"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI0Jwc9XSpUQ7kNvwGekJKI&_nc_oc=AdoG8VfYQqtx7DvbGgpipHKpE6axKqVyNcUu6Dv_hLO6QOOzDp6LV9MXphHwiss8PRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R7S_T90FO27ONQSra-XH2e2rBEyhqROTGV9CEZc3rMQ&oe=6A0322D7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghGGe5YNRZoQ7kNvwEhx9ed&_nc_oc=Adqz319DVwfLyOMStT-JHuyVFYgqG4XlzMFyVQzuTI4-9HA4fWLieh1Ojkw9giay5Lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G7nYGON_uGG3F8Rjq-mkx6B15-3pV1cr6YkKOIga4xA&oe=6A0334DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaU0n_owlvEQ7kNvwEsmKhV&_nc_oc=AdqQpXZFdOMao4_HAuPLBtcERBPBvn8jkQlI4DcWz_gP-chFrRI0O3xv4Jrt480ETH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RC_J7MKpXCEpV-A48MoOMF12XkOky3LRXB4h8Kiu24g&oe=6A03150B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zqD39qLjOQQ7kNvwELrJri&_nc_oc=Adrn2ldUYMIE_P-Qt3unmGy8XWJWpT_bmKwQk4FE0sD4Uc9HPMPmw48woucxBDSmMbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HBqLi8VyOKqzp1x35sUx_hX-5fRqw8QHHjnZWWbt72g&oe=6A0322D3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w2J1Z3ZXbgQ7kNvwG5IWGN&_nc_oc=Adqd3Jq6QoTDJ2Rasv22krd6FV_Or5FAm5k-vqZKiU11GqEQJ5hWNXI15nZVHWNT3u8&_nc_zt=3&_nc_h
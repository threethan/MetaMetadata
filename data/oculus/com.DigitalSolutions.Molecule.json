"}, {"file_name": "03.png", "id": "1329096738203478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392179_1329096741536811_8611226607687188228_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jmrj7NO6GsUQ7kNvwGgwhMu&_nc_oc=AdrFMXs5TFoFpwd63AeBORz-kPVrsLORnQA_KbgtLe3pdfOTuWopbrZs04PlxMHzoP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDehIZRaSXpYO1q8bJUGA2r3dKMazAVnloB-5UJnVB-zw&oe=6A54DFD7"}, {"file_name": "02.png", "id": "1748762312348821", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391860_1748762319015487_1421932971287351481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbriV1bH1f4Q7kNvwEb5pNN&_nc_oc=AdpHw8vIJxmrKsMq16hJum15NHJ8JVe7T7t2BVZbFGvupIv67kUcUOZRStBtBOq8NpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd_k-MJp3e73InUmNM9A4szz2yIT2THqau58qSW4RItg&oe=6A54F1DA"}, {"file_name": "05.png", "id": "574026965653815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392175_574026972320481_7205621352430064151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R312-FI1mZUQ7kNvwHF_qo3&_nc_oc=AdqG13MIhwo4FQMJL0HJSFna7g2Ep4jIQHwheE2V2lxHHBAcueIG0bNCN25_3QUQKKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLM61LqIQzibtxGg_uQBB9fCVZKwvx6yuUqK4M9D8ecA&oe=6A54D20B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "910612357516245", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75441584_910612360849578_7228555985229582529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybz2IH70KpsQ7kNvwGbCNDw&_nc_oc=Adox4UmlAU6TEXkI1QLB6mxaLTwyHa9ySCA03r1SVaQ1sdKzeUnyztF8TyYf90sKH-E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBETb6bu9b69b2jCzHp2j1BN-PoxTGYvjwt6FsAFFAhWg&oe=6A54DFD3"}, "display_name": "Atoms and Molecules", "keywords": [], "long_description": " This app provides a series of interactive lessons that detail the structure, properties, and behaviors of atoms and molecules, offering users a hands-on learning experience. Each lesson is followed by engaging tasks that reinforce the concepts taught, allowing learners to apply their knowledge in virtual experiments and quizzes. From visualizing the intricate arrangements of electrons to constructing molecules in a 3D space, this app makes complex scientific concepts accessible and exciting. It transforms abstract chemistry principles into tangible experiences, enhancing understanding and retention. Dive into the microscopic world and discover the wonders of chemistry like never before!", "short_description": "Explore the Building Blocks of the Universe with our Educational VR App designed to immerse users in the fascinating world of atoms and molecules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9386734991361623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974840_949382046811262_8167721585521170215_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWUoDzHEKugQ7kNvwHRQtkJ&_nc_oc=Adq0rkJrbreD2p_VzPKMaJILIx2D4hetS-9xweoXQL2FPZ4Kz2EQJusfJs0kximc1qY&_nc_zt=3&_nc_h
7", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821913_24336152379329926_7749077630744882515_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPALFE9HeOIQ7kNvwGzTPke&_nc_oc=Adrm43rpOL-HnfVB79kZyrYp3xG8HxIB51PST2nKallTzea-M6BqhTKQpJMYtaVc900&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYJJSOqtdowHKfJaOnVmgFLDcymbZ2UP3OxmgHzx2nOg&oe=6B05B761"}, {"file_name": "3.png", "id": "1914542846053663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_1914542849386996_6734428191005116651_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSTuVOm0SQUQ7kNvwGPj6z6&_nc_oc=AdoMw_5o5mIFe3ZzpYQ-NjKGE-GGBMVXXxNuXH9lsO7ZPvbb4HeioZQbtkmSLc9Kydw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxtZVEr1M3I5klnShmwR9tFL2HJE80T8rHfx5Fm3RXOg&oe=6B05B175"}, {"file_name": "2.png", "id": "1687633018582144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820586_1687633021915477_2313022753513040637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah6gckNenzUQ7kNvwHBpqjJ&_nc_oc=AdqNeLte1V3yI51l3mZSTZeiR0G0OfeHP5WCfpU_E4dnrLsKb2-DKDI9f8YUKGQ23hA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGWJJbd_QP0Q0qGzdeE7v51MYyLVEEf4gT5QiNo2pRiw&oe=6B05B2F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "1345373750597648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823447_1345373753930981_1645995710974859589_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5c9gGB5BYwQ7kNvwEGZcKd&_nc_oc=AdpwD0eBqS66-XWVc4tCprAA7eAVml7ZKh_zq-N3HQ6RChjoyLrj7AGTR8qQP4ivm0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFjDYVWz62axRCk2ScpG1FGxzETMGrzcsH82gLJvH8hA&oe=6B05C923"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24218172534516274"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "27695043980167782"}, {"stat
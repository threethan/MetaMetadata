96_6734428191005116651_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIXnUgmYwRoQ7kNvwEFT4i9&_nc_oc=Adqx199c6hsR5VfgKQw8_hsipnWZ5ciakySwwihijz1d8LRjJVeGWkA76NqcCiYtuh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2R8P2dE3YUwqQZBoJoyAycu9SsAstpuf5nHNwo2L0mg&oe=6AF730F5"}, {"file_name": "2.png", "id": "1687633018582144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820586_1687633021915477_2313022753513040637_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUwALzXGKIgQ7kNvwHeWMNx&_nc_oc=Adr9Rc6WS-JhtcxNQ7bvqHBpVTmDgtzF9olURmcLM8dxypfi5dYNDF5L5eFWI0v9A9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiRWcKzrzCZ90zpQn4aq-jipYbftnLXdwMYb5BgdgZdg&oe=6AF73270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "1345373750597648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823447_1345373753930981_1645995710974859589_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOXiRO7-kWMQ7kNvwGjptkr&_nc_oc=AdoB--Im1alunQqDnpk-8LiVJvEmGCX-x1Qx4it-G-q1UVdszCtw0O27m8p4go35Vmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWqBUEnrUwgc0KHXRErPp6dXqfZevmbtgIklXK058UiQ&oe=6AF748A3"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24218172534516274"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "27695043980167782"}, {"status": "PUBLISHED", "id": "2167432947323219"}, {"status": "PUBLISHED", "id": "1363455412265378"}, {"status": "PUBLISHED", "id": "1501161478034062"}, {"status": "PUBLISHED", "id": "1279773064066744"}, {"status": "PUBLISHED", "id": "1524295516080639"}, {"status": "PUBLISHED", "id": "1185936497078504"}, {"status": "PUBLISHED", "id": "25228581946842664"}, {"status": "PUBLISHED", "id": "1753128192013438"}, {"status": "PUBLISHED", "id": "1538268944211884"}, {"status": "PUBLISHED", "id": "671498629331640"}, {"status": "PUBLISHED", "id": "1110037094375708"}]}, "baseline_offer": {"id": "1538268944211884"}, "is_approved": true, 
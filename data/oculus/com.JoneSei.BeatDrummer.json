s://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/604298355_27906374282390650_8437369164833682089_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5BLOxG7_9MQ7kNvwE8PoMy&_nc_oc=AdoKPeWAqznCpH25amRZ8ozauqt2PRH8AZY8NhbjX0UD90NMThf7Mnudx6f4fDZWLAg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIchuWokXBsVeVhnjfvCuUa5-WMHPcYad4ln1A-6gMX9Q&oe=6AAE9058"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
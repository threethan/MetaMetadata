E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftli1HX6jckm3t0NpS6Jyxs8JbBSaT7DlT7vKbA0O2rsw&oe=69A57EA1"}, {"file_name": "3.png", "id": "1914542846053663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_1914542849386996_6734428191005116651_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMdKvOU8DD0Q7kNvwH2alqa&_nc_oc=AdnU7TWUhYOwGt1-bUXFaUw5FVJoIHf2O6qnA1cdKX4ZP2BtntGOckhKPKtIhOyB6ok&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftI8R8EvhE_kFyKWMcXaNH5aNTE-MupKJfEq1vTDT5GPQ&oe=69A578B5"}, {"file_name": "2.png", "id": "1687633018582144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820586_1687633021915477_2313022753513040637_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOFu_a_jHaMQ7kNvwHkxTKx&_nc_oc=AdnD53z-d44Jtz3FFLwM7n-JlDjJ5dQGCrk0suXsgoH6VYyoDvO5He8Yk0p7J_fZmIw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft9vVnp8XLkwSWRsgtRVOI2w4yIRQaMXVzkkMYQENSabQ&oe=69A57A30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "1345373750597648", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823447_1345373753930981_1645995710974859589_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E6o3_zaneYQ7kNvwFLwipQ&_nc_oc=AdnUSYMMCX-2KF5viYBA98bWWAjU9fVIb3_KGNk8CgnQ-OIyyWz8oKjtg4KA4AfyvHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afus7wuqind7BD23v6u3UkCIfeU3manvaOtfQ5bXSV0gUA&oe=69A59063"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24218172534516274"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1524295516080639"}, {"status": "PUBLISHED", "id": "1185936497078504"}, {"status": "PUBLISHED", "id": "25228581946842664"}, {"status": "PUBLISHED", "id": "1753128192013438"}, {"status": "PUBLISHED", "id": "1538268944211884"}, {"status": "PUBLISHED", "id": "671498629331640"}, {"status": "PUBLISHED", "id": "1110037094375708"}]}, "baseline_offer": {"id": "1538268944211884"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771876
5_Phjky7CaF7eKuxRdZqdZijr27T41X5Szq6aobQoCCSek5M_M9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9kcHGVNgWTEb2kW_mWnOKyo_l7NskTgmhFgEGiDGGjw&oe=6B0EEBF5"}, {"file_name": "2.png", "id": "1687633018582144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820586_1687633021915477_2313022753513040637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYjrgSCJIzoQ7kNvwEGW_95&_nc_oc=AdreorqsxPoQepjzcwW0VmGngY9WaRWEZMXxDldjR80Xi5c_jZIGecq1HnK_-PTMooc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5ieEZ-Tv9rt1x6rrPCxR2EWWVuq_G81_9hlquBlq1mw&oe=6B0EED70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "27906374265723985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604298355_27906374282390650_8437369164833682089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCYuMJWp04YQ7kNvwESmGav&_nc_oc=Adp8IgMF_aKslFbEgKXU_3NKrwulop-oTy87xl3TCpdQ3OsmW9BuM0Q7F7BdKEgkv9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUifO57iWJDw_ciWKFQiA49SdnV4OgSJUea7wiPppuxrw&oe=6B0F0618"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27942228302110660"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623601_1840991960606894_6611655782822348792_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4CEdRCR4MIQ7kNvwHVnHEW&_nc_oc=AdoPYxmCzn1NSKhyHO73_wtSIBztBpukjUMCEgUEJyUmxNTp-rcwF4hzd-99VUJGXnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqSREs3Chk4qa0ZnT9mRQNyg3fEheHfUU06veRIcOJJg&oe=6B0F1B40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Drummer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1755088860, "lastRevision": {"nodes": [{"id": "24218172561182938", "release_
czi5P3YBJKYc26ens2IsSc_z2dXpIukTMJLGOyw&oe=6B0C8135"}, {"file_name": "2.png", "id": "1687633018582144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820586_1687633021915477_2313022753513040637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu82kfGj4rwQ7kNvwEZCtvL&_nc_oc=AdqSzxwVwW39F_J-EBtHU80uv8ybrmoc0LZXx-2S2r3xbaoBvu9PkhO9n_OCltrute0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSS67sj77IIIm9-m4_EukPACnr3yjpdCKhZBxL4ciUySg&oe=6B0C82B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "27906374265723985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604298355_27906374282390650_8437369164833682089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCYuMJWp04YQ7kNvwHEDWx_&_nc_oc=AdpHclUHrDgRD669_8YjniLNY66db8GILckVhRh-yyGTurEqpFA-28KRNjSNNAZS9zk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRywSUuyXxIZjjDx7j5g_QDzcSuE7SKC-4rC_Yy_fNNdA&oe=6B0C6318"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27942228302110660"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623601_1840991960606894_6611655782822348792_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyD4OnK32YMQ7kNvwEZFtvR&_nc_oc=AdocxheokGcqLeFzQqF6BbFGKV5DrX4iSPSt35DMjlWwBUhyAyW2BwkFT7Y9o1mHgbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDw9KopF2DpoPVXEfRQPvImdAXvdhHVBy2xHbopl94Dg&oe=6B0C7840"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Drummer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1755088860, "lastRevision": {"nodes": [{"id": "24218172561182938", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah6gckNenzUQ7kNvwGJiGjI&_nc_oc=Adqru9BKt_m2AOjwvQwF3vHHef58vQUNV6WoYBcjgSYVwNq0qol3BMgR-ygzQmCRqCQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTttMlDkHj9QRjFqjcOZ9KIrQzApJVUjsqSoi9gzVGI-w&oe=6B0855F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "27906374265723985", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/604298355_27906374282390650_8437369164833682089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHd9tKrG6QwQ7kNvwGhh0EF&_nc_oc=AdrnN43yo0rrR9-cXJt85q9IV-zVITGb1OhXBFpKaT8kQxMWdWeK7RhyrpA2qYqXDlE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpXTSWjkny20Vz1lkv6pxyDE65Lz5mF7eryTgOcc1OgQ&oe=6B086E98"}, "display_name": "Beat Drummer", "keywords": ["vrdrumgame", "rhythmgame", "drummingbeats", "musicrhythmquest"], "long_description": "BEAT DRUMMER: Ultimate VR Drum Experience\nStep into the world\u2019s most intense drumming arena! Feel every beat, smash neon drums, and unleash your inner rockstar in hyper-realistic VR. Lots of head-banging tracks, dynamic environments, and multiplayer battles, this is rhythm gaming reborn.\n\n\ud83d\udd25 KEY FEATURES\n\n\ud83e\udd41 REALISTIC DRUMMING: Experience lifelike drum physics & haptic feedback \u2013 crafted for Meta Quest 3!\n\n\ud83c\udf1f LOTS OF ROCK/EDM TRACKS: Master classics from Metallica to Skrillex, with 5 difficulties & 360\u00b0 modes.\n\n\ud83d\udca5 SMASH TO WIN: Hit the right rhythm a lot to create many fuels explosive combos!\n\n\ud83d\ude80 WHY DRUMMERS LOVE IT:\n\"Finally, a VR game that makes you SWEAT! The adrenaline rush is unreal!\"", "short_description": "Smash drums in explosive VR! Feel real beats, master rock songs & become a rhythm legend. Play now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_web
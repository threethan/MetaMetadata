25/57572919_950010749502374_7336424103497073184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0wxOeUoSuYQ7kNvwHwh2PO&_nc_oc=Adly7lSVBXbxGpR0uQs-V8SwgylLI5s4ymYgQnePUlO7dEHq9Aw0FUgHi0lT4wE1pkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsps2li_7QU1jJcHItmO-yjY24O6f29LI_q6d0mvm2LlA&oe=699C4429"}, {"file_name": "oculus screenshot 3.png", "id": "758968529146536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_758968532479869_5992399593107185056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StCoV2EEnq8Q7kNvwG5jdvL&_nc_oc=Adm0lRMYkkMEqEOCdEoVFILSJvaZMz-pRMhGm3bI2U1l5Az68Wj4wYcG5PMp7u5CaIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuhm8tjZgSE7fg6BbNe8Kl_wRPToS2h-klf6eKpRoFsPw&oe=699C661A"}, {"file_name": "oculus screenshot 6.png", "id": "173579598860712", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974914_173579602194045_2043299477488637509_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBlnEynZVtEQ7kNvwE_vtLD&_nc_oc=AdlnSMUqKOqn3AM0p7fJ3HO_Zi3oDOC5DPCZ1xDD8qu9TN1VyiQ7pv-d95cq24TA3T8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuk3SVQQUPV_CPVlv63zMNR47wBty67IcWiY_88t5_5uw&oe=699C3FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "782998756902491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982502_782998763569157_2262920780424065717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFRKlk2YfGMQ7kNvwG6PPns&_nc_oc=AdkY1Kbc1KJ0wJs_0BOu3LXIk8ueu7glf2noOTrXr3P0mSHbQ-LtvdFdw8pWsBsMb_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsr3YY7bX4BrZDY5jtqmj25Lr408rYXb-36Sv5YZdKA3g&oe=699C3BD9"}, "display_name": "Blockworks", "keywords": [], "long_description": "Blockworks is a creative VR sandbox. Express your full creativity and build anything your mind can imagine!\n\nClassic Mode\nFollow instructions and build from built-in sets and hundreds of workshop submissions. Build one page at the time.\n\nSandbox Mode\nThe only limit is your imagination. All blocks and all materials are at your disposal. You can save your block creations in the library or share them on the game workshop.\n\nEndless Mode\nNo longer limited by table size, you have an infinite area to build on. Place the blocks on the studs in the ground.\n\nContent\n\u25cf 100s of block types\n\u25cf 30 materials\n\u25cf 5 build-in sets\n\u25cf 4 environments\n\u25cf 100s of workshop builds\n\nGameplay\n- use you virtual hands to grab and manipulate blocks. When blocks are close enough each other a blue preview will show up. Dropped block will instantly connect to the other block. Help blocks are highlighted, when the disconnect button is hit, the highlighted block is separated from the rest of the group. The game features lot of buttons and gizmos that have good feeling feedback. There is no UI in the game.\n\nJoin our official Discord for more fun outside the game!", "short_description": "Blockworks is unique VR sandbox game. Use your imagination to build anything you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elasticsea.com/blockworksprivacy", "developer_terms_of_service_url": null, "publisher_name": "Elastic Sea", "support_website_url": null, "website_url": "https://www.elasticsea.com/blockworks", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8484807698275021"}, "review_
_name": "oculus screenshot 7.png", "id": "950010746169041", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572919_950010749502374_7336424103497073184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTi0THWcYJcQ7kNvwFlaXys&_nc_oc=AdoE18D6uiQwL_HGmMgotnrFY3XFcKf1wKqhxBEgMJZSXOpQhk5aiukxzLRPewfdYtc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKRvWhVTq_5UsBpaW6V2W35PJPa4QApC17rDS-3smKWA&oe=6A6F3429"}, {"file_name": "oculus screenshot 3.png", "id": "758968529146536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974855_758968532479869_5992399593107185056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqxOxUp3zKEQ7kNvwEw9z47&_nc_oc=AdoyeQSE03UwiHZARL0SiidvyBmnCiWSI8qccwafEH7Arjbfp54xKv878BaGGUI5-c8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz3dT0bjY2Fx50AKhFRpAaNZZR0GgTMoSYxA0tf66gYw&oe=6A6F561A"}, {"file_name": "oculus screenshot 6.png", "id": "173579598860712", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974914_173579602194045_2043299477488637509_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd7d90JndUQQ7kNvwHERiw6&_nc_oc=Adr5SDpRMUAFF26BbDhMoAOMYxGOkJqndhjRYEfZ93IQ0K-d0hBvp0C5x8QWDJ0D23Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlGNDZsyBVhaXINycQGBMEwYdkk94v6vsPVkmTmqcCIA&oe=6A6F2FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "782998756902491", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982502_782998763569157_2262920780424065717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_AeknG4_WwQ7kNvwGk9Yhj&_nc_oc=AdpR735QiMFlMA1ZlhMMfFNcJfbc8fzhpcZ-yHwJ5frSTR2g-DlnUWqKUgtmM-Y-Ubo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7HT1iQCZNk_518bYBPl2Or2yDvN9dLmJbn-UPp7Mgog&oe=6A6F2BD9"}, "display_name": "Blockworks", "keywords": [], "long_description": "Blockworks is a creative VR sandbox. Express your full creativity and build anything your mind can imagine!\n\nClassic Mode\nFollow instructions and build from built-in sets and hundreds of workshop submissions. Build one page at the time.\n\nSandbox Mode\nThe only limit is your imagination. All blocks and all materials are at your disposal. You can save your block creations in the library or share them on the game workshop.\n\nEndless Mode\nNo longer limited by table size, you have an infinite area to build on. Place the blocks on the studs in the ground.\n\nContent\n\u25cf 100s of block types\n\u25cf 30 materials\n\u25cf 5 build-in sets\n\u25cf 4 environments\n\u25cf 100s of workshop builds\n\nGameplay\n- use you virtual hands to grab and manipulate blocks. When blocks are close enough each other a blue preview will show up. Dropped block will instantly connect to the other block. Help blocks are highlighted, when the disconnect button is hit, the highlighted block is separated from the rest of the group. The game features lot of buttons and gizmos that have good feeling feedback. There is no UI in the game.\n\nJoin our official Discord for more fun outside the game!", "short_description": "Blockworks is unique VR sandbox game. Use your imagination to build anything you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elasticsea.com/blockworksprivacy", "developer_terms_of_service_url": null, "publisher_name": "Elastic Sea", "support_website_url": null, "website_url": "https://www.elasticsea.com/blockworks", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "
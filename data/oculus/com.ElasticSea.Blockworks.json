_name": "oculus screenshot 7.png", "id": "950010746169041", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572919_950010749502374_7336424103497073184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXOyuvrZXs4Q7kNvwEDuVpa&_nc_oc=Ado600Bw7aQjPghIeA6zPJMl0BxUp-0IGuuk_6s4IkdzDMpLV_Y1Lk9IWtJHFQpSOR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8QhqLFeR0JnbSolkMsOKz_aXi15uFOR7rCJlFIQt4kg&oe=6A6B3FA9"}, {"file_name": "oculus screenshot 3.png", "id": "758968529146536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974855_758968532479869_5992399593107185056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80zIid6H6W0Q7kNvwHWdnCQ&_nc_oc=AdpksQwAmWx0It5gpBrs808XZLEHDFG61Z24ooGBareYtoUPxqXwAmf99q7bIFl9nsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCThlf7PcaziYSl_VAK13NeSW1OQFpNjtnbgaC0yuse4g&oe=6A6B619A"}, {"file_name": "oculus screenshot 6.png", "id": "173579598860712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974914_173579602194045_2043299477488637509_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m30JmSd_WIQ7kNvwGXDZHz&_nc_oc=AdoWIRUQBDVv9aQgGSeWpDZT2MMRN8io7HV2ZoR9VHUk3wyDpZfbd1RyN1A-DocD_Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVRxa7mMszcBeG_PkUVFGh7dDLUwTZIFfhTjjiv6UmGw&oe=6A6B3B5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "782998756902491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_782998763569157_2262920780424065717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBcVS_UEYncQ7kNvwFlZiXP&_nc_oc=AdpRTmS-l3-Df6Tqb_oPhTtREuVA351-FSgqOMsjhc3UwdfhRKZb6h4Lr5BR75g2I-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDneJr19OwaYcKBYl0dU_Cg8X4J1jj3sn092jfiQGspBA&oe=6A6B6F99"}, "display_name": "Blockworks", "keywords": [], "long_description": "Blockworks is a creative VR sandbox. Express your full creativity and build anything your mind can imagine!\n\nClassic Mode\nFollow instructions and build from built-in sets and hundreds of workshop submissions. Build one page at the time.\n\nSandbox Mode\nThe only limit is your imagination. All blocks and all materials are at your disposal. You can save your block creations in the library or share them on the game workshop.\n\nEndless Mode\nNo longer limited by table size, you have an infinite area to build on. Place the blocks on the studs in the ground.\n\nContent\n\u25cf 100s of block types\n\u25cf 30 materials\n\u25cf 5 build-in sets\n\u25cf 4 environments\n\u25cf 100s of workshop builds\n\nGameplay\n- use you virtual hands to grab and manipulate blocks. When blocks are close enough each other a blue preview will show up. Dropped block will instantly connect to the other block. Help blocks are highlighted, when the disconnect button is hit, the highlighted block is separated from the rest of the group. The game features lot of buttons and gizmos that have good feeling feedback. There is no UI in the game.\n\nJoin our official Discord for more fun outside the game!", "short_description": "Blockworks is unique VR sandbox game. Use your imagination to build anything you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elasticsea.com/blockworksprivacy", "developer_terms_of_service_url": null, "publisher_name": "Elastic Sea", "support_website_url": null, "website_url": "https://www.elasticsea.com/blockworks", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "
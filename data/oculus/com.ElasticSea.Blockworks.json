hc=bW2cCQQPk80Q7kNvwFxy8RY&_nc_oc=Adqd3rF8p_1kK-kOAqOVQmDHxEdyI_ZUVII-ZP3Wyvl5i7Rfz-bCFq1Ulz8b3bNiXj4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_JAZSSqRipsetsbXiOYEs8sfYWDkPOIRbdSkU_Na8pQ&oe=6AFB31AC"}, {"file_name": "oculus screenshot 7.png", "id": "950010746169041", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572919_950010749502374_7336424103497073184_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2kIU7-0qhUQ7kNvwFTJlcI&_nc_oc=Adp3ARuUi_mkYv31zGqnSz0EHRePXpstbF8XbuUD0eN3lJT0WvzX8wT43msyXWTXApM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1m9GUH-i2Sg_4FyTTI7-yLdPopX7jfrfPJi0JStPoNg&oe=6AFB2B69"}, {"file_name": "oculus screenshot 3.png", "id": "758968529146536", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_758968532479869_5992399593107185056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p53Q0bOh0EQ7kNvwFH4LAj&_nc_oc=Adp6Ts9OUmxvdHB6xXqVW7No5q2mFQIL3bzACFPEqs46xYLgWtgOyeYO8M6bhErePi4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSisrwHERUExMMrOeVtEqfpXXvo0Rb_ei2CHwgfhxbMpA&oe=6AFB151A"}, {"file_name": "oculus screenshot 6.png", "id": "173579598860712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974914_173579602194045_2043299477488637509_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j__LuMX1JQUQ7kNvwGVUC4r&_nc_oc=AdpiZWKituMT5oPsWJPKw7LZXTNPji5A2xSxzkgpJSplI2z51B3IYTvnuFzy19VO-5c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQujCCTW0hkrI213RtPDd40tItxQ1ZiXM6oajGuntn-yg&oe=6AFB271B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "782998756902491", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982502_782998763569157_2262920780424065717_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQe4hZZcQoAQ7kNvwE_MWzh&_nc_oc=Adr-Pkinmwbhu8fiVnHygKd48D0D8hYxI4GjCux0oRrJdzrODXsHFZYFVPJOtXQreAU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZR2J8Sw9chlYf5e2x_wx4bIFjKOG2JFnojbE2X9y9OA&oe=6AFB2319"}, "display_name": "Blockworks", "keywords": [], "long_description": "Blockworks is a creative VR sandbox. Express your full creativity and build anything your mind can imagine!\n\nClassic Mode\nFollow instructions and build from built-in sets and hundreds of workshop submissions. Build one page at the time.\n\nSandbox Mode\nThe only limit is your imagination. All blocks and all materials are at your disposal. You can save your block creations in the library or share them on the game workshop.\n\nEndless Mode\nNo longer limited by table size, you have an infinite area to build on. Place the blocks on the studs in the ground.\n\nContent\n\u25cf 100s of block types\n\u25cf 30 materials\n\u25cf 5 build-in sets\n\u25cf 4 environments\n\u25cf 100s of workshop builds\n\nGameplay\n- use you virtual hands to grab and manipulate blocks. When blocks are close enough each other a blue preview will show up. Dropped block will instantly connect to the other block. Help blocks are highlighted, when the disconnect button is hit, the highlighted block is separated from the rest of the group. The game features lot of buttons and gizmos that have good feeling feedback. There is no UI in the game.\n\nJoin our official Discord for more fun outside the game!", "short_description": "Blockworks is unique VR sandbox game. Use your imagination to build anything you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elasticsea.com/blockworksprivacy", "developer_terms_of_service_url": null, "publisher_name": "Elastic Sea", "support_website_url": null, "website_url": "https://www.elasticsea.com/blockworks", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "
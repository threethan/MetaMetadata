, {"file_name": "oculus screenshot 7.png", "id": "950010746169041", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57572919_950010749502374_7336424103497073184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8yhoYYMpP8Q7kNvwHsZp0f&_nc_oc=AdobjklcId6cLy5yOqFwxhxmVcdeN4BGaOy-yKcVKgY2MQAuKl3uXrYJrop0HKB_RCY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsTw_bTbJNdXu5Kn1fraaqeOEcfGDre_0Nw5UL9QRRLQ&oe=6A8ED829"}, {"file_name": "oculus screenshot 3.png", "id": "758968529146536", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974855_758968532479869_5992399593107185056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO8H7y0LymYQ7kNvwFAQCg5&_nc_oc=AdrGtfAMIlM1APdbcQhcseh6u8Bf61j0pSHBVFe2zQZAj1sVLfoksILcleWDV8M1iZ8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtERId4uxBluGCAhwCFV86eb5lwNZlAJ0JkHRGqIngMQ&oe=6A8EC1DA"}, {"file_name": "oculus screenshot 6.png", "id": "173579598860712", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974914_173579602194045_2043299477488637509_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW3pz9_BQOIQ7kNvwHuH3ju&_nc_oc=AdqoIChpI-3K69WJE5LFq955uw5oG7zZ-vv-Re2GhAXNZURqocrBviKJx-cqWFvVmxo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQy68Eu80KVLOQ1oYwpoO2n2bgmkPMZm2HqXAsrboReg&oe=6A8ED3DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover art.png", "id": "782998756902491", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982502_782998763569157_2262920780424065717_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg8lmehaQwcQ7kNvwGeTGf9&_nc_oc=AdrfTS0AX4yWtzHFIj5OntltEQ6WgLCCMPeZIWUMQGuWYIIbLo7MySEdvJwpZxUDqH0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhTy8RR0suu9qpyCL8ROHpnqLqtVofG1LPM_8keVhfeA&oe=6A8ECFD9"}, "display_name": "Blockworks", "keywords": [], "long_description": "Blockworks is a creative VR sandbox. Express your full creativity and build anything your mind can imagine!\n\nClassic Mode\nFollow instructions and build from built-in sets and hundreds of workshop submissions. Build one page at the time.\n\nSandbox Mode\nThe only limit is your imagination. All blocks and all materials are at your disposal. You can save your block creations in the library or share them on the game workshop.\n\nEndless Mode\nNo longer limited by table size, you have an infinite area to build on. Place the blocks on the studs in the ground.\n\nContent\n\u25cf 100s of block types\n\u25cf 30 materials\n\u25cf 5 build-in sets\n\u25cf 4 environments\n\u25cf 100s of workshop builds\n\nGameplay\n- use you virtual hands to grab and manipulate blocks. When blocks are close enough each other a blue preview will show up. Dropped block will instantly connect to the other block. Help blocks are highlighted, when the disconnect button is hit, the highlighted block is separated from the rest of the group. The game features lot of buttons and gizmos that have good feeling feedback. There is no UI in the game.\n\nJoin our official Discord for more fun outside the game!", "short_description": "Blockworks is unique VR sandbox game. Use your imagination to build anything you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elasticsea.com/blockworksprivacy", "developer_terms_of_service_url": null, "publisher_name": "Elastic Sea", "support_website_url": null, "website_url": "https://www.elasticsea.com/blockworks", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
rhIOfniidwJ8fX57aCGA5pi5rodk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGosdkGYbXZlwqV80KAKu9msPFvQJvlHNurh-oc_qpKLw&oe=6A9415DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Asylum Free", "keywords": ["horror", "asylum", "free", "hospital", "zombie"], "long_description": "If you have any heart or epilepsy problems do not play this evil game! Be warned.\n\nHorror Asylum FREE provides a stunning survival and mystery horror experience!\nCan you outlast this game and solve its puzzles?\n\nFight against zombies and use weapons or tools to succeed the mysterious horror hospital.\nBetter be prepared for jump scares and puzzles, the evil is resident in these halls!\n\nExperience the haunting horror game ideal for halloween or dark nights with:\n- Amazing 3D High End Graphics\n- Stunning Haunted Horror Atmosphere\n- Spatial 3D Sound\n\nIt is best to use headphones for ultimate immersion.\n\nNew Features coming soon! (Tell us what you would like to play, we love feedback!)", "short_description": "Horror Asylum Free provides a stunning survival and mystery horror experience!\nCan you outlast this game and solve its puzzles? \nFight against zombies and use weapons or tools to succeed the mysterious horror hospital."}]}, "developer_name": "Tom F\u00f6rster", "developer_privacy_policy_url": "http://www.forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom F\u00f6rster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
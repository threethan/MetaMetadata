25/604375581_1036753092723761_7517468467905431013_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw99M-UkKQ0Q7kNvwHcG8N6&_nc_oc=AdraOtCxnSaIF4AJtLIx0-FKZPoqiHSm70iTT6tuzlVOSN9Nqeoea6GqIJyjAPL4HXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv_qO7sqwd9G1vkCCYLaUd0qemgQXmFppsrDRPxYu0oA&oe=6B0331B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sig Bcary", "keywords": ["SigBcary", "Sig", "Bcary", "Zgmonk", "Waffle"], "long_description": "Sig Bcary is an Israeli horror gorilla tag and big scary fangame!\n\nSig Bcary is a fan-made horror game inspired by Big Scary and Gorilla Tag, made specifically for the Waffle account. While it takes inspiration from Big Scary, Sig Bcary is designed to have its own identity, secrets, events, challenges, and experiences for players to discover.\n\nThe game isn't just about playing through the same maps over and over. Sig Bcary is meant to feel like a game that changes over time, with special events, hidden secrets, temporary content, and things that players can discover together.", "short_description": "Sig Bcary is an Israeli horror gorilla tag and big scary fangame!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15Nr-xhfXWQ10R4jP1VtgvqpViQG51x5qM-rXzrRtLHU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "WaffleBG", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1E-UmBl-ucIOSwe4xqt_TaUGrohRkDGxmaB2uxeIlRos/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nu
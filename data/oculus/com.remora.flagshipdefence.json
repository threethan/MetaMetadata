yxPjdQubKrhIuWxwVh2cl8GIwLohU3By8-1yq7PSuwvaNDyjXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYEiBRPjls4ZJRdc0NVuMDLfvkW7FTE3Qgbdu2vwtasQ&oe=6B0DCE13"}, {"file_name": "Space_Oddysea_Screenshot_02_2560x1440.png", "id": "1594210075797934", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908835820_1594210079131267_7870874852782816261_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeMRdvxnjKQQ7kNvwGNNV0V&_nc_oc=AdqZV0ZHK9wTCG5vWY-57JOXgO_3bz9P8h8PqX4ZjfWvHBYk6ayJl8-_1V-Fau5COgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQ-jGLp_4PakZXVG0QcpSU3JMENFsbjFwzfK16-g92LQ&oe=6B0DCA41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space_Oddysea_Reef_Point_Trailer_Thumbnail_2560x1440.png", "id": "1162782663112931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_1162782666446264_8066608857197243813_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuTXsaPISjYQ7kNvwE_uwZk&_nc_oc=AdpK_ZQ7NwoYBAYOUjlohyxhtNOH-4vSf5uk3tPf8zFBmJQ9YgaM76vNhl_dK9wLnXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOzHGO3KxqpWzqIMbuNrPzQpTlEF5KZlRGP91eno6t4w&oe=6B0DCC3F"}, "display_name": "Space Oddysea - Space Combat Roguelite", "keywords": ["odyssey", "space", "oddysea", "spaceship", "dogfight"], "long_description": "Prepare to defend the capital ship, the Cetacean from hordes of arriving enemy spaceships of all descriptions in this space station wave defence survival experience! \n\nNEW MISSION - Reef Point - Defend the asteroid-based research facility from waves of new enemies and bosses! \n\nWhether you just want to experience space flight, or you want to challenge yourself to make it to the end of the onslaught and defeat all of the unique boss fights, this arcade style instant action game is perfect for you! \n\nThis game is in early access and many future updates are planned and currently underway. \n", "short_descriptio
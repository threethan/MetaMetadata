{"file_name": "StoreShot1.png", "id": "894884338608201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75234372_894884341941534_7869237073366451741_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWGHLonajasQ7kNvwF0Q6m5&_nc_oc=AdohTz4m5suOqr6XpY9NIg7lGmYtA0Gx2JwOKNxO1S_UqbtA_x2uvIWmcpXeMTuhfDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjfzwrlvzQCkvhfBHLzQd3JPDtlf73mAjteM1llOYuhg&oe=6ADE0E89"}, {"file_name": "StoreShot5.png", "id": "720594126792198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982600_720594136792197_1465571139819816706_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWt8Zv6AoqQQ7kNvwHJlATx&_nc_oc=AdpHArlvqdjFhnLpQBDMn5R7dq6yhPz3I9NKaJeF58VAQBVX-Sp9s46nHY312rf7gZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJW7WKQf85c4PD21r2eUC-aIbx1WJt0QNEOV273e9FPw&oe=6ADE15EE"}, {"file_name": "StoreShot4.png", "id": "1093540398468037", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75286676_1093540401801370_3413783454722325257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekQNHS1fWN0Q7kNvwH8gEVi&_nc_oc=AdoPfqBThBgDYd9Gj6ncIfUZZvxBH_sJZ0knq0W4X82L0OrNa3d-PFzR6jFXcXjVs9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv1lvBuxnvJ-786Dt35qX5HxpCbXkrlSJD0XkJVPYKqA&oe=6ADDFD95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Fly_CoverLandscape_2560x1440.png", "id": "410045358013448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_410045361346781_8167709878467870546_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-JdLUE5ra4Q7kNvwGhz7Mx&_nc_oc=AdpzDuUIwarDga3aHDB6kVl2IcU5rjWh_uK7WiixNtC8sl5oMHjUaKfHdWGQSV6cpi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeXAnDAbnNY5yboBYmkVnQZfKB7EmY9_1j0-pN4i8mGA&oe=6ADDFB7E"}, "display_name": "Fly", "keywords": [], "long_description": "Embark on an extraordinary journey with Fly, and redefine the way you explore our planet. Powered by Google's cutting-edge 3D Maps Tiles, this immersive experience lets you soar through the skies and witness the world's wonders like never before. From the ground all the way to the edge of space, you can truly Fly for the first time.\n\nGlobal Exploration: Fly taps into Google's vast repository of 3D tiles, offering a true-to-life representation of Earth. Traverse majestic landscapes, iconic landmarks, and hidden gems from the comfort of your home. Whether it's the towering peaks of the Himalayas, the bustling streets of Tokyo, or triumphs of human engineering like the Eiffel Tower in Paris, the world is yours to discover.\n\nUnique Motion in Flight: Feel the rush of wind as you take flight on your drone. Utilizing our unique motion controls enjoy a seamless and intuitive flying experience. Control your speed and direction with direct body motion and altitude with the joystick. Soar over mountains, glide through valleys, and experience the thrill of flight.\n\nStreaming Music: With Feed.fm built in you will have a selection of music at your fingertips to enjoy. From Pop hits to EDM you can pick your own soundtrack.\n\nUnleash your inner adventurer with Fly \u2013 the ultimate virtual reality app that brings the world to your fingertips for the first time in a stand alone headset. Elevate your senses, broaden your horizons, and experience the magic of flight in a way you've never imagined.", "short_description": "Embark on an extraordinary journey with Fly, powered by Google's 3D Maps Tiles. Soar through the skies, from the Alps to Tokyo, and explore Earth's wonders. Fly offers a true-to-life representation of the world, allowing you to traverse landscapes and iconic landmarks. With unique motion controls, experience the rush of wind as you navigate mountains and valleys. Enjoy a curated soundtrack with built-in Feed.fm. Elevate your senses, broaden your horizons, unleash your inner adventurer with Fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "developer_terms_of_service_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056435331", "publisher_name": "VirZOOM", "support_website_url": "https://virzoom.com/help", "website_url": "https://virzoom.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "820781506312417"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "2840910699628800"}, {"status": "PUBLISHED", "id": "1722672598792671"}, {"status": "PUBLISHED", "id": "2407519346398798"}, {"status": "PUBLISHED", "id": "1737419227396023"}, {"status": "PUBLISHED", "id": "1527115829114100"}, {"status": "PUBLISHED", "id": "1443406734036353"}, {"status": "PUBLISHED", "id": "1396958714989676"}, {"status": "PUBLISHED", "id": "1896373237946755"}, {"status": "PUBLISHED", "id": "1481890992830398"}, {"status": "PUBLISHED", "id": "2268422820242596"}, {"status": "PUBLISHED", "id": "3054507304711581"}, {"status": "PUBLISHED", "id": "688210907016745"}, {"status": "PUBLISHED", "id": "643864448224110"}, {"status": "PUBLISHED", "id": "994601512539222"}, {"status": "PUBLISHED", "id": "1224537928758507"}, {"status": "PUBLISHED", "id": "1231813481182671"}, {"status": "PUBLISHED", "id": "501177882482842"}, {"status": "PUBLISHED", "id": "3603716963195882"}, {"status": "PENDING", "id": "322418734007334"}]}, "baseline_offer": {"id": "688210907016745"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2840910699628800"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28731878649772805", "version": "1.7.15"}, "id": "1284708289075212", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6392501587470497", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28731878649772805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1284708289075212"}]}, "change_log": "--1.7.0--\n-Introducing the AI Concierge!-\nNever FLY alone again with your  new tour guide\nListens and replies in ANY language\nWill search for and take you to any location on Earth\nProvides information about what you are seeing and where you are located\nRemembers conversation context for more accurate replies\n\n-Multiplayer Improvements-\nMultiplayer options panel now lists all players\nTravel to other players easily by selecting them from the list\nStreet View pano dots turn orange when another player is in them making it easy to select and share their view!\n\n--1.7.1--\nFixes for a couple of minor crashes related to AI Concierge\n\n--1.7.2--\nFixed a rendering issue on Quest 2 headsets\n\n--1.7.3--\nAI Concierge options added for hiding the HUD button and the output text panel\nAI can now be used to create bookmarks\nAI is better at identifying a requested location when asking to travel to a specific place\nAdded links for external music services while removing Feed.FM\nNow supporting Asian character sets in Destination Search results\n\n--1.7.4--\nRe-fixed a rendering issue on Quest 2 headsets\n\n--1.7.5--\nAI activation options added, including ability to disable AI marketing info\nReworked how and when microphone permissions are requested\nKeyboard entry button is now more clear about function for Search, Bookmarks, Join Multiplayer\n\n--1.7.6--\nAttempted fix for a startup crash likely related to Quest platform initialization\n\n--1.7.7--\nMore startup sequence fixes and additional logging added to help find why some users are crashing on startup\n\n--1.7.8--\nAdditional startup sequence fixes and logging\n\n--1.7.9--\nUpdated to latest version of OculusXR plugin\n\n--1.7.10--\nNew error messaging for users to help us understand why there are some Meta-related crashes since recent headset updates\n\n--1.7.11--\nImproved handling of Meta system sync delays that causing start-up failures for some users\n\n--1.7.12--\nMore reliability fixes for the system handshake timeout during start-up\n\n--1.7.13--\nAdditional error logging and handling related to start-up issues for some users\n\n--1.7.14--\nAI Concierge is once again successfully using image data to inform specific prompt types\nAI Concierge now returns a more specific address whenever possible during a teleport prompt from the user\n\n--1.7.15--\nNew vehicles: soar over the world in one of three hang gliders, or drift along in one of three hot air balloons. Find them in the Hangar.\nHot air balloons come with a working burner. Push up to climb and you'll see and hear the flame roar, and so will your friends in multiplayer.\nThe Hangar is easier to browse, with smooth scrolling through all of your vehicles.\nHosts can now hide everyone's player tags, perfect for a game of hide and seek.\nThe AI Concierge is faster and more reliable, understands more ways of asking to look around or travel somewhere, and gives friendlier tour-guide answers.\nFixed an issue where asking the AI Concierge to bookmark a location didn't work.", "created_date": 1792182662, "id": "28731878649772805", "version": "1.7.15", "version_code": 406, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6392501587470497", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28731878649772805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792176705, "id": "28730888033205200", "version": "1.7.15", "version_code": 405, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6392501587470497", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28731878649772805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792120350, "id": "28720844457542891", "version": "1.7.15", "version_code": 404, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6392501587470497", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28731878649772805"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792117431, "id": "28720369454257058", "version": "1.7.15", "version_code": 403, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": 
luscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW2e0MrJPMQQ7kNvwFXEnaV&_nc_oc=AdoOJuiTGU3LCnWIQBJLmcVnzugIooZvDlRmAmgodU7_UI74kKJMHgZ5akoOb6NpNqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpOnGqpH5DK9HDS3WV56FIYmcOEwPY-zz5dbffdUzupw&oe=6A9C3C35"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa-CeYrOPlAQ7kNvwGIEIHb&_nc_oc=AdpXnE0dZBRWNlgBFnueJMrZ_PpsXNSXRC8ZMd85s70nX29EzYcCBZuX4TV4jRvbPsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL72bcmjHe_lw1e134HUlLvNH-A-EyWgnydKkUnpUclVA&oe=6A9C3A52"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9EeNIJePsYQ7kNvwEZ63fu&_nc_oc=AdrG48RvCK0btssKJeN8HRw6Ta5hCK80U3wrmUUBgSyiqSmiBvYNW7mobCi0xiex-_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoTlX0zQ54tlbNWwZMN7PMBmY2Gf23MIwY6nU0VKIArw&oe=6A9C3DFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaNsfKITKC4Q7kNvwHN3LDr&_nc_oc=AdosqYq0Q6A5PjPmB0LxgARNA5G7f_JqIAXGFNxwADLqjH7aBC0n171TjoTT9x7coso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl5kHDN_DEGVg8WC5YqzyMvzi--J4Mx85ShlwYzKoK1w&oe=6A9C1C42"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
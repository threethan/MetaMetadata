6225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVAa3bgFG8MQ7kNvwHPFO0u&_nc_oc=Adns5gJNIVV9DqNms1qARKiaBVG4kNglU07Q8Z18Ng5yJ8cojGKxbfQErbfgKrrz0Bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPBRl0qD1G-8b_LUr2ALgvfEn2Swca4maA8OQ5J7sxyg&oe=69AC12F5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65CGZxPU0mwQ7kNvwF4IAK3&_nc_oc=AdmEG4vL0YJ-KNi7FFdNx8Z6whmMNDjFdwUSiaCAKOVeKoKJPoPwakShzgEFsh16Cog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6wtaeVy1Ew2XQY8sgBF5TViHOU5_gi8DIbiJO3aF3Hg&oe=69AC1112"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN3lA7ftpb8Q7kNvwHf4SJy&_nc_oc=AdkkUaTJRhutf5QsTo6wkbGhRpc8s9atMCybKtELUAggLZBMYlTRUBvURH7HLa8ekbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsaZRwKKGzvvcr-8mP0ZUAjikp9dW8vvQkEhcvMAy7rA&oe=69AC14BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard2.png", "id": "3905640413031407", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393296_3905640416364740_811687506602555392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVgAyKArgqIQ7kNvwHuSX4q&_nc_oc=AdmRHpPLn6puALvx_L7VhCBXgbiEeTlhYMsRf9pOU3ZBh8gksLwFUGHMuzBhlZS0bi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzdJGirev-SmAQerEbwgBTn101ZvacMOCBm4ut8JCxq9A&oe=69AC0F55"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "fast", "hands", "parkour"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "r
c_sid=6e7a0a&_nc_ohc=E0-GLw-6bgEQ7kNvwHH2-ko&_nc_oc=AdqW0NXvAOABwJ8zrVcgF4tGRkghThzNySFjs7crOeeGCEd6B_fhlTD-h31nj9qPe_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNQ9DIar81Esj1BbRPgthYWCI7t9Vr3Kjl567zVkyalw&oe=6B0320B3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D-HIh0cRPcQ7kNvwFakPzc&_nc_oc=Adqa_rEU_r6IEitezh7bGAd_9ER-GC-P1gYhvNoAM6_VTubiF47Z-ThpC58vun8rjlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxKl2nYwoFCrHbBJ0t0zY_T7rEBS9j0DwGuDWZ1Ck6fA&oe=6B031135"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpGod_w5aNIQ7kNvwEu9DYM&_nc_oc=AdpJ70ndjM8g3xzdeqOxk421PVzUekJIQTk2p6fRiFiwYteTLSD09FRDIrc37UCyzPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAwr6LXbVxDmVK3evrEnFJYHfrkWrkLVe97WPfBkGfAA&oe=6B030F52"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX4Oh6ISfMgQ7kNvwE5i9UP&_nc_oc=AdpHv8Xax1eOp755h2wF10y_b_ttF1tqae_2CGj7C17uy9A0SJslnttdeAQVBoB4BN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShR-CJ-tOFNLUIK4Eyyc4zbVDRDR5yNM57uNJp9Ut3hA&oe=6B0312FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6ZUpfHbyCAQ7kNvwHJFZrZ&_nc_oc=Adq-S6zjjWPlBPqx91eYRIlYzAFN8tXtRsL3c5JzJf0wgf5HEH8T0tc4hMYfd2X_fv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDsU1lZC-BYNsRVgeC_zEzyOQ8XYQ7QU4U3nDsEqBzxg&oe=6B032982"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
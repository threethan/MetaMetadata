c_sid=6e7a0a&_nc_ohc=LItkbmmCa0gQ7kNvwGA5Xgj&_nc_oc=AdqFgmCNFQ5KBsj_B_DRMqReLhcGgxTmUu7KHlESzYFxZdSq05zo6RJBzqxXQcdS-SA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8riumxXQBMkis0v7W285SWXyOl3XKKCyO6bCdrqLB7w&oe=6B0866B3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBYcxKXkPNwQ7kNvwFG5I_e&_nc_oc=AdohIDbEvf2mbycIjK06weYt0mv3phveig76AKHrXAGerdSFWO6ilBuCPkZq68JvFqQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1iX6veBmP2VrqJ9INHDUhn7kL6vtaBnZTtVE22vihVg&oe=6B085735"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H59XKlN6ue0Q7kNvwFRpqVS&_nc_oc=Adqy01dCleO3lPxTh7FKzOhIqCzX3ii9c0fE3sHUDIidZdSwEP9dMZopzVwoTdqVs3s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1DXnVeHzyX9SWTy0SC16HmzbSVvdVEjfscRLPr9fYxw&oe=6B085552"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qca5cgwFbIYQ7kNvwE01JkQ&_nc_oc=AdqyPPXg-XYyiVs-CGtQDwFtakoCSANW9u06O8wwKjl_DufAcasGi1vS2ghUYNCEQGQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbW6XwSiGqnWLkf13-eLKPUncIzP4NWV9ZYfzGC6LUeg&oe=6B0858FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlI8Px_1Fg0Q7kNvwEVOU0_&_nc_oc=AdqZYvmxLx9qJPDWh0iKUQBWngvVUAs7u4HWZqZ4xSpjuY7ze3FspttgTwndOWnSI8o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_q0AkvDWds4rbvYUpugsfxN5pgtxlK4hvKlt2wI4ezw&oe=6B086F82"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
77_1255018382614487_3210111925376922250_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIviHbQGwOMQ7kNvwF_Sj-N&_nc_oc=Admmnm8_w5k3UxdSO1CfnforA83PhaisUUjTfltputOBg6OuPHgkaNarBjP3Fk8nqxI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8E0MEtvgRgvd1xBRQjL4MYG4vhBZ-p3om9ehiyekCLA&oe=69AAD0F3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG-oAHjzwiEQ7kNvwEd4T06&_nc_oc=Adnufn5StuEpeBj76c0zGGzPORqhj46Q51PqFU3nVYpyy6VaBI41lTtUaKnl-_3m_28&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGxhh7PzbBTui8JIOrrA8SkBHO6G-AHDlktse0kL_8aw&oe=69AAC175"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65CGZxPU0mwQ7kNvwHsUpue&_nc_oc=AdnXhLeVEBSkr5SktQGFFThk_Ib3zSV_iQyrGfi7JsaNdxxhASTt9lG-Spn267wz4Ps&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw19OBDDfvHFXp52qPM0U-8apLrn96ibCJPePOUMhmZvg&oe=69AABF92"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN3lA7ftpb8Q7kNvwHufUf9&_nc_oc=Adkv6rOE24P7bHlkLV_ROZuGzmFrQmE-vBANafP_CClZIxCs-L3yr6SkaSdURXCF7bc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8FtmUGL805NQlcFftKOU3HXZaezsppLCTnwQxD6_GbQ&oe=69AAC33B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard2.png", "id": "3905640413031407", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393296_3905640416364740_811687506602555392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVgAyKArgqIQ7kNvwESm4ic&_nc_oc=AdnqD7zffLArXV3nAsG4JVKNH5XAbwTRnma1N_qAe1FosYfPfkNAEsp2cC06RqEywsY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoIIE1piJXHsHGi7CUqBRlYl6sJGE0U6F30RzUY3zQJg&oe=69AABDD5"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "fast", "hands", "parkour"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9062862733801489"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1447564243833172"}, {"status": "PUBLISHED", "id": "897357752990941"}, {"status": "PUBLISHED", "id": "1975543726629844"}, {"status": "PUBLISHED", "id": "1027074202704905"}, {"status": "PUBLISHED", "id": "767835218990188"}, {"status": "PUBLISHED", "id": "1252653216573053"}, {"status": "PUBLISHED", "id": "1378745176471743"}, {"status": "PENDING", "id": "438433075753459"}]}, "baseline_offer": {"id": "897357752990941"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1447564243833172"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24000610792933438", "version": "0.76"}, "id": "7724922847621317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7779118745509234", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24000610792933438"}, "release_status": "RELEASED"}, "binary_release_
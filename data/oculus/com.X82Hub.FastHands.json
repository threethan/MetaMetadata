c_sid=6e7a0a&_nc_ohc=WBUhGWMlMuYQ7kNvwFDF03H&_nc_oc=Ado3xCA3fhK5bL9BhTkJnJxVCjmBIwSd6nVlvrMOTQZqFJbi5L-ZeAeTkxvYcmQ9xDM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRedaqzIeuTlu4aBcpog-Nl8xtLSkjVBTq3Rkk3P0MaHg&oe=6AFB37B3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEiXAkXxeUQQ7kNvwHz4eBh&_nc_oc=AdoyIk92LzJWadSYSU3LBO2AwsJvIoNAUoFV1qlwZJ3dEm4NSmCk2c_xCAUVg6NWj80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuyjqxnmU3jrDp8vLgvZYUrjVSq3R_DIAN6cTLR--FOQ&oe=6AFB2835"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFwLDchre4QQ7kNvwFJasnZ&_nc_oc=Adq7q01r6g3dgMB2SKEN4VaaiMS_BtI8ShFhlIThPYPdXvCyMGpY4SPWg6wc2C8HnYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLByF-REi0pZpRgIsrnyot9Uc-Po3u4ckNSppKTNhVEQ&oe=6AFB2652"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrDUVYAB_wQ7kNvwFLd0Qd&_nc_oc=AdqUtjAbOpazF_kdzLyA19C0JsxAODJvrZopTZR_GDbo-KZCeE5utd7YibR_r0qKS_4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFMz5wHkqLJg5W9Yu3bljlEooeAjWOMZcY7zC9Fk3U9A&oe=6AFB29FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2p2pYjjBcQ7kNvwHh7eq_&_nc_oc=AdreYyTUaPD5ic6-DqKHIqMoGx7VkXYVxux2n6fQIrWCtrJ8YcgSeMAkpVtKgSNDhKQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw2ZA1mNgHp4dAMN-6Hcs6edo3UAcBcirs2xkNGUYfqA&oe=6AFB4082"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
luscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET2FIAe_QyIQ7kNvwHA8ULh&_nc_oc=AdpdsbCj0UuPKhlA4M5-SJfCoGcUreuFSS8MSUeQ-EYOq-LVJwqO1RtZt3ejhG3O36k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRSuX_-xKKzgZvdKyoB3HL8DLtW5HeWOdoJeR2zQqsSg&oe=6A71D3F5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBBs60absmEQ7kNvwFbwfHk&_nc_oc=AdpQHYu-xZE5Z8RkDs4agtKhOSu7kWPPYTMao8M0k2ebk0Ql056uB4VDyJZA0P9xvJk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXhTdQHk1TMkxVPgl183sM8MU9cFHIJR65K_SWgde60Q&oe=6A71D212"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnhJVNLuUaEQ7kNvwEMAV2W&_nc_oc=AdoY24ZEzHz1vgxDNbcrYtSi9B2zqkwW6mdhO70VctnjyKrB9eAkBoTim7tmacLd0XU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFVg6G2XvlSVSEPF_q_sLhonTBilXDhSkoXQ-ghFx2Nw&oe=6A71D5BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1kgmJ5FkrcQ7kNvwGb842k&_nc_oc=Adpmk-rS46yiW7CU4GYdJ-UpbH1JcajznK0BozERPZYcMc5tHziB8fE77g2LRelmEjU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuMMAXkwGdkz7jx_ob958yDFRaPs2cMaWwKK8X7IBXjQ&oe=6A71EC42"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
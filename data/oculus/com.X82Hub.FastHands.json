c_sid=6e7a0a&_nc_ohc=DAAjUw5j3PwQ7kNvwH5bZvA&_nc_oc=AdoZg2ru-45CxhMnP5yt67Rx7zBjUD_oZHQEgDRaSjKZR9lWWjhAImHKXEyq4kYD57w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0s0CVe-cA1BH44bz9UFl6sQnLcUTtCcL2lIxBWX0tTw&oe=6B007DB3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D-HIh0cRPcQ7kNvwE_4gAJ&_nc_oc=Adrw7xSBmgs8-w7S6Ew4_elpNafawFWn-AlOP--eRu12QV7qalLm7XuIUhoXrhSfd9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkuk_lBLEEDP6JGrFd65ueF7ispui4ah8W99MqFngX_Q&oe=6B006E35"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97z_aPjyBRcQ7kNvwE9uVFe&_nc_oc=AdqqKXuZfhX7xcHQJbwlvG4XIjPMtMvOrUauLOUdaRer4XGCY7p56Tym4ygRj-8kFNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMKVWhnvNGHF-EVHtGmUgpBhEoqVg5sljIwq2XCZNnGQ&oe=6B006C52"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTeMNlXEUowQ7kNvwGa1wdI&_nc_oc=AdqR3MX-cE16KmwBevM3TTEuYqO_pJGjV-etO0gQ8zT0K5Gq4AcnmZViCKv9aKEhOfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFxb5SqVX0ArmLvbjx4mya-PMcL6CFeH7H1pIDImeGmQ&oe=6B006FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y3qmd2ioPIQ7kNvwG4Znrl&_nc_oc=AdpQYfwPv-xaJSYbZ8VisD6YfPykfZzkMaynlpShLHuHwW1ggUkzvIm0TbTlEKWMZ4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2zqkQcXKNWOoua0b0-bvgengttlsWolauXXui495a0A&oe=6B008682"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
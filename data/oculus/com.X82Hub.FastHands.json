c_sid=6e7a0a&_nc_ohc=E0-GLw-6bgEQ7kNvwFDHIv5&_nc_oc=Adp1OF0yyQB9ttn3GsDkDNFRTlHEQ94OJ2VHs-5azKxAj1waeo2uvVhm29rtQYXEISs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNhYjQ1o_wUXjVD6sy7T49jTvZ4XTpRKZx42tOewRazA&oe=6B01CF33"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D-HIh0cRPcQ7kNvwFDnqlk&_nc_oc=AdoXHqDFVMVzYFDn-Vt9bVFjH4fHPhiWKAOHMzMOCmXNUTju5T469ssNyVTv3LY4j1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK7_LwFF7jKigchizgGK8qtvJFD-1eEl7KKjSf_Lqx2A&oe=6B01BFB5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97z_aPjyBRcQ7kNvwH8P0wK&_nc_oc=Adq2dJfb_HrLgEp-1jCV56PB1gUerRzx3Krioz2ANz1UVlsxcid3wz-v1JTqPsCid-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKjXzPzS4-QX_AyQgDAf9TFIheWJWGH6oqCCxGjX3WZg&oe=6B01BDD2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTeMNlXEUowQ7kNvwGHe-gB&_nc_oc=AdpnyHV66v81Ag4gcXVbbtAVfxwHtzy_iSoF0pfkINJn_Dsfkz6Gw3Ofs-SLAgNpqP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzYH5-fwivnn4egqS0OiVroUNrpcrb5eBeHrH3xzLlVQ&oe=6B01C17B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6ZUpfHbyCAQ7kNvwHXgfDA&_nc_oc=AdoOFwOxMqdGf0-A8Stu22_4qwbptEKTjsv-Ffr6iinUauusfEqkJ2i1x2Z-2DBxsNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo-ktSrfQPELCkFTlpkP-CTI4fh-xrHBHWJISBPaJFDg&oe=6B01D802"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
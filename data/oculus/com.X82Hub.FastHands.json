luscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycUfQtJzRooQ7kNvwFHxrax&_nc_oc=AdqAeRh7b_kQd-peUjCzgvI31j65DkWrlipIaITvUnNCTxkCW5P-wijfXP8LZCPkVds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjpcq80_1OKLRjc2e9fNU5RmAeGAeGbFd_J5h0a7N6rA&oe=6A4BD0B5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCj30_IH66IQ7kNvwE5hTTS&_nc_oc=Adr6pZvLIOnSX7AT5xX3LFYqEeoKKmxrF54KRV8RCyzz-2tUW5uWo8ZqPKSe64pTdZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD7Kpyc2fy1VMn4a-pEfe7f-mT35nzNwrN-Z-8WsdqJg&oe=6A4BCED2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob9C3x_HJhYQ7kNvwHiaMwb&_nc_oc=AdorHjl2waaEuvwbno8XEWxGjbfKIFLO28yuFMwJCfT16yxJeE1iOpa2bgapejVMDFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZqJEr1LxW31o5FKAqcrOst-X-mcPhIpSwSiBPGPwygA&oe=6A4BD27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-vZu6fNDlYQ7kNvwHDM3aV&_nc_oc=AdrVzTsy0_wjOFc7cVghJEu8rSaG6bSnsMwcmiE_IPOmdHSrmzdG_cbpeHKMka9RyyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgcMxNAQc8b9byRW_-LAvQQkTN4mINtioP39ZIRmd9Yg&oe=6A4BB0C2"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
0.png", "id": "689484040235597", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392019_689484043568930_3174989992487122043_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4XtgMu7cSoQ7kNvwGqZGYv&_nc_oc=AdrnerOpAl--M0gCxrCCQmVp0qmIIGqSkGPveOnbkcx6QFxvNUdL2j6WFPPsLTxJJB0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zLSoWDt6aGL46h19QzCo-Tv4m2-tf618GemaR_Epi5A&oe=6A392C0B"}]}, "id": "584729647783710", "locale": "en_US", "screenshots": [{"file_name": "cityCourseWithBoost.png", "id": "918194110344673", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031400_918194113678006_9202435513813076985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hAfdzy3Uy8Q7kNvwFOM53M&_nc_oc=AdpGUXBeAuVMQl0msFRctIgfF5-iIixCT6dqcSL-E3PMTqP8v34AdgwokvaPyxFZ72o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cBr8IWYDMbUQC8x148gABOFCR1tun32IS2qEaftwL-Q&oe=6A3957CA"}, {"file_name": "heroLanding.png", "id": "1255018379281154", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974577_1255018382614487_3210111925376922250_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiIZZ5bewPEQ7kNvwEtEyoe&_nc_oc=Adp5mRhcscvxQPXHvLqdXkzMaEIfMT9qe3hBcpDBXsX5fexqlwDKvjrAPFjDMMrnbL8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nAjwHlKjg6OAxNB9ZUFgvt-CAce6CFH1rHaeljYnz8w&oe=6A3932F3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK_msgcw6WoQ7kNvwFGtIdn&_nc_oc=AdqPAZ1W8FkgB8xN6Zi3ebNlpajnBem35ncKYutR3-MjoRrSLpSwoXhSaA0PDSHX3wo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6czTmDqiXzLeTeNnHsvcNKvhc3gWUCtXVp6-TZCgEfw&oe=6A395BB5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt5K15qwa78Q7kNvwEZCvOY&_nc_oc=AdqmUqBNgSpCsXwEjqLX4tJ6XkOnOtfSk3oYE0M7R7azOCZ2JyHUcTzGI852lPGHT1w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OyZTJkB1lVOyPF9jV0zH0bRY0cEdbw1FYNnPpBkDmgg&oe=6A3959D2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN1hNEQdnnsQ7kNvwGGy7er&_nc_oc=Adoykj2bNWvwU9AUGQzx_E73QxjApmuOnLTLlGxSFuV-jDWG8din034CVLr6WSiq7MI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IUT7GbfmbHZnljKTL6-cD8xY1aekqoYt5yXS4K_LdAQ&oe=6A395D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard2.png", "id": "3905640413031407", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393296_3905640416364740_811687506602555392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0ydUxLpWrMQ7kNvwEv7JKo&_nc_oc=AdoJAYa8jJPtFnbp9HoPS5wfYA-UT2IrlYFYxUVKs86nnqSTFzcytVIuqQVH_OYjMew&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kvPltoCTGPl6WMZWqZW21MHKhtiVODNx0HepaYUqg5A&oe=6A395815"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "fast", "hands", "parkour"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9062862733801489"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PENDING", "id": "880146315017101"}, {"statu
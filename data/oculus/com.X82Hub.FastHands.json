c_sid=6e7a0a&_nc_ohc=P2QgKjWhFekQ7kNvwEgyTzp&_nc_oc=AdqjxMFWkkJa-SFb6CaASjv1YqkiA__uZzcLtfA8oILdQMyyngHzb-HQ5c4u1WSudVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLqts6YR8fL-5SceDeXxmXR3aIKlVXZsnLBfaV4JaiYg&oe=6B0EFE33"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR_C4L3auv4Q7kNvwE3cNoR&_nc_oc=AdpGx1YZZL5sRIDtgjOW9Y3tz7eiGf4dId54MQk0N61H9xBDKO4fIgICQ_JHwX5T2UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8zppK1PVd8zJDyhowHKJKwDi0a8Hc1hRy7deIYoSWHQ&oe=6B0EEEB5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYqL4FaZ6JQQ7kNvwENX369&_nc_oc=Adqmg5FarQKCFAsKWUGFygn7TH9c5Lr7CnUwojFO4ErsOwZU1pkJqGYCn4deGJuYoVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWlw5yuzaPWWm9jmkZ1wFO39JAt3u_tAG6oI9sZLcnWYw&oe=6B0EECD2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5jS2ofkhNEQ7kNvwFabzM4&_nc_oc=AdovC5pw5ww5EwavgCUB5oNpjL5iW_FZWcYSOkL5bAIrzi-o1hVouFeTT25lsgwQZSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIp_CitCD3ZccLdFZq9nXySK47WS4H4NTTA1VLvCYjYA&oe=6B0EF07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzzNU-6UWeIQ7kNvwFJK8U6&_nc_oc=AdoRuth6lNVg12oUngP67FVOlBRr9Bx4yABql2aAOJPct_K_6x8mkICwjO1oqPKJirg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX7uCG9fFAbm4m0z3U5yecZ2jK60Qs1NEWAtVqZT9Uygw&oe=6B0F0702"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
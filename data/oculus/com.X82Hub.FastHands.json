c_sid=6e7a0a&_nc_ohc=P2QgKjWhFekQ7kNvwG8fiS2&_nc_oc=AdoI8JVdPOQMLjROtkteLnAXNfTignfKV9MbYR7aQcPAkYRvE0EtuWQmDxOhbfNKp4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXAtSIuguP7ph5HICnoMHyfsFR3vNdq4j71C4N4WPorw&oe=6B104FB3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E4eLQUeRp8Q7kNvwF6lTkC&_nc_oc=AdpDDz9truaDL47idOl5NklQ2mfUtjtXlErMMn_V7L2NbQzaaFmi_Nmnu1WgB_Kz7fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVOXG-koUol1KxnQW1BoFNYP8qbCxncI38BPEczUJu4w&oe=6B104035"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYqL4FaZ6JQQ7kNvwFw675h&_nc_oc=Adqgasq74AtvvUIWJm5xjT1d_C1enmqrWEwQXxiRaIhZ9W1TUiXQDgBrqNQzV_Cr8oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhlligRYCSZR941ZRfsqLFOzCuPeNb5oNidPfligDWQg&oe=6B103E52"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5jS2ofkhNEQ7kNvwEXWX6s&_nc_oc=Adoc9g_IuBCB2MZvxePuUEkqrmasmvWtijPVYv30xdD_DJRUy2bYwpR4gUJKzs37GaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrmgGWAG4gZTftpiNn3yHLMvVrr98yEMSrwkK4K2djdg&oe=6B1041FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzzNU-6UWeIQ7kNvwFjBHtd&_nc_oc=AdoIpigQQXIMSLD4pbMoJDDCHiNaASdh-xnNW6a6GNQ0qb821Fl7K6iTQ7N2tNCnydg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_N_xzkHmYRNejc1q3SbI9qA1-OCrA_I6oHbZeSIlciA&oe=6B105882"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
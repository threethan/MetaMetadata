c_sid=6e7a0a&_nc_ohc=GbbIuULkfAEQ7kNvwHOr_zn&_nc_oc=AdqI-sLcsjifudd8LyNeUK3JxwkOZ-K2zUeyzM8FCjEyHKN3200mMo3kKvb8m6r1lpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCdvcZ8u5DsAJVDwYENbcIp3an-rPS6vaGnKmfE9BVQA&oe=6B0C5B33"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR_C4L3auv4Q7kNvwHvUfMV&_nc_oc=AdoT2RakODdVKBCfcBYGdHpulfEWM6_EDsCTsyVA5Aaf41Eu2wJlNIea---JaW5IbMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1SfEY_SvmbRG9Du0ptZrD8Y5CJc9m828QkgyOrMvdqw&oe=6B0C83F5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=playiOPqLyEQ7kNvwEKtXQV&_nc_oc=AdoCpAjL6DP_dAloBs5W4yQpgGqBws6mvZK4TrEocjK-8_AzXFnX-gaY-PSLTMosWLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsrq7fxmoZNi47sAjIxfRvWyMMjtVEhToYCRZYovp1Mw&oe=6B0C8212"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbJsGvX-ch0Q7kNvwFadWYO&_nc_oc=Ado_gkVYjvvbvaeD9lhm2_xkaki3eKSGvlBANooqSRz45M4xe1S0Nd2cAO1zUr_EaFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVmkQFMG7xCB8IAJ7fPQ_icW0iyDymbkaoX_l1IyRxjg&oe=6B0C4D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5Vf1YBQCQAQ7kNvwEirk-U&_nc_oc=AdrSgITtJbTHnw-rKMueFPXG55qqB0-Zd-CLFR1hupsliInE125x15pXTgLHD6JbO-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFbm11su-t7PLNRb3VeIxz36Qt7G5ZutiJH0V9w9YrRQ&oe=6B0C6402"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
c_sid=6e7a0a&_nc_ohc=GbbIuULkfAEQ7kNvwEUwtlw&_nc_oc=AdrlOBaKohRalZnwne5Xwb8tykkccwWydV4ga08vHTrPWBqSwJ_F2x0-appfnpCZLKc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZpFA8p6jGDivEQtjiex9ckS5nf1m3QDf4oVn69IREMA&oe=6B0B41F3"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBYcxKXkPNwQ7kNvwFAQd__&_nc_oc=AdoehVBju80QhZpe0EufBVUZQEoErB05aQxcjjq7SVfu9dOgU7R3gTl1R20daWjrac0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxeBePEng_H8pCayXkZpldUWa1UcrTqFvXk34euJSsKA&oe=6B0B3275"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=playiOPqLyEQ7kNvwHGObW5&_nc_oc=Adrzew9fMuRdveItIsXMa1GT8nMwJv3Zx3zQg24pqgocvNr-DYq5cxAoG6mFpzCGpNg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7-oIxua48BTUYNE_6n7oiqaCEegGCgRW74CmlEFEZkg&oe=6B0B3092"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbJsGvX-ch0Q7kNvwGFODkC&_nc_oc=AdozPXfKXot2nMlvvR1krkkGEXLkz5SmhFILyvXD9EoQ9v2szrEp_RYP1lQ-HH1P5cw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCZK3xBCKaK0q_fOwbKkXIHRyiL94M5GYG_j_gFbJtKw&oe=6B0B343B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5Vf1YBQCQAQ7kNvwGe4gOs&_nc_oc=AdoNdVN-g6jEkR7ISuuDKMOG13r3jUYIN9Y9W-CgPSqVKyOgOb0mbbSLRs6aiHkVMUo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFsUFM1ty39g3V2CmMMpaVpSPE5n0-e8qsmuXkS6K0AQ&oe=6B0B1282"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
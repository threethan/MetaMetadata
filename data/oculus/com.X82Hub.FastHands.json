c_sid=6e7a0a&_nc_ohc=LItkbmmCa0gQ7kNvwFOkikG&_nc_oc=Adpz3kHLkoHESoxV5PmVhTe1J0K5N8tmPDOoTiCwJ38-y1Jnz7Y3ZFKeW9IjlF7P0bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUqZ3Q1Nz3y3jz_Qmw_wnzZ00FxFwmfgwc9z1jwNE39A&oe=6B071533"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-8NAFlEZ_sQ7kNvwE2j3nD&_nc_oc=AdpxDuVy79Kzy5x1mXQ6M-9H3Um22Rn1Vsf2--qsRuaMRZrQTYehInK7rjJgDJEqPVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYi5igVrBsR1I-9ioeqkI4J2OuMpYpI8xHJN4mK4A1Tw&oe=6B0705B5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H59XKlN6ue0Q7kNvwEF2tNW&_nc_oc=AdoRHZ3dhSw7GbVXDVnFuNYKruKT_Kx-VsFboGeQY4ZNEEiO6LC7TcMBBRRN8hAsB0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREoQSWzb4XIIFsIkF2tUqBAvkBdch3kWr6tV7K7yXHsA&oe=6B0703D2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qca5cgwFbIYQ7kNvwHFMpIu&_nc_oc=AdqQbGeZWh18wdJokQj2S1mIcB5wuvzk37h6POV0iOxrLbOX8iBxWfwurByhECGuucY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYTH8xSoI4MtKjGFhpdlPffqsqBVGluDVhbQ_x_FNhew&oe=6B07077B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlI8Px_1Fg0Q7kNvwGdtuVl&_nc_oc=AdofdAlHTLYZtdpcgYSok34W1MVf83CTV3oxHqtSrC2WRvBRz_qS5B9zIYOPnOGjmuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUPqhIG1Www5v1lXKOhN9bUO2BZ9cOD4xYOYHfcloiRg&oe=6B071E02"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
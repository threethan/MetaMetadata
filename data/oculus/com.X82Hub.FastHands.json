c_sid=6e7a0a&_nc_ohc=GbbIuULkfAEQ7kNvwFvinps&_nc_oc=AdpZ_7KGjYqDvZCMM0NqgRunXbmgNfTJVnDkgvAGnJ4VX89Tm0eqiWDZITlIluCvq6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIc-b4_vmVURyTYVwuGHDzltg4Xu3SZL9g74O35HMXwA&oe=6B09B833"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBYcxKXkPNwQ7kNvwGEIpN5&_nc_oc=Adpbmn6kF9wl0o55r3fF7kDGbnUa-wbeTj5jktwbanATYLtBMw--fVFo243pH-OkmLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_tnt6h-HfjSu7EuHj9qBuRO4X-lXh7wKChzfZlI7adA&oe=6B09A8B5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H59XKlN6ue0Q7kNvwFJKLHz&_nc_oc=Adrl8w3TzAKrLbrosLNsboOrmKukc9TMwvjHbuA9MQH1xlnG_3Z7XLgizzIG2EC8oAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGLhu3qUIMQQXofZbWpe45jT7SriLW7EYQWgCt589Abw&oe=6B09A6D2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qca5cgwFbIYQ7kNvwEwquOG&_nc_oc=AdqxNx_GHuQ3zEjdGPhwPAt5yQWKhbDw842oc-KsvO7qzxJHZ0WNBD2BZnXU94Ewilk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgdEOC0Lga8bEmrYM92c_S61PshkU_yzWfjg5svUsiJg&oe=6B09AA7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5Vf1YBQCQAQ7kNvwG7dZH_&_nc_oc=AdqYSEC7U5m7HzFGIGfHyFh6m5c-742UUOTtpLZsfz8WfWnlh2ha6DcSeY78vPtVj4I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEDSO3AbnQz7Ym2FuWKWZMG6zruKZcRosErHSiQEaFRA&oe=6B09C102"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
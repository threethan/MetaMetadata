nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyLL7oNG3tIQ7kNvwGEzGnk&_nc_oc=AdrJh_nnrYT6FPC6IywcGpupScWhr7V_p_HkcYoo1u290cOQTwhk0_4b8Jh9GXZeZLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xu43iGksMOwOEDMIRr_nhvnFQn8HgueJFqfx4JpMGWg&oe=6A3FF152"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt7FU_KNitcQ7kNvwEVey-d&_nc_oc=AdpH6wJBy6Ahoemg7cYfhMIKdA2BIpDCUeb288ntMxafwY7N5x3lNSx9HYjohoxZfUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z8g1ZO0lPIuwbnp_BiqvMFwvEr2Oon0sBADyrD2qHlQ&oe=6A3FF4FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard2.png", "id": "3905640413031407", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393296_3905640416364740_811687506602555392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj7S4t71u6cQ7kNvwESf6Hn&_nc_oc=AdpAmXCUHtAcnOPkG06ZKZmng6flZxX6d1b8UYW2wNtYF3jc8NtDU9j_PuBynU6IUA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vLkRm8fmEdsNsz8vxux45MB6JC0ZNnbtSmb5i_JJKnw&oe=6A3FEF95"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "fast", "hands", "parkour"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9062862733801489"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PENDING", "id": "880146315017101"}, {"status": "PUBLI
c_sid=6e7a0a&_nc_ohc=WBUhGWMlMuYQ7kNvwEVNBHH&_nc_oc=AdrzvGzcZ9Q2zsgIpBY2AqIbGMuq6f9C38W1cBUkiCrZge2qReLlKBbviZy9_2qZlN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHGiu2WCgDYwMoMT25DtDY1jryRoahrII3yS0FfnrpAg&oe=6AFC8933"}, {"file_name": "tentacle.png", "id": "2138524743252892", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5aY9vcHc3cQ7kNvwHih11S&_nc_oc=AdrIbQCWoM00DlyqBOs8aND91omMociQWGRnDc_nY2icXGw0RDZCXuGgLsFkIMU2dS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAaKDq3EV8wCGkSC8ZrQyHxfo0vH5GkJcrLaB9H7NtdQ&oe=6AFC79B5"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFwLDchre4QQ7kNvwHnExQM&_nc_oc=AdrlqKT_YEnyWijzJFgpqxR-HYm6TybadnbIbmfuOkj-z3RVUiJdHlVbq-wRr7LTztk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgH9v4Y9UnVDq2SvK37l1SqmNoHX9OAn2NVvomGYyvxg&oe=6AFC77D2"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrDUVYAB_wQ7kNvwGVgAE2&_nc_oc=AdpbMYtF88xi34jIhzUH5nxPoORCkQ7P0A1VvQFjvIHD06hIh5jF9zrYyxeenDGf4hY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzU6pw9sSS01lk8shBsnU1wX8-R-rDS3cO9VLq0GcfSA&oe=6AFC7B7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2p2pYjjBcQ7kNvwEvkhYM&_nc_oc=Adpg8s3PKyfzRabCGg88XK5IL8ZyN4TyxkBrBwyo0h5ad74lPk06VdhFC9Q6YiBwT2o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrR8hobio52sG9Bc-GiQo9p38dFwcHr5YOBwlbeRk_oA&oe=6AFC9202"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://ww
luscdn.com/v/t64.5771-25/473392000_2138524746586225_2468302000013179619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wqHCj3C38EQ7kNvwE01kS_&_nc_oc=AdpKAAjM4v0KpO9k3noslJYFRp-wDzXpYvNkWZYYNURp-RXW5L_Tq4rpdmgYAwpJVXk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5GIJbVEMXZftJYUwD9PnyafGBU-bb73sA_p7lbwcXkw&oe=6AD0F835"}, {"file_name": "explode.png", "id": "2675324299307062", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031339_2675324305973728_4148753447517642994_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7A3a8mTf90Q7kNvwGiTh4v&_nc_oc=AdrmLtndRaQVC2E6Yu0cJgAcRynP5dBOfb2xTOJfIM0OJQCSg4y9DNJ7oTIunJy8xew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNyk8G3FlroORag6g784JeOFQvn-P3yBbQXjJh4_7Ujw&oe=6AD0F652"}, {"file_name": "candy.png", "id": "1734743227293627", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982472_1734743230626960_257785020843435295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8J2yhAJFLAQ7kNvwFW8oXU&_nc_oc=AdpWnzI_aG96vC6n0kalRlNTYhiaRjaQ-7DRZf5ilwG_qLJfVFz8jagwMw2IQKkCpYM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsgZFao6ilVECGq6sg2h-kpLF8zgECyMDuJxp7YoaXZg&oe=6AD0F9FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCard.png", "id": "1001464072785527", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303445_1001464076118860_842445343369425976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRj-N8SE-hYQ7kNvwHHVzYh&_nc_oc=AdqmPa-gcgFLd5cc78lUX-ekjcMJDqonit5nLZgxYwumOlVAFf62ZFFLFVShnqZ3KrM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoU_t616Ll730Z8ABR0O8H6mDmBgWWCsxhQm33LZFMng&oe=6AD0D842"}, "display_name": "FastHands", "keywords": ["sport", "sandbox", "parkour", "handtracking"], "long_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player). Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find.\n\nOptionally play with hand tracking for maximum immersion.\n\n# Must-Do Experiences on Your Visit\n- Run, jump, wall-run, dive and glide through the air\n- Climb with ease using spider fingers\n- Hit boosts to feel the speed\n- Shoot targets (or friends) with your slingshot \n- Beat the courses, then randomly generate your own\n- Try the mini-games and special multiplayer modes\n- Explore the anomalies to uncover Abraham's story\n\n# More About FastHands\nGanymede, Jupiter\u2019s most boring moon. We blew it up, harvested and entangled all its lovely Quantumite and replaced it with the FastHands playground. Hurrah!\n\nWe won't bore you with the technical babble about quantum mechanics and superposition state. Just know: courses form as you progress, everything can change at any moment and your reality might not match your friends'.\n\n**We blew up a moon for this. Don\u2019t waste it.**\n\n# Feedback\nChat in our discord channel or contact us details:\nwww.x82hub.com/fasthands", "short_description": "Welcome to FastHands, your ultimate parkour playground. Run, climb and glide through quantum courses - solo or with friends (6 player) . Climb the leaderboards and uncover strange anomalies that hint at a deeper secret the company doesn\u2019t want you to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.x82hub.com/xr_privacy", "developer_terms_of_service_url": null, "publisher_name": "X82 Ltd", "support_website_url": "https://www.x82hub.com/contact", "website_url": "https://www.x82hub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
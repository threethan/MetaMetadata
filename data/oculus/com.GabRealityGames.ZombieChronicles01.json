900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwxDw9E07yAQ7kNvwHkfBnk&_nc_oc=Adr51cSKysdXOEsgr7U8ZPOyNflloZmlUYyieQ4G4504Y_zkQFQPzXmN8JGFSk3TASE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oWZjFaYEpTKpIwIb0QMEFI3Cnvq7dbRrUt09DONXohg&oe=69DBA764"}, {"file_name": "SS03.png", "id": "1374851667074674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312263_1374851673741340_5380439420373694888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3dVlW9fjHUQ7kNvwH1MYHZ&_nc_oc=AdpSgncy1b4tHwVQozar2SXKcBWrJhnDJvGpF7BJ0TyRsi7JcSu72K2JeTnVClRgmRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PubDVlpCEwLIlthFWdmf3M0AQ9MTURPaitX94uhj8eA&oe=69DBB1E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_RM_Landscape_C.png", "id": "965171399018963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392019_965171402352296_3358174462332795271_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2mBUHUwffMQ7kNvwGllzR3&_nc_oc=Adq8Meu-dm0PA4u_Bk4GxdUbqxgA4Mgllp3vVc3Yy9bb5yVI2EsTLKU3ZUjVe1w92zE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tVC1NQQHD0INIX8VIkmUR1zb84ALTU9Y9Ha6BzNrXOA&oe=69DB9264"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["adventure", "shooter", "escape", "survival", "zombie"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gabrealitygames.com/pp/privacy-zc1.html", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": "https://www.gabrealitygames.com/support.html", "website_url": "https://www.gabrealitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24325757950391346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_9371734396251194_4424294611047250590_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i10ON0KbGCoQ7kNvwHj7Hwt&_nc_oc=AdqRdoqDcHD0-CYTM-49GOdzt82A-7yDZDkHhsR7Dhn6CnXnEt9G6yeIckhz7RNFuAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HaJwVrm9BcjCsuk98We_YKXbOtqJ8x5FNPe8wheMpSw&oe=69DB918F"}, "is_concept": false, "is_test
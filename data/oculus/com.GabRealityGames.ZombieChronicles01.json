 You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gabrealitygames.com/pp/privacy-zc1.html", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": "https://www.gabrealitygames.com/support.html", "website_url": "https://www.gabrealitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24325757950391346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391986_9371734396251194_4424294611047250590_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOoAsq_eGHUQ7kNvwG3UwoR&_nc_oc=AdovzAkCyzRMrpMsbX4D0y1NBsrvFaAHhNSWbZkszXC3CXQXD0OqP8SmSLStWJBGRCI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3x5Wp5Mt2amHWHyG8OX7PBferwG4U70NZGPTrUtKZKnA&oe=69F1FB0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zombie Chronicles: Max's story", "platform": "ANDROID_6DOF"
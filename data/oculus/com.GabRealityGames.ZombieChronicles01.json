le_name": "ZC04.png", "id": "502927152793690", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974685_502927156127023_552613582031000704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29mODBcZNwEQ7kNvwHNFBSm&_nc_oc=AdokM1DiTN-24I822NiKVi1UmsX_xruLwgdTCTuY1-dnL8D97vpx6gcHodvQbGm3pCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKvjl3LbBgtDSpGJJo8vScn-tcTugk8RoE4jV5LCU2ug&oe=69CA7FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_ea.png", "id": "2643960702463110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031314_2643960705796443_2967927418195826185_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8Wv2jw7XpkQ7kNvwEUNeD-&_nc_oc=AdrxvnBjJHQfrU_LvhFRV0Cw3xK_o91W2_wkqX0gwPqpOmBGFwmTcfXmDnHoVbQercc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRa8k_A6PcCHnouV_VutYn9YxJ0gr45hIdwALjy13H6w&oe=69CA72DF"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["Zombie", "puzzle", "adventure", "shooter"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1jzWFA0bU7zjMM3vv8FE8krWicVuBLvctPuS1LUIOkbo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": null, "website_url": "https://www.facebook.com/gabrealitygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9018468104880246"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "26200742042920002"}, {"status": "PUBLISHED", "id": "4384786125116237"}, {"status": "PUBLISHED", "id": "1924138741860153"}, {"status": "PUBLISHED", "id": "2277712812686469"}, {"status": "PUBLISHED", "id": "1042526161387693"}, {"status": "PUBLISHED", "id": "1020379016901555"}, {"status": "PUBLISHED", "id": "638317469025582"}, {"status": "PUBLISHED", "id": "2008691436261695"}, {"status": "CANCELLED", "id": "879611720920458"}, {"status": "PUBLISHED", "id": "537743612590357"}, {"status": "PUBLISHED", "id": "565241456222088"}]}, "baseline_offer": {"id": "1042526161387693"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775588400, "status": "PUBLISHED", "id": "26200742042920002"}]}, "li
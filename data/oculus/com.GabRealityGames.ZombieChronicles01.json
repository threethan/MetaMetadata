900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc6_AJK07usQ7kNvwGVULGO&_nc_oc=AdrS2Huizzsf8BShQYh58IUEXpQWCU7IgJ2Spdhiun7zvJmcQStZkvOLUjKDbC8nXYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vyUlOccwmCzzk4IAQeZ5b5fKYK7nz6B3FXAgz-xMJnw&oe=6A01E2E4"}, {"file_name": "SS03.png", "id": "1374851667074674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312263_1374851673741340_5380439420373694888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzqnc2mKXAAQ7kNvwFtugei&_nc_oc=Adq5iJ0877O2eFo998almAR0UcteYagudyS5f0KKawLyl3GCjaFDt5cPvH33_QI1Sw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kCO-_3Nu8k1uc-RG8OXJqXo_uFIDXAC0qzfizb9Mw-A&oe=6A01ED61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_RM_Landscape_C.png", "id": "965171399018963", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392019_965171402352296_3358174462332795271_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95B-NPdKSXEQ7kNvwFIuS6C&_nc_oc=AdoJSAdkf9LnrCQdgg1J5NN8Am0x-X_Zuh-bMT9WBJjJNulfOxKS4-s95-_eNrNhlpE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A2QyF1Jk16NBoN1HscAvhYtughhpoQF-Bu5pCY32X-A&oe=6A01CDE4"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["adventure", "shooter", "escape", "survival", "zombie"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gabrealitygames.com/pp/privacy-zc1.html", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": "https://www.gabrealitygames.com/support.html", "website_url": "https://www.gabrealitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24325757950391346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_9371734396251194_4424294611047250590_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs6GZ06iDFEQ7kNvwGRb9U3&_nc_oc=AdqyXz0gmREWEBNQm6uc9Logcx2GsAB8iJ0dkSy1TPRdwAZSIO8bwnLRBSN12VAJnz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_wtC-gWLNlaSVHujOkT1VJeOFr92DYO9dyczNb1dq-Q&oe=6A01CD0F"}, "is_concept": false, "is_test
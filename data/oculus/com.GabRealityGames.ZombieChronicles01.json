BAzjVa4ybJDrtvYc0Sek50B6KAQ5XMNsL8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvaBrHzN1QaQz9u_dzqXL2c1Zjdgyro1q7wkoNdUHmxnQ&oe=69A1A564"}, {"file_name": "SS03.png", "id": "1374851667074674", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499312263_1374851673741340_5380439420373694888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFafwHt8ztcQ7kNvwEMwexV&_nc_oc=Adn2FPLeGy-1udDFrJvUJMdH7fNyenQZ3G21SbyALPM8O6u6b_Y83Aux7glmHhAkmeQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afstq5rhFQ7hYMNmyMM8MtPSUazmQ2XZs0OwmevLlb6cNg&oe=69A177A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_RM_Landscape_C.png", "id": "965171399018963", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392019_965171402352296_3358174462332795271_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDfCVevrGeYQ7kNvwHFexVG&_nc_oc=AdnB0uP8P_NKIIWykSWhamqtyrSKbyu8jofpCbCMg7UdMBkDw2yn_aqBudKAgAqL2pg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvFeeFPY7QGY4mAizZMSiq4Bm2uLNa7LXOY4QnilKbOvQ&oe=69A19064"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["adventure", "shooter", "escape", "survival", "zombie"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gabrealitygames.com/pp/privacy-zc1.html", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": "https://www.gabrealitygames.com/support.html", "website_url": "https://www.gabrealitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24325757950391346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391986_9371734396251194_4424294611047250590_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTfgzAu0PkMQ7kNvwGK-Dpf&_nc_oc=AdkOWKTTP8j1w_qCBxawDVnavgF9nX_JJP-I_yQNCfhj8zUjXXFNJO19IWgCQkLqnfU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aful240yUzfFK6GgzpIkXUyp-5sHrIi3jd-C40VrcvPvaw&oe=69A18F8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zombie Chronicles: Max's story", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", 
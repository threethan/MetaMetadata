ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUy6H-EkwCwgxk3w5zEbtu3BEnKO9M7Ea_5SDji6vHlA&oe=699DACD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_ea.png", "id": "2643960702463110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031314_2643960705796443_2967927418195826185_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwcw82tXD7kQ7kNvwFpvTyx&_nc_oc=Adl1Ktv4JKA8cqa_iLK5LIa25U89CFXcnW6Nw9vBu-VkurtZhPWq3t7inJoF_pos-k4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfseLr5Ue4EKZiilzSXKAm34fCr2e2KE9_rHQOal6iIsfQ&oe=699D9FDF"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["Zombie", "puzzle", "adventure", "shooter"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1jzWFA0bU7zjMM3vv8FE8krWicVuBLvctPuS1LUIOkbo/edit?usp=sharing", "developer_terms_of_service_ur
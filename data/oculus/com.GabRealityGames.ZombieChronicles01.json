900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1YizHDk4jYQ7kNvwH9y7xf&_nc_oc=AdqanuKGllHdD9bqtz-Q_dycvr_N9snEXWX7bkcSSQ00Vn3pYvwR-iIuiFJd_I-HEvo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsPWK9h81LqTBBJZhdvSVgPxq9AFQElkFHMhgnoHZpEg&oe=6AA016E4"}, {"file_name": "SS03.png", "id": "1374851667074674", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312263_1374851673741340_5380439420373694888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGbXRe1mm2EQ7kNvwEFZQvH&_nc_oc=AdrIBfVsXHsugBAYhkR6U-9EvYIQSaLsJDo6LISZWqwlYSWnHzk2_7jRBG7n1n1ZZao&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAKb20UPTGkWiXi95iYw38i-YPRGtyxDiSKIDWLodaGQ&oe=6AA02161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_RM_Landscape_C.png", "id": "965171399018963", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392019_965171402352296_3358174462332795271_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H01NsQ9yoGQQ7kNvwEO5PZv&_nc_oc=AdpxojAqEOZyfV3god18BfJlyA8Cd2IdBSQAgXLrp_w6kkyZxjCWKQhsaKzfJH3ZFXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVE_eF6qGbZkf6sIm-tfzejW5CpC4p23ONS52GpPj7_A&oe=6AA001E4"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["adventure", "shooter", "escape", "survival", "zombie"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gabrealitygames.com/pp/privacy-zc1.html", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": "https://www.gabrealitygames.com/support.html", "website_url": "https://www.gabrealitygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24325757950391346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391986_9371734396251194_4424294611047250590_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3Co5R9VzL0Q7kNvwHQLdVE&_nc_oc=AdrV4S_T6DzY_mX3I8I8bCLc5BUktsUWvLRzJXe-Cu5RjcmLISKK7J2r9HokKQyqzMk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO6iqhREYF_ZDemC6V2elZuMeKypiYWqFoB8Z0egibPw&oe=6AA0010F"}, "is_concept": false, "is_test
le_name": "ZC04.png", "id": "502927152793690", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974685_502927156127023_552613582031000704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Izz7n0WI3dsQ7kNvwF8WZS5&_nc_oc=AdoONAOHMXF7idTvYhxeTt7GcayL6-4rq5GEwnAS9gW_UOX-vqIlFJQI0ykqKwzquI8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDoTKqo7hcyn90d7gdRARZZzx1dzZH8bbPxBga4dmq_g&oe=6AC4FCD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zc01_cover_ea.png", "id": "2643960702463110", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031314_2643960705796443_2967927418195826185_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw9JUjWOkgEQ7kNvwGGuSoi&_nc_oc=AdpNEdGc7SbvSvt4JZqd3SCD7yCtxm0RXQ8ufO6cGairBedxjNLJiOOANshjvw9Sk30&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOap5PDhRKc3RGNutrKA1HwKKvxp1lImwHWO5L_yp2rQA&oe=6AC5281F"}, "display_name": "Zombie Chronicles: Max's story", "keywords": ["Zombie", "puzzle", "adventure", "shooter"], "long_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles.\n\nThere are no microtransactions, no ads, no need for internet connection, just you and the zombies. Good luck!", "short_description": "Max's Story is an action adventure game with a complex gameplay style. In the middle of the apocalypse, your mission is to reach the capital. You'll have to survive the hordes of bloodthirsty zombies, solve a variety of logic puzzles, or defeat the zombies attacking the capital.\n\nThe game basically offers a casual single player experience, with a simple crafting system, a variety of weapons, buildable turrets on certain maps, and locks that can be opened with logic puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1jzWFA0bU7zjMM3vv8FE8krWicVuBLvctPuS1LUIOkbo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "GabReality Games", "support_website_url": null, "website_url": "https://www.facebook.com/gabrealitygames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9018468104880246"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2149718655925579"}, {"status": "PUBLISHED", "id": "2414998605650751"}, {"status": "PUBLISHED", "id": "986662867191429"}, {"status": "PUBLISHED", "id": "26200742042920002"}, {"status": "PUBLISHED", "id": "4384786125116237"}, {"status": "PUBLISHED", "id": "1924138741860153"}, {"status": "PUBLISHED", "id": "2277712812686469"}, {"status": "PUBLISHED", "id": "1042526161387693"}, {"status": "PUBLISHED", "id": "1020379016901555"}, {"status": "PUBLISHED", "id": "638317469025582"}, {"status": "PUBLISHED", "id": "2008691436261695"}, {"status": "CANCELLED", "id": "879611720920458"}, {"status": "PUBLISHED", "id": "537743612590357"}, {"status": "PUBLISHED", "id": "565241456222088"}]}, "baseline_offer": {"id"
3_638589924408376_5441811817976955723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql1BVF_2eNMQ7kNvwFWCpzZ&_nc_oc=AdnEZaRt5j9CQdV0JS6X8tkGE6vaidtDhqFsLM8kElqNNsO3wILeD9q7Ynz_BDCBguQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjxkxHQBiMlH9h3xymu9ghwr7vKcnyFXdRs22v1TlSPQ&oe=69AC3123"}, {"file_name": "vr_vystavy_screenshot_5.png", "id": "2006253086432735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_2006253089766068_6676304426313763338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78sYcZV-zOIQ7kNvwEsBLgV&_nc_oc=AdkMcwcduDPR1bt5cE7jgNzFmrmxvH62Ay5HgB2YVwhMrrhFEri_Z8uGi0cxfMQCtyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbJsIYrOtzy-UwyGZ4IhxYI-uFSAogr9qVskWxuhB6cA&oe=69AC2A10"}, {"file_name": "vr_vystavy_screenshot_4.png", "id": "1424525544737251", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982559_1424525548070584_6829588508529124338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucFH88gLkosQ7kNvwG2vR_X&_nc_oc=AdlR-X9U-TX2ZIq7g62v3BY8MVeH4xbZhlj-utM-9a2hmPj1_eyE3hSDM6-CO_phjRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPVLxsujRGYC-6SJ6AyO9odkWLnJAvpx5_--Jvz73Mmg&oe=69AC27B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Veda na dosah VR", "keywords": [], "long_description": "Virtu\u00e1lne panelov\u00e9 v\u00fdstavy Centra vedecko-technick\u00fdch inform\u00e1ci\u00ed SR vo virtu\u00e1lnej realite pre p\u00f4vodn\u00fd Quest, Quest 2 a Meta Quest Pro.\n\nT\u00e1to verzia obsahuje viacer\u00e9 virtu\u00e1lne v\u00fdstavy od CVTI SR:\n\u2022 Slovensk\u00ed vedci: Pr\u00edstup povolen\u00fd\n\u2022 Pravda alebo hoax?\n\u2022 \u0160tyri \u017eivly\n\u2022 Slov\u00e1ci h\u013eadia do vesm\u00edru\n\nVeda na dosah VR je dostupn\u00e1 v sloven\u010dine.\n\n\nVirtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions:\n\u2022 Slovak scientists: Access allowed\n\u2022 Truth or hoax?\n\u2022 The four elements\n\u2022 Slovaks look up into space\n\nVeda na dosah VR is available in Slovak language.", "short_description": "Virtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions made by SCSTI (CVTI SR). Available in Slovak language.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cvtisr.sk/cvti-sr-vedecka-kniznica/podmienky-ochrany-sukromia.html?page_id=23233#Veda_na_dosah", "developer_terms_of_service_url": null, "publisher_name": "CVTI SR", "support_website_url": null, "website_url": "https://vedanadosah.sk/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["sk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1486994775165102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982586_452166280172389_3770593270588869377_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh0qyw_FsT8Q7kNvwHKSCxe&_nc_oc=AdlIWZAKwVy_0-TLfoM0vQ4H2o_YgiP7sx7ewxHkb6JsQNuoT_roySCr9hHnp9yFJiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRUdLp-yb54xl9RhHFDKhgq4eAQdCcZrz65_cA-3anHg&oe=69AC2EE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
irtual exhibitions:\n\u2022 Slovak scientists: Access allowed\n\u2022 Truth or hoax?\n\u2022 The four elements\n\u2022 Slovaks look up into space\n\nVeda na dosah VR is available in Slovak language.", "short_description": "Virtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions made by SCSTI (CVTI SR). Available in Slovak language.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cvtisr.sk/cvti-sr-vedecka-kniznica/podmienky-ochrany-sukromia.html?page_id=23233#Veda_na_dosah", "developer_terms_of_service_url": null, "publisher_name": "CVTI SR", "support_website_url": null, "website_url": "https://vedanadosah.sk/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["sk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1486994775165102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_452166280172389_3770593270588869377_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wc-EsjLBoCYQ7kNvwGLCdiU&_nc_oc=Adm_lLMAP_U2vLZ29YAwkBRI-MOTZfOhcR0VhyekFZoKFQ4HV0T1fnytdvpY_Jp5a6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSYSxPFjBLheodXWmWZV_8pNpR-wCHvoTuPoLNG7_PcQ&oe=69BEA3E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
3_638589924408376_5441811817976955723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVZUNC6ACSwQ7kNvwH6Y7MR&_nc_oc=AdoyBRHQQBqwl7oj6IPQGgbUiS-aB0iRx1VT7L9qbFPr3VHAFb8bvBE2V6WULa8yMzs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdA-nNfMTILLYFURuPmxE8SLqHafB3h6GQqhb8Cz74LA&oe=69C14923"}, {"file_name": "vr_vystavy_screenshot_5.png", "id": "2006253086432735", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001662_2006253089766068_6676304426313763338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv8IVXOqA-UQ7kNvwFNANdA&_nc_oc=AdpVWGNXHmSdtvw3e-kdMM_ADeWRDM2DqrEcMOyZ3FCOFw8I1uSantbWc4RyeGbZoHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6W92LzxAtlNxa1VdW0zIDKNg1iowIl65yH7OOy42u2A&oe=69C14210"}, {"file_name": "vr_vystavy_screenshot_4.png", "id": "1424525544737251", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982559_1424525548070584_6829588508529124338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6JmXqCKWaYQ7kNvwHRM2_f&_nc_oc=Adph5Bm9KqOfktvASELAksJUKMOGuQwR9VUC4pVaHxwLF4YRL9tgCcyf_lEe7EZh9yk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9WSD20_Bremtt7SPQ2rs0JKzjCI_HOXZEh6DDM4jwdQ&oe=69C13FB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Veda na dosah VR", "keywords": [], "long_description": "Virtu\u00e1lne panelov\u00e9 v\u00fdstavy Centra vedecko-technick\u00fdch inform\u00e1ci\u00ed SR vo virtu\u00e1lnej realite pre p\u00f4vodn\u00fd Quest, Quest 2 a Meta Quest Pro.\n\nT\u00e1to verzia obsahuje viacer\u00e9 virtu\u00e1lne v\u00fdstavy od CVTI SR:\n\u2022 Slovensk\u00ed vedci: Pr\u00edstup povolen\u00fd\n\u2022 Pravda alebo hoax?\n\u2022 \u0160tyri \u017eivly\n\u2022 Slov\u00e1ci h\u013eadia do vesm\u00edru\n\nVeda na dosah VR je dostupn\u00e1 v sloven\u010dine.\n\n\nVirtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions:\n\u2022 Slovak scientists: Access allowed\n\u2022 Truth or hoax?\n\u2022 The four elements\n\u2022 Slovaks look up into space\n\nVeda na dosah VR is available in Slovak language.", "short_description": "Virtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions made by SCSTI (CVTI SR). Available in Slovak language.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cvtisr.sk/cvti-sr-vedecka-kniznica/podmienky-ochrany-sukromia.html?page_id=23233#Veda_na_dosah", "developer_terms_of_service_url": null, "publisher_name": "CVTI SR", "support_website_url": null, "website_url": "https://vedanadosah.sk/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["sk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1486994775165102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982586_452166280172389_3770593270588869377_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPD76mfN_5YQ7kNvwHWS5T4&_nc_oc=AdoGX_U5Agh2GicE-I8QUXnXFYyxURLmaZVVv2B-qcDv2QGxdm4zlPYFmP12nLLW500&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx58Vw_kePrT01kT7_o5b2uyAspUwU33uoBbtkbz5QMMg&oe=69C146E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
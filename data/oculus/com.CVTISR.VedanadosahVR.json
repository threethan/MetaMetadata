3_638589924408376_5441811817976955723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql1BVF_2eNMQ7kNvwGrm8zT&_nc_oc=AdnCmfqZmPft7BRclZ_4o9MwYTbcTtkRfFs-KYvX-rARw6oDSumUIIZtNDV4_UVTzSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-7FU49Iv8xrdkTcIhCBnqjRd6UbRRubF9E6H8sqHuxQ&oe=69AD82A3"}, {"file_name": "vr_vystavy_screenshot_5.png", "id": "2006253086432735", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001662_2006253089766068_6676304426313763338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78sYcZV-zOIQ7kNvwGRsIa0&_nc_oc=AdmNRrMnXhmAYiGYCE8StRmu4WELvsYZcjWGA5TkJbcrZSdFA9hS4dMSvxP-dXri6HQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxagb9nOMvesOq4ng0reNLCaLbYCcjz9giTqv_UAbmFtg&oe=69AD7B90"}, {"file_name": "vr_vystavy_screenshot_4.png", "id": "1424525544737251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982559_1424525548070584_6829588508529124338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNP0pGQqDxQQ7kNvwEHYUq4&_nc_oc=AdmnTiG4R8Fcui2GIYS7fObR7b3XFDe1O7QE9fglwZaxxusRNEI2xcl71MhAK2JTUDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpfKxrBSLVMzgFI3Q_htoVg5i0bX6TxH9BQH_ArAt7JA&oe=69AD7937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Veda na dosah VR", "keywords": [], "long_description": "Virtu\u00e1lne panelov\u00e9 v\u00fdstavy Centra vedecko-technick\u00fdch inform\u00e1ci\u00ed SR vo virtu\u00e1lnej realite pre p\u00f4vodn\u00fd Quest, Quest 2 a Meta Quest Pro.\n\nT\u00e1to verzia obsahuje viacer\u00e9 virtu\u00e1lne v\u00fdstavy od CVTI SR:\n\u2022 Slovensk\u00ed vedci: Pr\u00edstup povolen\u00fd\n\u2022 Pravda alebo hoax?\n\u2022 \u0160tyri \u017eivly\n\u2022 Slov\u00e1ci h\u013eadia do vesm\u00edru\n\nVeda na dosah VR je dostupn\u00e1 v sloven\u010dine.\n\n\nVirtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions:\n\u2022 Slovak scientists: Access allowed\n\u2022 Truth or hoax?\n\u2022 The four elements\n\u2022 Slovaks look up into space\n\nVeda na dosah VR is available in Slovak language.", "short_description": "Virtual panel exhibitions of the Slovak Centre of Scientific and Technical Information in virtual reality for Quest, Quest 2 and Meta Quest Pro.\n\nThis version contains several virtual exhibitions made by SCSTI (CVTI SR). Available in Slovak language.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cvtisr.sk/cvti-sr-vedecka-kniznica/podmienky-ochrany-sukromia.html?page_id=23233#Veda_na_dosah", "developer_terms_of_service_url": null, "publisher_name": "CVTI SR", "support_website_url": null, "website_url": "https://vedanadosah.sk/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["sk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1486994775165102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982586_452166280172389_3770593270588869377_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh0qyw_FsT8Q7kNvwGwhCfh&_nc_oc=AdkrqnX0I6a4G2ylGNy6nggAQslAAPuzzFggX-7meSBlWMO9iEXhv7OOiDMMspC4TAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyerL4ITllpipaYudr3wseFipbfoK9Lx8zFVOcmYeZ7oQ&oe=69AD8068"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
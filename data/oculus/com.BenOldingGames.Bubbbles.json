290798508_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7NKHJTX8ZYQ7kNvwGJC29Y&_nc_oc=AdrDRIBlPoiVNhAsGbQVSLNc_4OCbb4mUbOKT_6c40It-1BJb5TJ4pbmF9JfzegaVtQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAjxP0-X3ah6NdETvgq0U1ePxAVp-UzNv_HU6nwNhm3A&oe=69C7BD9A"}, {"file_name": "ocss4.png", "id": "3157689364442828", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035336_3157689367776161_5290646075699598752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDX1C7TNArgQ7kNvwGA6pRq&_nc_oc=AdoPx23p8Vl111zH62HFtY-mPew_WD7eFvM3uOwOTAsu-rzimQdrzlUXmcR_NlAJYqw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLr5iV2ImnZhLirED03ElD7WPNE1V5q_S3bOmsG4e4RA&oe=69C7DAFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bubble ab test land.png", "id": "1607462426508632", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031370_1607462429841965_2687810561798963527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4tCAcUjM7wQ7kNvwFG6Ilq&_nc_oc=AdrWlMsqUYumsSdBoGa79aTd4Epzh6QNTgr5d85YKYDrTLPfIHEObQRUmhTiHTM32xU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxraQlWCdeF3AKlf6DC2O9esqKCdWQdplY9rQ4V3I8tMw&oe=69C7BD7A"}, "display_name": "Bubbbles", "keywords": ["puzzle", "pop", "bubble", "casual", "relaxing"], "long_description": "#                                                                                                                                                                                                       \n{1086917240204430}\n**Puzzles in VR or Mixed Reality**\n\nExperience bubble pop puzzles like never before.\n{9953451728117495}\n**Get to the Core**\n\nMatch the correct color / texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n\n{1050302207258882}\n**Collect and Use Power Ups**\n\nPop bubbles strategically to grab power ups and use them to your advantage.\n{1435865291061649}\n**Don't Let it Pop**\n\nAim carefully!\n", "short_description": "Bubbbles is a casual VR/MR puzzle game where you'll need to get to the core of a pile of bubb(b)les! Match the correct color/texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n"}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://clique.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23965437116401181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974778_495104999809052_2075231900391067521_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx14gt3-igMQ7kNvwGhuGqr&_nc_oc=AdrmBCU40LY500PuHCJwoRPgQYtLpLhj_NkZ8AbbZrh47-keMURes-AGPAEN4_VE3vM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKmxTry865PbStNXXUX4tfNCm64H1cDWJ9Ce8T4VfWAg&oe=69C7E3E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bubbbles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Arc
90798508_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9_Rf3oaw6EQ7kNvwHMNChA&_nc_oc=AdrsnrNZVnoWRc7tX-Rhex0sNiuWgP_v8Ks-ThyjPRjMYYJ3l3nc8yLQqFj4BLSbeOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnZhB-3KVrotkKklkkjGRxCcEbx33rQDB7AI7LF8xdOA&oe=6ABFCFDA"}, {"file_name": "ocss4.png", "id": "3157689364442828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_3157689367776161_5290646075699598752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMuMy9pjRxwQ7kNvwGUMoVl&_nc_oc=Adpd4_QtHvxDuXMKR5VjLZxSxE8XH5eDqkVZmZ1jNMD6cd51ctImTFLxrv4yZtpIcZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSI0FZLZFYrzZR3U1C2suBvXkrJo4YthnjcsFGrTsMsQ&oe=6ABFB4FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bubble ab test land.png", "id": "1607462426508632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031370_1607462429841965_2687810561798963527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18J_UWZ1rRoQ7kNvwF-oE-z&_nc_oc=AdrQ2nw6vBKmh55gl6RCdDfKwJpx2Ulgkg7utbz7DB0YkRqPeEXSTWEQqO22z9PAvtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmhPcfsc0G5fBtn78YG2CedmcOd1H5vWDGua6duDFa3w&oe=6ABFCFBA"}, "display_name": "Bubbbles", "keywords": ["puzzle", "pop", "bubble", "casual", "relaxing"], "long_description": "#                                                                                                                                                                                                       \n{1086917240204430}\n**Puzzles in VR or Mixed Reality**\n\nExperience bubble pop puzzles like never before.\n{9953451728117495}\n**Get to the Core**\n\nMatch the correct color / texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n\n{1050302207258882}\n**Collect and Use Power Ups**\n\nPop bubbles strategically to grab power ups and use them to your advantage.\n{1435865291061649}\n**Don't Let it Pop**\n\nAim carefu
90798508_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4mvgUCVFvkQ7kNvwEnyptT&_nc_oc=AdqfOeNQRJ_aRZW8YhT1RAwKHTyiiZYmmCqATDQBzCzZ78bRUcFTduU7zmvm89vySsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1D2eqsz2bpN1ZyDODY4qlnBVKd3YJ5RPXSN8cA_tw4g&oe=6AEF45DA"}, {"file_name": "ocss4.png", "id": "3157689364442828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_3157689367776161_5290646075699598752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw_Qjsyy46wQ7kNvwH2XdHD&_nc_oc=Adody5x7Zva9hE0HhOs_sM6OV3C2XJiZGq3ex95uQS4m25O_FCUV0jMa0OV_R1SoXc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU5sm1TSaIUYzwj3ss_E_UWfWu5KIUBbn_c1MRRQ1YKA&oe=6AEF633E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bubble ab test land.png", "id": "1607462426508632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031370_1607462429841965_2687810561798963527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcuWfjo7R5sQ7kNvwHh-d0f&_nc_oc=Adrg76GEOnTw09dZ8g6TLrqr7WXlGXZztEy0h0iNaiVmMpxzR8rAvCLbfO_-Hn127CY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI3Cge5lV09Jiq8MvVTNW6PjyfOTvS9_0-jDhk3I_giQ&oe=6AEF45BA"}, "display_name": "Bubbbles", "keywords": ["puzzle", "pop", "bubble", "casual", "relaxing"], "long_description": "#                                                                                                                                                                                                       \n{1086917240204430}\n**Puzzles in VR or Mixed Reality**\n\nExperience bubble pop puzzles like never before.\n{9953451728117495}\n**Get to the Core**\n\nMatch the correct color / texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n\n{1050302207258882}\n**Collect and Use Power Ups**\n\nPop bubbles strategically to grab power ups and use them to your advantage.\n{1435865291061649}\n**Don't Let it Pop**\n\nAim carefu
290798508_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRayzpP8deIQ7kNvwFieQ0b&_nc_oc=AdoOHmhvEo39lsUTandgp1X7kPBg-Cx3oNipC7JAb67i0gidGkgSbBGxYXpjMXZdjjg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzj7GTtIRsxSpJsAyX5RfUOvO2sdY3PxmVwVeiJFQlbrw&oe=69C51A9A"}, {"file_name": "ocss4.png", "id": "3157689364442828", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035336_3157689367776161_5290646075699598752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDX1C7TNArgQ7kNvwGe3LKV&_nc_oc=AdripgnKtkrsD5qNFVQDedwrze77dfBwexfpT4zhBhPRU9Q-fSYHCuyEfuNtrVoXpuQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcbVaOMgkxnvPdxBZtmbguQV65lFkL7F28thl5lqoINg&oe=69C537FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bubble ab test land.png", "id": "1607462426508632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031370_1607462429841965_2687810561798963527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4tCAcUjM7wQ7kNvwEsnw_J&_nc_oc=AdqT3cVBDdM0lEnOKuSOh25x2S4KqdYDfAkKCaeSu2AckjCLbqD18KWTkae1i_eJbz0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxqe58tWhV2-_0CmW4gD_zZnut4KWj91e-t-x7KjKSKHA&oe=69C51A7A"}, "display_name": "Bubbbles", "keywords": ["puzzle", "pop", "bubble", "casual", "relaxing"], "long_description": "#                                                                                                                                                                                                       \n{1086917240204430}\n**Puzzles in VR or Mixed Reality**\n\nExperience bubble pop puzzles like never before.\n{9953451728117495}\n**Get to the Core**\n\nMatch the correct color / texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n\n{1050302207258882}\n**Collect and Use Power Ups**\n\nPop bubbles strategically to grab power ups and use them to your advantage.\n{1435865291061649}\n**Don't Let it Pop**\n\nAim caref
ur advantage.\n{1435865291061649}\n**Don't Let it Pop**\n\nAim carefully!\n", "short_description": "Bubbbles is a casual VR/MR puzzle game where you'll need to get to the core of a pile of bubb(b)les! Match the correct color/texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n"}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://clique.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23965437116401181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974778_495104999809052_2075231900391067521_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON5-9M8ipYMQ7kNvwHAcJq9&_nc_oc=AdnZfJTQoPN1lO79UKsfCs-bqh9_ORfRoPBK-qp0xpushcdhpvWlv4wBNjFwFvc5E8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLO5CZwXxZyhqNEvRWWUtwMnldqDWus2OJ7aW90-GRyA&oe=69AED766"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bubbbles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topi
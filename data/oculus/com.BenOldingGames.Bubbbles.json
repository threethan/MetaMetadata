290798508_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRayzpP8deIQ7kNvwEm2wew&_nc_oc=AdpaHgAOmO10XHa3jmUVWqJbmqRMn9J-fm59zRIZ5Fq0W3ym40WHh9JxW_tEt5ab9Bo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylbkzM9w0F3UAMPEZakqn_d7wsQ_hBVzNk-89-F3YtXw&oe=69C3C91A"}, {"file_name": "ocss4.png", "id": "3157689364442828", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035336_3157689367776161_5290646075699598752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ktt99NA2ZoQ7kNvwFVrsb2&_nc_oc=AdoJMiHU4NFiKxijlZyD5uiP9O924mY-rcH657ud-XxxHLv1F4MsH94tjG3JOnzDmnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOmvbCBX9QqOp60C7lAmHpcvexmT6gT7Rt84gERfBxFg&oe=69C3E67E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bubble ab test land.png", "id": "1607462426508632", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031370_1607462429841965_2687810561798963527_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTDUPD9JuEgQ7kNvwH6avOn&_nc_oc=AdobcW2NTtESKrgcudBWv5Yw_OD7Os_E3r98rcovlVi4QZijCghxT9YEk7UxcvpCnns&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS06q-4hqAuqXVhxr-lbAlC0awNf3t8PLcSOhM3aIMmQ&oe=69C3C8FA"}, "display_name": "Bubbbles", "keywords": ["puzzle", "pop", "bubble", "casual", "relaxing"], "long_description": "#                                                                                                                                                                                                       \n{1086917240204430}\n**Puzzles in VR or Mixed Reality**\n\nExperience bubble pop puzzles like never before.\n{9953451728117495}\n**Get to the Core**\n\nMatch the correct color / texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n\n{1050302207258882}\n**Collect and Use Power Ups**\n\nPop bubbles strategically to grab power ups and use them to your advantage.\n{1435865291061649}\n**Don't Let it Pop**\n\nAim carefully!\n", "short_description": "Bubbbles is a casual VR/MR puzzle game where you'll need to get to the core of a pile of bubb(b)les! Match the correct color/texture bubbles to remove all similar touching bubbles while more fly in from the sky to throw you off. \n"}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://www.clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://clique.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23965437116401181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974778_495104999809052_2075231900391067521_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCZFYXqH1XMQ7kNvwHDHEca&_nc_oc=Adoi9M-MaMZKECn-NrjweXWrk7kDE-J14-r_i74otnl4orIkOg-IsHY7RAabFgNhQvc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvgUhiGCXQnU-tEYrIwTTBKaBAHSlh5NO7Guuo5iTZqg&oe=69C3EF66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bubbbles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Arc
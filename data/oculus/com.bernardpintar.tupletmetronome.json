/593854747_1008088731727576_85641656572966278_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdzSWz2ysGUQ7kNvwG7Prsc&_nc_oc=AdpDBYEeaZR19siVbN65ThS3X_k70157HEnteJzLQmDv8vDauVg3UGf3vIc5vrmO6XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBENavHUc14kWjpHAtluj9k8_xH3-77RYn2ZerMStKsZA&oe=6A6E04D4"}, {"file_name": "com.oculus.vrshell-20260524-221539.png", "id": "1684379456037097", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_1684379459370430_8148234218176738878_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqiptA8P4esQ7kNvwF651Um&_nc_oc=Adq41lYqNqU8BZZwvrcQy_2Wau--OGUIq57TwDQXhbaCINhwCqj3q58P00bu6yPPkLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAECgYPy1qNN2K92ZY5aCIJbY15YqWqXwkx4caheYvAMQ&oe=6A6DE0FF"}, {"file_name": "com.oculus.vrshell-20260524-221614.png", "id": "1014614121560114", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1014614128226780_3445498543458636006_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TgdvyKr6ToQ7kNvwEtNs6W&_nc_oc=AdruJEpN4e8xmazR2kr9HYN1TSawZWXgZLM93Mw2kQ3YJSwqn0qrbe_lfvocnMkoLzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWJasRBzig8dSQoP0tulXWQGJJ9OpiZMkWeXlUeOpKiA&oe=6A6DF106"}, {"file_name": "com.oculus.vrshell-20260524-221705.png", "id": "2174071886797427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_2174071890130760_3940129459581443027_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZW8fTKDwEEQ7kNvwGe1-F_&_nc_oc=AdoSBkW3j2xsifXv3OXL3REUu2yO7LXwu3Ylbi2UgqVvCKL67VH04K3ZsdnGM1aVf2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_cvIr7t69wBPO8gapQLCXbzAgTYTy98ycomwWhT5m1Q&oe=6A6E09D1"}, {"file_name": "com.oculus.vrshell-20260524-221651.png", "id": "1505119664350029", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828087_1505119667683362_5327720122588640481_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH3AnW6oeM0Q7kNvwG3M-2J&_nc_oc=AdpjpFehuJ6SbY6scBj_fWUdc0_QFPVDPMwax-ZsOedM2JYxGCxEyn5j1lWFcgG-mns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi8mKPgoWGc31KtTU9nLx9BoQb0Woasbls7fabk6ohww&oe=6A6DE6E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuplet Metronome", "keywords": [], "long_description": "Dual metronome with tuplet control, time signature, GAP mode and a bar-based programmer.\n\nTuplet Metronome is a precision\u2011built metronome designed for musicians who need more than a simple click to practice tuplets. It allows you to place different numbers of notes inside any time signature through advanced tuplet control, the GAP silencing system for practice, and a bar\u2011based Programmer Mode. \nWhether you\u2019re working in odd or standard meters, Tuplet Metronome provides the tools you need for musical exploration, focused practice, and the ongoing improvement of your skills.\n\n\u25ba BUILT FOR EVERY PLATFORM\nRuns natively on macOS, Windows, Linux, iOS, Android, and Meta Horizon OS.\n\n\u25ba SHAREABLE PRESET MANAGER\nSave and sync your presets across devices and platforms. Select multiple checkboxes and share directly to Google Drive, Dropbox, or any app.\n\n\u25ba ADVANCED TUPLET ENGINE\nPlace any number of notes inside any time signature.\n\n\u25ba BAR\u2011BY\u2011BAR PROGRAMMER MODE\nBuild complex rhythmic structures with a visual, step\u2011based editor.\n\n\u25ba GAP SILENCING SYSTEM\nMute selected bars to practice timing accuracy. Silence the click and fill the space yourself.\n\n\u25ba ABLETON LINK\nStay in sync wirelessly with band members or other Link-enabled apps over your local network.\n\n\u25ba FULL MIDI MAPPING\nControl transport, tempo, and parameters from any MIDI controller.\n\n\u25ba REAL\u2011TIME PERFORMANCE MONITORING\nCatch issues before they cause dropouts. Monitor CPU (audio thread), GPU, RAM, and system usage.", "short_description": "Dual metronome with tuplet control, time signature, GAP mode and a bar-based programmer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rcqgGQydw-y2Ww3rPFkCtFmjldmTuyz0zhsG3EtK8aU/edit?tab=t.0", "developer_terms_of_service_url": "https://docs.google.com/document/d/1qAnx3l4oZ4Ie40XEXXzdrgjSLWA-l30lFQdQH3AaETA/edit?usp=drive_link", "publisher_name": "Bernard Pintar", "support_website_url": "https://bernardpintar.top/", "website_url": "https://bernardpintar.top/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36571300455847297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_1017808540943748_5372931226101260071_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5oXHAUb_lIQ7kNvwHzDoTI&_nc_oc=AdoufzycMfHi8NvB2dxYgolxPMXytyyJp3FvgEFktGYp7UP704QmhFyRKPFv2QNxg38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClWd3Mype0PuchcQOT_VNSIFrnTALu0iMYn3bjIhAt5Q&oe=6A6DDA9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tuplet Metronome", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1781701140, "lastRevision": {"nodes": [{"id": "34101514186159282", "release_
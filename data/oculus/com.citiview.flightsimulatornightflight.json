9QGxXn6t7z8nAfbV3hfeqrWGLGf7l2rzf8lH6AXo8jHNmMhji5khzsc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsk4bTLjkd3j6U65O5TuxR8OHugREbY5NLFsf3Q8j7fg&oe=6AF9E74C"}, {"file_name": "screenshot_2.png", "id": "1407458754841555", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673716021_1407458758174888_8479372196297879706_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWSV9IvWn3sQ7kNvwG6WXRE&_nc_oc=Adrwi2-2hHR3ysSbequLdo7pW8eNhSxbtM0xWVfvkkAMOb3LccmXnoq5Cj07vTxwtOk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeP4etRjR7neeauYbNxGal9fj4vxK3tCb_8MmdY1xurw&oe=6AF9BA35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "798898973318108", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/786297305_798898976651441_1087884523862729902_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llVcevYiqZwQ7kNvwGWD36S&_nc_oc=Adrjo9OuPjJFpxEmKsUPTeX8YuFvRq3TXxq9OcLzGLA-Qdib1kodneUrxbTC2k4AXL4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW2ROs-VoMjVDDXSdZzK8UrfX7pzXqXONB9yUOsd-1LA&oe=6AF9E0C2"}, "display_name": "Flight Simulator Night Flight", "keywords": ["flight", "simulator", "night", "airplane", "helicopter"], "long_description": "Flight Simulator Night Flight is always night. Take off over a whole city lit up below you and land by the runway lights.\n\nA CITY OF LIGHTS\nA downtown skyline with lit windows and glowing crowns, a 480 m observation tower, a harbour bridge strung with lights, a Ferris wheel, searchlights and fireworks over the water. Six highways carry thousands of moving cars - white headlights one way, red tail lights the other.\n\nAIRPORTS LIT FOR REAL\nEdge and centreline lights, green threshold bars, approach lights with the flashing rabbit, taxiway greens and blues, stop bars, lit signs, a glass terminal with airliners at the gates and a rotating beacon. Your landing lights light up the runway as you flare.\n\nTHE NIGHT SKY\nTwilight, Moonlit or Starlight: twinkling stars, the Milky Way, the moon, shooting stars, and clouds lit silver by the moon and orange by the city below.\n\nTHREE AIRCRAFT\nA business jet with a glass cockpit, autopilot and a cabin you can walk through, a helicopter, and a fighter with a head-up display and afterburner. Paint them and power wash them in your hangar.\n\nMISSIONS\nCity Lights Approach over downtown, the Skyline Run, the Starlight Canyon, a Midnight Arrival, fighter missions and formation flying, plus twelve landmarks to discover.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.", "short_description": "Fly a private jet, a helicopter and a fighter over a glittering city at night: streets of gold, highways of moving headlights, a lit downtown skyline, fully lit airports with real approach lights, and a sky full of stars. Solo or online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatornightflight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatornightflight/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1262329040306402"}}]}, "scheduled_offe
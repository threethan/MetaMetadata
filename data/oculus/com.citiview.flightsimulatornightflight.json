5059_5481069478960815409_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLRtG-08rAEQ7kNvwHDpkBK&_nc_oc=AdoNa7iPU6JR4TJvEI4XEOifoleiYOx4SejDZhg03Q21PvIUqBLHolfVabHibafrTTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjPS7Ti0v1xN8CWuIScTr1w3Hf0I5aHQPTGk_3ZKXsIg&oe=6AFDE1A9"}, {"file_name": "screenshot_3.png", "id": "1455417086766901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1455417093433567_4587596254103533955_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqI9gkWFgA4Q7kNvwHqUbzx&_nc_oc=AdpyeB978sDwDz7JneNeKSbkn4KCHriCIA_hmCxJshlkmSigBxJkZpPHcPXswpu6Fn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSya4DNsT_eA5qePJUnWg2YUTpk75IFQI3RzUS-QX9Zvg&oe=6AFDB162"}, {"file_name": "screenshot_4.png", "id": "1097393695988310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1097393699321643_8073432264706525728_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNZEZqDa4UQQ7kNvwEVJIZM&_nc_oc=Adp6ltFsP3YVpwvCiNGjAA5fyY1dsAkYvRRzU-U9Hr3y-yfcuThFzNnQRephmnCeIgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCuqDG5S3XUAIe9PRRiOGPwiWfpnaRl2q8rUD97lOP8w&oe=6AFDDBCC"}, {"file_name": "screenshot_2.png", "id": "1407458754841555", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673716021_1407458758174888_8479372196297879706_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S29P0ctXRjQQ7kNvwGb5ivt&_nc_oc=AdpJJWzZlXWzO_-StOCLbto147-hXe4MJkEmB4K-D5ujS_U9EPOJGBnt_taS8ixrS24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2ID1ewbD1aCYtmmp7uigo7oOwCl-21ztamKAPDA37Zw&oe=6AFDAEB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "798898973318108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/786297305_798898976651441_1087884523862729902_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xF0Tt2iLcwQ7kNvwHdE7le&_nc_oc=AdqQWVWJi-e8XC7uCDcyNghzuJCdb8yigPK_nRqMZsIJSZwyuWZPxQeiM31uimxtvdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4hjePCY393Bc_CsoM21k7IeB5W7WuXOta8IzlviNrLw&oe=6AFDD542"}, "display_name": "Flight Simulator Night Flight", "keywords": ["flight", "simulator", "night", "airplane", "helicopter"], "long_description": "Flight Simulator Night Flight is always night. Take off over a whole city lit up below you and land by the runway lights.\n\nA CITY OF LIGHTS\nA downtown skyline with lit windows and glowing crowns, a 480 m observation tower, a harbour bridge strung with lights, a Ferris wheel, searchlights and fireworks over the water. Six highways carry thousands of moving cars - white headlights one way, red tail lights the other.\n\nAIRPORTS LIT FOR REAL\nEdge and centreline lights, green threshold bars, approach lights with the flashing rabbit, taxiway greens and blues, stop bars, lit signs, a glass terminal with airliners at the gates and a rotating beacon. Your landing lights light up the runway as you flare.\n\nTHE NIGHT SKY\nTwilight, Moonlit or Starlight: twinkling stars, the Milky Way, the moon, shooting stars, and clouds lit silver by the moon and orange by the city below.\n\nTHREE AIRCRAFT\nA business jet with a glass cockpit, autopilot and a cabin you can walk through, a helicopter, and a fighter with a head-up display and afterburner. Paint them and power wash them in your hangar.\n\nMISSIONS\nCity Lights Approach over downtown, the Skyline Run, the Starlight Canyon, a Midnight Arrival, fighter missions and formation flying, plus twelve landmarks to discover.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.", "short_description": "Fly a private jet, a helicopter and a fighter over a glittering city at night: streets of gold, highways of moving headlights, a lit downtown skyline, fully lit airports with real approach lights, and a sky full of stars. Solo or online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatornightflight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatornightflight/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1262329040306402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613094043_1372169594674750_6081340592513038473_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-qdSLIJlp4Q7kNvwG1m_5y&_nc_oc=AdpN1ojybWi1YEtTZN-1mG6JVQqHQ5Vs4oxbfJXYFWn9lRc6KD4ulAFTFhLZYOWFAmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdrIiQZy7wa5hUZE-drMzjj6AxLyxheYEMzl0bgYkvxA&oe=6AFDDA54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator Night Flight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1791202500, "lastRevision": {"nodes": [{"
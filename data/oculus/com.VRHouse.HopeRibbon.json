91824318_29062036006727152_14495969288635611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Far9uxoYU-8Q7kNvwFbM7Y2&_nc_oc=Adp4ul9Av-TE9tUo1PD6tW9lABlq_ZOnuxZTE6ndfClVN1scVsx4UH66sowsk672uiM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq4Fqmx9xtbEUSKCfSzZN6eYqvg_gdG-12FMz8i_U3DA&oe=6AF081E9"}, {"file_name": "hope-ribbon-screenshot-4.png", "id": "1593339162337939", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1593339165671272_6061303620357914217_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50cNhHRxljsQ7kNvwEpX2xn&_nc_oc=Adrb6LFxo2M0Fv8lefnSNBj47HnVVoGF5rgR6hqUEhUxHG7qTS0tMzK6zWIgYOlwEec&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNriPfDptIQTvO8rcBDlSS4vVxDUjbtHSdjKI9VbuDwQ&oe=6AF0959A"}, {"file_name": "hope-ribbon-screenshot-5.png", "id": "1403325474597793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1403325477931126_6109380546367383329_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLoHC8BKIMoQ7kNvwFv3mxH&_nc_oc=AdoxU8d8CMAK6TtBMP80b7vra-VXCP237xnTdQiKwxPg8J_QVucbIL4IW71FSBpjt1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRa2wSUwVjb14hHtUFiGmX1iw7CQZu1QAGggBait2WWA&oe=6AF09B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hope-ribbon-trailer-cover.png", "id": "1419599342829322", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1419599346162655_5480696413627539081_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su93OjdcWSMQ7kNvwHnxtGM&_nc_oc=AdrT1cujB4MhTAR7GxSnF6Y2u0YqBbPwA91vaCmKwyJNr2WjseJ33Dfi925nOQzvwds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh60-rdAA5pl4CwuBhMXVxM3v5Q1fRO9ni8uuxS6nYvg&oe=6AF07DFC"}, "display_name": "Hope Ribbon", "keywords": [], "long_description": "Hope Ribbon is a virtual reality experience designed to demystify breast cancer screening and encourage early detection.\n\nDeveloped as an awareness initiative by Imam Abdulrahman Bin Faisal University (IAU), Hope Ribbon lets you live the full journey of a mammogram visit safely, privately, and at your own pace.\n\nWhat you'll experience:\n\n- Walk through the hospital entrance and reception, just as a real patient would\n- Wait in the lobby before your appointment, easing into the environment\n- Enter the mammogram room and meet a virtual specialist\nTalk with the specialist about each stage of the exam\n- Get honest, clear answers to common fears and misconceptions about mammograms\n\nBy removing the mystery around the screening process, Hope Ribbon hopes to lower anxiety, build confidence, and encourage more women to take the step toward early detection because awareness saves lives.\n\nExecuted by VR House Company. Developed using Unity Engine.", "short_description": "Step inside a real breast cancer screening journey. Hope Ribbon guides you from the hospital entrance to the mammogram room, where a virtual specialist walks you through every step, answers your questions, and helps ease common fears so you feel informed and empowered before your own screening."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1DOd-whUSQZrBJiB5WQp_uhIcIC8MYZJNT0If-Sc4ZeA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "VR House Company", "support_website_url": null, "website_url": "https://vr-house.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
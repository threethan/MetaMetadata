1XxD9jl7Tqm8ySnsPQ&oe=69B2CFDE"}, {"file_name": "Crash.png", "id": "406302435476314", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035345_406302438809647_8568981630473616411_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2DNpxvHGE8Q7kNvwEtQGHg&_nc_oc=AdkUleKHnaYCNTrNVTQ1MEGnvN9yqsGE-y-eK9TwZU8a9kPOjaX-1AFNIJOYm2ESKoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxh2_2Dogd61xXESYrKcAjN3KLHfjEuf_dzmFjam9mf2A&oe=69B2B1C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Start.png", "id": "964762261316057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003227_964762264649390_2253446905750202459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr8938kX2f4Q7kNvwFGj7jg&_nc_oc=Adm6ec-o9ld_hmK99mAQOutiWkqTi-oBQbUbeflJNRPoWC6ED_3gFEyJueAEMpWFH6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwte204xy-xIpwAUvPO6Cr5t55L7F5xwA-4g7EbHhjj4Q&oe=69B298EC"}, "display_name": "DroneSimulatorVR", "keywords": [], "long_description": "The DroneSimulatorVR is designed to facilitate and enhance the training of drone pilots.  To practice the handling of a UAS, many important basic functions of current drone technology are included. Particularly important are flight and gimbal controls, as well as the navigation and coordination of drones. Another distinctive feature of the simulator is a lifelike representation of distance and angle of view between the pilot and the aircraft. In addition to training, the simulator is also intended to arouse interest in the exciting subject area surrounding the drone. It is neither cheap to purchase a UAS, nor is it easy to meet the necessary conditions to put it into operation. The drone simulator is intended to provide a virtual reality for anyone who has the necessary hardware, in which they can enjoy flying a drone without worry and in a relaxed manner. ", "short_description": "The simulator is designed to learn the functions and control of a drone"}]}, "developer_name
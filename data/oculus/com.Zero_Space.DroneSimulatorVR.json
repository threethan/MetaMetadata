6pMm7mq-EPDv58gqZw&oe=69BAB8DE"}, {"file_name": "Crash.png", "id": "406302435476314", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035345_406302438809647_8568981630473616411_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFHEMmB1Wz4Q7kNvwHaz6GB&_nc_oc=Adk4BPGV_djIfBWw_SoRE6OhUsFhAJ88DuN4Q-TcoRh4qizAKuInZHlL9pmaNWwT0BU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6KLKQ60kYhwGO8TaaSVrrSma9GsQWJUu1NM5YTbUu5g&oe=69BA9AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Start.png", "id": "964762261316057", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_964762264649390_2253446905750202459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_loXMW5UP6wQ7kNvwEmWOWd&_nc_oc=AdlfIY71v__hBUm66qJADnhBN-d6zqgyLxGOxnsA8_9P6UtMXP02cAjz6NWHBZwFZas&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZoZCaFqz6BeZ9Gt8sCQMjSFNXZ2t-0ht32b0nOD7tWA&oe=69BA81EC"}, "display_name": "DroneSimulatorVR", "keywords": [], "long_description": "The DroneSimulatorVR is designed to facilitate and enhance the training of drone pilots.  To practice the handling of a UAS, many important basic functions of current drone technology are included. Particularly important are flight and gimbal controls, as well as the navigation and coordination of drones. Another distinctive feature of the simulator is a lifelike representation of distance and angle of view between the pilot and the aircraft. In addition to training, the simulator is also intended to arouse interest in the exciting subject area surrounding the drone. It is neither cheap to purchase a UAS, nor is it easy to meet the necessary conditions to put it into operation. The drone simulator is intended to provide a virtual reality for anyone who has the necessary hardware, in which they can enjoy flying a drone without worry and in a relaxed manner. ", "short_description": "The simulator is designed to learn the functions and control of a drone"}]}, "developer_name
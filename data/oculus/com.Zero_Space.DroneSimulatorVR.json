&_nc_ss=7f20f&oh=00_Af6w6xuypAONx-5iddJ0AJazRlotTX5vJOxSPqm0oYgQSw&oe=6A15B05E"}, {"file_name": "Crash.png", "id": "406302435476314", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035345_406302438809647_8568981630473616411_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEZUAIAnZZ8Q7kNvwG7q2IM&_nc_oc=AdqfBjWLj_CdN_-cpHx1HLAPehnRpc_nnA10HiC0vm8fhdVPgsXHBur0QeWJEJ2ZIRM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N-Grz7DlRoIcPfQkgjzm9cKpuJ1JITTLAJNfrueaMjA&oe=6A159246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Start.png", "id": "964762261316057", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003227_964762264649390_2253446905750202459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcoCyib3z5kQ7kNvwHK7iTj&_nc_oc=AdoaxmmcuJq1PeCtgiXqJqbrF4zr6F5goNVwwJrkU9jbXt_gulZygIhaDo3lhF0_7_0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D8TkzFYVWTA2UpM0vWjyzlIWO6LPPoTdG5QFBybgeGQ&oe=6A15B1AC"}, "display_name": "DroneSimulatorVR", "keywords": [], "long_description": "The DroneSimulatorVR is designed to facilitate and enhance the training of drone pilots.  To practice the handling of a UAS, many important basic functions of current drone technology are included. Particularly important are flight and gimbal controls, as well as the navigation and coordination of drones. Another distinctive feature of the simulator is a lifelike representation of distance and angle of view between the pilot and the aircraft. In addition to training, the simulator is also intended to arouse interest in the exciting subject area surrounding the drone. It is neither cheap to purchase a UAS, nor is it easy to meet the necessary conditions to put it into operation. The drone simulator is intended to provide a virtual reality for anyone who has the necessary hardware, in which they can enjoy flying a drone without worry and in a relaxed manner. ", "short_description": "The simulator is designed to learn the functions and control of a drone"}]}, "developer_name": "0Space", "developer_privacy_policy_url": "https://www.termsfeed.com/live/4dec8f1c-b379-41ee-abf7-800ab053de04", "developer_terms_of_service_url": null, "publisher_name": "0Space", "support_website_url": null, "website_url": "http://dronesimulatorvr.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25701794759436456"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "998116072782507"}, {"status": "PUBLISHED", "id": "930115103154023"}, {"status": "PUBLISHED", "id": "1323892779457883"}, {"status": "PUBLISHED", "id": "2123649641715925"}, {"status": "PUBLISHED", "id": "1374093683759301"}, {"status": "PUBLISHED", "id": "2960543074145399"}, {"status": "PUBLISHED", "id": "823336943612365"}, {"status": "PUBLISHED", "id": "2153912675101813"}, {"status": "PUBLISHED", "id": "687622254100673"}, {"status": "PUBLISHED", "id": "997181869209504"}, {"status": "PUBLISHED", "id": "1268928427512202"}, {"status": "PUBLISHED", "id": "1309003160034999"}, {"status": "PUBLISHED", "id": "2779960085516701"}, {"status": "PUBLISHED", "id": "1002072445051524"}, {"status": "PUBLISHED", "id": "1398122277550218"}, {"status": "PUBLISHED", "id": "6258079210880004"}]}, "baseline_offer": {"id": "1002072445051524"}, "is_approved": true, "firstOffer": {"nodes": [{"star
m/v/t64.5771-25/491824318_27292244040449194_3509206164409486334_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tgju_QygHWQQ7kNvwHqWlW4&_nc_oc=Ador_fLiam1LBZTblaltjEXfMB3FcfQKGsAuTj_vNQXnfr0udZ3k4bjh9Tsyhq88B0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Eg5grNIfv30ePy5r6rmIjAI-LGtNwsNKWiJ6_UKAnA&oe=6B084933"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DmWXnacq3EQ7kNvwG3DL2L&_nc_oc=AdoIlLLaULLRcg0bIedRBTjEVxx_LXH8t4LspndQU91lsjtzuDasu9aCw7nyCHNZzGI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy3aLE1FyqfulGiB3wrFABGiEJGeu5_uXVVYoGzDKZIQ&oe=6B083FCB"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff5c7ECfsf0Q7kNvwGOlrqP&_nc_oc=Adr1bXAwwBI286N_4uDU25AlR61bYZBHluE2yoic8yMNI8_JL7STfsH7XNrIe3HfvNI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSi63KzffNoDTKw263TPBcFProa8Bh0abTjmXZujk1hg&oe=6B085284"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBUr9zEOUngQ7kNvwEmxQLT&_nc_oc=Adoc3GVUmHzqxHq965Lxsm-aqzLCaIV6lwetAjxCgPC8lWkwduQJe4oAWoV10JeMQMo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNwpbUfB2MYCJkcm5lh81RsRenPhfdeAWGSTAgudZTlw&oe=6B0856D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I8ZE420kbEQ7kNvwH2-B1M&_nc_oc=Adpe1RdsukZbdGv0FX1kzav-pUoe-4huJ2S-k7ZYbaMOSkw8W9Aq8MpoTcLf0Y3FfCs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWg7oMgH_buTtlbTlq3xpufiCRV7oWaHUwtHu4ajyCvw&oe=6B085E50"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/contro
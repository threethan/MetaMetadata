0a&_nc_ohc=uonOrdvK0BcQ7kNvwHupKDD&_nc_oc=AdoFeFedNJIKIPeYOg8G4tBAYw-n6JHPzoALOIiQMBnkdeSGwbjuX3n13kQLwJTAxZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOxKn6lvm3Qk8JCzX5yFo5y1JHpokp0gqxLh_afeLubg&oe=6AFDD12C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1212520106964981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393117_1212520110298314_7656074111046047489_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwkmogs-Z7UQ7kNvwEKby_v&_nc_oc=AdoHbr-k5uvhTJlomaRF6fK-vhVW7rZFBDwj9b1ELZZM3gIPwtdXvWHJ_HU7rdgGH64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjWSwskNF_1FbQ5Ji7zb-4C5T9QqVy6dmAh40WzkyE-w&oe=6AFDCD6A"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "This is Control Freek, a game about pressing buttons really fast, because sometimes, that\u2019s all you need in life.\n\nWe\u2019ll keep working on this game based on the number of reviews it gets.\n\n5 Reviews - Fix bugs (yes, after release).\n9 Reviews - Global leaderboard.\n11 Reviews - Add a trapdoor exit, because why not?\n23 Reviews - Probably a new level. No promises, but maybe.\n42 Reviews - Add an actual menu so things feel more legit.\n69 Reviews - A new button. What does it do? We don\u2019t know yet.\n99 Reviews - A level with the new button.\n112 Reviews - Full level editor, because why build levels ourselves when you can do it for us?\n\nWe don\u2019t know how far this game will go. But we\u2019re having fun making it, and if you\u2019re having fun playing it, let us know. Leave a review, push some buttons, and let\u2019s see what happens.\n\nOhh, btw. Tell us what you think or what you want next here: https://discord.gg/4Zw3jA2T9p", "short_description": "Push. Flick. Slam. Repeat. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9514271041961827"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "493853269788123"}]}, "baseline_offer": {"id": "493853269788123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742564940, "status": "PUBLISHED", "id": "493853269788123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28799521246343518", "version": "1.0.197"}, "id": "1312150520121428", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8957204501001820", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28799521246343518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1312150520121428"}]}, "change_log": null, "created_date": 1791208499, "id": "28799521246343518", "version": "1.0.197", "version_code": 197, "release_status": "RELEASED",
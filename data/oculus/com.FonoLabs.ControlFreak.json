m/v/t64.5771-25/491824318_27292244040449194_3509206164409486334_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOjb46NGRAcQ7kNvwHFN7wW&_nc_oc=AdrzaxrkEegMvds6jb5PD732qSJ-zOaWtRr9UxKN3ylwxNO5zaiuHyrMVx6GOu_Xmxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfzfvL1J7Y-GtTVM6iKW92EkBC13IBlGFCzsHrGrDMRg&oe=6AFDBD33"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0__lYVsm6wQ7kNvwF14bl_&_nc_oc=AdruU13Vv6PBR-Hg3P1XNDeXYElMzRQVN6VGoJwB9Ph7rw9e8fUjopDw29HHiX27Bd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlyEGV797iouyjUgBWTrswJoxe30v38awsHcpwrooRFg&oe=6AFDB3CB"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kItP1ZlnIrMQ7kNvwGIM7Ko&_nc_oc=AdoA7OyWcoAfVOAvNP91NKw26f_PChDDDcCi7QIGNB8F6hDtRpRMA12LPGeBPvmGdlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcezjE9mNZ2DlHoe0SJZ0-oJRVVRevTmtEbcqYLUYS_g&oe=6AFDC684"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wschSqiKJm0Q7kNvwE_w1__&_nc_oc=AdqRbta7FaODgxdsGVxlhVMUbEGLQiRDzzauzLmXjj1MtOxdqOnVSDWAchwjlDCx8p0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4XREZMUWPQCaiJpCPQTVKo3Au9WrYYhVyFIg0H8oF1A&oe=6AFDCAD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWXLmEcQS2UQ7kNvwEbFLhK&_nc_oc=Adrq53_DBi4z3WyXaQjZPJDHKUeK3QZhOOjyP75M8QIqJ_sPZ6hx7AYFBtcV-dQDrRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQupJeCvvtD7h6P6bYGSyoar1nI7Ckes2DPAgS2EJbKQ&oe=6AFDD250"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/contro
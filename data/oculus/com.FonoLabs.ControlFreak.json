N-VXPENlQcqziSOMjUaid7GkGjlSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrG0GxPAnKlmQ53eoca5QAJTtc11vv-f4Fo0dify_cjQ&oe=6ADCC7B3"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NipSsGW6PM8Q7kNvwFkHyPc&_nc_oc=AdqjTnslOy8Cvtipi5exnuNTCb8mcPTEm22-7_YrjFCW6Bns8tv7jiN6tvdRplBsqK8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzGjNg_V7mINMgQbuBidIV9VDo92_wLTl8Xw0gwOGjqA&oe=6ADCBE4B"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIIEg8FarZEQ7kNvwGhFLhi&_nc_oc=AdprHbTxKp-Tmu11YiOM3RaF3ZWl0uUK-JvnfV0ZLcRmFmdNtyHpI5xnmhzEJeHcYE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKvagrwysMUlPazDDaZkmdckisJOcdDobp3utV1vuBkA&oe=6ADCD104"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wueyP8-JGGUQ7kNvwGbZgj_&_nc_oc=Adrf3bRiOGVFxjrQjm3oIKl90WAZE46fQFFboiF8dVgNyCABcBfoqVo4ZEpXqksCfsk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAFIf8drpOtJmV-U9RQe_5QTIIkMbqAoTuQZtz0MqoNw&oe=6ADCD556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tP73NTqSnsQ7kNvwEvAdZP&_nc_oc=AdpYDDtaDomyGdqLKqt_r9pJ9g9VZNSoJsyXsCDvsAsjFBGFyfD0xs-oo0Mzt5i1o5Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwibpispkpEtPENUTISy2cGWK7q3Ko8PMTOllaeGzE3Q&oe=6ADCA490"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoESDRMOuXGW8ERgvby1Dwy4xxV6FnBqb28LUz5VnOpw&oe=6A8C27E7"}, {"file_name": "ControlFreek_Screenshot_04.png", "id": "1767614340468036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392282_1767614343801369_109016704158575891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rxSrlDOZHkQ7kNvwFNPp7N&_nc_oc=Ado-tFAuQ0y0CctNgJfu3cRn04XzPUeyguyi-ypRE4Mu6StDtvmPWTzzQ4Kh-n3fI6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU_xR6WL3R7C4BlXlJzPTMiuUjFBSwtsZjyX9oCuPwdw&oe=6A8C4380"}, {"file_name": "ControlFreek_Screenshot_05.png", "id": "980966914013238", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393526_980966917346571_3254616300426915171_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dBctMenQnUQ7kNvwEEMQ3m&_nc_oc=Adorq8bN2MMs2NDL4lV3qnMgbE1DWRJZF2kk0pDbQjoOVc7UtFRUkSo8wGdBRSxgUFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_DgfZXZ2dMH5MOaisY9aZwePB95CZIuVJh7isSXBaQQ&oe=6A8C37EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1212520106964981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393117_1212520110298314_7656074111046047489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChUH82AEEwsQ7kNvwF4_Xxm&_nc_oc=AdozebT4YP496tFqEY3bo8DIZUhxUT2YC328R0cCY_6reL7L3S7RqDLu9CFKnbmsvN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaNwOdDBJlAr-zsd7AZNgyebjWZbybp1lhcJ9LSel_qg&oe=6A8C342A"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "This is Control Freek, a game about pressing buttons really fast, because sometimes, that\u2019s all you need in life.\n\nWe\u2019ll keep working on this game based on the number of reviews it gets.\n\n5 Reviews - Fix bugs (yes, after release).\n9 Reviews - Global leaderboard.\n11 Reviews - Add a trapdoor exit, because why not?\n23 Reviews - Probably a new level. No promises, but maybe.\n42 Reviews - Add an actual menu so things feel more legit.\n69 Reviews - A new button. What does it do? We don\u2019t know yet.\n99 Reviews - A level with the new button.\n112 Reviews - Full level editor, because why build levels ourselves when you can do it for us?\n\nWe don\u2019t know how far this game will go. But we\u2019re having fun making it, and if you\u2019re having fun playing it, let us know. Leave a review, push some buttons, and let\u2019s see what happens.\n\nOhh, btw. Tell us what you think or what you want next here: https://discord.gg/4Zw3jA2T9p", "short_description": "Push. Flick. Slam. Repeat. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9514271041961827"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "493853269788123"}]}, "baseline_offer": {"id": "493853269788123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742564940, "status": "PUBLISHED", "id": "493853269788123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
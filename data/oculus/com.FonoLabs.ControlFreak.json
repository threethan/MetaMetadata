w5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V0l-_UWEXvhUrSl2DgE6UCErWYYvahP5Zwpb1DGT5kQ&oe=69E64327"}, {"file_name": "ControlFreek_Screenshot_04.png", "id": "1767614340468036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392282_1767614343801369_109016704158575891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8JcJExVoewQ7kNvwGhr7-a&_nc_oc=AdpIGU4h7rdjxhUNi3noOLbghYF3xJZzHAeFjPnRM0b_h99SWielhtu4SDwQRYcnuvw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RzjV_dbeh3LikFGYT9-0Sbr4wPtf7orZsbv2ndR4yDA&oe=69E62680"}, {"file_name": "ControlFreek_Screenshot_05.png", "id": "980966914013238", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393526_980966917346571_3254616300426915171_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgXb1tCFLuwQ7kNvwG8Hwh8&_nc_oc=Adp7__IBXd4egUu5uobd0zOtxDPidva0pTGGPHO5wBByHrF5xnNyaGqfX4CCpI-46V0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f_iyYcX4ENWFAxTs8L8c6fbCG0drZnh5nCU2CT6Xb6Q&oe=69E61AEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1212520106964981", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393117_1212520110298314_7656074111046047489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCemcfu8baAQ7kNvwHbWf6u&_nc_oc=AdpIETkyUFeAWmWd2aDmslJUhgTMih-NTdPIA5ehEnwWEeQPi-fYN3Zhdna_aJlQe4U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PhLqRDZlSab3KFzXXZi_W2lUaydAYzw00cbf8cx_gmQ&oe=69E6172A"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "This is Control Freek, a game about pressing buttons really fast, because sometimes, that\u2019s all you need in life.\n\nWe\u2019ll keep working on this game based on the number of reviews it gets.\n\n5 Reviews - Fix bugs (yes, after release).\n9 Reviews - Global leaderboard.\n11 Reviews - Add a trapdoor exit, because why not?\n23 Reviews - Probably a new level. No promises, but maybe.\n42 Reviews - Add an actual menu so things feel more legit.\n69 Reviews - A new button. What does it do? We don\u2019t know yet.\n99 Reviews - A level with the new button.\n112 Reviews - Full level editor, because why build levels ourselves when you can do it for us?\n\nWe don\u2019t know how far this game will go. But we\u2019re having fun making it, and if you\u2019re having fun playing it, let us know. Leave a review, push some buttons, and let\u2019s see what happens.\n\nOhh, btw. Tell us what you think or what you want next here: https://discord.gg/4Zw3jA2T9p", "short_description": "Push. Flick. Slam. Repeat. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9514271041961827"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "493853269788123"}]}, "baseline_offer": {"id": "493853269788123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742564940, "status": "PUBLISHED", "id": "493853269788123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
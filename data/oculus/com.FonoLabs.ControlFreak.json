Dd40ItQr84MRUcYQXL1tvfJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7IuYFDNIv7go-5mU3rk7WuM0ZEPvBhr4BCa3aEIYujQ&oe=6AB92F33"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5WHa6kmmAAQ7kNvwFpLWXP&_nc_oc=Adqp7BDHme3PocLjyvX-rLbZKtna85i4aHHBAko4qeO8Bhz8JiGazBkgjhX63tCRHYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp6Ur3FaaWe8agRfVC-hNNYxKj6VMZXpL-tKmEznIsWg&oe=6AB925CB"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTd5noPQO9kQ7kNvwGD-zOZ&_nc_oc=Adqtn9mdwTKQeKNBD6YaR2ktjyvG0loSGxOzaadvfg-2WermYASw7iWTEPrY4gyWLk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjH5DsUm_6s9W4vUoaoZAz46Ln4iGwUzZJ-0YUCbzTag&oe=6AB93884"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWQHT4tyVRcQ7kNvwFzZLKa&_nc_oc=Ado3dZJAKgyh3Yr8zo4Pe8LMwv9yNv46T2XFrpGz9jK3pKEqPQg7baN5MijiJ4MevcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoxnWoToMs8WqSxce-ZOT4tm8GPR1vBhFG3agW6LeU5A&oe=6AB93CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7btvh3R0s8Q7kNvwGpXjUc&_nc_oc=Adrm1TxR9l-DwtszpPNYh5k47wCJvdbG9Qh_Okmh_aEM39HQLkkRKgNxHz5ea4jKE74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK1SamAiT26oMUJXcWNSUbfujKJ1qS4NWUd_FMXMnJRA&oe=6AB90C10"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "**Welcome to HI-CORP, Employee.**\n\nYou have been assigned to a control cabin. In front of you: a panel of levers, switches, buttons and cranks. Every control is real. Every control answers back \u2014 in sound, light and touch.\n\nYour job is simple: run the machine as fast as humanly possible.\n\n# Your responsibilities\n\n- Complete the production sequence. Then again. Faster.\n- Beat the clock. Beat your friends. Beat Employee #4471.\n- Climb the **Employee of the Month** leaderboard \u2014 it's global, and everyone can see your name.\n\n# A note from Management\n\nPerformance is monitored. Satisfaction is mandatory. Fun is guaranteed.\n\nTell us how your shift went \u2014 or file a complaint with HR \u2014 on Discord: https://discord.gg/4Zw3jA2T9p\n\nPush some buttons. Leave a review. HI-CORP is watching your times.\n", "short_description": "Push. Flick. Slam. Repeat. Your shift starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_mode
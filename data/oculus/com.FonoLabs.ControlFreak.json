qq_exozoW7l2tTDHlQO_Mx_826jUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-vkWisnq-WHE8ZZLDvJb-3cIpa-Jwrq7IOKhQkJGQrw&oe=6AF33133"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z469aaTzPEQ7kNvwH_5X4y&_nc_oc=AdpipiSwVS7stJlJR7-23RPOjBE81l1DBi-AI2qX7BnK6ePPbpo2aOnJHhTUEhkQiRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2VyHXMfWla8fYc8HPxSCBfAR1QKT1HK3HglAE9lutCg&oe=6AF327CB"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIH4wH-48KEQ7kNvwFaDX-g&_nc_oc=AdqIXEI2ioPj9flsP5akGeXZMHirF1rMi9gDfa33Ee6J3PiUz6PdAIopmF0HIKI4OsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaUd1KJe5A0VYwq-YHQwpyMmZfkIO33KqYTJh4gwdVdA&oe=6AF33A84"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6qXHd_ZRMoQ7kNvwFPVI9d&_nc_oc=AdorCZVEOyZckX3qmG2gHPxttDISZXxbv946YobFfNvRf4Qvu8s741Dm8SOaepqoN1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1VSsW_-qy6G5m3LLLk7AQzhnhW1inESyCmcPE-uU9Hw&oe=6AF33ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1ipcg9Tb9wQ7kNvwEE5a44&_nc_oc=Adobn3VM6PxcDrMBT0ruZY8xuuhv7I28Ia8l6xtsM1wqpfLKfVTzk5NzlVSeSubMPJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoBQtE5zrqmnceasy9w1Vri9fLYrsWYNCoHg9fbQf8FQ&oe=6AF34650"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
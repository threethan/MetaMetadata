0a&_nc_ohc=MbcSvXCKr7kQ7kNvwFGlk1i&_nc_oc=AdoqnsGAT3zCqMg47FMkahfXC6OIpuPFdOspem7TMKvrUEAuejtE9NBxil21I1F0R_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2J82OSo_tv-IhAsK7z9hpYE0glCe8GUtrDMOvgK4sA-w&oe=69F0B11E"}, {"file_name": "ControlFreek_Screenshot_05.png", "id": "949077214225278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_949077217558611_4253678252882718775_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbUzna_1D1cQ7kNvwHLZHSL&_nc_oc=Adq6DmTQtNO1ZH5UNGrz8XTidJmXdhp23VC9rPO3XbbI3uVfbJzDWSHeWGXdoOqdAOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1K3tttEltKYvpwFI3ndb-Eba4d6TV0Y9h34DSznfiioQ&oe=69F0C9C2"}, {"file_name": "ControlFreek_Screenshot_03.png", "id": "1863481834311432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1863481837644765_8367554335697643635_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQRyFFsjwNEQ7kNvwF8Oqvc&_nc_oc=AdrGvlQZWUjLA91-4jfQReCi9sOVx9Fai3TxNKFnix2ydUxCzaH1Pv4RQLsXMRndKo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2GDjAE8FWsiYsEmZiigmel1nC2THKOZbQhqLVevRAR9Q&oe=69F0CC1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "929921926665968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_929921929999301_525832794920388858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jv7MkuqBuXsQ7kNvwEVkDv4&_nc_oc=AdqEE8zUlosstu1zcRKn7YL945Zz15mQsSm00empYYU5pOuOMR0PNiq6VWDc0ggy76s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1qVvUKpvaCwduAa8WRkYCmmSjiG55TTlzLOJFaBalLRw&oe=69F0B0D3"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "This is Control Freek, a game about pressing buttons really fast, because sometimes, that\u2019s all you need in life.\n\nWe\u2019ll keep working on this game **based on the number of reviews it gets**:\n\n- ~~5 Reviews - Fix bugs (yes, after release).~~  \n- ~~9 Reviews - Global leaderboard.~~  \n- ~~11 Reviews - Add a trapdoor exit, because why not?~~  \n- 23 Reviews - Probably a new level. No promises, but maybe.  \n- 42 Reviews - Add an actual menu so things feel more legit.  \n- 69 Reviews - A new button. What does it do? We don\u2019t know yet.  \n- 99 Reviews - A level with the new button.  \n- 112 Reviews - Full level editor, because why build levels ourselves when you can do it for us?\n\nWe don\u2019t know how far this game will go. But we\u2019re having fun making it, and if you\u2019re having fun playing it, let us know. Leave a review, push some buttons, and let\u2019s see what happens.\n\nOhh, btw. Tell us what you think or what you want next here: https://discord.gg/4Zw3jA2T9p", "short_description": "Push. Flick. Slam. Repeat. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26383117737983893"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393438_657698583410684_5774911215584233810_n.png?stp=dst-png_s360
.com/v/t64.5771-25/491825503_1592425808711614_7729290911115928499_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVLq-mYfwlMQ7kNvwE5oohc&_nc_oc=AdpnZjFk6GuiQATiw50GdTNIht_fRztZXKvAeqlUvBksC6dtNlEV13gMrRDHx8ekKb4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z_7Akxqx6IyDlJLCRdrXtb0D51Z1E314x9eD8VGQYkg&oe=6A0C609E"}, {"file_name": "ControlFreek_Screenshot_05.png", "id": "949077214225278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_949077217558611_4253678252882718775_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5-rGG6lyLcQ7kNvwHwPUT5&_nc_oc=AdqoeVjWq2td12BAtOu9hmtNwZy8DtCDGqfKBYsPm1tzTt7ETDw-0p5_gmnUkudxhjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56NxkN9lkh-5spu497J1DzvYrkurTMyB7fSSDDqVT3Cg&oe=6A0C7942"}, {"file_name": "ControlFreek_Screenshot_03.png", "id": "1863481834311432", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823279_1863481837644765_8367554335697643635_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXUMGF7mQ6kQ7kNvwHmfRU7&_nc_oc=Adr_qFYJT8UjZyTp1wr4a1nfLSd5l_ff4sO7W0ienn2zqCODtv0WNeS5jU8EknX963E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zpmTH8idK7EipowmzVUUfOJHAPxuC3OvzDmVWLx0CXA&oe=6A0C7B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "929921926665968", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823296_929921929999301_525832794920388858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4m0UXXcRXgQ7kNvwHI4FDq&_nc_oc=AdoXLriDD0TmI87lrp-bsWojTuhhCJppFHMLaeshK1h7IuENL2RsNFUZjhUdoIvkG7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50JWYPbLnY19Rnujs9aIW4QF0qPUtirXhtI0UNiraH7g&oe=6A0C6053"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "This is Control Freek, a game about pressing buttons really fast, because sometimes, that\u2019s all you need in life.\n\nWe\u2019ll keep working on this game **based on the number of reviews it gets**:\n\n- ~~5 Reviews - Fix bugs (yes, after release).~~  \n- ~~9 Reviews - Global leaderboard.~~  \n- ~~11 Reviews - Add a trapdoor exit, because why not?~~  \n- 23 Reviews - Probably a new level. No promises, but maybe.  \n- 42 Reviews - Add an actual menu so things feel more legit.  \n- 69 Reviews - A new button. What does it do? We don\u2019t know yet.  \n- 99 Reviews - A level with the new button.  \n- 112 Reviews - Full level editor, because why build levels ourselves when you can do it for us?\n\nWe don\u2019t know how far this game will go. But we\u2019re having fun making it, and if you\u2019re having fun playing it, let us know. Leave a review, push some buttons, and let\u2019s see what happens.\n\nOhh, btw. Tell us what you think or what you want next here: https://discord.gg/4Zw3jA2T9p", "short_description": "Push. Flick. Slam. Repeat. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26383117737983893"}, "review_messages": []
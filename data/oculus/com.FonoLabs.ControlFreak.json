afoB4CBu6pfRQQSrxjK3baHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlzCUT8pMxtkjf1MYS8p3vKK3Ox-U80YJKs-nhpNspKA&oe=6ABBD233"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5WHa6kmmAAQ7kNvwGBTadg&_nc_oc=Adr1U_thVRCH_I9Wny7IximvezjEAZrz24ucps8lW7KCJTU55DAE1cnHWdn-CwWWRE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCGgzS8xYM3F63nat-PKOV8lFnheMNhhI3yi7n7K9nmg&oe=6ABBC8CB"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF211xLAI48Q7kNvwFaYgBZ&_nc_oc=AdonQoU06zy9I_30CrXmgCFonnZ9Q972ZGMiWwJGkKxyDZsUlT7-MXDmDakyTNmtOmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn9agrwfjkQYrjCI2F6a27hjSFWmnoYo5i4IymYw7VVQ&oe=6ABBDB84"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkvRvbkCkBwQ7kNvwFMVo0Z&_nc_oc=AdrQ0-Gj4Sowj5fIvKMoSyHKxWKGn_-RE8RfV004RijMIRwCB74ggjbUFLPbllsXLGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnJ7yiA-VZ2M1Be9Hn6-kXc4HjyzwcZBl3VX8YmDjn4w&oe=6ABBDFD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOy7yW7bZWAQ7kNvwGo-xSc&_nc_oc=AdoStfi9Wj3LwA_fc5psTSNR-9p84O_hFcLbtBzY8oB7ZJyzfDvBL3I6aK0kueQ7iFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU7akeA3hDI7dLgT-iYIroJM5W4fqcy7mH9JmwG6Tq6g&oe=6ABBAF10"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "**Welcome to HI-CORP, Employee.**\n\nYou have been assigned to a control cabin. In front of you: a panel of levers, switches, buttons and cranks. Every control is real. Every control answers back \u2014 in sound, light and touch.\n\nYour job is simple: run the machine as fast as humanly possible.\n\n# Your responsibilities\n\n- Complete the production sequence. Then again. Faster.\n- Beat the clock. Beat your friends. Beat Employee #4471.\n- Climb the **Employee of the Month** leaderboard \u2014 it's global, and everyone can see your name.\n\n# A note from Management\n\nPerformance is monitored. Satisfaction is mandatory. Fun is guaranteed.\n\nTell us how your shift went \u2014 or file a complaint with HR \u2014 on Discord: https://discord.gg/4Zw3jA2T9p\n\nPush some buttons. Leave a review. HI-CORP is watching your times.\n", "short_description": "Push. Flick. Slam. Repeat. Your shift starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_mode
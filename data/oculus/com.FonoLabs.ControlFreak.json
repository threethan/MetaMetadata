a5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pxmvnEYlH7i5hdneyerD_ZnBWHDJHHGm54t8IoJ7hvQ&oe=6A2C22A7"}, {"file_name": "ControlFreek_Screenshot_04.png", "id": "1767614340468036", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392282_1767614343801369_109016704158575891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZkfVC3slVwQ7kNvwF30uk3&_nc_oc=AdqU8VF_hBADAC1yh8GpopcwoBTkuOp1mfZHbQ1JP-vomuisE-wKvHy2cPZhRXB62Ak&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iCQlylbMcJoz1gU8wNPB2ps8PpGlX1bHh3JZOOMAKFg&oe=6A2C0600"}, {"file_name": "ControlFreek_Screenshot_05.png", "id": "980966914013238", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393526_980966917346571_3254616300426915171_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbvkgXFJlLAQ7kNvwE02ytH&_nc_oc=AdpiTV7Q4FC5aZjS2_KyUod3jYu4CiQjeCvflFXCrF0IPSMqh1eyN9TGvuaNbq-bZc0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f0RaKllpkjQG4THyduBCN--4zSOvdBt7vuAdAF1lawQ&oe=6A2C32AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1212520106964981", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393117_1212520110298314_7656074111046047489_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooogRvTBdJ0Q7kNvwFeNp7r&_nc_oc=AdovzAoz1PvyBMPrSOT45FDep7EVbtWfClBQ_ioW5WUPDxyT5kLuMiBr69PFrfsLZIg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pja92KHmrX0SH_VwNSUQtYsQvg5MpCdOZ8yBke1erOg&oe=6A2C2EEA"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "This is Control Freek, a game about pressing buttons really fast, because sometimes, that\u2019s all you need in life.\n\nWe\u2019ll keep working on this game based on the number of reviews it gets.\n\n5 Reviews - Fix bugs (yes, after release).\n9 Reviews - Global leaderboard.\n11 Reviews - Add a trapdoor exit, because why not?\n23 Reviews - Probably a new level. No promises, but maybe.\n42 Reviews - Add an actual menu so things feel more legit.\n69 Reviews - A new button. What does it do? We don\u2019t know yet.\n99 Reviews - A level with the new button.\n112 Reviews - Full level editor, because why build levels ourselves when you can do it for us?\n\nWe don\u2019t know how far this game will go. But we\u2019re having fun making it, and if you\u2019re having fun playing it, let us know. Leave a review, push some buttons, and let\u2019s see what happens.\n\nOhh, btw. Tell us what you think or what you want next here: https://discord.gg/4Zw3jA2T9p", "short_description": "Push. Flick. Slam. Repeat. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9514271041961827"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "493853269788123"}]}, "baseline_offer": {"id": "493853269788123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742564940, "status": "PUBLISHED", "id": "493853269788123"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
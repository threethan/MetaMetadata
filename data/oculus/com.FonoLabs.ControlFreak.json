U4K3aPjZ1-jbi8kSaWpQexHfW2DVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpGdbfqP_AODOUvgACwIlRpWxdqWUCj__k5gaQx3r3bw&oe=6AE20DB3"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNLKXsI6fH4Q7kNvwGhFQdG&_nc_oc=AdprsAQE6pEflfcSqrNmb1pHm0SJMOZy2RTm4zYIO0hzbVzF63aBRDetY8HWnlz1boY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXztSSt9ry4VkOkGQWvtvcmVz_OOVi4g9fRhfs3rIIKg&oe=6AE2044B"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v48Y1dy6TkAQ7kNvwHCa65n&_nc_oc=AdrhJ_sjOApy3jk5o8zwNXLjE2_NqoyBmNh6Tbui9DyDcHUNNlWAWnDBW_3Oh3BrGUI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzJ26G-hEhnKIy01fvp-K3troTB8Y_vUhtHaEVplyUvg&oe=6AE21704"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxIe1Hu-dMIQ7kNvwEbnd1L&_nc_oc=AdpwGK-Ix3l0EpOQNYXTtDxj4kcNnyHTdUFMm4DXJLdtS8-g2YDY0vXYdHb9IGj8Pzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvCc-UWvkJ_2CKNM7f9DzPXJpoutF9v-j4JY0a286wzQ&oe=6AE21B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a_SW-T5i5wQ7kNvwGqsXGe&_nc_oc=Adr5N1ggoOYfh0TI9xn68AtnSAFq8PIyIORzDADmebqslk61hH-iHG04XRtHLNWKaNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP356uAOXhi3fTqn8QuxIACRarO80hXzm2CH7BF930ELg&oe=6AE1EA90"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
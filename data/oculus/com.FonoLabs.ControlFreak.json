m/v/t64.5771-25/491824318_27292244040449194_3509206164409486334_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYpArt3q8jQQ7kNvwGTzTe8&_nc_oc=Adr6qA_SgVoYhQflmZ8oGqvNVy2u1ihGLNRs4wxwTf5IorJD53tqTGqyn9j_7ZbgRTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWuziy430DRovZmDVDcGGCwA-UrgsYKGkfttfiG2qwfw&oe=6B106A73"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmcyXgXvoOgQ7kNvwGF3wVm&_nc_oc=Adq_pLVs7gOvfovYhEnC5RgpkoKVvKt_4bSYKu5K-RWI6_mpNBREbAmXAUZcVdPAO_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPiqqx3ezfc-p-HDIEgVICZNRO06Pblzy4AGQ_T2KoDg&oe=6B10610B"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z54Q5DUAliMQ7kNvwF_v19c&_nc_oc=AdoUDUWq2Tqrln2-Ipxv56wT_fjErkoI7O4K9r-k0KXEPEKQsY1C1zzE_KF7HLct5-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUK-0nF-2MoGCfCRzFhFXz2jFxa9vw9cl4SsQ-9g-Ztnw&oe=6B103B84"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgXizq5XoJMQ7kNvwHvsZf-&_nc_oc=AdqgE2qUlOuURzBooQvUZ7JoeqFYzp6Uh0H7WxpdASkWzdaRU4vWU_-W0caUk17sTtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_MwQq24wWpXgIvfkIHGzjDoksubv6bT63BZNuNpfnCg&oe=6B103FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1ScaScN8y8Q7kNvwGTl65y&_nc_oc=Adou6SsD-2WR1Liav6sC6HYeD5nNlvTB9bj6B-IDUtAVz9NL8dFhDTOhKsBKCI4I_Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnJdB_T8qpuOqETa3JbmJVr2fpod_ENUhLf2oZw636Og&oe=6B104750"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/contro
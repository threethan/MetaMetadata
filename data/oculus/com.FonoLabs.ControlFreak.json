2LBu6CSAdxccopE0HK2Uoi88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjOAk_WBuepmnNFGqU_gIPjjkCrHkhG_QOcHf4kLx0ig&oe=6AB3E933"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC7ggV-ez5oQ7kNvwFqI-xp&_nc_oc=AdpKMshUOsBXOAg7D_EGZNYw5fpo8jahEzJKYnxoLUgkFp2cpH5jLvKKBllRoILQL7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq7THAhyKN04I2GTKc-tmF6CZE4Zz_HJWDFLU5ZZwYkw&oe=6AB3DFCB"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBzNeU-YLXoQ7kNvwGOAL5l&_nc_oc=AdoIMuB4gWT3cBzWl7Jkr8dgy5JNFWdLPSVQOKf7cqVkQRV2LSSxmmApau3FxjlzCeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUYMQnPmIsrqRxK67HkoNDXqKg4U9iXLbZyw5MrCMqzg&oe=6AB3F284"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb-BuqYkIcwQ7kNvwF6zqSQ&_nc_oc=AdovvxUwY_S8nuV0XWvUsqeAY2YlbxB9CoCWvQlAofEIXl9g9ohH9y1joq2DYllNTYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDKKRbOe2MRWlYIvCnmp09wTw-BwJ0oFTsYm59I22dxQ&oe=6AB3F6D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmljIuDOwVgQ7kNvwFYRq9e&_nc_oc=Adr8HepVF5IMnxm4VzsuLuvdbuBqZaKm_lhvvyOVSSo3YhQG8QyI7VM07wqVI5r93oY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoEvRNFpChKBL6b-IX11RFq4GSye2Ew209oQx5K10MsQ&oe=6AB3C610"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "**Welcome to HI-CORP, Employee.**\n\nYou have been assigned to a control cabin. In front of you: a panel of levers, switches, buttons and cranks. Every control is real. Every control answers back \u2014 in sound, light and touch.\n\nYour job is simple: run the machine as fast as humanly possible.\n\n# Your responsibilities\n\n- Complete the production sequence. Then again. Faster.\n- Beat the clock. Beat your friends. Beat Employee #4471.\n- Climb the **Employee of the Month** leaderboard \u2014 it's global, and everyone can see your name.\n\n# A note from Management\n\nPerformance is monitored. Satisfaction is mandatory. Fun is guaranteed.\n\nTell us how your shift went \u2014 or file a complaint with HR \u2014 on Discord: https://discord.gg/4Zw3jA2T9p\n\nPush some buttons. Leave a review. HI-CORP is watching your times.\n", "short_description": "Push. Flick. Slam. Repeat. Your shift starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_mode
PSWDOR_3k0Zgvvp1pP_yctLxqu9mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1zkCAfxpG74BmdopyFTYLZQ1UduQ5ZYg7vdjCPn11Og&oe=6AD23BB3"}, {"file_name": "Screenshots01.png", "id": "1109337971748811", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1109337975082144_2868233776751948265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HuP8OokJ94Q7kNvwF1pp7l&_nc_oc=AdpMofkMBcKRqJL-CdrsqZzio2X77vLU3hxKoAyjCC-jgRa9YX7iRnBwk50fJCLlgk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcPcxim6wv6p7Flm-BDe7Fkd2k72KpwdpjatwyKVaqbQ&oe=6AD2324B"}, {"file_name": "Screenshots07.png", "id": "1384542647199119", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1384542650532452_1440589814285122188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei7fiwlqvIQQ7kNvwF-F4-4&_nc_oc=Adp8vB_rFahHuBL1IYpFIrtO9hI80P1iOtmYWP8-p6elkNvSl4xP5dGMz8iwv33WUrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv7oT_c7wh6NNqjlQ2vX8i4s-1Z0EyynnhlIGtCsyklw&oe=6AD24504"}, {"file_name": "Screenshots02.png", "id": "1400532592047808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_1400532595381141_3399314511837708075_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr9ad9KgeBYQ7kNvwFok2d9&_nc_oc=AdpHrW5QuqXIbWwpoWBB-6MXG2FQWb1hPSsinKZ5HSd1bhr-6t7Ovh2x9cYAYsrKfu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVSCW7W_NiB35H1p2Dtk_dJPOKZoUYjy6Md1Oclj3fDg&oe=6AD24956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_s logom.png", "id": "985519041223669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_985519044557002_3272235211507795905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeGPHVBWgF0Q7kNvwH1oXmB&_nc_oc=AdpGnjyCBIfgMHR1HelZ2a1BBe9IyntpOQg02j6CYh3ctalDnxk6Q8XjKwA4UqzEHDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6dm5bZOVUtHKb9wcgvuCsD-eli3KBfCD-wtji9IAHbg&oe=6AD250D0"}, "display_name": "Control Freek", "keywords": ["Reflex", "Speed", "Buttons", "Challenge", "Time"], "long_description": "# OPERATORS WANTED!\n\nWe are looking for new hands to join the assembling team of the HAPPY ITEMS CORPORATION (HI-CORP\u00ae) and race for maximum effectivity!\n\nYour task will be to control the HI-Console\u00ae and keep the HI-CORP\u00ae production line running. In other words: Press. Flick. Push. Pull. Levers. Cranks. Buttons. Switches.\n\nExecute each sequence in the correct and timely order to manufacture a certified HAPPY ITEM\u00ae. Successful completion resets the line: an infinite loop of productivity, purpose, and joy!\n\nYour duties:\n- Master increasingly complex variations of the HI-Console\u00ae controls\n- Outperform your Co-Operators on the global leaderboards and become Operator of the Month\n- Share one headset in Party Mode: colleagues, relatives and houseguests take turns at the HI-Console\u00ae, and every level keeps a local leaderboard so they can be ranked, compared, judged and thus motivated to improve\n- Operate to the sound of our tailor-composed HI-CORP\u00ae soundtrack, engineered for maximum joy\n- Most importantly: always have fun!\n\nAre you ready to push some levers and limits?\n\nHI-CORP\u00ae\nHuman Resource & Joy Management\n", "short_description": "Junior Operators wanted! Master the HI-Console\u00ae!\n\nA VR arcade game of pulling, flicking, and pressing analogue controls\nin fast, precise sequences to keep the HI-CORP\u00ae production line running.\n\nSpeed up, skill up and become Operator of the Month!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fono-labs.com/wp-content/uploads/2025/03/control_freek_privacy_policy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
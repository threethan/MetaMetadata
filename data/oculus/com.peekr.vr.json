01_manga_spread_color.png", "id": "2536135856857053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_2536135860190386_5703302263429996953_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xeDVuD8q0gQ7kNvwFyRh7g&_nc_oc=AdpM7571wNxF9lqzhbe8Ch9C5NPYxldF5DvLP07W_xWu_V6Xrn1bfndU7ml1H6s1y_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I8Akwoobew0QmCiBBkq4-mSAyoK_8j1ifpZ-Dx_MvdQ&oe=6A3BEF0E"}, {"file_name": "02_manga_spread_bw.png", "id": "1581978213544674", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_1581978220211340_3920643153682528753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HeRjJohU9sQ7kNvwFVkPFn&_nc_oc=Ador45dKm2vKHKteoLy7HBQuY_Ep7MTNaN1snX_D6x-YmRWh7zgNiLaBK_RA-YyqOhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zFz61-6TfW5XVR1ZqT2MrdTHiX6sOoqx8agzux-ynGA&oe=6A3BE9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1739803200793397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1739803204126730_8596872080155761752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyQorEOFaQQQ7kNvwFAQF0q&_nc_oc=AdqkdzjpKfb22TsiHo2vSCVc_eTIN3HznzqwXe2dq6Q_5BMesyF420JdmXChFre2DGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87kjCatamdDZ7Lcf5HUKbXCKtCJze1DzMKvB0GG8YlaA&oe=6A3BEE4B"}, "display_name": "Peekr VR", "keywords": ["manga", "comic", "viewer", "reader", "VR"], "long_description": "No unzipping. No converting. No copying.\n\nZIP, RAR, 7z, CBZ\u2026 open your comic archives straight from the folder. Peekr VR is a VR viewer for the comics, photos, and videos you already own \u2014 on your headset or NAS, on a giant screen, as close as you like.\n\nOPEN ARCHIVES DIRECTLY\nReads ZIP, CBZ, RAR, CBR, 7z, and TAR with no extraction. Two-page spreads, auto page-turn, and unlimited zoom \u2014 lean right up to a favorite page and take in every brushstroke and line your favorite artist drew.\n\nCONNECT STRAIGHT TO YOUR NAS (SMB)\nBrowse your NAS folders right from the headset \u2014 no PC, no copying files around. Point it at the same SMB share as your Komga or Kavita library. Connection settings never leave your device.\n\nPRIVACY IS A FEATURE\nWhat you view is yours alone \u2014 never sent anywhere.\n- No data collection, analytics, or telemetry \u2014 ever\n- No \"All Files Access\" permission\n- Comic archives are read only from folders you choose\n- The only network traffic is to the NAS you set up\n\nPHOTOS AND VIDEOS TOO\nBrowse images and videos from device or NAS. View photos as two-page spreads, like manga, or page through a film or art book. Curved screen, video thumbnails, continuous playback.\n\nPLEASE NOTE\n- Designed for Meta Quest 3\n- Touch controllers only (no hand tracking, to prevent accidental input)\n- No content is included \u2014 bring your own files\n\nBuilt by an independent developer \u2014 feedback and bug reports welcome.\n\nManga shown in screenshots: \"Give My Regards to Black Jack\" by SHUHO SATO", "short_description": "ZIP, RAR, 7z \u2014 open them without opening them.\n\nPeekr VR is a viewer for your own media collection. It opens ZIP / CBZ / RAR / CBR / 7z / TAR archives directly with no extraction, connects straight to your NAS over SMB, with unlimited zoom \u2014 close enough to study every brushstroke. Two-page spreads, no accounts, no cloud, no data collection. Your library stays yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekrvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Peekr", "support_website_url": null, "website_url": "https://peekrvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "zh_TW", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1157359380796878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1015740081106553_53466181700402040_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGDUc7QCJbcQ7kNvwFeez4d&_nc_oc=AdqX3OJ-yhg9W4Z4wcUdJKt9Bo0CQj_OTSjUpUGQJJBWAEAP23zTrLUYEVsyFywYu48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xkNkyL2GxdZa4t5_LT6r-imdlOiPsEMkv8l9JHQjndQ&oe=6A3BFAD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Peekr VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1781622000, "lastRevision": {"nodes": [{"id": "1157359387463544", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1157359374130212", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3233461400376379"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1576022587868652", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peekr VR", "keywords": ["\u6f2b\u753b", "\u30b3\u30df\u30c3\u30af", "\u81ea\u708a", "\u30ea\u30fc\u30c0\u30fc", "\u30d3\u30e5\u30fc\u30ef\u30fc"], "long_description": "\u89e3\u51cd\u3082\u3001\u5909\u63db\u3082\u3001\u30b3\u30d4\u30fc\u3082\u3044\u3
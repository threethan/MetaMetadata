e": 1782214216, "id": "1172237269309089", "version": "1.1.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1157359374130212", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1189594050906744"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1484084902881097"}]}, "change_log": "\"Peekr VR \u521d\u56de\u30ea\u30ea\u30fc\u30b9\u3002\u6f2b\u753b\u30fb\u5199\u771f\u30fb\u52d5\u753b\u3092\u3001VR\u306e\u5927\u753b\u9762\u3067\u3002ZIP\u30fbRAR\u30fb7z\u3082\u89e3\u51cd\u305b\u305a\u305d\u306e\u307e\u307e\u958b\u3051\u3001NAS\u306b\u3082\u3064\u306a\u304c\u308a\u307e\u3059\u3002\"", "created_date": 1781357229, "id": "1157395607459922", "version": "1.0.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ntent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qKnT6UnMA499mJmiERpPaB7B63lO11PxD2QWoSWVJgA&oe=6A3FE38E"}, {"file_name": "02_manga_spread_bw.png", "id": "1581978213544674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620497_1581978220211340_3920643153682528753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh4fNuE3m3oQ7kNvwGHdvAR&_nc_oc=AdqQHwN3N6eTo0w8Dj_nlEF1HEbaQtjH0eqb60V7VolgDd6-SecjawRDmKPsu_wMB1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y1dRUgiXyxByiTIbSV7tybIeBV-kSVLyxnfR31kWjvw&oe=6A3FDE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1739803200793397", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623314_1739803204126730_8596872080155761752_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmRaWjjWF0UQ7kNvwE0x-yb&_nc_oc=AdrJLlq5_2EKiWdpIg0WMZFuScApYzmCR6PNZLOU0UV5qqYAhUXRQyvmDOVfP-zysAA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VKFzlk4jeb0oOWfIQq7uQ9XcIlbIGY3gH3SXYAUT-Iw&oe=6A3FE2CB"}, "display_name": "Peekr VR", "keywords": ["manga", "comic", "viewer", "reader", "VR"], "long_description": "No unzipping. No converting. No copying.\n\nZIP, RAR, 7z, CBZ\u2026 open your comic archives straight from the folder. Peekr VR is a VR viewer for the comics, photos, and videos you already own \u2014 on your headset or NAS, on a giant screen, as close as you like.\n\nOPEN ARCHIVES DIRECTLY\nReads ZIP, CBZ, RAR, CBR, 7z, and TAR with no extraction. Two-page spreads, auto page-turn, and unlimited zoom \u2014 lean right up to a favorite page and take in every brushstroke and line your favorite artist drew.\n\nCONNECT STRAIGHT TO YOUR NAS (SMB)\nBrowse your NAS folders right from the headset \u2014 no PC, no copying files around. Point it at the same SMB share as your Komga or Kavita library. Connection settings never leave your device.\n\nPRIVACY IS A FEATURE\nWhat you view is yours alone \u2014 never sent anywhere.\n- No data collection, analytics, or telemetry \u2014 ever\n- No \"All Files Access\" permission\n- Comic archives are read only from folders you choose\n- The only network traffic is to the NAS you set up\n\nPHOTOS AND VIDEOS TOO\nBrowse images and videos from device or NAS. View photos as two-page spreads, like manga, or page through a film or art book. Curved screen, video thumbnails, continuous playback.\n\nPLEASE NOTE\n- Designed for Meta Quest 3\n- Touch controllers only (no hand tracking, to prevent accidental input)\n- No content is included \u2014 bring your own files\n\nBuilt by an independent developer \u2014 feedback and bug reports welcome.\n\nManga shown in screenshots: \"Give My Regards to Black Jack\" by SHUHO SATO", "short_description": "ZIP, RAR, 7z \u2014 open them without opening them.\n\nPeekr VR is a viewer for your own media collection. It opens ZIP / CBZ / RAR / CBR / 7z / TAR archives directly with no extraction, connects straight to your NAS over SMB, with unlimited zoom \u2014 close enough to study every brushstroke. Two-page spreads, no accounts, no cloud, no data collection. Your library stays yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peekrvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Peekr", "support_website_url": null, "website_url": "https://peekrvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "zh_TW", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "su
fEzzKb_owQ7kNvwFfs9t1&_nc_oc=AdqXImI8Sqk2EIowT_aoqNnHjckq9mvDecFz_4sJpZTW4GwOn-qO3A8aUXTLOc-Sgg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u8obVqJfbQa4-Cj_CPd7J38M1KTjzDHTrCXi36m2fpw&oe=6A1EE906"}, {"file_name": "2.png", "id": "1745713363266332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1745713366599665_666472990109766114_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azayGDKeOM8Q7kNvwGPkKjW&_nc_oc=AdoPbHygZyOWg5faRSbjrojHv4H0O4o5Npcdras94oHC2foPFZcLSKnEaVlhwie9ADQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d6Qy8S1dH3Huk55nSocwjpbjM_lWRL_6N5CvXHACPHA&oe=6A1EDBF6"}, {"file_name": "3.png", "id": "2176831896466400", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595112037_2176831903133066_8029495608718644761_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LbL5CLxKKEQ7kNvwGWPnLG&_nc_oc=AdrI0KcIwwIkL9_bKZ0AqVHsQScPpsMO4Xzqc14uUN3aZiORRscvdxnL2UNBiUi_498&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42syX-RJwtk1ZdJ1sGoPrPvrHYAWHpafAU8hj7mYVqQQ&oe=6A1ED334"}, {"file_name": "4.png", "id": "2797049253994405", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_2797049260661071_1865605900004117317_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mxl2dAd65yMQ7kNvwGAwRKU&_nc_oc=AdpOQjesPvxiScLqcus4gA3eP0sDRQNU5l3BBpr_TrozlhyPoHMa0rzPL2EwBanwTCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AUvb1DBcajPRf6tyJ771KjWGr_k1F5J5hAP5jaMPn0g&oe=6A1EE9ED"}, {"file_name": "5.png", "id": "1302404411960361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1302404415293694_5252104956344115274_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nybxMgQ6cdEQ7kNvwFjxkrF&_nc_oc=AdrDJM2ZFrR3lI5IpltxkwVN_pSXDiua2PjoVidWZWF73ndYwltxbfMn4uFSzNN6c0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oYLgUpMYqibPiBYIMEsOiMDiaiq1YKT1cVLuCx1cvdw&oe=6A1F0026"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Driver: Formula Racing", "keywords": ["Formularacing", "f1racing", "carracinggame", "formuladriver", "formulacarracinggame"], "long_description": "\ud83c\udfc1 F1 Driver: Formula Racing\n\nStep into the world of high-speed Formula racing and experience the thrill of becoming a professional F1 driver. Take control of powerful racing machines, push your limits, and compete on intense circuits designed for speed, precision, and adrenaline.\n\n\ud83c\udfce\ufe0f Real Racing Experience\n\nFeel the excitement of Formula-style racing with realistic car handling, fast acceleration, and challenging tracks. Every turn matters, every second counts\u2014only the best drivers reach the finish line first.\n\n\ud83c\udf0d Challenging Tracks\n\nRace across dynamic circuits inspired by world-class Formula racing environments. Master sharp corners, long straights, and technical sections that test your driving skills.\n\n\u26a1 High-Speed Action\n\nSpeed is everything. Use precision driving, timing, and control to overtake opponents and dominate the track. The faster you react, the better your chances of victory.\n\n\ud83c\udfae Easy to Play, Hard to Master\n\nSimple controls make it easy to start racing, but mastering the tracks and becoming a top F1 driver takes skill, focus, and practice.\n\n\ud83c\udfc6 Become the Ultimate F1 Driver\n\nCompete, improve your skills, and rise through the ranks. Only the most skilled drivers can claim victory in the world of Formula racing.\n\n\ud83d\udd25 Key Features:\nFast-paced Formula racing gameplay\nRealistic driving and car physics\nChallenging racing circuits\nSmooth and responsive controls\nImmersive racing experience\n\n\ud83c\udfc1 Start your engine, hit the track, and prove yourself in F1 Driver: Formula ", "short_description": "Experience high-speed Formula racing and become the ultimate F1 driver on challenging tracks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zylostudio/privacy-policymeta-quest", "developer_terms_of_service_url": null, "publisher_name": "ZYLO Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/zylostudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26844433525199574"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830003_1700925790962453_5608881268953183747_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrDpabyavlEQ7kNvwGDh_CX&_nc_oc=AdrakYbMgZhfgfo7luqSJWhB8YWohg0HnXIfQkDVw7cVglZBhVDipjRDdFR1LhRfKIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vDkhuN-RXR_AjBzwKO9J7WovmSP5K_Hnyu1jS2uPXVQ&oe=6A1EDD60"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "F1 Driver: Formula Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1779619740, "lastRevision": {"nodes": [{"id": "26844433571866236", "release_type": "SCHEDULED", "administration_stat
358_480732434947093_6787620936891745978_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzVTQN20NrMQ7kNvwGeA7c5&_nc_oc=AdoXp0u48NmIFaPiJzqbtqxHsuhYnz7DQ73RxuIEWie5tN1W5tO0nof5oaXAfEGlo8I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VurNZGL3A8bOe0jzGluCMco7tg1BCKHzgbxN1oXm26A&oe=6A11C798"}]}, "id": "1065052698679596", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "1276780959875803", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974757_1276780966542469_872932849915269447_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7ExjwitUocQ7kNvwF3XLn4&_nc_oc=AdrjbKqG5Q1j2842vPSqLNL_rZngJvatsfs0_xd9wPRT50tQa0kS1oPXlT8FnT7T4-s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71BijBIn2vwF5J8CadYkDuHRKAUyV8GPaKXx-tbrb3yA&oe=6A11D08B"}, {"file_name": "screen2.png", "id": "466171599769971", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974507_466171609769970_3557325799633369321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV6oAstV3vIQ7kNvwE5xarF&_nc_oc=Adr2FR2bYoX1clTHwbRVuigiU4HY3SNBj2UBzjbbA6rXfIFpzf3WhUoOw82nk5WGGy8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pxXmywyR1wSirCDQ-n2zrgbAirn-WfGWkiAHM4i6Zqw&oe=6A11C9BB"}, {"file_name": "screen3.png", "id": "1821750798233258", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031516_1821750801566591_4899462947305189757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iew4GHtNACkQ7kNvwHnsoBT&_nc_oc=Adr6YDcsIf7eGqEVf5mY-f2FMerFI_KoWTmSyt8a5uMB7JIMaiOCXYk4fJzu-OoDUPQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42itfdsJSjeUaonYjzEDhmyltNZRf9Mvd4FxdFuZ4ArA&oe=6A11A552"}, {"file_name": "screen4.png", "id": "1595498638067989", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982555_1595498641401322_3163710687210050200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMFVPCtw92gQ7kNvwEIF_UK&_nc_oc=AdrJzjts0-j6W59-wEgHrmp_i7y54xWYa1RNVYVNZT7V0VCjau_5LXYYV_p-QStoV5Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g00h1iJ1gJxNEhXwJ_eZ8U7vgXpideJ8SUpWpHin98A&oe=6A11B2A8"}, {"file_name": "screen5.png", "id": "1669339583626503", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035354_1669339586959836_2814191112560207839_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coE6An5KbMoQ7kNvwGWfI3A&_nc_oc=AdrBYHdy5wuFsFRtDgN5pJS0F_ZdhLZ90Ff6p92QE7KvspVVFynP5pfktPfquv4Io5U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5khaAXNXzGy3b57bEG2XSlWVxd9kuBpuNnbP4Nkv9zMQ&oe=6A11B265"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London: Changing of the Guard Experience \u2013 VR Travel", "keywords": ["London", "Guard", "Tourist", "Travel", "Sightseeing"], "long_description": "Each year, millions of tourists gather at Buckingham Palace to witness the iconic Changing of the Guard. This ceremonial display of British discipline has been attracting visitors since 1689, making it a must-see event in London. Now, with our VR experience, you can skip the crowds and get an exclusive, up-close view from a vantage point few can access.\n\nFeel as if you\u2019re sticking your head behind the palace railings, while tourists stand crowded in front, trying to catch a glimpse. You, however, get a clear view of the guards marching, accompanied by traditional military music. Immerse yourself in the authentic sounds\u2014the clicking of boots, drumbeats, and the bustle of the crowd. Experience this exclusive perspective, impossible in real life.\n\nAfter the ceremony, take a virtual walk around Buckingham Palace. Picture yourself walking the same paths where royals have strolled for centuries, with street performers and the buzz of London life around you. This 75-minute VR experience offers the perfect escape, letting you leave your routine behind and enjoy British history and culture. It\u2019s like a quick day trip\u2014step away, clear your mind, and enjoy a peaceful moment in an iconic setting.\n\nStep into a world of British tradition, enjoy the ceremony from an exclusive view, and experience the Changing of the Guard like never before\u2014where you're not just watching history, but living it.", "short_description": "Experience the Changing of the Guard at Buckingham Palace from an exclusive perspective that is normally out of reach. Take a spontaneous break from your routine and dive into this iconic event. Watch the ceremony through the gates, turn around, and see the tourists crowding behind you. Enjoy authentic sounds and experience London through the eyes of a real tourist \u2013 a quick trip that offers you a unique view of this unforgettable event. #BuckinghamPalace #ChangingoftheGuard"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Changing-of-the-Guard", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28051628607769172"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1309067927221066"}, {"status": "PUBLISHED", "id": "3798262807149078"}, {"status": "PUBLISHED", "id": "1958283445104510"}, {"status": "PUBLISHED", "id": "1191413805869300"}, {"status": "PUBLISHED", "id": "1550300752880273"}, {"status": "PUBLISHED", "id": "809774808449100"}, {"
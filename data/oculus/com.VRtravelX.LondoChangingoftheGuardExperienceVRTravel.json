ps://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982555_1595498641401322_3163710687210050200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxPh9jN8c58Q7kNvwEjWB8m&_nc_oc=AdpnkCX7QsFhmH-ug6EOqco-uBjyN9SDMv_p2iF5XsntoMke5a4qLh-JPVyv36cYUuE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIXiE0l27WICRUDSzfp5yqrPxOzPR-eNDcHEttCv2Wtg&oe=6A7DCDA8"}, {"file_name": "screen5.png", "id": "1669339583626503", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035354_1669339586959836_2814191112560207839_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpdM6kNlFEAQ7kNvwE3Cqsg&_nc_oc=AdqiCBbBGSD2CZY_Y3a4qv33X5F3dj4pODiH4P3A_qQtRDDTF54R53NjkAPuu7xgPBI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGECY4Mv11A02nwPXeDz0a-qWoz8nfSCE8tzlungrStg&oe=6A7DCD65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London: Changing of the Guard Experience \u2013 VR Travel", "keywords": ["London", "Guard", "Tourist", "Travel", "Sightseeing"], "long_description": "Each year, millions of tourists gather at Buckingham Palace to witness the iconic Changing of the Guard. This ceremonial display of British discipline has been attracting visitors since 1689, making it a must-see event in London. Now, with our VR experience, you can skip the crowds and get an exclusive, up-close view from a vantage point few can access.\n\nFeel as if you\u2019re sticking your head behind the palace railings, while tourists stand crowded in front, trying to catch a glimpse. You, however, get a clear view of the guards marching, accompanied by traditional military music. Immerse yourself in the authentic sounds\u2014the clicking of boots, drumbeats, and the bustle of the crowd. Experience this exclusive perspective, impossible in real life.\n\nAfter the ceremony, take a virtual walk around Buckingham Palace. Picture yourself walking the same paths where royals have strolled for centuries, with street performers and the buzz of London life around you. This 75-minute VR experience offers the perfect escape, letting you leave your routine behind and enjoy British history and culture. It\u2019s like a quick day trip\u2014step away, clear your mind, and enjoy a peaceful moment in an iconic setting.\n\nStep into a world of British tradition, enjoy the ceremony from an exclusive view, and experience the Changing of the Guard like never before\u2014where you're not just watching history, but living it.", "short_description": "Experience the Changing of the Guard at Buckingham Palace from an exclusive perspective that is normally out of reach. Take a spontaneous break from your routine and dive into this iconic event. Watch the ceremony through the gates, turn around, and see the tourists crowding behind you. Enjoy authentic sounds and experience London through the eyes of a real tourist \u2013 a quick trip that offers you a unique view of this unforgettable event. #BuckinghamPalace #ChangingoftheGuard"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Changing-of-the-Guard", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28051628607769172"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "994956723148151"}, {"stat
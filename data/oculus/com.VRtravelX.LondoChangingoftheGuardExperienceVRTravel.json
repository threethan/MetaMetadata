, "screenshots": [{"file_name": "screen1.png", "id": "1276780959875803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974757_1276780966542469_872932849915269447_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7CRAzREaBkQ7kNvwHAg4hc&_nc_oc=AdmV4JBD87JJuaP75ZUiYvLDE3GDAoKIFJOIl59Q9gnj2ifzUI0fvCrAh9NPeq29Lgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftRaTQLULmO8CbpYz_G5kf6D9RHb7cPyi_ArAbE_5InwA&oe=699C42CB"}, {"file_name": "screen2.png", "id": "466171599769971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974507_466171609769970_3557325799633369321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3mVrJRSgkQQ7kNvwEDiNyq&_nc_oc=AdlnKjiZMy0fTWF91GAviBB82qp1eFBv0PthdYRW9S8MrYRfc11AQEH5UG22izKj2M8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu-53q1702c8Il6-YuTiu3gCay0kqW7itS0_5ZZg1Ew_Q&oe=699C3BFB"}, {"file_name": "screen3.png", "id": "1821750798233258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031516_1821750801566591_4899462947305189757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHbMUx2mXOsQ7kNvwGKhaUo&_nc_oc=Adke2o6Z1wEY_feGN180y8fCUQmIvclWG9cJXtKD93nk-TzlVxVwmz8aBI5iE3GWLjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs34FjSueEH5oO5DqJo0yiz7yGqL-sSLuHFmROv0Tm3fw&oe=699C4FD2"}, {"file_name": "screen4.png", "id": "1595498638067989", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1595498641401322_3163710687210050200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ3A0Qgs5zwQ7kNvwEe8kwY&_nc_oc=Adlr5WcR8qOAC6KDAhzaZ70JcJ5LQ06wKW6uJ1aHNwT6vWBL0sPLYSed91ekl_qeChk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftvNnstWPIZPTqjAww-SrDS4K3izn-4EaRDJbIThgOCMw&oe=699C5D28"}, {"file_name": "screen5.png", "id": "1669339583626503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035354_1669339586959836_2814191112560207839_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt7WffQ1XhoQ7kNvwEIwBc1&_nc_oc=AdnSzJ8DvjOmFA_ebWqJT7aNIYnZbYYy13POWMwBcaKVLawFK5LDfNri9OUSNXdfTaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvU4fFvq3orqEK76U-8fD8mMbDfZpu6GhohVAPyXLL_KQ&oe=699C5CE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "London: Changing of the Guard Experience \u2013 VR Travel", "keywords": ["London", "Guard", "Tourist", "Travel", "Sightseeing"], "long_description": "Each year, millions of tourists gather at Buckingham Palace to witness the iconic Changing of the Guard. This ceremonial display of British discipline has been attracting visitors since 1689, making it a must-see event in London. Now, with our VR experience, you can skip the crowds and get an exclusive, up-close view from a vantage point few can access.\n\nFeel as if you\u2019re sticking your head behind the palace railings, while tourists stand crowded in front, trying to catch a glimpse. You, however, get a clear view of the guards marching, accompanied by traditional military music. Immerse yourself in the authentic sounds\u2014the clicking of boots, drumbeats, and the bustle of the crowd. Experience this exclusive perspective, impossible in real life.\n\nAfter the ceremony, take a virtual walk around Buckingham Palace. Picture yourself walking the same paths where royals have strolled for centuries, with street performers and the buzz of London life around you. This 75-minute VR experience offers the perfect escape, letting you leave your routine behind and enjoy British history and culture. It\u2019s like a quick day trip\u2014step away, clear your mind, and enjoy a peaceful moment in an iconic setting.\n\nStep into a world of British tradition, enjoy the ceremony from an exclusive view, and experience the Changing of the Guard like never before\u2014where you're not just watching history, but living it.", "short_description": "Experience the Changing of the Guard at Buckingham Palace from an exclusive perspective that is normally out of reach. Take a spontaneous break from your routine and dive into this iconic event. Watch the ceremony through the gates, turn around, and see the tourists crowding behind you. Enjoy authentic sounds and experience London through the eyes of a real tourist \u2013 a quick trip that offers you a unique view of this unforgettable event. #BuckinghamPalace #ChangingoftheGuard"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Changing-of-the-Guard", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28051628607769172"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1958283445104510"}, {"status": "PUBLISHED", "id": "1191413805869300"}, {"status": "PUBLISHED", "id": "1550300752880273"}, {"status": "PUBLISHED", "id": "809774808449100"}, {"status": "PUBLISHED", "id": "1316918983343053"}, {"status": "PUBLISHED", "id": "1408174283540080"}, {"status": "PUBLISHED", "id": "1070175165147211"}, {"status": "PUBLISHED", "id": "584948161057473"}, {"status": "PUBLISHED", "id": "938290791481956"}, {"status": "PUBLISHED", "id": "2241437302896782"}]}, "baseline_offer": {"id": "2241437302896782"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1958283445104510"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": 
D76"}, "display_name": "Protect Tower", "keywords": [], "long_description": "Welcome to [PROTECT TOWER]!\nIn a world where technology has advanced beyond imagination, humanity created powerful machines to serve society\u2019s needs. But when these robots began to develop their own intelligence and break free from human control, destruction followed.\nYou are part of the last special forces unit tasked with the mission of annihilating these rogue robots and saving humanity. Get ready for intense battles where you must use all your skills to protect the world.\nTechnology created the enemy, and you are humanity's last hope.", "short_description": "Eliminate all the rogue robots and protect the tower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/5552a995-136b-4847-92e8-ddddf3bd461e", "developer_terms_of_service_url": null, "publisher_name": "Linh", "support_website_url": null, "website_url": "https://sites.google.com/view/protecttower/protecttower", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25876567141989671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75340714_909197147889125_792154936128839726_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1db-D_2Ay9cQ7kNvwHb3MzG&_nc_oc=AdoNimKqen0lEfIgUt4yABLhMk
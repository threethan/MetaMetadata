92C"}, {"file_name": "ss2.png", "id": "840161970878007", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974643_840161974211340_5182342833090899970_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L3_NkQYqbIQ7kNvwHxNmdS&_nc_oc=Adp9ffZWaLXJW5-erU8mQEcJhO_O_aZVmyEiLVtUe8GwLOZfqiqkhVplRC_vhdE6UfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTixrWA6J5lCTnKTDz-O2fTx3DgQqL2lgHp5JMWrgzf3g&oe=6B031DBD"}, {"file_name": "ss5.png", "id": "357447950712893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001660_357447954046226_6835419644014815938_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLlFYYp-uo8Q7kNvwHriywK&_nc_oc=AdrgsZsN371eq23cMM_WY88afTe0x98hc0gLNi3tHR-VhDpwod91hr0avdfis7KNrVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwa5FCMZyGMRKZ-EmZ8IpzGrG8E5FdY4DWgF2gj8PvtQ&oe=6B033821"}, {"file_name": "ss3.png", "id": "2250503891965287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035334_2250503895298620_6069743772748061378_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfUSzZUCKrIQ7kNvwGH1RNk&_nc_oc=AdqzFuBFSP5SD_GYi_qsVlrFObCi5R-1BI-qLZsZgLkM3_feOtPmL57pTkmVlD1IM_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_ISNP2oFlkR30dT8MQiTrOehO3rio2NRnjyotrz8R0g&oe=6B031E1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1819228061920273", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982452_1819228065253606_407037206585227872_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpIAAuT6UNsQ7kNvwE7hG2o&_nc_oc=AdonlIpnoijbvBF4hd_hMUJ7kdQkTp4t_ycWHIcxBdoEfHRCM2D2joz8SDXxtFKogWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVk2R06cS9eJuudhVIgzufDsbC0W68FYEAKUbP9LLC5w&oe=6B03338A"}, "display_name": "Pinfall", "keywords": [], "long_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Pinfall\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pinfall/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/pinfall", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
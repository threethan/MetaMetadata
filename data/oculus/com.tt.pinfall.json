&_nc_oc=AdqbDSJiyF2QC8pLx24IJboE3HMuuEPTULMIlV7-7nJOChrYJaAjALJoGEnwurnyVH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUao1npdtuHnhzXcb8P0FnzfxEEWlThgNtSjVxn8hEoQ&oe=6ABE577D"}, {"file_name": "ss5.png", "id": "357447950712893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001660_357447954046226_6835419644014815938_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYip5T-ZGlIQ7kNvwGwNiMr&_nc_oc=AdrvQRWzwV6sHwePfhN3yRfhBnhtxqxoiuuBrWDMcSWMBB5EdJhMTdGTRLQTaH5jXO4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtR3c0MDP5JA_pqkzCpmUJHUVCBl5VXypQKo2rrny0zg&oe=6ABE71E1"}, {"file_name": "ss3.png", "id": "2250503891965287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035334_2250503895298620_6069743772748061378_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPh6vhVFe3AQ7kNvwEnVe-j&_nc_oc=AdoJCEqegVXXd7Spe7cvIduA_hl9IU9dEVu8n4LCPdzZHe2rHmBYypPtBkkSIpZuWQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMXmKoexoNwhYHplaKw5XPusHb7kUFIAx0MDreqD8qUA&oe=6ABE57DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1819228061920273", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982452_1819228065253606_407037206585227872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4ZQBDnl4A4Q7kNvwF1BCit&_nc_oc=AdpwHv9VQvb9Yb6To9V5W3lgBY0knTdjKSFiPySTSDP_eOQRB9gjZApOTKWoVvDMExY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMQXBhsy5uQmomIAri3uJz5klbXiO4XXZ-qFmHL3UJvQ&oe=6ABE6D4A"}, "display_name": "Pinfall", "keywords": [], "long_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Pinfall\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pinfall/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/pinfall", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8918526014829059"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035319_913320047227186_3191201182714266002_n.png?stp=dst-png_s360x
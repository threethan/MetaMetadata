32C"}, {"file_name": "ss2.png", "id": "840161970878007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974643_840161974211340_5182342833090899970_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLGuGsDH24gQ7kNvwGbVjE1&_nc_oc=AdoNka_hHddEcPnYCboO-4zeWA-PLNSp_VLusFWnXZwFxWndbRmf5wq9kPG3T91S4dI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVH68tQaJ19X4stQlQqPhJOglPNkjskz3VIblqmjeaNw&oe=6AFDD7BD"}, {"file_name": "ss5.png", "id": "357447950712893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001660_357447954046226_6835419644014815938_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AScOTcbk02MQ7kNvwF59u62&_nc_oc=AdogI3mgFBkwEuEBY4BD2lXJeRNy2T2jEG10edmsE3hs7i-wMQ5ccAbsZ8E6Ry94Jtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNVpfziagDZnYaTexQIVDnIGf9mnLf-El9hZfLPici0A&oe=6AFDB9E1"}, {"file_name": "ss3.png", "id": "2250503891965287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035334_2250503895298620_6069743772748061378_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDNiPMeE_ikQ7kNvwHDhH0A&_nc_oc=AdoiCJbsKpFvlZ_mNhuH_m8-WozF4C9vTzCKSeg9VSIActU3K5-xX2lv4jaLN6NKBz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsl3H7qIxVCnmuqnbjZi0XbFggWts9z5nDNmzX0IPYPg&oe=6AFDD81E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1819228061920273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982452_1819228065253606_407037206585227872_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2wXQYMrd7IQ7kNvwGCa3sj&_nc_oc=AdpGRN6U5pT6lwnYj_c7gSms05qWQQ62Nn1gR4rFQ3zvJkxCUhKkj56WTQaG45f8qBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT72LOIryffe7zcoC6jINvgiq1n5f9ySb7nzKmpaz4qmw&oe=6AFDB54A"}, "display_name": "Pinfall", "keywords": [], "long_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Pinfall\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pinfall/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/pinfall", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
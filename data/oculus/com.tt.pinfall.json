AAC"}, {"file_name": "ss2.png", "id": "840161970878007", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974643_840161974211340_5182342833090899970_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L3_NkQYqbIQ7kNvwF15102&_nc_oc=Adpu2d2Rhc1FqyHNo8e02HrwJaSuD4qlZhQMQetMozBXtiiAj9rk01gGkVT3lYOE_QA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMo-K8d2YSJh1fragJXZcoW2QNUxV3GCVXBgiY4NipdQ&oe=6B046F3D"}, {"file_name": "ss5.png", "id": "357447950712893", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_357447954046226_6835419644014815938_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLlFYYp-uo8Q7kNvwH6uc4H&_nc_oc=Adr_Ak1lzaJNGbudUbZYOmzbkoRj_3gwtdz-48EUu6zIR8T6YzivUgPzfZSkpX3frbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzUdBe3_dXgkTb0VtLuzOJ9MFYqBZn5vPTnkxK_v8fUQ&oe=6B0489A1"}, {"file_name": "ss3.png", "id": "2250503891965287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035334_2250503895298620_6069743772748061378_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsubBgbHZL8Q7kNvwGUUkbu&_nc_oc=Adqr3Z7KuYQcxWwztToHSnQfJ5bUvaJcT3pxXXq3Vq6XgLJEglXzYhPg7L6OZbdKh-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyvPwr0uXm1m2umy2imI4tpF0nGZCo_uE83P0UQiEB5A&oe=6B046F9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1819228061920273", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982452_1819228065253606_407037206585227872_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJaIh2QKPEoQ7kNvwEE8vH8&_nc_oc=AdqLxN6ZB8xpX-Z-iB6WxRtMogvVhghRWDLOe4CVwv7B0JCx9FmJtm00ydYVDXqNUkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWE3nHHKQnIHwEVhQSGRlzsS47WILVtSjuNJkxtBbJHw&oe=6B04850A"}, "display_name": "Pinfall", "keywords": [], "long_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Pinfall\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pinfall/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/pinfall", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
.com&oh=00_Afs0-wb-Sg921eezp4vLvVasb9y27B_VbyyM9ysYl3pm0w&oe=69A6D97D"}, {"file_name": "ss5.png", "id": "357447950712893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_357447954046226_6835419644014815938_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VkeGL2_APcQ7kNvwH0TO7t&_nc_oc=Adl3589ItFcZ524CyyH_fABGDWsBnNlS-WUJIRi46K8K3tKdhcW_96ZFXZMwqS_3ikU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJ3aHGmNdGcBgKzXExjxZ84vg60zcdgwFwzVIa5LgSVw&oe=69A6F3E1"}, {"file_name": "ss3.png", "id": "2250503891965287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035334_2250503895298620_6069743772748061378_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv-dqFrx5R0Q7kNvwGAQiBK&_nc_oc=AdnzqiAaNahWT_SXolOLx2npCCAlAPiHB882NtEGIC_l_y7t41yVUY2nDZPiMusKebM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRmLNV2dK_YWJxFY-7-IUplsPszP1GRkmtiLBxFGgC_g&oe=69A6D9DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1819228061920273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982452_1819228065253606_407037206585227872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brMWkqIwUroQ7kNvwGQCG3e&_nc_oc=Adn-KdPWtJ48xlq0MIzcCSsX3oGkJM5F9x27LFcejrJjot087Buyxy_RR8JYakIpT-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHS2gj0AtMglDTYuugZCAdzbWCsFFWyZN9Sqoe867gew&oe=69A6EF4A"}, "display_name": "Pinfall", "keywords": [], "long_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Pinfall\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pinfall/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/pinfall", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8918526014829059"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035319_913320047227186_3191201182714266002_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3pdKDkMToAQ7kNvwGRw-lG&_nc_oc=AdlyTT5HU4_pqchlmkUbrqn0waKiF889tBLigtYvWW04Mir-1HyqmILmDelDeOY97bM&_nc_zt=3&_nc_ht=sconten
.com&oh=00_AfuGCorlmRGu-LLDASzzNDRGnGRjNr0_-dUpMg6_JGJYUg&oe=699858FD"}, {"file_name": "ss5.png", "id": "357447950712893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001660_357447954046226_6835419644014815938_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHgAFIqkSMAQ7kNvwHcjYr-&_nc_oc=AdlzuvNkOwykFdsc0T8DUWPmavGsYrJJYjfpDNH2JMo5uR1OwfPCkNU4w11sck3vEks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvsJ7gkFANUhaJHa56nk6FKABlyjrQ2N-roRHKCiW_yZQ&oe=69983B21"}, {"file_name": "ss3.png", "id": "2250503891965287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035334_2250503895298620_6069743772748061378_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMAU8h16FgoQ7kNvwH7D7MV&_nc_oc=AdnFCWGg8_ywzS9QkYEDfXUoCLmTDrRhjxRH5E27CuNXf8zBCrSnMpSs_t2koSmz8vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvlkVJmFsws16AKW2rVoB8nvAl41hpsFowG8_DHofKAzw&oe=6998595E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1819228061920273", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982452_1819228065253606_407037206585227872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFwx3u_EB8cQ7kNvwGb9wy3&_nc_oc=AdlZIQgF358erZLHcoouLVwhr0sq67d3q4AOMOUKLkkz_RjBhUa5udWLsFiWJbj8tUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsYnmmEIxAmnTgxTa-WuM8aAPQ18Y9zzKtG_uLyHljxwA&oe=69986ECA"}, "display_name": "Pinfall", "keywords": [], "long_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport.\nGame Overview\n\n\"Pinfall\" is a cutting-edge VR game that redefines the bowling experience by placing players in a vibrant cosmic arena. The game challenges your precision, skill, and timing as you aim to score points by knocking down pins in various celestial-themed lanes. Each game session offers a unique adventure, filled with stunning visuals and dynamic gameplay.", "short_description": "Pinfall: The Ultimate VR Bowling Experience\n\nWelcome to \"Pinfall,\" where the classic sport of bowling transcends the ordinary and enters the realm of immersive virtual reality. Prepare to embark on a cosmic adventure that transforms traditional bowling into an exhilarating and futuristic experience. Whether you're a seasoned bowler or new to the game, \"Pinfall\" offers a fresh and captivating way to enjoy this beloved sport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pinfall/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/pinfall", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8918526014829059"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035319_913320047227186_3191201182714266002_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJ6HWliLL9wQ7kNvwHDg4BJ&_nc_oc=Admm9xD4I6WpCQvxLuKQ88JH9gHr2k6AOZAWZqZXP4BU7Uo_iSo-JBdRm3s1nonfzjQ&_nc_zt=3&_nc_ht=sconten
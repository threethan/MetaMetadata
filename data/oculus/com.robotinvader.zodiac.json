-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu_9_XOaakHslBO6DpEWsS6E_q1-onujxr6Y1X05vjqQ&oe=6A8EF0DE"}, {"file_name": "migrated_image.png", "id": "199677087998109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKxuHOPr0TsQ7kNvwF5A9KL&_nc_oc=AdpdYsPdXG-DPKXrgQfkHYeo75OubfTiiIb0HNz55vfNPn-HCUFaPJnV2GGvUy3viDQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjeM3UP8B7EKhCT8hr-PbsZdWYvG2LWlf8DnrX95Ji0w&oe=6A8EEEC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1014945325288700", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386279_1014945328622033_742173121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9FrR6BycbMQ7kNvwFp_G8m&_nc_oc=Adolax_8-WMDOKIyIrqhBn6kgBYYpuDomOUkIS1UiiyKfQ1_K8kAzaW0QXozHQn77oY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT3sGJmhcmoecDLjYXBcQS7bL7UJVEfkm2LErtLOqvDQ&oe=6A8EDB4D"}, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has cr
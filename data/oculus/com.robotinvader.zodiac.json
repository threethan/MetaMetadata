cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzdsfxs-ez4Q7kNvwFmPbh7&_nc_oc=Adn9nIUUyri6JQedwa0R9H2upLZcnNUEV1WuzVJHPl2-ejUV37WeOVgYIzy4wjKQrwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4oYbMGcaOHamdg7PDOx5Dkyk6L5PH6qttufA7LCW9ig&oe=69BAAD43"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5M59LUAe9EQ7kNvwFWpFLC&_nc_oc=AdmbQOq8bzbYjmT9RNTU3_A7kv_ZlOHEF0fRy7ydHBa4Hrgg16XIALwRV3e16fDbmgE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyxrg0SmED_S-6sB8GopxjwLM4doHAT62RH6OdFnJ8-Sg&oe=69BAAF5E"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXIHzlm8bh8Q7kNvwFCoVHR&_nc_oc=AdkdbabxApnVWFWvN2H9WuhkRlirtCwkp57jyynunvN-fURToAaF7g7hVnxhxDsoZBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8N1PXYe6HSaNit2ItI1I8sXpu7Iu0W0M3nwmD2RDyQA&oe=69BAB5A1"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAcAQa2WMvUQ7kNvwGb9aCA&_nc_oc=AdkQOCPWQf_ktWM5AKbq7tEZZrkuJ8JTSbiV66y4mj4Kd6jMyMRvDuBD4q8IgRQjAtk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxV7KygdRqTf-wfQR6uE3BNlV91g4HuSz2dLM3e_IBb9A&oe=69BAB6D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/123861
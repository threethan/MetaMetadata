cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW-HWEaQy7MQ7kNvwGbrJ5I&_nc_oc=Adka4muV9RugCj6m1L9gLbnk-FpSPEuczzCosZPqHnsHJiabPDEXCjkUGHPoK00EVRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAVyugvjfJ1PZwrQ8sWWSqiQCoGbXCo8TzNRCNdYIWHg&oe=69BEA1C3"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttxo3Dtg78oQ7kNvwG7Jm11&_nc_oc=AdkkuuyejvfIGuZ2UkvBYx1LqwgOfj8805hSvua19pbVF3_Hls2wutRg-BjlhQb3thM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4fb0A07rlOALrB5iDXCWJM2CDMSe0moAikVi77xezqQ&oe=69BEA3DE"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cLBghZ3VI0Q7kNvwEzLQjH&_nc_oc=Adn2EtztMMa3NCLQBtXZ0zgWTG3BPn2opVv8MVt-A3b1yfKM9LfCqlAeYnxhwpTpEc8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4vuno1b4mX-EH93JfKyCxYyMs-etTCxOsisyKIKuJUQ&oe=69BEAA21"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7Js-92mMQYQ7kNvwGpqkQr&_nc_oc=Adki4nc6eSp7SqzydoGUidux53vlal_6289ZjuZ34rie-sfg4LAo41ZVegGxOjJPnfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdNrBHHS6pQcTIHyX9c43pEPAUAhyLDTznYwUOJalwRg&oe=69BEAB50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/123861
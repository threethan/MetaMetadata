-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9inwzeccwxfOA8-nROZBLLDdJomVADfqgM6jpIgAZIEg&oe=6A466E5E"}, {"file_name": "migrated_image.png", "id": "199677087998109", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXLDjq6WCw4Q7kNvwGH1DHP&_nc_oc=AdrMs7vvqi6ciGYCUQ8s-7pUH86j8yami3aaZDvpo_pbRpxxijUe01erCm16NDMo1FQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HL4vGIT8G9dYS1IgdHgOJs1MXyhE4mNUtG3lZ-6y_vw&oe=6A466C43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1014945325288700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12386279_1014945328622033_742173121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcbiV1oUbqcQ7kNvwHUZ_57&_nc_oc=Ado-t_C_lJIe0S42VH2wLO7DPweqTdYGKLr1dUT6B9ZtXWQj1NyME6ZFF8LTbC_Ye_0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hPeTrviaAwkpWl8Leb0CDBY5OcB00a3dS24odpB-57A&oe=6A46910D"}, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash 
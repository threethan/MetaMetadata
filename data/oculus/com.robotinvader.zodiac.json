cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7QzC4DJ7AwQ7kNvwER5X-h&_nc_oc=AdlNvndpO4Xjz52ryK627QQO4sx6sQxpOiqd41-UdgjOkNpnOMFq6BeCbhMI1ZC0G9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsCcMKFhf64Zk2ZS7KaEEapKIs7ITYHXltlYHn0ezMEMg&oe=69A83843"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3ntgAKMy8EQ7kNvwFE3hgK&_nc_oc=AdloLryA1OveYEBdVOmKG-seOVe2uunEApBlKR0LjNF6mRXkaBLRgzzLb0woNgWG4Jo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftrX9yPp67rGVPmgxmY12nCvgx47326TGuXDadSXtooCg&oe=69A83A5E"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVst5jha9AUQ7kNvwHD5C0h&_nc_oc=AdkVdlmF5BOd1LR16mXkvLnMvDQLRhAEkYWfEOZBZJKOdGJ2K7t-hGm0oz7GUhsNRQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFLThMQJ-zmlyYXLTcLUk4Qyy1TURK9NLgWMQYkTbYqA&oe=69A840A1"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9mf7EZl-gUQ7kNvwGmPSs-&_nc_oc=AdkJrEDa2lA-Ulk2gJjQz712kwnyzyS1JMVBiuYDpYzr0SA_hIc3rnAcGgfTX5jceKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs8o27ngpnE0EAEOmy76UynT13kFIAgYVdhUL-FoPNp0A&oe=69A80990"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/123861
cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qalBzV5vbEcQ7kNvwEL69Lk&_nc_oc=Adka6zjwMj4h3bbY4NQhQ4H8qacvffrHej9MUXGdv47AfmcNFWUo28Xu5dNmm8UVMzE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmNlbkDQZwGzrB0xFv-AvSOFe5nlNU_7Ys19gh53CQcw&oe=69B2C443"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoXh2WIvuDoQ7kNvwGo09Ky&_nc_oc=AdmXIvMlkuRj2opfjvuVg4e_4AklXXL_fk4S6JeNRK07_uvEhDN2sdIbfTVtW9fJTWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKR9bOqziRPMdbY1dgEjSHV8Oduz3YFWddVTnQ9ryOow&oe=69B2C65E"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2gpPgACaqwQ7kNvwF-imnV&_nc_oc=Adlm-dWGBrwet3pzkySjSGt-uMAhQPSlcAe9qfMPVQ_iWuT7Yx9vGa7l6HaxWbuwd_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFdplb298IOH-sMbva8uwnB49Q0-D4PmcU0QQXGL_iKA&oe=69B2CCA1"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDU9i6qy2BoQ7kNvwF3-JVF&_nc_oc=AdkdSDPwXmHbYHibcnWiAJcrn_3r4ulkpZcmlFBGQTH91TtPZgjskKq0-9vI60xcrMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBP4iKT7Wcn0ORUJP0zTgXqDSEukk1ylhIGF0Jl_IFDA&oe=69B2CDD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/123861
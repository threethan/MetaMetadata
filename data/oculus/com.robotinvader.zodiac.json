cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qalBzV5vbEcQ7kNvwFJzj_0&_nc_oc=Adl2Atimyn9NRIdKJELwQJpVjCWRib2X37Vaj2taefoP99L7i2Db7T1DGYw9C8S4Oac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb29N_O3GtjlME_75wZm0q2WLfNQxvrWld6QlSz8X2zQ&oe=69B172C3"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfROPJSa0bwQ7kNvwEvr_Hn&_nc_oc=AdkY_AXq39hbIL35KqELEWMV4-tV4mdcnSEiDgCckavoN815lmi9z1cjY3a9-sO2Gbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt92RzeHFQkjA-neBWlwjWxW5UAqeAiCLbXOu-Up1EfQ&oe=69B174DE"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2gpPgACaqwQ7kNvwEMjuWu&_nc_oc=AdnkadPgpUeGaATDUwiucorSaedzXvAOb2AjHgch0krh2kkm2rOGXp9y4XY4Tia072s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJ7-Ej7uBin-E5wTI_69q83JHhhhFhCLyscuFyYVq5mg&oe=69B17B21"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDU9i6qy2BoQ7kNvwHrhjAj&_nc_oc=AdmxoZ8BlCNDxtVaGWNcOgPCtt1cDmVnnCm5CAY7xcRb1rdb-ijuLufAvbSCePLX5qM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5SKebeAXhywr3_sDKRqJ6Z9PhnNPsactjShU3ldX5HQ&oe=69B17C50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/123861
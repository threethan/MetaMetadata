0", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ2ZsclN8-YQ7kNvwE7AXl7&_nc_oc=Adqb0RwwyaNGmgfcSNItFFXwtoIFWl5NChaP3WoHnluJKL1XhETr-e_vXEsZ0RPm1yE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2R_OcbVu12XQgZ2x7mPFSF_W6_cD6AV2xVC77GxWJSw&oe=6A7DCB43"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAuqc_9vk7cQ7kNvwHQYvYs&_nc_oc=AdrbbJzdaTpRKaJblfNcpkf1zoe32RT-kgRMyiWMks8wl5nXI_L1fTIR_p10gId_2fc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVHUjGp0r-hBDiuyrAGrwGix5SdnFqP6dBe-h5pi_R0Q&oe=6A7DCD5E"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A31eGWb_f34Q7kNvwF163wq&_nc_oc=Adq2lmep8qtlTOoOgsCqdSx4JBQeP0uxajzg0T2olx57sTOpJnEN4tvWbe1BBR6EBLA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM-IyNgzStyc9ajAoYUxknHFoHI7CkdurJrdk4bbUYyg&oe=6A7D9B61"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4t8Bd4myXAQ7kNvwHi65AX&_nc_oc=Adqxp9J7D6gRudj79WoFNShfjOlC48mFhtTqSCPxZVJm9ZMvTE4VlhCjxSbv0Dy69MI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV9Y-ppBaiN0APey-1pI3L4_xNt0dsqgspzTzZUTMIiQ&oe=6A7D9C90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri
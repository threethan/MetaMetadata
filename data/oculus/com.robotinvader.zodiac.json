-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVHUjGp0r-hBDiuyrAGrwGix5SdnFqP6dBe-h5pi_R0Q&oe=6A7DCD5E"}, {"file_name": "migrated_image.png", "id": "199677087998109", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ2ZsclN8-YQ7kNvwE7AXl7&_nc_oc=Adqb0RwwyaNGmgfcSNItFFXwtoIFWl5NChaP3WoHnluJKL1XhETr-e_vXEsZ0RPm1yE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2R_OcbVu12XQgZ2x7mPFSF_W6_cD6AV2xVC77GxWJSw&oe=6A7DCB43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1014945325288700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12386279_1014945328622033_742173121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUfDj88UvxQQ7kNvwGUVhAe&_nc_oc=AdpC8wSaGtTxL3IYIvRHOPGnOgvlfsRCXaAqN8Ae8CDrCkH4OgayLrvvR6h66JWF_5w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSjwGDJOVWn1DAs4D2htuGCN5val4s7Wo8vxr7XvEzNw&oe=6A7DB7CD"}, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash 
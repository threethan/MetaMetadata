-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYR4ujaogtgpty9WdrDf7l3chYB48ia3xHDyiavcfGiw&oe=6AA408DE"}, {"file_name": "migrated_image.png", "id": "199677087998109", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcVPiE_DeAYQ7kNvwFELpzv&_nc_oc=Ado3HxadPWTuS0S5fym8rapjNi8ZRZgORSJLJWR1eyDPWCyTzWME9YIEEdm3ZhpT_dE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkb3BkXauxmXp1sfV-2DC9xOGJhsJcRF3I5DtLDh3dOA&oe=6AA406C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1014945325288700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12386279_1014945328622033_742173121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llcg2DjjlUkQ7kNvwG66dNs&_nc_oc=Adq3hK6AZnfrkoSWuDblCQRYSw5MrxDzf1V3QUY99R-V4_R3gTs4XLihegA9LaLIFtA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK0Rs48sDxspAbUWsWliE29Cv9OntylN2rq57cMorOwg&oe=6AA3F34D"}, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash 
-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZFb9-MDeEpSh8g0sy1ZlBNFeI2rpXWLmxMA0fauCPRA&oe=6A857E1E"}, {"file_name": "migrated_image.png", "id": "199677087998109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e612lD2G6wYQ7kNvwFdr0W9&_nc_oc=AdrdG88ukuEc7HdKJlimdKzIsb22laKjMIiTbHg-7OtqAJpauZTQcAIgzles_k6P0K8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0nNL5JHqirfpllfnWz0d7XRcfKvv5M1OXUUeKyhywuQ&oe=6A857C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1014945325288700", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386279_1014945328622033_742173121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BU-k_raxnwQ7kNvwG-I2VC&_nc_oc=Adp4JIR7YGA81JFKyJs2aoFugFvjd-Vhs78EZdHLsUFeEsNBrc9uMFZKpjclDUIKdHU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM2U0_2q8WD7Gbmx8r43XQzL5ypQ8Glam1H6UUFV1dIQ&oe=6A85A0CD"}, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has cr
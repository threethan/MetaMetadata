cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UW-HWEaQy7MQ7kNvwFqg5_b&_nc_oc=AdnMwO9kFfbAgSwUEWI8e6yRyE2yXS0q79iSMnEUbDnQn6ooieJzXYRWMKA4BIX5WXs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZrLZjTqUwbRGU41-_jh-DrbyWZJpZIPSQaqvADwrmTw&oe=69BD5043"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5M59LUAe9EQ7kNvwHKYxjC&_nc_oc=AdnZNLbtsOxVbn8WP341tsKaQOfr_MtciwGD7XfpfF6PAi_Zgylf5WstBeYe6ataf3g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0zoI9hrduDXp-5vtwuTo5EWSU3QRPxjcRSGVPPQn2Cg&oe=69BD525E"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cLBghZ3VI0Q7kNvwGIp7LP&_nc_oc=Adn2Bf3GPb6gtPxIS8nukYzF3f12APqwCtivbldqPAoQBcOOjPZWT0e5Ij4rlR90ZJs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJuVV4_i2XFXL3ZcRCjAQ8A3Un-km8-5DBedO8YiqFsA&oe=69BD58A1"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7Js-92mMQYQ7kNvwGGqy37&_nc_oc=AdkCIZ654nJd8dvDA4PNo73kAigFXzFgANhROd9D8RyvgoO9BFN55omWxWkhauzK87E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZURHSLDWoj14M71RS54w4m--hQOBJ0tb3_8bsiGkboA&oe=69BD59D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/123861
cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccP_kQ_AnUoQ7kNvwG9a-KX&_nc_oc=Adn2LHCnXJtVD8E4FZa_N_AzPtkBPwEIpaHdPNNmv2HEuZcU9itKnmLWcqfCeudNm8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1-pUJAY_KedmqVn9ycE9k5530PHlaYH7aryP4-4GUnw&oe=69B415C3"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoXh2WIvuDoQ7kNvwHVfSl2&_nc_oc=AdmsYwsyPB-rlSLp4amVApToWSkA9Qu-RvL5fqw8Cc7Ez-rUrb1v5JTgq44gG2M49I0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhJAdA2RreEmBbl7dTuUB4AdHOmQpBMEcPC8RhT8EVHA&oe=69B417DE"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2gpPgACaqwQ7kNvwF2sGRO&_nc_oc=AdnLhGeR2H4-sH2UdiL53MDc9vCox33LgGDD0k3a5RmH5VybFRyKyboh7xZRvJ4PbuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWUjA5jLobOt9KdWDOK0BAaF93Zejw-y5dpB-qVIAp6w&oe=69B41E21"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDU9i6qy2BoQ7kNvwFMaQVK&_nc_oc=AdnZ78-qIvqXI8XqYZW-SpVKAOTXg3vrshan1Q7BeM3-N6YCZvhbAQ8nWFO_icTmIkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP6N11-oyxQQFpu7NdBf6l0OL3iIztlhId6WvvyCh-DA&oe=69B41F50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/123861
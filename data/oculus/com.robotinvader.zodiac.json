-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Yi-c3CPkCjiXEvEuPOYOahZHY_G1ZA7ZvNjbKnhT-w&oe=6A369C5E"}, {"file_name": "migrated_image.png", "id": "199677087998109", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neVt1Sgq06QQ7kNvwHcETId&_nc_oc=AdpkcPPsDa-NwwZ196F0o2Hjxhjm7PqbxnkRgT2yeVWRIOC-v3BDpNnb7E90zuuuo6s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S-giZBSwO2b_iz2ISpMRSqWUw88Bfxu-6afhS6Y4Nrg&oe=6A369A43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1014945325288700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12386279_1014945328622033_742173121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zFhR0ngTPYQ7kNvwG0DRsz&_nc_oc=AdrupUqowVmdT4rxwKqRjFHhA6Nfx0AnQwi7jo9G7xQgEY_6PgeIY-xplfTuLr-KbbE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qW4NFSGPc335tm_iyzHumnxfQ-H4ouj7otjFs65mLaA&oe=6A36BF0D"}, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash 
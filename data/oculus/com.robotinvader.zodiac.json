cdn.com/v/t64.5771-25/12386361_676254242539261_643523133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhopIBHGfwsQ7kNvwGDE4v1&_nc_oc=AdncCV34aKlEcIPaJvp2-ILAkg0szoSblXxdkRwHLbGK0kd1WSzSdZrt_Z4Bpg5FG3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYnVv_kr-Z9hbCMwUdV9bNmLtderSYn_PCL5Jx1hBfHw&oe=69BFF343"}, {"file_name": "migrated_image.png", "id": "547066649276877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331133_626582937505238_1532351749_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttxo3Dtg78oQ7kNvwFs9gS2&_nc_oc=AdmFuSMKGxakwmTapVKTAF3hfkq8tb8AvsOGeM0hufC_2jIgCBPS_oQLuo7JAuaJ1lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqsUuhs7VqlrcRzazO7tjaMtS9ATQsvw7vEz1phOdtow&oe=69BFF55E"}, {"file_name": "migrated_image.png", "id": "207670103665760", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386365_567353346803475_1339956407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cLBghZ3VI0Q7kNvwH9jROZ&_nc_oc=Admgh9KIH_UlfpoXVz8JvXuCYY56rkKLBIAZuEOuK1io8C0QWEGeFAz2KsczuwdYusM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_eQ0Bbkleo2pEDArKkY0HXq3AasOVE96KrkBjPR1o5w&oe=69BFFBA1"}, {"file_name": "migrated_image.png", "id": "206225783811832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_232550757145748_381352292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7Js-92mMQYQ7kNvwGfjcgW&_nc_oc=Adlw1T4USxd_mp9x-EXNlOVPS8WiwmnWUbmOW80kXKhFL4EqMEoVq2NscHpm6uLCpfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3Y9EvTRYNAaOLk-_dHEMwkbGzB1NajLxgZ8UnYc-kVQ&oe=69BFFCD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEX: Heavy Encounter EXOsuit", "keywords": ["Action", "Arcade", "Shooter"], "long_description": "<Start Transmission>\n\nFrom the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. You\u2019ll need all the help you can get, especially against the Zodiac bosses of each area. These ruthless, giant mechs, including Monkey, Ox, Rooster and Rabbit, are raring to pound the lugnuts out of you. Fight for your survival to collect the parts for your ship so you can escape this deadly planet once and for all.\n\n<End Transmission>", "short_description": "From the creators of DEAD SECRET comes HEX, a new action shooter only for Gear VR. Your ship has crash landed on the mysterious Planet 6IX and its armed, robotic denizens are out to get you. Good thing you brought along your secret weapon: the Heavy Encounter EXOsuit, or HEX for short. It doesn\u2019t make you unstoppable, but trust us, it\u2019s the next best thing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": "http://robotinvader.com/blog/?page_id=299", "publisher_name": "Robot Invader", "support_website_url": null, "website_url": "http://robotinvader.com/hex", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA", "fr", "es_MX", "de", "zh_CN", "ko", "es", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239389568385611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/123861
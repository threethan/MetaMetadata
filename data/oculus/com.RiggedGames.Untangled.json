FajcP54Pw&oe=6AD3A96F"}, {"file_name": "Screenshot (2).png", "id": "1351368163192771", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827973_1351368169859437_8723905190288898218_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN_l7dToKdkQ7kNvwEinjP_&_nc_oc=Adp0ocRYKaLEf8N46ArlwEUP7DSVyzWUqnnJ_V-ZBSBLz8H00PWcCUuTB8gnfmrdP3A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3_Em85vJPhXOk34qHjzbHHI5nAuxM4oLWvlapIAJqtA&oe=6AD3A3D9"}, {"file_name": "Screenshot (6).png", "id": "1591592522560051", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825546_1591592525893384_732231287893230239_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNiYMQCsBCsQ7kNvwH2Q0H3&_nc_oc=AdqYLh5auGw63A2MY1AvWxQXZgmqo5Vj_XwDer8-LJUA8xoLgfC4i3o8GQe6PZW-rRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7M28bv0HSuJrQ_1Jx4tdl7qSxvlmb9DG7A_OKgrg_CA&oe=6AD39FAD"}, {"file_name": "Screenshot (4).png", "id": "1503108285165833", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825563_1503108291832499_1484386665411675597_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl6Z-MwhKuMQ7kNvwEbNEj8&_nc_oc=AdqTKG0CqiaIF7h5R67iGBs_SUfrp6zu3haaJhHjdTanV79dzGCszPoJjegDcf2kTIQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE7EqTBy7I9Tt7HphzW0qRex48yzzU3Wret2vJ0nzzeA&oe=6AD3985F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UntangledCoverLandscape.png", "id": "1316375820255265", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823812_1316375823588598_3272140804454548368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0CHYk8YZYUQ7kNvwEwPZJD&_nc_oc=AdpJb9zhSfVbCyreJ5HskU5FyCCkQYbrnfQ0ozbu-ZbYn4czLsvP0JYaZ2F5o8tymSg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW7S8hL-_aKzqYm5J4mqHS6x43q0h6P5PsY6bkCWJNyQ&oe=6AD38FAE"}, "display_name": "Untangled", "keywords": ["Superhero", "Hero", "Web", "Swinging"], "long_description": "# Join our Discord https://discord.gg/3NvdXzTYqE\n\nEat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\n{973070422401410}\n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around and truly feel immersed in the world of Web-Guy! \n\n{1680092233678983}\n\nLevel up by clearing crimes, defeating enemies and completing activities like Pizza Delivery. Spend your Skill Points in the Skill Tree to unlock new powers, abilities, upgrades and more!\n\n{784546841417201}", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37204535849192788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771
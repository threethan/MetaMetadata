P1IUgYpAeDMcIVfIToUcIqAaBrAkZrkvOTf9lpA59V2baI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMDlNyJE1NtA6yGerlakMej4nZ-4xMjY2stxKklsfObw&oe=6B084BAE"}, "display_name": "Untangled", "keywords": ["Superhero", "Hero", "Web", "Swinging"], "long_description": "# Join our Discord https://discord.gg/3NvdXzTYqE\n\nEat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\n{973070422401410}\n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around and truly feel immersed in the world of Web-Guy! \n\n{1680092233678983}\n\nLevel up by clearing crimes, defeating enemies and completing activities like Pizza Delivery. Spend your Skill Points in the Skill Tree to unlock new powers, abilities, upgrades and more!\n\n{784546841417201}", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
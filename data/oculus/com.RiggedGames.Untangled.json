uscdn.com/v/t64.5771-25/38974750_557311750429485_2789499950880815567_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7nbO0RjVXsQ7kNvwF_6xR8&_nc_oc=AdlJJ2xztBYMbUylwf4iNZ7y_NlfCfvZ_bg7Q0nJNtoyHjf5EXxZCz5EldrOzf6N9wc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvmtThrny_jtm5m0y3mEiPiKbkeQOC00WsIePeSnf6brg&oe=69A431CE"}, {"file_name": "UntangledScreenshot5.png", "id": "1048191887320905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974577_1048191890654238_5816570938393431750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vFjZLy609MQ7kNvwGTKEON&_nc_oc=AdnNg3cAkAepqdIoza5453i7bcjymxDqSedS9U_lpyUAFv_2kpQeFO_Loi0cZUI0_jI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs67_5CKxegXWczfcRbyjdbR1JwntcUR6FNVdaP8gHVew&oe=69A4360F"}, {"file_name": "UntangledScreenshot.png", "id": "596078956248200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031376_596078959581533_6282574614754715713_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_SIAr6NcpsQ7kNvwFIJpq9&_nc_oc=AdnxeOalTjtoiIXQ9usPQPr7J9j7OEK6MIogDaFb8oAqumGSJJmMBo30_L1eLyAGEds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuceqRR1br3x2pqryadUZpEL96yAwxkQYdDeisrOOIkKA&oe=69A41EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untangled_6.png", "id": "1485911902402939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499311912_1485911905736272_2019976733083675626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAuVUduJfnIQ7kNvwEMzklD&_nc_oc=AdlMkuHhEZml8SFUNV1LVAqQoT-GFUycWJAfuQ2jcyGju5XGeFZk1S1pB_xDk7a8omk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0WVh56FzTcUPcxp8t1-wRJ06abECMR7vowioxnwv7Fg&oe=69A43952"}, "display_name": "Untangled", "keywords": [], "long_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around, hold onto other players and truly feel immersed in the world of Web-Guy! \n\nDefeat enemies at crimes around the city and keep the world safe! Through questlines you'll unlock powers and gadgets to help you with your crime-fighting!", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32700208086292276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819311_1454681855544591_5654376424763323885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60184OGcTQoQ7kNvwG0la42&_nc_oc=AdkS05xqiKzLKpe24CfcdCC3ES7Ry-sJOqwdFOJRuySETxDc7TVxrRMMWuRSKZKstmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvCiBjynDJEMiCRDZiAIpb71epdd1zkQEEGhLtyJCEVbg&oe=69A448E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
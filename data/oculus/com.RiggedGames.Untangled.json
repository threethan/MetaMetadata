hot2.png", "id": "557311747096152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974750_557311750429485_2789499950880815567_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91-10i2KB-oQ7kNvwHlFGMC&_nc_oc=AdkZa_DzvuYKQsoH8e2LKk2JQkMz2aptLOSIEbx98k22Yhx4ooJ64ILm39LNqhz-uL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLKlqulVyCqW31i9USNEddMsIOCF6S-Ky0z-wrQGXa1Q&oe=69B949CE"}, {"file_name": "UntangledScreenshot5.png", "id": "1048191887320905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974577_1048191890654238_5816570938393431750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJxGtMrqqOEQ7kNvwF179_Q&_nc_oc=AdnWE_JFZLBv70tKWosYnI5jsyPiDlYmBW-5MquF_aL103R36LHGgEBKSJXGi-d6mh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx30o7EjTN0-PD9j_T7N2642Tv-i_NyLd355Oun8YvsSA&oe=69B94E0F"}, {"file_name": "UntangledScreenshot.png", "id": "596078956248200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031376_596078959581533_6282574614754715713_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqJ3OMpW54MQ7kNvwHUByBi&_nc_oc=AdnNr_dYHLN7KhUdx4kZPTswqH9FRHmsRnEyaHzVdgCorZ-kEBCygCrOJlVj3Dw5nxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcLyLeLY24ISPfF6lqqQkizrv2kT2OcQKsIIOCdotOjg&oe=69B936A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untangled_6.png", "id": "1485911902402939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311912_1485911905736272_2019976733083675626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFOK60cIoawQ7kNvwFHULEG&_nc_oc=Adl1NloHlKvnUaXkQl-kjCDUQU_pwnBFXyWywCT1nSgoCY4EFuIO6B30SxvXM7InEXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzExtoBU7DzTla4hcosc3pk2pkpLp2r4OC_j-B3wjdlrQ&oe=69B95152"}, "display_name": "Untangled", "keywords": [], "long_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around, hold onto other players and truly feel immersed in the world of Web-Guy! \n\nDefeat enemies at crimes around the city and keep the world safe! Through questlines you'll unlock powers and gadgets to help you with your crime-fighting!", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32700208086292276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819311_1454681855544591_5654376424763323885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMdyJlNP_kEQ7kNvwF7bSqH&_nc_oc=AdnytZwr47mKsJyU7wGDowqXVkEZz6yyt61x8H-W9JgtU3hCR-pgjeh6SCb_1TJ0sfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7sKl-d
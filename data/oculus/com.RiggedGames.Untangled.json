avdjQ&oe=6A6B4AAF"}, {"file_name": "Screenshot (2).png", "id": "1351368163192771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827973_1351368169859437_8723905190288898218_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cip6Lxv4BGMQ7kNvwFae5xS&_nc_oc=AdpD6MnMekESHb6OHGalojm-H6D3l6il-dZNpd96dimtU9SrTvck4AtWMwNk3_9GwRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnrnoSZigdnw7qYqtTUnovdG7Hm8RwBdS5bTBZneIh-A&oe=6A6B4519"}, {"file_name": "Screenshot (6).png", "id": "1591592522560051", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1591592525893384_732231287893230239_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsxqSXaoKkQQ7kNvwE6HIum&_nc_oc=Adq_GfDyrxVRToBLhPGdXdYnWd51lZv7o3PrPk2QzNLMQu1r0upd0kbB5nhK4D4Kc5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlpwPAqNuW7Ii-ddSdiECUbWws6RqklqMJfhkIOduOLA&oe=6A6B40ED"}, {"file_name": "Screenshot (4).png", "id": "1503108285165833", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825563_1503108291832499_1484386665411675597_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0AqX_fMrCIQ7kNvwG3Vzkw&_nc_oc=AdrkO5JpafIl6dY17gmrjaWvUVvlTwfu8F0xdy8SfbrKJ4KtlG2nAwIcOhpVzBaxfIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYZb54kkrjETvzALoQ8709GB13DXB1K_dBTr9zt-GiTQ&oe=6A6B399F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UntangledCoverLandscape.png", "id": "1316375820255265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1316375823588598_3272140804454548368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnFWgaaRS_4Q7kNvwGZ2XV1&_nc_oc=AdoijFtt_o26--9IZa-gJAZwc4V6uq6DXL8GwVVcXUNKg46fI9YUCJqexlvFzREp7OE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-eu4rCjjOPAINCC2py212diRA0KWPDKTjTbObxD9hBA&oe=6A6B692E"}, "display_name": "Untangled", "keywords": ["Superhero", "Hero", "Web", "Swinging"], "long_description": "# Join our Discord https://discord.gg/3NvdXzTYqE\n\nEat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\n{973070422401410}\n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around and truly feel immersed in the world of Web-Guy! \n\n{1680092233678983}\n\nLevel up by clearing crimes, defeating enemies and completing activities like Pizza Delivery. Spend your Skill Points in the Skill Tree to unlock new powers, abilities, upgrades and more!\n\n{784546841417201}", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37204535849192788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/5
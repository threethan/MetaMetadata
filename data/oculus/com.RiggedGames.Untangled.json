5vgUA&oe=6A6C9C2F"}, {"file_name": "Screenshot (2).png", "id": "1351368163192771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827973_1351368169859437_8723905190288898218_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cip6Lxv4BGMQ7kNvwFWB1EI&_nc_oc=AdqWVoxTyTfXRMNXh9FNR3Ej5nsiJ2-mRIPlmpsjteE7O_0BTCoY2ZBshhFDEGsf18o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwA7tszP8ENIp05POwUe8zfKA9joXZ7I0ZYpBd2fxsOg&oe=6A6C9699"}, {"file_name": "Screenshot (6).png", "id": "1591592522560051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825546_1591592525893384_732231287893230239_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsxqSXaoKkQQ7kNvwGxZx2J&_nc_oc=AdpZZI8kN-GLScycbLlo9dgCzBLSYw28sJr6V0xiqOP9bvnipgM0F4UZVPXRwZTVL1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb9IDlKHEt4grlpZ4SyEFAkWeDiLGMa_2Bglh4xi54cA&oe=6A6C926D"}, {"file_name": "Screenshot (4).png", "id": "1503108285165833", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825563_1503108291832499_1484386665411675597_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0AqX_fMrCIQ7kNvwHN3CQH&_nc_oc=AdoDuuKpUwiP87vFz9GQuggMa8iqMHil7yUKOvh5bKfuIpwaVMDPXnGOHgiuaxi4dto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDweTHAs5ibJYLI8RyvGuJ4mxic_n_z_mcTnpxDqJb5Dw&oe=6A6C8B1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UntangledCoverLandscape.png", "id": "1316375820255265", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_1316375823588598_3272140804454548368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7h_55wc5_oQ7kNvwHeCGjt&_nc_oc=Ador42qVYPhI4TK_rY4qWNtDwglU4iv8Lf_Bx6mqbFt8bo0Wk7lMaEkIj-ZubPLfdWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe-WK7gW15YQC9-_DrqDX_hLZGMtSrOXeKGqCMvbHw8Q&oe=6A6CBAAE"}, "display_name": "Untangled", "keywords": ["Superhero", "Hero", "Web", "Swinging"], "long_description": "# Join our Discord https://discord.gg/3NvdXzTYqE\n\nEat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\n{973070422401410}\n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around and truly feel immersed in the world of Web-Guy! \n\n{1680092233678983}\n\nLevel up by clearing crimes, defeating enemies and completing activities like Pizza Delivery. Spend your Skill Points in the Skill Tree to unlock new powers, abilities, upgrades and more!\n\n{784546841417201}", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37204535849192788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/5
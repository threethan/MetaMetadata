uscdn.com/v/t64.5771-25/38974750_557311750429485_2789499950880815567_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM1mU5cu02oQ7kNvwEnj5bR&_nc_oc=Adn93oCMgk_j0pdW8P9Sbp6BFCk3zv-eK2MNFt2h9VefkcNCbovCf_oW6mQMCqUw1hU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUw6kbZzBA-aSZCXPb6B9ICYrJ-mB7TK-wUTPB_YMTyw&oe=69A03D4E"}, {"file_name": "UntangledScreenshot5.png", "id": "1048191887320905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_1048191890654238_5816570938393431750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEqHAGA5-4cQ7kNvwGArie4&_nc_oc=Adk2CU_Zy0nLORacMr-Ucu_NKu76ACoHAIgalKmW9Pcn6lQP_xvvNXfgM_Teg8Z7Zqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpWI7g2C3CK56Irho2CGSxQZ63iULqazl3AuFzCDsM2w&oe=69A0418F"}, {"file_name": "UntangledScreenshot.png", "id": "596078956248200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031376_596078959581533_6282574614754715713_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVxucEm7lu8Q7kNvwF0-ZAO&_nc_oc=AdnTv0CEQTEypidIrnpeus9sVuNnilTiwXhm7YCuDTYGczZCxDWIK-VKd-oGN1oTxyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftB20kFjpJiKYp78rshsSt7MiH0NY2SYnTop45x6qEZGg&oe=69A02A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untangled_6.png", "id": "1485911902402939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311912_1485911905736272_2019976733083675626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDiJ15iZW_4Q7kNvwHMZ4L5&_nc_oc=AdlVJF0QoSbg90f76Kad4srGLs1uruPIH4OhJKKSHWredA2rOQipBH-fWro0op-Oe7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsY6EYFYSYcGPOfMucmHh1VoTvQMX0j-HaKOGdpGloiEg&oe=69A044D2"}, "display_name": "Untangled", "keywords": [], "long_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around, hold onto other players and truly feel immersed in the world of Web-Guy! \n\nDefeat enemies at crimes around the city and keep the world safe! Through questlines you'll unlock powers and gadgets to help you with your crime-fighting!", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32700208086292276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819311_1454681855544591_5654376424763323885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5w_NvruErwQ7kNvwFL5-to&_nc_oc=AdkObztsLeK3HZSKlgIB7d5Ypdw_XEr_qObT7MAOVo_3DGf6mwWN7g0dAusAyGIiSyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvVFU3SDne2wje_QadVG595R8VeyDK15ErLe6gCtm_w5w&oe=69A05461"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
nd on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around, hold onto other players and truly feel immersed in the world of Web-Guy! \n\nDefeat enemies at crimes around the city and keep the world safe! Through questlines you'll unlock powers and gadgets to help you with your crime-fighting!", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32700208086292276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819311_1454681855544591_5654376424763323885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDx3gw8Zyz8Q7kNvwE3VvQ3&_nc_oc=AdlEnieOr_zeSfEmbcBEmcL0VUMMXfNY0JcaHcHCwmgMb7usLhJ0jri-va-yzGRuvpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuI7xMmsdclS0BZHT3SxqExOUdVW2wd18yRtijJaXdJ1g&oe=699DB161"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
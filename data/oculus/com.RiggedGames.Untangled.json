uscdn.com/v/t64.5771-25/38974750_557311750429485_2789499950880815567_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLnWoTw29O8Q7kNvwFrp-wT&_nc_oc=AdlFyznHINcFF88YUuXD2lmMxoekYx9r94JRkv1sWhNywljyiUxxyJju_bClhHrpIXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpD7Q5LZPRpB5q14wzqKOVniKRrLXhGg0Q3vCEGz_kzg&oe=6999A5CE"}, {"file_name": "UntangledScreenshot5.png", "id": "1048191887320905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_1048191890654238_5816570938393431750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnRdB8BewhoQ7kNvwHrfodh&_nc_oc=AdnfztmNnk-GqynfTm9sZd_PSMVuqfVkEd2pNGeuOV5IzT1IieAe8O0r3XuIOsJ-ktA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5hdmkVI9S0ky6IeSksqo5XQByUkpmfbJ3zQOSah-VuA&oe=6999AA0F"}, {"file_name": "UntangledScreenshot.png", "id": "596078956248200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031376_596078959581533_6282574614754715713_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gec07an1YWcQ7kNvwGLTw_-&_nc_oc=AdkUIpZiCTYdgRKJk1JskYgpCBi4S5vzye3gYyUXo0P3t09gwxPi3Vj2ar2desuthgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8EWVBjf-WBvlysXT92Vht_a66eLNf_hdHazwaRBWaAw&oe=699992A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untangled_6.png", "id": "1485911902402939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311912_1485911905736272_2019976733083675626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS97WWPJL9wQ7kNvwG_zhPO&_nc_oc=AdkWh8KWPqdSV0v8kvm8ZYtDvx9DNGvTFR0ifTf1_2UQHwOwFUkoZF-ULnmOmn4NipE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftK6n3Do4iPa8c55uFsUv1C_V1lpylYzK7r6HTY4Giu8Q&oe=6999AD52"}, "display_name": "Untangled", "keywords": [], "long_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe! \n\nWith a pull of the trigger you'll shoot a physics-based web that you can swing around on. Using a full physics body you'll be able to walk on any surface, flip around with acrobatics, climb around, hold onto other players and truly feel immersed in the world of Web-Guy! \n\nDefeat enemies at crimes around the city and keep the world safe! Through questlines you'll unlock powers and gadgets to help you with your crime-fighting!", "short_description": "Eat a spider and become Web-Guy in Untangled! Swing around the wacky worlds with your friends, defeat enemies, complete quests, find secrets and keep the world safe!"}]}, "developer_name": "Rigged Games", "developer_privacy_policy_url": "https://riggedvr.github.io/UntangledPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Rigged Games", "support_website_url": null, "website_url": "https://riggedvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32700208086292276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819311_1454681855544591_5654376424763323885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj8ed7_n2WMQ7kNvwEl5GYh&_nc_oc=AdkvgOC4kvFaGu70ky1vVntzo0bUmUzvnKaAX7114ypj0Tnh-Hf3Z1mOXFDHqLuvF7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPUbUmvL5TkHAuPQq--hFGXZfFvzwYEbpJ1QKXipmu3Q&oe=6999BCE1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
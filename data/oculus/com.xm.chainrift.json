-7&_nc_sid=6e7a0a&_nc_ohc=yGJ116udV0AQ7kNvwE6AI5Y&_nc_oc=AdpVL_JmkUElOvF3y7GBXf-MAM0D0SDLE20wlTghFUWcZ-M5XcKjPI_EBCrQZ-HUNh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzamsqiSu9FbAJ4UwGaB9YSAJ5fN6YwiaqbppyKRxPjQ&oe=6B0D9EA9"}, {"file_name": "05-vr-tutorial.png", "id": "1136202452728358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842212_1136202456061691_1910060668370784982_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdvbUGaZhcEQ7kNvwGTxFzQ&_nc_oc=AdoHkjCjZqv-3s_yZsNj0m_CkFN7zk66xlHMJ_5qa8xFALFU2DpDEOsWphgiCv1-dfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkbdNXhGGT4mxdqHhSGFify3DT6rreVrCIoGsEv9RHgQ&oe=6B0DBE63"}, {"file_name": "03-rift-rune.png", "id": "1495667679073154", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842211_1495667682406487_5800744024658894897_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQJ_EOkzw6YQ7kNvwHzV38r&_nc_oc=AdrFZmL7KVzDJivYmUeC94Kta_pLEOZ9Cp4_pXlUN4e44iQ_Gn0SIO4bdhPua7bxW_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaPtlaf_1zqb77HFELuBye8NhepQEwduBbjqDLz640tA&oe=6B0DA57A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chain Rift", "keywords": ["hook", "chain", "arena", "knights", "throwing"], "long_description": "Two armored teams face each other across a bottomless canyon. Your only weapon at range is an iron hook on a chain.\n\nHold the trigger and whirl the hook with your wrist \u2014 the more spins, the farther it flies. Release to throw it where you look, bounce it off the canyon walls, and drag an enemy knight across the rift. Then finish them with the blade in your other hand.\n\n\u2022 Physical hook throwing: real wrist spins charge your throw\n\u2022 Executions: hook an enemy who is already being dragged for an instant kill\n\u2022 Rescues: hook a dragged teammate back to safety\n\u2022 Runes over the rift: Haste, Double Damage and Heal\n\u2022 Upgrade your hook\u2019s damage, range, speed and size on your wrist panel mid-match\n\u2022 Play solo against bots on three difficulty levels, or face an online opponent with two bots on each team. First team to 15 kills wins.\n\u2022 Quick Match pairs two players automatically. To challenge a friend, create a private room and share its six-digit code.\n\u2022 Guided tutorial, snap or smooth turning, comfort vignette\n\u2022 English and Chinese", "short_description": "Whirl a chained hook across the rift in 3v3 arena battles. Play solo against bots, find an online opponent in Quick Match, or challenge a friend in a private room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xmaillc.com/chain-rift-privacy-0.2.0.html", "developer_terms_of_service_url": null, "publisher_name": "XM LLC", "support_website_url": null, "website_url": "https://www.xmaillc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1491021850756824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842191_1145829724897913_8139564163490494683_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2AcTzZCphYQ7kNvwE7UfRk&_nc_oc=AdpmikdP5o5O1_ctUFN27mR54xrWDoXwiu_8arOeZOqE4V-ynfrdyRZJ6dbC
&oh=00_AQN24NrEQppOqWFrlxkqr1EGdsTXL18eSvRQKWR2ASBJZw&oe=6AD3B227"}]}, "id": "2888272601522397", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01.png", "id": "1009341738500957", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499624983_1009341741834290_7396098546749684858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgE_zMxRV5AQ7kNvwFcJzyJ&_nc_oc=Adp5PswWMJD1Fvox55RBk2YGUhBff4Gp3pHZ2-n4opxOlnQ6L8PZpbglWUC-mlgzh14&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOox0rMJXqwjolfIsblLNj_aCzfQImqto9G1YxGBgNFOw&oe=6AD38B61"}, {"file_name": "screenshot_02.png", "id": "1294123909144269", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308063_1294123912477602_4872387866917650308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me93AfScTV0Q7kNvwE3xo1E&_nc_oc=AdqRp-re3tSIx8BhkSKj0GgMoWahQvtfCdS2Zrkkn8lOjKqDZONPZfOYt5jOczqusMo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7TQOyjvZ_kqRTsvmSpuUWBmYayDsDavkFJ8zxQ5xkWw&oe=6AD38D17"}, {"file_name": "screenshot_03.png", "id": "2015614565724542", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623384_2015614569057875_6877754692546287726_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJBcgoYvMUkQ7kNvwGStO7F&_nc_oc=Adogsp7gXo3tOhktAstpkN1DusqccjcyuSrhqh0Mnh3ZFS9VXin5vfblZFOZzPXLBHQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtSnPoe4Dzs2AxaVM0zLo-S4YYgSY9s6J8iIIreNgUYQ&oe=6AD3B936"}, {"file_name": "screenshot_04.png", "id": "1009504808671772", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1009504812005105_9203692076642005603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2fcFRmD92MQ7kNvwFGdOgc&_nc_oc=AdoOs_mkx0yR_8ubMQu6wb0LQIg19wkJicKEWJrz7jwyxoyw6lGpek-ZFxwH5ed3NpU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKddntFzpZiCtgEny8gtwKa0-TqpmCrYllw1z5ljAhRQ&oe=6AD3B398"}, {"file_name": "screenshot_05.png", "id": "940914609000158", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620921_940914612333491_4127732485565456129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLiwqOrRjKQQ7kNvwESscLc&_nc_oc=Ado903yUCmn86RQxpF2vD1alj8mwMN5Kl6ZFS9a_l3Uz7LhuMadVI7hlXru3MBb-gsQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOktt0qIL5QDt7hyAospMV4FWiSlOxpIOnXlWzQ7ek8Dg&oe=6AD38DFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "992548943557216", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623400_992548946890549_7827796434109570858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqmowIHXrqIQ7kNvwEmp47t&_nc_oc=AdriQ5v17O37ocM6OYlJO2xaZ2UI-_lvxOnaQP7puZI_xe0eK8sxzzJglUUZMUKyCEs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSms-fN1CCc9aI1u_cLku_4Nww2oSRml0UHarsVOJ9lQ&oe=6AD395DF"}, "display_name": "Plonk! A 4D Puzzle", "keywords": ["puzzle", "cozy", "cereberal", "time", "claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{2427361921076565}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{2107723376441476}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{1028362636330056}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1806835673822519}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1694549174926291}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343276673874869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624983_4363765987210188_780526073124059393_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8_oXC2UiE8Q7kNvwH77IGY&_nc_oc=AdoRP4kk-QMOwmjcGx2u5P1jaLQUkCFsnSIac8J-QrOi1UzAAH08H-9ocNemVuqxRhU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpH07xdYWutmYhWV4HiDNxP_XFvYwujeyZFYFBlcO9MA&oe=6AD3937E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plonk! A 4D
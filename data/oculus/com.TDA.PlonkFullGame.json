&oh=00_AQJLDr2ihzGTkLEjAhq3XQHKPGmuJtM3hgz3oHi-qVYKow&oe=6ABBBEE7"}]}, "id": "2888272601522397", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01.png", "id": "1009341738500957", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_1009341741834290_7396098546749684858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SY6bTvf0UUQ7kNvwFoWR1v&_nc_oc=Adqu-rizHPlWBGRFStz2wFE_XIY2dzHaOkeMEadMezDh6B7VNjPW9fNTP4dexAOU0EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYFEuQKrUZolK90PXzB7lIjLUlcdLzqY26hbPgFZ0WUw&oe=6ABBD061"}, {"file_name": "screenshot_02.png", "id": "1294123909144269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1294123912477602_4872387866917650308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKCS3nnuNWUQ7kNvwGK7IZD&_nc_oc=AdooNBn_Q2F4-dI70o5OfYIlAYVszjFWE6OfTz9UeSikkyn85hDQ-PaEx7WTIGfQ52g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqb8306ucjtK2DGagI56J-FFdqsy8nmPSDesmkk70Xqg&oe=6ABBD217"}, {"file_name": "screenshot_03.png", "id": "2015614565724542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_2015614569057875_6877754692546287726_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8uXdC0j9SEQ7kNvwF_BdLS&_nc_oc=AdrJaMZ7pUrcxO--8ipIKW5Jlv59XVWOar6ua9C4K9GnDpgqyJA1FqJ0-A8waNTWFz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWNzxSKiGVuOnREncwPfJ7xr9WTAUuTRQGb4jJ3okO-Q&oe=6ABBC5F6"}, {"file_name": "screenshot_04.png", "id": "1009504808671772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_1009504812005105_9203692076642005603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEHY2QIub70Q7kNvwF4la_H&_nc_oc=AdopX3uVXBt8xiaLZonsBGbVJlFAlQ_j-1ulJrNBcaV98iXhf4EY_YXyA7HseVPmsLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9uIABHtuXPcJV1txSTVwdk5BONQ7K7pV21BELJl_mVw&oe=6ABBC058"}, {"file_name": "screenshot_05.png", "id": "940914609000158", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_940914612333491_4127732485565456129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_ZIezykOrIQ7kNvwFvf94g&_nc_oc=AdohB7uvt65I3iEa_gBwq3LYxyI8em0sldYHZMfiR0xWRj_lTlB4fKPUGPb52d7hRPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW9009NOOVrTjBB8ksWiFAcRvQg1PKMlp4vjVELbk0Zg&oe=6ABBD2FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "992548943557216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623400_992548946890549_7827796434109570858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29yhFZvdSH8Q7kNvwEwkqzV&_nc_oc=AdoEGbPsuP_qqZ5tCRHFQhg5Almxl489_qUo6wCopeKJ9Dlqq1pB9fTf4lGyAN2KNi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6hTIcjlEH-P81xW9c18jWEJ8oTYhl9FCgDwzoW4fmjA&oe=6ABBDADF"}, "display_name": "Plonk! A 4D Puzzle", "keywords": ["puzzle", "cozy", "cereberal", "time", "claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{2427361921076565}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{2107723376441476}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{1028362636330056}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1806835673822519}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1694549174926291}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343276673874869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_4363765987210188_780526073124059393_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEx5jAONCLUQ7kNvwHvUwlD&_nc_oc=AdojyHcYDqTJntRIPAtY7NGZF0A4VhOUvJRNLdBapmPjQc3eFCs45eoMnlhTPnYe_7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsp4t95nZNC4HGqzxf-z9pPX86HupOpPoquvZVj2r05A&oe=6ABBD87E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plonk! A 4D
uscdn.com/v/t64.5771-25/499620921_940914612333491_4127732485565456129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWB6KpZ_v1QQ7kNvwFwY4xG&_nc_oc=AdpDn-1uMXwJk6v5Lqswez_TSobsVxv-o9lFZ-2Uy1kK1JOtg5wqHqgiiOQUQwKhnz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB4mIFALvQ4isA4ITXmFU2eE90xOSLAN0nip78yy2n0w&oe=6ABA817C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "992548943557216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_992548946890549_7827796434109570858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29yhFZvdSH8Q7kNvwH8albQ&_nc_oc=AdohL2K97TzJ8yxxyEwPNLhn0JpzVEXc7SNT4pZj0_55VCsrGKFCM5NN-rHx5nI7YDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZbYlZPAqh6tAMFgdTY65vBAde8qRaNFsUOwl44A_8Gg&oe=6ABA895F"}, "display_name": "Plonk! A 4D Puzzle", "keywords": ["puzzle", "cozy", "cereberal", "time", "claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{2427361921076565}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{2107723376441476}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{1028362636330056}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1806835673822519}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1694549174926291}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343276673874869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_4363765987210188_780526073124059393_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfUcpxamkVkQ7kNvwFbzrEM&_nc_oc=AdrfTUytr3Rqw3Th7uSvv1DKI3OmF_2z5XIiFVAt_05Is-F7nHxJG3nLIXX9b01Ez2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHrXAJItc-XelJUKVLblobJxizTqRqnwLA1Dav7XKikg&oe=6ABA86FE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plonk! A 4D
&oh=00_AQLqmrleO4TF6oWGf_d2HQteSHcSgBs261IMWJOu8UlFhw&oe=6AA55567"}]}, "id": "2888272601522397", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01.png", "id": "1009341738500957", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499624983_1009341741834290_7396098546749684858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CW9DpIpA7MQ7kNvwHpLFF7&_nc_oc=AdrREFxGmVTeS_xeW0LIWGcApm6_RnrRqufU-TnIdPMI5-i57SVI1CcWzJ_qq5eF160&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDdW_m7fvUQ91FALo_u9iZFLyCUOWBexGqwZCk0gZJig&oe=6AA566E1"}, {"file_name": "screenshot_02.png", "id": "1294123909144269", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1294123912477602_4872387866917650308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjNIlgI2GRgQ7kNvwHLbdjL&_nc_oc=AdqlJyFqcCI_n1Wi7vAn4dZB7TjH_rav3MvmZc6Lb7gZzrp-XXrJrKQuZftekYdntNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpoEpHgFpYngV0PyNvjekKuY5EjyBN6YEGM8PenKotYw&oe=6AA56897"}, {"file_name": "screenshot_03.png", "id": "2015614565724542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623384_2015614569057875_6877754692546287726_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqLws-ZQky8Q7kNvwE6eX6a&_nc_oc=AdruaidwCNmyDjplK-KIyLVuZmhxyDP-edjtJZy7qUmKOO0bLMsdnATXYbmfbUpaO78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZshEqk_lPyn2OGhgOiX1qagiPOJvEzhMM73ALZQ_aMw&oe=6AA55C76"}, {"file_name": "screenshot_04.png", "id": "1009504808671772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_1009504812005105_9203692076642005603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-QOPp8m_W0Q7kNvwHTXmZF&_nc_oc=AdroH_0hyQBEG9mgbege8ryVgSwV7yF02-ihnxnMZUvUe3mCaLtzuBAxXLlO-389W50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDqddWk8Mqa-Ka9ukHSXWV7ClKimoIfOTuDnayfZznxA&oe=6AA556D8"}, {"file_name": "screenshot_05.png", "id": "940914609000158", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620921_940914612333491_4127732485565456129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTial_F_C9gQ7kNvwF5ta9C&_nc_oc=AdpquBhcNuXCfdVERywNYK9D-6HTJ9VNWDL75VmR5Yf5wNUpL77TXLcyrIXWb5PJ_iM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlV44wk-BF0sx7KO5-T_LEs7OQmwO61K9Cwry3muDL4Q&oe=6AA5697C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "992548943557216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_992548946890549_7827796434109570858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26Wr6Hv9o_MQ7kNvwENKqkp&_nc_oc=AdrA880ZtkCzKo52V-sf1BPsyfqoSCc1mJepYLt7ZPCATkCyJxPM7KlraLiNdQYUneM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY_BUvMdXkyY_4Lo8sjJIycJ5Hzsw4zPsazr56fQPbtA&oe=6AA5715F"}, "display_name": "Plonk! A 4D Puzzle", "keywords": ["puzzle", "cozy", "cereberal", "time", "claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{2427361921076565}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{2107723376441476}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{1028362636330056}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1806835673822519}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1694549174926291}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343276673874869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_4363765987210188_780526073124059393_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6_wDgFnEm4Q7kNvwFaOMPC&_nc_oc=AdozFrK4RTe92VzwIsiAK4YBso5YShv2RzfsAsFX01kh76FpW9nwZNKy1oHexSowiDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5hvbwo5lHcRNMoB_fYys9_K7ckTyLclxvon0yC4643A&oe=6AA56EFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plonk! A 4D
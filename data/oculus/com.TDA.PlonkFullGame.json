&oh=00_AQJOEOl4RBeWzjZMwXzxpLSpghXp9u49gRIGm2caoV7E3Q&oe=6AB52767"}]}, "id": "2888272601522397", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01.png", "id": "1009341738500957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_1009341741834290_7396098546749684858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-jyHxk2MD4Q7kNvwFNHSoN&_nc_oc=Adp8GDCvDQCNy0XeMFoj-qKDgd2V7ZNCow-MP5ZoOqQtN5J4hPVLbTAL0yryUFVSRWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFHzmM4jnzSELGGMcaw9uolh0UBpRv7tLZksGjsFvP7g&oe=6AB538E1"}, {"file_name": "screenshot_02.png", "id": "1294123909144269", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1294123912477602_4872387866917650308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kx7XmMC7nH4Q7kNvwEfwIAL&_nc_oc=AdqwBZxn6h-f46k6gMLHr7ea_i3TY7f8FwJw0S9jKMGyIPy3VMc3llWyFToVmg_d0wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWbCeHA_bfVF5iAh48F27qSyNiR1Y6UWsaF6ExVaTTgg&oe=6AB53A97"}, {"file_name": "screenshot_03.png", "id": "2015614565724542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623384_2015614569057875_6877754692546287726_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApF04QI2H1kQ7kNvwFUE6ZH&_nc_oc=AdqZ_dZiaKm4b70XlIeW_mAMo82LRphEfFYE1dtGGgkGgwNXgyLhVaY-j5MLE4aWChM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-tOTFPP23NGaBQgIGRYfsHvOZZIxQBDyF7-tBYmpCfQ&oe=6AB52E76"}, {"file_name": "screenshot_04.png", "id": "1009504808671772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_1009504812005105_9203692076642005603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tv_voWtiTrgQ7kNvwE8a8sf&_nc_oc=Adozery1D23FoMUZjl5ITXveENUcK4xC289H0pxy2NnaowKjMYx8ng0IPdKMcAWY5PU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKfs-xyPfOJtzeBHwIkt4s639Z56T3noTHeG44iYnk5Q&oe=6AB528D8"}, {"file_name": "screenshot_05.png", "id": "940914609000158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_940914612333491_4127732485565456129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDx8oDmkBysQ7kNvwEPPnF1&_nc_oc=Adqi657QhfrY0YWK6gglKuwUaaGyv1mO0NBWN6mtv9f6GRkj91sFREMXKeSRVqwFlsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpwLo9MLbe6KWoh9-bV0LOsmYP9CHSPS3V7JhopJgfDw&oe=6AB53B7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "992548943557216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623400_992548946890549_7827796434109570858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-HX3A0aknEQ7kNvwHJSz_S&_nc_oc=AdoZVL7Wy70CTfLBDuhRoz46L5Ny2HL1575fi_JDc87wty4E64peWo4T67WcWGsZWyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrdlo2IaFq4rH1I9Sd59Uq_roikzMZ2_TofxXqPQRtHw&oe=6AB5435F"}, "display_name": "Plonk! A 4D Puzzle", "keywords": ["puzzle", "cozy", "cereberal", "time", "claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{2427361921076565}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{2107723376441476}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{1028362636330056}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1806835673822519}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1694549174926291}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343276673874869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624983_4363765987210188_780526073124059393_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66Yw45gv_EEQ7kNvwF8MlbI&_nc_oc=AdoiVs2BS7zp8StqoXJyFSlxtiXaOwFqS2KjWIlVxawapDYkuQ5x_pGyo2zLJ2s6Rvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHDI1vbrhrSz2shJ87RuvVjdYNUtDT6yZ_c2gfBHGHuw&oe=6AB540FE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plonk! A 4D
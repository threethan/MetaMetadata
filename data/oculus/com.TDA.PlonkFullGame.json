&oh=00_AQJv08FuCKvSwxtHGeWixYAYubbMquX-RodBHZ_xEGgacQ&oe=6A9C1AE7"}]}, "id": "2888272601522397", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01.png", "id": "1009341738500957", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624983_1009341741834290_7396098546749684858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOVIOQq-XZkQ7kNvwEr965d&_nc_oc=AdqOzuITvf3FgDBbk5XnFutvr3uVmYbvgNjoXNlcvC6h9H2oAzOh_1ikDFqgVNYvHZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqnWdWJ_WtX7o56QgGrSt3QyFaUHSuv1C8SvVqILKhjA&oe=6A9C2C61"}, {"file_name": "screenshot_02.png", "id": "1294123909144269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308063_1294123912477602_4872387866917650308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWfzyaRebjcQ7kNvwG7mqrn&_nc_oc=AdrZPA2niYnRekmFjEd3AzaujzRMYQLBQKgNeoVP9uEeYBnaCkJDpuQJ1RW7H_0GXlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2pHIdYx1z9KbQoqmHWnv3W5ftttnUSQxakudvr27sKA&oe=6A9C2E17"}, {"file_name": "screenshot_03.png", "id": "2015614565724542", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623384_2015614569057875_6877754692546287726_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwFuLxlhgDkQ7kNvwFdiJiY&_nc_oc=AdoaGsNsxiJ68jaXzyaStR0M6AwoQbkdPfNAvR4CnWmKnKKijv37PYjj3Nxo9MaTFm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb6T12UF_G-Ol2SpsG_ru0tOJD1gnHoNG0j1ggIIEM-Q&oe=6A9C21F6"}, {"file_name": "screenshot_04.png", "id": "1009504808671772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_1009504812005105_9203692076642005603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-g-7hhGmBIQ7kNvwFZDTTx&_nc_oc=AdqRPcshKXBqYUAi6ckgom9LFVa_DpS24QpbRKWDQEhZyJ0bNcTpWF1nb2DJhY-vTPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJun4YXD_cey2JeJwl4yDT4qGzram8TbfDyNLnY3qbLmg&oe=6A9C1C58"}, {"file_name": "screenshot_05.png", "id": "940914609000158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620921_940914612333491_4127732485565456129_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s99aQQzAHxMQ7kNvwHS03xX&_nc_oc=AdrYCaR8FI9gWQKr2dUBUnHD5-jHJ8rRptGwyRbindTQeGtq0I7wXVc3uyjP3fpX7oE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9_cLmyjlNwpMe39a7iI2nE_PZp1G6n2j2RMn4nvlwNQ&oe=6A9C2EFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "992548943557216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623400_992548946890549_7827796434109570858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxf52tbMwcwQ7kNvwEhz-mj&_nc_oc=Ado_hODWdwYp_No6UqarPsqS0pBMQhyoz701EvPJ5adZE7qn6TMzLuDP4d2_SL7Zvuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVA_Nb5O0nt9qHOXJamk7TNSgdCsF4Xo8KHGEF3GgA4A&oe=6A9C36DF"}, "display_name": "Plonk! A 4D Puzzle", "keywords": ["puzzle", "cozy", "cereberal", "time", "claymation"], "long_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with **two extra dimensions**, space and time. \u200e \u200e \u200e \u200e \u200e \u200e  \u200e  \u200e \u200e \u200e\u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e \u200e\u200e{2427361921076565}\n\n\n# \u231a A Moving Puzzle:\nEach puzzle piece holds a slice of an animated diorama. Scrub through time to discover how they all connect.\n\nPlonk the pieces together to solve the level.\n\n{2107723376441476}\n\n# \ud83e\udde9 50+ Hand-Crafted Puzzles\nTravel across a variety of worlds including playful toys, lush environments, clockwork creations and more.\n\n{1028362636330056}\n\n# \ud83d\udd90 Play Your Way\nUse hand tracking to solve the puzzle, or grab your controllers.\n\n{1806835673822519}\n\n# \ud83c\udfc6 Leaderboard and Challenges\nRace against the clock and compete for top spots on the global and friends leaderboard. Solve the bonus challenges in each level. \n\n{1694549174926291}\n\n**Let\u2019s Get Plonkin\u2019**", "short_description": "Plonk! A 4D Puzzle is a time-bending Mixed Reality game that reshapes the very concept of a jigsaw puzzle with two extra dimensions.\n\nSolve vibrant worlds of playful moving puzzles brought to life in claymation. Track back and forth across time to find connecting clues, plonk puzzle pieces together, and restore the fractured animation."}]}, "developer_name": "Stickshift Entertainment", "developer_privacy_policy_url": "https://plonk4d.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Stickshift Entertainment", "support_website_url": null, "website_url": "https://plonk4d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1343276673874869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624983_4363765987210188_780526073124059393_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV2VGUj7Vr0Q7kNvwHMkvWJ&_nc_oc=AdoWWbadWWgzyepT0Vuo23v5bQrNKUlnlNZmo0KkuuSqMT0mcejhJe0Tl5m8pazW1p4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfqyqbxNCM2ETRemQLWqhqpdFUxxVbBek5V6fRe1rrmg&oe=6A9C347E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plonk! A 4D
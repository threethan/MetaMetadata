g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XYwroqYRUUQ7kNvwFtvI_E&_nc_oc=AdpSzOMpQmSepSUkH7oNy5i5YPfwxbpokvF76OPlDDxYI2ikzEGBU956pc-f1rkNMPw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GVnmWzcxGbh83AabmcskeJk4ZvnUPnl0pTMGD49sa9g&oe=6A1C5DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Anteprima video.png", "id": "2766673700338573", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823930_2766673707005239_6765062186112674912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoigV33SOwMQ7kNvwEOxJOP&_nc_oc=AdqAzThNRyZayFbmAGIErVUXrzsOJaucna5gVuWH6bJYfUTtlZDOjIWd_HUY61XU_i4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RNbsvWSS_x06kIwFGs-GvhoqXBWlrKft6f9K7laEzAg&oe=6A1C2B55"}, "display_name": "HoloMeeting VR - Showroom & Training", "keywords": ["training", "showroom", "hologram", "marketing", "collaboration"], "long_description": "HoloMeeting VR is a VR showroom available anywhere, featuring realistic, detailed virtual versions of your products. You can examine them up close, step inside them, view them at full scale even if they\u2019re enormous, or enlarge them if they\u2019re small. Product simulations can include mechanical movements (they can be running!), visual effects and explanations. HoloMeeting VR is more effective than a showroom of physical products!\n\nIt also lets you invite people into the showroom from anywhere in the world and discuss the products on display together, as if you were in the same room: no more long and expensive business trips.\n\nHoloMeeting VR is an innovative and immersive tool: it supports designers during design reviews, helps technicians with training, and empowers communication teams with presentations and marketing. It\u2019s perfect for product demos, training, events, and trade shows. It\u2019s also ideal for creating an impressive, immersive in-company showroom in a small space, easy to keep up to date with new products.\n\nFor more information, to book a demo, or to request the creation of a virtual copy of your products, visit https://holomeeting.it", "short_description": "The ultimate immersive tool for virtual showroom, product communication, industrial design review and hands-on training, with real-time collaborative capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomeeting.it/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "High Resolution", "support_website_url": null, "website_url": "https://holomeeting.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "34764071896573388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827567_922471830480984_7863656341295636259_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrgnxphKDyoQ7kNvwG7a22d&_nc_oc=Ado3Wypm5qmkrCCqsbCTo8gI2bglfBlojZd9kA61GqaMGkvzuBLvgUlyrWaucfI9u0g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52c6I7Uqrskld8BCHlqL6XE6SlAYENNyovD3eSBaPrGg&oe=6A1C39A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HoloMeeting VR - Showroom & Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
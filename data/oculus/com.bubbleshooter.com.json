i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842198_1614286679816801_3899382115277435012_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGhNgouEBMcQ7kNvwF-lTJw&_nc_oc=AdrSpOpMqTBMAUHgNPTmuz6djiHbdG8IQcIw550LMF326fqduzVlOnu_EobtofoM5yE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAkvbM8VbEBNJBVu3V8m9M-haxyev_S5N3mzMBJcL3Zw&oe=6B0EED49"}, {"file_name": "image_4.png", "id": "4817478775205408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842220_4817478778538741_2406242643553023045_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=427rH1e5VQYQ7kNvwEsvAED&_nc_oc=Adoygll_oHVXpYa4lpOmA6gr9G3WGnW-K9hBD6Obe5HF_KU-L2pVEss7jY0sU_jVrYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHAbSj-b0ct4VZIb6BWsf9A8M2kIs9c4ubzZK3ukHrWA&oe=6B0F1305"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bubble Shooter MR", "keywords": ["BubbleShooter", "VRShooting", "MixedReality", "ColorMatchmaking", "BallShooting"], "long_description": "Bubble Shooter \u2013 Enter the Colorful Challenge!\n\nStep into a vibrant VR and Mixed Reality bubble-shooting experience built around precision, timing, and tactile throwing physics! Whether you are playing in a fully immersive virtual environment or bringing colorful floating spheres directly into your living room with Mixed Reality, every shot counts.\n\nHOW TO PLAY\n\u2022 Aim: Line up your shot using intuitive VR controller aiming.\n\u2022 Throw: Launch your sphere and put your hand-eye coordination to the test.\n\u2022 Match Colors: Hit clusters of matching colors to pop and clear them from the arena.\n\u2022 Master Your Skills: Keep playing to sharpen your accuracy and beat your best runs.\n\nKEY FEATURES\n\u2022 VR & Mixed Reality Support: Seamlessly play in full VR or turn your real-world room into an interactive bubble-popping arena.\n\u2022 Tactile Aiming & Throwing: Responsive, physical throwing mechanics that reward steady aim and smart angles.\n\u2022 Vibrant Visuals & Effects: Satisfying pops, colorful spheres, and crisp visual feedback with every match.\n\u2022 Pick-Up-and-Play Fun: Easy to learn for casual players, yet endlessly engaging for anyone who loves precision challenges.\n\nREADY TO PLAY?\nPut your aim to the test, match the colors, and experience classic bubble-popping fun in a whole new dimension.", "short_description": "Enter an immersive mixed-reality Bubble Shooter experience! Aim, throw colorful balls, match the same colors, and test your accuracy in an exciting VR challenge."}]}, "developer_name": "Smart Magic ", "developer_privacy_policy_url": "https://smartmagicproductions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Smart Magic Productions", "support_website_url": null, "website_url": "https://smartmagicproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1429279073605039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673645340_1503399341632189_1200752109083009534_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1wiZ39aw3YQ7kNvwFYUYSF&_nc_oc=AdoiT9W361EJlcysDVWZkpBX0HSxvg210MYKiDfFsjClzu-w_lDNTqGCnDtEfjs_KOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_
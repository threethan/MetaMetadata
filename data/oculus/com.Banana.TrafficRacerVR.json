MQ7kNvwGkq8Ag&_nc_oc=AdrrnO6r6cV6ZV-vm0et_UDpXChNQ8igUHyEnZFIo1mxsWaXCrPzIxMn1sLSls7zTVQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoQlKsQ6Ef3ZSYBHDflnUykymZRs1agW2qq71uCIm6ng&oe=6ADCBB37"}, {"file_name": "530275553_24695314663405751_2368215661600264209_n.png", "id": "9098428643615707", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822897_9098428650282373_5494468255796757598_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0xU_1xWVFUQ7kNvwG9S_df&_nc_oc=AdovRgaqyqegWaFrGoWXVssCjyDIkQLN0Ji9DZoTfUZ4SJUigtIFj4Gx8YQhtM6Z2z8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWfpicu92QFjpy-9QE-FAgN0Ww_MMN3hFCi9m_VU1VYw&oe=6ADCCAA0"}, {"file_name": "529004069_24382785961333846_7956621864714347737_n.png", "id": "24458119127117082", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828899_24458119140450414_3943801774487249827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhACkvm_Jy4Q7kNvwFVyL7d&_nc_oc=Adqkri_f1BrQGstXps7U75cNFe5YpdnIqkksAsD-s02P4eufpB9NdK3z4Y5G-eqLURY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqVtOG7b72UX04WyI_SvXdtLndmqVfDZV3da88OXtoig&oe=6ADCCD60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRVR2CutCopy.png", "id": "726797986642298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819407_726797989975631_6127624523229703443_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkp49aCafQcQ7kNvwFvtrrM&_nc_oc=AdqxlH7HiiXfjXY7GFHyvmVp8z2XIoi8UEs_AoantBtcigawisRkQfZRxTQO-dtvM-A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYtcxggKxK_151pkBmXFBKYSP6MkHGkAlNq1az0wTGgg&oe=6ADCA242"}, "display_name": "Traffic Racer VR", "keywords": ["traffic", "racer", "cars", "racing", "drive"], "long_description": "Welcome to Traffic Racer VR \u2013 the ultimate adrenaline-fueled driving experience built from the ground up for virtual reality!\n\nPut yourself in the driver\u2019s seat and experience the thrill of racing through dense traffic at high speed. With ultra-immersive VR controls and realistic physics, every turn, swerve, and near-miss feels dangerously real. Dodge cars, weave between lanes, and master the flow of traffic as you chase high scores and big rewards.\n\nUnlock a growing collection of high-performance cars . From sleek sports cars to powerful muscle machines, your garage is your trophy cabinet.\n\nFeeling competitive? Traffic Racer VR features Daily and Weekly leaderboards where you can battle players around the world for the top spot. Push your limits, climb the ranks, and show everyone who the true king of the road is.\n\nWith fast-paced gameplay, stunning visuals, and a true-to-life driving sensation, Traffic Racer VR delivers a racing experience that\u2019s only possible in VR.\n\nWhether you're chasing the next car unlock, perfecting your skills, or gunning for leaderboard glory, Traffic Racer VR will keep your heart pounding and your headset on.\n\nReady to race? ", "short_description": "Race through traffic like never before in Traffic Racer VR! Feel the speed in full virtual reality as you weave between cars, unlock high-performance vehicles, and climb the Daily and Weekly leaderboards. Every race is a thrill, can you handle the pressure and become #1? With realistic driving physics and heart-pounding gameplay, this is the ultimate VR racer. Strap in, hit the gas, and own the road!"}, {"images": {"nodes": []}, "id": "862539906179475", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Traffic Racer VR", "keywords": ["courseVR", "jeudevoiture", "simulationconduite", "racingVR", "jeudecourse"], "long_description": "Bienvenue dans Traffic Racer VR \u2013 l\u2019exp\u00e9rience de conduite ultime, con\u00e7ue de A \u00e0 Z pour la r\u00e9alit\u00e9 virtuelle !\n\nInstallez-vous derri\u00e8re le volant et vivez l\u2019adr\u00e9naline pure de la course \u00e0 travers une circulation dense \u00e0 grande vitesse. Gr\u00e2ce \u00e0 des commandes VR ultra-immersives et une physique r\u00e9aliste, chaque virage, chaque \u00e9cart et chaque fr\u00f4lement deviennent intens\u00e9ment r\u00e9els. \u00c9vitez les voitures, changez de voie avec pr\u00e9cision et ma\u00eetrisez le flux de la circulation pour atteindre des scores records et remporter de grosses r\u00e9compenses.\n\nD\u00e9bloquez une collection grandissante de voitures haute performance. Des sportives \u00e9l\u00e9gantes aux muscle cars puissantes, votre garage devient votre vitrine de troph\u00e9es.\n\nEnvie de comp\u00e9tition ? Traffic Racer VR propose des classements quotidiens et hebdomadaires pour affronter des joueurs du monde entier et viser la premi\u00e8re place. Poussez vos limites, grimpez dans le classement et montrez \u00e0 tous qui est le v\u00e9ritable roi de la route.\n\nAvec son gameplay rapide, ses graphismes saisissants et ses sensations de conduite fid\u00e8les \u00e0 la r\u00e9alit\u00e9, Traffic Racer VR offre une exp\u00e9rience de course possible uniquement en VR.\n\nQue vous soyez en qu\u00eate de votre prochaine voiture, en train d\u2019affiner vos comp\u00e9tences ou en mission pour dominer les classements, Traffic Racer VR fera battre votre c\u0153ur \u00e0 toute vitesse.\n\nPr\u00eat \u00e0 courir ?", "short_description": "Foncez dans la circulation comme jamais dans Traffic Racer VR ! Ressentez la vitesse en r\u00e9alit\u00e9 virtuelle totale en vous faufilant entre les voitures, d\u00e9bloquez des bolides haute performance et grimpez dans les classements quotidiens et hebdomadaires. Chaque course est un d\u00e9fi palpitant : saurez-vous g\u00e9rer la pression et devenir n\u00b0 1 ? Avec une physique de conduite r\u00e9aliste et un gameplay \u00e0 couper le souffle, c\u2019est le jeu de course VR ultime. Attachez votre ceinture, appuyez sur l\u2019acc\u00e9l\u00e9rateur e"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ef0cca47-9ac1-4bd5-9f0e-4b192f4173e2", "developer_terms_of_service_url": null, "publisher_name": "Banana", "support_website_url": null, "website_url": "https://linktr.ee/banana_meta", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33146177744980707"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295272_1966275174104643_9134285028328357902_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiNixD1g-9MQ7kNvwG3PZeG&_nc_oc=AdoDOK9tTNvHFTIkTyMPe252i3k1bxbNnoDxEcvcPeAtlvPdiJhixsjsDbNj3LeIQYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOshzcy_rRWzIIpZfXLXyWutl-tCa37u28D_F5h6MvEwA&oe=6ADCD00B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Traffic Racer VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1757091600, "lastRevision": {"nodes": [{"id": "30212020978396413", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "30212020908396420", "is_first_party": false, "en
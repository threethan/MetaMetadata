res planned for future updates.\n{3227293324138071}", "short_description": "Chimp Chase VR is a fast-paced VR game where you run, climb, jump and mess around with other players. Explore maps, play with friends and unlock cosmetics as the game grows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://giraffe-b6xdh7.my.canva.site/chimpchase", "developer_terms_of_service_url": null, "publisher_name": "CHIMP CHASE STUDIOS", "support_website_url": null, "website_url": "https://giraffe-b6xdh7.my.canva.site/chimpchase", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1376807632180408"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "953694757258376"}]}, "baseline_offer": {"id": "953694757258376"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791304260, "status": "PUBLISHED", "id": "953694757258376"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1436840036177167", "version": "0.2.4"}, "id": "1115109951026792", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1371278
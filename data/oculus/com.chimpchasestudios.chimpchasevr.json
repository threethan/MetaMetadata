und movement, climbing, chasing, and messing around with other players. Run, jump, climb, explore different maps, discover fun areas, and hang out with friends in VR.\nThe game is designed to be easy to jump into but fun to keep playing. Use your movement skills to get around the environment, meet other players, try different activities, and explore everything Chimp Chase VR has to offer.\nChimp Chase VR is still growing, with more maps, cosmetics, activities, and features planned for future updates.\n{3227293324138071}", "short_description": "Chimp Chase VR is a fast-paced VR game where you run, climb, jump and mess around with other players. Explore maps, play with friends and unlock cosmetics as the game grows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://giraffe-b6xdh7.my.canva.site/chimpchase", "developer_terms_of_service_url": null, "publisher_name": "CHIMP CHASE STUDIOS", "support_website_url": null, "website_url": "https://giraffe-b6xdh7.my.canva.site/chimpchase", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1382956301565541"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295481_1602235508303496_9105555126163469530_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlyu4
284729033_1146785936881878901_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXXOpbs4b8sQ7kNvwH8r61T&_nc_oc=AdpiC9FvUXw09U-JJ1aKHs8acny0CaZvy9Uxwj2w0jeBOS_Zp64Zbieg-2qcQD9q6DE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_DqWZ_bTAT5auBlmgJGm3xOhtig5asKEAQ_1RqJS0bg&oe=6AF741B3"}, {"file_name": "01_LOW_GRAV_2560x1440.png", "id": "2266952377180149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_2266952380513482_1616887266015561448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ9zSN7GPzoQ7kNvwGWUTf7&_nc_oc=AdpCZI0HcMz9IDhVTjJW42aW3GDaIbsiV4WqibWUeEtb_BMqHV2uA3VZQZyLXeN8l20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVof4sLTm13gUXGKsPsWR4ZXxmmZAAYsS00-v4YEcEzA&oe=6AF73476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CHIMP CHASE VR", "keywords": ["CHIMPCHASE", "CHIMP", "CHIMPCHASEVR", "chimpchase", "chimpchasevr"], "long_description": "Chimp Chase VR is a fast-paced multiplayer VR game built around movement, climbing, chasing, and messing around with other players. Run, jump, climb, explore different maps, discover fun areas, and hang out with friends in VR.\nThe game is designed to be easy to jump into but fun to keep playing. Use your movement skills to get around the environment, meet other players, try different activities, and explore everything Chimp Chase VR has to offer.\nChimp Chase VR is still growing, with more maps, cosmetics, activities, and features planned for future updates.\n{3227293324138071}", "short_description": "Chimp Chase VR is a fast-paced VR game where you run, climb, jump and mess around with other players. Explore maps, play with friends and unlock cosmetics as the game grows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://giraffe-b6xdh7.my.canva.site/chimpchase", "developer_terms_of_service_url": null, "publisher_name": "CHIMP CHASE STUDIOS", "support_website_url": null, "website_url": "https://giraffe-b6xdh7.my.c
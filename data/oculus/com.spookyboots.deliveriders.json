ed hoverboard.\n\n \u2022 Take on the role of a futuristic food delivery rider.\n \u2022 Meet unique characters and take on challenging missions\n \u2022 Master your hoverboard skills with fun intuitive controls\n \u2022 Customize your board with impressive upgrades\n\nHop on your Magboard and join us in Deliveriders!", "short_description": "Hoverboarding food delivery action!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSkpD8jRGkTuZr26qZBXj0x5ElANOu5WgYlCK8PnpDr159d6AB9qFPCJ05znM4DuyKFAIYqXGmWX7-x/pub", "developer_terms_of_service_url": null, "publisher_name": "Spooky Boots", "support_website_url": null, "website_url": "https://www.spookyboots.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7269020153221932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982585_273076812073658_5369173950703873626_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYuhR8toMMMQ7kNvwEZgaUv&_nc_oc=AdkzQVwgnReFk_1b1dXahwsYSZda1z2AVJFpI01qxH8msNGLRnqs8KZEnrPQIp79yAk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_6gJL_cutQuUCR7p8nenC2X7aBSm6ANISXeWbft-PJQ&oe=69AAB79D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deliveriders", "platform": "ANDROID_6DOF", "context_category": {"context_category"
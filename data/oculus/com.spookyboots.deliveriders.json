iE4jrEJt2wTXviGx4J1xdmdw&oe=69A4333F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DeliveridersCoverImageLandscape.png", "id": "944051900002993", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_944051903336326_4502587919904884482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hSOXYGaVUkQ7kNvwF_FjqB&_nc_oc=Adk6_oXp6Jb7REdvWADt4jodwT5nJZh4ojUsJOJ5UhUXilFqDOKsLnz3sAaCcBoSu_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsFo_E04j3xHP_4KcuRRZ-pkrABUoUfN5hugMr65MF-Yg&oe=69A43A53"}, "display_name": "Deliveriders", "keywords": [], "long_description": "Get your first taste of the future of food delivery in the Deliveriders Demo, a captivating new game where you navigate the bustling streets of NeoSoba City on a high-speed hoverboard.\n\n \u2022 Take on the role of a futuristic food delivery rider.\n \u2022 Meet unique characters and take on challenging missions\n \u2022 Master your hoverboard skills with fun intuitive controls\n \u2022 Customize your board with impressive upgrades\n\nThis demo is just the appetizer. In the full version, you'll unlock more upgrades, meet more characters, and help your delivery company outshine all others! More levels, challenges, and a fun, engaging story await!\n\nHop on your Magboard and join us in the Deliveriders Demo. Full game coming soon!", "short_description": "Hoverboarding food delivery action!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSkpD8jRGkTuZr26qZBXj0x5ElANOu5WgYlCK8PnpDr159d6AB9qFPCJ05znM4DuyKFAIYqXGmWX7-x/pub", "developer_terms_of_service_url": null, "publisher_name": "Spooky Boots", "support_website_url": null, "website_url": "https://www.spookyboots.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
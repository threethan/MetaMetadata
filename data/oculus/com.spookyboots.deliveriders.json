18_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2SW4H4IlwwQ7kNvwEbFlqS&_nc_oc=AdnyZNkNN7b4PFQppKpXnbBpvhgJcHNP7bp8BI22F1d9w9b0b7UX0AzXZp3Rol1Hz_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnX_u7U2QN_4zX0Ic8W3c6FrnTUIBeeUPY8TAvz0Aauw&oe=69B2B3BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DeliveridersCoverImageLandscape.png", "id": "944051900002993", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_944051903336326_4502587919904884482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KziP4chqbAQ7kNvwExWHJw&_nc_oc=AdnfhVMJ20KOU-7d3bF0z1HO7lPLRe8_46Sn2FGM4IyI3iW_1AX5Z_KKGW74CWwqXrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGO1syel3OzhldlMz1I5FqzS3LGEB_XZwSRFeTSNwJ-A&oe=69B2BAD3"}, "display_name": "Deliveriders", "keywords": [], "long_description": "Get your first taste of the future of food delivery in the Deliveriders Demo, a captivating new game where you navigate the bustling streets of NeoSoba City on a high-speed hoverboard.\n\n \u2022 Take on the role of a futuristic food delivery rider.\n \u2022 Meet unique characters and take on challenging missions\n \u2022 Master your hoverboard skills with fun intuitive controls\n \u2022 Customize your board with impressive upgrades\n\nThis demo is just the appetizer. In the full version, you'll unlock more upgrades, meet more characters, and help your delivery company outshine all others! More levels, challenges, and a fun, engaging story await!\n\nHop on your Magboard and join us in the Deliveriders Demo. Full game coming soon!", "short_description": "Hoverboarding food delivery action!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSkpD8jRGkTuZr26qZBXj0x5ElANOu5WgYlCK8PnpDr159d6AB9qFPCJ05znM4DuyKFAIYqXGmWX7-x/pub", "developer_terms_of_service_url": null, "publisher_name": "Spooky Boots", "support_website_url": null, "website_url": "https://www.spookyboots.co.uk/", "categor
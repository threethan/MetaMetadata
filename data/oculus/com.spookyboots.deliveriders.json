oard skills with fun intuitive controls\n \u2022 Customize your board with impressive upgrades\n\nThis demo is just the appetizer. In the full version, you'll unlock more upgrades, meet more characters, and help your delivery company outshine all others! More levels, challenges, and a fun, engaging story await!\n\nHop on your Magboard and join us in the Deliveriders Demo. Full game coming soon!", "short_description": "Hoverboarding food delivery action!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSkpD8jRGkTuZr26qZBXj0x5ElANOu5WgYlCK8PnpDr159d6AB9qFPCJ05znM4DuyKFAIYqXGmWX7-x/pub", "developer_terms_of_service_url": null, "publisher_name": "Spooky Boots", "support_website_url": null, "website_url": "https://www.spookyboots.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "661016568846155"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "137066852746472"}]}, "baseline_offer": {"id": "137066852746472"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689698091, "status": "PUBLISHED", "id": "137066852746472"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7268640529926561", "version": "1.0"}, "id": "1032940234754720", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binari
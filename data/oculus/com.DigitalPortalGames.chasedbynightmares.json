2057758049462090500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhCBB4qxvtUQ7kNvwE2n9U4&_nc_oc=AdppBvcXT5UsFi0BSLuzT8mO2lClUVpYc3X_p_mo__ZCCQ3Ny5B7NOA1moPrBQexCys&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MbIXSGES5yBxdXndk6fKPsvDMDBvkOV7qTZMb6Rp2Pw&oe=6A22CEEE"}, {"file_name": "cbn screenshot 6.png", "id": "665573602703231", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392000_665573606036564_2550641154369139111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCEeh_OT13kQ7kNvwEhoM-a&_nc_oc=Ado9aMn9yTaL-4jl-Jkaa_LtbghaGI0TJa_rEnBUkVFbg-BSNNlcBPNAZ9je7wGQCYQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w6i0ODkOAti08q5sGRZDxyOjmN-jHLetaYcjfi3dvbQ&oe=6A22E7DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CBN landscape ed.png", "id": "1291732752127348", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392000_1291732755460681_1331537097489260761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RAXlt7l32cQ7kNvwGLlCAX&_nc_oc=Adr3JiIlHffq2fItsQYfuqBbx2CBG1NkTDmWW4dIJWWyCTkFeRnstRRFhUbx05LQU3o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZZ2u38cc5zYvcMVK8P8tB6Qe0s48RqkioeO_tQ0rFAg&oe=6A22D280"}, "display_name": "CHASED BY NIGHTMARES", "keywords": ["Horror", "Adventure", "Run", "HandTracking", "Movement"], "long_description": "WARNING: Intense running in place required.   \n\nLose the controllers and immerse yourself in this Adventure/Runner.   Similar to legendary mobile runners of the past except this time it's VR and you're doing the running.\n\nYou slowly open your eyes to realize you're no longer sitting in a school auditorium.   Are you awake?  Is it a dream?   Alone in the darkness, or are you?\nThe only light coming from a mysterious amulet around your neck.  And there's that creepy castle far in the distance that you somehow know you need to get to.   A long path lies ahead.  Run.  And don't look back no matter what you hear behind you. \n\n-Unique running mechanic \n-Hand tracking\n-Branching paths\n-Challenging bosses \n", "short_description": "Wearing the amulet of light, our hero races to the castle, knowing full well of all the creatures prowling the night.   You are the controller as you run through 16 eerie stages avoiding traps and terror along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chasedbynightmares.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games", "support_website_url": null, "website_url": "https://chasedbynightmares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9242672132485916"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1316068570377767"}, {"status": "PUBLISHED", "id": "1357183489771075"}, {"status": "PUBLISHED", "id": "1767712053727591"}, {"status": "PUBLISHED", "id": "549516904471674"}, {"status": "PUBLISHED", "id": "919444016752532"}, {"status": "PUBLISHED", "id": "2437813849911653"}]}, "baseline_offer": {"id": "2437813849911653"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1316068570377767"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9297533166999812", "version": "OVRTransit
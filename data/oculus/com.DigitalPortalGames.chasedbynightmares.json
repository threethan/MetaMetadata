ent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUSuIpUV5ixIzUH6j0Py3WxkOOHBS-onZV_f0hmJwhiA&oe=6AE8B16F"}, {"file_name": "cbn screenshot 7.png", "id": "622582140763779", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393644_622582144097112_2057758049462090500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlHoCFxICEYQ7kNvwFJKw75&_nc_oc=AdqsjrQ_5I-eHiDNPSltPHp1fCAXRF8-xlH4YyoSpnn0VWe6eU_f-_EDDOVVaCYCurM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-rw-GWjEP5mEMHR0kF9Kax_IUb1fvz-FnR4t_kaZFYA&oe=6AE88FEE"}, {"file_name": "cbn screenshot 6.png", "id": "665573602703231", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_665573606036564_2550641154369139111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FP0tvxEm2AQ7kNvwFMayUM&_nc_oc=AdpG8EUqdC5oI7YBJ2clfHaRrRN9SkpXoERKWYE9X2q325ghnr2UDSiCdKRoYjnC9S4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhL5Ej1z_3QmAGaarllgrkqoQrjBDLlEQlhUpy12AGdw&oe=6AE8A8DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CBN landscape ed.png", "id": "1291732752127348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392000_1291732755460681_1331537097489260761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f_uRZ1Zt-kQ7kNvwEgBuw8&_nc_oc=AdqLm0cFiVYsKtreynJH6Rut7nt96XIEMbzUk6ljXix8oqRvynK2U0OixjcXck_wdyw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAGY33JzZxjDMLqqDLMeYJKG9hi6k7N72C6eXtPlPWMA&oe=6AE89380"}, "display_name": "CHASED BY NIGHTMARES", "keywords": ["Horror", "Adventure", "Run", "HandTracking", "Movement"], "long_description": "WARNING: Intense running in place required.   \n\nLose the controllers and immerse yourself in this Adventure/Runner.   Similar to legendary mobile runners of the past except this time it's VR and you're doing the running.\n\nYou slowly open your eyes to realize you're no longer sitting in a school auditorium.   Are you awake?  Is it a dream?   Alone in the darkness, or are you?\nThe only light coming from a mysterious amulet around your neck.  And there's that creepy castle far in the distance that you somehow know you need to get to.   A long path lies ahead.  Run.  And don't look back no matter what you hear behind you. \n\n-Unique running mechanic \n-Hand tracking\n-Branching paths\n-Challenging bosses \n", "short_description": "Wearing the amulet of light, our hero races to the castle, knowing full well of all the creatures prowling the night.   You are the controller as you run through 16 eerie stages avoiding traps and terror along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/private-policy-cbn", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.com/chased-by-nightmares", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25543724341954103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391913_1352124479110388_7862721370306700601_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P55IcCX0qt8Q7kNvwH0xA7U&_nc_oc=Adp6n4D970eNf-K5b2byCfMhFNU6_9WbscBjySLEc549US03qQrPQHk2w5sqgNEi9Ks&_nc_zt=3&_n
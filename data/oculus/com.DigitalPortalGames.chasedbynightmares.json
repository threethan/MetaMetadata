ent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu6hWDNikOZr4oeMQynzIZEtpfY23Zv-6ojyJsntnh7g&oe=6A74752F"}, {"file_name": "cbn screenshot 7.png", "id": "622582140763779", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393644_622582144097112_2057758049462090500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm7RXblB2CEQ7kNvwG46TGl&_nc_oc=AdrZ6XPd4Zup6pf5TcBW3s4MjYaqAXmXw0_4TLUjPbN4v3M-v8OwPsmYFIbv94tbcJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6K9sY0wEEl2MP_PWEZF-U-caCYO3AwuFtN4NPHgNUIw&oe=6A748BEE"}, {"file_name": "cbn screenshot 6.png", "id": "665573602703231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_665573606036564_2550641154369139111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBLk_VXZOEkQ7kNvwH8IMcf&_nc_oc=Adp6W4jkYOQdXqJft12XLWjGhs2gLQGJPS0qamkKScxb5-xylwpfYS2AqAfajslbGmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgtrpYQRkQjVTeL_M8ZJNSroHsx3JMbd6zi6PKGoIljw&oe=6A74A4DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CBN landscape ed.png", "id": "1291732752127348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_1291732755460681_1331537097489260761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSVxvDOv1bwQ7kNvwEZcy0c&_nc_oc=AdqTn2aOJxEuZUNCoxUGW0x0lK5Q150fXPk9QCU8TIYtR8KC-yiolWkmwWMVuYgrpQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEQY82qpLoFVE6AV2A0_IlscPrF7JYVrCG3JK6g9FuGA&oe=6A748F80"}, "display_name": "CHASED BY NIGHTMARES", "keywords": ["Horror", "Adventure", "Run", "HandTracking", "Movement"], "long_description": "WARNING: Intense running in place required.   \n\nLose the controllers and immerse yourself in this Adventure/Runner.   Similar to legendary mobile runners of the past except this time it's VR and you're doing the running.\n\nYou slowly open your eyes to realize you're no longer sitting in a school auditorium.   Are you awake?  Is it a dream?   Alone in the darkness, or are you?\nThe only light coming from a mysterious amulet around your neck.  And there's that creepy castle far in the distance that you somehow know you need to get to.   A long path lies ahead.  Run.  And don't look back no matter what you hear behind you. \n\n-Unique running mechanic \n-Hand tracking\n-Branching paths\n-Challenging bosses \n", "short_description": "Wearing the amulet of light, our hero races to the castle, knowing full well of all the creatures prowling the night.   You are the controller as you run through 16 eerie stages avoiding traps and terror along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/private-policy-cbn", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.com/chased-by-nightmares", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25543724341954103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391913_1352124479110388_7862721370306700601_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy497PP2MaQQ7kNvwE-gBJG&_nc_oc=Adp2w2rDaPiJJiHqW7PTo4vItbuFcsuJWraEnHSAaRQ9MiXUSHlHz91EIGotXSv6RUk&_nc_zt=3&_n
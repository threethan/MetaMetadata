ent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8WYuJRhQ3P06PoUBVYQ0fNGGKceqvAORvChXLKsaIlA&oe=6A58C5AF"}, {"file_name": "cbn screenshot 7.png", "id": "622582140763779", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393644_622582144097112_2057758049462090500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QBsxSgQ9KkQ7kNvwHAQEGf&_nc_oc=Adp29pYZkH0zHmLhTPtl4AdNy6UuTlMRu3YUZqNbJTltq8ELj9YnTNWrbw90kT5Gwd0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJh2c0Vst2_K3GGq5DPPsGApa_C74MbbO8u8GGGlICJQ&oe=6A58DC6E"}, {"file_name": "cbn screenshot 6.png", "id": "665573602703231", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392000_665573606036564_2550641154369139111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sIZslDOjt8Q7kNvwEYedbq&_nc_oc=AdoeXrmE6NlcG5Pw4vKR25Vh5IGthlK9ZQ4C2MeRU37AUhLeCwPrCcI_UHHeqmuVKkc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe2jxRKoEuHyBolPgNvD2Lcsj6L5kc1sZ2LlxVS0SiFQ&oe=6A58F55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CBN landscape ed.png", "id": "1291732752127348", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392000_1291732755460681_1331537097489260761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKRCli4rEloQ7kNvwGNxVjZ&_nc_oc=AdrtKxK6LO47KvjNGSKgexe7OcmMWgTvSiU5Fb95vEmTBcShMJSgF_i_a5mDc5_0n8s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYKo8Bo9nWCuXshgT-T3IU31hyCD1G1QEKdVVL1UyzJA&oe=6A58E000"}, "display_name": "CHASED BY NIGHTMARES", "keywords": ["Horror", "Adventure", "Run", "HandTracking", "Movement"], "long_description": "WARNING: Intense running in place required.   \n\nLose the controllers and immerse yourself in this Adventure/Runner.   Similar to legendary mobile runners of the past except this time it's VR and you're doing the running.\n\nYou slowly open your eyes to realize you're no longer sitting in a school auditorium.   Are you awake?  Is it a dream?   Alone in the darkness, or are you?\nThe only light coming from a mysterious amulet around your neck.  And there's that creepy castle far in the distance that you somehow know you need to get to.   A long path lies ahead.  Run.  And don't look back no matter what you hear behind you. \n\n-Unique running mechanic \n-Hand tracking\n-Branching paths\n-Challenging bosses \n", "short_description": "Wearing the amulet of light, our hero races to the castle, knowing full well of all the creatures prowling the night.   You are the controller as you run through 16 eerie stages avoiding traps and terror along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/private-policy-cbn", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.com/chased-by-nightmares", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25543724341954103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391913_1352124479110388_7862721370306700601_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pdc6uDcSpoQ7kNvwHVZqhb&_nc_oc=AdoNdbhgJOiiwdxesSZhxN5RtACo2aUnWmHsaB3ewdAuYVwqWbVOF8cgQQeBC2iI390&_nc_zt=3&_n
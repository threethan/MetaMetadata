ent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af072piouQOtaKnbXjzH6g0biKaPfEBmuu40nv9U945Kfw&oe=69F3422F"}, {"file_name": "cbn screenshot 7.png", "id": "622582140763779", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393644_622582144097112_2057758049462090500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4NdkoSnViIQ7kNvwG5OWhs&_nc_oc=Adra9FqGV_-axcBf3ZnoLTCH1YHrZ3IU1NmJ7716mkOVwbzFrZF-sAEEaNmj8q63QOI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dOae-dhtvYr_KKLeUU48pUmXyIgi4YutL9Up64Keh7w&oe=69F358EE"}, {"file_name": "cbn screenshot 6.png", "id": "665573602703231", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392000_665573606036564_2550641154369139111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2frzURDKZ4Q7kNvwFyMQ80&_nc_oc=Adq9IUbEgzaddUMtGjWP32E9_P1wMiUv9zQClzPETSABdsFYo7II2QSDDDkuAB1VGO0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mWWZ2WoFO1Cyp7vrhOL-ItrEOUn4Eidh8HZh1yE-pAg&oe=69F371DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CBN landscape ed.png", "id": "1291732752127348", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392000_1291732755460681_1331537097489260761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag-RgVv7EZUQ7kNvwHS0sif&_nc_oc=Adpw6KuGmDTxAeDcQ9YKosVoB5PKL2n-o18Rt-pcluYhYtFm1B0JAYeqsVbRMEFIqNQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28UXOG9tc_hm4YrAd2hk_UazoVLJFH2LHYZGyk0jQ77g&oe=69F35C80"}, "display_name": "CHASED BY NIGHTMARES", "keywords": ["Horror", "Adventure", "Run", "HandTracking", "Movement"], "long_description": "WARNING: Intense running in place required.   \n\nLose the controllers and immerse yourself in this Adventure/Runner.   Similar to legendary mobile runners of the past except this time it's VR and you're doing the running.\n\nYou slowly open your eyes to realize you're no longer sitting in a school auditorium.   Are you awake?  Is it a dream?   Alone in the darkness, or are you?\nThe only light coming from a mysterious amulet around your neck.  And there's that creepy castle far in the distance that you somehow know you need to get to.   A long path lies ahead.  Run.  And don't look back no matter what you hear behind you. \n\n-Unique running mechanic \n-Hand tracking\n-Branching paths\n-Challenging bosses \n", "short_description": "Wearing the amulet of light, our hero races to the castle, knowing full well of all the creatures prowling the night.   You are the controller as you run through 16 eerie stages avoiding traps and terror along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalportalgames.godaddysites.com/private-policy-cbn", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games", "support_website_url": null, "website_url": "https://digitalportalgames.godaddysites.com/chased-by-nightmares", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25543724341954103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391913_1352124479110388_7862721370306700601_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IctUD2n1omQQ7kNvwGxMVx1&_nc_oc=AdrujyAdSD9kFcUe2dy5F8Ie7q1BW2KZ3b6XORPQh4sUI8ISBRh8MGJfAgOtwFtdjTA&_nc_zt=3&_n
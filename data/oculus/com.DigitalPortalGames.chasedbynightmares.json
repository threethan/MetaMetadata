2057758049462090500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvkQ9mDKAwoQ7kNvwFauzwu&_nc_oc=AdqTYgLAK_VqC-P9AhdcajQ9NZvp8KQgGzVN-15NBUE77YKEFj5PtavbxvlVrWRZmpI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wYJO5gTs2VPpQEb5PAUnM3BZqSgmAqnvBlJ9sAhXqLA&oe=6A46676E"}, {"file_name": "cbn screenshot 6.png", "id": "665573602703231", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392000_665573606036564_2550641154369139111_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-Bn3rsMbusQ7kNvwHlAIPe&_nc_oc=Adod4pVuguTFUZD8OWDlKjwaabofupiM8lTSmZU1nPWcolcd-4WQ9KtOeBubXToWU6o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JYlEhNpqCTj8V3L0lXHQjw8WVqy7TdSvYEedDgHDrRQ&oe=6A46805F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CBN landscape ed.png", "id": "1291732752127348", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392000_1291732755460681_1331537097489260761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sITm-cpNGAQ7kNvwF1hOz1&_nc_oc=Adq2FL8uLHpuX9Gb_mdz6JmwbmMq03bKSJJWTwo1aXgALYnwbmqRhnAbf3L8yhwzPf0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PR6bCB2Mioqie-nMY8VNuWe_UCBQ6CeT_YkZj0IcOlQ&oe=6A466B00"}, "display_name": "CHASED BY NIGHTMARES", "keywords": ["Horror", "Adventure", "Run", "HandTracking", "Movement"], "long_description": "WARNING: Intense running in place required.   \n\nLose the controllers and immerse yourself in this Adventure/Runner.   Similar to legendary mobile runners of the past except this time it's VR and you're doing the running.\n\nYou slowly open your eyes to realize you're no longer sitting in a school auditorium.   Are you awake?  Is it a dream?   Alone in the darkness, or are you?\nThe only light coming from a mysterious amulet around your neck.  And there's that creepy castle far in the distance that you somehow know you need to get to.   A long path lies ahead.  Run.  And don't look back no matter what you hear behind you. \n\n-Unique running mechanic \n-Hand tracking\n-Branching paths\n-Challenging bosses \n", "short_description": "Wearing the amulet of light, our hero races to the castle, knowing full well of all the creatures prowling the night.   You are the controller as you run through 16 eerie stages avoiding traps and terror along the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chasedbynightmares.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Portal Games", "support_website_url": null, "website_url": "https://chasedbynightmares.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9242672132485916"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1316068570377767"}, {"status": "PUBLISHED", "id": "1357183489771075"}, {"status": "PUBLISHED", "id": "1767712053727591"}, {"status": "PUBLISHED", "id": "549516904471674"}, {"status": "PUBLISHED", "id": "919444016752532"}, {"status": "PUBLISHED", "id": "2437813849911653"}]}, "baseline_offer": {"id": "2437813849911653"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1316068570377767"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9297533166999812", "version": "OVRTransit
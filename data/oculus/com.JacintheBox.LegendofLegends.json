56_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATR-HdTiCbUQ7kNvwFrLcqh&_nc_oc=AdkSZjJ0uakcY92lfb3It359ewnn8lzj6I7lDN9bAI1qfz9-qapuULfZosy4UDgsLoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfydM25DKUw2LpzIEQeEJn2NbpWV8-K7vvxns-oaL8Hi7A&oe=69AD5913"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXSA08DNivMQ7kNvwEiSeEt&_nc_oc=Admm_Y8HyxYp-rp5lryMbhs8KVjzUJG_cbbVErvpA3rGnoWERU_gwUNXtWDiofUHbIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5y6vOt-j9bcL2sJhcIdiiUfxGrxCWm8GxZiqLLvaD4w&oe=69AD5747"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Soq-Zyfq8AQ7kNvwGLmwJh&_nc_oc=AdksHxw6yoGhhjob9_Lk7mBK6lK0ZJKc5JsZqSj1b1i4dYPIcWBTzutJWcqzZP-HOhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-OlReLGrdPTczl9Wflyk0lTs4Zb_kzP0pQ480G_R8-w&oe=69AD5F70"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HytcYVWmqHgQ7kNvwE41nGK&_nc_oc=AdlH3g3-nh79JznBlzM4rkdwcdVlUCOv5sFaMjmirq7lNzxPHV-W0qQdwo6abVnlOy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1OkhPu9S8Y2D6_t7_HGsH06_y1olpkaS99xoKGztnOw&oe=69AD6B45"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyMj0Ycy5ZkQ7kNvwGgiKW7&_nc_oc=AdlU9BiLBY9qxhmPyiiEQMw_WVTGF-pZr95NNAzOVTPVAbGnhw-amjDDCAcYD52G6cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd9bn-Pzsqe8ZS85KBqYdgBdXZstCTv9tAHYNhfeFETg&oe=69AD7137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": 
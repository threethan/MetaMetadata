AZ1cH-cgVSucBDAwa26tGsMC2FHTVBe746qg-Hwos8TdWBPw-v0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfstHjQ_NdunVFKgh4by93ydybcY_c4QqZx5_Qkqs2efiA&oe=699ED893"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moCzqIIat4UQ7kNvwG8Fay4&_nc_oc=AdllOnwXyXFp4sd8TMSMVTIuNN5FsqN81e8ehBq0VVS9GiD6VWatIpLVIcRG-rZKbII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afthp03Ky_alPU7YO1fh-g00SnXlwUZhc_HAo72au62UvA&oe=699ED6C7"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xrtprl3STSEQ7kNvwFZhJE0&_nc_oc=Adkb-QRnNEsRSnhyRhB_MVvA02fQtaPeDj0cAWKyzyRyIZts6Bx6zR7ScdWQYI2u05I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-wjfFyb1cf1SxHlkZoEss-9BXXFLvseHkXYydRAs9cg&oe=699EDEF0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WABHTtIFoeIQ7kNvwFElQ9l&_nc_oc=AdnFde4KQ-HRXbedAF3wGF9SU0XTHihDJYw_p4SZ1HRccTt2wxiAtQ6HuVdvNu5eu3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftR0tuZSRwEbQSfZQPeC43HLc_ejPh97UJjCg_o_5x4Lg&oe=699EEAC5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43G-SgSEg1QQ7kNvwHROlZ_&_nc_oc=Adlz4CkVUysmF2Of3cI5Kv4l6IRtUyPLC5ce6y_NdKwvjOBtYZDgzzsGqQFseZNnINU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsj1qL0oDB3ve5Iq8o6F6HX4KXfBIwSLwplWPL4JXuWTQ&oe=699EF0B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nu
5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piF6j73JcP8Q7kNvwFZUk9W&_nc_oc=AdrymAeDSYDnMDfP4FvluaXJpv-V_AUJoKd4d7sgz9ET1WBhOWluGuGYAiB8Iy6azWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xx_MgGJ5O0Nm4D-nvO1VCiFRYB5aesftunvR1XWd0bw&oe=69E8AC93"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqLyue4Dc2EQ7kNvwFZHreg&_nc_oc=Adq-nkxeLaNibSibwyP2kBG-TFIqeNxYUCfjExVEFNBRIaVOJOxAFm-em0epf8ui7ZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-Xn-F0oOeLSXzjfn42g5mKZi8awBEdV-PlpU_mAAgMQ&oe=69E8AAC7"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aOVgf_XvxcQ7kNvwEI9wee&_nc_oc=AdoKSvQs3GV7yoTtAWXEDdwEeYl01k_5DnA2DPoIszjf4bfp5mhP9xlAdjrAuINUIhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26eWefYUfNDvLOhXBXIVFYOGtorJD7YgpJxflK7wY46w&oe=69E8B2F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21o3in3wn4IQ7kNvwH5Lllf&_nc_oc=Ado0IzSFA8vJlqIgCmOxRlblI_2FVm4bmlgUH_QrRTn2IqZYfO63qp0R8pjIRUMbfJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zKVTQIP00eg71uwRMKXBa8eDHo90Iowm6y_lwlISY3w&oe=69E8BEC5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZRrc7KiIZEQ7kNvwENHb5Y&_nc_oc=AdpDZ01_gKiDcpVAPp1EgK3nNNQniKkMuKR1N63_KgfSR-G0sNpmvAxrHVdX17QkgD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39aNuahd6C-XfMBxwX5oWPSL8T9EhBoBQLbU4Q00N8JA&oe=69E8C4B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jLT-Pm8_TkQ7kNvwEg_Hod&_nc_oc=AdpnXguv362eCJwXPYHE_vDJmmJQuAg_pOH36u95EL4MsAQJSsKugCCZmKHH5RB7fzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxjYkLr7Mxs1dVdArlGAJR3djK5xsEhI37LJWh2BRb-g&oe=6AE4B353"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWHmqsnXfhcQ7kNvwEM7vAT&_nc_oc=AdqXgyTsqCWRrblodBj8c6VzsUQGJNDpLahXVn2CEZpXcsFEpft3FsmPdwMdYuQrquc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlJaZXx09J9HUG2Ww-7_YqnWCpqaVRWyM_v_xHt_7WuA&oe=6AE4B187"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj0TMa3Z26kQ7kNvwGNM1PP&_nc_oc=AdoCmcnk6_Cd5TLcZkty2u1TDBHEyGhq916Z9klHpFILgM2-yGH468V7Mm3b_r8D4LE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrONkLJ7mbxHH27SbvdX7EigmnA5Ber6dfKqiDyhq8SA&oe=6AE4B9B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAE_JlR13BQQ7kNvwGEYkiJ&_nc_oc=Adq-xhXcem-4CjYootTPPfqQGfar_BKwBLBGlyVi6Bm1FQOmt6Xoqfjrcmf5IqQy6AU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMojQ_gl9m-zuPdPrR53sKSIqLdEG0-00orp7zZXTYNnQ&oe=6AE48D45"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NU1AfgspUUQ7kNvwHcVGA_&_nc_oc=Adq4uc6L5cH7jIqtfWouWI1IjddM5h0FhYa0WN3KXTLCOoz6DKb5jEBT8tjnBk12GQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHZ4j0G3_oSvz7vqlsob5MojwlhbvqYqC56FHsRw2gnQ&oe=6AE49337"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
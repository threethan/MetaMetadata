5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVBfpH6MlLIQ7kNvwHYVyrX&_nc_oc=Adruw-8bj2vIQHv1bIvsrBZBDqzAjwCSkMCqTLPjKiWR_CajjVKTBR3YQoxJIj2uzZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3opV9lpLvFJ5d1ZjTEcikcRwj6YdbsW0zXCoiXDhk-pw&oe=69DCCF13"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yta36ujFBOAQ7kNvwH4IIWG&_nc_oc=AdpQaOKjzpZrgp8_4H3ZZn8umEzRG2Uw7HkqxHX5TK0dYu1J6uQ-uarwxWOOEap55zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EGbf9o8LLrC0BV7uL6_Etqfu0V_bn01mdeOM88HEVkg&oe=69DCCD47"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reDsxyhKbEsQ7kNvwFsy2Z1&_nc_oc=Adq0BKc_D1H_aaqiBrFAZ7Od7Jt0aRMk713M909RHQyJeBhFjUta-98Fxfjfst7QGiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MavYB_-UyNbr7ZW_jKKxux7aeETDe3m9dbZ26zXHERg&oe=69DCD570"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQcCI44ae7AQ7kNvwELs0dm&_nc_oc=AdqcsbQNIbc8egNarxz8QisguDmDy6__vR4EH_VO0c9pJ6YQHBHa7fOkaWpNofu5J18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aqro9MjH71k8fhgY7s6IDsIPUV3DSK11RuPZdp-Un4w&oe=69DCE145"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lur5XknpnX8Q7kNvwHDTSKg&_nc_oc=AdoQDlFwcV-1ZCzntJiIOMzAhrCX4-EezRqR_OHidqOevhdpCovPCShSt3eo5jOxRe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DMKPTTzbaUsc0S6GeTGA-N7CV_twifBVVv2gVYgX65w&oe=69DCE737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
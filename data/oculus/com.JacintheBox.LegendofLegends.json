5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVBfpH6MlLIQ7kNvwExOJEb&_nc_oc=AdoZdBaN3ixhYQXSKLIwmhsCv5Fq_3nFhUmRRZofGYBr9WXSWnnhECNuJEoUVP3aYVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01bEIQFm3hPHSvBm7Kch26jDOoZTRtY8hK4P9JJ19orQ&oe=69DF7213"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qMUoW3xe90Q7kNvwGCURF5&_nc_oc=AdoYAn8MRXvyfYzq-v0c4oFVL9t4LzCN_k3AJOa46RNViYNvl7wivhKaEtjv1T1eTDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lQQ9rByg3ZEDl1IJSE40UMiC9IFSYC6UC6NG5WHNC4Q&oe=69DF7047"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPX_zsGYpN8Q7kNvwEU-UBc&_nc_oc=AdoP4CN8tNI5WakSyv7wivq3VmDycGGXeJ9tgIlsUNAeAsQLQZ32yei4gYKYHL0QU8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ofaji4uX186dl5e5uWH1rk4Y8plsSpW3PoLy-OvBhBg&oe=69DF7870"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQcCI44ae7AQ7kNvwEE0fJo&_nc_oc=Adrb3iIPu2cBDr2dZl0zAX3GmL_GSOcibr845npfHWE-RRj-VOcoWQE6_Zei8iY39_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Lf7k9IzJ5ofHavNOopRychje0GrwLSV1TX-Ek-4UprA&oe=69DF8445"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQzLWluCelwQ7kNvwHVZ0mX&_nc_oc=Adp7r5gN1vTLZL5oGst0-e9f5cAWs6NVIoLMyZusDEoRFgIbvL9sPSvuoeU-Sq---B8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eHylcUElaHE1qts7laSb9rUR30jcHeKNd0WCEDSsOeA&oe=69DF8A37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
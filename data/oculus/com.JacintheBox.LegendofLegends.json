5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbw6cQvK_mIQ7kNvwGf_-7G&_nc_oc=AdpRwb_6gX92ThTatBKIPmodZMqGCeFthhcy7u6IyB9TUTeEtr9kswYbP-5Zjlfed1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21hujItCDeTXq1AaciOo3ZTslsyyXsR9az2MR_UqQXVQ&oe=69D8DA93"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35uRmXgV0xcQ7kNvwFqdUxf&_nc_oc=AdoVaund6UGG1GTVjrLxWaT7FVQsKJkFzIISl4fCtvDtgpV5cgfzQEls9tf8AAOmVFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lN7jQX8A1Wcbki_511ddrxY7FuPsHn6EXkpPSwHBkZA&oe=69D8D8C7"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7-Ywi-Hlk4Q7kNvwGRI7NJ&_nc_oc=Adpepmrm7ecHAk_r2ZRJ1rYNfp91cHFfwyAP0_lm4e03Zda-q89vZQxu0NqtDMpfcao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-Zfft33JvCyx2jR1jqvbAjgkcnRWVyK8VIq4PDwfQsw&oe=69D8E0F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksPFLuloSqMQ7kNvwGzlz1R&_nc_oc=AdrqUE_XNrc3UkAk0Y3DmH8TEQwwsAvRF9LfjnM4yZr6R6nPkdOVFFVDOxTNd9zUx-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k-D6ENs59Wt4nxw6LwODcc7gUp3cbIxY3UYMLPpapZg&oe=69D8ECC5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pJ_nPR829IQ7kNvwGdQ4vc&_nc_oc=Adqnp6BzDJLFak6pYSrTIkr8yPT09X-O4kcsclr8Hzm9iJxX3rs3kPjbE8LVuTESY44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34q5kSLaPoAcd-tutO15OxJjw5SFKJV-rOQ5OQf1pgmA&oe=69D8F2B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
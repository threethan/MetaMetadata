5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAV_Com8PLUQ7kNvwFBCmgy&_nc_oc=Adq5ql5ZdFrPmJvYDAeamhuM5WXB26jRuyIiOF-6H38-IYnx43Gbe1GfpAnivLtDFII&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WPIZseBQQJwwoPMbqEpyuihAXwzm7aOIYl1znsRFUtw&oe=69F613D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTWWpqZhmOkQ7kNvwG6pm-q&_nc_oc=AdqTicnE69-bh2LXRRrXRVzkmNEaXXj-9nPLyg4lLbgYslV4blCfVR62kgv-RIJPAHE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BNal3jYTFsjImYmIzpYnuIsDRRD_-o8sg5Ncib13TwQ&oe=69F61207"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYkgkoXkvGIQ7kNvwFe-5nG&_nc_oc=Adp48VuCUWZRb9YD52lxJ4SQZe6BS72y4B-scdYK40MknHz9gNAk0DHSj5o7ovO_EpI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25QmwBlWMem_WTieXEzgXdR5nBya6FrPg_i7LW9eOFTg&oe=69F61A30"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGCl1j9jDmwQ7kNvwGROdDA&_nc_oc=AdrqbTbP_YM4dmeNH0jidZVcn8qp3f8_EH0jgZcrBqDZT8kgb6KXTxa9rpEvWEb1tNI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2elyb9Km2WQV52JGSj9sAncEEXOnwZFsNvSXV_pnr_Yw&oe=69F5EDC5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lPqobs2SM0Q7kNvwGWnBMz&_nc_oc=AdqVywwZpk7-e6oxW0Z4CXIRIe0hmbuM-vnOoWE9RwKghiFn92mU8kGWl6rAvYIh8cE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VrnGkES9nfh2GEfYV8xHPkRJ2TJtuNwZqFol7UvlXtQ&oe=69F5F3B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
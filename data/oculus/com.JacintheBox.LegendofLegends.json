/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhfQV8uOraoQ7kNvwFgDiCJ&_nc_oc=AdovtkhuBYxv3qS2pEpx7WNwk30g2KoT_XITwJn2rKzD2k8utgsVoXyW60_inanztWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTDy7DMPMY963C_9m1W99roelDPz3H_nDS3oAbFLIRZQ&oe=6ADE1BD3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nix3GateFdkQ7kNvwG8nEqO&_nc_oc=AdrmspOPgca63-SRLMJRFw0cFhUc3E6o0ELpDk3LxkCjY9t0NWqMa-s_gRYdpX_SFJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEA73-Vq6NIdnQYMu5VXagQLdBlMyI9llxfXWTUECEMA&oe=6ADE1A07"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX7tpUxusoIQ7kNvwEl0-te&_nc_oc=Adr4ESGV1O35shf0k-vEak9hYY4AOwNMvrhDap_2YIwWO3LjvY6CQlFv7hbE_-Xnatw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUwbKA0qhHdFR_Dzh0doY0BiR6sllgWGiSDSQ_r9_ENg&oe=6ADE2230"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dmscfx32eYQ7kNvwE-5iZT&_nc_oc=AdrhdfMTBOoreBSRoMnfLrurOD9NsH6lzDkx4KqdctnShZnymeHoSOQpB2WOFgP05MU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy5ruACGwsJteRxFpSQ8OKWCsJE4ZIh5Lj9vVOJjtKsw&oe=6ADDF5C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9j865z7g2AQ7kNvwFhh5Qi&_nc_oc=AdpwyJuy1X4uHR4cKxdvZNwq57z81ISDjsH01rS9u9Swcj98qbFAw3IK3K11BY147Gw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeV3RWnWa-mkpGXywyUYXazXecTTh6-3otuIH_v8PmKQ&oe=6ADDFBB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piF6j73JcP8Q7kNvwF2CWN2&_nc_oc=AdoO4UiIgX2TGEK9ryt8xih1a6i1O0Bqq1_8xBaClzf3n326ShSQv91wfd-SUQEpIbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QWgW5wrirPd60KJonJ99hAbtVRycaMC1d9Qig2oUJ6w&oe=69EB87D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCre9Xu_0-4Q7kNvwHs7WkY&_nc_oc=Adqn6kx0uEFt58Oy27HKJ46eav09unAqsLKSvJa52G3B2uKDb3y4gvAb8TjNiwInoAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r03N6ViabMhJyeVRWYzQOPQRG2xsN1xCDt7fwGggYGw&oe=69EB8607"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZn9TTh-o_AQ7kNvwG0IUpI&_nc_oc=AdoHlRlOs7Nq3HyFuk_TmcpJUrz_-oj-AIbyhjZZRXWmKNcRzZbyGpti90y35ko5Z8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JbkmoBYsem171Ndnh3jgzcnZE2YFtWwrVECaNMcqBSw&oe=69EB55F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21o3in3wn4IQ7kNvwEPvyN6&_nc_oc=AdqopgQVgZOjiUpLezsZLJHLJ-JI2ypnw6d1dKV_gzjkDUC8c6HZ9J3AbAToLagMQqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y8rBmeCr9Http38yNN3Axicc8RrXjq1inm6vkOv8Z6Q&oe=69EB61C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W83sHbArceUQ7kNvwFlUplY&_nc_oc=AdpZu1LErFjXCxPU9XI7gQtucMbGymdT8PoIa6RfpkNTT7078J79GmOFHykc1ZzLaLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af288N8yHhUQoKHdxcoFJGfffUopP--zVvbuQZacxZfRKg&oe=69EB67B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
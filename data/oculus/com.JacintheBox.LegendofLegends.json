/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRZfn3343X0Q7kNvwE9veJA&_nc_oc=AdpCrlhm7BPN_YbYUcctIwD1lyj2gkJ2aUauv7hiTFJSHdIZPH3DxVu2YCSHsLPL_K0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdL2JK79bqtLDlQaoaVa-pgtQZBignlxGWV7xDr8hX_g&oe=6AEB4AD3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j72TbAzsZFwQ7kNvwH_ZyWf&_nc_oc=AdrDf1BXkPB7mf37cUZa-5sP4QDCAWnt0kiDH2XSpVKok3jFdfnPvnjixdwSncxl2no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSomgVhoDHJKOVX-pH_4DYQI6nP9U2ygI5SgrolS1etwg&oe=6AEB4907"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdY38t-ZT-AQ7kNvwHOTjWn&_nc_oc=AdrNCFfrkMJtYVrcvuqehGlV1TlM4VYo3iXo7B79m_5JEFWZBeqssgurGQVOlJrSqkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzDyN5X5bjAlBSDoo0GxXTamzq8gP3sqol1obQXxp-5Q&oe=6AEB5130"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNDFYjOVmlAQ7kNvwERZXPi&_nc_oc=Adrh0mx8sh4oZAd0HgIGv0j7qnrGVX8dzStMJUj6ufQeWkci8QYMOuCuCUG-jB6L98o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStaAwfOi9vTjzQXKPML87Z1A-iXPiZ-tJ3c3xIGBtZvg&oe=6AEB5D05"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtQ5G5CCxQYQ7kNvwFJbjba&_nc_oc=AdquILvI2gPW-z8uZIEAbmetn1y94YVd8vUqKVcjWduL3jWaIRwjfber2dwqqRfV7rU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCYqPwm_sh81z2d-qnqfM52xvQE0x6pRVaVtVxXWb8eA&oe=6AEB62F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
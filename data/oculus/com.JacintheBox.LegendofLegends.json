/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbZbZD4D4wEQ7kNvwFVElVG&_nc_oc=AdrcCsTm8H7I71gwfGpLSB5-Vf1qtIymqB_KPUC-5vScHR6ZiqR9xKOxG-mVrobAEzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdgZwcixmlyDjp99or4etQ_OdVoge7SPE_KG5qxrdE_Q&oe=6AE75653"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-2SJwJnFG0Q7kNvwFYDxmm&_nc_oc=Adp-cyEwjbcPtJlhWqJPrAt7HUjJAM_wuEWeKkZ9U07fgleJOHCUxFgQ_qZq7YB03Pg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB5NsipgBkHNy2hhQetltCVvPemtHOMMLHtFSOduG3_w&oe=6AE75487"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj0TMa3Z26kQ7kNvwGfkVUU&_nc_oc=Adqq_v14Z1bpPcFrL4-6vengA3Y6g0CWZa0S7WWrwER_e2Uf1-dawy1v7c2lG-2ElM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzlUyeoyyoTzyR4MWNO1r5h8RwK4RbGE0KfFTISXDdAQ&oe=6AE75CB0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYuU_o2B_TUQ7kNvwHzJ_Xj&_nc_oc=AdoH2uWBP3FTiO8BxD3sgqb7DemVC_7t2_ruu1XCuxVm56cFJwKd5SVFW8Sr-R0oK4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7bmMr75UhchbhGt4cq8azVzgNZwC4VrZcmUL59pK1TA&oe=6AE76885"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NU1AfgspUUQ7kNvwEJ1Qj3&_nc_oc=AdorVbmEo5ilsmEsGd4PSe-hKqO427Sew6k3A0aNNHuP3YVh23_Obn6q7TXfX7AMdEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmuzJiAYtZ9C9oGFFDfE564ehfpVcNxaUAFY4PqPFfCA&oe=6AE76E77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jLT-Pm8_TkQ7kNvwG3_hAX&_nc_oc=Adoy1HNKEfYrAmdlz0Q7y0y1_B22DmKwJFTpk4PVwXHM07gMf7ctFGEqq1DIJ0cv1v8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHULNc6ekZnx-gojvws0obVUd5lVrgW9gIueqma0fzBA&oe=6AE21053"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEOWK9QOtlsQ7kNvwHJgzYh&_nc_oc=AdrV8TM_g8Vf0ZIC-kb_nsbccDPl8fW2uLWG2uam1GRQxtmYcw7pjYgyEv-YlYsrlPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhUgaecJGoYASQUkthtGTT3Wr3TrQxPZOeRDOMCuUyzw&oe=6AE20E87"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snQeTN6r6DUQ7kNvwG-9CVN&_nc_oc=AdokvBBBfYHKy-ccUcW5iCdc9IdEZRA0Py2hoZ3aQOYo7muEUyggVWsG9S7e8O_M0ao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq3DntPPjrZCBKKed1rWzLg85lW4Lh--Q_TSOE-Uwlvg&oe=6AE216B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAE_JlR13BQQ7kNvwGSTv3V&_nc_oc=Adqm9UMciSBTn1ED3kSHZvq8YY4G9fJrICYvhRNQEiLwRRTY_OQ9KrXlaLqBoPNtiCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzAOIq2g5KU98cmD_TzaCwVSlR_JBB8mtt2Vqy3bvBnA&oe=6AE1EA45"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5imuOxT2SwQ7kNvwEF9meV&_nc_oc=AdqWLlNarZlvC69FcPzeqUu12gnN6wHWnwGppuz_xJy2jtmo5x9C4JxvRGNMHK6J0r4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaLNS8GjkSFQBlGKhnW-fuCJQZ7W44enUHvkIHBSYK_w&oe=6AE1F037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
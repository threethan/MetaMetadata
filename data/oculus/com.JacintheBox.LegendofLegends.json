/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pllz7fyQXgQ7kNvwE7NGG-&_nc_oc=Adpn-VglJA5DhUzKfUMKajuaC9YT_vk_0rxNGUce7td6ofSvlIqe8GuF628Vnf69nXc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa8fd-fZx6nJtR8O5EW_RFVSvJG2qhliB9BASLgG7gwA&oe=6AF9CB53"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpEjXQ6nkSoQ7kNvwH8CbBp&_nc_oc=AdoqtUHGJVLjXprMLQzz9KxBaoBqWand-VlOdS9BS_JzBypORg0nLw5Q_FqEnsQvtvE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQQVpn6cOHNl7k7ATjxlOQNGm5G8j863FKwiRMBsk2Hw&oe=6AF9C987"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSLnQg5WEFoQ7kNvwGAXTf8&_nc_oc=AdoeWxcge6NYTPKg47a9aUgb6ZjcLS6foDNgKluXGOFBnx8qKYhQPFzhtx_XONRY_6c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIkMVVHKeI_112ouuLpCuTgQz2oto9P84RahYcwEGPaQ&oe=6AF9D1B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAVEEU4e40AQ7kNvwH3yj8W&_nc_oc=Adp4BnVKuvU959eAG_57BTOCt9Cf2501KbwIuSpvn9KfDUSsIl5cV5LiZgNZk9pHFJY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYqYIXOgbAoESlrnpNh3hV2rMLZWzubD2eFhiEoFcCGw&oe=6AF9DD85"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNh4IJQEdtYQ7kNvwHkPT0X&_nc_oc=AdptYEstl3x6SHI8MaqWqseTC_eZnSHh-5tMfse7bzfPjnrS9NKdz8hlxATctKeGTrc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTGFTjmoKlfBrYvvTH3Hya7akPlhSbB7qk4PsqarUSkg&oe=6AF9E377"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAHgvkMG4p0Q7kNvwGvDlPc&_nc_oc=Adqw6ZCWqH6ni3H8i45K8Vz1bif4I8Uo_0NDHh2ijoPVLAklakeey_ED6lRBZx0QqGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vrmi-5Q2IOW8VtRU_zPImgMEnyowz_f4k4Qrhtmic_w&oe=6A049453"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L35qH218ysUQ7kNvwGTF5IW&_nc_oc=AdqomhvJugxAhq8qsN5X7bGDwtma4J3bsN6ZhCRRVKm1XnAjgENm4-2FE5qFopNnZ0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oJmZsa4diZQA9vg0G4z9G9_xNKtFl8YaKa0zvzyP1gg&oe=6A049287"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWMbsI1fQOMQ7kNvwGmWtqo&_nc_oc=AdovKaP0evIat41WVBRJ_hhZy555NcJ2-MPeOQ4Bh6QMRLfHbdWCTo1czYtTZtEFq0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-l3cs9_iVYyYLBgt78FL8Oaw1Nv_HUP7MSgxpPeB9AA&oe=6A049AB0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHqjIUtPSV4Q7kNvwFhxAWX&_nc_oc=AdorJBS4f4wTDJzSPpyhuq4AhQ7R6aH7P16PxbMF0qwX5hhQa0q68WtgGA233ze7kkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PXoEtCQjbThV6PmO0TrpDrztoiya5Wp3warNvsfDzyg&oe=6A046E45"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98Cu_grC7FAQ7kNvwFD8G_a&_nc_oc=AdrCjtSoqS69UZE9NzGaC1Ip0WKxPJ9nV556Fw18md0AV2R8Sd3KiWY0C9EdGSxWjQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GEv2c-jFqBN4-Wg6ewwaKDXW2SBtEDt7JCTZCLdsT7A&oe=6A047437"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
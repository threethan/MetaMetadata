/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeAKZ9iLP2AQ7kNvwGI_bAd&_nc_oc=AdoD2c6M6ajs_0cC4uM2oKoGaLwyAK8xbCcBRi0RzKUUbFe_qmmyH98kL9fGf9OyfqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS3wb07HoZ5WlW7KuG4SBfm3Pyqz0F3RaiqnxhYnRkxw&oe=6AF48553"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZgJxS_3520Q7kNvwFD_OVO&_nc_oc=AdpptaUatc9Sry2LYV19gDlFboCe2J3pfSaMw5Daf8gXGTdRZDaKwIL0AlHxyiGo_xY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToP4yD-gu9cDC_9O6OFuAB4Z9yHDrqfe9c0MlZy3CsAw&oe=6AF48387"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbSmb_UHSdYQ7kNvwGWWeNe&_nc_oc=AdqUAc0pdMiW3rxnFQxwNe1y-otwQ8LZJMNkEyG1jH2siEpSJC6jmPRlL5q5PIDj_Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUZAetJJyZc4CrEpSmKcf0rHeBMJx9M2Rn4tFNMOQLbA&oe=6AF48BB0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKB7pPC7rcMQ7kNvwHFsrNs&_nc_oc=AdqYNpbenpV1_isTnQw6QV_Ot4kejyTSCanKXr2cLPT1hn0Lo8wyEBq-iyguNijfmhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqtACEpAkCvgUha9exEYgRVIJumisRl0FlyTq82pjpbg&oe=6AF49785"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMSVlQJPlzwQ7kNvwHJSsoz&_nc_oc=AdoR9rPki8yWJerPaTZC4aDjbvd82TAjbRAWORoe7VPwga-wlX6SBGTev185SX74JsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6CdMz7fApvgaxo_3X8wK0yurmEYXn_Gk8ZANc3NvRZA&oe=6AF49D77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
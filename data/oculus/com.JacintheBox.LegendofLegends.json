/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhfQV8uOraoQ7kNvwFDplgx&_nc_oc=Adpwq_Mw5yiled65KA3ULQRmfhQuEQvWA3iBvjom327mLSDl2wfdlZzmN96QnAQGOe8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR5DXfkOuho6TFOfNLVk-LdecGBNcfnuQiXp_nZwx2zA&oe=6AE0BED3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEOWK9QOtlsQ7kNvwHgYO-y&_nc_oc=AdpmgTH4Nyztnvjo49KokkjTxIzDisOILZIK7i5CeWWXyxxaNPpBmNMO6nU091ukd2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPrheYjQ2zIVZqrGsxAj8Gw2qw9br10w3xT25JRFZmjQ&oe=6AE0BD07"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snQeTN6r6DUQ7kNvwFBpLve&_nc_oc=Adopk1ZzsTeZuWpEyb9dpqf0f6A2DRgc4KuRCHuOY9IvLKz0nJ5WQTl-h9iIupkuvWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9YQ8jduH9fl4CuTFM9p7orSMlxqNgofUhhz44YwoWdw&oe=6AE0C530"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dmscfx32eYQ7kNvwGqt3K7&_nc_oc=Adq2T9lOW6gbSpI4drsHDZeUIYtdaTMB-kGH-Lr_zJD1rotJYTW89tPPMyJQqmv8fI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVolyv1l5BUTTuPuGfWWgtavVi1GrQtt3SQNk_pIb92A&oe=6AE098C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5imuOxT2SwQ7kNvwF6dja6&_nc_oc=Ado3YkSU9FeFj56A5uB0TQ0HvyhkkszxG_sZlWXn15RtO8MEw2QZ8RVCnW27TBtQizY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJJqvLNfMbTNRYbzuq_HEkHKAGtGkgYgIW6aSks0g5DQ&oe=6AE09EB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
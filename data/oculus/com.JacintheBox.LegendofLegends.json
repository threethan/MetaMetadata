5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE6UcseVxP4Q7kNvwFP0lIc&_nc_oc=Adqd0KSdU9k3LXbQaxaDbItCoXuvg5mUGQgyPWyBkvIGZ2pkzwuG5eiOji3XwSNQr3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lMcz1Y4b3oKateiTqti6l4npQ3WRhH3qXB1VnzQQZdA&oe=69ECA113"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCre9Xu_0-4Q7kNvwGsOC9_&_nc_oc=AdqYCtOCZ50x7HSrreMkb5S4YvTR_sr-ksmalJrDMZlbWyemdkh5I9oSYXO6dBHdYwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tFj5xEvbTe5N6aYz8Y_eGjmy8pE2jRldmPBXOymIg4Q&oe=69ECD787"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZn9TTh-o_AQ7kNvwEKJmMF&_nc_oc=Adpql392uC_lFUXzC-VqhUOQL6NhNfAYg2gI4tiJD3pyax7dIlOiQfzEeJ3AKpIVoXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J7dK-cZlcoATaQbXaiH2BQgusTL2GbtmUF9GR4KiA6A&oe=69ECA770"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcxPIzPy330Q7kNvwFLlBRT&_nc_oc=Adqot9tzpksqs5koZ-T9lhYxcEE6yOY1pHM4GXzwVvDk3-8hBdNatkzYV-2X78_t4dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wDS5Q_2mJSvC6-gYK8SI-oviMExGqk6n2a29WL-8VGw&oe=69ECB345"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W83sHbArceUQ7kNvwHm8Xim&_nc_oc=AdoM9D1JI9LCNGwnNE91ruyVqZNIyV7A2h25HkXLutvmuypqGdDqqISQ1TYBwo5GFbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uw_LQlYkGB5HVs4sBWiJ9SxM5aZY0CzMnOg4bioDnKA&oe=69ECB937"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
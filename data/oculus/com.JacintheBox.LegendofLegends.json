/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMqZwub3yFQQ7kNvwFgXgcj&_nc_oc=AdrTfpcvbdd-tuixbYJLXsRd9p9Tz16StLqGiUUbNuYK-vKNsyEhC2xJprXgm0vQgk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPisDxZzv7-Dl5G408Gbqqr77HKIB_Vn81_457NnY1cdg&oe=6AD23E53"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llmbpknjXBwQ7kNvwHEDGrG&_nc_oc=AdrpZeCAAks3kQeSfc0IFu8CeMeVyoJCQzixEGU-of8pSlZdZ1ZSuFoiDwvFDectVTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8uptY_Zeb3plLoRMrmnXq4T0DrR7eNfFuC77fhgiO-A&oe=6AD23C87"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_6QpUBwBXMQ7kNvwFIvuhJ&_nc_oc=AdrkImWbrQGsoEoSUzK3hQGwk15YtZUhDpJYUYpB4LTgzWXNSWI_ycM0mIuyVxeS1IU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOng7NMD6G60q0CFnomxXyy2I2FFhepRw-MLbyE3t3SJQ&oe=6AD244B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ds3s_ilPgtwQ7kNvwGFHLIF&_nc_oc=Adr2vMnj6LT5vOCUIelRSu6siQ10GF_WbtMQ8JL4xlD0Z-ygvd9vWuxkmcVe57ohKKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPS59E5_5TjYOju9ShhMb4u68FjtAK6ztC5d5V6wbrbg&oe=6AD25085"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaZ2n2cU54sQ7kNvwGpv4QF&_nc_oc=AdpY-EFiEyZ7KYuhTz5BpzsN4CRjsumQ5S8TXnj1CA2zP4ZWvLgmnw450G5eTSPveu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiEXSlDlAQj4sIx6miESHV5oAAzchvUOYMv0HugLyN0w&oe=6AD25677"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
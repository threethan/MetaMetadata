73391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPWgJzeNH3wQ7kNvwHFKKho&_nc_oc=AdqobMM-OFKW18LKzvMVk4mhQKH71yi14dQIBGz-_8ql3aQo3OUZsu7icP-TFcs_f5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp0pZmsHW-jQbXAsz3vZ6iAIr0LJAzmTZErbwf0cYrsg&oe=6A510B53"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhK9Cz99LeIQ7kNvwGLKWPh&_nc_oc=Adr7Ne8a97JEI27rR-apif4aYeODxTIhCCYQG24ueo1IMBzj9EAA_ckmPXKBrSbx6cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDABBFyYw61OmkbI8CGv984LVruYRweOoM1fNKPFPEH9g&oe=6A510987"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl26BIrNXbwQ7kNvwFhIXSa&_nc_oc=Adom-bPFuf1jcytM5N3QRDczazuAs5abrV4cFMR2nMBLwb5beHSjmjq6pltDTWOovA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvE2V4wErxYTiq32Pnx3YHtf1P6Vusnp7eWuUCNWe74Q&oe=6A5111B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYJha5XNf8UQ7kNvwHz2zsK&_nc_oc=AdpeKVeu3HMEJOGT4fZlHa6TB6ug7qeHTzBaFt8wvuD_C2QAEXyyQtYPsoyg2ow8kGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJbSruHAOYhNiwRdCYjEwxbmghMCCcmED0lycueSPsRw&oe=6A50E545"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jlK98eovrwQ7kNvwH73jra&_nc_oc=AdqyZQeKLFJrH4_rtIWtAtYnx9SnewrZJzC4Ckpj9R9KDASaBaKvc-i7Qx7q6swFxwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGQFT8td0e9qpcpEHaYAHFTNJ9c3JdaT0RFONJKSGjLg&oe=6A50EB37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446046
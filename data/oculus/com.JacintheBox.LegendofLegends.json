5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqDncbGBFwUQ7kNvwELCrJI&_nc_oc=AdrDbZNR204iIgDXA86kn-CSUNSoZ4V7UwohLXCWPpabxFY0D2-otpyeDnPQuhlmo6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DEbiOYOoqv8bd4D-sHzAhbCo1I5OFjF7ly88P4Lto-g&oe=69F8B6D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTWWpqZhmOkQ7kNvwFDF7g4&_nc_oc=Ado9P6InRF4ro9NBP_FfncQdJSD3pH71VkErHy_OCTdo1HD1bHrh4Dk-eqZ1mvPM0As&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iaXRTcYWl-krpsDCxk1MLO9stXKePPwkXFqBw1GY-Sw&oe=69F8B507"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1haXAjK96AQ7kNvwHtaQ9E&_nc_oc=AdodRJIB5BdHbv-gGGkoohG2mQ4bu2MTzGk1o-6blqeuppyn4K0pwDn9D56UioV1ZF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hCMS7S_Y8zYn6QrDTl5ydtHpZLb8-KHq6xwwwPx28zw&oe=69F8BD30"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqbzhh12s4UQ7kNvwFoGElC&_nc_oc=Adqq_Vt8yV-QYChcy78H4trXJ5W2wCc3jEzffWjtSe1XQ1W8-rKTQofw8jA8rl-AIMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nV9zcF8efT8Bz_7ZOI_75WU-73UoXSZyY_iomOJjihw&oe=69F890C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS_2NP0fhBgQ7kNvwFPnVtq&_nc_oc=AdocN31w_4W-NFCad_4vb5PdXP-njk124NOGlZJkd1CChPX1VTFibWB6tu4m6SK01mM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1j3DMWJlLXa2RrhMyCW9goKdk9K7_xb7PvhXY4N6Ma0w&oe=69F896B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
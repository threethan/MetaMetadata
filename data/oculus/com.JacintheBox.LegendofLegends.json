SHg-NBrKynaH_YBUqGAuSd4oTwkNqrTK6fmmL7XPZgN8RNDI-pA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftGNOKm7QHcPEihwG6DJLPyatgI7hEmxNF_0nNTuAc07A&oe=69A17B93"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moCzqIIat4UQ7kNvwHssbtS&_nc_oc=AdmASW9_FSHTMjoYH_MUgUjlgYKGgcjbB2Wbgmd_eniJRRh0Qv8tqtoA8IuB-4ImmiE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuynAy0etwMUtxPVCA0I9e4NMPhpGPnONuwFBwwdSTrLg&oe=69A179C7"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u80ytocnQGMQ7kNvwF8p2KM&_nc_oc=Adl3nOyrr_G2liNCQuCuJcnBdQvvNHiK8okcA68bh134fREipQDJvdsb4RPkuODyWhc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft6foS7ZENIhv4opwj0yPs-Rf_BiKwRLayoU_Gzf4Zd7w&oe=69A181F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Svsf0QsVhnoQ7kNvwFkKUHE&_nc_oc=AdmjyAD6AVVM2PAaW65DAijK21fsSE7eU6ODpT9PJl4QQrOsxd7xP-oIQc5SroRyZ5s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftCHtWWeQnD4zTLv6xY0ZSII1-7MtGqq2YSRffQ0darHA&oe=69A18DC5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5py8N3ePSMQ7kNvwENdRL3&_nc_oc=AdmjF4hCTDInITZMhbH-HOH-9IwKcZat6nTQbccIm7lC0uOjYH0YZceIJCBlniKOZz4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv90rlxEvfr_EMqGMC4sQHt3X-xNlBC5Yu4wfkG6SbdwQ&oe=69A193B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nu
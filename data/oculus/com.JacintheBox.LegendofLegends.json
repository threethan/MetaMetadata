/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0TE98ZzAHQQ7kNvwEzeiPw&_nc_oc=AdqFxG13MjNLSyYivTgKcF8MPBecYsfig8Rn2gYw5aSrCm5sEronwJk6201s8Eezefs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAa7lfGl7OTNfL_IHdIjGUJvpKGvmGf8Vj8GWvZpGVoQ&oe=6AF090D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx0dBP2xtq4Q7kNvwFQWens&_nc_oc=AdpDLuvje9wIysb4Ce1iNMQa5x6kOWGdm_uh6oCcFaO1Lu6inWu-Yxyr19CQBRKZbsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIBVcD-KMmMe3bmrKj4DdP-fQ6WY1u1rnkdf5NYOsLXg&oe=6AF08F07"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgDYJzN9mlgQ7kNvwEinGoJ&_nc_oc=AdpGFxxY_tZTXKWx2etM10szEbiSO8l0EUZA7oDnej3R8RCKuJ5YX3-A0qZGr1Y4Qnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiW6Za9FH75H8GSV7aOYeeoBRmUBB41uz79pmrVOgQBA&oe=6AF09730"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9G349yC1LUQ7kNvwHZBzNa&_nc_oc=AdrYTkA9LS0QhzFyv4_7nC39-SgOOFglz7037mE3f5h96Ry5G3hQkuAPrCuvmB7CCVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTturOicPotUe5ZZI4-8Cu6Cn_ZQmwXRsRlK_dMVN00Aw&oe=6AF0A305"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqp1AAWVtPsQ7kNvwGhIVef&_nc_oc=Adph0v7QRIMIfn2Y2GE38vYoDpZ9A-tlh3hhsNjZjI9jZdgow1GlczNiMjYoTISeFOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToam0kpb4sS9YCMHmFaKB-1DHo3X72ML1aJhPVT1bUVw&oe=6AF0A8F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE6UcseVxP4Q7kNvwEQ9nJA&_nc_oc=Adr46kDDZ1QU-xBSpq5tuCfLL2ymJPQ_7GHLz34NdyX0pCf30i4Wfv9ZzirQJxcvYyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gySkssW7_Hc_PCwHbUT-VLV8cchtvprNRgZfqs84v3A&oe=69EDF293"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ICsW9s31dsQ7kNvwELiJy-&_nc_oc=Adp-MIY-z_RIFPSDc0PZ7BPxKBCzrWaoCvarRt3gZL_esLTofYJ0CGpNKrB9BusxnoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cK-xslNZCUhxpEyYDiLhvRSXVBu_NRq-jvS8IfG9jfg&oe=69EE2907"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZn9TTh-o_AQ7kNvwFlyLFN&_nc_oc=AdptNXTdPLPrp83ZZRgVxZmPEfUhDSJANJCP42yUN0CkeEjfzrbPz5yac3xcnXAtfwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GJ7uU_6_Pd7_Inyj1yhnjgKHac7Eu3PP7oaBFQMtTgA&oe=69EDF8F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcxPIzPy330Q7kNvwGGkzEh&_nc_oc=AdqaxVnyqf_k3piAfD645RZ2MlZlUzUaW5gemBdbpRoSxjSHCresXNimxDeYi7Q-O5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15_o2JZ4aFSN7OIS4_kwctO2DA-T_EVZUfa6y6AjACRA&oe=69EE04C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W83sHbArceUQ7kNvwFRjoI1&_nc_oc=Adqcb2GHtcWc7Bh86phcPkIUh-tjVKzOjG1EAh9DpfnHKZN2U_WukPUqh4xKyWTmr00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ueMiUk4Av3a6S7VXdy2KmLrAOpTrdLa3oAu59qjuexQ&oe=69EE0AB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
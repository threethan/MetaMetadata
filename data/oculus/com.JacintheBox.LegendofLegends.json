/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE8QnUb7rFUQ7kNvwFGycEB&_nc_oc=AdoxgY5zSpklCAXdg7JiRde4J84HLILP3ZQmKE6hzGOnp4oXJ-fEGbP4vlNSsLI3lSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRNAEYfMlYIMMTaVNhmpTiohMnz47cnHvb7_uHv4mE0g&oe=6AF879D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpEjXQ6nkSoQ7kNvwEmfyph&_nc_oc=AdojeHu6PEm-pUTC6FJTPLpUTDQi3KSrrk5J0E6YbrgNyfb6n9TMd-jOOWZNcK2yRfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB1awoeYQDnNw9d4S9AQghJMm4g8RITXeRIgfDdMPhgw&oe=6AF87807"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSLnQg5WEFoQ7kNvwEMTAdo&_nc_oc=Adrqf6gFYCKXCZE1W1GxacyIq96DA7CDEIN_N2zIH5jwB7IdrS_ftu9LbXzAS9piilo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxBFIet2w3TIrEGhR2DLAdz3Lla4eWO0Z9FzcXtF6p2A&oe=6AF88030"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOnzhyesB8MQ7kNvwFIDpjr&_nc_oc=Adp-uBinI4uxnl8cAfUXsEoWB7UoPTWofcXXhfkWk_Z9TzA6gtHkcAbcnwD71_FrXzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7rVwL80tZhR-YKMLUm_0ERFj5BYNRFFjVWexWFt78zw&oe=6AF88C05"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNh4IJQEdtYQ7kNvwH1-xuN&_nc_oc=AdogUtPBcAeLIt5sXTdCOePDaA19unfAMMh448FjBoQlhqL_nKX-FNx456gzx-quWSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQg0_ljnsTAaxaLEJvpg82bpOIzcJp8xwQ-D3l_xnTAQ&oe=6AF891F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
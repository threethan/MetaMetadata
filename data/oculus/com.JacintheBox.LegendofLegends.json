/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE8QnUb7rFUQ7kNvwH1mOdV&_nc_oc=AdrQ9RguWNoXeuHWs-3HEZEme-8CprCBG8n3vIJB3mtIyZ61IemySSGK8fj5p6GM0GM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2aBgaONLBG5vtyRWPmEDyaytq-JfpVoB4DWnojChDPg&oe=6AF72853"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpEjXQ6nkSoQ7kNvwGSKfKz&_nc_oc=AdqNSq5ppjIhpOJntyrc-VptLyVBM2KaSnuFQ3qAS3sPY5XMv7nK5kxDrYC484BD1cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8NGF7MF1LniqSsfOp4dZVIAlsOfan9u9O6gkCP5g8jQ&oe=6AF72687"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbSmb_UHSdYQ7kNvwElSPNk&_nc_oc=AdoCPJmQgI7cmocFqUOkiOMOeCbnDSijI17_2fg7aCsuP8iO41jeoIBiZGK43xNXXPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg-53Z2ADb1bERV5ddL2QZtheg1xfJr-HVyBcPgPqO4w&oe=6AF72EB0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOnzhyesB8MQ7kNvwE_8_cQ&_nc_oc=AdqrbNLMyPrZW1WLjlCr6EH216xr6RFa04uSCq4yDdRt7yOXRV-ntTJjCij7m08rqZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIBumyX4LDCW_-Q-jqZ_cXM2rIxI3F5neaEo8Mmf05jw&oe=6AF73A85"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMSVlQJPlzwQ7kNvwESSZJh&_nc_oc=Adp494vZz1nRumCpXsllX6vkpA4kdgA6dai-HtyGGMsGkUPcQTmZe6x-6CVKE9CqpRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHVADthNYXxIGz0zXVfjfP2qCFztAgxFX_xsZPl7WpiQ&oe=6AF74077"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
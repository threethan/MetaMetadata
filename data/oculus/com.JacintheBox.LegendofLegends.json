/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRZfn3343X0Q7kNvwEVLRal&_nc_oc=Adqlq8unuG68Ww292PI4-LQxtcEgTOBjr9Dw1-b0g2XOfuH9wLI5VS9cjkAZSKh5EFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5JWAaTEHys8LtrTKkZVHMCuioQ25k0PfE0DB23nByXg&oe=6AE9F953"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-2SJwJnFG0Q7kNvwHrorML&_nc_oc=AdqXSVFAT90af7fba077TFdbR_NHIhbudLlGLsNs-dYSEFbDriaIUi9v2VHcczsYzAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0OvRSx9fSI0F7wx0pqjHjKy7tK77oeYARXDKpJK5tPw&oe=6AE9F787"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdY38t-ZT-AQ7kNvwE_KCKR&_nc_oc=Adrn_s6-M1uIaWWYvsD1tcLCSytyH7Llp0X3zm5rKg-df46i09FS2NoFfWJMlEh7EoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqKHFuj0CTB-BjxyH3PWE8lrp0FR8gr3Z7qY7_3kmr4A&oe=6AE9FFB0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNDFYjOVmlAQ7kNvwH6QsR7&_nc_oc=Adqa91wAn4NpcDk4tQP-PsftJGjyPUGaML8nGpiYKILmrkQC12xOFbPkXThaDrHvUYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQot4Xd4Z6EaP_-jT5w2f8LeIa7EZIqY0V4BpZDAjl3FQ&oe=6AEA0B85"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtQ5G5CCxQYQ7kNvwF9CKtw&_nc_oc=Adp4rqTkNLlugJy9FtpGZKUll7CA_JkjXc7hwo1nh82aC4JsZ_zXbKXkPuLX_CvpeMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKj3ss8xaquqZeuKFlxK2XBkHkq_droNKo3yGVbZv4Jw&oe=6AEA1177"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
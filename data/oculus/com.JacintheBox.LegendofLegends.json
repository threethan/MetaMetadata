5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVBfpH6MlLIQ7kNvwHIpFcY&_nc_oc=Adp3JqTw8WEPm7ydUMR5eXXRv0LO-1DZQrLHRoq68ttMJkDfnskZ79c7LEgh2shlFXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zhi845FyrsXXWbkoRTkxyIJMoE1i-JGP3xgF6Md9-QA&oe=69DE2093"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qMUoW3xe90Q7kNvwHFpnxq&_nc_oc=AdoNvPMy7RNIc_Ab40QD_m-J5l6kP5qp6vrFL8_V9gyhaGnZHy7B6Vl2Rr_SuqMoVT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OxjZvQLV1OyVTIaAiefvhNcn2quSTesKxV2VqELUbnA&oe=69DE1EC7"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reDsxyhKbEsQ7kNvwEjQtcj&_nc_oc=AdpVKKI2Qq0IpDo5eUm6CA23-lXHpJA_lSG3s9NIU9gltiwqTVX5glYBDt-aeLYnxFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-wZOFyyr7CywxyjU9kh69X-UzLr1bVbEuW40amnmp9A&oe=69DE26F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQcCI44ae7AQ7kNvwGUbeOU&_nc_oc=AdpDwmEcIe5NlOb58XGOo-UqUi25EQVrb9tuYCQnoKIQ3lYZbJzI1TkW8sqO9d-fJa4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E7fQcBZZFf9IgsV1b3agnMgJJfHGrzURGlajip77wcw&oe=69DE32C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lur5XknpnX8Q7kNvwGrlXmr&_nc_oc=AdqatBTnwrjh6JbZEkHv9BQa0dst3-hxPXtAvXWjR3Bn-4QxFTAWJ5rSYOH96WvJxLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z-Mos2rOOpo_Q9tCoid9952G3UnzHqnobf1qixq9QgQ&oe=69DE38B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
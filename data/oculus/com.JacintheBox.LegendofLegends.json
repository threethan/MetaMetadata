/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAHgvkMG4p0Q7kNvwG865LL&_nc_oc=AdrJy4_VlEWEi_hvk9n4s29DWn8sCOK0yXWnWRZ96ZeP9MzqTXs7bC8uZtvUP91fARk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jtWOkeKVml6omfnIpP3YXlXTud-upGdccRRcORWwbGg&oe=6A05E5D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXtNLNcar-4Q7kNvwHa7nAt&_nc_oc=AdpDkz1v9srRD5AeOdYNP2juVZCMqZ4_0xfLYCsj_U_5bKaEv-csr1giEKIul18dEp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70AvEfCvHF7PqxWetHNoqNtJfb4bBkN-xrY4gqiyqVCw&oe=6A05E407"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWMbsI1fQOMQ7kNvwE5HcKP&_nc_oc=AdrLySt-mSJFkOn7-fPZQKsDIdHtBBO5xNAahchz2ApCFTYx0e8G1FgYMSJGArx1uuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mps0_PqHDQyIkd6es5sq7QEyA0AE3_BWCsseNPszUyg&oe=6A05EC30"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHqjIUtPSV4Q7kNvwHiIzEv&_nc_oc=Adqz_KY9NCGwifDVlHYkU4GV27Lh0wJm6QtMmvO746YRabIOXGrNjquLSMoj3B0Lnfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k7GoXElPM5mc20XUxmGEuLaXIfu1Ut5NuRaYOFgRP-w&oe=6A05BFC5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98Cu_grC7FAQ7kNvwFyHVDs&_nc_oc=AdpyDFyadq4TjRdA8WOyPJq08OHlk2wmBEgH0irBoGf6mwuY8376fg0gX5Rm-IaHUyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JThXZl_JuRJtfeTmzjUa9ckUYBcQBiBzjUGlrcD8PKQ&oe=6A05C5B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
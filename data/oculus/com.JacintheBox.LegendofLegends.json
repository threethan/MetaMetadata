5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE6UcseVxP4Q7kNvwFkajsB&_nc_oc=AdpraUHwUI87ywoMmr80SMxdiIFqlnI9KnR3lvpx6NVaxPY_A0WJ0PIEqvl2GITZa7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ky7rnZo7KphsZdSq7CHZRcqGy7DwSmCoCOBd04wh_xA&oe=69EF7C53"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ICsW9s31dsQ7kNvwFGN1Sd&_nc_oc=AdrebMNo7_GCiLK3D7Xo7he3XVoCGCwSWSFiuE3bMgaQRHXP5AWyTMM-bgjFvbkSmQ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1o3g8ZTtWbiLf96kzD3BZkZ9tRjaDMvDCMHqsgWubNIQ&oe=69EF7A87"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=971qkgs9jaYQ7kNvwEGOdaN&_nc_oc=AdoqMtOVjkHtv3ZXWRMLzRZ3g6Tvpqt3DTQD5C4OTcUNABFyoi6UEjpvp9T2NNyNlrk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3g63IxLIggza5O4Yk1Z90Mwc0dzZtsV3Uxhe28yHBTxg&oe=69EF82B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcxPIzPy330Q7kNvwGsMWUS&_nc_oc=Adp0fve6b6OdCmhtkRyW3KxEsSvVONNG4uTj0NW08A4TGJ1TVlaxJdxkhZn-cqwc5AU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qtWjHjtIwD-dB5NeFT2M1qmAoYMaE4qL7tiJeSLOvlg&oe=69EF5645"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcuvChkU5T8Q7kNvwEYnoQz&_nc_oc=Adqt3KckBCWmLpLEJ3nn8041LoMueEzUf4BsYDSmnwkCLmD7LGTlu7AFeQT6Y-OeMzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19tREjtuDgtwriJXCCVBPKNcrpWrzoxLk2rHjgXo2L1Q&oe=69EF5C37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
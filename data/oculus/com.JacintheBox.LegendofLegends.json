/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqDncbGBFwUQ7kNvwHV8v77&_nc_oc=AdqvD8C7q-zK7O_8lzrnOHBXWaoDp0aWEabWL_JwXJeA8jYTcQ5bG-oZAr7cqfjL-Rs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aMfAr5b5nwiH8iWyw1EfO7Sq3Sfu7RZ-SIcHdiVO7XQ&oe=69FB59D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQj9inGXSmIQ7kNvwGyXLTJ&_nc_oc=AdpJklxI3NvZf7OgWB9AYfd18LMabVBlSIaKiX52MzZifVGM2orsdE47Bwhv3vGJdfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ef2m2f6dAtPjbeU5V56Qvg99rrWPdog8yZB6sZSdAdg&oe=69FB5807"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DNzVUWcPrIQ7kNvwH8Kjdy&_nc_oc=AdrS6vpgMzmA0TF2uNkqd7mH7YqHigPBHLR-IJ8X3xk_-bKYHLQhyRekC0kRgkgTOcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wPW6b5RaDxx-QriVdREeuW44zikNTeHKE61epnrPPLw&oe=69FB27F0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqbzhh12s4UQ7kNvwFoVYZW&_nc_oc=AdqKQ7myiWZqKw94eknhyBO2n--mZEfRD3aqRpkfj5gjIL81ZVdQBtaq69Ax58ssYLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_KcldErwCN9TUE79p88yPJtCdMkSiJyDiW758MnTOPg&oe=69FB33C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWFhQWjAmMsQ7kNvwGhaeLL&_nc_oc=AdpPTZbVW-igFFn538S_SbgJ3JUHQTvn_cJf-xgtzOY_M3pf6Y1kfpyTNKjXpWnFlBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qGSuMX6tpMd1ln68VgWUgwWRBi47i3kDRl0AT12ww7A&oe=69FB39B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
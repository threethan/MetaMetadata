/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeAKZ9iLP2AQ7kNvwHIKoNn&_nc_oc=AdrsTNu4b9_RWBtnQCUA1bh3FK4sbp_usGjTpZs-UBczw-dVJIzHH8rBw6pUL6QEPfU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3L4ZpK7Yhk6EXgO3qxbRMDAlVYINyJSRcLh1bRN1UgA&oe=6AF333D3"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZgJxS_3520Q7kNvwEVtrMD&_nc_oc=AdoySguYasBjd7qhGmmp_S2hN4qzXwAkbiF8H5jKgEFEkZJBpBbRUxkfK7sYR42WS0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTszC2uV1tvPNlOiJw03QdbjVIgLSKs9_hJvOQdYlg03A&oe=6AF33207"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgDYJzN9mlgQ7kNvwEsNr02&_nc_oc=Adri7u-gRHk5Nen1aV7_4u3CVD3EhOSVamzjA_pkiEDobEZmUna271K1l24WiaABXzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAWSUn9g5YmYz_NyJIfvL2d9VY-ccXp14_gfC_2xqbvg&oe=6AF33A30"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKB7pPC7rcMQ7kNvwGb38Yq&_nc_oc=AdrpHpjmQRAX6cXInJa5i7teX_e7FD6iYkuFViJ7JKa8gSFt69TWGnOk8VCa--5329w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTad4Ybau9x-6ClJVcVyOgFhc1WKAiDWRXes1DCS02CTQ&oe=6AF34605"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqp1AAWVtPsQ7kNvwF24Ssy&_nc_oc=AdqMam-91oKF_j3uxgx1eZnJxmnBcu6mEVHUYCtimug7Fvcni6ioDX0tDkFRyLH9AbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWcZyUKhIuj9HtzIVq3cK8J3ujv72PmTPF3ZTSLx8U0w&oe=6AF34BF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
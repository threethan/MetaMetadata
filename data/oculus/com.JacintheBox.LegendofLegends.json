cdn.com&_nc_ss=7f20f&oh=00_Af-GqAdmSTa0C6T-bDDUDkuAihbUSzYGZzx1ReEX_Oq2ag&oe=6A22FEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "1518388506964032", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499296123_1518388513630698_8128431791173910327_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y4LJ6LWsmcQ7kNvwHpkrWq&_nc_oc=Adp2acDLYSSoidTBJVbMhr2RoEk1E5_2A7p6Wk8_3uZfxkSk1gUchk9PecKKZZ6-Ezw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hp-EO361qsmQX7lbLlPh4qYs5ruSrWNOzVu_bYTzEGQ&oe=6A22FDA6"}, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": "Jac-in-the-Box Productions", "developer_privacy_policy_url": "https://jacintheboxg
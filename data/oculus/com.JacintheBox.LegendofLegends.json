/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhfQV8uOraoQ7kNvwHtyjJY&_nc_oc=AdrjQeqTzlLz37loWs7f8jdVcO8fFQJDYE5wc3b5NfKqw1soJSFKKbU9I4m0C2OkNh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFx9ljRf_TOOPffRr9sZiUGcKkkX10RHybhx0oCBrl_g&oe=6ADF6D53"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEOWK9QOtlsQ7kNvwGl-hEI&_nc_oc=AdpQItm2Sr30i_bWlzmYg8tZ7DQ5NMirkdXTveLyV5jR3u5-IdEKNLuwSZdVruJao4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_eeU_UJ3LVrYp1Lif5HpjBCmXxO2mWU5UVWZWVZmvrA&oe=6ADF6B87"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX7tpUxusoIQ7kNvwEJI0x2&_nc_oc=AdoTvWY8SVE5cA6pgQCXPKUkfaHFWt9OrtHwne2ZANUXyiGoOOE1F7f39c-Xt_YcCDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXqh7BjkmI6UX9gVGoRlPHQ5kkEhj_9qzQF-QkZH2q-A&oe=6ADF73B0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dmscfx32eYQ7kNvwFQD9Xo&_nc_oc=Adpg2TUImUDlVei0BgnskK8JseWYR9bsZI93744CYWq5P9sLROwbUmE0ackstzKC6wQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSbaEkFa1TxWZM0jCvpHVM6fjvLED3DbW569yLlrM6vQ&oe=6ADF4745"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9j865z7g2AQ7kNvwEuFerc&_nc_oc=AdrWn1m53SqgM1H4GzE1sE6vZeam07QKSrtTC8jOE38tjhcqwZ_s5BeZ4uwqh13b3LM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP51CvERml9IBSVYRqA4MZYKD_EMZ5HpwdG3cpdVEaLcg&oe=6ADF4D37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460
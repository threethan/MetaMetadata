73391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5IA1gRQlF8Q7kNvwHEo54z&_nc_oc=AdqaiG2tW4PyEMc_POIDlCikbRCx2kWKJ4baLxmAjk5n-wt8okuG6GaWJKviDgBlw-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4YPGkEHXJSRtcK2XFGnsa9iAv3rRgUioJT0QushonYA&oe=6A60A513"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPgo1mEpvecQ7kNvwEsMDp2&_nc_oc=Adr_TAfAv7uZMe9Mon-NXdSr2_ZuB_unlnpoc9TLoPwtuSYNqi_ANxumFlmnTQ0Mz5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD9zzUi6f5GYa34n39WUO7w1bPt-xBoXf4RHdrARurLA&oe=6A60A347"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awkJkYYiYqEQ7kNvwF6_DR6&_nc_oc=AdqcqbTgtKeHP5SMAlavsaXMOTfEzEVlAJ9FIHP-Onb5uq_SSeeBeoWRqUGRlDXOAUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArtQ9lHbN0K3HSSTo9uTrRq3g1wtvRYnSWXWOhsqo81Q&oe=6A60AB70"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-9AEdzPccwQ7kNvwHSHBRp&_nc_oc=AdoAhuQm_TjCK-9NmV00ch1cY0B3tJ3jVCDNAMGE5hITOobMuHagyE3EUU_RGerhP3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaW5t-SxaRXw836MWChMLSecA3rCMLb-AWUJk6nZoidA&oe=6A60B745"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEXM7_8B4xsQ7kNvwEDdS0v&_nc_oc=Adogu19QMlXQWI16hdMRAdOGsHpodsI3GDGN41Qtt9DcAFcvFaz_aiXtZsBB95JxKLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHQ0a7gbIZOPy4GIcQfv3masxcOEBFxCXFW9nEmr5tUg&oe=6A60BD37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446046
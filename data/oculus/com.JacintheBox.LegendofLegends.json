5/473391924_1037158581574742_9050939831973923556_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL5aECkEEHoQ7kNvwEMB7HJ&_nc_oc=AdpNG7dyNU9Qkhf06lg9ZClrAMgulvu4I9LzlSkvVn6CZDL8BNBvHqs679bkjSBzWws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_btF3LWLMVdQpDkJOKs887GLbBv0l3ahmHzQwuzcqiA&oe=69E36693"}, {"file_name": "2.png", "id": "1146896643428788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1146896650095454_5732758953885967078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvRXTYuWhX0Q7kNvwHutOxC&_nc_oc=AdpNxgknZsAY4KDz7tC3fIEzxzXgTAFCMuJ-BuPObOtTt2yJ9CtsOXWbKZGrwfjUScE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MWM5GMXlHHGxe6p7ExhDKGBfBxSksMaFaT2apMffRcw&oe=69E39D07"}, {"file_name": "3.png", "id": "2750039408719534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_2750039415386200_5706688997599607826_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx7IkoRQCZMQ7kNvwEoe8Cx&_nc_oc=AdrL43TYDwzQNn58jgnVsvZelvzyeoaUSJrCqz2hM05FqShLmazz9Ey1wytQ1jeYptI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zqik1tgzv8FUqs6c64HvbMjB-bdjtis-u5MSqfG-TRQ&oe=69E36CF0"}, {"file_name": "4.png", "id": "1163054028614484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1163054031947817_2733671248868130239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxRkLNzk5-MQ7kNvwGDMry_&_nc_oc=Adr2ZG0dNKeAJ85HWDZ7U7r67jIQlQDZEHxpppUPgLjubO2EnL2ofWFLHG2jPxnkSNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sxzFmQ3-OXbBVIRuabfBslAUdPlexKmWyY_2wSCIqcQ&oe=69E378C5"}, {"file_name": "5.png", "id": "1561328597863731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1561328601197064_230659378809001247_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq64v3cK3QEQ7kNvwG374TF&_nc_oc=AdqGy_TCprMmr1IlmtGFAssmPuC4_JA2LBMvWD2vUisy4gc0_ZvFcb52WM5WYmRdrIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-TX8q7AnRenDSnAzEfk8Ar2q1QQkvJ5xlnHYs4KQfKA&oe=69E37EB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legend of Legends: Orbs of Power", "keywords": [], "long_description": "Legend of Legends is a single player non-linear adventure with the classic design of a traditional action RPG. Journey to a world filled with friend and foe, discover new equipment, and battle the Temple Guardians to collect the Orbs of Power.\n{3837352763076990}\n# Explore a large non-linear World.\nTraverse the wild lands and fight through dark caves, infested swamps, desolate deserts, and more as you uncover new items and collectables to help you on your quest.\n{1546253499365371}\n\n# Conquer the dungeons\nNo randomized roguelikes here.  Delve into meticulously crafted dungeons, each designed to capture the essence of retro gaming nostalgia. Solve the puzzles, avoid the traps, unlock new equipment, and defeat the dungeon Bosses.\n{2965641180278974}\n\n# Test your Mettle\nFace off against a plethora of monstrosities. Defend yourself against the varied onslaught of attacks and fight back with a curated arsenal of your own.\n{659475316797371}\n{3837352763076990}\n\n\n\n\n", "short_description": "Enter a world of adventure. Explore hand-crafted lands filled with treasures, traps, and mysteries to solve. Meet the locals and defeat the monsters. You must complete the quest to bring back the Orbs of Power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacintheboxgames.wixsite.com/games/english-privacy-policy", "developer_terms_of_service_url": "https://jacintheboxgames.wixsite.com/games/english-terms-conditions", "publisher_name": "Jac-in-the-Box", "support_website_url": null, "website_url": "https://jacintheboxgames.wixsite.com/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "269189016446
om&_nc_ss=7f20f&oh=00_AQSuA2Prt0myBUF4qC3M6obKpQ4XLqsjGY2GtXMAi_VB3A&oe=6B085CEF"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-25 010952.png", "id": "538215922032939", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75443241_538215925366272_3085559605707624387_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq4Hao_Qcb4Q7kNvwHlklRg&_nc_oc=AdplrZyDNv7h_IpMIPaNvajUt_FDcNdyUfQVJPm_bHNMfUX_ERXgu7H2mYcyEmS4J3A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6e4-tV0wthYSnx3k2Fw9pj4nyBsJR3KvPCsF8hFpr0A&oe=6B085458"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-25 010024.png", "id": "1058062589310224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031526_1058062592643557_5894424519316317768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL2To63q1D4Q7kNvwHNMWPA&_nc_oc=AdplI4hbBdSu6ag-TjNDXD30vRq95rarVb5pedyThnLLJJ397SVNMROQ-4WsinsYt1U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR18IkrcWH_qUf9Cvf2SQNmC-8aowtyV4P9B26lYz6n5A&oe=6B084F7C"}, "display_name": "Tangle Breaker", "keywords": ["Puzzle", "Casual", "HyperCasual", "Rope", "Mix"], "long_description": "Enter the world of Tangle Breaker, a uniquely entertaining puzzle game where your goal is to untangle a mess of colorful ropes. Each level presents new and more complex knots, challenging you to think strategically and find the best solution. With every move, the game becomes more intricate, pushing your problem-solving skills to the limit. Whether you're looking for a casual experience or something that will test your mind, Tangle Breaker delivers it all.\n\nThe vibrant 3D visuals and intuitive gameplay mechanics ensure that players of all ages can enjoy the game. Use simple touch controls to twist, pull, and maneuver the ropes into the right position to break free of the tangle. But beware\u2014one wrong move can make things even more complicated! As you advance through levels, you'll encounter new challenges, making each stage more exciting than the last.\n\nTangle Breaker isn't just about solving puzzles; it's about mastering the art of untangling. With easy-to-learn controls but increasingly difficult levels, you'll find yourself coming back for more. The game is perfect for short play sessions or longer challenges, offering hours of mental stimulation. Are you ready to break the tangle and prove your skills? Start now and become the ultimate Tangle Breaker!", "short_description": "Tangle Breaker is a fun and engaging puzzle game that challenges you to untangle colorful ropes! Each level gets more difficult as the knots grow more complex, testing your problem-solving skills and strategic thinking. With its vibrant 3D graphics and intuitive controls, it's suitable for all ages. Twist, pull, and unravel the ropes to solve the puzzles. Are you ready to become the ultimate Tangle Breaker? Jump in and enjoy hours of addictive fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/tangle-breaker", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_inte
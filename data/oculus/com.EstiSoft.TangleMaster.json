Ir5wK12Ckt5--nZuA&oe=69E8D8D5"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-25 011012.png", "id": "1082752926806738", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75280176_1082752930140071_6224493985727549376_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bLVn2HVwX4Q7kNvwEtbnUz&_nc_oc=AdpJFryAQ2k1kGPhQHW7bxtvhnYWatG770VB5TpNC6QnXSgcNpvdOG0_AJ1fDn_2QLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n8MXdOB_WxGfFfMCV-GF3b0wznMfIDd7ZEMJZdqcHfg&oe=69E8AE55"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-25 010024.png", "id": "1503889853574785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86808542_1503889860241451_3476848034482435311_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5N7veapJc8Q7kNvwG9uXKT&_nc_oc=Adq0_UcNkkzASjc2nftR9iV7RXhy7KjMSOPLzhnyySPIe2FqVyOpwFw5u0GeJ4gVSF0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cYqcGVKuS8c0YqKEOlOgp6W8YdOdKSJqM-D1ix6XhMQ&oe=69E8BDAF"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-25 010952.png", "id": "538215922032939", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75443241_538215925366272_3085559605707624387_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOT3qaL3HVYQ7kNvwFSOnds&_nc_oc=AdoRAk_b1Yck4hv8nxQWtOBmSi3ga5tJmw7hNZ2ZTkkkHBfR13PhdAFz-YGb2f_bmkM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-2ZW4ha0CSq9fNMsTxAMg1MpChHI9wnLdgJoUhOSksA&oe=69E8B518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-09-25 010024.png", "id": "1058062589310224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031526_1058062592643557_5894424519316317768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikZQ5mxtz8MQ7kNvwHD48sQ&_nc_oc=Adr-JrZhaGy1C4bn6tNcbcVjrWSW6-4sJvJ_EglzwcMXrlqSVxMzBy5gObTsXKsaQBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YN3NW3YR-psLLs-Wz06gyTzNmrn5ZkHZC1agtmDoZNA&oe=69E8B03C"}, "display_name": "Tangle Breaker", "keywords": ["Puzzle", "Casual", "HyperCasual", "Rope", "Mix"], "long_description": "Enter the world of Tangle Breaker, a uniquely entertaining puzzle game where your goal is to untangle a mess of colorful ropes. Each level presents new and more complex knots, challenging you to think strategically and find the best solution. With every move, the game becomes more intricate, pushing your problem-solving skills to the limit. Whether you're looking for a casual experience or something that will test your mind, Tangle Breaker delivers it all.\n\nThe vibrant 3D visuals and intuitive gameplay mechanics ensure that players of all ages can enjoy the game. Use simple touch controls to twist, pull, and maneuver the ropes into the right position to break free of the tangle. But beware\u2014one wrong move can make things even more complicated! As you advance through levels, you'll encounter new challenges, making each stage more exciting than the last.\n\nTangle Breaker isn't just about solving puzzles; it's about mastering the art of untangling. With easy-to-learn controls but increasingly difficult levels, you'll find yourself coming back for more. The game is perfect for short play sessions or longer challenges, offering hours of mental stimulation. Are you ready to break the tangle and prove your skills? Start now and become the ultimate Tangle Breaker!", "short_description": "Tangle Breaker is a fun and engaging puzzle game that challenges you to untangle colorful ropes! Each level gets more difficult as the knots grow more complex, testing your problem-solving skills and strategic thinking. With its vibrant 3D graphics and intuitive controls, it's suitable for all ages. Twist, pull, and unravel the ropes to solve the puzzles. Are you ready to become the ultimate Tangle Breaker? Jump in and enjoy hours of addictive fun!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/tangle-breaker", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8164869346942049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031514_437007099396158_2865602783961774611_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YrObt_vodYQ7kNvwGW870L&_nc_oc=AdoY1P7Pyz8y48beQgQXtvzruwjq1ReEfU9CIWjfCuLkldNRrtZ424LWfgFRAWcogUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jC5JyCprfz0ADP5XKUiT9Z2_DXX3MJex11j7Z7ZKQaw&oe=69E8B3EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tangle Breaker", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1727888700, "lastRevision": {"nodes": [{"id": "8164869360275381", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8164869330275384", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert"
764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwkt0N02CCwQ7kNvwFj8c75&_nc_oc=AdrwQsawbnXaZntXfP3Mlh4bU7QmFyuI9BZN_W7cjU6W3LsjOq9MRkvhswcs85vJ_Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMHCLB0VhuFrB6oNE5k2QZ-RC7y589Xko6qKM5n8paWg&oe=6A4CFEF9"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzUAcRng_LYQ7kNvwEo4kks&_nc_oc=AdoeLlO8p7n51dJ63ks9L3qgwAZINPd92s2g2au-zGRVZ6uUxDLd2Ye_N5OU8cP4X54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw-bDFaQYv0RByWAuDdYrut0hu7cFQzvkJyfTnwgMHCg&oe=6A4CEF5B"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIlPi1IIJlQQ7kNvwFABVH6&_nc_oc=Adod_nIbguPqqW0p67uVJv3tCiU3QZuulEKVqS63wBM-qn8WTcoE9_tlLW9LX71zvOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxBLqWe4Iycdcbvcd8yHEVmvwOOudekW5_Yto39y1BSg&oe=6A4CF44F"}, {"file_name": "screen5.png", "id": "1224927135876245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396978_1224927139209578_764402035138883071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ1MnrXurjoQ7kNvwEKIIm8&_nc_oc=AdqhAnAQ-euYaAKTt9oDcv-1uQ2JgFFZjHL31A0h0VN8_YCXTy1CKszknDozuSQjo40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLGwGhjtHvBvPKWpYZrN1SZTFEDQWxA8jmlwvishCKBw&oe=6A4D009E"}, {"file_name": "screen4.png", "id": "723408736786262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324939_723408740119595_8035685698945450130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnQeGoM_iNMQ7kNvwGQKE2l&_nc_oc=AdqWxcViSn5F9uBkcc4qAKAtM-xySs0hyU110uw9_UNDYGvZSEZqa5WBc4ezFRYJJAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgrL0D1aJigePhHPakB7fV9F__5kf3voeRBVJ1cwYZeg&oe=6A4D0198"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Guard", "keywords": [], "long_description": "# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Fire up the X-ray, scan the luggage and the passengers. Let them through \u2014 or not?\n\n\n# Clear the passengers\nSearch hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  Laughter guaranteed.\n\n\n**Join our Discord crew \ud83c\udfae \u2014 news, updates, giveaways, and surprises await! \ud83d\udc49 discord.gg/etermaxrstudio**", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRE
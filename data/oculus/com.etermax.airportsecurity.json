9078_902765552779942_3780436713308771294_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUygBFOiZFwQ7kNvwHni4vI&_nc_oc=Adr2ViobSVabhpyQLfZFhZdv80adL2PJLN6RaU8GsxP8AqDHIknqk570XOvHum674nU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j_R8NZr-duncNOhOFG656xj6oIWG4W4uidBMfJOQ4lQ&oe=6A072285"}]}, "id": "2260380377826879", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFYgYOMoH3oQ7kNvwHCNMo1&_nc_oc=AdoZYfpZQN5e3mY0GRySgjYLSkKMR8WrlA5QCJxDAfbJizVxPaZ73SH04XBGWfKmkQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64kRYZ5O-zYHPkDG-qcgWO8CSoJf7LyxnoG2xPeho_-w&oe=6A070C41"}, {"file_name": "dog.png", "id": "756187530820014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_756187534153347_8907838921303455702_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmdK51Ljf9YQ7kNvwHz2e7v&_nc_oc=AdpOPltVsBneu0hVgIi9SF-euBfscJtb1ItaWmnGG7fZvb-SC6-jXDoaSXgkfFe0f2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57LTFIdL6uSnN-IbVQ311pspjfPJu0Ap_BLig9iFjXDA&oe=6A0731E6"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyhCyJ4WO-QQ7kNvwEev-3q&_nc_oc=AdrbqPygJyWQ15rtL7RWZOBGQ_QNsyMp27FLakqN-LVKKM6-ztjr3C4k0spCJHv-PZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u_400011-etyHtp9Ap-xqEPP141rM8jXSIyduVmYeEg&oe=6A070CFF"}, {"file_name": "ASG-Sabotaje_Screenshot 02.png", "id": "1933690560620409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_1933690563953742_8957389180104597144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3b9zKkEbOgQ7kNvwE3hKfe&_nc_oc=AdqCAO9T15IP2zz_ELPp9P9xdOFKVBmPDXsHu1JKJnu8SnIkzpiYGsER7KrwLKmilYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70UN_ojxNf-mlLf4ZdWqeRDh4SfOBQmLRwM6GHzTzK9w&oe=6A071961"}, {"file_name": "ASG-Sabotaje_Screenshot 01.png", "id": "1261042002659277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1261042005992610_4881034503493149594_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6II-Q-zZssoQ7kNvwH1eOD-&_nc_oc=AdoMEVMC4WERHSAmAcHIeLeWphOJspPaVg2-9szoPvr2HzE98ivi7Xhilwfs0rbtu0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x7KIhWgtVL7PPKN1pdat7sFim_qOl81wQJwoh4pgSEQ&oe=6A0737F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Dog.png", "id": "26815227704753395", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_26815227708086728_6159149265929139896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l1wAi5PiWUQ7kNvwFtS_CU&_nc_oc=AdpU5RI71auCvM4ABZhUkeDNdIBtMiffDPxHG7xuAFi06PtUv00qhOGl2nb5rnfFuq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77bE1KO6DnUR38CpcUsF5Zf3yAMKkJUKB8mkT1YiBgDg&oe=6A07268C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n{871879605880886} \n\n# NEW: Sabotage Tools & Kits  have a fresh look \ud83d\ude08\ud83d\udd25\n\nChaos just got an upgrade.\n\n**Unlock powerful sabotage tools** and use them to disrupt rival guards, break their rhythm, and create scoring opportunities at the perfect moment \ud83d\udca5\u2708\ufe0f\n\nFrom quick distractions to full-blown chaos, timing is everything. **Use tools strategically to climb the ranks faster and take control of the checkpoint.**\n\n{2045802276146832}\n\n**Want the full loadout?**\n\nGrab Kits to combine multiple tools and unlock your true potential\u2014from Cadet to Captain \ud83d\udc6e\u200d\u2642\ufe0f\ud83d\udea8 You can find them at the line or in the lobby. \n\n\n{3381561185339110}\n\n\n# Social Lobby is  open! \ud83c\udf89\n\nHang out with other players, explore all available packs, and grab new goodies in one shared space.\u2708\ufe0f\ud83d\ude0e\n\n\n{761738103289314}\n\n# Scan fast\n\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and rival guards are not making it easy. Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n# Clear the passengers\n\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks \ud83d\udca5 or even a bomb \ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\n\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\n\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f\n\n{694386776531919}\n\nStay ahead of the chaos here:\n**https://discord.com/channels/1014620047827804281/1377372782718877826**\n\n\n", "short_descri
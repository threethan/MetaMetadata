c_oc=Adozy_nS8ewPzy6upa7xoR-Ue2dwDe0WRBDujlkL-hKbxKjCMF-64MJ6p8Z1_b6zqPE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bXiixpNy7vJY41EpaRR65jKw_sJXOr2asvI2vHzeKqw&oe=69FDDEE1"}, {"file_name": "ASG-Sabotaje_Screenshot 01.png", "id": "1261042002659277", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1261042005992610_4881034503493149594_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOXpfleXd-cQ7kNvwF9mTGo&_nc_oc=Adpo1WZ4BklQLa3Xbzf068UUYzIkufUwxaQ4hay_p0599NR-P7At7BwbL8jNDutMR0I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X6yCWVT28QBe_1glgNHjMxK6cu-dfPMKpEljrik62Ng&oe=69FDFD76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Sabotage.png", "id": "1136244515236810", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819982_1136244518570143_4073764491968986955_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwDirTB9PPkQ7kNvwEr2PAJ&_nc_oc=Adp5C2MIrYxvAPuHoLku3Gdal-rJ7UT5BdPKDjO4lRQafCyF3oLo2x87b73z7d8zY-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dfMe2DmF6J95vz-vgkHFogzgILz31U9-wNJ04rsj4Kw&oe=69FDE0FF"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n{871879605880886} \n\n# NEW: Sabotage Tools & Kits  have a fresh look \ud83d\ude08\ud83d\udd25\n\nChaos just got an upgrade.\n\n**Unlock powerful sabotage tools** and use them to disrupt rival guards, break their rhythm, and create scoring opportunities at the perfect moment \ud83d\udca5\u2708\ufe0f\n\nFrom quick distractions to full-blown chaos, timing is everything. **Use tools strategically to climb the ranks faster and take control of the checkpoint.**\n\n{2045802276146832}\n\n**Want the full loadout?**\n\nGrab Kits to combine multiple tools and unlock your true potential\u2014from Cadet to Captain \ud83d\udc6e\u200d\u2642\ufe0f\ud83d\udea8 You can find them at the line or in the lobby. \n\n\n{3381561185339110}\n\n\n# Social Lobby is  open! \ud83c\udf89\n\nHang out with other players, explore all available packs, and grab new goodies in one shared space.\u2708\ufe0f\ud83d\ude0e\n\n\n{761738103289314}\n\n# Scan fast\n\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and rival guards are not making it easy. Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n# Clear the passengers\n\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks \ud83d\udca5 or even a bomb \ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\n\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\n\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f\n\n{694386776531919}\n\nStay ahead of the chaos here:\n**https://discord.com/channels/1014620047827804281/1377372782718877826**\n\n\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25964304716602299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_786431287855591_3020998282256043511_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUBWJpeeJhQQ7kNvwHNkLwL&_nc_oc=AdrgrDJ4tA-aAV2R_0LHDfcEVyXfb_RW6XfpWMAgIs2SgROnXHnoLyaFxL0Uroa7oTs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75ePH9q5FzBP4IlKb_d9EucjQSBIHHEArJbmhHLGH0nQ&oe=69FDEF61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbo
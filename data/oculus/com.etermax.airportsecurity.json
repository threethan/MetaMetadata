ts": [{"file_name": "screen3.png", "id": "1208202234078299", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820067_1208202237411632_1764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9xZmWxyrgsQ7kNvwGlcaBo&_nc_oc=Adqw3YSaqN5TGtwC0q5cr-huQqtNfLXpSvz4oxJpIQqYAArU7MZIHFP3mtM1b9a_0vc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fuyjxp45O9QS6o4ruOvZhdwJn325L6oH-lTCHSbip5w&oe=6A0B13F9"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoGR9ceR8IQQ7kNvwHlFztr&_nc_oc=AdpMVjmWREHN8jeoJ489YgdSxz2hhcih8rh7eclDJYrw_8LG_dzRxAJDdPzlqMJ0gX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oknbsfzn4vAu31cHlHTyWVd59272b3vk5MmU89-hFwg&oe=6A0B045B"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIxJq0YeugEQ7kNvwEJWJQ9&_nc_oc=AdqUpGQFF3U5NhZDCdwvfn0cVVk_traQmcRlr1BGgmcKieCV2wTCw5fnFmvdzpl1QIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7taU2LQtcFlQZjHdECagk1Gth614QtH9RbOy4N6mYsbQ&oe=6A0B094F"}, {"file_name": "screen5.png", "id": "1224927135876245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396978_1224927139209578_764402035138883071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsIfXnJiOgQQ7kNvwGSbhUu&_nc_oc=AdpMP20lvcY2eTfnhi6n7fL7aO0ilfbS3XfP2Khpuu4BDTS6LSJAmvSr1c4yCsz9vGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ynL_0Mn4guOKendxMOSDt42AyCZPq3N-sN3xj7Q0K4w&oe=6A0B159E"}, {"file_name": "screen4.png", "id": "723408736786262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324939_723408740119595_8035685698945450130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOGgxX00utYQ7kNvwG_eru1&_nc_oc=Adr9QREat-Ff7eWH0BO1zDTlcLSn-NrNmzpsGOTRfESQHW1Ju-MjpJKVCel_UwE3opk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45zsvz5SABz2qP_PBxFmlgyHljf24JcpjE94LozdLD2A&oe=6A0B1698"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Guard", "keywords": [], "long_description": "# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Fire up the X-ray, scan the luggage and the passengers. Let them through \u2014 or not?\n\n\n# Clear the passengers\nSearch hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  Laughter guaranteed.\n\n\n**Join our Discord crew \ud83c\udfae \u2014 news, updates, giveaways, and surprises await! \ud83d\udc49 discord.gg/etermaxrstudio**", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
iO5nw8EK_26Qx-ohpOjXy2CrYM1qbhJo9a86c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bSb-7Nz8OCOLrv8YrB3wDm7EdEH5GuWVIzSgqx8VFMw&oe=6A0C5F61"}, {"file_name": "ASG-Sabotaje_Screenshot 01.png", "id": "1261042002659277", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1261042005992610_4881034503493149594_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VH3yn9JjoAQ7kNvwGVJHtq&_nc_oc=AdorOwlUNsGNMMsyejEZIMZCs5OyFDhgkJhcW1vXEvN8CH1jWp-_j52zlP6gePxVMVU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sC_BS2lkxNweleeGgSvnkRv7IMc7Pndh_7l7mh0sUNw&oe=6A0C7DF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Dog.png", "id": "26815227704753395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618515_26815227708086728_6159149265929139896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G3KaumX6akQ7kNvwFZMRVH&_nc_oc=AdpHeIGjnX-tV7boiNK0nD3HZiWm0UTAPmYZd1mUYCpW151MPslqf-1Mrves0YPAzh4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FQI2wIQXUc6oYSZokJDuy2-UgDiWHXAyi0b74_owBSA&oe=6A0C6C8C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n{871879605880886} \n\n# NEW: Sabotage Tools & Kits  have a fresh look \ud83d\ude08\ud83d\udd25\n\nChaos just got an upgrade.\n\n**Unlock powerful sabotage tools** and use them to disrupt rival guards, break their rhythm, and create scoring opportunities at the perfect moment \ud83d\udca5\u2708\ufe0f\n\nFrom quick distractions to full-blown chaos, timing is everything. **Use tools strategically to climb the ranks faster and take control of the checkpoint.**\n\n{2045802276146832}\n\n**Want the full loadout?**\n\nGrab Kits to combine multiple tools and unlock your true potential\u2014from Cadet to Captain \ud83d\udc6e\u200d\u2642\ufe0f\ud83d\udea8 You can find them at the line or in the lobby. \n\n\n{3381561185339110}\n\n\n# Social Lobby is  open! \ud83c\udf89\n\nHang out with other players, explore all available packs, and grab new goodies in one shared space.\u2708\ufe0f\ud83d\ude0e\n\n\n{761738103289314}\n\n# Scan fast\n\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and rival guards are not making it easy. Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n# Clear the passengers\n\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks \ud83d\udca5 or even a bomb \ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\n\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\n\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f\n\n{694386776531919}\n\nStay ahead of the chaos here:\n**https://discord.com/channels/1014620047827804281/1377372782718877826**\n\n\n", "short_de
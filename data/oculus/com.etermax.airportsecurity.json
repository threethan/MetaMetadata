&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ3T665egdUQ7kNvwF9UsQn&_nc_oc=AdlmQTyjXR8YMQ6vjp6a9DwQ8263zTjhy4jf6WFVhWXw2STwrL0pHAAP5Go_NTioJaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjL1jcFuM6DUjlrhdOvtOn9Uo9gPxB5_ZnN6KsjvUvRA&oe=69A6CF7F"}, {"file_name": "screen3.png", "id": "1208202234078299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820067_1208202237411632_1764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6by7_HEZeV4Q7kNvwFdHnyk&_nc_oc=AdnFYzazoq2NU8k9AnfUelLESkf519-wtZCBnNf8qZoGTl3fSlaziJGSTJ1Ln1aWi2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuvJAy10anRU6V535sDj74RTefRkJqpH2UtEbV1O0mFdA&oe=69A6E1F9"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH7wFRZ2XeYQ7kNvwFd445Q&_nc_oc=Adkk1Kj0DcEGOlpG8zTqTN57qc6GGcOAtXTCYCXjJXk6sKclpcMzGgeLscHZDl-WtYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCbeD0qDkDbtaY7MuzMNEeF3BEpj0N94HtZhZGAvXYKw&oe=69A6D25B"}, {"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4VFr1DDgO0Q7kNvwGBSD4d&_nc_oc=AdlHBZY2JdIFHfjIV_RQPgHwwMvMs6Alu7_bB2DcJGr9Set5I6AacHl9uKOtD6GIyuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsS7GB8Zo5XbHLGafY9IlojMhOWtNqmAUXeEeZ62BRanA&oe=69A6CEC1"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGFHQ85caKoQ7kNvwFz8Y2E&_nc_oc=Adl0ViwCD6HN5BWorgPEXvHa_eNJ1T9QigR0t5GhxpfF4jrogGwXGD4U6jrLWSUlax8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuRTt6D9xklhNR4gNmth8MuT08UXt78LIBwYkY3_OZug&oe=69A6D74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Multiplayer.png", "id": "885618347253031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_885618360586363_1692578319805030314_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An15FyrNnn8Q7kNvwHjsES9&_nc_oc=AdmQ7Z0QPH-lV46_F-_1jm5mMF7ipN0F1oq41huBPKIHKIIXcuBNSgGv0XsOUV_Cdy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHPMeYpGzwd0FaOH3vlL83Vb-sQ0xDcvsi4MIYDL8AYw&oe=69A6D983"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                         \n\n\n{2891009444623762}\n\n# NEW: Social Lobby is now open! \ud83c\udf89\n\n**Hang out** with other players, explore all available packs, and **grab new goodies** in one shared space.\n\nMeet up, gear up, and jump back into the chaos together \u2708\ufe0f\ud83d\ude0e\"\n\n\n\n# Multiplayer Mode \n\nShow rookie guards who\u2019s the boss at the checkpoint! Sabotage your opponents \ud83d\udca5\ud83d\udd2b to slow down rival lines \ud83d\udc0c\u26d4\n\n{761738103289314}\n\n# Prove you have the sharpest eye at the airport! \n\nEvery passenger you screen \ud83c\udfaf and every smuggler you catch \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udeab adds to your score. Every performance boosts your rank. **Climb to #1 on the leaderboard** and see yourself on the **Agent Spotlight Board**!\n\n{1273264500692671}\n\n# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and the rookie guards beside you seem faster than you! Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n{2679838542225972}\n\n# Clear the passengers\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  \n\n{694386776531919}\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25
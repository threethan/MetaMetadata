25/499619078_902765552779942_3780436713308771294_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N34uqRv92PIQ7kNvwFdQ5Qv&_nc_oc=AdpgxgFYe3PIUDE-OLKtiT6wFLrRXtpcRLqZMuabK9AbvUVZJSWkRl7XK2filgF2898&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mUBqPEu3VgWM8XzEalB7ACul2XDuRmCnHoJP3HAiAeg&oe=6A11AE85"}]}, "id": "1522984789551602", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTlhAL6OwYoQ7kNvwEej66M&_nc_oc=Adr5uSu250x621JAOMt2YqUEanu1NUSo2g82YUNqt1jITEhdJFTPxK40Tzk7vhEFdT0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42X8cms2Yqvvjxvi2ahxqXE3z7kDXLuGIyuaYqYUOQNA&oe=6A119841"}, {"file_name": "ASG_SS_PatrolPartner 1.png", "id": "1347114693954973", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499617847_1347114697288306_1024321109761818753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYOV47idtYQQ7kNvwHgxzCU&_nc_oc=AdqwHW_c1rb1rP3jWESY6DXsitv9unU3rabGo6lwrXY1OGw-6EaNPWtgAfXNI6sS65g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fJtKIaaFUduul-WQE8oYvFSrEPlXkwWa52QjKxrg_lw&oe=6A11C66D"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCZU2NNLd1QQ7kNvwH_Cz9E&_nc_oc=Adp99Lf50EuuVPW4SHdC5madzx1IgF3mSQvxhXhSt9oIl79_SqbKFk8F0rgImo2EOCY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X_WCMPeLkZ-P4dXU73VgOWV_nGFbxK_DD4tA2kCODnA&oe=6A1198FF"}, {"file_name": "ASG-Sabotaje_Screenshot 02.png", "id": "1933690560620409", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820001_1933690563953742_8957389180104597144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcQk9jc1f2QQ7kNvwEDP_t5&_nc_oc=AdpHYGIX72EDA4dMcFbGeQ07bKaV4qrCCJXQXpx4U6Vzx6ObpAVKvv2Dza7v_8AcnaQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NIVw5G3bbdOGZx5pbyOdoOdJG2zZkOwIWZZcuRV0iaw&oe=6A11A561"}, {"file_name": "ASG_SS_PatrolPartner 2.png", "id": "1449195816511930", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1449195819845263_5320353852881489965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GfkFWNEPkEQ7kNvwFJ5Omm&_nc_oc=AdqdniLmZgGYY8KAlJbuyH3IO7PQDUYR72k85KKe1tY58GKGrXTk3wTYTuBKfT6dkaA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aHD8e0r2SwBtnKFW_HkY2i2zhtN8YNI14GS-awW8IEg&oe=6A11C2E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Dog.png", "id": "26815227704753395", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618515_26815227708086728_6159149265929139896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhbjOOQo16gQ7kNvwFDwd8j&_nc_oc=Ado9mu64aqALK-rISM3DTMfQIKdtTWj9SolTV2bw_4-lQCbPQcm8hDbkaZ23-QLiB2g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71AmI9uVvdnqgqR-ZRjHDv2GhYFK2D1uQzM_ydfO4hvQ&oe=6A11B28C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{967463802916746}\n# NEW: Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nYou\u2019re no longer handling the checkpoint alone.\n\n**Meet your Patrol Partner**\u2014a loyal K9 that helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead \u2708\ufe0f\ud83d\udd0d\nFrom sneaky smugglers to unexpected surprises, **your partner has the instincts to catch what others miss**\u2026 most of the time \ud83d\ude0f\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\nChaos just got an upgrade.\n\n**Unlock powerful sabotage tools**  to disrupt rival guards, break their rhythm, and create scoring opportunities \ud83d\udca5\u2708\ufe0f\n\n**Grab Kits to combine tools and take control**\u2014from Cadet to Captain \ud83d\udc6e\u200d\u2642\ufe0f\ud83d\udea8\n\n{761738103289314}\n\n# Multiplayer Mode\n\nCompete with other guards, **slow down rival lines**, and **take control when it matters most** \ud83d\udca5\ud83d\udd2b\n\n{871879605880886} \n\n# Prove your skills\n\nScan passengers \ud83c\udfaf, catch smugglers \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udeab, and  **climb the leaderboard to become the top guard.**\n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.gg/7spuFrJ5y**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n\n\n\n\n\n\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nScan fast, clear passengers, and unmask smugglers\u2014now with your Patrol Partner \ud83d\udc36\ud83d\udc3e by your side. \n\nSpot suspicious behavior, uncover hidden trouble, and stay one step ahead. Use sabotage tools to disrupt rival guards, handle tricky passengers, and turn chaotic moments into points \ud83d\udca5"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26520515397647892"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619805_3966732010287404_8583139215839214314_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI2vhIt1vQAQ7kNvwGIZ5Hz&_nc_oc=AdrvFM9V2zv2Jpb6v148aIiet0uT_0BcAG4RDf9lOGFniVHUxeMlfjh0_1MbsE9Y5CY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i-bVt1WwaXwmZJvUwgpySujJJi8FHC1vzMqigC8zIqw&oe=6A11B19A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GA
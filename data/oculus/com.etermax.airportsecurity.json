5/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gJNqDxFd2oQ7kNvwGjXs-E&_nc_oc=Adnztxa-udoTFJbSMbAlszxpBSKzgYV4UeW3f8iLST1M5dh_1eku2u0mqHyI35Bruyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoES58DQXkgxFAL-f05Nq1OZFvjfo08PtfEfabQpvKlA&oe=69B2ACFF"}, {"file_name": "screen3.png", "id": "1208202234078299", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820067_1208202237411632_1764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4Zye557m04Q7kNvwH4id6A&_nc_oc=Adk0DWWjBVli6KOnoXnMKcl-6tdqleUeX9rkPx7PzCtPYZcyHrPbJ0e4LF0YlVTqo3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOdrbVhhXFc3Dys5rS-ugK9_xdbS3Z1CKGDuaPzuWeZQ&oe=69B2BF79"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahEOhaQ8KYYQ7kNvwFqoFqN&_nc_oc=AdkbfEm6NJBThJeuqCWHzWPcsdx_-oXhOHzFFRVNE4v2y9SNSfO-CMNLo5GV-SlXetI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCJD2Qqn-ufiJUOantvLrNy2rX6bx7LMavAtTe77ItKg&oe=69B2AFDB"}, {"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEYFz7xz1xQQ7kNvwFNiyHn&_nc_oc=AdnrypDbCTZyhtEJrMNW-WhRH0aGXGFIbQS1cwFl1fwmZgYUEI3hzNGtXh892g5iIfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtrMzrT-S3vhRdS0ZshmwSN9xvTYP555TAN0Gr-NpxxQ&oe=69B2AC41"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jprs77NnUzwQ7kNvwGw_xvp&_nc_oc=AdlRE0lkD4fEy1XGNbeVgZb-ULB1wcMbKLG9pTIrYPgFWy_NvCIaX9jOmvn_hFrK1pE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzen6TCUCO7twwhqomJVda-ZsHADHurk_GjSQUZIb6nUw&oe=69B2B4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Multiplayer.png", "id": "885618347253031", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618069_885618360586363_1692578319805030314_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLOuvJnS0IsQ7kNvwF3uf57&_nc_oc=Adlm3bQBx1etjxdf__Gj0Y6n0rkeg945-IF-mHtzY8jnNyxbsrVn8wL0wYnsQGWMvbY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLqW9WcEvi99wWbxaoUTzGnR3Peg9NFgWz_3049xpGtQ&oe=69B2B703"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                         \n\n\n{2891009444623762}\n\n# NEW: Social Lobby is now open! \ud83c\udf89\n\n**Hang out** with other players, explore all available packs, and **grab new goodies** in one shared space.\n\nMeet up, gear up, and jump back into the chaos together \u2708\ufe0f\ud83d\ude0e\"\n\n\n\n# Multiplayer Mode \n\nShow rookie guards who\u2019s the boss at the checkpoint! Sabotage your opponents \ud83d\udca5\ud83d\udd2b to slow down rival lines \ud83d\udc0c\u26d4\n\n{761738103289314}\n\n# Prove you have the sharpest eye at the airport! \n\nEvery passenger you screen \ud83c\udfaf and every smuggler you catch \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udeab adds to your score. Every performance boosts your rank. **Climb to #1 on the leaderboard** and see yourself on the **Agent Spotlight Board**!\n\n{1273264500692671}\n\n# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and the rookie guards beside you seem faster than you! Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n{2679838542225972}\n\n# Clear the passengers\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  \n\n{694386776531919}\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
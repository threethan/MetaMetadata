_Af8Z4Amh1YR4KTLdeTqGU0j2aqOTCySiELiA8LZsi8aFDA&oe=6A296061"}, {"file_name": "ASG_SS_PatrolPartner 2.png", "id": "1449195816511930", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1449195819845263_5320353852881489965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwvnvjQymc8Q7kNvwH3o21x&_nc_oc=AdpLtZHXrOUMdGW--23fVuFRU3jzqGJgyTICPj6XaRm6PF86lTBijEqTX0oMuHErcLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OvhodQoEnvDtrm8EkUrcYsgi-ApRTXWkVJx8ENvOO0w&oe=6A297DE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Dog.png", "id": "26815227704753395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618515_26815227708086728_6159149265929139896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hhMkKopwqkQ7kNvwHbCwsJ&_nc_oc=AdqDhkCkIdIZt6O78Xk4kWnUykbT4byt6oUx1MjY-KrKPzrRUffz6yOiAJh-tiiSzHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XBaZZ7GE7zED9EDlMz5zHDgxy76p5jWBQA9Arly_Puw&oe=6A296D8C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{967463802916746}\n# NEW: Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nYou\u2019re no longer handling the checkpoint alone.\n\n**Meet your Patrol Partner**\u2014a loyal K9 that helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead \u2708\ufe0f\ud83d\udd0d\nFrom sneaky smugglers to unexpected surprises, **your partner has the instincts to catch what others miss**\u2026 most of the time \ud83d\ude0f\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\nChaos just got an upgrade.\n\n**Unlock powerful sabotage tools**  to disrupt rival guards, break their rhythm, and create scoring opportunities \ud83d\udca5\u2708\ufe0f\n\n**Grab Kits to combine tools and take control**\u2014from Cadet to Captain \ud83d\udc6e\u200d\u2642\ufe0f\ud83d\udea8\n\n{761738103289314}\n\n# Multiplayer Mode\n\nCompete with other guards, **slow down rival lines**, and **take control when it matters most** \ud83d\udca5\ud83d\udd2b\n\n{871879605880886} \n\n# Prove your skills\n\nScan passengers \ud83c\udfaf, catch smugglers \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udeab, and  **climb the leaderboard to become the top guard.**\n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.gg/7spuFrJ5y**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n\n\n\n\n\n\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nScan fast, clear passengers, and unmask smugglers\u2014now with your Patrol Partner \ud83d\udc36\ud83d\udc3e by your side. \n\nSpot suspicious behavior, uncover hidden trouble, and stay one step ahead. Use sabotage tools to disrupt rival guards, handle tricky passengers, and turn chaotic moments into points \ud83d\udca5"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26520515397647892"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619805_3966732010287404_8583139215839214314_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLEiAOf1CRIQ7kNvwFRaX8i&_nc_oc=AdrgoRGIL0_Ak1f_Y72n8eZvd-URPgd2hqhtAosquT3uu8ccXkZubElQG_lWCQLiOFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-cZLbfbjC-I-1nkivy7aqm6YSaYEWGLKC3OWbhNE92Q&oe=6A296C9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation",
=6e7a0a&_nc_ohc=fw3wcsAlnvMQ7kNvwF_Vius&_nc_oc=AdqxZzF_4shhirQgn6qeCf_WpCQ1n_M-OtsHBxcSNrommuqa_Q5zyvNRIxqMUXon3b4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL22voCu0Rrqf_GhdYeLx_Bp_emVoNOOvNFhoiG5rhtvw&oe=6AA417BC"}]}, "id": "1729902291587980", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNbeKHCxv04Q7kNvwEc47_9&_nc_oc=AdqUK8dqqWqnB8DXMV_HWg6zT5Gie8a21MZkbX0q9PCIw8jaAiEos1UYDy2QvpLTJkU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsex18MkP0d_FJkTCWvI5mhO83ejYypEn93BvtaDX63w&oe=6AA3EEC1"}, {"file_name": "ASG_SS_PatrolPartner 1.png", "id": "1347114693954973", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499617847_1347114697288306_1024321109761818753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJCH_5DbaVkQ7kNvwG2fk7c&_nc_oc=AdqjM0ALJt4G1nF75b2IpHuEmIoXYd8tEdMwjfbHHhfRmoP4O3yDI3mVJLtiBX1FQ0c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzblI57unOmnIN_F6fo9TujCcmYsNq-h0vlINSW5VJpQ&oe=6AA41CED"}, {"file_name": "ASG_SS_BaggageClaim-01.png", "id": "927352379702469", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499311585_927352383035802_4645562821568678353_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COZWEHKl5hYQ7kNvwFMGq-m&_nc_oc=AdosvDyuFnZbOJZ05VkRQMicaUSfIhj3D7JXpEZOtjtaEA3PIrjgz2MjdkaD80JNFsA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs3t8LVG7Gdr9Yiuwlmd0RQzc6l9I_3kpAignJkyarYw&oe=6AA3F9B5"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J26zZLCC8IQQ7kNvwFIb-TV&_nc_oc=AdoW7TVwbEwUTnnXqytijfNTj_wxkwEyRLV2A7rQDGwY3jjB7Lhpq76sfv72Trgb-4Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHA5Fc4eSbgb5tYe9yLXdC6n4mpaLqmriaBkL32DQUOw&oe=6AA3EF7F"}, {"file_name": "ASG_SS_BaggageClaim-02.png", "id": "1739188827207572", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/507845837_1739188830540905_4247170731112861372_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUADte6RndoQ7kNvwH9j93R&_nc_oc=AdrIJdIsN3Itc1BHpCHAHhIQURloa4mqjkIlHt3dQ8-URnD349Omc8Q8rY8A4AC45gA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Z4S0JkFY1B_Evg7ZuK6O6ecb2XdShBWXk6lnEjtnog&oe=6AA3F782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_baggage (1).png", "id": "1509351071209350", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499620921_1509351074542683_9128856851212219382_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC-kZFdjXBsQ7kNvwHINZJg&_nc_oc=Adp0QNKz3F9z_dK2EV26sahri_dIMoftCNojfbFklcJl2BTGEAxc-7PElb_SRixbgCc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7BIyer_sOJ9G_f7SF6ub-_C_x6yWLEIi1o6aWCBKItQ&oe=6AA3F92C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{1362675645366713}\n# NEW: Baggage Claim \ud83e\uddf3\n\nThe checkpoint isn't the only place where trouble hides...\n\nHead to the new Baggage Claim area to recover lost luggage, inspect suspicious bags, and stop smugglers before they disappear into the crowd. Stay alert\u2014danger can show up long after the flight lands. \u2708\ufe0f\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "\"BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5\""}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27487842827581806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499623314_1730318188114447_3592727335492222001_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXPatlMxsG4Q7kNvwF2rGIF&_nc_oc=AdriNgTGgaBRVZZ6QaCUiuoABluiAYiNFnpSQdZnwByXhrMYNxF6WT-vN9pJUH7n4Do&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXgEPK_yyxWQyI3oOPx8QBXdYlfAt8QyoIOyUu1UPHKg&oe=6AA42130"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
&_nc_ohc=N-eJ8kgan3wQ7kNvwGLjlFz&_nc_oc=AdprRR3IJ4HqFNBG_s7cX3dawvnR4JJG6jfUmwokxt002sDjaqy4gqM7AmJ4eMqX_pw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyHYQoytfPyq5kcb8E-bPLEWZ6xxsirnRLROjoe45Gjg&oe=6A81987C"}]}, "id": "1729902291587980", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xupgprd1fCAQ7kNvwFk5xvC&_nc_oc=AdrvQmZkU_NYamPzqrlN1kv5ZRZn7GiR43wRRRSaWm6ICeuaDAiG79lLbIYvyfpRmjw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4q4G3uMAj3W1PTd9PNpdNZQIJAg16Pdey02Fmx-Cy1w&oe=6A81A7C1"}, {"file_name": "ASG_SS_PatrolPartner 1.png", "id": "1347114693954973", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617847_1347114697288306_1024321109761818753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92fz7Idp8ccQ7kNvwFyuRC0&_nc_oc=AdqKpMYHQ_uYeuRigb2_BEyIXh_NVu9F69cMKcSj7Fvp38Fm4WyXSYOtI4lj-O_AKHA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNVOTbz4Kw3hbM2nXw2Om6wN_dzw-KNtS4dWmkdGKrdw&oe=6A819DAD"}, {"file_name": "ASG_SS_BaggageClaim-01.png", "id": "927352379702469", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311585_927352383035802_4645562821568678353_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7PXLs5lT-QQ7kNvwH37Rap&_nc_oc=AdoNQ76nLTe9UCufztJNx3_zMYijm6k6wDTtzZ1fS3OFAmPA5fO6N5QM_NBj1rBciVg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcuAAOHy3oX0L5HYeMvXdkpE-W5j0xdolt-naUglFkLQ&oe=6A81B2B5"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwU1hep4NGoQ7kNvwHYQN_d&_nc_oc=AdqZ6uk8-NnUKrVToMCyGBc8zVkgWr70bFXQsyZTdmmR1FL8AEWYnZptNwPQ8aFuAKw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIjlDWjBDty5AmDY8qHO3CdLLPEjQEYHZr-Wctr2OyPg&oe=6A81A87F"}, {"file_name": "ASG_SS_BaggageClaim-02.png", "id": "1739188827207572", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/507845837_1739188830540905_4247170731112861372_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK6302XAwZUQ7kNvwEqI01Q&_nc_oc=AdqZSwWBOVa_b-KmGv8NQ6uuRQwmXrbakFrN8EvBgNGc1E8WdhOz1-KvJjL_Q43H944&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSoSbbNR7EWIm0mNipolxKayBMGc_ZwbIp16Y0i9TjYA&oe=6A81B082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_baggage (1).png", "id": "1509351071209350", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620921_1509351074542683_9128856851212219382_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgtaAIAkXoAQ7kNvwFSvOn4&_nc_oc=AdqY7EcsOdySIkxFulMnum1pyIbafAU_lnck13L8aN-PmMR9groF1OR7RTnbmYLSHQs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU1SC26N178nPI1FUEx3PDzghpvE9U4Z6__oVYeKDAeA&oe=6A81B22C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{1362675645366713}\n# NEW: Baggage Claim \ud83e\uddf3\n\nThe checkpoint isn't the only place where trouble hides...\n\nHead to the new Baggage Claim area to recover lost luggage, inspect suspicious bags, and stop smugglers before they disappear into the crowd. Stay alert\u2014danger can show up long after the flight lands. \u2708\ufe0f\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "\"BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5\""}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27487842827581806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623314_1730318188114447_3592727335492222001_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-8eumgHf8YQ7kNvwEETmrC&_nc_oc=AdoHdn7SC3sM74dx8w_RvtFAq2f-OoAtE7Ny5Ydi1IbNJP4kxfCKxVRfQDRsBrlNtWs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFicljhGtSqVd3gZPitTSbcO76nowSAch3bB5xFh9CqPg&oe=6A81A1F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
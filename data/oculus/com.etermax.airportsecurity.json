ttps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396978_1224927139209578_764402035138883071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsJXjWOOgCAQ7kNvwFzXWyk&_nc_oc=AdmPBLqth5fLTKz8izpmcCIDuCYm9JSJzdNs0KpARjEwfln3ZlBSELZfw1WgNQT8zjw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthrMuZvr4gBiqsp7NB0Q4KZFCCGSqT6s-8GtB0BuRsOQ&oe=69A4409E"}, {"file_name": "screen4.png", "id": "723408736786262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499324939_723408740119595_8035685698945450130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUkkHLRa5RAQ7kNvwHNA94v&_nc_oc=AdmvrqO_mAGqUK_tnefWFcqLs7Q7zi1gbacJbeZEzGBZI2QIkYFOZpIZfam1CKr-QPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvDZ9Upg5ZIZ8gT-ilhDY9UisAW61qj6ccg7OuTiWMV3A&oe=69A44198"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Guard", "keywords": [], "long_description": "# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Fire up the X-ray, scan the luggage and the passengers. Let them through \u2014 or not?\n\n\n# Clear the passengers\nSearch hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  Laughter guaranteed.\n\n\n**Join our Discord crew \ud83c\udfae \u2014 news, updates, giveaways, and surprises await! \ud83d\udc49 discord.gg/etermaxrstudio**", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8868593123266725"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "643454632041874"}]}, "baseline_offer": {"id": "643454632041874"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750784640, "status": "PUBLISHED", "id": "643454632041874"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25664281373271303", "version": "0.25.14"}, "id": "1326578655033799", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8868593096600061", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25664281373271303"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": 
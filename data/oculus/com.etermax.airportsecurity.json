&_nc_ohc=N-eJ8kgan3wQ7kNvwHsL5R9&_nc_oc=Adohwc-DVu5dJAkpHiKlj6nRfhW8yjHj73e0UIfq8LVuKWEmejv2rgbull4uhlng0h8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4l4J0nHZNcagIF8nOViS89xj4G6vFAaKpSyZQ50hEpQ&oe=6A8046FC"}]}, "id": "1729902291587980", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMTRcqx7Mv8Q7kNvwHVxVv-&_nc_oc=AdoeSs7h_Fv8eck5cGmqAmNMlqk9UZis2GmDhQQuaNhzW8MEnhhPBE-mkAma0QwxKXQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrTmOj-4Y2PbBlN0vtiaPtp1Qqv_0S4MvfVItWgXq5eQ&oe=6A805641"}, {"file_name": "ASG_SS_PatrolPartner 1.png", "id": "1347114693954973", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_1347114697288306_1024321109761818753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XJGA5b96AYQ7kNvwGDoe3_&_nc_oc=AdqtGEXSjsD4YgvozjZyFLgz12Ck9j62WVgM61nCRjucweOngbwN69Uvn0oq5w3v7_E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBQbHNltCFCcx7giquuVZIIjp9PipzyqPl_0uhR2xZnA&oe=6A804C2D"}, {"file_name": "ASG_SS_BaggageClaim-01.png", "id": "927352379702469", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311585_927352383035802_4645562821568678353_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwXlY7-2J9sQ7kNvwERC-z_&_nc_oc=Ado8S3IxNRlFVOK4n6wai3Nv5SL53ZxBEsaHXWa3FkZFR_E7oL_Kaq9a7s0lgHSyVeE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUGezm2sC1N4uGnCgoHOH35Xk7_PJwuYqbPWl30J3YRA&oe=6A806135"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwU1hep4NGoQ7kNvwHn3JCi&_nc_oc=Ado-N_up7i9fYjJCzNw2VlSCSsXDF-dvvrjrTPLO6IQ8XlYMf38zM5jobEFo6cWOyjY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGemGUR41jctZC0nkMg-f3p82MlGVNjmmOoOx6B8fHGfg&oe=6A8056FF"}, {"file_name": "ASG_SS_BaggageClaim-02.png", "id": "1739188827207572", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507845837_1739188830540905_4247170731112861372_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK6302XAwZUQ7kNvwFjjiJu&_nc_oc=Ado6A93V7lo3Psb3GBjIbnYaF7DQRgR3EmqkJRrFifQ8-6obGNdlflJ6j6OyQHNuo8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqvfEXSJ_rjw2zsgkLdUzIZOW0NSbm6WkzKDn3FUHVRw&oe=6A805F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_baggage (1).png", "id": "1509351071209350", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620921_1509351074542683_9128856851212219382_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7scj70pxa6EQ7kNvwHze76O&_nc_oc=AdphM-bIfcjcu2zaHZeBvqovwqFj5HuiFHd5ti2yt7H42bC8plOczHSq_F7uXDCh2a4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEejNglldZ1_urW7WpSdIKz4tUH1xos2KZg7tGTMUoi9A&oe=6A8060AC"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{1362675645366713}\n# NEW: Baggage Claim \ud83e\uddf3\n\nThe checkpoint isn't the only place where trouble hides...\n\nHead to the new Baggage Claim area to recover lost luggage, inspect suspicious bags, and stop smugglers before they disappear into the crowd. Stay alert\u2014danger can show up long after the flight lands. \u2708\ufe0f\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "\"BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5\""}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27487842827581806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623314_1730318188114447_3592727335492222001_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKk9A0Pp_o8Q7kNvwE1E39C&_nc_oc=Ado5T4LxKZ7ydMQjT7FkOg5ezVRzE1jIFcx85_ozBED_1ERY-X0IFgidqCjfQCra3fg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjYcBenHVr0HxoK_xuw2q_sS6QUFeoo2vmJ1aJ43tKwQ&oe=6A805070"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
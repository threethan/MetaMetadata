&_nc_ohc=2SCBr0zyDFQQ7kNvwHbCPaZ&_nc_oc=AdoNlU701JLRDP4J9g7FM8snkMA2qS1rFB023OFFj8EB6QVwM6_4DCNIVScxdvuTWS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO5y4sPdSbd3m5q_l7IhQOZw0V_awftp2CNHladNkw5Q&oe=6A7C527C"}]}, "id": "1729902291587980", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kjjZ0Fq5c8Q7kNvwGShEAg&_nc_oc=AdpVFK2LK6shx6krJs-pm5fauWFzgGmruNy0ag88DS0tGbPbrLy-UycRA0rpDrcgUKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXdF2tEoIKFpQRAKEHkFNB9G-Hwn9p5RfuoFsvjuQ-Ow&oe=6A7C61C1"}, {"file_name": "ASG_SS_PatrolPartner 1.png", "id": "1347114693954973", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_1347114697288306_1024321109761818753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8IClEsvyBEQ7kNvwH-LDiY&_nc_oc=AdpG_Th7-vDUvGGqvjhphy-qysLSQsVnob56uPWuopcNGR5TOwCECk3FcqJRYOiupMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBgUxEB9PF-tdWF09B-hXOgURJGSQ-j1JuYwAGQnH8jw&oe=6A7C57AD"}, {"file_name": "ASG_SS_BaggageClaim-01.png", "id": "927352379702469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311585_927352383035802_4645562821568678353_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKDSkGzooWcQ7kNvwEMyFNf&_nc_oc=Adoro9OOISpByp4z9p6kfZwkdfThZKoD6gXRjInnRdCbVJk9c_tq0jYXqSWHdxfXgoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxVQayGj37sjw66WzPjhmeMB6hQE8u0okiyU3Er-dCvw&oe=6A7C6CB5"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsUpzroVvCIQ7kNvwE55GPT&_nc_oc=Adq_rOMUnL_cCP7NCJJZ8tXltnmiK-jHXeOG02o2v11n_bbkHbeGz0EqqhSE8dcjmls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwku8j1YzVb0-wCrheCaZ-FZSmiS5AObpr3geAoIEULQ&oe=6A7C627F"}, {"file_name": "ASG_SS_BaggageClaim-02.png", "id": "1739188827207572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507845837_1739188830540905_4247170731112861372_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9KsCqj4MqoQ7kNvwGQItSr&_nc_oc=Adp8XeNQP1H8fhZAqbAS4YUd_MONd73bwJMgnnM1hBdscDPydPdPUEYrbJC83sguwqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-8VWQWRigs_2H4k0MpHKY0yyMA0tQkwDot60-mq6TMg&oe=6A7C6A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_baggage (1).png", "id": "1509351071209350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_1509351074542683_9128856851212219382_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azqT603C-oQQ7kNvwE8peat&_nc_oc=AdrdtpICV86I0WqpYXAJOHsqZN4W-Ls4mgM9q5fviVZ7JCSNpt5uXUC13nsU6cRAOIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWp_zj_qo2zQHUALmgBLOaqkz2cBA_tmgs7mMxVCfnAg&oe=6A7C6C2C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{1362675645366713}\n# NEW: Baggage Claim \ud83e\uddf3\n\nThe checkpoint isn't the only place where trouble hides...\n\nHead to the new Baggage Claim area to recover lost luggage, inspect suspicious bags, and stop smugglers before they disappear into the crowd. Stay alert\u2014danger can show up long after the flight lands. \u2708\ufe0f\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "\"BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5\""}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27487842827581806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623314_1730318188114447_3592727335492222001_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSTn9IjMbtIQ7kNvwFjH9SL&_nc_oc=AdqgIDqLEs9pij-kUw2nxvgoxQzFzs1E_yNa15N1oD1uezbdVRzsQ9LDFTPIuWDut0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQwo_bq_k1jUKJtQHevyUr1Qba3Izmz_3KGQynNCcX8g&oe=6A7C5BF0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
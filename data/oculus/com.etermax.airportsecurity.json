&_nc_ohc=v_H-dBcAo0sQ7kNvwHNAsPZ&_nc_oc=Adr8KYQdk66N_D_j1s7VRxu6Lj8VVH6XulTPDui2fEJvYt1Ke1_p9agcaApxF8oWLrk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2MFd-IbYtCimY6H05FN3iRdsvsenb-h2LKxgpTPLD9A&oe=6A882FFC"}]}, "id": "1729902291587980", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NYMS5JxFQUQ7kNvwHj38BH&_nc_oc=AdpeJOSdg-VNQMXArHxZcNMiSlTDEPrrokMmuJmOxJoxCWe8oTO5NYs8idYiBogsTpw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw8oEaZn0BGAOpI0J9Mt-RyX7p49MxX5BK3c-c9ko2CQ&oe=6A883F41"}, {"file_name": "ASG_SS_PatrolPartner 1.png", "id": "1347114693954973", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617847_1347114697288306_1024321109761818753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFxn5eZr1yMQ7kNvwER1Kav&_nc_oc=AdrxrtrlcIYDQjuyPmA4WcqEXs-TrQPh1OYRh3UoWJF_oEqwS9I1JtzJphvRV_f7Gqc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaGu_wAlKjp6Gbbk8AxdcLQ-KwpGgt2VLsOesahADqvQ&oe=6A88352D"}, {"file_name": "ASG_SS_BaggageClaim-01.png", "id": "927352379702469", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311585_927352383035802_4645562821568678353_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOZblhi5mkoQ7kNvwG0Svwt&_nc_oc=AdrEXtK3WLK1lLIhoyWhIj55Hv8BW3dpZrl9bCF1wMcY0xtHxGruHpZZVYyjp9auecA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdw_njblG3IGn0XiAaw26i2uLuwxiwSRkqaRqYQcmC2A&oe=6A884A35"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvxPL6oZCREQ7kNvwGiU1BY&_nc_oc=Adr5KvM0496dWhv9VDT4_yUzPHhfZW_jYq9Kynmli2v9kV4xf-OMp05CRsZMuwBqIHs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIXHEbGKDNGBz32MVes8KOtWY_o6tOXxdh_aZXp5VF2A&oe=6A883FFF"}, {"file_name": "ASG_SS_BaggageClaim-02.png", "id": "1739188827207572", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/507845837_1739188830540905_4247170731112861372_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MEYdRXZug0Q7kNvwG9_YOH&_nc_oc=Adq6MwPdXfp2f0zHxT3SPEUNOQe7QLMYES03YTjFpHJmYGV8kXRMEkWS6nKBboZREX0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnL40uRuDowwR3KexD0HK8q1o0YMmiL5Pv4T6kzz35ug&oe=6A884802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_baggage (1).png", "id": "1509351071209350", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620921_1509351074542683_9128856851212219382_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dbG3-FEjFIQ7kNvwEYiYsI&_nc_oc=Adqmp5GLDgtmOgKAdAIeiP6QCpzqpG_IPgZXkYyyjgzOXnD2IMynxHU0NHrAKyl74jg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvr-BWoOV0qw3O0gcqikC905QU4W40CgO9hsGHGXvkBQ&oe=6A8849AC"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{1362675645366713}\n# NEW: Baggage Claim \ud83e\uddf3\n\nThe checkpoint isn't the only place where trouble hides...\n\nHead to the new Baggage Claim area to recover lost luggage, inspect suspicious bags, and stop smugglers before they disappear into the crowd. Stay alert\u2014danger can show up long after the flight lands. \u2708\ufe0f\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "\"BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5\""}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27487842827581806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623314_1730318188114447_3592727335492222001_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AITPYKyHj6IQ7kNvwHNm6iQ&_nc_oc=AdqMm0hICChnk1f3D3_KevQUij677WbI1Riwr_0gZKi647S7jl-egFjC5nNEhTSs6HM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEtEUCRE1kaUkAKwn8SNkBzKV0WlkbviXdw6GdgHwMvQ&oe=6A883970"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pbEQhHcgegQ7kNvwFXcQsN&_nc_oc=AdoHXy7OlEI6Ij7Qpliy9ziOf1R4fpjW1bN0043cpjd6Is8bxic75XmRj1VK1w7mnlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWttFWNqMUc3573bhPor_BChTM5hu9xgYIdeq9c_xLSqg&oe=6B0F0A3C"}, {"file_name": "ASG_LobbySocial-SS08.png", "id": "1594289512499817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596157734_1594289519166483_2731207158614144643_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5pCaqe-OgIQ7kNvwGzL8pR&_nc_oc=AdoIjKzbqwRTXucNNWbggvh3E9zxPjh_JKA2iNbBz6shug-BVu3ULcMWxzNPWh5vRVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTq9W1xKrups_RM9KFT3poAdn-4DPwMUBKzqArauyKRQ&oe=6B0EF1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Christmas.png", "id": "1069869316109651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839666_1069869319442984_6242759325108316480_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYkUe6BMW_cQ7kNvwFovvn6&_nc_oc=Adq0eIae5ODay1rk6IZL4kiIT2EDxgf0AofhxOGhz6XFrkQEUYr-ckpSpV2kUCM8dIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWay3Rj6LukI2sHTbCr7WBxfXnL8_Lwh7oCOMzoxEmnlg&oe=6B0F1409"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n \n{1840570270315289}\n                                               \n# \ud83c\udf83 Halloween has officially landed at the airport, Rookie! \n\n{1288071953444443}    \n\nThings are about to get spooky, so gear up with the Spook Squad Kit and bring some Halloween chaos to your shift. \ud83d\udd77\ufe0f\ud83d\udc7b The creepiest passengers are waiting!\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28961165610249513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839663_1088936094173502_7121483920296572109_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seeTLa2C8PEQ7kNvwEQKF1h&_nc_oc=AdrLuOXBIz-XA0J5LpmLryXSKEsVnN8Yki7U4Lp8rrniI6AxLtXB99eU8BKL_4xQCJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVv6dfIbpia11cCwHnvwE3cG3ZzFuuPoWjHcVw6Py4Xzw&oe=6B0F164F"}, "is_concept"
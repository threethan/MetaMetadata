=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1OirPL87S8Q7kNvwE024qs&_nc_oc=AdnH-3ebBNONKQHMardT3p2R-aU5DZ8VGIH3e35gGccF92yQzyQ8_wqlGsCBVc3-VlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHNvX9p1HuoFnODIKTwyRjPodBwtHD07qzYxd1Gc6Oaw&oe=69A037FF"}, {"file_name": "screen3.png", "id": "1208202234078299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820067_1208202237411632_1764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlO4j152DPMQ7kNvwEErjQD&_nc_oc=Adl8nnRF-Y-JYm6Pj9KWZdSL384QCpNbXv0OQR-HjiefC8yd3ax47gE4SWdqBvH-Du8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxFc1fJWY1rrfKDb0d7gH2bXCMBBCm7LG7a2AOVhzwuw&oe=69A04A79"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL2P1pRe4BkQ7kNvwGwwKg5&_nc_oc=AdnWrkOkHn0M0O0gLeq0cfHJrE7JMTMcjUOwl0Hzi-Ok5fLVie5QArLJa0z0kwnCMro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsM_RWfj_AOYCaHpJPabvbEdbtdFWcXyXYsKid__jDJ7g&oe=69A03ADB"}, {"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wi8rf3n00Q7kNvwEMgT4Y&_nc_oc=AdnrqTHbP9b-Lv9sxmmzy6PVbr9je0Z-iPvgDorcmmNF2RIgSvXmESC1q7fF4ApZ_PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhzKxdW4wJRGr0h3sb_89oa5mZqUNGxkR4znvecC1rOg&oe=69A03741"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuUxRIZk5SgQ7kNvwEXfLU2&_nc_oc=Adn5V6-NAdkK9pWFxX3pHZxPuTCAjH48nLpFEHqkV_ma-CUYoh6TQM8BnFUWCXYJNiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudbGaful1-fhAqYXzqceoXOtuKM1MRMwfSNS3yDTqKIQ&oe=69A03FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Multiplayer.png", "id": "885618347253031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_885618360586363_1692578319805030314_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGCIWhjleFIQ7kNvwFrPQFR&_nc_oc=AdmNbW9eJh9fV4odpXMeVDPVV1z_PxBGBpvYXDHlXNcMJaJ-06-kqNv_aN0UfbJWSNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfseisViIoGou51tqZbr97W-ukfkkDXBwSe6KexZkBTXmg&oe=69A04203"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                         \n\n\n{2891009444623762}\n\n# NEW: Social Lobby is now open! \ud83c\udf89\n\n**Hang out** with other players, explore all available packs, and **grab new goodies** in one shared space.\n\nMeet up, gear up, and jump back into the chaos together \u2708\ufe0f\ud83d\ude0e\"\n\n\n\n# Multiplayer Mode \n\nShow rookie guards who\u2019s the boss at the checkpoint! Sabotage your opponents \ud83d\udca5\ud83d\udd2b to slow down rival lines \ud83d\udc0c\u26d4\n\n{761738103289314}\n\n# Prove you have the sharpest eye at the airport! \n\nEvery passenger you screen \ud83c\udfaf and every smuggler you catch \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\ud83d\udeab adds to your score. Every performance boosts your rank. **Climb to #1 on the leaderboard** and see yourself on the **Agent Spotlight Board**!\n\n{1273264500692671}\n\n# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and the rookie guards beside you seem faster than you! Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n{2679838542225972}\n\n# Clear the passengers\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  \n\n{694386776531919}\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id":
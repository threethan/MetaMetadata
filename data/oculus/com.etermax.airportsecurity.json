9078_902765552779942_3780436713308771294_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxJoWiJPLUwQ7kNvwH0E66p&_nc_oc=AdqydE-WCD0gWxemZ-WDZDf5KmQcP5gRXiyDqz2qE3Y9zNdyI-lwv7t1C7pPKuAd7l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z-hOolU87IxDCW4tG7yqndiomudCamLGtgk1kBCg6yg&oe=6A047F85"}]}, "id": "2260380377826879", "locale": "en_US", "screenshots": [{"file_name": "Screen_Multiplayer2.png", "id": "1204062391570258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1204062394903591_485769715827945855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xeHSyBTYEwQ7kNvwGT9rb7&_nc_oc=AdpFcmMfym6vH5s0mAvyTN2RfbiAtfSixXZzU3_NpIYiJluof92MdT77X7sqFX2Wos4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C82X9K8HvO1aaZM00CasHd9qPByPdhVZq5xyM82BHXw&oe=6A046941"}, {"file_name": "dog.png", "id": "756187530820014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_756187534153347_8907838921303455702_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58Q701YssOYQ7kNvwHNyCbI&_nc_oc=Adrbq9_UoCY4dSyQnC35nHX7TxAcDtPWyUfly2T15bKswBNOzaDIy_w-Ml-WbcuouIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hGS2urWA1Ojc3SiwEtrhJWYgcqOisCb7vZuDHTAPeqg&oe=6A048EE6"}, {"file_name": "Screen_Multiplayer1.png", "id": "817084764540951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_817084767874284_3254203393607692404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyhCyJ4WO-QQ7kNvwFhdByv&_nc_oc=AdoXPlACw1fRM9BZfK03PvhSagxR89pHgksQgvvgI1iB2SOVIUqJMiJxOAyHVnHHPjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rsHrGt3tivsHr4AvKW-lczjEXDTTnJPEY9EEgcXrtsA&oe=6A0469FF"}, {"file_name": "ASG-Sabotaje_Screenshot 02.png", "id": "1933690560620409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820001_1933690563953742_8957389180104597144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooeh2Yy8xK0Q7kNvwE8Usad&_nc_oc=Adp0h6_gB49M1CUpb3Y-H6nswpwNJsknBFx_6yMrAPhK_Zs2UXydt-eo-FoIb1HE8d0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KZXMu_SQQrPo3nBcHLCSqQ6Tb6pe618legttfa0FEdA&oe=6A047661"}, {"file_name": "ASG-Sabotaje_Screenshot 01.png", "id": "1261042002659277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1261042005992610_4881034503493149594_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6II-Q-zZssoQ7kNvwH6leEv&_nc_oc=AdqsLA72umAy2Fu-PXxztJLJSnYmmIdnR2rJ5MozushFZP4rnTWdoWradOLemvp4z_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j6q6qzPESueN-gbXp3mvnh89eoQeMXifbiEnjophQWQ&oe=6A0494F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_Dog.png", "id": "26815227704753395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618515_26815227708086728_6159149265929139896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p6szb5pDQAQ7kNvwHaetR-&_nc_oc=AdpdRvTzVab2KzASztRubKCqZXDXLlS_BNX0eu7b2L5xui_o2vG34LdGneJUSxP1uNM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Y099VXbQmVbSfj6mPcKIAcAOQ36_VXsGdFwxvH9UHQ&oe=6A04838C"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n{871879605880886} \n\n# NEW: Sabotage Tools & Kits  have a fresh look \ud83d\ude08\ud83d\udd25\n\nChaos just got an upgrade.\n\n**Unlock powerful sabotage tools** and use them to disrupt rival guards, break their rhythm, and create scoring opportunities at the perfect moment \ud83d\udca5\u2708\ufe0f\n\nFrom quick distractions to full-blown chaos, timing is everything. **Use tools strategically to climb the ranks faster and take control of the checkpoint.**\n\n{2045802276146832}\n\n**Want the full loadout?**\n\nGrab Kits to combine multiple tools and unlock your true potential\u2014from Cadet to Captain \ud83d\udc6e\u200d\u2642\ufe0f\ud83d\udea8 You can find them at the line or in the lobby. \n\n\n{3381561185339110}\n\n\n# Social Lobby is  open! \ud83c\udf89\n\nHang out with other players, explore all available packs, and grab new goodies in one shared space.\u2708\ufe0f\ud83d\ude0e\n\n\n{761738103289314}\n\n# Scan fast\n\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and rival guards are not making it easy. Don\u2019t forget, someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Let them through \u2014 or not?\n\n# Clear the passengers\n\nFire up the X-ray, scan the luggage and the passengers. Search hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks \ud83d\udca5 or even a bomb \ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n{4076559519270736}\n\n# Unmask the weirdos\n\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n{692606223618379}\n\n# Stamp\n\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f\n\n{694386776531919}\n\nStay ahead of the chaos here:\n**https://discord.com/channels/1014620047827804281/1377372782718877826**\n\n\n", "short_descri
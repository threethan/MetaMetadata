764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNbZwgc4j9MQ7kNvwFElR1a&_nc_oc=AdqVbKgnj5YnHF1Lf4vDEuSgYWXpLxUMm3MFo141q0Lkqhk2bJ_MngOraiFka7gfDxw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB62lLRvvi1qpvIWmi7RQVS3p3WXWaqB8e54j-ZLmO-6g&oe=6A563979"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ary2DcyV7c0Q7kNvwFAoYtd&_nc_oc=AdqMJzAIk1XNn0bVdQuj-v_14Ja_ekz8PyfH-2C1qYE8K-k1DNQqHtxL9Q1K6aMo8oc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkBYEEWtjdn1Fy0Prwe0wBIb-rIGYf2MCmfQfmEao7KQ&oe=6A5629DB"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGVaIcdjmBgQ7kNvwH6Yx5F&_nc_oc=AdrMqRlnyoWL5CA028q0GRVB1NF2ABaRBwBXnIIFX2jdNSYNIZL9nEyg6q7p4gWg4z8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBePJMfGQJocutZf-JHqhgQUm3o-BXuqW6Dmkr5ZqXv6w&oe=6A562ECF"}, {"file_name": "screen5.png", "id": "1224927135876245", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473396978_1224927139209578_764402035138883071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhPOQpdC5pQQ7kNvwG2SiAv&_nc_oc=AdrEeH_iy0zWeus8nYmbecAVAtBx_-bXNjRSTtmb36ROjN7DZQcsC0P2o4de2IwtJVw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9qa3u3YwbTzaMFKUAQDdlW3CkxmOJ5EZKlzI4fazHXQ&oe=6A563B1E"}, {"file_name": "screen4.png", "id": "723408736786262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499324939_723408740119595_8035685698945450130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TamYX42MOMoQ7kNvwGA8g9M&_nc_oc=Adrsq1yHgFuAQqZyBbzC1k_dsha6FvIHfdxb4et8TDTgc3fofw0ueup2yIG0-6DfhNU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtto0rG5lsJqs0yE-L9CktkMtIaj5155m38vYadqlZFg&oe=6A563C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Guard", "keywords": [], "long_description": "# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Fire up the X-ray, scan the luggage and the passengers. Let them through \u2014 or not?\n\n\n# Clear the passengers\nSearch hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  Laughter guaranteed.\n\n\n**Join our Discord crew \ud83c\udfae \u2014 news, updates, giveaways, and surprises await! \ud83d\udc49 discord.gg/etermaxrstudio**", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRE
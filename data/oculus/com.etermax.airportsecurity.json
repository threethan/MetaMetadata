rd5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHChc8epxT4YNzyPbZcFBN-se9ziail7Uc7GThcuD_oA&oe=6AB0053F"}, {"file_name": "ASG_SS_BaggageClaim-02.png", "id": "1739188827207572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507845837_1739188830540905_4247170731112861372_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kq3sbsfOEIQ7kNvwFBavNi&_nc_oc=AdrvvIQbMfzViYa1TUR6hsgup1RlfOLfH8NCs579XU3SaP0jqBmJp7l8fXDxV6acqmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgn2QUUekURGR3o0b6V41_WYn72LprhRz_XrSeyrCcyw&oe=6AAFD502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ASG_2560x1440_baggage (1).png", "id": "1509351071209350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_1509351074542683_9128856851212219382_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4Ns4ivlorAQ7kNvwHONjRa&_nc_oc=AdqXiuZDbdCPWll1aIB4F8kvtE6Nhp1_YABv8tg9C2wDI-XzSgYgOv-DHc-yxDzX-kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHcw4jc4fxBN8fhJp_ddkR02cDErMxcq0ffXOYnVOcZQ&oe=6AAFD6AC"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n                                                    \n{1362675645366713}\n# NEW: Baggage Claim \ud83e\uddf3\n\nThe checkpoint isn't the only place where trouble hides...\n\nHead to the new Baggage Claim area to recover lost luggage, inspect suspicious bags, and stop smugglers before they disappear into the crowd. Stay alert\u2014danger can show up long after the flight lands. \u2708\ufe0f\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "\"BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5\""}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27487842827581806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_1730318188114447_3592727335492222001_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlvoqoL4lZcQ7kNvwFmjiaR&_nc_oc=Adopk3_2iwAksahCyxC_YTRlTnjS8wHsLbUz_U1NlZh4Lr0DeVG6EU8g6s0hLv1ghgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJni4vX7LC7R3QG2qJ_BcSI0vgUFeZ66spNzauK5rujVA&oe=6AAFFEB0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "
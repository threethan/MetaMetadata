237411632_1764336261388046853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC4UTTy8Wl0Q7kNvwH-9fuX&_nc_oc=AdoTMLsHBexpaX6I1M5wa9sYM-GziKjKkZOO0hNRlVUXRZczTkYNdqkSGsNGRDyl4sE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6xLpcUdjIVdIXxDKFeJZItNADCL1keVBEZFE64i4_qA&oe=6A5B7F79"}, {"file_name": "screen2.png", "id": "592393143304615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499321095_592393146637948_3230839892818384606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEYGxgoQHEwQ7kNvwGFiHx6&_nc_oc=Adpjfa96S9IGlaQVwcMZ6NEKMlV1hQ0VjyzyQ3JEh6Pk1pT0oniwMZAzXHAFFNecp1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEQJgEUvQ2xczPxVMk2ZPQXRjrjw_5-2Go0QCHfwtaFQ&oe=6A5B6FDB"}, {"file_name": "Screen1.png", "id": "1893105654844648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331948_1893105658177981_5905574729725670140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRta7UseS5kQ7kNvwFRID_3&_nc_oc=AdoDBWjcPCvaqY_2-F9y8oKm4QSlztomCWh2zm8R5hlTh39uZvQ8sUUO7oxUPb-SUW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtIdHe5ersosKPVt0-xcRcKjSniRYqJErqyNHC5_bveQ&oe=6A5B74CF"}, {"file_name": "screen5.png", "id": "1224927135876245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396978_1224927139209578_764402035138883071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvDiBAHG71MQ7kNvwEQWbLW&_nc_oc=AdoYvZoWtm-LyMXDvzuYL60T-cmkIHjDaT02tR6EDzBnuTA_Hi0pN9if2CL_T_JSm94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3GtOQFsJwqFuvCe5EjRhxcYkriizXCOOLV8cm8cLqeQ&oe=6A5B811E"}, {"file_name": "screen4.png", "id": "723408736786262", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499324939_723408740119595_8035685698945450130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIjTIr26PAcQ7kNvwHydTUD&_nc_oc=AdpxqOsE_8vXkPTzwqGaxIIaNQidqPiK73QteTGJiufgPtn8Tok-KCit8jh5knBMtjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ0GaEP0-LyCzdsdisnfDWbO5QXFBVOQUnQkw9pNzcXg&oe=6A5B8218"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Guard", "keywords": [], "long_description": "# Scan fast\nTime\u2019s ticking \u23f1\ufe0f, the line\u2019s a mess, and someone might\u2019ve stuffed a bomb \ud83d\udca3 in their bag\u2026 or under their clothes. Fire up the X-ray, scan the luggage and the passengers. Let them through \u2014 or not?\n\n\n# Clear the passengers\nSearch hats, shoes, and pockets for bubble guns \ud83e\udee7\ud83d\udd2b, fireworks\ud83d\udca5 or even a bomb!\ud83d\udca3 and other absurd contraband. Catch them \u2014 or they board!\n\n\n# Unmask the weirdos\nUse facial tech to find wanted smugglers in disguise. Pull off hats, glasses, or wigs \ud83e\udd78 (don\u2019t let them fool you \u2014 even if they look like grannies\u2026 or superheroes).\n\n\n# Stamp\nIf all\u2019s clear, stamp that passport and keep the line moving. Miss one? BOOM! \ud83d\udca5\u2708\ufe0f  Laughter guaranteed.\n\n\n**Join our Discord crew \ud83c\udfae \u2014 news, updates, giveaways, and surprises await! \ud83d\udc49 discord.gg/etermaxrstudio**", "short_description": "BECOME A FEARLESS SECURITY GUARD AND KEEP THE AIRPORT UNDER CONTROL! \n\nScan fast, clear the passengers, unmask the weirdos, and keep the bomb off the plane\u2014or everything blows up\u2026 with laughter!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
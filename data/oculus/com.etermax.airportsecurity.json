9bKMfWRnAN1vEpg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPunIVVlCmzbaBApaIJ7tt4hV-4DBa6yQ-3RmcM8AdK0g&oe=6ADCCE6A"}, {"file_name": "ASG_Halloween2026_SS02.png", "id": "2069870617231384", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831964_2069870620564717_8520357803479579746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItGNMF1CszcQ7kNvwG6rCMJ&_nc_oc=AdqC6oRMz6sIxfWJPkZsxRuP5Nlz62kfYp14zJ24h1qCeRniRiapazj_nrVz9Oc2HXo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-f6SmR_QY_qMZpMEJHyHlmXtyfD2UZQaY9rlZwZvFsg&oe=6ADCBD34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirportSecurty2560x1440_V_Halloween.png", "id": "1130969393215684", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/596061819_1130969396549017_6752460223589499217_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHyIPu4th30Q7kNvwGp1VXm&_nc_oc=AdqIxk7kHUI8YPhfKM-bt_4a35cUc-x39PghAh43IieLrFxjLAUgeRi_baIXJJVaETA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQKKQZLyG8GpS2UCBriXzs34dEHdQoffZRqtZ6HxfPYg&oe=6ADCBAAE"}, "display_name": "Airport Security Guard", "keywords": ["airport", "security", "guard", "chaos", "fun"], "long_description": "                                                                                                                                                                                   \n                                                                                                                                                                                   \n \n{1840570270315289}\n                                               \n# \ud83c\udf83 Halloween has officially landed at the airport, Rookie! \n\n{1288071953444443}    \n\nThings are about to get spooky, so gear up with the Spook Squad Kit and bring some Halloween chaos to your shift. \ud83d\udd77\ufe0f\ud83d\udc7b The creepiest passengers are waiting!\n\n{967463802916746}\n# Patrol Partner \ud83d\udc36\ud83d\udc3e\n\nMeet your **loyal Patrol Partner**! Your K9 companion helps you spot suspicious passengers, uncover hidden trouble, and stay one step ahead. Feed and grow your partner to unlock even more helpful abilities.\n\n{2045802276146832}\n\n# Sabotage Tools & Kits \ud83d\ude08\ud83d\udd25\n\n**Create chaos** for rival guards with powerful sabotage tools and combine them into Kits to take control of every shift\u2014from Cadet to Captain. \ud83d\udca5\n\n{761738103289314}\n\n# Multiplayer Mode\n\n**Compete against other guards**, slow down rival lines, and prove you're the best officer at the airport.\n\n{1624144522631354}\n\n# Keep the Airport Safe\n\n**Scan bags**, **inspect passengers**, **uncover contraband**, **search the new Baggage Claim**, and **stop every smuggler** before it's too late. \n\n{694386776531919}\n\n# Stay sharp\n\nTime\u2019s ticking \u23f1\ufe0f\u2014**scan bags, check passengers, uncover contraband, and keep the line moving**. Miss one? **BOOM! \ud83d\udca5\u2708\ufe0f**\n\nJoin the community: **https://discord.com/invite/etermaxrstudio**                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              \n                                                                                                                                                                                     \n\n\n", "short_description": "BECOME A FEARLESS SECURITY GUARD AND CONTROL THE CHAOS! \ud83d\ude08\u2708\ufe0f\n\nThe airport just got bigger! Explore the new Baggage Claim area, recover suspicious luggage, stop smugglers, and keep passengers moving. \n\nTeam up with your Patrol Partner \ud83d\udc36\ud83d\udc3e, use powerful sabotage tools to outsmart rival guards, and turn every chaotic shift into your chance to climb the ranks. \ud83d\udca5"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28381427741556639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831393_1952092462816897_6974513241493218990_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRsQzgthbfEQ7kNvwG5RTXO&_nc_oc=AdqEdDAkCvjet4aQiPEHRW_qqQWJyhI0etcgAcABkEeXrP5PtSkkEohwW5h6ZQh8_rs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4EiW2-tBe0AZxCtcbtz_gZe9PxIRsfQsDs0snomxCOw&oe=6ADCD1EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Airport Security Guard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603
hWCtPZOmcCxXLXQ-PQDZO_X79gxj0S8JVlgu80hpOHiXRgcPdBL0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF5mZEIR9VlrQM-wGLIT0tSOENDQN9vbLq9PvPjpfPAw&oe=6A4E6FF1"}, {"file_name": "RiverScene.png", "id": "1810685069553157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499297237_1810685072886490_1470668139499833326_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hslfZ3SiQ5kQ7kNvwH08yhE&_nc_oc=AdrWvz0hZKgMKa7H_XWAmn4YlY2nLG42yAHGuk8F2yNLkCjfUVJJpBQxx2ELJUZoDik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj62BprSG8jGXvfh-eawjB5ZQyvBj_bK__7b3M1YzpmA&oe=6A4E3846"}, {"file_name": "BoatScene.png", "id": "1877832236279364", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618440_1877832239612697_9193727457701118033_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8z7lFPxHWkQ7kNvwH17iWY&_nc_oc=Adq1aeXMCreaHzqAK-BiUXVcuTHmpNbjznCR12UOo5gjPtZP5ZmcYUCafm7yh2U4j8c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3y4vP4lUDxGe-Hbp2IDJDtGBbdu2st5FiYkxLFB2iSQ&oe=6A4E5F72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World of Wonder: A Curious Journey", "keywords": ["education", "wonderland", "fantasy", "puzzle", "adventure"], "long_description": "**Imagine a world where Alice's Wonderland frames immersive learning experiences.**\n\nStep into a *World of Wonder* \u2014 a first-person, immersive experience where curiosity leads you to explore, create, and collaborate. Each encounter invites you to question, reflect, and think differently about the world around you. Designed as an evolving prototype, *World of Wonder* challenges your thinking through interactive moments that spark inquiry and imagination. Future versions will expand these experiences, empowering participants to explore real-world problems and imagine innovative solutions.\n", "short_description": "Step into the shoes of Alice and journey through a wonderland of immersive moments that provoke inquiry and challenge your thinking about the world around you. Question, reflect, and think differently as curiosity leads your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avc.web.usf.edu/app-policies/WorldOfWonder/", "developer_terms_of_service_url": null, "publisher_name": "Lindsay Persohn", "support_website_url": null, "website_url": "https://avc.web.usf.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25435021996135234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618271_1293932232421946_6711113916934430490_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w5mbG5gb04Q7kNvwGSQ1wk&_nc_oc=AdoSEwL4KdicE7aW1hQa73tmVTCReHdrJKa3ZcUaSusNWUDLgufYWs-pmHWmA_ezavA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2RECXI7k894FROFC88A0_XPy7bUb6jadUzUvQRKvQ6g&oe=6A4E6995"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "World of Wonder: A Curious Journey", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1763995
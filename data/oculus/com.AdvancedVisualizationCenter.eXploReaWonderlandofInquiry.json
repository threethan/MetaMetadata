 challenge your thinking about the world around you. Question, reflect, and think differently as curiosity leads your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avc.web.usf.edu/app-policies/WorldOfWonder/", "developer_terms_of_service_url": null, "publisher_name": "Lindsay Persohn", "support_website_url": null, "website_url": "https://avc.web.usf.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25435021996135234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618271_1293932232421946_6711113916934430490_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2h7vVQOtBoQ7kNvwEdTRq4&_nc_oc=Adph4HXYzJScJ77O2C4fcDMO0R-DsxX22mBiDBCHv4uFrno4geXzxt0jFU-ra2twhM8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfC5dKZ9ItVwy81KR3SmWNi24ctkx46TN56x9XJJx3cA&oe=6A6F26D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "World of Wonder: A Curious Journey", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1763995
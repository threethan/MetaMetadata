less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvvbiBLLnSsQ7kNvwGcOJ0u&_nc_oc=AdoPNuDOdHLmzce-Z9QvyK_phLIURCcdAG1TvlULzjUTtI-GpcJ8Z3Nr1igu8Z_TqgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJhIGgCsJrtbgCl4r9r5rF_nNF8dvb2-RPy8b2hfoYdg&oe=6B0DA8DC"}, {"file_name": "05-puzzles-2560x1440.png", "id": "1661307795392388", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1661307798725721_5420563424431149454_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2oSu1J9wwEQ7kNvwGUHoII&_nc_oc=Adp08VJEUm8yTxf3KM09emA6pXR9B0NiN4YFAiHPgAD_r6sUbOaf0Zds3rUXLQbgPcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtEcOpU53Lh27gFmR0dKcbjyeRrUl4zD0a1-OtXu8zTw&oe=6B0DA117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Free-trailer-cover-2560x1440.png", "id": "1180099091354693", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1180099094688026_868355909318226793_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezm0ZVGxTBcQ7kNvwHawcWU&_nc_oc=AdrKWMBDjlbQR6gCSLttqxRxyhzhtEVv5PT72YByL5bauaP-YTEuGZotYE90Nw8d44E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtrnD-UjqYlcyuol0RpyoBY1p43E9nshOSWwM_ZUS7_A&oe=6B0DB309"}, "display_name": "Virtual Comic Reader", "keywords": ["comics", "manga", "ebooks", "pdf", "puzzles"], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372516875952067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1637482021371554_5586726147933186917_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U649OhgsGoAQ7k
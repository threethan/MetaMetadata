hawNoeN4_qYy4Y99Ag0SAexATXeI7cC4DHoUdx73dlCuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4b48X-BqmanFGOB8u_sYKr5xDKPWPItBt1cnjVJC9CA&oe=6B0C5B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11-trailer-cover-2560x1440.png", "id": "3547069968797462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_3547069972130795_500480689004459587_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBtvnoOtsnQQ7kNvwHZX3Ly&_nc_oc=AdopLdZ5UIvqEycIUwNLLG_MeRYOqN2FqifpN2EGdz_bK3K22bCTGfA3g17VOeFV0PE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1UvktsbqvZ0mMHkYF_lKoRUQACE9N7RW9iPlDabtVvg&oe=6B0C720D"}, "display_name": "Virtual Comic Reader", "keywords": [], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1166187516585005"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1973826356625824"}]}, "baseline_offer": {"id": "1973826356625824"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790805600, "status": "PUBLISHED", "id": "1973826356625824"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1397317896805298", "version": "1.0.1"}, "id": "1044848968241346", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1166187506585006", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1397317896805298"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [
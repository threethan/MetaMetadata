Ah-oatmlaUQ7kNvwGc3FHb&_nc_oc=Adqq0x6Z08PsWtQ4VQnPwaYZ3wvW6FHA1vL7cM_POYVGdkg7KeYuND_3JuDtaedkIEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDn-rDxw-2Ps2hXr0smIsvZjifwwxdY0Ru1WjvcPo0FA&oe=6AC675F3"}, {"file_name": "05-pro-seaside-reading-2560x1440.png", "id": "1746550566554384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827973_1746550573221050_5118268094410036898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAcHbUP7lEMQ7kNvwFsD2Xm&_nc_oc=AdpqQWU7pLiFckbujigt8tGaZosKyiBsznHiKXYZCRW_IzwGb8l0xvts-x_2UnJB1CM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFC0VsvVjrxnbqLWzURUzZwAI0DFdEx3IPrx7nNLUYrQ&oe=6AC643CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11-trailer-cover-2560x1440.png", "id": "3547069968797462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_3547069972130795_500480689004459587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgdmtQhfjDMQ7kNvwF_-XyV&_nc_oc=AdqHG9-S_ej--n98NeinBp06RC1qJqZx7HEP3wTfcWIyrmeOvBznWFyI7EXxX8xv2FQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6fp5XIPzGKzhUd0wQPjEJB2s9m0vZOYg2eF3VjjLOhQ&oe=6AC65A4D"}, "display_name": "Virtual Comic Reader", "keywords": [], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1166187516585005"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1637482021371554_5586726147933186917_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj9GMWj85IcQ7kNvwGR1duJ&_nc_oc=AdpKFEHwF2HNjlEDp9wTzW-xQE2vN6ZNPdXnb8RijMAQbCXKRkYDZ-8KNXSB3a1g6bM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
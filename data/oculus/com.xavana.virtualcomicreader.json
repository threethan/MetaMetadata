JaEX03o4PG1TD49unqQrFYNqEas8VOvu-XiFK429bOLtkbWzeEFuOwk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZxav3mYGb9XOhkk9ETPEDQigTVWCdVZxgYB2-OjemeA&oe=6AC90DC5"}, {"file_name": "03-settings-2560x1440.png", "id": "1092542206492898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825563_1092542209826231_6605665016730644158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zvdjIdAe0IQ7kNvwF-30fy&_nc_oc=Adr5U7HVPQPgFBq3rd8iIPYvD-Eltat3qlLZI4oMH7nykT6_HBJs7o2S13vjab9gB3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbhY7sK5gUSbNuLbfyVeJYWnqdnczgSHju46FlcLfmJA&oe=6AC8F626"}, {"file_name": "04-page-adjustments-2560x1440.png", "id": "1394398162337217", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824292_1394398175670549_2869186266617445000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P2A-bDaolsQ7kNvwFgQLMx&_nc_oc=Adp7fp8fq_FcVjyvv-b11GGiNWM6UWBtutv-RN5wakp5JnZdVHPXuLrNz-5W-St1kOE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx0qodnbaPnbSTBKv3n1ILjJvPPsEg2DG6Rfz8HtwMAg&oe=6AC918F3"}, {"file_name": "05-pro-seaside-reading-2560x1440.png", "id": "1746550566554384", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827973_1746550573221050_5118268094410036898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed3GxBQ3ZdAQ7kNvwE-Coli&_nc_oc=AdoK96x8uko_2RKyJi1RAyLLeG01rXgdAe4Zu6jQRI5i6RiCfoyxwKyCj4_IcvumXeI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxffZlKdYpJFaqV_zWuLLiJelySaqitk2HreAUJllPhQ&oe=6AC8E6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11-trailer-cover-2560x1440.png", "id": "3547069968797462", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824700_3547069972130795_500480689004459587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7tdceqvF2kQ7kNvwGB7dah&_nc_oc=AdqYM_AsIEAxzEdcgk7feWjuj-Da5u4nc6MEpTxybg-B4szKd9t-zmLWt-9sGLqj5Lw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Q9unv7YPmoraVvZRKCYphJjQgzImWW5i1JLnPJfcig&oe=6AC8FD4D"}, "display_name": "Virtual Comic Reader", "keywords": [], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscrip
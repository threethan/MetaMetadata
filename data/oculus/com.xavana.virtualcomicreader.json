8_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1uFKaGinX4Q7kNvwGq_4df&_nc_oc=AdpxpFV5htQsgY-HfIqQ1zEwYVYVwuKX6WAgv12J8dnxu7DECBg1J3o1oFyUCvPcJQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy-uICgXFY83J_HDTN4FkTQ1EZwoYpMSYBxsGNC1lF8g&oe=6AF5C926"}, {"file_name": "04-page-adjustments-2560x1440.png", "id": "1394398162337217", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1394398175670549_2869186266617445000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW6Kdqn2aPcQ7kNvwHbd-qE&_nc_oc=AdrpZAL6KAkjtMGUlj-JGq2-cbfrV2uofrfuMLjixUgylB-33vnIpVyf22qBlB_pijU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqILKC5IY4gwCs7IzrB-yllcE6s7a9KwOQncmOHY0clA&oe=6AF5EBF3"}, {"file_name": "05-pro-seaside-reading-2560x1440.png", "id": "1746550566554384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827973_1746550573221050_5118268094410036898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhEOLg4p1akQ7kNvwH_mf2o&_nc_oc=AdqhOdNgfOF3ihFSdw5qg0e4CZ5VN_X6DEVEmI8nywfrpt-MPar6eJVG5_o4YVUvbP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRarg_-3GeSs0t3SVzLaI4sqEc8hCAF8GX7799HaL6Q1Q&oe=6AF5F20A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11-trailer-cover-2560x1440.png", "id": "3547069968797462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_3547069972130795_500480689004459587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a395KD9jmXkQ7kNvwEb767c&_nc_oc=AdrlZhnnyJe5vlYGFaPLL2wjR_IeAhtqrK4YXSkMA43EJryoCtVSWHc3ocRrsJRTwxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtq2uFzJ59TtwUP6XV6SyjkydGHjtrF8ybdseRFd5n8Q&oe=6AF5D04D"}, "display_name": "Virtual Comic Reader", "keywords": [], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITT
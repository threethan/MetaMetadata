8_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taYmPzbR12cQ7kNvwHRrkD0&_nc_oc=Ado92vUUTQ6OCuEaIogK0chcAqvCscBhWobJVJmtLBKboO3g0dqRgID7BXaWR-RpW48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThaPvW9KKaDgXqIQmXsrnPKnVvcrLpS7CRtLzdC7tPPw&oe=6AF32626"}, {"file_name": "04-page-adjustments-2560x1440.png", "id": "1394398162337217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1394398175670549_2869186266617445000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW6Kdqn2aPcQ7kNvwEJ5HsP&_nc_oc=AdpmyJoPKSCnP0ZpxfwjfQw5n0UUcSVwy4pGv63CeahiJHU8WZFpcjcbtkNIQ3h2sgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy098x8-odjms8_QI4TeyUTJl7ANmBGAB15H_7IhbdKA&oe=6AF348F3"}, {"file_name": "05-pro-seaside-reading-2560x1440.png", "id": "1746550566554384", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827973_1746550573221050_5118268094410036898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWMTAt-iqnAQ7kNvwE-4Ymw&_nc_oc=AdqJPsWeE4aK_K8fG-D5lxClMf7e_uzmi5hTsyxWsbehqufh6yg5NM5zEcK8nvzK1Wg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtxNCfGenwBNyH_p7KECeMHQHojruTRvjjBrX7vCV1vg&oe=6AF34F0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11-trailer-cover-2560x1440.png", "id": "3547069968797462", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824700_3547069972130795_500480689004459587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjCPTIA1EI0Q7kNvwHwrRLT&_nc_oc=Adqtk8VgHreqdiFJ9SF-Ws4hX3hRSE8an9jj4Q0_NPiGKhBA4bF6uPf53OXv4yUe3Ho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQp8upPeLNXDpbkvvC0FJwpZpqSXwUKYGEGFAlRuwFXQ&oe=6AF32D4D"}, "display_name": "Virtual Comic Reader", "keywords": [], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITT
5118268094410036898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep0ribE60DoQ7kNvwE_QpNO&_nc_oc=Adrvy49nu0IrtZYeiwdxsPRMQHCLltg9cTnCLYl_rbMmrvZIU_SzR2QkW11H2S5fuTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu1iMv8KWT_3Qpg_0ZL3ujU5zdHqbDsD2bJl4qybM9nA&oe=6AD2598A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11-trailer-cover-2560x1440.png", "id": "3547069968797462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_3547069972130795_500480689004459587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3yveXC1wE0Q7kNvwFvB_dV&_nc_oc=AdqL1D_l5wPw7FRYokGExUfRAyZ96XQEMAmEuTOzDxuD4jLU99ly0e6dnQzwnE2jLfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ_i5KJQEKJDEwPhpb3fYVNZ65rjTADVFnVqziJtdbvw&oe=6AD237CD"}, "display_name": "Virtual Comic Reader", "keywords": ["comics", "manga", "ebooks", "pdf", "puzzles"], "long_description": "Bring your own DRM-free publications into Virtual Comic Reader and make space for reading on Meta Quest.\n\nRead CBR, CBZ and PDF files with single-page or two-page views, right-to-left manga reading, bookmarks, favorites and saved progress. Organize your library into collections, adjust the reading view, and choose a virtual library or a distraction-free black environment. The included guide helps you get started.\n\nImport your files with Send to VcR. Turn eligible comic, magazine and manga pages into jigsaw or sliding puzzles.\n\nThe Free edition supports up to 15 publications, five collections and files up to 60 MiB. The optional Pro upgrade expands the library to 1,000 publications, adds DRM-free EPUB, AZW3 and MOBI support, read-only SMB imports, more scenery, additional puzzle sizes and saved display settings.\n\nOn Quest 3 and Quest 3S, passthrough and wall-poster features bring artwork into your room. These features are unavailable on Quest 2.\n\nBring your own content; commercial comics and books are not included. DRM-protected publications are not supported.", "short_description": "Read your own comics, manga and PDFs in a virtual library. Organize collections, save your reading progress, and turn comic pages into puzzles. An optional Pro upgrade adds more space, ebook formats and customization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xavana.com/privacy.html", "developer_terms_of_service_url": "https://xavana.com/terms.html", "publisher_name": "Xavana Consulting", "support_website_url": "https://xavana.com/index.html#contact", "website_url": "https://xavana.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290368314166924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1637482021371554_5586726147933186917_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIqkgYanEckQ7kNvwGq-I21&_nc_oc=AdrOtYOSy7jp36xHebLpWjOxgnHt7PC4rX7MPDUW5wx3i--kMQ8xgrmFJ1I1NhtDA2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0DalImGKzZx0xEpDDZL8WDFLsf3BaTh1lS-S2Fkojcg&oe=6AD24E15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Comic Reader", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "r
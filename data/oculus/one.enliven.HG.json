euwd hoe het voelt?", "short_description": "In alle lagen van de bevolking komt huiselijk geweld voor. De gevolgen voor kinderen zijn enorm en kunnen leiden tot onder andere een laag zelfbeeld, angstgevoelens en depressie. Deze VR simulatie maakt het mogelijk om in de huid van een 7-jarige te kruipen die zijn ouders ziet ruzi\u00ebn. Een intense, maar leerzame ervaring die hulpverleners, docenten, studenten en zelfs ouders een nieuw perspectief biedt."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.enliven.one/privacy", "developer_terms_of_service_url": null, "publisher_name": "Pro-ductions", "support_website_url": null, "website_url": "http://www.pro-ductions.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "400087565210859"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "5405197882828344"}]}, "baseline_offer": {"id": "5405197882828344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1646694660, "status": "PUBLISHED", "id": "5405197882828344"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4431900383577556", "version": "2.4.0"}, "id": "507390806933671", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Android
culuscdn.com/v/t64.5771-25/75251817_421623249610082_3596064596002787115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HcGC2AyccMQ7kNvwEf4C0r&_nc_oc=AdrZweJESR8K3xmMLg511sfLYjaib7g1i7AdNWDszZPdry2VfgdLfRoY3VMD9wjFJ2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBfQ_CwK319LqnQADRKcpbeg8yRJXBwzBIoi1o7K7Yew&oe=6AAA8F9E"}, "display_name": "Huiselijk geweld", "keywords": [], "long_description": "Huiselijk geweld.\nIn alle lagen van de bevolking komt huiselijk geweld voor. De gevolgen voor kinderen zijn enorm en kunnen leiden tot onder andere een laag zelfbeeld, angstgevoelens en depressie. Deze VR simulatie maakt het mogelijk om in de huid van een 7-jarige te kruipen die zijn ouders ziet ruzi\u00ebn. Een intense, maar leerzame ervaring die hulpverleners, docenten, studenten en zelfs ouders een nieuw perspectief biedt. Ben jij benieuwd hoe het voelt?", "short_description": "In alle lagen van de bevolking komt huiselijk geweld voor. De gevolgen voor kinderen zijn enorm en kunnen leiden tot onder andere een laag zelfbeeld, angstgevoelens en depressie. Deze VR simulatie maakt het mogelijk om in de huid van een 7-jarige te kruipen die zijn ouders ziet ruzi\u00ebn. Een intense, maar leerzame ervaring die hulpverleners, docenten, studenten en zelfs ouders een nieuw perspectief biedt."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.enliven.one/privacy", "developer_terms_of_service_url": null, "publisher_name": "Pro-ductions", "support_website_url": null, "website_url": "http://www.pro-ductions.nl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
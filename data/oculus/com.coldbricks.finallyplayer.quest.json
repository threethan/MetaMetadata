25556", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ5tRgIfOMgQ7kNvwFjK01S&_nc_oc=AdozWWD9Bx4nIaFxyr2Kof1RvV-iN0e7oyRjtflSGQRMyJKH1UtVUiI2Z7dvyz6JgvY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlKjlmtlfB5VsooOuHYSR-gp_AwRHoLKWavQ62P3gcFQ&oe=6A91660B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgvIf-gml2sQ7kNvwFP3x54&_nc_oc=AdonZCpKDqj6gft62Z7s0KqVv-GDv5H6T_VodmErlg1TmF56m3wm1THIezKLtBTt54Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYBxFlbzkQF6Xvhi4-A7R4SiG4eUfbgs_9ZX1e88L0QA&oe=6A918A60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg-q7sIt6B0Q7kNvwE93UFa&_nc_oc=AdqkhpZS4wGmDBXT98sPU39ol6VjW0U3uKgPUpnPf8t7KAPZKfmvdgqYGKKvKRWvHpA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEczFTmrfdgxBagaTUCQ5tozla0DLf1gE4JPyVSFoZXRQ&oe=6A916243"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161567437048700"}, "review_messages": []}]}, "cover_square_image": {"
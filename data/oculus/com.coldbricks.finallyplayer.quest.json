cdn.com&_nc_ss=7f20f&oh=00_AQF3LJeqllJ3Mw6Lmzh8vkmeWlnhdeeT-rRFPGQW5fupsA&oe=6A707FA2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifzAFlDdnVEQ7kNvwHvexZ2&_nc_oc=AdpB9n9mu50U3OK4dUsAZxcWyA9_GPX4M6jA93qVf3uoU5vib_scd3_4Df6CfoA0JWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbudt76hKjIQOjVBZ3WMVmZR_Qx4NXoheAVTuzG64sHg&oe=6A7096AA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HsknlwhpNsQ7kNvwFewayB&_nc_oc=AdrrawKK_c_AjVxalPPbB-gaQUendMVDXgb6B_5pkRZH6TgsWEfWpKZP2Oa3nu3GP-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbhDXpS4gOtZuOxnlOkSD99HkCVqrcXt7GE_2VB5sBYQ&oe=6A70A25B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrwMi1sElXoQ7kNvwF7Pne9&_nc_oc=Ado09pUwSKieQdQu0LjLkCgmnru0hds8nPENpAPONdzyQcBJnC913_54oT0ONX6mOWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6gPibP7bALxZNlCCxpDHXy7PoFzH2rh8C1uOgnRJITA&oe=6A708FC4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQt-djRxzsQ7kNvwFHF8tp&_nc_oc=Adp_6r2_cumO2AFN5XeHDHY2hFTOJd5pZPO8NIKFs2oNbK8qojFyRGlz2-m_FYBiPbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSlyR2x00JQxvi1QINh-w_5_YMDsu84zrUrnQhVylUwA&oe=6A70A8CB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYkwgIf_6x0Q7kNvwGH-ugN&_nc_oc=AdohKgl_cma9aZUW5GYMfg3dO13aMVF2wKTHIWSUavQlmN5S0FTI2fIe0z-ZbBHIKfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQr5wwq54xvbW9qaHvGZysChkGp9VFyrxhNQUxERq5dA&oe=6A7094E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d77vvOmxEyoQ7kNvwEM5ohu&_nc_oc=AdreU7gTCadzefZkwXQnJxwXwDR5dgI0MExUdWisxSgDgQBzJMNtOp1Buq6I3r5wClI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHktaFl_6ECTouBiei9LtjLk7nL-TxjEYO1SzkL7ogsHw&oe=6A70A503"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1173979475807496", "version": "0.3.24-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1173979475807496"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.24-m3 / Quest code 30:\r\n\r\n- Subtitles now keep a consistent readable size instead of enlarging short cues.\r\n- Added external SRT, VTT, ASS, and SSA subtitle selection, clear EMBEDDED/FILE labels, and saved subtitle looks.\r\n- Refined the immersive menu with clearer hierarchy, spacing, contrast, selected states, and subtitle controls.\r\n- Hardened WebDAV range reads, remote MKV opening, ISO/MVC lifecycle handling, and large-library scanning.\r\n- SMB rescans now remove stale titles safely, save work in bounded chunks, and avoid leaking media paths to logs.\r\n- Improved first-run guidance, 8K environment memory handling, XR shutdown, trusted-LAN connections, and Watch Together joins.\r\n- Includes the large Plex/NAS sorting, resumable scan, WebDAV MP4/ISO, VOID room, and controller fixes.\r\n\r\nNetwork servers and media files vary; this remains a pre-release build.", "created_date": 1785356983, "id": "1173979475807496", "version": "0.3.24-m3", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1173979475807496"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.23-m3 / Quest code 29 hotfix:\r\n\r\n- Fixed large Plex/NAS library sorting crashes and the relaunch loop they could cause.\r\n- NAS folders now open immediately; full-library indexing is optional.\r\n- Prevented duplicate scans, made scans resumable beyond 25,000 files, and reduced database overhead.\r\n- Unsupported-file warnings now include example filenames.\r\n- Fixed ordinary WebDAV MP4 playback and added clearer WebDAV errors.\r\n- Restored the black VOID room.\r\n- Added WebDAV ISO support and hardened remote ISO positioned reads.\r\n- Fixed trigger+grip menu conflicts and added a B/Y menu-button swap.\r\n\r\nLimits: Live third-party NAS/WebDAV servers and ISO libraries vary. This hotfix passed automated, build, lint, and physical Quest/Galaxy checks, but not every server or ISO combination can be guaranteed", "created_date": 1785347110, "id": "1173788089159968", "version": "0.3.23-m3", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1173979475807496"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.22-m3 / Quest code 28:\r\n\r\n- 3D Blu-ray MVC playback now keeps stereo through saved resume and authored chapter seeks instead of silently falling back to the base 2D view.\r\n- Adds direct standalone SSIF and direct MVC MKV/MK3D playback through Chloe MVC Engine 1.\r\n- WORLD now opens a large, non-scrolling ROOMS grid instead of blindly cycling backgrounds.\r\n- Import custom room backgrounds by adding JPG, PNG, or WebP files to Movies/Finally/environments.\r\n- ROOM DIM independently controls room and passthrough brightness without dimming the movie, subtitles, or controls.\r\n- Projection and stereo overrides remain saved per title; RESET/recenter restores placement when a title opens off-center.\r\n- Keeps the faster bounded SMB browser/indexer, AFR/Stats, folder sorting, tutorial, privacy-safe bug ZIP, Watch Together, AV1, and clear-sector USB DVD work from the previous update.\r\n\r\nLimits: MVC is for eligible unencrypted media at 1.0x. Blu-ray Java menus, AACS/CSS, protected discs, and feature-length compatibility are not claimed.", "created_date": 1785294675, "id": "1172739899264787", "version": "0.3.22-m3", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1173979475807496"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.21-m3 / Quest code 27 / Galaxy code 10027:\r\n- Adds three 8K rooms: Ash Airfoil Loft (the real Smithtown 180\u00b0 photo stage), Loft Night, and Reference Dark. A responsive ROOMS grid selects bundled/user rooms directly. ROOM DIM independently controls room/passthrough brightness without dimming the movie, subtitles, or UI.\r\n- Adds eight folder sort orders, confirmed local-file deletion, no-repeat shuffle, a six-step replayable tutorial, hand-accessible PRO controls, a saved OFF-100% haptic-strength slider (Quest default 100%, Galaxy 55%), AFR hints, and an honest Stats for Nerds cadence/refresh lock readout.\r\n- SUBMIT BUG REPORT creates a bounded privacy-safe ZIP, tries email then the Android share sheet, and otherwise leaves an explicit manual attachment path; nothing silently uploads or sends.\r\n- SMB folders browse immediately while large indexing resumes in bounded pages. NAS errors are clearer and high-bitrate read-ahead is pipelined and memory-bounded.\r\n- Adds WebDAV, local Plex Direct Play, Stash, and trusted-LAN FTP source flows.\r\n- Quest 3 and Galaxy XR physically passed local 3D Blu-ray H.264/MVC OpenXR and Club A/V gates for the locked short ISO. Quest also passed one exact SMB MVC ISO run.\r\n- Adds same-LAN Watch Together Host/Join for byte-identical media, hardware AV1 Main 8/Main 10 HDR10, and Quest clear-sector USB DVD-Video title playback.\r\n\r\nLimits: AFR does not interpolate. Plex has no transcoding/cloud login. Watch Together does not relay files or provide Internet rooms. DVD has no CSS/menu claim. MVC currently requires a complete eligible ISO, start 0, and 1.0x; direct MVC MKV/SSIF, seek/resume, protected discs, and feature-length endurance remain outside the claim.", "created_date": 1785289715, "id": "1172659355939508", "version": "0.3.21-m3", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1173979475807496"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Playback fixes for stereoscopic and flat videos:\r\n\u2022 Improves automatic and manual FULL/HALF SBS and OU geometry, with explicit controls for distorted 3D.\r\n\u2022 Adds per-video flat aspect choices: Auto, 16:9, 4:3, 2:1, 2.40:1, 1:1, and 9:16.\r\n\u2022 Shows the selected environment behind flat playback.\r\n\u2022 Prevents unintended background autoplay and improves pause/resume, per-title settings, and high-bitrate network memory handling.", "created_date": 1785040879, "id": "1168029419735835", "version": "0.3.19-m3", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
tent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOQSd6umLmoQ7kNvwGov9Yf&_nc_oc=Adrk0sy38gtshcYeJs60nxn3U60mbmCCaRro7fSF1HUoPSYU6uykYmOoxJkWXy9Llhk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBTXSsu-52rBhMwPaPObVjUL5ObtMwxDCQhfvq0FQZ5Q&oe=6A68BFCB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M5zigyFxr0Q7kNvwFhN84z&_nc_oc=Adrlu10QkZYcJK3-UN4CeyRb4oGvvcJkAifrqf9WjiR3d74GjimxGfZlBfCDRK5CD5s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh9yMYjd33rlbb7SbF5iluEf49--PpdMneT8eJxrKKFQ&oe=6A68ABE0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH9LUhlbOs8Q7kNvwFaszpy&_nc_oc=Adqn3HO6Elv2TO_l7sFlWNfikvrmWpmiAyE-WaOXNzIQK4jz7PxOaItAOEdBe7NPp2Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBKtsKYek2eVMbMeeO4WuI7HAAnSXXpiy5oeOYUP7z4g&oe=6A68BC03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1164111923460918", "version": "0.3.18-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1164111923460918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Stability update 0.3.18: fixes known memory pressure when streaming very high-bitrate videos from network shares.\r\n\r\n\u2022 Bounds network playback memory to prevent high-bitrate SMB freeze/lockups\r\n\u2022 Reduces retained network rewind memory and improves rebuffer recovery\r\n\u2022 Adds a safer low-memory fallback if the SMB disk cache is unavailable\r\n\u2022 Fixes a crash when rescanning Movies / local Import folders\r\n\u2022 Fixes a rare crash if you leave the library while a NAS scan finishes\r\n\u2022 Uses tighter SMB read buffers on Quest\r\n\r\nStill offline-first: your files, optional shares, no accounts.", "created_date": 1784822797, "id": "1164111923460918", "version": "0.3.18-m3", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1164111923460918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Crash-stability update 0.3.17: safer folder rescan and NAS dialogs, plus tighter network read buffers on Quest.\r\n\r\n\u2022 Fix crash when rescanning Movies / local folders (Import Movies path)\r\n\u2022 Fix rare crash if you leave the library while a NAS scan finishes\r\n\u2022 Keep NAS playback memory use lower on Quest\r\n\r\nStill offline-first: your files, optional shares, no accounts.", "created_date": 1784785407, "id": "1163420686863375", "version": "0.3.17-m3", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1164111923460918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Added support for multiple saved servers with clear rescan, edit, and remove controls.\r\n\r\nFixed large shares so folders beyond the first page remain visible and reachable.\r\n\r\nMade embedded subtitle and alternate audio controls available directly from the first playback controls strip.\r\n\r\nImproved overlapping-source safety, credential matching, and source removal behavior.", "created_date": 1784754731, "id": "1162941930244584", "version": "0.3.16-m3", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1164111923460918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "0.3.15-m3 (21)\r\n\r\nNew subtitle and audio-track controls:\r\n- Cycle embedded subtitles and neighboring sidecars\r\n- Switch audio tracks while video keeps playing\r\n- Turn subtitles off\r\n\r\nAlso improves long track labels. ISO subtitles remain disabled for stability.", "created_date": 1784710498, "id": "1162089416996502", "version": "0.3.15-m3", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1164111923460918"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Fixed a crash when resuming some experimental decrypted 2D Blu-ray BDMV ISOs.\r\n  Skip Intro now defaults off.\r\n  Truncated NAS scans show clearer recovery guidance.\r\n  Updated format limits and support links at finallyvr.com.", "created_date": 1784691086, "id": "1161783453693765", "version": "0.3.14-m4", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
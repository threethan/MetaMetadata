cdn.com&_nc_ss=7f20f&oh=00_AQFFQBL8AblMrdwliGej01zjoO8lThBZQ6DKFLg4Mb6Ycg&oe=6A8C2F22"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDpalPMhxi0Q7kNvwFDAPIJ&_nc_oc=AdpbO5w_QVnCReRggQn4xnEuOqURJnp062TcBcNnsj_t7islZ2hkyN3XuvH3bXP2ceU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKbwotppU3aA1_eUtzxXFl4jYumWFLoI9uGhxuBWZaSQ&oe=6A8C462A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kWRElSGNm4Q7kNvwH1Knoh&_nc_oc=AdqIgEmg3j9GzNCQ5E3aAnLbeTgM33nNFCh_pI7AMA0FioIB2ZiZx7wOKUg7nAaoH3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Miye2PQetNVjrborm_kgkkQ3f1aqCoUdBsn5HAYzIQ&oe=6A8C199B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z07cdLqelgMQ7kNvwHJ_aMx&_nc_oc=AdpfCiRJfECDRHfnFRXFlF3idZ_iRn_Ephueph1o_ZpKuDbRU3sHV-NDI2mQdCDyvLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Vz2yZ3iHMkIp3WDg6WOoyd46BuW0zGV3alSkAK1Tqg&oe=6A8C3F44"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2At8i1TK50Q7kNvwEjM6FO&_nc_oc=AdrSPTCuMFxsMOdcUNHm8F32TkrA5I1tuhxzuJ1R6VzQpXct7G2OQY7UCOOjz-AuagY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLJJBvW1VqLQVq0dHkAgB4YcvmnCnJg50Hj40lQk_3rQ&oe=6A8C200B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir7gE0cQXj4Q7kNvwFOvczF&_nc_oc=Adrl17gVMp3TKJ_mALlUYwYydDBDvzXXqUSgsSYnAgxiT1aFZMI-JQa98rKGXzy-6Io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjPsYZEcZ7j55ND_YoHHHW6dv4u3NvTx00fV7IPb5IhA&oe=6A8C4460"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seglvzDxE4MQ7kNvwFteH91&_nc_oc=AdpdpgJomG62GLhOHAnTgp9xIpXI456Sp8H-hBOtX520VMiAOpZjpRE5iG9a-_ntE4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZhrR_3djUrcvgEnvEPNNNf4oKJmNpydxL0RHrBOW9qA&oe=6A8C1C43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1210185402186903", "version": "1.0.8"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1210185402186903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.8 \u2014 candidate release notes\r\n\r\n- Guided NAS sign-in, share and folder browsing, exact Test connection, and truthful empty/denied/partial results.\r\n- Cleaner SIMPLE controls, larger VR targets, stable hover, and deliberate same-hand grip + stick title changes.\r\n- Corrected Galaxy XR controller body rendering and safer OpenXR startup/input handling.\r\n- The Handy now shows a controller-reachable HandyFeeling/Ohdoki disclosure before the first request; Cancel and Back send nothing.\r\n- Forget removes both current and upgrade-era local Handy key storage, while cancellation and test queues are race-safe.", "created_date": 1787182585, "id": "1210185402186903", "version": "1.0.8", "version_code": 99, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1210185402186903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.7 \r\n\r\n- Easier NAS setup: connect to a server, choose a shared folder, drill into folders, test the exact selection, then add it. Testing and folder selection do not save the source; only Add & browse does.\r\n- Clearer NAS results: empty, mixed-content, permission-denied, and bounded partial listings are reported as those states instead of as a generic connection failure. Large-library indexing is cancelable and resumes only from a safe checkpoint.\r\n- A cleaner SIMPLE cockpit: PICTURE is one tap away; larger CLOSER, FARTHER, ZOOM - / +, and reset targets handle everyday placement. Chapter, subtitle, and other advanced controls remain available in PRO.\r\n- Safer controller input: hover and live-panel updates preserve the current target, startup cannot inject a held control, and title changes require a deliberate same-hand grip + vertical-stick hold.\r\n- Galaxy XR includes a corrected left-controller mesh basis and winding. Controller bodies follow the grip pose while lasers follow the aim pose.", "created_date": 1787178317, "id": "1210111595527617", "version": "1.0.7", "version_code": 98, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1210185402186903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.6\r\n\r\n- Theater audio: optional world-locked sound. Turn it on and the soundtrack stays anchored to your virtual screen when you turn your head - like real speakers in the room, not headphones strapped to your ears. Three modes: Off (default, untouched stereo), Room, and Headphones. Recentering re-anchors the room.\r\n- Real HDR: HDR10 and HLG titles are now properly tone-mapped with correct color. Colors are rich and accurate instead of washed out; regular (SDR) videos look exactly the same as before.\r\n- Your color adjustments now stick: brightness, contrast, saturation, hue, temperature, and gamma are saved per title and come back the next time you open it.\r\n- Smarter FIND: search filters the folder you are in as you type, with a live match count. APPLY keeps you in the folder; CANCEL puts everything back the way it was.\r\n- Empty library? One press on \"On this headset\" scans your Movies and DCIM folders right from VR, asking for permission if needed.\r\n- VR format auto-detection now reads the 360/180 metadata embedded in MP4 files, so correctly tagged videos pick the right projection without filename hints. Your manual settings always win.\r\n- MKV chapter support: chapters stored in Matroska files now power the chapter buttons and seek rail.\r\n- Subtitles authored at the top or side of the screen now render where they were placed instead of the bottom strip.\r\n- A-B loops stick per title and come back the next time you open that video.\r\n- USB drives are a first-class source. Unplug the drive and those titles leave the library instead of going dead.\r\n- Browse your local XBVR player catalog in VR, including named lists. If you saved a login, Finally sends it when the catalog asks.\r\n- Handy stops when you leave the movie on Galaxy XR.", "created_date": 1786838194, "id": "1201069123098531", "version": "1.0.6", "version_code": 97, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1210185402186903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.5\r\n\r\n- Theater audio: optional world-locked sound. Turn it on and the soundtrack stays anchored to your virtual screen when you turn your head - like real speakers in the room, not headphones strapped to your ears. Three modes: Off (default, untouched stereo), Room, and Headphones. Recentering re-anchors the room.\r\n- Real HDR: HDR10 and HLG titles are now properly tone-mapped with correct color. Colors are rich and accurate instead of washed out; regular (SDR) videos look exactly the same as before.\r\n- Your color adjustments now stick: brightness, contrast, saturation, hue, temperature, and gamma are saved per title and come back the next time you open it.\r\n- Smarter FIND: search filters the folder you are in as you type, with a live match count. APPLY keeps you in the folder; CANCEL puts everything back the way it was.\r\n- Empty library? One press on \"On this headset\" scans your Movies and DCIM folders right from VR, asking for permission if needed.\r\n- VR format auto-detection now reads the 360/180 metadata embedded in MP4 files, so correctly tagged videos pick the right projection without filename hints. Your manual settings always win.\r\n- MKV chapter support: chapters stored in Matroska files now power the chapter buttons and seek rail.\r\n- Subtitles authored at the top or side of the screen now render where they were placed instead of the bottom strip.", "created_date": 1786748221, "id": "1199350979937012", "version": "1.0.5", "version_code": 96, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1210185402186903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.4\r\n\r\n- New A-Z jump rail in the library: with Name sort active, a letter strip appears on the right edge of the shelf. Tap a letter or drag along the strip to jump straight to that part of a big collection, with a large letter badge and a haptic tick as you scrub.\r\n- Your room now stays put. Seeking, pausing, or recentering no longer swings the theater background around you, and recentering while lying back no longer tilts the room.\r\n- Seeking and pausing a 3D Blu-ray no longer resets your screen position, size, or curve - the movie comes back exactly where you placed it.\r\n- One offline NAS no longer freezes your other sources: browsing and playback from healthy shares keep working while an unreachable server times out in the background.", "created_date": 1786674591, "id": "1197931890078921", "version": "1.0.4", "version_code": 95, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
2"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT-qoWoYFoEQ7kNvwGFi5E3&_nc_oc=Adow-qkk9HL2szO_aYTIHseMTRDZwwLqVE4TEdykMeIT-rvXoIgWRXVb36maz9HrC4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhzwfKslQaA3M2M0Y6MV1vrIgWsrVFqoMYrZIUSf8Ukg&oe=6AC66962"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z98ZhaeguJAQ7kNvwHjIHRA&_nc_oc=AdpyMFyCEWjpU-ygAOiwVtIRMk0jY6Qrd0PqvJHJCnvLBxcj4oCT72rqhK8VO9DhKWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdXRB_JjXdcPY-zrIAlDJBIOku9XlwsbBTFXMTReDivA&oe=6AC6482A"}]}, "id": "1376776781291320", "locale": "en_US", "screenshots": [{"file_name": "02-library.png", "id": "1390964799141465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1390964802474798_6047325578666872246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGSomS-2CFUQ7kNvwEpngcD&_nc_oc=AdphApOL4ZMibXA-FrNykEqsM6DyLPR51mAALQ7wMN_1Iv-t-qdDarRd6LnJvao3bc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXPG4jXgu4074JImapwyNG7RCAoHeweeeO9nB1yx0gvw&oe=6AC64DD2"}, {"file_name": "03-connect-computer.png", "id": "1798296184674552", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1798296188007885_4116644365857144993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mu-l90a_KjYQ7kNvwEySXxF&_nc_oc=Ado5C14qoLXtMDSFDez8_qnry1WBP_yvTuiYyUWMAxs3bw6Ts4dLqE13hB3v1VmbsUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlaattFGVgA6wU7G9HPk1bkxOOXD6Yh83ISzaQhlgRbg&oe=6AC63FF8"}, {"file_name": "01-immersive-video.png", "id": "1053997607244217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604317775_1053997610577550_2920253805503949335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLpE2YRXSzQQ7kNvwGiWFRF&_nc_oc=AdpuP4dDh5r_O7icmbbTAVnS_2kaORWFddMA1F0maVT1YAGT-lhOUdw6GTYpy1-Rrgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVtgEhdPQPB4v0bZ1m1KxueG3NJZ6IkF1ZxM_Cmtd6uQ&oe=6AC66BE9"}, {"file_name": "04-quest-help.png", "id": "2266933544083990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_2266933547417323_6404197436740496345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u9rk19kvsoQ7kNvwEiIDVp&_nc_oc=Adr0CKz6m_xLPOW40I0ZfBYMkn_mjdDPmub-Ml88cfwnQyPBi3DmAkVD_bsu2Jc-pEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNujQ4ExnhdVpE-IgIGJQaXggIhUKOHGCdnhRwMFEkE4g&oe=6AC6549E"}, {"file_name": "05-pro-playback.png", "id": "1373037901476301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1373037904809634_6881609859731654856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-CELZAOvTMQ7kNvwHxN5YJ&_nc_oc=AdrA1hArAfldriwuIR_-ggmK-pKYjYUU1cP6xOFz19zwfPxPtdzdyB7qELGOlblht7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3582XwfmHeKKJlsI9HKpifQzVxPNpjo-CAzl9lAAm1g&oe=6AC64426"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1237255869479856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
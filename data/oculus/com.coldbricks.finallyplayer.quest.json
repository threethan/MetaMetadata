2"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR7qhRItucEQ7kNvwEzDFYs&_nc_oc=AdpvB5_wybOeBd1fwqD4EoOKHB627SFWTo7JbDecCFqvsi9UYaYsvNU5pSC9aH9Z6c0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfpbYV4iq2RfPGg_ez6NqA_J3c6VNlpDHa78uk7bPIFQ&oe=6ACA5DE2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqIJFj11dSoQ7kNvwFCt_r2&_nc_oc=AdqecK5ETL34EfhGFaimgoS09zVnFE35oSN8AiyxrQzfrpetLL3-M2wgQh6UPA0bjUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdueKpN1pIA8Km46bPV6Gh37Ws0RCW0lR5nu7OeFPApQ&oe=6ACA74EA"}]}, "id": "1376776781291320", "locale": "en_US", "screenshots": [{"file_name": "02-library.png", "id": "1390964799141465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1390964802474798_6047325578666872246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-kk6sj-pOoQ7kNvwHKGN6D&_nc_oc=Ado1EioO3XWD_Y0KUietnhS2hpMCMOiYn2VaU1lG8omBWtF2uiNGmtMFpCvSNmVxRgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrJeUbqbLz2vU7osBF_I1mOFAsPH-P2C_kEXJ9--liUw&oe=6ACA4252"}, {"file_name": "03-connect-computer.png", "id": "1798296184674552", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1798296188007885_4116644365857144993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ6-fzxe7KEQ7kNvwHtMqRY&_nc_oc=Adp5MLGWVFfEmFHhRjFiF-2ZuC4W6zb56IWynftYYusADxDvNvzoWhNeaJ-qD9x0Y-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-ISbMM9dHAtERT_YJREsJeVaoIJx_qXErQqNvjeQP5w&oe=6ACA6CB8"}, {"file_name": "01-immersive-video.png", "id": "1053997607244217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604317775_1053997610577550_2920253805503949335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7dAIBUQrs4Q7kNvwHHL9Jt&_nc_oc=AdovGy4-euBTc1I964vHLCDubaR0UOjbci6wChpTCsCPXgDmVoUzhZPn7rVg7DkJr5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1xaSuNL6zIKi1WvQBtpOO6U2-ieq99PEyx2R3q9458w&oe=6ACA6069"}, {"file_name": "04-quest-help.png", "id": "2266933544083990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_2266933547417323_6404197436740496345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRTl-83okcwQ7kNvwE4zUZZ&_nc_oc=AdqSwOdw3f-ygTKrq1-kAPdGKe5sl8vA2PFnw57mZ80gObA_zdKOlLgLSmo34hsgB4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNurQHldhms3tyu0rcBchrwZw9mhqF45l6y8TcIWtqhFQ&oe=6ACA491E"}, {"file_name": "05-pro-playback.png", "id": "1373037901476301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1373037904809634_6881609859731654856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEY0YGc2nyAQ7kNvwFR56sy&_nc_oc=AdrApSOvdm5_Aa8Hap5tSCes53Ntl723ZPvoJ6h4l_g0VVjLk-R-ojxYvH4q-iLmDoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN7Wt_5tK6HW7sra97OsTDPFLoJ0osADIcto3XzLREUQ&oe=6ACA70E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1237255869479856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
2"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcCCisS7lKkQ7kNvwF1m828&_nc_oc=Ado24jTvukFiG57lDc_CYwanJVngnECNpDYGlq3XhrASJ8sXzOr_v5R-ZiZyvgJXCO0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY9w4P_Sk985hWsrxnhn1BWWZ1lJM6NJF2t8O5YxE_mg&oe=6A71D122"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifzAFlDdnVEQ7kNvwFU9U33&_nc_oc=Adr1q2DfuNeK5qs7yUm1fr6SdzK2Lx_s3sqXEN3fL12jaPen79FpZYRgetg92a1lujg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyetelCIe3GS6bBRy1m3yTRVxfqxKlejl8xYNmKwHcEg&oe=6A71E82A"}]}, "id": "4536840456556530", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYiNovqtJgIQ7kNvwH-UlLX&_nc_oc=Adpgj4V0hN3Z0nAaCWBlvJpHEfOdWhWI13-IYc9LQRyZMSPqgjwSFfJY5_GqBu722Is&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv64NQGKmClapCD-JtO7ofi8lKAWus_w6CZjyoF0vvhg&oe=6A71F3DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WRoHYGl_QsQ7kNvwH8Pvmd&_nc_oc=AdpoUhPZu-K8IkgQQVOnhwHFlQ8-5OKfYVfNk9wLfKY3Mucs-QdyG7NN8yI1Rqq7Bno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKLN3Wr-1rwiUChgCivzqLt6ORULTh5BcX83ZdZUuy3w&oe=6A71E144"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQt-djRxzsQ7kNvwHs_DVA&_nc_oc=AdoJjvYqEd6Pe63-0vKRvNjDKWWPu3DHATTcoCqQzOGWOE_OkaAiPCQpw32haK-17kc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM3qi_aL-ITWLmFFsU-V_DjHdCHVxTJt5ahz_LPvAUJQ&oe=6A71FA4B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vstEEx9z_jIQ7kNvwHtZax-&_nc_oc=AdoS93K8jvgykO390OBnEUC0VtC1Muz6jFmsb6uYz8LgA9LYrPRnQHDbTr1vD5EtSek&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMkONU_AlfJWw7eaBLhaKsPHPbKe9kbhMVfG7YsqH5CQ&oe=6A71E660"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUXbtrTSYPYQ7kNvwFwqxLF&_nc_oc=AdrX7JImJ4YpHW4cjAy4_WwRaXX9eIDUXb4i3Sj5TbQ4By5NZ1eJ3bnwCGOLu_cheAw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA6hz44ETC2KQZp5YrYwOwntF5ybqel0b3xpuD78svmQ&oe=6A71F683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161567437048700"}, "review_messages": []}]}, "cover_square_image": {"
=7f20f&oh=00_AQNfpbYV4iq2RfPGg_ez6NqA_J3c6VNlpDHa78uk7bPIFQ&oe=6ACA5DE2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqIJFj11dSoQ7kNvwFCt_r2&_nc_oc=AdqecK5ETL34EfhGFaimgoS09zVnFE35oSN8AiyxrQzfrpetLL3-M2wgQh6UPA0bjUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdueKpN1pIA8Km46bPV6Gh37Ws0RCW0lR5nu7OeFPApQ&oe=6ACA74EA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtBGepZ9VbsQ7kNvwGPBL94&_nc_oc=AdoRd5_VTcjRnlnI2ISNzTUXKqyoNnOqQjnjtf2pjky95RPB7IWxABTyPuCpB5MdfW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPivFmlHJgHSD9FIucWwX0VmTYU3G_HuVwX_kV19YOlgQ&oe=6ACA485B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLaEp44XM9cQ7kNvwHg4thH&_nc_oc=AdqtGmmmRAjSEgnH1OcJrrv5wRO2LOJnDCHLsPrl3aN9ig6V-C1atpXfROEFbz7EcWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVo-PHxzmQvDj3OqGMxrPG2nznYn3nJ9pTsvPdYl7Mhg&oe=6ACA6E04"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjX7RxLneBAQ7kNvwHMGS7c&_nc_oc=AdoWJ0RXgtgPtLaBm6sILZ4_n_610y88qXEas25KvMC3HxdDn3tSBhDsEucimHdb_xQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0UF7eCNGixE_Atdk_pIv2y40byL_cNCWKoo9Dw_RSVw&oe=6ACA4ECB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jnhy-WKn67YQ7kNvwH2tQYx&_nc_oc=AdoPj3lfbu5cha58S3hBqxNiVDAiCj5KR4uiEuJ7njG82GkRtb7VeThVLbJL-vD2cxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfcMPh3WasVao8f_hos3p0emuy7hgfdS8MD72Z3OKLEQ&oe=6ACA7320"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnRmZOZ6tF0Q7kNvwG5dbSx&_nc_oc=AdovoDog57vIjHIPsKIlLxDZ3xG7oO2dAWzRiyxXxQ1ONWRyrwyRGWd1K_CeNLvnGew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9earCX7kysjv8YY-8mJFOz-IVmhm2r9ZD3gFx7jWtjQ&oe=6ACA4B03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1290935940778515", "version": "1.0.39"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1290935940778515"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.39\r\n\r\n- NEW \u00b7 MUSIC: play your music library inside VR, with EQ, A-B repeat that remembers each song, and a big PLAY/PAUSE wherever you are.\r\n- NEW \u00b7 CLUB LIGHTS: the room and your photos glow and pulse with the beat. Real-fixture presets, color, ROOM DARKNESS, and AUTO, which builds, goes dark and hits on the drop. Flash rate stays limited for comfort.\r\n- NEW \u00b7 BEAT SLIDESHOWS: change photos every 1, 2, 4 or 8 beats, or let AUTO follow the song. Timed slideshows now run from 100 ms to 60 s and play the folder, favorites or search you started from.\r\n- NEW \u00b7 2D \u2192 3D for photos, plus a 3D STUDIO with a sharper BEST depth model (downloads once on first use).\r\n- NEW \u00b7 DETAILS list view with sortable columns, a lobby RESUME chip, smooth stick scrolling, and every setting on one page.\r\n- 360 panoramas: the stick turns the dome and the horizon never tilts. Click the stick to recenter.\r\n- ChloeVibes for optional Bluetooth accessories now connects from the music page and follows the music, with adjustable sync, a calibration metronome and a safety lock.\r\n- Fixes: H.264 plays again after a legacy AVI; steadier exit from VR.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1791096622, "id": "1290935940778515", "version": "1.0.39", "version_code": 131, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1290935940778515"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.38\r\n\r\n- NEW \u00b7 AI Background (Experimental): keeps the people in your video and shows your real room behind them, live on the headset. Works with flat 2D and 3D video and with VR180, 360 and fisheye. SDR video only; needs Quest 3 or 3S.\r\n- NEW \u00b7 2D \u2192 3D (Experimental): adds on-device depth to flat 2D video. Its model downloads once on first use.\r\n- AI runs entirely on the headset. Your video never leaves it.\r\n- CLARITY: optional sharpening, super resolution and FSR 1 Ultra quality upscaling for flat SDR video. Off by default.\r\n- SCAN asks for full video access when Android shares only selected videos.\r\n- Fixed yellow text overlapping PRO CONTROLS; long notices scroll on hover.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1790730605, "id": "1274696272402482", "version": "1.0.38", "version_code": 130, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1290935940778515"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.36\r\n\r\n- WebDAV setup retries once when encrypted password storage is temporarily unavailable.\r\n- Clearer message and private diagnostics if the headset still cannot save the password.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1790300347, "id": "1266880023184107", "version": "1.0.36", "version_code": 127, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1290935940778515"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.35\r\n\r\n- An empty library now offers Add WebDAV directly.\r\n- Improved authenticated WebDAV source setup and playback.\r\n- More reliable Quest Lobby clicks and hover haptics.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1790130570, "id": "1263846400154136", "version": "1.0.35", "version_code": 126, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1290935940778515"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.34\r\n\r\n- Saved local folders refresh automatically when you open Finally or return to it.\r\n- Newly copied photos and videos appear without clearing or re-adding your library.\r\n- Favorites, resume positions and picture settings stay intact.\r\n- Improved PNG/JPEG discovery, small-photo handling, photo permissions and Android Open/Share.\r\n- Re-adding an existing folder correctly reveals its media.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1789651849, "id": "1254767924395317", "version": "1.0.34", "version_code": 125, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
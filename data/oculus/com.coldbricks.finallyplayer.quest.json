O3QgJPd_rwXkHkug8wkOUUY7Bj6k_3gVsvmPHM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCOlU1ZHRacRbETvPGTLn7dIcdcciEgO1ddZDMAvwHgQ&oe=6B09B4B8"}, {"file_name": "01-immersive-video.png", "id": "1053997607244217", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604317775_1053997610577550_2920253805503949335_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ8zhNrslWIQ7kNvwHFWHxQ&_nc_oc=AdpIGTPvCOscpSRYBI3P_Xtl-4gZPKkgiGGQoHTQHBclLhIhUQM1ktKvCrybQpR2nks&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKsG_P_YjB8LPDsr5BbOefeZSzcQJDMi8w6a7LNuNITA&oe=6B09A869"}, {"file_name": "04-quest-help.png", "id": "2266933544083990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_2266933547417323_6404197436740496345_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8X3UrW29bYQ7kNvwFPD3Ws&_nc_oc=AdpYArnuDd7pgyEzparEaUTHF1y4F5VmUXBeyhHDYEyu43NYUuzY_6HRCR67dQ4SewU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz6sQILtcZR2hBARgnOQAOMdkq8Ag1CqTKYJBLWZyAFw&oe=6B09C95E"}, {"file_name": "05-pro-playback.png", "id": "1373037901476301", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/595119480_1373037904809634_6881609859731654856_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBNVo1k-tUEQ7kNvwFqQsEW&_nc_oc=AdpG4m_sFjapcvaf1_GyO67RbwbBTGXe0LfEVmEmETbbzcahQzqC3nkuh1Wp__Zu8Ns&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt0ZQjVLuYl_ULQ0UDsn-f6i69h_SyJZIRz-3Z5w7Erw&oe=6B09B8E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
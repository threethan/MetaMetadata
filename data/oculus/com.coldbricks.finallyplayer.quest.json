cdn.com&_nc_ss=7f20f&oh=00_AQJA-xYHVQD7OKuMHp9m_eLZvhOQYFw5xmwS8GvLJmrQ2w&oe=6A9D8AE2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_m4dhnCD9EQ7kNvwEWXG4k&_nc_oc=AdqP7L5ZXtKdf_6r3W5qpNz-AR7Efu-t1-iYsQh20bpZXLw1mryUZvLrpt8iPgUeX04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOPnNBIwqy079K0wXJ8N3QQk59sAp9XIuWqE4Re0FnNA&oe=6A9D69AA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB6nHN0DGnYQ7kNvwGxwXUU&_nc_oc=AdqKS32F-mbohKBleubQfas8KokIwiDUkujb7IVvWGmA1KDk3yttsx6F3x75CclM-W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaYNImZtmbZIV203nwA4wgGMmf_roeaE7ub_z2Os9jfA&oe=6A9D755B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90kc8d1wrccQ7kNvwHPQ812&_nc_oc=AdpqaW420dBBCNh7oDNygFJQJC5HJhcPw9dVQslyX0Zho7YmWKElNtKMW2fsThmS_A8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7HDY1nWWJs5elNsSZIlAo7lQtnKITeVP_9-n0PcF_hw&oe=6A9D62C4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTEBQocg8kEQ7kNvwFqNW5n&_nc_oc=AdonHG-bity9fey2wrt1f27e9gilPhusaZmvFVTYA1id6dcVR0qPagv3r_JznoIk-D0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBpjdPJuqD4rQeFsp1sYCtMieGY39M2pIRBSjKtVzLhQ&oe=6A9D7BCB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvNe4B9i1h8Q7kNvwHAlXNv&_nc_oc=Adpt0hp3GLVab-Yjqygoe7swC3aA1U_Bi7OY6rD37G-nY0qQ8VbYqlFjx5oL0HzIa7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKemrA5GeCBDfPvwZg8nDhkSArj_N-vBs3x8RbMSibPpA&oe=6A9D67E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ageVaKtpDjUQ7kNvwE7Ut9u&_nc_oc=AdqtPhr-qIZyx3lCvZ-O-q43IueC967SpeZ-W-LSrwwkHYYpc6A0cNHQI2JRMM6KKG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoDPzP6VUB6Tn1Yqu8BJ2q9Lq8cSx9cfnckL3tJ_QLrQ&oe=6A9D7803"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1229826840222759", "version": "1.0.21"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1229826840222759"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.21\r\n\r\n- A folder you add now keeps its own shelf, its name, and its titles after a SCAN, instead of being swallowed into the headset's photos and videos.\r\n- Sorting the vault by DATE now shows each title's date on its row.\r\n- Titles found by a folder scan are dated by the file itself, so DATE sort matches what you would expect.", "created_date": 1788314555, "id": "1229826840222759", "version": "1.0.21", "version_code": 112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1229826840222759"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.20\r\n\r\n- SCAN in the lobby now finds videos you copied onto the headset over USB or adb without a restart, and always tells you what it found.\r\n- REFRESH POSTER updates the title's artwork right away.\r\n- Smoother lobby when you have large network sources saved.\r\n- Removing an XBVR source no longer fails when secure storage is unavailable.\r\n- Fixed a crash some pages could trigger in the built-in browser.", "created_date": 1788310545, "id": "1229764130229030", "version": "1.0.20", "version_code": 111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1229826840222759"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.19\r\n\r\n- New START HERE button for first-time setup: pick your videos folder and you're in.\r\n- No more permission prompt over the intro; Finally asks for media access only when you add on-headset media.\r\n- Adding a folder keeps scanning after you enter the lobby; SCAN in the lobby now refreshes added folders too.\r\n- Stick closer/farther no longer triggers on left/right seeks and ramps smoothly from the gate.", "created_date": 1787721113, "id": "1219498031255640", "version": "1.0.19", "version_code": 110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1229826840222759"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.18\r\n\r\n- Fixed a browser crash when a web page tried to start its own in-page video player; page media now hands off to Finally's player through Videos.\r\n- Fixed an audio crash on MKV/MP4/AVI files whose Dolby, DTS, or MP3 track changes channel layout mid-stream.\r\n- The VR session now starts off the UI thread, removing a stall that could trigger \"app not responding\" after returning to the app.\r\n- Smaller memory footprint on Quest 2 for scrub previews, the boot intro, and passthrough mattes.", "created_date": 1787717094, "id": "1219436671261776", "version": "1.0.18", "version_code": 109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1229826840222759"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.17\r\n\r\n- Restored previous/next photo navigation without a distance jolt.\r\n- Photo stick left/right changes photos; video stick left/right seeks the timeline.\r\n- Grip + stick left/right keeps adjusting image height in photos and videos.", "created_date": 1787553486, "id": "1216510954887681", "version": "1.0.17", "version_code": 108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
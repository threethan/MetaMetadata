2"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDselFg7P5cQ7kNvwFuN2Gz&_nc_oc=Adq3QK6QyGJDwZjd5iXXnNMmAAXstZhcCPg56gmMwcBsKv_nLjEp5Me-HYqlqiZKaqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb6y9Y-Mzdd5z9LBT2UfRSa5ulVdmD_ZOxPX6QKR3LwA&oe=6ABBDD62"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9saorCxzv8Q7kNvwFolKYN&_nc_oc=AdovAcuDBGYcPGXAss88egnvxzEOIvHAXyKrT3rVre98nrDL4jHv2oUcggN53-2kQg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk4VDexTWUCaIi1AkanQOZUxD1d9p-7S-IBLiqB-ynDw&oe=6ABBBC2A"}]}, "id": "1376776781291320", "locale": "en_US", "screenshots": [{"file_name": "02-library.png", "id": "1390964799141465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831279_1390964802474798_6047325578666872246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYDjdl3jLVYQ7kNvwEhFuYE&_nc_oc=Adot1biDdkKrf0DxFGZLIC1DWPPNeQbuqPN8vnm_L9BkmOyuDTlL73lmDHKCNPGB1YA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNalsuB3-hoolp8QeKMS-ZMqTZIMJeKXK6IJXjF19cYg&oe=6ABBC1D2"}, {"file_name": "03-connect-computer.png", "id": "1798296184674552", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1798296188007885_4116644365857144993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDsxJusGIsAQ7kNvwE1S6oj&_nc_oc=AdrQE33MA6EcezFvphWQKIvwWsL1QyrPZvSl-UzhMnjn1pkARBA5hvVHebmOyBJG-3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxj2N7HawG1s09sRK1-cWHIEZpSrzdMfMyMb7X67IYiA&oe=6ABBB3F8"}, {"file_name": "01-immersive-video.png", "id": "1053997607244217", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604317775_1053997610577550_2920253805503949335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7DswMmF5noQ7kNvwGigqeE&_nc_oc=Ado-9jtmaisPIKBRPhhx5EzTPqE-rL9yR56SjmVlC-pqDoa5gtSlypQSgQyf6haOmY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpBlP9keGMcb02zbPYPxd55LIm3WBbrJlrNSOoUG9vfw&oe=6ABBDFE9"}, {"file_name": "04-quest-help.png", "id": "2266933544083990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_2266933547417323_6404197436740496345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQkxomikMAoQ7kNvwGakKdA&_nc_oc=AdrZ9rRPR34N2Ki_NyepxO1HcQw0bHOWgyEZ8N-A4-C3UQcckSMMqFVMawaDbcDSbVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKqyLX224w-787VfMcG1IT8_CuhrPzxF52DSmZEWT3cw&oe=6ABBC89E"}, {"file_name": "05-pro-playback.png", "id": "1373037901476301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1373037904809634_6881609859731654856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7a8WP8EztMQ7kNvwEPnxRF&_nc_oc=AdqlZC7Nyq8a6CV2aP3vixyjwZvOHUEOPXDNk4une6xpsOhv4CQACbwF_EXKUZmUXJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8RMRl3hD4tT4zVwgQJ1hjEhCP7qOqGLTZqogtmkSXlw&oe=6ABBB826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1237255869479856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
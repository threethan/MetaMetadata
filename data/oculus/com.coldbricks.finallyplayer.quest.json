cdn.com&_nc_ss=7f20f&oh=00_AQKVjaVuEPheKmdbTtInlxaJeYGM52Ox_BGPgShUA-ebDQ&oe=6AA17F62"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugeE1lc23g0Q7kNvwHQISry&_nc_oc=AdrtaRVKIcc5gwNM5DCiQeXFV3lJH6SE3yYMrCsshsNbiIvQ9zEwtElo0bGIL5PFqP0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHP2TK2hvvQYQQeOWWl2rRhEmhsT4T7PeEp_VicTVkww&oe=6AA15E2A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aUguJPXHzwQ7kNvwGt-B2E&_nc_oc=AdqWVNbpDThsxevW5FfvlqtEb-0xxZf4XNHD9Qvjpf4kfY07UX6eW5tA4GLoeuchH4w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYy3hVpbxgGK-QFbPV5ECUPVuCM4goFF3K_CkA_Xr8xg&oe=6AA169DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP9IbQ5WCNEQ7kNvwFvkK5r&_nc_oc=AdptIC0r3MBxryDmOPdYiPOslWxHYlrdgf7Sc8UjMT6cDuJWp7Az66rTk9lPxL7TaHA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI4qvLxB0Cdedpw_G4q1si68se7vf6GzY6UYdvnAta2A&oe=6AA15744"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAlCX_C2Z2oQ7kNvwFJY_5L&_nc_oc=AdqpFFd1PBIPDNbN2DnBBKO5JBoRDXuQZdWFKKZ3eW1AcpvrOf8Tkks18BkUOkRk5sU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjiB4G7r5uiVweIiF9CGebn_r9YiuhnqxjzTWJinAMrQ&oe=6AA1704B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2XLER6swI0Q7kNvwH5YVJ5&_nc_oc=AdqQpCkJJ3Q8B5MOCEZX97QwHhV_B4TprSqbmj9xLmHb9cFoVMGlqVjtNKJgOSNhXWg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiSVy-T1ZCkMQD1MR2iAYx76hn3iQS0hy2yZ97o534Sg&oe=6AA15C60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93H_D73w0yUQ7kNvwHJKkql&_nc_oc=AdoIYUhdFsnO6eoEWJ6_MwanQA2u4HkChpptLJxLvfZKxhGac5ypR3-4MY2FcgykL5I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2aSWDubxAD7KGKFQN9ceJqLz0WR3ipeU5b8vdW1_ukQ&oe=6AA16C83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1234330686439041", "version": "1.0.27"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1234330686439041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.27\r\n\r\n- Fixed DLNA folder and media-filter dialogs that could hide their rows.\r\n- Improved video selection when a server supplies thumbnails, subtitles, and an extensionless video stream together.\r\n- Kept MKV filename detection working with application container MIME types.\r\n- Fixed indexing that could stop early when a server returns small pages, leaving later videos undiscovered.\r\n\r\nLean native OpenXR playback for Quest.", "created_date": 1788566140, "id": "1234330686439041", "version": "1.0.27", "version_code": 118, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1234330686439041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.26\r\n\r\n- Creator notebook: save named timecodes, jump back to a moment while paused, and export your viewing recipe.\r\n- Compare neutral: temporarily compare the picture without your color adjustments, then restore your grade.\r\n- Browse large libraries in smaller pages, with search and selection across the catalog.\r\n- FIND supports system-keyboard entry, paste, and more languages.\r\n- Preserve authored chapter names and use indexed seek previews when matching preview files are available.\r\n- Temporary sessions skip new resume, Recently Played, and automatic playback receipt updates. Existing records stay.\r\n- Continue adding a source after granting access, restore a room saved at 0% brightness, and see clearer buffering feedback.\r\n- Bounded thumbnail work helps keep background media extraction under control.\r\n\r\nTemporary sessions do not erase files, caches, viewing settings, explicit notebook edits, or server activity. They do not encrypt videos.\r\n\r\nLean native OpenXR playback for Quest.", "created_date": 1788562705, "id": "1234278809777562", "version": "1.0.26", "version_code": 117, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1234330686439041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.25\r\n\r\n- ROOMS is quieter: picking a place no longer raises a floating toast with the room name, and the \"fit to 4096x2048\" notice that appeared every time a room loaded on Quest is gone. The place name, category and mapping still show on the menu's status line.\r\n- Nothing else changed: decode quality, resolution, color and rendering are identical to 1.0.24.", "created_date": 1788473030, "id": "1232643176607792", "version": "1.0.25", "version_code": 116, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1234330686439041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.24\r\n\r\n- DLNA servers find themselves: the DLNA screen searches your Wi-Fi the moment it opens, names each media server, and one tap adds it and opens its folders. Typing an address is still there as a fallback. In VR, opening SOURCES scans the network by itself.\r\n- Stability pass from the crash dashboard: opening a title no longer waits on the media provider on the main thread; the app survives a process whose Application object is not ours (a Quest 2 launch path); removing a NAS, FTP, WebDAV, Stash or Plex source works even when the headset's secure storage will not open; saved sources are parsed off the main thread at start.\r\n- Support bundles now include a sanitized record of the previous run's ANR or crash, so a problem you report can be traced without any telemetry. Nothing leaves the headset unless you send it.\r\n- No change to decode quality, resolution or color.", "created_date": 1788465895, "id": "1232517823286994", "version": "1.0.24", "version_code": 115, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1234330686439041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.23\r\n\r\n- Faster lobby: every menu panel now draws on its own render thread, so the headset's main thread only hands the finished panel to the display. SETTINGS, folder changes and the scrub strip no longer queue behind poster work.\r\n- Faster local playback start and seeks: a local title starts moving once half a second is buffered instead of a second and a half, and the subtitle sidecar lookup no longer sits in the open path.\r\n- Playback timing is measured now: the log records press-to-first-frame, decoder start-up and seek-to-frame times, so the next slowdown gets chased with numbers.\r\n- No change to decode quality, resolution or color.", "created_date": 1788434596, "id": "1231885413350235", "version": "1.0.23", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
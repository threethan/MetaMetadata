cdn.com&_nc_ss=7f20f&oh=00_AQEdE7ueaBrFb-4WFWHM1RD9kOtcXN4x_2RCqvkdLcA24Q&oe=6A8051A2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeJyrKOibLkQ7kNvwFVpxyY&_nc_oc=AdoAOVzD3afJZBXNeNccpYX4xWzYmhMbGetngpaUgPMxIeVV-4kRz5JH9AniZZEdzY0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDay0ZTiRxW6YAJk6ymljz62uXpSh5r7Z3yMt6VsrvOw&oe=6A8068AA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZlRQUksS_sQ7kNvwHOcVfj&_nc_oc=AdqtRzO_8Kh4RfI9AnfOKlOSbLrOhJey0_wyLzZCdDt9EBO8quqQI5GF-8Lig_LM6vc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErRYGhrfTWWns6zZbjAyLrsOxDbToL4qijbtl7mHI_yQ&oe=6A803C1B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUh9eO_by8YQ7kNvwGuIioT&_nc_oc=Adqrnf6sXbLx5D3Aua7uLZVDn6ZXp3DEPvZ6i6T0YeD00ItOmsE6iWl7taVLlOQRydc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfOkYxFUUT06iZ3x3tflx7lB93qg9G7Q-A6z5vD501pg&oe=6A8061C4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5iogk2j3KUQ7kNvwFnNRJT&_nc_oc=AdqZwVbi9DC69I8tsosSKXwi177sjS4AllUehTOvc_lgQ77Fek0k4e61fSZSE-DvNBo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEokkc2xY1jFCrIH-BTOfNoKtGFM87xDE9sSSl56Q-GCQ&oe=6A80428B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiUo_A4XdS4Q7kNvwFh-zli&_nc_oc=AdpgaKpBqHTVPhfKbfEPy-1nX6AAlGM1oxpvA__kVyVxSmD3sIlELs8MI9RRnq6GGzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERYkuSCO-mSwybBOKDTMkxvXSY0XoRLDGbm0n90AVQjg&oe=6A8066E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp56KnH5vkYQ7kNvwGjCEPt&_nc_oc=AdqD_kWfQo0hGvZFlK9bk30QySVL-B6kYzSTDIof7BKAPf2zkeG9OIF01o2lCeE77aY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtGaSeFaupFqFE28za4GBLwgn9Qzz0mDrX-1nYdv9xdA&oe=6A803EC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1191794487359328", "version": "1.0.0"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1191794487359328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Update 1.0.0 (build 87):\r\n- Real controller models: your actual controllers now appear in your hands, with correct materials on Quest and Galaxy XR.\r\n- HELP manual: photographic controller map for your platform, smooth animated figures, and fixed flicker on animated pages.\r\n- Stability: menu presentation watchdog prevents rare frozen help figures; hover highlight no longer strobes.", "created_date": 1786337573, "id": "1191794487359328", "version": "1.0.0", "version_code": 90, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1191794487359328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.0\r\n\r\n- Multi-select in the library: press SELECT, check any rows, then favorite,\r\n  hide, or color-tag them all at once.\r\n- Hide titles or folders from the list without deleting anything \u2014 a HIDDEN\r\n  chip brings them back whenever you want.\r\n- Color tags: mark rows red / amber / green / blue / violet with one control.\r\n- Deleted files no longer leave stuck entries behind: opening one cleans it\r\n  up, and SCAN sweeps the whole library in one pass.\r\n- Favoriting a row keeps your place in the list instead of jumping to the top.\r\n- 3D depth now survives a replay: a side-by-side title that reaches its end and\r\n  starts over comes back in stereo instead of flat.\r\n- A missing or deleted file can no longer crash the player. Next and previous\r\n  skip past what is gone, and a title that vanished says so instead of\r\n  dropping you back to the lobby in silence.\r\n- Rebuilt manual: the controls diagram is finally the controller you are\r\n  actually holding, and there is a new Haptics page.\r\n- Lobby menu stability and vault scrolling reliability improvements \u2014 hard\r\n  flings no longer corrupt the list.", "created_date": 1786278017, "id": "1190769224128521", "version": "1.0.0", "version_code": 86, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1191794487359328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.0\r\n\r\n- Multi-select in the library: press SELECT, check any rows, then favorite,\r\n  hide, or color-tag them all at once.\r\n- Hide titles or folders from the list without deleting anything \u2014 a HIDDEN\r\n  chip brings them back whenever you want.\r\n- Color tags: mark rows red / amber / green / blue / violet with one control.\r\n- Deleted files no longer leave stuck entries behind: opening one cleans it\r\n  up, and SCAN sweeps the whole library in one pass.\r\n- Favoriting a row keeps your place in the list instead of jumping to the top.\r\n- Lobby menu stability and vault scrolling reliability improvements \u2014 hard\r\n  flings no longer corrupt the list.", "created_date": 1786207634, "id": "1189618034243640", "version": "1.0.0", "version_code": 85, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1191794487359328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.62-m3 \u2014 the reliability wave\r\n\r\n\u2022 COVER layout: scrolling fixed \u2014 flicks glide again instead of freezing\r\n\u2022 Faster menus: vault scrolling is smoother under the hood on every skin\r\n\u2022 Long settings pages now scroll with the stick instead of clipping\r\n\u2022 Restored controls: RESET VIEW / RECENTER / AUTO in SIMPLE view, LEAVE on the color page, DELETE in the vault\r\n\u2022 B button now steps back one menu level in settings instead of jumping to the vault\r\n\u2022 Language picker is an inline pull-down with flags \u2014 plus hundreds of translation fixes across German, Spanish, French, Japanese, Russian, and Chinese (the first-run flow is now fully translated)\r\n\u2022 Playback resumes automatically after a notification interrupts audio\r\n\u2022 Friendlier launch check on slow networks \u2014 retries with a visible message instead of closing\r\n\u2022 Bug report button now confirms on screen when pressed\r\n\u2022 Japanese subtitle files detect correctly (Shift-JIS)\r\n\u2022 Smoother high-bitrate NAS playback after buffering", "created_date": 1786005327, "id": "1185922511279859", "version": "0.3.62-m3", "version_code": 69, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1191794487359328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.61-m3 \u2014 skins + MVC speed\r\n\r\n\u2022 MVC 3D: changing play speed no longer drops two-eye stereo to base-only / crawl; speed stays locked at 1\u00d7 while MVC is active (with on-panel notice)\r\n\u2022 Skins board: continuous scroll (stick + laser drag/fling), hard-clipped well, HI-CON rail label, MARITIME / OPS / SIGNAL type sections\r\n\u2022 Theme catalog expansion (dive, ops, RF, album-cover music, high-contrast packs)\r\n\u2022 Vault page chips use \u25b2/\u25bc (not a right-arrow for \u201cnext\u201d)", "created_date": 1785974240, "id": "1185384184667025", "version": "0.3.61-m3", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
cdn.com&_nc_ss=7f20f&oh=00_AQF_4bzLHwZQCxz6Uu7GRVO_YtX_xoXIL-AeLFR9D07VaQ&oe=6A771722"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZNghz9CtggQ7kNvwFVlnDL&_nc_oc=Adr2mjVk8jTWETP63oeHNA7mqzN2R-1hGfms1WelPmF1YtkTUWLpIjZ2Ci4w0ImJ5Mk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU92Mm7OGxj6sm6yYH1QJ_rtBHIkBD4TbRhVgnXZi1_Q&oe=6A772E2A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifoNckTV6bwQ7kNvwHMDzNP&_nc_oc=AdoTiRC9ECWTutRUegt647iiPqRhYfdel7EX6tC16j4iYo14ql4hbLucYCMFdNOG1Oo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZvbVvP1p1u88wn0IsZDPNaLSB3biqej6o92ED7Teu7A&oe=6A7739DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSTzf5lXNSQQ7kNvwFq3LOy&_nc_oc=AdqRO8vGydKfPAOVanOealX0qNIuDdrQV2So8vCMoFJQm5rtyLMpN1nIQaTkrOX9MPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Co5NuFmY32s4B7NasBHLaFWLb4HDPCc4SmyOHwjgsw&oe=6A772744"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58bEMccS6ZQQ7kNvwFG24MN&_nc_oc=Ado7NTPMqTelHJy1VakdlAfQkllPN9y6y0qpkYDTwtno7rjBSPB6aE4spOsJQNw_alU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPMmq_SIMi4TY_ogP2ybj-OArlAUAWTIsncrggAicbcg&oe=6A77404B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C85u_jTk34QQ7kNvwFV2IbX&_nc_oc=Adoi8yuQIt4kyxeYKSne4LLVD-XGKU1fJX2kaFoWT2CJkQuukzrgILCIvCBy3htutrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl2E4kjMdBz5UgIotvPQQYoUyTRnN7G2GxI94aVW2Psw&oe=6A772C60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrhmbOeX-KUQ7kNvwFv1wqr&_nc_oc=AdpDPf9Ay--WGQULap_vS0GLrumQ3_3KZJ7B3mIyoWEe6lnxve3lYHfy2URn9OQVZck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3VDzpVbRM1Wz53S6lBdtoFtyPfYoJxgg8jHU4Iw3StA&oe=6A773C83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1181650945040349", "version": "0.3.37-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1181650945040349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.37-m3 (code 43)\r\n\r\n\u2022 Stick-click reset for parameters: point at a lit slider (Sub delay, Distance, Zoom, EQ, color, etc.) and press the stick in \u2014 that control snaps back to its factory center detent. Point at nothing / no menu \u2192 full view reset as before (D1.00 / Z1.00 / gaze).\r\n\u2022 Quick strip: stick-click on Volume \u2192 100%; on Speed \u2192 1.00\u00d7.\r\n\u2022 Distance lock, UI languages, FULL-SBS geometry fix, Material Symbols Club chrome, subtitle fonts, and MOVE SUBS below picture retained. (HOLD and B-lock)", "created_date": 1785778822, "id": "1181650945040349", "version": "0.3.37-m3", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1181650945040349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.36-m3 (code 42)\r\n\r\n\u2022 Distance lock on VIEW next to Distance/Zoom \u2014 freezes stick dolly so bumps do not move your seat. CLOSER/FARTHER and the Distance slider still work. Material Symbols lock icon (filled when locked).\r\n\u2022 UI languages in GLOBAL SETTINGS (bottom of list): System, English, Espa\u00f1ol, Deutsch, Fran\u00e7ais, \u65e5\u672c\u8a9e, \u7b80\u4f53\u4e2d\u6587, \u0420\u0443\u0441\u0441\u043a\u0438\u0439 \u2014 with flags. App chrome only; not audio/subtitle track language.\r\n\u2022 Club chrome localization for vault chips and key settings rows.\r\n\u2022 FULL-SBS geometry fix retained (true full-SBS stays ~16:9, not squished).\r\n\u2022 Material Symbols Club chrome, subtitle fonts, MOVE SUBS below picture, vault folder/NAS tower chrome retained.", "created_date": 1785776388, "id": "1181597235045720", "version": "0.3.36-m3", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1181650945040349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.35-m3 (code 41)\r\n\r\nToday\u2019s store build \u2014 what you get:\r\n\r\n\u2022 Club Material Symbols icons with real variable axes (FILL / weight / grade / optical size). Dark glass uses GRAD \u221225; active REAL fills. Folders, NAS cell-tower, SRC/CFG/HELP chrome \u2014 monochrome, not emoji soup.\r\n\u2022 Subtitle fonts: bundled OFL faces (Inter default) + SUBTITLE FONT cycle in SET.\r\n\u2022 MOVE SUBS can park captions BELOW the picture (not only on-frame). Sub height slider: BELOW \u2192 HIGH.\r\n\u2022 FULL-SBS geometry fix: double-wide SAR 1:2 rips (e.g. Rick and Morty FULL-SBS) keep ~16:9 per eye instead of squish.\r\n\u2022 Vault folder vs title chrome: warm folder rows vs cool media rows; corner NAS tower badge readable in VR.\r\n\u2022 Field pack retained: cinema distance/zoom, standalone m2ts, NAS one-level folder browse, ChloeLEXA support crosscheck.", "created_date": 1785734429, "id": "1180775051794605", "version": "0.3.35-m3", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1181650945040349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.34-m3 (code 40)\r\n\r\nLean Club symbology: sort is \u25b2/\u25bc NAME\u00b7DATE\u00b7SIZE\u00b7LEN (no SORT word). REAL vs SET (passthrough vs lobby). \u21c4 RAND, \u2605, DEL, \ufffd SRC, \ufffd CFG.\r\n\r\nSources: list stays in VR; 2D EDIT only for Android pickers. Flat handoff is a branded Source desk with \u2190 BACK TO CLUB \u2014 same app, not a different product.\r\n\r\nAlso includes 0.3.33 Distance stick-click reset (D1.00/Z1.00) and the full 0.3.32 feature set.\r\nFinally VR 0.3.33-m3 (code 39)\r\n\r\nHOTFIX: Stick forward on VR180/VR360/fisheye/passthru now drives the real Distance value (cockpit slider + save). Stick-click resets Distance + Zoom to D1.00 / Z1.00 and recenters \u2014 no more \u201cgirl stuck closer\u201d with no slider change.\r\n\r\n\u2022 Plex / FTP / WebDAV / Stash / DLNA: Remove source visible again (Rescan \u00b7 Edit \u00b7 Remove)\r\n\u2022 LEAVE \u2192 Quest home: harder teardown so home can reclaim the headset\r\n\u2022 Lobby worlds reloaded after stop; failed 8K loads fall back to VOID\r\n\u2022 AFR: 25p / 50p / 100p lock to 100 Hz when advertised; optional MAX = highest rate (~120 on Quest 3)\r\n\u2022 Global default projection for untagged files (Flat / 180 / FE190 / MKX\u2026)\r\n\u2022 Subtitles: larger default, size to 300%, on-picture, auto-pick, MOVE SUBS free drag (B saves)\r\n\u2022 Sub size no longer freezes controllers while resizing\r\n\u2022 Multi-audio track list + remembers language\r\n\u2022 AUDIO studio: SIMPLE night soft \u00b7 PRO EQ + dynamics + stereo width\r\n\u2022 WebDAV: safe HTTPS PROPFIND redirects + same-folder subtitle sidecars\r\n\u2022 Progressive HTTPS cache (512 MB) + Clear HTTP cache in SETTINGS\r\n\u2022 Soft-retain missing library titles after full rescan (resume/favorites survive)\r\n\u2022 RANDOM on player HUD (no-repeat local shuffle)\r\n\u2022 Scrub storyboard tiles (local/SAF) \u00b7 chapters in SIMPLE \u00b7 full timeline drag-seek\r\n\u2022 ChloeVibes stroke/speed caps \u00b7 The Handy connection-key path\r\n\u2022 Controller remap (face B/Y, seek stick) in SETTINGS\r\n\u2022 UI: smoother laser hover on square chips, button glow LOW/MED/HIGH, clearer slider %\r\n\u2022 Cinema distance/size raised \u00b7 rebuffer shows buffer \u00b7 % \u00b7 MB/s\r\n\u2022 XBVR first-class sources in Club SOURCES", "created_date": 1785640833, "id": "1179153761956734", "version": "0.3.34-m3", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1181650945040349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.33-m3 (code 39)\r\n\r\nHOTFIX: Stick forward on VR180/VR360/fisheye/passthru now drives
ad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiWujX5sFqOxcIeA9_eGgvWUYGIRsul27ckkL-uYCj6w&oe=6B01CD04"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3UNEjAMntgQ7kNvwFtNwtT&_nc_oc=Adrulq6tfjAUCUOaW0ZqEPxe6EVT4_D0pPmsh7Ax1odh6nGs2skt1cWjQav5X5m-PAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6oPJ3rfS-F9fdiyAYfA_Ots1KFojI5Yetg9NxshZ-EQ&oe=6B01E60B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXyZ3BeYYvUQ7kNvwHMWeUb&_nc_oc=Adp6Q6PPtPp942lxfCi4mgrENojfpE0Cqa5oER9mOznUowThbnGLfpf746RDe9mHpjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAjECKRmjpr0bAnXsBKagrveWv6S3QrGSC7tms8MaPgg&oe=6B01D220"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oObQ1Gv9lVUQ7kNvwGu_AnY&_nc_oc=AdoZGzk0_tIWSLFgnicao_1sfPZV_bFm_MOgZj9hie5ldP4lxuaeTFvFzTgbDpXYot0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT6NzBrES0F1GIV8TjHtHYqEINIbkfGe1IPdzHoE-1xQ&oe=6B01E243"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1379663751905733", "version": "1.0.43"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379663751905733"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.43\r\n\r\n- Faster skips, scrubbing, and chapter jumps: SMB playback now keeps its warm byte reservoir alive across seeks and MKV Cues hops, post-seek playback resumes after 0.5 s of buffered media instead of waiting for the full 10 s startup cushion, MKV Cues strip mid-GOP subtitle entries so FAST seeks land directly on keyframes, and USB-C SSD streams use a direct 512 KB buffered reader.\r\n- Zero-config DLNA Direct Play: Universal Media Server and Windows 11 Media Streaming now stream 50 GB+ 8K VR files out of the box with no custom renderer config.\r\n- Photo gallery upgrades: SMB, WebDAV, and FTP photo folders now show sampled single-eye thumbnails in the Vault when remote posters are enabled. Added a PHOTO STICK mode selector on the photo PLAY page (Stick: Next/Prev, Stick: Move Only, or Stick: L Skip / R Move) plus a stricter horizontal stick deadzone so moving 3D photos never skips files by accident.\r\n- Playback, skins & haptics polish: resolved the A/B loop pause-hold timeline drift on resume, quieted LINK / music-driven haptics cleanly on video pause and audio-focus loss, added Candy Stripes and Assembly Crimson to the 318-skin catalog, and removed unused legacy Android 11 location permission flags.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1794803749, "id": "1379663751905733", "version": "1.0.43", "version_code": 135, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379663751905733"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.42\r\n\r\n- VIBES headroom: INPUT SIGNAL VOLUME now works like a preamp. Turn it down and loud, heavily limited songs come off the top, so THRESHOLD can tell the kicks from the rest again. The new EXPAND slider (TEMPO off) spreads the top few dB across the whole graph, the opposite of a compressor. The THRESHOLD graph reads in dB and warns when a song is pinned at the top.\r\n- With TEMPO off every hit now gets the full envelope: ATTACK, DECAY, SUSTAIN while the music stays over the line, then RELEASE.\r\n- VIBE intensity on the quick strip: pull the trigger and turn the toy down or up without opening the menus.\r\n- Leaving a video for the lobby stops the music. Want it to keep playing? CFG > APP > Stop music on LOBBY.\r\n- The DETAILS view sorts folders by DATE, SIZE and LENGTH too, and shows each folder's item count, size and length.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1791696348, "id": "1302395862965856", "version": "1.0.42", "version_code": 134, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379663751905733"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.41\r\n\r\n- FIX \u00b7 A crash entering the lobby that could repeat on every launch until app data was cleared. The menu icons used far more memory than they should; menus are lighter and smoother now.\r\n- CURVATURE now wraps the screen around you: at 100% every part of a big flat screen sits the same distance from your eyes, at any DISTANCE or ZOOM, so the edges stop stretching. The trim reads in percent.\r\n- Holding the stick to scroll a menu with the laser on it now glides instead of catching on every row.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1791661212, "id": "1301551569716952", "version": "1.0.41", "version_code": 133, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379663751905733"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.40\r\n\r\n- NEW \u00b7 VIBES THRESHOLD: the line now fires the music vibes. BINARY is a steady pulse (LOCKOUT keeps hits apart), DYNAMIC follows the music, HYBRID blends both; TEMPO is now opt-in. A live graph shows input against the line, a BEAT light flashes on the beat, and PLAY after a pause restarts your accessory.\r\n- NEW \u00b7 LIGHTS THRESHOLD on a 20-240 Hz graph with a TARGET band, LIGHT SYNC with a CALI metronome, and FLOOR/CEILING/ATTACK/RELEASE.\r\n- NEW \u00b7 GLOW page: five presets, RADIANT EDGES that ray outward, and light ON VIDEO (off by default) with VIDEO BLOOM. Fast strobe on photo or video is opt-in, with a warning.\r\n- NEW \u00b7 Illustrated HELP for Music, Vibes and Lights.\r\n- NEW \u00b7 LOOP replays the video each time it ends.\r\n- 2D \u2192 3D (Experimental): steadier depth in slow motion.\r\n- Faster scrolling: hold to speed up, sideways to page, and a Scroll speed setting.\r\n- SMB sources always save and remember the password, Microsoft-account email usernames included.\r\n- Picture and laser keep working if position tracking drops but rotation remains.\r\n- Fixes: PLAY/PAUSE labels, Distance slider steps, stray HELP highlights.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1791518248, "id": "1298783336660442", "version": "1.0.40", "version_code": 132, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379663751905733"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.39\r\n\r\n- NEW \u00b7 MUSIC: play your music library inside VR, with EQ, A-B repeat that remembers each song, and a big PLAY/PAUSE wherever you are.\r\n- NEW \u00b7 CLUB LIGHTS: the room and your photos glow and pulse with the beat. Real-fixture presets, color, ROOM DARKNESS, and AUTO, which builds, goes dark and hits on the drop. Flash rate stays limited for comfort.\r\n- NEW \u00b7 BEAT SLIDESHOWS: change photos every 1, 2, 4 or 8 beats, or let AUTO follow the song. Timed slideshows now run from 100 ms to 60 s and play the folder, favorites or search you started from.\r\n- NEW \u00b7 2D \u2192 3D for photos, plus a 3D STUDIO with a sharper BEST depth model (downloads once on first use).\r\n- NEW \u00b7 DETAILS list view with sortable columns, a lobby RESUME chip, smooth stick scrolling, and every setting on one page.\r\n- 360 panoramas: the stick turns the dome and the horizon never tilts. Click the stick to recenter.\r\n- ChloeVibes for optional Bluetooth accessories now connects from the music page and follows the music, with adjustable sync, a calibration metronome and a safety lock.\r\n- Fixes: H.264 plays again after a legacy AVI; steadier exit from VR.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1791096622, "id": "1290935940778515", "version": "1.0.39", "version_code": 131, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
tent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS1eNOsyrA0Q7kNvwFaLrb7&_nc_oc=AdoVL5KA2ax0YtalVOwGP8DRlD59MwGHERokv9HfP6nC2CfBVVqDIt1BadRFaygQzjI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUm5VjT9PGvx36y_K-4RyBNwLfWeFCPhM07HET8RbYug&oe=6A661CCB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M5zigyFxr0Q7kNvwFecmZs&_nc_oc=AdpUq0AkwWcgvMjG_1cJrWz_iCEXtGqtmwblL2rfFlzspgETt0k4LHJBzv0oavW_sQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9MEZC1pN7TFaXPGwmrKos0JWIkwfrmFY47srjAJK6ng&oe=6A6608E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH9LUhlbOs8Q7kNvwFe_sLl&_nc_oc=AdoM1VS4fPZDhx2G54T-61edJutcFYtk6b-zA8DHIZWIywyibnKXQttqzy5I9UjIPcU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKva9tcyAh4rQNN6pDrNuYhhk7To_heJnKSDFAsKKLTA&oe=6A661903"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1161493310389446", "version": "0.3.14-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1161493310389446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Grab the library list and flick it: momentum scrolling plus a scroll bar for big collections, and every list now reaches its final entries.\nNAS scans go 5x deeper, and if a scan ever stops early it names the folders it skipped.\nPhotos: stick left/right steps to the previous/next file.\nNew NAS buffer setting (LEAN / DEFAULT / BIG / MAX) in lobby settings.\nLocal folders keep every image you chose - only tiny thumbnails are filtered.\nClearer error card for corrupt images.", "created_date": 1784674090, "id": "1161493310389446", "version": "0.3.14-m3", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1161493310389446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "\"Your library, your rules: manually configured videos always stay listed (MONO auto-hide no longer applies to your saved settings).\\nSBS/OU are now toggles - pres\r\ns the lit one to drop back to 2D.\\nThumbnails clear when items are removed and refresh when files change.\\nFlat drops a wrong stereo guess in one clean save.\"", "created_date": 1784666529, "id": "1161358293736281", "version": "0.3.13-m3", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1161493310389446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "\"Tester update 0.3.12: live cockpit sliders and full color grade, scene roll, smarter 3D guessing so Flat works on untagged titles, vault poster thumbnails, and multi-folder / multi-file add.\r\n\r\n\u2022 Live sliders + brightness / contrast / gamma / saturation / hue / warmth\r\n\u2022 Scene roll + live tilt/zoom tracking\r\n\u2022 Flat no longer keeps a wrong SBS split on untagged clips\r\n\u2022 Vault posters + add multiple folders/files\r\n\u2022 Still offline-first: your files, optional NAS, no accounts\"", "created_date": 1784663271, "id": "1161291937076250", "version": "0.3.12-m3", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1161493310389446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "\"Crash-stability update 0.3.11: smaller NAS read buffers to avoid out-of-memory on Quest, and safer NAS dialogs so the app does not crash if you leave the connect screen mid-scan.\\n\\n\u2022 Fix SMB out-of-memory under heavy network playback\\n\u2022 Fix rare crash showing NAS results after leaving the screen\\n\u2022 Includes Blu-ray ISO support from 0.3.10\\n\\nStill offline-first: your files, optional shares, no accounts.\"", "created_date": 1784605751, "id": "1160168243855286", "version": "0.3.11-m3", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1161493310389446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "\"Blu-ray ISO support 0.3.10: play decrypted BD backup ISOs from local storage or your NAS \u2014 main movie, chapters, and scrub. Encrypted discs still need a MakeMKV-style rip first.\\n\\n\u2022 Local Blu-ray ISO (BDMV) playback\\n\u2022 ISO over SMB / network shares\\n\u2022 Main title + chapters from the disc playlist\\n\u2022 Scrub on ISO titles\\n\u2022 Honest alert if the ISO is still encrypted\\n\\nStill offline-first: your files, optional shares, no accounts.\"", "created_date": 1784604760, "id": "1160153073856803", "version": "0.3.10-m3", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
cdn.com&_nc_ss=7f20f&oh=00_AQEiwu2wRDx98iqhBK_Y5Wd6ITu6SV1eZ88v2W86V5pHkQ&oe=6A7868A2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZNghz9CtggQ7kNvwHQZusj&_nc_oc=AdqWGM34wn-QCYTvk6BL3g-JgD65o1f-tEOgVTuiqGT21FkBajcbQXpRHJE18I5InAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ43hmuUZt_T4II5jIhh5lTjKGD0XauIMnsvCDrHYilA&oe=6A787FAA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifoNckTV6bwQ7kNvwEPvsti&_nc_oc=Adq7aQ4KdwlXMj7EQk5I0f4Ynvo0XnjhvoMqLRiaoBxaJDFz3byUXBZ5W1KyMo5kbBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJx9E8p-7d8DJgPsrCG_T_ZN0j6VD5_IyzY0R6J6xqpg&oe=6A788B5B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSTzf5lXNSQQ7kNvwFA5TkD&_nc_oc=AdoFS7WZe_GjfEZ5wPngrne9IiaWGNiIZ_WaiWcY03m4OilJHEaQDygaXO2PshCEP_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs_GA0kW_OiZgjqhyo8bXeMOswzLmV_Ckki2NhoxIKxA&oe=6A7878C4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB4GMlyfifMQ7kNvwGraIYh&_nc_oc=AdrfKlCip6TyKdpak2QJx7R8whY_bYLPaOWn9gthUiJcnBRQUR1JqT5Y5AXLoTBtGDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGthR_upkKWKTNHQYfJ7roZ87_kQ7G7N-DzQ_OaJVUz8g&oe=6A7891CB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C85u_jTk34QQ7kNvwFDxuqJ&_nc_oc=AdorPWb3rlwuKHNLEtqKEDEGj4awwqkcAfR_X-WwTHnJQ2QLv5fyG9ruN_s9KiLz9EE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx9IxuoClokjLBlNgM7K0h4pQHWeS22X4bMh1GkqJFzw&oe=6A787DE0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrhmbOeX-KUQ7kNvwEK1fUL&_nc_oc=Ado2mrXiG6qNgZ5N-ikaT03c4zpEeriAgOyuCZZKJiNfKWq3dOEhDWazE3z3XaJX4NU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_ODy9-73a9fN5yuDcEqY0PbnxmKWPxx8Wi4ouS5pR0g&oe=6A788E03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1183533358185441", "version": "0.3.38-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183533358185441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.38-m3 (code 44)\r\n\r\n\u2022 Club vault: smooth compositor-rate scroll and fling; South Beach teal UI; LIST default; DETAILS inspect pane; Recent / Unwatched / Favorites shelf filters.\r\n\u2022 MakeMKV / Blu-ray 3D (MVC) reliability: Stereo High remuxes are detected without special filenames, routed through the real two-eye path, and no longer treated as Full-SBS packing.\r\n\u2022 Right-eye-first discs (and left-eye-first) honor authored eye order; status and support reports distinguish base-only vs both-eyes active.\r\n\u2022 Stutter / \u201cslideshow\u201d class on MVC when the player reports no frame rate is fixed so the companion can arm and promote pairs.\r\n\u2022 German UI: Leave/Exit uses \u201cBeenden\u201d (not \u201cRaus\u201d).\r\n\u2022 Menu interaction hardening: quick transport and MOVE SUBS no longer leave the laser dead or silently ignore controller edges.\r\n\u2022 Stick-click slider reset and prior 0.3.37 Club polish retained.", "created_date": 1785878706, "id": "1183533358185441", "version": "0.3.38-m3", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183533358185441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.38-m3 (code 44)\r\n\r\n\u2022 Club vault: smooth compositor-rate scroll and fling; South Beach teal UI; LIST default; DETAILS inspect pane; Recent / Unwatched / Favorites shelf filters.\r\n\u2022 MakeMKV / Blu-ray 3D (MVC) reliability: Stereo High remuxes are detected without special filenames, routed through the real two-eye path, and no longer treated as Full-SBS packing.\r\n\u2022 Right-eye-first discs (and left-eye-first) honor authored eye order; status and support reports distinguish base-only vs both-eyes active.\r\n\u2022 Stutter / \u201cslideshow\u201d class on MVC when the player reports no frame rate is fixed so the companion can arm and promote pairs.\r\n\u2022 German UI: Leave/Exit uses \u201cBeenden\u201d (not \u201cRaus\u201d).\r\n\u2022 Menu interaction hardening: quick transport and MOVE SUBS no longer leave the laser dead or silently ignore controller edges.\r\n\u2022 Stick-click slider reset and prior 0.3.37 Club polish retained.", "created_date": 1785815382, "id": "1182307831641327", "version": "0.3.38-m3", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183533358185441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.37-m3 (code 43)\r\n\r\n\u2022 Stick-click reset for parameters: point at a lit slider (Sub delay, Distance, Zoom, EQ, color, etc.) and press the stick in \u2014 that control snaps back to its factory center detent. Point at nothing / no menu \u2192 full view reset as before (D1.00 / Z1.00 / gaze).\r\n\u2022 Quick strip: stick-click on Volume \u2192 100%; on Speed \u2192 1.00\u00d7.\r\n\u2022 Distance lock, UI languages, FULL-SBS geometry fix, Material Symbols Club chrome, subtitle fonts, and MOVE SUBS below picture retained. (HOLD and B-lock)", "created_date": 1785778822, "id": "1181650945040349", "version": "0.3.37-m3", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183533358185441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.36-m3 (code 42)\r\n\r\n\u2022 Distance lock on VIEW next to Distance/Zoom \u2014 freezes stick dolly so bumps do not move your seat. CLOSER/FARTHER and the Distance slider still work. Material Symbols lock icon (filled when locked).\r\n\u2022 UI languages in GLOBAL SETTINGS (bottom of list): System, English, Espa\u00f1ol, Deutsch, Fran\u00e7ais, \u65e5\u672c\u8a9e, \u7b80\u4f53\u4e2d\u6587, \u0420\u0443\u0441\u0441\u043a\u0438\u0439 \u2014 with flags. App chrome only; not audio/subtitle track language.\r\n\u2022 Club chrome localization for vault chips and key settings rows.\r\n\u2022 FULL-SBS geometry fix retained (true full-SBS stays ~16:9, not squished).\r\n\u2022 Material Symbols Club chrome, subtitle fonts, MOVE SUBS below picture, vault folder/NAS tower chrome retained.", "created_date": 1785776388, "id": "1181597235045720", "version": "0.3.36-m3", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183533358185441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR 0.3.35-m3 (code 41)\r\n\r\nToday\u2019s store build \u2014 what you get:\r\n\r\n\u2022 Club Material Symbols icons with real variable axes (FILL / weight / grade / optical size). Dark glass uses GRAD \u221225; active REAL fills. Folders, NAS cell-tower, SRC/CFG/HELP chrome \u2014 monochrome, not emoji soup.\r\n\u2022 Subtitle fonts: bundled OFL faces (Inter default) + SUBTITLE FONT cycle in SET.\r\n\u2022 MOVE SUBS can park captions BELOW the picture (not only on-frame). Sub height slider: BELOW \u2192 HIGH.\r\n\u2022 FULL-SBS geometry fix: double-wide SAR 1:2 rips (e.g. Rick and Morty FULL-SBS) keep ~16:9 per eye instead of squish.\r\n\u2022 Vault folder vs title chrome: warm folder rows vs cool media rows; corner NAS tower badge readable in VR.\r\n\u2022 Field pack retained: cinema distance/zoom, standalone m2ts, NAS one-level folder browse, ChloeLEXA support crosscheck.", "created_date": 1785734429, "id": "1180775051794605", "version": "0.3.35-m3", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
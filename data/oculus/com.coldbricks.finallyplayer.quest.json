40D02"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZvSREyUJg8Q7kNvwEiQfJh&_nc_oc=AdosYEyl8hHB3bP1ZSsbsICMo1z1Oy6DgPQsFZ8atOakF0-ldqzrHNiHoVORTmiL3pQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbF7G5d3BU1Mno07k7IHb7fStYfO4xgSC9OUeOFk6d9Q&oe=6AA42262"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkbjE7UmDsMQ7kNvwEYyNeV&_nc_oc=AdoQmr9I_dxVnFV9KXsrb3nVUZbFImQZ0v42ncZyz7bRvIEcJ-Cug7UanlOp2CvHOYo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4x5E2dJx0S_3AAM9IljHnp3lSu-CEv9uX2oirFKEytA&oe=6AA4012A"}]}, "id": "4536840456556530", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aUguJPXHzwQ7kNvwHJRvy6&_nc_oc=AdobpzZyfsR4AFvDmebpmAUF2H415WYxYCM62g-9YG34GsEb8Mhne-4yTql7aVOf1yo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7MvNrpYBX1dNR9Vi3HybMwhcg_EO7fi5LjnPpAnQG3w&oe=6AA40CDB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP9IbQ5WCNEQ7kNvwHZKuzC&_nc_oc=Ado0DnYPvZrXZbshJlByicuIukTIJit5zqdvR0-5Dps_USkUt7DTe6Wz1yT5mWVjMM0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPgG4JxPAReSg4ZHhEt-lvJ-ML1kDBcR3RRqWEmBGADA&oe=6AA3FA44"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA4FjgaGoiQQ7kNvwEU2zoU&_nc_oc=AdoAFdf23ube4-YnCS6IIGxYhpFP9IhWfOhkkvociXtV2y8sc-fJXNRjQtQ-xB7BAfI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUe7buXfHIKMiCHKm9LY5sEZW5q-1MpYrKN5CucEuIcQ&oe=6AA4134B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2XLER6swI0Q7kNvwG-3QWJ&_nc_oc=AdoY0yRrsuz7Acos3r7iFXo2PjHytCM71lpF4K4o5LyJBpqHtzjxPS4q20ERrAWg87E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRzR-9UK0mRlpHnzvsVV5uMoGe4uV5-m-6lglg5wTJBA&oe=6AA3FF60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93H_D73w0yUQ7kNvwHTeGc6&_nc_oc=AdosBoJCy-mtELRd-v-PAEmuMF1sNUbfQRU2F24Bm4QR6nRv1rgdnjhevqdAAwwhHu0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdYkt9g6vIqo7e9REBvlkpwEeAjl9LenMuuk7HEXq7Qg&oe=6AA40F83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161567437048700"}, "review_messages": []}]}, "cover_square_im
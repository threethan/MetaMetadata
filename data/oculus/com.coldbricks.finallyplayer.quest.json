cdn.com&_nc_ss=7f20f&oh=00_AQHec_P1nSdfu1zlByKdewLkSlaCkfDY7Bu5AWcxk4rlaQ&oe=6A898C22"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXfvoDuJYUgQ7kNvwFaYvbg&_nc_oc=Ado9MIEtSjANfRcb9wM0HpGYGKLfjmB5NU2ESBmk8faTNWcgWHLJUtk8Ow2dU6sA06c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO2dN4MwtkJRsyWrWc2nhz2T1dhKOXFvi54_dEAF5JPg&oe=6A89A32A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kWRElSGNm4Q7kNvwE7J1l7&_nc_oc=AdrFGEzjDGiBppx5rWa6kfI_Q0BGYG_8opSHuscmuoS8v_6gB87O0XW4yXJ1ksyi8_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlevKqz2LBVtJgFhdzlnX_42CwurpuK6TbSMXpKpqycQ&oe=6A89769B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z07cdLqelgMQ7kNvwEtWNco&_nc_oc=Adr9LBOjAXHYrkADvWl8aX8_fShRwP1QAes_uJitzVrJY7yxOxRXhuLrkQfJNXUbiik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHH_kaxoyeNyCXFI7xRobB8XOipShbLKle9SSJyW_9Lw&oe=6A899C44"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIYfiql97iAQ7kNvwHH-EmJ&_nc_oc=Adq3k8_-m44jgh3EolIdEG-gI-JxK4iBZcY-F8K8SrO2sPcEd1ingqErHh3Vz3U_sXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKvK8DHq_NJfEulkbeVT05ITKxdDwDWlHA8qjVxqmNFA&oe=6A897D0B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir7gE0cQXj4Q7kNvwGUNZpk&_nc_oc=AdqejKMLXfYP7VpbTtVVG7gHssJoToLo2VIVILd25d1R6Sx4nbfQUn12FzTflSUaMLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQpSiFPq94t3jw0UJ6kt3kTgsMMcQuZZkToPvkzxR9bQ&oe=6A89A160"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seglvzDxE4MQ7kNvwFoLqI9&_nc_oc=Adr6G4WpSci8m66hflTJWPP6eXEaXzUUmDUFfs3K6Goj1-nOsOf-hEuK2XzsCH254bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVUFcABTYvIEsZkuglhH2hDV7uR-vGuqugUpzUm5upWw&oe=6A897943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1201069123098531", "version": "1.0.6"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1201069123098531"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.6\r\n\r\n- Theater audio: optional world-locked sound. Turn it on and the soundtrack stays anchored to your virtual screen when you turn your head - like real speakers in the room, not headphones strapped to your ears. Three modes: Off (default, untouched stereo), Room, and Headphones. Recentering re-anchors the room.\r\n- Real HDR: HDR10 and HLG titles are now properly tone-mapped with correct color. Colors are rich and accurate instead of washed out; regular (SDR) videos look exactly the same as before.\r\n- Your color adjustments now stick: brightness, contrast, saturation, hue, temperature, and gamma are saved per title and come back the next time you open it.\r\n- Smarter FIND: search filters the folder you are in as you type, with a live match count. APPLY keeps you in the folder; CANCEL puts everything back the way it was.\r\n- Empty library? One press on \"On this headset\" scans your Movies and DCIM folders right from VR, asking for permission if needed.\r\n- VR format auto-detection now reads the 360/180 metadata embedded in MP4 files, so correctly tagged videos pick the right projection without filename hints. Your manual settings always win.\r\n- MKV chapter support: chapters stored in Matroska files now power the chapter buttons and seek rail.\r\n- Subtitles authored at the top or side of the screen now render where they were placed instead of the bottom strip.\r\n- A-B loops stick per title and come back the next time you open that video.\r\n- USB drives are a first-class source. Unplug the drive and those titles leave the library instead of going dead.\r\n- Browse your local XBVR player catalog in VR, including named lists. If you saved a login, Finally sends it when the catalog asks.\r\n- Handy stops when you leave the movie on Galaxy XR.", "created_date": 1786838194, "id": "1201069123098531", "version": "1.0.6", "version_code": 97, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1201069123098531"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.5\r\n\r\n- Theater audio: optional world-locked sound. Turn it on and the soundtrack stays anchored to your virtual screen when you turn your head - like real speakers in the room, not headphones strapped to your ears. Three modes: Off (default, untouched stereo), Room, and Headphones. Recentering re-anchors the room.\r\n- Real HDR: HDR10 and HLG titles are now properly tone-mapped with correct color. Colors are rich and accurate instead of washed out; regular (SDR) videos look exactly the same as before.\r\n- Your color adjustments now stick: brightness, contrast, saturation, hue, temperature, and gamma are saved per title and come back the next time you open it.\r\n- Smarter FIND: search filters the folder you are in as you type, with a live match count. APPLY keeps you in the folder; CANCEL puts everything back the way it was.\r\n- Empty library? One press on \"On this headset\" scans your Movies and DCIM folders right from VR, asking for permission if needed.\r\n- VR format auto-detection now reads the 360/180 metadata embedded in MP4 files, so correctly tagged videos pick the right projection without filename hints. Your manual settings always win.\r\n- MKV chapter support: chapters stored in Matroska files now power the chapter buttons and seek rail.\r\n- Subtitles authored at the top or side of the screen now render where they were placed instead of the bottom strip.", "created_date": 1786748221, "id": "1199350979937012", "version": "1.0.5", "version_code": 96, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1201069123098531"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.4\r\n\r\n- New A-Z jump rail in the library: with Name sort active, a letter strip appears on the right edge of the shelf. Tap a letter or drag along the strip to jump straight to that part of a big collection, with a large letter badge and a haptic tick as you scrub.\r\n- Your room now stays put. Seeking, pausing, or recentering no longer swings the theater background around you, and recentering while lying back no longer tilts the room.\r\n- Seeking and pausing a 3D Blu-ray no longer resets your screen position, size, or curve - the movie comes back exactly where you placed it.\r\n- One offline NAS no longer freezes your other sources: browsing and playback from healthy shares keep working while an unreachable server times out in the background.", "created_date": 1786674591, "id": "1197931890078921", "version": "1.0.4", "version_code": 95, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1201069123098531"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.3\r\n\r\n- The Handy support rebuilt end to end. \"Connect The Handy\" now works, including the Handy 2 and firmware-4 devices: the app speaks both HandyFeeling API generations and picks the right one for your device automatically.\r\n- Real error messages from the Handy connection: the app now tells you whether your Handy is offline, the key was rejected, or the network dropped, instead of one generic failure.\r\n- New \"Forget Handy key\" row in ChloeVibes settings, so a saved connection key can be replaced right in the headset.\r\n- Clearer Handy setup: copy your HandyFeeling connection key, then tap Connect. No desktop screen needed.", "created_date": 1786591715, "id": "1196433830228727", "version": "1.0.3", "version_code": 94, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1201069123098531"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.2\r\n\r\n- 6DoF head tracking in VR video: lean in and move, the scene answers naturally instead of staying glued to your head. On by default, with a 6DoF toggle in GLOBAL SETTINGS for viewers who prefer the classic fixed view.\r\n- Recentering with the Meta button now re-centers the video too.\r\n- Every row in GLOBAL SETTINGS describes itself in the footer when you point at it.\r\n- SCAN in the headset now picks up videos newly copied onto the device, no desktop screen visit needed.\r\n- XBVR setup guidance matches current XBVR (Options, then Players, then Player integration), and the app now tells you directly when Player integration is switched off.\r\n- Library stability hardening for very large libraries.", "created_date": 1786568137, "id": "1196061153599328", "version": "1.0.2", "version_code": 93, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
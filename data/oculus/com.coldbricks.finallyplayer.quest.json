cdn.com&_nc_ss=7f20f&oh=00_AQFFPRPrOKkmqm2n7s15pkx4d_0FTj_kPpvvO4Hm4wXXxw&oe=6A972BA2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4aenGSuZdMQ7kNvwH3Xif6&_nc_oc=Adou2eCfBTeTtnPEie6mgu96GZRzg-PHAr-TEkf1Z1FbHEGQAoCrgasxywcjR0vW3iM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk2RcsKsOU8mvZXcR5e1R6aEvDtpwD6hT-_xMnTd7eZg&oe=6A9742AA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jylWrhvLaH4Q7kNvwGHiISS&_nc_oc=AdqmNDaO-4I6j2DKXkj-HPrpGADVYLECDatrs3UerzXtBVkbR4pJIlYSRMf6cXy2Yuk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDpEJ64X5JHmV8z5KNgTZKOQHNo_TNk7MXTeNxAHWXlQ&oe=6A974E5B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQuwTBVpDPsQ7kNvwHwfs4i&_nc_oc=AdqcZ1lZMblGiDkVWyzCVwb904PXPjFAaZMvZ2xfEo8US-rID8kCl-Jz-YFLMDqI_9k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESryPH5jJt6Wxhq69zfbQW9GGq1N24MgfhBBP2l6lAUA&oe=6A973BC4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iat_jRGblu0Q7kNvwFmOfnB&_nc_oc=Adq8PSIO6nx_2C3oa1xpQPz__mEMhtVfcehXAg_OlLqJE2ti5xfygWXjxdOPr5KytcQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrwPtoLBFQ2QDYEGr54wmB0d7O43qFEybOFLKY3b08MQ&oe=6A971C8B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn3Qd0wnx5wQ7kNvwG8UkC9&_nc_oc=AdpR3LZu4ipfiZGER1jMaq5U1Q9IvFhQf2Jc87XYuKgBTiMcB6EAJBQ9p6CRuMuJQIo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmA-XMaJb_U5ExnqR_S006-75G_m9R-5MMKS0KPvORJA&oe=6A9740E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK4-nyZS_oMQ7kNvwH4Tpg0&_nc_oc=AdrteT85Ilhpcr_3S9vLHX_ZJyXnv6_2SMQRllwH86nGgeHTG2_DgTYjpFQi73zgyE8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1e3pwHMGlh54de-xnZjtKKAHDnF79WUBbgajo1wtSFQ&oe=6A975103"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1219498031255640", "version": "1.0.19"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219498031255640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.19\r\n\r\n- New START HERE button for first-time setup: pick your videos folder and you're in.\r\n- No more permission prompt over the intro; Finally asks for media access only when you add on-headset media.\r\n- Adding a folder keeps scanning after you enter the lobby; SCAN in the lobby now refreshes added folders too.\r\n- Stick closer/farther no longer triggers on left/right seeks and ramps smoothly from the gate.", "created_date": 1787721113, "id": "1219498031255640", "version": "1.0.19", "version_code": 110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219498031255640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.18\r\n\r\n- Fixed a browser crash when a web page tried to start its own in-page video player; page media now hands off to Finally's player through Videos.\r\n- Fixed an audio crash on MKV/MP4/AVI files whose Dolby, DTS, or MP3 track changes channel layout mid-stream.\r\n- The VR session now starts off the UI thread, removing a stall that could trigger \"app not responding\" after returning to the app.\r\n- Smaller memory footprint on Quest 2 for scrub previews, the boot intro, and passthrough mattes.", "created_date": 1787717094, "id": "1219436671261776", "version": "1.0.18", "version_code": 109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219498031255640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.17\r\n\r\n- Restored previous/next photo navigation without a distance jolt.\r\n- Photo stick left/right changes photos; video stick left/right seeks the timeline.\r\n- Grip + stick left/right keeps adjusting image height in photos and videos.", "created_date": 1787553486, "id": "1216510954887681", "version": "1.0.17", "version_code": 108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219498031255640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.16\r\n\r\n- ADD A FOLDER now keeps action text cleanly inside its button.\r\n- Photos no longer show a video timeline scrubber.\r\n- Grip + stick up/down is inert for photos.", "created_date": 1787551210, "id": "1216477498224360", "version": "1.0.16", "version_code": 107, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1219498031255640"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.12 \u2014 candidate release notes\r\n\r\n- Grip + stick \u2191/\u2193 changes title again. The 1.0.7 hardening turned it into a 600 ms full-throw hold that had to be re-armed by releasing grip, and nobody found it. It is now a short deliberate push that fires once; the stick only has to recenter between pushes, so grip can stay held.\r\n- The \u2193 direction learned the car-stereo rule: one push restarts the current title, a second push (or a push while the title is already near its start) goes to the previous title. \u2191 is still next. Stills always step.\r\n- The HELP tab's top row and side buttons no longer flicker under the laser. That page repaints its figures 30 times a second and the hover band was being cleared on every repaint; every other page already had the exemption.\r\n- The controller map placard and the field manual describe the new grammar.", "created_date": 1787500897, "id": "1215665064972270", "version": "1.0.12", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
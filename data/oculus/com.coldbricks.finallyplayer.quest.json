cdn.com&_nc_ss=7f20f&oh=00_AQKStq2XwzEf4rS_PfNsJQnNmCK4uXc7x167QFCG6DPbgg&oe=6AA02DE2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugeE1lc23g0Q7kNvwGGr5Qa&_nc_oc=AdobqsebW_u5Guopy0pbcQkzTJ-5Wlq4KM837CiaMleV6o4YBB9Yr8omMkfqyZx8lgw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7BR1bD-SYpndSUXhDg6ppUX_cMyPKaIErhxLdIyk2LA&oe=6AA00CAA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB6nHN0DGnYQ7kNvwFlz_8g&_nc_oc=AdpYZqlBgk4h5tG2XCdvkZC7wA7yzz23Ccu_zEl3kWCvEehxzb1sPcviUG6f4Cpw-6g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1gF2wcz3FHvBrRc1YEMzAaFxnBsmpW8Ouz0q5BPrg2A&oe=6AA0185B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90kc8d1wrccQ7kNvwGjo4c-&_nc_oc=AdrVjxbaZdAU38FeAL0RfSw59E2fMSNUV9ed216LXjLUypm7lUaX_Et9kWN6oOfQbo4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU4ApdyBmeSmxnkA1akmQbP_mmR8CqNOlRKyJLHBW1DQ&oe=6AA005C4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAlCX_C2Z2oQ7kNvwHzeM8v&_nc_oc=AdruWghVDtdgobahwscuQxGRyJvvUBU34bgSlOHv86dUpUbntqrOzCFrQXSSqgD3kdc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1DMWmahXvkKtybX8oO37olV8yHLdTEdPRv1AWQ3Fymg&oe=6AA01ECB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvNe4B9i1h8Q7kNvwGooT0q&_nc_oc=Adpq2sIpwH9yc3A2tY9qTLotmC9zoipSybMx6KokVWcTczQ_SRojpMME1uC5mM0itSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBmjW5AD_9kdL4akeklUtPR4Dr0K3I4x9-YbXW9O4sHA&oe=6AA00AE0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ageVaKtpDjUQ7kNvwG3Wp5j&_nc_oc=AdoSsmYaoY5UGP06msh_p1ctg4XjizeKx-2-PXpX2HX1gQ0yjXSPPVrzbocnRp_IR9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlPT9f58xD_chaBu86M9Yg21AGNq_D1ZLiSeXKzVYxnA&oe=6AA01B03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1232643176607792", "version": "1.0.25"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1232643176607792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.25\r\n\r\n- ROOMS is quieter: picking a place no longer raises a floating toast with the room name, and the \"fit to 4096x2048\" notice that appeared every time a room loaded on Quest is gone. The place name, category and mapping still show on the menu's status line.\r\n- Nothing else changed: decode quality, resolution, color and rendering are identical to 1.0.24.", "created_date": 1788473030, "id": "1232643176607792", "version": "1.0.25", "version_code": 116, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1232643176607792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.24\r\n\r\n- DLNA servers find themselves: the DLNA screen searches your Wi-Fi the moment it opens, names each media server, and one tap adds it and opens its folders. Typing an address is still there as a fallback. In VR, opening SOURCES scans the network by itself.\r\n- Stability pass from the crash dashboard: opening a title no longer waits on the media provider on the main thread; the app survives a process whose Application object is not ours (a Quest 2 launch path); removing a NAS, FTP, WebDAV, Stash or Plex source works even when the headset's secure storage will not open; saved sources are parsed off the main thread at start.\r\n- Support bundles now include a sanitized record of the previous run's ANR or crash, so a problem you report can be traced without any telemetry. Nothing leaves the headset unless you send it.\r\n- No change to decode quality, resolution or color.", "created_date": 1788465895, "id": "1232517823286994", "version": "1.0.24", "version_code": 115, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1232643176607792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.23\r\n\r\n- Faster lobby: every menu panel now draws on its own render thread, so the headset's main thread only hands the finished panel to the display. SETTINGS, folder changes and the scrub strip no longer queue behind poster work.\r\n- Faster local playback start and seeks: a local title starts moving once half a second is buffered instead of a second and a half, and the subtitle sidecar lookup no longer sits in the open path.\r\n- Playback timing is measured now: the log records press-to-first-frame, decoder start-up and seek-to-frame times, so the next slowdown gets chased with numbers.\r\n- No change to decode quality, resolution or color.", "created_date": 1788434596, "id": "1231885413350235", "version": "1.0.23", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1232643176607792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.21\r\n\r\n- A folder you add now keeps its own shelf, its name, and its titles after a SCAN, instead of being swallowed into the headset's photos and videos.\r\n- Sorting the vault by DATE now shows each title's date on its row.\r\n- Titles found by a folder scan are dated by the file itself, so DATE sort matches what you would expect.", "created_date": 1788314555, "id": "1229826840222759", "version": "1.0.21", "version_code": 112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1232643176607792"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.20\r\n\r\n- SCAN in the lobby now finds videos you copied onto the headset over USB or adb without a restart, and always tells you what it found.\r\n- REFRESH POSTER updates the title's artwork right away.\r\n- Smoother lobby when you have large network sources saved.\r\n- Removing an XBVR source no longer fails when secure storage is unavailable.\r\n- Fixed a crash some pages could trigger in the built-in browser.", "created_date": 1788310545, "id": "1229764130229030", "version": "1.0.20", "version_code": 111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
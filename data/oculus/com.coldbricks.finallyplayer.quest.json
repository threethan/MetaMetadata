tent-ord5-3.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58b5nehY8ZMQ7kNvwGTVLIl&_nc_oc=AdoCuWKJFH24T3w3nvD1qOLoSFQvcVNhu1iRFy9kopgO_mmYG6UKICzU3Hs696JHeWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL8xt0xMLibtx_4q-c39Dx779UIyXi1W8scJye5dPNCA&oe=6A6379CB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjS1jVut4g0Q7kNvwF2lnG_&_nc_oc=AdoNM8aQYv34DBxoHYCB5Ds4TrLSlBB0h1ryAd7fY3yl6F7pZQxoerSGApDLWozb9d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHktLxnZ4sMSwceuMkrHYpieO4bskGSTkvojwlOI9PcA&oe=6A6365E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qerF20y-G6wQ7kNvwE7kN8B&_nc_oc=AdojwcIH9rWiRdvbJlJVL4tjXTh3VASYEwPQVP_-oSyH7Xq5s_qcmZxLtMSVEV9lVG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChJpnr2vD4wNSr1x7LVjcoIVnJY_5DEppeKR5P4gqjfA&oe=6A637603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1156973780841399", "version": "0.3.5-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1156973780841399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "0.3.5 (build 8)\r\n\r\n\u2022 NAS: new optional Folder field \u2014 scan just a subfolder of your share\r\n  (e.g. media/vr) instead of crawling the whole thing.\r\n\r\n\u2022 NAS: music album art and tiny thumbnails are no longer imported as\r\n  photos during network scans.\r\n\r\n\u2022 New: TILT FOLLOW (Setup) \u2014 the picture stays upright to your face when\r\n  you watch lying down. Menus stay world-anchored.\r\n\r\n\u2022 New: MENU LEVEL (Setup) \u2014 the menu spawns level with the room instead\r\n  of matching your head tilt.\r\n\r\nBoth new options default off. No permission changes. No new network behavior.", "created_date": 1784422350, "id": "1156973780841399", "version": "0.3.5-m3", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1156973780841399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "0.3.4 (build 7)\r\n\r\n\u2022 New: FISHEYE 180\u00b0 manual lens option in the player lens row. Untagged plain\r\n  180\u00b0 fisheye files can now be forced to the correct fisheye projection \u2014\r\n  previously only the 190\u00b0/200\u00b0/220\u00b0 lens variants had manual buttons, and\r\n  VR180 (equirectangular) was the wrong mesh for fisheye sources.\r\n\r\n\u2022 Fixed: launcher icon \u2014 the Finally \"F\" mark is now optically centered.\r\n\r\nNo permission changes. No new network behavior.", "created_date": 1784419395, "id": "1156929270845850", "version": "0.3.4-m3", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1156973780841399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "0.3.3 \u2014 Environment grab-drag now tracks your hand correctly in the lobby; removed the experimental BOOM reverse loop (classic A/B and cascade loops unchanged).", "created_date": 1784388366, "id": "1156378904234220", "version": "0.3.3-m3", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1156973780841399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.2 (build 5)\r\n\r\n\u2022 Camera stills and large JPEGs display correctly\r\n\u2022 Vault laser hover is smoother and more responsive\r\n\u2022 Broader video/photo support; MKV audio path improved (AC-3/DTS-style tracks)\r\n\u2022 NAS / PC share: clearer setup, remembered last connection\r\n\u2022 Clearer playback errors; junk file types filtered from library\r\n\u2022 Smaller download \u2014 lobby environments use high-quality JPEG\r\n\u2022 Club polish: env drag feel, status overlay fix", "created_date": 1784090394, "id": "1150829438122500", "version": "0.3.2-m3", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1156973780841399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784076305, "id": "1150595701479207", "version": "0.3.1-m3", "version_code": 4, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
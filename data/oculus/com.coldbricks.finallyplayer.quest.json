2"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1RIepxlpCQQ7kNvwGOxxPO&_nc_oc=AdoQjm2155eaMJ0BOHjLaKPFVNcLXRC9_wgw2Q2RKlEQ_nuplOHx6i95zKFIibyGoRI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8FlSsq5zgM-IwDZG6_bWBLYytT6tnhzHF1RvaJiCbQw&oe=6AD39862"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_G796VweAYQ7kNvwHJoMmi&_nc_oc=Adot7riC90Rha0I34qPpD-tU6ceKkazjm4JBexy9NK8hZyf_z7HC88ab-yLtHg7XnG8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM237e4fVoWhuK3LS5dctUZ92F6hq5CmhXFLdTgV9E6gg&oe=6AD3AF6A"}]}, "id": "1376776781291320", "locale": "en_US", "screenshots": [{"file_name": "02-library.png", "id": "1390964799141465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831279_1390964802474798_6047325578666872246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQrc5c4ESxQQ7kNvwHIfjmp&_nc_oc=Adq-Yo5sPvfGm0tFr8rgfwen5VmptWQ4lxmBEFUs7q8tJ1cMTHPAb2yoWRgmYy-4RYI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONRjjnKUkQUNd2CZnVW9jBE2GWvQswUa03JfVyACpxaQ&oe=6AD3B512"}, {"file_name": "03-connect-computer.png", "id": "1798296184674552", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604360590_1798296188007885_4116644365857144993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eL3MJMgvK4Q7kNvwF3Etth&_nc_oc=AdoNqxSgeaV5uyHIVtrkh0iSLAmQFpP-ZkAuBWzx0UX0BH3P9BfZFf2gsRyOEAAX4eA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa6p9cTnjm9byAAwMhriVk9VD3y7p8bn_HSz0ySsbECw&oe=6AD3A738"}, {"file_name": "01-immersive-video.png", "id": "1053997607244217", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604317775_1053997610577550_2920253805503949335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05KvVtjoNKQQ7kNvwGIpqk_&_nc_oc=AdpuHhQ2Lokiohj2mL_jN9VDme8-Ty3xlIMX_iU4TLW3wiw9XHpfkkuB8D1T9AFFGVg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-NPj8QJML03JLjHx_J6-bq-65opTsyE1QaRTzWuOp1A&oe=6AD39AE9"}, {"file_name": "04-quest-help.png", "id": "2266933544083990", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595129854_2266933547417323_6404197436740496345_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8osB4DSKNYQ7kNvwHqGUuI&_nc_oc=Adr5yMBKLkSwp9W5BhYyVRhbIo5wuBZEk2aMAZT98cDP0R1Ia-4xxKJI9w3_Rk2CrJs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwGhpC9HguElXtOhR0QPYmLP09ow5hjAWZYcBLk1ucwA&oe=6AD3BBDE"}, {"file_name": "05-pro-playback.png", "id": "1373037901476301", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595119480_1373037904809634_6881609859731654856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVixnNsrD2EQ7kNvwEmxR3M&_nc_oc=AdqJU4MeamQWtVkOIAuytjI6jBWlvUwUVf6nD4m5M963e1dBNdFERmHNoge8jYow6J4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOknuxxsUGin1OUZKnc23CfrHuacA3qAO8uixAovJGAbw&oe=6AD3AB66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1237255869479856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
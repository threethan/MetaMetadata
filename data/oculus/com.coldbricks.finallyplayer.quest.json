cdn.com&_nc_ss=7f20f&oh=00_AQJmfub0ORlej-qaiu1Px6S9r1wxc-cIHjbmZWWXO5J5LQ&oe=6AAEAE62"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwieQZcwCBsQ7kNvwFqUhSr&_nc_oc=AdqBVPpmWWucmKHuFhneAfJ40mwYs_VMd7nTBzMTlJWMQieqdIravVxuIazmrLMVkyo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmDMLX-XAHpJ9OiSahaYqfWKAWEppuM6rFVdZR8lc37A&oe=6AAE8D2A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fqfSHjyfyUQ7kNvwG4QERL&_nc_oc=AdreQRNfd4OgFURPxt6eYDl8hWlrpeLPbLzveZNIMdl8UOJaJ3Kx0mV3IiARpKxL_XM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOXQ1x4N4aTTcs6TrdNI5chMw8AlWY0fCZRHOVbNuORQ&oe=6AAE98DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViHGEwfTs7sQ7kNvwEsE6Xh&_nc_oc=AdpiiM8xtuW2QGIm6NZuFjS_-rQgij_fYsiJBUNUNUtQPPCDQNjQ4zKLKs076c9c21M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWgGZJL9j6OL2uhI4-wLclkSjHqOSTbOHPDZFnAdUJvA&oe=6AAE8644"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlA7jxjR3VYQ7kNvwFP9gk7&_nc_oc=AdrG6fcRfe9JipscOrtb1xMit9YAkAX2hKjolMRA5VlJNqAypc8NjyioHSHBQ8Zsx6o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-2X1Wa-RxFA89z6rg8AlCEol_aFEJWrQqsID6cMsiUw&oe=6AAE9F4B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AhMW6YLOB4Q7kNvwE-1MgY&_nc_oc=Adrqx8vrFtE9ZZHcMdrBC9Z7MVd0FQPDbyNe-VnqGr5esh9kYqQCojqhdpR86Fp3ml8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyyjmi6-2Li_1k8VFjV-hX2VavC72GheKZAXmLP2OiJw&oe=6AAE8B60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0OIF7W8UXgQ7kNvwE5oza6&_nc_oc=AdoSpID9hFgLCHgLPU1LPxU2X_FONrD7FKo2vEa9Dnv5jYCLZuDtEQ-p6e_TzEZ967c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM4fItxl418xGu_M9tfI01B7nbcXb2ZjirqykbpOiKJg&oe=6AAE9B83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1249943151544461", "version": "1.0.33"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1249943151544461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.33\n\nA small polish update to the familiar player and library controls.\n\n- Clearer PRO playback, chapter and Lobby labels.\n- Preset and room-state labels wrap when needed so the full text stays visible.\n- Library Tools paging buttons are disabled when there is no previous or next page.\n- Empty naming fields now distinguish folders, files and playlists.\n- Updated the matching in-app Help illustration.\n\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1789415502, "id": "1249943151544461", "version": "1.0.33", "version_code": 124, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1249943151544461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.32\r\n\r\nSaved playlists, offline downloads and file tools are now available from MORE.\r\n\r\n- Mix headset, USB and network videos in named playlists.\r\n- Download videos to the headset with progress, cancel and retry.\r\n- Create folders, rename, copy and move in writable headset, USB and SMB locations.\r\n- Read exFAT USB media, including large files; improved access, rescanning and unplug behavior.\r\n- Create named cockpit palettes with a color wheel and live previews.\r\n- Improved MVC eye order and large-file/FLAC playback, with working cinema curve and bow.\r\n- Newly opened videos start at 1\u00d7.\r\n- Steadier Help highlights, more reliable photo and cover controls, and a clear photo footer.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1788897941, "id": "1240552042483572", "version": "1.0.32", "version_code": 123, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1249943151544461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.31\n\n- Optional Auto-hide controllers hides models and lasers after the menu closes during videos and photos. Buttons remain active; opening the menu restores visibility.\n- Clearer DLNA messages for sharing restrictions and unusable media entries.\n- Trigger and drag to scroll Help articles, with new text zoom controls.\n- Theory and Deeper are available in Lobby Help, with animated diagrams.\n- Larger controller placard text and corrected height-control instructions.\n- Experimental 6DoF now defaults OFF. Tilt follow remains OFF by default.\n\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1788815269, "id": "1238897899315653", "version": "1.0.31", "version_code": 122, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1249943151544461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.30\r\n\r\n- Controllers in front of the menu stay visible instead of being cut off by the panel.\r\n- Lobby HELP now includes illustrated articles and controller diagrams for your platform.\r\n- All Help topics stay visible while you scroll the selected article.\r\n- Read longer articles with PAGE UP, PAGE DOWN or the thumbstick.\r\n- Lobby Help keeps its own topic and reading position, separate from playback Help.\r\n\r\nLean native OpenXR for Quest and Galaxy XR.", "created_date": 1788720509, "id": "1237193169486126", "version": "1.0.30", "version_code": 121, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1249943151544461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 1.0.29\n\n- Easier-to-find SOURCES with clear headset and computer/NAS choices.\n- Simpler SMB sign-in and optional advanced settings.\n- Back returns to the Lobby after canceling setup.\n- Clearer DLNA access messages and improved SMB recovery.\n- Cleaner scan cancellation and local folder handling.\n- Better audio-language fallback and delayed subtitles.\n- Correct reset defaults; pending view resets cancel when paused.\n- Browser handoffs stop when you leave.", "created_date": 1788710912, "id": "1237007109504732", "version": "1.0.29", "version_code": 120, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
cdn.com&_nc_ss=7f20f&oh=00_AQEY9w4P_Sk985hWsrxnhn1BWWZ1lJM6NJF2t8O5YxE_mg&oe=6A71D122"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifzAFlDdnVEQ7kNvwFU9U33&_nc_oc=Adr1q2DfuNeK5qs7yUm1fr6SdzK2Lx_s3sqXEN3fL12jaPen79FpZYRgetg92a1lujg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyetelCIe3GS6bBRy1m3yTRVxfqxKlejl8xYNmKwHcEg&oe=6A71E82A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYiNovqtJgIQ7kNvwH-UlLX&_nc_oc=Adpgj4V0hN3Z0nAaCWBlvJpHEfOdWhWI13-IYc9LQRyZMSPqgjwSFfJY5_GqBu722Is&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv64NQGKmClapCD-JtO7ofi8lKAWus_w6CZjyoF0vvhg&oe=6A71F3DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WRoHYGl_QsQ7kNvwH8Pvmd&_nc_oc=AdpoUhPZu-K8IkgQQVOnhwHFlQ8-5OKfYVfNk9wLfKY3Mucs-QdyG7NN8yI1Rqq7Bno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKLN3Wr-1rwiUChgCivzqLt6ORULTh5BcX83ZdZUuy3w&oe=6A71E144"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQt-djRxzsQ7kNvwHs_DVA&_nc_oc=AdoJjvYqEd6Pe63-0vKRvNjDKWWPu3DHATTcoCqQzOGWOE_OkaAiPCQpw32haK-17kc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM3qi_aL-ITWLmFFsU-V_DjHdCHVxTJt5ahz_LPvAUJQ&oe=6A71FA4B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vstEEx9z_jIQ7kNvwHtZax-&_nc_oc=AdoS93K8jvgykO390OBnEUC0VtC1Muz6jFmsb6uYz8LgA9LYrPRnQHDbTr1vD5EtSek&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMkONU_AlfJWw7eaBLhaKsPHPbKe9kbhMVfG7YsqH5CQ&oe=6A71E660"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUXbtrTSYPYQ7kNvwFwqxLF&_nc_oc=AdrX7JImJ4YpHW4cjAy4_WwRaXX9eIDUXb4i3Sj5TbQ4By5NZ1eJ3bnwCGOLu_cheAw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA6hz44ETC2KQZp5YrYwOwntF5ybqel0b3xpuD78svmQ&oe=6A71F683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1175992712272839", "version": "0.3.29-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1175992712272839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.29-m3 / Quest code 35\r\n\r\n- Fixes vertical stick control for VR180, VR360, and fisheye media: forward/back\r\n  now changes the visible and saved Distance value, never a hidden offset or\r\n  Zoom.\r\n- Clicking either thumbstick now resets both Distance and Zoom to\r\n  D1.00 / Z1.00 and recenters on the current gaze.\r\n- Keeps the 0.3.28 large-library importer and repaired PRO control layouts.\r\n\r\nThis signed artifact remains an internal candidate until uploaded and accepted\r\nthrough the Meta store track.", "created_date": 1785467250, "id": "1175992712272839", "version": "0.3.29-m3", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1175992712272839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.28-m3 / Quest code 34\r\n\r\n- Adds a bounded Device Media importer for large local libraries. Video and\r\n  image discovery now bypasses the system Files multi-select path that could\r\n  crash or blank out with thousands of files.\r\n- Keeps existing favorites, resume positions, ratings, and projection settings\r\n  when legacy local paths migrate to MediaStore content URIs.\r\n- Repairs cramped PRO controls: Quick Place text and the Room Dim and Haptic\r\n  Strength sliders now remain inside their buttons.\r\n- Includes the WebDAV, Stash filename, immersive search, subtitle, Plex sorting,\r\n  and background MVC shutdown improvements from the prior candidate.\r\n\r\nThe exact debug code passed a real Quest 3 import of 982 MediaStore items in\r\nfour bounded batches, plus a 10,003-item host regression. Signed store artifacts\r\nremain internal candidates until uploaded and accepted through the store track.", "created_date": 1785458027, "id": "1175846372287473", "version": "0.3.28-m3", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1175992712272839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.27-m3 / Quest code 33\r\n\r\n- Improves WebDAV playback compatibility with safe HTTPS media handoffs while\r\n  preserving byte ranges and keeping source credentials private.\r\n- Uses a sanitized filename when a Stash scene has no title.\r\n- Adds a controller-first SEARCH keyboard directly inside the immersive vault.\r\n- Includes external subtitle loading, the large-library Plex sorting/crash-loop\r\n  repair, and non-blocking MVC/3D shutdown from the prior candidate.\r\n\r\nLocal protocol and cross-variant checks passed. Live server and on-head\r\nacceptance remain required for the exact staged build.", "created_date": 1785428021, "id": "1175273612344749", "version": "0.3.27-m3", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1175992712272839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.25-m3 / Quest code 31\r\n\r\n- Adds Find nearby sources for SMB hosts and DLNA/UPnP media servers.\r\n- After sign-in, an SMB server can list its visible SMB2/3 disk shares for\r\n  selection. Manual share entry remains available for hidden shares or servers\r\n  that block listing.\r\n- Repairs controller navigation: trigger press edges act immediately and\r\n  independently, and B backs out of lobby panels and folders before hiding the\r\n  root vault.\r\n- Adds an always-visible BACK TO CLUB action and Android Back handling to Watch\r\n  Together.\r\n- Improves preservation of photo zoom and placement through title switches and\r\n  explicit XR exits.\r\n- Makes a stalled NAS during Blu-ray/ISO playback report a bounded network\r\n  error instead of freezing indefinitely.\r\n- Reduces redundant work in large libraries and hardens nearby discovery,\r\n  DLNA, SMB, remote-media, and ISO concurrency paths.\r\n\r\nFinally remains a content-neutral player: no hosted catalog, no accounts, no\r\ntelemetry, and no ads.", "created_date": 1785379932, "id": "1174361769102600", "version": "0.3.25-m3", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1175992712272839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.24-m3 / Quest code 30:\r\n\r\n- Subtitles now keep a consistent readable size instead of enlarging short cues.\r\n- Added external SRT, VTT, ASS, and SSA subtitle selection, clear EMBEDDED/FILE labels, and saved subtitle looks.\r\n- Refined the immersive menu with clearer hierarchy, spacing, contrast, selected states, and subtitle controls.\r\n- Hardened WebDAV range reads, remote MKV opening, ISO/MVC lifecycle handling, and large-library scanning.\r\n- SMB rescans now remove stale titles safely, save work in bounded chunks, and avoid leaking media paths to logs.\r\n- Improved first-run guidance, 8K environment memory handling, XR shutdown, trusted-LAN connections, and Watch Together joins.\r\n- Includes the large Plex/NAS sorting, resumable scan, WebDAV MP4/ISO, VOID room, and controller fixes.\r\n\r\nNetwork servers and media files vary; this remains a pre-release build.", "created_date": 1785356983, "id": "1173979475807496", "version": "0.3.24-m3", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
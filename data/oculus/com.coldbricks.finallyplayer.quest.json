cdn.com&_nc_ss=7f20f&oh=00_AQFzkM5eTz3yCORTNBK1gUxfyu8HcthtpGFM0tV-DbQJyA&oe=6A7C5D22"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rlo0pmFfJoQ7kNvwEnkaZJ&_nc_oc=AdqPy40oq5l7EPWXlE_Tkn3ZFYoSkXjDuSIaAcLndETsu0ZkM_U76_3ZZIoRW51c0k8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr06MwAEiVFbmc4gWdarCSvlEP7yVfherz3FjwL8OlCQ&oe=6A7C742A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSXsf44iCsYQ7kNvwHEBVMh&_nc_oc=AdrPKqQhkbUAGvYe8GbvUdN_8nVw5-QtLj4bx4DJ7AHlSPRpUROZWEjYoNgCTV8J-04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkYLX1qyyF0ogAIk1CM5-06MavFxX6BQHqPu98R2e47Q&oe=6A7C479B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5Jt0dXUApgQ7kNvwGRXmkC&_nc_oc=AdpwNlza1xfm3MDmZLkZ8e-IRgZRBl2qhoC-zkUn7lcA78G1uUs9ZrQ1g-rAZ64LYbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSE4VdqOBgU7zwu_FiLrLrKlxvmoXc9UdHHxePw0cGkw&oe=6A7C6D44"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWrWP7tfdR4Q7kNvwEhKX3p&_nc_oc=Adr3KARHddEOmuMSUTWyHLMaI2V-0SwjWUagtyP6zu6VkkOebYMRqG4THPY3bjw95No&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKE7ALisvIGr6eErQcK2Y9KJu5L_UQszFaB6QoSvZNUA&oe=6A7C4E0B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVJ3b_VtHFoQ7kNvwE7qTH4&_nc_oc=AdriX4y-GhoXG8nHUX4laBY4sDAqR4x-rUy_kwHBabfH49mhW85XSzkX4FNY9_4aTG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWx6EZqh-c4uMr3KZC3DPydS3OYrjYCnynA0bS6gw-dg&oe=6A7C7260"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLkrcAZQI9QQ7kNvwFdqpYc&_nc_oc=Adqwkb351BXk39n0FZz3NJFGQuraPcrqRqMFfpuUR_HSMESJJbaLTlD22Mx-qLzZzhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmJAHDUVqiRbBtBgWx6Sze9t9V-cZHzOQsOXypL0_zLw&oe=6A7C4A43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1185922511279859", "version": "0.3.62-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1185922511279859"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.62-m3 \u2014 the reliability wave\r\n\r\n\u2022 COVER layout: scrolling fixed \u2014 flicks glide again instead of freezing\r\n\u2022 Faster menus: vault scrolling is smoother under the hood on every skin\r\n\u2022 Long settings pages now scroll with the stick instead of clipping\r\n\u2022 Restored controls: RESET VIEW / RECENTER / AUTO in SIMPLE view, LEAVE on the color page, DELETE in the vault\r\n\u2022 B button now steps back one menu level in settings instead of jumping to the vault\r\n\u2022 Language picker is an inline pull-down with flags \u2014 plus hundreds of translation fixes across German, Spanish, French, Japanese, Russian, and Chinese (the first-run flow is now fully translated)\r\n\u2022 Playback resumes automatically after a notification interrupts audio\r\n\u2022 Friendlier launch check on slow networks \u2014 retries with a visible message instead of closing\r\n\u2022 Bug report button now confirms on screen when pressed\r\n\u2022 Japanese subtitle files detect correctly (Shift-JIS)\r\n\u2022 Smoother high-bitrate NAS playback after buffering", "created_date": 1786005327, "id": "1185922511279859", "version": "0.3.62-m3", "version_code": 69, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1185922511279859"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.61-m3 \u2014 skins + MVC speed\r\n\r\n\u2022 MVC 3D: changing play speed no longer drops two-eye stereo to base-only / crawl; speed stays locked at 1\u00d7 while MVC is active (with on-panel notice)\r\n\u2022 Skins board: continuous scroll (stick + laser drag/fling), hard-clipped well, HI-CON rail label, MARITIME / OPS / SIGNAL type sections\r\n\u2022 Theme catalog expansion (dive, ops, RF, album-cover music, high-contrast packs)\r\n\u2022 Vault page chips use \u25b2/\u25bc (not a right-arrow for \u201cnext\u201d)", "created_date": 1785974240, "id": "1185384184667025", "version": "0.3.61-m3", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1185922511279859"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.60-m3 \u2014 field fixes\r\n\r\n\u2022 MakeMKV / Blu-ray MVC 3D: better left/right eye order (right-first titles no longer need Swap by default when the container reports it)\r\n\u2022 Subtitles: changing tracks or loading an external file no longer freezes cockpit controls\r\n\u2022 System menu return: playback pause fence so the app stays responsive after Oculus / Android menu\r\n\u2022 CFG: fixed garbled characters under curvature", "created_date": 1785951471, "id": "1184934504711993", "version": "0.3.60-m3", "version_code": 67, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1185922511279859"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.58-m3 / Quest code 65\r\n\r\n245 cockpit skins with a fixed TYPE rail (icons + labels on one grid), full-width color bars, and Cockpit skin in CFG. Theme picker layout fixes from Quest field shots.\r\n\r\nPlay chrome never auto-hides while you read; off-panel trigger is dark room only. Boot film on by default; first cold start cannot skip; later SKIP on screen or permanent HIDE in settings (opt-in). Empty vault: ADD A SOURCE; media permission only on import.\r\n\r\nSBS/HSBS packing icons corrected. Tutorial never auto-pops. Field manual theme catalog live.", "created_date": 1785910137, "id": "1184076684797775", "version": "0.3.59-m3", "version_code": 66, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1185922511279859"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.58-m3 / Quest code 65\r\n\r\n245 cockpit skins with a fixed TYPE rail (icons + labels on one grid), full-width color bars, and Cockpit skin in CFG. Theme picker layout fixes from Quest field shots.\r\n\r\nPlay chrome never auto-hides while you read; off-panel trigger is dark room only. Boot film on by default; first cold start cannot skip; later SKIP on screen or permanent HIDE in settings (opt-in). Empty vault: ADD A SOURCE; media permission only on import.\r\n\r\nSBS/HSBS packing icons corrected. Tutorial never auto-pops. Field manual theme catalog live.", "created_date": 1785905508, "id": "1183996434805800", "version": "0.3.58-m3", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
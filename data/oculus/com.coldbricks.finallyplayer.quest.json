cdn.com&_nc_ss=7f20f&oh=00_AQGWsIcb8Tb3lW5I1h5IPmlnmNhHrKQEd5Kfb4pQIIRyMA&oe=6A82F4A2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkJozbEgN5oQ7kNvwH9C_rR&_nc_oc=Adqc6kD-VIeESy6k_ke-rxQu4od6n89xVu3-hWXyciFMAJn1fEVP9RFo0mQ69cefa4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoeFfFb_O75Z6KHKfMXcaIe0k9Eg1LZd09SvbTwQ_2fg&oe=6A830BAA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eew_QPOhdtgQ7kNvwEDDuml&_nc_oc=AdrJMqgvlGbj0j5WSJYMNL9ETWk88PmvAGuvWKd5_h8Tr9jadFMTL8MlMZ-QSdfIFN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO_RDgCbU2Bz4JI0hUUcnajczXxUhhbN4XERtb6vxSrw&oe=6A83175B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13RjaJkA-6EQ7kNvwEXhMKD&_nc_oc=AdoX3CPTSFEH4-dUdDAZa3-G10s58l2yII3WJ39ccuYoxcu_EIOSCzVulM-2Xi-_rbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFufo76Jt5YwmUuPwf7AzfHs4jV3bQnDOACg4VrvVbZLw&oe=6A8304C4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5iogk2j3KUQ7kNvwHZ6ply&_nc_oc=AdqeVEjrQFRH-kMr74d_8JYurKPIum_x-TsE8eKmzTNAANLZTVOtkHCLM1xznd9Ok18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwjmpgou8txsp17Wubr9WtOW8o-0ArGoVvKMbDLmbSlA&oe=6A82E58B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3dBWnQrIhcQ7kNvwGkinzp&_nc_oc=AdouCE4JvJF_MmJhwWX4nojtnTXcb4O6l6E4ladoSTGxT7tqw5UkipmlOHg7cPTY4fY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzXAxWn0h0rW6ftZDtuB91S--mqKMjzSWYvTsGfGOKGQ&oe=6A8309E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIKRU6kaQLQQ7kNvwEHDkpo&_nc_oc=AdqSIu50SLcuBLbILGLEhc2hvwwSlAB70L3VDBpbVvK-9Lv3NyJG0eyCzKV2ZSbn-TQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdhQTWL3bn2K4_-Fa-MUv8-BtHETy9AErWgsItWfnZMQ&oe=6A831A03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1196061153599328", "version": "1.0.2"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1196061153599328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.2\r\n\r\n- 6DoF head tracking in VR video: lean in and move, the scene answers naturally instead of staying glued to your head. On by default, with a 6DoF toggle in GLOBAL SETTINGS for viewers who prefer the classic fixed view.\r\n- Recentering with the Meta button now re-centers the video too.\r\n- Every row in GLOBAL SETTINGS describes itself in the footer when you point at it.\r\n- SCAN in the headset now picks up videos newly copied onto the device, no desktop screen visit needed.\r\n- XBVR setup guidance matches current XBVR (Options, then Players, then Player integration), and the app now tells you directly when Player integration is switched off.\r\n- Library stability hardening for very large libraries.", "created_date": 1786568137, "id": "1196061153599328", "version": "1.0.2", "version_code": 93, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1196061153599328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Playlists, slideshows, and stability update:\r\n\r\n- Playlists and slideshows now remember your zoom and distance across titles.\r\n- Photo slideshows: per-photo timing, hard cut or fade transitions, and a steady view (no re-centering between slides). A GLOBAL SETTINGS switch hides the controls if you never use them.\r\n- Folder shuffle and slideshows stay inside the opened folder, including SMB shares.\r\n- RESET VIEW restores natural picture orientation; finite 3D screens can no longer rotate behind you.\r\n- Network fixes: dual-stack and VPN-reached NAS hosts connect reliably, and saved sources survive updates.\r\n- More robust 3D Blu-ray ISO playback and seeking, safer source removal, and haptics emergency-STOP hardening.", "created_date": 1786513608, "id": "1194964023709041", "version": "1.0.1", "version_code": 92, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1196061153599328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Picture recovery and library navigation update:\r\n\r\n- Prevents finite 3D screens from being rotated behind the viewer.\r\n- RESET VIEW restores natural picture orientation.\r\n- Folder shuffle and photo slideshow stay inside the opened folder, including SMB shares.\r\n- Missing local files trigger safe library reconciliation.\r\n- Improves MVC/3D seek continuity and simplifies source setup.", "created_date": 1786428944, "id": "1193384393867004", "version": "1.0.1", "version_code": 91, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1196061153599328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Update 1.0.0 (build 87):\r\n- Real controller models: your actual controllers now appear in your hands, with correct materials on Quest and Galaxy XR.\r\n- HELP manual: photographic controller map for your platform, smooth animated figures, and fixed flicker on animated pages.\r\n- Stability: menu presentation watchdog prevents rare frozen help figures; hover highlight no longer strobes.", "created_date": 1786337573, "id": "1191794487359328", "version": "1.0.0", "version_code": 90, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1196061153599328"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.0\r\n\r\n- Multi-select in the library: press SELECT, check any rows, then favorite,\r\n  hide, or color-tag them all at once.\r\n- Hide titles or folders from the list without deleting anything \u2014 a HIDDEN\r\n  chip brings them back whenever you want.\r\n- Color tags: mark rows red / amber / green / blue / violet with one control.\r\n- Deleted files no longer leave stuck entries behind: opening one cleans it\r\n  up, and SCAN sweeps the whole library in one pass.\r\n- Favoriting a row keeps your place in the list instead of jumping to the top.\r\n- 3D depth now survives a replay: a side-by-side title that reaches its end and\r\n  starts over comes back in stereo instead of flat.\r\n- A missing or deleted file can no longer crash the player. Next and previous\r\n  skip past what is gone, and a title that vanished says so instead of\r\n  dropping you back to the lobby in silence.\r\n- Rebuilt manual: the controls diagram is finally the controller you are\r\n  actually holding, and there is a new Haptics page.\r\n- Lobby menu stability and vault scrolling reliability improvements \u2014 hard\r\n  flings no longer corrupt the list.", "created_date": 1786278017, "id": "1190769224128521", "version": "1.0.0", "version_code": 86, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
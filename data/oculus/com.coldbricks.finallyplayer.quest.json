2"}, {"file_name": "finally_icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynrm1BaWuvoQ7kNvwFF1f05&_nc_oc=AdpaMOQwxiJvfMzZrRVnKLsOmT5TW2ZZXxCQxAPsOKjOD9_d6NHzGV2s4XFihE2nSmc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_4bzLHwZQCxz6Uu7GRVO_YtX_xoXIL-AeLFR9D07VaQ&oe=6A771722"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZNghz9CtggQ7kNvwFVlnDL&_nc_oc=Adr2mjVk8jTWETP63oeHNA7mqzN2R-1hGfms1WelPmF1YtkTUWLpIjZ2Ci4w0ImJ5Mk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU92Mm7OGxj6sm6yYH1QJ_rtBHIkBD4TbRhVgnXZi1_Q&oe=6A772E2A"}]}, "id": "4536840456556530", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifoNckTV6bwQ7kNvwHMDzNP&_nc_oc=AdoTiRC9ECWTutRUegt647iiPqRhYfdel7EX6tC16j4iYo14ql4hbLucYCMFdNOG1Oo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZvbVvP1p1u88wn0IsZDPNaLSB3biqej6o92ED7Teu7A&oe=6A7739DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSTzf5lXNSQQ7kNvwFq3LOy&_nc_oc=AdqRO8vGydKfPAOVanOealX0qNIuDdrQV2So8vCMoFJQm5rtyLMpN1nIQaTkrOX9MPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Co5NuFmY32s4B7NasBHLaFWLb4HDPCc4SmyOHwjgsw&oe=6A772744"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58bEMccS6ZQQ7kNvwFG24MN&_nc_oc=Ado7NTPMqTelHJy1VakdlAfQkllPN9y6y0qpkYDTwtno7rjBSPB6aE4spOsJQNw_alU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPMmq_SIMi4TY_ogP2ybj-OArlAUAWTIsncrggAicbcg&oe=6A77404B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C85u_jTk34QQ7kNvwFV2IbX&_nc_oc=Adoi8yuQIt4kyxeYKSne4LLVD-XGKU1fJX2kaFoWT2CJkQuukzrgILCIvCBy3htutrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl2E4kjMdBz5UgIotvPQQYoUyTRnN7G2GxI94aVW2Psw&oe=6A772C60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrhmbOeX-KUQ7kNvwFv1wqr&_nc_oc=AdpDPf9Ay--WGQULap_vS0GLrumQ3_3KZJ7B3mIyoWEe6lnxve3lYHfy2URn9OQVZck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3VDzpVbRM1Wz53S6lBdtoFtyPfYoJxgg8jHU4Iw3StA&oe=6A773C83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "Finally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, SBS/TB \u2014 auto-detected, with overrides that stick\n- Blu-ray ISO support for your decrypted rips\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR theater with SIMPLE and PRO cockpit modes\n- Grab the library and flick it \u2014 momentum scrolling for big collections\n- True scene dolly, refresh-rate matching, lie-back tilt follow\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with an in-headset laser color picker\n- Passthrough lobby \u2014 or drop in your own 360\u00b0 worlds\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title memory, A-B loops, live color controls\n- No telemetry, no analytics, no ads\n\nFull field manual at finallyvr.com. If you have a media collection and a Quest, this is the player you've been waiting for.", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://finallyvr.com/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": "https://finallyvr.com/finally/manual/", "website_url": "https://finallyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1161567437048700"}, "review_messages": []}]}, "cover_square_image": {"
cdn.com&_nc_ss=7f20f&oh=00_AQEl2LP8_zJ0I1FlqsqmShaXC3NMKawc-sVxLeBkHYBaTg&oe=6A7322A2"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLOt1iKsRLgQ7kNvwHFhYg1&_nc_oc=AdotDMWa0Cq0SJkLBE67YKgqZBXkPnTzZRltWgjray5hwOIMmE2Y7AmfsKehynKkqOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdY_9WHD8vzTLnL32A59IW0ExZKSnlKy8P0NK8BdzoLA&oe=6A7339AA"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYiNovqtJgIQ7kNvwF9tGY5&_nc_oc=AdqL9cToAmv-2_b1AUSMmC5_6uWdUq40KoY_Ps8Rrscrg1wkTuwKOI_-v2zIXv5UfeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjo4DzVDEBZqy0u3VryZO45C9mMdWWiilUy9InkSRXJQ&oe=6A73455B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WRoHYGl_QsQ7kNvwH4WKjR&_nc_oc=AdpLYLQVQQbPVCGSzv_5XzhF4bX24cL0MJZvgYTaR3tMiBaWc6Ss_iH3wTxf9CuQdAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMs7hnLl0w_oacvkbhrtyXTCzu5RV8T8pzf2X-EEJ2kw&oe=6A7332C4"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQt-djRxzsQ7kNvwGG4Upm&_nc_oc=Adr5PupnIRLGwPUBW7aVyDDcVxIGLwhnmtrssk48Pb2NKSWs_bxmSNEU1g6WkU2tehg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpB9iWeTaBtxvROarRnjVoyFxrbQK4Foq0UVyxG-1ekQ&oe=6A734BCB"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vstEEx9z_jIQ7kNvwGfdqQ_&_nc_oc=Adpj8gzUuGYtd42eFSHMjWg2QILDzYZvEREK0UgtThnd59Ed9xwFVpdHfiDp3Umog2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyCDRJpr4y8OQhOu0iEptp3nX7tKPWWAWlfguT3wXmoQ&oe=6A7337E0"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUXbtrTSYPYQ7kNvwFmZAOp&_nc_oc=AdrR1BOz8ppKvtxvBXUpj2KIPrAlZEGNCumepAypv6ST4iRsPSr_jfP6XTteDMTK4pk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCvFsVWjnJPvXnfcE2AP2bw3ghoinrXrpAjfuvoJfY-A&oe=6A734803"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1177261895479254", "version": "0.3.31-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1177261895479254"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.31-m3 / Quest code 37\r\n\r\nAdds an integrated ChloeVibes Haptic Control Panel for optional Bluetooth accessories and matching .funscript sidecars, with explicit ARM/DISARM, immediate STOP, and a one-shot TEST that automatically stops and disarms. Global Settings are now available from the player, long settings panels visibly advertise scrolling, and hover highlights follow each button's real shape. Includes the DLNA, FTP, local-folder autoplay/sort, WebDAV, browser-handoff, screenshot-chord, and Blu-ray ISO/MVC reliability work from 0.3.30.", "created_date": 1785532183, "id": "1177261895479254", "version": "0.3.31-m3", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1177261895479254"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.30-m3 / Quest code 36\r\n\r\nDLNA now browses NAS folders on demand in 2D and inside Club, defaults to videos, offers an optional photo filter, and cleans legacy image/audio rows from indexed libraries. FTP sources can be edited or removed without clearing the vault. Also adds local-folder next/no-repeat-shuffle autoplay, Date Added sorting, private browser video/catalog handoff, parallel WebDAV read-ahead, Quest screenshot-chord protection, and Blu-ray ISO/MVC reliability fixes.", "created_date": 1785508481, "id": "1176775672194543", "version": "0.3.30-m3", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1177261895479254"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.29-m3 / Quest code 35\r\n\r\n- Fixes vertical stick control for VR180, VR360, and fisheye media: forward/back\r\n  now changes the visible and saved Distance value, never a hidden offset or\r\n  Zoom.\r\n- Clicking either thumbstick now resets both Distance and Zoom to\r\n  D1.00 / Z1.00 and recenters on the current gaze.\r\n- Keeps the 0.3.28 large-library importer and repaired PRO control layouts.\r\n\r\nThis signed artifact remains an internal candidate until uploaded and accepted\r\nthrough the Meta store track.", "created_date": 1785467250, "id": "1175992712272839", "version": "0.3.29-m3", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1177261895479254"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.28-m3 / Quest code 34\r\n\r\n- Adds a bounded Device Media importer for large local libraries. Video and\r\n  image discovery now bypasses the system Files multi-select path that could\r\n  crash or blank out with thousands of files.\r\n- Keeps existing favorites, resume positions, ratings, and projection settings\r\n  when legacy local paths migrate to MediaStore content URIs.\r\n- Repairs cramped PRO controls: Quick Place text and the Room Dim and Haptic\r\n  Strength sliders now remain inside their buttons.\r\n- Includes the WebDAV, Stash filename, immersive search, subtitle, Plex sorting,\r\n  and background MVC shutdown improvements from the prior candidate.\r\n\r\nThe exact debug code passed a real Quest 3 import of 982 MediaStore items in\r\nfour bounded batches, plus a 10,003-item host regression. Signed store artifacts\r\nremain internal candidates until uploaded and accepted through the store track.", "created_date": 1785458027, "id": "1175846372287473", "version": "0.3.28-m3", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1177261895479254"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.27-m3 / Quest code 33\r\n\r\n- Improves WebDAV playback compatibility with safe HTTPS media handoffs while\r\n  preserving byte ranges and keeping source credentials private.\r\n- Uses a sanitized filename when a Stash scene has no title.\r\n- Adds a controller-first SEARCH keyboard directly inside the immersive vault.\r\n- Includes external subtitle loading, the large-library Plex sorting/crash-loop\r\n  repair, and non-blocking MVC/3D shutdown from the prior candidate.\r\n\r\nLocal protocol and cross-variant checks passed. Live server and on-head\r\nacceptance remain required for the exact staged build.", "created_date": 1785428021, "id": "1175273612344749", "version": "0.3.27-m3", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
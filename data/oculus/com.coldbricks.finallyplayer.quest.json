cdn.com&_nc_ss=7f20f&oh=00_AQHzigsuO-8r0Lp6lRYLPV2SSEKVnFppuAPOfa3u1OxhFA&oe=6A917522"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSlxlQwO9A0Q7kNvwEnuov0&_nc_oc=Adon_Uq1TiRVQfUrtOecGv_SUTu_RPzhyrXulfFzuqeh_od6CGGySMzzew4-twNW0C0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqdDs7yy2zlGtbwcHIsv-wNv6ZaCV-THYGeM9YQrfz5Q&oe=6A918C2A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D179bjoNrpcQ7kNvwEH34qm&_nc_oc=AdrgViPY1at1cdxXLnOleKyrT_v175M6MxCWnyhp9sppd1oKkmTqfVj6_sivcA7RYIU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH--zvYdMtCNis4Tg61csLCmAFXSbMImH49LkA21yuIsw&oe=6A915F9B"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lM7zBRvw4ToQ7kNvwGrtLNA&_nc_oc=AdoZKd5EBNvHExFDOLSFQbkOeAUoXY-xBaP0pLgFnyecFK1Lsi0KNqgRahXlF2MGXEI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYF82BIjKpDK1d3Dw_r-Rt83XpocpssUbcxj7Wy5daJw&oe=6A918544"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ5tRgIfOMgQ7kNvwFjK01S&_nc_oc=AdozWWD9Bx4nIaFxyr2Kof1RvV-iN0e7oyRjtflSGQRMyJKH1UtVUiI2Z7dvyz6JgvY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlKjlmtlfB5VsooOuHYSR-gp_AwRHoLKWavQ62P3gcFQ&oe=6A91660B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgvIf-gml2sQ7kNvwFP3x54&_nc_oc=AdonZCpKDqj6gft62Z7s0KqVv-GDv5H6T_VodmErlg1TmF56m3wm1THIezKLtBTt54Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYBxFlbzkQF6Xvhi4-A7R4SiG4eUfbgs_9ZX1e88L0QA&oe=6A918A60"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg-q7sIt6B0Q7kNvwE93UFa&_nc_oc=AdqkhpZS4wGmDBXT98sPU39ol6VjW0U3uKgPUpnPf8t7KAPZKfmvdgqYGKKvKRWvHpA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEczFTmrfdgxBagaTUCQ5tozla0DLf1gE4JPyVSFoZXRQ&oe=6A916243"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1215665064972270", "version": "1.0.12"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1215665064972270"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.12 \u2014 candidate release notes\r\n\r\n- Grip + stick \u2191/\u2193 changes title again. The 1.0.7 hardening turned it into a 600 ms full-throw hold that had to be re-armed by releasing grip, and nobody found it. It is now a short deliberate push that fires once; the stick only has to recenter between pushes, so grip can stay held.\r\n- The \u2193 direction learned the car-stereo rule: one push restarts the current title, a second push (or a push while the title is already near its start) goes to the previous title. \u2191 is still next. Stills always step.\r\n- The HELP tab's top row and side buttons no longer flicker under the laser. That page repaints its figures 30 times a second and the hover band was being cleared on every repaint; every other page already had the exemption.\r\n- The controller map placard and the field manual describe the new grammar.", "created_date": 1787500897, "id": "1215665064972270", "version": "1.0.12", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1215665064972270"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.11 \u2014 candidate release notes\r\n\r\n- Photo galleries hold one pose: place the first picture and NEXT/PREV/slideshow replace the pixels in that same spot instead of chasing your head.\r\n- Turn the lock off and every photo keeps its own place, size, tilt and turn again, restored exactly as you left it.\r\n- ZOOM LOCK and DIST LOCK are one switch: it freezes both stick dolly and the grip + stick size chord, so a nudge cannot resize a picture.\r\n- A photo shot on its side stays turned through a title change, a recenter and a reopen.\r\n- Changing photos with the stick now needs a deliberate held push, so a knock into the stick no longer skips a file; video scrubbing keeps its light flick.\r\n- USB sticks formatted FAT32 are readable after declining the headset's format prompt; exFAT and NTFS remain unsupported and say so.\r\n- In-page browser video is kept off the Quest system web layer that produced the TriChrome playback crash.\r\n- Every shipped native library is now built for 16 KB memory pages, so the app loads on current and future 64-bit Android devices.", "created_date": 1787453157, "id": "1214843015054475", "version": "1.0.11", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1215665064972270"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.10 \u2014 candidate release notes\r\n\r\n- Photo galleries hold one pose: place the first picture and NEXT/PREV/slideshow replace the pixels in that same spot instead of chasing your head.\r\n- Turn the lock off and every photo keeps its own place, size, tilt and turn again, restored exactly as you left it.\r\n- ZOOM LOCK and DIST LOCK are one switch: it freezes both stick dolly and the grip + stick size chord, so a nudge cannot resize a picture.\r\n- A photo shot on its side stays turned through a title change, a recenter and a reopen.\r\n- Changing photos with the stick now needs a deliberate held push, so a knock into the stick no longer skips a file; video scrubbing keeps its light flick.\r\n- USB sticks formatted FAT32 are readable after declining the headset's format prompt; exFAT and NTFS remain unsupported and say so.\r\n- In-page browser video is kept off the Quest system web layer that produced the TriChrome playback crash.", "created_date": 1787452025, "id": "1214826948389415", "version": "1.0.10", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1215665064972270"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "- Browse NAS shares/folders, test the exact folder, then Add.\r\n- Clear empty, denied and partial NAS results.\r\n- Larger SIMPLE controls and steadier VR hover/input.\r\n- Corrected Galaxy XR controller body rendering.\r\n- The Handy discloses HandyFeeling/Ohdoki data before CONNECT; Cancel/Back sends nothing.\r\n- Safer key removal and cancellation handling.", "created_date": 1787197424, "id": "1210430558829054", "version": "1.0.9", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1215665064972270"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally VR Video Player 1.0.8 \u2014 candidate release notes\r\n\r\n- Guided NAS sign-in, share and folder browsing, exact Test connection, and truthful empty/denied/partial results.\r\n- Cleaner SIMPLE controls, larger VR targets, stable hover, and deliberate same-hand grip + stick title changes.\r\n- Corrected Galaxy XR controller body rendering and safer OpenXR startup/input handling.\r\n- The Handy now shows a controller-reachable HandyFeeling/Ohdoki disclosure before the first request; Cancel and Back send nothing.\r\n- Forget removes both current and upgrade-era local Handy key storage, while cancellation and test queues are race-safe.", "created_date": 1787182585, "id": "1210185402186903", "version": "1.0.8", "version_code": 99, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
icon_512_flat.png", "id": "1547965076877855", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1547965080211188_8764012576438632422_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP6m_vjAJcsQ7kNvwFp23ny&_nc_oc=Adq2U0fwZitaWgLTSXwTghCR0rL3d5GhyiFrvEuE0tZQZm6rDnqVNVe-kUl3qbwhtJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_ld6Jk_lC6Skp38ZHe2gw5BiZG2g01Vtpyp9QbR7M4Q&oe=6A64A222"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1049946551312473", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1049946554645806_5627111672388509306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpvCqgP7aCUQ7kNvwGlfIas&_nc_oc=Adp_1Wn8Xxes9jZ-oYG4Bvnb_QOBmcqcASXirOgtYGfLiA8ZkQmDOSHuC8D-CsPOp60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeQ1j1sYD39QUfWngPIXwfruEOGRoHlzy2VrfZu0Jp7g&oe=6A64B92A"}]}, "id": "1664906948136138", "locale": "en_US", "screenshots": [{"file_name": "01_cockpit_arena.png", "id": "2202931117153913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593877129_2202931120487246_1018450187216848163_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEvCbnqyYb0Q7kNvwGf3WKO&_nc_oc=AdpCvA8iKCOtkx3EduwIG3xylBrvOTI_JNQ3g9lNMOeBcb0kJaSlEP1OgUj-68boRLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpqFS24rm53tGUwjd_TFFNyEWPrD9VhMRk1IunKSSe2Q&oe=6A64C4DB"}, {"file_name": "03_chroma_passthrough.png", "id": "1547698216859268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_1547698223525934_6598732221120852557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnHR9pGkamwQ7kNvwEGVtzA&_nc_oc=AdrsFb_ufpFImCWcw_QEKPgDD2kTtMXFvBo0mrJJ3M9DgsYRPXjaHQS4isYbdIkXR7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRhoyWP8fxI2zeer07p9l7yVgl_rsJg_HYNBJQEzb9Ig&oe=6A64B244"}, {"file_name": "04_photo_passthrough.png", "id": "4459170904325556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_4459170907658889_3814226122316887053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS1eNOsyrA0Q7kNvwFKz71b&_nc_oc=AdrWk9mZzrs-U18Z9oUngScO_fwl0QMpwPXRwHevqUQ7ahf6E2O7iXLUmpo9hK1-wTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApFvX8qcfH-8QjVtia771_6V-NTgtMLL_QfDNclhV7vg&oe=6A64CB4B"}, {"file_name": "06_vault_cracked_club.png", "id": "1023643870566406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1023643873899739_5396471792898162736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjS1jVut4g0Q7kNvwFvdBrF&_nc_oc=AdpR6USfbEbMlWZcwyThn8JsJ67qpaifWWsaSlmNlaNsiduCBN3iXrUIrqvIVoBkO0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLJ95v3gAJ5oq5dZGalshQ9aXs9foMNvPLPePxVLsUFA&oe=6A64B760"}, {"file_name": "07_theme_pink.png", "id": "921808227600850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_921808230934183_3497660381919990941_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qerF20y-G6wQ7kNvwEJWsek&_nc_oc=AdrHtQZjMPvECbLHqivfCl0b67NRNaht3tfS2bPv0t9nfeZtDoW3fN98cQFBTHiwdFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4ePCMGgrt8afgQwNKzjRRjHU4s8KpNrydVQaX8QeYAw&oe=6A64C783"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Finally VR Video Player", "keywords": ["video", "player", "VR180", "SMB", "8K"], "long_description": "```\nFinally \u2014 a VR video player built the way it should have been all along.\n\nPoint it at your own collection and press play. Finally indexes local files and streams straight from your network drives (SMB) \u2014 no uploads, no accounts, no subscriptions.\n\n**Plays everything, properly.**\n- Hardware-accelerated playback up to 8K\n- VR180, VR360, fisheye, flat, and SBS/TB stereo\n- Automatic projection detection with a manual override that sticks\n- Photos and stills in the same library\n\n**Built for the headset.**\n- Native OpenXR immersive theater with a clean cockpit\n- True scene dolly \u2014 move closer without breaking world scale\n- Refresh-rate matching for judder-free 24/30/60 fps\n- One-controller friendly: everything reachable from one hand\n\n**Mixed reality, done right.**\n- Alpha-packed AR video plays in your real room, not a black void\n- Four simultaneous chroma keys with independent tolerance, softness, and spill\n- In-headset color picker: point the laser, click, it's keyed\n- Passthrough lobby: browse your vault with the room visible\n\n**Your library, your rules.**\n- Local storage and SMB shares as first-class sources\n- Resume positions, per-title settings, fast vault browser\n- No telemetry, no analytics, no ads\n\nIf you have a media collection and a Quest, this is the player you've been waiting for.\n```\n", "short_description": "The VR video player that respects your library. Local files and network shares, 8K playback, VR180/360/fisheye, and zero accounts required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coldbricks.github.io/finally/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Coldbricks", "support_website_url": null, "website_url": "https://coldbricks.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150511761487601"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549908803299978"}]}, "baseline_offer": {"id": "1549908803299978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784388180, "status": "PUBLISHED", "id": "1549908803299978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1159689810569796", "version": "0.3.9-m3"}, "id": "1762694784946602", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1159689810569796"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "\"NAS/SMB streaming overhaul \u2014 built from your feedback:\\n\u2022 Multi-GB videos over SMB now stream reliably (fixed buffering that never finished on big files)\\n\u2022 Test button on the NAS setup form \u2014 and a failed attempt keeps everything you typed\\n\u2022 Scans now tell you what they skipped (locked folders, unsupported types) instead of hiding it\\n\u2022 Rescan your NAS right from the vault \u2014 no need to leave VR\\n\u2022 If a video can't play, the reason appears right on the panel \u2014 no more silent bounce\\n\u2022 Press B during a video for compact controls, low and out of your face \u2014 press B again for the full cockpit\\n\u2022 New SIMPLE menu mode (default) with just the essentials; flip to PRO in Settings for every control\\n\u2022 STATS FOR NERDS: live codec, buffer, and network readout for the curious (PRO)\\n\u2022 Smarter read-ahead buffering for smoother NAS playback, plus audio and reliability fixes\"", "created_date": 1784575654, "id": "1159689810569796", "version": "0.3.9-m3", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1159689810569796"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "\"NAS playback upgrade 0.3.8: smoother SMB streaming with smarter buffering, clearer loading (no black void), Help & Settings in the Club lobby without starting a movie, and a small version label on splash.\\n\\n\u2022 Faster, more reliable NAS / network file open\\n\u2022 Loading stays in the lobby until video is ready\\n\u2022 Help & Settings available before you play\\n\u2022 Menu Level and global prefs in lobby\\n\u2022 Version number on splash + Club footer\\n\\nStill offline-first: your files, optional shares, no accounts.\"", "created_date": 1784539429, "id": "1158973953974715", "version": "0.3.8-m3", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1159689810569796"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "Finally 0.3.6 is a reliability-focused update for Quest.\r\n\r\n\u2022 Projection settings stick more reliably (library rescans and re-detect no longer throw away your fixes)\r\n\u2022 OpenXR sessions tear down and restart more cleanly when you leave the Club or take the headset off\r\n\u2022 Flat and mesh players use the same projection brain as the immersive Club\r\n\u2022 SMB/NAS: more stable when browsing and playing; multi-account shares handle credentials better\r\n\u2022 Audio focus tuned for long movies\r\n\r\nStill offline-first: your files, optional network shares, no accounts required.\r\nIf something feels wrong after the update, email coldbricks@gmail.com with Quest model + a short note. Enjoy.", "created_date": 1784525526, "id": "1158734840665293", "version": "0.3.6-m3", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1159689810569796"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "0.3.5 (build 8)\r\n\r\n\u2022 NAS: new optional Folder field \u2014 scan just a subfolder of your share\r\n  (e.g. media/vr) instead of crawling the whole thing.\r\n\r\n\u2022 NAS: music album art and tiny thumbnails are no longer imported as\r\n  photos during network scans.\r\n\r\n\u2022 New: TILT FOLLOW (Setup) \u2014 the picture stays upright to your face when\r\n  you watch lying down. Menus stay world-anchored.\r\n\r\n\u2022 New: MENU LEVEL (Setup) \u2014 the menu spawns level with the room instead\r\n  of matching your head tilt.\r\n\r\nBoth new options default off. No permission changes. No new network behavior.", "created_date": 1784422350, "id": "1156973780841399", "version": "0.3.5-m3", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1150511758154268", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1159689810569796"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1762694784946602"}]}, "change_log": "0.3.4 (build 7)\r\n\r\n\u2022 New: FISHEYE 180\u00b0 manual lens option in the player lens row. Untagged plain\r\n  180\u00b0 fisheye files can now be forced to the correct fisheye projection \u2014\r\n  previously only the 190\u00b0/200\u00b0/220\u00b0 lens variants had manual buttons, and\r\n  VR180 (equirectangular) was the wrong mesh for fisheye sources.\r\n\r\n\u2022 Fixed: launcher icon \u2014 the Finally \"F\" mark is now optically centered.\r\n\r\nNo permission changes. No new network behavior.", "created_date": 1784419395, "id": "1156929270845850", "version": "0.3.4-m3", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
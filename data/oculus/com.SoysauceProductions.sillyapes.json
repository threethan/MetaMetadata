ile_name": "Meta Thing For Screen Shot (11).png", "id": "2011129092985886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294659_2011129096319219_8387316489540275941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2Ci-dO1S8cQ7kNvwEnCY1i&_nc_oc=AdqIxAajJQWb3GPsKpZTeicO1ZfNaHPPYitoVphzdaiYV7zkwp38y0vEUUV5ixXnOGc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-i6OmBauzo0MCAd1ISgqwQRh6XpIITaJ-WoGnKIfJBA&oe=69EF689A"}, {"file_name": "Untitled design (1).png", "id": "1063511605862089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820648_1063511609195422_4158308697767591443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFOICST8m7cQ7kNvwGyBD6h&_nc_oc=Ado-qDmsWCzTjL7ZKG7PDg4kpEpiBUkozfFuI4xjynNRVoB7WH7wByQiS8emGha8Ge8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vjoTRR7tRklJqpehlJcmEPbWnLnmMGop8hCDqJzJODA&oe=69EF72AD"}, {"file_name": "Meta Thing For Screen Shot (7).png", "id": "1073483381417206", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831276_1073483384750539_6129536067532009785_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuM-5VKXvYIQ7kNvwFiw0Zr&_nc_oc=AdpppN1Rcs5ZZIryf7lTF7iovwHQLo8YRKjqUfQhbjYuFl82hOcPHjzamXCpKv9LBNA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2V2edHyIEFDAnRA4WwZZ1gDusq1Ye0QdLg38RwLb-Djw&oe=69EF716F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silly Apes V2", "keywords": ["Fun", "Adventure", "Ape", "Game", "Crazy"], "long_description": "Silly Apes is a chaotic VR experience where you become a hyperactive ape let loose inside a massive, unpredictable building packed with ridiculous challenges. Built around a smooth and silly arm-swing locomotion system, this game throws realism out the window in favor of pure, unfiltered fun.\n\nDash, hop, and stumble your way through a variety of game modes, each offering its own kind of madness:", "short_description": "Silly Apes is a chaotic and hilarious VR game where you play as a wild ape charging through over-the-top game modes like Zero G , Shop and more. Using a unique arm-swing locomotion system, you\u2019ll run, jump, and stumble through vertical mayhem, and pure unpredictable fun. It\u2019s fast, frantic, and completely ridiculous!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/silly-apes/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Soysauce Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-apes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24627295596898789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818916_1981615512676468_5615962036284550369_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57Bv83d0074Q7kNvwGNNtMP&_nc_oc=Adre9RmPjp6iWWhdddGcPoFuJ1SvtPjXxLNbtiKA7KGef1jhDlEEWvW6FxdGIopP6w0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jH9R_xrDFMY0wo5AalrNf2ZwBXoxXAhsH8OyizTaDaQ&oe=69EF57F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Silly Apes V2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "4
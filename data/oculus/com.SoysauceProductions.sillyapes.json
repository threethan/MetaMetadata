 through over-the-top game modes like Zero G , Shop and more. Using a unique arm-swing locomotion system, you\u2019ll run, jump, and stumble through vertical mayhem, and pure unpredictable fun. It\u2019s fast, frantic, and completely ridiculous!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/silly-apes/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Soysauce Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-apes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24627295596898789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818916_1981615512676468_5615962036284550369_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8smH7Fqr8oMQ7kNvwF0zlvP&_nc_oc=Adli-V3HWMm1I11RXFxXjHcEKv_qgH7GfNHOMc63zqtoqE0iBXkT6SFs_NqLw5KF-Ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylnoTd67ZWPx9kmSIv_Lt8fbR_-90HQ3VFppvC2dryHw&oe=69B6A776"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Silly Apes V2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "
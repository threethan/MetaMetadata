ile_name": "Meta Thing For Screen Shot (11).png", "id": "2011129092985886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294659_2011129096319219_8387316489540275941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-yIGV3IQqAQ7kNvwHBrMFf&_nc_oc=Adq4InyDem-n3R0RleIukcWJsf0vkA1MUuM39MO9eJQ7YKOLw6TzkujMpDJcD9mOWUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jUQuCYxPgWbhZse8KvqY41NRXP8S3aZ2MsIDpu-qNzA&oe=6A032F1A"}, {"file_name": "Untitled design (1).png", "id": "1063511605862089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_1063511609195422_4158308697767591443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qctb_7yH-j8Q7kNvwFgRl1p&_nc_oc=AdogX97bQs7v3QFhEk0yZ6G1NRFMwcHD_NRUZUR_QnEQ8lDV3260Bx8yJZBiEETeX_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s1v78r9WJu0UoTEktvrtGmgQnwa9g8aLd2_Knl5ME2A&oe=6A03392D"}, {"file_name": "Meta Thing For Screen Shot (7).png", "id": "1073483381417206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831276_1073483384750539_6129536067532009785_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khjIv1QDd-EQ7kNvwETB66O&_nc_oc=AdomCIXS2Ft5Zu0PzxqqBCLvX5EfwgC_gN9azagUc-T1SVOcDXjVPlJhY9hlVicEO5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gbPTcNMr9-RVVWTsMf8r7KIc0Owcf08W7FhvMHNEMZQ&oe=6A0337EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silly Apes V2", "keywords": ["Fun", "Adventure", "Ape", "Game", "Crazy"], "long_description": "Silly Apes is a chaotic VR experience where you become a hyperactive ape let loose inside a massive, unpredictable building packed with ridiculous challenges. Built around a smooth and silly arm-swing locomotion system, this game throws realism out the window in favor of pure, unfiltered fun.\n\nDash, hop, and stumble your way through a variety of game modes, each offering its own kind of madness:", "short_description": "Silly Apes is a chaotic and hilarious VR game where you play as a wild ape charging through over-the-top game modes like Zero G , Shop and more. Using a unique arm-swing locomotion system, you\u2019ll run, jump, and stumble through vertical mayhem, and pure unpredictable fun. It\u2019s fast, frantic, and completely ridiculous!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/silly-apes/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Soysauce Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-apes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24627295596898789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1981615512676468_5615962036284550369_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDT_Gd_1-N8Q7kNvwEUaw1m&_nc_oc=AdrRqW9J557f1Ze4wbcX-Y9Tcn4I6xZprjmfJiK2wAve6PZ0G9dtzNETPtKzPRd127E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b_RTkx1leVoUOmBY74ruUm62oMqHWhMCDsT6K_Lq-6w&oe=6A031E76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Silly Apes V2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "4
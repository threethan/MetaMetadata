CA"}, {"file_name": "PhotoEdited (1) (7).png", "id": "1939565456561293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310651_1939565459894626_6420869230659419541_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy8zekOkCsUQ7kNvwHn99f1&_nc_oc=AdpUA6SZpWCapSVso41r0DQkENlVptKcuWZSvW2AOTBFwDn2si8m-2pYr-IGhOxKUgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO2EDyAo1TlMwXFLVGWLfr5bOck0_HPDrIP0B89BU5Uw&oe=6AFC7D3E"}, {"file_name": "PhotoEdited (1) (6).png", "id": "1046277147753094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593919959_1046277151086427_7897502040962433317_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaSZZbfY9VgQ7kNvwF_t9y6&_nc_oc=AdrHe8Q13k65QhO5-Kay7jrgPbpDpfdqvGivGcfAsv5Be56ARKJl8fHxmvtzR8NuENs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi4IE9uF3gY1nn-9tHCTuAdFNXxjXzqIy2wrGjDo3scQ&oe=6AFC8730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RobotCompanyLandScapeProtoType.png", "id": "2050100169224578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507829689_2050100172557911_940163764807479149_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NlQHrZji5gQ7kNvwH_Of58&_nc_oc=Adrhsbayvbh-jN1xUnF6-6Mu49TQJPEkgIMUW81_0UaKcLN8bKWMI8JNcpynUsgjIBo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtytJFzpM5YJbfcHUoLNXUHOYADqNixlty4Zme0DagvA&oe=6AFC8B49"}, "display_name": "Robot Company", "keywords": ["Tag", "Robot", "Multiplayer", "Free", "Funny"], "long_description": "Robot Company:\nJust a game where you swing a round, jump and run from Magma Bots.\n\nWhy you should play:\nThere is much to for example, \n- Go on a shopping spree\n- Play tag with friends\n- Do sick parkour\n- Join the Discord: https://discord.gg/Ktx9NvbaCX\n- Etc.\n\nWhy it was made:\nI made this game to show my new locomotion system combining the Gorilla Tag Locomotion System and a new Locomotion system my friend made, friend is Yellow44, where you can swing with webs as a spider may do.\nI also made this because I enjoy to make people happy and want people to have a safe space to play in with other people.\nPlay now!\nGod bless.\n\nYellow44 was here...", "short_description": "Just a game where you swing a round, jump and run from Magma Bots.\n\nWhy you should play:\nThere is so much to do for example, \n- Go on a shopping spree\n- Play tag with friends\n- Do sick parkour\n- Join the Discord: https://discord.gg/Ktx9NvbaCX\n- Etc.\n\nPlay now!\nGod bless.\n\nYellow44 is watching..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rcprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://sites.google.com/view/robocwebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "26460322993641535"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1762170611444747"}]}, "baseline_offer": {"id": "1762170611444747"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785690000, "status": "PUBLISHED", "id": "1762170611444747"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
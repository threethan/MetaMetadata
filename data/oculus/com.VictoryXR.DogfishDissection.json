00_AQOuiXFwXoeLogYWB12GroVbJwecUYCRROx_MMe3gBNx8w&oe=6AD2572E"}, {"file_name": "screen_3840x2160_2019-12-02_15-48-56.png", "id": "5179772605398058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031449_5179772608731391_6735295695570050880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nam1zi9nWIQ7kNvwFsQqvG&_nc_oc=AdqYKdqoM69JRhPXCg37zihqcd_Wac43p4Hp89rcg1fjTWOLNCTVz48LuH2uhPnAQg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFimuVn1q-YC8JKUkL9oK_f9uruoOyMnVmdzV_p9N9GQ&oe=6AD24B0E"}, {"file_name": "screen_3840x2160_2019-12-02_15-55-57.png", "id": "858192835037450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003245_858192838370783_4517972656687566193_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdhVADGOl6MQ7kNvwGVi2LQ&_nc_oc=AdqG-u0IZMwawtfFq7vw5GEEgeQGTPyVFAyKuc8sE6Flk-yiL-faZXtl681zvAKFtjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm2LTMgrjd0DmP1S3wyRWK7x9v9_SkvxEAKsRoHxDSdw&oe=6AD23F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_3840x2160_2019-12-02_15-50-56.png", "id": "245067367253838", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974558_245067370587171_3803449818666952260_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p06wLY1jXTIQ7kNvwEw15Kx&_nc_oc=Ado61DP8iftSiRPKb-62SxMWyK_p89yDSTR2C4kJwziZFkP2B_fm5uTDZe2hSkEc2bM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTq4SPw_3kBxW2nVn3njDveCH0A7yplrM1R2VwGx7MwA&oe=6AD25519"}, "display_name": "Dissection Simulator: Shark Edition", "keywords": [], "long_description": "VictoryXR\u2019s virtual shark dissection software is a hands-on opportunity experienced through the power of VR. Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality shark dissection in Dissection Simulator: Dogfish Edition. Learn the fundamentals of dogfish anatomy through its various systems in our fully immersive VR experience using Carolina Biological\u2019s expert curricula and process.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections, without the safety and ethical implications.", "short_description": "VictoryXR\u2019s virtual shark dissection software is a hands-on opportunity experienced through the power of VR. Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality shark dissection in Dissection Simulator: Dogfish Edition. Learn the fundamentals of dogfish anatomy through its various systems in our fully immersive VR experience using Carolina Biological\u2019s expert curricula and process."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "639992003985598"}}]}, "sche
00_Af82NRh11hfpgNHE2lPmJnsu2Vcrfr34zLOJEY-M6fBwuQ&oe=6A2C01EE"}, {"file_name": "screen_3840x2160_2019-12-02_15-48-56.png", "id": "5179772605398058", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031449_5179772608731391_6735295695570050880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CkCO9FWZjwQ7kNvwGiBeT6&_nc_oc=AdoNbH0rdaRUGcjovzeWUBP8vyHYxLSlRolkKaXdFn59RFCrlpedKDj6dhMdesIEZo0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_metESttOhJ3kfx59X_9VIofTzII4siA3KxXt1CfR5xw&oe=6A2C2E0E"}, {"file_name": "screen_3840x2160_2019-12-02_15-55-57.png", "id": "858192835037450", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003245_858192838370783_4517972656687566193_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zenmynFfQNYQ7kNvwG6AeMW&_nc_oc=AdoEDS49CGM1vZvze6BanANJ1hNE-W2TbUuqLgoKqC3pgEDRqt2NZVjyTXtk1bu-gfw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bYMAbiesBx7SavN75FpV_HaNaiy8m384EuhhtvpgJLg&oe=6A2C2220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_3840x2160_2019-12-02_15-50-56.png", "id": "245067367253838", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974558_245067370587171_3803449818666952260_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9OhDQ9XJNkQ7kNvwHevZr-&_nc_oc=AdrFyMY5iogWrflzqNbxf-1pL0XiPu6elWR8cT1aENtxBs_ZgxWCbs8CGlLGWQC7NxM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__gjWhm4c6jdjSkn0wsU0w4hnhG0js3w-Q2bES1qY6tA&oe=6A2BFFD9"}, "display_name": "Dissection Simulator: Shark Edition", "keywords": [], "long_description": "VictoryXR\u2019s virtual shark dissection software is a hands-on opportunity experienced through the power of VR. Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality shark dissection in Dissection Simulator: Dogfish Edition. Learn the fundamentals of dogfish anatomy through its various systems in our fully immersive VR experience using Carolina Biological\u2019s expert curricula and process.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections, without the safety and ethical implications.", "short_description": "VictoryXR\u2019s virtual shark dissection software is a hands-on opportunity experienced through the power of VR. Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality shark dissection in Dissection Simulator: Dogfish Edition. Learn the fundamentals of dogfish anatomy through its various systems in our fully immersive VR experience using Carolina Biological\u2019s expert curricula and process."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "639992003985598"}}]}, "sche
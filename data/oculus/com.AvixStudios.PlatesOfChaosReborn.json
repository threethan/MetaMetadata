le_name": "499313057_2006819713589224_1275216997881685701_n.png", "id": "2369923997086144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_2369924007086143_4689160194930864208_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo7YnAPzZCgQ7kNvwE4urHo&_nc_oc=Adr17IosKU_3YbjQaxexjEsZT3tXs9hYuuPZUQP5jevcWbZ9UTBAcTkHSQNe2j9ddFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ80yykm3RiFzSd7GqScfkVzeav_eCH7N5jlml8jxy2xg&oe=6AFC927E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Plates of Chaos: Reborn", "keywords": ["Multiplayer", "Survival", "Party", "Social", "Minigames"], "long_description": "Plates of Chaos is a VR Multiplayer game where each player spawns on their own plate, surviving over 150+ random events. The goal is to be the last one standing, will you win or falter?\n\n\n\n\nPlates of Chaos is a multiplayer VR survival game with one rule: survive no matter what.\n\nEveryone spawns on their own floating platform over the void. Every few seconds, a random event hits the arena, a random player, or a specific plate. The last player standing wins.\n\nWith over 150 random events packed into the game, no two rounds play out the same. One second you're completely safe, and the next your plate is shrinking to the size of a dinner dish, tilting sideways, freezing over, or getting pelted with meteors. You'll have to physically duck, dodge, and scramble in VR just to keep your footing while the arena falls apart around you.\n\nWhat to expect:\n\n150+ Random Events: Everything from rising lava and sudden gravity shifts to bizarre hazards, random items, and surprise traps.\n\nMultiplayer Mayhem: Queue into public lobbies or play with friends. Watch your neighbors panic as their plates get wrecked, or use items to mess with them directly and knock them off.\n\nBuilt for VR: Move, duck, and use your hands to survive whatever the game throws at you next.\n\nFast Rounds: Quick matches built to jump straight in, laugh at the chaos, and run it back.\n\nThe rules are simple, the hazards aren't. Step onto your plate and see how long you can last. Will you win or falter?", "short_description": "Plates of Chaos is a multiplayer VR survival game where every player stands on their own floating plate and faces 150+ unpredictable random events. Dodge hazards, survive the chaos, and be the last player standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQlotSvt5GKCsbjjvJ138b-235E29-pd4rpz2iMBCqwnlJ4YH95hKfxyTJsJWybLfYCJx4SPNAJPp8q/pub", "developer_terms_of_service_url": null, "publisher_name": "Avix Studios", "support_website_url": "https://discord.gg/platesofchaos", "website_url": "https://discord.gg/platesofchaos", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1460439653817913"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1596624721675409"}]}, "baseline_offer": {"id": "1596624721675409"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793733780, "status": "PUBLISHED", "id": "1596624721675409"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1470882849440260", "version": "3.11"}, "id": "1016903361451749", "channel_name"
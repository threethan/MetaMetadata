_AfzVF_LlnpJQKdUr6WhwkOYd2CpCqhXeVlhN6YOqvhYQ0g&oe=69BA8495"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnJ1Uid5AXYQ7kNvwEuvh0v&_nc_oc=Adn4xzbwFWgJSshR_YmPPHyryREoeM1fjN4aPELmSwNUzl9NiuiIhmgyzAYQBXXouX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWCSmA3nGQrofxqs5lwqEQ09r7s_64VOJEnEcNm9rowA&oe=69BAA5B8"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkL7cn232dUQ7kNvwGsn1YL&_nc_oc=AdkNlv-nL8K5sNONmc3N3S-SIQzCyxaGa5ssBNxrxoWwyYxdGMfdoMAAowelCjtWBrc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfaXKJdk8jKr8YtBamjr_iWeRMP8UWp-FKacxSyb998Q&oe=69BAB1FB"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nShnlioJWg8Q7kNvwFsOzJ3&_nc_oc=AdltAl5DI14EQ47ZclIEYf74M0MkohBDrSqcjtQxiW9smrnLOXTJ0_L5VpXyej47eN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWIp5e8JHcKuhN1gVKTdMDZvfaJWgpz8ZdDLzYZ2Qjow&oe=69BA91F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKeyywxgvAAQ7kNvwH1Anj0&_nc_oc=AdlhzsrSqhOgs_NFQFwIoSy6ss5SnWCBCyct-Ln1C9XQp78uU_JoIKIB7HZfGdSLGQ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzr-LwX5d3wd6fuiyAauTNk7tcT_6OY9-lS-8Z2ke0djw&oe=69BA8512"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking
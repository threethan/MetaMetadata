95453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmgmNhovpxsQ7kNvwHC0DQq&_nc_oc=Adr6Ep-j6CehgcEogiJEXAmTWJGnfzYVFyET-HCIXX_niEkNlLx0vzXggKKgXtkAU4w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55PG3rzWCPEhLY5xyrXfYuTSWrnWupEZqYkvs2hETErw&oe=6A107BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojZWsIjc44YQ7kNvwHNEgHh&_nc_oc=Ado26K9s0pqNIgLry0CZbyN0oMutxc52T3SpcQtcLr_VJ9LbXvHfvaGN_QoQ2ooFi9I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75LKEO27oOZR3n5hIrWfH3NiGBKdUbqGuvXmpyC13FPw&oe=6A106ED2"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24542588448767317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491830027_25156104977306588_9180828692093608225_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hssfr4MTJEQ7kNvwHODIBQ&_nc_oc=AdpFMHvibbuSi-mkgV7SCgvv8-comZqd3Y83Coq8BKFh4tsba6nbBO6AEwSt3HHo1OI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aF5mIfJVT5IAu1rnV0ZwU9Lh9_7Q8UxruGPgDyKgPsw&oe=6A104DA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fencing VR: En Garde Arena", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1758906780, "lastRevision": {"nodes": [{"id": "24542588472100648", "release_type": "SCHEDULED", "administration_status": 
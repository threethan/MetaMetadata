05092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8MBcTWCQNIQ7kNvwEx_egm&_nc_oc=Adn9_mtQa3Kj32iwV-fIv2uesHJIydXAWDZp5mSALJnhVKjavgXZsExfW8dExxs-1gE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsxapVnRsV7u96HStBOEO9zrcTZm5RgGwNj42tiZM-VGQ&oe=69A19938"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz1tey74TaAQ7kNvwE9bybh&_nc_oc=AdkEAZXArqP0ENqsLyRAb7k8u9Byy4Jf7e_0lNyORnXngrQ9syG4xCl9Iu8CpNGfF-U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuuKV77NIaQCzKyF7dUo5W9bklaS1aAXqpIgLk5KLDi0Q&oe=69A1A57B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlaJbHdz36AQ7kNvwGAlU1n&_nc_oc=AdkgnxNlENxM-Icj_N3dbrIkTS3rligAbVSgx3vQYtVC3U4bXkeJIzEAQgc7Vub7OH8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftNTKMORlF3SRHTpd1N59iwlgOy2Z2Hz2kXWpNEa-RzEQ&oe=69A18574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlOquFZjKwsQ7kNvwE3UXkW&_nc_oc=Adl4_8pfOUzmZR4IXEMIVRScjjsDcsXP2V2GZyMl6K3tXEZ00C1bv4R2guyJO7PK3Xs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuYxr8a8ihuSE7zBBUWyxGvriwSB5MiCNb_h_pm2Yr97A&oe=69A17892"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24542588448767317"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25002072716085513"}]}, "baseline_offer": {"id": "2
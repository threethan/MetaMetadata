-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhArVTKiu48Q7kNvwF_kwIi&_nc_oc=AdpWZYCEig27ioTl-oeyI95OS8CJSxrrFTavW7SNMeoEp9COqjOjLLrEDRGzbvfj7YY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTId9i4-W6t6QUGJAvqIvPoM0A2EdwHn-jRLu9wwWwCuw&oe=6B0DC695"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJbPi1fMWZsQ7kNvwH9KDl1&_nc_oc=AdocaUn-c2ZuZtckV7H3DyIQlCzYCTKOJlCRhdcu9eVZBLuecPrZXKkakKJ59MZge1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBo9MyKvLz9HNm57bdDVNbLxH_Btm4IjtGliM9pZpU7Q&oe=6B0DAF78"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKKiMq-87-MQ7kNvwEqKOpJ&_nc_oc=Adoa0E5eEcYv7R3WipuyFWo8w48b1MiYsri7EZZ7RMSptp9DMZWM42eoQyFF-mBLToU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQatlfbjC3xufQL0Q7O66NN549YsIqvlgkFNlVb67jNlw&oe=6B0DBBBB"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FmEBuMOuJcQ7kNvwG8z8BG&_nc_oc=AdpMoKgnGKnXZZK70-K6KOfa_KOybno6Dx8xNizbkmD4g_f_RZviLHFpFU1C3CwoVM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgsNiApOYTgFzce8m7KHcZ6KXqoRzxIfvm9sHJvF6GTg&oe=6B0D9BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HuFPFhI1_8Q7kNvwE7HJyH&_nc_oc=AdoujWIgkzOz24KufGZ-6mk2VgifLWj9Nj3Zl_waWLCaPLA_JzUVuioDMKibmELSx7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRr3e07QUbmOqYXy8ZDFiULhWmF29TPaPzHFa6utYgtyg&oe=6B0DC712"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422860
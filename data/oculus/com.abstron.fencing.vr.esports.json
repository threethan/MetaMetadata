_AfyqjucELVBDt5oXUUwLOYb8N4NjTEn-ZhKoIxGLBUJRCg&oe=69B69015"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FXyBSR3V3cQ7kNvwEXOJY4&_nc_oc=AdmV-Ch_-QZbavNdAMXQtXUNWenXzWLHmQ6Qqn0OEKK3NEMfJN1RU1nfikhcWWKZw8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx12znxXeoHEJzbKybRQNqGldOxW9fth0Z8A_dGBoZKDg&oe=69B6B138"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDFr_L8VEWwQ7kNvwGcIkLd&_nc_oc=AdnmVvx5SAGkBFv0HrlP1_Tkl93U9kaOlk3hqg65ywIN5cVcCUOfn6Bavu-ZzfWHDZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVaanUWn4odkf4m_smHeKeo14Px9XKibpZQD5HzlW4UA&oe=69B6BD7B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-mER4ja-ZgQ7kNvwFxNtiT&_nc_oc=AdlbcMncUzfmPQ0he4nOD36oDt1Kw9H1NtAoQhc8cTt_z5LVu_hmiFNoMUVzbtGYj0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2NbQ4FPwLGZDoP9a6A41_SimfFmZ_Y23kA6MlfmG7Sg&oe=69B69D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeIQMmPryVUQ7kNvwFZCmM1&_nc_oc=AdmVvOEs2rB4iQUYDzGmbbFEzLofsYbo7WwKDz3auQul70PL1kFefOmCapgOqXtz4O8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7Sq3qy9UlXSjHH7JEOCWFQaX2rPPcF491IXEfbZ-Q0g&oe=69B69092"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking
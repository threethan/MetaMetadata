-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uffCeG-3P2wQ7kNvwEmpi8v&_nc_oc=AdqbWzxaV_B1nB9D1FRJ1t0bJPiraXLvAVyew-ow9jQ2UkkVJmOr1i9nVFbM7rKRR5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgxlUicus7IIdJ4OMOel94GzyDmhxtdd4i3G0mylc8hg&oe=6B0F1815"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzsm00MKeKIQ7kNvwEBo4nm&_nc_oc=AdoDD2wzHEfkBaskmwbHkugxVfqsGqT-9Nok94emvFsltv5eFKEOYcyTUHW-xCIhu6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFApQ80_7tfIERZyPjFxM1dbQzuEajH8EZiXQdyH3gjw&oe=6B0F00F8"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKKiMq-87-MQ7kNvwE5wovK&_nc_oc=AdqjMr6u9qdimhMAG82EDi1saLAArr_tXuv3h4uutVUES3M0IcdhP87PsPdF-_q3OKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUsnjJBHu4ygcObP6zLe6mCcWlccgLI14FZnS-uUoLi3A&oe=6B0F0D3B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FmEBuMOuJcQ7kNvwHF88fs&_nc_oc=AdpfseuPEHjiMoT2Zfwj6IEXgiNrlCjnzl7pdFGdIHi11b4mFCuzlwo9jtt8KcY9a_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_CxLzoCqgl_NDQ-waisIG_obPeZiAfLQuU1GGHZz64g&oe=6B0EED34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HuFPFhI1_8Q7kNvwFUTqWk&_nc_oc=AdrM1RcmO7p345FjN-6EyadyrOsTlruQ5yyYYnQuLLW-ajb9hjIlLN4ZCyFlLnWeacw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlVKJ-tlkeYxZ8uJYzl0HEXMAJMYq3ngzP_kIKWpxQkg&oe=6B0F1892"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422860
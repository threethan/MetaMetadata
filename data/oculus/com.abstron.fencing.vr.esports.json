850101910859", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIktNpGAcLEQ7kNvwEesNOS&_nc_oc=AdqfzWPZNJXfsOFJrR8aaHMMKNYmxdlWs_Z7JV9ifPXp4hKaKisPcWuPub6-RpwDEUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa47QCdH_dcdcIThndxEFen1erDM24zg0FppahD2oSjA&oe=6A86DD15"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq5iWv73ai0Q7kNvwG55hkD&_nc_oc=AdpGpQB_vCuSdySs_uNsMqY7-nxcUfiOFPuijCadT2bUjk9Lb6mNCmon-9Ck12_7ELg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQalTkX7VHqyARMzRpYzYJ3c4xKfbadJVq3SfMwEGdvw&oe=6A86FE38"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpqH0jOM6-EQ7kNvwFffdB5&_nc_oc=AdqB3sRxJKRQ-QUI_XdGI_BdgHSM0Y0RDLsN_ihdUpuXXKfL1Zg-pwuUGo_yeqMbhnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVSqUxvHqRbN3S8yZAM19Aog7jQVCPaI8n6amA-Xnc7w&oe=6A86D23B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URgHuOCj-9IQ7kNvwFCAVRj&_nc_oc=AdrIX4YE988iOjJUmoK-Q0gnbqrpmnSuXmB2-jK48c0TuUBgSNZIsWwocSnkfowqfUc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuu0k2WLp_pCPGof1WOfyUcgJbRInTBWw1O94fpCf6kw&oe=6A86EA74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz6fUYwV8mAQ7kNvwFDc43E&_nc_oc=AdpO8jdQgTLQBmNOXc1UrDyQmR0VBukbEayeqoZy6dqheKxQAxFWG_z_QUmc65Vgiyk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG95g9EWyCWtyBxv4037Ejjjj7bBbj_4MXv_1LTtTZ5hw&oe=6A86DD92"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres"
05092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8MBcTWCQNIQ7kNvwGT_K9P&_nc_oc=AdnY_QATGkVmUm6v5ERFG-EfbMMzjPwqY6bzf89LkMBl_I1P7AtWi3YwwD4SRuwJptw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftv56NU4GLq9kVd3vxJR0Nq8TePTQdxJGPMJJRjVp8oYQ&oe=699EF638"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUHCIgI3UroQ7kNvwFKC1Q6&_nc_oc=AdkPJpuJUAhkIvuz5LLOXcpO6qwuvA3ibTcJu_SLVUYLjphHBXV_y3IJQCwxXDCSuno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfukA2vdbHqVqq2YcOSw2QO8QShxgBNPc5QYmqDZtPWs_A&oe=699F027B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvR7V90hlTYQ7kNvwHo6wH0&_nc_oc=AdnxWVnEnErOmARtBnF9y3HBmzwT1Mf-4mBm69u8K9b3Qkpo5RNdGZo0LqDLQejLfrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5Te_j3UqFde8r4JK9pjLud5uhtRspc7IdxyH16k0YnQ&oe=699EE274"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhC6-Knb970Q7kNvwEl8J4X&_nc_oc=AdlYAkfnt8PnP7F6JLQkBWCsn9dSzSatsjAbJrkMargzPNe7yEqYZFky2OKSbjWMhLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDWNnaFohV4g2q4fH2i8wXafu22Vd9xZlLz_KvLMnuxw&oe=699ED592"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24542588448767317"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25002072716085513"}]}, "baseline_offer": {"id": "2
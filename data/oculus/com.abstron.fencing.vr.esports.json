05092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1PX097fsMkQ7kNvwEj4_uR&_nc_oc=Adq2A2ErqgVn38zMYz2yG_wp4-_ACL6UeqMpzeYwfvfzEF5mtSq1jAuH3kovLAc0b4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0CM6AuoCCcHbdV2HPPKjvB_ra6bcysV87aVZ6BJBxSvw&oe=69F0B338"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRtuB6AQSg0Q7kNvwFw2jRv&_nc_oc=AdrSvtzcS6Bk5f-pxSMBE5w6a379CYcDWjA7yRKc8JCNZzqW6BP2fg4zvBgTL7HauXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af25rcOjX5htwQjGqPgJOufOsC_cn-weWkTLGd1Hbvdvwg&oe=69F0BF7B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tXdzMwRAvoQ7kNvwGYcBv9&_nc_oc=AdqnhMKJEP0rE90rV7cCyJ9-G3NfRxr15SyvzrBO40Pn_4-dr5be612FlgpuenPPJvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2DuomSvkSDSp7teKMEXv0mcK48ZPSyaNiYDAs9mDaFhw&oe=69F09F74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWtbthPWhdMQ7kNvwHqZ-Rf&_nc_oc=Adp4ormUiNBxYPpK27sO6fwoziBXPsa9ptSTkQDSJ-Tka2SF7cDs0vT1N8nUhJlnUzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1XobjTpo-bcsyuYsR6mifY9n5NR1oN25NdPm-pFXDE0Q&oe=69F0CAD2"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24542588448767317"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25002072716085513"}]}, "baseline_offer": {"id": "2
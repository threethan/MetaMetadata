_Afy2w7jhLD1p49t7rDdYOyaio_0SB6oR2bKLQdp6KaHlJA&oe=69AD5595"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTOWlr8NDy4Q7kNvwGFwclZ&_nc_oc=AdmmnXlJNO1hjVXOu-QcnG2b0959ICBdhjP1esPQqQ5lKDFD5rHObZN0YKsFeITMHCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAWaGx2OWiH3UG0sVsQ0j-EfnPTGqzvbWL80VwDi8gNw&oe=69AD76B8"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBKZhtnc4qYQ7kNvwGKVhnL&_nc_oc=AdltaxRFmLym9aWBHNavVueG7QPc3fxoalZD_o7btqiiluiZM5yo9SZS3l0Cx3DX9zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKGiL7qX7c6cZB9ZHIbe2rg_YaIfju2SftCYbsbMSGUA&oe=69AD82FB"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd18PaGzC20Q7kNvwEOT45P&_nc_oc=Admkk-t-3QzHtNLuAzQE6vCDDWEiWBLPwRzotRvAYejbz8konTIWsecwIeASkOQoTss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrRnVVj0xS63U1iQcHL8hIZFMqdzX1mX0Dbir-DEHFeQ&oe=69AD62F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOdyoFQa7g0Q7kNvwHrBZfE&_nc_oc=Adn3jF1GwFLHGdlKnXFqlFjQUkUn5mKKviG-iics2AK065PEoj8lspaUy5weWL4dbkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXyNlOk7B477zNfxOGs1xWgpr5JMkltG7QsMvg_WVblw&oe=69AD5612"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking
850101910859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTBnvYfk5LoQ7kNvwF0ViHu&_nc_oc=AdqollDdzF30a9abjF8RAc9hSiVFXgY3fM5wD9PtgC8EU5h0e7jwf0wlfpKfmngpVLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeyKA8r7NZP2_Vrt5xUmLufG4-9lmamA7vAwpfvTa3Tw&oe=6AAFF3D5"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us1o79sGPNQQ7kNvwHVzyrG&_nc_oc=AdqnJdGrMwz55uToQXBO94XUf-1Ukde-tji2QgW5yVqsWi256GdaSeB1kw0S2mTHAOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKbeAeZYDRCNrO_aCBH1vjbrMWgz1JXniClUETlNCv2A&oe=6AAFDCB8"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvLsNQz1JIEQ7kNvwG-ZceJ&_nc_oc=AdqZGcghFVE3HYlin_7jSyzTB3E5KlSRBMe3lqL6164ylZ_dzBtTe7jsqi0lkajxf78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP1qBhBKtYGd1GfVOy5rMykzD-HXlwHk7_zZugI4sipg&oe=6AAFE8FB"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyztCVcYj0sQ7kNvwHqk70c&_nc_oc=Adoza0e83Ki0QPxeihN0mJ-I7r6PKKHDtIfS4u7klPScgN6rnAC5Sk443n3DN5HCLQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq_qvq2SJpAciXUOtnspQv1Q6YFuiLuSVC6SD-kZBqGA&oe=6AB00134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IA_u80dUikQ7kNvwFrvCd_&_nc_oc=Adpy8ogQspICylVaTApcEn1tCSaqZIlGeYDMlpa9aEo6Yij22jUGyezt9gjo9EsAK0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzWhhT_yZK0bQ6Sm2tR0jIP-uR4XHncNsfcLQU4T36fA&oe=6AAFF452"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres"
_AfyRc9DYBoyHrQ-Y6YxPobidKqTjEqInMgycxfcy_N3x3w&oe=69B14A15"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdIbznAkDBYQ7kNvwEUDl8i&_nc_oc=AdnaPCkn3w2JVhfPVaMw9ySAgvyrTIlVBhWoDokUvRPl0ka_PAY-KRSA-uFkXfByW60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx7C25LfrQWPfvUJUTPW3hmFiC2-QveVuT0pZIlIya9w&oe=69B16B38"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVmDUt1UNwkQ7kNvwGSxDJd&_nc_oc=Adk1P_cKN3tQdSHog-AEhMaj_Gg3QD2lq7VhwK4VYEN8rXQ74ZhmwBsQ37dF3LBHzMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoUPcz90W4UVQ2TCvJEqZh9qKwxc-Qrhy1_lQZA1R9CQ&oe=69B1777B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0qKSGuqc9gQ7kNvwHtBpWJ&_nc_oc=AdnQfwSILVoB2ZzQRSktSCEwHRUtp0HCb8T64PNcSle2wCMyFTTLFad-PxY6gj3CJCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk8egpZUISk6Rw5huQazxn-pAoOhwE85lHgDcGYsp1KA&oe=69B15774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFu7Uxa4hNwQ7kNvwHctmvK&_nc_oc=AdnPRkCNE9cy5eDVEYJSrhu_MzMZYkMiOvBkmAHsHZZSzGo9Hy8UqIM8BLdOfoKMwHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPKycot_8sUU60kj-rxSdzq2J_4NZGXR7WdU5RW_JIjQ&oe=69B14A92"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking
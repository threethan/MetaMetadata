850101910859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjpPXK9yb7MQ7kNvwF9xScz&_nc_oc=Adq-WB2KNPpwzMDt2M5-hPoPowXAFm86l5U_szTYMZM6AzzBdx4eSRyZcyRum013MJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIfP4pwVE9N969tG7hRO8XBXEFH4SZxX8sivVIP9P-_Q&oe=6A7894D5"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96ZJ4Yo0TxAQ7kNvwHtgtez&_nc_oc=Adp3vdP5TKujvDun32rLbvdcMPpqkl60VaRvotFU4lHN_skXmMDurqy-SFDBxV3gJsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIE9eIBiZO9xRW2XFuHxGbLs531KlWjK9IzS4UcU0InQ&oe=6A787DB8"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bp8ACbomKsQ7kNvwFs44us&_nc_oc=AdplCH8d6Kh8tCScyLjz7M3Er5HW3lXeFwuLJW6xjep9K7dXWPWQreOsmBto7mYWWpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXUd-NDXHnLJMYFq9S4W73mHgeY5dmyasGeO4Y402m2g&oe=6A7889FB"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J92VW8T6pdQQ7kNvwFbZV_n&_nc_oc=Adrky_7fez61a74_7hxk_IBy8Grpv4H9a5siykAcK_47Py8T9_kMMX-4fkCEHlLShjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3euB3HPbdQcpbvUWVyftwUaef90evrUBaeNpanUVL5g&oe=6A7869F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCRcsUJO9GMQ7kNvwFJRym_&_nc_oc=AdoD7WTZHURNmN5qbpeFbJaesEeSithCMDCMB78x8jpCWFvCAONnpjrLA25lmzX9gMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIdhxx59bn_8t8V2QijHhMsseRHpapJGTZEBHcWfA-yg&oe=6A789552"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres"
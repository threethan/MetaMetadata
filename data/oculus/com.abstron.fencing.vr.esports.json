850101910859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjpPXK9yb7MQ7kNvwFH1pZo&_nc_oc=AdpvS_hdPYEklxsU6NCQ3tBYlZJlzdy0bwXMZiqu7ddjhThDo_dT7j6HmZCFrEA-gD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwjzgqjzFiaiL4-McqRtYKMjTNEQZ5kUZfC4hkJP0vrA&oe=6A7B37D5"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96ZJ4Yo0TxAQ7kNvwHiQyJV&_nc_oc=AdpbwanXnXkX446haNa9TM1MjvmBTuXV3Hm_qB2BY69UZwXyOlR6zZDI7n9I3Gswzyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUjtW4obngb4WPOALyNp-5c5EdA9drZrwQtPH-KnS25g&oe=6A7B20B8"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYc83_WOn3UQ7kNvwE-tZHs&_nc_oc=Adpseawm1LOS0vkqJJAcBrSsBnoDRRKZ6eXITDuWnjxcAgHnzJQ7pn6o1YIqqDmHa2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH2-HqudWSNq8qilEz4N9B_adWkJ_IgXgRUT70FKAhig&oe=6A7B2CFB"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jH26fUrjTEQ7kNvwGMCo1z&_nc_oc=AdoyaLupTnFvrrro64xbZZQTXInNdq1feoAC6jzq8Pm7GcPH2Iow1rAihKQHpP3QWZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXz40_az0L23guTPDnhm_l3bbgHpUHXO49ooNFQKve1g&oe=6A7B0CF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NklJh3W3d-UQ7kNvwEJs3ZI&_nc_oc=Adr0JzcJMHpMroQCllpKr-74PBw_-GXFXggbfw3E0BEDFvKPDwLuzOoyrKQAj6XwQrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvnsye38VICNXTnZuEnlWED--Da-bdVVORSjdltdlbiQ&oe=6A7B3852"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres"
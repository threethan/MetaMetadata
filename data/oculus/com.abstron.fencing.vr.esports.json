850101910859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_673850105244192_8554682878628301774_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGS-EqfkSeYQ7kNvwGHy2A6&_nc_oc=AdptGXQxa-2XAgrxwP-ArH3CwOxRgyNB1oHCEGra18emqxyrzakSIB9nY-Np7SARJgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn6SCODtuDFJUZIfMW0liKJ0iVWaj1qSUHzrSsSEEnRA&oe=6AC11755"}, {"file_name": "1.png", "id": "25236605089274047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_25236605092607380_1831297009379149924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxyjnsAuwQ8Q7kNvwF4j2ZP&_nc_oc=Adrjwh93QHaW6MeSD2rdEiWEm12d6bff-GNr7DCylp1R1QzJ0psDRR9kfrTwX_zG0J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd4PcOAzhjigKgOC9ukw0ckNSnoyh5L0se-_4vnm_asA&oe=6AC10038"}, {"file_name": "4.png", "id": "795781569515269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_795781572848602_6835198966918900989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoZteghmOUQQ7kNvwH8zmVk&_nc_oc=Adpc824LVb5cDhcBw91PHUapqH0TgwuxxrHvk4Wetlvh9ZkvC5SdPKUkbkg3tb5-pYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM78P4lD_jHWm4TcyL2tuCEzIIzcf-1ewFbMp8H9i3QYw&oe=6AC10C7B"}, {"file_name": "7.png", "id": "1423105092120203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_1423105095453536_7513528383127247952_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58PCz6HxsoAQ7kNvwGCT35m&_nc_oc=Adopv1SVctYb328CkB5RDCjkdfU-s44AK2eu5UhAKltjm6_3efy2tdei1g9M2A6svBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcwxVeK9daoNPBN_FliTTrlCmiKMMO_Xs75yeGBIJOeg&oe=6AC124B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fencing-vr Landscape.png", "id": "1105385768373296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1105385771706629_1526644266772282750_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQmPskdxdVoQ7kNvwGp9hsz&_nc_oc=AdqxD9ozfzHbFXizQ8i4owlYYvIdMcGVvGct_fIqUJQZlS3QKERdGzr-Gzpq6jVrp-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIHu9l_Tp20D4sYJQbNWEEC7cieRdAHebiXY8YPmMD9w&oe=6AC117D2"}, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://www.abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres"
9dE4thSgkedSkQwPsidwd9ez3ibrn9HHqvdv4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRAS1Okte3OOl3QeHJwVZBR1ITlJJfhDDG7FKH7G9Inw&oe=6B09BE40"}, {"file_name": "SS-04.png", "id": "933852299665347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312468_933852302998680_6112813428469801549_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSV2um7CBTAQ7kNvwEK0UG5&_nc_oc=AdoEbWxNPVrvUBE5t-C5n0sqlLjpEaRbu0zQMyXxURCDJwslxqu3aU7eiwF5N42wiXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUYVPsffsWMauemjUey7ndCpe269omyQiKw5CeU61-pw&oe=6B09D1A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fencing VR: En Garde Arena", "keywords": ["Combat", "swords", "duel", "battle", "clash"], "long_description": "Step onto the virtual piste! Experience the world's most elegant combat sport with unparalleled realism in Fencing game.\n\nPowered by a realistic fencing physics , every parry, lunge, and touch\u00e9 feels authentic. Master the blade in a true test of wits, reflexes, and strategy.\n\nKEY FEATURES:\n\nMASTER 3 DISCIPLINES: Duel against advanced AI opponents in Foil, \u00c9p\u00e9e, and Sabre to perfect your technique in every style.\n\nGLOBAL MULTIPLAYER: Challenge players worldwide in tactical, head-to-head Foil duels, where strategy is everything.\n\nPLAY YOUR WAY: Full support for both immersive, athletic Roomscale VR and accessible, quick-play Stationary VR.\n\n\nHone your skills, find your rhythm, and prove your worth on the piste.", "short_description": "Step onto the virtual piste! Experience intense duels powered by realistic physics and true 1:1 motion tracking where every touch\u00e9 feels real.\n\nChallenge players worldwide in ranked multiplayer, master your technique in the Training Academy, and customize your gear to create a champion.\n\nYour honor is on the line. The Arena awaits. En Garde!"}]}, "developer_name": null, "developer_privacy_policy_url": "http
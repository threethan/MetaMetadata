DyrrurvYGqr7TodBanZVbNm-6wjtoZRMW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0Je4IYZ4SmzFyZdjoxZyDN_nxSFjWD-he1F_685aI8Q&oe=69BFEF49"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PL0UAyuBOAQ7kNvwHKXKCN&_nc_oc=AdlupsoH-8M8Cyf4x7DRPW8UJNcn_P26TmlD9Xc1RI20iAi7QNhHk_F2CW2emYXYwwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmuHquI40W1A7j9XjZNbMJCbfZt-ls5IkwRqCMyg8KtA&oe=69BFD9D9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryswHVY7oaMQ7kNvwEZ-3ku&_nc_oc=AdkA93mwKTxpjw4SDch8Zo2-S7RgZ3Nb0StT9ElvHq01nYThwhxUQ6wB_U7FWk3fyag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZaT22_2FWU0FBrT_tGHXTIWp8jt8sawCJU_v9C32wHw&oe=69BFECD7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aghg5Cte4wQ7kNvwHF1JHK&_nc_oc=AdkpcPG0E_d6c0xYr7q2CauRRk9lae1etLqn_nD3cJ0pSTfyg0QtIGnZzOu1kPFxFZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLv8OZmGLTYNXHfL9uVY2LdWKZqQiJQeIPuyV4EZkqHA&oe=69BFF1E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVtapVsZ0FsQ7kNvwGhx1R1&_nc_oc=Adkiqh4oF61lhXSagnwgkBV1t003qbdH-EWaelwvppzVL3Gg3zw3Ql5b2N0J7DAyafo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8c9Gcjku3TFmOQKwjDXNNQllZiPsIKE4qhy7GkK3YgQ&oe=69BFF5EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
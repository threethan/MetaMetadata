WHDQgx5B1y8qpg_x1Q1VJ7y6TcwdmeeUhc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWzMIODt1GL01uM2iusFU7xA1tCopJx-MUnCgOYTu6-g&oe=69B6B4C9"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8D6RGGYirYQ7kNvwEl44AX&_nc_oc=AdnYWfLljgxuUkN5ZLGPw3j8DPS5OcRnyBhCRq_tQUuHVqdmtxdXdszj4Pv3PvCSNHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afye8cPd4J_51RH284sYa_p_3SF5_IYMJKK9iV7EqQW_KA&oe=69B69F59"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbhMR4y-rBIQ7kNvwEAh4Ap&_nc_oc=AdnoIxMREsL8K5pkP4fbhyshoykMZrvjxsWu6VOEU9k-6FqYHScT0HxeKnsl4IkWn1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_qg2o3FLoOQ_hs5HHS4DfqCdOp9sFdI9ZyfouY2Bo0A&oe=69B6B257"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6es-5GjGfQwQ7kNvwGe7Z4v&_nc_oc=Adk7ify6vFRn1FTM5oxyh0NPFOt5SaOlvspCwSU-P725FpXjnKDIT4GR3SLSmXMy33Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_Ck_WD4ZtP1a1WS-ukBfIFTD62OtMxngZTP7KeXmG2g&oe=69B6B761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQZTirs9PMoQ7kNvwHS69AT&_nc_oc=Adn-sPxVIq8fLqf2bNwcVsV6VX92YfHd5SxK9yMEE6AsOr2G7r3d8DgqWM6A0GKa_0M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5uOlvi522g6ll0gTcsWsxC8T-7Obh5wgJDMUnWhU_ig&oe=69B6BB6B"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8Dr4cR22XMQ7kNvwFUF7aI&_nc_oc=AdrN10Geenl9PBIL4rgi9N_4ySF6_7cNooyWZPJDbhA7G7oBaNi9DRYI0ltIx-KA9y4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLkgvwgPZiwTIgzDGc7FKRpD0V2Po4k_70AgWbahptbg&oe=6A859AD9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhczNTvWGK0Q7kNvwFc8pza&_nc_oc=Adqh9g6Tt5MpBqug9CpRsJLlsv81xREhhU5hoScpGMn5N2wgnmBPr93HizfiAnXc_hU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxPPlI3v-L7mbs0sStinMFxiImILa3GP8rg7n-OwL4gQ&oe=6A85ADD7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_umnR_Si3joQ7kNvwGfPNl_&_nc_oc=AdqjNNsFEGznCnw2qds7DYr4BQt2JB00SJv1U-_IQsW7PmVDPMd8T2hww7XPeIudexo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF16uYW8tPlEFVuo2ErqXBifuQr31pD9PON_NVQj-4nUA&oe=6A857AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4Um-OK9Q8QQ7kNvwH1qUZ4&_nc_oc=AdpM4v2aa9LJ1Ac3-eSgVeXZMwqEEsn_nMUhBwJ2eQq8hLjaKM_XP0tFDiDAn9-C6gM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHwHYbpf6qLLa4ecRUFbVwKajFEzfWqTAR4xkrxK2VvA&oe=6A857EAB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes
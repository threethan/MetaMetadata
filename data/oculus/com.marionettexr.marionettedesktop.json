": "277495467398348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003242_277495470731681_7721116716354681708_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AxPc8_Ta1wQ7kNvwGG96wz&_nc_oc=Adpspta3dpPl3pndZTQH762FeYxvz3GI9Qts9FOL6C7mB8F_h80ILsjy7lHoCqYXkxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS_FKio5Lpg1AoKmCj1TAfiSxD_dEXq7Mfm-MJYASeww&oe=6B047889"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWpSOzB0p0kQ7kNvwEuCR0k&_nc_oc=Adq33J1SfgL6wuhC3oSgLOazrY71jyZ5G4ixBbDPhIV7eOtpAwCt11Nhhu6vG4aS0zY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRym1s-0T4-qMDaqlNlkq-lALFOHRiFSbS_Jn7NzyyAlg&oe=6B046319"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkeZ8-QYuyAQ7kNvwEs7MvG&_nc_oc=AdpP75MR9Yz4-tI6-Z4Jd7az12u94WWOr5S7dt5q8VR1CY2V9Us5JD7ZgveACBvEFXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw1t1L-7mtOjYf_Wt6xcbwHU_rTRaaM_mdp5NHJG17dQ&oe=6B047617"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMg0zrzFZpgQ7kNvwH1sXTc&_nc_oc=AdpBKJ3vMIgw2sof_DfF35umAf4aSN1_1DCol-LjwTCKI4lZnLi-SeBMb9A7j5fYE7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQilxppDntlaJAWIweuFPxXDxX7u1rgldO3KaY9b58Lbw&oe=6B047B21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7UBRsmEOGEQ7kNvwEzodhW&_nc_oc=AdpHjjOrvukisYGjTXA8eznZgqbUz9x8ygpW70D8405jtQaupNINBGvEaxY0ROg7_xo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL07wI0Eg2S7ueQ72ujOHInd_96rdfSUj6vlA_4qdFbw&oe=6B047F2B"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating"
ABNVBkvUJ9RhT_o8um4YYXAZQx57rW_2_j5lY8_AqA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxI6w9oOl-Ke_iFmVwoao0It436SJmO4W8fzqmsjtUJ3A&oe=69AAD749"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqRC1gwm6ZsQ7kNvwEaWHm7&_nc_oc=AdlG1V60q2gZHlHMfTu2eQOMxWNARincxK15UeoVeITAmO0YX8-DxpIzJ3jnEhEgqEI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz62--7ShZK3lNqRDPudctmNcOG4iJ3DX0RVBD1ir51sg&oe=69AAC1D9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqDP-aG045AQ7kNvwH2DUzM&_nc_oc=AdntC7joU-Dv03zOd5XyXrSeaO2p6rB22oPCfiJ7d0ySvWPalfIYkbE3bTsC51W3kAc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyA331q75d6fycKcPf5pldTeW93Q95djCvJDjQGmiFXFw&oe=69AAD4D7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYZfXz7ul9MQ7kNvwE-25bB&_nc_oc=AdlsVvgunfOyqXQokNyQknb6C44wTeDR5BlD7IgRy6XbAj1EEthEX9dFwMDmhB0VXvg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afysxg-GR-s7ODI-zwpIJ8E0CVg_N8XQ9S-spP0Boby-8w&oe=69AAD9E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9YXydaXi-oQ7kNvwHhQCGY&_nc_oc=AdnPbkjM5CXMnPdywmlFhygIOtgAlquG4BUV3zU9dKGa8g36LnSKgQSaNZLCnDkY_TI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxBwcguVIUY9eZvWxuti2uuyNGvBAzVAvqX6iHCUWwgQ&oe=69AADDEB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
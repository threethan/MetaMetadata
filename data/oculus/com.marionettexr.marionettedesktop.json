a1lK2hW_TCQL6ohHNxekiX2fjtGfPKZPRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_PQCrl5H4Zogn-_ULJiqlzsS6lRk5K_Ftq8FPO7chfQ&oe=69BE9DC9"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COnBhqXWl-YQ7kNvwG6RtE4&_nc_oc=AdkzObRcwPEom5JdQS6K_WmgI69OMFg6l1e2trD68XBUqcbRRxI0qni73c5E7YxtYP0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3IrHjwqFlh8KzFP9Pt3bJnQse9-_RKxsPRb7RZx2eaw&oe=69BE8859"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbViFY3zU3gQ7kNvwELfdy-&_nc_oc=Adk5GNcqzZA0cJs5k8Uv2iGjQ5GGhdDfQfb93hQ3QOC-eFWJlErWF3gXfAnkuI_SyGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVz4ZWJMxctYs1awtTt6RfdrKc-JW0ZqrIPoz6tL8IQA&oe=69BE9B57"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VArnY1tQQmEQ7kNvwFqjbhG&_nc_oc=Adkw2yUyOCSdXe4Xhjs8zXRF2IJcaPlrBV-w2rRn2ySB9wYEojbHEepRRhywdDpDFWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfydZh99awBQehWfHHXZ8L4oMZC06j1hED99zgXulsnCDQ&oe=69BEA061"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_9jBc-QRKgQ7kNvwGjBL0V&_nc_oc=AdmOO4P2H4JOrZMKcaZpFCdJmVIGdQoSenzNJcjNo_dHpyS8xiPmzOQDxNhlKj57UTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6f2QrwgJjoWi1qK3CwjEZoFlC8G_tcOrfhK0jPxKGEg&oe=69BEA46B"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
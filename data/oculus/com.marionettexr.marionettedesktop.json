62688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8Dr4cR22XMQ7kNvwH5W3Q2&_nc_oc=AdqEdLPF_LDA_3mkURFlU1ZHXMPu-F5-dcgC7-hqFjhhbaMSb2oXtvdidyUi0gl32rc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3mXash2cKrXqHy9tr3ZQV5LXU-ScgGT_XywaoI97urQ&oe=6A883DD9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhczNTvWGK0Q7kNvwHi63iT&_nc_oc=AdqvESc3KqEUEHawUZt1lAUaS00GN9_TPh_d9wKsmJJ0UQfI2BxJmiH4P9PEc-m6ess&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFl1DhEdnrjT6XmCObiEjV3nYtRnpO_jqiEEdYa6NOag&oe=6A8850D7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_umnR_Si3joQ7kNvwG5y-0S&_nc_oc=AdotFsj4slwtot0tIoDC-gVL4zS_0jTs_-Q2R_iBiOAyiOFTMiTbiBaRYZiH6NMxWBs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0tgpZhtd9lHIsqXBd_6tmABAiDhfcfBPAAKvlMk65Og&oe=6A881DA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4Um-OK9Q8QQ7kNvwFwVREt&_nc_oc=AdqB3jzt9D77GAkXmYveQQS_pkN1ZTldor98qwiRwI-xS6P756IMzJ66_GmCN_Xab6M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx3-S-UGSg2l8XPqyCSt2V0Blw7aXpScBh8jPi6cAkyA&oe=6A8821AB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
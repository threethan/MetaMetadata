62688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XE6PAtgBcYQ7kNvwH3d0H9&_nc_oc=Adq386dXljs3KiusyauKYPrE5I3yblHFAKl_T0VDRoPtvy3_rnQ_8koRuenWdw51_2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_II1o6SmW-uaJDOYWZ09qvNDpnVm4yOY-xmVL9WdBdA&oe=6AEA0519"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls8bAJJQHewQ7kNvwHWAqBc&_nc_oc=Adp4YoAfuDw-SL83rfbFKJ0SlmDrz5QK6pHvBj_uAJz1SmgXM4FHIA_RIPy3GIlo9fw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTf8PJQiTmDA7jMZBbx0ILgKF4BFtqpTocztfTmgthVA&oe=6AE9DFD7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho05E9a0mZsQ7kNvwENkWzl&_nc_oc=AdqBFva2JilUH9ow4llSqhTphEumQNJYnYfbsC7suVzDDF0cQG9OrI89cCEfUua4nq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyQaqFaQMNeF3cLw3hLEhd4Nw-g3QvxP_kw6oqqxfcAg&oe=6AE9E4E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERs0k-268hkQ7kNvwFESrnN&_nc_oc=AdqZWgIDlRodwTRSkjg_G7Opd4vCtqu41soa77Vniwx7CPYflnTObZAYM1fRneBQe08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwV1DF3OIY57ssx_ocx_n-qj19xyvsDqodZLPDenHrPw&oe=6AE9E8EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
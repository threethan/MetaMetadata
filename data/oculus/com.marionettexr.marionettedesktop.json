62688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiymYAKWL3gQ7kNvwEzWj_Z&_nc_oc=AdpNESxEH4R0453n01ix_uhg4zbFDkVjvOTI9b0hE_30OLc28_FcwMjtlCnhx9Mr2MI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bEiNYfl6ZMKCX5H1tLBcdEDkhm_ld3CzvmeT0g5ZKgQ&oe=69F5E759"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Scuf4Z6NbTQQ7kNvwEDNDXf&_nc_oc=AdqSL3R3rpUkSsSaLyvbLRsTFatSY21Myr-L9VdqntYaihOkk2bvrpifbai6bnMeDrI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MzmCMS6qSK4TB3W4zdK_bO_hHfAYLYHYPQS61juVoSA&oe=69F5FA57"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVFAPtyhQoYQ7kNvwHSisIe&_nc_oc=AdoKNf6cqhxjdKLTe6jPwKE_TetfsWx9vYY97JmXEavx93X1J863KNWMwiZFidSmS-c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07_N1GK2JwFY85dOJXlcxx8LYEjNEAn9-_o43Y9q_7Lg&oe=69F5FF61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmP6kf7GJJAQ7kNvwFCkP-s&_nc_oc=AdpA2xU-aRBRHr5MuOVuUAOs4eDFpIXcvRu19zdutyaLtlMW6IdGzG5KfaHJxJI7U1E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Rwgme362RrlJlhcBB1bNTSqjBfluDkPImj4-vZUsOGQ&oe=69F6036B"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
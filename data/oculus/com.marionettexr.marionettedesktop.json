62688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKdQxoO-e5gQ7kNvwFOJEro&_nc_oc=Adqw18I3ODie8u5ybMNdV-ZoSVtox81OPD51vydftO2eQHNwIlgKi3ro5Y-6DKodJdE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Sp6CRyXzm5yuFYJLh1slUKbiv4E4ibdFuVuVEn5dDuA&oe=69EF4FD9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHAx7FLM32EQ7kNvwFSlPe6&_nc_oc=AdplRqCm2bfbz-W-O2BRhmHB_X15BPX3q9xZ3RGBKuQqf_I6i_L5Phka-AXm-GU7XRc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QZy9qk2f2dlE2fo9qO8HUBsT1u5EF2c_p3d0CC-QXvQ&oe=69EF62D7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iqk2ffs7rYQ7kNvwHC03lj&_nc_oc=Adr-zKGlCid6OOuyE-GqhCebhOm6vdxYt84VOsz5h0q9FwmqRRnN_z3asKm_4GMSN_Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02HDefgHUNkf8Lder953vS8P6RwF6n4yepqJPIl2wKKQ&oe=69EF67E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XA6JmOydIEcQ7kNvwGdiPzE&_nc_oc=AdqNU0uPIViiSl_tipz5mXg4plIp2xgkj3Ib6GT1yk_3fg3hmPRe47WmVYY8tUhL4oA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35kZ2vPFq98jrhPw4_BxGVon9EjDqdr_Ls1gkBHEzMRw&oe=69EF6BEB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
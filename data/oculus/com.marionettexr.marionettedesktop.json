TRShgBOj2E5wUouXFPlQr_V1GPFF_F4gLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6dewpQ8KdpJe5_VrKJaR0f8ZaHoP4qTudCIYYcyk1sg&oe=69AD7A49"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oLJuwP_8dYQ7kNvwEphUUL&_nc_oc=AdmkaaFgFvuhJJ3fIFYqUGXbsY4qt5IZuXPlOgJVkqrAQHhDrzJx-h1wYoQxsAMl2H0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCRp0d3kysK6NdhG2eYyNckEQiv2fWWLGsRAIOfcXfoA&oe=69AD64D9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBCzysl4fZ8Q7kNvwGzpNBP&_nc_oc=Adl6TJatqGL4qFKMNVPwsVQvUT8-568YnUVBP8N5I5Srj4OfHmsgfjs-5r_W6tv7rDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5sNClaG6fqTBG8ntVilXXva4poWfuCaMTDYeQfLinjQ&oe=69AD77D7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ8TfaMCfGAQ7kNvwH8m2Z0&_nc_oc=AdnSGh90Z65hlUSxF7fCMtOk2oQaP3lRzsL-8iCdLZtnkED29U_suC9NYCupie6xQiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhtF1Ji4X8olCjM7nXjuRqkwac6HhmX6Xo8IqpBFQKDQ&oe=69AD7CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OqB0VMaFDkQ7kNvwFM-ksE&_nc_oc=Adlh_a0zI30J1ExGx_uOZAiSURjx3g71u0hV1j3hYB1K_gmDzejFv-indGczp9BUMXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZslTXHCqhJI-Fck2mAkhbbb0_pFGatyS_D3zAWAv70w&oe=69AD80EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
62688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggzifMlmv30Q7kNvwE2KoiV&_nc_oc=AdrLymZwcuaVIQbOlqkHK6tGfIm2xLCLYa4i5ceJVUfKHUNXRAJ8TBUGY3RiamB6LBs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5umHFcMZNWpuT5AVVmBCBMPzeYmYuYDqqOazJQ2ZqKlg&oe=6A16DCD9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM1JyK1xT_8Q7kNvwEt4bY3&_nc_oc=Adp2wIwgnAIVLSBOPefQjvNtWBe7vbK31DlntmFWWb0r7mi-EwOiWkix2OIMP_7H2o8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bHHCYghs6iToKaS03P-33aYH6teIyhA9JfGKEXxmNrQ&oe=6A16EFD7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shvkHWjzq4sQ7kNvwGd0Mof&_nc_oc=Adri9vAClvRsH-tLOx6mBgc9KZegr-Ea_syhMRKhtIGuo2s0_2jBRZ6Y6XpdbGz9-C0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RHgtclCrSAwVfXFSZoCVVyNhJe1DsaCcfPkLSdrh8iA&oe=6A16F4E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSNwT4UQaKQQ7kNvwExNkUy&_nc_oc=Adoln9Kbr-kSS0NV3-Y59gQC0uPsjDP2b8vfbJxtGsWSJLUGeMyfqMCjjFjRJil26G0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YcwgceDkTjIUrfpWw_6zZNlkSpCV1TgybakDhew5SGQ&oe=6A16F8EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
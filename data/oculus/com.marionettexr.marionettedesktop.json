wksrDzszBxHlmMG7fimLs0lLQ4ydBtUStI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0QfCJMYqD1qrGZC4AAbnQZYK583yulIPr7SPITYnRqA&oe=69AC28C9"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oLJuwP_8dYQ7kNvwG9eQ58&_nc_oc=Adlea8vIw8ydCQ1DcT13Y0RWJzIW-dgD5haSLnmz4KiSq2uyYK6mQoKZovXy-PbgbN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6pFAfQMSGrsFsxU-QXQIQP1QO5IqPZxm4-hCYsmHmUA&oe=69AC1359"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBCzysl4fZ8Q7kNvwHPZIl6&_nc_oc=AdkwuJSadkavsFX4c4_qhg8DxEkjE3g3xAjidrfBzwlKPR3X69yYH4hKInILD2R6jQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZz6_B7rFxOj7cFd5BhXLKw2McMt55K2ooSvu-ThBPIg&oe=69AC2657"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ8TfaMCfGAQ7kNvwFuCGIL&_nc_oc=AdkeL8H-saNDs4NpI5SaeegzTbnPFdlmWAqXtM0V2eZfrK5Fldb69OTg87NSsWf0-FA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlXDWTW9621UvmIAmyT1pn1sTowMea_2so1Z8WdJ0MIA&oe=69AC2B61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OqB0VMaFDkQ7kNvwFEbPfq&_nc_oc=AdmiDd8F6RECgcu3LDpMYYhVmlT2lGTF5cr4o2B1E3flxy7EvzlYihIxN-5hEoDcm70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxixB8E9rEyAqun4NEDUHMopMbp-Z6udrS_H0FUoWKsAQ&oe=69AC2F6B"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
qmxScmCZi2iLXoyom9YAKgCsz3T9rma4K4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvGyx7n-w9Lr6IQbDXQrTScNeDIhxRxmRv2t8cESAZ-g&oe=69BD4C49"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COnBhqXWl-YQ7kNvwF6f4Z0&_nc_oc=AdnzOlpDuxfPUo5FHIddg2hQ2GUKIRDk8dyG0jIlRGWghYjgTNes_BBtOU6iINX31UY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoWzEN2ivKngQeXAVUVAdL3JAPHAHY7DSiB6H--dXAhw&oe=69BD36D9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbViFY3zU3gQ7kNvwGz8Bdm&_nc_oc=Adm8UGdgVlvaLueK4T4-QKit7Ks97yliwF1ALaa-R57a4HGp1jGFTtxaHkcWG0jZ3QU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiLIBSrqAYwpwxm258ItgzbGpkEO0xnvOvarvV1F1adA&oe=69BD49D7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VArnY1tQQmEQ7kNvwHbfSOs&_nc_oc=AdlpFHK1mm2dxNTuNhWplHpdru_PF30UG5iYpU2wuuRubs-RLG-IjOWxfXascVjaq5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEHb-QeNbOAAa6pC7tG-AwmaVavMBNIU_IsrhHl1LOKQ&oe=69BD4EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_9jBc-QRKgQ7kNvwG1Oum5&_nc_oc=AdkBdWw0I6Y1wa3pPun4NU09fNAsXB4SH34wH4EM-B9-w6LHwTQHOGxER_VCrtJFX1M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPJ0cG4913iLDGGEhxJWoerecr0opX0pM6czkAsuGnyw&oe=69BD52EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
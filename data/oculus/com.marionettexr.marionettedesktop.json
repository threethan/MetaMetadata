HxMv0PtL9p-KEFiHnE8TWWolps9ptJSpM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_gMSGHT4-rgf4WcSgHHwjpOz9TZA-CP2Tbk8_cigc4Q&oe=69B01D49"}, {"file_name": "SC3.png", "id": "3107780886129355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_3107780889462688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19_aCQDNatIQ7kNvwFZ5e3C&_nc_oc=Admn19rAeI9qkJDLKIOMWcD4QYou3g74mTMC1chM_NKSPG8rZN_6nBh7EUBEhT7Hqsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afykohw5zBW9qIshTd8kOux_-BTeVYSWmN4s_I9Whaz1Dw&oe=69B007D9"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aUg7WCZZeQQ7kNvwG8PhvE&_nc_oc=Adm2C-7E4pRAMOlOpdKwGeNV_C_1xYSWbtm1EXv4MCaIWWugLiX7A4mw_K80XxKMz70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd8wNyVa-B5GF1RNI3Po_UVEr_hdFZfHarsCFrnsR5Nw&oe=69B01AD7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Enyq5CxPG8Q7kNvwE7X06k&_nc_oc=AdkcPvbssXxe3uMzoV4dS4QOBXz2v0aF4mzFHxnIZdGxQac3jHqxFZF3NMUI2qoJsq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfBWJwoHyBZbvgcQHTzNOv8Y3SidEtTPSmS3vLDsc-2g&oe=69B01FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8x1U47B740Q7kNvwHVAGp3&_nc_oc=AdlBNA6khrV9Ry7B8w4jCF7nPJJs5sFYpZikgPL0G9WhzZIOpl5QNlhnjVwVi7DMWWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAb6-M8p187prjPG1ZGQYf35NK_XORRbknfX_SdRtR9g&oe=69B023EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
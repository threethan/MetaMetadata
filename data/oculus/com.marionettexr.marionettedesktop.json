62688_9133608938552631719_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Isyzm-ZoAtEQ7kNvwFybb5s&_nc_oc=Adr00U3e3RFFX0YKEsA5VAi3Uqh4oN7UWaz6iKvDWoeIkUePoSnoGXFoAJ49xi9nQ6c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tXODFgAjr-XZyEAXnsf_zeKNFHeYDLLrhMejdEy3Vtw&oe=6A244419"}, {"file_name": "SC4.png", "id": "501963917528594", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982553_501963924195260_307194920377122869_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QyNUrDr7T8Q7kNvwHGFb10&_nc_oc=AdrbLAvSj8ABswxK5fJql2AQZNYLrmdoLfYx8dfimZt0bYX5ETXSI0ii7oVZBSlxNVc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DoFzUS9bE9DTJUp4UDGebRM7KXgMtrKYJzY07T2Crag&oe=6A241ED7"}, {"file_name": "SC5.png", "id": "3009592912653573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031330_3009592915986906_2047540131165911933_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rRLhxcmJ_gQ7kNvwGhfrfV&_nc_oc=Adovo99A5oXmPUigpZ0e0lkBNKf6hjWnCQ0AAYR6UeXaUtPC4ykSTUFa3KocIXAbvhQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ok3BVDAg-jb4Z9KFyImVAtlIgebsiPNePBKKGyorwsA&oe=6A2423E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1219712615133503", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035404_1219712621800169_3580933134705653831_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm6uU-3MRCYQ7kNvwHH7hqh&_nc_oc=AdqJU-UArjCIrlVBDh3lclIsHaJoYewvprVbAZmX5kwXJCFJFA1_I708r7cNxHwuMfk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_9PW2yTafZfhfcRPjk0s-4Dl6sk2-KSqdFnHdy3M0Jw&oe=6A2427EB"}, "display_name": "Marionette", "keywords": [], "long_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills.\n\nWith Marionette there is no need for costly equipment or large studio space. Combine inputs from webcam, phone, VR, and/or a microphone to record performance capture in no time.\n\nUse our video editing inspired workflow to record in layers. Mix your recordings with imported animations and audio.\n\nSee your work in real dimensions - instantly! Scale, spawn, and move in a weightless environment. Work remotely while being physically present in virtual space, with your team, or customers! (coming soon)\n\nUse Marionette to export to standard formats such as fbx, gtlf, usd, etc. Continue your projects in standard industry pipelines.", "short_description": "Our mission is to empower storytellers, 3D artists, and actors with a new, intuitive workflow. Record and edit performance capture in layers, whether you are working from the comfort of your home or in a studio. All you need to get going is off-the-shelf hardware and some video editing skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://marionettexr.com/PrivacyPolicies/MarionetteRemotePP20210301.pdf", "developer_terms_of_service_url": null, "publisher_name": "Marionette ApS", "support_website_url": "https://marionettexr.com/marionette-support-form/", "website_url": "https://marionettexr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
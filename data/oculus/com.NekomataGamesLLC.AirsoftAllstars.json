_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn9PT5ca7n0Q7kNvwHGhRF7&_nc_oc=AdobzUVfoRLcdWLLsNo97IUai5hbGVAmZrJc2z6RwDjW8ws9ZvkqM8ZNBmnQHVwm3HM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyzcSKA2ZR41iRrln91OD1-F2tUDZfwgj_DLjRRiH0Wg&oe=6B01D514"}, {"file_name": "AirsoftAllstars_Screenshot_10.png", "id": "927375667134155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_927375673800821_1840268041667170271_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKT47SkplHYQ7kNvwE-6zoe&_nc_oc=AdojtZA28dNSHw8LWXAL4X1M_g2qjoLWWKDmaQPGyqhKpfB3Whti5PqkpRVq5KgQNvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCQgLSBXx9-ws_jYhu9eBnwQ7l007jOfazoRRlrXRfgw&oe=6B01E3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirsoftAllstars_Screenshot_04.png", "id": "1224602525757971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307935_1224602529091304_780746822987049476_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKQTfAC8FzEQ7kNvwFOsXzL&_nc_oc=Adopk-9YtB0Vl6hszQfuWhyDrF12n9Hk_6WTmPM1xs_6jjjenyiAjM56gVxPLky6Wes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvTta3Yl5N-jkqTIBppep1kX86JODtwyTcjsmbQOGBjQ&oe=6B01D52D"}, "display_name": "Airsoft Allstars", "keywords": ["airsoft", "paintball", "speedsoft", "tactical", "milsim"], "long_description": "# Airsoft Allstars\n\n**A fast, chaotic, and ridiculously fun love letter to airsoft.**\n\nSprint into cover. Blind-fire around corners. Dump high-caps. Trade hits and yell \"HIT!\" This isn\u2019t your average shooter. It\u2019s pure airsoft energy.\n\nBuilt for VR, it captures what makes airsoft special: tactics, sportsmanship, trash talk, and that duct-tape-and-zip-tie charm players love. Go hardcore milsim or full speedsoft goblin. There\u2019s a mode for everyone.\n\n# Modes\n- Offline PvE with bots\n- Online PvP\n- Co-op survival\n- Zombies and party modes\n\nJump in solo or squad up.\n\n# Customize\n- Weapons, optics, lights, lasers, mags, throwables\n- Gear, outfits, ranks, and unlocks\n\nBuild your dream loadout or a cursed meme kit.\n\n# Locations\nIndoor arenas, outdoor fields, and CQB killhouses inspired by real airsoft spots. Every map plays differently.\n\nBuilt by airsofters, for airsofters. Call hits, clutch rounds, and sling plastic with friends.\n\nGrab your gear. Fill your mags. See you on the field.", "short_description": "A chaotic VR love letter to airsoft. Sprint into cover, lean around corners, and sling plastic in PvP, PvE, co-op, and party modes. Customize your loadout, gear up with friends, and play your way, from tactical milsim to full speedsoft goblin chaos. Built for laughs, clutch plays, and nonstop action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "32692448387065650"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971201318721374"}]}, "baseline_of
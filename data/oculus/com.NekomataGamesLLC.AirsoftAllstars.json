?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knBqI-FwvysQ7kNvwGwgFPN&_nc_oc=Adr308WZbvSW7r4oaCQBw7uEd85aoNjIgJlJ7ScxOzuyyj8YtRfgBOhk665t_yq0zLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj8RAUmS-jxh6tZMdilyIY0hDCch0AChx06O5kyqSNtQ&oe=6AEB4BB6"}, {"file_name": "AirsoftAllstars_Screenshot_07.png", "id": "1611645756503151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_1611645759836484_2521520559478896897_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCBVHPlWhZAQ7kNvwEQJswm&_nc_oc=Adp-qLJIW-S7P40FYMCAF03pYolfjTtF2i1KXCuZbaFk3u6nNi0TDFRHiGC7R0tNiBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZV7ZqyI5Y6bG70tWDa-9U2rBhIr5odoWueenXCCzKVw&oe=6AEB2CA9"}, {"file_name": "AirsoftAllstars_Screenshot_13.png", "id": "894828566814939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312263_894828573481605_999761461262008166_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI8I60xOgIMQ7kNvwHP6_Zz&_nc_oc=AdrNARurqdbxgU4B2C-sMSHHEgXV5PbOMGC42D0WbuE29n8koAmugJ3mcY9hTm64ehI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSezfHuP4EGw7Kn6qR9vwtZZxRdaDT-yMjiYZORQcEkeQ&oe=6AEB4512"}, {"file_name": "AirsoftAllstars_Screenshot_03.png", "id": "909934085021775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_909934088355108_5643655692698411532_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4sfESw_CK4Q7kNvwG41i-e&_nc_oc=Adq4yf4ChMJCx9irRTPFhUD1HGky3wQp6ix_MTENk6TXAVLCGvNJubKEgFFBaJIom88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPPpT-W2blwYpF0I1atLV3SJj_HbFbuhEkHUvVANb82A&oe=6AEB3354"}, {"file_name": "AirsoftAllstars_Screenshot_10.png", "id": "927375667134155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_927375673800821_1840268041667170271_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHzDf_z97lMQ7kNvwHbhksx&_nc_oc=AdpSMTX7WBZ80QA2edTTveFOCgMYk02oHjc7MAKSK8kY5lCOiAKfUjS03uZwT0lWFXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXF2-W7I8GqJiXi1ENhzkp1B6EFi_AjxyIqmP1K2iUWw&oe=6AEB41EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirsoftAllstars_Screenshot_04.png", "id": "1224602525757971", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307935_1224602529091304_780746822987049476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YfJt_-mxV4Q7kNvwEHXX2R&_nc_oc=Adpw94XFa90KgaDZjoFhdvGorceHPlxhrCSMDaxiQ_5ZR0Z22mR1dxkeSqocKGJHLJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9EMyBAmWPIRFzke5_tpoIAq_8bvj9r48UVWmSDCBqWA&oe=6AEB336D"}, "display_name": "Airsoft Allstars", "keywords": ["airsoft", "paintball", "speedsoft", "tactical", "milsim"], "long_description": "# Airsoft Allstars\n\n**A fast, chaotic, and ridiculously fun love letter to airsoft.**\n\nSprint into cover. Blind-fire around corners. Dump high-caps. Trade hits and yell \"HIT!\" This isn\u2019t your average shooter. It\u2019s pure airsoft energy.\n\nBuilt for VR, it captures what makes airsoft special: tactics, sportsmanship, trash talk, and that duct-tape-and-zip-tie charm players love. Go hardcore milsim or full speedsoft goblin. There\u2019s a mode for everyone.\n\n# Modes\n- Offline PvE with bots\n- Online PvP\n- Co-op survival\n- Zombies and party modes\n\nJump in solo or squad up.\n\n# Customize\n- Weapons, optics, lights, lasers, mags, throwables\n- Gear, outfits, ranks, and unlocks\n\nBuild your dream loadout or a cursed meme kit.\n\n# Locations\nIndoor arenas, outdoor fields, and CQB killhouses inspired by real airsoft spots. Every map plays differently.\n\nBuilt by airsofters, for airsofters. Call hits, clutch rounds, and sling plastic with friends.\n\nGrab your gear. Fill your mags. See you on the field.", "short_description": "A chaotic VR love letter to airsoft. Sprint into cover, lean around corners, and sling plastic in PvP, PvE, co-op, and party modes. Customize your loadout, gear up with friends, and play your way, from tactical milsim to full speedsoft goblin chaos. Built for laughs, clutch plays, and nonstop action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "32692448387065650"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971201318721374"}]}, "baseline_offer": {"id": "971201318721374"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792684800, "status": "PUBLISHED", "id": "971201318721374"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39399840199659735", "version": "0.4.74"}, "id": "1345309890223752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32692448327065656", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39399840199659735"}, "r
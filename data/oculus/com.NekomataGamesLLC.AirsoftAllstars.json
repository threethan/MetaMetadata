&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxOQitmPKToQ7kNvwFEB4Yl&_nc_oc=AdoUyVf4NqSlkLBf2xV2MtLuP0_wax398rImVOmC6S7P_TaLc6GcmJ9jJQ6F0n3GkMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVqsrMN5cqX117BKkP_YWmOJkxf42U-tJdwYFO5dfqVw&oe=6AFB1712"}, {"file_name": "AirsoftAllstars_Screenshot_03.png", "id": "909934085021775", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304106_909934088355108_5643655692698411532_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjakydxZ4eIQ7kNvwH6YJHj&_nc_oc=AdoguiVZNtqcy8bzoyzsdN7xNj5bW_BNjxm9wM01lOfUl7OYX_e6eaeyGVdtOCfZO90&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqnxeq4nd-8W5MauLonNtnzpB4EhUR35FMOA4LYEIj9Q&oe=6AFB3D94"}, {"file_name": "AirsoftAllstars_Screenshot_18.png", "id": "1668769101054614", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618937_1668769104387947_4651689867235773324_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oSL6mFjlYQQ7kNvwFrLNkM&_nc_oc=AdqQqVN1xxwBcr4e3V7vzWPLLk8gzObzzwqLB-sj5L_ZypJVhadIhs6J8WBivl4grnI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrdLQ2G0l_aTmLgyKEXiuQqgbwgPiuD_Pt5WqBFKXEcQ&oe=6AFB3BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirsoftAllstars_Screenshot_04.png", "id": "1224602525757971", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307935_1224602529091304_780746822987049476_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRDylFPMpk8Q7kNvwE10YXt&_nc_oc=Adr4bB59eX6XOzifwghJuCKf2YkiyWhTme-XayHG6GgWinTckQHSz0pcMYvVAR8A3eE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO3lpOA_ritRUKd5G63yPRHWvVvQzRe0vGtD1cCxBsUQ&oe=6AFB3DAD"}, "display_name": "Airsoft Allstars", "keywords": ["airsoft", "paintball", "speedsoft", "tactical", "milsim"], "long_description": "# Airsoft Allstars\n\n**A fast, chaotic, and ridiculously fun love letter to airsoft.**\n\nSprint into cover. Blind-fire around corners. Dump high-caps. Trade hits and yell \"HIT!\" This isn\u2019t your average shooter. It\u2019s pure airsoft energy.\n\nBuilt for VR, it captures what makes airsoft special: tactics, sportsmanship, trash talk, and that duct-tape-and-zip-tie charm players love. Go hardcore milsim or full speedsoft goblin. There\u2019s a mode for everyone.\n\n# Modes\n- Offline PvE with bots\n- Online PvP\n- Co-op survival\n- Zombies and party modes\n\nJump in solo or squad up.\n\n# Customize\n- Weapons, optics, lights, lasers, mags, throwables\n- Gear, outfits, ranks, and unlocks\n\nBuild your dream loadout or a cursed meme kit.\n\n# Locations\nIndoor arenas, outdoor fields, and CQB killhouses inspired by real airsoft spots. Every map plays differently.\n\nBuilt by airsofters, for airsofters. Call hits, clutch rounds, and sling plastic with friends.\n\nGrab your gear. Fill your mags. See you on the field.", "short_description": "A chaotic VR love letter to airsoft. Sprint into cover, lean around corners, and sling plastic in PvP, PvE, co-op, and party modes. Customize your loadout, gear up with friends, and play your way, from tactical milsim to full speedsoft goblin chaos. Built for laughs, clutch plays, and nonstop action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
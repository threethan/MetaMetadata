?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDPZJHEXKNYQ7kNvwHraeJp&_nc_oc=AdqgEMnxJutM6OjruWmLMpkrtAKKVIHYI_V71QwyY8cwFLRwZERWiN99BreTc5c-I9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeGExlSPf4asZl2MlcldRbwE6Rbw3Vau8j4_rBQuUsHw&oe=6AF091B6"}, {"file_name": "AirsoftAllstars_Screenshot_07.png", "id": "1611645756503151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300910_1611645759836484_2521520559478896897_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt6YKBx5Vf8Q7kNvwG8aRaa&_nc_oc=AdoLjlLdswAUP7bAQ7kl1jDrmkDGG4Z5L9LwRrddR5NjhbFkDzzbZz4D2EU5F-jS-1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo9RWI2KolAqecpONE9GQy_WRP7wFqOQvgxRn_je_xrg&oe=6AF0AAE9"}, {"file_name": "AirsoftAllstars_Screenshot_13.png", "id": "894828566814939", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312263_894828573481605_999761461262008166_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kaAlTCM5ngQ7kNvwG216Lq&_nc_oc=AdrjtNJ56FqbJa0zw9xM6Nlll6y7RVDtpAFOo5DSlg3Yy1cfrynaqBWKd0yVOHwD9fw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ75O5GoVR1261J8mo1bK5k8U2ch5XsXtYeL9TS1_A8HQ&oe=6AF08B12"}, {"file_name": "AirsoftAllstars_Screenshot_03.png", "id": "909934085021775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_909934088355108_5643655692698411532_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTqxLm5Cq30Q7kNvwEfBmAo&_nc_oc=Adqh-2nueyEzoLMHhd70lWU4uzyabjGoZrGNCZxexdmxI7J9RATZazgk4mAJve8BjYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-hVoy18hJ27O1MwC8hYKU6hQJDNm-QJfT5Esd8qupEA&oe=6AF0B194"}, {"file_name": "AirsoftAllstars_Screenshot_10.png", "id": "927375667134155", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821178_927375673800821_1840268041667170271_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6llHG6JsaMQ7kNvwGAP8wG&_nc_oc=AdoyjzfUNfpKaX2FWhrG1casq-27KhwTWmp1vZOzFNh3IWCFyDwxrB1O3ZYHJFJrldI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5G88FViqX4drxF3uqTcHeSD2mZKNnrk_ZFctQEDiXWw&oe=6AF087EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirsoftAllstars_Screenshot_04.png", "id": "1224602525757971", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307935_1224602529091304_780746822987049476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xelxBqaVwksQ7kNvwEJkl33&_nc_oc=AdpizZCltnx_x6mPbv0icc5GjeYVR47FcID5oPenppqdwsddMBwSZUtJ4pTg2vtyiC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYwmvYDPVEte8q_QQ-k9hpqxguRf32N_anLZUh_htrnw&oe=6AF0B1AD"}, "display_name": "Airsoft Allstars", "keywords": ["airsoft", "paintball", "speedsoft", "tactical", "milsim"], "long_description": "# Airsoft Allstars\n\n**A fast, chaotic, and ridiculously fun love letter to airsoft.**\n\nSprint into cover. Blind-fire around corners. Dump high-caps. Trade hits and yell \"HIT!\" This isn\u2019t your average shooter. It\u2019s pure airsoft energy.\n\nBuilt for VR, it captures what makes airsoft special: tactics, sportsmanship, trash talk, and that duct-tape-and-zip-tie charm players love. Go hardcore milsim or full speedsoft goblin. There\u2019s a mode for everyone.\n\n# Modes\n- Offline PvE with bots\n- Online PvP\n- Co-op survival\n- Zombies and party modes\n\nJump in solo or squad up.\n\n# Customize\n- Weapons, optics, lights, lasers, mags, throwables\n- Gear, outfits, ranks, and unlocks\n\nBuild your dream loadout or a cursed meme kit.\n\n# Locations\nIndoor arenas, outdoor fields, and CQB killhouses inspired by real airsoft spots. Every map plays differently.\n\nBuilt by airsofters, for airsofters. Call hits, clutch rounds, and sling plastic with friends.\n\nGrab your gear. Fill your mags. See you on the field.", "short_description": "A chaotic VR love letter to airsoft. Sprint into cover, lean around corners, and sling plastic in PvP, PvE, co-op, and party modes. Customize your loadout, gear up with friends, and play your way, from tactical milsim to full speedsoft goblin chaos. Built for laughs, clutch plays, and nonstop action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "32692448387065650"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971201318721374"}]}, "baseline_offer": {"id": "971201318721374"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792684800, "status": "PUBLISHED", "id": "971201318721374"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39471573319153089", "version": "0.4.78"}, "id": "1345309890223752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32692448327065656", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39471573319153089"}, "r
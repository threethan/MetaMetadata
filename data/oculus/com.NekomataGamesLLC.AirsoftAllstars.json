&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNGuCv41KrYQ7kNvwEVGB3J&_nc_oc=AdrfTVHNVKWf4P5qEb6e7DWpRbBXdXAdnB_8D5LOUsOnNeIRhYxhBLkEIJMlBIiq-8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDibIKxjdwARnC66DWGhrpAo0ZbFliAXaoSKZUdgBQGQ&oe=6B05A312"}, {"file_name": "AirsoftAllstars_Screenshot_03.png", "id": "909934085021775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_909934088355108_5643655692698411532_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Un7voKr1DcQ7kNvwEwshq0&_nc_oc=AdqqcjQ12aVueIexAyRDyJ1VTncFOTDXsAncvSNlA1sGXTTWcGu7tPuAS6l1walf1Z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdfJgjoSJzWRVhk4POtfY74gHq5TCEFZyKq6B46bqJ0g&oe=6B05C994"}, {"file_name": "AirsoftAllstars_Screenshot_18.png", "id": "1668769101054614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618937_1668769104387947_4651689867235773324_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNlfe6SPmG4Q7kNvwEXDf1e&_nc_oc=Adr5hi8PRetw6JSpMRrW1SF6ebzNg5J6DLJ_FQYG8FBRv_j4xcKATHFz0YexZsJkYQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr3lDVW-5LKP3rBs0_62HwN35DYNbzFUOFv1l_N8y79A&oe=6B05C7DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirsoftAllstars_Screenshot_04.png", "id": "1224602525757971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307935_1224602529091304_780746822987049476_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CN4ZsUC5bjQQ7kNvwFsE-EO&_nc_oc=Adr1DFKVM2KCP1F9ByycbjCiUSYONwO0btkwa8Myz19HMKZEn1k0FgCpRKxBPuTYt6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP76Acww1EeYF57qZqfZNoiIfmG0wVQtTIH9xA14ASLg&oe=6B05C9AD"}, "display_name": "Airsoft Allstars", "keywords": ["airsoft", "paintball", "speedsoft", "tactical", "milsim"], "long_description": "# Airsoft Allstars\n\n**A fast, chaotic, and ridiculously fun love letter to airsoft.**\n\nSprint into cover. Blind-fire around corners. Dump high-caps. Trade hits and yell \"HIT!\" This isn\u2019t your average shooter. It\u2019s pure airsoft energy.\n\nBuilt for VR, it captures what makes airsoft special: tactics, sportsmanship, trash talk, and that duct-tape-and-zip-tie charm players love. Go hardcore milsim or full speedsoft goblin. There\u2019s a mode for everyone.\n\n# Modes\n- Offline PvE with bots\n- Online PvP\n- Co-op survival\n- Zombies and party modes\n\nJump in solo or squad up.\n\n# Customize\n- Weapons, optics, lights, lasers, mags, throwables\n- Gear, outfits, ranks, and unlocks\n\nBuild your dream loadout or a cursed meme kit.\n\n# Locations\nIndoor arenas, outdoor fields, and CQB killhouses inspired by real airsoft spots. Every map plays differently.\n\nBuilt by airsofters, for airsofters. Call hits, clutch rounds, and sling plastic with friends.\n\nGrab your gear. Fill your mags. See you on the field.", "short_description": "A chaotic VR love letter to airsoft. Sprint into cover, lean around corners, and sling plastic in PvP, PvE, co-op, and party modes. Customize your loadout, gear up with friends, and play your way, from tactical milsim to full speedsoft goblin chaos. Built for laughs, clutch plays, and nonstop action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
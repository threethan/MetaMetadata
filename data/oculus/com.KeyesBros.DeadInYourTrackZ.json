tent-ord5-3.oculuscdn.com/v/t64.5771-25/491825050_1742178256421376_318710753309974607_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyE_xwY4y6oQ7kNvwHkCZin&_nc_oc=AdoK2m5qDaTRv2_ZXhsCDsW_wpyJmQ6CLQYN94QCCi31d4Wi-p7fF8M2xsk_xmfhxMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyADmuzq14e1ZmvGHuZzgihFDpgsF9R1ciJyzW4lZ4vg&oe=6A4A5CD0"}, {"file_name": "sc01.png", "id": "1127352072790310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822924_1127352079456976_621256237363422015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3WTDrgiTjIQ7kNvwFam87u&_nc_oc=Adou5z63FJlrLZx44stRh9TDfvBrHmn_SDjsSAWnDPH0SYYBAYkRKzjciCOYjKpFt8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA49K2KjSG_Exjy3tpngWdwD98KxgyMU0G9rf9TyksSOA&oe=6A4A610A"}, {"file_name": "sc04.png", "id": "1404713810585296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821799_1404713813918629_1825752181667161143_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm4CcXmlx20Q7kNvwGLWMLw&_nc_oc=AdroJ9nfmAFLh46yP5LzOACEhTQiRpIEyI6Ci_r9fM9RCB4Vd-EUwfwjOTKG8-ZifZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVyEXpFxoFbepOUqhKUIxgTzcVOdUdjQzmlDbXd9ahrA&oe=6A4A6B03"}, {"file_name": "sc02.png", "id": "1499111397780845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828843_1499111401114178_162162570016944973_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp1VDxZods4Q7kNvwGnKA8f&_nc_oc=Adpkf4SfcZrX1Ot42gW0syafp_8aRwmYLp6c3ly0QO4j4WUaoN4sDUQnuRoyKeI-4cw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhMg6trQbE4sP3DyXvtbOc5ZfQ8-n1K2TFDsW217oVDw&oe=6A4A774F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead In Your TrackZ", "keywords": ["dead", "rails", "tracks", "zombies", "train"], "long_description": "\n**Dead In Your TrackZ** is a VR Zombie Shooter created by 3 brothers! Defend your train from hordes of zombies until your train has refueled. It features **multiple zombie types, weapon and train upgrades**, and different **levels and environments**.\n\n# Gameplay:\n\nBuilt with accessibility and comfort in mind, in **Dead In Your TrackZ**, the train remains stationary while you fuel up and fight against the zombies. Once your train is fully fueled up, pull the horn and defend against the final horde before your train boosts out of there!\n\nThe game contains a variety of **weapons, upgrades**, and **environments**. Tired of the basic pistol? Use the **double barrel shotgun** instead to kill multiple zombies in one shot. Or, upgrade your pistol with a **laser sight, compensator, and extended mags** to make zombie killing easier. If you're tired of manually shooting zombies, the train can be upgraded with an **auto-turret!**\n\n# Upgrades:\n\nCompleting levels and killing zombies will earn you score. You can use this score to purchase a variety of **upgrades** for your **train and your weapons** which will give you a range of advantages and benefits.\n", "short_description": "Dead In Your TrackZ is a VR Zombie Shooter where you defend your train from hordes of zombies while you fuel up. Shoot up zombies, get cool upgrades, and above all, survive. Coming soon!"}]}, "developer_name": "Keyes Bros. Inc.", "developer_privacy_policy_url": "https://gist.github.com/KeyesBros/f7bc652d33fc516cc8e6b2bd8182bbf7", "developer_terms_of_service_url": null, "publisher_name": "Keyes Bros. Inc", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UC-KT-rF-WqCmgj42LUOKAyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
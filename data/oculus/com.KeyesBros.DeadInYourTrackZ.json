tent-fra5-2.oculuscdn.com/v/t64.5771-25/491825050_1742178256421376_318710753309974607_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnv_hlAlEroQ7kNvwHGLuK7&_nc_oc=AdocDZgnKeOZgKJJ5l-Gi8igKvDACI6CWF8SGjHtaWe3INKNzMmqUcCEonc6sRNMm1M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTxtKM_CwG56kfNcuCjqefvlYvPWKCiEzFe7WLymdBoA&oe=6A563A50"}, {"file_name": "sc01.png", "id": "1127352072790310", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822924_1127352079456976_621256237363422015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7miC94I_5agQ7kNvwFkjMw-&_nc_oc=Adqzn9w5apKHDyfWPMISFdF7wIy3cWWULiFw3F0m2O8oveIMYXn_IylImwhtLMH6uNk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnlafz6CFnHfTyJyrKzYMa6QhHByFf5PZocSBNHQVdpA&oe=6A563E8A"}, {"file_name": "sc04.png", "id": "1404713810585296", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821799_1404713813918629_1825752181667161143_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B02NWOTYaWQQ7kNvwH2ynkJ&_nc_oc=AdqxnaAVWVzXi5ZyS5J7DCkcr2uBTD_y7qvWwtgUpN1FkwkRnQl2FjPuchwGflj6w4o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUc-j6eDcdBonq9yuwk31QY5d_KgI2SIM6JIMM5nU2qQ&oe=6A564883"}, {"file_name": "sc02.png", "id": "1499111397780845", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491828843_1499111401114178_162162570016944973_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDmmrs-6DS0Q7kNvwFH9iuT&_nc_oc=AdoOWwVLrCvqvjcFzfW0GS61eeUGkj_BHU4gdpRC2eGBVg2uTasl86gWjeAlsGLWmX4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrY8PIhRJ6GtHWfYVDGS4IKZpHKpJlReezI8dF8q5_3Q&oe=6A5654CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead In Your TrackZ", "keywords": ["dead", "rails", "tracks", "zombies", "train"], "long_description": "\n**Dead In Your TrackZ** is a VR Zombie Shooter created by 3 brothers! Defend your train from hordes of zombies until your train has refueled. It features **multiple zombie types, weapon and train upgrades**, and different **levels and environments**.\n\n# Gameplay:\n\nBuilt with accessibility and comfort in mind, in **Dead In Your TrackZ**, the train remains stationary while you fuel up and fight against the zombies. Once your train is fully fueled up, pull the horn and defend against the final horde before your train boosts out of there!\n\nThe game contains a variety of **weapons, upgrades**, and **environments**. Tired of the basic pistol? Use the **double barrel shotgun** instead to kill multiple zombies in one shot. Or, upgrade your pistol with a **laser sight, compensator, and extended mags** to make zombie killing easier. If you're tired of manually shooting zombies, the train can be upgraded with an **auto-turret!**\n\n# Upgrades:\n\nCompleting levels and killing zombies will earn you score. You can use this score to purchase a variety of **upgrades** for your **train and your weapons** which will give you a range of advantages and benefits.\n", "short_description": "Dead In Your TrackZ is a VR Zombie Shooter where you defend your train from hordes of zombies while you fuel up. Shoot up zombies, get cool upgrades, and above all, survive. Coming soon!"}]}, "developer_name": "Keyes Bros. Inc.", "developer_privacy_policy_url": "https://gist.github.com/KeyesBros/f7bc652d33fc516cc8e6b2bd8182bbf7", "developer_terms_of_service_url": null, "publisher_name": "Keyes Bros. Inc", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UC-KT-rF-WqCmgj42LUOKAyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
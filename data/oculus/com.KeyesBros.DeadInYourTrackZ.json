tent-ord5-3.oculuscdn.com/v/t64.5771-25/491825050_1742178256421376_318710753309974607_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huG39P_UEokQ7kNvwFMIzxL&_nc_oc=AdpxmxzkTKk2piF0qetG4Hv0Ivosc6LcO_lmJdPrX50Ui1tN7KVvmY-wt1kIvyf5YmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QldKiUDxcAxaJYtkfO_R3Ghp_jED-d4CxYEKxzrKwzQ&oe=6A1D89D0"}, {"file_name": "sc01.png", "id": "1127352072790310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822924_1127352079456976_621256237363422015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX9Kj09FxU0Q7kNvwF-xJYA&_nc_oc=AdraCCjVp4VtbgAaCsm0NLao17eXaSjWvQ_H39_ER0awXo5nhIcOA74W3XHTlbDUUfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5veu2Po5gaeAXXwKJ-XTtL3cCXrWQluSEOOWIFcpPeXg&oe=6A1D8E0A"}, {"file_name": "sc04.png", "id": "1404713810585296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821799_1404713813918629_1825752181667161143_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrT_5U-2nI4Q7kNvwGHRWRV&_nc_oc=Adqjzh-KbIv961VwPx-E1tBCPGRLztV5bpDhBbstucXVpzHRhrGfSAjYkBTOmO_qW7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74xvKMGY7-bzRhmi-kXvEYXZ9wUu-EFakhdTnUN75hiw&oe=6A1D9803"}, {"file_name": "sc02.png", "id": "1499111397780845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828843_1499111401114178_162162570016944973_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNbGX1x-1HgQ7kNvwEszSYh&_nc_oc=Adq_CTrv3ufXWr9TF_wKavfpML1xjaZn-2zMHJXQxlfmxDghLCbeox_Hc7ItUD0IYjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GO0jgJ5i_n6eJgPaToKStM5gBRns6WrJ0NpXE3oJJQA&oe=6A1DA44F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead In Your TrackZ", "keywords": ["dead", "rails", "tracks", "zombies", "train"], "long_description": "\n**Dead In Your TrackZ** is a VR Zombie Shooter created by 3 brothers! Defend your train from hordes of zombies until your train has refueled. It features **multiple zombie types, weapon and train upgrades**, and different **levels and environments**.\n\n# Gameplay:\n\nBuilt with accessibility and comfort in mind, in **Dead In Your TrackZ**, the train remains stationary while you fuel up and fight against the zombies. Once your train is fully fueled up, pull the horn and defend against the final horde before your train boosts out of there!\n\nThe game contains a variety of **weapons, upgrades**, and **environments**. Tired of the basic pistol? Use the **double barrel shotgun** instead to kill multiple zombies in one shot. Or, upgrade your pistol with a **laser sight, compensator, and extended mags** to make zombie killing easier. If you're tired of manually shooting zombies, the train can be upgraded with an **auto-turret!**\n\n# Upgrades:\n\nCompleting levels and killing zombies will earn you score. You can use this score to purchase a variety of **upgrades** for your **train and your weapons** which will give you a range of advantages and benefits.\n", "short_description": "Dead In Your TrackZ is a VR Zombie Shooter where you defend your train from hordes of zombies while you fuel up. Shoot up zombies, get cool upgrades, and above all, survive. Coming soon!"}]}, "developer_name": "Keyes Bros. Inc.", "developer_privacy_policy_url": "https://gist.github.com/KeyesBros/f7bc652d33fc516cc8e6b2bd8182bbf7", "developer_terms_of_service_url": null, "publisher_name": "Keyes Bros. Inc", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UC-KT-rF-WqCmgj42LUOKAyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
1-7&_nc_sid=6e7a0a&_nc_ohc=TxTNvfvurvgQ7kNvwFyfK8Q&_nc_oc=AdoceiEZXQsENSWrPtN_6oK9R6wd-Ea6Is_MiBrsTEF-Uup2PGFP955s2Cno_rHYs0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SSZcRtYbAKpQRqMZStmplOcrbR6pB31Je9x2kaHbMBQ&oe=6A15AD5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wind Tag", "keywords": ["tag", "tagging", "taggering", "Tags", "Taggers"], "long_description": "Wind Tag\n\nWelcome to Wind Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\n\nIn Wind Tag, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure tag. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Wind Tag offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the tag chase begin!", "short_description": "Wind Tag\n\nStep into Wind Tag, a heart-pounding tag game where your hands are your only way to move! Glide, climb, and race using the Gorilla Movement System through serene landscapes. Master your movement, outsmart opponents, and find your inner balance in a game that\u2019s both physically and mentally engaging. Agility, fun, and surprises await\u2014let the tag chase begin!"}]}, "developer_name": "Spooki", "developer_privacy_policy_url": "https://docs.google.com/document/d/1JeM-Y2rdc53cQfL4-MpBBJA5pEXFLAZppboBOd9zqYo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Spooki", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1IdxeOcwcZ4d5zIJBgCk2dMwPFbFBUEOhNp8O1wW1-Cs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26409457438709757"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26429826063339561", "version": "7"}, "id": "947127761341776", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26321610510827784", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26429826063339561"}, "release_status": "RELEASED"},
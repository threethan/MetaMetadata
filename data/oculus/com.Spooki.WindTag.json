scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830467_1220871013165237_1015874620886789242_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6Pr753KKbYQ7kNvwHO6wcJ&_nc_oc=AdruPMBwDCMjeD6YuQ84LAl9xa20UGwXyvE96RsSlplFiwIJ1oBIwCKX-kJDoUUF7Yw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n4lHCAeyosqm6l4AUdOal3uXMSfcwDAOsKeRRXpIZQQ&oe=6A15AD30"}, {"file_name": "gorillalife4_resized.png", "id": "949281771121191", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_949281777787857_3143820523621020980_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G61M52PsFk0Q7kNvwEFTPBE&_nc_oc=AdpYyJKp-N97-BhLlkFtPWR2bCEzSM2MyH5UKbXUzEFtp2xcgN4bEQGm7wIkXKXkrtk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6voXi7Vzi6TOFqu12jckdzhOUyNzUTYCSGPswvF-JSIg&oe=6A15A4AC"}, {"file_name": "gorillalife5_resized.png", "id": "957980253342910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_957980256676243_1438366915087939279_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxTNvfvurvgQ7kNvwFyfK8Q&_nc_oc=AdoceiEZXQsENSWrPtN_6oK9R6wd-Ea6Is_MiBrsTEF-Uup2PGFP955s2Cno_rHYs0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SSZcRtYbAKpQRqMZStmplOcrbR6pB31Je9x2kaHbMBQ&oe=6A15AD5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wind Tag", "keywords": ["tag", "tagging", "taggering", "Tags", "Taggers"], "long_description": "Wind Tag\n\nWelcome to Wind Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\n\nIn Wind Tag, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure tag. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Wind Tag offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the tag chase begin!", "short_description": "Wind Tag\n\nStep into Wind Tag, a heart-pounding tag game where your hands are your only way to move! Glide, climb, and race using the Gorilla Movement System through serene landscapes. Master your movement, outsmart opponents, and find your inner balance in a game that\u2019s both physically and mentally engaging. Agility, fun, and surprises await\u2014let the tag chase begin!"}]}, "developer_name": "Spooki", "developer_privacy_policy_url": "https://docs.google.com/document/d/1JeM-Y2rdc53cQfL4-MpBBJA5pEXFLAZppboBOd9zqYo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Spooki", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1IdxeOcwcZ4d5zIJBgCk2dMwPFbFBUEOhNp8O1wW1-Cs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT",
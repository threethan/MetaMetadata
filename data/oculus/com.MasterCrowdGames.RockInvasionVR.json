xHUtPJIFC1y8ZPB8LOe1bSJJRKjChkOhI2BB8FXYZQ&oe=69FC91AA"}, {"file_name": "RI_ScreenShotNew_04.png", "id": "1559835398766840", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1559835402100173_1529923885849027953_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRV0gJgQ6hEQ7kNvwG5eW7r&_nc_oc=Adop-PsxqCIWSY27OOWyduV6_LmRvxEyTnp4-vrf_6PEl_Wz7FxEg6rGKneqeNiOvlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69j-k9utgkndAxnfKuVBTvJFdbGtga-tBF-VefmOlrqw&oe=69FC8889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RI_CoverLandscape.png", "id": "3193180414166968", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_3193180417500301_6701910600254614242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRp3ru8eFW8Q7kNvwGAerm7&_nc_oc=AdqQ78FCjtgjYUW5dN2dBFF-8EotejCXj0LarlHlP-TMlsHPOSpndhwC0C4inRP3Yuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oTP1iPBvFcImYTVdvRhI0fq8pzKX5ye3KWWRjXJtvpw&oe=69FCA8A9"}, "display_name": "ROCK INVASION", "keywords": ["Rock", "Aliens", "Rhythm", "Guitar", "Music"], "long_description": "Get ready for the event of the century! The aliens have arrived and are trying to invade the planet, but here in ROCK INVASION VR: the show must go on, no matter what. Immerse yourself in the most incredible concert of the decade, where you'll be the legendary guitarist defending the stage at guitar-point. With vibrant graphics, explosive gameplay and an irreverent touch, you'll face an invasion of UFOs while proving that at this concert, you call the shots. Release control, hit everything that comes your way and let the power of rock flood every second!\n\nROCK INVASION VR is a virtual reality rhythm game exclusive to Oculus Quest 2 and Quest 3. It combines the thrill of playing rock songs in rhythm game style with the adrenaline rush of arcade action. During the most epic concert, a guitarist must keep the audience energized while defending the stage from an alien invasion. With intuitive controls adapted to VR, graphics with cartoonish touches and a spectacular musical selection.", "short_description": "Aliens are invading the planet! But the show must go on. Play the most incredible concert of the decade while facing an invasion of UFOs. Hit every note and hit everything that comes your way. \n\nExperience an epic rock concert in VR while defending the stage from an alien invasion - become the guitarist who saves the show by shooting laser beams at the flying saucers!"}]}, "developer_name": "Master Crowd Games", "developer_privacy_policy_url": "https://mastercrowdgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Master Crowd Games", "support_website_url": null, "website_url": "https://mastercrowdgames.com/rock-invasion-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25162507083401320"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1622978878839593"}, {"status": "PUBLISHED", "id": "1198177052297351"}, {"status": "PUBLISHED", "id": "755945654214421"}, {"status": "PUBLISHED", "id": "853400234280951"}, {"status": "CANCELLED", "id": "853580720409151"}, {"status": "CANCELLED", "id": "1157694246081503"}, {"status": "PUBLISHED", "id": "1150696353799496"}]}, "bas
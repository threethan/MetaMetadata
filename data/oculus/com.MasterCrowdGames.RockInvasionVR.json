4051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1919726716087384_4838753260061943595_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uYPgEz6JIcQ7kNvwGmOM_g&_nc_oc=AdoQ6AUh04PCCsHasSxWKcgsC5WVI8GUYLb-y31kBJa7R2InAYr0mN7TBHrah6b09jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GFvmriVhyG-u3XNuD7uvvjo4GVKaMXKUctWx5SZ3cGw&oe=69FC83C1"}, {"file_name": "RI_ScreenShotMix2_17.png", "id": "2427531484327871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_2427531487661204_1187992084540283473_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZDPbQ2FCScQ7kNvwGhOfLH&_nc_oc=AdpgN_LrhYhPxXqIYJ2xNCGDf-KaHAMwL6pU8nDcqmfHseJBIfPqhdeCsmRshCOhNgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NYqmWaNspIovDs0dp1sfV9uRyQcQ5GaRacGnRPTAWkg&oe=69FC919D"}, {"file_name": "RI_ScreenShotMix2_01.png", "id": "747448218131138", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_747448221464471_3629395663061115715_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35cXxrnr__AQ7kNvwH8VnBo&_nc_oc=Adqi9Hi62cL-rj8uagctfI-98tOSDj0LOQ-TqEkCMosRCXPY5iFSKGbKQD5Gl1G684s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rD6SDbhKWXmo7h-uiph_IwpEWOC3HyqUHSXQcJgf0zA&oe=69FC966D"}, {"file_name": "RI_ScreenShotNew_02.png", "id": "1712727026557485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_1712727029890818_3394329402378610238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOsDW9cvIvUQ7kNvwEoxVu7&_nc_oc=Adp5qTVDbwJ-fBfSv7_eUSdqdsc2bGcKzIlmXWs5e-W4aC7XrUPyaY342xtXQtJaXAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bedlXb-O5FIW4aJo9KmXw1PQ5AxBM_o7af5zHGehwsA&oe=69FCAC18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RI_CoverLandscape_MIX2.png", "id": "1207034011607466", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1207034018274132_6206178546099159867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lFkHGXoilUQ7kNvwEq5dN2&_nc_oc=AdoV8hrZMKxcZ29tuMrhwjZMAWuiZPeDtgyHSh5LF4uw7K5DdYmVHMbkxyzb7ZewxDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UmtPiw-NLCAAdeHnw34JDsgozq1ysEXDTtHXek0Gtiw&oe=69FC95C5"}, "display_name": "ROCK INVASION", "keywords": ["Guitar", "Music", "Alien", "Rock", "Stage"], "long_description": "**Get ready to rock and repel an alien invasion at the same time.**  \nIn **Rock Invasion VR** you step on stage as the lead guitarist in a loud rock concert while classic flying saucers attack the city. Keep playing, keep the crowd alive and turn your guitar into a laser cannon to blast UFOs out of the sky before they ruin the show.\n\n{1262390035818749}\n\n**Rock Invasion VR is a virtual reality rock music rhythm game exclusive to Meta Quest 2 and Meta Quest 3.**  \nFollow note highways in time with the music, strum in rhythm to play guitar parts and trigger special laser notes to fire at invading aliens while you defend the stage and chase higher scores. The better you play, the more intense the concert and the invasion become.\n\n{2176452893154173}\n\n### Key features\n\n- Rock VR rhythm gameplay focused on guitar.\n- Original indie rock soundtrack featuring multiple bands and songs.\n- Arcade-style alien shooting using your laser guitar.\n- Difficulty levels that scale from easy to challenging.\n- Intuitive motion controls with support for left- and right-handed play.\n- Stylized graphics with a fun, cartoonish sci-fi look and a live crowd reacting to your performance.\n- Fully standalone, no extra accessories required on Meta Quest 2 & 3.\n\n\n\n{1436577828011967}\n\nGuitar Mix Vol. 2 Update\n\nThis update introduces Guitar Mix Vol. 2, adding five new rock tracks to blast aliens with while you play.\nAlongside the new songs, we\u2019ve made visual improvements (enhanced graphics and VFX) and performance optimizations to make Rock Invasion VR feel smoother.\n\n{1475938397381003}", "short_description": "Play Rock Invasion VR, a guitar focused rock VR rhythm music game that mixes rock concert fantasy with alien-blasting arcade action against an extraterrestrial invasion, on Meta Quest 2 & 3. Hit colored notes, strum in time, fire laser beams from your guitar to destroy UFOs, protect the stage, master multiple difficulty levels, compete for high scores and enjoy an original indie rock soundtrack with no extra peripherals."}]}, "developer_name": "Master Crowd Games", "developer_privacy_policy_url": "https://mastercrowdgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Master Crowd Games", "support_website_url": null, "website_url": "https://mastercrowdgames.com/rock-invasion-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25929252696726751"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1274551671236924_5338618096382529797_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZRULq6lqc0Q7kNvwEFo2sr&_nc_oc=AdqloBzZ6nMtAy8NK0cPOsDi5xANNMRUlHXR2N9jSXfEJ7NrVpEGiuaoJAsxLVj8y6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RAbHNndNM1pr9pdHPYyErXP4rl26ybtaUR2ST244s6g&oe=69FCACFF"}, "is_concept": false, "is_test": false, "is_trial_offer_va
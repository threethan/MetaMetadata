-ams2-1.oculuscdn.com/v/t64.5771-25/65402154_1224808084723054_564240767897631724_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfYvV3VRg2IQ7kNvwFQ1eqR&_nc_oc=AdlmPwjMbW-VaCkIlUdTN0WQ5KMIyl6S2RwgMJgAmbg0NUZeSRtXQrRGKWltfur2ftI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsvwjowi2KFVSNFfhiar_76qqBdEfrxJumCxEy6VW7qqg&oe=699ED272"}, {"file_name": "zzzzz - Copy.png", "id": "2727865564269859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdVgmGPFCakQ7kNvwHnr_9z&_nc_oc=Adnsr572eWWm4EImSB6R6gkwUuI7JVpduhhScJzPPDyQT_wxJURFHypX_q6q9axYxs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs_Mf5uqf_mSLolJp0ZSmTYdd_DPO0drlyx0S-QFA_4Fg&oe=699F0771"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9LKUNzIEDsQ7kNvwEUU9H-&_nc_oc=AdmD5zYRDS4a7mdK23lRudaW3wb_n5Qts0EaNzzk6piqqUJld447HtAZdBUXw6V_Roc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftMNKhvQ2JglDh8y58etnfqW6wf-iOYWSjJsZsfpz1Zcw&oe=699EE8FF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M5ILAaMdh4Q7kNvwE6CJOM&_nc_oc=Adl7nFJNoAM5JXejStzX9mBjkDlUibgrv1ShCm6FAnqxgLguBlQSFNLTo7JFhg6ibGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfscM-nPNBCKvO3N1Dtko9P8AGc4CVlc07_voIQo3K7hgw&oe=699EE1DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rp8_4imzD4Q7kNvwG-NuTu&_nc_oc=Admw0ALMwsY0hMkmtIH8SkobkolGvtKr-PHUsxBxKAtza_aOYGA2KnmcsqH8rCPFXag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQclVgM6POtyjW9FXKijv0S9vxNAHO1plgtoLw-TKrlA&oe=699EE9D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSaLxzcC3TkQ7kNvwHw6SZ2&_nc_oc=AdndNxI0UlKXEIUSXxPkXJgsipWUTCpZgwJY6Y8mjm2ONT25H4UptAKfsnPrYcqk1zE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuZ19bTZGTjWbIbiKZz97CMrhlNUHy5e-eaxN_tqJZ6xQ&oe=699EE4A1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more.\n\nMajor Feb. '25 Update: 360 beach video areas"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "DINOSAURS", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7369374796519984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974703_415875600447010_8202666949375033340_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QviPD124PEQ7kNvwFHRxTg&_nc_oc=AdllgGzW2O7GAsz2w-rudY4dL81FtRqBI4YowzcrtSHLycWgpds58b3x5eAWX4itUxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9fD4LrgIWAvjxk0E-hkyx0t3r9EabMlk4ppPmI4zeCg&oe=699EF651"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ZOSU Zoo", "platform": "ANDROID_6DOF", "context_cate
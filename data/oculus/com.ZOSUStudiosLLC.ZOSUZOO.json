Copy.png", "id": "2727865564269859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihwVjXUy7ToQ7kNvwEuEF3H&_nc_oc=AdrY9q92_7GPblrui66wqiLjqx5g90JnO8u-YRHOHX_4IhpkmJ8GyfgYdb5L5G8Ofso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46h4at5gIiqKsShpQbUmTeokNvEUf33fJ25qdbepTo5g&oe=6A0F16F1"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV3i3iG9HYwQ7kNvwHC-CKj&_nc_oc=Adp9dpxPZe3tJpHYzpDmi_o5ATLavG5e9PocSlTwzGWvQJFTDjd6P5tB6BHCYG4GXdc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HajhUqDkO0NSKOni1K7XPx6ib7VnYh5dujsCfo4Kh6w&oe=6A0EF87F"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjxVv0mZ4hUQ7kNvwGZM-ZG&_nc_oc=AdptVrgzA_2VXJMW2DBCXAz_n-wLfvd4aWec3uYNSArs7yAycpM9_1wlRNxqFggSVqg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QB6RwmRRPURQH8l6ICCVrjTuKpC832x_UiCyikKbXhA&oe=6A0F299A"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBc3DTISQN0Q7kNvwFT6WUt&_nc_oc=AdrexP9RN8kyvSf6U8MgeS79TF3yblOYBhIru2yhI0BATOIcfFvXRLjpa7uKRPivmCw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VJs_FXBzVoNRhUTCNdCzK08POiASQR_9riIKYwr3xyw&oe=6A0EF959"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGyrHVr-NAYQ7kNvwFmKlwv&_nc_oc=AdpNzI8kr04ASV3PdE3kViDWDZNwuwAli3bZ9A6bSjWsB45mJQa5O_-E2HAJa5e2UvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lhXvBGWQjyLIXgsvdS8wzDU5V3MdgNS2OoTxc7k835g&oe=6A0F2C61"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
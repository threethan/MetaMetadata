Copy.png", "id": "2727865564269859", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7sShgYUIoYQ7kNvwF8eeYB&_nc_oc=Adp648rD-kLTZYzbhBOA6R8tbkVYFmfvZEwVNt2OFIItmJuJqoPFuow8qLDuI92ny3U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvNan2dI0rbDzjALH31GpntppQEP6mwyo4QaRSS9mr_w&oe=6A819131"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMbJgYlbJVoQ7kNvwFbHNHT&_nc_oc=Adr9r0Mo6F81A8Cev8cdT65jnw4QDzhO_VHzk82aWPo63JdFNZV0zqpYy34kOZJjcI0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUx8GYEIfvr9DHHlY-t8oiq56Pspr3PUtLGOT2T_Dvqw&oe=6A81AAFF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bd8xKxI9_8Q7kNvwGqhAbQ&_nc_oc=Ado4N0n7LFEy77ua1-gc_dQbGFHwZQK89nctEdQNn1DSN9-NtR_7bnXIX9orPfXQAvI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaHKeQZibo2GJRItN7ndJaVTMXTdE5CIRXL86AI-93uQ&oe=6A81A3DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBZXsORZbIYQ7kNvwEhJd3F&_nc_oc=AdoNxXBAjD9X3eE1znr7YvcarQb1Iqj0OmIa8wSVwk3BNKfZd3on2igjd71mAny217s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhasez73dnKMfMIlzh-xQv_GJiY4PwuHPW15XHq5aGbw&oe=6A81ABD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQI_ylBMG2wQ7kNvwF3IOOJ&_nc_oc=AdryGLtHc_d422cMPyME2MxnjXeJepLjnmvd9T8i1X2O7KKdpeWhaZL9zIPvRX_Dbls&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUVK3tZRE5XpA9SZiqA8Q8wcRTDijnzuPARWEHAh-Kcw&oe=6A81A6A1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
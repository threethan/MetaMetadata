-ord5-1.oculuscdn.com/v/t64.5771-25/65402154_1224808084723054_564240767897631724_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24G5YKurJSEQ7kNvwGlM6e8&_nc_oc=AdnPjrwrLLzIX0yCv49XPlJwxeCT3iqvqnAlsU3Kqu2FFN_0HWGq4fqJmUlU9XNOAzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuKgpwPi3_7ckd2YJiRMwbU_MFB76vsywCLKeMLaTXdkA&oe=69A41872"}, {"file_name": "zzzzz - Copy.png", "id": "2727865564269859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD2Ah9vGhjUQ7kNvwHQxS2N&_nc_oc=AdlU7Vp2m6MauRpFhFDfpdiPX16nwjZskqvR-m_RCkWgJFeBpTxnxcWMSYkiTfAso4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulSXuck7LAOiawdfqXLY97HjD7E31sYculkfkEI3dR4w&oe=69A44D71"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48kYd64CuAsQ7kNvwHvnl_9&_nc_oc=AdmQ2Sl14ERjQV1571n7faaO7MgGlExIYYYCOVqG3eJGiVa4Q-o5C6QPtUiz6KjW95Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHek11rXTGnHnd14YTWSsVNhoXarV_10_WkgVZXbatdw&oe=69A42EFF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJEMwsWfrOsQ7kNvwHG0Oum&_nc_oc=AdmjKxDK3Wa-RqEwsPbY1XtGtjVJmB1VQlDvNHIiSq2stZmtGSuEbmwFXOlVCYrsCuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvJf0sNo75orC0U6M_We_Cx_RESG4PGxhwHfAlcR8hk2Q&oe=69A427DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=milVk-MjhBoQ7kNvwGjzzP4&_nc_oc=AdmelzqL2nF9KHadgU0hWDnKQBbdsayRX9pkwS5O2sxr7EC3DKxTFGorIoLSbNLN78M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsF0pl4rF4Dbfv-K9aKRcE0hAx94MnLAHyhBZ1-rLqzuw&oe=69A42FD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NMf3ox2gQ8Q7kNvwE9ZX-F&_nc_oc=Adl071wiZxDtgrXrgXzH-8Rhm3WWYoVr6SSH0zgL0DQaviunfgER17zCwfSmJt7dv3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft82FMfnR4yME1tv_1Q1OVpd-49_4gpNrjbGLD5LQouXg&oe=69A42AA1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more.\n\nMajor Feb. '25 Update: 360 beach video areas"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "DINOSAURS", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7369374796519984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974703_415875600447010_8202666949375033340_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWTb4M0ULR8Q7kNvwG8Nr9G&_nc_oc=AdkdRUw3crELoEljFzeTryZc68l2Kpf2xGpLRWqOCBgbA_VgHOVwMegyZ2joKHn76Lo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQquJVT-X7fWsOzvExA13I095Pzh1q2OdDqnvmO2Zg3A&oe=69A43C51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ZOSU Zoo", "platform": "ANDROID_6DOF", "context_cate
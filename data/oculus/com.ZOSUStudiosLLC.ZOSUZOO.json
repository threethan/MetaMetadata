9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfKQpTZQTz0Q7kNvwEcHKpH&_nc_oc=AdqIJhzaPE80KtnMrZPYIntJdMGWcjzdNKTp1p8i4gHf4USzTVEbXhR9eKVQz8aKDrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKwSSPzNleqzfEP5Eqni4EY3j1uFyIY0GzRdinyQJ8Aw&oe=6ABA65FF"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEKmhsfLU7IQ7kNvwFQ9ySx&_nc_oc=AdoNknof1emkHQwJkGTUrCGySfSy3Rk6wDiS13h_3Neo5gWOT-LukkuoCV076UkjUaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8ROkjJlTb_rvq-ddotlEE274veABXQ8HQBuIOQYuduA&oe=6ABA8BD5"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYE2Ewp_UMMQ7kNvwF64vyy&_nc_oc=AdrhU8SgEVyfaeYuEtaM0Eq91hJNaU9R9eNOdq2ewdnH6qLmsgtOeVf44FrDdHOIw0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGmWUbsBZ5KTgiBc1NHeTORAMzH_uiuD03oL0ljUjsYQ&oe=6ABA7A00"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYDWuAmnxd8Q7kNvwFg8DUV&_nc_oc=Adq2BJiRvI8Bhy8PQ4x0ngIRK_RKm9TZCIzq3eVo6LS1qiYIuYmQZR9JuBA-6H-lni0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDeRuQlLU_HzhpYyMyF0Iegkam4HZzCDd1bT-7-2hlRQ&oe=6ABA7C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwemOTQE7z4Q7kNvwGiik4q&_nc_oc=AdoI8LstV03JeIEz-OWajDg_CvHpQCYJqLWAqbU9wC7WF4la98HFHSxgbTdhI8stmyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3q1e6x7rMH97s2rjuk4nyazOjIuK715V8UeCZfAtv7Q&oe=6ABA6A2E"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
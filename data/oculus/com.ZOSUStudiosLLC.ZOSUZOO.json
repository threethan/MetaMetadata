Copy.png", "id": "2727865564269859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osNra8-uoXwQ7kNvwGFhKUs&_nc_oc=Ado2CYzw1qYbq_pjNbId7xrX6WpVy6MEY-iKHheodgvnhDk85OTmofErrqpatMH882k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80eQ94JnhKfJzSPinO4wxN2NIST-OxpKW790OMgPKBdw&oe=6A315DF1"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyHti7dbZCwQ7kNvwEYzrzD&_nc_oc=Adpn-el7J95ykBdcQKLdi_ebB2qAouwWpK-l36iCrnX7UeXYebT0FRy1IVD7c0SFqBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9roxB99PP4Tb_Ir5ZponPx4AOiWyRpjOiH9u8lF-s0Xw&oe=6A3177BF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZH2ZE8FLJcQ7kNvwG96whz&_nc_oc=Ado6DydCi_MRNDAC_Ypfb-txJJc7rImLCglC-FhoLPVPTeyrxlrW0lHlKCsF15-n-MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pmKH5rFmOc-YXD19Y5NWFMjiVrzNih4TVUu9cp9RaHA&oe=6A31709A"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjOWhKswc0QQ7kNvwFyAxC8&_nc_oc=AdodfTZ6R3XHTsWd60EwriBWQG_5bCZj7QS-NodkDTSojmmIuLXHnsIUv-W8ffIsWhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bFLCIVUoFCBFCZSK9gO00KKdYsO4XrTLmcBTqpjD1gw&oe=6A317899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FBt6QVv4Z0Q7kNvwHJPVcI&_nc_oc=AdqGdOSFg53rO7Jmhm9twe_BgTTD0LJTuFANnI5zqubEqaVjHNoGKc0kdOhVr5YcI6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pj238B_zGW57uW3dppm6i4HRy2SodkcvVYeAkqtSAvg&oe=6A317361"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
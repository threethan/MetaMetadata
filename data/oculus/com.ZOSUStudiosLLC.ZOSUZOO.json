Copy.png", "id": "2727865564269859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jokJajs8wz4Q7kNvwHiiZWs&_nc_oc=AdowDBHURapueVs9LWnRXioDDh6yW4yplOesvbcdy9iIHBjTZ4br7VEXTDxB3lpKjuc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4apOEACBRMynvaFW4hACNj5R2ugrc9wY-fRDwEu7AtZQ&oe=6A01E7F1"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAZrYNcOdSwQ7kNvwGkAdOs&_nc_oc=AdpjKilUDX3d1er1J5YpL35vgmCekF-HelLUPuM9JcGlWp_yVEGv6hN3yCTGQ3iVTvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51cO5QuVBRXCbCIFmhwcRgHzeSV69ZCFEIVIR-35twoA&oe=6A01C97F"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wHzMKfRDvkQ7kNvwEX0MX9&_nc_oc=AdpaZmodeHD4uQbNIY2sWZzvAF2SdJT5bQZ2gOokbnqkdkTNm78QY68DMkG66vIBOak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NTI47bZnTk1qMBH8Ync0mMt6y2rj_2kgAitNyrpzgqw&oe=6A01C25A"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qIo6891BZUQ7kNvwEsjbiu&_nc_oc=AdqlFqgVjfA06mMNNWr8HAhHadnXWUqW09LvQPUkXav4Jh5a8zbmGw4ERnAhnXGoVDE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yJz5ZlMU7IRvYyJ2vwt0DCcd-dEC61yO0GiST1K4aQQ&oe=6A01CA59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kpk9eFd-8wQ7kNvwErKNxu&_nc_oc=Adp0SXVnlBmviV97ySqHriR4kHmZnmmGbDuB-WdO272a524Ivo3MnItUSt_daWYgasQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GLe60aa3tm7EEMCCMolskagSqaGJbs2Yu3AwPRGvirw&oe=6A01C521"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
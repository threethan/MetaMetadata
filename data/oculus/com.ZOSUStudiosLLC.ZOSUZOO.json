Copy.png", "id": "2727865564269859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOO-SCnPQLgQ7kNvwHgWK77&_nc_oc=AdqbiwNYNf7-qu4BlRNyxwcvsuFGhMj11K25Wm2R6k_1aWN-ZVnKF4TVsY4TVjkU8SY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwCRUyU5seU0R-TEOvrA-ZFPBdK9XbNXL5DuXET1d9-w&oe=6A7B31F1"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX5g9Xfz-MsQ7kNvwH-0MXp&_nc_oc=Adr13y2pF-aJPcvPvvHZn8EyxdlqVtKoo0pf3_ov1ybhw-kIL7StauZOnulW1Pc7ZG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp6Z-4QpfYeZIlJ4HdMcxVDVWoCD48M9LpJCPCiLxmGQ&oe=6A7B137F"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBTRi8VuTAsQ7kNvwG2YUK5&_nc_oc=AdriWP0FOTXgePkiH0NNM0pi9hYDnrALlI_gUGWnYhbbHQr7w6OAiadMjDaQtmdnPvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuUKeX6jivUARuYcTs0j4BxVtQVBSWW2kMCq8j1SxNOw&oe=6A7B0C5A"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIhUwDSgPWcQ7kNvwGGnEQU&_nc_oc=AdpmJMXTpC-Vm3tsa1rm3W6fFbR89QB3Q7fqHyhZ1rwydIQJaG5UM30OThp-Fi5Zlog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtUC4H1t5YK93NpGV1oXt_rYy1Zs2dAdrbhR2poE415Q&oe=6A7B1459"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pLC2hsGpM4Q7kNvwHhXPVI&_nc_oc=AdofLPnrrqWXNpZExC95jdMoN4mGQOKSqbS9NQPY2tMv2xzVeKk-MCREpCk6rA0vknY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyqeql3JkuEsqcKWHD9Gks_D9mnLgVDVuE0eg7R-9zTQ&oe=6A7B0F21"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
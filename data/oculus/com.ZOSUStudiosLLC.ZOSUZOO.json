771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkcRO2gYfJ8Q7kNvwFlG0zw&_nc_oc=AdpgV3xGk5En4XZSW25Xub5syVR2GX9LYtyAYCXNsE1Ow7BKIdf_mszOyBqmTAjwmzs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35s_Yh0vBhT2eFhW1OwnuO6wr1_y6mbK8QaqLbNSmSAg&oe=69D4F759"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_WsxFx-btUQ7kNvwF34awA&_nc_oc=AdoKWwq_QMVuGP8SEUZ4pa1MZGZPKZ7rPcYhN4A8i9_KV7gId6mQaJF4N9UK4GUj-AI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bxEtPL7oh2AXlfL4l93VVrZX-wXoUXTUnJ-ndEF3jJg&oe=69D4F221"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more.\n\nMajor Feb. '25 Update: 360 beach video areas"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "DINOSAURS", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7369374796519984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974703_415875600447010_8202666949375033340_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRhWTw3MjvIQ7kNvwH0A5RM&_nc_oc=AdqZjOkoVanUHcBDygbHEbL4wTJWb_slX1TXsAAI40HPJet-P4cLRlbKv9OAFYFgJNk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mWW
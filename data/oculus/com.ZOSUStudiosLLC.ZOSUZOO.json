9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1kyewFL9L0Q7kNvwHlbm2B&_nc_oc=AdpRDCNfpfFhNlv025l_HIDXsHE6lpGt4EQ7tls2FQj0zJGHfmEURU1tjjm4egGTab4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEC60wzGXfWET5pIJVwEtSEhOFd5UAWPy4_VMQ9Fba_Q&oe=6ACA703F"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2SWqRj48OUQ7kNvwGtJKW4&_nc_oc=AdrRMrI2hEHF6bqvXkZeLaEit_m_X3smKOq7khzn1I-40-k_42ghuC61Pv0Ju3DXheg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoh48q-jRwg0iEtoYSXw-yK1U1ke14CTl1NsOtc7COyw&oe=6ACA5DD5"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQINrgdFiisQ7kNvwHP-awy&_nc_oc=Ado0ZR8cGupKMzHwnXYEhc4OxRAc82wxJGWm0Sy2AyuWJcYH_0Q6WAD7_XXTpIxyKZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHiUNu-YC27KAbqjtX9mNYjLPgX0zOLjHGXpA4zKiHYg&oe=6ACA4C00"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcG11sXxZMUQ7kNvwHr8B7W&_nc_oc=AdpuzEEjGqO44ZJNCEQSCVquqPFVoq-agKrJyVkqOuSPk7uq5w-Dqhr7jQHuZUtmTUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHyL9dXDocDyvZ1jCu7esY5OlOriRTLNt_5CZGAqOq6Q&oe=6ACA4E1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10FolUNN7UMQ7kNvwHHLfri&_nc_oc=AdoPFLSRcv3Qhy2c3DLkNEluefkeT9hJWV9SCS0BHlVKiz1QXOIvom1nWfqeyBvUBfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP01OqKN1XYA4FapFmW5d8dmE_hkGd_PC51xLQvWJFX2A&oe=6ACA746E"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
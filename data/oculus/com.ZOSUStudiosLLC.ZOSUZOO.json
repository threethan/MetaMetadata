9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkhSa4OMG3EQ7kNvwFH3NTW&_nc_oc=Ado9VKkXy-LDBZpjXOGtMBWDbv3D75TTuEzcNOj5JwrKG7e5_g1wlaaC3ogbGEoQIjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLa5yIDvkBqhnqcR9YK7-bWcqzWf4E6Ov0B68rsb1-ag&oe=6AC6437F"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nytq3aBrkpcQ7kNvwFpMvVL&_nc_oc=AdrT6GdBDj1Dctmm1vytourV6Q5SEHNQwfgtuhAgNn_lDDZuziwmSfTHak6PGmKvqKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPydDsUtinmUfjJVS4d1DWXF_D-2kPYSBUUMloJE56oJQ&oe=6AC66955"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMlUandWDT4Q7kNvwH3egXz&_nc_oc=AdpqDyjGeiP2oS3H5ZRuKsrUuIKpTbyG8Y0FQCLYA5Ub0WvsIM2TRkjzlU8lEf0gRHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6J0GMkM9snlTThMkd7Q4Ofr6CSIAkw8SplG3Qmb-qmg&oe=6AC65780"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTaEuU0nLbEQ7kNvwEkAnZ0&_nc_oc=Adp6e7_6VMczG15fz2VRX1xign9_--Og-ellrc5fNiSrgV9OiCo7ZmRSViz5C5LkSZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNysxcpM75ZtFVjgAM1LLgI8r1gNHN8OtUExbz08oJVQ&oe=6AC6599E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu2O0yWad5cQ7kNvwEsf7-j&_nc_oc=AdqtQuWZ80qqZ-Hv0vNqhfccxFnJ-8OLKnE_YwdlwNxBhyWgCDYuTOUCPNLsU0SORIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpNVwHrE00NecMYedXz1qhUeYUrAYcKvXLTxcOUHVdAQ&oe=6AC647AE"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
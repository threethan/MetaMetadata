9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzZefmvImtgQ7kNvwFvSWKT&_nc_oc=Adqk5QNhnq4az-dNxgrvxU-rYirO0o7A0v6KkI0_LI-bcT2WLJrgO_OgSEzltc6pd8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBFmU_GU0Yh34Lk90Ns0Lhzo7UdZzsaw4vlPtP4xu9-w&oe=6ACFB63F"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnthza7uBRAQ7kNvwHslbTe&_nc_oc=AdpQTiaqrczUPfMzQ2lyy52KVVzPMI2xoCNdMfdTLL71GVM4KWcOtsna0rZVUXPm0co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCrVKKQgkKsJPlvrlJ0yPJrEqtcAgezxV9b-hGBr8TIQ&oe=6ACFA3D5"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N0Sjxe9CQYQ7kNvwFLRXZx&_nc_oc=AdrgYpdLZivvqRZ8fyxMpeUUBwzrjz1q0pCEO2iii3GVxayi0EpQ-tqP-SizoFAyObg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQWKynPHL3-7F_Vsr6NAKCCsmX1eKl39UUyQtm2swZIw&oe=6ACF9200"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K31j7YbeQD8Q7kNvwEdCzz4&_nc_oc=AdrzVDQSp9G9Gsxqv5URtT0isZypODgmvn65cFcqQyn2XQof_WjxGAX42RDzHI-73gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrQDhBj55IuN_OEjSQc1MaPbgwjtw3mITRN1JjmqdAHg&oe=6ACF941E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op8orWFhQ24Q7kNvwH7B5Sn&_nc_oc=AdqNpjc1XN78X5TywzLx8sAiBHv5iIN5mtWHJ-QXXMJZKd8cta9_wwUVttkcT0u4ZHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpAv3_nmKPGPj8NPEdUTLs9Zm1kaib9sJyqX3Tck2e1w&oe=6ACF822E"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
-hkg4-1.oculuscdn.com/v/t64.5771-25/65402154_1224808084723054_564240767897631724_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtNDh2IcmecQ7kNvwHghVvE&_nc_oc=AdmR_PI-v4Y45XoqfQvRwpjxUipLGso25pZuM2HKjzVChFXa-xdRXWxpbaEUUyJGshY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsMjzUoUJg6sfoS-_BLUiAkA73sHBahuyiKNBdZyqd8tw&oe=69A17572"}, {"file_name": "zzzzz - Copy.png", "id": "2727865564269859", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdVgmGPFCakQ7kNvwH8nD8x&_nc_oc=AdmF5sgCxws-oU-uMpt0P8a46IJ9AQp_QIcBYMhjHwwoLoNZfKWuSdGPoEqeYQux08E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvDw9IGSwzn1S4U44yqbu_YiZ8xrVBSa88ABXFF4CK-ww&oe=69A1AA71"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48kYd64CuAsQ7kNvwHp6jMX&_nc_oc=AdluNGZCrdXILj9tu42HWZVSWwiOMkEq_Ny3NdIvmDE1usTs172TXMSys0VVwR_SFnQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftgAVKdzO5R-siMhurYnieXGLOtHk8DDx3QyjfUSmvPLQ&oe=69A18BFF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJEMwsWfrOsQ7kNvwFjxgEY&_nc_oc=Adl8BbvliVbAPeNmqx7CDhAfoDZyPmDqZEwfg0ziS5Ipe9JsvBiJ7OGUN4KAYNe2j1U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afst9GwKkUh18EQcsyTQcf4QMYCwt_P7uGuXUpWmecWQIA&oe=69A184DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKo-zgnFBYgQ7kNvwGm660n&_nc_oc=AdmVE08NP32XXyTqEV-yZSYUb7otcwVKDlVrFflzHJhQgTmk1nwtYQzWkXsDFhdQuQk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuIQKMozRXifsw9tPalI7fq3hNXd6frMKjg3UvCMemtdA&oe=69A18CD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NMf3ox2gQ8Q7kNvwFPzKfv&_nc_oc=AdlHFU560wPfhaQMuQceeK7sN5ILuu_imHZvk-diorjv3MlewdZJSfYbLMzD4XpWsY0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsG66To9aebwSzZ-dGnNN3ReIBfIwiTHX26wd7TQF7Qcg&oe=69A187A1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more.\n\nMajor Feb. '25 Update: 360 beach video areas"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "DINOSAURS", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7369374796519984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974703_415875600447010_8202666949375033340_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWTb4M0ULR8Q7kNvwHGYg3Y&_nc_oc=AdmOQcvs-Pw1WntnEntZYXIt7qP4fGOj87Nm6vLn4BQszTh00hk1IgHpbHW5Ye_r9Rc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftdKGFakoit4gJ4ehEXM0YeSSA2nC0W09faE3GbP6DjTg&oe=69A19951"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ZOSU Zoo", "platform": "ANDROID_6DOF", "context_cate
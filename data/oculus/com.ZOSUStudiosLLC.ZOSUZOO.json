9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llb6qAs0ktwQ7kNvwHUxVAl&_nc_oc=Adp2oRD72H9pznE3lzeZtgg5S019JOqlj117HmHD6CVF_BFQ3hGPEmI5LCgOkBzG3nQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKXZ46KZg_O92RffXlTD7qJLRet0BSFqGh1sDEDs0dng&oe=6ABE5A7F"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km-RLG0Cu4EQ7kNvwEDAM2d&_nc_oc=Adp1_xaT2MdvRZhKV69i-m2P18xrvkYMWPwAvtpI6_xFEOlm3czkVLxwBVlvKn9Cygo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD9H6ClYkyi-BXA2AFowxUgkTCLrWI_FLghALiYr2Ojw&oe=6ABE8055"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXtUyVV_NHsQ7kNvwEp9KsY&_nc_oc=AdrehaTMe_9tQ3-BQTxRLwOktAUyf_ia2GwIk2Re8aDGCbz5rrHk5oOXClGcEQUTyug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKUyluFiSU-3At51XC4yRJC9E5wfepUr5EX_79e7nArg&oe=6ABE6E80"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPgGq2exmX4Q7kNvwEBrR_9&_nc_oc=AdoDU_KdtpLEsS9GKz7G8oDaOBGFFd0JlOcLxvOcfbBk-IAsQGcEUY3ohH-swmsoZQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsFy8NHnYoQ9edVTAoDyvmiPCOkHP5dYTrOIVkP7-cXA&oe=6ABE709E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_mY5g8uEQQQ7kNvwGA95l7&_nc_oc=AdoH8omOeQktxTVYMTzDZIi7MckKYA1EHi6b-iMWbYGPUsaraeU4GYXnnWeRUB4xLsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIiDdDUqunzXM8wUhLxteebxf3J5nYYb0cRv5I0XqoSg&oe=6ABE5EAE"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzZefmvImtgQ7kNvwE73_Lr&_nc_oc=AdrQ_pc5_omJMWnXGDlHYuYR3u3y0qugSJOm35YnuxaN3qDd-KOnyAzgeA49yDXxKJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1UqTdzhFn-d0VaxJLdokHaz9vROr_i6Spy_EoxK5EvA&oe=6AD2593F"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnthza7uBRAQ7kNvwGtPyFs&_nc_oc=AdrGN21bNk8SS6_sgNJysSy7EH572pDxuDkl-VlYbZ9oSYPBt0TLT8xZ7eLkXSh9Kps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgTNrjUofbxrRcDyN0kzwhjdfM2jqw8EGRUQ5Jlv2nFg&oe=6AD246D5"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Zk_GIFmV6gQ7kNvwE3ZD57&_nc_oc=Ado8FgSXiRe9O0Mc4lAEvIVRy-tknHjXNXRuM4F-0pkvMGOzKIPL12YvBPNl7-WCkFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMOFMEacWozGoTPEy2CPmWLA__nbP9hwqWOK7g5ceW4Q&oe=6AD23500"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K31j7YbeQD8Q7kNvwHnLane&_nc_oc=AdpNFpy4H_qSLlHG9KH0C4JJXKv8qF-e0qhU919vIU_lSKjYHnxMtPn8Z5LZaj27swU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKXZudYx-hoT5Yrm12HyjUP8NI03H9cb1usJZwSUQn2A&oe=6AD2371E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op8orWFhQ24Q7kNvwFS068x&_nc_oc=AdqvgQiI6VAoNSvPwpWJbsaCohidY-QJxmDnw_2mUzTKbFfPoZN_KbAPs9qQ2K6QtpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbYu8vqO4aKtYPzput6bXMWIAuvQT6LMgzJ2ToXmojqg&oe=6AD2252E"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
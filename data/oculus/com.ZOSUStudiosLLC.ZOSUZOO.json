A&oe=6B05D7C0"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffujlNfJoUYQ7kNvwE-98Lv&_nc_oc=Adp7sXK3VrylvK7o8Hnt_lnoBmXK-UFsxdY2GyauOYHp4oeTvicnHIeRYbB31XSKJgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxumxb10iOzH7_ZVcZV-v_LA7F-mmoRbnkHoMXX64Gtw&oe=6B05A19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHliO0lIRrEQ7kNvwEr1Eae&_nc_oc=AdpEXsCF2pkCQWvFgt4aTXxQ78dJAKWn9vtDXDvWsEn23drmneIahI_gUyZTsN2TBxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZxNYP9wWUVUieRTbGnMzWZyI8n_yYRcCLCfzRqCC_lw&oe=6B05C7EE"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "DINOSAURS", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26305612335802945"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627502_2128976987754687_3530743161940298158_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dHygrVvHL8Q7kNvwFFb0np&_nc_oc=AdrD6QiUw6FLRMWd719GPbDFQivYAkA1gBhq
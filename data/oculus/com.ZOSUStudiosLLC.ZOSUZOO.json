Copy.png", "id": "2727865564269859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev2R8bhJZzwQ7kNvwHYsOGf&_nc_oc=AdrU6A-xtmp3qZFPjV0dlxdg3dEqDecf8Q2D64xB4CBxLOVfKwnHoYGv1LG1FBBTqiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSY-Yv54WHkW-Zu7gtX7S-CwnhNgFkYodk6Ril2j2ubQ&oe=6A64C871"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmSDCqbZi-sQ7kNvwE8yV9s&_nc_oc=AdpJSLOnSNmTwLWZo7LW2XYTjAxy_hONVwzrJCEhpZS9VsgtISAAkMfJH2vZnHsaVAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7b4bf_jFV5oZoJA8zqrtP6ftOJof956E3L4rs0anoNw&oe=6A64A9FF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-iUmCETbBUQ7kNvwFR0wLj&_nc_oc=AdrBgQc6NwSVBTs3Wp1XadsQ0qJOmRZy_OFiNSR592sVsNl_S7vaekj7cv_uzCMtyD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVYl44mC3H0aaCFJjJzf3SVmxTQ8WrQ12UD6qaGoV3HA&oe=6A64A2DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq422mxlkbMQ7kNvwHpdC08&_nc_oc=Adq9-evPC4t7CpLobH10y7dFl_sMJnWbrBzja7xiTrSwyO3ibsWEPW5qhiu6x3OBTNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8DPX1Yw3OnGY2zkgn0hkcZDj-fb0XDYQN0NfONIpsUA&oe=6A64AAD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeJ84-rz6mQQ7kNvwG0E8zS&_nc_oc=AdoHvNIop-Dbmz32xkMGMIbZt0Hurka46Vi7kDNiYUy7cgf_a8qpthBOK-q5w25S1hc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3G7LDfOTzvZ7kLaHpTb4RlbUZ8WTVnwa-15O5vGty3Q&oe=6A64A5A1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more.\n\nMajor Feb. '25 Update: 360 beach video areas"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "DINOSAURS", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24434880219542842"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974703_415875600447010_8202666949375033340_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaGbTQUL_wgQ7kNvwF8EtOl&_nc_oc=AdpdR5sUIlRUbDhMdeJfDhV48VjpXu6AiiC9gmKRo5bBFxyrfNN5p-iGZnHukqhItK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxdhSYs5yDlbEQa8DP2EHpJpX8JGKNoFYvk8bIHCtZtg&oe=6A64B751"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ZOSU Zoo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1653343717, "lastRevision": {"nodes": [{"id": "3623397014451133", "release_type"
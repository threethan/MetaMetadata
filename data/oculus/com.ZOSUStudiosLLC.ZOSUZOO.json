Copy.png", "id": "2727865564269859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrOz-P58pPsQ7kNvwHYnYu4&_nc_oc=AdrmGR7K1745q1oG4VEGvF6eKejpSETJVpfK1eGH2f-bgpITXoIe0SOunsm3EE2-43k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLUUZXc7muXRLMh4Ed7xfpAzdxKumUh0x-tl-26k2I2g&oe=6A773D71"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ1QP2MLLs0Q7kNvwE6-hhY&_nc_oc=Adpb7tAnrrViDPAgVIdTiYbWKY5Rw7L6J2W1PcI272q3aLT7J7Zfj4pWhHgwgbC1a1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdPf_bMUZMW3d5trayhH_vqYq8EE6OXCEoHya-QEPK1Q&oe=6A771EFF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7UYgLlCJqYQ7kNvwFRmM99&_nc_oc=AdqbE-A-0q6U42Rv7UucxChBF0VZqTqAtu-Eh2zGQMc068tQ6k93w_Tj9h4JVjLb3IQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN-fcfMT81xcIuAD09rCz3DHR4FU5cMhrBnqqLv3UZmA&oe=6A7717DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePt8oIJJYIoQ7kNvwEESeud&_nc_oc=Adr5JswXv_tWYzavxnSooOOFBPGyFgMHEYUeOiUU-JxjNDJCNpGSI6E2SzEZv6SPoFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcW1mRHO61Gto7m24QhEHmcX_6OWWNyV3v9EQqIlC7Qg&oe=6A771FD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HawnyfWyXC0Q7kNvwGS7PBR&_nc_oc=AdoQ9ibvSwltrs2lrCZLZ1pBPQqVjiffVFZrAcN3SpL02-z_oHmlah9bccCrhPmB60c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELBQ4KdEdfqcV4uPZCEPL0l3otjnO3HpkDDKUU2My_Gw&oe=6A771AA1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
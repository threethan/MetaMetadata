9680_2159335734965595_5115268452688190180_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfKQpTZQTz0Q7kNvwGPWQ6D&_nc_oc=Adoh92iHbMINgz9byet_X7M9L1rx6f5V-7gkIiARvb8PlKyx2AIYLY5gWfG-yLqO2Xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJFLJmVhyyORrOnTsSbrmcQeyFe4CdQghY0FerILfYQQ&oe=6AB9147F"}, {"file_name": "473393549_986927593316995_137404144953740922_n.png", "id": "1629531555545716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626806_1629531558879049_9220855430578889250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEKmhsfLU7IQ7kNvwGJ8Mrc&_nc_oc=AdpoRZ91sX8MUPmYfDmg4Fx1gkQhXvNa85uUhJDkVd_qIp-QMY7CDpdM9IQ3ruzlUic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM2hbMFNkzjq606mYjlOwnpMTJruzH_6eTuFqop5BWcA&oe=6AB93A55"}, {"file_name": "zoo new1.png", "id": "1324360762845861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1324360766179194_2443450847532085383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYE2Ewp_UMMQ7kNvwHkle1V&_nc_oc=AdrG8cBsrGyIsocrdURVDsMGWFj50dSLxxg4YCuHjNGpKhYW7_9-oo8taHID4uKzP00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGfk-qkXplvw3375ktu1n1C2ta1GwbGM_UgNkb4cx_OA&oe=6AB92880"}, {"file_name": "499619751_1813739739603188_7560309759937034711_n (1).png", "id": "1696283478109808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_1696283481443141_7960785105840964369_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYDWuAmnxd8Q7kNvwFjT3UM&_nc_oc=Adpp6WqkVjuWAL1CYSjjQR1rsroLdH3ScMaiUEvIDOQPOecxq8bOIAw4HS_H_ElpkY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImKB24tEalvMfMaV18eeE9YC9XDIz0KJsdOqpJ_29Yhw&oe=6AB92A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "d21ec90f434bdd7f8a10ebb35173d9ab.png", "id": "1030950856213930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1030950859547263_3476191653390360023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwemOTQE7z4Q7kNvwHX5uMz&_nc_oc=AdopQiQyWc3fGVgvhT-A3mPG2zNwD58g3gBQmfWmlxmNTi64-2b0SMVL3gfMIMCaKHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSxTYm9k0f_l2A7PaSfgsYBOXQ2XUdAE44hOkYp-v-ag&oe=6AB918AE"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming:  hand tracking, controller, or controller joystick\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nAugust 2026: new highly immersive swimming areas with the option to swim using hand swimming movements for hand tracking, controllers, or joystick\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Immersive swimming areas with hand swimming\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses, cats, dogs, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LL
Copy.png", "id": "2727865564269859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_2727865567603192_3815450512596207592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muNELVHxD6cQ7kNvwGQ-DDu&_nc_oc=Adou0GxAa9suyoeH7-cxCSjncUiMyhPdh-8EJxlvJLFgS9tBRb2jMA4pyY6uQrTBe34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rChy3-vfn18eybbsVS96kuzI7uqXBbKRVahKGW6b4og&oe=69E8DB71"}, {"file_name": "39036665_1362218797977565_2391701479039030959_n.png", "id": "1659613264442691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031387_1659613267776024_1666033661232148010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdZ1DpDKHK8Q7kNvwHWysFQ&_nc_oc=AdrVVC_ZjSfIbUMd6e0nk92t3dDlDM2ARJFIYtCFNfEUnOqTFGMF6jarvAUu27FN8JU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z610tQ9PqeT-Z_SiMheyjGeyb5z-CfTcVb_0Y-5sTdQ&oe=69E8BCFF"}, {"file_name": "38974494_830112815084627_2349069689351704121_n.png", "id": "2346687842338612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245817_2346687845671945_3105462788421085166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9oqpGpVJxsQ7kNvwELDQzg&_nc_oc=AdrJOegd2KUyD5hzVTspA8gEKUMBRvA1179hYwV1rPRjmcu1ltrICCLI9Cl-3ZtjxCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33EfxumbrO9tbwcodq1dbj0OMkiaYk6wPZz4abEyGE2w&oe=69E8B5DA"}, {"file_name": "39031644_1406435783246773_7738440767812395666_n.png", "id": "925264206472432", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392171_925264209805765_3742408624817311337_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5ubwxklQZAQ7kNvwEzPgyt&_nc_oc=AdpTAS9unM3akyWHWmwMFg13lhBEU4Jmtq_842Y8z3r1DxMP9CuwK43IJZaD6s2B3EE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2woDrFRVv2_qIOuVx-pppxqbzlPvOU1F41uaYOzRE6kw&oe=69E8BDD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "2401078666941825", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392298_2401078670275158_7935411864527675119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy6D6hx5wgoQ7kNvwE9rKXr&_nc_oc=AdpTdWq5Yh0MvVtseNb5AftDnEynuS4bAJ7uvhy4nYcBXbfPKETZv9479Ju3X9tzMFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yjkXTyZ_1_ujLR092H5t42GKQc7KGnTMIA4BOod2g9w&oe=69E8B8A1"}, "display_name": "ZOSU Zoo", "keywords": ["Zoo", "mixedreality", "dinosaur", "handtrack", "animal"], "long_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and hand tracking areas allow you to create a zoo home, along with jungle environments.\n- ZOSU Zoo VR Land and 30 ZOSU Ocean VR levels are waiting for you to explore in classic VR (controller use only).\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, bears, wolves, elephants, rhinos, whales, crocodiles, chickens, tigers, octopus, whales, dolphins, horses, cats, dogs, star fish, leopard, cuttlefish, zebras, owls, seals, lion fish, lizards, goats, sun fish, squid, and many more!\n\nMajor Updates:\nFebruary 2025: added 360 degree beach video background areas with toy sized animals to play with \nOctober 2024: added new animals: a humpback whale, a new turtle and squid, and 2 new dinosaurs.  Also added palm trees to the zoo land area.\nJuly 2024: added mixed reality + hand tracking and ocean exploration levels, these updates are available for all version except Quest1 (Quest1 will continue to only have the original ZOSU Zoo land)\n", "short_description": "- This is a relaxing zoo experience with over 140 high detailed animals to see and 60 jungle plants.\n- Mixed reality and handtracking areas allow you to create a zoo home along with jungle environments.\n- ZOSU Zoo VR Land & 30 ZOSU Ocean VR levels are waiting for you in classic VR.\n\nAnimals include: lions, sharks, dinosaurs, clown fish, pre-historic fish, elephants, whales, crocodiles, tigers, octopus, whales, dolphins, horses,
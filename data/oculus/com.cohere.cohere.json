", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974909_1006052630226847_7999381520604970027_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WICR-JDMP9YQ7kNvwEkSL9i&_nc_oc=AdowlKOXoOhVG1fCc9-va5MWhka7UKZbAaBMrgAmCHn5bWLtQx1xyVuHDnhTkxePyDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlUsYiQ9Ia42zTvRJ7tcj4o4GIvDiI5k5Q9Rn__gi6bw&oe=6AFDB236"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cohere", "keywords": [], "long_description": "Regain creative vitality with virtual reality!\nWorkshops have helped teams go faster for ages. Get on the same page and build momentum with new ideas. That\u2019s the gist.\n\nThen we went remote, and now workshops suck. They slow us down. Some old technophobe is hogging the microphone with complaints, trying to find the zoom-button. It turns out sitting on our butts all day isn\u2019t very inspiring, and we feel our creative juices flowing freely down the drain.\n\nSo we got off our asses and now we\u2019re making Cohere. It\u2019s a virtual reality platform for workshops, that\u2019s actually easy to use. Even for those pesky boomers.", "short_description": "We make remote workshops brilliant with VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cohere.fun/brukervilkaar/", "developer_terms_of_service_url": null, "publisher_name": "Cohere XR", "support_website_url": "https://cohereapp.typeform.com/to/sIrFODWj", "website_url": "https://cohere.fun/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
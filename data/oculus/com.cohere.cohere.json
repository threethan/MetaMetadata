2M8mCzcq00dE73Mh60CEGad3l10_fvQT54U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMXkoCAq_cL4neJhIfoWh9HRBLfoMo3XN876lt6guhMw&oe=6999C1D1"}, {"file_name": "screenshots-template-2.png", "id": "993946471533672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031492_993946474867005_3819622424359665904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnOMA4FL77MQ7kNvwEIh46Z&_nc_oc=Admc6vj9nc_wbWLJZr6Nh48PFhckBKto6iYifAyIIS1hZac7Y9I8wKSo5Fyv0xiuCIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFiJU4F6lWsrcWwpnwZrqRUJhWgtKTZYMrix64dlck2Q&oe=6999A4AA"}, {"file_name": "screenshots-template-4.png", "id": "719746049391141", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974824_719746052724474_2947872145257315952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk-Z3CmR3VEQ7kNvwGjGQis&_nc_oc=Adnj-wGlm0abRUxEvE_OYsa_d9V8XlF7fMaFvpj2m1rFs9KGuxFtXLppabr7WhL6Pcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCpR8E9lH3n0xfaG6V9xxOU4jDJrRZ8X0JqZjj033vMw&oe=6999BC94"}, {"file_name": "181862453_456891438732663_6570000156002538162_n 2.png", "id": "370686698041304", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974779_370686701374637_8946645015137559248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-9Polp7kvYQ7kNvwGM-1Oz&_nc_oc=AdmC9V7Ulnyb37ePjLfoO31XOja3fyc3Jae8zOdtGLhsPqCQ2ocEHwdF1fnN4eKPx2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaTR-d90AJHs96HNowstVrq-eQo1dOaZhKvBnP2F_lTQ&oe=6999BDFB"}, {"file_name": "23.png", "id": "1006052623560181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_1006052630226847_7999381520604970027_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omKe4nZAAbcQ7kNvwGUcfrE&_nc_oc=AdnXbTYjAeS_e7ehfxLKemaRwTXZqtytbUMa7_r6VqPLbHFW6KgUk7PGdAWaLGc3Zu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzYZljeY8rbzl5Wlp52EyGFnsD8cuUzQLJOXEtH4MoXQ&oe=6999BD36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cohere", "keywords": [], "long_description": "Regain creative vitality with virtual reality!\nWorkshops have helped teams go faster for ages. Get on the same page and build momentum with new ideas. That\u2019s the gist.\n\nThen we went remote, and now workshops suck. They slow us down. Some old technophobe is hogging the microphone with complaints, trying to find the zoom-button. It turns out sitting on our butts all day isn\u2019t very inspiring, and we feel our creative juices flowing freely down the drain.\n\nSo we got off our asses and now we\u2019re making Cohere. It\u2019s a virtual reality platform for workshops, that\u2019s actually easy to use. Even for those pesky boomers.", "short_description": "We make remote workshops brilliant with VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cohere.fun/brukervilkaar/", "developer_terms_of_service_url": null, "publisher_name": "Cohere XR", "support_website_url": "https://cohereapp.typeform.com/to/sIrFODWj", "website_url": "https://cohere.fun/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "467678625095991"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7761869037200339", "ver
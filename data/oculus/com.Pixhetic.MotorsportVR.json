wxdrQ9sDFQvpA19sSPROGQcHcL1bCOhGJ3x9tW-yIpdQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsR7tkAN_dBrMk6Z8yUqKRwU-SJm_nTKSOk1Lkklcq11g&oe=69A17E5A"}, {"file_name": "sc66.png", "id": "24062148523397074", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491821696_24062148553397071_9023080155429995008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnpm3wRCf24Q7kNvwEIkbgL&_nc_oc=Adk_n4TMHSDEiM3cmRyoEfmawv8dBX_3JFGeQ_V-xVpf6O5pQoMaRu9Sol18CkLjsCo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft2S4n0BWSsm7yQN-dap3TwqhAQhmOeSbFfmNSH5NMr4A&oe=69A177AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorsportvr2560_handtracking.png", "id": "2060907507770640", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303707_2060907511103973_158746132141598062_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvWOVQTsMEcQ7kNvwHNt1i_&_nc_oc=AdkX4az-hTdqZA7K4KXZWG-mJ3SkanOvEMOjkfyrZpqrNugqlrxADtNM9SBR573UIz4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvc9FUfahJu5Dyzns9PyRd2yC2YfUAP9f-X75g6RC-XZA&oe=69A197D8"}, "display_name": "MotorsportVR", "keywords": ["race", "racing", "car", "driving", "simulator"], "long_description": "This fully immersive VR circuit racing experience puts you right in the driver\u2019s seat. Choose between manual and automatic gear shifting to match your style. Feel the thrill of speed, grip, and competition with physics inspired by real-world driving. Whether you're a beginner or a pro, a challenging track awaits. Start your journey with 4 distinct cars and 3 carefully designed tracks, available from day one.\nNow supports both hand tracking and touch controllers.\nMultiplayer mode is not available during Early Access.", "short_description": "MotorsportVR delivers a true circuit racing experience with full VR immersion. Choose manual or automatic transmission to match your driving style. Feel the thrill of speed, grip, and competition with physics inspired by real-world driving.\nNow supports both hand tracking and touch controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixhetic.com/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Pixhetic", "support_website_url": null, "website_url": "https://pixhetic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23949080658124352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499295272_1445841830096990_1439448179136151458_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVb_ziijuAsQ7kNvwFKrRxV&_nc_oc=Adnmq-xDBYUZCtV972QD_zRKjKc8xkBgxaxjkQ1DLvJiQrGRw_GbPbAHedRACPzFbH8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftAXb1sjb2kF0NNgzVaVrWycJAAKrwyZjMKBvZyfNZFzA&oe=69A181C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotorsportVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1750175580, "lastRevision": {"nodes": [{"id": "9789621087830213", "release_type": "SCHEDULED", "administr
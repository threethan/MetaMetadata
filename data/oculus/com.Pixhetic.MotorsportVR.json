orts both hand tracking and touch controllers.", "short_description": "MotorsportVR delivers a true circuit racing experience with full VR immersion. Featuring Free Roam for exploring at your own pace. Choose between manual or automatic transmission for any driving style. Feel the thrill of speed, grip, and competition with physics inspired by real-world driving.\n\n\nA major content update is in development to expand the game further, with multiplayer features on the upcoming roadmap\u2014stay tuned.\n\n\nSupports both hand tracking and touch controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixhetic.com/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Pixhetic", "support_website_url": null, "website_url": "https://pixhetic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25805976665768066"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_735977966113211_571209141535533227_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChRb3X1rHHgQ7kNvwFmMgf6&_nc_oc=Adq-R32qxnTJQ8_5GrzH9FKjJyItP1ljvp6SLk_3OQnp-7oT8boX5yJ_qnDZ49dPoQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTcH695i8H
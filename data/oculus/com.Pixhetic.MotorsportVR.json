lV9sneQl6wSNtG_6hChDezYmDrZqNNN16kKJOBdm7wOU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsVYDop1b7HtRsrLLVO5KFiseGgv9ViUzS6wCkPmKKNlA&oe=699843DA"}, {"file_name": "sc66.png", "id": "24062148523397074", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821696_24062148553397071_9023080155429995008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuAOE2Bnp2YQ7kNvwFP6-sj&_nc_oc=AdnRFzCTomLQO2sAysVUdcD1wTRgXPHepC6NFfr6ZkaACnCukAi39pu0uOd9tvSkL8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuRsYHzlaUIDZQPjFQVvTLdK6uM5l9Utxdkp6pbFvagzQ&oe=69983D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorsportvr2560_handtracking.png", "id": "2060907507770640", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303707_2060907511103973_158746132141598062_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWJbRhtYSEsQ7kNvwFOMqmq&_nc_oc=AdmMs34HxPkr6dZFOljYfsk9kNYlnnU5Kyr_vNCwtT7UY0RTMkzW5DJ8PXu80WctlE8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftjbgCT1FXEV7dpEPLvA3XR-OOL66n2sF3hzzOfTIpPkA&oe=69985D58"}, "display_name": "MotorsportVR", "keywords": ["race", "racing", "car", "driving", "simulator"], "long_description": "This fully immersive VR circuit racing experience puts you right in the driver\u2019s seat. Choose between manual and automatic gear shifting to match your style. Feel the thrill of speed, grip, and competition with physics inspired by real-world driving. Whether you're a beginner or a pro, a challenging track awaits. Start your journey with 4 distinct cars and 3 carefully designed tracks, available from day one.\nNow supports both hand tracking and touch controllers.\nMultiplayer mode is not available during Early Access.", "short_description": "MotorsportVR delivers a true circuit racing experience with full VR immersion. Choose manual or automatic transmission to match your driving style. Feel the thrill of speed, grip, and competition with physics inspired by real-world driving.\nNow supports both hand tracking and touch controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixhetic.com/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Pixhetic", "support_website_url": null, "website_url": "https://pixhetic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23949080658124352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295272_1445841830096990_1439448179136151458_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwFJtJZKLCcQ7kNvwGY58Nn&_nc_oc=AdmH-336ifPQxLCzYlYPbGt0uX3CBCVjqGFBuSUdI3o27Dnwtg5CcdAZsPOSWS-iiYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvs2Kp1bHG9EtdZUoLI46_Abkj01gXi1uHGh9ckJIK-CA&oe=69984746"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotorsportVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1750175580, "lastRevision": {"nodes": [{"id": "9789621087830213", "release_type": "SCHEDULED", "administr
6&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liP9-jl0KIUQ7kNvwGbMY_I&_nc_oc=AdnN4a5P6_GFPs-AaPGNNskaWzNOE-mO0FCfvpNK0S_mSWpioJsQR9ZcLJ-iXt-rNS8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afzl8uxE74hpzrPJOzzP-Yg_7wPHljLthOKfOgBji1WA6A&oe=69AAB8DA"}, {"file_name": "sc66.png", "id": "24062148523397074", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821696_24062148553397071_9023080155429995008_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_CZUa-yo-EQ7kNvwH7Wt9v&_nc_oc=Adktvi_5QSdTfnbiN09KH-v3Jg4_VVuf78ULiO2A1q9lbwt-JYkUrGma9goyaaA_rvI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afyq5XtI-KrSIYmReiG_agWdI1lzktjnJfba_UpMdXqkag&oe=69AAB22A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motorsportvr2560_handtracking.png", "id": "2060907507770640", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303707_2060907511103973_158746132141598062_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOTVshrRIRgQ7kNvwEf4VIf&_nc_oc=Adk-jBPiGpFqtEQe5mOkRSyu9NQvfD7NicHSHN-w9Hp8q0oEMxD4u9X-tziTKlBkKjE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC3dPPMvXr0gXWbCAHwqxHXtWCcyKfDrdUq8y8onVcHw&oe=69AAD258"}, "display_name": "MotorsportVR", "keywords": ["race", "racing", "car", "driving", "simulator"], "long_description": "This fully immersive VR circuit racing experience puts you right in the driver\u2019s seat. Choose between manual and automatic gear shifting to match your style. Feel the thrill of speed, grip, and competition with physics inspired by real-world driving. Whether you're a beginner or a pro, a challenging track awaits. Start your journey with 4 distinct cars and 3 carefully designed tracks, available from day one.\nNow supports both hand tracking and touch controllers.\nMultiplayer mode is not available during Early Access.", "short_description": "MotorsportVR delivers a true circuit racing experience with full VR immersion. Choose manual or automatic transmission to match your driv
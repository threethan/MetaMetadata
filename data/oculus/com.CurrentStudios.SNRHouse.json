ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcxZJFMF-1fxLz8aVP-Y1k0wlQwNfPzABFl-G6_uHkMw&oe=6AFDD7E1"}, {"file_name": "Oculus-Screenshots-1.png", "id": "2934871646664543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75520122_2934871653331209_4306875857718849677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHNgjG3tuQQ7kNvwHp09DD&_nc_oc=Ado4UMiODPQo1QCbulUsg2b0xWuszcdVRl7mW6XGjtz-cqSH_-otjxrv5UT7wTyBTvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI6AjkpyjN5bnTJ_4Lr6gGrd4GlAsazwlbX7cI_Ut1tw&oe=6AFDB242"}, {"file_name": "Oculus-Screenshots-3.png", "id": "1624494821746935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031435_1624494825080268_1696240370691242191_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0mljX2PtsYQ7kNvwFATpzC&_nc_oc=AdqNQGT_Sb54GQc7XJc7YE562zth52OBVIoZHhbDChgUXzwfMaRo7cvunU-s4GijdZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrkDdQY4a9NhZ7aoIcU-9fGO26BzWpopD-HazvTsuV-Q&oe=6AFDCCC7"}, {"file_name": "Oculus-Screenshots-4.png", "id": "466032423164525", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_466032426497858_4370629542069459434_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVLMEPvRXVQQ7kNvwEpbJCI&_nc_oc=Adpt568-qWYkCBCwvSSdApNtmzwk7m7zkgSffSjMMD5--p_sJUOA1t5HwWagID8nTp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdx1f910RfT6TGOg6T6B4LKUc32hawiKJzPvh4jrhdwA&oe=6AFDB1A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SNR House", "keywords": [], "long_description": "SNR House transforms math learning into an immersive VR adventure! Step into a virtual house to explore signal-to-noise ratio (SNR) measurements and uncover how distance and obstacles impact Wi-Fi signal strength. Students engage with core math concepts\u2014ratios, proportions, and fractions\u2014through interactive, hands-on lessons that connect theory with real-world applications.\nSNR House features three structured lessons, each paired with quizzes to reinforce learning. As students progress, they can put their skills to the test in an exciting escape room level, combining education with a fun, game-like challenge. SNR House makes math meaningful, interactive, and fun for students of all levels.", "short_description": "Dive into SNR House, an interactive VR app where students explore math concepts like ratios, proportions, and fractions through Wi-Fi signal measurements. Learn and test your skills with engaging lessons and quizzes, then take on the challenge of an escape room level!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://currentstudios.ca/privacy?pid=true", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24605732605732281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254872_1934106747069577_4393937004111974463_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q66XqMl51MIQ7kNvwE3XQfi&_nc_oc=AdouvYh7xS4_YbFhvigXsUOlM02LZSYR_G4bn657KENPjzhwe4HzU9cjhxsq4hHgflk&_nc_zt=3&_nc_ht=
ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjIFwOTAElAudkz2KqNFEc8hAgxf9jCFai60d6tbzGPQ&oe=6AFC8661"}, {"file_name": "Oculus-Screenshots-1.png", "id": "2934871646664543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75520122_2934871653331209_4306875857718849677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHNgjG3tuQQ7kNvwHBHb76&_nc_oc=AdpBwQmHKuR1yrk4IO4quUDmjBorCUHueRcCZOJEuov_MhfzUnPKvxKR99s7MhOntkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9I9GG_2AsGXC2eCM02HuVQ0kf_xWZIbNP-5D1DbgVIA&oe=6AFC60C2"}, {"file_name": "Oculus-Screenshots-3.png", "id": "1624494821746935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031435_1624494825080268_1696240370691242191_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrdrJSLibT8Q7kNvwHZjcWo&_nc_oc=AdqG_gr4j_1vtH6hHsFVmcVAdGrMTkY5lxCQmj2qatsA5YZB0yahcr5rPGOnoeKKbyo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5O7M4XQldliEJQzNNSsQbzzXQdjZhMp5pZWc2ivyy7Q&oe=6AFC7B47"}, {"file_name": "Oculus-Screenshots-4.png", "id": "466032423164525", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_466032426497858_4370629542069459434_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVLMEPvRXVQQ7kNvwHtOoJl&_nc_oc=Adq7psm4EJ0Z0YXY9eAXa3EH5xjX31AG-mvB73KGwnF0klvIJXoplmKB3k0kgUrY5mU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzISLTT89rzQCTU6d13owHJiaO47WV2c58WufPhBnAhw&oe=6AFC6025"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SNR House", "keywords": [], "long_description": "SNR House transforms math learning into an immersive VR adventure! Step into a virtual house to explore signal-to-noise ratio (SNR) measurements and uncover how distance and obstacles impact Wi-Fi signal strength. Students engage with core math concepts\u2014ratios, proportions, and fractions\u2014through interactive, hands-on lessons that connect theory with real-world applications.\nSNR House features three structured lessons, each paired with quizzes to reinforce learning. As students progress, they can put their skills to the test in an exciting escape room level, combining education with a fun, game-like challenge. SNR House makes math meaningful, interactive, and fun for students of all levels.", "short_description": "Dive into SNR House, an interactive VR app where students explore math concepts like ratios, proportions, and fractions through Wi-Fi signal measurements. Learn and test your skills with engaging lessons and quizzes, then take on the challenge of an escape room level!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://currentstudios.ca/privacy?pid=true", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24605732605732281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254872_1934106747069577_4393937004111974463_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q66XqMl51MIQ7kNvwEY4k25&_nc_oc=AdrX08hxWFOwGmwmQRapDkbpyM3BsaI-5H_DlO4mJULLhkHTW36FTPa7GaiWQZ3no-c&_nc_zt=3&_nc_ht=
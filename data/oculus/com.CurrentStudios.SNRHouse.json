7&_nc_sid=6e7a0a&_nc_ohc=H8_hz4F76FoQ7kNvwEOZR9U&_nc_oc=AdkqVQxLFxL7ri-X93R41kM25kkuX_oanHyhh84mAyD_ggpFJnx3UWGc9JfocH1vREo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsgA2o6BKbYuzqzvXJRVpfLni52NWwZa6yXqdIlwcpvcg&oe=69A6EC42"}, {"file_name": "Oculus-Screenshots-3.png", "id": "1624494821746935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031435_1624494825080268_1696240370691242191_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tm8nvVCF7nEQ7kNvwGhpggx&_nc_oc=AdmnWPXBXiBFB57BnFTcCV2wj-ZgCuwq62Bd4JxCNgDrqP8f88NqRcub4kGuvxdua_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOBlzui1r6ZICPq56IdxU5WmCDjjirhNwFURy6Q9xFKw&oe=69A6CE87"}, {"file_name": "Oculus-Screenshots-4.png", "id": "466032423164525", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982488_466032426497858_4370629542069459434_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oSkg4Yq4KgQ7kNvwGawptg&_nc_oc=AdmKkc7zFtQErJuWLhk-Xw9rN858haRhiBRLM8-S51fKsj1QeoPO2xj3YyWmwCVxJcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftW_k10glLfI5yuMMjA-Tg-pLOTB-8MSnLH1289Ty94Dg&oe=69A6EBA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SNR House", "keywords": [], "long_description": "SNR House transforms math learning into an immersive VR adventure! Step into a virtual house to explore signal-to-noise ratio (SNR) measurements and uncover how distance and obstacles impact Wi-Fi signal strength. Students engage with core math concepts\u2014ratios, proportions, and fractions\u2014through interactive, hands-on lessons that connect theory with real-world applications.\nSNR House features three structured lessons, each paired with quizzes to reinforce learning. As students progress, they can put their skills to the test in an exciting escape room level, combining education with a fun, game-like challenge. SNR House makes math meaningful, interactive, and fun for students of all levels.", "short_description": "Dive into SNR House, an interactive VR app where students explore math concepts like ratios, proportions, and fractions through Wi-Fi signal measurements. Learn and test your skills with engaging lessons and quizzes, then take on the challenge of an escape room level!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://currentstudios.ca/privacy?pid=true", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24605732605732281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254872_1934106747069577_4393937004111974463_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvBT5wg8VQ8Q7kNvwF5Sdbc&_nc_oc=Adm6Li8PbIO7ezlDoVtPUAHCvjmlHGqRmLZRXu83FNyYcsRISOamNtoMP8HDPv2nJDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTW0XcwvXNCCSwvf00t-ZSjMm6n9nmRi7LXxV2spM_SQ&oe=69A6D600"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SNR House", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1731697920, 
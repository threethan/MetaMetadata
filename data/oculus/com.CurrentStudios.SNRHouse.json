ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjJcS2Zghx5dNeMjbzJt4PJYCSQEYv8HX_otfnKT-KDA&oe=6B104CE1"}, {"file_name": "Oculus-Screenshots-1.png", "id": "2934871646664543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520122_2934871653331209_4306875857718849677_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77iaqqOhIVIQ7kNvwHPrGqT&_nc_oc=AdrO2s3G7LvhWcZe4qRn6H_zHfQwEALP8KresRhgP2gvMhbwkYY8xsYYqLk7imszMIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVknrrTFKx1I0t_t9wSqoJraV9V8Ml1VwU3oIQ4gVDWZw&oe=6B105F82"}, {"file_name": "Oculus-Screenshots-3.png", "id": "1624494821746935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031435_1624494825080268_1696240370691242191_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-lG_wkdFi4Q7kNvwGSRmfe&_nc_oc=AdpbuectAd7_IJILIuCPzgpi2EMl1qItVQscPbRpeOloAXUrjbt209ycYSGvT2yrr1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX70EzcFHLBCbW_fbJs2SlSSRradPpMFyicDBqZXOwiBA&oe=6B1041C7"}, {"file_name": "Oculus-Screenshots-4.png", "id": "466032423164525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_466032426497858_4370629542069459434_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9sKFU1gRSQQ7kNvwFKekUT&_nc_oc=Adok2HCQwFpFX8bN3_tmI_GHBNt2EqxabT1_7ysHbUZqGFlpiU4PRwaAF0Qwzh5KDW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVm9PcMp98vDLPE19q9tsBA5NsgCcI4dnBZJ0zKX1zU6A&oe=6B105EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SNR House", "keywords": [], "long_description": "SNR House transforms math learning into an immersive VR adventure! Step into a virtual house to explore signal-to-noise ratio (SNR) measurements and uncover how distance and obstacles impact Wi-Fi signal strength. Students engage with core math concepts\u2014ratios, proportions, and fractions\u2014through interactive, hands-on lessons that connect theory with real-world applications.\nSNR House features three structured lessons, each paired with quizzes to reinforce learning. As students progress, they can put their skills to the test in an exciting escape room level, combining education with a fun, game-like challenge. SNR House makes math meaningful, interactive, and fun for students of all levels.", "short_description": "Dive into SNR House, an interactive VR app where students explore math concepts like ratios, proportions, and fractions through Wi-Fi signal measurements. Learn and test your skills with engaging lessons and quizzes, then take on the challenge of an escape room level!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://currentstudios.ca/privacy?pid=true", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24605732605732281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254872_1934106747069577_4393937004111974463_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjD2f0tnvJIQ7kNvwHPBcNU&_nc_oc=Adr6EIpzxhSfsszY1EXIkck3xtduhXiNkpCXPmAx0pC4HiUxsabIyl7lZo4jlPQKqQg&_nc_zt=3&_nc_ht=
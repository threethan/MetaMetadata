r what you see on Feed and Stories.", "short_description": "Bringing you closer to the people and things you love. \u2014 Instagram from Facebook\n\nConnect with friends, share what you\u2019re up to, or see what's new from others all over the world. Explore our community where you can feel free to be yourself and share everything from your daily moments to life's highlights."}]}, "developer_name": "Instagram, Inc.", "developer_privacy_policy_url": "https://help.instagram.com/519522125107875", "developer_terms_of_service_url": "https://help.instagram.com/581066165581870", "publisher_name": "Instagram, Inc.", "support_website_url": "https://help.instagram.com/", "website_url": "https://www.instagram.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nn", "de", "hi", "fi", "kn", "ru", "sv", "ko", "pt", "nl_BE", "af", "bg", "mr", "ms", "el", "en", "hr", "pt_BR", "it", "bn", "fr", "hu", "ta", "es", "gu", "en_GB", "fr_CA", "pa", "te", "vi", "zh_TW", "nb", "en_US", "th", "zh_HK", "si", "uk", "ja", "ne", "sk", "tl", "id", "pl", "es_MX", "zh_CN", "da", "ro", "nl", "tr", "ml", "sr"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27301224542826217"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974662_1076455733971015_9075806430122601394_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLHoeQGklksQ7
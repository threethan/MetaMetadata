_9Y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrbMB4FhVcrSticqk54FzUMs5BR-qUXdY2VxdXTp5BFw&oe=69C925EC"}, {"file_name": "image_056_0000.png", "id": "1056720046242016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982609_1056720049575349_76842352665110716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbdtMvRoPXIQ7kNvwHz4D_-&_nc_oc=AdpcnI3VOxHV_qxQfs7RanDbXtdpYLww8UOyamyYkKi2nlK6XmiOJ0ZB4OXMwwnoFxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhncLbbYZbEn9CZxVpRJ6dX2FGRxh455x3YzcO--MSOw&oe=69C913F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Collage", "keywords": [], "long_description": "VR Collage is an immersive virtual reality app enabling adults and children to explore creativity through 3D collages and installations. Users can easily create, edit, and transform artworks using hand gestures instead of controllers. The app also allows for close-up exploration of famous masterpieces, offering a unique, interactive way to engage with art in a virtual space.\n\nThis is an MVP (Minimum Viable Product) program where we have implemented only a few core features. We have many more ideas for the app, but first, we would like to test whether this concept resonates with VR users. We would greatly appreciate your comments and feedback to help us improve.", "short_description": "VR Collage is an immersive VR app enabling adults and children to explore creativity through 3D collages and installations. Users can easily create, edit, and transform artworks using hand gestures instead of controllers. The app also allows for close-up exploration of famous masterpieces, offering a unique, interactive way to engage with art in a virtual space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axiio.fi/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Axiio Oy", "support_website_url": null, "website_url": "https://axiio.fi/", "category": null,
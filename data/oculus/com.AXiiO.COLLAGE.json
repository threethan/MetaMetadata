LH10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-HJmniW5oUFBpqAVg0uHXy0HKuqKQiwcucUwqYII-3w&oe=6A5F70EC"}, {"file_name": "image_056_0000.png", "id": "1056720046242016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_1056720049575349_76842352665110716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwLzAK0cLd8Q7kNvwE3S_tV&_nc_oc=Adq9u-4LlbzXiYhec1tvrZTwSvTbbJAjrh0sHO2W07mOWpbzC17nlGu_RXNkl7-W3lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeWGooNRY11hZ4cu7XXsO3nDuwC4nO_PbjgM8mZOuL1Q&oe=6A5F5EF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Collage", "keywords": [], "long_description": "VR Collage is an immersive virtual reality app enabling adults and children to explore creativity through 3D collages and installations. Users can easily create, edit, and transform artworks using hand gestures instead of controllers. The app also allows for close-up exploration of famous masterpieces, offering a unique, interactive way to engage with art in a virtual space.\n\nThis is an MVP (Minimum Viable Product) program where we have implemented only a few core features. We have many more ideas for the app, but first, we would like to test whether this concept resonates with VR users. We would greatly appreciate your comments and feedback to help us improve.", "short_description": "VR Collage is an immersive VR app enabling adults and children to explore creativity through 3D collages and installations. Users can easily create, edit, and transform artworks using hand gestures instead of controllers. The app also allows for close-up exploration of famous masterpieces, offering a unique, interactive way to engage with art in a virtual space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axiio.fi/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Axiio Oy", "support_website_url": null, "website_url": "https://axiio.fi/", "category": null,
7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfJWLfEEO3wQ7kNvwH_5OIC&_nc_oc=AdpX02yXDhEwrow9VYol-WhwtuZvm59ArWW0phkCsvxfawDwy9ClK6IW8ej211P4618&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuMERRK35WwFciIyNsBLG6rpIvGd2OOfbStJbTRipedA&oe=6A58E775"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvlNJ8lIDeUQ7kNvwFqUKBw&_nc_oc=Adp1COPjbOWEOgGXwi6ofhrq9uhr7XRiWV-LD9NX-T-KYjXEXghgEawPdBx7-FIOhgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFDS6vq_yTJ6gN-ULWF7_qGNEk681Ek8SVCEs5eNum8Q&oe=6A58E4B3"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkbYJFheegYQ7kNvwFlJpUu&_nc_oc=AdqFslEmTUzHYNpHsq9Ml0gNjUWrNCue_1WvFjvDI4xy205nO-u0zvMByLIrmQVZYJM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeOMf6DH-Ze-TNiWKivfY7x0fnv7QjmaW0MaQm3Nirag&oe=6A58C691"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MubOSqQc_0sQ7kNvwFuRQ8d&_nc_oc=Adpo9zFOAcNtU9GVUC5pkoOky2wTQwlDqwNTr6a2PW_hmCHvD9aUcEwzn9FNpQM3-Kk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2gQQ1n2TeT4U0OpWpMNCvkYAv6wZXAAuGFI5I5Ft-qQ&oe=6A58E6CD"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UI8sYIEtPsQ7kNvwFBctkS&_nc_oc=AdoM_XrhhfOHRS1IozDSHB2wWzuu6subtuCZx7PugJteim_nEUvkLyxZIX1GEcALD5s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlfBHAVcDu7Zl07nPWZVux3-Jgu5LQB7oPb21SKGnsBA&oe=6A58DF7D"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPFxJW46ftUQ7kNvwHF8rSA&_nc_oc=AdpIXMD3dqmcy0Eh1xg3j8Q0VUojhJEcERrSsh6PqNEXna96gX7hKTp3S68IUXqaD6o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl2PRCDQfEEPkjkan3Hmd-Uyjk9VRkSVYPaH-IHamRGQ&oe=6A58C10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRPOrrbNxs0Q7kNvwHgCGlu&_nc_oc=AdrW1RLCLRuAly_CEPsXZo7s8qT1C7En1tQO7JzWnmaryT0UmUXEoTqL69QwDmgGhdc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBObovgqALs3F2qCKyP1MdC4qM1LEskAofofTV1kWa6HQ&oe=6A58C992"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkZdhHOlf9sQ7kNvwH71zbV&_nc_oc=AdqknUaHVlebz0qioqg3uEUqGUlCzD11DJTaNcBTRRnI7_FBk_pXJyByWrZFE2joHdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__pPQNRpFUvGLn-jkRptW1fcG36YKeAd2a_gEpHLF5Pg&oe=6A315A75"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1D1_cwYDGcQ7kNvwGiYxs9&_nc_oc=AdqdP9Iuxsh9yIdACwDZQY8RqOVKzD_-x5vH6RDeHZjx0ZW5MnjL1mZ3AK1-bYPakRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6psG_XNZBUYFizDK5OnJw4kTgUOHQqvY1xO3QPf_eCQ&oe=6A3157B3"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAn_p9QOnf4Q7kNvwGwIVbz&_nc_oc=AdoY7Op5onlrfULsbOaK4LLY203rBabMsr4oHyv60czhl6jPBky4iX3DkapFA2e3TGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B56MpWFW5d134VJqM-3YbOBkXkkWqQFSruI348IgxGA&oe=6A3171D1"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25DwGchoq4cQ7kNvwFZeuAP&_nc_oc=AdoBK54w4vCQDOxPQdMIOukHSsqoFEiGi7j1-Ohj0J05jwu_wYkV5nDBE-LkopcupPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Trq6RQ8Mw3Gv9486yzVZiErtoZJNQieSDitH6p2QPWA&oe=6A3159CD"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBSSChP-jt4Q7kNvwFbzT0A&_nc_oc=Ado_mWNeXtNBgd1hw8ce6qo1sFzHu5PjThYQzVHED58wNN5mpUiOFnNGFFYcfXku9xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2mXzSN8SlOLC0DzFzUOsFvhWYBg8ya5U3ldg9AhjUEQ&oe=6A31527D"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMENled7hAgQ7kNvwGnlA-k&_nc_oc=AdpFXlrq6upJXwE0ydM4c9EzDLS__zR3dVergOlx37PhQVKSsef1W2V1i55XI-7Rmic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NI12OmVucfq2XtkujmSKB1YzzS_aTR70NZVYwVoMIPQ&oe=6A316C4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmGhAFZ2ukwQ7kNvwHKIrtj&_nc_oc=AdqWIHwPHOlECINmBWib-DTF-jqQ9b5YfqFpcWtRSLAzXnF8fDeGvv60cTp_jlfsssA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wcgVwdFESUdqSoVvvft34mutRwaCJ3RyP16m0Czn9Nw&oe=6A3174D2"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
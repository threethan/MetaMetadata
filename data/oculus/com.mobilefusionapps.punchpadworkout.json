7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSKYHrmlHtcQ7kNvwHBCMB5&_nc_oc=AdrJZLacFh876m88tFwdrsqwCesDrHjGJ_AJF6t5eKc1ENlSFB3-kZJMx_OxlfaeWl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2YvaMN5_b_FW-dXu_IPVzVC5osnCuzcXVIoEU-pPLcg&oe=6AF71B75"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG8kXvhOLwsQ7kNvwH7QjFE&_nc_oc=AdpArExBNLEydqjhvVyNK5e7JtoRadMbfYVKaEW-QVMGFSYf3pWEurqMwgXnb5efQX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMPNWLNJv-B9K0Ap1Fk-sltRu5vTokVmR5yooGkCiT3w&oe=6AF718B3"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g38l6TxxZosQ7kNvwFK_Aes&_nc_oc=AdpIUcMP4ZBKD3MyqGXJSHXzCE9a6XuMHh9b8aTC_Of097CSckbm5nsmfQBsJWUCR2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8Kgbxv6kX0Eq57ti9hFZg-h5cfKry_LHCfj6MTZ9aA&oe=6AF732D1"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixsnJClHuOEQ7kNvwGHhpEg&_nc_oc=AdohxZf1pTD1yiXmtGPDOZ6DdbvCc5zZY2cr8g2eQYMK4rGhdlhsVgLM_qdcnxSL1do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQftPwnCGHo1GE1Ti2eYx55v5MGM5coBUhIZvbaS7MNg&oe=6AF71ACD"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUPoiRUm-iMQ7kNvwEj0-5t&_nc_oc=AdriF7blL9-9aS4KGkw9SlWxpp5sAA-gBIVXIBiDENXXdUYLBr89OjqeRx-Ry4JdD60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBxqLWG14LmMHOMTC_8zclISx8522z-59BsxnxW7oEfA&oe=6AF7137D"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFTdHehScvoQ7kNvwH6Y5J1&_nc_oc=Adqu9Z37BMZpQvAXl_dkqYPWkRPSdgYE0SJ94uhpUFEyIwNEVtY04mKepNI3qBOyWkU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3hD81RiLcnMGEk3x9F-BR1-rSFhhGH39OxOjrdPMNdg&oe=6AF72D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx9LpsaY0psQ7kNvwG4ES4K&_nc_oc=AdogUH9x41sKZabDXa9W8KdHui5Zr1HUEJF3Q0G94xmlMPTblWZuC0PdERr8_sfzxpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyE5WZZwm6ygHfYqJPq8ABbLBAggBG48bp8MKpGMnXPA&oe=6AF735D2"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
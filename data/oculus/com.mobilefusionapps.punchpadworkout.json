7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i0_ZYZrnhUQ7kNvwGTSfi7&_nc_oc=AdqD1ps9sHzFcSLDg75PgScyt78GGAIiF5xPXgh9D_cOGUh3kN46msShvXgGJ_oJvkM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXWznahndXpWYFCroGA1EkUTyypY-dw_r6JTLdKS4r-g&oe=69C53F75"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guZAXrItYs4Q7kNvwES-UJ6&_nc_oc=AdpyIs6gX0iybrf-2AuOsW7fWGbgtcITcWfo-rAGPn6_bRCbmiCd80ekkXwR_c8elE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9csf3MYx0qh64gkAXSpCEmLInCd1A59N2ApCzpLq12A&oe=69C53CB3"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKEUCObbCP8Q7kNvwFCst6_&_nc_oc=AdrmANkjK2zsCWmFLG4coJhDi5KtsAtFBiGEAsSq0lzNP4CsnJPgykosYsaZcPq6knc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUZNjpDGmxkNAfFi1rC9DZvA4suWCwl9bIL9JRw9dHXA&oe=69C51E91"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldyb4JJ-9gMQ7kNvwEawhnZ&_nc_oc=Adqg0Pjb2TlEZEBXsegDalNtzDL_9CXE-3OgmhcWgpaMlH9lPY6z7DHNqLOsIb4hphQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDe7lwtToaDdPQ5psPY84SAp-XLE7L6ABs2uALDEvymA&oe=69C53ECD"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezoNkfN9LJgQ7kNvwG8JXOg&_nc_oc=AdqqjQPWo6ca_1MPGZwcm9g8mYafv8XdSBTIB9inh9dRCVH-kKUOLdydPbds--QUa9I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuKvShQSuk5emaYAF8wH2phFk6Q6Cwjp-9dxohmjiesA&oe=69C5377D"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y-Wt84FeP0Q7kNvwFrOhhZ&_nc_oc=AdqxZHUqZv06lJjvhgktqBRfnvk46cxuqiQNB3loyXzEmVi46b5rlRIyoJjhZ2eMriM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1pCokngXANDz2fuQ8bc2Kf3UpPUjwW3-8CI_oLHxlBg&oe=69C5190C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf16wvx5Yb4Q7kNvwHDSIdJ&_nc_oc=Ado7olutO_mv3_L-bnIpSew6L-42yLVxUdsUCsVRT0ukMEXqvg-C9tt9kUV53L7eY7s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwxbVoxla4ZbVVBd16pqj4NxHdWfuF24GyHUJGTpJ--w&oe=69C52192"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
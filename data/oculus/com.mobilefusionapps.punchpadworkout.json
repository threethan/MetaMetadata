7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSKYHrmlHtcQ7kNvwEK0D0H&_nc_oc=Adppk6ng5H2oBiHhF_x2q0RQTy8abqM-LHvB7AU-jsWVrQT58AKSDqIZErV35meQtWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDCN7CKmiFpGjdb7zwwt2SzFBau2B7L6cbm5yr8v-ufQ&oe=6AF8A535"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3sVNR2Fl_8Q7kNvwHoi0kF&_nc_oc=AdovxmtSKWHpImbjW9AnWagSL9oeCEFg6ZwTpwFKRSJwTVFfoe8ola5EkiDzHaCEs-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH99TMBeLcHMcUvc8wUIhhHQx1xdoXhORIqEaau8mX9w&oe=6AF8A273"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g38l6TxxZosQ7kNvwGV6htR&_nc_oc=Adp09dADVRPLaKEVIzyvTjL80j7bek0ZDddb140bCnYTQi_31TMrd3WHxUdAUNzL7ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCZivuxTZDT3Se5JnYxms9Wt9d9NQsXDwuK9kKcbCKYQ&oe=6AF88451"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixsnJClHuOEQ7kNvwFuQY74&_nc_oc=AdrZJruME1c8tcswrW4M-DnRlV9L2rffDPQNdnH9YhDBPNgD8RG8dWOh8QkPAp6A6Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0IeR8FS0G6f_hD8YnfHumE6dMabzzfr8OyFYCE-O35Q&oe=6AF8A48D"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvXKenz7K_QQ7kNvwEUp-x7&_nc_oc=AdpxHtiXXv4PiAz15t3yz_5nuP3NaVE7cuhvugGP3B4xnmp1lZXVxrgZ3XLxYxVWbPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU4NvU279jQhB40FMWp3-rxqdr6H6PnJ8WW0tbISUm1Q&oe=6AF89D3D"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFTdHehScvoQ7kNvwEqQbiX&_nc_oc=AdpRx0CIS5L0YHlV1XS59EBv31rd3EtNiJJ_B1M_4fFITe5KGsD7KnrGiumUsRcexr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuwNqOEjkTh2RSyXYw7X4Z-tyteUdGVcxPHtQ3VRd8VQ&oe=6AF87ECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2OIc-knHfMQ7kNvwFM5x1L&_nc_oc=AdoELwseICfqHk-pYj0GQK6OYP0TgXRziETKEv6ZqWqTUvw53IK5nXaCijlNE8MSeAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyEcJc2LIrxPRccrm48Ahdk6EA-WKa3B9642Gwt-hv2Q&oe=6AF88752"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
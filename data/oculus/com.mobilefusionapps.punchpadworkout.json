luscdn.com&_nc_ss=7a30f&oh=00_AfywpDMamcTvxuDRV_m064JfnCwhtR_l1vRfX76bxqomPQ&oe=69CE71FD"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgVFeECVlaEQ7kNvwHRQAxk&_nc_oc=Adr7WHM1xPRBmjkmBChTyZhRm5hbmCdRy-z8_EmdavxtBbrHbxv_1syt43FxRP9PPcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMmgGVdgDlL2cRZ7hByTzdloQlpIA5yMxeOK53dKR3WA&oe=69CE538C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO3WLPgtd8IQ7kNvwEsl9gk&_nc_oc=AdoAOu768Gz-kDgqR_G9BS86I6yhPx21TSQOo-uc455FsTvG0ESCcj7RbDwUlhhHUVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyYAUhVzht3NPP0ITTJP6sUlg4xZLnTN0AyChkzW9R_g&oe=69CE5C12"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
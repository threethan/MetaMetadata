7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hVyjx_sZW4Q7kNvwF82Az7&_nc_oc=AdrR7DBwkJDwvR9p25E5izXvPe6PCGvViOezETXg593fnZNCAnnx3ZzaLpeyCXCWIHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ38NZ-7tu6naiX8AeJwLVzSjUSZx3CudIPiQYtHX1BTw&oe=6AEB3DF5"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PibuZRdUYI0Q7kNvwFR3FWK&_nc_oc=Adq7YvlggFGXeW5kSBqm6gP6AJRh5_Ldb8CGVL7_PvC0UozHaeIsu-krOtv6JuvgN20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFVqctqo0fqDaslcGAXVseYuCojhjglvF7rb5Yk24uHg&oe=6AEB3B33"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89Day-TElG0Q7kNvwFzoSE2&_nc_oc=Adphavv1nZTm8ihKnXmmLGZn0Z2nVCsPFGxDivhrxzOmmQh_4esfSipfwXC2Wm3uRHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuQtV4mbt2mVKmkEkjXfqKDkE_4PPb-slR7ocjI0Tx2A&oe=6AEB5551"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FUw3SKp01IQ7kNvwHV8s58&_nc_oc=Ado5DySfXTrL_bk6uKPj73IJ6M9d6UbdyjHaFfV2w0RGCSF9vU-W7dlk55gLqOz-mRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcAC5MTeIPGhnAzlPqsN9-FZ6ni4hnxanJD8PXE_HU2g&oe=6AEB3D4D"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNhfhxRXg74Q7kNvwGYnVrP&_nc_oc=AdoipLqhJR8neAo3p-dcsH-y_EN90swB3SKTmmM1G75_oKwKY2z2U_pGOrsjFaoCxSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkOgDz-Re50gPQdgSpjGQiib51hKuu-D2pfpR8hECgjQ&oe=6AEB35FD"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnsaBL0EvMUQ7kNvwEr2XMV&_nc_oc=Adq3_isDmKd3kfBkK2czC219c-EIttVEre6-PH2PKT9WpsD8Rlg0HqRMop3tMc8CKmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG7_MrktQGLZmfolGXbhaGZVjbx3Q62BDl-s2kqUgb9w&oe=6AEB4FCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9hoyoK996gQ7kNvwG-75gD&_nc_oc=AdoRwIJet1H0xA4_DHCmvtrip6Ss_kgrjQLfpB7F6_1guceHLnPK8-V_1q8hVp-KUzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3hwtM3hOsMZMhDn-eeUae8-xUdS5nFVjkKoDOEBbZ8w&oe=6AEB5852"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
7_299549756521887_2335884631406698694_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogn2xMpkQpgQ7kNvwEA8V36&_nc_oc=Adp1dVv94k1JzlFGkoUYlw88CTQLX8xKjo1sNWQtaaKHzmynlWC8GRumRnoi9v3RE5c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RvHKhp901ZAGhEhMR9fX5EScM7A75ZgO7fl9v277CJQ&oe=69F606F5"}]}, "id": "869844701543038", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "922059606331494", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982566_922059612998160_6232311056976096181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rFy4CBN-xIQ7kNvwHjqFgt&_nc_oc=AdqhSAozd7q1JIzjeE8pcS-FMzCOG87MWsEpwBO3nczDt78F0fveZWLfer9gDJy9BBo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XmHSjlnf34bTgHC2frqwbosLOJ-ZMx6TrvveQ5-0D6Q&oe=69F60433"}, {"file_name": "2.png", "id": "1422982321656480", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75297582_1422982324989813_2452206628982652075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdfLhnTRivkQ7kNvwEBuXKL&_nc_oc=AdptvetcHBGIcro0IE7n4Y2gtxW2kdYrp_QsEm6ydGAstJbNW0UpfGzPAndAPDrLRwo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bgaIXhpI6QD8Iyw5nQ92IsbGztqIQT3tXqWPAtTSdjA&oe=69F5E611"}, {"file_name": "4.png", "id": "1162817998221124", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035375_1162818001554457_1793589626222242566_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9R_0_8FWO4Q7kNvwHarVJh&_nc_oc=AdrO5J6McfMREzt9ekFXPN0aRVcqv0fQplH6650pDXxzXo_G99bkmwTSUqfHfoc-nwQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2P3Z9hwbYZsuzIAynC3GCecDNe9THrMdPoMLs5cU3d7g&oe=69F6064D"}, {"file_name": "7.png", "id": "1414963546052329", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031569_1414963549385662_701169076179990821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQYzu7-yMY4Q7kNvwGmEfTl&_nc_oc=AdrYHNDhfZp_Rql00ndklYGVbwSKf1S73tDNPhY9OKvGjr-pEzlXyGCdMt2aadjBS-o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UB9viWXKrpUlX7xQ0todVBBzrZl9t2LyZO59UcZcZXw&oe=69F5FEFD"}, {"file_name": "6.png", "id": "964787705254545", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982548_964787711921211_2506071065898281157_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILsezHmcuu8Q7kNvwFcMhBA&_nc_oc=Ado3MxdLUNcwaqK07r5ndD9O5NZYlATYLLsh68eqeYsC4lb6j20urn_MBTibvDaUs70&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kcsJ87emb4vptTGWrNU7DfoLJZ8xRgrqAjIR7NIFEfA&oe=69F618CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1416246045676727", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031451_1416246049010060_3070331786932506366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLpss42Jm7YQ7kNvwFJ0nCO&_nc_oc=AdoMTUGabe9cdc1QMCAyZpo1KgsJSeR8T2yUtxO_1GPKS4ayLFhACXOrUYSaqvStT3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GRBex_1x2PVaIQCG-tRmC0LXA4DlztNVyxJGh8bVacg&oe=69F5E912"}, "display_name": "Punch Pad Workout", "keywords": [], "long_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order.\n\nThere are 5 available modes, of which are the original 'Combo Punch Mode', the 'Punch Dodge Mode', 'Coach Mode', 'Heavy Bag Mode' and the 'Music Workout Mode'.\n\nYou will receive points for each punch, based on how quickly that punch was thrown. If you complete the combination correctly, you will receive bonus points based on how many punches there were. If you get a punch wrong, then you will not gain any bonus points for that combination. If you successively get combinations correct, then the combo number will go up and if you get one wrong, then the combo number will go down.", "short_description": "This is a workout plus memorization game, where the player must punch the pads, in the correct order that each combination is called out, over 3 rounds. At the end of the workout your score will be added to the leaderboard. The faster you throw correct combinations and the more punches you throw in total, the higher your score will be. You will need to memorize the combinations called out and throw them as fast as you can in the correct order."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6831823400230593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7557602020986057", "version": "1.05"}, "id": "1672616899816714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinar
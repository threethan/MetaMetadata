_ss=7f20f&oh=00_AQSW7Hdae9ozsWDfX2mN7K8qr6JhFWH_EDyQRipm0jRRwA&oe=6AFC7277"}, {"file_name": "4.png", "id": "1046360474713341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827987_1046360478046674_354655786941504341_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IukIwzq-ahEQ7kNvwEGbZTn&_nc_oc=AdoanWBixTDT5kTFsq81Bh7STtFgbbFRHwTxSNLQfpcMo_TuJmIVqDC2inWpRtZMIG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLpU1-IXXftmObQWI95-8vF4K9kmgrvNvWX75g7x3rLg&oe=6AFC689C"}, {"file_name": "1.png", "id": "1045191751273539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1045191757940205_8448661037750802038_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCsW85gdm5MQ7kNvwEMbGPq&_nc_oc=AdqPNZXdiaBYMqJkyUvS3rDggj_dBQTHfxSL9zozCs6sTm44cLpJaZAEHYOH-xMvksg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3IPA5Qa6rTOQcT-IK-_i2-GAJvwXExxN2O_UwEtCQjg&oe=6AFC8345"}, {"file_name": "Sc5.png", "id": "4514297245516020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_4514297248849353_7789253416768013723_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmHG2fwfghIQ7kNvwHPf5jt&_nc_oc=Adq0-bsFpXjaLX34GGvAg8f6INYnDiG_RC_pJhNA_vzENlFGpa3lD0D-u7d9DOQ7flo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDImqJvZTCTXBa4vMXhw-9ZfmAy-mTlHOsU8BOEBwo2g&oe=6AFC73DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-07-03-12h21m55s834.png", "id": "1566976488122000", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823351_1566976491455333_7572237726658224107_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlccrP8EEiUQ7kNvwGowON4&_nc_oc=AdqYV3wu85wnckMpgcnlPFWFfsStLXvy-ay1P8CgVj3eYI-dXiMWQwMxdHqXtIIkqXo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOw1ZPBKbpu2Q8-203iZui4IrPhHf59MxWrF8bgDhiYg&oe=6AFC66E6"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "training", "motion", "fit"], "long_description": "**Jump Rope XR** transforms cardio into an immersive VR fitness experience.\n\nEnjoy the feeling of jumping rope without a physical rope, using intuitive motion tracking and engaging gameplay designed to keep you motivated. Train longer, burn more calories, and make every workout feel like a game.\n\n**Why you'll love Jump Rope XR:**\n\n* \ud83e\udea2 Experience realistic virtual jump rope workouts.\n* \ud83c\udf0d Exercise in beautiful VR environments instead of the same old gym.\n* \ud83c\udfc6 Compete with players from around the world on online leaderboards.\n* \ud83c\udfb5 Work out to your favorite music for a more enjoyable fitness session.\n* \ud83d\udd25 Burn calories while improving your cardio, coordination, and endurance.\n* \ud83d\udcc8 Track your progress and challenge yourself to beat your personal best.\n\nWhether you're looking for a fun way to stay active, improve your fitness, or simply enjoy an engaging VR workout, Jump Rope XR delivers a unique experience that combines exercise, competition, and entertainment.\n", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & cardio training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://visionlab.pro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Lab", "support_website_url": "https://visionlab.pro/privacy.html", "website_url": "https://visionlab.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "exter
_ss=7f20f&oh=00_AQQHy244DBAdWkPp2u5uhi_CkNU3QNEtdt8IxD3WtqTf8w&oe=6B084FF7"}, {"file_name": "4.png", "id": "1046360474713341", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827987_1046360478046674_354655786941504341_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzUlCf1VJmMQ7kNvwHCYSNo&_nc_oc=AdpEVbF6rgxII2KBrdgCeMX-U1dYVF6cKeBgIc_rqtpI07AUuR6CbvKE2zJ3NmQjrFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuGTsmTbpX6csBAheSQvyGw0rLcvKYncvb_tUBnfxvXA&oe=6B08461C"}, {"file_name": "1.png", "id": "1045191751273539", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824328_1045191757940205_8448661037750802038_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK1VRlMl6TkQ7kNvwH9HjkJ&_nc_oc=AdqSmZVmrPEX69BF0UTYxf8VSbNY7UTgk-RAY4837zlLIe0DnB673a0xtxhZR67jsjc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuycA6P1r7FMhzNs4YLMJ3N_n6hVIlaMFncLlW_UXgDg&oe=6B0860C5"}, {"file_name": "Sc5.png", "id": "4514297245516020", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499304305_4514297248849353_7789253416768013723_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoXH1T9ZaVEQ7kNvwGW9BkB&_nc_oc=AdoK1D4RF-DMT21KRWJe4xKLhsBo6bdnBGpbbCRqbvEUye3ve5Eu8fQeipbeV-fyN6c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgEYK1wY7h3jTfKx91GKfKiE0rgNwNfl5PAwL-NgbVGA&oe=6B08515F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-07-03-12h21m55s834.png", "id": "1566976488122000", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823351_1566976491455333_7572237726658224107_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulDFYR8T8m4Q7kNvwEZ_c_p&_nc_oc=AdqNBEiyqdENJnfxkuRumf8eNk6QB6YIx-WqfF4aqfslbfoqAZmGEjPwCO5xiJXzQnI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXBQYpw-QKjerZPicha2MzirZfM3e-blw-6Gfkhcv1vg&oe=6B084466"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "training", "motion", "fit"], "long_description": "**Jump Rope XR** transforms cardio into an immersive VR fitness experience.\n\nEnjoy the feeling of jumping rope without a physical rope, using intuitive motion tracking and engaging gameplay designed to keep you motivated. Train longer, burn more calories, and make every workout feel like a game.\n\n**Why you'll love Jump Rope XR:**\n\n* \ud83e\udea2 Experience realistic virtual jump rope workouts.\n* \ud83c\udf0d Exercise in beautiful VR environments instead of the same old gym.\n* \ud83c\udfc6 Compete with players from around the world on online leaderboards.\n* \ud83c\udfb5 Work out to your favorite music for a more enjoyable fitness session.\n* \ud83d\udd25 Burn calories while improving your cardio, coordination, and endurance.\n* \ud83d\udcc8 Track your progress and challenge yourself to beat your personal best.\n\nWhether you're looking for a fun way to stay active, improve your fitness, or simply enjoy an engaging VR workout, Jump Rope XR delivers a unique experience that combines exercise, competition, and entertainment.\n", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & cardio training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://visionlab.pro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Lab", "support_website_url": "https://visionlab.pro/privacy.html", "website_url": "https://visionlab.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "exter
_ss=7f20f&oh=00_AQRdlaKzz5PYjlSt9cicLOApS0p2cfVzPFXw33KzMcLDTg&oe=6B05ACF7"}, {"file_name": "4.png", "id": "1046360474713341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827987_1046360478046674_354655786941504341_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzUlCf1VJmMQ7kNvwFWB8Ke&_nc_oc=AdpiOfB_ytIZrAfgzRciNYqWVFWN0MGzWSwczP3zlfTsMFkqLmBuSh9HClDOKtWznp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl-SvnRRG7KYSV3C4nGsU9UdRfARTdFyPhErrTDJ8-aA&oe=6B05A31C"}, {"file_name": "1.png", "id": "1045191751273539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1045191757940205_8448661037750802038_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqlFml7sSiEQ7kNvwEeGFQa&_nc_oc=Adr1oPg9TUTd5QvukKXjy-EYV5w7zzVgbUjMBvfoklfQC8uhrQ3MywGU8zvPzfUogxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnzZNLT1Qgq7KA0vmC2HVcJ-uw7XcAGwjLgK04w7KbBg&oe=6B05BDC5"}, {"file_name": "Sc5.png", "id": "4514297245516020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_4514297248849353_7789253416768013723_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoXH1T9ZaVEQ7kNvwEk4RRV&_nc_oc=Ado4dWl-LwRSqNxWsUa-NAzEXWZ322PGlma62PqC5CVltC9JhIEBNC328viBTMmvvk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-TIIwcL8lpAmB9TIjL88qOonXenGmEUyU5Vvuug5sxQ&oe=6B05AE5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-07-03-12h21m55s834.png", "id": "1566976488122000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1566976491455333_7572237726658224107_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulDFYR8T8m4Q7kNvwGokE6c&_nc_oc=Adr7c1fFhD9BxSG1FNWjFY9RCI2lDIsjr0W6q5U4uRkB-Q-17gAOIlNXJFJ8hLFYi-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRqQIaGTvu250xYyyjo_3v2BeiuPraFsZSYl9ZX_gHSw&oe=6B05A166"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "training", "motion", "fit"], "long_description": "**Jump Rope XR** transforms cardio into an immersive VR fitness experience.\n\nEnjoy the feeling of jumping rope without a physical rope, using intuitive motion tracking and engaging gameplay designed to keep you motivated. Train longer, burn more calories, and make every workout feel like a game.\n\n**Why you'll love Jump Rope XR:**\n\n* \ud83e\udea2 Experience realistic virtual jump rope workouts.\n* \ud83c\udf0d Exercise in beautiful VR environments instead of the same old gym.\n* \ud83c\udfc6 Compete with players from around the world on online leaderboards.\n* \ud83c\udfb5 Work out to your favorite music for a more enjoyable fitness session.\n* \ud83d\udd25 Burn calories while improving your cardio, coordination, and endurance.\n* \ud83d\udcc8 Track your progress and challenge yourself to beat your personal best.\n\nWhether you're looking for a fun way to stay active, improve your fitness, or simply enjoy an engaging VR workout, Jump Rope XR delivers a unique experience that combines exercise, competition, and entertainment.\n", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & cardio training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://visionlab.pro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Lab", "support_website_url": "https://visionlab.pro/privacy.html", "website_url": "https://visionlab.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "exter
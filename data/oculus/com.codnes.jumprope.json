ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_1155505096302855_3944534447470340183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_GS4qB_wJQQ7kNvwH8G2AK&_nc_oc=AdoR1UiAwduP-JAuEDcZ70uZpHoQ1wu8yXO1Cqnn_IXXrxK2FnNzzLj9LL_m2Es-04Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB739fg-d51a8L-GF1K6Zlf20R_1F_gvTvSeMSxk8aCeA&oe=6A6A0C4F"}, {"file_name": "4.png", "id": "1157345302527940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392305_1157345305861273_8507109329514924873_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVP5RgupCqsQ7kNvwGUogMQ&_nc_oc=AdpFtgQocCd_wFad6pn-NDDk7XnHJbSTdNEJ7Ug962H6R5mbq1XDWZnH9I8G8P_GGWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx6MGbIqw9nqWwKAFxXiePrRptZZiv91YpyIoNWDaVvQ&oe=6A6A0EDD"}, {"file_name": "5.png", "id": "1334009037746801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_1334009041080134_4260584670607588883_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfpDRoRjzrQQ7kNvwHnVvSe&_nc_oc=AdqGWCbV20S8Mqzq8o2BpGYyRYkDi7z17onz_pF5_CQU-F4c1OTFW7-DlhQTB50XCJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASeGwR-7lKKOr6Hd2Q1DAhLWwHBCUMx9yr9vArnUJ6YQ&oe=6A6A14B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoFirstFrameBlack.png", "id": "665353835970339", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393511_665353839303672_2679303703056771108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzIDaP6uXgoQ7kNvwFKqPit&_nc_oc=Adr5-V26Ksh3OLobrKLIL4Gb1O96uNPQssc-oxI1LVM_9Ayhynl60E-KJqZ1_wcD7ok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkdPgIT13HrIomHPvyJ6GiL2lac1j3-IjeYYAOk0wdiQ&oe=6A69F559"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "spotify", "Supernatural", "FitXR"], "long_description": "# \ud83d\ude80 The World's First XR fitness application with real load experience! \n# \nMeet **Jump Rope XR** \u2013 a **XR fitness app** where you jump with a **virtual jump rope** and get the **same real workout effect** as with a physical one! \n# \n\ud83d\udca1 **Virtual Jump Rope - No limits for training**  \nNo need for a large space \u2013 **train anywhere**, and **your results will be just as effective** as with a real rope.  \n# \n\ud83c\udfaf **Workout programs for every goal**  \n\u2705 High-intensity calorie burning  \n\u2705 Muscle building & endurance training  \n\u2705 Challenges & achievements to keep you motivated  \n#\n\ud83c\udfb6 **Fitness in the rhythm of your music**  \n\ud83d\udd39 Integrated with **Spotify** \u2013 train with your favorite tracks!  \n#\n\ud83d\udd25 **Unique features**  \n\ud83d\udd39 Monitor **calories burned, jump count, and progress** in real time!.  \n\ud83d\udd39 **Spotify** integration.  \n\ud83d\udd39 Music library.  \n\ud83d\udd39 XR mode or Virtual Environments.  \n\ud83d\udd39 **Real workout** programs created by fitness coach.", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & muscle training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jump-rope.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "CODNES", "support_website_url": null, "website_url": "https://jump-rope.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
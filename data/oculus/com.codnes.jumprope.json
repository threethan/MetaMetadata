69522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_1155505096302855_3944534447470340183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDYh4WJT_FoQ7kNvwE6zog2&_nc_oc=AdqVW2Gtc73a9s1t0wEeAuGJsTrj3xP99XmNaGn_QXh42tRSrGT0LMZ4vR_Ln5fwDXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxEyrqRv6fUJ6afjKrTy4NI9ofjS4pw3hntuYc6Ba1Bw&oe=6A50FFCF"}, {"file_name": "4.png", "id": "1157345302527940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_1157345305861273_8507109329514924873_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-Y_N50_wH8Q7kNvwGEGsjR&_nc_oc=AdpS2fmnj6WoKo7RPluBKMt7Lt7Wp0Q437wTqwoUJJoLt_yVxUJ4hZ2Zx666zpBBNyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAHdVi_tuVnE2lJc3XD8HO24fGXN-FDARBqi_nwKqJaQ&oe=6A51025D"}, {"file_name": "5.png", "id": "1334009037746801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_1334009041080134_4260584670607588883_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDAGeu9LZ8YQ7kNvwE2Vd1d&_nc_oc=AdoO-ZpWPOA4ZARxNLmJJgbBCiYTEGH-qgCmsccDOTCXJa8ARfRw3i5fEi-RtL1TZ0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS6SxxLDi2bsqRC9tWtaxDej-H9_YaFDc0YYKfmukVtw&oe=6A510835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoFirstFrameBlack.png", "id": "665353835970339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393511_665353839303672_2679303703056771108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoRgTZAM-t0Q7kNvwHhvF-P&_nc_oc=AdoM8-VS7LcECvnZinu17BKlnESDizJ9LBzNOHREiRAY1maGB49BlHK4_9UPgxnST2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE8FZPCuzTdSP8BG85Nk6oq9tBinyy6MCfOnm9iaCvzA&oe=6A50E8D9"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "spotify", "Supernatural", "FitXR"], "long_description": "# \ud83d\ude80 The World's First XR fitness application with real load experience! \n# \nMeet **Jump Rope XR** \u2013 a **XR fitness app** where you jump with a **virtual jump rope** and get the **same real workout effect** as with a physical one! \n# \n\ud83d\udca1 **Virtual Jump Rope - No limits for training**  \nNo need for a large space \u2013 **train anywhere**, and **your results will be just as effective** as with a real rope.  \n# \n\ud83c\udfaf **Workout programs for every goal**  \n\u2705 High-intensity calorie burning  \n\u2705 Muscle building & endurance training  \n\u2705 Challenges & achievements to keep you motivated  \n#\n\ud83c\udfb6 **Fitness in the rhythm of your music**  \n\ud83d\udd39 Integrated with **Spotify** \u2013 train with your favorite tracks!  \n#\n\ud83d\udd25 **Unique features**  \n\ud83d\udd39 Monitor **calories burned, jump count, and progress** in real time!.  \n\ud83d\udd39 **Spotify** integration.  \n\ud83d\udd39 Music library.  \n\ud83d\udd39 XR mode or Virtual Environments.  \n\ud83d\udd39 **Real workout** programs created by fitness coach.", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & muscle training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jump-rope.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "CODNES", "support_website_url": null, "website_url": "https://jump-rope.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
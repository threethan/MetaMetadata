ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_1155505096302855_3944534447470340183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYs6MZupT-cQ7kNvwGuxxes&_nc_oc=AdoVd10z8uORwEyLWuRCwRrWg0IFU1fBf-nPO-mhLjoa6as53wcLp9NZ2g8qA16deZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEzUzpqmFsIexGO1Vqzex1Wt5-O6O6id_hvvDZU5Hvhw&oe=6AA2BCCF"}, {"file_name": "4.png", "id": "1157345302527940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392305_1157345305861273_8507109329514924873_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEF1SyRAfB8Q7kNvwGm_03F&_nc_oc=Adpz3kqePDdH_LQjKusfDs7GncJ4B26wbuTwZhCKbxGHPByI6Zl1-BjDKx32AydbhwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzfMGKEnEXyNbBHwuIxRKw6jSZ05jYUv9d_-IMOB5mWw&oe=6AA2BF5D"}, {"file_name": "5.png", "id": "1334009037746801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_1334009041080134_4260584670607588883_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAmDCAY6JVsQ7kNvwExaTpH&_nc_oc=Adrfv5MjUOaeKCOGCmKcQX1bsa_EqjgJF3QRXtOHhr_QoLsJh-6-1toTlyzZxTvg3S0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPppvW5unzlvA6brROmSjsR17GnPMMyw0xGkszVViunA&oe=6AA2C535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoFirstFrameBlack.png", "id": "665353835970339", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393511_665353839303672_2679303703056771108_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VoDy7B_TLcQ7kNvwH8dl26&_nc_oc=Adq_w15sHo44NEPg06q4t8hAT7PLeabymbphw2-XZyv0k84eE8V9MHA3vMN1cUOgde0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNvWUNp3C7RBNJ0njJuCEp0GymmK7i_4SHl6Ws_qyNSg&oe=6AA2A5D9"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "spotify", "Supernatural", "FitXR"], "long_description": "# \ud83d\ude80 The World's First XR fitness application with real load experience! \n# \nMeet **Jump Rope XR** \u2013 a **XR fitness app** where you jump with a **virtual jump rope** and get the **same real workout effect** as with a physical one! \n# \n\ud83d\udca1 **Virtual Jump Rope - No limits for training**  \nNo need for a large space \u2013 **train anywhere**, and **your results will be just as effective** as with a real rope.  \n# \n\ud83c\udfaf **Workout programs for every goal**  \n\u2705 High-intensity calorie burning  \n\u2705 Muscle building & endurance training  \n\u2705 Challenges & achievements to keep you motivated  \n#\n\ud83c\udfb6 **Fitness in the rhythm of your music**  \n\ud83d\udd39 Integrated with **Spotify** \u2013 train with your favorite tracks!  \n#\n\ud83d\udd25 **Unique features**  \n\ud83d\udd39 Monitor **calories burned, jump count, and progress** in real time!.  \n\ud83d\udd39 **Spotify** integration.  \n\ud83d\udd39 Music library.  \n\ud83d\udd39 XR mode or Virtual Environments.  \n\ud83d\udd39 **Real workout** programs created by fitness coach.", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & muscle training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jump-rope.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "CODNES", "support_website_url": null, "website_url": "https://jump-rope.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
=Adoy_wgzwyLU2gjWJU9E8ogbr1wTD89m0zlIFHdQShpYLVay2CY6mlHae6LBrH3ElmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpSlEJfBhZ2O5nKfLiwdX3P416IOkTkR01R23Lo7Ia0A&oe=6AB5379C"}, {"file_name": "1.png", "id": "1045191751273539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1045191757940205_8448661037750802038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AUdVRtvVNkQ7kNvwGQrbj9&_nc_oc=Adoxk87Pa_mlxmRME3SLAOQ4uYj6uIBOOSULBLQsOmerXJBPdBaUTNs11xcbv040Hu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsuPkfVpwMmJTkQKSFVeFVTsy7tvn86WbZwSEWxv5hUQ&oe=6AB51A05"}, {"file_name": "Sc5.png", "id": "4514297245516020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304305_4514297248849353_7789253416768013723_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STfeA5ETLIUQ7kNvwEDCjv_&_nc_oc=Adroq_Uy1t4z1qCUtr4AH36tmoF9p1IZ55OKq7nUcDP4P-92Ho5aQ-lIwGRGx8Paoug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa5oZIMtfDxL8bQWn_gM3TOc2YgjJERuSjqSHrCtYx3w&oe=6AB542DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-07-03-12h21m55s834.png", "id": "1566976488122000", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1566976491455333_7572237726658224107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeEbb0bHaeUQ7kNvwFz_09b&_nc_oc=AdrRIsdFwaxq1g9Iv2IFOr2Ayyeg1T1HEywb6suPTeDrIVICorAIueRgEq79Ibypb6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6OKINi1PTUPvhKhBQCHjx_uI-suM58_sZtTcSRKA-zQ&oe=6AB535E6"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "training", "motion", "fit"], "long_description": "**Jump Rope XR** transforms cardio into an immersive VR fitness experience.\n\nEnjoy the feeling of jumping rope without a physical rope, using intuitive motion tracking and engaging gameplay designed to keep you motivated. Train longer, burn more calories, and make every workout feel like a game.\n\n**Why you'll love Jump Rope XR:**\n\n* \ud83e\udea2 Experience realistic virtual jump rope workouts.\n* \ud83c\udf0d Exercise in beautiful VR environments instead of the same old gym.\n* \ud83c\udfc6 Compete with players from around the world on online leaderboards.\n* \ud83c\udfb5 Work out to your favorite music for a more enjoyable fitness session.\n* \ud83d\udd25 Burn calories while improving your cardio, coordination, and endurance.\n* \ud83d\udcc8 Track your progress and challenge yourself to beat your personal best.\n\nWhether you're looking for a fun way to stay active, improve your fitness, or simply enjoy an engaging VR workout, Jump Rope XR delivers a unique experience that combines exercise, competition, and entertainment.\n", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & cardio training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://visionlab.pro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Lab", "support_website_url": "https://visionlab.pro/privacy.html", "website_url": "https://visionlab.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "use
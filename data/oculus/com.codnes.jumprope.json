wSFZ597tx2Zuu2yUq0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtcxYLIzMQWWEiFQhVIDm0uQw2XwTqgvxbqqBM3kFRpA&oe=6AFDBCB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoFirstFrameBlack.png", "id": "665353835970339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_665353839303672_2679303703056771108_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnyQ8AcJpYkQ7kNvwHKKH8f&_nc_oc=Adr3i7e9heGzxrwKd0GKLwfn8RB5fNHQxEEws9yOPNKFgc4abRP54R0UE0BzR9vBQ68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6yw_nYr_cQRyNg2HNk6QJvto1atDGTkD5uI36hsN9wQ&oe=6AFDD599"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "spotify", "Supernatural", "FitXR"], "long_description": "# \ud83d\ude80 The World's First XR fitness application with real load experience! \n# \nMeet **Jump Rope XR** \u2013 a **XR fitness app** where you jump with a **virtual jump rope** and get the **same real workout effect** as with a physical one! \n# \n\ud83d\udca1 **Virtual Jump Rope - No limits for training**  \nNo need for a large space \u2013 **train anywhere**, and **your results will be just as effective** as with a real rope.  \n# \n\ud83c\udfaf **Workout programs for every goal**  \n\u2705 High-intensity calorie burning  \n\u2705 Muscle building & endurance training  \n\u2705 Challenges & achievements to keep you motivated  \n#\n\ud83c\udfb6 **Fitness in the rhythm of your music**  \n\ud83d\udd39 Integrated with **Spotify** \u2013 train with your favorite tracks!  \n#\n\ud83d\udd25 **Unique features**  \n\ud83d\udd39 Monitor **calories burned, jump count, and progress** in real time!.  \n\ud83d\udd39 **Spotify** integration.  \n\ud83d\udd39 Music library.  \n\ud83d\udd39 XR mode or Virtual Environments.  \n\ud83d\udd39 **Real workout** programs created by fitness coach.", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & muscle training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jump-rope.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "CODNES", "support_website_url": null, "website_url": "https://jump-rope.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29300435699543685"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1540978403771149"}, {"status": "PUBLISHED", "id": "1142015017736897"}, {"status": "PUBLISHED", "id": "648166891171660"}, {"status": "PUBLISHED", "id": "692210946815554"}, {"status": "PUBLISHED", "id": "973897920842168"}]}, "baseline_offer": {"id": "1540978403771149"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765606560, "status": "PUBLISHED", "id": "1540978403771149"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39363519253235229", "version": "2.11"}, "id": "614617194521166", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "
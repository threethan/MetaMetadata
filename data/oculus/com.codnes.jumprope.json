0f&oh=00_AQI2FzR8fX4sMVDVKw2GOZhFSsdAKqb8-HdFr2rHSHZ0BA&oe=6AAD4E9C"}, {"file_name": "1.png", "id": "1045191751273539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824328_1045191757940205_8448661037750802038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5SkKs8w5UgQ7kNvwFfQzCZ&_nc_oc=AdoswJQbxsG-7k5Z5Xr-jO8ae7D1EqYZlHA0ZwyL2VDDgA4S5L0PQHB9bgGACzpbRaM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtplYu83509gbXz_tT6F4hx8pQHC0Gi-YsMxg8tJWG0w&oe=6AAD3105"}, {"file_name": "Sc5.png", "id": "4514297245516020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304305_4514297248849353_7789253416768013723_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw4wb--7YkwQ7kNvwG-HOFX&_nc_oc=AdqwQeqR9DzcexlbBKDRZWWl5m39mDQyzgNB0DiVk1q_dDGNripnv-7LO2AXe3jSMGM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjk_SnsPsrvNPQcy-8V9rcZe9msgDLDet1SoeHzLyyxw&oe=6AAD59DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-07-03-12h21m55s834.png", "id": "1566976488122000", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823351_1566976491455333_7572237726658224107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daRK7USAKgQQ7kNvwFoUz9G&_nc_oc=AdrwPO1FZtw9nvVpKwHYscgWG7SQv06pNOSCrriWe9S02m3qOckW8Gx-Md8o6F6CkNY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsOTo7ZTieVAeSrL99ef003aHOXqvDTU8sJrFZWJOesg&oe=6AAD4CE6"}, "display_name": "Jump Rope XR", "keywords": ["fitness", "workout", "training", "motion", "fit"], "long_description": "**Jump Rope XR** transforms cardio into an immersive VR fitness experience.\n\nEnjoy the feeling of jumping rope without a physical rope, using intuitive motion tracking and engaging gameplay designed to keep you motivated. Train longer, burn more calories, and make every workout feel like a game.\n\n**Why you'll love Jump Rope XR:**\n\n* \ud83e\udea2 Experience realistic virtual jump rope workouts.\n* \ud83c\udf0d Exercise in beautiful VR environments instead of the same old gym.\n* \ud83c\udfc6 Compete with players from around the world on online leaderboards.\n* \ud83c\udfb5 Work out to your favorite music for a more enjoyable fitness session.\n* \ud83d\udd25 Burn calories while improving your cardio, coordination, and endurance.\n* \ud83d\udcc8 Track your progress and challenge yourself to beat your personal best.\n\nWhether you're looking for a fun way to stay active, improve your fitness, or simply enjoy an engaging VR workout, Jump Rope XR delivers a unique experience that combines exercise, competition, and entertainment.\n", "short_description": "Next-Level fitness application! \ud83d\ude80\nJump with a virtual jump rope and get a real workout effect without space limitations! \ud83d\udcaa\n\n\ud83d\udd25 Programs for weight loss & cardio training\n\ud83c\udfb6 Spotify integration for extra motivation\n\ud83d\udcca Real-time performance tracking"}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://visionlab.pro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Lab", "support_website_url": "https://visionlab.pro/privacy.html", "website_url": "https://visionlab.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38010088845244950"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
6tGdYnpNSNKnG2_yPGcObWUIzRXl5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJw24WRuBH6WsCkOPCBCO4CqBlcXuZRqXHhWhmv-8qfg&oe=6B0C4A54"}, {"file_name": "ZB - Screenshot 5.png", "id": "866476903069605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_866476909736271_1090612464187292632_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSfLBljuDVYQ7kNvwHm60Nx&_nc_oc=AdpwxksoUn5_X-XvUsXj7BL053Xid08MZB7KzmacjcyBM0RJCZCC3ht2CefswOTddF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVAIz4zWWi7dGLJCp_hAmMlFDzl88KmpQ65KPErDY9cQ&oe=6B0C5EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Art - Meta PDP.png", "id": "1174513868584056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622192_1174513871917389_6454969980364419415_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZCbolVRxBgQ7kNvwHTTrLW&_nc_oc=AdqYOn37kAAED1cGAjbRhvLU7RwvYfqVRzekN_gBfBQ8p1TUNThGoLqd-r5UDhcuShU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7YWAGfdqR6cYI6D77lykQ6sZuRO7D_mKJIJe3se0E2g&oe=6B0C6870"}, "display_name": "Zombie Breach", "keywords": ["vrzombieshooter", "wavedefense", "survival", "horror", "crafting"], "long_description": "You're trapped on the second floor of a fortified apartment. Outside, an endless horde wants in.\nZombie Breach is a VR wave-defense shooter for Meta Quest. No story to wander through, no way out; just you, a room, and what you can hold.\n\n**TACTILE COMBAT:** Reload by hand. Eject, grab a fresh magazine from your hip, slam it home, rack the slide. Headshots hit harder and score more, the toughest zombies still take multiple clean hits.\n\n**PREP, FIGHT, LOOT:** Loot wood between waves to craft barricades for the three ways in: the front door stairwell, a crashed bus beneath the window, and a plank bridge next door. Every barricade buys time and shapes the fight. \n\n**TEN ESCALATING WAVES:** Standard zombies, fast rushers and tanks that soak damage. The horde grows faster, tougher, and more numerous each wave. Survive all ten to win, or die and chase a better score.\n\n**HEAR THEM COMING:** Every zombie type has its own groan and footstep, fully spatialized. Footsteps on the stairs, a scrape at the window; you'll hear it before you see it.\n\n**BUILT FOR COMFORT: Stable 90 FPS. Play room-scale on your feet, or seated with smooth thumbstick locomotion.** \n\nZombie Breach is Virtulane's first commercial game title, built by a small team in Canberra, Australia.", "short_description": "Locked in one room. An endless horde outside. Zombie Breach is a VR wave-defense shooter where confinement is the threat. No exploring, no escaping, just tactile gunplay and a horde you have to out-position, out-shoot, and out-barricade. Reload by hand, John Wick style. Fortify three breach points. Survive ten escalating waves of enemy you'll hear coming before you ever see it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtulane.com.au/zb-privacypolicy#bf87ff4c-0ce8-4981-8f63-11dd193e0598", "developer_terms_of_service_url": null, "publisher_name": "Virtulane Pty Ltd", "support_website_url": null, "website_url": "https://virtulane.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1
915231", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984454_730062158248564_2202061072413731476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJAdqvVbYu8Q7kNvwH__SQN&_nc_oc=Adod9rzNAE0kRgySHFxmqYG16KCecDD3CciATLGeO0jo3VH7C9f3KOt8z9lsGofQEiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlZqnvfNt78jwd1H3YtvAPvoPLHXOfbKay5j7CFgCg8w&oe=6AA2B058"}, {"file_name": "Oso.png", "id": "475175787608520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982596_475175790941853_2569882350102964601_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2C0WTrm5csQ7kNvwH26Hts&_nc_oc=AdqibyIw_E6-UBI4dm4F_6ZvtJrPYilangkxHcaa54lCqsnNlaB_Aytj8kwdx7wnDzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFzFfW9gvNbvDKzbsO33hy645X75Nk0DjlMp-K7BbwpQ&oe=6AA2A070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TumbailDF2560 x 1440px.png", "id": "573807347454572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75565303_573807350787905_7918949246373855842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbEb5q1BC90Q7kNvwFhMsa1&_nc_oc=Adpe-PurIwXi4nCLp7Sr5WHzPTxjN49yZhoTekbyTQn8-B1W-0HNF4T_18xlcWHcW-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaswTTM9Bu4fZB22gUo9Z1VO7rffxNzWYYMawfyX2ZEA&oe=6AA2B9AE"}, "display_name": "Dangerous Fists", "keywords": [], "long_description": "The real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!.\nHit strong,hit speed, dodge attacks, keep your distance, move your legs, block the punches and win. Your fists is the only that you have to get the belts. This is a fighting club, the fighters has skills like mma, jujitsu, karate,  boxing and muay thai techniques to beat you. \u00bfCan you beat them? This is a fight club, you can fight to 9 exited and dangerous fighters, each fighter has the own techniques to fight, can you beat them to become the king of the dangerous fists champion. The game include 4 difficult modes \u00bfAre you ready? \nImportant \nRoom scale is necessary a minimum\nplay area size of 6.5ft by 6.5ft (2m by\n2m) recommend 3m by 3m for a better experience. Please ensure your Guardian boundaries are set up properly for room scale. Always consult your doctor or other qualified healthcare provider before playing sports games. ", "short_description": "This is dangerous fists, the real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dmundo.net/blank", "developer_terms_of_service_url": null, "publisher_name": "Frank Mier", "support_website_url": null, "website_url": "https://www.3dmundo.net/blank", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "570533511374116"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "232705246565064"}, {"status": "PUBLISHED", "id": "600399671387712"}]}, "baseline_offer": {"id": "232705246565064"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706736829, "status": "PUBLISHED", "id": "232705246565064"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
0941853_2569882350102964601_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a397G0AUmTMQ7kNvwErElqg&_nc_oc=AdoNB-YtezXq1iCAOK-g8uZyQ--ww1BIyDXzn59s7tcth896U39BMNu3c3pLyrGVxHU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYk4UL0qVIFpA-HGNKg7Mf6wEjKkwZzezjjzbnGdRFtg&oe=6A8D8870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TumbailDF2560 x 1440px.png", "id": "573807347454572", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75565303_573807350787905_7918949246373855842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHkkMw_l2U4Q7kNvwGWbetO&_nc_oc=AdrWskGBKciKd5xCLuXCZMwkF_MWp6b9nzzjPUSmdZFePYcVBc-DeCOE3g3a_47tehI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxM7fhs8QNWR0UDHZapRAnE5hv7jSbmHFjDKJUXqd8KA&oe=6A8D696E"}, "display_name": "Dangerous Fists", "keywords": [], "long_description": "The real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!.\nHit strong,hit speed, dodge attacks, keep your distance, move your legs, block the punches and win. Your fists is the only that you have to get the belts. This is a fighting club, the fighters has skills like mma, jujitsu, karate,  boxing and muay thai techniques to beat you. \u00bfCan you beat them? This is a fight club, you can fight to 9 exited and dangerous fighters, each fighter has the own techniques to fight, can you beat them to become the king of the dangerous fists champion. The game include 4 difficult modes \u00bfAre you ready? \nImportant \nRoom scale is necessary a minimum\nplay area size of 6.5ft by 6.5ft (2m by\n2m) recommend 3m by 3m for a better experience. Please ensure your Guardian boundaries are set up properly for room scale. Always consult your doctor or other qualified healthcare provider before playing sports games. ", "short_description": "This is dangerous fists, the real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixandservice.wixsite.com/3dmundo/blank", "developer_terms_of_service_url": null, "publisher_name": "Frank Mier", "support_website_url": null, "website_url": "https://fixandservice.wixsite.com/3dmundo/blank", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7900060103342614"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001655_564986128664879_7152812086509662105_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr-tOtp7YLoQ7kNvwGAB_4z&_nc_oc=AdohUbYJXXxysbxjPofkTKFtlDOJji-ebFGA-QqWnehHdJRkt-KgJpn9e_HelKeQQ0M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0jFr_XttSgKbHXdgty6DLMNgcikxXdnj8LXoJLnpERA&oe=6A8D9BBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dangerous Fists", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1656738000, "lastRevision": {"nodes": [{"id": "5891786217503356", "release_type": "SCHEDULED", "administration_
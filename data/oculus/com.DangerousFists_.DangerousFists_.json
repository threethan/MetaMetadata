XbdTOG0K9-qTnObemP0foCVuX4p43zwkaQoQL2koA&oe=6AC28149"}, {"file_name": "Ufc.png", "id": "730062154915231", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984454_730062158248564_2202061072413731476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWEsBQ4oKsoQ7kNvwE71Kiw&_nc_oc=AdrQ277shGXdPeBMlcWMDkDipbeE76epIahF91NfxBwcf1ef_jbR3MpfM0LQU1-th7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGzkjmumltPqu2dtrqda46sjqTcAXuNi_5DjzzcC0c0w&oe=6AC25458"}, {"file_name": "Oso.png", "id": "475175787608520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982596_475175790941853_2569882350102964601_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUf3Gezpz8YQ7kNvwEUFdW5&_nc_oc=AdrsSMJ7rKr1z9UoweEsrHf9DkP1iHW7Zo3zFmWJq6SttqtSNqkPIbb-JPRp8nxUlPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_cdoZIIn0vhFDjuag5y9yVhyES6sWb92PurxZK2RV2w&oe=6AC27CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TumbailDF2560 x 1440px.png", "id": "573807347454572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75565303_573807350787905_7918949246373855842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHDAdKeuldEQ7kNvwGxMU8b&_nc_oc=Adp7H3ZNWkQYkYFe1y-ncUVvO4gbP9Mw4-YITHmQHwgw5rLEeWC3XU3ktmFxs4__iwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_DBSkqQjmXVO8H0An8rfmwrESIJPAa1FOkGx_zHPdhw&oe=6AC25DAE"}, "display_name": "Dangerous Fists", "keywords": [], "long_description": "The real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!.\nHit strong,hit speed, dodge attacks, keep your distance, move your legs, block the punches and win. Your fists is the only that you have to get the belts. This is a fighting club, the fighters has skills like mma, jujitsu, karate,  boxing and muay thai techniques to beat you. \u00bfCan you beat them? This is a fight club, you can fight to 9 exited an
z8mjHd6liaKuFiVGDa36dF1ligXdm1ojb7L6vnudw&oe=6AC52449"}, {"file_name": "Ufc.png", "id": "730062154915231", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984454_730062158248564_2202061072413731476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrOxfNlVXmQQ7kNvwFdneKf&_nc_oc=Ado1E_vdcf_y6qlzYgCV_jbBlSbMnBa_I4aMC652E-YISHIWqNNMQ3q9u2kbUKelM9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORxge3PnF52Wra3Z-hpCIGmKMAyxtRzRLCYxQnMbliQw&oe=6AC4F758"}, {"file_name": "Oso.png", "id": "475175787608520", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982596_475175790941853_2569882350102964601_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97P-QJn1XvwQ7kNvwFGTPxk&_nc_oc=Adp8U4R2IteolJl-3t6BCNRa7ivNSPYKN40efd7LrGthF0NRMs9WAe2PCT8F8-XTv2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM_GHcjBMBy5TNrw51cqDHbSrDlrAvl31hMNOFpl04Sw&oe=6AC51FB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TumbailDF2560 x 1440px.png", "id": "573807347454572", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75565303_573807350787905_7918949246373855842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGTEWGGGMyUQ7kNvwG0OIwj&_nc_oc=AdoLplF4PnPT8g_MRGCkzH4UxtPNh8JS9URcCBE9W33C1Ra0bOWgSVLXacX6fR7nP0M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8SVQN7yxgqKhlNEG4AH9QYVN6laE3fMpEP0CbHU2WBw&oe=6AC500AE"}, "display_name": "Dangerous Fists", "keywords": [], "long_description": "The real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!.\nHit strong,hit speed, dodge attacks, keep your distance, move your legs, block the punches and win. Your fists is the only that you have to get the belts. This is a fighting club, the fighters has skills like mma, jujitsu, karate,  boxing and muay thai techniques to beat you. \u00bfCan you beat them? This is a fight club, you can fight to 9 exited an
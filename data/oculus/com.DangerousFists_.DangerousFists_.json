Ynkg5ZTiOJKtiTEnXxXBvcM2kXr6wj4lfOlrg2clw&oe=6AC3D2C9"}, {"file_name": "Ufc.png", "id": "730062154915231", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984454_730062158248564_2202061072413731476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWEsBQ4oKsoQ7kNvwE9wmmM&_nc_oc=AdpoOUWylsxSdjQDIw9q5FJ9tCBUFuyxRrnWdfK0x-A44jQt2s_DebVWzFGmoFAmOvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOep2ccmtzUdKn-lyUHoUUx_DT1YaIngyjgS19BKK8yJA&oe=6AC3A5D8"}, {"file_name": "Oso.png", "id": "475175787608520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982596_475175790941853_2569882350102964601_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97P-QJn1XvwQ7kNvwGA-Mfg&_nc_oc=AdrGGRFmSQrcmOXQetvGPtw37sMUDOioR2s0Lrax8lEy5cAqL7Y5unKhNJ_6NpNneKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMsQFDNoEbVgOTG5uH0qwtXchfOoxmped9KIgeNrtktg&oe=6AC3CE30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TumbailDF2560 x 1440px.png", "id": "573807347454572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75565303_573807350787905_7918949246373855842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHDAdKeuldEQ7kNvwF5rTxR&_nc_oc=Adp_vMDLajSnMTzQuXCo-4NwMh_qis0PYCkyalV-ttfzksxJYfiQnrZgt20ee-XFidk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNySP-B_k5mwlFa49ji-j6w5wtADRgGJFbrZlNsMs0prA&oe=6AC3AF2E"}, "display_name": "Dangerous Fists", "keywords": [], "long_description": "The real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!.\nHit strong,hit speed, dodge attacks, keep your distance, move your legs, block the punches and win. Your fists is the only that you have to get the belts. This is a fighting club, the fighters has skills like mma, jujitsu, karate,  boxing and muay thai techniques to beat you. \u00bfCan you beat them? This is a fight club, you can fight to 9 exited an
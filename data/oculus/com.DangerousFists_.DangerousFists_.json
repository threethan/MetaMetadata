ur Guardian boundaries are set up properly for room scale. Always consult your doctor or other qualified healthcare provider before playing sports games. ", "short_description": "This is dangerous fists, the real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dmundo.net/blank", "developer_terms_of_service_url": null, "publisher_name": "Frank Mier", "support_website_url": null, "website_url": "https://www.3dmundo.net/blank", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "570533511374116"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "232705246565064"}, {"status": "PUBLISHED", "id": "600399671387712"}]}, "baseline_offer": {"id": "232705246565064"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706736829, "status": "PUBLISHED", "id": "232705246565064"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6219678681380773", "version": "6.9"}, "id": "1444676625945948", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
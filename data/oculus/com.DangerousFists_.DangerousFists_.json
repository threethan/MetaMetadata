MgLjlfosWj6RasXgYrLcylo6g7VSuygf7WFazqCw&oe=6AA00209"}, {"file_name": "Ufc.png", "id": "730062154915231", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984454_730062158248564_2202061072413731476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edEo1xfBZ0cQ7kNvwHKaGoJ&_nc_oc=AdpN_lcDeAoK52oivSs7Q07cml-BNi4g1Y2xejnu02Zj3Q1o6yhmXEIL3_RXhMxhpOo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL25qHMoSQGbxbCHyt_qA18pWA0nC2h_n89zgdOVp4jFw&oe=6AA00D58"}, {"file_name": "Oso.png", "id": "475175787608520", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982596_475175790941853_2569882350102964601_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2C0WTrm5csQ7kNvwF0W_XP&_nc_oc=AdqaeHwo9aJ58JOv8I69EkdnIdgjRcTf1Ae0B25sg_KhIxNE4nmgErGbg_HDYkznBWU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH9BJmMp82UVTmL8Fse2XQ5q_NDmguYU8yyVTjLk6_UA&oe=6A9FFD70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TumbailDF2560 x 1440px.png", "id": "573807347454572", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75565303_573807350787905_7918949246373855842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRiDUsJwd_IQ7kNvwESZ911&_nc_oc=AdqRf4WaMc3IfOZqxsLFmrQk8uXNKffMbnp2LdgAdEuQxxVvsADSRTLmb0Met18pW6Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII82yKxPrixriEACARLg2pSAFHwM2XApli7qlrm7LkTA&oe=6AA016AE"}, "display_name": "Dangerous Fists", "keywords": [], "long_description": "The real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!.\nHit strong,hit speed, dodge attacks, keep your distance, move your legs, block the punches and win. Your fists is the only that you have to get the belts. This is a fighting club, the fighters has skills like mma, jujitsu, karate,  boxing and muay thai techniques to beat you. \u00bfCan you beat them? This is a fight club, you can fight to 9 exited and dangerous fighters, each fighter has the own techniques to fight, can you beat them to become the king of the dangerous fists champion. The game include 4 difficult modes \u00bfAre you ready? \nImportant \nRoom scale is necessary a minimum\nplay area size of 6.5ft by 6.5ft (2m by\n2m) recommend 3m by 3m for a better experience. Please ensure your Guardian boundaries are set up properly for room scale. Always consult your doctor or other qualified healthcare provider before playing sports games. ", "short_description": "This is dangerous fists, the real experience of fighting in VR, the video game when you can fight to the end, there is no rules, no limited time to beat your opponent, fight to win!."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixandservice.wixsite.com/3dmundo/blank", "developer_terms_of_service_url": null, "publisher_name": "Frank Mier", "support_website_url": null, "website_url": "https://fixandservice.wixsite.com/3dmundo/blank", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7900060103342614"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001655_564986128664879_7152812086509662105_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWX0lTtkcAMQ7kNvwFvUJCs&_nc_oc=AdofUG-NB8nN-Y8mL8WpqD40mpZvAjQHOxsQMPsEQaNZY
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYDDWK8JWT8Q7kNvwGNCpXG&_nc_oc=AdqAwrigVwKGB-SMIOo63ObKh5OlGBcNqmw6KI0NVxl375DTyHfoLevDXECRC1WvsGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5lL8eYQ-8zPkA2yeALEE862dhAJpBLh5GNKTynak5xA&oe=6A709622"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk0oWinMz_IQ7kNvwEtsf9W&_nc_oc=AdoGkNac0hj_X1t-hR5qAE3kpaoPIxjP0GP1dFHR65PsIzZcV10YAS7jwquGNmhfhIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSyx4PKeUr-WcavOk5GU0N2C2BXfYKq9OHoj3VBiPhbA&oe=6A707338"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QToOuYHcp3UQ7kNvwGi5S5y&_nc_oc=AdrFk8YjScyhyarh2Iqm8uBa43Ev3q4KalMFpk5nMttSweGn57BO2uKlrxmNCyloeDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE66H_DGApaAvVw66jAAHA4a0KZE6fION7LBCZGOW3fZg&oe=6A7085F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJoBb4B1dlkQ7kNvwG3us0K&_nc_oc=Adom16VWz5t0QsxVOPSps5a9WCBodvXyxVOrpJvVUxtfF6GqoiUcoB-djbGcNx_M2wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr-rocMC7G4ly8mV13MFE06mDwcozMR_DmH85nTVHpWA&oe=6A709E80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MjRrOL_KYcQ7kNvwHndo4S&_nc_oc=AdoyjYSWXILh43rI0DwXgbqzzu_LYCmA9Uu3qWgqo1TJezZdt2B_wVdfknTo56RQrms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHfU9USg-Y8nFWk4So5V9RiCqtp06EAWIRw8u1TR7T8A&oe=6A708A0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYH0lCag998Q7kNvwFUUO1o&_nc_oc=AdqSJOLPQVXD9FxhNTGcHM1IU8yHxmOuZ9XKoQ9s4EgMYVPmqpJ12gpxgrJ2mQHbYdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWCsj-qzXBTah4N1yG_GUAiLJdAB1MJE1J2sSnePsfHw&oe=6A709369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMIhcaMexpgQ7kNvwH_woZj&_nc_oc=Adr24aqK7YFs02Rl8PyIdNT5Zr7Ubk_wsnvMtQpUsPHd2zmEjD9QB8sV5ls99b8Z9Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcXnaV0qtIJ4fOiMi50yrKy-F6uQ6PCb_ExHndi9cY9g&oe=6A7088F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJz7y8TcFEUQ7kNvwEpF8aT&_nc_oc=AdranUC8FDkk5UXTsBuWOC6QX2aDcS94T9lra4O8dvLlpdu2QdoDETvHeUPOOLrSwow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH50y0B2JH651W0jf9Sq8HqbcMOtVHwttNtj40vuYLr8Q&oe=6A7077E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
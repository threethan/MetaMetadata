.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHxvjOUfB-YQ7kNvwHN8s0I&_nc_oc=AdrJ146C8yx8Osa9T8S_fHeWxDuhTmHJdqYaAhpVbp6vFwwl1FJkqjYpjEmBd9CRHcY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzqQu0Kvn7KCe2lCu_s8-gQKGucxZYh08dt8XHS_MBBQ&oe=6A8AF422"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MMDKyjLNYYQ7kNvwEXGeck&_nc_oc=AdqTLhfdEygiUwKYzoSn3GxHyhFZ3RRPqaG94_gdqHoxTSERYDscwLp4ercfsCHt4sM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYBbVUVkxFrwNIsMd0jobzGaFjAHbIOnDTEqaWE63SjA&oe=6A8AD138"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1ikIXU0BPwQ7kNvwGVHIcp&_nc_oc=AdroD7JCSplyDkpOXal9kR1TMz5g_UWJJIUSAYc3hQaQyGyf6xVt_jn2ML97M8QrB5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-l_zxi4JNvvpGVPVywJ8qxk8IfpCmX5oHIacMrJBCzg&oe=6A8AE3F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_mA4MnR_zIQ7kNvwHW_acC&_nc_oc=AdpNRbFyM-VylclKHICiPEhNJX2a1qK0P3hQN1UDtV0wXnSLVY8MKszkBmgHZzE08CU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt9JKpd9Y0-xeEcS6f4ig1WOdJ937wPkHPM0nu0mKJlw&oe=6A8AC440"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcVHzfnJzcYQ7kNvwG__qSM&_nc_oc=AdpGdV-porJeplXFQqJLWh5yxBRNhpmwZEn7ikgY-OSGL7Ywx3gc6nsiZf7AViEBZcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFqjZXIAFBAPtEl5vwWxIxROEz6sOsDcSlihYBXEYEWA&oe=6A8AE80D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-G-SkPersEQ7kNvwGPsPTj&_nc_oc=AdqG_xi8qpPNxv965hWxE-3_LcCCkduvSYL8MFunR-zmSIbBGVBAgbw_aDTLGoTHZKw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyAmn4YqBHvIRCN5YozeDvoX4W5Obr0-Hto_mCidYdVg&oe=6A8AF169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRzni9tCOEIQ7kNvwH1uZcf&_nc_oc=AdpdgxP3eIPrVU1H4lPvHNhIGJfd-Dzac1GOZLibF04TQGggdnSwfligjDR6VdVniy8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMri8pOZobvQ55K31DQbF5GTsQKXYVUBJz7KHeDm3WVA&oe=6A8AE6F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LREiew6Avc4Q7kNvwFO8fE_&_nc_oc=AdqZhQOpOijc0alu4C6trCOGdL7lBGsVPvy1OPWSFGHdrHOULe9FT391WxaT96uZFls&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGqm9wuL33P6bAaHS2M8mFXW3npFEC-Qw-Kig31474Pg&oe=6A8AD5E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
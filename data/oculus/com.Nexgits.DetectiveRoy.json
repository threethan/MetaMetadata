.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OMS3cvdy1cQ7kNvwG8f1Fm&_nc_oc=AdpTcvuyR7IWViLeP9qMqyU21a8tt1vB7RVccv6_0ETyD2N-CFj_CglHhTNrhuJC6Q0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66OvtcFEZiVta4Y85vmvAVMMUvoBMoLJFSWZQlc5e0yg&oe=6A09C122"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JAh-1CwZdEQ7kNvwH26t4h&_nc_oc=AdoxVPf-bRmOD0Vb_xFijg40QZDs_f6fbg2ENaSbuIvdfwPt0pu7iRXaR_ExyzNw4Gc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sqsdhd0w4nutQjO1Zdzmq5G9Mx92nSr4N6j5Kbj8D7g&oe=6A09D678"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW5jCJGDMeIQ7kNvwHyxIhf&_nc_oc=AdpdJWpOFXiJfJhwpWz_m5FdX3I64DL6Fr33lo7yxeK7Y7r-xmT1WbGQlQBZ-8UVB_U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q-Qdy3MecAnnfOkFO_Bce4C0HAzuYW070wECnCAem8A&oe=6A09B0F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xP6038W0KoQ7kNvwFpNdr_&_nc_oc=AdpTz2MQsq1VCxlohChJ1TV8dFuPHxYPIdlluUF3Y5QVPTJwCeoyG_JZS5ifNqPeiQg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eFgV1ULZZ9AVMMaOyUXE5qnT-sYsglUyaqSoJEvwVKQ&oe=6A09C980"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58y33U3ubMQQ7kNvwEr4ZZf&_nc_oc=Adoad5eJX7csySxL45gcrA4TdjKGNuazyBBOzAqLXGfE-gcwjrEJ5thdC5W9hZm2XkQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XpMn0ElnZPyaeKmcAJGUgsl4QqqLZcX_ZhfKFXVeDaA&oe=6A09B50D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6lE_B_l3zAQ7kNvwEN7ZIV&_nc_oc=AdqqGjCNdzOvZCBklB0_Lixgv9xht39--hEGtHAlU5RI1x9u1ZsAF803cUHGnzSoDxw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tQXMF_flhbM7QUjwrIPEqtRyVphS2EfrmqPfueaqg7A&oe=6A09BE69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1KVaB6BJJIQ7kNvwEOwIXG&_nc_oc=AdplFbLZsHh-M9CWeAHe9G4loPL4RCpXzY9fdmF4qS0_0KnujXPvIe-XiWW5du3YnQ4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v5H3rGB6G9psvPXswZO3CLrLfzhUsgzA9xppIXS7A2w&oe=6A09B3F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s37GZj2o88AQ7kNvwGUfATn&_nc_oc=AdrNjNVqNPPkof3iosL2Wz2RWVxhFMAZfVliFVAhIJlbTp5c7gJ27Uo2oJndgWWFnRU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TfkhSGOapkQfwrqyuh6W8JH9yknPQO5qqNCT8TEMBbA&oe=6A09DB28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
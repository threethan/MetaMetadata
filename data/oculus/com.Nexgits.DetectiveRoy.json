.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLqT9gU5QzgQ7kNvwH2Tn3v&_nc_oc=Adr-mMuQdUl19-JYsQMa5KoqMTcHsR-Dln9zA-aReqI5JZel8UNvIjQ89jWlqwafV7s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCzBfRFml7ugPGlWLLF3_3pbTyZhOHjA_LncjdQgnt4Q&oe=6AE348A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiWFVdlb9AwQ7kNvwFLWMCK&_nc_oc=Ado7aI4ekZYxkqLt55CmdOF18utxEkWj64il3LlnKlkEGJZnXjvPwggptsRY31_tCPQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW_A9RRu4rKR9psuzgk03hbpMznOZ4GI45yQcI_0PKgA&oe=6AE35DF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgzl3aR1GlYQ7kNvwF5Bge5&_nc_oc=AdrOf2B9PDI6nZsnrMNy78g1qdZU_56dk8lP4wzgcWU67mMT6y7dbWcQDEpYRyUdxQw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcVyU9opj5oLM7WoxIobb216V4skxoGtVicBJZNUuoeg&oe=6AE33870"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkmslzFult8Q7kNvwG_tLXN&_nc_oc=AdpH5YlLeagoADa4IAmjMCPND5YtK7H5saflDAFW_d9yMCoW-poyXY92gEmae4R2FZw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUxo2GBiJztsogw6x2K69O68u_dm407eR28XPBb8ccZA&oe=6AE35100"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS7_FjADYF8Q7kNvwHkJr_q&_nc_oc=Adro-9v1_RGJLFDmkl3xY9qaHBaI-A6xNAvN81odfcsAoU3SLVGgBDaSpSiOyXrZFl4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQfQzONWGs2iFG7mZltXwlxNVcUP9rbaXrR1sDOKOU8A&oe=6AE33C8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo_NdpAcVFMQ7kNvwGexuY6&_nc_oc=AdoVhMHp306NNHC6_hZ59OkO7DsSxNEgfFcMhSM8dHUp26dM2jrxabBWLTgrRH7n6Aw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPooS9-1tHXQReTeYsBL0BPx2JRtQ7e74GSbAV5yj_fYg&oe=6AE345E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUV-huqyKj8Q7kNvwHRXPon&_nc_oc=AdpgtdCCexVwL_vwkQhVAK8SN5t-Hxi-yWy-DeFgVSjU85TIhu3jh0FLrPvuS3rH30A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKE8kIdKFItRVmOuGsQc7z7hV2hTAB91g77z4YaObTyg&oe=6AE33B72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05_04GTHxzUQ7kNvwEmW0kN&_nc_oc=AdrlsMCSAQCBDi2YllCNNMSXKunI1RBX1-icI-HXxK-_eaKCKUYOKTFvS1PZZz1NICo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvpByx-3mUun30khw_NHm1s6HHzM3bQfJwUgeM9QsACw&oe=6AE362A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=266ixfTiJxsQ7kNvwFqBTeV&_nc_oc=AdpqepZ2VpLIgkMsyqjqz8fnK8UJCiW0EC8UtRu8QawWAiKb4BkpuHhYJaMXoQUTo-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4urDHsr3DveyflR7t3Ycfw_gBAaXkHgknnej0bLraDRg&oe=6A071E22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUEVgpQvlQAQ7kNvwGrTVqq&_nc_oc=AdrdQeNZDtDcQfw_NR5EDz2Bw5vpnWNr6jWhB0o4caUXyVnh_0FFqmqTmWO8uObaqIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P1uTMRVi_sbj3fhylewh07BFp04ukEfAvZiCYtV27-w&oe=6A073378"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW5jCJGDMeIQ7kNvwHje42k&_nc_oc=AdoAcd5GHp1gfIZi8osvCZRrK6GvEBfOphAGu4k6yLEUFSJXcPHOyMOKUijZVIf-bjM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45e1Swwa71Q5Co9TP0s9kuiW-IKw1QXbdNKfeBOsSpIw&oe=6A070DF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5_QxerTzBEQ7kNvwGJ0Zn6&_nc_oc=AdoMm9pzEuvZ7kgQUpvMCvIoyJ7QGBaqy1kEY17mIYkrVUVUhGzNILL419cH-KlBZ7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LgjCx9tEvwm0-owz78Tjq9P76kRJZnyFvwKTLKLmT6A&oe=6A072680"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58y33U3ubMQQ7kNvwGNOVFE&_nc_oc=Adrzxbgh1h5Xq1m_ZNpY7QAidbxJ0oSLQBoDqitNhr-1dQIHKEHx9RQ4fPYCWE_01vI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S-8-3E8evYra62GCUOBrYqKHBZEpCybbJ75zZ6KxebQ&oe=6A07120D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6lE_B_l3zAQ7kNvwED8rPv&_nc_oc=AdpTIGa-sIVSlD7izxBYnzZ5WtRF9gCQcZCbmARTDBFSx4mQm3wsuCv3DnOzPu2vL8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YqWdx43bQF7xz5qr6g9f4_a4hC8kAhguEj7lLpGSGHA&oe=6A071B69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR2BbbS0O-wQ7kNvwEeDfhv&_nc_oc=AdqsLCvYRF-KfKhMRKWJhiwVapdDlse606IZ8a34yRpcFGho2Gfk0FjuT_MXlLRnDPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rpOGwKaueEykq7PYTPGCjAs0B7FOe8sBlsI9CWrCe8g&oe=6A0710F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s37GZj2o88AQ7kNvwFzfHif&_nc_oc=AdpKimuEJigfdmXtto6p8LJFIhTIsSp7V7N2sK_g45uBMV3koYEowDVygypjeFG0-Vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6THVeewFTQIYJAwpXME_8-9iFEBiTFg_OQ_SdIcPtIag&oe=6A073828"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
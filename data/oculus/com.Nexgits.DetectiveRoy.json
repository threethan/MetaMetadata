.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K_yprtNBNEQ7kNvwE3dEpS&_nc_oc=AdpB5U18nazlkc4RvXkIrtAiocbFcDCgDxNB8V5ibfhtyYFnZq-cEQrSKULFD_w-s54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Puwhf0jPAndb20GEbEWJnOMyc34QqNCLaw8URG_pvaw&oe=6A2813A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evYD-W_fOlYQ7kNvwE9S_cE&_nc_oc=AdoIm_4_kQfQdjAoj5Wkw9aRo80VAET5Rpc-ctEkHAFAS-g5MjW4MzT3ZtDcvfwQrfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9032eYNcOyvyt_LRBnm7MOYEpHp8FkAOsCIAMy2ggqaw&oe=6A2828F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpiUhjtXeQMQ7kNvwGmLWUf&_nc_oc=AdrA-me52dWczxDNLXYcAWyq6Ed3a1uIvaOweGdDHEErlrWL9Xw7RTaLs_DcRwjoW2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j8rjyDn5N8tnc19zvFQOboBXTBqe_eJsM8o3QH6763g&oe=6A283BB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8CPlkdbvz0Q7kNvwGsxTXg&_nc_oc=Adqg3x7g5GOrJmjxxv4ufQ_8C_eFhbMvv5S9LlYVhdd7153PggwLVATYmTSzdX0MAIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QOf9BmyUBRueCsk-6JLpw-TIdjCbPc01PvQyJbrmhFQ&oe=6A281C00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGFwrjuoQqkQ7kNvwERDNH_&_nc_oc=AdruPBlYawcFrokg5gf-lKD53IMq1AV1RY-Y2kR5f6dCeiBSvfAnDjPNtUsLCZnXNCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gnl3U9zw5YYb41Mo-XSNPZZKCsxS6eOQYNICciPapng&oe=6A283FCD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eYAaA1IEZoQ7kNvwH4KeBz&_nc_oc=Adp6NeY6D9afO2-nTuhTqsINqHcB2NVyJOVLCxZO2KbIol_1wskUs67h03DdlxQ2uxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n9zyQOaUSJQeNrIQYd7-Yg5CtJlXHogc-7n_nL5qJZw&oe=6A2810E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wA-X2-lH0oQ7kNvwGmLWEQ&_nc_oc=Adqa1puaGTyEapufhiC3sFiXQOwZhR0_OJYzKcn5mq650UpvhfdmaN4O0yojjw7YYMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QD-0OtgjGXf4KG_K3CPzUpCQfv7wysHvq5ayqp2j1gQ&oe=6A283EB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEIQsIgbVuIQ7kNvwEQ_CYm&_nc_oc=AdpVHplKxKHHAe6Yqj74Ik10Yg5LRlegEGUM9sEbTb7NQNYTaqDfoSu4saB38_kM7Bc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2NMJZIlLv6hncrkChgHgk5TJYj_QPkXwXP3luNMTgZw&oe=6A282DA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
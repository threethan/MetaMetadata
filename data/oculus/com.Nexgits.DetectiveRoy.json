.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p4xoRGlLK8Q7kNvwGP_V8I&_nc_oc=AdoOEEas5-nP__QLVqAQpOqkggVyZi_bk941xBYuP77oi5xwXS5Xk_mmhqmH1HT9HX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kUcL2MR7rybwGLNMICfT_Y3zB_B9lRB7lzZie_CKClw&oe=6A144D22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqJegHuHfH0Q7kNvwHLQeL4&_nc_oc=AdoXibYIN5SzKGC-M6CJKrXrrwuz8VDrNqzqlSk319eWbnRudp0VS9V_Snppt0H3KpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vRgJzsxMG8bnFuk3NEjB79V1fEQUYlXgFwAl_1o_NVw&oe=6A146278"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5DqzhELN_0Q7kNvwEM81N-&_nc_oc=AdqpOny_OQVB16xAvg3fXBmx5A7jPJLjmHcgHHFzAQ1mgpExQyfNQGnL04qIocknDus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jV0R_Xkupl7KJwVZMy9__xtRQt6PKyJHQ29K0oh-V3Q&oe=6A147530"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4INQqZ_1wksQ7kNvwHZmZzI&_nc_oc=AdpF68O8J-OpgZqJ01ikTU1WydMX5NjaZOWUA3UBm2jujKHfF6xRVy2lOVH1S-hQv5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5adSS33Np_Nn17huVkQ3MWl1-PWEgYAAAKIfzZQC7OjQ&oe=6A145580"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPoW8gL3xvYQ7kNvwEOKgvh&_nc_oc=AdqZU6IulPKCt-BmRpOqqBkwrsBqrL97n25g151isWUMz-i-4ZH0bihWd8GAkFtyWac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76AGNSTAn6NkePfFt3fhG8QRtxoRRoW9SEayyoLe_auA&oe=6A14794D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcub2DrURu4Q7kNvwEBRFHj&_nc_oc=AdpLDVM0EgVm-fIGaYgwUs8H_yqFqRBoeyHdoytbDUJjd_qATFk0LctHTOnyqA4GyEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61UQPFZc-_kw0_hgmi4GwRRpCyGJlR7eUVFhiP1tEX3w&oe=6A144A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWWRAvLwP30Q7kNvwH6Z_eX&_nc_oc=Adrky_wNcdpDvS_MsjCrRcXoe35LZtJzGEvaRh2WeHVdVhCjlJuSvpNtyPFE-XQVIDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PeGPkYc5PQVWf8ORpT65ymJEWnu7fkQV3Q-e7bZ04WQ&oe=6A147832"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvUt8lO4zNIQ7kNvwFETQpL&_nc_oc=AdpYeLVaiAshc_E_zYht5-MwxNB0YdRDRxRO_pS9xXhY_cxMKnM49Yqjh6jznhYBMHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JLyHmVfcDS9koxumGi8CGZBcFIFLYQpTYQ7-lCDW3lw&oe=6A146728"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
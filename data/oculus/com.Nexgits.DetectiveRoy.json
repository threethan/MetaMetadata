.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHGO5rwV4_wQ7kNvwF9G3rq&_nc_oc=AdoALS6kg5CBY0t6JHc9ovvnxhlLxs6pxy-f9b0SIw-91e8ekNw692FpZITT2qdZ1T0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5msEQ4rDlp96CT3aDmoqKPIxfHlj6KsbPPSDbyVKOCJA&oe=6A1841A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWymX_lV71sQ7kNvwFPBhb_&_nc_oc=AdppP1Bz2h4y3l7BadbHX29-BqWx6Cp11bBSQWA5cOhEjn4ATBN7KaY3aDTdBFCQmzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ii7W7ROJLEVVh0WhxHNVgx8DFoomqUoHJvOzZOqLd9w&oe=6A1856F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaKsJLk-x8kQ7kNvwHow6Jd&_nc_oc=Ado9xnE8JqqilcVuNerHh6Psk03wKUvrnDvRBGleVQdVu5lwnF0wZx8xUlPaW6bW0AU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XcUbdJAiV12X-JkMhFCeKNey9KRM9OCuj2GinHqurSQ&oe=6A183170"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMrl6xnLXNMQ7kNvwGSAnLz&_nc_oc=Adqy_DcgEEaG6buvtUyiz9YJKC8h5e-RW05lu7fC8pWx40VMrFQREkvHwaRTgmclaFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hJzWGkmPYACG803nukIVDYNg25hiRx36v4GlD76Redw&oe=6A184A00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdwXJMAb57MQ7kNvwEPA94S&_nc_oc=AdqYPz4zNihUG7p25zFLWvU_iOjTD7pBFDSyOWc9uhG0pMtoVHHcSZIcfNv-IJDh1N0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C8DDoTvKFvZJf1RX0zWrO9rM09WsxenGfKC25wgyRbw&oe=6A18358D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDmM6a3Rnm8Q7kNvwGji59p&_nc_oc=AdrWuUSTs2a4MAlf2xRqts5kP94ABOBNz6oZlObn_2JHCT7F9TaV6baosPtnsHnrawI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tyEAPNJnJ8V_kGveEVauhuRC2DlDKqiOoLccZpP4O7Q&oe=6A183EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXnm7f31_lQQ7kNvwEu2a2q&_nc_oc=Ado6OxMUctNTNev254f9y3UQUPD4dXyKjoV2_isGc2ZCv0jG1YbUYKTLD7IDzCSILKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W1G4GkRj75H_EwnYJ6-KFMP9LswjHE3fni-2bHqeofw&oe=6A183472"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HbN8psOv0gQ7kNvwEk8a7r&_nc_oc=AdpGVr3f3hvmPnOdjtMRUCdEChtUtP-9NUg_ma14ougib96ke8n8K2eEo3F4udNyoyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xmwtNW5g6Qp9W21v_z6qHeRQGLwjCREXF1BX5o_-rOA&oe=6A185BA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
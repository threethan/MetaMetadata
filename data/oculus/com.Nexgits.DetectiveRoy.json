.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5mH6ZmKAAUQ7kNvwGjgEQv&_nc_oc=Adp1Nv0LPMHJFSPWnYBPKgV9MBgPmTeeD8016yUI2QmNGuRQNuZcLsVUZor9AoKmExU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yIBiwEtgP6-oo6yuwXSLxOoFywS6YKTQu1iM6aitFvQ&oe=69E385A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbyuNMmZq-IQ7kNvwHirObA&_nc_oc=Adqv1RupAWrWoLtMuLKyObE_Y60p_tPBCpl5EVi2eqWmYcQ77t0XwJLGvMWKJ0kJJwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JT1UQas2rWEv26c0iXDaDX0AKCim0Ua4TtOhCKORRCQ&oe=69E39AF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXCC6w12UQEQ7kNvwFHb8qD&_nc_oc=AdrGFKmbE3ileNEX3oCdiP-6nL1fuHPZo2dBl0joi_B9_uBZ78jZ5U6ciWngyjOJgpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Am5vumOQz78NnW8kUcFjTJwMKqzMA81jzZjFlH7z7tA&oe=69E37570"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED5qXe6hw-UQ7kNvwHJXJcN&_nc_oc=AdohfKS6lS6Rd6wFyTsu0nfnmbFsI-4FXORYqLe9AWhxHAAQuQaEfc5OCWw0Z0W5qYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FvI_-stt5iVsoyuY_6l7UnXsvCr9UKRUK9Sz9sHElSQ&oe=69E38E00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_QtpRLai80Q7kNvwHB6Dy2&_nc_oc=Adq9XvZLCBu-pvlUD5FVRUO4zpUn7_0No1AY2lCFl0hkEbTeIAl8HJtnGkz30qX4bB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QQdS5FqdH6zQlDhjmqosK5hpkZimP81jTl1tlFIgC8g&oe=69E3798D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzEm3zMBr3sQ7kNvwHm1hbk&_nc_oc=AdpFVqJiOB13qsKdYFBS1_Xc1qKjThHGwe7CwTNiYC06ERgjIC3SEWVN-n8G4tk8mMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wZQQ4PCAeMaxkDDqLR0bEFjT4rGri_hGU85PO4Jn6OQ&oe=69E382E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmQLSRm7XtUQ7kNvwFIHcEt&_nc_oc=AdpEZcsvB0w-S4_Uyqy2FgpRNuTsG3iPG9MM1tMNha5G5Ir1NYmpSIYvoGfaeegchMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10JVo7NY6DFhb7BuQVrRJZCayVl6ZUif0-rTmw7cktdQ&oe=69E37872"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqH7F1unqREQ7kNvwFeJvk2&_nc_oc=AdqXIivoC8QxTDkrfKNOnUBeExTcTeCtMjFKSsvMgo02RpRoHCGm212vChDAdJvjnJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yfV8phRo-i6p3IPtMeZl-ViJnXSBM35oTCc0rCRhHkw&oe=69E36768"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LRnIXQ3x5gQ7kNvwEc0toO&_nc_oc=AdoRdX4S766Ls-pfnEbYQ28-ASMPzjdWvKWTWaAJRQ1ExaTZhi70T8dMhLn49nGBzz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM8Mlx7fr-VLoj3Utvjrxvz6VhCZN7VPsHv5S11vnPSQ&oe=6AA6A3A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxrp_FDALSkQ7kNvwESYBWp&_nc_oc=AdrF_tQEQ18I6fZKmFWFoSBIDTTvg4hpH3GYin8GanopNarqGO90GLWRW4hJpHv9eyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBFOT7FZEUWqrVAGJdr9Phwl4amUsM_r8L2l-GOHvyGA&oe=6AA6B8F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZAnBPPpWNcQ7kNvwGK-PuL&_nc_oc=Adr7fXEG4IJu61uhpYOrBLadeaxArYFxSqgIVPPCJL3Z7MOs6WqaIk-8JoZzjJ0hjvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHpjN6F9YB2Soxx5qRQKuG5ur-DXJ5WlO5Swgu_AuKPw&oe=6AA69370"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h0wLzzEJDcQ7kNvwHSj_3u&_nc_oc=AdpHzY-eMgVM9eQEbeO1b8rKA5YE-dDl6v6-tHWH-zFSGmZam7k9vAneFrErlRuIOwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG3eHgB1KV6bkLClv17eUerc1vK3JfoyeVHs1GsZrU2Q&oe=6AA6AC00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7rD5lBrq90Q7kNvwGlzbr1&_nc_oc=AdqH-ARr83au4Sue-qk_KXA3CaUfKm8nYmOh8Y-VvxTgiHqarUo1OHhHG_F6V3xO_yY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUqVmEqn8rWChUQQqe5kdhO-xLY25vDuZyozMeGrDMBQ&oe=6AA6978D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjFxoetEM30Q7kNvwFmEtD_&_nc_oc=AdrUapQChe5I3eqsZHmvue3iPg2WsOLr7EImW-eDW_jYXvJbN6INeAMxycJcIkX8v4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTLPQ-sIXa-0pTeyUmPoyNtAvayuArsePzU4FPJ9F5Hw&oe=6AA6A0E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne0U8vOfjJYQ7kNvwHfu79y&_nc_oc=Adqi6_b6MjDvAYm8LYv-o6E7J6YBJl9dUjpxnR8JraLYxTNkJUlGFOb7gR8XzjjnVJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt600kQdbmA2NYJbAOcKn0Fv5n0P9opB_w8QuZvyAk8w&oe=6AA69672"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc2OzalqwPsQ7kNvwE9KNkf&_nc_oc=AdrbRYCR1ouqQ7Oqiq7cidgvBCrOXxs0SgyvDbYn8ok55rbdXgWDWBNL7EjMo-fD06Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJttNToIVMmfh49LLIijtw_BBXWedQJ4IgE0VPNoGsNeA&oe=6AA6BDA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
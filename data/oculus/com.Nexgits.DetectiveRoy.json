.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V17OUWxkvlgQ7kNvwFRmuJ3&_nc_oc=AdoV31SZz2zoktCxwCFDKSY2O-36zCm2UXLJr8h_tbvC7TohyQNmp22s3qJjYJmhjj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMwFVQ9CHIhr27BReF8QbmLka3ejPv2pH20FUjoUpFxw&oe=6AE9E022"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXs9Zp3liIUQ7kNvwGYnt8_&_nc_oc=Ado3noZ8N1t9JiBPOROFnheH1KIoGz6bmrbDHDJhIQCZ82iPvNqONzqtg8SP27Yyr5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGDYP_t6n9le7RY7amgvdLnccBYINEQYcfdheN0peD-g&oe=6AE9F578"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxIGK3yONC8Q7kNvwGAW0bf&_nc_oc=AdpKcCTu-d9gsaWtzoz28v0-AZ1yBEztSg1HmUpJyu_tZ65jp5SZofY-Pews5SLWVdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6enot-ouWqpAGsQy0yAwXsU5uGRcTjxlc-3SmU1PUSw&oe=6AEA0830"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqUZVMCQc6wQ7kNvwGkyeNl&_nc_oc=Adrs2rBrZXN3hj6TlUao948Rj8_Q6igB1FgoHVFJM1MkUTmbMuUNekgqmkRP8ukTEuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSloesnuW9DDFxaJEERGZCPk9zmCeAoVwd9pWOmHyFuuA&oe=6AE9E880"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KBZOUozBB4Q7kNvwG-DKqE&_nc_oc=Adooh5LAH_EI-ZHjXahkJfUgGyYxloHF5w8dyM0FWPA9vZAqolR3hG0OAAY1AlzDPuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqLstZRuJPeOPLZLC07z-OP8Ef615a2rSIKw5vcQqtWQ&oe=6AEA0C4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ey89eviac4Q7kNvwEcAEh4&_nc_oc=AdrCera884IxBaACutp3GGYTrTdehopfJidRbEwrSdCfpdfHDrnceHpzNbpeShq9JTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSWRyiuJiVb2qi3kVfJ943V7vPuq2BqBwRSW3C4K6pnA&oe=6AE9DD69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFceBfdEBRYQ7kNvwEn2kPI&_nc_oc=AdpvbLPS7DE2_h4kYQC3jh0dl1TjrTkm7hVteeWGjAJPumZ1u7sFBrLtyHmjJyIvq7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaMpmVQLLUbVxOPoTVVCFVLGE8SwN4Rg_2GelXfVKZFg&oe=6AEA0B32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_YwqOLvzOsQ7kNvwFvceLs&_nc_oc=Adq8ISGjbV-Bcbau67OLApCBCPOKRix0mG3aW8bdeZKOb_cHJukK2yMmAlRvdN6GpJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzSjaPD2UyEkHxJlAQgGNtjL6OUiuqrAjq10oM1GmwSQ&oe=6AE9FA28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
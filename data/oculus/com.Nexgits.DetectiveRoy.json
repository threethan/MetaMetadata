.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLqT9gU5QzgQ7kNvwFSBmFu&_nc_oc=AdqwHFkl4tBzAGG4t79aIdUUe2yaDOYTyRuBEV1KLZ6jeBUaHR6gpu8MW1SWPMmHbt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXedR2LhV83mq1510cdGmly16Bvx2K1yehWRviZbEf_Q&oe=6AE1F722"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIfWkLXZUP4Q7kNvwGmoBdG&_nc_oc=AdquMFWPD5bCtt8CKfAg8RgQ0eoTcyXN6CeeRM8Pb6xaE_pj2lHWcczOkaoX0UlRML0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVaarZwg-uoRZ-tHZIRqUmpVCeu-XI3Rn0X2grpHiyMg&oe=6AE20C78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgzl3aR1GlYQ7kNvwF_5BQB&_nc_oc=AdqmkoX17ez3QslQSyCIPIRt8XuFzizoxDZXrWYJe67Vee7YDBLC6WZ39gWZVuawSUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvYb_59fL949f1CeyaO0TKJxEVN7XeDyFBIcP5KtrgCg&oe=6AE1E6F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkmslzFult8Q7kNvwFSRzFT&_nc_oc=AdqtDntJ0OGe-G03mZ7ZTY_sSvaxa4v9lcfxD9gKEioSOYMIwHXLPwRBOA4tjwf11hI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqQbA6Mp21EUGZMy6khhdiKQYU6_8TYKCX62S0R4NCaw&oe=6AE1FF80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS7_FjADYF8Q7kNvwHCA8zm&_nc_oc=AdquF55MBTrVXfC4ir89gOs1Or9pJFbzUpJzTWL7CbFkYTXF7cMMvV1AgfAAvt-TlUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSgzfUzDXU_PdPySpVNGY9zaXsB7PKcsO4AXv3UEK_7g&oe=6AE1EB0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo_NdpAcVFMQ7kNvwElCHIw&_nc_oc=AdpLyRQRKSXYE8Ozu-dpAqeqLWDMIQowYK6PpSsnPSAQddv4mWVtCvqYdheFIdYZOcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmH38j7u_hh7ehv9gLLrMRc5CJgdE4U3DsgG-N67pkYA&oe=6AE1F469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUV-huqyKj8Q7kNvwF-7CvK&_nc_oc=AdpLptNqCohFvWcPOMiK3qmKQYegQNSNxwBvXXew0HVse9qrx8p3jNpt2w4NWZXxlFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi6i4kKT-SbXBtF9vT5g538WuY59k4gbqt8fWp-gLo8w&oe=6AE1E9F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05_04GTHxzUQ7kNvwH1sEsw&_nc_oc=AdqOHsG4Lgol3gXbmFgM9PTz-eMF3bv4E1aTp230AsL2Aua_Senjube4xdXxJjAzM5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2jZlhIL2YtqFHDg3OurSOo_jFbPA4OCR5vleGHUBjqQ&oe=6AE21128"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
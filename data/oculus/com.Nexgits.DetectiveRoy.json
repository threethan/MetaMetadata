.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIRr8h77EfcQ7kNvwGXKjCd&_nc_oc=Adr_lGBEkDwj27sBLOkKXAm7jW5MfaoRqNWZacfpY-cE_8wj7NCFMWM_8GFBjMwwcjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh9wcSVw_USDBNPDkRjYZzEuquOGvxhw-O2QyuzV67Yg&oe=6A7B2222"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u4IwSDI5w0Q7kNvwFu3gqe&_nc_oc=AdpVLFUf_XxeYAt6VYaxtQqAXo7QqeqIdngKgJE33WEzuIcpm9Yals13ihrHq-9VdYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcsGT3nLTUdjSUzjxpT7LBnBRwt-iHAZjUX_io-d425w&oe=6A7B3778"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9DnLceqXMAQ7kNvwF7P3-u&_nc_oc=AdoFyXgQSAH7lVqe59wSxlTSBWIX_D5MA1uGzJ9595nURMUJnbBlQc9UbBVPtLGGlkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHicp1Zpv5C_omEHpH21h-p0syuKEGgLU_0CXzET7PICw&oe=6A7B11F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFPtIcD4JqkQ7kNvwH54bkh&_nc_oc=AdqkdZ6qPuKjcqyCCuayR3TkO5JAZ-hbtdkPOQKoI9Gx7qWwQwWthFZVnFjmBc1EBiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTdtOYhD37NCe9JHeiipVe3HHkBOpDx-waZvn9Qm1h4w&oe=6A7B2A80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asdPbi7tT9kQ7kNvwHT3rwS&_nc_oc=AdrouLFWHBFYQ0kU1ZQNshkZ9DIil5-5RpzAxxzab8AvAqOUWG-p9NCYCxVUA6_pZTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr6NpLjks_4TmEvkLoL9QYRQc8NP_8bG3_a26Z3uIYUQ&oe=6A7B160D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Q-Iv9HJfcQ7kNvwHVHD5l&_nc_oc=AdqKE_ySWn8EDJfhYbRCKwG3CXJKsXjpDhA4yrLh5x8GxL4RYWZNzLVA99OoFtXjdhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeKvGixeZyzY03N8QnVI9GBNMziESoYzQSB-t3IH1QLQ&oe=6A7B1F69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hmyc-M5EhsQ7kNvwHyoF0O&_nc_oc=Adoyyq4EmVoU0LgGvLpsIcCwOHB5nrmvKoh3vt_IWhTfjzFF55cFrHldn20v0M7WzSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG5Y3Rq_nULaUmJo6v2_fqvlquRM-iQo8GfmW-ACvedA&oe=6A7B14F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acRTPPldZZEQ7kNvwEmeFu8&_nc_oc=AdqhSlVfv6SeIjbOA-U1Q171PmmNboUnTdaCE0g2vSFhtTRXtNs7DKuMnqul36c1XlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOyjrOE03R6GNNmmQiSBjJ9IGbYuOKrXT0yLlE0yu4FQ&oe=6A7B3C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
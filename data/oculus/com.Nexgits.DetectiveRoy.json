.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OMS3cvdy1cQ7kNvwFu7hMg&_nc_oc=AdoVdOURyC5eQJE4h2Pr7v0jZc8kCU0ZdENt__Q9TEqX3ulPfGicfF7vGayJTjvtfYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79QDC0xg7gjU5hiUNlom0MS5o1cfmCBbVZY-YXAB9P9g&oe=6A086FA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUEVgpQvlQAQ7kNvwGO7p_S&_nc_oc=AdrVqIn91boiH6ZuWjkuJHkzcvd4iHvK4OVyRmMGU7cWLB29D0rTQ077iCO2BQzlIpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aYmlB-U3OOvFD8kwL8Qqg40nv77oS5FbSrXkEi6l44g&oe=6A0884F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW5jCJGDMeIQ7kNvwEhhpXL&_nc_oc=AdqIxA965vkQgXuQ18iNDDQIofqtCtN_QJR8GGOXzThk0EMkK8MhxFE_olSAHDfBTAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dpvyBF0-5J-Ey9F0EGQduAxTxIy3Pbg07lpTeTv9w-Q&oe=6A085F70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xP6038W0KoQ7kNvwGibBtt&_nc_oc=Adrh2644IhSL05qcbeIlyprBu04YhhSJZc4W2b90ETYPe6HdBqOEGnLDX4D42g-baVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cQde70ndsczW3kJFGx07aXUtqDIk8CQn2U3LPC6JZ_A&oe=6A087800"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58y33U3ubMQQ7kNvwG2bflg&_nc_oc=Adqq1C52Jscz8RRUGL24jfScj5VqP4OB35-I4J-gN6zYFO9lF0YjEpt1vUieQxbSFro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gFTzXuxK5JUduWQxNzkN4DbpLoS0_1g5eFcCtMRpl4w&oe=6A08638D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6lE_B_l3zAQ7kNvwGiggD1&_nc_oc=AdqFL1sbwpEV5hOwhkwZ0bJsa9jWVDyXbej_fjB7UBFG25WiwR3hVe9fGFzwwZkoubc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af688CtN6F82bbS7IZW5sg1ThWCRQFXS9bepY76cno1QpA&oe=6A086CE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1KVaB6BJJIQ7kNvwHdPNLl&_nc_oc=Adr7blgCr3ZSDrhcGB3PUP3hWpwsYbUisyKA8PYWNVTEx0iU52bqx2bnWZyrvRdRq6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bckNUj_45gj8_WE8Jeuirws37oa4J5ccvI7sfvt2x4A&oe=6A086272"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s37GZj2o88AQ7kNvwGjVKhk&_nc_oc=Adq3Gt1D1Oxla2R77R57O_tNks_lZMvY-lzgAQfnISTgzCffXcoyS0WKuD5FfA9hIsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eMKjtkwRHeFAoH85ocdiaxSyV9DjtA9nuoTLgtAkgZg&oe=6A0889A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw_9CikO8PIQ7kNvwFhQn5v&_nc_oc=AdozUAIyV2YdQ8fU0aqmfUMA7hmwNZZ3Eg6vLoI_kP6bi37x45LYL9VgcombJ-P2Izs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN97UUP-35gINlE5KYkg17eSajrJrGsAYL1OStsXtHw9Q&oe=6AC25322"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_HbDSkAeTgQ7kNvwHIp0Xk&_nc_oc=AdpGuLG0bGK20EQRCUGUvrs-YK7PmAy5gg62IZtNTXpLZzPAoX7cVskYHdbEdtK695k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvYCHPnoVmGJfPNvAs8off2i8K0_KgsysQv9abilbAUw&oe=6AC26878"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6bpeFAfF50Q7kNvwEIyuJp&_nc_oc=Adp-TJpPI5as15Sz8X0ag4Zg6b5noI29FMdcLrSPgX1thWQ4b3LdA7aqTn2n08ssgUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJcdGr9hMXBuuFwHCLjZGqQkyjrO3Z99GK0ByxLg0BYw&oe=6AC27B30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSABNEUneWYQ7kNvwEvfg2j&_nc_oc=AdrYdLIEznvSCcLFIJ0PfvkxIxkvYzHjqSKwuPeeys2npC3ajMqAtvngyhGOWzpoH_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv9WnplYO-qAgaKEjTgdC8hUqXaRJAlI3Bk4_cS95_lw&oe=6AC25B80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQFT3lCRwoIQ7kNvwFoIT1q&_nc_oc=AdqxFjKf2iM1YZlOcqg7aokWGgw-NUo6ZYi4tY0Izs5bxnkr_j-tcP-X0bwoMF1-MyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd7Au8Hqe0wgNEMBfcftgSjWS9c08oKfWtzeunFx5Lbw&oe=6AC27F4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIwxqOF2Ln4Q7kNvwF3xXF0&_nc_oc=Adp0H46RIauXAKnJqqeqpX-A9OQ-uEH-z0l_TE69GAnko_1xwGvXqpsR302hF40Lr-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7y8WSASKuoO7m_R4emK08xTSkL5jmABbv9e42Qls5yA&oe=6AC25069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01-EnohXs8QQ7kNvwEsI7lp&_nc_oc=AdqWVqGY1WXcP7hv9Hsir9cVe8GMJwep6PhO3LfZGIe4IwZYzm4oD3niKBmqx60uDQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONI0gEvonbaKzPXJ9JNmSmNkSnplTq0U-Z_kfyfaWF4w&oe=6AC27E32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EURtrRucnS0Q7kNvwGdSSUr&_nc_oc=Adon6-yOQNLz5g37IFt2jJQ9iLt-GWZAr636DIP9asn0ixrZML21UKwg2P9F4UvfbDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3GIQJwYw8UA2NIqbYUGU7tcTY7wwFqXkNK86bMt7W0w&oe=6AC26D28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
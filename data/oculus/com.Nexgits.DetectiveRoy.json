.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XahURRrIc2sQ7kNvwF4vlVS&_nc_oc=AdobHXZBZt8MFS_N7Q-iChxT_oqe1FuluNThLSprWj5rS1gN5Kv0lbuFOL5UxIBGI8Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n52gqsyZWXwEOykEHSyKgU4jx6P0cK7J410K_dk9pDg&oe=69FDE3A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8T_RwVaChoQ7kNvwGhWZRw&_nc_oc=Adrm4_ZfzkQ2F8GAe6L0OxBwYdGUowviZ729PMlLhmRYZFsZ4L7gmircvxd6ms8QScQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dzH8YTe88wjmO9lA2V48kgaVXRdyhPAKg4_fHHk1ToA&oe=69FDF8F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYJBWmKFBMoQ7kNvwHuQzI9&_nc_oc=Adra9y86OakAM8eWcaujT-kp_R0JYjvfXLS3hpkg6HbbDePa_YhL1vKElppx3pk3DPY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e1tzGB2tVE3_n60_2mAOZWQ5TUwPzSrYeHkvq9A3ViA&oe=69FDD370"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDnqyoJE2ngQ7kNvwGRrMf8&_nc_oc=AdrFU20egkdhZOzGoCefMZQpdyg2wl7lTNIz8rOpO9RMItlXYJJiE6MA3Mh6i1ANo0Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SC-9JXGPGjsHNKYwWVeD1DivOtAdjUDv2lM9HwXBZ6Q&oe=69FDEC00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-jMiWsbAkIQ7kNvwGpICxn&_nc_oc=Adp_W7kuI415-Erv_e5fsoorfk56_EW0_iqw7MOgRs3n5CU4ceczgW_IXVrLh6MQwdk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QDCp8oTMDN8yU_FKRyyalf4uMIhNqcYoYv5xvRvYahw&oe=69FDD78D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpOJtFxg4BcQ7kNvwGCInyf&_nc_oc=AdqxdisxRXRqvczVl2b-rHlcOlB0_UyMtQRNNgAvGp8JP9TfnbHJ5_BORdGacehzuEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XDGy1jcWTCU37Mx39yTFLietnR790K8axmS0Ztva2Xw&oe=69FDE0E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLAF2RMq18YQ7kNvwHlVQr9&_nc_oc=Adoa4nGlPtDrjHEO8gN2025L5VmIs_vuulmpy6I51K-bxQ-wN-q3vmQCndOHb8-IbMc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QLSQEik96nEIbbg4DCYrPLJ3uebz24vI7QWakNPwatg&oe=69FDD672"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHbZqXgvuiYQ7kNvwEytMxL&_nc_oc=AdqqPgmXslxrx_nr-GkdC495-T-ysWSapkaX4Re9yvadcMqztVgYwhdfA1gercdPqAg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xt7SUvQ1wxMPdpFI7dooJRZUbusL38vdHAlHiLTGEJQ&oe=69FDFDA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRyF63o37Y8Q7kNvwEqrOOc&_nc_oc=Adp2WmlaSFqYldPBYVhJ50TJqj-i_CsFhjf4U5pW1zemLU8HpcITbfKJ7_Z2b49LbmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJeKcZ_YSmbl0tKgepxGIJb9qaagqXsaL1wYRImwAIIQ&oe=6AB3D2A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idtct2vAHGsQ7kNvwEbee1-&_nc_oc=AdrWgaM7VYHGQZx7aCIELcWKkD4lQSeOo72WZxjafAVZFkMcBChiGgspmRYM2SeFnL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsk0aIRy1V02T1dTZRoeQpufc_5hBjqnvEyxw_lYsO6Q&oe=6AB3E7F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DOXaxx9t7IQ7kNvwHnZ1av&_nc_oc=AdoLR7ikgvOI3sdlPGk_CmY-c6cnObV9gUCT_QDhPd_hj-OeadwIYf978hUq51lUz9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK044qY95Qi3UEfjfot-pxPNVpsq4YBb6c6ufLxSyX93A&oe=6AB3C270"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT1jXgPuFggQ7kNvwH2AH2x&_nc_oc=AdrVA-5uFMInQbxdjlZ7WHrTf-NcTL-_uH5ZMEjtZXvi0yJ7-7cjKa6L_OV7_59kXgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDAq5gbA9Nkd2Fi9FwoR_MxxGLsZiUBn6AIyZc31a8dQ&oe=6AB3DB00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKDADyMHvJAQ7kNvwH1wmsw&_nc_oc=AdoS7i7EOP5R2Fp0j4RsgIvlwMTlJS9cxJhRrU4E-V_YQldI8xlLmhVCGdTUDFeDUsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLImcaQJbFAin5D7ylHmh0MWkDkf--HS_tpQ5nKegAfyA&oe=6AB3C68D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUSOIS4reRMQ7kNvwF-xdn4&_nc_oc=AdpVgAe-utivkhmG2ATreBtHt31zdn3koFfg0sN5GYX8Inxkd5spQwuCMH4Wp5tF7s4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL15KB9tgwlimpwrxYezaf_PhQZTyAzUwN3zvAYbfOkrw&oe=6AB3CFE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY6ZaXv4DfcQ7kNvwFuPHpD&_nc_oc=AdriImF9MEvIEXLpyC44hD4EIXnmhASbNhO6xLxox2BCNstb7_M3NPme0qikKW4f--k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiwAF3bM9h0pbmuleXt-cIQe4QMWhXoBv6zJOw4VPTuA&oe=6AB3C572"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UE9LqxmR08Q7kNvwF4qQys&_nc_oc=AdpT6aSiE6-4wCsouAZuEp1WCuPqgohVO3i9CXZ9_FvXq77AwrD3B89Dm6-FfvtnUng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBlUQFkrBEyIn1P9gH8NxgIcf_vYlAQo2NQgsvWV3W5Q&oe=6AB3ECA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
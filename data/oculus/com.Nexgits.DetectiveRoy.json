.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbxISV4YdmcQ7kNvwEY2wdT&_nc_oc=AdpnzjL-3Lijpdne1mGqL01xClIU5q3T8TI3kAnjoypcVwyh1ENZb_XenU5baxOe61Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8rj6pGjUOvhUW1OGFs4LPFfZ2bzJ5e9IJS-Dbw9zvrA&oe=6A9AC622"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu5q5CLMOkwQ7kNvwFR5dzM&_nc_oc=AdoWXi9iMpiBvxmN9nrmlT7E8OkvOkuuYP9COjOR_ot1wAVtppK4zZYpHjguIsYo6q8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBcv-2r-kKin2K7xPKKEhRyKwqMZUYOGW655M0vQPAlw&oe=6A9ADB78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzmQwUBcPKYQ7kNvwHq_Jlu&_nc_oc=AdpM0vzHu0q5FoBopLgAOh5bZeAt24ttVJoEqf57ILWDdjLxaaOgVSqJhoAQs1Ylq3Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdnXAt5iZjBXffew95icR59iCzIYDWWXoRKlLXZAzn-w&oe=6A9AEE30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rkOeksto4AQ7kNvwEFHkgl&_nc_oc=AdqBusfXJV-U_k2-SXRt7VaZ9iZCi9wsN2JqM7DRZaLoPefILC2582_VFRO2sxJsxDg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZuqr_EVmtPyC9i6rw234oFY4tdgrsj3PBb5zjjojKfg&oe=6A9ACE80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEeGdEvtVPQQ7kNvwFHnuwI&_nc_oc=AdqE_X2fimB2FYgTxCTLwFHgoMzC27eNiOs6ZE_zb87rC1g3qsDRQ_OVAfAU05XO1Ak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNef7qkqyajfpr43moUXGR1MfcGN2Fqo30nKEFi1bnig&oe=6A9AF24D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofb4aiT3jgcQ7kNvwEk-XfU&_nc_oc=AdqoNcEPXQ2GsL0p8H0ob7R9NuOK0ZApmr3YgwyePfnPhAHsdTxU2gkvImqh5ltjUHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdTuXS9D_oDSVvUslehOpY40ve95Pe2nefhwS03-00yQ&oe=6A9AC369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DblkdsQCgzwQ7kNvwFrnsg2&_nc_oc=Adq6leA6AKP6R7k69iWH2BGDOyouUfm1QLMkJ3EKRY6cCY9LcOU6mj-lEg7dqngI9uY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOAtI66zTI-H6ZiWr-SqyqJ0gd9jy64erexe6PXc94GQ&oe=6A9AF132"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf3phQ6tvfMQ7kNvwGM-Mrc&_nc_oc=AdpPGesubLGb_B6FkZpl7atVK_fP_AZqbS0Jkz7OGvp87jKAcy2x5Xyzjq89C5ULi5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiAQB-csmZ1xEMJ9HJxAQZP1OgO73c_xRBpyWxyrzhUg&oe=6A9AE028"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
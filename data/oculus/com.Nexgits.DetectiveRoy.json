.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmq-IMTsRqcQ7kNvwECsdzl&_nc_oc=AdrPMv3i8JzvbOsFRPgvQLrASMreftrZ6xPNZKIbj_WkFm-FcS6-VNnbIHuPXM7hQ0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOLcb5yryFliE9ho2FGayHfCiCuhCO47enRk-p5GP3ng&oe=6AD22522"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ-AWPfKKtsQ7kNvwGJ11F-&_nc_oc=Adr7k2ENRX53IcgE_sipfX221VBtX3xsr1UOctS5pW0mRxP1GcBv8Sb4ydrsLYFyb9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnupzZCyCKGCOKi3MZafzP4qo9kQMAKMQWaf5DKyhDKQ&oe=6AD23A78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtCQnalKVdkQ7kNvwEfdIay&_nc_oc=AdqyOhPoQk4QTOZSaChXFXhV8HeoZZ13FCpzItc7WcNC5LuTnXGPADo2KdreaagJXn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4T7ocN0MLk9Ksz_PfCU9se25tKieNMOR-sQtDEnY7BA&oe=6AD24D30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KHa4y9Y43sQ7kNvwHQIMyC&_nc_oc=AdrM5Z60EACI7YoIhO5LTcOpXxWlazz0StfpNLYrcZYl9KYVGl6FEDTEJPWzHQUFG-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxezKj2kcaT8pDtN6HAl9JGN9vABNIp3fq81Fqdy8ylA&oe=6AD22D80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kktV6wzueVcQ7kNvwGBDF-I&_nc_oc=AdoS40BOyjMYXVz_ylZ-sDAwWhrUXWDRwZRsobRS2gpId9pOYn_3RsK0ZCvHVzzN-Sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX9QKFRfkvAHbiI7SqWuxfLI_mMlHSSHPO7FXLg_FP5w&oe=6AD2514D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKicChrKweQQ7kNvwH8EL_i&_nc_oc=AdqXfgUjAJT1-8sQC-B62cFmE1WOp2P9TAUePwwNi87GqAIJPfisOP6HlF3LEcTWAGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUHgoNmEtyy0mOpD7uqTWpmsTR2GeTiN8z0CKWh_WULQ&oe=6AD25AA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GUGS95ZRPIQ7kNvwFuV4sS&_nc_oc=AdqP0GzYi9M0cqQgUIM4NXg5UrTc9SX0P6TbI54Hry8CAQxsa8zjq5bCgCT5gkr8w14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQhQlOvSdFDp-AWFvInihyVCUho4Hy1WPLQUXf-Lg0Fw&oe=6AD25032"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA8_lMk14i4Q7kNvwGUEXS1&_nc_oc=AdqApIwMpSQ3_2HxI69BSTSnX1GJllMp99o6KRSC8c_TBbrkZ0lMZEr_JFvHSl0iVyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnVQ_8bLIRvDpGBBdYpoiIL-M27rRIEc5IZ0xgYnWZXQ&oe=6AD23F28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
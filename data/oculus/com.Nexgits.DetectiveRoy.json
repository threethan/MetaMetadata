.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eFMZR1uZ_kQ7kNvwFXYrZP&_nc_oc=Adp2EjQa6qRyyx1jlHLtJ_0qpTxhlSMibZGBOa_Yg2eR3O_9eObc37ZB3pyqCjRgCDQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuue649VoLnqOzMZb0PIBuAYL8-FwA53iVkTjkvWM4WA&oe=6A92DD22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNr2cbIXOJkQ7kNvwFB_0GY&_nc_oc=AdqD9xr1rUIdf2CdRfIXcQpOffQ8Bi-SzGQTvN_ZXe_PCupQRUtLRIDiuvdbH9H9NdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQOQnFmJUoUj9I670R981--Tr_nOut2YFmMkkDRf5moA&oe=6A92BA38"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JF5pPvu8F4Q7kNvwF7yi47&_nc_oc=AdodwxH5DM_H6LC_vozsO86DjDaQD-GIikNs8XQOgEE6s0v0SyM6KFASF7Uqu8zUgDY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSDoiJcSisEbHsuYyHmW0NBPgOUArGfopa0OeGgFOBkw&oe=6A92CCF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiJehTyu5ckQ7kNvwHpvTqg&_nc_oc=AdpiCdPf26OMukzxevtNK9gV-15jfMQVqAwNUMxS2Ic9rSjaPTA3xQr49iws2ozQEv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf5g0tt4hb-EXRe_nIl6V22JcyXD_Uk3fJO9Po69uWTw&oe=6A92AD40"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muvT6wpK-lUQ7kNvwGwcIpt&_nc_oc=AdpKLTy8pW1Sh7m-fWaOEgaWlJmox69229zsM98TcWP1RvNMY6F-wSfbJhblSlcL1Fk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbGSJSkhv0cT4IUqqoDBg8eVa3FUkT7l2uXfgVy6_KIQ&oe=6A92D10D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS4VuAyrlmEQ7kNvwGDOElP&_nc_oc=AdpSESovsDwdF-8nJuOsEkD-ZC95J6PMjmW-QOnlTE3CftPXNLacDPKNR3zk4gFGzS8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8akOAFDbIv4txc9jLwgvdRR_RgV_3sp74kF4iA9AlsQ&oe=6A92DA69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG0BdxtR0NgQ7kNvwEUdVed&_nc_oc=Adov7L5mxsTK5FacxGaKKiUZ6S2H46Dx4BVQYl0UThbuQvJitTYeyL0u_eS3Op-vrQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmDB5S072ryoFCMIysNM4DFMxJfQ2642AtsRWx9bzmYQ&oe=6A92CFF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHFyxji_EhEQ7kNvwFizt2x&_nc_oc=Adrjuof-NIaEvXmlTedT5v6zXeeWByWySOo4EkPk_w_SUGV5rErgBhq1118c0df4nWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5iwhh9Kwoqqk-RD_JMPMJPIWETAQPug-BshT9zy-0fQ&oe=6A92BEE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
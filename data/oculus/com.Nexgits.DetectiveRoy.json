.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5gasRxYc8EQ7kNvwE02aiE&_nc_oc=Adof3PRe-OCDRHjHnSxS318Z2SwJ4a2qRRG4I1vThcHMuXYlVS9FqSN4TJIoKtSBmG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbkzDxdt4mATKku9GEvMQVmCkRhqy0hPdS0jbRZb7MmA&oe=6ABE5EA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4uUo0XCrckQ7kNvwHRgXEl&_nc_oc=AdrfNz7J_4Q4Ktjfyohp5X8KJBQVcI7_MFor41pzYX4INznMUcGw9GsCyu6xQzvp3PQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY43drIIdSyG0sVumIIS6AMMwvaUX4T1kubdzrAzW2eg&oe=6ABE73F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-rwBvzWLx0Q7kNvwFRRHF8&_nc_oc=AdpCNWTGiG4ePi3aMD2JcYzxwMN9KwBfu3t4z_yBu7oFzmi5U3uC5utqHcHI4buc43U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7QWr3Np0BdBuxR95ICnsrFMJRAyMWrB_5qLL-EF6J4Q&oe=6ABE86B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GStiDLep7EkQ7kNvwGVKWS9&_nc_oc=AdoXSRwna1qlc-0mqISKgGliDEPa8ZctASO8-lcNmuC0xMngODGhqwRgTpA8wl9mdAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyhrM2HrdDasIBCmgL8MJMiMzT5lEtGg5CNiJGtHK37A&oe=6ABE6700"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rh87NUB3tIQ7kNvwEYekYa&_nc_oc=AdqZPWYNkr7D48cWeoje3R9Y7YxEPyh1q5pjmCmfcyzsvGilhwlFSNXpBIfplX1iz9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjFMjJcQ-EUVanFD7hQCUgmitfIGKuMwVSPOpntcYk0g&oe=6ABE8ACD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFV8DIFSjjQQ7kNvwEO3vAZ&_nc_oc=Adp4FSbLGfE3DzjSY0Z3JdG1HY9s5mdfePwk7xtT5Msc1kaSZPUvuyPSHaTQinVJdwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlOnGLpmE4mw4fXJdM7bPBwfotTl9tI4SETWtP2BtpMA&oe=6ABE5BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCpZ_3B8T34Q7kNvwGqhcLJ&_nc_oc=AdoK71Msl-PXf9L3kIBHOtteO0yZRIHclw5INhUQqZ-Foyo49RmXysJ-9kcj7XCAIYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdGZ32wOGUyo-XRYAx_z-xOKKGO27kygqGNvd10ny4Pg&oe=6ABE89B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5VReJDXeL0Q7kNvwHe5Mei&_nc_oc=AdpI2L9HT0puiCiSeMjp4-ilzx0QWjbHPJkwSqvLiP3d80Mk23E-cRWrHX-1lh7GirU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfU3HuYDPnTdoyRYYIn3GXa3GlTLvDE7F0qUXi_PvY8Q&oe=6ABE78A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
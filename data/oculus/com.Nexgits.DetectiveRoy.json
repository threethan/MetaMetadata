.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WU-AUp0wYQQ7kNvwFKt-pV&_nc_oc=AdrtVzD5FtVwuDbB4oI5hzKDvJHR2RwvjyPrLHIQZTGK9McqaqZUIE1PHtHEAUum6ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z7Q3QwYFK4T9fjMRfwKlNgYzAQGSjD2GmrBzay6IMFA&oe=6A3BDA22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgh-gaovGugQ7kNvwFpJcdg&_nc_oc=AdrzgMSB0mM-wIv-FueDGSHWm4sYK8AAEfQt_q3C3l-_74hdmZOmbtcW7jgJSsJeQhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U9PzRyxTxnUJY7XBJX5ioJQov9N8ggB66f7NrJe9Plw&oe=6A3BEF78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pffbk2ZeuD4Q7kNvwHjqj48&_nc_oc=AdpWq-5qBQTff0bIhb7XKHGPyCVh8WVqaZMCZxR589yWanykyPpE5wu-SOE_DwLcLw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eoV8oZzR4P2AEmmqjaa7X085QZI4cubGYnLz8A2I_tg&oe=6A3BC9F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlXITfiG2q0Q7kNvwGcQ8sA&_nc_oc=Ado_WTwA_mo3QpuY7_5wyhLMqevQyh-6NhcbAqXOU42zFldC6lVlrw41po0g9vjrzg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GucdblVwqfOusLuil7wLlAp6-8S1GnDEUvAStTfVDuw&oe=6A3BE280"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmQ5kPh_sfIQ7kNvwHo4l_G&_nc_oc=Adr1bWZ_9_qJpxMUJLsjCbR2hu9bGajQ12hrRR7gO3llkkWVT7LhFltOBMFOha8evuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wKCJZSfJEtBTpBhsN4P6C9CjGfByNBw7pMQtPf54rVw&oe=6A3BCE0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6MwpIcZNOsQ7kNvwHbvTfN&_nc_oc=Adr-0hhTr4-2UzGADSrOPC1xYhipg03_UR9FBa2XsNB250a_at8BylWZx6hosFeuRSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99amMa9Lsxw39PfU13Uvhy2XR51zpSiBx56QNVys6dyw&oe=6A3BD769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d0Sv4ATaMcQ7kNvwG7bqxb&_nc_oc=Adr562pnzziymshXMEgtrSCmS1lE5qqq2QVx2Te6E3_zVni79KRkzWbTjPsHTnzi1P4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K7h8TWriwAiV2kEO6b4u5M-pT86pW448yD2wCYOnX1A&oe=6A3BCCF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6qLdFDT3AQ7kNvwES1BHH&_nc_oc=Adqk25PHXisPGZjDGJaw8ysV3OQc4_tLzc-TUe3KlRLCYCfNMix2u9hgi7yMLkMjxZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zwFeupk4sB8_FUm0KbSeK-OBrXlz2Aj7GnzfIJtEZtA&oe=6A3BF428"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
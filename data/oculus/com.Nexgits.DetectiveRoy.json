.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANaTQkEZMj0Q7kNvwFCqlCT&_nc_oc=Ado8VeqiVYozOF3XljK2xbqttewwswKNxtxdbb4vWuclbLU8qf4USZgMvvaCR0B5xDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4csh2I-nJR48iSIwVy8bFdLv3Zv8LnjEnVfW2gxZFlkA&oe=6A0DB5A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhI7IqKfudcQ7kNvwF8I3qI&_nc_oc=Adod7F-03pKXEtEpjgsnJhsPROswJIn5mPHN6ppuWj-5rctYCdXGzRm11YjRjel3IAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lfsQRuS2iwsW9xbZxXd16LoMxm_XDRHEHVUIFiRwo3Q&oe=6A0DCAF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du-EOacaiiYQ7kNvwG-ZJrs&_nc_oc=AdrPfVUmikYRsBUyugXw4tSGifuhQtxYeqGgElx_WKbP96yu3CKo3S7RTJ4x1rs4UAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pV4ThP02Es9TmJ_vi37jSx9XhAYhpWIG13XqYFM5N0w&oe=6A0DA570"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efDkxkUI51cQ7kNvwEUiEez&_nc_oc=AdrwxjiZdQxy-hwtC3ejylPyGbLsorkCUaoVWByib5QlVsQft6BhcZHQ4SZdI7SFJ-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V4fj3s2P24H0w1CS82TQlrcSa5262lScBLviWDrW2-A&oe=6A0DBE00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUJMhULZYbUQ7kNvwHCr9Dk&_nc_oc=AdrgSdA9ApBEHUlY9QENRqYeU5X6shNW5XXrrSNoH0yxSJd2j87Z3d6ECoNa5QIalPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W5uAaNi076mE1-Of3R3TZZHQ9sYm6L9atz0NVfVZKVg&oe=6A0DA98D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaCM8jSBU-sQ7kNvwEvXLVp&_nc_oc=AdovI6gcYezFPAymFnYJRKz2ctIUdHhMMDN0hLZi2WLVtAW8dKa_3L1Z1sAtnQJ5fhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b8mBqIg8VLxE0r0HZ3AffJtnclnuFQ7qr0JJvz_XuQg&oe=6A0DB2E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-rxOK_DZZcQ7kNvwF2yjdK&_nc_oc=AdoMXltiB1qJJlwyKiIQ0qnJdhQCkQnWca6eWDs4OP21ww9YhfycbVyTtS_dYkrRLco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZMzsRsGopb7lUpZE-fTaddBZpnYdDqg6qVu_UgY0vzw&oe=6A0DA872"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_waU72-_mYQ7kNvwGss6GE&_nc_oc=Adq7_9r0s1K1lGx4tmvGfdsmIlQnvXzKX2OVu7VK5s3E9phbufvj6iJSmc-gsE9C0gM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MYn1PXN7HLPn7OuRhT3j-xNVvOw5ULnUlSK82dS35sg&oe=6A0DCFA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
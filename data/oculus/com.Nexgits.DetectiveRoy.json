.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5gasRxYc8EQ7kNvwEOiA8e&_nc_oc=Adp-IkAGPO7rcIH85idMlnJ9tv4RGjaZQrwwdK84txlZfH2wCaGD6AYYfNsOlxPbxMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTQaDN8CQuMM1sx76Rs3A5eJyu6uW3akBTROKUoQQDJw&oe=6AC101A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_HbDSkAeTgQ7kNvwHQ1vrE&_nc_oc=AdoCzNAiQb2mVtNOwFGEg6OvKFbrurP-Y01Tud75tOu2xdniBKI6BGSHl82yUEXqtUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE9jS_qR1ci22jvRWrB8FuBGyVDCoL-TAlOPgXSxoR_Q&oe=6AC116F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6bpeFAfF50Q7kNvwHPRZf1&_nc_oc=AdpkcE22Nwxn8ODb6tFyNd3slyOFPRN0VNsy7KGmh_VjBeIRnyKFkKsPVUj3x_x5pq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPihX_Qa9WJgweB9vpCTLMUwR3HxoU_svibcYjNNmj1rg&oe=6AC129B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GStiDLep7EkQ7kNvwHHqRgZ&_nc_oc=Ado3xE8GTE7KeUlULsTq9tA7stKUEpbPGeL6yHb_FB2lKC03ND1HjI0zJ_DcrTWP_Vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgMquHLh9yI_aD6w0EZep88vaRB_9Xx5chsFD9Ki_wJA&oe=6AC10A00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQFT3lCRwoIQ7kNvwENMzYc&_nc_oc=Adpq2kPAgNiwEQATsWq8KFIegDoeJQfnVB5GbhQnvnPKnegNRfDKsjjmjFHRcXj_B1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPVPKGhxZKouUw0Y74dh0NuAB859k4sX1KfA4MeVbSmQ&oe=6AC12DCD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIwxqOF2Ln4Q7kNvwG1I70W&_nc_oc=Adq5x1_7xdKNutKxddw9hz3AtUwvijqW99i2XpIddBfDJorm2qMGZMszqqanWPNQJr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_FCrQIAWZ3dKZqp9xq2UuCnxV88TOVylTsVqhrYSDZw&oe=6AC13729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCpZ_3B8T34Q7kNvwGTh9c8&_nc_oc=AdqEEas49BJJ2h6nClXHGp-cMSdGwyZ0AkCpKLLlNdKOm5E687ICM4XJe2F55Slh5Bg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmgJd-vn1mn8J9QlQe7fnmjRmQxIWMDZW4iXPJtgKv0Q&oe=6AC12CB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EURtrRucnS0Q7kNvwHoDZwR&_nc_oc=Adpk-rUgkf2sbt0H8I2K2ybxlCrCaehfFW9Kyx9buZMD208Mk7z0sCcfAyK6JM39XFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqo4ZltOOoWipr42TY2zuCVXtTsRpBERENiAQs5P9hfg&oe=6AC11BA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
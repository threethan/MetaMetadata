.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHGO5rwV4_wQ7kNvwFISoI3&_nc_oc=AdqHAw8r8GADMG_IlZZyt4K1E89BpikkrRN0jp5Bxd6K_ctUZNKUJlmLicyo7gu7IRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_7bc7Bw6dmRpa74ZNStLX9k_htAnMYQxulq1603CkqQ&oe=6A199322"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDSdxmSrdTkQ7kNvwGKIx4B&_nc_oc=AdqsKXpXzy9bL1dcOPxi-WfNL7VI3MzLPMJNzPv5KB0WxNBJdLnto8qKh6MoSmYnmyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RG3OuvNWryllVttAC-CMCPaKtrXIOh4UGv4RDca9RJA&oe=6A19A878"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaKsJLk-x8kQ7kNvwHdxgWH&_nc_oc=AdriHQ13361_5VZCFDp9m6XBJI2KDGzD7EkVFj9fxXyppvz2g3L3LuI8acUqcb69XlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hmqXZ_6GHjkB7Y92arnt6cqcxCI9_IQeR1TRDzcHQ2Q&oe=6A19BB30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMrl6xnLXNMQ7kNvwGDwvjU&_nc_oc=AdonoRamcDfYocZpLDPOseFRluC3BCGFmFh2R0llu3dNCCfrFI3AeIH_8x_IXUfyPd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43uqd-pWSnhL9yBXpBrqfSE0npIN5iQWzY7EM56Ly-hQ&oe=6A199B80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdwXJMAb57MQ7kNvwHgKzlB&_nc_oc=Ado-3mQZT9YQmd1TLhxJrtKhb4tYmJoSJUDXuFbsBGvQ9Z7mszXEGlgf6ECXtVXKHNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TuHI8zTU9CRUjmrUJewz1o7V2zJUwhADJpe-f-RP2XQ&oe=6A19BF4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDmM6a3Rnm8Q7kNvwH5iKvq&_nc_oc=AdqKWRgkN7iYaQTDFzb4q19wK_WKzSYGNLoPVTMcAkE1l-U7gSAqHUEXYYkEgrtCbOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45h25EYUpby-0DHgFfzTmzK6xyAF5WJM1gNNp_KkngCg&oe=6A199069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXnm7f31_lQQ7kNvwGYubCG&_nc_oc=AdquLRsnErf8Fe3aJwZsX-3rs-Hc4UxE8oS0yP7P_H4qALrbyXzPAE4M_Ngr0CKeG_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7epgGzfA5p2S2AMhvHmqPzcLyNepef4TMsgkQkoOEB5g&oe=6A19BE32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HbN8psOv0gQ7kNvwEW2z8_&_nc_oc=Adr_q1ZjqtdudTBMD2W1kJ1JYUMzcwXz_HUdMwYMGyJZ8dvnmqw8_oUOh_pQez7MN2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R6KXBcIp2lm3HoTh97bEjY5tmu_4d39UTrjiYa0g3Xg&oe=6A19AD28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
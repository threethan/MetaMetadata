.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l6ZAFAvxbwQ7kNvwGvAmey&_nc_oc=Adou6f3xKj-sv7cCgvYr2zav3-ivkxUS5hQqbmglKErKomD7eTQBNTg2Vecbv4Cd-1c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ17icgal83qiwa4NhrMHXZUh8U88_zSnwAo5isD-jtA&oe=6ADCB122"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLgO6VKfWHUQ7kNvwGnK2ea&_nc_oc=AdpeRPBkiLMYkqsds6sEJFcDVUn5grpjA7xeI8nu8zMxdMdxTbUPFCPV-l8RdXu5KDA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyPHlLOhdTvXN9Yao_QaNXAcEqHnjHZasCmwrlZeRQXA&oe=6ADCC678"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYNQ3_VLmKsQ7kNvwGx4RaQ&_nc_oc=Adpodh2GKLeVSy1w-75WZk8xCHbl645R3PW0BOvgi5RUNd0HzRUCmNZU0oSyV1Ll8os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_qA6eVOV1AKfXoLq975ARcQdJRtptYL_R85es94XTJA&oe=6ADCD930"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V5_Jm6RDIEQ7kNvwGv3bHN&_nc_oc=AdooNOh7rGDr78fqKBADZ1dBVpNEF1Q4_IuzIc438wJh5-J7fySuk8iC0E_X9KbR4mU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgRQXv9nSTI2ZRcxqByekqUZqXyKGhzbphePe3jPHsiw&oe=6ADCB980"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rejq8DasPuQQ7kNvwHSUEh4&_nc_oc=AdoNr1kPb0DjGSIcEBwn620_qQi2fjtHQ25N3obFxrsgGZqv1WkdEijtUDydvaIXwEA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM306U1Z1niFKE7PtbiIB046dXkArjt_88rRa45u1GHpw&oe=6ADCA50D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQjyvPmhuckQ7kNvwE5akNz&_nc_oc=AdqOQAaevGFWFeIIrtfG8dd35wsRl4GyZX31-6vtj1nuYTO3r1CW7JBVZhP_EV7vUOU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCkM8Czgn6KnwiBo2NaQf4XiI3d8iS1xr2f9GQ7PkRgQ&oe=6ADCAE69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PNhn7H44cwQ7kNvwFjFsCH&_nc_oc=AdqCsIfB-lM_oUF1TBPPSKaf7n0NM0RvnTHS9RT_ZwVBoro3Uz0qlsqthlGaQD6fqNg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvlqeIUpdNsfd-pumkMCzYa5LYCFUEBOvOb4kttnDhUQ&oe=6ADCA3F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi5r8Eb2iWMQ7kNvwEcZ_f6&_nc_oc=AdqYVG6H_7GOQnlIU2RmcaG9iivmSXi2ZJvIh9B5MP6kErfiDH3AvhNaUQvEf8A73qk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzgVWSf1t57zlCC3qvB0oqSSFzxvHB5e0TfbYP2ZhNpA&oe=6ADCCB28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
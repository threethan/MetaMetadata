.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OMS3cvdy1cQ7kNvwHjIw47&_nc_oc=AdqZO9wHMNKGxbmr4pkm0_ei4xURmC4JG3TD3SFf8Cj0LiZ0ImhsbUdtIUCnEvWHULM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57Yta8xVuDB8CHcX9HRhdr-JHD82nzTf4R_ce-EQT7hQ&oe=6A0B12A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JAh-1CwZdEQ7kNvwFQjMAM&_nc_oc=Ado-ggyL-BqDMViQHb4VdfoZL7-3awo6Xeqv8ai6uIqLzvZ-ibyrlbPe_dsV_By5aTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TCWREg0bf90wda_ai3gH-ndKhWiucmuQ_o77EM9ZNJw&oe=6A0B27F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du-EOacaiiYQ7kNvwF_5I-S&_nc_oc=Adru4iLp1iVYsdr_npIsToPXhKvs5NlBz1_oJOlE3F1ssbAKDcifr5UqMurk1XBBaFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K62HTXB_U4qAri4Jn_HG9z3RJNxXx95eoSaFJ0rHVgg&oe=6A0B0270"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xP6038W0KoQ7kNvwHQPPaH&_nc_oc=AdohYFperdYjPBQilN77vBswhs0qNYO1J_PoUcvSFasY3pfRPfKVTR0AN8c5CIhWTZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af521bpFvc1wkNX1iyckjdug9X90-w3jzwaQUD-E0FuIOQ&oe=6A0B1B00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUJMhULZYbUQ7kNvwHIyw8B&_nc_oc=Adq_ThWHbeSmqcqD8wQEmcgAcErg2QcLexrfr5ML7WJRSkFSbiZu9nxGcgMeOB9t1Z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af602bTWxqiLYIPIcuV6gthD6Ix76I1v3OF9FQKtk-lIwQ&oe=6A0B068D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaCM8jSBU-sQ7kNvwEisF_K&_nc_oc=AdqBVT60M8XrIlFwlF-9xFEcvJ_JTg-l_N9LZK7KWRdux84VH1J7iAnEc9DUKA6bo2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pkaadRrr3cah5ycMjHAto3mfDLncCc3KYGeZrP7E70g&oe=6A0B0FE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1KVaB6BJJIQ7kNvwFgai0f&_nc_oc=AdrexXRnK9CmD7fd2nvVigXexe0GdOVXgbKQEdq07b3LuKoLTLmI4HX4LT0uMajNYoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yF8t3H2NhaQo5yCf2B0qaTakroRicscVr4xD_EvTK3A&oe=6A0B0572"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_waU72-_mYQ7kNvwE65MhE&_nc_oc=AdpQOk0Ukf9JlCeCG_FtabX9YI4omcaNqkCe2yw1OY2NuSBruQdRRC-VFur_ttCNZMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ei0vkNdV8EELx0n-NBrsenD3lLxILPZNd1nn4PP-62g&oe=6A0B2CA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
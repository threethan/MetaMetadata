1-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEnfbNuxUjsQ7kNvwGyNYhI&_nc_oc=Adq6cpZgwwFte6EgOGv85BfivPelU58J64Vw7rarcXk0_a81GYuGGxr2-aUstbR8qwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0MmVEplFvkxu128RoIJ2Yzb1ngqn2nZgiedgkEsraNw&oe=6B070D4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEAxYe6DP3MQ7kNvwFTOnVE&_nc_oc=Adpmy2pan4oCTNYmO1Q2D_sTXVb4MqC6CKKCEtuNKYcK-Eb5tyJjV7OkvEx5Ih7xh1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY-vNmaEzOXrELI-cDxumKEhN4aiIK5Tjx1mMeQBXWxQ&oe=6B0716A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHB1Eo-UDqYQ7kNvwE9AtdR&_nc_oc=AdrkdaGdrGu7xnc50_H91EO8ZcD8QK3ZbDQY_IDGcIjMOzwwcEDHqKu0sI0o_1oUeIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmCdqDY-LUXRNZhe1Iipy1xan1bmINPidf3gogO98D5g&oe=6B070C32"}, "display_name": "Detective Roy", "keywords": [], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "http://detectiveroy.nexgits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nexgits", "support_website_url": null, "website_url": "http://detectiveroy.nexgits.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "842399483385090"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1986062092018015"}, {"status": "PUBLISHED", "id": "1497166088049158"}, {"status": "PUBLISHED", "id": "1402480698586188"}, {"status": "PUBLISHED", "id": "1870115117025235"}, {"status": "PUBLISHED", "id": "530235488763186"}]}, "baseline_offer": {"id": "530235488763186"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1986062092018015"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "726416498029
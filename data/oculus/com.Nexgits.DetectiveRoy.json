.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HS7XQouM4YQ7kNvwFHD6_P&_nc_oc=Adoh7I4Rrrycymd0mChzD4-8lSsPrfxkOYF6AOJAwCTn1m2jtpDxIPJKStDWK_QxaaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Brnqn7TqYr5-wWCUACB6HPdbkX59YDbo6RzOc-C_09g&oe=6A0086A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8T_RwVaChoQ7kNvwF49eym&_nc_oc=Adq32M6w10Ay57x7BwhjlMWqv6Ji-z3SlueQzs-8dpvE6XHUtLvbPe26vyk2nni5Ec8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5giH_CiAKMBolDDVEOC1NccxQzmbZhbj358IVbEu13Og&oe=6A009BF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPX-bWORQXQQ7kNvwE3jWNU&_nc_oc=AdrTKG8wlpe70wgI5tZVU-MthOiLynEDOzQZKg-DnjnL7FBEBBnf9iA40tRHqNdDJXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zlQsP78TP9NUw8bBXEYCGQt8uLo5GqJjbnBuileGqvQ&oe=6A007670"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wks3XV_HWvkQ7kNvwE52gGF&_nc_oc=AdpwrEfK4Z_WWkNJaQtW_4MGUKwpLfT0v11JPvmYqgGvEZbUIy6ZwP6RPOmP5n-XQW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V9jy4Eaxg61KmuzCRzZgwb86QgYgeaoeNKIrDYBVpHA&oe=6A008F00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5btGIMcihGUQ7kNvwGaCqxo&_nc_oc=Ado2--0EkGV78joMF5Di6VhiwEZ3Le_bpz-IGazicoSDnbH_Fft_zPsmvLqamnkw2y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e1j9uDqk7Gc494mZlxF8SuKQwLwkoqC468S3cnba8fw&oe=6A007A8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey9lqruD8foQ7kNvwHjJcJ1&_nc_oc=Ados3WfF__inW_HpdYD_lcyp3TUOZ8i83vDShBT6D_ZTjCpNMqirWvDtCWiwyf0dZ84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZR1lQhANMSj72VjxToRavEM-SVRWE4oxLsmkFxU1YgA&oe=6A0083E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAjh4BynQloQ7kNvwE7DBGd&_nc_oc=Ado8YbjHA64Adtp8ueS8hw4kYRj9qP__3YYpwtMkC4Hjb96yJH643x7RyKq-9a81jMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MDPzq2BDgmB8R5iqsf9fwiRsMEOL5dTdw-qPw3VsTMw&oe=6A007972"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P_hSis-JA0Q7kNvwFqw-L2&_nc_oc=Adre9BI8EtPCTBUOMENdyoxVCFHUgwd6VrjevKe4Hm9UTC0zuaCabLG6GZc8jcw0mRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xdq7e7rwugTra4Xsawfqu8ACXybLMo3SGP_-ZjuFg1Q&oe=6A00A0A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
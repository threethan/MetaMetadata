.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrOixH15rMMQ7kNvwHhR9-v&_nc_oc=AdqPGJRD3O-PTHQH8uf9NYsHDaMN7Wm56FsMcc90am_TshL0Ngjsuo-Ffjvoi0xOse0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvqPFpthqMRRyEm9DXwKTATVDTSy6tRSuweEHVFPiFlw&oe=6AAA9822"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1U6fDzJ6rAQ7kNvwEUkOpf&_nc_oc=Adqhgf-cFhCIkZ2HaiYuQkbU52pr7DAX_tcwIANkzRhPTUqVkUNsSW0baSxqMc7CcOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2zRjoMJeynbPjzYy7oK8-zaNkAO6GzYdPrIA7c9fE9Q&oe=6AAAAD78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxyO5M2BeSwQ7kNvwGqERgu&_nc_oc=AdrhAdWZ0dYoOZ7OF3rJ8fAm4bjx2wxjcUyiTECq4OH2bBjuJpmd0-ISSsLrl1Bu3JQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPCMAWbS94woDGk3f7K8J7iU_dd60M-K-mnOs94OXLfA&oe=6AAA87F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIWKAwc8O-sQ7kNvwHyjI6P&_nc_oc=AdqMYWZH6QzIUD1PDuwkPuTDdaiYHBtqpptXL00FKGsDzzwBDkdXC-i7Oqg8DI4Oj1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv4hOZyVokpLnpkPbikZobxsMFDPkznDyiL0ug1m4tew&oe=6AAAA080"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhMPC5J6PnMQ7kNvwEAg-Jg&_nc_oc=AdrRZk81BAgf4wBXDrmURxmGwDSkJw2iqicpD78RvmUJyunMAZ7RcjZP_vwuz-cjt0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkNk6VgNKvDg2RmoRaX1vT3jaxftclOClTJJGssIH6wQ&oe=6AAA8C0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAAg06VhifwQ7kNvwEU5nHc&_nc_oc=Adqp5Po9EeAGYCSFFNdjdvgwNJUTPsOn9O_6RXQByPje5XLP0qKQZhAhY61241SyjRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM31BpYIuV0HD5gtQ7ELKr53Gfm3JPhY6bGoJWlfeRhw&oe=6AAA9569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8OWPvBIpikQ7kNvwG8jFaB&_nc_oc=AdocsQQCp-DMwnX5Hsyw38zkg25ETTAZjHnhYet3rjaMvkQBs8jbM-1I1YuYVoxw-18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTel7c4ir4KWBGnMU8FH7IcZB_y35vF3MoeCViYHHAFg&oe=6AAA8AF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bpSF5iVQJQQ7kNvwHzjeIw&_nc_oc=Adq302Sj2DTiz9nGpsGh8FU9fjdn5RD5i0MAhJLEfudXVzfhBS9UNHQHrRpnkrXp4s4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_ONPnGrNJnBgNQie028F_v6PpTiGlcy3qYRL5PT7tUA&oe=6AAAB228"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
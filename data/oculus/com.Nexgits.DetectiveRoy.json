.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrO7pBa7LtIQ7kNvwG3nJkp&_nc_oc=AdrSs5gVK6nqvx8mfxHc8214kFk7HiWrglBnerHvTil4D1homTb0MWpaU7fSROTA9Hc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00pJRqncRTAzGWLFnE3yo0h4GRrqJHXAXIHTFzQU9zbg&oe=69EB6EA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-0NqeA-CN4Q7kNvwGIePVI&_nc_oc=Adrh1eQ8qFC42N0TsF6b_QNe5-mL2SQUlXX0LTWVz6flSnmPwYJAAlkxVQJ0ulX4UY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ln6eZ1DcghundlKNgeuIeBADxBqRLPwWL_jcglR65kg&oe=69EB83F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W7B72cLAyYQ7kNvwGPVqJB&_nc_oc=AdrMBZCAi420amkUt7L5rX03LsX1XBzatFRMNRqQVREKgisASpX1-9ztKkBqXDdRHJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af391UGQ8_Cc9CLZ300YQoMDhpcLestnrRpr4WoVP6K6tw&oe=69EB5E70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWo41FKoaS8Q7kNvwHBfWQM&_nc_oc=AdqIidER0HDgA-ym8c2H69S0EHseAFNuNya_VpPe7xrgQh5CParpiVB7LVR0A7PnwcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dS2ornXUwub4MH1cKhFzBcnWdYDPSe5GxzGge57lCuQ&oe=69EB7700"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjiA9A3g5PQQ7kNvwEWfk6d&_nc_oc=AdqA-TA7-fT_Igj1nihROxkI4idzHHy3FaV7P8wOBaPPPd6kAkZu1u62bp5v52MBZPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34W-2Tv1LD7F4zDuJo5i6IASfoUMDWmkHfx9QNDVFdhg&oe=69EB628D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzrmlHA0Y8EQ7kNvwH-aiqU&_nc_oc=AdrG4PpNOHzk7b8BsEqPq0Jf58j3Ar01Sdd_-W7Kur6JF5j9A8dLtbwUa__e2S4cQQo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zIm-LD697R3_5ZG_LgNOddv6Ja8wndqqfhZKFHFXeuA&oe=69EB6BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG7LArKEx34Q7kNvwEr0Mn3&_nc_oc=AdpVaKIrwxkAHTTW4Rogy-MUMRB-EebPE9KzfBspeUEC0Gs2EFvMsjeVF_QpF1cXHTQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u2kvjCiP46rWpXgdT7dHJePVQkhp9WCK1xB6Z174VLg&oe=69EB6172"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Buqax8oUZ0Q7kNvwGGmeVU&_nc_oc=AdqeURSMi75SiCqrghDxz-q68wHZ7pcWeJbmdovqzqyIdYp9XhzWf9cw6mrB35-GIVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qtaPMxfIPoadeGqA7-Yk_k2ZLRTZ6Zy0t7Ck__C643Q&oe=69EB88A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
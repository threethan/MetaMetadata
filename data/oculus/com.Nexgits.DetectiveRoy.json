.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyDjalqW2KIQ7kNvwGI5O7S&_nc_oc=AdpTiov-djm9GuX1csWAnoLSkAJaaQo9fiqcc0CIDjk9l1VW-vVSeA1PEwZN82-I5-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFNOy5f0num_-FvZ-hPuWqIipCUk7CZAmKUHS7icRR4A&oe=6A4FA0A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpDZIcmDVjIQ7kNvwE1SBwa&_nc_oc=Adrhg1cFcQWYP5-jyopfpXOck_IG0m1rM5PwTBBmRgILk9AAuuyKIO6CIH3S18wZnQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2iRK22X3kwpBdG_iSf309QR4f2lvqJA1ucmzt9vVBYA&oe=6A4FB5F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irtmfKUO6JAQ7kNvwHA8sw9&_nc_oc=AdpZD6nGNu-NVNT5LE3yNZ5zHGiHrwz6PauQzx4LRnIwAItzPxiFXTGPjUFhs5tZXeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCeW_46BVhRTTuavrqeRadaD-800DZO7Jrxylarv96dw&oe=6A4F9070"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHkZokEop7UQ7kNvwE3EFN5&_nc_oc=AdpISh3xjFq14RAFE0sHdtgYdJ6NAmZkqEcQ0YOQo9kFOJkl-wcQPjDGh6oHjhr7WM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkq5-6aL65NUHaO3VSSv41e6MoqVO80YZpWib8Ao-04g&oe=6A4FA900"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvpTnpPC_jMQ7kNvwEqvExf&_nc_oc=AdqGbAc-ajVGKweND7pQwhoIkTkn70XBapfZDa_cVVR5TOcD69ACUWz_qXA22L2OUl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkeoloeKxNusNP-kcpqSaiQIX5R0rupTrewd1OKFPfnA&oe=6A4F948D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru8zleU4ipgQ7kNvwF4CjDN&_nc_oc=Adp6VblUlCIMHC_AvYk2IwqjkYkbGEo2BaKn7TDCsxEJQGx-JDMgeDapwE9K6aFvgkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGuuShnJe-xgLSJpORp3ULawvA0F6iFUrGXoYafs1SFQ&oe=6A4F9DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aF36AeU9rsQ7kNvwFtfixf&_nc_oc=Adr_2U3Oin0TKeJsYozooiZDpnUv4nZNg5rCbgcIiMf8upT_JuUn2t33ZGg6prJt4N8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKyuyJ9D3e8GBmuqvLm-PtS5paUHa5kW1YhcY6fAzAVw&oe=6A4F9372"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyYDZpnkNcYQ7kNvwGSufZC&_nc_oc=AdqrphCuk55-QM7g_PhiDNW__GW1c9_AVKqvL6-hlxjlDUO_Rxi50LSbHmXhdMOnaNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBugJyknoh7lyuyb65sTD_oP9posx7ihy17a4ALZ5a1rA&oe=6A4FBAA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
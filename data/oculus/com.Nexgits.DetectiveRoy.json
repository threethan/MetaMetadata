.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL0306xkae4Q7kNvwH7W2nA&_nc_oc=AdryhsDmRQGWYhwpEJptKj7oK7N8_mN9fuOTPtlRTlBzK1OuPK2fjk2AIPFK0Zp3TRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc8g9pDSd8CmQ8q_MuwvXuVj4AxkKZm-egq_jTy3bmpQ&oe=6A490922"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aM2OloYDW4Q7kNvwFjqXSh&_nc_oc=Adpmp-UMiyouofdIZRMUyHGMxXt-NST0hPi7Fs_X025sdLNuJ13loMyHaSa5ht76ovM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhdeLb7Tb1O4ObVALkjPNEwegU4nxAl02OKDMd2BC5xA&oe=6A491E78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzsfvnY6JF0Q7kNvwHalpuU&_nc_oc=Ado3SL8xN8exlzrbyrdFRYoFV33ad7NHIWTh75EeUptmMZv9gav5BKxloiWXnmEdl_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7hKipFynMdI4He6jpGTMapRe6gkrXAcpq_I6mUNlM2g&oe=6A493130"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_I1RaK9ftsQ7kNvwHZR9VC&_nc_oc=AdpZDHgtx2xsC8E19zv1l_UELlRrsDsyDSfgTd2ynBbXknyWY_6cjC_NK84yW3xQ7JQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfh3cVqLgqz5GX6yjYsfBKPFuXvzyC7Q2i_70rMCNUfA&oe=6A491180"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHoUELTw5tUQ7kNvwGor2q5&_nc_oc=Adqghhomyqo-DZy8iX4GsJ79tUkvQHTPdfw5swVuT1w0OaTNScvUdOTYXyPEXQgZyao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJlB6btysiAI9h09cHihmJ6gDdg2ADp11gguDND4nLGg&oe=6A48FD0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8ONLvBTh3UQ7kNvwEiooV4&_nc_oc=Adqm8bSe61BBZYYdD1-qXL-3AmCfFfrNXfS38FH-HNWOASzDv9ghL61ggMnmfy8Az3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-_i1z-MK7YNYqM5g3zlXO-zYtBtbkeNV18DS_wo6I3w&oe=6A490669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCYAy3bVkwYQ7kNvwH7LcBG&_nc_oc=AdpwugPVeRaaXRKcTpZwFfw0grYTDvZongJVKsL6m-ER2WhJKPvnem6O1OumNf3lYMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuILSn8_d-nGN4BkH1h0sbAYE7Q-B-bmaWiAc88-MXyA&oe=6A48FBF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE_6vViCuMUQ7kNvwHg8Rya&_nc_oc=AdqER_Rdg9eKQzvxT0xeD2CHEcrL0pREJ9WYp4NKeIaxxRDIxGF_8W3prRH93KPbc0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRqUR6BaKggrO-bg0s4nwPmW7leWcSyocBqZyaqUSt_A&oe=6A492328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANaTQkEZMj0Q7kNvwFMrNsg&_nc_oc=AdqjSa88-QY5dc1vZaMtlafHcvHd4lfLsEFF0veBaKu-A0u6YrHydEJF2SHXU0enD04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d2e7xyxJUnon6SqxWSrXMGQjMKSi6YYdozJZ81q3Tmw&oe=6A0F0722"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhI7IqKfudcQ7kNvwEUVKo1&_nc_oc=Adonr686EJbfSCts8952HfPP8Lhx1I72almtnjwFcuX9V1g9IoFbx4inkjkLaEf8jMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nbm7AgGSdLZZyrzlwQVQvEMa1hgMEI0slMdD04Pw-UQ&oe=6A0F1C78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orX2ysnk8mIQ7kNvwHqZFXA&_nc_oc=Ado0f9v6Vu07WZCI9x84A5VznicYDU7JcuBf7KCqbzDEFyjQtnpP6VdYzbUZNzj2rck&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bHW3O4_NnUm_oxmOo6BHWLPPGlBSgXortMvg6pKlUlw&oe=6A0EF6F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efDkxkUI51cQ7kNvwHpoIeC&_nc_oc=AdpgUQRdSPYkVaHXaHYITjiP02gIhu2OjYlJzTpW2gazXPaRDKggVpksFOUGpRXeXl0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_4TAeJmAcyPsSBvhHl_g7tpc90qR9FvTXlQ0Z1tIoRA&oe=6A0F0F80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1t33wO2DoYQ7kNvwGwG05R&_nc_oc=Ado61-q7v65w4HrQdHIE0hWJdphLA83n4LLnfnwrODwxCKGElwD6qqF0OLDeTYHQUUQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ie0YTHKsxjSe9gcS0J3KFdoBKj0orneOXV4EViwTeQQ&oe=6A0EFB0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNl6ob1saSoQ7kNvwFKo7QG&_nc_oc=AdqGNDFn7yNkkmJirqnK4wF75AwIbHbLiM9qoZDDhe5DF6LaxmoDNHkXQlwgm0RgZKY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47TOfNa7_uP615-HWZWB1M9JnvdUxZyQE-p6aPLed27g&oe=6A0F0469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-rxOK_DZZcQ7kNvwGPtySV&_nc_oc=Adqkr8nk_NJK7Tk5wTCpqVw9obFxhXSJHO9fAJilYY-p5_dE5ou6m6acUyXGG-jDKJk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q_WOKVY_i3rsdlZVNmhyFobADwJEhnyk1YFNU_VDCdQ&oe=6A0EF9F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9w7PDBOacYQ7kNvwHedwz5&_nc_oc=AdohV7NkdFDCFoWxiytfTdLE-hiwhCFBwp8K9e6fH_Zs6fFNwLkBxA_lClHMRXMSX9M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65qnuCT9AwPWy_-UvZ7fbMKllFDgdEaPLazvdigi06jw&oe=6A0F2128"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
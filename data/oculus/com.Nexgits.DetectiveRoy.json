.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFJIRM5HSQkQ7kNvwHXKRXx&_nc_oc=AdpdlK5Pav0eFZMb20evLeEvr8XzRQeI15rEqz_E8nnoRakk8U90J0NKTHxMfhgqyy0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxKii9zm8NDtJamXZIX5_XO8Lkmgvb_sKuP4bvIInv7A&oe=6AF9EA62"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO-w46KxRF8Q7kNvwHun4gc&_nc_oc=AdoWn1W5XtnvrWjUzRDLWBdCiC0B09T3q2C0sRE-YEuFCf2HC0GPb9mShJxKFbESDTI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsQ9RpJqh9m8jDMEIWzNt1SXnosBkh28AXPMFxWNX-AA&oe=6AF9C778"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPQQgClMcD4Q7kNvwG5BXL3&_nc_oc=Adqf7ZHxNZORIq1jiGPgeHNbTZ6uuEMq07QiIT3BDKmmVkAbR58K0mdJPUpwk6JG6uM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuAEC2WXCNYN6XZW948_Tb9p3SDkbAU2lPWnoXGEozEQ&oe=6AF9DA30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eWDgT8xPdMQ7kNvwE4ratA&_nc_oc=AdrrY19xfKoe0k9rZdGdUwKGC824QBYxUi-ggvFqwkqIce6cOVXww5f4Bbeblwq-L1o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkkiwVqNk4TmsAnnFZVKvxui_ZFuyDkXwOUWr-GvSZsw&oe=6AF9BA80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHj1Kap1P7MQ7kNvwGo8YNA&_nc_oc=AdrTWpCZneuTXozznayNE67FFcjfCb3DeK0ohQLOmuXv1jQVnBQfK2qKD_EmpgJmWPs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfHamukKCwcjX2OBNRZ-9k2mgdAZO--74VgCsm1Wgo7A&oe=6AF9DE4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggKvPZtnmlwQ7kNvwFHkAel&_nc_oc=AdoIFbKxnGxSnmcy41h9VUk5MjXzkXxX9h_0xYISPmLQn_uNc104EbXw2GAKGcp5WE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPF99JI1falXzSzBAQebiHFLiN_rVK2IV-Ru4FcNIMaw&oe=6AF9E7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUtTvrX-wu0Q7kNvwHjOMJ4&_nc_oc=AdrOdQ7FQDcEMsxeA7p31JxSdyGUb7Rm8st0rRzNyeGVqeWyBxHsOvCUqNBnDhUbaww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7rNQBsTg7ZTbhCvoYmMnzNjHdv11QP0E5i4z37G9ruQ&oe=6AF9DD32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7AhbgeFZPgQ7kNvwHEv_n0&_nc_oc=Ado8-vnKWhkAwxnB1KS-3vE1SocPdNOPTJw2cQUppyE8q4wG3aEEu5tdQvGeaWkrm_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRayAVEfSOkn1SFOuqg0_JYAFjl6a0xm1cml0SkDRDgdw&oe=6AF9CC28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
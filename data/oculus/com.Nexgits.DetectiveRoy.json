.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlVTwzTsXuMQ7kNvwG9NqeM&_nc_oc=AdrUhs2nyrcnmIMKd1InHu2u8sg53CvQpBIUtSah_xzDuwFPc8w3i81YzdRlMSgj8qw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxMu7i8DH9tCwffrijk2B0jupYziSQiokJrvNgKyPvfA&oe=6ACF8222"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ-AWPfKKtsQ7kNvwEcmNmZ&_nc_oc=Adpo8SFfxWdotLF8FEC-Wmm0C9A4onF9XGAlZmKO2XD3wi2dWxRy5xljFGth492xkwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTEySZQGBq13wJvXW1AU4LgU_Xwtu8ERQ413GLBOXcMQ&oe=6ACF9778"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzDiGkPmlc4Q7kNvwEnWrIU&_nc_oc=AdouJ_sHLtWalTiyXUVbn9SxcUnYYas9_MHaNLt-tSW73hnz_KTGrGdt9nywJFC6VZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwss1VQo9MgEzJmKmpMxC9zbmSFIjR2ARkEJkmaj8Cqw&oe=6ACFAA30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn9Ucd4S-OAQ7kNvwE8pyvM&_nc_oc=AdpR0p2i1mxv6MBMVe2rOSk-uXLyt9IZtMANM5U1rCAd8_G3I1QZVNha3LfrKcHvQg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4XcegV5Zmz7_M4qnPgL91XimwUVTJHyMAgbcwVf85-g&oe=6ACF8A80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDXzMgKdxrcQ7kNvwFJdXCN&_nc_oc=Adp1hFvAnYLFU2uXBvhlirZhGqdOdMR1gK575f5XK9nFweSd0_OWjYhNpIbbZ-iuzVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu2Vcr6_NcPZXLaRpiBsbDpucoe_zTV2YFGRahsUYizw&oe=6ACFAE4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9IQ0KfmvEcQ7kNvwEHfA8U&_nc_oc=Ado3KhA8uQlAOP4hvWsh3GDcDwa1DKyE-5zDPcqImr06fYfalUA5KqXC-XCdZS634u4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNojG-OEjNEjelGmxCcWM5s-6E1imHu61S-whsY8vIWCg&oe=6ACFB7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C8ca-JRx74Q7kNvwGWH5bF&_nc_oc=AdoyZ46aPyhDrduLw8ubA4H3CzNbSZVFyxohCytPtpVc4HVzBxXUWy0xSruLFkh4oxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCF971_HTIC-MeeMHw6v0Gz6BurhTR9hGUEoQCmTMvyw&oe=6ACFAD32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqKRs5Y9TAsQ7kNvwGNqT7l&_nc_oc=AdqOnExGL7cfk2EyN1vu1fH8fK_BgcWXmHJm-latppEKHn_KJdUzitLzhmGba-K3920&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKhDjgcQkzjY7xpt1ewT4BJ2gEjPZyuVUsdF_oKSZM4w&oe=6ACF9C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
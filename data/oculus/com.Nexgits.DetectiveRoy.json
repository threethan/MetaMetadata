.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol2Fa55btL4Q7kNvwHcpODP&_nc_oc=AdqTTvTqAao_sqpvoh5OozaxEZVV47tvvBYXKZyvJjFzp-y-eazFKDYF7sMUvP6yyHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7LMocaXnpYHTyAan3DDpaZT-dqbYXMYOxVlHSm8VoRw&oe=6ACB8DA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpXgibuDNfQQ7kNvwHqk5Ue&_nc_oc=AdrnRnQqxp-ucOlP4kO3x28qnTlZpYgsnInGTW5GbiP4-096q9oUc-jytTMvzR2kjCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8iiBmo9XighRaTCkLM7T3RPoGRE6GYoKXIEtwQQy3rg&oe=6ACBA2F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRiSrZwsCzkQ7kNvwE3St4t&_nc_oc=AdpujAZ0J8CiqSNOVfuftj0Ba2G_Fm0OLrPhLykoj9rs2HNvenNROKEImENxZeUheQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl6_UGpZ2BIxm7kIPgAmnN2QbLmdZ3R4m1e_5eiQLAog&oe=6ACBB5B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_anxB1iokCcQ7kNvwGXMfLk&_nc_oc=AdrXov4OQUJ1c9mG-ZbnIBrpksfHS3VRvxAeCAg0MJNWV-sW2UaovdzCldyGemijmfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA0MAG-27ONsmthis9kJezHCwdvem8j5TRKtH1JJ9sYw&oe=6ACB9600"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaEWUoX5bJoQ7kNvwGbiW7R&_nc_oc=Adoxkg31H8u2EGyfHttHUfWixyiaxomjTislYV3YNpt16dzvRtUI-xm3pTI-XKbAWW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzuIViSsIS2b6audRctcIrXMwi3gmbYqDR_vBpGt28uw&oe=6ACBB9CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y-BGStY2uEQ7kNvwGG_E6J&_nc_oc=AdrwX3dWgKiRIwLBKEPVNOcdT0094kHz7WXJPloWFnSyGueJqn8F95HFEnU8fo7JkZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCI2Mbg_vL9FaF4jDdrqt6v9JVv-FZ_DZ3ZO68Q6nYZw&oe=6ACBC329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JYLyuRK4CoQ7kNvwHdv2Gi&_nc_oc=Adp7xEtowJim9_m1H4wVzYXJEklJjB47wobOQdCIgGjQQCnHKExU_B12m9w8H4aPUio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrChOaxIzvQHSH689LHz-ttkse7MY3xofrzyZUp-9Tpw&oe=6ACBB8B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hrinx4ErQegQ7kNvwERHdlp&_nc_oc=AdpDCDhU_43aiNB0CBF2eRSWuhbF9zktNtOa4zZ42ZgMZ73-oUl7USOQ12UWcDDG-Y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNZUcHiu3m9Wwx_Ky5drCORMsyE28vzyYW01_oqdPMqA&oe=6ACBA7A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
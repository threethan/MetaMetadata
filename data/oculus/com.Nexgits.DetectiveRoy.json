.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzE7hEaNBaoQ7kNvwGPsOln&_nc_oc=Adqw7071vaph_beicE48h_NAl0UGKRSV6P2y2hQs1CntIpqd1HjU5WDudRj7fPgyBtA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xPZ2hDOSH4KjdlGbtILtL9O2EVJOIttJEM-dXje7eaw&oe=6A412022"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agW6pqDv5GgQ7kNvwGMW8uP&_nc_oc=AdqDwTpl2DcHatqvViVKpTKNlKINKrBMVv89plq0MaWk0PpjwAb1mEq_P0cVNnvyhbY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OhfrHzGew5QgS_bS7bMj3D9Z9X_JOQcktGflwb-nILQ&oe=6A413578"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP3AqbfgkQkQ7kNvwFiaV3s&_nc_oc=AdoMXpfyx4yw_ju-Pm38Yx_tn_NbTqhUPmHMgXJ6XmmKYuoWVhVPgPQ4Hz2Epixi-pg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GuO8Z1G613Pajxr_eRgpHMBuRgcwQcKb0dGNG-Cm1BA&oe=6A410FF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdL5_lPO-uwQ7kNvwFwZb-O&_nc_oc=AdpaarAuv8WR5hthxUlu6ZLuNZVjAkIDA5bMsLkzHybLf4rIMA8nc5eGVB4PhqwjmMo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9coYbMOzKljjZLmhzj58Vm7TlMfh0Rl-hypPg72OXTg&oe=6A412880"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk1rQ3zs1o8Q7kNvwHSPhHT&_nc_oc=AdozHiOSrwGiZdld8PHugmlZrKrFVqsBNYEv2yWqt5jzJGlIJuvJvQnOUbo1uoiUr04&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pYbnRPrwY71ImmuVc7JzTax51AsQG2uYQZNACHJktGw&oe=6A41140D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC7vflAhNckQ7kNvwGqFele&_nc_oc=AdrCxC3wagvUNjeEeXK98XuK4ZPPhMDM9tJ7H3s9W_18-1ey4xV0NkPUNYvjx1bsjXs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ku6Ta0eZ2KFTMXB4BYb-eo4TpyDEhe0rrmBqPbsmiqA&oe=6A411D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0YAqt3C7PkQ7kNvwFSkvg5&_nc_oc=AdoEvZdsXwtxP9c42NT3tDZEPof17E6BUHqqAshp9imSixvo1Of5LU_cqxrxaVNbIE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jpf5pgwwAk4dOinP-I2-KWnIJ-ZopHRjrCr-Locjz6w&oe=6A4112F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEpZA0Ksz8Q7kNvwG88S3L&_nc_oc=Adoxlfpsz8fyCXexBTnankDZwvEJ3BEr-YBUuv5UrPlZAZKecqrK0IqpqtN3HR3fzLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ts9a_njEIPr3au-dGcXETJBZn8t8_5X2tEyhbJHInuw&oe=6A413A28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
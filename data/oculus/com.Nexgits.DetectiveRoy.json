.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jS4HQSrHYAQ7kNvwHK0bFR&_nc_oc=AdppDk8PXYUOjwTjN-T_mQ-3hpxUjI9OjooXdyPbo8_NoY8S7f0X4_Wsq7bCUtuXQsg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs94ecye-3QGi-G75ORxqIKLBIYmHhoPgjdxA52P41jA&oe=6A903A22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNr2cbIXOJkQ7kNvwEZr_7b&_nc_oc=AdoHDGMQG3woPLgHNb2aYag-AjjyWs7ygKHwpyY42yzC_7vYAu8xBIcJnmgAesYKn4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElxz4GaV-H3HZKrs9Tq-Yw7G8_N2iAw3ZJWnXy6BiTkQ&oe=6A901738"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFAzIPTchqEQ7kNvwFSr2-w&_nc_oc=AdrO6-bhaauUFCezwItw7s-SmeA3S77K_yFHE3Bu-AI6bTs43HhdG2R3MFzbCTpk1Tw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnVbFyEHAmlw5hK-L0PBm0m7CynGSvcsVPe6ABMx8_Sw&oe=6A9029F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFJEF_pLxCgQ7kNvwFPO0LY&_nc_oc=AdrFc11QEblDtjFBLyeQ1ZKW9PjOr7QFdTbmQpxZrLAs3SPf7Y8bgS7iWwjxlE8L6-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdxysqL8JyGMm-CF0MvnOrzxyKrcBp52TfM2aOVIB1Ng&oe=6A900A40"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7SmKwJlU8wQ7kNvwFIF4hW&_nc_oc=Adr9XkWZnJbXcgS8TK_KlamL_0l4o31-LzeUU4H7Xmvdmr7cu2xwCtxtUkEPcnJJ7nE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG78j4EK20sGvpCI9aKNiht__ffNpqvyWF_0oAuQ_9_FA&oe=6A902E0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_K1Ra7esxkQ7kNvwFHICdP&_nc_oc=AdqxuoK4UMlmaY2ZMdMwhCoZb_kDd75H_B04teyyyP0I-fO2HDrwAGM04UVpMQtwq8o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs-dALXSiKJPqiisr0D8QWjJIia_cRozJpM4RC5LD8sA&oe=6A903769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqHQJ2zRcBAQ7kNvwEWJtNy&_nc_oc=AdrwCAOrrcKXhf3bq_fXf52iVejkaAOcooVhnISSa6G2zR7O9o0pUEVwqvaf0TC8SeY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjl_KMR12ZkfC_FT3GrWMt7cPxXZKYxjl7OXn17yHXYw&oe=6A902CF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJEPqGUwpocQ7kNvwFwhZJ3&_nc_oc=Adqx7wO76ROTeipjBUBndNYAJjtr6P64emMdURKEr7Vn21CPHZKU3pHTEwJfOcswgfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh4E1qNEryuGUq2n1hkUxJ9pXjwvaEFt06ZCIdYPpU4g&oe=6A901BE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKH3PHh_qJoQ7kNvwHGMaSp&_nc_oc=AdrzOZd4ZNK19UE_9oPheCAs05atE7kMxLgyujrWKI_UQmqMUOAv-LAkRGdAWAmlI3k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PV05PHQsiNQpJ-P6AkKbf0aCNGyJTeApufeAuyJ-IuA&oe=69F357A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfkJ4iTdYtAQ7kNvwG5aIBC&_nc_oc=AdpLgAbtL6mhW-aw22ZiMX2_dsRn2UUQUbvfSAaSq-0fTn1ry04jULhoti7dpSH_7XE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xliRV16Ptj-sN3WAh6AYtdBAyoRCgxrkpg-bJ5X0p4A&oe=69F36CF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMlEwnfQ5v8Q7kNvwHlmgB1&_nc_oc=Adr2-E70DdhiGiYWij8hrz_aQwTAcNZ8LT4CsoL4QFKn3Zx_9nhNdlaRXmv4hGeNiuI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2f6fCXHhtgzENOG1x1SbOJBtyA-sIDO8nHAIkrwExHXw&oe=69F34770"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnogN-dd6FgQ7kNvwF9OUtN&_nc_oc=AdqKA2ZKYIK8D0WUDjc9Dc3nq2GPIZZipaK4YXhulOrh9XgMdAPrrSAiVEFKGPRUhb4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cwwovUDSt7clsJUj3xFKwUaFAMRiKv8_rXUy-hQdl5g&oe=69F36000"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPgWRlFnJj8Q7kNvwE_k1NU&_nc_oc=Adq9qcqa4QcqopHKsSaAzTdUWZXCbiwJWpRu_QzSmZIjI2omFn-nTlXI8CUSBk-GGkg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UHAeIOzyeahLHiMgzh718J5rAq9uYIkkc04Hyqwn3-Q&oe=69F34B8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbZ140996ZcQ7kNvwEszxyO&_nc_oc=AdpYHPtTrGl8Ug42G2YB1C2LmnjxiJFCAWB3voohTKn3LHFZrWzlPhesbLcswYAfll0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sYiBWDAVUejQpVEr0cX654OSxoQiJ102E5cc943tLHg&oe=69F354E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGtDR1xvRQQQ7kNvwG-cUlS&_nc_oc=AdoDCpnuRYfnwtZPldyv9HEzIsGrUyTjJxqpCOaufMgn6Hq9v3EZKeGwEWsC7JlxiIs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Vke2iUt4jQF3zOqv-MQMjfrE221kf_9RvGFX_zHpJJw&oe=69F34A72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA0p1jJ3o74Q7kNvwHPSMRQ&_nc_oc=Adrf74iNr62mmpi-RxS0NaDBeofHxFpBx__Q0dRN2ohqH2AbSpJMce94lB6oiKKS3TE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xDB-EnmZZ92rV0QOlwrpvxc-jM7_B5GYkDgdgyjLlaQ&oe=69F371A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
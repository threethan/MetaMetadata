.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apuEzwPtiQgQ7kNvwEZqHn5&_nc_oc=Adr4i3RZfWZAoc8djC3a3yLa5O3zIRjDFDI-8pL7lNRYfKXivHE83kAQkoLl_uZcQZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X2BdatzgD9R30Z-HjbXx6Rw6nVQFZRU_JhiwiEwOFZA&oe=6A314E22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JFzL0HWlaMQ7kNvwE5juiL&_nc_oc=AdpA10UPNHPHqAfmTKVmfBPQbYuhtbZKqwZ3TXRFtAuUqc_aYtQTNJjp5KGiFKKfqQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pV-24pe_Hjv1hKlC00PjeEkw22CaDeoQbL1p5L-jhoA&oe=6A316378"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE5hFaeXuZcQ7kNvwFUT1Wq&_nc_oc=AdoclDcRY0dh8DJeXO9lzrLlCdIdfuSid7LKy1YfCs9kPFjScIMSP5RX98Pij1Xft_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__D0meRhsD01KR7oa5-uUqO7Y5rlC3auuafbQWC3NBoQ&oe=6A317630"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2ANxC0JHaUQ7kNvwGwDgKc&_nc_oc=AdovvB8RKyaEe6ddSabcv-V2Z5_Qty6doIaxsXqmPTB6VfRPzDZBFdPHmAwMjQhy-KE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y-2Bs4bVIekHtUBCFZ2P9PrE-k7aMbHo4pTyRVCGlCA&oe=6A315680"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVJvfmxrl6oQ7kNvwEA8RZn&_nc_oc=AdoUu4hzJAzp9drXyz2k97MpvT1KQV5Mct5gh_brx8t-s4CyLuNu6n_jtc8zm8gptFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pZwzLSfqDfxKz3seZUgv5GkcIec8F0vS3V5I62X9P4w&oe=6A31420D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7jjoglFpe8Q7kNvwGbp7FW&_nc_oc=AdpnD1RFhc9O5AMvwabj16KiEKdoMPlndWk97m_hXiqYBnOKylyCvfSNZwmXCPVjeHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oWNhzNmcpvtpc7WIJRM583vYNIOwpRQnVg12-dv5uBA&oe=6A314B69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osSS9XWKMBMQ7kNvwHNqlt5&_nc_oc=AdpKgsfuzgLX_BOZCUi_eukX-qR4af6me0iSE7EybnaoNKoUGMOI_Y8vJRU19oqLjZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RV1BJIcAsif77dmucrL8yoBLGbHq7Yeg3TClykMwVzA&oe=6A317932"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa9pUsoIOOMQ7kNvwGsJM4c&_nc_oc=Adp0jb44RU59jsr9RCeMeYY9RlYnEuKt6F0ywuPePL-Pnhn2UH_AhWqWNG4zFsohpcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F6rX6W_MvXxoju9EcnMBkDGH10apysLhhKlLROu7aGw&oe=6A316828"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
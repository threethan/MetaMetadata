.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wm4LXXOX3EQ7kNvwFImgaV&_nc_oc=AdrU_sFLO1e-XtEPkrtgSlBA3OQeb_2b00j4dzbnCyS969kbOZD2BgHEjKiA75fR2dU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h5Ll38hOKVuFshYYNjwGzYd7q3v0ZW8BdzPfDVlnxwg&oe=6A33F122"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JFzL0HWlaMQ7kNvwGsNDeE&_nc_oc=AdpxrTgfLYGLAYGR_Lce7FsnzjgWJlWd7HHwdMzI3hU2KzPkGMv82bWhkWEsP4-QvBY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_71Z84vE7lX3m1VYbZmyeoNqDPO0mdiUCrAK38vaGtFw&oe=6A340678"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HP0TWcrjQ3oQ7kNvwEr9ukH&_nc_oc=Adrhe3JOogBoOEdTktxbVT4jwagAb6N0oY42SGoiv-JkLBnpwi37bZ7Sgau57kqumfc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mu6crkQiZGoi_jND8Xo2y08Oa0-cl4q5Wd3qLdX3jwg&oe=6A341930"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqTDbgvxKXQQ7kNvwGnwHPP&_nc_oc=AdpJhiOuuKxBPiRo1dQOEVt7Cey4ce7y8RFWYZP3ucmAMRkOwbxMGvrTjcOvZzsnRqw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ifBbqtkF0giGJzk7ilid3wZy55tUZb45Twb6_lELYag&oe=6A33F980"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn82yEyBEQsQ7kNvwEZ2tp5&_nc_oc=AdqcngUOAa55Kfi7SVLFqY8Y80L3Z-d_ZEtlruF7mcrO1pzlz3gaz0ZcitbQaF_wvvA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9haRjQ-yZoRphoiiDEiIfZteidKeDoGFoAShy2Car8A&oe=6A341D4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz4_2VFX7v8Q7kNvwEmOi-f&_nc_oc=AdqketxOMGAB7PEwZLKFs2FJjWrU5qvNvc2JU-HPB2GQGRnk1SLPIFvhY0k93EWWOQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KH-WbwBZecd1YF9Pwz6ZSS5wYff5CkLc9brIS2c2cUw&oe=6A33EE69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-dCgEn7sWcQ7kNvwE0FJ-9&_nc_oc=AdoPzVTLo2HGmQvjLnReiNz8-mlEibnD_xpZrv-ro82aanB-o1rr-KkMvpBuDy9H2gw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MvcycHfwanUVdktOJhPg0-dykeJLm3At5UymiPzvcoQ&oe=6A341C32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cj29m-hmDIQ7kNvwHf_Rbk&_nc_oc=AdpmEsG4FlpybFY9GpdGtvLhArufz6Q2wGIk9baG28LK6c3l__vcmub6FDNmXZOqi6s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OG8lm_uBv8innJ1xX6PSpw53ymtsikbyTriD8vZ6jxw&oe=6A340B28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
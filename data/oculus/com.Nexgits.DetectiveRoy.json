.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw_9CikO8PIQ7kNvwF_boOL&_nc_oc=Adrsy-0Y_29o-_pJUdE-g4_lMSAtrqrqS0P2w1oSQKdnqNoSAi2t32NHPlPk9vD8GHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPMSP82AYpjjwCmarsGTZLyCpsw5-5JOyclfSkSQSDkQ&oe=6AC3A4A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjrRSrMei0cQ7kNvwFToHsh&_nc_oc=AdovMQ1vGFcz57YyOjwY5qepZ13NFFPKh-dC9AUafq1qUaXAQdXVJGHVFRXgzR9s2yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuKy1WWvZiqUOQRpbFfHZKeIJIxyGSvxCx3tURZkvlkg&oe=6AC3B9F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6bpeFAfF50Q7kNvwE7yTDm&_nc_oc=AdoZU3nDS2EpXK-T-hmKV_A4GprrX_8pkkTT52XeKBOvzX8QeVOxDo7B9cJz3BSG6_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeEgZC2cQucUWiUc3zrfPfAN8rF0YY4gydMVv1wcbw9g&oe=6AC3CCB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSABNEUneWYQ7kNvwENrKYp&_nc_oc=AdrGQHrlyPq6MU_3ScAoPQAYPxhU4PopiVwnFDbsZ1ep19VqiE8cbAl4YWOWwkz4aeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSTNgnELjbJftmmX-fpjABT3DsfLPWBQQhz8or34-ZSg&oe=6AC3AD00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQFT3lCRwoIQ7kNvwEgt59u&_nc_oc=AdrgZWFic0FUarXdynS62LP9Z1lQWlQeW-gFTyJI-Sq7yhVdhWPxepNOlWzaFvSJ4Ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkayiwMj3ruC8WUxyx_Z_J2B2EUdMNcaBbfUh4t_7hzg&oe=6AC3D0CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIwxqOF2Ln4Q7kNvwEUSs3o&_nc_oc=AdqRg8uCBfcfCm5A6b2weLN8Zj8zfA9rvUC9bupmjmCKdJ9PHQyxRlKg-di0GirLxyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIepItcmh3ioyC4W-OKRRm2jqIdNRoTav6YJ638DW-sw&oe=6AC3A1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01-EnohXs8QQ7kNvwGYLSrn&_nc_oc=AdqXxooxAzn6jZ1mzWCp-94PC0mxivAZ_7SAJfomNrltUys-6t-j2zeePeoXv2x5NSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2nqc0yEQMdwWK998aFTpdKAqLW8pcZmRCeD_wnsfXBw&oe=6AC3CFB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EURtrRucnS0Q7kNvwGKoONK&_nc_oc=AdrMW3WOGreJS2zpdnPPQ28CBD9AhbWeYNprddG5EnScrsoHtb0l4Z6_DVOYBR9I4XY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnPkabX0LZ56maA2T8qvqjDdKfE0q5prQ3bJK7FlAT-A&oe=6AC3BEA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
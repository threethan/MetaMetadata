.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irdmkqnKN50Q7kNvwGhgprB&_nc_oc=Adpc5fzUegyazwPKb-sbZ_BGbOOCsXLz_hDB32HbrVbSr_bSfHikWl0kL6IHQ3s7WEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHeh_Zccb_9Pe98NcS-EAopm2lcJKMt3EGFRXC4uduRQ&oe=6A748AA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DgkWv1paYsQ7kNvwGdrbI_&_nc_oc=AdobBcut1zpgv4Af9vVUShSC9NtJZOLe_MxIvJhsc0L8oSv8EKwdDa3H3udSP6PtLYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG09h5QTCyiLSCIZdd1Jorfa204W-hnvxS0BABURHCu7g&oe=6A749FF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsJlYkRKaVoQ7kNvwH67PtQ&_nc_oc=AdpvPNRHi-C3kwHwO66LC7vUC60o2gIqmU8QbFCRp5faTkP2rln-CxQvnFOlUiCb3-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Mbey5O3390f54H7LlU-iD3JPRHa5GWUqYGgEEdfm1Q&oe=6A747A70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kst8fltK-MMQ7kNvwFYs6Pa&_nc_oc=AdoMlOBvDlLyORLz9iQO8kCLb821zpRkZSwDteYTnOkQbmundi5dVTN-TccpsyT9KhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqlTbk_OJcoBh2cafXCHdDE4R0_eh9JK_uG_qoxdiM1Q&oe=6A749300"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9i4UraSGVoQ7kNvwHwMDox&_nc_oc=Adoda4UfP1YQyGs8tS9sI_JWBBF8qopY64FMajw0XdeWHVSPD27a18Jk-RuDp4iJ-uY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEryJ79ZZLJDm_-eszzxi6VADlnbY7d2f3PRoYpcegORw&oe=6A747E8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlgGbUVrgSUQ7kNvwEGTPNw&_nc_oc=Adr3_dLMygRk5EFfPqIagLtxvyJgb82qLckIRVZLtS_kFijeN2Bl7rroI798SreZNiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3CY335aLTnWOSrKc7CYxQeQRGp3r1vldmRZ89EuDk7Q&oe=6A7487E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qubJUScljgQ7kNvwGsVTLe&_nc_oc=AdqflrfSQeDTh550ekN1uwfvOV20SfbQ4iuCmhyV-hszTOuobacaMx_ulLfj4upYtD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4IKFp1EofJYGK0DFgxA52iH-7m6yYtJYzAXVLlht51w&oe=6A747D72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yytEbdQwutMQ7kNvwG7zX0T&_nc_oc=AdqZrz8GViRTcNLzUfZ9teWBfgItNiGK-tIx4DCB9nGDLEbW6UdrUr8dbosz7s45vSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVio5u0ShBzS09FhVvIiHyAO3Luzvbz8MQTT72WTjfrw&oe=6A74A4A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
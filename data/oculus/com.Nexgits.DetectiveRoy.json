.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poE9bPfIrq4Q7kNvwHFRmJ0&_nc_oc=AdpsG8N4j0K8igTFVKjaFyyHbU68j5fxOFEJlXCCH2mWRwoGs7W5xnypxxNRmP0qAs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwE_C-4GX1MylKGWySPSLKXa8lKiGxoWqFnCtA41c-3g&oe=6A5F72A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdxyloQ4CA8Q7kNvwFp4j3R&_nc_oc=AdrgY5LRUbCbQgYnMgW3Ps6UaPSmY03vQGkbO7QxT5ZNjAodttd3NYg4e4zJ7grTv68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5F3U7rlTI-OuJJVgJRe3LsNqPdWavFApEvJKSeiY8gQ&oe=6A5F87F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3HIY4lVSsIQ7kNvwEK_C7Z&_nc_oc=Adp-pLyB1uciDv3RjcZ2bgNrj5_joIfLywIH2fZl3LciTPn8FklntiTHN1Kshbo98v8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjwhKYkv6d5t4W6jeSklcQi42Rv-CAWBqZ7LX5Odzx6w&oe=6A5F6270"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWn-LJStFt4Q7kNvwEyN9sG&_nc_oc=Ado5Tp2xaVi3DtDC4SuB97YLUTrbyF7JBmDZKIVSg7WJKeu7u8IyLrNumOtBzv1kHP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALUD-7tdxzz3_dGk9ZKGC0Q1C9fRHJFoY3OFvO6AvgaQ&oe=6A5F7B00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAujR1qtB70Q7kNvwG4kPpG&_nc_oc=AdoYWo2G6DN6gl0Nl1OySEx3no28Fz6F16w4wD_1eM9mul0H92S3KrvMeTg2WOI5jXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM_OuBEo2qJi2zw4jWbmjD4mJQwhBoARCVeqoeT8Chhw&oe=6A5F668D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmMjJyzu_yoQ7kNvwHIlBwF&_nc_oc=Adq67-ZBjFIKo9ynL3KFy3-b1uxQUg0mtb3_V_9Yo7zPpGWRDy-irEq26UlM2uN5vmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ1bv1K8vDwXVOjVMmShSbNPL2VYyyroMpnHMneGcKdg&oe=6A5F6FE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWG7KphWYK8Q7kNvwGSAP1o&_nc_oc=AdouxSp87kZaMCNG4B2IOXZb-DN_SLC2wzfJGBXfZB4LdFVjTkyC1h-z6T-bYA-QU90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbmI3UGK16RyrITXpUaARw5zZeiXjc2uKO2K7Jcd78_A&oe=6A5F6572"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqtEC8G39LkQ7kNvwGEPof3&_nc_oc=Adpdxv5yIfYm-Kzk4kAaumITk6rSMXdF1icVVO3JJCUaglj2CEtawAvy-41gJgmmGnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1u1_GxNDNsoZYYfuAwlYNb9YqIuOaRzv_Hqx6rijThQ&oe=6A5F8CA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
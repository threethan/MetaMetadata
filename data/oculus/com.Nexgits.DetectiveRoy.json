.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYDDWK8JWT8Q7kNvwFEeHoe&_nc_oc=AdqffFadrm3XRYTBaQz8eF3EyYRxqhyliUaUWVuFnHPwiv_VpW0lBrjDEfJJnkioIvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGmLE3DXJkK2jDXRnKK5VWZhIPeTinqJ82irXF5CUDzg&oe=6A71E7A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk0oWinMz_IQ7kNvwGMhlVs&_nc_oc=AdpFfZdKAXGqpc3HOvuBVthINfilPur_tre64g4tK0aVhaTi1WTySAyUohj4Uj4UDAo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQFxF-rDLcnLOMZ5vhqRQr52uEGJVxz70d1q9RYNxe9Q&oe=6A71FCF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsJlYkRKaVoQ7kNvwHmS-j4&_nc_oc=Adq9YgEmQNedNE5ZExa8UfW4yq_baelFYGAWb5d4Z1wkeCrdlsfbKSZXS_o3MbrdUZ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4TShxMeyUfnfAk_DIazdYOVk0Eg3wJ5e0TFnFQY0X0Q&oe=6A71D770"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJoBb4B1dlkQ7kNvwFf_xmD&_nc_oc=AdqNlDXq-BZD4BuyyvVe2rmRayjPf0mNUhHmyWj7q378XTNPvHRmZ1kUqFSI-QvwUgI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK5bs7o7pmaFzvw5-let9J_QWuhLskzfOYX6hN0W9sZw&oe=6A71F000"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9i4UraSGVoQ7kNvwFAv79j&_nc_oc=AdrbIOV3kSVQFg3q-BDg-dU5ADmYeKLUiIiAlK5OKVp6L7cGKW3udebSd202basW_u4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYQUaMASgsqmeA18rLYUtB5NZYF9fDOmUR-_3FSc2Jbg&oe=6A71DB8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlgGbUVrgSUQ7kNvwGjxoEz&_nc_oc=Adr9X1lxktY0H8IBRcxzdHITh_IEIdCUxGQu9Ou5_Cgl7a95j08KrOQtme8fdt8LRbw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHp2s_mrNgoBvD1xr__L88JHOH3kKfS3ieoIkfbfvuhQ&oe=6A71E4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMIhcaMexpgQ7kNvwEQa6-6&_nc_oc=AdqZ1TIA5jBsgoW-wx_FuxfXHJLlj__00FkiL76kmf6x2O1yG5wMXmEEygl_gUIO8Jw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmj_9i2acWhe-50ij3DqkbJhG86ARfdkHEsWlcgsLZzg&oe=6A71DA72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yytEbdQwutMQ7kNvwGVr9Hu&_nc_oc=Adpcgi061mrfGEToQpbEwiyvxxpKmN3stx51SwkMwdm8jZT4C69pfu8LTz9m6LawlCo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYRudAeA1q8PbGS2AeyPIvaSGnW4gzRr6EivSUoTxirw&oe=6A7201A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
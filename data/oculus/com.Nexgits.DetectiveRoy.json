.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDFoV0Ki8UkQ7kNvwGelB65&_nc_oc=AdrEhVLSe8YSAK7ehs2JTeKJ-EW-FfMyoTxgZaEZRhUtangwdb_7EbZHqaTUZIuWdz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_36AWVcGBrq4E1eN6H9z3NMt1V7a2bQ3pmOLxwERO36A&oe=6A37E5A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcHMtSZvyX0Q7kNvwEJqXol&_nc_oc=Adq9PEgDmJ6qN6C0xWbBhyMGdRVoD_Snuwmyhnx4265wJpbEdtvx35_TImifrAUi3jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87jw8A7ZYnwMRd2u1B1QFqFSigfFVutcw6h_mt7qsyyw&oe=6A37FAF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vFysF8JqysQ7kNvwEqAVZe&_nc_oc=AdoeXPk4lkB0MbLH4Xya4L3pcc3o0FZCGwvMb1ya-xuFjLJpPguEy1GnpuOpMCVX_YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s-kyK_RLCmw9WdyCGuuT3OdjkwM-wJmpVgbn6S2QJCw&oe=6A380DB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAqKmSk8yt0Q7kNvwFkLpU6&_nc_oc=AdqSDGApR6C0RP8LL4QvWfAM6jUCLNpTk8OAyhipi6pkXIVfWYfSVZjns5QYIgja0FI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8beRuST1kvARtMOmkYPEkg4FT52kHPiCZGomVBVbFZHQ&oe=6A37EE00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzkqUYm6jdoQ7kNvwGbEUT3&_nc_oc=Adojd5OSy51vKjHYGzVYzFFJf_5X3TYrGmYL_709IFcGdOa7lVH3pPn6xrd568kVXFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9mRmqDJyWJl9sguiQvSzkBFbyZ-2OB4w1mcjPIAS4FA&oe=6A3811CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEMBUk16LpIQ7kNvwGtQer5&_nc_oc=Ado2Sr5Jf0qWioGwM79BmH7Bmxd7jvdt2AuZqwrGEjoXAM9nm9FMci58Z62ceN7ccWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v-qIaxmcxdb5dZ4-v7SL37bWSLV_jkKzQF_AeJkuyxw&oe=6A37E2E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsZRQk6W-AQQ7kNvwG4kVbS&_nc_oc=Adoacpa9GcDDyKgT7PpNggRkMIsD4EkPuufUjBhMuoiX6SQ5bTIUwodeEoI53f5Fi5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-457_JJg-99xN9SABz2ItuPrPyrfctHjB443YLhV1e7w&oe=6A3810B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-js2vmBJP-QQ7kNvwHhb66-&_nc_oc=AdoWqScVHkXw_OV3JX9gYFKNr-ZLlKIeMFn2JnzMv0mr0YUB2KtuZn_A4wPDmRRsb2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i5qd8KtgdJiZOxdzw7c89faUKdbSMpk_4iow07g2L9A&oe=6A37FFA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
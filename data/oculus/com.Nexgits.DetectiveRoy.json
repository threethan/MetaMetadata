.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBn_HAJ2d8UQ7kNvwHFDASi&_nc_oc=AdoNwjAOPDSdvgcSzPRQItNgfIrZQYN0emSyYpyCm-BGpGS76VhyZiFk2Y_LOxPJXSw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ugQB20bTN4r0NjTcCzl7bSsmmlZvgThQonRQPpuHW6g&oe=69F5FAA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3a4C5n6PZsQ7kNvwEgyS2c&_nc_oc=Adp6cT_U3JLj1OfUqlOPb9P8k4Gd6_W5EsevSz7sh6W4EAJyk-qJ7DaUNrpyZO_JHkg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3x-RzEYx42-c1br7DYIzkFoxI6wpGC5Ku_cqFbfNRYTA&oe=69F60FF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMlEwnfQ5v8Q7kNvwGMslqX&_nc_oc=AdoCFtWA0mWG1m6vLM1bVqzoyH0iYeBXJoJqqs68N1F03DReQIHcJroOYYdKD3AzSgs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PtuKUSMc1sniQtpjSiEZ-g8UjMmkpdFmMqdmedh0kkw&oe=69F5EA70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wbXzBOdafcQ7kNvwFmwt0Q&_nc_oc=AdpczcTbVoA_hm_4raVXIMJ_OX7AJJ2qKPYddAfEzhf5_OvzwavWUkPv2M5N1HwMaK8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05xyvVYaA8Te3x4nI1KPAi1syE3CrZTz8cDW4Ivmg5MA&oe=69F60300"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPgWRlFnJj8Q7kNvwHzdKGq&_nc_oc=AdqiMJ0tPOlcNjgNw3gPurP0sm5E_WO1lCTA9P7AcQ3lacj5dDOjG9A3h1fPKv8WpUE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2a9ptcPyPyekk1OWK36MMc9uffqm3bVdoecEmIMHfuAQ&oe=69F5EE8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbZ140996ZcQ7kNvwFplb-p&_nc_oc=AdrrmxUQZmhrG2jUh3yNGs8j_OmDPufIHAaGbn7jETXQSQ9QfiMoz-9qzc_PdCoY3ow&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ijyCv_6cCVH3wML-d7Yu0ZKMH-mfZJPW03s4COh027w&oe=69F5F7E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4eeV00d5wMQ7kNvwEmSCR8&_nc_oc=AdrvT5F_i-mTdruVJ_g_XGfJF_uvJOgExjgWyzR2bblilY_2OZCflNVN1Rl2qGGWUVc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HYjtJ7aUxEtWyskSDPuvqcwasoGoBa2sAyXgKz0jkuw&oe=69F5ED72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA0p1jJ3o74Q7kNvwHonMhl&_nc_oc=Adoj8_nq5cLjd-aFTbiDYbLgR2dreEWYbpi_mNSR70LWFuPvnMCY0_i5ojAVQJwuT_s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iDWStz2-S8I95RCXMOyzlkZwPvr3xEOaBFdhCrNSy-w&oe=69F614A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
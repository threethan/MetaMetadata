.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQr02UscuOYQ7kNvwGeRMA2&_nc_oc=AdrTYrDqbnoC78oz8LLuJQqUjzR8oLh239wwzG3PcHb3lYZKR0bj1j_YRcSMAPw1bX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_oxPy_UbXTeCJc4Z1FomvyVhqX7O8RM6p_IMbgIo57A&oe=6A6CA1A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq8ImYvmXyMQ7kNvwGQ26ih&_nc_oc=AdrWGsrdDYByJ10K1u_Zttpz6i2eu1xQafiKZJp7stg85A9mPIo1wTRN6ig50YC91i4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCefBViaGEvmesBJcluqVTsvCOeEfQuflLFPHXh-n6NHA&oe=6A6CB6F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ2Ao9Xao4QQ7kNvwFllHlQ&_nc_oc=AdqDvTCWNgSnU9f94YF5nH66ZB0Cz1dqTYRPOlTZWcHZbr0xXcdDPru8xAettuvxJkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqmIpNryzPdFwOPNEZNEkLDjgGWXg8V_SYyvfflpCqIw&oe=6A6C9170"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qMElj8sGO0Q7kNvwGvr61z&_nc_oc=AdqnzGCzIiD0i3fXaM6mOJA7JDZ0_ak0eo76WarWBSnFse8BDLrQMihxa4PX2XPl-VM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxOw-fFnk6w37JfleBK6rdrutVMeYnVDKCi8OUSAPkCg&oe=6A6CAA00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8G-CDAT1QcQ7kNvwHCKNl7&_nc_oc=AdrZvgK8dXfXHi1QqIPk6g49fh4Enx7umQVgsGjHy8Q7E3MYp6VDOxMtCDbZHBeUB2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNofQtY5BXPm4rneQFo2z4KKddOP2uvEVR1uVhZv2-Kw&oe=6A6C958D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoTJxRBQahUQ7kNvwEugF_A&_nc_oc=AdrfIa9-9Dv2MAvoORt1iZZJZeULZsLztZbUlLLd7gSFZfrBydhYfomURFMWdWtaJ5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiT4uTIejKR4hRnOKUAmtFhw6wJ_AvHGcnhetAMdaKZg&oe=6A6C9EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCGxxW7LpJIQ7kNvwHNbuqM&_nc_oc=AdpfAsxItr6SK0jTx1XoRX9kwXbfLAGNN_yRyJkn71k4BjN7b2I75dyWN9GoOJAVnYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6kQ5y2cNqsJ3yEvhEEDbo9mX0841P2_NgwhmRKFHYcA&oe=6A6C9472"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TtS3Kf8YsoQ7kNvwEO7bm-&_nc_oc=AdrsQ3gIVMusQFk8rqSrMyHDFINnRQCgTRrElD9bJRcP7HDyx2lXmYS5mN2H_awVXzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu44Y7Ojy6P-KCRXEEv-vMJMEqbaSsLKZugXrEdc3Q3w&oe=6A6CBBA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
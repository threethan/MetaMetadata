.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poE9bPfIrq4Q7kNvwExmOrr&_nc_oc=Adp87NqOsnzL5wsLu866cx2tJzVJCh1Kdhypohx3QHbeyWNlIpDavx59tlWOypAYZxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-eF98mYcvHmTghRPi8vXHPbTtdUVMfachILraiwAP-A&oe=6A6215A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGLPWJ9DMiUQ7kNvwH0lW2p&_nc_oc=AdrgoZ9tFub5nn1NWrwLrOOAUz12yJr5PvOt8vTnsOcZ9EhjFlcI-gfQHiR-K6hnJp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5rAvsEPSFP2miAj6ntqz8x8IiPyxXvX_I-O1QVYeIjQ&oe=6A622AF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkoKUcM2fscQ7kNvwEM6oSE&_nc_oc=Adr-piCslI-lm_jeYTVnOuxRChEoW-MNz7cdb2Bk1W-2bzVrkh1LOmpf7pClU0CIDOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7XJvDCGEUVCtfNloLkTgwrAamHnNEDM4CYw_n8NwH9g&oe=6A620570"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWn-LJStFt4Q7kNvwEIbS6d&_nc_oc=AdphQ_YobSmqXor3qVPV-NgYFyhP6_PLhvSeiqnatTayl7ljUckEXmShe7gInaN4Vh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDcCjfcZG1lAoIxZVZIrKqN9YN7QP3ni4CYwROiwWdDg&oe=6A621E00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4NEKc9fTrQQ7kNvwGp6ze_&_nc_oc=AdqqWvO2kqEWwszLCRArTotlXxvozWgdxdIO_wiT2L69KBZfZvfitTiK4shAjWZ39Q8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeNC01zqXQ51asgnmXe3tqiCttw2q7rf3b24dv79YNhg&oe=6A62098D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGY3xp8b-4QQ7kNvwGDAf9U&_nc_oc=AdqZkhscVwoAlq9mETS6M80n4r4Z52M3GgNWFCZznQsieZ0IXMNVJxlX3MvNnZINAm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnw68xzvoPsyCMTmhOQzpGS9BQCkeiuBpqm8r-FGwVWw&oe=6A6212E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWG7KphWYK8Q7kNvwEkaJZf&_nc_oc=AdrieAO9iMyPZd81MK3Cd_iacc0uC0xv6HKXvzOUNYDoav62CYBdmH11k8hsycWlOmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_dj_3Whlf9t9wV0aViSu7sFCCb0phD_AVBXoUdwWgxw&oe=6A620872"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqdYnjklIkUQ7kNvwHPTqBi&_nc_oc=AdrUi1MimOf1ISNGAZxlggNGMHkayYiOHXvfZgen99pTvG3QI4OKc5WqClw3kWsHLrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf2dMkPwTFAMmWHs5jpXYB4QWG4y9hEBhnRgbXproXaA&oe=6A622FA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3Xo8q4c64wQ7kNvwF00qHc&_nc_oc=Ado0NJJG20KcVrp940D1jr6_7pec3oxnJJNrBq797AiOy57OIYcZ61thUb5vte-dsHI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf16DwuFdl1fY-kj8xdDIMsQ08Lt3rTpOR4ybQ3lTsWw&oe=6A86FFA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmEsA7Rv1uwQ7kNvwEzMnIr&_nc_oc=AdrB3SXF4ADDJ7es1RpFvb9zdAzIvlNdBEpIn9MBUG4fTeidk14RTLnjSZDhFDPp81I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLf4dDSE01CCLvbcBHmWueLNr7-Lmht3BH3KsLEeyEfA&oe=6A86DCB8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaJICwkfRuMQ7kNvwGzzYjc&_nc_oc=AdqWCm8WxCogW46UVkqLyJv0st58QvHQogTCHN7k67B7ZBlmr8Gw75agKpBQJrO-3Io&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFuskbl9GikpC5gy4gc0a4rx4AIP07T9Di-O7rEesNKQ&oe=6A86EF70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLxhXcejc2cQ7kNvwGBBrBa&_nc_oc=Ado2ce4ocrc7Lq0XoqwgF9lXCNf7h8CrYuO6W1qqdGm7XtQ3TJR0WaL_5oTFnhmh0o0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR2lI11gTVCFTTRzvUhkjqhmnABmTdD8-QloRJpOM5eA&oe=6A86CFC0"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFVMMKi678UQ7kNvwEUgzlq&_nc_oc=AdoBxAnt8AQfX1c33Qn35Sz7OeVW1SLkSH01IWtZlV7UIHoFSUxadNFsKIT6HiVAqTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4lWJ2mSXbPSc6ANfq4wyNv-maqpskKaAxpbsyyGPKKA&oe=6A86F38D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUNeEhCmnfsQ7kNvwEgDpnE&_nc_oc=Adpf79OwsddTacFCUSD1In-0bSqMS9BZ4MBHF4NbGGa4j_oxjqgkcaPTZ9529jZylo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOLlKyFRUrDWfpQ4udUB7SHllMK1_eUptNQI9zz_0zzw&oe=6A86FCE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXqh8QlbbdkQ7kNvwHktUUW&_nc_oc=Adp1zpSv30oWoYR5F7MYAFPClNcGNOMbzOBq-yRDo5xQLF7MoHuebzBq81Qqht0UMhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-pKTvYBSOCkeKgiXdrGDGI3cyao_TIy_MqM95ac9S1Q&oe=6A86F272"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp7re7W_gp8Q7kNvwEoRcYN&_nc_oc=AdphoeanG-bSZKPqwH6z6i3CTs9S6RaHj2XN2adxMZACAbVROfygD-76aGOgMeZE4Yk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFy0pbsQHaItavCu4pdTyPlDkPj5UG4ES551I9eBVemw&oe=6A86E168"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
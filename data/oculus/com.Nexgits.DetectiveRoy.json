.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LRnIXQ3x5gQ7kNvwHpUtBM&_nc_oc=AdqO7KdLcPiWH8IidLIGNnAEJNJm35fD9WCg_EQ4s4Gf889xAn2-nQn0xzAzpFqWHLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfTDcpJUNAvvTmi5WWBI-98Qg8aJryZKFD0ojrP3mowA&oe=6AA7F522"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1U6fDzJ6rAQ7kNvwFZNdb6&_nc_oc=Adr4MoVigVQC_kmhNqm92DAYz-FBpY_g1ReiLAPcZpIatQbeIYNiU1q0KkB_zVCb1aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoQVijfKauWKYpToMubT_HT4-5COnA24iKGAt6S1-Ptw&oe=6AA80A78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZAnBPPpWNcQ7kNvwH8S3hu&_nc_oc=Adq1nITeL0K2nVM8Om2tETMjsIfdmWU0qO47lpUoBcRl5twS-pULvNs61Kw_p-lR9fc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuGe8wNYTnpk4csB2RUvI9H_Vq5o9fslYMf4_b_Y1bvg&oe=6AA7E4F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h0wLzzEJDcQ7kNvwHMZZPw&_nc_oc=Adp6NOohQaz9w7NzIaNRhRoHIlXLB6955HGV2yoV8l3OT5z1hQk9pPLpjmALSoSikic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQbTLXos5efB7o7n51R88qg0BhzwJd0UF0C6XHrOcLuw&oe=6AA7FD80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7rD5lBrq90Q7kNvwHRDsxu&_nc_oc=AdrbmE8f5ct9YmNT-_y8mPO3CEx1suyZKC28knk-awQm0q44P2Ga05vAu_RprP3y1OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINLt9bYWRQogsobmZJiVQKVAJe0S0ORM24KAqN6i2vKA&oe=6AA7E90D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjFxoetEM30Q7kNvwHUZFOZ&_nc_oc=AdpcB478Q-PZktupGF9oNb-gXf2HY441U5mxpXi2LhuxxZpo4bnZwRLPy4PqhdzGNJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrnstv9kohRIGA0tNsQBgAovnlO8kBUPGcnTmAots-vg&oe=6AA7F269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne0U8vOfjJYQ7kNvwHtsYfj&_nc_oc=AdonaYbf-w5nseihgzvk4RdANJFKhwDXzBEIh-NADNYLKddwN0JoeLAlPMWtyqYjmKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIREtqjoS5zCBMn4_rHMaHnagqDrDR1xc_9ns4tihX53w&oe=6AA7E7F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc2OzalqwPsQ7kNvwHz2pJg&_nc_oc=Adq18ApeuXqIuhjerZC7BUn3gk5BCkxNrx7NJ6qZJfYsncdEvmfGMPGQVClZ6Rblxw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0Bb8ZI5LJ3nVV5WuKuHibPr47K4qa922Igrhbk0H1eg&oe=6AA80F28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
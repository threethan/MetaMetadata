.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5PIJDQjJjYQ7kNvwGF6WWV&_nc_oc=AdquDaSXGrNFYGiT25EtVEDz4ylSfRcNvCZkXUWMwU_MLuXaJe4NbM3zF06jbCnah0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6oOtAUPtgU7UqxO4RR-0tGd7AMGYBEoboQsw6v4Gp8A&oe=6A241F22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBN3fCtyW3UQ7kNvwFZGk8Q&_nc_oc=Ado2aV4wsA61jKPgE8BI1kiBzf6jnOcL138xn86zHVxLXrzXTyUNZkNI965gdtvyaX4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wiw6SM4OvcyfrfY7NhcBCP10OnCAyoAjnZx1XqD3VrA&oe=6A243478"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diCXQyfzUb0Q7kNvwEekL9E&_nc_oc=AdrGWckg4X1j6ih0AdSlXGAjl5m4E4EIrQ5j9gRkH7Em-wLReYNBT3Me7EkvZf81J5o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84cdvv5avHputQPs8DcUu4cl19h6LpW3Adh3n6O4Ss7g&oe=6A244730"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JocouQbfEmIQ7kNvwFdTiu_&_nc_oc=AdpP7z6sbdeZZdpymqLFMLzsxOwx_o3qWdPR_Enecnf-8agXHk6QOZOM3CY_a3dEouQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jyYNbDibjt_S6TaqR9LtemaE0dwFjYe79PFD5AcXJpA&oe=6A242780"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV1nay8MtRcQ7kNvwFwWLuV&_nc_oc=AdrK-26WOIPNOu4okse97_1i7rdA2NqmhX_Ye5-KH1VsmYifoNr1xJt7GEvCFgWtEwY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af802U3v6e8AB0t4omaVf-2iQjNcP3ic1oJ_TXKH8N-ZVg&oe=6A244B4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pis6dN3JW88Q7kNvwEvQus-&_nc_oc=Adq3HSOCwgidMluX5vikQpiEBeVIqYsA_nWCgwOsSWThQS5--evY6BKztmk1BPSk15w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wDF2XXAopqdZpTdPbYz2XiCGufh37xHGVkX3SGkGLZA&oe=6A241C69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKj6cOXtkosQ7kNvwGEqjq7&_nc_oc=AdogfpebiLf_3BW2MwYoZHGL_9n9cgs4LPI_dYbvFlhUS1FiLqXJb6UAT-TYuQha7-Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vVZbdKiykfb98ttEWQ2urRiJntnoXL0bb9EIF5ehAmQ&oe=6A244A32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQlOie2J62wQ7kNvwG6MOaF&_nc_oc=AdrgtO-hq--FCavHwT8w9U8kGDz8TehaMWN9o_YCYehSsOEggcFLegCmHdRV2WBiHbI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UeqbaU-olFr66_kqgamDfh1aQuDK89FKqosGOfMjhuw&oe=6A243928"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
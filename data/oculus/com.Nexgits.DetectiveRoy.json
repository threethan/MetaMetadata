.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3Xo8q4c64wQ7kNvwH20A-P&_nc_oc=Adp4-imt7cduZzaUuxUrolD0VzckFvWMiRLwFQxlgTKhMq3Q1A4WWo3WyDIDHmoLWpY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKtVOJIw3ngr8rZ9OJMQ6CPPGPXeUAmFySuiawxD3C1Q&oe=6A885122"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MMDKyjLNYYQ7kNvwE8Q2Jm&_nc_oc=AdppOxWEc5gUte2GwPGbzRm80qXhzJ3FH5GdwnI3lDai9J5hN0cgFdB0u3ncZvi57Jg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmCkzHgCnWu73NAxYeEr-YQgRpEa0flCbWphHBwG4YlA&oe=6A882E38"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaJICwkfRuMQ7kNvwEtz8sW&_nc_oc=AdowK94vpbIaiVhYDxpI4V_9qQpraC0hFmVyB77qSPxDVkyXzhn1QZcwlPafgB9WDTw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmO7JjrIYVis8N_tVx6gKdK_-FHXMIb0ioQeV9Soqt9A&oe=6A8840F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLxhXcejc2cQ7kNvwFFJKeE&_nc_oc=AdqE-nLQU6VrIVJJnN2LrKtRToQhZJiI7m_k0nAbCic53VmGxOhWjF_Ybe2bx-UtqEY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC1xfG4haJhLX5nb0fzjL9xv8nzCgeA2nCAnQybRF6Qw&oe=6A882140"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFVMMKi678UQ7kNvwGxKP96&_nc_oc=AdqzzqDElXMUZavb7GzVej1CEWhydQ9K-D9GufSNkT3JvkxIYFOPs_NjVqIo5mYJmh4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzLI703CfXYJ-nexd7K79tzcb4bPKhxstlyTLnJYs7SA&oe=6A88450D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUNeEhCmnfsQ7kNvwHd0ISb&_nc_oc=AdoR_BZJOWLcMuj2UCzZkaDRlTxBMNjZA-PyiHImngI9nxYqpa0Iy8Q8dPTVVMc8zTg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6BA46KNl2TVykkPP0E8CB1XtoIvBaoM9Hswx_tAmgRg&oe=6A884E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXqh8QlbbdkQ7kNvwEUIkW3&_nc_oc=AdpwhGZaTccHT2w4lQHOae54n1GK9iK8gEd_gEb_wcy2Zu8INc0vlnnHGOW_DTY8vNM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK-SiSua6VnmffjeLpCbWT8WEfiK9qWTOY3Gdd4mpKPQ&oe=6A8843F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp7re7W_gp8Q7kNvwEaJB2g&_nc_oc=AdrJuaYQBbPaUYZZdEHpNlFyXxt8vpxp4Pz888czLOtMRqZtrLyoQ-BavSbYZB6PUGU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkMGdPhxXRkabg4Gr0DwgYZmRyQ8nQ-dr7-84UM3bnxA&oe=6A8832E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
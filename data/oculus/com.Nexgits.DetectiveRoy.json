.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Wm4LXXOX3EQ7kNvwEES_T8&_nc_oc=AdrrtmArhnI4qv5umL-t4KdpVSAvgdjP9vptCs-GSmMf0qDybc0dQxs6hgXhYvwcMkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O1j0lkn6GY7G2xpvJjauUXtM8jeMexlOSLO9BQyMa5A&oe=6A3542A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcHMtSZvyX0Q7kNvwESBLxt&_nc_oc=Adq69VKnZ5IGGn2aba5qLnx6LPBHdCD7WiMWDRTLMp3g3OAA4-H87dfekOHTkVxXoQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kyoHiFY4FPtZ1URzVVAaq9GJmBiIOWLEBtkWNt-w4Fw&oe=6A3557F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HP0TWcrjQ3oQ7kNvwGDiO_Q&_nc_oc=AdqpIxdgq4w9S4Kw997YGF-apbXBPuOF5s8tumExwcM_-GO2eXAl0vG8Pbmr0Ok4zt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vKoy_BDlKXlkgur2Q5dm8dZBc5PTJnZV8nbN6TqCtwg&oe=6A356AB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqTDbgvxKXQQ7kNvwEJvkwn&_nc_oc=AdoGRsEpV3l2umGYNL9LWQEtfG9rn18oXs3Z_hVv4ZAXaMQvVHOo3GUdEyUmnCAJifs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YzR3RNAaJqFXhDpsoXvMXjg-XgsElkV0a7VuiWG0LYQ&oe=6A354B00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn82yEyBEQsQ7kNvwHgOE0V&_nc_oc=AdpwJYycUwYBS6KzvM3lOJE8Wvx1OVlcTD4TRM-IkOVRr8T5BXTkea8zyLx8LWvT9s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-56SviuL1hQBXTXsR0QwcRsfDHNs-nmcDirdyGwunCkA&oe=6A356ECD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz4_2VFX7v8Q7kNvwGEbhno&_nc_oc=Adoiw33sIjavoc_0IdLERBtAMSYeO0kxr4kyBwmDh6BwgEwIP4YZzVg4kaqu54-EJfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C2sRRVEnbwpEIgFNoo-WKyDgqoJMTQISIi6qYXL8KWw&oe=6A353FE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-dCgEn7sWcQ7kNvwG4AZRx&_nc_oc=AdqDVm-5pyASwgbvKrp73JQQdz5kEFnpEj-rSCwLd0Y-Y2cS8M5moc8H7rCB5G1tVCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ho8ZDsVd5KW7oncGOxrrign0FeZLA6IjCEJ1H-6jcGw&oe=6A356DB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cj29m-hmDIQ7kNvwFxadRR&_nc_oc=Adr5KMfDMYTDxKHgM3PxLGDsSuS3hvQd7HPaq_qG1aKkZGB2DbW4Qs4Dh3M6kgg4BtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b8idE4q03VhkOl9yDqfmV7JjFMVn2CA1ZKt7pvwqwbw&oe=6A355CA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
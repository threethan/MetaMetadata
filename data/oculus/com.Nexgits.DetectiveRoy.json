.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cmq-IMTsRqcQ7kNvwEBjjjW&_nc_oc=AdqMZ7DKH3FpRRbt-VWFbJ-eet-b39c75kLBt4R6zSpZWrEn5pX58_uF1d8nunrpk20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoUxc3wIys-YQ0wC_v5TSBTaAB9_V4mzgRvfcmroYcQg&oe=6AD3AEE2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59b6tHM-T1MQ7kNvwEtcBPd&_nc_oc=Adp0qcBqbpdNpje-LNYPrPb4QVWwbqwXXctkBF8u4a9MkZbAg047fUr8Sdny91bOEDA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKGoFDSomhCZIMXKYN1QUOhPpn2doeMMTTtaKWxhwFxA&oe=6AD38BF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtCQnalKVdkQ7kNvwFdgv3M&_nc_oc=AdpSVJQTrl-BTTo0U_o-bfWw_LEt5Vm2IxZDtZkvA8b7K1tt_AIBeBBJ3bbUEsG2U74&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSb0wk5F9Y6rKUgecGQN-XBcJMlWf-Z2uttgKycLGWqg&oe=6AD39EB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KHa4y9Y43sQ7kNvwHDWxSz&_nc_oc=AdqCKf1orZf__JDM1Z3SjPccOpEOrH2ts7txEUQF5Y36Qz0C2BkLRHGd1ONJGNkUTHM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyxmKsrFAjEWcppge6H-2EdAqBgnn6ZN5jUfMIO7vjCA&oe=6AD3B740"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kktV6wzueVcQ7kNvwG61spO&_nc_oc=Ado6zJEUq0OtgL3EKLcunhQZHXam7psD2wTTXh10ST1USSPC_g1u9p4iqV8UWsOcwWQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqy6OWjls4XfYJtJCz_TF3Tv1kPcQeo4YGnLHbYEd8ew&oe=6AD3A2CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKicChrKweQQ7kNvwH9EkD9&_nc_oc=AdpQsBEDzoa96zOI4c_TYom2sTDoTejGftVy3y7DiNI0sx3x16cXUWgu_eaAMZaFzgQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRccqUk5H0eek59TPv05Tq66hmyp0VUfQYDBVNPPEhuw&oe=6AD3AC29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GUGS95ZRPIQ7kNvwHFJ999&_nc_oc=AdoqTB7n2pTaQCY8tzWJGRk0z3ddSzC8JoUZ4JBde0hu69ZrAkLIc1pMiWQlfeJF4xs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXo8Crj1LU67dL7jvLHxoRSligFWDtPwFdfRq3XBvDcQ&oe=6AD3A1B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA8_lMk14i4Q7kNvwHByn4f&_nc_oc=AdpGE08cDbEPPIkiza7WT-qQ4bDx7AvXjlsM5Vz1iaQxwVYBDD3nfY383-SJpW0jJ4Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuqCRr7a_90jibU9BYbkLdNaihyGQ3ng_OfJNDpBD4cQ&oe=6AD390A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
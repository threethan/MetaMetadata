.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQr02UscuOYQ7kNvwGXuE1Q&_nc_oc=Adqit7ERdVJRuTs9bIbcU_8rV5P6c_55Tdeu1dPZy6Jt9hENxACXpvnq3DA_IMQqccA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKTAeXSCpE3ahOT4h0F6pX0H4Z5RDFfqdsHejvL-gkIQ&oe=6A6B5022"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7gwPevVZVsQ7kNvwGCKLdl&_nc_oc=Adr2EdYvrh5-K3zydLNAr4Q0lZo3AjBRTPjzn_xqRSV23R06qH1FPJDzuFNz-PZnUZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUowCe5-TdS-rKP4BOyycYG8_90F4JZ0rwUsPe-t8xAg&oe=6A6B6578"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ2Ao9Xao4QQ7kNvwG5MUGW&_nc_oc=AdovbqJipqbsrzZDutTEoUNE1FpqsrkU-A8bqwLFnYMpN8U_7JCg8u8So_TRJFDbZPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAXZe3hJLyLiiJNPzUNUc4MhQO2l-hBmMFC11CWIzL5Q&oe=6A6B3FF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qMElj8sGO0Q7kNvwGTCdF2&_nc_oc=Adr7rZSYoq-JxIRcvrAUB-WjI3hMms9CQcmxNHPgF9fOQ0B9YoBZ5dsztPDJdW3K_K4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwoumvjFfuQK4UwBcjPVtxJ0B1-sBWg0118sMM0URWhQ&oe=6A6B5880"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8G-CDAT1QcQ7kNvwHZ8DkJ&_nc_oc=Ado5dQGB3gGQ7YUeGKCvIeNkb9B1KBkAR334AmlxzeETntz4O2xyTAUi1TkEZ4QNvVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApRFRaxdtfJ2qEdopd89grFEAU3KKqd3ch4nymZuGHhQ&oe=6A6B440D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoTJxRBQahUQ7kNvwGgZtFM&_nc_oc=Ado9INRYDxrhi3DDO-XFHojN8oNmW8x9TsU4PUnEaUfn6eVtmPi6AdzhP5X1YMuFrbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMXO9c6-m8xoORg6k8HyNyZlSfBnwUjecLnXEHRwD-lw&oe=6A6B4D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCGxxW7LpJIQ7kNvwFAOo8O&_nc_oc=Adpfpvm8fOR6ybgbjMoV9CC0e572hvR6IKq_MuAiQ6hGRN41dv5T5_CsyHJrAjxCTeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtba5qlLiWtHMIv_chCRvp0UcHzq-BUMxDHW9SdEA9sA&oe=6A6B42F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TtS3Kf8YsoQ7kNvwEu3ft3&_nc_oc=AdproQTp4N7De1vVe1fJZkI0icVZKBt7nQXywcA7zajt5KwWWFP53urgRmCGL7PP0xM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASz_Dpyy1Zh7vbJ4vjPRWtCp_vpvLIotRMeBhHNO1GMQ&oe=6A6B6A28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
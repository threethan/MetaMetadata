.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHGO5rwV4_wQ7kNvwFkG7bF&_nc_oc=AdpqX4bRMpie_450z48jiS7kfNYPuFe81Vb6P-EZAN2Ua9_dOMQA1_q64QhKr7LlbnM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EXdQKdhLsy7y06rsAxTEC4lJxBUgCSLKRriRDBbpfWg&oe=6A1AE4A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDSdxmSrdTkQ7kNvwHvWgJF&_nc_oc=AdofNMErzuLIE_lNFTTI35cU3iwLTQ2XQkHW2FilDOTKclACOoiyV2TB5OtMwX4C5Pc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ke5OHtxlGy2bR-d_9YyBQdjX-IU7KIgCxdmc9mpFhdA&oe=6A1AF9F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Dp-NeVvXhoQ7kNvwFzmZXE&_nc_oc=AdrJnMbhvlIH_ScCm7Za-QsMCJZyuK09bOSKBNUsAj_2mJZE_AsLZ7XYbJr9asKjpLM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UsIoxwF1jKPMT1XVjWh1Oo4lAwO0dwZybnSsMo1iojg&oe=6A1AD470"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMrl6xnLXNMQ7kNvwHLMzq_&_nc_oc=AdqT84TzWsTKcOnAil_FXPWpYDzAkcBHXbqXFaXCp4Kg9cbwM0TVT36y9YxP9V7iYD4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aVkeENBxW4T_hBO8-XT0g4uY_HpXO0bxnzSq14Jo4cw&oe=6A1AED00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_6QCk1NUxAQ7kNvwHoQZ3B&_nc_oc=AdqpH9Ljj4iJMAhxF9Mwfi9pMOeDBKDfUsPWO-IW-486SnEDHO_m8PsKwvNOloznFA0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CmcHSK9P--Out1SZtuz7fF-LwpDuzQioJ9FETYU5o8A&oe=6A1AD88D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QvCE5okFrgQ7kNvwGP9PEB&_nc_oc=AdrFcRP_JV0PUZrJ4WqEz9Zh8oNwDqnCily3T8s4du1Ic2Dci-ydJvUl7swaOTITLmQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af632L0DZutmEEsmods2TwFjyizsjq3gIi6_CvKAnbc2Tg&oe=6A1AE1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXnm7f31_lQQ7kNvwFcb5he&_nc_oc=AdotFkANzU1axAAm1edAzjBwuqjNM7chQTz4qN9EAvwh2N1FpWXY1L15A2yLEH1GbAI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af662OecTjYM6sTMUjpIbtp06PJYLClPvxC9EBIJ5tMCKg&oe=6A1AD772"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii4rYuZz6XIQ7kNvwF-5Vu3&_nc_oc=Adp6p3XgdEiot8UaUeE5atwJLBJGyML5WuFivoL3nN2FgM0snteNZk-GEMz03yD_NqE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i_enmtPDPnzgTdVYvANLXWQtu7wHzihjhKCMUEllMqw&oe=6A1AFEA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMjWPDclghwQ7kNvwHT2NY_&_nc_oc=AdoUPj5Rvho-tDLCw5fcLLg7g9Fl8I9-pYUQTmVZS14ecapdMoWpFVIZnG3XF5R3eyk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1SX7Nd9YO6yHmloeSSrb8IQzeLinKGQhWWSU4hhUPZg&oe=6A563822"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0fTSCPydNUQ7kNvwFO4IpA&_nc_oc=AdqzgBUs6MX6ja-8M56W6MUNdCRTrDwmcU5G79Zucn0pKXGrDKVlHrC5nfE3s-20MKw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjszmJ6WuLU6dDhktNl7biYy8hnNiq1BiFOBGsHuOP_Q&oe=6A564D78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLB23ZpPlCEQ7kNvwHz_beZ&_nc_oc=AdrMSjcd5Lr-0J9ed07svvJovQeOPLPwr4I1Wt4CVXdppAcjjKu8xFUuUhwmMa8DM6U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1CDV2sA76psy6NjtkQ6oDqVICOAhc0MtwlDRM7UcgwA&oe=6A5627F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF01jlZfA78Q7kNvwE-FZ4c&_nc_oc=AdqAUp8ttVQol6kZfSRSO2_ARCD9fi5nFB4lPaHVP-_34UQpQcWbpF6l3V3H3JA5hQI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVuENFmjdcs8H65WI44366jy3-ugZG5h7osIj7SWzGCQ&oe=6A564080"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MsC-UFSRxEQ7kNvwGE0KEN&_nc_oc=AdoR1V5F4LCh1ersWGvVsYpF9Rtkh2bRvomNHEMjxx1iL5u7wA10aukeh5kLUeSA2L0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNyccq6ea4xLvP1E2N_H8Qm-njsJ_M63HBKRDynd9Yhw&oe=6A562C0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbpF-IN3BdsQ7kNvwG56k2P&_nc_oc=AdoeKVQInrMo7dwaETEBvRlSk0bzfUzGM3bjpq6jICE0ykpsRJWp2UfEsSeemz8dtfU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB739NznOTYdND2a_nru0PCj-Nys75dOpCSAoX3sRrLFQ&oe=6A563569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoutQjaqsLYQ7kNvwGXTimk&_nc_oc=Adrstk-khLaB8GYyG-kFENmLUAu5V4zuRBKQ4fe7zCA3yrZhcwWKJd7bnBea0xHRbWI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJwqGto9VrYG1dQX0yKC6xaws_siQUQ9grdZHAmQb2Uw&oe=6A562AF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGwgWIYfjaUQ7kNvwE1owYa&_nc_oc=AdoysonxI-ew9JSy3dzXKyv1DBnOqTLmrA-xoZ1SkzK6VFOZKHnkDPvvyobm60JIB28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq3GQKzmLqyK6tPB5MLnf_-qWCBrahwxxQ_f9kv6luLw&oe=6A565228"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
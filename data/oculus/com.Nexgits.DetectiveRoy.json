.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLBDtgAemGoQ7kNvwGdACgy&_nc_oc=AdrzywADv0Aml84nZBMDpKZd-9otsRpryKm-CV9z6xz_NcWiYdj9KEtfATgBKUXlVHY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fP8vDGqsqY_5lvKclEic8F4CPv2DbosfS49N-vjC7Zw&oe=6A217C22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBN3fCtyW3UQ7kNvwFY2WzK&_nc_oc=AdpuTuG3aOCWbhlh-wVD3p4A4QhB--HXtYzGFOU6ag3IJ_J4dWaxbwV0DWFHZHo_tzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UH1_bFwXm0A5gq1GFnDDeFIHj-Ecn-RMkwxCLnnPTbQ&oe=6A219178"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9RXUG-lNKYQ7kNvwHG8Un4&_nc_oc=AdqWmVrgAuiwgrZYEgY5gkBymRh4B9lEf2V8gQ-4rFWCU39sxidFidwtBC0VNRCmoEM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yZzqmbhzzLxa3YuY0lt1CYnnJ-CmmY_iEMh-_OcSfMw&oe=6A21A430"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSxA7R-xxkwQ7kNvwH3LpDv&_nc_oc=AdoMp1-Lx9tv_qG697AkeG4j3-avqi_mj0KWYfAbQgxlLtue_ho-zsRLdRMp20zC3NQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YJXT8Jnd0gS9pPC5fGATiJl5DSumzKfA9-qujxvaJmg&oe=6A218480"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMXgBfKbeWYQ7kNvwGb234V&_nc_oc=AdrmJJd6Q3fIIXsioBP-lk2nq7_DA_yqPcZXVe-P9oPgDooNlu3lk8Ig0EfwCvcRCr8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5iEED7QcKKjqdy6xvbVsMwUCTzU1ySiemuE22Pr0dKA&oe=6A21700D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNtlrOAfBE4Q7kNvwFG0L1A&_nc_oc=AdpC4euVFEDOnWV0x2GWwY9QdUwbdGzwInv8hyc1SiPEhX5zPbb4skIwhTOzT8O1B0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WsrsCThbttVS-TORUGNDx7H1a7a5r-BtQj0FlZXnd8w&oe=6A217969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeGFVWVkawkQ7kNvwGrGwTe&_nc_oc=Ado48gFvkCC2a6weA9sGayYeyvZt7YCVZ8ji30XTIvSC49BF2Ajdqf-AAD1Ae-vVhVI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Tpc4Ah8Nka-WoeJW7yz6hVpa_X9AjY4FGTiP-ZbCiTg&oe=6A216EF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QyajgEGJCkQ7kNvwGtM1WX&_nc_oc=AdredB29hdl-L5q8gqZju-RGnW9VaTMX-UvRah0cEXJmtg2k-h49ShMiRM8pjFj1CB0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VGSnia4kYVV6wpCWeJ0LG4_fPFrx8l8qWI1qsSqtVrw&oe=6A219628"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
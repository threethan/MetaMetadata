.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tia3frnaZz8Q7kNvwETuO-k&_nc_oc=AdoTf2sL-sko7Wvz1kZKNCm8mUlbvSGcnuDAXZCpe6QE1s1Kb3TPuv8j6TpO8iWVPqw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm2pllQF8WunW0YH_upFuhiui4nqABE_CJ65QwzRejNA&oe=6A974222"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwuRFez82SgQ7kNvwGK5ZhH&_nc_oc=AdpUo2WXRTFtH04HuKmko_pMgi6zLgb2d9HBAVdxJTInpqfSqkdG6fhWuO3cDWiE4SM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtD7ddD_pnyogja8xODlniK8Lmllet6XpuVBBodnJr6g&oe=6A971F38"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IyyeoIkrlgQ7kNvwHa1Wf0&_nc_oc=Adp67kVHjr4HP1p-AFmpcElrqFvG7iqCBcUmQjqMXWaDeSWotnkCOlhQo28Q8jX7q30&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTfOoGHztmXd4hUN4mFKTmOT0BR54S6WUZYszE2Ae_UA&oe=6A9731F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r90gc2HDtpIQ7kNvwHUKmAI&_nc_oc=AdrmzkVl75NSAO1FHmihfzDftX_hWvaytUib35ExTpeImrH0JuIjYEIXi2-cEzoVYeA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrwtvTyMGMN6ZYa8KpIedz6ozai7435G1IBHfsLYdXQg&oe=6A974A80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IntxcaMP8cgQ7kNvwEEK92Q&_nc_oc=AdqJX7IYc2YG9ILfIOh5rD2UlCV3-9UStscpaKA1KqEpJ9Gb144ba6g_pf4xVand80A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAnVzikRBmav_92XDBVWLvNbp8qODPLSofoIhDjhbapw&oe=6A97360D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvjGTuwkNe8Q7kNvwGZ46Oy&_nc_oc=Adqii0-StyNAsmvdAILn38beY8jf_HZzon0Z9rK-uppm3krdPt5lp1_5DJyqzxpbKYc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB1MCm3fzcJChjMPcx2JkOwoY7p5q2ZYCkvELRwM1PeA&oe=6A973F69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE9JxgtEuSYQ7kNvwFKR3zo&_nc_oc=AdqUBmMaV_SYs00z_1t_9PkS0_nZKeh8dJpiqGenSuc60mUCZ5WeoCTJfFaGFDdsSmw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn_2MIl3O-s0lUTNBFmLpEbiuy5Zhe8N-EREKf5SzPvg&oe=6A9734F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9wpAZ8z0uwQ7kNvwFvh_k5&_nc_oc=Adq6tk8MzwpQB5ygz_cV18YkiQFRSwoTotDwyMh3e7SIdYF9DzqCRaSrsd7JaJqNVUs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQECpNyE5jafWIo5PQW81c1GVgot9DtRemZQqHBDyHTg&oe=6A9723E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
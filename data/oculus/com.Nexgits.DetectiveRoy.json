.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyDjalqW2KIQ7kNvwEyGhE9&_nc_oc=AdqIWoc4GGfn9RBW8cI6SIhpidkUiWdrlD2jVtGDYQthaYUz1MAHF6zVIfLbLlqjYNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK4wHBvpVn5YcpCDE5789fWs_gUWXgwvLWUK7TduAyAg&oe=6A50F222"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEGun-mIN6sQ7kNvwHUbvUE&_nc_oc=AdrGWbjImrXBPd1bR1eoR1hTCnJYV77SguirNkd27YM-gJerQ4vdw6aJ5dRUjbcbr-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_hlBNS5wxttwfuxLtUzKidv73xJcG3h63jrRu3JdE2g&oe=6A510778"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irtmfKUO6JAQ7kNvwEKCKzR&_nc_oc=AdoilBtJQe7BzIce7xsBdtlIT2OdGmhKMit-rKwBgt7caQCPN4IiCAbdtneevs5_Xz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjUTfEgQwqDPIMPS5N1RAA4sNr949jpQ_mRDeJ0aJ_Zg&oe=6A511A30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHkZokEop7UQ7kNvwEm9Int&_nc_oc=AdrTR11wQdAH-s6AOTA0UZcVCm9F3SzuDzev1-7j_Lu7fVXl7DnaPsMM35pAN11TFwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6ofT_ZuSetzX0ZMWw8JIZ2El0LZypyKKtFABLhkfhug&oe=6A50FA80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvpTnpPC_jMQ7kNvwGskgPa&_nc_oc=Ado9pD9CnCRJ5Jv6O18jUr4mRY1zAo3OEuUOqVE-x-3uG-JXtn_3vwLifxutbjjT1r0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-C9XZJykuJK66GqlLNcve33T98oPd7hq9WDbbxayEHg&oe=6A50E60D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru8zleU4ipgQ7kNvwFhoosp&_nc_oc=AdpGzyCM361KvYIAHpMjfHvJMR6OQQatTpiHhLqEm_jYDNxMzJLWU-nZwPaO4-aDsHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY_nMhOK6f1msnLsn0NYLS5gzmRUVNVZphi6nW_5QZWw&oe=6A50EF69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aF36AeU9rsQ7kNvwGjpXXe&_nc_oc=AdrEfc_PMeFZb_PEGCrsdSZsruxb9rBGhnozLCSbW2kJ2WZKUZOQjDVpx-2VRM_Mz_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8MB09MkHVgIl06sqMcmhxKsVlDFXqtTY1Cy2ixWgUUQ&oe=6A50E4F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyYDZpnkNcYQ7kNvwGlPpOt&_nc_oc=AdrOBau36L7af2ejjABYggqFYGX32ret6OWxyBQdCYzfzs105Jj0n0jB2-NJfu4bNnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOYdRRZVF-F1uR-7mT9C6medtg_rp8zpq_QdlLACMHqg&oe=6A510C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
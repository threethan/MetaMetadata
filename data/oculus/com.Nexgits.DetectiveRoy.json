43344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8G-CDAT1QcQ7kNvwHM5mlN&_nc_oc=AdoTT5vc4JFLjjdMeD0iKCKExlzO6MVcywbwWPgV-Mgxc9W4lP1OwS2Hf62A_I7-AsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDixlwNdwkymIRvreKh2GiAYJVTuu71SElD1_OfNgkGCw&oe=6A69F28D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoTJxRBQahUQ7kNvwFmCXhO&_nc_oc=AdqCPZTNDmtrdOEi2vrbwXrTJVUrLKGGQdsk2UVx86Um52h5sNLLt4OzMxPrsKtC6DI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA86TEaBAlCZxtp5Jy3EPVlSMlywhRudVuFT8u43Z19oQ&oe=6A69FBE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQhBTfcTlIkQ7kNvwEw54tH&_nc_oc=AdqmW3pQxUXwxhJEPoen3CnNudy4hlsYEhKRrr-NkrOgFWU_jEAP76W9cJwPRSnvLss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrtBzBr-l8M5LGqI3ywThZmzFWQwuAbQzgmX9wSphr4A&oe=6A69F172"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TtS3Kf8YsoQ7kNvwG8v9Dq&_nc_oc=AdoIrNt3gqp0xH8bpn1mKiUF1mwLQ7OX-x724HNUVrsTwV5YO6JhX9-vqYBuucTAu_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZfqV824xZnmD_w43t7bUXwQFzeOZjlzTMX1CTK_QcLA&oe=6A69E068"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
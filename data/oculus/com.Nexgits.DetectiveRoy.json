.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3Xo8q4c64wQ7kNvwE6wtgF&_nc_oc=Ado-pDognWYD2cSy6S1PSi5n2lTHMXMYRf6pE3Pz_FbTHoRp6ytUs0UdB3bHn4VSsNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbJd_KV9hqJEYC1Vp6VR8AY-EZPv5hTbKpE2CMtMHwow&oe=6A89A2A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MMDKyjLNYYQ7kNvwGdjLC6&_nc_oc=AdpzBreHc1CML4hbFSFwPGlw1vLNEHXlkei7dVXtdgzMVam2MtIyRBqp46NVyCl7BQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmvFhHmENxK2XvGCqIehkSyNek_wSFZBUq0Ctwy35_Rw&oe=6A897FB8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1ikIXU0BPwQ7kNvwFqk9bI&_nc_oc=AdqaopSy-_5qT64j62ZDXRDGvptuocHcLSbNvRzvNWPhuzoP1J_N41KFJxcNcG-8-YE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvqqKS0DCj-4y8JsALvYXiMCR2SrtWtH2o1iLuFmdXAg&oe=6A899270"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLxhXcejc2cQ7kNvwHvfRhu&_nc_oc=Adocf8U2dVWtqYlzeN2odLf_C1hXa0Va3gVG3MZZoanhyWO1HAPppiRwI7I6ANGn8gI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkld5vOj4G6-knbxeD-rn7PCX8gh7M4AZN7boXpAcmhA&oe=6A8972C0"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcVHzfnJzcYQ7kNvwGQ1hl_&_nc_oc=Adq3VZvDKAQqIU6emdm_vucu3rqXWqUENdnbVpBORTc7mGq2WGzTYXOyONiPjCt_Zh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk6j7IfxsVa8zdvVsJAk4lKbZs92wPtCfkBFWnQWmj2g&oe=6A89968D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-G-SkPersEQ7kNvwF4qmjW&_nc_oc=AdrlHfb_uAGur98VEIAd_Q3B2aPGVpExoc0x9hUViK0psatiIdsYViVe2bLVb39zcHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPU1YQiv2k4zb0XuyZhtptmLjZ9d-eEtwmBiOmlv2B0A&oe=6A899FE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXqh8QlbbdkQ7kNvwGDrkWu&_nc_oc=AdpZRpK3ACt16pDNYKamdJBcusZo_t3EnZv1iryHjSQZsAvte_p4zUBPSnij-0YawRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDst3Ua4YWdESJ2xmoUuFarsKNHNNBSFG000-aGUojUA&oe=6A899572"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LREiew6Avc4Q7kNvwGaQN3R&_nc_oc=AdqQCsKLo1TtDWwREMxCJ5CY2cHPfTxIpbqWBlG9O7aSFSYrH4g0memwTa5vlVxRPiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGahQjajvj1DkmXZraHAqU98EhZnui44in7NyZJLZN8Qw&oe=6A898468"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
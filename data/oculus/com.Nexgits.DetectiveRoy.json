.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apuEzwPtiQgQ7kNvwEStC4C&_nc_oc=Adrxp3tENonMlXZ0g1VzUTin-R0vG-mFpiAsyOgAYspqV1R-r-r201M-nGn_96i8cKg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3ZT6NZDQjlq1_MiLKAMSJa2Q84Rz_KPbooSbQbBWMzA&oe=6A2FFCA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaGIu35FN6gQ7kNvwFEdgPv&_nc_oc=AdplAyy58qodDAsDzrc_k7b-haxsZu7Xej9TLDhR-3VUxxQVyWV1JRVtbQvvPuTbnUA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TU_efPAG36xXNXl_YR7WH0RPmLO4_a8GprAuTqz07bA&oe=6A3011F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE5hFaeXuZcQ7kNvwGhC5Ga&_nc_oc=AdouiS8dOKQj18UHZm0io-K03Y46P8DgyVNt1ZyaCzZ8gpVBQb7WPqWON71z90TUwVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qW7yaLT_2D3x1FH5BBcc73jNmwdhnIyV6M2S3h_EI5A&oe=6A3024B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2ANxC0JHaUQ7kNvwGT93ky&_nc_oc=AdpT7m_5eWHgVZHrtVt69W-6GlGQyRhweCbouc9kCbo1Cp9ksfOA7dOkiD3EhY_2pPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-035HyWk1nvNPQIM1sKzb_app3YJuyHURzqradcYOLdw&oe=6A300500"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVJvfmxrl6oQ7kNvwEoZp9j&_nc_oc=AdrK0Zk-FLczLONOE4_LN0IVAyYLAGRe6PgIKUgyz6WvVe8EJDzZh23y62XEhiTBsFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sFJTLV0BVWRifrK-W8Uk3jXT9tUIq34mH9RZZ-AsdHw&oe=6A3028CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7jjoglFpe8Q7kNvwHwap_r&_nc_oc=Adpl1MqTR95Gu04_sE2UqGM3PAcgvehLwTFHPrSJz9lwrCLqQCDPPvoXclLoUdCv5Bw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fY4ihAPZJ2Sp9kUXLVOGo7J5XJ2VC4jq4CznNmEKjOg&oe=6A2FF9E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osSS9XWKMBMQ7kNvwH9F8-4&_nc_oc=AdrkIePgBlPZaVUiy4iP97x20-VPVQ9d4-EGm7GIosaXKgEUOQSPUMQX0PwMHi81jaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zHoAPsYG0IIY58-1F3e03VmhnOrnOi0-lvz74gXwePw&oe=6A3027B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa9pUsoIOOMQ7kNvwGjCrN_&_nc_oc=Adrv1quQHLpAj6dHpX_MgFHoV6KMcCFWjEQIlNi3V25sgcu-GN3gbyi9wxOM9UweZI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rWXoCbWwCguS4l4SJg3_18__tEgOZKhzReVT4AVuHXg&oe=6A3016A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhMxAaHhmo0Q7kNvwEIM974&_nc_oc=AdqsUOKlRJnN887FS0SsKHFFYK7PEM41fQDDvcHL6dsTP7kNbzRUDQ5ncrWr0MKaQU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrazjhuELyaKppvBsipPYTuR1os17EuqT_mkNH2yyNHg&oe=6A5B7E22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZzVU1w9qsgQ7kNvwHcjdDj&_nc_oc=AdoCd09Yr5l4W_4O2G3ETkpYwM10V6RnsDBm7enzWjZWFA2EWy7ZOQQjmemLa68Iguk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDFDM3j_1GRWMpfmzRqUl8yXmTN-3acHBTpNzd0YJ6SA&oe=6A5B9378"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T762NrO0li4Q7kNvwFX3LTC&_nc_oc=AdpDAPuGtIPnFcajcdWtoDTBx4Y7DyZqiwjDkRFYywMY00Ko5pPtFND1pNPJzXeqbFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-64uYHSmgkJfgLjQuMGjz6gPJ09hN1IW3n_f2obNQvw&oe=6A5B6DF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRnQgKjpvBUQ7kNvwENFQnB&_nc_oc=Adp9CtTsE_B_Go5CIwqyZj8a0Tj46vifAf3rYfTaoaJKwcWs0_OsADPA5rkyFWdv24k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHh4ehc5xQolvkf2LA7r6mevxVhWNYOQYfUryDIdwrag&oe=6A5B8680"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdw_EgsY6TAQ7kNvwE1p0K1&_nc_oc=AdrvMXO4HBxlouaOzYIXjUYrreLZJBIk5uPtDmRqT_emk5GPRru6_KQj0Ak6K0shkWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfjLm-NknFpqh-sOokkgGNBSUF8fA8h19oLDVkoOePdA&oe=6A5B720D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahjJgMhmo1gQ7kNvwE7fFc0&_nc_oc=Adrpalu4o7yvrKDaWsoDtKdmv07frRocusbCLS4bHw7GrDJE4iE1NhCm5Dzr661lcX8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0lPPuouc-JUnS-ocAPI-54Ue9chshzZJERuB4nccnfw&oe=6A5B7B69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2rJqahGyzYQ7kNvwHur-th&_nc_oc=Adon5Ix8-zTw5o7P2WC02s7dewrej8jLVu43ZpUPjMM1hJfNsVpf_qe3Yu8Jdt1nXMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpdT2FrDp6GgW1YrLaNclBXJpdTkYiJ2HVf3OgL7i7Fw&oe=6A5B70F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAx4HjyLKMwQ7kNvwGqSMDD&_nc_oc=AdoZ1WLwGduTy5UzCFGawuthEIw8UkG2X0G3nwzebzqv9-g9NvU6834nC39LTAXi-0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDijxyiJSktbW0NTM17jd73ATSSwIWF0_VpbHZ-oVudwg&oe=6A5B5FE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
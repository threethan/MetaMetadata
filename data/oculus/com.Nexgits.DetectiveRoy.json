.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nfDzSoJpFYQ7kNvwGEnqhv&_nc_oc=AdrwEBYUKvXYl-Y9DSxzwvjdiVohCZcTwAttGsoTS5OSg1AHSjqTyct7cKideZAU4tM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8BMoz4mvkbwEnpBP7ZOXzSku3xbnS60W8rCvmFLJjXw&oe=6AEF5E62"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD21k4UpAewQ7kNvwF4wAby&_nc_oc=Adqg8NoK8DKosrOxmZpEVaR4bGxyW-cwtVYWEw2TSPopcdROVurMsk4Y5UrdyKWBB8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpqv9i85HbzqXjtC-_B7HRiZhFICdMMmc4hXnt_6L14w&oe=6AEF3B78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9RBMinjqeIQ7kNvwGCi5nB&_nc_oc=AdpGk4IRQix5IpWDyVFu_16Yo0IL7oVp6ahhirqf2dSIv3bomUlK7kHCHmRr7O6jqs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_0_NTilcus_iIWhyqNefCUSB6syYr7C1sFbRTANqI4A&oe=6AEF4E30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKO6YG9xIxgQ7kNvwGKxAJ4&_nc_oc=Adoyprc3Jamw58oa2n0fetHrdS_jz5D-jp88k1_X24LiqwMOJhJ68JG-m1J6SbExQf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlfamknSLZFzfPeWjB6WC3NXIrfKs-MtVP4qjbu6q8Bw&oe=6AEF66C0"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7-hCvxDQYMQ7kNvwG0_WEY&_nc_oc=Adpt-2ANoHpgzy4mc6706Ex2SOubUIuOEK3qiFMcfKF7W-aIsABF_i-4sR2OYV-Dd7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdHExwJmZxJM9O71myCmOcsLZ63ZHW3oDx6MKCJU21qg&oe=6AEF524D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8GL4hO5PXYQ7kNvwFuKOfP&_nc_oc=AdrTGybYh2SrUHmknHCCL4FViVxS1jis9EWhGbr45ltwHmMWs9oTZHWi7N_ov3eWoVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRH08HzhH7mQzEHwnI8dQZq__4P8YGx88mFe5NAqcHcA&oe=6AEF5BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVnZknaJ39cQ7kNvwF2Q0xE&_nc_oc=Adpnm-ejA6G79mAu8s5ztfxyIwBkPhGsjPifoZAKqijaMtWhfOS4XgHzCmPEpBp16oU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR38I28zxwU0yE-KLjFHaWwatyp21MBRQebQMeV0QDjlQ&oe=6AEF5132"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDDf9hgrwoMQ7kNvwHzXovd&_nc_oc=AdphvyQSbMsacJgaOdkjZSPMzwzMIom0RIpJ6PMxldxL64yZkZ1j4uJ75Io8VJ2tDEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzb_cDnvap_R47rZ8vtzTKvtm3ySSfu2Lr8dqiqpYQ8Q&oe=6AEF4028"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
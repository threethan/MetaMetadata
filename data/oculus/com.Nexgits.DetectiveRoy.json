.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dZiy9j8K3wQ7kNvwFo7WON&_nc_oc=AdppQ83hqwzyojsnPi7fbY3AtCaKQGOY1LFIXYjHtLie9PBKCEzhTTWVp6JUCJVpo88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgBsMV-fhWJSsS4BPtI8rY10qBg-2HP9h5H9E5eG7nKQ&oe=6A9EBAA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ84rw_h-2oQ7kNvwGkzq6M&_nc_oc=Adp-K0kLxjgco-MIVe0Xo5BSoPl_7OqmwYesu-ilzDuX-O0Z8T-OcTpeF-3geo0r5tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiYA4kwgzlt6eJe2nE9U5w93CNZvNXdfazxxcJmR9M9A&oe=6A9ECFF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPn0XA6kZxIQ7kNvwHCrhcA&_nc_oc=Adondsx9JsHNOJwk2JAn7rjySBVTY7vOJ_Fn6vqH4_lNolnkcT7m9RdtqhWxHuMgfzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2uwYYK7EncoCAa_H4lYyyqeb1fwVvcItV0oumtvcM9A&oe=6A9EE2B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f-EeF_tfrAQ7kNvwFH0_mG&_nc_oc=Adqyp3g5hKg91tLcPnDPPP4BB_V7TxTz8d13MEX4Ww4a5K-dD8g21y7XMp34r6Zh5Kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb8g8keyof5Mu9O3Mbnqnkez3UiMEv0dVnW01wJ3KnxQ&oe=6A9EC300"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5oyqsgxEj0Q7kNvwHzequG&_nc_oc=Adr1FIAFlFvcwAfpwNB_2q-yHiYPpdEQEbeONDTj_MGPEatUnsusU3UC0cL64ctN73E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ4-vXbYRGvBsQapFuFp90m94fl7oK-43kKw4F6z2ANA&oe=6A9EAE8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7IovEJeLrAQ7kNvwF-VCbS&_nc_oc=AdqkM7N6yD1Ybe19TP7Xusm8wU-4B44LEpRGXiG5Jh5vfCQ96Jl7FLE2IbUye1bTosA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgRudkbX_keRetkY1M0cz5Hp4g4-e6ulnspnr-GAfk-g&oe=6A9EB7E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WiZFkHOy-kQ7kNvwGoWQSP&_nc_oc=AdqMIvGQmDINeamlQvHQQwxwaqk3OgjaoiO6sJHMPpHbw8u-guZlM7qCKidn7iotSYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxwpN3Q9BBaanoHp0Db1nzQBqTnfkIrGxoECeQdk5UzA&oe=6A9EAD72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbNXN8UIBmAQ7kNvwERBAcp&_nc_oc=AdoMtR1RFccc1rAxUQ7u6UUy3hTiAK2xLebFMGnGX3SSL_qwdSSP7qliX7PaYFPE3kI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrA8x_eLyZHY-mhWpsOZa22Zfmiv9mLFcA3v_ee_lqUg&oe=6A9ED4A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
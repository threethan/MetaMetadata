.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol2Fa55btL4Q7kNvwE6cCmx&_nc_oc=Adp5PcqOJfEVV5Q9KRmwpMDh1mO_negsF62Mnx6c3Kvw8E5zz4FoVsAwkzcTXF5ehik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD1-Y9i0LMhxV0kflgAdqrzdoixcsjZOHDzgZHreQEew&oe=6ACD1762"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpXgibuDNfQQ7kNvwGyqbeB&_nc_oc=AdpwFUN3McAPKUKLC33yeu8kmSvsSxZPLXn2ARp46DmcE6C6fFVIfNwpEMxVSZ6geHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPItTvyfvWLLRPZmDWnkGsSt3jgy4kqW9EC0ymYteiQKw&oe=6ACCF478"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzDiGkPmlc4Q7kNvwFWgeLx&_nc_oc=Adq0-SsEQG3kphSBK8FAt4JVvIs1OBLC05fPWVaxh7Crn-eGQ6XY7Dun0fexycWt4m4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPHykZx8UPVAeEAj1Qh9YUeIat0GuU45pmvs6O2AkIcQ&oe=6ACD0730"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_anxB1iokCcQ7kNvwHgQtG1&_nc_oc=AdrT6BO8wx7KNUz-7Rzf9zjoFso4Uq37pzvB4AlJdjOPwyvcgKp8KPh0x8zOfTUFyVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF4TyddWQdCjeFB3UoBiIYYo2FRHRfpx4aJTSnQrBK6Q&oe=6ACCE780"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDXzMgKdxrcQ7kNvwFLfDia&_nc_oc=Adq3aASkU3AJJ9ADPmIEushVpGyGbGb0uHq2P4_mlGprpmbluk0AdL-np62Cv2VTJV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUSAMtIULwjplL-pPkPPTV_9rPscJ9nsi79VtruY2ikw&oe=6ACD0B4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9IQ0KfmvEcQ7kNvwE2qsG3&_nc_oc=AdqU4VzUqoxF3Qt9uBnGrmDkbTb5Mj5bvhYxmJXUPri-1Qm7sNmjUPEHcKsyl7HxixA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfLgsmFccJ9ZHXjHdG69hWW-fhF-fc6pSl3vDqv9eqiw&oe=6ACD14A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JYLyuRK4CoQ7kNvwEmW_uv&_nc_oc=AdqAIHAK5rJiJA3tWP2zoUJHt3PofXUSo0_Xbrse9lQSc2UH4xeVB54M71sgSgcnlnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6L7LsejlNkH2SC3KRvzeVgvmTb6V-una1alz52nj-Fw&oe=6ACD0A32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqKRs5Y9TAsQ7kNvwFbIG0v&_nc_oc=AdpmxoVIXFxD70PaLSyEhfU-zC-HudJFNkNwd2bVl7Itq4FcldOMB_EHj-AfstFPhjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB0S0GvxT0TB58w06WqtG1Dlq9HIouYJkWL3Jamhg_vA&oe=6ACCF928"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
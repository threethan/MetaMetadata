.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRyF63o37Y8Q7kNvwE5xzoI&_nc_oc=AdoLyW5A8woKz39QjaBcFNO-DAEgu1R5Ggs-oZMO2iIX4m0KnZZjKPqzB8FN0PZLO5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn9mbLxAUpp1tPyLiWEYm48RPxpiiVwGLPNHNtJoSSrQ&oe=6AB28122"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNiY43OAPbMQ7kNvwEMRTeQ&_nc_oc=AdryPveozD9OBXoUSc0wFMoBFveab8u-4axkqn0bWhBTn7lkeatEtr_1eDtwLnXp_aY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYrlnFH6uUzSKNHRV_KnGj03VBAYDL07JYi0xYKL-9zw&oe=6AB29678"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DOXaxx9t7IQ7kNvwEW9MnO&_nc_oc=AdoIRLrhj45FGgfTvEbb9Gel5KASm5LUpiLoDcctQQ7e59t2GQ8sYAORT1AWepeJ1uE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzYVhE0l6pTY5nowZU6cx4uVQN9aWHKVMXswQ__3pYew&oe=6AB270F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT1jXgPuFggQ7kNvwHy4apH&_nc_oc=Adq69MdgBm7a0EQe3WXE1XAELSHNJtXYCtPL4dYuWHIbwzhz8kb_8TbH0DKTKDF-EXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzTfTdAX_udA4nvQ9og64beUfLQ8Pi0G7a6u2PPJ7r8A&oe=6AB28980"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKDADyMHvJAQ7kNvwF_5JBx&_nc_oc=Adr9fpAzG-DaAwGs6THzbsoFAA-3ZSn0BD6hN0bZS8B0JA3fSyqD0K53RrO1XKtqwb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtgfzqfR39yZdulES4bHcefULPxd7kIM34uQ7mdZHx2Q&oe=6AB2750D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUSOIS4reRMQ7kNvwG5qPzt&_nc_oc=Ado34rpDJyPVUaiuM2-fmbhQ0BCwLH_oD6XCbdtQ2WkUchOLyk_R1A0B5ciKMOKJH-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMR8wCDpb3h6otFYSIpGY4RUWi33bHgU81EdullYMmwg&oe=6AB27E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY6ZaXv4DfcQ7kNvwHQOA2G&_nc_oc=AdoQPpnvcRMdkMy655boANdPAgwBcLHP7mqUlnd9hfLhs3eGUHyl9LoLu10gGHA6tuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAPCJvRI_FT2aZN0h-76mAsgl_DrqcvlYeBdC4slYUXg&oe=6AB273F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UE9LqxmR08Q7kNvwGeJ19O&_nc_oc=Ado28naHSmw-syc2g6yiEm9qmgdJPAmJCaGjuxkTF81LkMXY45NivEAj5Dh6o0KUzGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxl13TQhkLZYd-GF2cBs9dKwNG5kHgHGHpfFXJR6el5A&oe=6AB29B28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
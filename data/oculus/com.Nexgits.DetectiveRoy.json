.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLBDtgAemGoQ7kNvwEFeDHn&_nc_oc=AdocO8KD5lCAz_jFglk6qq2fD4MUNJwwemBvrRGdHDZ_M2Oj5n9kxbuMrZfOXbouAS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52dPo8kx8BeVqIAtMBuqnAt6RwzEyzXEDnJ3jsutZ2pA&oe=6A202AA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDsHj3A1AO0Q7kNvwFg4Ma-&_nc_oc=AdqBWHAtrjAKaL9Pmkd6UnxGfVY1E5LH5TRlkrKHsxNaB8nY-PEiLdmTDGkoU1xfSE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rDHf3XA6IW6NlVdRvbLs2nUOaMjvDP6cNNnIS9fJasA&oe=6A203FF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9RXUG-lNKYQ7kNvwEPvGAT&_nc_oc=AdqKu3Pj0GM9IiqLAdJ00RH6kexAQG-5cBrIsmI5cvK8DkRo39pUBI0wZgwTdBbA23Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IJmwezEpecQYlen0QDfLfcHdmxeJaHXV8dpEcsWcYYA&oe=6A201A70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSxA7R-xxkwQ7kNvwECHb6b&_nc_oc=AdoukJJwp6TMI6ng7fPrep1mXD5rOozYq1sPu7HZG8p_3Ih_iz4xeE6DtRCJgAnuuAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VfOpYdvogZjVKEtIqZr1p_im3LKFI0bxQVxPAS9xvfg&oe=6A203300"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMXgBfKbeWYQ7kNvwHE6PAI&_nc_oc=AdovHPeLnZdO8KE55Vp1kWEhajRXu3JttyPaD9xKoCzI3JYvFQ33gSFT7UpqUHtUTWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y9Qr07EH14a9PSxBkGMNuMcW3BCPUpyoPtuQMx_cOAA&oe=6A201E8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNtlrOAfBE4Q7kNvwHi0ZeD&_nc_oc=AdpUx7AeRW_tSmq0ltfq83561nElgf9qiVWqhePi3MbXzvdXPT9GOixGDRLZpmQc7Zc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SJFSnO6eEtn1Os14AIwCYY8ZNiV0g78ibAU_gIHeX1w&oe=6A2027E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeGFVWVkawkQ7kNvwGoN96e&_nc_oc=AdqZZeQyyzVRR3Wf8NwL0E1M05DIwIYYX0tmH_inCso9dYZAUZCRycLqXnRmv5gtp-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E6ykMCY9SbTLqhRgZJoCPdFRUCD56HbJ2i-zoz3Mp4A&oe=6A201D72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QyajgEGJCkQ7kNvwE6N86e&_nc_oc=AdrBfdA5wD_qOhqEjR7rMZ6I4KDrtqpJeZJ6aGsjlzdL5K0fcH6CQj1l3HVsAqs84Ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_uLCMw64c9BCrmltwDog2797oY9XjHoRO5diig2lC9Q&oe=6A2044A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrO7pBa7LtIQ7kNvwEQMY2S&_nc_oc=AdqR-u7IV2InyyRi9ve1NJ06-sp5YOr26TeiDs2FcI4FFizqjoIhcx1yXTmG52Tg0ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xs_j67L79LlW6xzdvUJfr9RonI8DPPoi89YcqYxuMzQ&oe=69EA1D22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-0NqeA-CN4Q7kNvwG-nCxq&_nc_oc=AdrpB6C3jC4bZJdy5hVSKVrq3A6hScg83N67mW-Xzu55sYIsBPN6yoTkSQjTgO06J2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19AVUKB4opyaeEhfCMGlawJDPthE260Kj4RjovX2zIbw&oe=69EA3278"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIWlFBF00RwQ7kNvwHJh0Kn&_nc_oc=AdqW3rg9kp7vgNUDi6NKfA3KZSHtriJGDO_uiuQF4AVPPYcX8XHGskZUbTHPwbGzdLM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RQJJMUf9JmRESIs9z1KzqNgluJ6IfUbkTOn4AOjZnKw&oe=69EA0CF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWo41FKoaS8Q7kNvwF8HLhG&_nc_oc=Adp-85hWcUygnrLRMiB3ADa90DN9UHHrkzU4wQxIFNbrAULsUXZKyHaCelmCeJNFs_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38C5varO5P6UP9QtetK4gPdbOo1ZYY-8GLrBdOqRQ3pQ&oe=69EA2580"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc6mfgqmT7UQ7kNvwGlNpaF&_nc_oc=AdqVgGKjT1_I5VxjuWHSgQBMEuVB2Vw6A-s5lawZdagzGOj27vvsO_wjHMwQ88NKQD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T7tQrc3HVS7kd6j3Z56L4c4z7gfaGXVwdurO4a1oINA&oe=69EA110D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oATbzNW7nZIQ7kNvwGaPlX7&_nc_oc=AdqnMVRtUFVu0oJyX7Bl3DWJC34c_Y6pM_VrRARh9vMlv7w15SWYbgmydObMbF1epjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UMRhT1m5nYAmGydaAwf9XvokvLuyOjCxfj71_NfT5qA&oe=69EA1A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG7LArKEx34Q7kNvwGD-FtR&_nc_oc=AdqZ31WFoX9SMUhWKoK5ucCFD2PpFAdqO3wGXNHHpMzKi7Zer6UeBRBKTwN1oa6jkDk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xfqk-HBhep2Lnh1ZfPJWgrHCU8VpzZHTLslzZHK4Duw&oe=69EA0FF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHNrWqElUycQ7kNvwEF26Ft&_nc_oc=AdrSIIj08w8XOY3hkNo29Zh7WA_ACxsX1w23LPYqS5pfmFb14kdB3oAI9X6Ve1I9toM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pomEEXMXSCkk35-o4Xx_jRvde_0yRLuo2V6qrXqFwrw&oe=69EA3728"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
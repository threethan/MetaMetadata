.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOaxE2kkdPAQ7kNvwEAmHXQ&_nc_oc=AdoVB3FlhJGIadMJMT8Uv4TmjisbeXkeutT1kFerWmcg7xFESEzpBQnAu4rbf9Q5i0U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pm_0EzK7OFqYA8W5LyI91twOO_wl1iCwalDxoU4iSCg&oe=69F9EF22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw9rQDU1C2YQ7kNvwFWlouJ&_nc_oc=AdoL7S_VDWnfOa1KE72ORGf3sAY0QgCxO20N3qmYUpSc5vsihtOOBvEf6sk9tEVZrvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ipzPughkpMm-mpJZIzkpA5Dcv7WxsKR_wyNbD8grFLA&oe=69FA0478"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okMrAjb3-i8Q7kNvwHYUXqA&_nc_oc=AdqrXgHkp_7aldRAUgXuFQuttRChTUU4lkENRL-4fG-cp1mr4dmoTGJ1G-3Yt35cY4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zcNX3w18k4OwpVXttgCas9SXgOqWFopszLKHRMaKcXw&oe=69F9DEF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe2JoUU8tbcQ7kNvwHrx2SB&_nc_oc=Adq28Yexab_CFxEyIBxRwQCP-2I4gOrtilIW-KcF6as-ah3KX1X1kmfBocKMwz9bqbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jlh5EgeCcM8boE3E4EI0wYIfQpfZEon2UO_RZL1aBnQ&oe=69F9F780"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsHL7RuMj5IQ7kNvwEJElmQ&_nc_oc=AdrtcAZwkEAFK2pnmK8MdPdILhCxckmyk7atUP3Dvbe0hUAmXF7l8egonz04Jlmg63w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60LT7yHpFVgIdLhwYYodXf6vT0riMiyW4yhsUVUX4V4A&oe=69F9E30D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNtaUciCFXgQ7kNvwGjfLj0&_nc_oc=Adq2WdZDHj2tZ2fuNlisaVZ091TLs-yzDkRB7EyblLU3OAnrN4wcyqp1lXwZV3aAWgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zB-6_OioPRBJ_bEHTZEyGtWd0OuEDzAEvYLTHbg914Q&oe=69F9EC69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID1crrvseCwQ7kNvwGbwhvY&_nc_oc=Adr3Vajowkh0OHsjhYrC_g_ACx0wlJRACMI4rh5Hwf-Vn6YZw_wTP1XYmLbGuMaLp54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-Aj53GpLClBfI1aXovQWdoAJKPKoqnTSfTss6UcHtKg&oe=69F9E1F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np7aztPmds4Q7kNvwHCzClm&_nc_oc=AdrM4CtkHym9-DT-UWjNVwa8EmiIkPSEm6dQUuInVhCtjDoMlTRn_IptkDB_I4mTD80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pDvnpECwcRAQTfKh-ln0gSYugls5EFwOp1DZJsrE-9g&oe=69FA0928"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
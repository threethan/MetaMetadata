.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WU-AUp0wYQQ7kNvwEGiFJf&_nc_oc=AdqXxxug8SzcMxYmRgromPPtdbievKUiH0SJ2ETLHUSawrB1yBw9wRDgeujXCXO1sg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vyhr_6ggDsrJuv_oSlAHk21oeIWEbyL_Sb_uMk3bZbg&oe=6A3D2BA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3F_A4SctD8Q7kNvwH3kXYO&_nc_oc=AdrA4Hm8kwhWRgj-cps3D2Wwvi_sRBje42mhuV4B_RMTBwLHO9DYB-nXRJmZ3MgKDC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9njYl2kgg5pzSNxkCmwoLdWA839RQWlzS19Lm7hXr3MA&oe=6A3D40F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pffbk2ZeuD4Q7kNvwFnPHnG&_nc_oc=AdrGuuEu666UQnL1J0KMgEadaO57ZTBj6dnWGM8KeHkgL77jEnJ2_Sl0LOz-gADs9vc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AhvUQ8dX_qaViVi85EtIIm9ri0n_dbtP_jzl-dfNTXQ&oe=6A3D53B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlXITfiG2q0Q7kNvwHdAah_&_nc_oc=AdoocG93sn43HxcAxMW8mMGxfX10xjtT3-m6utvsPQ2T73eG6vDBmR-5z5Q82O3qrS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Jhr3BAVQwZ6WYKjfboo9YXGOqNVL9EEhE6FuIKnyiAw&oe=6A3D3400"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmQ5kPh_sfIQ7kNvwEUt2b0&_nc_oc=Adq4F5MY8C-3wzsDk_hmrqnjXnFVk85mmAI6XkVVQ_BqamPxnmaRPs5wvWCfPHHIi7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LVIcgF3vVZZjJCLv7h67UreSF0I6cRLF5vovBFticxA&oe=6A3D57CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6MwpIcZNOsQ7kNvwG05flO&_nc_oc=Adpx7lp5Erdu_yHD38AuFTnUK2nw2G805Nia1yOBg07UEUMwg82GSRoB2ztEJQLYCeY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Wj-LoK3uJi4A5GTzwmorIyQM6BoYSHFgmSZNUzJZrg&oe=6A3D28E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d0Sv4ATaMcQ7kNvwEXjBku&_nc_oc=AdruJ4VnqFJgxp0LFiS9CC7f6whqPIP6kZLVCb30nF64yqXye62N3BSTbNV7Vn0ccNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QlRh6itQ73gO4bzUoLpOGQZLLM_jbs-Pzfe60f0X3cg&oe=6A3D56B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6qLdFDT3AQ7kNvwGZaTzx&_nc_oc=Adp4pejGY30cDH_bQD-9QOkANJgZLvMHiDt3s0MREX72R5APZ-LdnlMWcxUwBhN0lNc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PQgIjmDjSFN4dV6lCIsidZs9O8oa7f0pue3nXt10TpQ&oe=6A3D45A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
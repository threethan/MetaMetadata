.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjYQZU1e2aQQ7kNvwHBO9B8&_nc_oc=AdrLTbg1yj9p9xXaZwyUsf29GPjA_XGg9xPo8Lbh5jN_EpEGAHoPra2JXt17L86P9Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB65EoS-siqx13f6GN6vBXFteNIcDQhPmMfz9kA9Ze4HA&oe=6A5789A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0fTSCPydNUQ7kNvwHNeGhC&_nc_oc=AdoYkp5HDHH4psf6-BQ0nnj4PPXkM8Qs7Fgqh0O8wSbZcw6biRC54mfvkpoTAuxrR0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByoRnhmeS30dh29lkCFV-LcAfqMPwLojcSd1tGYvubYA&oe=6A579EF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLB23ZpPlCEQ7kNvwH0t9Yb&_nc_oc=AdrOhbWZcfH4BwmIH5O-6D91Fxm30TKTyrwvrXK4xpog0k0q8L1X7K3hmVZQxJIHFIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_DYswrFlWBiaNG1UKeOMss5WIWmByXe1PpkLniLr_cQ&oe=6A577970"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrQY368jU_kQ7kNvwE8IEGa&_nc_oc=Ado440unohayATVc0WzqjbQzZNojdiEYMLwFI45DJKBpDimAtYPMbO0H6OLqbcUnRnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvofEBDQf6zOUrLApQgjTj1UDpGE9at98TUeijO8ZrVg&oe=6A579200"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MsC-UFSRxEQ7kNvwFfrIsp&_nc_oc=Adp_rEcX-s_EOZ_6ZNp4EH5RF1S-m7EskxfJ4ZGYFWsO-21Wu2npYy5r9_xQFlXrKqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA4LmZ17W3kqCyG2ZHs0MJ6WOUjOpWQlJS4Nl0fjYIeg&oe=6A577D8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbpF-IN3BdsQ7kNvwGPFCzF&_nc_oc=AdpOkx9W47GB6cruhq8IbaGpPha9kk0ZjpCajoECzkLp-BXGpF-QdvNizWD1j3e5j1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOfyoJshmlISpfyYr3SYH8h1dInUgThVe4j9Bp-ZAtpg&oe=6A5786E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCm-lRuhF-UQ7kNvwEXyvzF&_nc_oc=Adp0dzmFLcD1KwZrO56AOoVICBOmTgVy7AADb7Qy_BOEmJNZQo7yKVHrUrRSlLhGD4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD34K0K1HVZrwBTkn0-ZZMecFUiaIsfiZoO1IulFa5Pjg&oe=6A577C72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGwgWIYfjaUQ7kNvwFq2cMP&_nc_oc=AdqbMs7yjXYPsYSkqx29f0Bg6iI-Ubq9oCWHFDZnmAZ1e3W9ErRl1mdhIOOga8HWJFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmTSPnB8tJYEtmoavErtq3nLRwyrNuCLmwLDPlcjnBTQ&oe=6A576B68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
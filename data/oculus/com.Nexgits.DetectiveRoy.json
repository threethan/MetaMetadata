.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eFMZR1uZ_kQ7kNvwE7nIWO&_nc_oc=AdoNQ_tq_fX6aKSdMQFdLFu5G7C4SmLUdlfqVtow-Mta0mYB5LIyWRydFp4cG-bZVQw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN4vh1WEpR79vHyQj8PIYCbwxfe2z7yEJd3UxszTG2oQ&oe=6A942EA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwuRFez82SgQ7kNvwEy2FFh&_nc_oc=AdoDV8xJbOf3a7ZziOhWY1TZ9DCsQNgZ3QA-WBNCREu-BTtWmYliAf0th-Y2En28l3M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEthvi1cVBnqOeJN1s3wszvrAvoaiqxS0H9kU-Hfa78_g&oe=6A940BB8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JF5pPvu8F4Q7kNvwGwJ9i3&_nc_oc=AdoKFW-0EU9rM5AtV8-T2tJaTjy6kQb_GkI8BzMyjfsBEqcbt0TgtATxMaSXw2uM1DA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQKmFuOTNq26veEML5JFwLIoaRMzVFNz4_5Oy4a-4hlQ&oe=6A941E70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiJehTyu5ckQ7kNvwEX0IIS&_nc_oc=AdpbTPy5X6TwdN1__pp-L8kmBttPLu66NUNCeAzQnT0WrK1PscfIVvjDplJNUewKDzA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIEYiBqDSqOV7dQG2CSpMJQfQMavqN2S1FjEQM-TzpZA&oe=6A93FEC0"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muvT6wpK-lUQ7kNvwFUMQKl&_nc_oc=AdppVe-1NYlmygbJVKTkcy9mHNnSGSbVJF-PNGYzfTXwRik_NeArYD7BmHUsnipYxnc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk7aWy8dodNntD4uO44zgui-cKoaqNNmgSN69M2IgE9w&oe=6A94228D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS4VuAyrlmEQ7kNvwEz7mdg&_nc_oc=AdobMFqnCpWObj0zz4rF0kjmeKZbSW8Gxcbaa_WNpu-2S6LN8hvE1tpV107CF8lejBo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiQXxQ0ndRIhaN39YmJSZcN18Ow7BasPDDtVhNsj6Ycw&oe=6A942BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG0BdxtR0NgQ7kNvwFae6Vl&_nc_oc=AdpfyAWZ_9BT3jC3bpaMj5FKOPxHQLFE0GQ6UGgaBFe3YvX6xljjIiq2whbBAU0V_pk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtZdSH3ROgN5d-QbO4itEqujC1kTC521rMB56TWcjclA&oe=6A942172"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHFyxji_EhEQ7kNvwEnGMBL&_nc_oc=AdrwCRs79AVJPDLuwLj-UZTKnaXBy-JeEi4AgdBx4hV9_ze-LQvX95Z5PloAjZem7sA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBCVErpLgJMzh-u7W1iX6JO1rgBxvWawejB1xlmHIuww&oe=6A941068"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5PIJDQjJjYQ7kNvwG0ve3B&_nc_oc=Adp6sJb9dYEF8mBJORhlcAFt_qaPY6B9jNPBTM1AghuTP-mgRUYY9jnhQGrtA57pwtk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-69g7GdVG4ws17RcnDFVwvi40NMmW6AchSw-3ue_hIag&oe=6A26C222"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evYD-W_fOlYQ7kNvwE_TTHF&_nc_oc=AdqcAtUaWWZHpLIO7-efU3k65yZQIA8UEkv3AlGVvPDnxmLHSXNZjM-JKRD-gNCYAPI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WDL2iyS4ihFwgtBOEVvU7-Uv0Do1Ze9uMTuc4nRjpCA&oe=6A26D778"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpiUhjtXeQMQ7kNvwEvb8LB&_nc_oc=AdpTlsaLaUpwdo1A5I_aRWCkNUctNa4eZxmyNsu4RHYqgJGrSZgEX4N-XNxddi2CDV0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9ZRLrZTC29PYZXn2KDNUdQwQSLNdohLCaoyFzfwZ9Vw&oe=6A26EA30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JocouQbfEmIQ7kNvwHW7Iv6&_nc_oc=Ado5YXVvbMH7gTPTgNWOUeWTqgMUmD2226LH5Mbjiy84XfRYNB7A8iqcFGwn86QrJN0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eAk3l5GlUULkchDN0TZV7aDhEJXTpfL_4NxaAQ1-bJw&oe=6A26CA80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGFwrjuoQqkQ7kNvwFENM9V&_nc_oc=AdpqgqHqYKqRjm8H3NDuM0PtJz7cHGo2iLOf3MxRryuyO8sEv9cL8cwSQiyHf5A3dCc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af916Ng0UR9aIdHMVOrcqV-ZiSAog61tE6rcFxYqos7ZhA&oe=6A26EE4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eYAaA1IEZoQ7kNvwF8-Y_s&_nc_oc=AdrGA3EZB1FhXup4gKLHR04SWRFF5l457r8_2s90a9AeaZ6xUPZw_XxXPA8mX9WYao8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90RPC-YGl99wxWH6NRjzAscXHqSSe0ahnC6-lqmgVzlw&oe=6A26BF69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKj6cOXtkosQ7kNvwEyzrZJ&_nc_oc=AdqIYhGXxi8q1Be5tdA17pRd93bWtQO-gs7qHgtKo7B1WpPUguped7GhY0-qydFpbIg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZZ3jdlM_NhpQXnZkJTyOWk3sw2f5l8HCIxqRtl1veFQ&oe=6A26ED32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEIQsIgbVuIQ7kNvwFze4XK&_nc_oc=AdrK3EOTgKLaBh82o4PGAGuL-li_zgs2a3EbpW8I0YADUFrFh6kTBYKDJKtStBQ_-xg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kbMp3jr8RbFq0DCRyreAdgKNTe4INRYxTU75RH1X2Jg&oe=6A26DC28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb7-jw1ipfgQ7kNvwEyjMgY&_nc_oc=AdplvApNesxolDkemlETeKIdWMjkBt9MqqeKbNd0r4pXHyzLnfb6OjRrRKO6V2-YixI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-WNQd9eZq7mCVS32VtR-G4QuzJAF7nPa9awyB37RpYQ&oe=6A81B9A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFmWr5Eu5fMQ7kNvwEl69f-&_nc_oc=Adp1i9Squ0dHylGy2hxXzoQKl8lK6eoLkcqm_q0nGJtyavTTc9YTJJ6KOr296yelaTw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE22-Yd7Td5d67BuYATz8q6KNDXqMABA5XO9x42se7hQA&oe=6A8196B8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riBnlJ4QbwwQ7kNvwE2o2ya&_nc_oc=AdrBNFmjNeB6Fx0LkpXFzcgTh5iu2usPbEmjHKe9upqs8USJXaDIELS4m3IBU9sykek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu0Kcpi5dfh3Equjj1k7RKm2PVg7gpLEoqqpR4bfwNsg&oe=6A81A970"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CtFwugrHMAQ7kNvwEL7JTg&_nc_oc=Adpv6tHDioPb6K2a4J62jjwWpzmMixvY3s_NH63KaAEGDP9q7_leoaOge2FcuRYKV4I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmU5WdIKxHRsucexy7qTg9bFXPWN0xmy4INIpkWgWMKw&oe=6A81C200"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFoCigRXuVUQ7kNvwHYeKKP&_nc_oc=AdoY3WUoJcdVm230QjFum15CBHfgL0aNVkL44DxUFN1uU3kiYBhefq24ThU8FqIzAWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFa9Rm3Q8bqVom2Jf6gcCeMfUO7vIni5s2lHCIVMsOdw&oe=6A81AD8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS2eZf0SB-YQ7kNvwFy9xw7&_nc_oc=Adrp_QKXN8xWjNzW2LwMVerGENfr2Z135S5qJc-r333ofyX-MRZ33ju605PGTPvXZHk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtCMZPuhv66sAH2S4kgLoIQEShEbvyQiJ_v05qs5HQMA&oe=6A81B6E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx3TL6m-VFAQ7kNvwED_R8v&_nc_oc=Adq-CbW86loVM_ABrNcKSq8uXml1x_OuZvu2WMRvzxxnyZZOEtr2-CVzcjN9s5c_l6Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbwYUvlnsJXL66-GrJ832f_JaqAeQq-lYIh9mxFI2YUw&oe=6A81AC72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWqYErQalMcQ7kNvwG2TA_k&_nc_oc=AdqTGOeg6PoaeJ2G68evlnXyhtekn7Nr8PivsqNm_h9LPagCFxdniMeMBjEGIRmgnQQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1ptKVFUr6wAqb8GioXsVpWseAGGNIwtgZOqIfSWR93Q&oe=6A819B68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
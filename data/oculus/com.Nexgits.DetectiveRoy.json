.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fusHNNFGcukQ7kNvwFgFMVU&_nc_oc=AdprFc1U-iXFSPk_JTShvLecDOly1zuraq5JYrMWkZN5AdJKZ5Smm8TyakJedM-KuaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AMgzE315Wf7HbtIzSXCMGeRnVEc4BPiiqH4egqWmbmA&oe=6A2D59A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaGIu35FN6gQ7kNvwH2BCoU&_nc_oc=AdqXXdQeIJHiYJs_RRgkgD40RYGJF7ZIwZqW6TypHTXkViT7uhCs2UU9yOSIOA2WLxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4SPME1-RIQ4jINsuquvr3TzsbkE_yuxk5CMVgt3VXIg&oe=6A2D6EF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3V2FseP5PQQ7kNvwEMdKSR&_nc_oc=AdpZjWKt-2GtY_LsXpRF7iaouW2dbU7Gn5hgtfdpKaPU9LT1KXeS20VqjroHweixihw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WeRjdjwVCb5Yu3RFGQgFCqkDtB-edJEXKAE9vLTETRQ&oe=6A2D4970"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo7TD7mrajIQ7kNvwG8MKbI&_nc_oc=Adr8wLCPhrxMKnqTS_E-BS7gpvnXSR6QzlqsmRYnsj0_xmcdbdPNdQ4hcmj3Q9re82M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZTLunVHH0ia1J_V07ERdQQSIEWsRJUO73Akah9MH3mA&oe=6A2D6200"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fMDnwfeUSgQ7kNvwH4O5a_&_nc_oc=AdoNO-UPzN_7daUFvReUyBZTpxgiLw74nnNhO4EP85fE4EJRRyfOZQiITJg6V0HvV_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99X5Ch5zniGf7CT0Dbnr8MOmaiNy66VkS3UN_U_5Nt5Q&oe=6A2D4D8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcmXD6ojLdkQ7kNvwHwiNwR&_nc_oc=AdocO5qQim-A_z-vRBVrmDDfyoy14nfA_Apk672F2VbyG2fuSku-kEKz_TMBNWUhS4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uGSFZIbjUtry5ekbZOpWpR18VsAWts_X0g1r-KtXVqQ&oe=6A2D56E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x37Eu5_k2s8Q7kNvwEYOhh8&_nc_oc=Adq-YoK123XIEdbtSmt7WuYHPvtxlmYCbT7OmbQKzmKWzQFNWGHRpYUlMhjZgE-rJPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9wO5VUnT5t1Jcf8GRtk3TJ5RU1wKQgYmm1XpoT4Z5iQ&oe=6A2D4C72"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZHh_XHmI1EQ7kNvwGbEGIj&_nc_oc=AdoWhvjmvWzao7WzL13CcS05PuHCEm_QdqwYOIFS5bXhhVPAYScZTfGmNj6wHce7n1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fgrP1FzrAEne30I4a2X1fDlNnpD4p63Rb45llZS5gIg&oe=6A2D73A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
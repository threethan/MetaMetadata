.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apuEzwPtiQgQ7kNvwGIeT3w&_nc_oc=AdpkfOxSE1FrmuVEMT02uFrqVSHpok-bQlU6__0oiDX2qkGTWyIFQJyGxwrcamPP090&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yRDWnPXW-9eHq2W6QqXBpC-YJtLOPvXrzcVcJ0nr3WQ&oe=6A329FA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JFzL0HWlaMQ7kNvwGJ5WU1&_nc_oc=AdqOoFBgg-9KHG7cRc7nE7IttstMOQcCl_M8dNRs3I9y-zIr9nt3y2BFLP9dAwqY0Wo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fWHxaWwP2Q7RaF6g5oNyOIE3XTd6ORfz_EyP-ih2nbA&oe=6A32B4F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HP0TWcrjQ3oQ7kNvwGdfYEz&_nc_oc=AdoUCx0tCEN_PHUEsUDrvKiX3Ln97fcH6fwY9BcCW71eLFcSCOn7teUAVluNtLAb4ok&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E3XiJrewxc56dn2ElcIZo-ONXScAudxBQI9NE3q53zQ&oe=6A32C7B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2ANxC0JHaUQ7kNvwG3Tchp&_nc_oc=AdoUoyJGnufrO-NijsPoWgB22ax9XdmYOSOmGkKlFaF02Mw-LFP-bPFt_45JJwNlMWw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PpMXPk0y98-ChJMij1FtURQ9f8qPb6PwcqfpJkmieHg&oe=6A32A800"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn82yEyBEQsQ7kNvwFAVSRu&_nc_oc=AdrQn2dBHxm2CX8GnLPGD6SV6BxKDIbvSfKUABfKOqtwVrVfiHEKfPzQUpX-G3KXA24&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c7jO0mbVM890whMTFDb5IrAloZeYmt5_XfgHimKWhNg&oe=6A32938D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz4_2VFX7v8Q7kNvwEL8HsG&_nc_oc=AdqHulMs5d_8hUKMlx3x5RPHTuKfFO66tSl5IzrDpg4Avbijn2Oi5uzwMwd3yCw8BDw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v4BJ6fpZPTkt5kFJHIXN3Xp_dXy9YQ5OFy2j34d7ccg&oe=6A329CE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osSS9XWKMBMQ7kNvwEgFF_F&_nc_oc=Adp1_r8wRdNZHYsYk6ejJjDdmbUqQL82NCl9yksmbYF6PcYK96tgAwhB2XwZxTidf2Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MXThJLP-St8MtoZnavK151x6J_UR3dxvOL0vaDYTQ4w&oe=6A329272"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cj29m-hmDIQ7kNvwHKOJZj&_nc_oc=AdqSe-Chq8rocXUj9eAaPFq7RtLGhPXINPgF0BzLDyyd3TWl2TJki-lTwm5y9IWpz_0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FSl2l-oYCD7G-IWMvxcMCiSowa7LPcEd41Ezkfqd7Qg&oe=6A32B9A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
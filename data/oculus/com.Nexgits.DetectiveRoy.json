.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL0306xkae4Q7kNvwHdYygd&_nc_oc=AdrcFqODyJ_V-PmJPtD_7IRtjwOWqcd-zf88RYfuKJs8WjQeWCAwu7ATYQyeldYCQxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a5e8LhM7biS7O4FC2BVf_qzDPMENxNLowNN4oc2y16w&oe=6A47B7A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK6qi2OYRZ0Q7kNvwFIOEgW&_nc_oc=AdrXmHIEPt0SeBF08FD8kSRrtnsFXYh-vnW4oKr2joKu_82K8fFZPf3pOY1h6SSy6Ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FR3VZMGnhfUiblPppO8QrKYCW1QZrsp8SbgneMs6sxQ&oe=6A47CCF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzsfvnY6JF0Q7kNvwHycqTi&_nc_oc=AdpHXoPQUoMa_YpFkS0UwX0YwABBxS9NVXzEpcQFYH95l3x1IPVat3veYr9LNHJL9oA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2hsoPGJVHKwRnD68r7tgD5hh9a7epMTUtFZn-aMLtFw&oe=6A47DFB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_I1RaK9ftsQ7kNvwGBVlyD&_nc_oc=AdoytP2F3ha30nc0M0c1SzUhxW3hBrCT8dN9nmZo0EZLEhSW6hc0sZJRsCD5D5S3_O0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BPzHxIj1sAVns3C8TL_hZZXFalNIuVcDojCttD2LQeA&oe=6A47C000"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHoUELTw5tUQ7kNvwG_YSK_&_nc_oc=AdqTdTPKbqawNjK9jaJKmHzRwrcIuRUL3Of7nIWc60-2kjmr8kqw5kT5mX74JU3DWkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8-G9mjUN2WIXsc-FsfKVb-2sWzGTVPskj2OYZgx34lA&oe=6A47E3CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8ONLvBTh3UQ7kNvwEdhqyC&_nc_oc=Adowy0iRn_Dz2OGp5-U8WK1F-vpA0ehdjmCD6n8J0waib944r6esJbkaHNDx1PYdLDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GhkCtbYQGkOvFvmsjgXywYs2F0mXnkq8J4Mj6dU2LEA&oe=6A47B4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCYAy3bVkwYQ7kNvwGxh6dd&_nc_oc=AdqDX3YPLvTGPa8x9Wiwkz0EF4VGwVo5dYHelK0DR0o4poEmMpHI5m-GTUgpYM1Roeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YF46C1shzQxadpJ9ESkKZSqclg-NIJPgAXeL0a3SiuA&oe=6A47E2B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE_6vViCuMUQ7kNvwF9pfFP&_nc_oc=Adqr7IxYpZa0ECnktOASxDlgtGGTR4-sp5n4KdIDiTZTp9Nm67Dv7uNm7k2MSFyDjBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sGInXVtTngWnrAvBplpHPjwntCUBfxRDQlHWPGK9apw&oe=6A47D1A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
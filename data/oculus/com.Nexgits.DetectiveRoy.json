.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p4xoRGlLK8Q7kNvwGHbmCe&_nc_oc=AdqZBxLqYLjIbY6iUxAKKD3hP58QEvElqAPXGss5A_e6AKkyMoqZVbzzBmVcrkUnlgI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xp5sQTefSf3mhZ8gRvwKC1xPPXYimhLMcb6kjwDwLag&oe=6A159EA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWymX_lV71sQ7kNvwH6XWuP&_nc_oc=Adr38bmeTjrgr6XGVr0qCYdVJGw0amiTrhAVYKIpwm7qQAV6qtcDUc-FsfKq6BLu2IE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45qgg-UmT-BkIsnGVWyUhlvC3wjiTQiUNEZWhPJmDMWQ&oe=6A15B3F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5DqzhELN_0Q7kNvwGOKGDX&_nc_oc=Adpq4Yqs7BqnXskvQxcd53lrE2LWDdKwMpkRlEzsydLPO44749ovOFI6eOaxBCgIs80&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h5IwcXHlTRn1dj1WIMRKvH_z5ajMwhCCnJs7FWoWztw&oe=6A15C6B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4INQqZ_1wksQ7kNvwHJ_s7u&_nc_oc=Adp9Sp74uukc7mU51Zpor-4-ansjna_xIm05IF-pX1QVKfptL-n8whySU5wB33HS_ZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m6GYwiHtxkbeFAvjSYKPrqmZoRbNCuN6IEojGVD_TzA&oe=6A15A700"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPoW8gL3xvYQ7kNvwFWmwuc&_nc_oc=AdqZe_witHsap4TSh_9G25ubmzfN10xfhhYDrVp2ANzT_ek9IJRcLELpqclWIH8b3aQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZggRZrYZsu4GCQSpMrQdjd4LtxIy1sEHBjDZEa4M-ZA&oe=6A15928D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcub2DrURu4Q7kNvwEVAAkj&_nc_oc=AdoF-f3p6BNHSGKS3WrOxBOC1QYIPx4kZiS6yqYqA1W82fvI0V-MHdxVx4Q0-ZuJXQ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IkJStO3xs5GeD-xk_tzKy74Vb5WqZNS-8xpq4X30e8Q&oe=6A159BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWWRAvLwP30Q7kNvwG64WGZ&_nc_oc=AdoohlmPB97FeNr8v-EAUwYZS2UvJcTJ53dKH_tjZmZxrcmZaMEOqONygFFL4OzZARs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I7cip3Ra9KKeKsJdRBKwWVr3K7Qd6XjRRG2zoNdXq3g&oe=6A159172"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvUt8lO4zNIQ7kNvwF3a5qt&_nc_oc=AdrTf8vhMPFR9lrnxA7D1ffJf8e6wOoCAAxTjPJMB1hg9nGApdr_9Zu6bNZiEdSbXSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4273eXRWSjhg12gXlk7CQpa1VbU17XeSdWDCYgkrnUMw&oe=6A15B8A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gpk3aJpb7EQ7kNvwFNKuL5&_nc_oc=Adr31dqzzsY0IxvN_Jkr1UFQVAtEbbLaOXKKe-l9TRzFdC5zo7zzaBD3zNdfGFNTGXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbtpYjQD6leYm_kZSpcbU6mseF-gL5ceGcFYyWe7bVDQ&oe=6ADF5422"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIfWkLXZUP4Q7kNvwG13ELx&_nc_oc=AdoW8dPQrEKrAK-Adj_qetAF-HAYhxfPcDcKgaQeSNIvrdY9cPerppncZHMRhyWFsvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIUTzKzyt2FJAfWfQ6hJojoMW_ilE6efFRljXl-X8-qw&oe=6ADF6978"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYNQ3_VLmKsQ7kNvwH8Hu1p&_nc_oc=AdqAD1nWoHCgy6YNGWSeb6SzefTHZWd_hy7PDX1hYdIGui4rS8K03sbkq2O7zWg2aOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtNDh6IIId63pf7fFs7iXDHmpzwOOWsOnrih24iOzryw&oe=6ADF7C30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sldng3eYC2cQ7kNvwHHhK2U&_nc_oc=AdrDoK64yCcN2co2j1gYlzKXVzdHK76eQGqBiNq6RdtE-npbvCqFvSZBN3aulbQWK4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7nOvKRycXvaes9vhSoQd2Q-RwskKgJ6DKAIHjjDnS_A&oe=6ADF5C80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rejq8DasPuQQ7kNvwFxcwIy&_nc_oc=AdoXLivNir__tYN9YCMUoWY6nJdPT9jejUK7Up5kAwM0sYn831HctGoo3-BRNbd8QG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8jReyn_FAoXOOX-F9R43uq3MUtmcgOIcR_xYEnrOzGA&oe=6ADF480D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQjyvPmhuckQ7kNvwHsN2KG&_nc_oc=AdpxMLh8pAZXM3mSpiOpjVWElsLF9UAipXlyoqS7opP73ItYMpYy65zbK4NpRFN5rhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUNNUEO8czgfORijuyJqtKsloHEg8L4pIuq97HkIBiFg&oe=6ADF5169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2Deak8GIj8Q7kNvwESXf5h&_nc_oc=AdrDQx8T7NKCARBldDjpeQvdm8rY0g8sAHkjDXzoBTXY8S1jmyR6TB1ji8SGTvJWTCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLelhwNFsnXM8dBjjzdKG5qKYA3TwI15YNfZlbvKhMrA&oe=6ADF46F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi5r8Eb2iWMQ7kNvwHOKo-0&_nc_oc=Adp8AyQUkgVTywox6pz0YLu1NcJz1jGqihZeS4m4BAU7qsNSadcjC6OJwKjKcR-1COs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAMWmuuhjYnDOVv0aP7_MSxdNakqNvQ-GUylXnh0y52w&oe=6ADF6E28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
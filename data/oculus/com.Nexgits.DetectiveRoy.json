.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBn_HAJ2d8UQ7kNvwEN-6Y6&_nc_oc=AdppGgK3RDBALWQBOjnFQDkRS0ZUdVaG3zq2j0hz1GAVAggAPm0-5M1Ee7ybcp9lNTk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lvzhrpH7NcX6JNw83z0FfIwMK2f3GHahFzvQC3scLzg&oe=69F4A922"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfkJ4iTdYtAQ7kNvwEqPigm&_nc_oc=AdrAk-aNCtTjL7eGKnd-mGlWl1hJwSoZoFop0prC2sktXsVlQXh4rkkTnimiOaBDAZY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11s2JPZj4IuO4LOt2dcxNbys0w797Bsr82gSmQA3U-RA&oe=69F4BE78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMlEwnfQ5v8Q7kNvwGNtsvg&_nc_oc=AdomdBIzGxiTu2UZIAo5exqYfr6GrOI2KJGWAURmFU3i-hsRDIjygOwnPw2CBPaLDDc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31aGo1ZaehvqwEjSnesY-g9ojPOGEHLMM5Q8w9IK3IWA&oe=69F498F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wbXzBOdafcQ7kNvwGBHTrA&_nc_oc=AdpFL0NnOS9JrrG5zLQNDv7X3FK_6KE36x7ldjpedv9B-n3FVH6J12yTu7xCDaoAaVo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_fU93zv2tVUGzk5iwmGwcYlUNh-tVOCIm-fX4rlaUbA&oe=69F4B180"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPgWRlFnJj8Q7kNvwFIy6g6&_nc_oc=AdqK8eRYugTXoqW7knr9KDZe30zRNf1yEACZzoQjYxyPCjF2Qu_Z3pt2_p1G-kj5w7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3P-WSR3d-Y5y0yjLbI8y_rBVT1v1U1MQ8YzgyFaBbqUw&oe=69F49D0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbZ140996ZcQ7kNvwGRQOls&_nc_oc=Adqx7z5TuKAbBCxPHRZw7iTp-HQ7HhgvCBttDcFAj-hCqc08-_8gqY1TKQlyx2dBx54&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MtQaTTiTQBkVtnVFH8nAFF4FvW0PqBYHHjdDTLZmKqQ&oe=69F4A669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4eeV00d5wMQ7kNvwHM9Z98&_nc_oc=AdpofaD9OnF9mrUrOV0fW70XeKUKJeQBA6BchURYUxaLh3G8WAdW8SdpUmxEUss-Liw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3AGD4rCuA19oGgkIYcKR9YGxD1Xp9QAewEFhCjsCr-Eg&oe=69F49BF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA0p1jJ3o74Q7kNvwEvDmc4&_nc_oc=Adql9wrWGmhFR7DF8YHibkcj3THaRtQml9Po76F7FN_mn7E71qs2PI6SOxKWGaoxBhg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25Qlj1_NnmxbZvDXTYX_ea-8SsS452L3lAUXGdef6EYw&oe=69F4C328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
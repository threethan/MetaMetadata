.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5mH6ZmKAAUQ7kNvwGh7LUB&_nc_oc=AdptwzoEYO4Ewjm57DX0H8a9xVaJPp4jnpQFxWqPRM3ZotgrygZ6NEG4O27aSb_2yMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uvfOx133UX2ixRmm7HKljdj8MNlchtM6dWuzCkZ6MMw&oe=69E0E2A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sceKydMt1ccQ7kNvwGBPcCk&_nc_oc=AdoMv3ZiYtVroshXri5H4cgEcFgkvdOr77pYHgt-zVUZA8T6hOpSG-7ItwGq-LXDGiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ogOCmml3TjPwGwSH1LTH6C1S2FKm3hmPpwZyj5z89fg&oe=69E0F7F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoGw_6OqsVUQ7kNvwFthQH3&_nc_oc=Ado1OjW2aP6OmcYeS3sAyNxAU2OF_SPKB8pRdi4-Gsx2kdsLDITGiK5Dz4XpZB8qcaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Xt-9ab-44dnpRqQTo1NQZuvg3P_cnGNTu1IiXYH2joA&oe=69E0D270"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED5qXe6hw-UQ7kNvwGjnxMC&_nc_oc=Adq8o42KXiPCcoizRO7x2F6riaBS_Luy0TXYNWfYgURz4-R7ouF9oSLywEhgMFyKxPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I-Gs79dIGNiB62d_kV9P35vUCfHBP_4VuLdAQZXvEvg&oe=69E0EB00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dhLe_2Oh7EQ7kNvwE0Ks0s&_nc_oc=Ado2SG-bx4wtyavZSvm_iyred4wT7W3jF98Eb5u_DX_3cRWsaPccIOtDThGSvg-KK6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18nWU2tv2WMOyiauESnBhyl6HfOCOgPUdWsUM20D_VfQ&oe=69E0D68D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4azKqpvbXIwQ7kNvwFM-u0E&_nc_oc=AdqBaHsqscvH-BRYNnA0zgl4isoY7qnQunLuTaQ52-yYWYTBDhERFJwqNZauiNoZDwo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1edLkz4FR-K2wLm_-d5MQyjyHalk6Wrudlzu_HZkmlMQ&oe=69E0DFE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmQLSRm7XtUQ7kNvwF8YWbg&_nc_oc=AdqUJ1FH_6uFZzhWbti9LZTmD2r3Z2NS31FLNrGm2ComLXrqF9VWO1KJlaFv9Qu2EMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c9j_LUOcgXkbB6QAb39aEKHcA-2px3Zh6ioKhZQUFkg&oe=69E0D572"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyEH81Ak0M4Q7kNvwEPgYr9&_nc_oc=Adpu9sn5Eh0nyKJ6OibtpqrtKWK40d_TOlzaQCxSD_pCJJVngCXKxW5bvwokdCaJkek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f27d2gZDdPRixtyrpFKa7xcz9j1GsKA3VH52Nj6pOsg&oe=69E0FCA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
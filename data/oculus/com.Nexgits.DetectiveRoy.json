.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fusHNNFGcukQ7kNvwHNys-O&_nc_oc=Adrpu8fxUGt32hblr0iWBHBuzrDNIgwidCt1DF9XtmPn-QJF_u_pWJVV8iCjJ1F5jcQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_62-ip8JXiuV1t23L7yH4tbBILY05PDr-sOVTqxAun2Q&oe=6A2C0822"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_RzGyf40hoQ7kNvwFvYdEJ&_nc_oc=AdqcyX3iB529yxxdtlPCL2XLUlJi12XlZD8xdiR9V1SAhrjZyG7FtfVP7rz2NEDSXb8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_29NLjBS3umMEeazUffJL2Q_Zez_pyZ9kF_YiyQsuqtA&oe=6A2C1D78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3V2FseP5PQQ7kNvwHfy52_&_nc_oc=AdqkBFaHG8fr4Z8a13wXeQe0WSwVJZOSsGqt_AuYI5eLBNU-QWK85JfTI2VeF1sko90&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bd5nEW3cLkyB0BiwZUOolnXNrBBFEpd3tfB7tF7YR9Q&oe=6A2C3030"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo7TD7mrajIQ7kNvwHC5jXS&_nc_oc=AdpLV4PBYrX3TY5PfVHIG4XU3JSR3kSk1QhAOuHdq2L75sC7KzeYEJEcTxmd6UR3rEw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KUSzdI0hvgLF0s7ov6WQsG2fJQ8z5L2kKugc8vcHRPQ&oe=6A2C1080"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fMDnwfeUSgQ7kNvwH6Rwnz&_nc_oc=Ado0z2RMjzFkwxausb-wmpYA3YFhv1YU7Hfggx3iUuVp1TAAgwpt2iBOAGFJYDBSC0Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KPHsDICvCERFL2OqzNfeY0Ata9c8Uo3EpdsS_085feA&oe=6A2C344D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcmXD6ojLdkQ7kNvwHdJAb_&_nc_oc=Adq-82xhv6Ogkq9ruifO7qxjuJNOwC9wLwpcX4VGcH8ijiM9HgW8edv2hzFPTu6rrn0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8zNfqNkBcHlSWZLiybp0GNVf_SuecKq1SxZoWRpBGew&oe=6A2C0569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x37Eu5_k2s8Q7kNvwHlI_x2&_nc_oc=AdpoqomgbpYp7YUUX8Gsb0Vs9RFlAntGMKJHZAYoSY20K3mGbi34KbQ6dArLlSQTstQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1tNMMuPsVTWG4T7TMmGRTifATNphcGXyYgGMIoUN3-w&oe=6A2C3332"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZHh_XHmI1EQ7kNvwHja--H&_nc_oc=AdpBt-Ck8WMyOQigKmp6Y4Dlv2n4edTBuZOMi0EmJnjUxMFdhvAumMmUqOYiUfAOD1Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0HsM9GLHzh37494UBBvQmKM9O4NPUFcSJc2AR85fUew&oe=6A2C2228"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
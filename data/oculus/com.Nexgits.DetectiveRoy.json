XkQ9VIeQ&oe=69AADD80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNYY9EPr9VsQ7kNvwFjvesu&_nc_oc=Adk7viYnrxjn-PjZNiqSvTGTNgvmIoDI7_IDVILsbg84uPpNEiPNo2MeaL2Opyu9ViA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyCjrKguFN7rctvSMTrgaRYUB38ue_faNl7Dm5-a0AEQ&oe=69AAC90D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VObYMHWl03sQ7kNvwGJHUi7&_nc_oc=AdnAmJpI1uvj_gdTj0SqdGeTbcv-C_g8rTKYnpU4bt4mPwS0wTXlGPWFxHK_IUNqxw0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw21FVd7xpvZAu_p2u4TOPsOhOqGzsBdQ2u8yEq43et4Q&oe=69AAD269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWA0SJDSOeQQ7kNvwFVUMXR&_nc_oc=AdkvZHrweZYeW5ApiICkZao7xejOMXY5USXd2jQJDpx1-qftxm-eL0AipF2IISvmpXU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLv9-mvpK5s7k8l2HkpxoiCZOLvf0ON8ZRmG6-BFPEog&oe=69AAC7F2"}, "display_name": "Detective Roy", "keywords": [], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_descri
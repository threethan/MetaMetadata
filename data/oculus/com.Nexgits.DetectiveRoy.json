.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLqT9gU5QzgQ7kNvwHDnEPN&_nc_oc=Adqs980W3wJaDmz_UsiNX1-iEQsMGopU_RA7oA4FJBZ1ewxebWnlDWfZprWASrPAeeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMREaWxaYpNJQWSDXCBNikJAbJFCzvuWayBbkEsQ3Rqhw&oe=6AE49A22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiWFVdlb9AwQ7kNvwGt-J_t&_nc_oc=Adqw7M0GCfalhwYCAcZtVnHPNX1mvpyqf-534nNSkRkJIlMxqyNR04wV9BL6t2bZ410&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOotuLni0CmbkRq79aXryneaIq2maw6YH6dQk6-ggrjyA&oe=6AE4AF78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHbozdcq-NQQ7kNvwEV9MEW&_nc_oc=AdorTmGSf1uo6jG6emvIRzX2gCqo6FKV55POwLGPdFXnQKsQvBGzsVDR0KQYoIDbVts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODdgCstpnqTIEC6Sh0eOFShw1brIQR-Ni91aLfuQuz3A&oe=6AE489F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkmslzFult8Q7kNvwH_cP-J&_nc_oc=AdqSNp4ERLTu-kHexhjUh_fjz82bao1lrfUPXM9omLbmlHSQjLAhB8fMRI3FunlhQoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4HBx1Vv2FGWz4mX9uXFOTTp4hLHYeRcYlbrS1xyv-9w&oe=6AE4A280"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyChctrygtEQ7kNvwGwhE9M&_nc_oc=AdoC-oYK93Zp0cPxDQXkaxs73Rc0tWGNTB9tv5YySowYyYuyiRUL8NtibdFOW4m1NJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwIEOPZVRHv-3yDfqAXMoVKcpWyKV1VML8E0tkhKDO8Q&oe=6AE48E0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQXBUVdJn8AQ7kNvwH7S_NT&_nc_oc=AdobXRhzCBrrb9Nf6Rik8vrPROD3r39-bu8eqqWiEDop1R-0Ih4_UgLgjxBHaABg8_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbSRRyevwRIZZgkPA8mVOMFz_--o62cklbtHk52kaOoQ&oe=6AE49769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUV-huqyKj8Q7kNvwGkMrD6&_nc_oc=Adqk-hOzUgYNEw8sOJsCNpM__3JUHEzYKOQFGvUcjjP_avmV6QM51xtqdgBBPBL3U6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMictCy8H-2EARDVxni4nxNlExvRTiV7gDBKCFGPjRABQ&oe=6AE48CF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh3s4gSkK5QQ7kNvwGMXq2G&_nc_oc=AdqvL0Apfj2xaR5obihnUSZvh1nfyPBGAfLz8TeFbtAxzjWq3zw1ma6qYj9FSqukUSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4CLlVSUaRrQ7dVgesfAiE8RLNMvDF7k_E_hH_plvhWw&oe=6AE4B428"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gpk3aJpb7EQ7kNvwEm4Zdn&_nc_oc=Adow__A6k5MTrL6_v0p9As_B0XdKj3AR_PDoVA5DQNUBXFsavhzdWa_x3JpkB2KUi8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdXF6iQVU6zsrtxN9q0tipI-hEyKyESFzRtVgx2cNpsA&oe=6AE0A5A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIfWkLXZUP4Q7kNvwETrXRW&_nc_oc=AdoQ1dMagdLmh_FQIQIyRsjwtgSktOqk8Pkuf_y8Ectqk9Ccixb9Rnak6lTum1Uulbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtuxwXseNadf2LSLVGozNd91865TjLUwfR-ZX7QGwULA&oe=6AE0BAF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgzl3aR1GlYQ7kNvwFB4JfJ&_nc_oc=AdpUDjPynvixYXTjnQxcnL8cZpJ-_P5Yedex80uBibvGSGq9toRoUb0Gw8fmmD-GJ6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO-e7xZXq_gKKSQlW3-YWXEfUyXaHEc-Qe46oXxFHQ6Q&oe=6AE0CDB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sldng3eYC2cQ7kNvwGg12H_&_nc_oc=AdrThEnF91x2NWIjkxetvePpbwso0exa4Te_V-obHpQasSFox0BNxvDPH6doWUaqK6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiNMY3CaxsxKGrgNgcfwHa1bQsXnX7tjv3q7KZcEHBlA&oe=6AE0AE00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS7_FjADYF8Q7kNvwF6evEh&_nc_oc=Ado7y5xNJMWajst-w0M_gHzd7omFY3Xuo0GbMzcORGLR999AI4gJ3eEHsX3TOsUsb0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZxpnYpKIvPdTbeWTNLt9-RfzuoSYfevkpUap1hxFlAw&oe=6AE0998D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo_NdpAcVFMQ7kNvwFQh3NB&_nc_oc=AdpKn2-9aT41qlD55E4betnE4KNc9gySHBOXWkQ2witC0Ub6PWt4HsiX5s4nx2alusE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHnY2TW2cJMjCslDUcjj435cSIR3_y75JxWg-FefA5Mw&oe=6AE0A2E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2Deak8GIj8Q7kNvwHxmEJU&_nc_oc=Adq8uouOClRUtQw9RfNPO34GJf6lWVCIJqGoctP1q7YOsVzZKBfz_jf1b5FZ0YmvusI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSBYYe717sjGuMdxLSktSoGt4iCNL_To8TUPqXRgiRIQ&oe=6AE09872"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05_04GTHxzUQ7kNvwFtucss&_nc_oc=AdopzCRy9kP56m6-MHCb892tt0kpIau3P3zjqqaZHLimI-Epf9CHCelFh9QnyLp-ums&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOCSDqqHfdVYuOMq57FuH0VPNi87JBRM7XvRNfXABTcA&oe=6AE0BFA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
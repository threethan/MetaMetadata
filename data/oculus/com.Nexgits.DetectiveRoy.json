.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WU-AUp0wYQQ7kNvwHSEzkA&_nc_oc=AdrgOkVbzgqjx9nS1ffSDze9hroQqa_cJXn0NgYoR2Rbs3VXePdqz93-ZI3_Kq5Vq9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OJqzhLMV-6t_6UnO1M9KjIEH5LTMiemIux0E8XBNYKA&oe=6A3E7D22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3F_A4SctD8Q7kNvwGq6ma9&_nc_oc=AdrgbIyA2EUkwKBLMcBeQDQAsWr1TdhhAyGmWuHKyyhCx5elSrGuKWYOaxSCIY13nl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PAqKiMv-5h372QJP_37ytlTz-s3P9ribSJi6Cv8Buig&oe=6A3E9278"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP3AqbfgkQkQ7kNvwGgZc4A&_nc_oc=Adp8vl7ysRzDGilxt8NrifFXlkH7VKts3uORs6M1nSlYfTrwtNvXTmj_i84jKcHgUbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xrFVtpwPnIyin5O409NoJ-Wfu8_iSROsqdkXcyFm0og&oe=6A3EA530"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlXITfiG2q0Q7kNvwGstCT5&_nc_oc=Adpq_pASrThNgM0JojaXk2ppyYmfpcm_d8FkBZ7-qmZqRZ8UZ_LKXgtdAp4a7QpCjjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q1M8_yZstbcgCUFzIqWA3WKriZOuM4cIvjnGL_RVDjA&oe=6A3E8580"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk1rQ3zs1o8Q7kNvwGmaSQC&_nc_oc=Adq2h1jOqdsJUqG0vQ0fh_zoihavMgEcIWOKj0wehOpyB1ozupGRrYs80bH9hwxXMMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-58kko-tXSS9msDJOuc0I97Tzqd8tUK74_OiRt8I3KDA&oe=6A3EA94D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC7vflAhNckQ7kNvwFGxqWI&_nc_oc=AdqvdGed2vaXaV9MyzX5dqX2Yg1RKGL-7djwUUvdX0_ULL_DYqfWuQVqshLMeZcQXtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tdYGw_7CTxhDXl_fJ497JKWyaxvX3xzxEmToAbvbT3Q&oe=6A3EB2A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d0Sv4ATaMcQ7kNvwF-GQoM&_nc_oc=Adolx2EL5twxfj3vobbjsNqcXXmGdQ9EY8_eLtLMIEsvoXpV8AaDMu2-vXcHb8eLAog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QRWAatxFFb_745q9jDawOeA86AcodgNZwkhavzM8WqQ&oe=6A3EA832"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIEpZA0Ksz8Q7kNvwFqPm0F&_nc_oc=AdpK6dlEGX-iXQevQzp1OBRhDD3msvw9ng_ptD5YbXpNqstxRH3murAeHtlEou9Xd3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af998ZcCHfrStM02TkROMDK9U6UHZYIks9aF66TpaVUoDw&oe=6A3E9728"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
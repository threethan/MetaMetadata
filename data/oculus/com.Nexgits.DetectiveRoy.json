.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVu9x1pFIxsQ7kNvwECICXx&_nc_oc=AdrkByelVegLecIW0jaeHOVtnuZO7lSQn2rZPW4XW8ByrTizWLMHS1EGRF_6zXJWaSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0E36BJSGvkMfjVVk6TN_h0xQrkg_tDc7kwOyBSdpuCw&oe=6A772DA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DgkWv1paYsQ7kNvwEKmkgi&_nc_oc=AdqiJFSx_IMb67t0XLw2GyCiE_kWuIxQgQaG6rle0JosWBNGAN7878OpXjH0qbvejvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr9YK8SFX8WxRF0v_gB2BxqRQGNl4a5ZQtAt-pFFsXGQ&oe=6A7742F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6auX6c5NqMQ7kNvwE1kZTr&_nc_oc=AdpBsXDbTmzbdtqu9IjLlRvENv1Ws0MLWrrY3FhfPUag3ZwITm44JDYTN2AvgKwxVEw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmQmnji1rgJUXPG0T4gZDbYyBbwf7ib0c-eYr-NWgyXA&oe=6A771D70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4jXcOtIFKYQ7kNvwGhn0qI&_nc_oc=Adp9nVlRuxsywnJm3ocOQRiCSXgCDiUVqbZJN79pwSRy4G3YJKm3fx92UIS_O2QR9jA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-VmQ2SxTo_9kLJTMGWwqjX28hCN6hVMigqbx9cykj2w&oe=6A773600"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAnkJpBbs94Q7kNvwFp_eQO&_nc_oc=Adr83fk3tpEbd6POQg9fJQvk6esI2FaiEH9Lw_AEu3WrCtKNU49i_YI62Yz6d0e15Cw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJbfPn0TzlOjuUwEG4jkMsiDZ21_IyCfBg823tdeWwEQ&oe=6A77218D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um3VB44Ra3cQ7kNvwHAWyI2&_nc_oc=AdomwP_iKBGmHHVImJ22wY_5QBGM1sPkgcw9AAqlmcNIe4XByDDvK8LsDf5SYP3BFrM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgFuXHPibMdKxZVsCO9-mqCTYkSkHQ3jgevJ3aDDRUAA&oe=6A772AE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgEa3LXy_OcQ7kNvwEMYPnm&_nc_oc=Adrm5l0vIY7Ug0O9MJguCFQlCYTOQO7fkPn9LHZolnzRDMD2R4eEzkoty2T-bDtQTP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFStizoUFPQLPmIF6eI2QusnzonkjMn8VP1fWjuoPLGYQ&oe=6A772072"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlzEBE245VkQ7kNvwE9hNYL&_nc_oc=Adp97ARARRAbtPBEySEQ6rJPphCti2C6OJOwEXzBwD4f-L4k-2s_mW_duHsUYJTWImk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5ArwygI_yLHS6v5WhJXcso-eKDzxyCpIY1JrZEuSxaQ&oe=6A770F68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyDjalqW2KIQ7kNvwEtke3x&_nc_oc=AdqYG3wPvOvbmi9TDitrrOlcz21VReNKuqGYOMuwFlwHgoHb6y2Bo29a-m3pay05C6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBooUbkXnKxwI1qp7eFBM-S0z4VJct_R-pwXu_g1fjcxg&oe=6A5243A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEGun-mIN6sQ7kNvwGF5pgA&_nc_oc=AdrkHxPCPb5D1v7eCJWEv5rFC6B44w2-pPgNM3AlhiEBvSeuk28uwbQEnH17y_9u30o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1xuA-HsUuvOLvKaI8T1-oRZq7R1a6g_rXggzHLb0tEg&oe=6A5258F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuiJX-KftAMQ7kNvwEFCx7B&_nc_oc=AdpTG7IZDzi-gx072EoQPcjDC_c_TGj81JFtpm9SUf95XmfF385OC5LcbH8Q6MLhw4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVPtNrjXSG00oVA0htWBUwJ8VTo5IXo7NpBVKw-PBULg&oe=6A523370"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHkZokEop7UQ7kNvwFetSjT&_nc_oc=AdoOZ3pOeozEzNsH0xRnV-mC0ztz4KeYQ3LioXcoqQvFGbZlC_HdnbGjDEez6WeiesE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKAE-jbzb8aFnULBkrY_EHXXJSe29jhCZSCLBJyAyyyg&oe=6A524C00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w25awKLT58IQ7kNvwFmoxPl&_nc_oc=AdoYj8ND2vnfFbD8WsKRYsBvNIuNLnjA4KH6NbDu32T6ZEJJKe03DzBXV5mt_nwQSNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs_D7macyecxWFgHOrMCG_cqXLo2MxAkpdLu2bCYrRJA&oe=6A52378D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW_nSUx57IIQ7kNvwHdPRzp&_nc_oc=Adq4VkZV1KN63KP6Z67bY994To1nR1Cckk0660DsOzjR9YDeMS5g1IkqhS9bafaY8Qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlnQ8hojWGQdgzGQ0wp97IF951WszuIEvva1JE1btvGw&oe=6A5240E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aF36AeU9rsQ7kNvwEuEuC0&_nc_oc=Adr5u-4DjpwVYhT80FJdueFgQaq2rzlfiNN7FupJvBRQq5WAZPkmgzzXREnxgkS4JBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA20FYu0XEPsDund1XhwQOn7TXyCEt0fWfFyQ4RcUOoNg&oe=6A523672"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt8y8JBjdjwQ7kNvwHoMvTW&_nc_oc=AdrIoaW9AzUMF9YO8h3lIqd8cvEpy-d-50bKFv_fJIxLQewD_MDaXBUCEC4ADJ75IeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlXcyL0E_0H-d9AibNSn2CAnxENoH_IVy4nXMIzATL9Q&oe=6A525DA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
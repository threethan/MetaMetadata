.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRyF63o37Y8Q7kNvwHW0MIR&_nc_oc=AdrKvaVaGgUAcwBSEeeUOa1IlgrmzsrrZDS5M4IaaVCEle8EcmQMHcRNDmCfGYOjGzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsRO28WNycgjlntsAUfmaYAQNVCQDS8DEn9B2EjZ5wJw&oe=6AB52422"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idtct2vAHGsQ7kNvwEwHorJ&_nc_oc=Adqzxc5pT517th-3Lx8HKUT3SNC-y1p5VT-6Zg2PmOg5zy1Il1o-FMx3XYX_ocwiBhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuFlXfEzqARDkNWwnzENGYh2Jtw_PMiyILV5rX47GBTg&oe=6AB53978"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNMiANos3PwQ7kNvwF1JLjM&_nc_oc=AdoEf7F6qzxX5cAcAdWWTdy9f1stNg024s1IuhPxhNu3ffqCeMTS0PO4asyheQoHUJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILxDNhmUUUxCqcVCdLMNAkwsAwkyYv67RNzVv6i4Aj5w&oe=6AB54C30"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT1jXgPuFggQ7kNvwFFaFRw&_nc_oc=AdoC0f9cU-d_P90fOIuOA5AE2T-4CNFP6hkI1OHu1935tioSAl4JUcd5MQ0-6q5WJLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpM-c1Y0X6urlaJ8U38WOb4WN7CgCOABoO44zH5yxd4g&oe=6AB52C80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGTWQ7AyBtMQ7kNvwFUcOo3&_nc_oc=AdryRfrGYk1QTJuLSFGRcrW-SFZ4D9WP9V_5kdoULMEGM71XH73klie9anqnGJ7ndVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-nEBef79MGVVuyx97GA2cKSfSl5_rYppkeXZIlP8UPQ&oe=6AB5180D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4j4k0DLNNoQ7kNvwFXZ6ck&_nc_oc=Adr9vsEoNeRK5zsyGzGmbWFD63yJT_YQxXURuOwl-Ani6jHrziIXIGkqeYyp6xwy7iE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXm1xuVUtdyqvyTZKYGnomKw0s_JLvXR4JVpYcNPVuiQ&oe=6AB52169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY6ZaXv4DfcQ7kNvwEVX9y2&_nc_oc=AdrFqkGh6xgNcuOoPnXMYwVX5o5sbAdI9nYHgvOSeg-bvioHNtwnd_6S1NxG-xeipq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv7-lU8s1Mv1sNLQYfF-xV9rbdBROfxG_4N8NZz72Nlw&oe=6AB516F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q8iWYNeB98Q7kNvwGAyduo&_nc_oc=Adrt1SYxlw48CBcUBIHN-Pk3NKd2Ppsy9G3L2L9GcaVOeI0W2WJzvm4Vtb9hMLH0icA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0lAl-2q_0bbCq9fyVYEAPTGaCv7TODIZVaN21BvFxVQ&oe=6AB53E28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
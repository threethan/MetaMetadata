.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CCftTWAyxMQ7kNvwF6ENRw&_nc_oc=AdoPkae9jyQtRexoP3539tbj_j-4IaU4RqDOWKOfK1r4Zzt9LYSFqzNocSbnslfCb18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7F7BAUsQlGICk7752rK-LeYg1r6sqUHGeMDgtYdvzHg&oe=6A830B22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFmWr5Eu5fMQ7kNvwGOpDgk&_nc_oc=Adr_G6dYW2YlHTGd9r0naq7gf1jr2-U4CX4SNWHjnGLvq-ntTTwMyXo9HEC769AP394&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWgJriuqHqK5SX38YNfieb3SlxQpnUsxVbaaU1OlsC8Q&oe=6A82E838"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riBnlJ4QbwwQ7kNvwG0iLwG&_nc_oc=AdoJ4C-v0rLaw5mjmDWbE-iTcECWGemzOJ2RoukEPItgAApts0IewPKevTV2rzBe0eE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHJnhMHsgn1MKzjW0Tfx1nkEsix1EjrsIpHz9e3SQL5g&oe=6A82FAF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX93CDg_u9oQ7kNvwHhjfM9&_nc_oc=AdqrnXw6657GyhdMTP-2ydobAlls3b24EPue0Zi2X52VadRZ1lIV2Z5zZMx6Bv8qmY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGdaZ8o9pre8AXzKk-2wOI5H_mo_h1FTri-1dfMxMe3A&oe=6A831380"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFoCigRXuVUQ7kNvwGN4Zie&_nc_oc=Adqq6aQZMEf6Dguxlm7cGrJSBiYnazz3eeq6PvBxy86ZjtP5N8TNxAj2vTrskrV6pmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgWyD0cfZdc8wEgedlidIisi-KdNbUcW6vfUrUe8I3KQ&oe=6A82FF0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS2eZf0SB-YQ7kNvwHqdcAO&_nc_oc=Adpxj95W0oMyh7sgaljn9xKfBjvR-ovfuSi5bpxpYn9gnt4ATdkSq6VfIk6RHCI2TbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5eh4ZaFJ6NevvZbXHBXPHyn8tUJ5O8U9UYcb9ZXA-SA&oe=6A830869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8maHWm2ZAeAQ7kNvwHruh3O&_nc_oc=AdqahsGQvP-sFnXF4Gv4BfSYZDP7wxl6QJ95ViKOM7vOw_MqfWWAv9uSlKNNHDECjkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXHj9L0SPb4mkv3SNEWDdonbW9Nu1787EIdkYTt_QZhQ&oe=6A82FDF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWqYErQalMcQ7kNvwEo6EO3&_nc_oc=Adp3HhqIhqcyGFz5YDKn6BqZTbodNHeeNRp02fD8ZmAuiF2ApYo4cKVBUfjdfkbn3S8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVasrmab3s4j__ybZ87e_XU63cbzwMJUdn41KoBM0WpA&oe=6A82ECE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
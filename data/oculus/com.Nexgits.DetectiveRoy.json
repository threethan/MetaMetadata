.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsllaZRDFZcQ7kNvwG6zJAG&_nc_oc=AdqhoCxyOiHlsQYNH39-xBiVLuNuBk7dWrvJV1RnmELlBzJDwW86rerCrpNHQgP7ZwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcJV8Rcfi3wM1i38cx3TWBDq2ze4m37ZTXdQt6iH7Lsw&oe=6AA55222"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxrp_FDALSkQ7kNvwEx0nF8&_nc_oc=AdpHoMDEy_pznklp_2GCz1Jk9RbY_pwveLo7RvStrL8ds2r94KtjnxHfT7r85XCgq2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN-XihlUciv2sFTw8GLhCIPb5RTucG8GMF4J2sP3akNA&oe=6AA56778"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZAnBPPpWNcQ7kNvwECXG1W&_nc_oc=AdrrkXIvGD1X9NJ_ul0SM01x8ZXzZ2yn8SeDClbQKxiUjAuanhSOyXDRxU6k8aTOXzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWVDIu5THkT5c8b5-BeSkA_t7JXKOKB1NW0d2Wjg3asg&oe=6AA541F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbrgKXnSNToQ7kNvwHjL3rp&_nc_oc=Adp6SMgyC5poDawnGI7ObEtwoqhCIkgSxi1cb9-7PNo7QNkZ4V1tl-BrOgkH7sVxFpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT_9CFSU-9zbJMNz2jF6uO-8mJlm3iU-YeXa3chylGLw&oe=6AA55A80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7rD5lBrq90Q7kNvwHe8_PW&_nc_oc=AdpiLYNl_EKamdItKZbCva7nJe61bHOJ6sxNlsoc8t7DNBskdbsfqAgliok5tavT8MA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0CGqi2mf3lNiz3RN_0msf0Yf2N2zFsVSwLz3gnrS9Rw&oe=6AA5460D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjFxoetEM30Q7kNvwG1Dy9U&_nc_oc=AdpUTMJjk_2Bh2ZtjKT0mbZK4p5q97L88iEgkAjPpXGNBqoDQ_RCN54FgkxXxJaj6ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3KVBzwRmXesozYyPTfV2Rz_PhQQphbUxnpSAiwHNJZQ&oe=6AA54F69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNQ7k4_qyKsQ7kNvwEmFbno&_nc_oc=Adphb4_A-1WNWtmd-hW8lR2mdbOrAe7GSnDeuRJfl2MHsgLidcvoSJdUY8H-JLCGSO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4OvE_JoRgIav3NmIRhpoxQMwAfWhcrpPxjOR3IU7ZvQ&oe=6AA544F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc2OzalqwPsQ7kNvwF1T4ny&_nc_oc=Adr_fuFPb9uauXDVn7bJ-4pPcf1wN-FYSfr2o2LAMU31MwJlsUFIkbdbDLysA8TIz6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhmlvCbyHdNDx2P0hwu81yUAoQ_lk6Tigi-l700cJcHA&oe=6AA56C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
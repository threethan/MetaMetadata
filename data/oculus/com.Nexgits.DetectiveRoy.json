.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irdmkqnKN50Q7kNvwFTYfj5&_nc_oc=AdqjzdkEdy3tb6RdQMnZDIE-fXwUA7MV8FbZMjOCQd7_aP6JiiSHgTBqgMGyPJ68_Lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGsvpi7qGulp6jH_oGrhnHJ4oIvQQmBGStdR8Izp5xdA&oe=6A733922"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk0oWinMz_IQ7kNvwFuSUuG&_nc_oc=AdpJBTmRhjMZG9Se2_Dabv6URXBiJ5PURCCAAFdu9MaADm0UO5zNbNFA0E3hQYJdpB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELGP8uRuwXSge27iatOCuTLXoYqurETXN-APyxef6dIA&oe=6A734E78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsJlYkRKaVoQ7kNvwGgmp47&_nc_oc=AdopQ5XRYnSpguh4G2y06EIEkCQGKRD2HzhZ3ZLnvtn87AeyMttnPzySGyWkMRdgbbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1jz4pRRdaed6qkCyZt6lBvoy3wZhulS9s7W4c15yPkA&oe=6A7328F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kst8fltK-MMQ7kNvwGQom-n&_nc_oc=AdrpOqX1LrxiIGgdzKNs-iI0LlEt5fmr8EjXyFpxz8meafNRSwPgbwGnToQOrJMyvto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvustzeOMtvYbOKrFyAjNfNduMuQhLYCJdds8kX-tJjA&oe=6A734180"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9i4UraSGVoQ7kNvwGzg_k_&_nc_oc=AdrR5I2QWzcl6cCRxqGw6MSjvyTzjW_wYQKx-j341ddwiz0hIc532a1NOh2_sOkeKh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuSgcyLtwCzwzZudGhXK0dOKx7WKxj0KkNZyZ1khnt_g&oe=6A732D0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlgGbUVrgSUQ7kNvwHpiv6y&_nc_oc=AdpL78WwZ5szQ-Itw9Y3pwyRBlsvuQvKU2KPLbGVhIuyWrk9N6g8T2Aya6LCT-YnhTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCRNbIWEH1SGhnhCpKO7cvn8LwoBU0thdPR4qKA_ie1A&oe=6A733669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qubJUScljgQ7kNvwF1jKIi&_nc_oc=AdqcTk8IkfFydC06EZW1ILaEfSLxjkM3NbxF9sUlZup65_7zT439SOJUv9cYxdi1h7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWuNS2Y8nNkGMznvhXvmq0dMsBNB_6zvFdsV6NiOho9w&oe=6A732BF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yytEbdQwutMQ7kNvwEs6cvn&_nc_oc=AdqizF3oOI1iVaGBHk8GflT5XzjOKJh7C-7yAXXTvfnnaiiIfXnodeDd922rpNEgJxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpyvmuw24AtTunniG7zX1evw7JacYZkhJksjZ9xtPmzA&oe=6A735328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=266ixfTiJxsQ7kNvwG4svrC&_nc_oc=AdrfCW306BoWIbLKyhJk_g_fMT1m7R0VppirHfnUlS7HMb1cjXOFAUSiPoG_LyX-I0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kXqMM1EdEZmcwYcCoWXVz6HWwh31_Gw-c8fdzk7XjsA&oe=6A047B22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70as-jwLfusQ7kNvwEHIer7&_nc_oc=AdqKJSb5apSb6gte1DKnQog_7sDM1cJIaYl6ngp_DCbq_kH7KTREHxokHVlQpSg2vpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ar_pa6YIJfDMoIcuk3IBmxIBMUlcqJ0Dq_ddiHtGdRA&oe=6A049078"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IgMwJs7zUcQ7kNvwHBLzxI&_nc_oc=Adrnjg0DY7a-hGlsagKWnLHPeGywwjxAruoanwZAxI14dvyCPhhXOuo5kZHWiY-_8Pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t54tlCO17XfCSbLIlCkopWY1yHDbpxdNlMrZFyuVjfQ&oe=6A046AF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5_QxerTzBEQ7kNvwGQLD2E&_nc_oc=AdqlHoODWqiBaYNTh90N7lf5_vGhSdUnJedLiDnxsF_cfcD3XViFT30RIFOg9wMPNMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DqmErUSwGKw1du2eihVK4PITZefOAaC09vs4s1UHUYg&oe=6A048380"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdEf9rVOHHwQ7kNvwGbZp-a&_nc_oc=AdoUv8zbW5D12huBVDAWoiA43tt76HRwJ-vCp71R1RlKOhDaP8R-8Kf0bLtestx_Qgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kWpk0cfac74c4lI9ppq1j5h5dauH8gznztV_k46xuDA&oe=6A046F0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgrL6TXtwWEQ7kNvwHl2_0k&_nc_oc=AdpmcgzqV2vTJWGuOHCLXh9GGooCxv-tV9oFPO8ztMj7qCsYXv08qcsM56dv0OaMNRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CrqQi93kGIaKJoiiC56dOP1b5YYuESoLcWW8i7v2Rbw&oe=6A047869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR2BbbS0O-wQ7kNvwHesWVo&_nc_oc=AdrCVb2g31IGOIBc-hG1h1xQRM50ui-o-gTsjZSC1SNNWxRYQKL7-SbTyCTc-Z670Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NCdqn5G1vk3id8Tp_QCu3GCquzUE50frOnr_PqWgOPQ&oe=6A046DF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgCJiQ2LtuMQ7kNvwFmg6vY&_nc_oc=AdqpAd7eoq-cLqFhzQ5QOTRugAVR8AmIK3qJhZhupiN1GHdxX9u7pChH631pIxVfNcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-B9PZH-bw2lpSokWEkRwIEZxZr8ma7J-xZYAfQY5LlA&oe=6A049528"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
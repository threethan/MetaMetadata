dJ1LCQjuixEBR4OxCKcF4S7qk4sqSEY2fZkDOgk_4w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqo-SlNUJU__GjqI5GXMgr9TOVPyAOpcpgIuuXv5a2Hg&oe=6A6F41E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMIhcaMexpgQ7kNvwFoOBzw&_nc_oc=AdrUj5rfLaiCmsSkCbL2379ILOis0_qSK0jKPevPrTkKlUuiK9Z6qfsIjzPmF0farhM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8tl69jksGh1LUtpHUoj3C12QvFBOv3EfoMr2XpFuYeA&oe=6A6F3772"}, "display_name": "Detective Roy", "keywords": [], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "http://detectiveroy.nexgits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nexgits", "support_website_url": null, "website_url": "http://detec
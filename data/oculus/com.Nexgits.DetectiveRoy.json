.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-U7XC0Zz5wQ7kNvwGLsgwb&_nc_oc=Adp67yOolkN-WplTXHhbqUZcrNVF2Wjzvm_oe61pxvKz-jA1t0_s6f0AH2gM7JYupyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kh3hUUJ57OXcUnx7Z5qhBR3rwo-FQbgEhSqUaMbEztQ&oe=69E4D722"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbyuNMmZq-IQ7kNvwHpbpIR&_nc_oc=AdpI55hvG49Rrmd2OLexG_IhA44pTvu9EwtFry3fR5yZrjHwVYuGwwKpUuyN2pRNfwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VsxMgjFxt93nc4CihNKnlr2lvKB3mdozT-BUL_hwjwA&oe=69E4EC78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXCC6w12UQEQ7kNvwE7mjYq&_nc_oc=AdrFRqeLoxBTP6b4Mcx701uRfcgpbDj8pmW0yO3WvDDV8s1qFZbU81Vf4ZFaTV3AOXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VAaENQ8WbX7AkMYg9lLDn3PNlBAe8Rq9oQZcBB0j2SA&oe=69E4C6F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-1qHsEm_mUQ7kNvwFqUq1_&_nc_oc=Ado9oFIlfBtW-HLsbTbXNiiV1CyO9Dx9kpURYYnku7GNwSPk4NEVtnVASbk0Pa_o3PM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nj41aXfuWkzL5GtlyL1U5ycdDhpALE4PY52z0Q02nKg&oe=69E4DF80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_QtpRLai80Q7kNvwFzGxmk&_nc_oc=AdrRHEJwYRp1R5PdqM9f6nr5NrzpnEY_iSV9wQ-nWxzw7rxlVKdLaTeOyS6kRmcmoEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Su7-BnfBbLrpqnrDKFsVw0YnoKLfhEco-zhUKVSP7UQ&oe=69E4CB0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzEm3zMBr3sQ7kNvwFWYCiA&_nc_oc=AdqkqQ6Uc4OJQKSQiSBpir1xeJu3tSP7a1lFXgr31oNGxq3YwGpCNDP2ULPcE6qnHNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Uayf0L5C3riUlpFvf0GP1veQkdRN2P18ng2yHLOkcHg&oe=69E4D469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrasBm5PvXgQ7kNvwGyiz23&_nc_oc=AdpETAOFN6-AuC3MIYEdB4iLO3CI-lU4weU8KbMA_jSAxpMYJnZKrePKtzGv3kzcjxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_aD5WNOuvrsw_ApEY7CF9TAd73IaQS0nvAUyIdTZlqA&oe=69E4C9F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqH7F1unqREQ7kNvwE1QP9F&_nc_oc=AdpkewfRzfevOyfA90n_lDp5VunvPSYLkmNTBAZBIChmSLcY0Q1OYGBGaL2tSx-f4Ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wr4m3RPFUtFRtXFKzLwKQQTCkNkhe8FIVsa7g_BsSDw&oe=69E4B8E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
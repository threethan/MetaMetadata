.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw5CzsTTsQ0Q7kNvwF9llmh&_nc_oc=Adq29PuT_4a9wJIhH1Fxo6JTCEn7jpd5GgCePxU2yXYc3YkNBeEQVITUtkiZN0XWbNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VIIkby0sryqLgFQ9LRx66gzZTNnHOTbms78UpzrWZNg&oe=6A1ED922"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDsHj3A1AO0Q7kNvwGAX9G7&_nc_oc=Ado2AzfyWEYMH1yHBCDFv6EPS3GZTFVhEpiYfyI7GTw7rfX9yNe0pQ4G7Mx-U8Q-TdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af489D8587lNAxhQf_2tSadKC6Z3WxYldzYxvynJ02Lteg&oe=6A1EEE78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9RXUG-lNKYQ7kNvwE-2v8M&_nc_oc=AdpmfB8dYuLHq3A4M0RNTpZmCdIqR95zyJtqlW20JHIH0CZZdoew21yj07efAecfrZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lhzpmeK8y96C9iiA7MfRhlf2VzTZMudtOoiq3k8M7Hw&oe=6A1F0130"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPu_j22Ap50Q7kNvwFqtn8o&_nc_oc=Adq1kHnuXSK1eWIh0miU2K5dGFegWQKNzItfl-ZKzpXKwHlszGI3bNXscPSSaJCXl_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HSMD5OIfp6zEw-HaiIa5NkCrzh7rjHjt_GVX2MN0aXg&oe=6A1EE180"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMXgBfKbeWYQ7kNvwHLQ8xX&_nc_oc=AdppRi9wU-Z2WSyTZbnRjM_B-h3RHzeg4u89MjCgaG0sXKg17Vdcb_8T9lHzs2Pu7pk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XvnR7LGKg0PPekQIizR4Qv-F7HZrdE2w3lNgtOEPh5g&oe=6A1ECD0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNtlrOAfBE4Q7kNvwHNeDNl&_nc_oc=AdoTMOiXuRtnHLvSI6INwaBEIVHrDbbNqAaGQzrdhgdE9-hmlYzYoD28D4lG34P8Usg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A9xyz6q0LWhZ9fXpaoi5dzFvh6XIVZO4FZIzLrak5gQ&oe=6A1ED669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AT3qrkbZY2sQ7kNvwGgyNz-&_nc_oc=Adqm-FdIoatL5PUphbKfNuBb8wvr3U8-R0DMZ6XDCExD8pDrebuxPBzJ7cToiuoALtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QtZvLQbd-jmMcB_ClA_iiNJHJ7X1_6pt_KkFtp9mwlg&oe=6A1ECBF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QyajgEGJCkQ7kNvwH8NGiD&_nc_oc=AdofET6y_Te-GlqHTJiZ1fQo3nPvcVLQ-7Ms5eOdWkzbTqmcesXRzuA96pHtdD3Og-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N-TY1LvrA6qCmYRKQOvmQYobOA0tyg6TK72XLOrK4QQ&oe=6A1EF328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
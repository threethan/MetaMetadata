.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol2Fa55btL4Q7kNvwHhxbHg&_nc_oc=Adqyy3DEb-2zdEhRjUb_C2DchMoCw4V32EFLwuZAKB-AIIocaYmb74VLchaZcdzsctA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPsD-mJT3Ru9sJES2BO2hy4sXlK8UDwmj8deflef1OfA&oe=6ACA7462"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMHU-aS6zh4Q7kNvwGf98su&_nc_oc=AdrnRwZugjlSyDO1rq9SeTL-5AmUVeKW_4fIWW49o2un6VHCvbkSYiY7Gy8VhBvhhkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSjaQQ__SZY88T2ioVA_AXiZZkFer2fftLJw8RJrc8YQ&oe=6ACA5178"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRiSrZwsCzkQ7kNvwG0-xWb&_nc_oc=AdqbX_QAqglFnKGtli-i4ivn2bvX5ti9s4gPRpGSGTtEZPnZe7CWQFnXvbDy6bzusJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv9D11-ZyhGA2lo1FOH1AQ32ipJ7Ejy5Zjmzuea_U0Bw&oe=6ACA6430"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_anxB1iokCcQ7kNvwEEwDvn&_nc_oc=Adqv3_stkF8D2KKlw-1z4eawr20oQrEOlSz6oojB-KKQ0ZJaMySfM9IfNhu5xeTAh98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJD1hE2hYnRC4J7VzqJFFnYBX7JMCQHgDcN85XapKu3Q&oe=6ACA4480"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaEWUoX5bJoQ7kNvwHGtTsM&_nc_oc=AdrYbKqy_Z_iJ9jfA8RYEsWCN8DESSB8LpesNAZs3mYIuqrjIqhhfpv2MFelATnw3FY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgyy5bMJVHITNQuLScNo-sz-OtpPXEkQJCpUpARMPnzQ&oe=6ACA684D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y-BGStY2uEQ7kNvwH64jLE&_nc_oc=AdpzLjyAVXaOPpf4ec4hqST0U9GJ2I9jPLRnnIbEmNoVqjkoyAXYKcROLffguuKK3jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTQrVE7DQh4Lj1o7joO8HYMEt7YMoHZhnRmwjVaS65yw&oe=6ACA71A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JYLyuRK4CoQ7kNvwGMwd7Q&_nc_oc=AdqeTrSNVF3Mn0KlBQ-IoltSEtTBcU5NDMubT23fJMSi8oH8xp4g6_aI8M8Diwgy-B0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX5sMqPcBEfgUfQkJRUFT8fVp8Fn0af6NliLYjeVXnIw&oe=6ACA6732"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hrinx4ErQegQ7kNvwF_H4A8&_nc_oc=AdrZ7y1gOxLkgSFv5hE336QH6U6LWac7xaX8Zobxx4QwqSoQOoE7aBrmuv6dSOeA_C0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqKudwxLhQwMXAGYP5u4TVLYDJg9117hk_81W8hQuKXg&oe=6ACA5628"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
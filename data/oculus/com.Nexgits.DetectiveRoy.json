.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBn_HAJ2d8UQ7kNvwF-x8UN&_nc_oc=AdpbmMNobejNHGfLWJbnANlHB2Bgg8VZIZv-clHMFSwpdbAp_dTkFaEbJYA9VINAT3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lHFHk83FBXNBqADWHiHqnTZh0wy2uE-8FrplV2nP_eA&oe=69F74C22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3a4C5n6PZsQ7kNvwFrlDSb&_nc_oc=Adoj7aX4CEE_vFHs0-G7PqqQYyQWqFtYjT63HGqeP51A995T-awAXG2BwWDSC4M6wyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19IBuIdkpn2q_S4O_EWoEDH_ak679kLI3rDo2IWf6PUQ&oe=69F76178"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okMrAjb3-i8Q7kNvwElw40H&_nc_oc=Adpp3iuzpA2phnAu7SAwOo1vZWWHj3H1g58VL4ZvCV7otyF_WPAFjwFwGMDDmKVifb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02Hx1b94WxL6ThLcgATIJfPbprCYf6yLNw9cR0NEiPHQ&oe=69F73BF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wbXzBOdafcQ7kNvwEs0t8_&_nc_oc=AdqvmoL12PYNNUdlLYxGWfyyf14pk9n9JDzHTFOtVf_5TkDpyadxXda2BN9zIINK1qY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qk7kYku7v0Yp8wf6QBvNGcIB-hSRIFP4C56I_GURKVw&oe=69F75480"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsHL7RuMj5IQ7kNvwGsAvd8&_nc_oc=AdqpNcCTaURpNAqEaWCJ6MHl-6rpiIcZUfee8joa64OU1mlzkQK9RMLgzf8A-wLxQhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0X0NLr1eUa6oYgGI40yIKpfjMWTALXyrGbU7PGMa7L-A&oe=69F7400D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNtaUciCFXgQ7kNvwF7Oouk&_nc_oc=AdpeFoMciUV2ihivFvblJcPkinAEIInWyqwCflrISJFrekm5g6zkMRp-t4pihPcqVpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iT0-gHhaoNT6AtpYNtiuJSpVqqKYnUlCXr4RH69VFwg&oe=69F74969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4eeV00d5wMQ7kNvwFuSwxA&_nc_oc=AdoJnhHigY0woqb7VUKVgKOhHfBjuU5laIymm5y2kTfgOJsezKqneoDgeebTiB6HDIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13Lcgx6WKaqglzEwCfdPMD_2ybLxcpdf8m_SycSpyPCw&oe=69F73EF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np7aztPmds4Q7kNvwGd34wd&_nc_oc=Adq7vFQfRL48p0M1D3wq0KRnNzLbxDYytdUSfbZcy4fmC0zrYRrRXkdrqZnO3tx3Mlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fKJ-z-0ajhsppw_fU_KBZmY6l2Z_lXmk8OndSooxdZg&oe=69F76628"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlVTwzTsXuMQ7kNvwFVQPxR&_nc_oc=AdqstmaL3sNKWStmtG00eDXCsdAhHJktsBsuiugJuZiIHisrEuLcHlPMOuOQwem0y5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_ThpliLclG1yOTHYCVLXVs3t1WytMLV8AWSvXCBhS1w&oe=6ACE68E2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpXgibuDNfQQ7kNvwFeUDRG&_nc_oc=Adr-AOZbiPZUTD-pRYAkHqXmPfsD9py35i7GgB6D6fxrwjkpJZwNgUEvjhBLKudjilk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuYsYIvmJBzghOBJ-mTD0YK1pI1IJYZ4M_cOHHGjUwlw&oe=6ACE45F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzDiGkPmlc4Q7kNvwH6YPBm&_nc_oc=Adpxu0jHgF32kbKNuzqzC1R2BI2cUZT-DLX09XoEBwJdVY77v20gCNj8m-ajQhbexgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPctGMtbbzOrOZxplZE5kgWTTa8gQrHAoZCr7mdy5Idyg&oe=6ACE58B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn9Ucd4S-OAQ7kNvwE_Wdao&_nc_oc=AdriGInWd1WX_MueyeLtUBS-gxHRnnAcMikZR1KDnNO4lC4Ja6VVuu1pCeYmo5xIg9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_plqYa-CKCu8cBNJpGUff7NLTpk_MEw34oKDIkbScwQ&oe=6ACE3900"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDXzMgKdxrcQ7kNvwHS3Rqu&_nc_oc=AdrrNS38pLriZYQFYLG3Z7ds8PIgoTg0t9T4-qx_fPAxGYH8GMx4TWrnv4hPxF8LZRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHfvn7AkiI3GQ7My0VrRonN2PujvQ18ETRx1fNbQYZqg&oe=6ACE5CCD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9IQ0KfmvEcQ7kNvwFgYmg9&_nc_oc=Adr4FJZXwjk-F0SCrG8vQchaK2W97LmycCdieklx0veuYFF0bTrjP_27e7-EsTtYLTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbtJSbuAnEcETqNuoYUxKP6YWLEPJ5IsH0BGeMDfMhgA&oe=6ACE6629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C8ca-JRx74Q7kNvwFnVGKC&_nc_oc=Adocph3I7pn1KGFFm5-g8zAwADwvSJWob6L0H74APIlSUDbgfmzM5um6TqrfZnTtCN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_gkAl55h8sOIYxBM3GgtXOUOM9tj3n3ebcIwu-W4MZw&oe=6ACE5BB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqKRs5Y9TAsQ7kNvwEuOmn2&_nc_oc=AdqqAcg_3F6lR_eWb1oINKAGhDg4PaKLnaYZu1oXcfr3DO1P8EAWTfIpDViH4T9Vhv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjDxvQdZGvnklM_G4ki5a3jMAIS7AGPia5InoW10MJUA&oe=6ACE4AA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
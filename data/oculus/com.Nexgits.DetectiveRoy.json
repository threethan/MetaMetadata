.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fusHNNFGcukQ7kNvwGhnX9v&_nc_oc=AdpiIc-6sc0PDsE09D23TV5FUIJOeHJD5cK9JRRK2novEqJOKpNycqT1wSN_-D7-YnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KsAXTy6Qdip8lwFBeIWtmjPvfrpIMM9o0XRrSh4lorQ&oe=6A2EAB22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaGIu35FN6gQ7kNvwGsI9bW&_nc_oc=AdrTr-0kSpLf6DqZgQ3B1kmClro6RfQIoeeaieUhpZhYPjJBYjdVpeOO3NFbLG_Apbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kid7FTsJvemxXc1N-2mOYvahYYaP8dOG9qJF5h9l6wQ&oe=6A2EC078"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE5hFaeXuZcQ7kNvwHwFqEz&_nc_oc=Adpl4z7lYBXmqB7Iy2e7Q8KobJuJUGs8JilQQD-jH3q2xSvx2ss_SE1bc33CQNj62Mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oYOxhXgNvEEHqrLZrqEfqxrdh-KGKiKSfMvJIpP1sKQ&oe=6A2ED330"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo7TD7mrajIQ7kNvwEhz3kH&_nc_oc=AdrsRSPO0_m1lQIvHIZiTRTPZESI74JM_Y2DFFehZlOa6zwtKNBI9DEYu9Oq3xNWd6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G0AQ9D6havcr2sK5EACDtuerTgy4nD3ZzQitP2-9AmQ&oe=6A2EB380"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVJvfmxrl6oQ7kNvwEc0n2p&_nc_oc=AdoEqlm9HjDZvO1YXgBAyRx9udLmXk14K2NU0kN-SwSlv1DcTeljZ66NjKMVbRBnhhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95DpbTawYB1b9pMv4UpLrQ71k382GXjzCsT7rJ3iPtDw&oe=6A2E9F0D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7jjoglFpe8Q7kNvwHOCrMb&_nc_oc=Adoic56V7bJP8lYYrhUYxTrzo6yYm-SIPVX1yEnQG16LEZObqmrNGpou9HCPwOU4GC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87Y9rt2RSWFoYUffDcgIhzLJ-6htn8cY4ZaOI1y-C34Q&oe=6A2EA869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x37Eu5_k2s8Q7kNvwFRCtyJ&_nc_oc=Adp24AwWJUEevY6UCh5FL9N8Q1ROoNNlpRkgHlCF0EzxUdbjdkeetpM2f1sZbNY_wSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86C4ZxgCOeqY08Egzt4xcfuMSrJ18hsXjdIQtvjuE87Q&oe=6A2E9DF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa9pUsoIOOMQ7kNvwFd0rRl&_nc_oc=AdqPmd7hshkHEWg3So6rlwic9EI5sNZ6OR_52fxaTasW3wK1OWVwLY4by-LEaSVdK9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lIbUAGM2pmMN_QhHLt6jp-r4brmU99mtW4qjy_GEqIg&oe=6A2EC528"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
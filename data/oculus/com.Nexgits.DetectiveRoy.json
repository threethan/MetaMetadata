.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb7-jw1ipfgQ7kNvwHkjOvA&_nc_oc=AdoLDbcGrPQEiBCuc9kv1QxCxo9tgLwB30OrRdseKS-aNjFQNZvOrfYyQFMAVdb2s7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8jshNTaumZ98ehoUKOUREW9px059DKEgfxREjA_shYA&oe=6A7F16A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpvwbVHgz94Q7kNvwE1g25G&_nc_oc=AdqmaLaTMgYO_Tfrwl72QApK9nc8smS5QKtTOzaeKoaiiB648xWeaRc_DsdtZv835EI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnxgQrCF4xH4K_F84o2y5ffPIjetVwpQxkI3qglqO01w&oe=6A7EF3B8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnUxud_BNEUQ7kNvwE5wlEm&_nc_oc=AdoRQiH5NIMxexOlkeuYeVSgjukKphTr8XSd2yO5-u5Qea7y57eAZ7WXk6-M-hUtDMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElEYO8uwNkChGG5_m7KK99nxPsrzFeNedSqou5gov7zQ&oe=6A7F0670"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CtFwugrHMAQ7kNvwFWvOhC&_nc_oc=AdobC5A3QhNsNPSCUGwJo3z9pAtFfpGVKMpy7nksaT7RN36NthFA2JxWWivhgnkaah4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQRngQiAj0dLOboBSkJe8zNfhqN1p9mvR0hwJFI3ufvQ&oe=6A7F1F00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXs4mar_kQAQ7kNvwHrwfbp&_nc_oc=AdoIVB6BpHAzfZqPgDjXEdCJo2yMpid3JYvs4Lzc66NHWIZGYLk3HaaYDowROUu-KIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7bwxa4yfxTFyG-XJ3UiJA6sKIB1m2Ou75AC1ZHDEtXQ&oe=6A7F0A8D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZuirokfO64Q7kNvwE-t0eM&_nc_oc=Adr35N7KknfMsE0Zx74pgRRk6ZidqUmXeF5uMYVQmIv16jKKQPLIXWIHb2UMT3nYfOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXofPEGo4YDJLgMsOtZRVt4ce5hYHvZx_YTvU68dMmhg&oe=6A7F13E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx3TL6m-VFAQ7kNvwG1BvXg&_nc_oc=Adp3z1mJI8xCNFR0uetRQy25XFQkk_l2zup776C48nJmHz7m1zdyE4h1mnqN5FvIMjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO_3vVr6Hvsl9Z_VnWyGRQYup9mLG2nHnpupHMD7vnKQ&oe=6A7F0972"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJtSoCXLWHAQ7kNvwFRMf4g&_nc_oc=AdoPgW0uu9FskS8ZSxphr_ZRbFjBYiicsuHkrz_SPLlAfwE3UE_0xRwgQERXePj5kxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlUSnE9RDQueuhmVZTsnFbOPWmW5f-WLkFRVNjefLROg&oe=6A7EF868"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5gasRxYc8EQ7kNvwHDGKNY&_nc_oc=Adq3YP6ezJOyeNZFa2C7Zj0HrsVAwUbTvNZRITsohiILNJHiVCpKwo_fp9KJAvGAycs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV6DI0apmPRxqXD9LAzO1VCdJJSW7t2y44tSTKBIJ1uw&oe=6ABFB022"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_HbDSkAeTgQ7kNvwHLyt4k&_nc_oc=AdqCY06OnYrG_v4OqgqMSe1_Jak0zSvCa_ogv0ccspZfvtdoFZE8KtvXAHHCN710Ogc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOa7BLOymmfp-1_foJXIi-adFpZjmaD3rlmE6tNY6BeA&oe=6ABFC578"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-rwBvzWLx0Q7kNvwEk95IL&_nc_oc=AdpPQ2Zhgao0TzmHA05vs-Ie66lNxM6yyTefK9e7lO_UaO4DeYl0bywAuBq2-sRj_Ek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKYiu-js7WChyIU3FsGH0CJWFjNyAKB7UBGg2LvHOU3g&oe=6ABFD830"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GStiDLep7EkQ7kNvwHwfK5N&_nc_oc=AdqrC2f12hgQmdKYFZ2nbg1Ete3z9Zi6EhwX_pw9nbLwAsW1Sw0tZKaXqe8g0eDHWUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMK9Uek9Ts78v-oiKukIMsw1S8ICqG5vdDhMp39FocZw&oe=6ABFB880"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rh87NUB3tIQ7kNvwEo6lsf&_nc_oc=Adqwclx_zIJOWLTCrgLqPUALW8vcB05lBSgyd7Lpa7UilJz8Tyvf5tKrVQEARZLecEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr9J2NFFIyiN9kE3h_hGZUdj1YWV_ZiItcvHAfC7t-yw&oe=6ABFDC4D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFV8DIFSjjQQ7kNvwG0KkSD&_nc_oc=AdqaDBkD6slIBALhI9FJJfwOKHjr6Bb2AZgEklEKzGXspeMaP-iYzUCyWhZYlnj2-c0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM118Qtzk-qgt-8XD5G3H8Sye3YwTAsDrYooDyTbg5OuQ&oe=6ABFAD69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCpZ_3B8T34Q7kNvwH7leQM&_nc_oc=AdqjTkcSZwxZPbuqz4d37wNVy-48soV_lelEfCq3RlAdVg4DfrULk_dmhnzshJg9s_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYn_N_R7moeMax4i9TM8cZ93p73zLq67owisy5Fj3MrQ&oe=6ABFDB32"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5VReJDXeL0Q7kNvwGHqDZ4&_nc_oc=Adq767-UTfchw33HDq_VNVE4FtD5hgGrVkgbjrHZtx4EtPh01pvKhf_v5RNdZ_UJJOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbV0w389R-97vjQKXTzWZuyRFPgYl_mLcwHEIuvoYjJw&oe=6ABFCA28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
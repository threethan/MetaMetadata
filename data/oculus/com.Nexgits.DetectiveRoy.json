.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdkUgegDLiQQ7kNvwEX5avE&_nc_oc=AdqyZmxFkwg2PTZqmkhv_tAB2pSPXjbr034iqLduiIdbnzsiMn19B1MrlnRYHvamGP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvk_XfFjX_i35YTwUm9b4YoQ7rTjNlhV1-HGr7Pc51ZQ&oe=6A4CFDA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpDZIcmDVjIQ7kNvwFaSh3h&_nc_oc=Adofu8z7_6oNDk1z9BFb0tFAnm8CA5PG6VKwN069urgu5gZorFNFAXz7d8YgJW8IqUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4P_bAmWZqMlIQP4BSbLAqORjCjiDkgLEtDEiJ5NnCbw&oe=6A4D12F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zGXDZfCZGwQ7kNvwHCvyNs&_nc_oc=AdrFXq1AXPAaTFocCle0rT5neDBg4XIZNClbPanskgyE0SNl-Bl_QxXs7Hbh_OzUOS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUn71m92kU3pHpiKeu51DcDi44LHfRibR1GHzQTUUbPA&oe=6A4CED70"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mBcgqdcXFQQ7kNvwEEq1VR&_nc_oc=AdrR-hXiZEYhomOn9JV0i4whU1dTjxjuMdtO_1v-4WbJlux0PkVPrjbrHZD-j-JU4DA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7IQDocKIz9sjLwyWqHtr7vOMDTsIK8n4AzIHKs2oRrQ&oe=6A4D0600"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjMA5M8IO2wQ7kNvwGdJZxF&_nc_oc=Adosmd3S2CwBuCoOw7YOzREkcZ5AfekeZ0NOSMXf94LSEKXthUUXz-VVPEFMeLMCmnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0W7zW8bxIfZ9qKUaOg6_52dwRUIXjBwTwfzhql35LBw&oe=6A4CF18D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGWaG4NDDTgQ7kNvwHQ3kT5&_nc_oc=AdqiGhulCu2SdYxzqp0OLPVFtxLowxl3pl_P5MPD6q1YwwzpqNgceMM-FL8NRmkcGYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvVo1xgZIPEO2vsbSl-xl0zthNHtkBQqwVXzpXZq_e-Q&oe=6A4CFAE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFFtw3q6d9MQ7kNvwHqPip9&_nc_oc=Adp8cpfRjmn4wwpd9Uh4CPA1rI4f3ImWN7Ny3maLTrn12zwKZC8-6KE7yKylUB7wHgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApOA3IPnPKrIa49DV5G2rK4NB0ClaJ4SGjDqqYPuBoXg&oe=6A4CF072"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhVmXx5dHvIQ7kNvwGKxcly&_nc_oc=AdocJBrKLs3RleoDQwgfoI_UL_e495OSNjmyKk8FgzZygdVNGltshAFshS75QKGGdnY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE-HijLxDxT8sS1Y_zQDR6YvrO3p17TmFvCFM5d9Fjmg&oe=6A4D17A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
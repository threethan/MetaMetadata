.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tia3frnaZz8Q7kNvwEM0bEc&_nc_oc=AdrktPaShzgNp8zGsBpaQz3I0qYi_0Wo77GEvuWPAYxE-2NBR8jQqXR7VCyMPgndHTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtn8XRiva70I33o1SYoyJimZk5tXj2jFQ4dfrb45mTNQ&oe=6A9974A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu5q5CLMOkwQ7kNvwHrLr1G&_nc_oc=AdqLoNr9J9RXnKi5rSV0At1K-nVD3UVAE8-lj1KHEgr9RtihiYfQy5UOg4jn2q5X-00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUDAxnM5GgtsgD_OP1Imx6irMfKflR4Y-eRhLeUKkx1Q&oe=6A9989F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzmQwUBcPKYQ7kNvwEqGcfd&_nc_oc=Adokdf-sSUN5Om2jLyvnIRBG7gBjLjq6isxbuIpdpz5lK0xMq6RxoriNGOSgVBI3HAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF-v7U3bWPLUXRhSEahjTrIZP93AiNr7VMPtY78ubEEA&oe=6A999CB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r90gc2HDtpIQ7kNvwFN8y81&_nc_oc=Adppni6L67vbDhgX58GMm26SSmlNeNW0xemuaj8sDQIzhYCuZYMUtBoFCCpCw8egXg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4cGoKfkhF-NFX08f8runLHGWfNd-xcGtTPJgNl0XGcA&oe=6A997D00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEeGdEvtVPQQ7kNvwH3jj0x&_nc_oc=AdqN4Zupt0avWZBvYsh190Z4rjyGuyLHEXkToq-JDUN4wFH8pz3g8cBCOg3K50Vibc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8h6pAMcd-VYtUZfr3ffJ-I4EdQUrDCwsfu1Qf-R-Ycw&oe=6A99A0CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofb4aiT3jgcQ7kNvwGbWToy&_nc_oc=Adr8PMZv_rXjtVzMXZhveHqRPCwILd_s7MMgbXNVRbALc9sLJ0uXNWO0IzW18Pf3sf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZL90TTwJdntfLGDzp2qzX0WPnqX_5guOYa59ilF6x_A&oe=6A9971E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE9JxgtEuSYQ7kNvwGBmGkF&_nc_oc=AdrI_mjRWiTJA0uVb4PN30M4ZnWHBukQzlqpVEGFPg1PNRWWqcZhNgO3GLHesgyktxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7DCC0L6pP-iRe2JhqnjV65aZ1i7ScuihVg9_xSP0iJA&oe=6A999FB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf3phQ6tvfMQ7kNvwFo3AKD&_nc_oc=AdoH9xZKW_pz5bUpQTJ7QoE9Atn1fnpNsMuzRsmkCjZ7ixo0EfAjMImIj3ucLjsMAYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfg8DNAQ-x0uyfiwfs-eNdvTu_0swFbzIT0CD4uVyuhA&oe=6A998EA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
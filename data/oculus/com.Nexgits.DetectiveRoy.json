.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UXLFtHO2uYQ7kNvwGnt0sK&_nc_oc=Ado56AehBgCgviJPTOFSbs0mCgaAf9xGz6sIBVb7M12dsy7h7wxRhpeXsgDkaw78qYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFMRoovZznqJbUARu-Gllzm102f3XkQVhz5MUMPGVPZw&oe=6AE88EA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXs9Zp3liIUQ7kNvwEJvcEt&_nc_oc=AdpjkkrnOS0kFazGzy8iwC8QzJypQXVbJBCHO-u7nLKLdqAjIdV2MuZdhkImLT8DhJs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROwg5PItbWbOOFzr0JU2bjR68pLZ8FXChFI2b8_FcMgA&oe=6AE8A3F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxIGK3yONC8Q7kNvwHEDlrD&_nc_oc=AdpUV3K4uBbD9Vqldj8SJXUk76MEUxQg5EXPDMpcPvI8ncwHAa03po6kZYrZwHV5cW8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShVJBpY_SJCwgf01puyaxqY-TQdy9gBsDWS6K7xu_VVA&oe=6AE8B6B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cad3u8tnmjEQ7kNvwGMdPIV&_nc_oc=Adp3iszv0Icjn0Je-4QmBZFdhVh265F7usWQ9KDDRQ4XXJaemmxeU6gHh7VJt20leq0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgJJF9dKPA67g9lB1morVonaxLwP6uGWl1xzvDrXaRGA&oe=6AE89700"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KBZOUozBB4Q7kNvwExuL75&_nc_oc=AdrXwIdbMWZtoZJRIEZdZb1nYFkX1hoZdk-KT9_-dS6GPHegJPKjfJER0Ei9JOpxX4Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGiATpxI7jEgjTV2AEb3-tvtWKgwXWDPwLSjNgKNrnSA&oe=6AE8BACD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ey89eviac4Q7kNvwGsCeUZ&_nc_oc=AdpZWNPF0259JzUPwUuNX6cVP5QZQ6SLjM0LqIGJEA_LGvj3VqgzWgSWD2eJq089pCs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkxq0cUuzd9MF0URGacxiXSRw8p4DOQhzp5lRGR2-CCw&oe=6AE88BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-RHohluyKMQ7kNvwE4Vq_l&_nc_oc=AdpR3nKYuo7jCumlo3FQlCf5aiLVLp_uYf_LdfFGV4XwiRNbDQmtDXNBPtXHmpdNNZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEecQTEBS5Ygo-2i-HSlj9juGD6VhHI9BYZKH-_0rEGQ&oe=6AE8B9B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_YwqOLvzOsQ7kNvwG62Deh&_nc_oc=AdrmycPPp6yf9iQBry5TTo17Ly5moJbdiRK1T0HU2Lgv28N0nIp52nX9LLSpgkspHNA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY3BlZp79BqAIC-MqwFu4lT8dXAUmBXGBaNw_53koHLw&oe=6AE8A8A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
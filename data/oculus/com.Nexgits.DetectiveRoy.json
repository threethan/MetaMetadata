al detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "http://detectiveroy.nexgits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nexgits", "support_website_url": null, "website_url": "http://detectiveroy.nexgits.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "842399483385090"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7264164980290824", "version": "1.0"}, "id": "1020259648844942", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7263407077033281", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7264164980290824"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1020259648844942"}]}, "change_log": null, "created_date": 16
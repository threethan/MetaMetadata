.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dZiy9j8K3wQ7kNvwEd2qgY&_nc_oc=AdrN1i2BHbHuD6u3lZhBjHCjpAWVq1A90FjQgG4QzDgSX7fT698yOpG6eKFoUuVs4rs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7egn9lWoDwckYsjXzUMSCkf_uqHJAX8D3UVAc5B4oJQ&oe=6AA00C22"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=164WmQJX6A4Q7kNvwHIbbvF&_nc_oc=Adrs5Uxiam25AJzGat1VkrLfCQYvOcIDyckYy9pQZUqOY_ywCLFzhQk93mU7qQDh0oA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITk8IVw_b9rnKIWtCez0H39jaWEKlESXkgsFzA39NmBQ&oe=6AA02178"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPn0XA6kZxIQ7kNvwE0uB3y&_nc_oc=AdoQ6qXh7et6kvAxiasmCloRffR4uZ7HAUscNHbgoB-PiawCJ9U3q3t-mK4X56mFi_o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOvAe_UGrxBGUFmSSZY40Ob4f6XFhykEeLZVnUallR4A&oe=6A9FFBF0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f-EeF_tfrAQ7kNvwHXRPxq&_nc_oc=AdoPZUV_vYnETPwku9th-D6gON0yQrDNS7PF2G9iRdNy-t1BaoXYku1KnsQhgYUlsC4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIenFTEo1ylxC20lno1SSKKfc2VMtSGqS3emQAvSElxNw&oe=6AA01480"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5oyqsgxEj0Q7kNvwF0aiPr&_nc_oc=Adp5F28dzEaPI57yeSftN5w03wx7co0Yssdc-s6CXokTgGhkD6OQtEIMpXSVQ1FqnwI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdFiuzQKZ35s0pr8DOk-XmgxUNYgeaeLX5p7MrTk8Xxg&oe=6AA0000D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7IovEJeLrAQ7kNvwHgNtry&_nc_oc=AdqD1bzIB1m5Jio89uWfdpq_cuZnRcdfI0FcKTyStgsV-mBGD_7NUO__A_dVG82W-vU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRsp7OSq0fvHxAp9VExqyKPnbqcmBUAuCoNVplotccog&oe=6AA00969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WiZFkHOy-kQ7kNvwEe_SV8&_nc_oc=AdonCjrDTHTaIB6_oetm3AxrsVytYN38q3tTykNnwDdcc9g6SMbzZUCEn2Uu1H2NNbM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDt_sZcEBe_NcquD5U2MgKw0OOZgHyzctfOANB0gPPYw&oe=6A9FFEF2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbNXN8UIBmAQ7kNvwE2DACG&_nc_oc=AdqaIv2vfoifQkk4ZwzLUcy2S2GSnfaTxzcsrey2txmBARnTLw4gsOW0UL6YbxhCcwI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEImSixH4J49nKYy10AoQLai1A0IFt-Qi7mgWVsewlow&oe=6AA02628"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhMxAaHhmo0Q7kNvwH5M9Rz&_nc_oc=AdptrvI9s7IcVzFCp9MIlVP7Fh7NdcOsgsivmHF4WS26eMKL0xo6rkOLg7HC0WyNP9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGRf_a10n6Z0OstTEiAJ8OiLRS9HVQUpUb4jbeqvs52A&oe=6A5E2122"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdxyloQ4CA8Q7kNvwG5jrYy&_nc_oc=AdpVw7DalO8p9WdpoMXaDob2ghTcuWYLOwuek4-EX7IENaw4bOK_B7eYIJAkraTVq5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCczIqrh7r1gNFGS5-1EBF7jlTN4r6Q-Sve0GurY-ZtXw&oe=6A5E3678"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3HIY4lVSsIQ7kNvwH3yw4E&_nc_oc=Adq6-Oj9L32sv8L7wGkZzrOurMGg38sFTl6GoZHJZ9a3v4RIvC8dSwroOaOvDwx4JMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD58BbdKiqyEDZCzJUyrnN7s95i3lxnXBLfmstHTFtPug&oe=6A5E10F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRnQgKjpvBUQ7kNvwFaqSv_&_nc_oc=AdrOFOvx2U9c7pmOt6XdDHfofB94fArE9I2jKWreqmOjEUNCv3LZk37X-uLADDrLCfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwW-57CvRQWdBcWm_287hIVNHyGj1Ci0ck9GIIg74dhQ&oe=6A5E2980"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAujR1qtB70Q7kNvwE-lyAp&_nc_oc=AdptRbZdcPUL2JSjotsnajr0u3MKiFOQKlNQEiq9eT4f6TF11TsSsu_jxc9eQPiZ6mI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd-Y4w4otJYlhieEg85Y-9nZBusCRLM8W9PXYhaKIotg&oe=6A5E150D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmMjJyzu_yoQ7kNvwHYjyhU&_nc_oc=AdpXj7O8-lX3R6sat7nHjYwP1JqNH85_IjFRaMfy3EtdxHsqtQ7Kn8T1SAH5oluN3yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB245H_DJs65wC0G2OhUMifjwTJ_by669cYjGmvbZ84w&oe=6A5E1E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2rJqahGyzYQ7kNvwGctsW-&_nc_oc=Adp80NcSrgdK5CtCzAYeZf2mDh8J9JtypTYNlrW7RrK_zYnzzLPu2ZcrpviA4anySMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl-mbYN345ZHv7t-OqLGoERyXqwCwIzdKqfN4-dttBzg&oe=6A5E13F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqtEC8G39LkQ7kNvwG4JFG3&_nc_oc=AdqWw0uOfszO7zJJ-JQ8S5TN5vqhPlPDMH3wfcH37zbbmmGPvoh9xfBcWCIsAx0-by0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSMEEOSAnOipme7NpuN_K_NS8RWplXTcqUVi23G_mUSg&oe=6A5E3B28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
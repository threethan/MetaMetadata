.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5PIJDQjJjYQ7kNvwHvIuD8&_nc_oc=AdoSwOnQ0Xk670ZSEKx1W71jcoikazIeqeqdAMEL0ZbCiE3NdnUfDPvky5TJt_w4cGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uAJC_xhnR3o9ngGAk--Va6y_3fDzbQwZ5i85pm7Yjsg&oe=6A2570A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evYD-W_fOlYQ7kNvwHdmgBO&_nc_oc=Adpfpcg38Osh6-kCsY63dyyzjJPcN3Ab2j8mN07ALRaMz1vU2VHFhcMkh1P1Za4VfI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9oZrKqMavBCYIP_w7PZ7zHJDiepFMsoSAce2iMFCYwA&oe=6A2585F8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diCXQyfzUb0Q7kNvwGduSUS&_nc_oc=AdoYFQGl41uyUaldkjK3x9wcrWLqIld95hB7T09dG8DAlbHXBgh3Eu2SVvEWIx3Bz_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RiQlQ02CK4UO-uhj788TZ25XyD9Th4WOXSpbjT2Yh2w&oe=6A2598B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JocouQbfEmIQ7kNvwGAz2a5&_nc_oc=AdqeCa5xJyzKnVNlc0WwNN0jumZRpQRId3doFM0Nx8Bo6YTfYOrOc2Ay74bPRJpDJ9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w6CVU5xyklzSRGa8Bu1SUpxpYh6O9FPaVdpcER6xdSQ&oe=6A257900"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV1nay8MtRcQ7kNvwET-7GM&_nc_oc=AdpSD2kp6QN3sNGpSQzxL7Zpt5ZbjVKY8ElaEUDOcCby3cW1E9mYvoMHGJ0GYxdV2Ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IPAVmXUWHVIfPAdjRdK4aPCPkCJ_TWVtA3ObQLKpcrA&oe=6A259CCD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pis6dN3JW88Q7kNvwH1vsIi&_nc_oc=AdrgFU1mwRibSDxA9Muk5MenAaxWexLo64ammIx2voMHh8NzS65KjE6nnEdHoNsJCXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fppb_9jFd-H1b6UOh35Vi6fpb0A6nKmfiuH9VIihFqQ&oe=6A25A629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKj6cOXtkosQ7kNvwHAygxG&_nc_oc=AdoSJYZZ32E0xOIJdWrt21sEQmivKBGj7Lv6N2_jZhFm1-rnVknIe71YXGpnbSck4Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oEbIxX4HVrGKBFDyt81HrrkL8D0dBa6hhBF6B4D4qxA&oe=6A259BB2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQlOie2J62wQ7kNvwFQXlWr&_nc_oc=AdrOiyBuEbVzeWHbEmX2eCBJMC76GCiBZNaamoMFGZUkRNAEkbmqI8qptHX0KnwDTc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RiDBNmW3f_zpt1tvtTl82txDbDx4caxpOWx-BI8cFEg&oe=6A258AA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
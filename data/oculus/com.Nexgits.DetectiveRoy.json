.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K_yprtNBNEQ7kNvwH3ZIzr&_nc_oc=AdqdX2YfeCBH-6IptNxjoqwnG5BvhclOIt3pfDHESxlVERGo89cZ56rB4-lapGjVB8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TMWwncs3o3aSXDN7LWxoNLykRlKvjTH83IjPIx0IpxQ&oe=6A296522"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_RzGyf40hoQ7kNvwFhRKu-&_nc_oc=Adp6cAeXF2IZFaM4X5xHqb1Q2UkLxsQeJuRkIPwDCL-3FJmqBjHl-mDZRPc3hJzzps0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VbECgHyre_S3B_n-1sdwd77WIQyGDsI7leI8HyXNjvQ&oe=6A297A78"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpiUhjtXeQMQ7kNvwH57H5D&_nc_oc=AdoJ3_ciFYOgJqPNqSNS3wUbMRqzH2H1aZG2zkVTPWIHlNSNYQfghv5v8ELkH2CUAAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pzrAWhQU7RYp-XhY14gpF1CkY-zxi0n_0fbsWmh9Nvw&oe=6A2954F0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8CPlkdbvz0Q7kNvwGgZIWI&_nc_oc=AdpuNi_hUKPLf8eQkEcij9UGshX_94b9326AJfrAMxUxlHS_-PrMov4o98C3Fyj5rVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P7QrRcVKQihCyqd3TYHpPZjKtyYyJVokLujtNLZ7V_w&oe=6A296D80"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGFwrjuoQqkQ7kNvwF3x7sP&_nc_oc=Adp1csGyW94SPgvd1knsn0R8vh_02OF0SUyflP9fOJols1GICQJTTGsdwZ1dbFXENP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y2I6ejeg3ItfY7hGcrlLN0cVmzA0RbJtswC_DUVqSbg&oe=6A29590D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eYAaA1IEZoQ7kNvwGfiKGH&_nc_oc=Adp0Fn2SGshZ9GTQxfcyBb24xb0Yt-i9sFDrzFHcniaA1xjyXwH4GhvVhsALeavRsmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IQ6MiYpk3VYS19gDW0MQtLH5o33w2YvSIXJZOlnI_9Q&oe=6A296269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wA-X2-lH0oQ7kNvwFyZgds&_nc_oc=AdovzV84IWR_r5vrSScx8c3h3G0rurY7aaaNEarihsA79uihRU1lG1wtpWnqwZaduqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bOQvM1_5xFOVioQHTD-bBUmCjdFJGg2J-9IXG3l-SwQ&oe=6A2957F2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEIQsIgbVuIQ7kNvwFNNslB&_nc_oc=AdrPLZxsWtYFqsz0jKtPOSpALo0OYoWRcee5GbjA1H6pMJoSaKc3Kbw1fUm3vSg6Kfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qDutfMuek0hp_-vm5T3q9hAicqG8nJrXuKyLF4ZFqFw&oe=6A297F28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
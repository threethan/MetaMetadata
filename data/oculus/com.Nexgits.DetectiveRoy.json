.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL0306xkae4Q7kNvwFz-CI-&_nc_oc=Adq7qtvAlmzw8aSu0weTRrDMvTqeNDMFvdt-MD0myoHL6erlsN2h6-XmfUEZT2-0IpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7cFienKMQ7NQ9mFZfN4jW4Njz0lstyWSAazLDBjIoNw&oe=6A4A5AA2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aM2OloYDW4Q7kNvwHP3-hS&_nc_oc=Adqp51TJMZ9UVYMeomNiJbvmB7LuibGXE1TIRbQl8qdJ3KixMqlwiIdZgylH4f859B0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBghg8suYkvNu_OsXvKl4RRhmg9REfS9kFAG3uBBSwHvw&oe=6A4A6FF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zGXDZfCZGwQ7kNvwGK1kGA&_nc_oc=Adre0MToP1-1IR8GpbiiEBiPHhpCsTxjuUaKJBOqepQuNErAZPPiMgG_xKhSK74-Qaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwHlVnmzHHvUkdWBME1pXtyOaIgJ0E1hx9GOcP9OK7Rg&oe=6A4A82B0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_I1RaK9ftsQ7kNvwE2srAE&_nc_oc=AdqmJW_TqGZz4YJNVOKH0CzDUjTAPuTBl30d3xHY-CUewPIgof8wh7Cz7MDA_e9Nquc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6Wn7LSkxdnNWJqizL2XtbKzgChjW9d1hpBLlm9n8kAg&oe=6A4A6300"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjMA5M8IO2wQ7kNvwF36Jyv&_nc_oc=AdoKbMj29tkU8LyfeNxdU0H_3EZzbtQMAPNS3blvGnWgQXSDJbAmvxaxSigNqukSg4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-UCXYxVDSAk3DPQ9UtSH-XhMiu7z_MvBqG9StcXKiKQ&oe=6A4A86CD"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGWaG4NDDTgQ7kNvwGDpDS9&_nc_oc=AdqdTYDEl98QRMOmVaxPLhFvRnt8iQ0S0q6oKSrEltx7CEIGUHAE8_3uTXPBeWyzDlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOmaeUQCS9upP6oQ1L41_ombNwn0RuBKCBCH6amIRovQ&oe=6A4A57E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCYAy3bVkwYQ7kNvwGqR0XB&_nc_oc=Adp8VjWCkMk073GVjlskAOjmnXDybydt7uL8QnS3M9nFRAVN4h1qtKB0-mDGmaPQ7_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzpGOI4eZiSMXVYvY40VWp6EythyUJk-1SQPBmSyNTWw&oe=6A4A85B2"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhVmXx5dHvIQ7kNvwH44mvM&_nc_oc=AdrcUQuAqp7x-D5Cj6yOEjWocbzJv4--2xXZBrPBZO9tuCaeizi0HYyHARRGeFLdhK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm80al-OqMLJubnUZBsT7GiIEbsTEGsZ_j05WD89Wkew&oe=6A4A74A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
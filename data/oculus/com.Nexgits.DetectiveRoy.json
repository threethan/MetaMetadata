.png", "id": "692351868486854", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982720_692351871820187_6104350350805857881_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrmU2vseVy0Q7kNvwH2Tmqr&_nc_oc=AdoOOLrltYV2LHwNb_QAScZ8nhdumGA0jJ70izIWYi-pYc4IfkZxijvyC8XCmcD3p6Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs0W8y7eFd3RyOSCAx0Xp_5e5e4Qct5xrnppP4qcUnbg&oe=6AB675A2"}]}, "id": "1556689635441276", "locale": "en_US", "screenshots": [{"file_name": "Screen_Shot_01.png", "id": "504741654663327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375767_504741657996660_8513117437013666392_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idtct2vAHGsQ7kNvwH0PtY4&_nc_oc=Adp6uv8Zau1N_ttkcJ9t5O4evA2yoUCiu0WDRxRw4mRaGpQfKIGUcTq5GSyzec5Yiv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI28A35kJ2DVX4Fq6B_GAs8njquHGCVqHJc8oi-6_YIhQ&oe=6AB68AF8"}, {"file_name": "Screen_Shot_02.png", "id": "990264435200626", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75622018_990264438533959_7223713242811973802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNMiANos3PwQ7kNvwH-zWMS&_nc_oc=Ado6GOL2O4ZHS3q2o1oCzZtJMVL_qQwAGiHlr1ZBYDNhEoy38zKWOC5sV7C0QuaO62I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_Z3QYfzY45fYYEODx0eEckcZ1ptX7OBNip8WdYhpeTA&oe=6AB69DB0"}, {"file_name": "Screen_Shot_03.png", "id": "380058370616979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_380058373950312_3333025060895219356_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBz27zY4EVQQ7kNvwFei_4d&_nc_oc=Adq-NaqkD9zArIQDWVnzKFTAFXK74IoHtZmssSKHMtqHigj7bhVY57rAP1EWPbBCfCo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgFI6dLA3EbyXYOXHFZAlrvQeuI2ip8jYLftUaVeUQ7Q&oe=6AB67E00"}, {"file_name": "Screen_Shot_04.png", "id": "659294388672151", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036606_659294392005484_6966487471482843344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGTWQ7AyBtMQ7kNvwFR8D6T&_nc_oc=AdriPp3ZJx8ZhJgrXmkPOCVtK_d1FHZdXE9bFyf9Lt7V3POUk5XK8O-kg0JPGGIPmyw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBqx0GXdlaL5AK5oafvBjQZeVC_V-MUx--QjFodXyu2Q&oe=6AB6698D"}, {"file_name": "Screen_Shot_05.png", "id": "1181694372663104", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86646544_1181694375996437_8414353035495530575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4j4k0DLNNoQ7kNvwGwDdrf&_nc_oc=AdrDRnNoM3l3ekr0-cAnidYJrXI9GLmqUYpL2jZw0LHtC0yKc6ScES5L72Ll1V5hmXQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3fT-NWrCix8psyhB-dbkvde7phcmG8iNO3RB1A5KmXg&oe=6AB672E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image_2560 x 1440.png", "id": "1514153985652636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_1514153988985969_6511150343104976334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1aOQwY59nwQ7kNvwH5UuZg&_nc_oc=AdptHGertmMeVz4iipucZsLYe5ALRUaqDUVj1SlzEdvbwi__MQ85NR4MTAeeMZIotzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKP7lDhzCoHSVWqfWHyuUTHp65pJzgtOOFwdOCrgxv1A&oe=6AB66872"}, "display_name": "Detective Roy", "keywords": ["detective", "mystery", "puzzle", "investigation"], "long_description": "The ancient idol was missing from the National Museum. So, Detective Roy from the France spy agency have been called to investigate this case. \n\nLike a true detective, dip into the mystical detective quest where you have to use your brain and solve puzzle after puzzle in order to get closer to your target. \n\nDesigned with perfectly detailed pictures and textures. All objects look very realistic, and even small details are easily discernible. This is the game to check your detective case solving skills.\n", "short_description": "Reveal the mystery of a missing ancient Idol from the museum. Investigate scene using your detective skills. It is an interactive Suspicious game which consists of a perfect mix of cinematic storyline games, and different puzzles. Dip into the mystical detective quest where you have to solve different puzzles, discover all the clues. This is the game to check your detective case solving skills. Detective Roy is very challenging and it will check your puzzle solving skills"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexgits.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nexgits Private Limited", "support_website_url": null, "website_url": "https://nexgits.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33944698791810747"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_1030631710822694_9041651518439937953_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q8iWYNeB98Q7kNvwG83ZpS&_nc_oc=AdoRY8mtwkTB5x_hDe9D5wr04BQLReI2onJfxlFDIkIXD-m5k6MfeKbiTzbrvthXo7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzY8CAJ-E0Wj9MUZlkQ32REBnRh8m5s5EPtuMgrw4POg&oe=6AB68FA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Roy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlNUNFJE3ygQ7kNvwGQ04B-&_nc_oc=AdpjrhSvoSTgyHLMIRQDXS77ISRMCGLNY6sXEV7tPE-9e0wDizfWHgaZu2Vmc7NdR-U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzbgSxN1ALQiKQXHY1xJI9SjYpbissFjYCEJLHHN-65A&oe=6A85A4F3"}, {"file_name": "Screenshot_05.png", "id": "3767752379973714", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031379_3767752386640380_8447861101223318170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OcnyxIrNvkQ7kNvwH4x4uS&_nc_oc=AdpbxsMuhjWY5VdcASyk09u5JiB4V0J2EzdSTZowocTeyaY6reO4qiQIYpiHds3bkKc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_V4W6UYifb_gkbfmFE_M8X2R35iOhH3GlId6hJgKhiQ&oe=6A859B10"}, {"file_name": "Screenshot_01.png", "id": "3421502638137019", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75404377_3421502641470352_2710315714562841810_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLqwQSlP_f0Q7kNvwHzydDx&_nc_oc=Ado3RdUs8mU7SVUzJ3UkgNUC3X9czt3WOaoI4qxZRiU05hYTSdVU-Mnk7L7rzLf6cpc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkq6i0PfuU7Vl_lMo7PpOEPpv_hhgmiX6XYPBd02L92g&oe=6A859832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "635171461603624", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57569444_635171464936957_8156230190308559210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Wk0kFmvshoQ7kNvwFrV4YC&_nc_oc=AdpgSt_EvT4QkXrqIk0eP70TqJ-VaorA03WVNC43YN_eRfie4r1TOfOvz2hXiA8rT_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYe_9d4OEFOt3cpAG1ZDWCwYqo-T5zByLV8PZlX_kVug&oe=6A85879F"}, "display_name": "Glue", "keywords": ["productivity", "collaboration", "multiuser", "meetings", "remote"], "long_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create. Combining the best in immersive 3D graphics, virtual reality and cloud computing technology, Glue empowers teams everywhere to maximize their collaborative potential.\n\nGlue offers both FREE and PAID subscriptions to is remote collaboration platform. Within the app you can create a Glue Team and Glue Account with FREE subscription.\n\nFREE subscription offers you all the features of Glue including customizable 3D avatars, spatial audio, selection of persistent meeting spaces, full suite of collaboration tools and the team files storage for your files. \n\nWith the FREE subscription, you can have up to 10 members in your Glue Team and create up to 10 Team Spaces. FREE subscription has a session time limit of 30 minutes per session.\n\nPAID subscription options and upgrading your subscription at www.glue.work/pricing.", "short_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create.\n\nYou need to be a member of a Glue Team to use this app. You can create a free trial Glue Team within the app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glue.work/glue-privacy-policy/", "developer_terms_of_service_url": "https://glue.work/terms-and-conditions/", "publisher_name": "Glue Collaboration", "support_website_url": "https://glue.work/support/", "website_url": "https://glue.work/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
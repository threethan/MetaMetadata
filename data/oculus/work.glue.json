zWvEUQ4KUie_jCZUFnbaH9mPIag4xI3BX9naw&oe=69A585F3"}, {"file_name": "Screenshot_05.png", "id": "3767752379973714", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031379_3767752386640380_8447861101223318170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3za24BnkIJoQ7kNvwFEgSW3&_nc_oc=AdnCHG4m4BrYdkrU7rbCPkVeIUtTJQf85yiqVaxjQCodUmS0v3Gy4g1IPLlj5oBR_jI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs9LxTCG6znn3xhYofQuGyiPmeb7tpe9TMSzzGU7pje7g&oe=69A57C10"}, {"file_name": "Screenshot_01.png", "id": "3421502638137019", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404377_3421502641470352_2710315714562841810_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN18xuDtByIQ7kNvwE51bcX&_nc_oc=AdmwgGjUxGhEgQ3J_h3LF-0G_uZKSQ4lTC5NjycyD_fl0NgPcjg9PMPNPQ2cZl4MB5o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvd_OPqFuOi5JMeQINWGs57W3agVCzTN4ChVBl3URvBDw&oe=69A57932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "635171461603624", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569444_635171464936957_8156230190308559210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNR-kNcQj7UQ7kNvwHZij5e&_nc_oc=AdmKzlr2nSR63elKU7f97mmFu1nM-FCFem1-mQmbt6g1_9SjKtMEJRrAUNVh5HPbC1s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftvu1DdVI8BLULYhzjhpxqhxi-S1QKu_7pv35fFQGUevQ&oe=69A5A0DF"}, "display_name": "Glue", "keywords": ["productivity", "collaboration", "multiuser", "meetings", "remote"], "long_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create. Combining the best in immersive 3D graphics, virtual reality and cloud computing technology, Glue empowers teams everywhere to maximize their collaborative potential.\n\nGlue offers both FREE and PAID subscriptions to is remote collaboration platform. Within the app you can create a Glue Team and Glue Account with FREE subscription.\n\nFREE subscription offers you all the features of Glue including customizable 3D avatars, spatial audio, selection of persistent meeting spaces, full suite of collaboration tools and the team files storage for your files. \n\nWith the FREE subscription, you can have up to 10 members in your Glue Team and create up to 10 Team Spaces. FREE subscription has a session time limit of 30 minutes per session.\n\nPAID subscription options and upgrading your subscription at www.glue.work/pricing.", "short_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create.\n\nYou need to be a member of a Glue Team to use this app. You can create a free trial Glue Team within the app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glue.work/glue-privacy-policy/", "developer_terms_of_service_url": "https://glue.work/terms-and-conditions/", "publisher_name": "Glue Collaboration", "support_website_url": "https://glue.work/support/", "website_url": "https://glue.work/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "832650831105452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031640_1776440686082037_2077441
&_nc_ohc=3TerF5J8kpgQ7kNvwHL-R5X&_nc_oc=Ado2AW1t0QdhUt4OV8s1JvcnpFUtszQtFQv7_oGV5D3vY9qhRN1fApLgYT-J_nqnig8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu7TaOm7lxOTVefQyz3TUBgeFc8Av2sdb9D2xnHWNJ0g&oe=6A99A3B3"}, {"file_name": "Screenshot_05.png", "id": "3767752379973714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031379_3767752386640380_8447861101223318170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYCGWFmZ6GwQ7kNvwFbC7yl&_nc_oc=Adq5-qihno6bsCewf79TBU-J5qUqtkWaHdPbwgh16vYVyyOXs5y8RKioECcIzCbRajs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ7QIXU54px1xW4iYyHXSy_ZFYZnDYPOn8K__1Pq-v-g&oe=6A9999D0"}, {"file_name": "Screenshot_01.png", "id": "3421502638137019", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404377_3421502641470352_2710315714562841810_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwJEwMCiZ9gQ7kNvwHR7nwc&_nc_oc=Adq9k3RT-CMrHiMH0JY_ARK2hnO8C7lJ6V-_APWMCkDdXVD0uqs2nh2PaUW-E1Na8c8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2jaapUa6YkcybhESMIHs9G3Ten5LI0d9rDI_CykBIuA&oe=6A9996F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "635171461603624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569444_635171464936957_8156230190308559210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50vPc7ovBXYQ7kNvwFLrLHr&_nc_oc=AdopA4d6a4NDj3Zj-Nue2l9hEFgVKeKLMeAhwzxH1OX7RB7A4kSxJ0s-empM9kxPbAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyelrqWmyn6RqAAVq12vqnz_tS0T3XZ9W2nnzyi3c_eQ&oe=6A99865F"}, "display_name": "Glue", "keywords": ["productivity", "collaboration", "multiuser", "meetings", "remote"], "long_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create. Combining the best in immersive 3D graphics, virtual reality and cloud computing technology, Glue empowers teams everywhere to maximize their collaborative potential.\n\nGlue offers both FREE and PAID subscriptions to is remote collaboration platform. Within the app you can create a Glue Team and Glue Account with FREE subscription.\n\nFREE subscription offers you all the features of Glue including customizable 3D avatars, spatial audio, selection of persistent meeting spaces, full suite of collaboration tools and the team files storage for your files. \n\nWith the FREE subscription, you can have up to 10 members in your Glue Team and create up to 10 Team Spaces. FREE subscription has a session time limit of 30 minutes per session.\n\nPAID subscription options and upgrading your subscription at www.glue.work/pricing.", "short_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create.\n\nYou need to be a member of a Glue Team to use this app. You can create a free trial Glue Team within the app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glue.work/glue-privacy-policy/", "developer_terms_of_service_url": "https://glue.work/terms-and-conditions/", "publisher_name": "Glue Collaboration", "support_website_url": "https://glue.work/support/", "website_url": "https://glue.work/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
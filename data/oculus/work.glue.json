&_nc_ohc=7il3o8GO2B8Q7kNvwFS99nA&_nc_oc=Adru5uwpPt-uzJY-u0z-gRgc-rly6ZagzknV9VdZV_ZNyur-vPTEVUF_StTYo2ZqLn0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4egsBHjk--_DK7E7t6GAC8t5EFNFYCz6JOjQzA4Q-oVQ&oe=6A104F73"}, {"file_name": "Screenshot_05.png", "id": "3767752379973714", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031379_3767752386640380_8447861101223318170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTwmdy85Lv0Q7kNvwG_GyT_&_nc_oc=AdrVqzX_mRsMXtbu0Y0dQt9YrDjgEgFHzCLLqpyhAPHgVDle9uwAs63TavU8yqxE_eo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61aSW9n3FaSrlIX5_f3EIF4h3XDH503yRK73be1PPlug&oe=6A107DD0"}, {"file_name": "Screenshot_01.png", "id": "3421502638137019", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75404377_3421502641470352_2710315714562841810_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5OijTKU94MQ7kNvwH7tIj0&_nc_oc=Adq8Bj8huorlcrN8FzT3WKxXaudintsn7TfNHCg-uQk57E41X5gUgyXenwcncbE6UDg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V7YaRieEoxgqhVs_b7KyIPE3xo3DJcZSPrHfpDaRoMQ&oe=6A107AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "635171461603624", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57569444_635171464936957_8156230190308559210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQjEWOSr46EQ7kNvwGq_a32&_nc_oc=AdrLJ3Yuxnd-aHfq7PQLwKXp8eUqlwY10tVclVZwG1KSK9SNuhI7oyLWrdfsEmfWtJM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52XHTzuXnVn0jB7c45de2v93mljIYL3W9xm7z1gOOvcQ&oe=6A106A5F"}, "display_name": "Glue", "keywords": ["productivity", "collaboration", "multiuser", "meetings", "remote"], "long_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create. Combining the best in immersive 3D graphics, virtual reality and cloud computing technology, Glue empowers teams everywhere to maximize their collaborative potential.\n\nGlue offers both FREE and PAID subscriptions to is remote collaboration platform. Within the app you can create a Glue Team and Glue Account with FREE subscription.\n\nFREE subscription offers you all the features of Glue including customizable 3D avatars, spatial audio, selection of persistent meeting spaces, full suite of collaboration tools and the team files storage for your files. \n\nWith the FREE subscription, you can have up to 10 members in your Glue Team and create up to 10 Team Spaces. FREE subscription has a session time limit of 30 minutes per session.\n\nPAID subscription options and upgrading your subscription at www.glue.work/pricing.", "short_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create.\n\nYou need to be a member of a Glue Team to use this app. You can create a free trial Glue Team within the app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glue.work/glue-privacy-policy/", "developer_terms_of_service_url": "https://glue.work/terms-and-conditions/", "publisher_name": "Glue Collaboration", "support_website_url": "https://glue.work/support/", "website_url": "https://glue.work/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
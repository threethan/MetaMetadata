&_nc_ohc=eGjfS6rIqLQQ7kNvwEJY-CW&_nc_oc=AdqOKah8Zv7sGRHETx9tZaBOdsOkq_N7mD2EAxWQq1-BOx53x4pwkJb0waJwYQ7DeZU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaCgOry1Fs2NKewLfVWVVUFx_AiEUs9Vg8osxpMWCNkA&oe=6A942573"}, {"file_name": "Screenshot_05.png", "id": "3767752379973714", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031379_3767752386640380_8447861101223318170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZEP_kzcZeAQ7kNvwETgwGN&_nc_oc=AdqRN1TVOHbO0P9L5zAjjJi_kq5IxogCWSL5RB8mLLHIz73UATujSoXYpXSxlZzCVss&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdroCHNt0rWwQGthG0sKIh0wKu_wcx0JrNGxJCS0956g&oe=6A941B90"}, {"file_name": "Screenshot_01.png", "id": "3421502638137019", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75404377_3421502641470352_2710315714562841810_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21VStajk9lYQ7kNvwEs4yvG&_nc_oc=AdoN915a_EjqqM8kzeL_asM32UsQ-hR17YxO0JoKCki8ERMwff5pRY5hB8sya8knYTM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhZLK_WlyBLyGqyEH35vjfPoP6vJISkxtFC0n84M1ZaA&oe=6A9418B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "635171461603624", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569444_635171464936957_8156230190308559210_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqny5dmHGTAQ7kNvwFq0Pk2&_nc_oc=AdqKw-1T24PPrE0P-qphsTkQBZ9i7UbUpeETqRYMc7TDJHF332DjSZs99vUIw1kqdek&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEReq4RII7ENykbF7_NJVu6WuvJa6vuivM8BYlcF24GGQ&oe=6A94081F"}, "display_name": "Glue", "keywords": ["productivity", "collaboration", "multiuser", "meetings", "remote"], "long_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create. Combining the best in immersive 3D graphics, virtual reality and cloud computing technology, Glue empowers teams everywhere to maximize their collaborative potential.\n\nGlue offers both FREE and PAID subscriptions to is remote collaboration platform. Within the app you can create a Glue Team and Glue Account with FREE subscription.\n\nFREE subscription offers you all the features of Glue including customizable 3D avatars, spatial audio, selection of persistent meeting spaces, full suite of collaboration tools and the team files storage for your files. \n\nWith the FREE subscription, you can have up to 10 members in your Glue Team and create up to 10 Team Spaces. FREE subscription has a session time limit of 30 minutes per session.\n\nPAID subscription options and upgrading your subscription at www.glue.work/pricing.", "short_description": "Glue is a collaboration platform for teams who need remote meetings to be as great as face-to-face meetings. Glue brings remote teams together to learn, share, plan and create.\n\nYou need to be a member of a Glue Team to use this app. You can create a free trial Glue Team within the app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://glue.work/glue-privacy-policy/", "developer_terms_of_service_url": "https://glue.work/terms-and-conditions/", "publisher_name": "Glue Collaboration", "support_website_url": "https://glue.work/support/", "website_url": "https://glue.work/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
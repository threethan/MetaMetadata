 memories in Chimps Palace!", "short_description": "welcome to chimps palace! a gorilla tag fangame inspired by an older fangame called Monkeys Place from 2022!\nin this game you can play many modes and meet new friends and we hope you have a great time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1x2gzKygNTIgzNox2paFYgHPyqrgu3aoXP9FydzuQh8g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CzkiVewRXwvz1MBvlb32HzZBXJXyYKX6NCAk_kN7xR4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "27026223020319338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "810898911576236"}]}, "baseline_offer": {"id": "810898911576236"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775501700, "status": "PUBLISHED", "id": "810898911576236"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27060948236846816", "version": "0.35.0"}, "id": "1139270178307895", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": 
GTx5VzYrcQ7kNvwGPnvpt&_nc_oc=AdrJngehkXRcxbi_nvuq6hYkHuXC41YqjV1WaBh45_EHKw48U2EzKGbLEGxOw5gZHAA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wCBKh0s30zZyn-ATtq2kl6tQEIQdqksfum9NdPKd3Sw&oe=69EA321B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Palace", "keywords": ["Chimps", "Palace", "ChimpsPalace", "Kingdom", "Zgmonk"], "long_description": "A brand-new Gorilla Tag fangame and a full remake of our classic Chimps Kingdom, inspired by the beloved 2022 fangame Monkeys Place!\n\nStep inside a world full of fun, adventure, and endless possibilities. Explore exciting new modes, meet other players, and discover hidden surprises around every corner. Whether you\u2019re climbing, swinging, or just hanging out, Chimps Palace offers something for everyone.\n\nWe\u2019ve taken everything you loved about Chimps Kingdom and reimagined it with fresh features, improved gameplay, and a lively, vibrant environment. Gather your friends, jump in, and experience the next chapter of our gorilla-filled world.\n\nWe hope you have an amazing time and create unforgettable memories in Chimps Palace!", "short_description": "welcome to chimps palace! a gorilla tag fangame inspired by an older fangame called Monkeys Place from 2022!\nin this game you can play many modes and meet new friends and we hope you have a great time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1x2gzKygNTIgzNox2paFYgHPyqrgu3aoXP9FydzuQh8g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CzkiVewRXwvz1MBvlb32HzZBXJXyYKX6NCAk_kN7xR4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "102377078
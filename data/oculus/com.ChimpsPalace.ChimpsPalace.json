culuscdn.com/v/t64.5771-25/491820496_1287280243333146_6437842998626253037_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFFvSQJzqP4Q7kNvwFmDB2N&_nc_oc=Adrk4GWl2ZJyMyiSKcU7BsqVcFK8cQUtP95RiVMVI7-N18L7u9s6SE5HCSNrcbTuV_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1w8qZsysn6SnJ11JBEE2NndTmZDc0RJHbNCcz6DAQ-yg&oe=69F36C9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Palace", "keywords": ["Chimps", "Palace", "ChimpsPalace", "Kingdom", "Zgmonk"], "long_description": "A brand-new Gorilla Tag fangame and a full remake of our classic Chimps Kingdom, inspired by the beloved 2022 fangame Monkeys Place!\n\nStep inside a world full of fun, adventure, and endless possibilities. Explore exciting new modes, meet other players, and discover hidden surprises around every corner. Whether you\u2019re climbing, swinging, or just hanging out, Chimps Palace offers something for everyone.\n\nWe\u2019ve taken everything you loved about Chimps Kingdom and reimagined it with fresh features, improved gameplay, and a lively, vibrant environment. Gather your friends, jump in, and experience the next chapter of our gorilla-filled world.\n\nWe hope you have an amazing time and create unforgettable memories in Chimps Palace!", "short_description": "welcome to chimps palace! a gorilla tag fangame inspired by an older fangame called Monkeys Place from 2022!\nin this game you can play many modes and meet new friends and we hope you have a great time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1x2gzKygNTIgzNox2paFYgHPyqrgu3aoXP9FydzuQh8g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CzkiVewRXwvz1MBvlb32HzZBXJXyYKX6NCAk_kN7xR4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
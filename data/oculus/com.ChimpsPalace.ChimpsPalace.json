fers something for everyone.\n\nWe\u2019ve taken everything you loved about Chimps Kingdom and reimagined it with fresh features, improved gameplay, and a lively, vibrant environment. Gather your friends, jump in, and experience the next chapter of our gorilla-filled world.\n\nWe hope you have an amazing time and create unforgettable memories in Chimps Palace!", "short_description": "welcome to chimps palace! a gorilla tag fangame inspired by an older fangame called Monkeys Place from 2022!\nin this game you can play many modes and meet new friends and we hope you have a great time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1x2gzKygNTIgzNox2paFYgHPyqrgu3aoXP9FydzuQh8g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CzkiVewRXwvz1MBvlb32HzZBXJXyYKX6NCAk_kN7xR4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "27026223020319338"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821849_808217765215736_6126575875426271233_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY6sQIB-dnoQ7
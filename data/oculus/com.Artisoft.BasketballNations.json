scdn.com/v/t64.5771-25/673658581_1294854509175519_6772145497820941302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7fmhtt2nFgQ7kNvwFymMB3&_nc_oc=AdpZutlh26j49E2hqnJsz-p61nyF8RkfBR0OIqC2ouEO5QOZysZewI7MrGjzO1xRdu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfSVatLzf-7KD75V1TfWVM8amAjOZfTH115E2WGA9SVw&oe=6AA6C913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1043938534817324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1043938541483990_3210818529405068617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nB5HJm2g2gQ7kNvwGYt_PP&_nc_oc=AdrPTK4SRElusGiK0W8TqtwIR2sg9sndn9jKRJuh8NgTMeMifUuom08qX_QRu-eav4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvjRfIT2bw7pdgJzycQ2EQl7eaP6xBlf-AktJEYoSZBQ&oe=6AA6BD45"}, "display_name": "Pro Basketball Nations", "keywords": ["basketball", "dunk", "team", "basket"], "long_description": "# **Pro Basketball Nations**\n\nExperience the excitement of international basketball in VR! Take control of your players and compete for glory in immersive full-length matches against intelligent AI opponents\u2014all **offline**, no internet required.\n\nChoose from **200+ national teams** and compete in world and continental tournaments, or create your own custom competitions with your favorite nations and rules.\n\nBuilt specifically for virtual reality, Pro Basketball Nations features comfortable movement designed to minimize VR discomfort while keeping you fully immersed in the action.\n\n**Features**\n\n* 200+ national teams\n* World & continental tournaments\n* Create custom tournaments\n* Control all players\n* Intelligent AI opponents\n* Multiple difficulty levels\n* Comfortable VR gameplay\n* Fully offline\u2014no internet required\n\n# **Lead Your Nation to Glory**\n\nEvery pass matters.\n\nEvery tackle counts.\n\nEvery goal brings you one step closer to becoming world champion.\n\nPut on your headset, step onto the pitch, and experience the passion, excitement, and drama of international basketball in Pro Basketball Nations.\n\n# **List of predefined tournaments**\n * World: 1994-2023\n * Europe: 2009-2025\n * America: 2015-2025\n * Africa: 2015-2025\n * Asia: 2015-2025\n\nYou can play them as is or modify the teams. Some of the tournaments were adjusted to conform the generic template.\nFor totally custom tournaments you can select 32, 24 or 16 teams template.", "short_description": "Experience international basketball in VR! Control all players, choose from 200+ national teams, and compete in world and continental tournaments or create your own. Play full matches against intelligent AI with multiple difficulty levels. Built for comfort with optimized VR movement. No internet required\u2014play offline anytime and lead your nation to victory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bn_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://basketballnations.artisoft.pl/#", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1009903258319230"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1550559996567148"}, {"status": "PUBLISHED", "id": "4632682270288448"}]}, "baseline_offer": {"id": "4632682270288448"}, "is_app
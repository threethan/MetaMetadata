"screenshots": [{"file_name": "laxvr-screenshort-longpole.png", "id": "29871498189106304", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654865194_29871498205772969_5038331877684258160_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2PK49bJDPsQ7kNvwH4FVFr&_nc_oc=Adpvwc-4o_gjxsKHV71GhIiBxKybg2pbE81wZMm2mSf0Ly6VT3x6FV5E14jH7oahts8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7fRCJRbnB9xqcgcozOxzqlzJ9m5CFD7D5cdNj99CIlw&oe=6AFC636F"}, {"file_name": "laxvr-screenshort-SSgoalie.png", "id": "1787582672501813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_1787582679168479_9048921522959986892_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsdmYnZy_a4Q7kNvwG3eAsv&_nc_oc=Adr7M7NrEs0B3kblBu5yHnp3lR3jgR8d2tvXGyPY-lgI3i62n_ld9VVgvUF_S5tTmhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAM1JDaqZb_KpL1q0E_y_J0YBnFY5lUGET0u-7wBTfmg&oe=6AFC7916"}, {"file_name": "laxvr-screenshot-goalie.png", "id": "2082874089782185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2082874096448851_5045551991714931670_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY1FvU9txXIQ7kNvwE5hlAt&_nc_oc=AdrKXLdeWHN96UWkFbT2RFd9nPp-IrT_NNez7Eyk6DcaN5FhrHi0zpTfUholAJ6f0Mc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Y4VO5B2Vw37pvaEFMBkgbKFhCt4SNbAa9cLOT0xI5w&oe=6AFC678B"}, {"file_name": "laxvr-screenshot-sixes.png", "id": "1694226605563833", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654961355_1694226612230499_9188514482809325177_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKWhlO0V8tkQ7kNvwH3pkI3&_nc_oc=Adr2ghK2vNO3j2vU5cljKdunijK5KJGz5TSpOqjkgnCjcFPK7LOXsIqMllSjfUDk14k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_cgCvQiyi4WNZo3FgLhfBO40Lrx2vCQFmfTsIzHo-iQ&oe=6AFC6F84"}, {"file_name": "laxvr-screenshot-boxv2.png", "id": "1023365817450782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1023365820784115_5328151958810636031_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz3Oh2IlB-kQ7kNvwFsfaUY&_nc_oc=Ado2yz6kQabBr9nNuW94__oMT1TYp-iQYnnw79W5p16L7A16NQK8Zrf9cN_wvFevwWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQQt0m5YNzbq-i6kLy3wnEufKSWr9Yi2jlkrXuCLNmCA&oe=6AFC8972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "laxvr-trailer-cover.png", "id": "1594388538577727", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/765553549_1594388541911060_265033252202848535_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2_5WnhhZvQQ7kNvwGUeNFv&_nc_oc=AdouPGEaiknOyPD7m8eYrMAdX9ruRbTH_UvYk-u5mXXx7MRUGx-wcREbx8DpVirTyD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo6YP4Emsim2Ip5fjEOeJurUEYJIDjPdcJ4WtKTFPwKA&oe=6AFC6DA1"}, "display_name": "LAX VR", "keywords": ["lacrosse", "laxvr", "lax", "game", "pll"], "long_description": "# Take the Field. Go Online.\n\nLAX VR 2.0 brings the speed, skill, and intensity of lacrosse to first-person VR. The new online multiplayer mode is here: **Shoot and Save** \u2014 a 1v1 shootout where you trade shots as shooter and goalie, with 1-, 2-, 3-, and 4-point spots and sudden-death overtime. Take your shooting and goalie skills into online competition, free for all players.\n\n# Find Your Solo Game\n\nPlay **Field 6v6 or Box** and step into the action as a field player, long pole, or goalie. Chase a championship in Box or Field 6v6 tournaments, customize your twig, and compete on global leaderboards.\n\nUnique touch-controller physics capture the feel of a real stick, putting every pass, catch, and shot in your hands.\n\n# Build Your Skills\n\nFind your rhythm, sharpen your reactions, and work on your game across a range of dedicated modes:\n\n- Braveheart\n- Shooting\n- Goalie\n- Longstick\n- Shoot Around\n- Wall Ball\n\n# Go Bigger with the Expansion\n\nThe **optional paid expansion** adds full 10v10 field action and a dynamic Coach's Mode. Change middie lines, call timeouts, manage tempo, and even argue with the refs.\n\nThe expansion also includes:\n\n- A dodging challenge\n- A box-goalie skills test\n- A field-goalie workout designer for serious goalie training!\n\n**The expansion is sold separately or as part of a bundle.**\n\n# Your Stick. Your Style. Your Game.\n\n\n", "short_description": "LAX VR 2.0 is here: take the field in online multiplayer 1v1 shootouts. Play Field 6v6 and Box as a goalie, long pole, or short-stick, and sharpen your skills in Braveheart, Wall Ball, Shooting, and more. Honor lacrosse's Indigenous roots in the Medicine Game. Customize your stick, compete in tournaments, and climb the leaderboards. Feel the speed, skill, and physical intensity of lacrosse from inside the headset."}]}, "developer_name": "Duper Studios", "developer_privacy_policy_url": "https://www.laxvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Duper Studios", "support_website_url": null, "website_url": "https://www.laxvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "29082118441426113"}, "review_messages": []}]}, "cover_square_image": {"uri":
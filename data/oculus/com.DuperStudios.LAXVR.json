-2.oculuscdn.com/v/t64.5771-25/38974797_1705506346507968_8085597570849703522_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mSrwB-e0vMQ7kNvwHojFY2&_nc_oc=AdoUI0esQcMx-U6Pj-_Y9Eaqh1keCazQNowZn2Sj1JLG-QHbR69FzjAd-lxHEQZDZAg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYZ0PehL42tdKkQDyqKTVFIpjn1UzzZGG9AwL4T6szcA&oe=6AFC72B8"}, {"file_name": "laxvr-ss2-2560x1440.png", "id": "671774420528304", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982635_671774423861637_180823103724781212_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj6vd2-1aNUQ7kNvwHiG6Fl&_nc_oc=AdoerI6FVHM3LerNnDftRq3Fq0S4HL4ExL33GYZ56Wo1zKqsNBrGGF9cl-mse4OM1hA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB_4Fu5PrMPLsiKDnvWRCp2Y4qNGsQWeltH4pigzGn5w&oe=6AFC7D38"}, {"file_name": "laxvr-ss3-2560x1440.png", "id": "317993927035581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75302221_317993930368914_2866513447516295560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RILcDCybsNMQ7kNvwGGrNkO&_nc_oc=AdqNe2dk_K0e__6jzI6EmxjJlKjnnWeJ0oMoJvvyagF_os_N5YmvfYZX5ANjfB8iprA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVzngEZCfjfT9J1WKvubdZWMltJHsGWfy_03UaqhSrAw&oe=6AFC5F26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LAX VR ", "keywords": [], "long_description": "LAX VR is a lacrosse based simulation game that lets you catch passes and shoot on our AI goalie to score points.\n\nLAX VR features realistic lacrosse catching and shooting in this VR simulation, leveraging the physics engine of our game platform which enables bounce shots. Leveraging the Oculus touch controllers, the speed of your shot is based on your real shooting motion.  Shoot from different spots on the field and feeds from our AI coach.\n\nFeatures include:\n   1) Wall Ball - Build lefty/righty fundamentals on our wall.\n   2) Game Mode - Receive passes from our coach and bury them against our AI driven goalie.\n  3) Compete against others with a global leaderboard or earn achievements for great performances.\n\nYou can't always go outside and shoot on a goalie, but with LAX VR, you can get your reps in the comfort of your own home.\n\nOculus touch controllers are required.", "short_description": "LAX VR is a lacrosse based simulation game that lets you catch passes and shoot on our AI goalie to score points.\n\nLAX VR features realistic lacrosse catching and shooting in this VR simulation, leveraging the physics engine of our game platform which enables bounce shots. Leveraging the Oculus touch controllers, the speed of your shot is based on your real shooting motion.  Shoot from different spots on the field and feeds from our AI coach.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.laxvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Duper Studios", "support_website_url": null, "website_url": "https://www.laxvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "714775023019708"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1368187411882618"}, {"status": "PUBLISHED", "id": "824141717097468"}, {"status": "PUBLISHED", "id": "2108564549667936"}, {"status": "PUBLISHED", "id": "1365275231128601"}, {"sta
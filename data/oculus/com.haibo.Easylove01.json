_Af72qrPFKuNiYdcYddHz5r7ZE8iNH8K77_FSjNBWSCgcIw&oe=69FF4A34"}]}, "id": "1874801346292185", "locale": "en_US", "screenshots": [{"file_name": "BW2560new.png", "id": "397112776431492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035364_397112779764825_2294495462440801898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpTULP5oNlwQ7kNvwGrInfi&_nc_oc=AdoH8_RCk-xpqtiP3kO0EgpX1WcYYHBQrky5MlH0YbU73CWm9iXYo5lxAKbyHqbmsK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54XIhdlYh9F6kwujHY_M6FaMWZ-VPclwXr4K8lsT5u3g&oe=69FF5351"}, {"file_name": "taichi3.png", "id": "314335198339471", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356795_314335201672804_4261583471990852637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGKh6B2lHqcQ7kNvwH-tinB&_nc_oc=AdopTFx16-ik3aM6_bImngDrdclyuZG7--KPXjNWxmS-XWFN6SGHBJkKnVPFCSi9haY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TT1nAfYzCY6nWF86wF0VKytE60zvWGvdB7nE0GUlONA&oe=69FF4D19"}, {"file_name": "BW3.png", "id": "7559346240775260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375764_7559346244108593_8153257008514147015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Jm0RgRhJWQQ7kNvwFu6-f6&_nc_oc=Adoz7yUrEtF950uXE4jKE2XQh3KOndlHqupfdw43A6yeAYEM3GU3a5LE4lO6EuhL2Dg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MHscVTNC6u93CpuhFGkRUt_SxKjP-aHbIifq69QNBVQ&oe=69FF4BD8"}, {"file_name": "taichi2.png", "id": "3530283607302433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974654_3530283610635766_8076547441111351794_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUoXTm31-IYQ7kNvwFb8ke-&_nc_oc=AdpzMlaXMzKBuiE4FMLOsAQm8OBWKIyUf_L6aNecpTx4njh91XoBoeG4wfMSz3OPNKo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yXmSNxu_Rwyzmy1ORBmtf3d9JuAKnggbg99SSJwu3yw&oe=69FF2BCD"}, {"file_name": "BW2.png", "id": "333333546423981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003286_333333549757314_3466498857991109781_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esfPZvHCI4YQ7kNvwFckgxy&_nc_oc=AdoisBWwfNswi1POGsV0fGc8V55ac-t_aP__Ge5CHSlevjJKWbc19ASyyhwLPLysToc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s5DcQf8wxvB3oVQX36vOf2QpW4Lp1AFaPiaQlS5VGCA&oe=69FF2ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39035364_397112779764825_2294495462440801898_n.png", "id": "414959207922549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195910_414959211255882_8923606001836342845_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8kL0hUqXq8Q7kNvwEyDx_4&_nc_oc=AdqXCZTHEEOSI5SB1AknmjOBa9D5JpL40jb0YG5-rnG-ERwl3HmQbKS4s-Tt6EitpSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VNxkHjqgIze1W4MQ5wia8tQ_5NSqzRsQXoyfejjGb5g&oe=69FF382B"}, "display_name": "Blossom Whisper", "keywords": [], "long_description": "Introducing \"Blossom Whisper,\" a revolutionary MR game designed to unleash the magic within you through the simplest gestures: your movement and breath. This game peels away the complexities of traditional gaming, immersing you in a world where your actions create effortless beauty. Without the need for set objectives or learning complicated moves, the magic of \"Blossom Whisper\" lies in encouraging you to explore and express your physical potential in the most natural and comfortable ways.\n\nAs you launch the game, you're greeted with a cascade of petals and flower particles that respond to your every movement and breath. Imagine controlling nature, creating stunning visual effects with a wave of your hand or a deep breath, all without any prior training or instruction. \"Blossom Whisper\" celebrates your unique expression and movement, making every action a beautiful testament to your presence.\n\nTargeted towards women and teenagers, \"Blossom Whisper\" is not just a game; it's a journey to relaxation and self-discovery. It promotes a healthy lifestyle and mindfulness, creating a space where fitness and beauty blend seamlessly. With no pressure to achieve specific goals, you're free to explore the joy of movement in your own way, discovering the magic and love inherent in every gesture.\n\n\n", "short_description": "Welcome to \"Blossom Whisper,\" a MR game designed for Meta Quest VR glasses, offering a journey of art, beauty, and self-discovery. This game simplifies complexity, transforming gestures and breaths into displays of love and beauty. Your movements awaken a dance of enchanting flowers, connecting you with nature's gentle forces. More than a game, \"Blossom Whisper\" is a soulful exploration, encouraging genuine self-expression and exploration."}, {"images": {"nodes": []}, "id": "272206305943266", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u82b1\u8bed", "keywords": [], "long_description": "\u6b22\u8fce\u4f53\u9a8c\u300eBlossom Whisper\u300f\uff1a\u4e00\u6b3e\u8ba9\u9b54\u6cd5\u81ea\u7136\u91ca\u653e\u7684MR\u6e38\u620f\u3002\u5728\u8fd9\u4e2a\u72ec\u7279\u7684\u6e38\u620f\u4e2d\uff0c\u6211\u4eec\u53bb\u9664\u4e86\u4f20\u7edf\u6e38\u620f\u7684\u4efb\u52a1\u548c\u590d\u6742\u7684\u52a8\u4f5c\u6559\u7a0b\uff0c\u8ba9\u4e00\u5207\u53d8\u5f97\u7b80\u5355\u6613\u884c\u3002\u6211\u4eec\u76f8\u4fe1\uff0c\u771f\u6b63\u7684\u9b54\u6cd5\u6765\u6e90\u4e8e\u73a9\u5bb6\u81ea\u8eab\u7684\u884c\u52a8\u548c\u547c\u5438\uff0c\u800c\u300eBlossom Whisper\u300f\u7684\u6838\u5fc3\u5c31\u662f\u5229\u7528\u8fd9\u79cd\u9b54\u6cd5\u6765\u9f13\u52b1\u73a9\u5bb6\u81ea\u7136\u800c\u7136\u5730\u53d1\u6325\u4ed6\u4eec\u7684\u52a8\u4f5c\u6f5c\u80fd\uff0c\u8ba9\u6bcf\u4e00\u4e2a\u52a8\u4f5c\u90fd\u5145\u6ee1\u4e86\u7f8e\u4e3d\u548c\u9b54\u6cd5\u3002\n\n\u6e38\u620f\u64cd\u4f5c\u6781\u5176\u7b80\u5355\uff1a\u5f00\u542f\u6e38\u620f\uff0c\u5373\u523b\u6c89\u6d78\u5728\u4e00\u4e2a\u7531\u4f60\u7684\u624b\u52bf\u548c\u6df1\u547c\u5438\u9a71\u52a8\u7684\u8ff7\u4eba\u82b1\u6735\u4e16\u754c\u3002\u6ca1\u6709\u9884\u8bbe\u7684\u52a8\u4f5c\u8981\u6c42\uff0c\u6ca1\u6709\u590d\u6742\u7684\u89c4\u5219\u9700\u8981\u5b66\u4e60\u3002\u53ea\u8981\u4f60\u79fb\u52a8\u4f60\u7684\u53cc\u624b\uff0c\u6df1\u547c\u5438\uff0c\u4f60\u5c31\u80fd\u770b\u5230\u7f8e\u4e3d\u7684\u82b1\u74e3\u548c\u82b1\u6735\u7c92\u5b50\u968f\u4e4b\u98d8\u52a8\uff0c\u4eff\u4f5b\u62e5\u6709\u4e86\u63a7\u5236\u81ea\u7136\u7684\u529b\u91cf\u3002\u8fd9\u4e9b\u89c6\u89c9\u7279\u6548\u4e0d\u4ec5\u7f8e\u4e3d\u8ff7\u4eba\uff0c\u66f4\u662f\u5bf9\u4f60\u7684\u6bcf\u4e00\u4e2a\u52a8\u4f5c\u548c\u6bcf\u4e00\u6b21\u547c\u5438\u7684\u79ef\u6781\u54cd\u5e94\uff0c\u9f13\u52b1\u4f60\u4ee5\u6700\u81ea\u7136\u3001\u6700\u8212\u9002\u7684\u65b9\u5f0f\u63a2\u7d22\u548c\u8868\u8fbe\u81ea\u5df1\u3002\n\n\u300eBlossom Whisper\u300f\u7684\u8bbe\u8ba1\u7406\u5ff5\u662f\u8ba9\u6bcf\u4e2a\u4eba\u90fd\u80fd\u8f7b\u677e\u4f53\u9a8c\u5230\u52a8\u4f5c\u7684\u4e50\u8da3\u548c\u5fc3\u7075\u7684\u653e\u677e\uff0c\u65e0\u8bba\u4f60\u7684\u52a8\u4f5c\u5982\u4f55\u81ea\u7531\u53d1\u6325\uff0c\u5c55\u73b0\u51fa\u6765\u7684\u6548\u679c\u90fd\u662f\u7f8e\u4e3d\u7684\u3002\u8fd9\u79cd\u7b80\u5355\u800c\u76f4\u63a5\u7684\u4e92\u52a8\u65b9\u5f0f\u5b9a\u4e49\u4e86\u6e38\u620f\u4e2d\u7684\u7f8e\u4e3d\uff0c\u5b83\u4e0d\u4ec5\u5f00\u542f\u4e86\u73a9\u5bb6\u81ea\u8eab\u7684\u52a8\u4f5c\u6f5c\u80fd\uff0c\u4e5f\u8ba9\u6bcf\u4e2a\u4eba\u7684\u72ec\u7279\u9b45\u529b\u5f97\u4ee5\u5145\u5206\u5c55\u73b0\u3002\n\n\u4e3a\u5973\u6027\u548c\u9752\u5c11\u5e74\u91cf\u8eab\u6253\u9020\uff0c\u300eBlossom Whisper\u300f\u4e0d\u4ec5\u662f\u4e00\u6b3e\u6e38\u620f\uff0c\u66f4\u662f\u4e00\u6b21\u5fc3\u7075\u7684\u65c5\u7a0b\uff0c\u4e00\u4e2a\u9f13\u52b1\u8eab\u5fc3\u5065\u5eb7\u3001\u7f8e\u4e3d\u548c\u81ea\u6211\u8868\u8fbe\u7684\u5e73\u53f0\u3002\u5728\u8fd9\u4e2a\u6e38\u620f\u4e2d\uff0c\u7b80\u5355\u5c31\u662f\u4e00\u5207\u3002\u4f60\u4e0d\u9700\u8981\u6210\u4e3a\u52a8\u4f5c\u9ad8\u624b\uff0c\u4e5f\u4e0d\u9700\u8981\u8ffd\u6c42\u5b8c\u7f8e\u7684\u6280\u5de7\u3002\u53ea\u8981\u4f60\u5728\u6e38\u620f\u4e2d\u4ee5\u81ea\u5df1\u7684\u65b9\u5f0f\u79fb\u52a8\u548c\u547c\u5438\uff0c\u90a3\u4e48\u7f8e\u4e3d\u548c\u9b54\u6cd5\u5c31\u4f1a\u968f\u4e4b\u800c\u6765\u3002\n\n\u73b0\u5728\uff0c\u5c31\u8ba9\u6211\u4eec\u4e00\u8d77\u5728\u300eBlossom Whisper\u300f\u4e2d\uff0c\u7528\u6700\u8f7b\u677e\u81ea\u5728\u7684\u65b9\u5f0f\u91ca\u653e\u5185\u5fc3\u7684\u9b54\u6cd5\uff0c\u53d1\u73b0\u81ea\u5df1\n", "short_description": "\u6b22\u8fce\u4f53\u9a8c\u300eBlossom Whisper\u300f\uff1a\u4e00\u6b3e\u4e13\u4e3aMeta Quest\u7cfb\u5217VR\u773c\u955c\u6253\u9020\u7684MR\u8212\u9002\u7f8e\u80b2\u6e38\u620f\u3002\u5728\u8fd9\u91cc\uff0c\u4e00\u5207\u590d\u6742\u7684\u89c4\u5219\u548c\u4efb\u52a1\u90fd\u88ab\u7b80\u5316\uff0c\u8ba9\u6bcf\u4e00\u6b21\u52a8\u4f5c\u548c\u547c\u5438\u90fd\u81ea\u7136\u5730\u7efd\u653e\u51fa\u7231\u4e0e\u7f8e\u4e3d\u3002\u5728\u300eBlossom Whisper\u300f\u4e2d\uff0c\u7b80\u5355\u7684\u624b\u52bf\u4fbf\u80fd\u5524\u9192\u8ff7\u4eba\u7684\u82b1\u6735\uff0c\u8ba9\u4f60\u611f\u53d7\u5230\u638c\u63a7\u81ea\u7136\u7684\u529b\u91cf\u3002\u8fd9\u4e0d\u4ec5\u662f\u4e00\u573a\u6e38\u620f\uff0c\u5b83\u662f\u4e00\u6b21\u5fc3\u7075\u7684\u65c5\u7a0b\uff0c\u9f13\u52b1\u4f60\u4ee5\u6700\u81ea\u7136\u7684\u65b9\u5f0f\u53bb\u63a2\u7d22\u548c\u8868\u8fbe\u81ea\u6211\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.youtube.com/@watercolorstory3676/community", "developer_terms_of_service_url": null, "publisher_name": "Haibo", "support_website_url": null, "website_url": "https://www.facebook.com/PainterHaibo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
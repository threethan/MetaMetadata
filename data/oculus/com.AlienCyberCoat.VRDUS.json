3116_1579123899851695_1652542805634127257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDbhfZzMRikQ7kNvwGPTjFS&_nc_oc=AdqWpXD61oYC0QjVZwvhF1YBic7nizivNAPoNVe_h_-Db5EzPR7FUyruiN9EiVi--rc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nYJdpYNGruZMqVFPuibivGrNARPpqVDHo5-jjRzogiw&oe=6A01CFB1"}, {"file_name": "meta2.png", "id": "1199978572293102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619704_1199978575626435_8474659023936375992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inW4mcWOLoQQ7kNvwEmVIWM&_nc_oc=Adqw9ORo98OmKMxmo1BeV4VjLCln5-PQk4BkKbvhqryqSH7MheC8HqeyfX6kNQxF90U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UwmWBT-A4TduRv9KWSob0gQ5kruuD9Qlh_OojW1_pTA&oe=6A01EE08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jamRoom.png", "id": "26372411479036233", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303140_26372411499036231_7127827799295634246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcc9cpKRaLIQ7kNvwFO3Uwq&_nc_oc=AdrzwxSPsqi5JhEfuaobAS2iZu7GpaLGBLvjuLf8SuEBtsVL_s8VMUuxz6CI2nBd7Oc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q2mIPOepFyxofdbMzCAxKLgrVAVlDicTo6aNygb75iQ&oe=6A01C8F2"}, "display_name": "VR Drums Ultimate Streamer", "keywords": ["drums", "music", "drumming", "drum", "musician"], "long_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Practice drumming at all hours with gear that never wears. Move the kit anywhere, cover songs, use with a band.\n\n2D and 3D note highways in-game, add your Clone Hero .mid song folders. Also an advanced 23 lane raw .mid player and note highway.\n\nDrum kits are highly customizable, all your applied settings will save when you save your kit. Multiple save slots to save multiple kit creations.\n\nMixed reality passthrough option. Place and play the drums in your own living space, see your real world surroundings around you as you drum or while you're playing with your band.\n\nModify each drum sound, head tuning, shells, use different realistic drum heads, cymbals, and hi-hats.\n\nFeatures:\n- Save and load slots.\n- In-game audio and video players. \n- Spawn standard drums or electronic drum pads.\n- Pressure sensitive hits.\n- Custom drum racks.\n- Bass and hi-hat foot pedals.\n- .Mid Player\n- Unlimited drum spawning and drag 'n drop placement. \n- Optional hardware for bass and hi-hat foot pedals. (USB)\n- Recording tools for making third person style drum videos, with custom avatars.\n\nIncluded:\n30+ snare drums, 10+ bass drums, 10+ crash cymbals, 5 ride cymbals,  splash cymbals, tom drums, with multiple heads. Roto toms, 6 different hi-hats (rock, 50's, metal, thrash etc.), china cymbals, custom china's, tube toms, chimes, tambourine, cow bells and more.", "short_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Drum anytime, anywhere.\n\nPractice, cover your favorite songs, now drum at all hours of the night. Create your own highly customizable kits that  save your applied settings. There are multiple save slots to save multiple kit creations. Add your own media .WAV/.MP3/.OGG/.MP4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
c_sid=6e7a0a&_nc_ohc=VBZddBaKa24Q7kNvwFL8BZ4&_nc_oc=AdqNCrKBVtvprPSiXMk_Y9vCtWFkXqYRzKVvYJeXel7-EThKx31dBHi1MVCML-3_f1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGknwTE3ClZDGCGQ5HLjFnT9tINv0yk7nlSab7_lQX-DQ&oe=6A7C7A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerThumb.png", "id": "6866505960070899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031557_6866505966737565_4554394408291032221_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gcxmUC9Xi8Q7kNvwEWoRAu&_nc_oc=AdqqT_KfqPXgtUosXeDtqH54CJtst3_L76_o1GJ-rz7Sm1HlYVrnQJyZdD8uLel_5pw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOS1fHjacWj6s7EVEBZn8hItoLWmd258KU5xPtseF2Bw&oe=6A7C5DB5"}, "display_name": "VR Drums Ultimate Streamer", "keywords": [], "long_description": "A VR musical instrument simulator of a full drum kit. Practice in the privacy of VR, play and mod your drum set however you like. \n\nPlay the VR drum kit to your favorite music. (You must provide the music source)\n\nThis project was started when we were not able to own a real physical drum set anymore. It has been tuned the past 2 years and has brought us the feeling we were striving for. I hope it can bring others the same joy. We believe we have become better drummers from what we were, practicing in this game.", "short_description": "A VR drum kit instrument simulator. Practice in the privacy of VR, play and mod your own realistic looking drum set."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}]
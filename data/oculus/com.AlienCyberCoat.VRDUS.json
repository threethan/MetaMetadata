1-25/499619174_2083235809165777_9150588118684611607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9bV6CpSiWIQ7kNvwF9O0jR&_nc_oc=Adr9hlCozO01cPIA6HS1RovW3fS2wMJNq6z9_zH8aszgcHwx8e7mFewbacc0YTsSbzQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYc2rb1tMcCPQJk5qrYO1RQVTzjb4VQdgx4an4z6bPQg&oe=69CF9E92"}, {"file_name": "SCREEN1.png", "id": "1256808242836729", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499340151_1256808246170062_8647785745052122175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBN_TjKEsWcQ7kNvwHAX9CP&_nc_oc=Adp0Qe7JxVnRZ0nZ9E1bqMvGX8F38byKmai8sqBsifWn3uD21ntNdjgQOTvqhQF9Suk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVpDZPw0WwLqCjP_DLqbKPcPB8lI1YINPzobNdy4SANA&oe=69CFCD78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "m_screenShot6.png", "id": "1471508310555039", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618252_1471508313888372_6565931401660019656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsUTBtI8ZekQ7kNvwEZI9ed&_nc_oc=Adqqx-31CUkFSHIHpoxY0ZDOCbcd1pgQjb4YUADj1fFgZ3NK9e1G-Fa3Ny33WpL4Mzk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9-G1Ay7YdsLoUsGV58GUMTWIvg8Om7Acbsx3SYM1hOg&oe=69CFB0C0"}, "display_name": "VR Drums Ultimate Streamer", "keywords": ["drums", "music", "drumming", "drum", "musician"], "long_description": "A realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Practice drumming, start covering your favorite songs, drum anytime, anywhere.\n\nDrum kits are highly customizable, all your applied settings will save when you save your kit. Multiple save slots to save multiple kit creations.\n\nMixed reality passthrough option. Place and play the drums in your own living space, see your real world surroundings around you as you drum or while you're playing with your band.\n\nModify each drum sound, head tuning, shells, use different realistic drum heads, cymbals, and hi-hats.\n\nFeatures:\n- In-game save and load slots.\n- In-game audio and video players. \n- Spawn standard drums or electronic drum pads.\n- Pressure sensitive strikes.\n- Custom drum racks.\n- Bass and hi-hat foot pedals.\n- Unlimited drum spawning and drag 'n drop placement. \n- Optional hardware for bass and hi-hat foot pedals. (USB)\n- Recording tools for making third person style drum videos, with custom avatars.\n\nIncluded:\n30+ snare drums, 10+ bass drums, 10+ crash cymbals, 5 ride cymbals,  splash cymbals, tom drums, with multiple heads. Roto toms, 6 different hi-hats (rock, 50's, metal, thrash etc.), china cymbals, custom china's, tube toms, chimes, mounted tambourine, cow bells and more.\n\nExtra: A 2D or 3D highway mode in-game, add Clone Hero format drum .chart songs and swing to the notes on the 3d highway where each note is a flying disc.", "short_description": "A realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers.  Drum anytime, anywhere.\n\nPractice, cover your favorite songs, or drum at all hours of the night. Create your own highly customizable kits that  save your applied settings. There are multiple save slots to save multiple kit creations. Add your own media .WAV/.MP3/.OGG/.MP4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
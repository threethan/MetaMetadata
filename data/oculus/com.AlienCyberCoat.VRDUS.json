1-25/499303116_1579123899851695_1652542805634127257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncjksqOxNEgQ7kNvwHex9PS&_nc_oc=AdrHkCgim0cP15nFqiK6jfkizJEQJg4z_U3ONMXYUTTEeTpYT-qfIRZ-PemGLpi8Nk8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_sCs9-Dgxeww-4OQFe8t8r0Vklq4C8-J9udsFNQgVoQ&oe=6A11A1B1"}, {"file_name": "meta2.png", "id": "1199978572293102", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619704_1199978575626435_8474659023936375992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7pWc7UAqysQ7kNvwH3k962&_nc_oc=Ado5oQHN5MSlVVTL-f4uRpSyh1yQBKb2uSB6xLBI98dO0XFpn2AeEQcJBX-Q6_Bjeew&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q-kqG320gRPFeani7uSo4TlKNa4OgYYMnZxYv4F672A&oe=6A11C008"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoPhoto.png", "id": "1659218571955441", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298150_1659218575288774_8994548391396755234_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX-qOYYqQYgQ7kNvwEE7N1x&_nc_oc=AdpkqWo2tpiGGgK9sWFhAp-BZ7CzMxuLpRb78Nqng4MCEcll0rpM22JuIbrDEOG2ZGU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hhqYK7jsF3EzyBXz99ZJoVuPqg5gBN2upt2p2Gd_vfA&oe=6A11D0AE"}, "display_name": "VR Drums Ultimate Streamer", "keywords": ["drums", "music", "drumming", "drum", "musician"], "long_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Practice drumming at all hours with gear that never wears. Move the kit anywhere, cover songs, use with a band.\n\n2D/3D note highways, add your custom Clone Hero drum song folders. Also an advanced 23 lane raw .mid player note highway.\n\nDrum kits are highly customizable, all your applied settings will save when you save your kit. Multiple save slots to save multiple kit creations.\n\nMixed reality passthrough option. Place and play the drums in your own living space, see your real world surroundings around you as you drum or while you're playing with your band.\n\nModify each drum sound, head tuning, shells, use different realistic drum heads, cymbals, and hi-hats.\n\nFeatures:\n- Save and load slots.\n- In-game audio and video players. \n- Spawn standard drums or electronic drum pads.\n- Pressure sensitive hits.\n- Custom drum racks.\n- Bass and hi-hat foot pedals.\n- .Mid Player\n- Unlimited drum spawning and drag 'n drop placement. \n- Optional hardware for bass and hi-hat foot pedals. (USB)\n- Recording tools for making third person style drum videos, with custom avatars.\n\nIncluded:\n30+ snare drums, 10+ bass drums, 10+ crash cymbals, 5 ride cymbals,  splash cymbals, tom drums, with multiple heads. Roto toms, 6 different hi-hats (rock, 50's, metal, thrash etc.), china cymbals, custom china's, tube toms, chimes, tambourine, cow bells and more.", "short_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Drum anytime, anywhere.\n\nPractice, cover your favorite songs, now drum at all hours of the night. Create your own highly customizable kits that  save your applied settings. There are multiple save slots to save multiple kit creations. Add your own media .WAV/.MP3/.OGG/.MP4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
.com&oh=00_Af0o-E8tnBvN6cJ7fDADiwsr7ZCWdJbTVDt3SYq3tgBH5A&oe=69F0CB10"}, {"file_name": "s4.png", "id": "748534227309832", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974899_748534230643165_2347223058285118564_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82mQAjLlm6QQ7kNvwFZdtWq&_nc_oc=Adrglc03yCYTMAZNB4Ie2-8tBvcBVPjGZYPfB9F8qmL2hCoC3WkPoCX2mHUHsGkV0dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2EZ9vhQn87ybZObtUgxJzZH2x5dcLoW7lPWGAHf8UGdA&oe=69F0C644"}, {"file_name": "s5.png", "id": "357518203678417", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302218_357518207011750_4579930035608897030_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRA5syCMRqIQ7kNvwEUFHo9&_nc_oc=Adr4eMfGjTOU9fvIIKpq7PGDC56DBruOs5eyQKX-0JNn9iGOA-cAn6HTsvvF8F81dsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3eQ1q6yX5sDo-oBVvOS5MP_PPNVMCd11mH7jPf_Hs-GA&oe=69F0BB22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerThumb.png", "id": "6866505960070899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031557_6866505966737565_4554394408291032221_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kutWAY8uMJEQ7kNvwFeAyET&_nc_oc=AdpAjul0mMHCBfx1oA0FZ438KqBLJb9xLqa2OgMt6SuhKjPlTpH67kxB1-Jq9BzCg38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0XOvi8KvhBIyOwuK9VCNfa0HNA4kI7xqxDfq08UNZr5w&oe=69F09EB5"}, "display_name": "VR Drums Ultimate Streamer", "keywords": [], "long_description": "A VR musical instrument simulator of a full drum kit. Practice in the privacy of VR, play and mod your drum set however you like. \n\nPlay the VR drum kit to your favorite music. (You must provide the music source)\n\nThis project was started when we were not able to own a real physical drum set anymore. It has been tuned the past 2 years and has brought us the feeling we were striving for. I hope it can bring others the same joy. We believe we have become better drummers from what we were, practicing in this game.", "short_des
083235809165777_9150588118684611607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGy2tgDMelgQ7kNvwHfRnBc&_nc_oc=AdoFTbGmaQpCX0XpFDzT434tUMevQL29vc96cHxllNB2IGZVsylPmUfuVK6r0SnjqOk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dNJq-aM28pJnTDdO1L13a6Zla54n41ZJ-38Lc3xRAhQ&oe=69EF7AD2"}, {"file_name": "nh33.png", "id": "4400224390218219", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821919_4400224393551552_3802144979390529888_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXrpLi0FrDUQ7kNvwEqWQ-y&_nc_oc=AdpnRAlsHRSkZl0YdkZ1gR6DupQHGdtVw_Uk-TVIaefdgzxIiqOdeZzHNmnwfVoDtcg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GY562KCd8T_iAkIa2Dz5xscMgOShrZs-tK-ynWIw7-A&oe=69EF75E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jamRoom.png", "id": "26372411479036233", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303140_26372411499036231_7127827799295634246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SrdzyS8MZUQ7kNvwEvq6Vj&_nc_oc=AdqhfV_Xv-L7W1xD3SJs_0990YM9rwnMtSer4odt7N4bsU1NwCA0lb0N9bKQumbk0kI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Co0x1qnIVXcII3N_j3LPONXL6r4vIpSTxBZ17la3bQg&oe=69EF53F2"}, "display_name": "VR Drums Ultimate Streamer", "keywords": ["drums", "music", "drumming", "drum", "musician"], "long_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Now practice drumming, at all hours, cover songs, use live, anywhere.\n\nDrum kits are highly customizable, all your applied settings will save when you save your kit. Multiple save slots to save multiple kit creations.\n\nMixed reality passthrough option. Place and play the drums in your own living space, see your real world surroundings around you as you drum or while you're playing with your band.\n\nModify each drum sound, head tuning, shells, use different realistic drum heads, cymbals, and hi-hats.\n\nFeatures:\n- In-game save and load slots.\n- In-game audio and video players. \n- Spawn standard drums or electronic drum pads.\n- Pressure sensitive strikes.\n- Custom drum racks.\n- Bass and hi-hat foot pedals.\n- Unlimited drum spawning and drag 'n drop placement. \n- Optional hardware for bass and hi-hat foot pedals. (USB)\n- Recording tools for making third person style drum videos, with custom avatars.\n\nIncluded:\n30+ snare drums, 10+ bass drums, 10+ crash cymbals, 5 ride cymbals,  splash cymbals, tom drums, with multiple heads. Roto toms, 6 different hi-hats (rock, 50's, metal, thrash etc.), china cymbals, custom china's, tube toms, chimes, tambourine, cow bells and more.\n\nExtra: 2D and 3D note highways in-game, add Clone Hero song .chart or .mid song folders. Also MIDI out beta testing.", "short_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers.  Drum anytime, anywhere.\n\nPractice, cover your favorite songs, or drum at all hours of the night. Create your own highly customizable kits that  save your applied settings. There are multiple save slots to save multiple kit creations. Add your own media .WAV/.MP3/.OGG/.MP4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": n
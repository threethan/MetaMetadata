1-25/499619187_932909495836377_7484493455805764246_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtLVj63CewIQ7kNvwHkJf5t&_nc_oc=AdrbwKZLoVSUzUxzfd7lx-kdOp9jXWe3p3HB-AsjyBsCdjWIFTWaUvfEtdgX_fu2XjM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlhhD2x6yC6Qe61lLMm5T1oV0WwYj6SErQbTU3Ty0G3Q&oe=69C5104B"}, {"file_name": "SCREEN1.png", "id": "1256808242836729", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499340151_1256808246170062_8647785745052122175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2z4LARllCUQ7kNvwGZ_cJA&_nc_oc=AdpMsn5Nr-Ypf6GFLWsGUvTmRKF8MN3bK66N7DZaepQ3iAvdpyrBcpbhOVf7Nt7QHsk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv8IUy6Plz6xCpFImQneyBXmO-HnrQOsbASgsiZW9rvA&oe=69C54178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "m_screenShot6.png", "id": "1471508310555039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618252_1471508313888372_6565931401660019656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijBOgf06FYgQ7kNvwE4LyQQ&_nc_oc=AdrgBtknD_Jh529AUmrjSefIbE4t8-96bH8LyV6CCMgTMvnhhSnofphbyEsd81W0BJc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4SyFiH_dGQpxZhITmDGyXkz14Io785UfAC59c4mIwiw&oe=69C524C0"}, "display_name": "VR Drums Ultimate Streamer", "keywords": ["drums", "music", "drumming", "drum", "musician"], "long_description": "A realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Practice drumming, start covering your favorite songs, drum anytime, anywhere.\n\nDrum kits are highly customizable, all your applied settings will save when you save your kit. Multiple save slots to save multiple kit creations.\n\nMixed reality passthrough option. Place and play the drums in your own living space, see your real world surroundings around you as you drum or while you're playing with your band.\n\nModify each drum sound, head tuning, shells, use different realistic drum heads, cymbals, and hi-hats.\n\nFeatures:\n- In-game save and load slots.\n- In-game audio and video players. \n- Spawn standard drums or electronic drum pads.\n- Pressure sensitive strikes.\n- Custom drum racks.\n- Bass and hi-hat foot pedals.\n- Unlimited drum spawning and drag 'n drop placement. \n- Optional hardware for bass and hi-hat foot pedals. (USB)\n- Recording tools for making third person style drum videos, with custom avatars.\n\nIncluded:\n30+ snare drums, 10+ bass drums, 10+ crash cymbals, 5 ride cymbals,  splash cymbals, tom drums, with multiple heads. Roto toms, 6 different hi-hats (rock, 50's, metal, thrash etc.), china cymbals, custom china's, tube toms, chimes, mounted tambourine, cow bells and more.\n\nExtra: An arcade highway mode in-game, add Clone Hero format drum .chart songs and swing to the notes on the 3d highway where each note is a flying disc.", "short_description": "A realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers.  Drum anytime, anywhere.\n\nPractice, cover your favorite songs, or drum at all hours of the night. Create your own highly customizable kits that  save your applied settings. There are multiple save slots to save multiple kit creations. Add your own media .WAV/.MP3/.OGG/.MP4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33899899689656274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499295701_1305304801243753_3333124186300261359_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSGdWOewzZkQ7kNvwHNof-5&_nc_oc=Adq1m9rgkRP3lkyK6m-xoAj_ZJLVROmkZEX_PYYBvPTPZ3uaVDOzULyAiT4rBv1hocY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwvlSa9-BvHm34jKw6RpwUDbBXbBiJmprVe5PAfHQ1ew&oe=69C54209"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Drums Ultimate Streamer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1706725464, "lastRevision": {"nodes": [{"id": "24141290328850641", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24141290282183979", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "877926617042526"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "ph2.png", "id": "2321701914707341", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75196223_2321701918040674_6136388579533290885_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXZRqkk40QQQ7k
, "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314623_1825875221736133_8211674644666625614_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzAWmT0zagIQ7kNvwETanJN&_nc_oc=AdrlD-vISEcUmyjPNDdPBy0qf7z1N4TDU0UGuSmasg-1_Ddq64mK22dMHt0L2oIlbls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh-M0VNCw6v2bQpz3UY1mE3R60Xo0XYr7A9lJCHSY-Tg&oe=6ADCACD3"}, {"file_name": "screen6.png", "id": "27380673564898388", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302527_27380673574898387_2732964180917032736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY17Qem4LIUQ7kNvwE7uv5z&_nc_oc=AdqRyVIu3jRbukuKFAc0QzguHoRWSn1T17Gd_5cL3rlFswi2ihQK8Udq49MzvGZGSQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO__t6BY08G-oqD-p2dugh9soteSojPxCAJRIxGoBPhYA&oe=6ADCCA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoPhoto.png", "id": "1659218571955441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298150_1659218575288774_8994548391396755234_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-adxrSO6ToQ7kNvwFX6ddE&_nc_oc=AdqNDQSaEmvb_sIEbycXoxn11nbA_WIuDd-nzgAyG66Uf_Gv-CJ7KCW1_1DTbEPfGHQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONEDHq-HTWBOKUL85xbQZexgJ9YVQ69ZsVzOnr4CD6ow&oe=6ADCD7AE"}, "display_name": "VR Drums Ultimate Streamer", "keywords": ["drums", "music", "drumming", "drum", "musician"], "long_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Practice drumming at all hours with gear that never wears. Move the kit anywhere, cover songs, use with a band.\n\n2D / 3D note highways, add your custom Clone Hero drum song folders and other drumming rhythm games like .rlrr customs.\n\nCustom Song Support:\n- .chart\n- .mid\n- .rlrr\n\nDrum kits are highly customizable, all your applied settings will save when you save your kit. Multiple save slots to save multiple kit creations.\n\nMixed reality passthrough option.\n\nModify each drum sound, head tuning, shells, use different realistic drum heads, cymbals, and hi-hats.\n\nYou can shop the in-game store to purchase more drum hardware for your custom drum kits.\n\nFeatures:\n- Save and load slots.\n- In-game audio and video players. \n- In-game store for even more hardware.\n- Multiplayer.\n- Pressure sensitive hits.\n- Drum racks.\n- Bass and hi-hat foot pedals.\n- .Mid Player\n- Unlimited drum spawning drag 'n drop placement. \n- Connect optional hardware for bass and hi-hat foot pedals. (USB)\n- Recording tools for making third person style drum videos and avatars.\n\nIncluded:\n30+ snare drums, 10+ bass drums, crash cymbals, ride cymbals,  splash cymbals, tom drums, with multiple heads, hi-hats, china cymbals, bells, chimes, cow bells and more.", "short_description": "Realistic and customizable drum kit simulator made by drummers for drummers. Used by beginners and real world professional session drummers. Drum anytime, anywhere.\n\nPractice, cover your favorite songs, now drum at all hours of the night. Create your own highly customizable kits that save your applied settings. There are multiple save slots to save multiple kit creations. Add your own media .WAV/.MP3/.OGG/.MP4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", 
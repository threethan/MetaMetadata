_1790164652269081_7443792269330492519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uzZxG87jCgQ7kNvwHvcmzo&_nc_oc=AdqRBNrTGSuFGS_wt1oSBOnuPH6HxMPN44eNqG-j16W6GyAPLIacSbNJ7Y0K1kRn0mE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8aaSbcrkdBvUhrGaYDl8lPZ8__PZ9fKMd-JkjVtQOrw&oe=6AF477F0"}, {"file_name": "08.png", "id": "3008549089487580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_3008549099487579_4938491692826644189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaKsjCI2V9YQ7kNvwHzblbz&_nc_oc=AdqAuGzkmYpDwt-fzZNafDaU49KOOJQW10DohSfboX9o6n31gDUjhdr1XBr8qQ_-Lg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcbYJaFmj-N4ozR64Da7BZNbSDfMSryu_p81E8R9PGVg&oe=6AF474B0"}, {"file_name": "03.png", "id": "1828933988108048", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1828933991441381_8747031393574171743_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89ZDfGwiW_YQ7kNvwHRdf-P&_nc_oc=AdpktBwxyuH35Y_2RPU1p6ffgei0jYRyhIvIj-8Ngi0m2u5u9K0wI1F9YTOEeQjg9jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg8tXkIP6SDitY8pUM2gyNgSbqiHDNe94iVprdtrnVgA&oe=6AF48EF2"}, {"file_name": "17.png", "id": "1585211630017042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1585211633350375_5577857086258432576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGvtPXMOI_kQ7kNvwHhDNZC&_nc_oc=AdqSMgqQpIaRZMWolIix-qReHVL4vAL56CevSqEb9Sbd2q_6Qvg2Pak-qUu4kFPOG_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJMkO4ErCzY3EW9o7sFm_5rxEQ60e4_TgccgqbE16hPA&oe=6AF49097"}, {"file_name": "05.png", "id": "1628259795569003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_1628259798902336_6174198265879925541_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r01Spfj9t3cQ7kNvwH30cq8&_nc_oc=Adr9sY_AgSqldqFcy2lxD_5ZELpbcKUP2zeGTtRiG4NWagm8IHBhOxAbHgriLa32m30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqIkSOxG1mkZkIBHz59BrZGBfMhNS7jzQZA_XXeg-WgQ&oe=6AF48328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RC2000_Trailer_Cover_2560x1440.png", "id": "1586619116125752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1586619119459085_1855939237838899033_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaXHetzQp4kQ7kNvwFNQjBa&_nc_oc=AdoMAxSglhSVgRcs2mCo8YEtSmxPPuetAdquJQG2Ep6HkdQemcFKoqB9T800ERI1M6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTwoFE9TpYvCgm25YeTPmurt7O7gGN0y2r-WV5Q76SYA&oe=6AF4A572"}, "display_name": "Retro Coder 2000", "keywords": ["programming", "hacking", "retro", "puzle", "simulation"], "long_description": "It's 1991. Your brother is gone. What he left is his room, a beige PC, a dial-up modem, a stack of floppies and a rent bill with a deadline.\n\nTHE PC IS REAL\nBoot it, install games from floppies, buy a faster CPU, video card and hard disk and switch them on in the BIOS. Everything runs on a simulated machine, and every program can be opened and changed.\n\nWORK THE LINE\nDial in, read your mail and take jobs: fix broken programs, decode secret messages, test games. Get paid (eventually), build trust and chase the clients who don't pay.\n\nGO DEEPER\nFollow the white rabbit into a hidden network. Scan hosts, sniff traffic and crack passwords in puzzles that reward skill, not luck. Somewhere at the end of the trail is the reason your brother disappeared.\n\nMAKE YOUR OWN\nLearn the built-in language step by step, then make 2D, tile-map or 3D games, pack them onto floppies and publish them. After the story, free play keeps the whole machine yours.\n\nAN OLD INTERNET\nText-mode web pages, slow-loading GIFs, chat rooms full of theories, shady download sites and viruses waiting for the careless.\n\nPLAY YOUR WAY\nSit at the desk in VR, or play on your monitor with mouse and keyboard. A keyboard is recommended for coding.\n", "short_description": "Your older brother vanished and left you his room, his early-90s PC and a dial-up modem. Take coding jobs to pay the rent, fix bugs, crack codes and slip into a hidden network while you follow his trail. Then write your own games in the built-in language, pack them on floppies and share them. Sit at the desk in VR or play on your monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrkemono.com/privacy-policy/", "developer_terms_of_service_url": "https://www.vrkemono.com/terms-of-use/", "publisher_name": "VRKemono", "support_website_url": null, "website_url": "https://vrkemono.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39023836240595372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828087_2625612367900586_168096611708083620_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Yc_kVoElKgQ7kNvwGb09QX&_nc_oc=Adqgu2HQymGZQVoU-U0YgjkQyOJLHqCxvBtgtcgDAbg9PoolWosEp-R5BJE-GJ4O21M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMDTe2eZkxKrpyKzMl7DtLzsPFqW_VZCx17h1nBkAdHg&oe=6AF48396"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Retro Coder 2000", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name
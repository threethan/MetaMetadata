=6e7a0a&_nc_ohc=9G_0xbUmvnQQ7kNvwE7Kyby&_nc_oc=Adqu3N05pXC1LBuxSt5WBOnM7caRxnDzM6sOkVkML2-PK3Zq33WB9HthrJ652nq2_sU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRY1qvV0djPo7JQoKCie7Gg9m76SIH0LjAi_US6k16lA&oe=6B05B272"}, {"file_name": "17.png", "id": "1585211630017042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1585211633350375_5577857086258432576_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ_DLv8VSfkQ7kNvwETomJN&_nc_oc=Ado3lr4iROE_4hYPuWybXSpNqT7dHBf5qymoxfltF83BhTceripAvWsuf0SEV2U6vlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXw3libkgUyGKXHCIfml36cKotS_bDf7WThiYm9ps5yA&oe=6B05B417"}, {"file_name": "05.png", "id": "1628259795569003", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1628259798902336_6174198265879925541_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaSdSOBWATIQ7kNvwFcXK8s&_nc_oc=AdrnLNXhI1GG330FGIheCdGq69X4u6Sktux5jluhDcVXBAdDclao24dsg9moPRwGvhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXJIazoWlwWqC5foGoBnS0duK5IqCwdIbpMNCVOaBOIA&oe=6B05A6A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RC2000_Trailer_Cover_2560x1440.png", "id": "1586619116125752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1586619119459085_1855939237838899033_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmrFWsOUhagQ7kNvwFptWiy&_nc_oc=AdpRueiPT8nZ_xd1KuTe0_kZA8XazdLVuhTUKy4HiP9-WHby0hYGLj0FNy63sS0zlPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu4TAKJSegt-GaQTDIfoST5_BufSjaf7XGqKZ0z65N4g&oe=6B05C8F2"}, "display_name": "Retro Coder 2000", "keywords": ["programming", "hacking", "retro", "puzle", "simulation"], "long_description": "It's 1991. Your brother is gone. What he left is his room, a beige PC, a dial-up modem, a stack of floppies and a rent bill with a deadline.\n\nTHE PC IS REAL\nBoot it, install games from floppies, buy a faster CPU, video card and hard disk and switch them on in the BIOS. Everything runs on a simulated machine, and every program can be opened and changed.\n\nWORK THE LINE\nDial in, read your mail and take jobs: fix broken programs, decode secret messages, test games. Get paid (eventually), build trust and chase the clients who don't pay.\n\nGO DEEPER\nFollow the white rabbit into a hidden network. Scan hosts, sniff traffic and crack passwords in puzzles that reward skill, not luck. Somewhere at the end of the trail is the reason your brother disappeared.\n\nMAKE YOUR OWN\nLearn the built-in language step by step, then make 2D, tile-map or 3D games, pack them onto floppies and publish them. After the story, free play keeps the whole machine yours.\n\nAN OLD INTERNET\nText-mode web pages, slow-loading GIFs, chat rooms full of theories, shady download sites and viruses waiting for the careless.\n\nPLAY YOUR WAY\nSit at the desk in VR, or play on your monitor with mouse and keyboard. A keyboard is recommended for coding.\n", "short_description": "Your older brother vanished and left you his room, his early-90s PC and a dial-up modem. Take coding jobs to pay the rent, fix bugs, crack codes and slip into a hidden network while you follow his trail. Then write your own games in the built-in language, pack them on floppies and share them. Sit at the desk in VR or play on your monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrkemono.com/privacy-policy/", "developer_terms_of_service_url": "https://www.vrkemono.com/terms-of-use/", "publisher_name": "VRKemono", "support_website_url": null, "website_url": "https://vrkemono.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39023836240595372"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1430908585131141"}]}, "baseline_offer": {"id": "1430908585131141"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792077780, "status": "PUBLISHED", "id": "1430908585131141"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39939376389041348", "version": "1.4.5f"}, "id": "2631999380578133", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "39023836187262044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39939376389041348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2631999380578133"}]}, "change_log": "# 1.4.5f  18.11.2026\n+ Build your PC by hand: a new tower with the side panel off.\nWalk up and work inside the case to take parts out, swap them\nand fit new ones - CPU, cooler, video and sound cards, memory\nand hard disk. What is in the case is what your PC has\n+ Parts you order now come in their retail boxes: the doorbell\nrings and the courier drops them by the door. Open a box and\nfit the part yourself\n+ The BIOS checks the case at power-on and tells you what is\nmissing - no CPU fan, no memory, no boot disk\n+ Fans spin and the LEDs light up while the PC runs\n+ No sound card in the case, no sound: games, music and the\nsound tools tell you it is missing and the PC stays silent\n+ MEGAMARK 2000 (http://megamark): benchmark your PC, submit\nyour score to the Hall of Speed and beat the overclockers\n+ Kev's H2O-MAX 2000 water cooling, plain or RGB EDITION, sold\nby Kev himself in the MEGAMARK classifieds. Cooler CPU, more\nTurboTune headroom. Mind the hose clamps\n+ Two new air coolers in the VRK shop: the ZALKAN Bloom 7 copper\nflower and the NOPUA DT-2 twin tower. Cooler than the stock fan\nand more overclocking room, without Kev's hose clamps\n+ Beat KEV_H2O and the EXTREME section opens: dry ice\n+ 3 new achievements: water cooling, going RGB, and a new\nMEGAMARK world record\n+ Spare parts live on the bookshelves, each in its own place.\nLeave a part anywhere you like - next time you play it is back\nin its box on the shelf. Free play starts with every part, Kev's\nkits and the dry ice already there\n+ Overclock from the BIOS: Setup has a FREQUENCY/VOLTAGE CONTROL\npage - CPU and video clocks and CPU core voltage. More volts keep\na high clock stable but run hotter. Works in DOS, Pindows and Lunix\n* TurboTune: how far you can push now depends on your cooling\n* Your old PC moves into the new case by itself: the parts you\nhad installed are fitted, the spare parts you own wait boxed\non the bookshelves. Credits, files and progress stay as they were\n* The shop sells up to four memory sticks of each size - that\nfills every bank\n* DOOM WADs and files you copy in from outside no longer count\nagainst your hard disk\n* A disk too small for drive C: no longer stops the PC - it\nboots and warns you the disk is full\n* Start Over also uninstalls Pindows, TurboTune and Lunix and\nresets LOLO to DOS: a new career earns them again", "created_date": 1795023540, "id": "39939376389041348", "version": "1.4.5f", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "39023836187262044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39939376389041348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2631999380578133"}]}, "change_log": "# 1.3.8  13.11.2026\n- Balloons vs Ghosts 1.1 would not start after installing it:\na file was missing from the package. 1.1.1 is on GamezPot -\ndownload it again and install it over the old one, your\nscores stay\n- DZMARIO 2.0.7: a khinkali popping out of a block makes its\nsound again. Download it again from GamezPot to update\n* Games in C:\\DOWNLOADS that GamezPot has updated since you\ndownloaded them refresh themselves - just install them again\n- Pindows File Manager and Lunix xfm now open what VOS\nCommander opens: .VPK packages install with SETUP, and level\npacks, modem firmware and WADs work from there too\n- Lunix can no longer be started from inside DOS or Pindows -\npick it in LOLO at power-on\n+ Pindows and Lunix: pictures open in a viewer, sounds and\nsongs in a small player, with Edit for PAINT, SNDEDIT or\nCOMPOSER when you have them", "created_date": 1794578578, "id": "39801361526176169", "version": "1.3.8", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "39023836187262044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39939376389041348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2631999380578133"}]}, "change_log": "# 1.3.7  11.11.2026\n+ LOLO boot loader: pick DOS, Pindows or Lunix at power-on.\nChange the default, the wait and the names in LOLO's options,\nwith BOOTCFG at the DOS prompt or Boot Manager in Pindows\n+ Lunix 0.99 (Slackwire): a free Unix-like system on two floppies,\nfrom the slackwire FTP on UNDERNET. Write them with RAWRITE,\nboot the first one and follow the installer.\nDOS and Pindows stay where they are\n+ Lunix boots to a root shell - ls, cd, cat, df, free, uname...\nand runs the V-OS programs under dosemu (try: dosemu mail)\n+ vee, Lunix's own text editor. If you know vi, you know vee.\nIf you don't: i to type, Esc, then :wq to save and quit\n+ startx (4 MB RAM): an X desktop with fvwm, four desks and\na pager, a panel with clock, load, credits, modem and mail,\nand xterm, xfm, xedit, xclock and xload. X remembers your\nwindows for the next session\n+ Pindows: drag a window's edge or corner to resize it.\nProgram windows open where you left them\n+ Balloons vs Ghosts 1.1 on GamezPot. Own it already? GamezPot\nshows the update - download it again and install it over the\nold one in VOS Commander, your scores stay\n+ 5 new achievements, two of them hidden\n* Mouse pointers are smaller\n- Floppies you write now show their label, and the right name\nwhen you pick them up", "created_date": 1794400801, "id": "39743455281966794", "version": "1.3.7", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "39023836187262044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39939376389041348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2631999380578133"}]}, "change_log": "MACROHARD PINDOWS 3.12\n- A windowed OS for your 1991 PC, bought in the VRK Shop and delivered as a boxed set of six floppies\n- Wait for the parcel by the door, pin the CD key on the cork board, feed SETUP disks 1 to 6\n- File Manager, Notepad, System Info with a VRK-GL test, and the MacroHard Navigator web browser\n- Two games: Minefield and Patience (yes, the bouncing cards)\n- Desktop shortcuts, wallpapers and colours in Control Panel\n- Swap a CPU or video card and Pindows runs Add New Hardware and installs a driver\n\nTURBOTUNE 95\n- On VRK-NET: overclock the CPU and video card, set the fan, watch the temperature\n- Burn-in with the Donut Test: FPS and MAX FPS\n- Push it too far and meet the pink screen of death\n\nBALLOONS VS GHOSTS\n- New on GamezPot: tie balloons to the lawn and keep the ghosts out of the house. 10 levels, a top 10, 75 CR\n\nLANGUAGES\n- Italiano: pick it on first launch or in Settings\n- Phone calls have Georgian voices when the game is in Georgian\n- Pindows, its programs and TurboTune speak every language the game does\n\nALSO\n- A new TODO task, and new chat in #hardware and #games", "created_date": 1794245628, "id": "39694803243498665", "version": "1.3.6", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "39023836187262044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39939376389041348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2631999380578133"}]}, "change_log": "# 1.3.5  06.11.2026\n+ Languages: English, Espa\u00f1ol, \u10e5\u10d0\u10e0\u10d7\u10e3\u10da\u10d8, Deutsch, \u0420\u0443\u0441\u0441\u043a\u0438\u0439,\n\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0430, Fran\u00e7ais - pick one on first launch or in Settings\n+ Room hints, menus, mail, the story intro, printouts\nand the V-OS apps are translated\n+ The printer prints accents, Cyrillic and Georgian\n- Story intro: long lines now wrap instead of running off the screen", "created_date": 1793972555, "id": "39611574908488166", "version": "1.3.5", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
_1790164652269081_7443792269330492519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IdY352mLREQ7kNvwH2a616&_nc_oc=AdrqBgPNUwoDuehe7a6CTstAoUFK1O_1K59EOqbnN9gW8K7j7zioS7XgvaYOJ8ci27E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOyLDtqhcDSWq8sgldmfTz6XvIEE3jDujsqcIQAbmBKw&oe=6ADE0E70"}, {"file_name": "08.png", "id": "3008549089487580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_3008549099487579_4938491692826644189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqxF9cIRDogQ7kNvwEM1H4w&_nc_oc=AdpvbllKKMtJn958BdsZnkD-BErUJzL90kq9ih2fusha-DhVYfYfh9Skz-YoA9fQzXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTdSkLQlGkKlc5CoyId805pe72U4-P5TqEpy9lY7X5DA&oe=6ADE0B30"}, {"file_name": "03.png", "id": "1828933988108048", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1828933991441381_8747031393574171743_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmmjbKd70-YQ7kNvwGVfogd&_nc_oc=AdoFpLE0uz1qBi6_ffcnBavAvaLsE2XEMrI2VBuRYYcKI1LlGRQXcsOz01aZsfnUAEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO33CUwZlIQbzJCS8UmXChd5iSx_7LWxwLfX47rxSNOqw&oe=6ADE2572"}, {"file_name": "17.png", "id": "1585211630017042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1585211633350375_5577857086258432576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZlTld4QpcQQ7kNvwHRRV-1&_nc_oc=Ado8CR9Y_6Uyj6nZrIuqpBsFkoSP2JaLVziBhpvEbUX8lG5ZMnjytvsJ6nv71TrbvNc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaYJqKGdHme1mUNyJVe4bI2GyGWOP-CM2xHTavOYQ5PA&oe=6ADE2717"}, {"file_name": "05.png", "id": "1628259795569003", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824671_1628259798902336_6174198265879925541_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSq6QmSRmE8Q7kNvwGUbs4A&_nc_oc=AdqtyeCcYYlvX1dw-b5gnpCMyJm8Qs08fVeEEf34D9diY8NexfBI79yiuge8XNOi-l0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwQMcNwue1Vaytf6PorqL4C6861sKdn44zNV0nLaAvnw&oe=6ADE19A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RC2000_Trailer_Cover_2560x1440.png", "id": "1586619116125752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1586619119459085_1855939237838899033_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIQntz-TkEwQ7kNvwGOUH0P&_nc_oc=AdpPfPgEb7f0PSCARt0jxgNPiDXkdwJfsMy8Rb3hl0FkoEe3FfQ4N5Z-z1qpIF3OQ5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV03eL5lMWGxCq9-hireNEqHjm_HGcyaHjfuemTAVqsQ&oe=6ADE03B2"}, "display_name": "Retro Coder 2000", "keywords": ["programming", "hacking", "retro", "puzle", "simulation"], "long_description": "It's 1991. Your brother is gone. What he left is his room, a beige PC, a dial-up modem, a stack of floppies and a rent bill with a deadline.\n\nTHE PC IS REAL\nBoot it, install games from floppies, buy a faster CPU, video card and hard disk and switch them on in the BIOS. Everything runs on a simulated machine, and every program can be opened and changed.\n\nWORK THE LINE\nDial in, read your mail and take jobs: fix broken programs, decode secret messages, test games. Get paid (eventually), build trust and chase the clients who don't pay.\n\nGO DEEPER\nFollow the white rabbit into a hidden network. Scan hosts, sniff traffic and crack passwords in puzzles that reward skill, not luck. Somewhere at the end of the trail is the reason your brother disappeared.\n\nMAKE YOUR OWN\nLearn the built-in language step by step, then make 2D, tile-map or 3D games, pack them onto floppies and publish them. After the story, free play keeps the whole machine yours.\n\nAN OLD INTERNET\nText-mode web pages, slow-loading GIFs, chat rooms full of theories, shady download sites and viruses waiting for the careless.\n\nPLAY YOUR WAY\nSit at the desk in VR, or play on your monitor with mouse and keyboard. A keyboard is recommended for coding.\n", "short_description": "Your older brother vanished and left you his room, his early-90s PC and a dial-up modem. Take coding jobs to pay the rent, fix bugs, crack codes and slip into a hidden network while you follow his trail. Then write your own games in the built-in language, pack them on floppies and share them. Sit at the desk in VR or play on your monitor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrkemono.com/privacy-policy/", "developer_terms_of_service_url": "https://www.vrkemono.com/terms-of-use/", "publisher_name": "VRKemono", "support_website_url": null, "website_url": "https://vrkemono.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39023836240595372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828087_2625612367900586_168096611708083620_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFqV06uLwnsQ7kNvwHiVN-n&_nc_oc=Adqw8q00Sl8bqm8U-NiFpy5mLFg8y_8ORUQwYdzvTZwXvWbh9NaEmjY_tYm19cX3DOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKBuJLfBjTLbi40lCAWisJbkj4zSEx8akTsEZvbSySxg&oe=6ADE1A16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Retro Coder 2000", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name
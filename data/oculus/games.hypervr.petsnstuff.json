Bd7RcQ7kNvwFNg1Tg&_nc_oc=AdopD6axX7gxk3ENbQUkvchRj1GcirNovX9lfJl0zjGCu6nehIC2B2km06mtf36NNq4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbB9dlXnB2F-sLi7ya15z_cwvQbmDvsV3ivzTeoittxA&oe=6A77402E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P&S_Landscape_2560x1440 (1).png", "id": "1270461971504733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1270461974838066_3264089010068260628_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQcyALaZImcQ7kNvwEDPrY8&_nc_oc=AdqOqV4yGQiU7LI4EbngR2KiCIIchYL5BEqKMHpRGPRATAuvd08IPmnCGgXLtSpAWQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhv5ss3XY7k_4TCy2Nc2Xmc-zpNz0YYAmj-1xDswbkbA&oe=6A772900"}, "display_name": "Pets & Stuff", "keywords": ["cat", "animal", "kids", "cute", "shave"], "long_description": "**Pets & Stuff** \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian. Help little friends in trouble, make them happy, pampered, clean, well-fed, and don't forget to add a pinch of chic. Let your imagination run wild!\n\nEnjoy a fully responsive and polished gameplay, make the best trims, feel the fur at your fingertips and capture the best photoshoots of your creations. \n\n**Meet a wide range of pets**\n{1337478634686148}\n\nHelp a variety of furry friends in need: cats, dogs, raccoons, foxes, deer and so many more!\n\n**Explore tools and accessories**\n{1269757408529080}\n\nFrom fly swatters to vacuum cleaners, you'll have a range of tools to take care of each pet. Use color sprays, collars and shades for a stylish finish!\n\n**Upgrade your clinic and discover new locations**\n{1583697675978106}\n\nDiscover all four unique locations\u2014Clinic, Forest, Farm, and Fantasy Land\u2014and earn stars to upgrade your workspace to a cozy clinic!\n\nCuteness overload and furrrr everywhere guaranteed!", "short_description": "Pets & Stuff \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian using a variety of tools, meds and stylish accessories. Let your imagination run wild! \n\nHelp little friends in trouble, make them happy, pampered, clean, well-fed, and while on it - feel free to add a pinch of chic. Enjoy a fully responsive and polished gameplay with different locations to explore, many adorable pets and lots of creativity boosting gadgets to play with."}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/petsnstuff.html", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27137200195880441"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_4117521885229131_4789437153324384281_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEF7Jg3QBp4Q7kNvwHX-BNM&_nc_oc=AdpzNNqh3io8O7qU33LKhEa1b5VqW-lNIZ0P917N3mD0ekXC7ic2dC4a6I8dGW583mw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwQyN_1HipHwJWLsC0rONcVeUFgeqdY7B4pk4QLB0rQg&oe=6A771C97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pets & Stuff", "platform": "ANDROID_6DO
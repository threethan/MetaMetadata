ontent-iad3-1.oculuscdn.com&oh=00_AfuTixmMqXOKZLDBr4UaIupgIAft5IxTuuSCdohzL4IwUA&oe=699DB1EF"}, {"file_name": "PnS_Screen_6.png", "id": "1443070913012591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86601734_1443070916345924_5445802836207090448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2cBq8_xn0YQ7kNvwGMFRsl&_nc_oc=Admd8EfuvBdMAT_nylGLiGPd56YGu22SrBR6iX5-ZWQpZFiKfEpFuHSgKG8852QWqbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFUoPUzFkce6nsCmCLDSicHqwQdDXt1Ed-UY5GXYCPHQ&oe=699D97CD"}, {"file_name": "PnS_Screen_2.png", "id": "781731767465610", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392876_781731770798943_7524934239906729170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcRTJRvBdwkQ7kNvwGT0Bs1&_nc_oc=AdmnK1LVGEQMf9blk_sjZOu0LkWoKoe7-x7fdpibt3GERsk8c3ocbfuFYlof5InaY2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscDJl1a2NKK_AJoC8dC_nZYOXGSU_nmScEzlNJmDibmA&oe=699DA6E5"}, {"file_name": "PnS_Screen_4.png", "id": "888017739841757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982458_888017743175090_7655612419219817957_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnGhnjiUW1gQ7kNvwGJKO85&_nc_oc=AdkAhKriRorLok6yACsJz8GRtCPRv3JS75gMp9Llq5DmEGhLPI5RHfExYYl2WbmaJvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvl0p2NRNxBNY9SY0EwLEBtKUyLs74XcIWTXRncK9J1iw&oe=699D9DFC"}, {"file_name": "PnS_Screen_5.png", "id": "1047790816766549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031586_1047790820099882_6601680007287048467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV1XDfPo6WMQ7kNvwENLMkd&_nc_oc=AdniWmMbp5BQcBHfJHYyaflPrblrOgHwti3zqPNbjbGSFpv4PHugXouIwCHO07uGUFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUw6WYL6_bXv7A33grOHFIf6oIPDyb1qqaSKvMBOrZig&oe=699D806E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (6).png", "id": "2130525324462489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_2130525331129155_7747550886624196249_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgNK6uukfEoQ7kNvwF8hbMv&_nc_oc=AdntOYQjq8eT3tIwdzcGWYaCKHDmAupyEX3F1wBYKwOX9JTQjaoeQRRSDb0NEqg4igM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsABG6GFwe6D7xCnjzS_HnF3hHgEyqyCSz7Gk8kgroi2Q&oe=699D884D"}, "display_name": "Pets & Stuff", "keywords": ["cat", "animal", "kids", "cute", "shave"], "long_description": "**Pets & Stuff** \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian. Help little friends in trouble, make them happy, pampered, clean, well-fed, and don't forget to add a pinch of chic. Let your imagination run wild!\n\nEnjoy a fully responsive and polished gameplay, make the best trims, feel the fur at your fingertips and capture the best photoshoots of your creations. \n\n**Meet a wide range of pets**\n{1337478634686148}\n\nHelp a variety of furry friends in need: cats, dogs, raccoons, foxes, deer and so many more!\n\n**Explore tools and accessories**\n{1269757408529080}\n\nFrom fly swatters to vacuum cleaners, you'll have a range of tools to take care of each pet. Use color sprays, collars and shades for a stylish finish!\n\n**Upgrade your clinic and discover new locations**\n{1583697675978106}\n\nDiscover all four unique locations\u2014Clinic, Forest, Farm, and Fantasy Land\u2014and earn stars to upgrade your workspace to a cozy clinic!\n\nCuteness overload and furrrr everywhere guaranteed!", "short_description": "Pets & Stuff \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian using a variety of tools, meds and stylish accessories. Let your imagination run wild! \n\nHelp little friends in trouble, make them happy, pampered, clean, well-fed, and while on it - feel free to add a pinch of chic. Enjoy a fully responsive and polished gameplay with different locations to explore, many adorable pets and lots of creativity boosting gadgets to play with."}]}, "developer_name": "HyperVR Games", "dev
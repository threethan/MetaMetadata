ontent-ord5-3.oculuscdn.com&oh=00_AfuSMY-jvWnZbsDq1hREr9f_3oaL2ec55XBgU59pGtc-hg&oe=699B0EEF"}, {"file_name": "PnS_Screen_6.png", "id": "1443070913012591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86601734_1443070916345924_5445802836207090448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR3Dt_mM57sQ7kNvwGTRlqo&_nc_oc=Adnqq72DBsYxdHBF5BjnjzaTK-Yz3DpzBQq1zKrx28HMJ-xCVPm-rjVvUj3Gm1GqJeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvSDj7KFLancW15qSdXh34uPHnYB_P4z0C50Oq_75nI6A&oe=699AF4CD"}, {"file_name": "PnS_Screen_2.png", "id": "781731767465610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_781731770798943_7524934239906729170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcRTJRvBdwkQ7kNvwErZNk6&_nc_oc=AdkJaOC-2p76HSIbCZBKY8oKnbush_-zIbSarPKWMd00QUWHMAaIAt8Z48SHZHJxFCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft1DAtr6v6KTFeJ7A5Nkjwbo_hGTa3-MU6J7W5Mt1QlsQ&oe=699B03E5"}, {"file_name": "PnS_Screen_4.png", "id": "888017739841757", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982458_888017743175090_7655612419219817957_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpAayRNeJ9YQ7kNvwFTGP9q&_nc_oc=AdlfzGE72bomzXOBqTGGDsdACnpTQfSLx7U9sqoYYhp2mXhpJ3JiSVB88B9VO-yd-8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMZFCWY_qmKU4h99O0VEF8ncVngPTM186d92beswWU2w&oe=699AFAFC"}, {"file_name": "PnS_Screen_5.png", "id": "1047790816766549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031586_1047790820099882_6601680007287048467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV1XDfPo6WMQ7kNvwFKMGsM&_nc_oc=AdmLk2LzzzQNlPIj3VqNqg0uvSLfalXxu0-BbjL8J86Axqq8H3vyHgkvsmBTFDWDz3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftLto8HaqGCXYbVh8HfkqvgELff4nhIZCFIMpUGbk3GAA&oe=699B15AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (6).png", "id": "2130525324462489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2130525331129155_7747550886624196249_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgNK6uukfEoQ7kNvwF7RbVe&_nc_oc=Adn98ao56RBLM8ul4MPGEbXb3SQgeD2Up596-yzPczWuVTVCFZ1yGjdmPjZl3HyAWo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs7NcmNGGv-ryhfITNRr_XCM0S984pQGl_cFxLj_mRR7A&oe=699AE54D"}, "display_name": "Pets & Stuff", "keywords": ["cat", "animal", "kids", "cute", "shave"], "long_description": "**Pets & Stuff** \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian. Help little friends in trouble, make them happy, pampered, clean, well-fed, and don't forget to add a pinch of chic. Let your imagination run wild!\n\nEnjoy a fully responsive and polished gameplay, make the best trims, feel the fur at your fingertips and capture the best photoshoots of your creations. \n\n**Meet a wide range of pets**\n{1337478634686148}\n\nHelp a variety of furry friends in need: cats, dogs, raccoons, foxes, deer and so many more!\n\n**Explore tools and accessories**\n{1269757408529080}\n\nFrom fly swatters to vacuum cleaners, you'll have a range of tools to take care of each pet. Use color sprays, collars and shades for a stylish finish!\n\n**Upgrade your clinic and discover new locations**\n{1583697675978106}\n\nDiscover all four unique locations\u2014Clinic, Forest, Farm, and Fantasy Land\u2014and earn stars to upgrade your workspace to a cozy clinic!\n\nCuteness overload and furrrr everywhere guaranteed!", "short_description": "Pets & Stuff \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian using a variety of tools, meds and stylish accessories. Let your imagination run wild! \n\nHelp little friends in trouble, make them happy, pampered, clean, well-fed, and while on it - feel free to add a pinch of chic. Enjoy a fully responsive and polished gameplay with different locations to explore, many adorable pets and lots of creativity boosting gadgets to play with."}]}, "developer_name": "HyperVR Games", "dev
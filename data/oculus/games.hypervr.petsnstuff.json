ontent-ord5-3.oculuscdn.com&oh=00_AftxZrjt94vTM9B7tbT4RoJ3xp7z1xCn3fIltwEG0WE7sA&oe=699C606F"}, {"file_name": "PnS_Screen_6.png", "id": "1443070913012591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86601734_1443070916345924_5445802836207090448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR3Dt_mM57sQ7kNvwEMEZbM&_nc_oc=AdmFO2O1yhv-JFqKQ8OabNOy7ad8W4y19LePn0MgVA7zQQaVftqNkmn4ZtgtAWR4nDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afth3uMm-Jd86SHTvFZe42bGmkAG1o2CmxIRS5-1W3QEyQ&oe=699C464D"}, {"file_name": "PnS_Screen_2.png", "id": "781731767465610", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392876_781731770798943_7524934239906729170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcRTJRvBdwkQ7kNvwHVi-Qm&_nc_oc=AdlJqBBE_dK7w3UsHdUsOc4V0yyzXsbBE-d7-0a5pmf6QPm92dYmrhyAhN_CIAqBrYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRz9qaxOQzvRona7Irqtcm9g8Cqr7-O5mH_jVJPGZrQg&oe=699C5565"}, {"file_name": "PnS_Screen_4.png", "id": "888017739841757", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982458_888017743175090_7655612419219817957_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpAayRNeJ9YQ7kNvwH8uZ2f&_nc_oc=AdkX3PxYNosLi7kTZceHdE52GofIWOy4CpRHO7xYh_pia4WIOZ-fgk8jrKoWsAq2qKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftexsyEXt3aD9KR7LjvXV67omzycWwJM1fdql0rlBzhnw&oe=699C4C7C"}, {"file_name": "PnS_Screen_5.png", "id": "1047790816766549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031586_1047790820099882_6601680007287048467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV1XDfPo6WMQ7kNvwGfBj_8&_nc_oc=Admardd4Kw7hMl0Md-IPWsvnQ8eWSDyxoJ5PLXO9guD-G7R5BD80m0F6rns7vBBk0-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsPPekWhuaVmlnqVSDJNjtltrOPPV2xjIT8J9WjtsycBA&oe=699C672E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (6).png", "id": "2130525324462489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2130525331129155_7747550886624196249_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgNK6uukfEoQ7kNvwE-rbuC&_nc_oc=AdkZvRjarMXesFNGniAr9_x0ozj1IUvztaajDsPemsB9r55Suxji0JMrVJMceKeT02s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsdQfjVqFVIAhv2YTcn6DW51RcKertrz3GTRYHCw6M8QA&oe=699C36CD"}, "display_name": "Pets & Stuff", "keywords": ["cat", "animal", "kids", "cute", "shave"], "long_description": "**Pets & Stuff** \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian. Help little friends in trouble, make them happy, pampered, clean, well-fed, and don't forget to add a pinch of chic. Let your imagination run wild!\n\nEnjoy a fully responsive and polished gameplay, make the best trims, feel the fur at your fingertips and capture the best photoshoots of your creations. \n\n**Meet a wide range of pets**\n{1337478634686148}\n\nHelp a variety of furry friends in need: cats, dogs, raccoons, foxes, deer and so many more!\n\n**Explore tools and accessories**\n{1269757408529080}\n\nFrom fly swatters to vacuum cleaners, you'll have a range of tools to take care of each pet. Use color sprays, collars and shades for a stylish finish!\n\n**Upgrade your clinic and discover new locations**\n{1583697675978106}\n\nDiscover all four unique locations\u2014Clinic, Forest, Farm, and Fantasy Land\u2014and earn stars to upgrade your workspace to a cozy clinic!\n\nCuteness overload and furrrr everywhere guaranteed!", "short_description": "Pets & Stuff \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian using a variety of tools, meds and stylish accessories. Let your imagination run wild! \n\nHelp little friends in trouble, make them happy, pampered, clean, well-fed, and while on it - feel free to add a pinch of chic. Enjoy a fully responsive and polished gameplay with different locations to explore, many adorable pets and lots of creativity boosting gadgets to play with."}]}, "developer_name": "HyperVR Games", "dev
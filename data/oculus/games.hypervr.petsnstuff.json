ixrvyK-WPqyfDEQXPcwYTK4_cHf9I03ZtA&oe=6A8EEF7E"}, {"file_name": "PnS_Screen_09.png", "id": "1142405567188531", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86625131_1142405570521864_3433678619384350817_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy1h2yMFRrIQ7kNvwFNKMcU&_nc_oc=AdoSJej_6F-ZYfLQ58BcOWdXGOr6FyZyxJ0suplLKBSaKrWUS0pr4gMor9br3POZ58E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvG-FeR1ZEFtvOy_XqVrPUpEhEfk1KdnNMSNfRgPCnFQ&oe=6A8EE7FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SideQuest_ListingImage2.png", "id": "2560167484146816", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974691_2560167487480149_7128508974699641776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XegqkTg488IQ7kNvwHEG5GB&_nc_oc=AdqsR8VAyXjd_LYyBhpT5BKcJNPeN2BkwC5fg-YTrAVdh_wenluY3oguMD9jnc0RL1I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1_drfGXI5IDxGnjJhNk16QljZkHgYqcHSzbLIVg5BQg&oe=6A8EE2B8"}, "display_name": "Pets & Stuff", "keywords": [], "long_description": "By the creators of Shave & Stuff we present you Pets & Stuff!\n\nImmerse yourself into the role of a pet groomer at a cute pet clinic. Help adorable, furry friends with all kinds of different treatments. Let your imagination run wild and impress not only your fuzzy customers, but everyone around with a completely renewed, colourful and healthy look. Everyone deserves to be happy, groomed and in style!\n\nCuteness overload and fur everywhere guaranteed!\n\nFour adorable animals to play with (we will have more soon):\n* Tiger\n* Piggie\n* Oxy\n* Deerling\n\nFeel free to use our wonderful grooming tools:\n* Futuristic vacuum cleaner\n* Toothsie brushes\n* Unbearably cute collars\n* Badass glasses\n* Cool Camera to take pictures\n* Totally realistic color sprays\n* Advanced fly hitting lash\n* Mosquito repellents\n* and much more", "short_description": "Immerse yourself into the role of a pet groomer at a cute pet clinic. Help adorable, furry friends with all kinds of different treatments. Let your imagination run wild and impress not only your fuzzy customers, but everyone around with a completely renewed, colourful and healthy look. Everyone deserves to be happy, groomed and in style!\n\nCuteness overload and fur everywhere guaranteed!"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/petsnstuff.html", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7837485789611837"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1081300050932065"}, {"status": "PUBLISHED", "id": "2167432657354374"}, {"status": "PUBLISHED", "id": "744024218641144"}, {"status": "PUBLISHED", "id": "1555246079144696"}, {"status": "PUBLISHED", "id": "2274672289664879"}, {"status": "PUBLISHED", "id": "1485737402623827"}, {"status": "PUBLISHED", "id": "706100032046261"}, {"status": "PUBLISHED", "id": "2813644188810728"}, {"status": "PUBLISHED", "id": "1879416752800998"}, {"status": "PUBLISHED", "id": "1025915999552024"}, {"status": "PUBLISHED", "id": "1087418402376224"}, {"status": "PUBLISHED", "id": "1216943889345348"}, {"status": "PUBLISHED", "id": "
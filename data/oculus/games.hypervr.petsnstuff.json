1.oculuscdn.com/v/t64.5771-25/86625131_1142405570521864_3433678619384350817_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkuWswZN_hgQ7kNvwEnm3P3&_nc_oc=Ado-yMlbEAjM2WNkavxu7r39WnPTJuPKdXYQqs04XdT9tCU0MYlNmu9vLczC2hVLqms&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r52JV2tLvB5ZiFxt6UsBsbUPdDLtx9fhX49syL1Ciig&oe=6A36937E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SideQuest_ListingImage2.png", "id": "2560167484146816", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974691_2560167487480149_7128508974699641776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nqeIdK6tysQ7kNvwG5_vuZ&_nc_oc=AdrXtAiPXQP6ts_1RvwAOTnCSXD0CUp_hHgkVm2fnUzkYeKq4mdcGy5BRL6Hfl20peM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VLaxkB96vblfVDpjDF65XB7Tw9MhsCeKDn-1GJhaSCw&oe=6A368E38"}, "display_name": "Pets & Stuff", "keywords": [], "long_description": "By the creators of Shave & Stuff we present you Pets & Stuff!\n\nImmerse yourself into the role of a pet groomer at a cute pet clinic. Help adorable, furry friends with all kinds of different treatments. Let your imagination run wild and impress not only your fuzzy customers, but everyone around with a completely renewed, colourful and healthy look. Everyone deserves to be happy, groomed and in style!\n\nCuteness overload and fur everywhere guaranteed!\n\nFour adorable animals to play with (we will have more soon):\n* Tiger\n* Piggie\n* Oxy\n* Deerling\n\nFeel free to use our wonderful grooming tools:\n* Futuristic vacuum cleaner\n* Toothsie brushes\n* Unbearably cute collars\n* Badass glasses\n* Cool Camera to take pictures\n* Totally realistic color sprays\n* Advanced fly hitting lash\n* Mosquito repellents\n* and much more", "short_description": "Immerse yourself into the role of a pet groomer at a cute pet clinic. Help adorable, furry friends with all kinds of different treatments. Let your imagination run wild and impress not only your fuzzy customers, but
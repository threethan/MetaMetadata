ontent-ams2-1.oculuscdn.com&oh=00_AftO_yr4wkVZzK5VhmL3liVqTmUgriAPHIYB0IMgOv5teg&oe=699F036F"}, {"file_name": "PnS_Screen_6.png", "id": "1443070913012591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601734_1443070916345924_5445802836207090448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2cBq8_xn0YQ7kNvwHtOUu8&_nc_oc=AdmSX9HRdg2I1oesXNRz_gardNVlmK8EXRCeIMSae-dJidLxHrDgvG6c3WIBI3AXO0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvr8pRd0cI-e2urjIWeCoU6i0CGJQAS_voStz_DRstjGg&oe=699EE94D"}, {"file_name": "PnS_Screen_2.png", "id": "781731767465610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392876_781731770798943_7524934239906729170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVUjVwy6XOEQ7kNvwHxyRGd&_nc_oc=AdkLocJvURE6W6rhpnilLzZQBsLx_5R3gNU-V31Y7N_IkTJrmXnALyoK25UvgjoWVcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvO2-ikYfBxVvCSzIF8n_yOaV9k7-glwaJTr7W9SkuYXw&oe=699EF865"}, {"file_name": "PnS_Screen_4.png", "id": "888017739841757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_888017743175090_7655612419219817957_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnGhnjiUW1gQ7kNvwGhyEQV&_nc_oc=AdmQeYq9MexWdSOg6fcS8vjsnH4XJmk1IMPP2GSSIcNFAvYhhj7DToSM9_bup3OdcpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuhyohy5u_4CLMNPqgImZyc0u9HCdLUNoWGfFDQXDGyAQ&oe=699EEF7C"}, {"file_name": "PnS_Screen_5.png", "id": "1047790816766549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031586_1047790820099882_6601680007287048467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9CLj4sn3MQQ7kNvwG440XX&_nc_oc=Adlspgas3UpRGqfUNA_bD1vOX8vHkDz-w0DIQyejJiu9MmN4hiDcPzy_y_uCpaOlaiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftSSpj9oRn5LpCC4yW6sbiEbiUlFPRrUx8-IQYGeF0b2w&oe=699ED1EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (6).png", "id": "2130525324462489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_2130525331129155_7747550886624196249_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqZaU5E1mvkQ7kNvwF5Ftaz&_nc_oc=AdkcQfFuu3nYzVI4vrc702b65ok0ZtaZbUTbmNc8W4JxhoRhlkxMfy5SPM2d44UCnSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfthdOTl1ydj0A4txWE6BPWp3bVb1puBmU8Mh06koGGsWQ&oe=699ED9CD"}, "display_name": "Pets & Stuff", "keywords": ["cat", "animal", "kids", "cute", "shave"], "long_description": "**Pets & Stuff** \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian. Help little friends in trouble, make them happy, pampered, clean, well-fed, and don't forget to add a pinch of chic. Let your imagination run wild!\n\nEnjoy a fully responsive and polished gameplay, make the best trims, feel the fur at your fingertips and capture the best photoshoots of your creations. \n\n**Meet a wide range of pets**\n{1337478634686148}\n\nHelp a variety of furry friends in need: cats, dogs, raccoons, foxes, deer and so many more!\n\n**Explore tools and accessories**\n{1269757408529080}\n\nFrom fly swatters to vacuum cleaners, you'll have a range of tools to take care of each pet. Use color sprays, collars and shades for a stylish finish!\n\n**Upgrade your clinic and discover new locations**\n{1583697675978106}\n\nDiscover all four unique locations\u2014Clinic, Forest, Farm, and Fantasy Land\u2014and earn stars to upgrade your workspace to a cozy clinic!\n\nCuteness overload and furrrr everywhere guaranteed!", "short_description": "Pets & Stuff \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian using a variety of tools, meds and stylish accessories. Let your imagination run wild! \n\nHelp little friends in trouble, make them happy, pampered, clean, well-fed, and while on it - feel free to add a pinch of chic. Enjoy a fully responsive and polished gameplay with different locations to explore, many adorable pets and lots of creativity boosting gadgets to play with."}]}, "developer_name": "HyperVR Games", "dev
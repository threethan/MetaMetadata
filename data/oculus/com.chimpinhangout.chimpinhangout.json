e=6B0471CC"}, {"file_name": "1223242.png", "id": "1213018714196374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293825_1213018717529707_3240205837733654637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjNecFV3qOYQ7kNvwEwOqyf&_nc_oc=Adpjm2OfP_MRxbPWMiqvckyO_TmwTX5IAwKE_kOzJpObFiCtN6UkCXvH6uaw6ex7gw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhIzXR3aJtnpLxW8UlTDWDG7B_Kfae2ahomZUoAwyIqQ&oe=6B045F5A"}, {"file_name": "12232242.png", "id": "2512697309188865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307920_2512697312522198_403256819002593989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8TF1W2DSCwQ7kNvwFS6rYe&_nc_oc=Adr2qWdhX52-dajaBEozgw7e26mm3wE5n0qnWUVt4ZKlPW899loRjOLBLjqxr-LRq_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6bGRPjjp7QUsXG1Ryd6yiC0d4IBugfEGHc2dNgoHggw&oe=6B047023"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?
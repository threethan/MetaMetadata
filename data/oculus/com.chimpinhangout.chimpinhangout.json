_1981087829474085_5724823002576344336_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IlUYw5-fJYQ7kNvwEQw05u&_nc_oc=Adrn5GVRzq8LIejil35nIGeq34p04fvv9Ypc1dXHXz2glDgchyJoVKKZ8lrzUXIJ0YA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQepYCqNXAtSoi0cBbc76wNHCe1_9QW_HqVZc5zwSk7fw&oe=6B031B32"}, {"file_name": "aaaaaaaa.png", "id": "1372501724603880", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830893_1372501727937213_1693215256118165284_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgMv-6umaXwQ7kNvwE6EYGu&_nc_oc=Adqun1zNAq1VwtrhnKGqlg9z94UlmRjZsZ9RmnIh2X0vd2Zv6_7srBmjbEUUZFPqMnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsInqWSCgz3C-SFtHpfCu2y35l2_EAjIQZ83yl8zmNTA&oe=6B031B63"}, {"file_name": "aaaaaaaaaaa.png", "id": "868292799184888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299922_868292802518221_747518528165820992_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXZv-vkEvuoQ7kNvwHSUmRL&_nc_oc=AdoEXhrJR-mkob1ds1Jhi8j-H8dzfH-7o0iFeLJzmttDB1h101hH6DPxfVzyGyYTqmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGMkeu6XD800Gjo11NL_ISM1Um8iVVBH4GPRgVtU-ZMw&oe=6B032E3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "evdog929", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpinhangout/game-overview?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER", "MULTI_USER"], "id": "25006103755752487"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1405143604359051"}]}, "baseline_offer": {"id": "1405143604359051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766172900, "status": "PUBLISHED", "id": "1405143604359051"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26771777019185143", "version": "15"}, "id": "880668758239144", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "249881
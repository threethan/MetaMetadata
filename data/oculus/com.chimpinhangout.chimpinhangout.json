e=6B0EFDCC"}, {"file_name": "1223242.png", "id": "1213018714196374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293825_1213018717529707_3240205837733654637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFfI4Vbuw9UQ7kNvwFLx9Md&_nc_oc=AdpKpg-iQhxP7TErz7bbEY7ayViEBN7gltWCCXZCiOBTMW_CBIwshV0jOEAy6WnPWaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWM9hbNJNK8npOVxczvW5ZvO_XPy5WiV5E7IBYla8r3zw&oe=6B0F239A"}, {"file_name": "12232242.png", "id": "2512697309188865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307920_2512697312522198_403256819002593989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83xb_wr4iXcQ7kNvwGbJUlL&_nc_oc=Adr8-4u9QyQ35fN1gdNLk-TBTSetHWRrIhvRdpIflYEMF7wXbhVE_PDdp97ES9TuCCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVnjvCh_WvalWJY_YA9iHd8eXyv_M1i79cLDOj428ibtw&oe=6B0EFC23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?
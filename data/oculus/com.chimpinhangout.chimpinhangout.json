_1981087829474085_5724823002576344336_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuPqaxnHW7AQ7kNvwFnlgEN&_nc_oc=Adr_ObVoYycLIckzs4tcn1R0JpfyOExX-UT9OpMfg1iCKAD6uRsOMB62IAvpfMdXMfE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdMy9jUvY_vN7q9B2Ij2-FlBGrhOuEPhV4l6gOLSHfbQ&oe=6B086132"}, {"file_name": "aaaaaaaa.png", "id": "1372501724603880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830893_1372501727937213_1693215256118165284_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGVQblZAXfIQ7kNvwFaiHks&_nc_oc=AdqjRUarX2Q1l5u3_uB16Aj3c9QCOmLasx8auPKzv1aMNY2CPb-O6Lb1j2DYkkLymUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR13BKdvW1eQVUqffaolI2KVuggVd_MVQVBlYGEOENwFA&oe=6B086163"}, {"file_name": "aaaaaaaaaaa.png", "id": "868292799184888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299922_868292802518221_747518528165820992_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR_bt-w6vVIQ7kNvwE47OSn&_nc_oc=AdqoaOmCi1XVVlxsVummDWQDVK-i_1EGtMV1AvWJMaSD4yfITnnESWd3aw4xe4K6hcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlJV6TsghQvy3bKUfom-Wzz95-a3kAFNj5cN3pN1pIvw&oe=6B083BFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "evdog929", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpinhangout/game-overview?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER", "MULTI_USER"], "id": "25006103755752487"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1405143604359051"}]}, "baseline_offer": {"id": "1405143604359051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766172900, "status": "PUBLISHED", "id": "1405143604359051"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26771777019185143", "version": "15"}, "id": "880668758239144", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "249881
e=6B0C5ACC"}, {"file_name": "1223242.png", "id": "1213018714196374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293825_1213018717529707_3240205837733654637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWNpFmAHSYAQ7kNvwFXSZAm&_nc_oc=Ado6NYcY9_k_gg1uDS4H7ojWOubE6p0sJ57z8taOvbyCSlQMo7F6fFg0q0OEO5mwKZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyCtsKU5O5aXiCUb51CZEl6wJ7Wzoe-bFRL_txa5JQ5A&oe=6B0C809A"}, {"file_name": "12232242.png", "id": "2512697309188865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307920_2512697312522198_403256819002593989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83xb_wr4iXcQ7kNvwEoIo0-&_nc_oc=AdrosnymUq6f9mrixM8Ndve11POfAl3A0T-U1GbPHddHJSAqQStYxyI0p9uDQyjSCL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStEnwoWi1UKmANMzcUW2p1eyxY34qa4NgUKt-TsOPqgA&oe=6B0C5923"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?
e=6B03204C"}, {"file_name": "1223242.png", "id": "1213018714196374", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293825_1213018717529707_3240205837733654637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjNecFV3qOYQ7kNvwE1dgw2&_nc_oc=AdqPHIqCutVGITUU5o5xa9Lrzlmku_mAFU9ItRdx_vT7p9YyxS_ysdcTtTsqYjhZGb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAri9unX4qO8VnF12o1oitgDqRIj6JoX81RT3s861DxA&oe=6B030DDA"}, {"file_name": "12232242.png", "id": "2512697309188865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307920_2512697312522198_403256819002593989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHeYJ4cER1IQ7kNvwGpkRe-&_nc_oc=AdpAggEZSOWvI4rf9nsk3h1wfHJMh_bovhgFwcF12k1vAHGcvDnOhWa5y4h3VGfaur8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFCp11b5X2NCOk0bFpGy3lNTo-zo55px7qVvKpuA8MUA&oe=6B031EA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?
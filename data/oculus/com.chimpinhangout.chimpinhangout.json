e=6B007D4C"}, {"file_name": "1223242.png", "id": "1213018714196374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293825_1213018717529707_3240205837733654637_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bby4RNkegmQQ7kNvwE_VBCb&_nc_oc=AdqPDEht-C5DdczkzGWL8k_J0PzJ5uGQ0OU6uOG2eyya43W6iTtMRlMLcobrVW-_6t0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2fMpFaBgDzaJkQX-ustYnozfvQUv7zIfUhtMbDWCxKw&oe=6B006ADA"}, {"file_name": "12232242.png", "id": "2512697309188865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307920_2512697312522198_403256819002593989_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHeYJ4cER1IQ7kNvwEb17h-&_nc_oc=AdoNMiMwQ2jzjKa0frjXYnxUOFAQxd2nxwQ47Ay7ZVZH4WPUMbDGaSCOnDx8RZkoUR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNbs1QUxBF52BB3lJA_DM8Mv4n97FP5TGHjiLmzwtS8Q&oe=6B007BA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpin Hangout", "keywords": [], "long_description": "Chimpin Hangout is a Gorilla Tag\u2013inspired fan game focused on fun movement, exploration, and relaxed social gameplay. Swing, climb, and launch yourself around using arm-powered movement as you explore different hangout maps made for chilling and goofing off with other chimps.\n\nJump between unique locations like the Shop, where you can hang out and check out cosmetics; Zero Gravity, a floaty map that lets you drift, launch, and experiment with movement in a low-gravity environment; and Cozy Corner, a warm and relaxing space perfect for slowing down, chatting, and just being a chimpin. Each map offers its own vibe while keeping the same expressive movement and playful energy.", "short_description": "Chimpin Hangout is a Gorilla Tag fan game focused on movement, exploration, and relaxed social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpinhangout/home?
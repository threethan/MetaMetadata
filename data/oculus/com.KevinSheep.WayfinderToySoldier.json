42_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlwHB7y-S3oQ7kNvwGXE9tx&_nc_oc=AdpzeOURhNUSNI8iRKjnFIB06xLm6tHUBN7Dn8ytGKG8vhTi9TDqbjgNf4RkzUkj9OY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJYSGFtA5hIPF8o35fwCBq5B_0LcORy5StoRme1z7wAQ&oe=69C14ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "860933835290656", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974711_860933838623989_69031312732105415_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2zcIMEU6yAQ7kNvwFB_maY&_nc_oc=Adq4QepC4ggJnn9d0egSJhvFaRI0GqAO_lWLRqZCqEzRxpQ7Xx-J8YKaxnBqScaV8LA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyuwpqBHIQPq0jWTkB8eQesXdR28XkQ2yEDMCYJcy_uIQ&oe=69C1215A"}, "display_name": "Wayfinder Toy Soldier", "keywords": [], "long_description": "Hello everyone,\" Wayfinder Toy Soldier\" is my first independently developed VR casual puzzle game. There are still many areas for improvement, and I appreciate your feedback and understanding. The game features 7 levels, and as you progress, you can unlock various items with different functions. The overall gameplay takes around 20 minutes to complete. Welcome to the challenge! (Recommended for seated play)", "short_description": "Take control of a terracotta soldier as it navigates through a ruined city, dodging obstacles, and solving puzzles on its way to victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQuQVLD-MXc_8PBAscyJPwlHEwwT5GPaeO7_9lBtWlF_jeemb1gEfk9sDfPTbRof1rY40iOMfGNDD_C/pub", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://mt29277547.jzfkw.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "4597815049684
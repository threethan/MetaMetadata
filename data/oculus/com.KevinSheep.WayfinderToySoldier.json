s a demo mode\u2014challenge yourself to complete the level within 15 minutes!", "short_description": "This is a platform puzzle game in which players assume the role of Terracotta Warriors exploring ancient ruins. The goal of the game is to discover the secret entrance that leads to the next level!"}]}, "developer_name": "KevinSheep", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforwayfinder", "developer_terms_of_service_url": null, "publisher_name": "KevinSheep", "support_website_url": null, "website_url": "https://sites.google.com/view/wayfindertoysoldier", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "en_US", "en_GB", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9493951350655071"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392046_509345568428092_7266232199142713411_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dLWjV8CXeEQ7kNvwFcuaD5&_nc_oc=AdnejqSy0sodtr3ndv90VI3-DAyJDoGZrRakJPm9Hg9byTwUQ9Dqidja0K_4X88ulYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu3ttfL6ApKnWLvLqhxJmdHWLa2gK8OxCmbnWUmXcawEw&oe=69983D51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wayfinder Toy Soldier", "platform": "ANDROID_6DOF", "context_category": {"con
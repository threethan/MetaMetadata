J9CNcaULu2pucawzAVCBHQufYujEMFBQ&oe=6B05B78A"}, "display_name": "Wayfinder Toy Soldier", "keywords": ["wayfinder", "toy", "soldier"], "long_description": "During the game, players will acquire three key items:\n\nA spear, which enables the soldier to break boxes.\nA pair of glasses, which allows players to switch to a first-person perspective.\nA virtual hand, which gives players the ability to \"pick up\" the soldier.\nUse these abilities strategically to advance to the end of the level! The game offers a demo mode\u2014challenge yourself to complete the level within 15 minutes!", "short_description": "This is a platform puzzle game in which players assume the role of Terracotta Warriors exploring ancient ruins. The goal of the game is to discover the secret entrance that leads to the next level!"}]}, "developer_name": "KevinSheep", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforwayfinder", "developer_terms_of_service_url": null, "publisher_name": "KevinSheep", "support_website_url": null, "website_url": "https://sites.google.com/view/wayfindertoysoldier", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "en_US", "en_GB", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9493951350655071"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com
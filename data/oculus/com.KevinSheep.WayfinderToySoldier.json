42_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if9TofdcuI4Q7kNvwE_VNqj&_nc_oc=Adlop8yffNvpLo4HtRRCG3-tjzOJAsVIIxaU8anoQuoDIERjLuT7My1qY-VR15d_7SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHplYtpQOeHRd-PZi5NrrRGHIKCXE5jT8eJ4bbGP25Sg&oe=69B0275C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "860933835290656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_860933838623989_69031312732105415_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUAzygUKmWsQ7kNvwGg6ERw&_nc_oc=AdmdBxvBp81ahwEsWhVJlg7KGskG2O-EKr7tcTaVL2-vtWTzEnjx9DBhkcVRz_u6yRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdHjtqz7N0CXblqrrjhGxTMmvCkcVxACTfJcYDYBZxPw&oe=69AFFDDA"}, "display_name": "Wayfinder Toy Soldier", "keywords": [], "long_description": "Hello everyone,\" Wayfinder Toy Soldier\" is my first independently developed VR casual puzzle game. There are still many areas for improvement, and I appreciate your feedback and understanding. The game features 7 levels, and as you progress, you can unlock various items with different functions. The overall gameplay takes around 20 minutes to complete. Welcome to the challenge! (Recommended for seated play)", "short_description": "Take control of a terracotta soldier as it navigates through a ruined city, dodging obstacles, and solving puzzles on its way to victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQuQVLD-MXc_8PBAscyJPwlHEwwT5GPaeO7_9lBtWlF_jeemb1gEfk9sDfPTbRof1rY40iOMfGNDD_C/pub", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://mt29277547.jzfkw.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "4597815049684
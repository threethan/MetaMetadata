42_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xia4wg7N5M0Q7kNvwH7Gmsd&_nc_oc=AdlS5JtzqAWmV6TLFQGhLBlkbfODriNWiCjG40fuUEjYYFsTpm6HMWEV9qf8ivbpc7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuSodOQe9Cx2w5yPNERZo07mF1XJSU7rX7_YljQoGCfCQ&oe=69A98FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "860933835290656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_860933838623989_69031312732105415_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogmxpXsk7e8Q7kNvwESAP8C&_nc_oc=AdmuRnVff2iX5VDnI4BJBg--CJ6qy3Gc6sj6_SiBylAkTxDGo7dswCGOrnTlyUNgeak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKaZS6eGKeSfbxkxtL23aq97oPlobGBgrDOznURlVxKg&oe=69A9665A"}, "display_name": "Wayfinder Toy Soldier", "keywords": [], "long_description": "Hello everyone,\" Wayfinder Toy Soldier\" is my first independently developed VR casual puzzle game. There are still many areas for improvement, and I appreciate your feedback and understanding. The game features 7 levels, and as you progress, you can unlock various items with different functions. The overall gameplay takes around 20 minutes to complete. Welcome to the challenge! (Recommended for seated play)", "short_description": "Take control of a terracotta soldier as it navigates through a ruined city, dodging obstacles, and solving puzzles on its way to victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQuQVLD-MXc_8PBAscyJPwlHEwwT5GPaeO7_9lBtWlF_jeemb1gEfk9sDfPTbRof1rY40iOMfGNDD_C/pub", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://mt29277547.jzfkw.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "4597815049684
42_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKaEefqpKJcQ7kNvwEoJTi1&_nc_oc=AdlvP_XdkqhHBKy7Cq3qeDoQCsk0tvn7YeW5qwYlOEanIbAUnhh5RegXaDkaL8cuh-Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQl6N4VmZGCYMRlRK6dZyj6b6S5u3HKK2jL_loBhyIYQ&oe=69BD565C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "860933835290656", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_860933838623989_69031312732105415_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJxfFTI98IkQ7kNvwGz4iR7&_nc_oc=Adn9_MiPdVfQ2SQsIaGFy6DVmSnmJEqXYrggjM7VgF5gMqcvcMhsF8li4e8BeEnjpsM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJr0s9ENuWvMK7PTXFMUS_vrNrWn8HnwvNgMbt21eJpw&oe=69BD2CDA"}, "display_name": "Wayfinder Toy Soldier", "keywords": [], "long_description": "Hello everyone,\" Wayfinder Toy Soldier\" is my first independently developed VR casual puzzle game. There are still many areas for improvement, and I appreciate your feedback and understanding. The game features 7 levels, and as you progress, you can unlock various items with different functions. The overall gameplay takes around 20 minutes to complete. Welcome to the challenge! (Recommended for seated play)", "short_description": "Take control of a terracotta soldier as it navigates through a ruined city, dodging obstacles, and solving puzzles on its way to victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQuQVLD-MXc_8PBAscyJPwlHEwwT5GPaeO7_9lBtWlF_jeemb1gEfk9sDfPTbRof1rY40iOMfGNDD_C/pub", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://mt29277547.jzfkw.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "4597815049684
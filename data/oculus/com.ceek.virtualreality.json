4560018439417_6822575800466800640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vHMD6935QcQ7kNvwGek8Ox&_nc_oc=AdnScGAYJg3Su0GIWAYYQNrG6dUovKfvATi92-h3toUzaiVb2xQ2rrUSLnjS_23FuSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5xwisaNx68v6IrJu4Tj_iCWF_OxW1VRoffKfNFxvGkw&oe=69999672"}, {"file_name": "migrated_image.png", "id": "897840700675365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031536_357322591494753_613507735744413696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYjkTdW6r5YQ7kNvwH6qF_O&_nc_oc=AdlWbCm66MwQHVA16FU1jDauYhOmuiZHnSapBTYae8zMKqcR4exx1oYljgGLs3CoTPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvthHvSr2BfI4lJcY9JIOSYi5GYSDSndmGcTkdLH37-g&oe=6999B0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/EYR8CW", "id": "2230560720589866", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_2230560723923199_5885763482392985600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhB0fGmMjAgQ7kNvwENd1fx&_nc_oc=AdnZt4e_LSXhhSR3_bfFic7NuUCRd4yNeKu-P1JRo44o99eqQUJ5XQMsB8D5C4_ugvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5-sjcf74FQHWfAFWQWfgPL6wv4ecxr6ydbbPJ70dvIQ&oe=6999AD0A"}, "display_name": "CEEK Virtual Reality", "keywords": ["CEEK", "CEEKVR", "VRConcerts", "VRmovie", "VRmusic"], "long_description": "From 360 VR Videos to True 3D and 180 immersive, CEEK delivers compelling experiences intensified by our award winning patent AWARDED 4D virtual reality audio and AI visual technologies.\n\nFeatures Include: \n- In-app Navigation\n- Mobile VR interaction \n- Multiple VR Environments to choose from\n- Multiple Concerts \n\nExperience your favorite Music Stars in concert, backstage, all access interviews, and intimate performances in 360 VR and 180 VR on ultra-huge \u201cMe Max\u201d Screens in magical environments. Hundreds of top performances\u2014all on one single app \u2013 no need for multiple app downloads. From Lady Gaga to Katy Perry, Snoop Dogg, NAS and Sting, CEEK VR brings you the best documentaries, interviews, and concerts from around the world are on CEEK now, with greater top performances being added regularly. \n\nCEEK VR is the definitive destination for exciting music concerts and premium entertainment experiences in Virtual Reality.", "short_description": "CEEK VR VENUES magnifies and transforms your phone into the most engulfing VR Concert Arena."}]}, "developer_name": "CEEK VR Inc", "developer_privacy_policy_url": "http://ceek.com/privacy", "developer_terms_of_service_url": "https://ceek.com/terms", "publisher_name": "CEEK VR Inc", "support_website_url": null, "website_url": "http://ceek.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455434716239813"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2766685010089819", "version": "1.4.8"}, "id": "1962053387440762", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1688731664551831", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2766685010089819"}, "release_status": "RELEASED"}, "bin
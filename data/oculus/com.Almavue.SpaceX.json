t=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPwVk-48Arf7GVYKClSpeSbeO8m7s-7FDFtFaXZHmsyQ&oe=6B09BF53"}, {"file_name": "G3.png", "id": "2093782741272957", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622162_2093782744606290_5751735700862705883_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTZO3VHwAe0Q7kNvwF3HN1q&_nc_oc=AdovuFEP_hpkFnAAieJ9zuD2ybj8jqbM8nPDiXAh44FK76W5Knh6GzROOpR6d3i4FaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQXRKp0b4yHAjEAghYQLNs8QQkgY_XVKNsh_RbqYXnvA&oe=6B099B32"}, {"file_name": "N7.png", "id": "1662855498748020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622192_1662855502081353_8834491185520450432_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I528U1p7DEEQ7kNvwEIzhYv&_nc_oc=AdolfEmesNOCWgF4smHeeCDrZDnaJZR77Ta8gaJIe9cRNYQfzy4yfBbaFz4T26D9YEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp3Q8WgwBQ1GqZRUEaUnaV0PBn56Ql9BMqH98BPc8Eng&oe=6B09B383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.PNG", "id": "1845462716631033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593716858_1845462723297699_924478102167288524_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEBlGflq9K0Q7kNvwHZbzCT&_nc_oc=Adp_IQPDXqRQbcEPfkkRhzQ9_XccC1brM6S9XhA9ez3uc17UCApYC4fbEpDaRDWGlVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL7lKsfE5GSwH8BViLPQnVh38Ys8uCXjV4x1GIPoWe6w&oe=6B09A0F2"}, "display_name": "SpaceX", "keywords": ["space", "universe", "educational", "science", "cosmology"], "long_description": "SpaceX \u2014 Explore the Universe in Virtual Reality\n\nDiscover the wonders of the cosmos with SpaceX, an immersive educational VR experience developed by Almavue. Explore galaxies, planets, nebulae, and cosmic portals in a captivating three-dimensional environment designed for students, space enthusiasts, and curious minds.\n\nLearn about planets and celestial objects through informative descriptions based on scientific information from NASA. Experience the beauty and scale of the universe while developing a deeper interest in space science and astronomical discovery.\n\nBeyond exploration, SpaceX represents a growing educational vision connecting space science with cosmology, quantum physics, space-time, black holes, and wormholes. Future development aims to explore scientific research alongside the knowledge and perspectives of ancient civilizations, the Quran, and other scriptures, encouraging thoughtful inquiry into the universe, its origins, and humanity's place within it.\n\nThis is the beginning of a broader journey of discovery. Almavue aims to expand SpaceX with new environments, educational content, and perspectives that bring science, history, and reflection together.\n\nEnter the cosmos. Explore, discover, and question the universe.", "short_description": "Explore galaxies, planets, nebulae, and cosmic portals in an immersive educational VR experience designed to spark curiosity about the universe and space science."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.almavue.com/spacex-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Almavue", "support_website_url": null, "website_url": "https://www.almavue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "us
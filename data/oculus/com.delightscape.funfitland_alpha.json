ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_So3tQhPpZpgmVolv8CDH4SAA309cwLn5TDjlHHU5hQ&oe=6AFDADB7"}, {"file_name": "3.png", "id": "6636089333126992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031360_6636089336460325_3054016984900627763_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n6VsJLILJ8Q7kNvwFcItZm&_nc_oc=Adpdx5XaVt47V1JCxRPY3WIZu32osUDKU-iDIVf5fNsBWMM2f7zAYPSgdAT_9ySvpZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6-TZWqsAD2l5c7mH8X8MtbbDH2sk723DO5LI07gBMzg&oe=6AFDBE91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "292313986974027", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75326675_292313996974026_2821468147987449922_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSCZMxF1tKkQ7kNvwGksKRC&_nc_oc=AdqT2nOsmiYBsZiUWy7YMp_g8c4fypWPc12cy64Bgiu_BfkWE2tqYB5mPDH_obUB47o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWnwcU9KV_uQ0jts0SA4FGJf5m2ZjhR_xvGWKx4Cyh7g&oe=6AFDCD57"}, "display_name": "FunFitLand", "keywords": [], "long_description": "Discover FunFitLand: Dive into a world of truly innovative fitness adventures. Encounter workouts that feel instinctive, utterly delightful, and unmistakably new. JOIN ALPHA NOW and co-create a fitness journey that resonates with your vibe. \n\n\ud83d\udc83 DanceFit: More Than Just Dance\nExperience dance in a new light with DanceFit, where every beat turns into a spontaneous step, making each workout feel like a lively dance party. Whether with a controller or just your hands, the experience is immersive, allowing you to explore the essence of movement in a fitness-oriented manner.\n\n\ud83e\uddb8 CombatFit: Embrace the Fighter Within\nUnleash your energy with CombatFit. Engage in sequences that feel organic. Each strike and combo brings a rush, making workouts thrilling.\n\n\u270b Hand-Tracking **Experimental**\nGo controller-free! Natural hand movements lead you through a new world of possibilities \u2014 chop, slash, even finger snaps!\n\n\ud83c\udfcb\ufe0f Real Coaches, Always On:\nWith our dedicated coaches by your side, you're never alone. They guide, motivate, and help you harness the full potential of every session.\n\n\ud83c\udf08 A Visual Feast\nEnjoy workouts within stunning landscapes that enhance your fitness journey with beauty and engagement.\n\n\ud83e\udd1d Become a Part of FunFitLand\nJoin a community where your feedback and success are celebrated. Here, workouts are more than just exercise; they're a fun journey we take together. Your thoughts help us improve, making fitness both enjoyable and rewarding for everyone.", "short_description": "Step into FunFitLand, where dance grooves and combat moves blend in a fresh and innovative fitness experience! Try DanceFit, where every beat turns into a spontaneous step, making each workout feel like a lively party. Want something more intense? CombatFit provides a new, thrilling rush. With our passionate and friendly coaches leading the way, each session is bursting with energy and enjoyment. JOIN ALPHA NOW and immerse yourself in the FunFitLand community \u2013 where fun and fitness converge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.termly.io/document/privacy-policy/0163988b-469b-4e76-947f-625a686149bd", "developer_terms_of_service_url": "https://app.termly.io/document/terms-of-service/a47ec382-a72e-4903-bffd-f846c153ff8d", "publisher_name": "DelightScape Interactives", "support_website_url": null, "website_url": "https://www.funfitland.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
w3hmHExDBJ6Nmvz_DAts3h7Vl189WGoOzh-qaduzG8R0UbbMxYHDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCO9GJopFkxXLYZYqAW-dWnJqsMSzbUyVwHGS7xaDb9g&oe=6AFDDE51"}, {"file_name": "20260824-232105.png", "id": "28391434167163745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628455_28391434183830410_9130136122805925918_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLyxS3BNT6MQ7kNvwHluQon&_nc_oc=AdoiE-wj-k0BkStJZXT0TLQaZDlEhpk-BeVGS5HTjaqCJc08k8Nk_kjrNqDNB7ujuVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEb-xvOnmaQkhcv30s2WZU8Rnvf0N-J4JuUQGV5p-Mtw&oe=6AFDDC09"}, {"file_name": "flowfit quest new (1).png", "id": "1147590990436638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_1147590993769971_7852789205009272978_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99cJFFew02sQ7kNvwF-xo9j&_nc_oc=AdpKwJSWjBzW1B39lKIrUvcgzqIduTp_2k6EI6tMlx3SQDN4tnSpG4Z3T8uiukSDMVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnrWo-c_eYuIlAYBDkG9ZmM2qxFUHcmEWek9L7wbrcKQ&oe=6AFDCD3E"}, {"file_name": "groovefit quest new (1).png", "id": "2497730483977118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_2497730487310451_1543803308408788223_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG7Ynv2G4ZgQ7kNvwEgTmLe&_nc_oc=AdoGxwskyHI_LmJcwPkrTlruNZlhB10fZqxCxBvKDfEO7JEvkDox1crf7HJ9sYPvWk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3xX07vM7kzUTceW-iS4ZZCe5sP7dc6s2nocut_MoiFg&oe=6AFDB84B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499618264_2361805894308451_1690198328499421399_n.png", "id": "1280366897005948", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_1280366900339281_6642077055206171541_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-MHCKnyW68Q7kNvwFuiVhG&_nc_oc=Adpd-poaqIkAC8EKAkuHA6RtejnBMXe92V5sjeg398y_sy0CaUkhr07NKaAuaMfs6oI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmsF5V48Zga80nimEBfK-ediXnMjLsIwNsGnGekLA7rQ&oe=6AFDD6EC"}, "display_name": "FunFitLand: Boxing, Cardio, Meditation", "keywords": ["fitness", "workout", "flow", "boxing", "dance"], "long_description": "# Start for $0, then 30% off year one. A top-rated Quest fitness app, 4.6\u2605.\n\nBoxing, dance, flow, and moving meditation in one fitness app. Workouts so fun, you may forget you\u2019re working out.\n\n**\ud83e\udd4a Serious fun. A real workout**\n\nGreat music, satisfying hits, and carefully choreographed moves make exercise feel exciting the whole time. Finish sweaty, energized, and wanting one more round.\n\n{2017499636307765}\n\n**\u2728 More ways to move. New workouts every week**\n\nExplore dozens of series, from seated stretching, Tai Chi, walking, dance, and flow to intense boxing, HIIT, Battle Rope, and Knee Strikes. Match your energy, fitness level, and needs with new sessions weekly.\n\n**\ud83d\udc9b Real coaches. A community cheering you on**\n\nReal coaches guide and encourage you through each workout. Share progress, celebrate wins, and stay motivated in a welcoming community.\n\n{829317776888661}\n\n**\ud83e\udd1d Multiplayer. More fun when we move together**\n\nChat, laugh, and work out with friends old and new. Discover public rooms, join mid-workout, or start first and let others join later. Language preferences help you find partners who speak your language.\n\n{1333284128868029}\n\n**\u2764\ufe0f See your heart rate as you train**\n\nConnect a compatible watch or Bluetooth heart-rate monitor via the mobile app. See your heart rate in-headset as you exercise. Sync workouts to Apple Health to help close your rings.\n\n{2503911650089915}\n\n**\ud83d\udcaa More ways to train with hand tracking**\n\nMove freely without controllers, add real equipment like dumbbells and cable machines to your workout. Hand tracking across every mode makes it possible.\n\n**\u25b6 Start your free trial today**\n", "short_description": "Dive into a journey so enjoyable that you'll forget you're working out. Engage with premium workouts that feel intuitive, delightful, and refreshingly new."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.funfitland.com/privacy-policies", "developer_terms_of_service_url": "https://www.funfitland.com/terms-of-service", "publisher_name": "DelightScape Interactives", "support_website_url": null, "website_url": "https://www.funfitland.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "zh_CN", "zh_HK", "zh_TW", "ko", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "29661859330084743"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_2050796272133739_1507038440084641820_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUdvAke3YZoQ7kNvwF2TEL5&_nc_oc=AdqImpfA6oJkBKrnCaZlHWR6rGij_eL01FxDuL5Zbka-tvIeduMvr9_V5mK9DblREVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgkHXVpZYBqibhpymb0QHIMpRFLB_ZfwKlBGkOmBIivw&oe=6AFDCB38"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FunFitLand: Boxing, Cardio, Meditation", "platform": "ANDROID_6DOF"
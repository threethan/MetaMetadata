qrxQoQ7kNvwFZR-sf&_nc_oc=Adp3Ty6s7CUkrYJl208n7naxdsblfnlz5pgq2i0Sd60CTCvacSuFcZRvmixzLN_zdZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVebOzZFOgQokkBtIYYRHb85sUjIcnGdKIGnX2TwBBYA&oe=6A60AFEC"}, {"file_name": "ss 3.png", "id": "3096393317228120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_3096393320561453_642103767365687810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga6t69D3_jEQ7kNvwHmWfEx&_nc_oc=AdpWYZzJfGdUxIR5I8sMNR7g5g1gAHha16qrOqH8eJEFxJRhoBOfKR4ikQ5MzjUuYFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnJVjnbpQiUTJDMOZForITliBhIhLGjrS1jKnDxLGv9w&oe=6A60D830"}, {"file_name": "ss 5.png", "id": "1209645087615857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1209645090949190_9176832368939179117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uc0Mz2NACMQ7kNvwHMqLOU&_nc_oc=AdoLt0bWUXiTcJTAa8m12tSM2Wm0fQK16fdgutHT4uPHoWUaTY2gL2bnqisneti6b9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5NQ1Lr75dD-S-VzfT2RK0U1_JaXhY4JiB2NombrP9ZA&oe=6A60BF2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Hud", "keywords": [], "long_description": "Surah Hud \u2013 VR Experience\n\nExperience the recitation of Surah Hud, the eleventh chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and distraction-free space to listen, reflect, and connect deeply with the teachings of Surah Hud. The immersive virtual environment and high-quality audio make it easy to follow and meditate on the verses.\n\nSurah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges.", "short_description": "Surah Hud highlights the stories of past prophets and their communities, emphasizing patience,
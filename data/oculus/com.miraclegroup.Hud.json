t64.5771-25/491824307_1209645090949190_9176832368939179117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG53Oaf6OIIQ7kNvwHQS39a&_nc_oc=Ado3AdPVMedxd7hUhChYhfA6tZPgwZAVu2z-P1qrQjhwDMcqUYdl28t05Dshlqpl1t0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBm6yg6-sRBtHLDYEB4oTJIe1a32zDaqhc1xug8j2rdA&oe=69C67FAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Hud", "keywords": [], "long_description": "Surah Hud \u2013 VR Experience\n\nExperience the recitation of Surah Hud, the eleventh chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and distraction-free space to listen, reflect, and connect deeply with the teachings of Surah Hud. The immersive virtual environment and high-quality audio make it easy to follow and meditate on the verses.\n\nSurah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges.", "short_description": "Surah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvk68WCVHoYQ7kNvwHdi8n6&_nc_oc=AdpyCy0OI_munKN6tpvusUydzFzd3tm-r3xH4zuQ4dV13HbCbFRwcW16xOkeaE0Nemw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7cm0YoinpRP6-5DG-Xp4UxpST_PARRLpplFmrzb6SKA&oe=69CBDEB0"}, {"file_name": "ss 5.png", "id": "1209645087615857", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824307_1209645090949190_9176832368939179117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRnE_NIhVKwQ7kNvwEsCsYV&_nc_oc=AdrfF8R7Y13u8BKquxUHwT8PzCHA6nDlLzgvZVxTzja3tKaQJPOD1zjWnaR9WRqWx9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCd3sNPBWBVfCnMrRg82qsN4UUY4uc0P4TQg02hCHvdw&oe=69CBC5AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Hud", "keywords": [], "long_description": "Surah Hud \u2013 VR Experience\n\nExperience the recitation of Surah Hud, the eleventh chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and distraction-free space to listen, reflect, and connect deeply with the teachings of Surah Hud. The immersive virtual environment and high-quality audio make it easy to follow and meditate on the verses.\n\nSurah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges.", "short_description": "Surah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www
nce, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges.", "short_description": "Surah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34251134444534416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824741_955028843534172_6410011322680498165_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlXqUN-qB94Q7kNvwFt6HbV&_nc_oc=Adp_HJGfbOFxnOwxlKonVSxlJ146LdZPR6CkbFw07L58OWBX2Wq2LE34_37Zg1aA2Cs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRis04nwe-HcBOGx1MaBFlgesqu7ruY6i59Swu5TDKsOA&oe=6AFB3FE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Hud", "platform": "ANDROID_6DOF", "context_cate
_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RcwMtKeYycQ7kNvwHojmqb&_nc_oc=AdrX3Crb1w7R8OR9-i1VKQS7NDOrTxl5d7kk_c48RezdjZggQE00jX_JIY-U3w0TS7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwasHbUTazjQkLaz-TrbjThOukY4sv9Lf4yd4WQaee71Q&oe=69D124B0"}, {"file_name": "ss 5.png", "id": "1209645087615857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824307_1209645090949190_9176832368939179117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ8I82YjsscQ7kNvwFaZl6E&_nc_oc=AdqcXokyt1NVJk8av4IiCElrfeLWWhGvXIlUv_LoJhnDnE6YvkFfA0jRrhFnxV-Hlhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1vycInV5m63ozyOaKnwzJ-XkZpphKSYZb6OBDcxyTWA&oe=69D10BAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Hud", "keywords": [], "long_description": "Surah Hud \u2013 VR Experience\n\nExperience the recitation of Surah Hud, the eleventh chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and distraction-free space to listen, reflect, and connect deeply with the teachings of Surah Hud. The immersive virtual environment and high-quality audio make it easy to follow and meditate on the verses.\n\nSurah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges.", "short_description": "Surah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www
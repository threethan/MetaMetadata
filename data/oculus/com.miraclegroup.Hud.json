_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rvk68WCVHoYQ7kNvwEBqR_k&_nc_oc=Adqrg3Sopmo8MFlMS3WCS_JHo8EtOD4jflSe1Mq1qeK6iUnRFp7ZLJ9n8AkO-MHizro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnlGIpt9d70ti9-gjURXy0-4J0s53KsNPmxGTcvLiH2A&oe=69CA54F0"}, {"file_name": "ss 5.png", "id": "1209645087615857", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1209645090949190_9176832368939179117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRnE_NIhVKwQ7kNvwFA5n1Z&_nc_oc=AdqQ2QJW_hTg-Iy0MMoqY6cyOAbZ-xgUryKqJ2u2XHys-ZILLr0HQJCb9Z_opi5hTyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUxAVDNnDlwBelx-xkmIBzoAHDv2a5hDGhAr-s7F6DoA&oe=69CA742B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Hud", "keywords": [], "long_description": "Surah Hud \u2013 VR Experience\n\nExperience the recitation of Surah Hud, the eleventh chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and distraction-free space to listen, reflect, and connect deeply with the teachings of Surah Hud. The immersive virtual environment and high-quality audio make it easy to follow and meditate on the verses.\n\nSurah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges.", "short_description": "Surah Hud highlights the stories of past prophets and their communities, emphasizing patience, perseverance, and obedience to Allah. It teaches believers lessons about faith, accountability, and trusting in Allah during challenges."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www
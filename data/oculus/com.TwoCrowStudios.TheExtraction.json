{"file_name": "Untitled design (7).png", "id": "760533521614935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001703_760533524948268_5929132528678025364_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlMii_gkQnsQ7kNvwEQ9cEL&_nc_oc=AdrHoLynY-EVQEMWB_U91y6MecOFGcRS1bAq_jW2n4N_YHSYvNQ-2NRO-1EKU6E6nrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fruglIWuc9WTyTctcEbY4vkCR77GTI6zCkU0RAvD75w&oe=6A43D10E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THE RETRIEVAL (2).png", "id": "1059497764697325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982500_1059497768030658_269254459267951193_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oD79j11urB8Q7kNvwFOWsHB&_nc_oc=AdozkKXtpFtzoh-TBsqvg0Z1U8PdOkMEuSiADlSKf6ppdJKtgEf1Y4pDECeZHXNA3kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HmyyfJ4yzEweZakI71geej7zzFOsrtAqwZXBCshCzrg&oe=6A43BA93"}, "display_name": "The Retrieval", "keywords": [], "long_description": "THE spaceship Prometheus has re-emerged after being lost for over 200 years. It's not responding to our calls or emitting any signals. The mission is simple: dock in, try to make contact with the crew and if not possible, learn what happened and leave.\n\n\nThe Retrieval is a sci-fi horror puzzle taking place in the far future. Navigate your way through abandoned spaceship learning what happened to the crew.\n\n If you enjoy puzzles games and mind bending horror environments - this game is for you. And remember, the deep space can play tricks to the mind..\n\nWarning: this game contains sudden horrifying moments.\n\nThis game will receive regular updates.", "short_description": "THE spaceship Prometheus has re-emerged after being lost for over 200 years. It's not responding to our calls or emitting any signals. The mission is simple: dock in, try to make contact with the crew and if not possible, learn what happened and leave.\n\nThe Retrieval is a sci-fi horror puzzle taking place in the far future. Navigate your way through abandoned spaceship learning what happened to the crew. If you enjoy puzzles games and mind bending horror environments - this game is for you.\n\n"}]}, "developer_name": "Two Crow Studios", "developer_privacy_policy_url": "https://www.twocrowstudios.com/privacy-policy-the-extraction", "developer_terms_of_service_url": null, "publisher_name": "Two Crow Studios", "support_website_url": null, "website_url": "http://www.twocrowstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "387580136682134"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1961658894469765"}, {"status": "PUBLISHED", "id": "1457479632164151"}, {"status": "PUBLISHED", "id": "1948020815801460"}, {"status": "PUBLISHED", "id": "2146962592785187"}, {"status": "PUBLISHED", "id": "896639459931343"}, {"status": "PUBLISHED", "id": "1645073766934577"}, {"status": "PUBLISHED", "id": "1243417264373190"}, {"status": "PUBLISHED", "id": "854733723713916"}, {"status": "PUBLISHED", "id": "1848385909430586"}, {"status": "PUBLISHED", "id": "1421698462496712"}, {"status": "PUBLISHED", "id": "738425604482500"}, {"status": "PUBLISHED", "id": "561271025676333"}, {"status": "PUBLISHED", "id": "488318566101696"}]}, "baseline_offer": {"id": "896639459931343"}, "is_approved": tru
nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKyKss91aB9RHQHBEqcAYY0orueu-Q-XcoXdhXSkGJJA&oe=6A92DF22"}, {"file_name": "Ear Symptom Investigation Simulator_screenshot_05.png", "id": "419249807665712", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031583_419249820999044_835207457413829966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLrhl8BBOpgQ7kNvwH8kkkF&_nc_oc=Adoob1YlHED0Qy9P6C28BgIvPfbU8j2emT_c59YGRSkJ1uHwGn7j0nvSlSNKbn_726k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7TiQYwXMmRwr7R4Sc-7ENf_IE-M27XXZRXVsjVEPBZQ&oe=6A92B0DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1494725554463067", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974903_1494725557796400_7550125774767171861_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlrgGUBq_XYQ7kNvwEaT2vl&_nc_oc=AdrnEY3I-yy6SD2mkAYseTIgxQQJP5YEJcytcT1H9vjH-vrd7wg4eUp2PqGP6eqSx18&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq-z7i8rCunJCjDRKjo-EsST1EcRwnxrUjKs0s3ua5VQ&oe=6A92CCAE"}, "display_name": "Ear Symptom Investigation Simulator", "keywords": [], "long_description": "The Ear Symptom Investigation Simulator app immerses participants in a realistic and interactive environment to practice examining patients' ears using an otoscope. This application guides users through the selection and proper use of an otoscope, identifying common ear symptoms such as infections, blockages, and abnormalities.\n# Learning Objectives:\n- Remembering the anatomy of the ear and common symptoms\n- Understanding the implications of different ear conditions\n- Applying the correct technique for using an otoscope in a virtual scenario\n- Analyzing the visual cues presented in the ear canal\n- Evaluating the findings against standard medical criteria\n- Creating a report or action plan based on the examination results.  \n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are well-prepared to perform ear examinations accurately and diagnose potential issues in clinical settings.", "short_description": "Designed to train CNAs in conducting ear examinations using an otoscope to identify and interpret common ear symptoms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7540608226059938"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1833414617224053"}, {"status": "PUBLISHED", "id": "2090194768030075"}]}, "baseline_offer": {"id": "1833414617224053"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743460, "status": "PUBLISHED", "id": "1833414617224053"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24013238105037023", "version": "2.0"}, "id": "818553293483316", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7540608182
3dgMJ6XyYERCwNDUE_AXssYTp_MPEQHhNW2eKXsmg&oe=69C140A2"}, {"file_name": "Ear Symptom Investigation Simulator_screenshot_05.png", "id": "419249807665712", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031583_419249820999044_835207457413829966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc1BVZ94XgwQ7kNvwEItrFR&_nc_oc=Adr-zTVFNuFJlub-_IKgGch2rwYe4d46H-WEx0XSivb740T4FohnIB4JMxRn_Gk-43o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwS7zE1qVWlCAoRGgrCh9TGVZrN0L2MhyWcwDIr2w1zCQ&oe=69C14A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1494725554463067", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974903_1494725557796400_7550125774767171861_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P45g9NLpJgQ7kNvwF5kbya&_nc_oc=Adog8SSIATgpivFGebatMS3bJffWee9NvU-mmb4kzdBjnuD2wVa4MGX5243ABTGxU8g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw24Hijwg93MkDEyaE_Fm9qn0s0-S3zYrEQxw4tdjYTJA&oe=69C12E2E"}, "display_name": "Ear Symptom Investigation Simulator", "keywords": [], "long_description": "The Ear Symptom Investigation Simulator app immerses participants in a realistic and interactive environment to practice examining patients' ears using an otoscope. This application guides users through the selection and proper use of an otoscope, identifying common ear symptoms such as infections, blockages, and abnormalities.\n# Learning Objectives:\n- Remembering the anatomy of the ear and common symptoms\n- Understanding the implications of different ear conditions\n- Applying the correct technique for using an otoscope in a virtual scenario\n- Analyzing the visual cues presented in the ear canal\n- Evaluating the findings against standard medical criteria\n- Creating a report or action plan based on the examination results.  \n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are well-prepared to perform ear examinations accurately and diagnose potential issues in clinical settings.", "short_description": "Designed to train CNAs in conducting ear examinations using an otoscope to identify and interpret common ear symptoms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7540608226059938"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24013238105037023", "version": "2.0"}, "id": "818553293483316", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7540608182726609", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24013238105037023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "818553293483316"}]}, "change_log": n
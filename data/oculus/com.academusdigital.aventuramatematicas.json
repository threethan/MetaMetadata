y sonora.\n\nAl completar los desaf\u00edos, descubre el resultado de tu aventura y decide si quieres volver a jugar o salir de la experiencia.\n\nLa interacci\u00f3n est\u00e1 dise\u00f1ada espec\u00edficamente para realidad virtual mediante controles XR y apuntado por rayos, ofreciendo una experiencia sencilla, accesible y enfocada en el aprendizaje mediante la pr\u00e1ctica.", "short_description": "Explora una isla en realidad virtual y supera divertidos retos matem\u00e1ticos mientras aprendes, obtienes monedas y avanzas hasta completar la aventura."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.academusdigital.com/politica-de-privacidad-apps/", "developer_terms_of_service_url": null, "publisher_name": "AcademusDigital", "support_website_url": null, "website_url": "https://www.academusdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323316050875240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/769741158_1412999360756532_7756414568475520470_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHcFD6GgP7QQ7kNvwHmAcgI&_nc_oc=Adq528gllHdANxw_9lGiC3I9m8WyYiAtMfg7vylLHVb93gvQFdR4bh3cpPaxVFhpXso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3_IIwVRHEplphYU2_CBZbgx0aVwMROy0FbS4SFX9DCg&oe=6AFDBE
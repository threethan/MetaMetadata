0356520377", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75411996_462100359853710_1806972303768212876_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GknDlHk28wAQ7kNvwFEg5og&_nc_oc=Adm-wi9xAPgxYhz182vFiEmoHgNkVPy0sZ_nvQ2k5LLLm9E7ysTItBoFiupWenTAP3Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvN3tTPvlHle3d4XiM3jQz7iRW8U1HDdylllkut_ZRQ5A&oe=69A575AD"}, "display_name": "SimX Preview", "keywords": [], "long_description": "SimX is the first professional-grade wireless, multiplayer VR medical simulation. Physicians, nurses, and allied professionals can practice their skills on any virtual patient in any environment. Designed by physicians at Stanford and UCSF and already in use at top medical and nursing schools across the country, SimX is the most advanced VR medical training system.", "short_description": "SimX is the first professional-grade wireless, multiplayer VR medical training simulation. Physicians, nurses, and allied professionals can learn their skills on any virtual patient in any environment. Designed by physicians at Stanford and UCSF and already in use at top medical and nursing schools across the country, SimX is the most advanced VR medical training system."}]}, "developer_name": "SimX, Inc.", "developer_privacy_policy_url": "https://www.simxvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimX, Inc.", "support_website_url": null, "website_url": "https://www.simxvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
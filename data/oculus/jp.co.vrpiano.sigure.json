.com/v/t64.5771-25/491822905_559420667174805_1052944879066421940_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9bgLAbKC6QQ7kNvwHW-Hbx&_nc_oc=AdneJ4ShqSAJ5BAibmNIhWyZVFVVPESFSl84VvLmeGn_dFcE_iPSTlWYWN2wWwPkRlo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyCUe1XSXVFvu-DQanVlP7YdL6a9Q8YWOqVRngT6dGcA&oe=69AAC2DC"}, {"file_name": "5.png", "id": "1855642151935300", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819973_1855642155268633_4300854261531738100_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH4EM6C535EQ7kNvwHyp5OJ&_nc_oc=Adk9YU4Ht1Cr8-NBFyug65NMPxGeAyYzoF-IYAWzPBCUVuG1RHA4dphGCL8WgIrhBLw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_B-jc2ITn5YJ5Ajj2SYSDWo1L2m_fZCzy_I24dbfEmQ&oe=69AAC47B"}, {"file_name": "step.png", "id": "1345571343108729", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982671_1345571346442062_8682380559220754951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=my_aOEByHHgQ7kNvwGNDXOs&_nc_oc=AdnXM4-qx7ZtLEiLlrU_YzFpI_3Va0a2B-1VzGBjgDBh1oqUOu2Pi6cSA3slBkwhYes&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwabihRErb99XTfM1Bz7xqEXMsPemNoCJnf32gJbZySGQ&oe=69AADCCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.2560.png", "id": "3188301451322944", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393325_3188301457989610_2905020728757799789_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sYGEpA_pcsQ7kNvwHUAYeJ&_nc_oc=AdkOnttH94d1wQ2MufcvMoq_aMiEu-u8zKIx__-ucd7ER5C9fhErYbcxwaV38ganEAU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfycpajR8aFaj2i4MfCgJwATc_RLtn7PPINoFbkd-Zzb6Q&oe=69AAD044"}, "display_name": "Sigure", "keywords": ["\u30d4\u30a2\u30ce", "piano", "Sigure", "\u6642\u96e8", "\u97f3\u30b2\u30fc"], "long_description": "\"Sigure\" is a MR piano game that lets you enjoy playing on an actual piano.  \n\nEven beginners who can't read sheet music can intuitively play the piano.  \n\nFor those with piano experience, the game also offers the option to display sheet music for a more traditional playing experience.  \n\nIn addition to classical pieces, the game features a wide selection of popular J-POP and anime songs. Enjoy performing your favorite tracks while aiming for a high score!  \n\n---\n\n\u25bcSong List\nhttps://vrpiano.co.jp/sigure/music/\n\nWhen you install the app, it includes 50 tracks as part of the initial song collection.  \n\nYou can also purchase additional tracks one by one, with over 150 songs currently available for purchase. More songs are added every month!  \n\n---\n\n\u25bcPractice Mode\n\nIf you're struggling with a piece, the \"Practice Mode\" lets you rehearse at your own pace.  \n\nFeatures include:  \n- Speed adjustment  \n- Section looping  \n- Practice with one hand at a time  \n\n---\n\n\u25bcImprovement Program\n\nTo help even complete beginners enjoy the piano, we\u2019ve created a step-by-step improvement program called \"Step-Up 30.\"  \n\nThe program was developed under the supervision of an experienced piano instructor who specializes in teaching adult beginners, allowing even those who are touching the piano for the first time to learn the basics of finger movements.\n\n---\n\n\u25bcWhat You'll Need\nhttps://vrpiano.co.jp/sigure/prepare/\n\n- Meta Quest 3 / 3s\n- Digital Piano (88 keys with a USB port) \n- MIDI Cable", "short_description": "\"Sigure\" is an MR piano game that lets you enjoy playing on an actual piano.\n\nBy moving your fingers in sync with the note bars displayed above the piano keys, even beginners who can't read sheet music can intuitively play the piano.\n\n\u203bPlease prepare a digital piano and a MIDI cable separately.\n\nIn addition to classical pieces, the game features a wide variety of popular J-POP and anime songs. Enjoy playing your favorite tunes while aiming for a high score!\n"}, {"images": {"nodes": []}, "id": "690407393455121", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30d4\u30a2\u30ce", "keywords": ["\u30d4\u30a2\u30ce", "sigure", "\u6642\u96e8", "\u97f3\u30b2\u30fc", "piano"], "long_description": "\u300cSigure\u300d\u306f\u3001\u5b9f\u969b\u306e\u30d4\u30a2\u30ce\u3067\u697d\u3057\u3081\u308bVR\u30fbMR\u30d4\u30a2\u30ce\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u30d4\u30a2\u30ce\u4e0a\u306b\u8868\u793a\u3055\u308c\u308b\u30ce\u30fc\u30c4(\u97f3\u306e\u68d2)\u306b\u5408\u308f\u305b\u3066\u6307\u3092\u52d5\u304b\u3059\u3053\u3068\u3067\u3001\u697d\u8b5c\u304c\u8aad\u3081\u306a\u3044\u521d\u5fc3\u8005\u3082\u76f4\u611f\u7684\u306b\u30d4\u30a2\u30ce\u3092\u5f3e\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\n\u3010\u3054\u6ce8\u610f\u3011\n\u96fb\u5b50\u30d4\u30a2\u30ce\u3068MIDI\u30b1\u30fc\u30d6\u30eb\u3092\u5225\u9014\u3054\u7528\u610f\u304f\u3060\u3055\u3044\u3002\n\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\n\n\u697d\u8b5c\u3092\u8868\u793a\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u308b\u305f\u3081\u3001\u30d4\u30a2\u30ce\u7d4c\u9a13\u8005\u3082\u697d\u3057\u3081\u307e\u3059\u3002\n\n\u30af\u30e9\u30b7\u30c3\u30af\u66f2\u3060\u3051\u3067\u306f\u306a\u304f\u3001\u4eba\u6c17\u306eJ-POP\u3084\u30a2\u30cb\u30e1\u30bd\u30f3\u30b0\u3082\u591a\u6570\u53ce\u9332\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u597d\u304d\u306a\u66f2\u3067\u30d4\u30a2\u30ce\u6f14\u594f\u3092\u697d\u3057\u307f\u306a\u304c\u3089\u3001\u30cf\u30a4\u30b9\u30b3\u30a2\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\uff01\n\n\n\u3010\u53ce\u9332\u66f2\u3011\nhttps://vrpiano.co.jp/sigure/music/\n\n\u30a2\u30d7\u30ea\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6642\u306b\u3001\u521d\u671f\u697d\u66f2\u3068\u3057\u3066\u7d0450\u66f2\u304c\u53ce\u9332\u3055\u308c\u3066\u3044\u307e\u3059\u3002\n\u305d\u306e\u4ed6\u3001\u597d\u304d\u306a\u66f2\u30921\u66f2\u305a\u3064\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\n\n\u8ffd\u52a0\u8cfc\u5165\u3067\u304d\u308b\u697d\u66f2\u306f\u73fe\u5728200\u66f2\u4ee5\u4e0a\u3092\u3054\u7528\u610f\u3057\u3066\u304a\u308a\u3001\u4eca\u5f8c\u3082\u6bce\u6708\u8ffd\u52a0\u3057\u3066\u3044\u304f\u4e88\u5b9a\u3067\u3059\u3002\n\n\n\u3010\u7df4\u7fd2\u30e2\u30fc\u30c9\u3011\n\n\u4e0a\u624b\u304f\u5f3e\u3051\u306a\u3044\u6642\u306f\u3001\u300c\u7df4\u7fd2\u30e2\u30fc\u30c9\u300d\u3067\u81ea\u5206\u306e\u30da\u30fc\u30b9\u3067\u7df4\u7fd2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30fbStay Notes\u6a5f\u80fd\n\u30fb\u901f\u5ea6\u8abf\u7bc0\n\u30fb\u90e8\u5206\u30ea\u30d4\u30fc\u30c8\n\u30fb\u7247\u624b\u305a\u3064\u7df4\u7fd2\n\n\n\u3010\u4e0a\u9054\u30d7\u30ed\u30b0\u30e9\u30e0\u3011\n\n\u521d\u5fc3\u8005\u304b\u3089\u3067\u3082\u30d4\u30a2\u30ce\u3092\u697d\u3057\u3081\u308b\u3088\u3046\u306b\u3001\u30b9\u30c6\u30c3\u30d7\u30a2\u30c3\u30d7\u5f0f\u306b\u4e0a\u9054\u3067\u304d\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u300c\u30b9\u30c6\u30c3\u30d7\u30a2\u30c3\u30d730\u300d\u3092\u4f5c\u6210\u3057\u307e\u3057\u305f\u3002\n\n\u5927\u4eba\u306e\u521d\u5fc3\u8005\u3078\u306e\u6307\u5c0e\u7d4c\u9a13\u306e\u8c4a\u5bcc\u306aAya\u5148\u751f\u306e\u76e3\u4fee\u306e\u3082\u3068\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u4f5c\u6210\u3057\u307e\u3057\u305f\u306e\u3067\u3001\u521d\u3081\u3066\u30d4\u30a2\u30ce\u306b\u89e6\u308c\u308b\u65b9\u3067\u3082\u6307\u306e\u52d5\u304b\u3057\u65b9\u306e\u57fa\u790e\u304b\u3089\u5b66\u3093\u3067\u3044\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\n\u3053\u306eVR\u30d4\u30a2\u30ce\u30b2\u30fc\u30e0\u300cSigure\u300d\u3067\u3001\u65b0\u3057\u3044\u30d4\u30a2\u30ce\u4f53\u9a13\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\uff01\n\n\n\u25bc\u5fc5\u8981\u306a\u3082\u306e\nhttps://vrpiano.co.jp/sigure/prepare/\n\n\u30fbMeta Quest 3 / 3s\n\u30fb\u96fb\u5b50\u30d4\u30a2\u30ce\uff08USB-B\u307e\u305f\u306f\u4e38\u578bMIDI\u30dd\u30fc\u30c8\u4ed8\u304d\uff09\n\u30fbMIDI\u30b1\u30fc\u30d6\u30eb", "short_description": "\u300cSigure\u300d\u306f\u300
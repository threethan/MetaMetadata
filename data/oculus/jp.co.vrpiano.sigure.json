5015191054", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974913_545015018524387_7510488970179780669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HznSKje3yY8Q7kNvwH0vq4K&_nc_oc=AdlumnNGh2bxalRvB6OufKrkw6kAMZrh4epq5JHCbGTAHlPklEgH0NgEXs5cVg__niw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXtOx7ya5uYYOCR2_RkQAWhVEktK-unCoBEjpMR7qKcw&oe=69A050EF"}]}, "id": "989828439729104", "locale": "en_US", "screenshots": [{"file_name": "playtest.png", "id": "1140298424218272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391967_1140298427551605_6767300443633178565_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYWD81AMXFMQ7kNvwErxG7k&_nc_oc=AdnNxAmqIdUIkvCuzNi-gEeyhamyR1A9pPKGCUfUZ8JQfEnh4UZz0cqGRqq_cwUGuyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsa5BALY00IxJeCgFyZq8THpxVl9vxJjTam25j_sLGepQ&oe=69A054F3"}, {"file_name": "sigureplay.png", "id": "645975077821839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391862_645975081155172_6181115374461373687_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEQHXaxQ7UYQ7kNvwFIqzhK&_nc_oc=AdnXvupV0-_cK_BFqmFsAiuaJZoNTkzPXVcVgCS6RUaDWx2xBmk2DEbjb9Ein8qU-t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgLUJ2JCzqwwOSjmeDvYRoor8ebovcDlOMV8x7okMuXA&oe=69A03C04"}, {"file_name": "img02 2.png", "id": "993772642783741", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974524_993772646117074_7360622431510259495_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WWkrCoz8zIQ7kNvwFiNxvK&_nc_oc=Adnw0oWvzPCzjqhKcVFDOB7kVfmSNEDl4wxBmmlAP1ERF2R35nt8NNEidrkV0ckTlsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftw3Z5EEBQvz9si3GQhaAt_PonuNeLNfbqfywazEH78LQ&oe=69A03F1B"}, {"file_name": "img03 2560.png", "id": "931269731869691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574724_931269735203024_2850721696466761343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd2Mn6jtyr0Q7kNvwF6xY2o&_nc_oc=AdlfqWvC5onC1F5ry44W7bxF6Owq-Kp2a6MJI_bvpGxsYV5DxbKntiLN59V4gAHBf9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaebeFE8i_foc9dQK__EPbqJZTeG1IzGAVk0YcUf5Hjg&oe=69A02EDC"}, {"file_name": "step.png", "id": "1345571343108729", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982671_1345571346442062_8682380559220754951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxPlFFh3OY0Q7kNvwFX80Wx&_nc_oc=AdmsUBuAYvfeDz09IbQON2b9ysnDAVJZ9V9ewyb0aVbjEg-WCmicf6o50k8xOOGDhHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft48nO2abZjGW56ofeKDgUZbyulyf4uHoL6BKVdhhp88w&oe=69A050CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sigure - MR Piano Game", "keywords": ["\u30d4\u30a2\u30ce", "piano", "Sigure", "\u6642\u96e8", "\u97f3\u30b2\u30fc"], "long_description": "\"Sigure\" is a MR piano game that lets you enjoy playing on an actual piano.  \n\nEven beginners who can't read sheet music can intuitively play the piano.  \n\nFor those with piano experience, the game also offers the option to display sheet music for a more traditional playing experience.  \n\nIn addition to classical pieces, the game features a wide selection of popular J-POP and anime songs. Enjoy performing your favorite tracks while aiming for a high score!  \n\n---\n\n\u25bcSong List\nhttps://vrpiano.co.jp/sigure/music/\n\nWhen you install the app, it includes 50 tracks as part of the initial song collection.  \n\nYou can also purchase additional tracks one by one, with over 150 songs currently available for purchase. More songs are added every month!  \n\n---\n\n\u25bcPractice Mode\n\nIf you're struggling with a piece, the \"Practice Mode\" lets you rehearse at your own pace.  \n\nFeatures include:  \n- Speed adjustment  \n- Section looping  \n- Practice with one hand at a time  \n\n---\n\n\u25bcImprovement Program\n\nTo help even complete beginners enjoy the piano, we\u2019ve created a step-by-step improvement program called \"Step-Up 30.\"  \n\nThe program was developed under the supervision of an experienced piano instructor who specializes in teaching adult beginners, allowing even those who are touching the piano for the first time to learn the basics of finger movements.\n\n---\n\n\u25bcWhat You'll Need\nhttps://vrpiano.co.jp/sigure/prepare/\n\n- Meta Quest 3 / 3s\n- Digital Piano (88 keys with a USB port) \n- MIDI Cable", "short_description": "\"Sigure\" is an MR piano game that lets you enjoy playing on an actual piano.\n\nBy moving your fingers in sync with the note bars displayed above the piano keys, even beginners who can't read sheet music can intuitively play the piano.\n\n\u203bPlease prepare a digital piano and a MIDI cable separately.\n\nIn addition to classical pieces, the game features a wide variety of popular J-POP and anime songs. Enjoy playing your favorite tunes while aiming for a high score!\n"}, {"images": {"nodes": []}, "id": "609289935141312", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sigure - MR\u30d4\u30a2\u30ce\u30b2\u30fc\u30e0", "keywords": ["\u30d4\u30a2\u30ce", "piano", "sigure", "\u6642\u96e8", "\u97f3\u30b2\u30fc"], "long_description": "\u300cSigure\u300d\u306f\u3001\u5b9f\u969b\u306e\u30d4\u30a2\u30ce\u3067\u697d\u3057\u3081\u308bVR\u30fbMR\u30d4\u30a2\u30ce\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u30d4\u30a2\u30ce\u4e0a\u306b\u8868\u793a\u3055\u308c\u308b\u30ce\u30fc\u30c4(\u97f3\u306e\u68d2)\u306b\u5408\u308f\u305b\u3066\u6307\u3092\u52d5\u304b\u3059\u3053\u3068\u3067\u3001\u697d\u8b5c\u304c\u8aad\u3081\u306a\u3044\u521d\u5fc3\u8005\u3082\u76f4\u611f\u7684\u306b\u30d4\u30a2\u30ce\u3092\u5f3e\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\n\u3010\u3054\u6ce8\u610f\u3011\n\u203b\u96fb\u5b50\u30d4\u30a2\u30ce\u3068MIDI\u30b1\u30fc\u30d6\u30eb\u3092\u5225\u9014\u3054\u7528\u610f\u304f\u3060\u3055\u3044\u3002\n\u203b\u30c8\u30c3\u30d7\u753b\u50cf\u306e\u30ce\u30fc\u30c4\u306e\u30c7\u30b6\u30a4\u30f3\u306f\u30a4\u30e1\u30fc\u30b8\u3068\u306a\u308a\u307e\u3059\u3002\n\u203b\u5b9f\u969b\u306e\u30d7\u30ec\u30a4\u753b\u9762\u306f\u30012\u679a\u76ee\u306e\u753b\u50cf\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002\n\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\u30fc\n\n\u697d\u8b5c\u3092\u8868\u793a\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u308b\u305f\u3081\u3001\u30d4\u30a2\u30ce\u7d4c\u9a13\u8005\u3082\u697d\u3057\u3081\u307e\u3059\u3002\n\n\u30af\u30e9\u30b7\u30c3\u30af\u66f2\u3060\u3051\u3067\u306f\u306a\u304f\u3001\u4eba\u6c17\u306eJ-POP\u3084\u30a2\u30cb\u30e1\u30bd\u30f3\u30b0\u3082\u591a\u6570\u53ce\u9332\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u597d\u304d\u306a\u66f2\u3067\u30d4\u30a2\u30ce\u6f14\u594f\u3092\u697d\u3057\u307f\u306a\u304c\u3089\u3001\u30cf\u30a4\u30b9\u30b3\u30a2\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\uff01\n\n\n\u3010\u53ce\u9332\u66f2\u3011\nhttps://vrpiano.co.jp/sigure/music/\n\n\u30a2\u30d7\u30ea\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6642\u306b\u3001\u521d\u671f\u697d\u66f2\u3068\u3057\u3066\u7d0450\u66f2\u304c\u53ce\u9332\u3055\u308c\u3066\u3044\u307e\u3059\u3002\n\u305d\u306e\u4ed6\u3001\u597d\u304d\u306a\u66f2\u30921\u66f2\u305a\u3064\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\n\n\u8ffd\u52a0\u8cfc\u5165\u3067\u304d\u308b\u697d\u66f2\u306f\u73fe\u5728150\u66f2\u4ee5\u4e0a\u3092\u3054\u7528\u610f\u3057\u3066\u304a\u308a\u3001\u4eca\u5f8c\u3082\u6bce\u6708\u8ffd\u52a0\u3057\u3066\u3044\u304f\u4e88\u5b9a\u3067\u3059\u3002\n\n\n\u3010\u7df4\u7fd2\u30e2\u30fc\u30c9\u3011\n\n\u4e0a\u624b\u304f\u5f3e\u3051\u306a\u3044\u6642\u306f\u3001\u300c\u7df4\u7fd2\u30e2\u30fc\u30c9\u300d\u3067\u81ea\u5206\u306e\u30da\u30fc\u30b9\u3067\u7df4\u7fd2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30fbStay Notes\u6a5f\u80fd\n\u30fb\u901f\u5ea6\u8abf\u7bc0\n\u30fb\u90e8\u5206\u30ea\u30d4\u30fc\u30c8\n\u30fb\u7247\u624b\u305a\u3064\u7df4\u7fd2\n\n\n\u3010\u4e0a\u9054\u30d7\u30ed\
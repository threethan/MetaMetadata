Zf7O_h1rPuQn00cGtea0w&oe=6AC10E13"}, {"file_name": "final_05_settings.png", "id": "1616019073519240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1616019076852573_6836568878419243871_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLJOzQpSM9wQ7kNvwHXnofD&_nc_oc=AdqeSA_Q0Yx29S6MSe75_NalZQ7PtOxGT6LfIPoxXkUHedw6i6lji8jmgqF1IN_WkJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjQm_Kz3HrVqOLQCqz4-21MOT77CY1PCw2-5BZOzqO_w&oe=6AC11D4C"}, {"file_name": "final_02_images.png", "id": "2989062281445180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/748437750_2989062284778513_7912470721044981300_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WS08zaUomYQ7kNvwHTLDRG&_nc_oc=AdrImoqEXCDCgabPcCs2giX6nVRIev7Jfa7jGaHJJG-4t6PjUytSgljsTqRXqjBlsCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFeCWai9a4y5OtuwqkVuYlGQcdX2FnE3sEX0MSrz3kJg&oe=6AC1222C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Manager", "keywords": [], "long_description": "Simple File Manager turns your headset into a full file manager.\n\nFEATURES\n- Browse internal storage with grid or list view, sort by name, date, size or type\n- Categorized views for Images, Videos, Audio, Documents, Apps, Archives, Downloads and Large files\n- Multi-select copy, cut, paste, rename, delete and share\n- Built-in zip compress and extract\n- Image viewer with pinch-zoom and a text file viewer/editor\n- Trash with restore, so deletes are never permanent by accident\n- Favorites and recent files for quick access\n- Password-protected vault with AES-256 encryption for sensitive files\n- Duplicate file finder to free up storage\n- Dual-pane mode to move files between two folders at once\n- Built-in FTP and WebDAV servers so you can connect from any computer on the same Wi-Fi network, no cable required\n\nNo ads, no account required. All file operations happen locally on your device.", "short_description": "Browse, manage and share your Quest's files. Categorized views, trash, favorites, an encrypted vault, and built-in FTP/WebDAV so you can drag files in from any computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simple-file-manager-privacy.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Kalki Arts", "support_website_url": null, "website_url": "https://kalkiarts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310827975450178"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1772633021529847"}]}, "baseline_offer": {"id": "1772633021529847"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790390580, "status": "PUBLISHED", "id": "1772633021529847"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1306713402528302", "version": "2.1.0"}, "id": "2896743814021542", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1300799706453005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1306713402528302"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"cha
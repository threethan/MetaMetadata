KmGBZxB_fqSr5ZJ1W4yGPLEfA_kezAIUxg4ogFqLdxzohXj_MhsoP_A4RgzJH-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV27rur556fuO4ArJJNZshprL8XfwHFMKOt69Dzus_24Q&oe=6B0F1B6B"}, {"file_name": "final_04_vault.png", "id": "4483088391930588", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_4483088395263921_6010277461223827940_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ_pxOvR6sgQ7kNvwFIMKwN&_nc_oc=AdqhFNgbXEnJYzQnX9u2oDsIm_mqvJ1q7H1-EGL8RneR1mO_AzdH3vAIiE1sspdNnoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_SYaUC3T4d5gQotL_4tcty3vd-BA1kc_Rtmb0jlAwnA&oe=6B0F0ED3"}, {"file_name": "final_05_settings.png", "id": "1616019073519240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/753032404_1616019076852573_6836568878419243871_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPWi3ZD8FcoQ7kNvwHegD0j&_nc_oc=AdpqT-sXzge60JyzDZt3EfExD8gCvRKl6JLEXm_rYH7qZrG2BzP0n8gKyhuvpHz9reI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPOOACxdiFX-V4UJCQo_AHW2xfc9p_25xdkaf9Nba6CA&oe=6B0F1E0C"}, {"file_name": "final_02_images.png", "id": "2989062281445180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/748437750_2989062284778513_7912470721044981300_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExPq1GZ0xO4Q7kNvwGDo_oJ&_nc_oc=AdqH-8nh7ht3urD8AeGoqoKp9TS7jf2bR-nhLx3YtCr20E3579CBNUgGkuMIK1GEmhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvrSUi_0g-IoPhatbKM0JURyxOfN3I6qhmJ6E0TsCnUQ&oe=6B0EEAAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Manager", "keywords": [], "long_description": "Simple File Manager turns your headset into a full file manager.\n\nFEATURES\n- Browse internal storage with grid or list view, sort by name, date, size or type\n- Categorized views for Images, Videos, Audio, Documents, Apps, Archives, Downloads and Large files\n- Multi-select copy, cut, paste, rename, delete and share\n- Built-in zip compress and extract\n- Image viewer with pinch-zoom and a text file viewer/editor\n- Trash with restore, so deletes are never permanent by accident\n- Favorites and recent files for quick access\n- Password-protected vault with AES-256 encryption for sensitive files\n- Duplicate file finder to free up storage\n- Dual-pane mode to move files between two folders at once\n- Built-in FTP and WebDAV servers so you can connect from any computer on the same Wi-Fi network, no cable required\n\nNo ads, no account required. All file operations happen locally on your device.", "short_description": "Browse, manage and share your Quest's files. Categorized views, trash, favorites, an encrypted vault, and built-in FTP/WebDAV so you can drag files in from any computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simple-file-manager-privacy.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Kalki Arts", "support_website_url": null, "website_url": "https://kalkiarts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310827975450178"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2209176419694968"}, {"status": "PUBLISHED", "id": "1025223410529989"}, {"status": "PUBLISHED", "id": "1772633021529847"}]}, "basel
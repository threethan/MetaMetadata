iad6-1.oculuscdn.com/v/t64.5771-25/753032404_1616019076852573_6836568878419243871_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D03chJ16mD0Q7kNvwHWsyrp&_nc_oc=Adq1D_QZcQcIYKGE5nuH0DPMFgKyqD6CoFO0XmFwjDhfN7j0GY1DaTT2nOKx4tL8fKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSATqjFppHJrlFeKLCtcIvM5ozpGhv-8fipHCc81XDBBg&oe=6AE758CC"}, {"file_name": "final_02_images.png", "id": "2989062281445180", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/748437750_2989062284778513_7912470721044981300_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYyUGFmkuSwQ7kNvwFePJFD&_nc_oc=AdqmkMp2_tEoZ62ltSoJtnny_UmoEy3cuh_Id2O8DHPBeVEzrNY-wo88aS-aP5K189c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2cyTef_GZlA60WgQSpjF-UzyRr0Rrb_5_9VlK-W5WOQ&oe=6AE75DAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Manager", "keywords": [], "long_description": "Simple File Manager turns your headset into a full file manager.\n\nFEATURES\n- Browse internal storage with grid or list view, sort by name, date, size or type\n- Categorized views for Images, Videos, Audio, Documents, Apps, Archives, Downloads and Large files\n- Multi-select copy, cut, paste, rename, delete and share\n- Built-in zip compress and extract\n- Image viewer with pinch-zoom and a text file viewer/editor\n- Trash with restore, so deletes are never permanent by accident\n- Favorites and recent files for quick access\n- Password-protected vault with AES-256 encryption for sensitive files\n- Duplicate file finder to free up storage\n- Dual-pane mode to move files between two folders at once\n- Built-in FTP and WebDAV servers so you can connect from any computer on the same Wi-Fi network, no cable required\n\nNo ads, no account required. All file operations happen locally on your device.", "short_description": "Browse, manage and share your Quest's files. Categorized views, trash, favorites, an encrypted vault, and built-in FTP/WebDAV so you can drag files in from any computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://simple-file-manager-privacy.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Kalki Arts", "support_website_url": null, "website_url": "https://kalkiarts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310827975450178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_1023869580683514_8449017077220337265_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKIyrp_xORMQ7kNvwFeVAVA&_nc_oc=AdrhN_63bP4RtvbM60hrsBv0bRKKXNpCQ9PUzCWPPQLBmAbWEXzqJc6m0aRQ71VTiO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFDwNNtnt48Q-IrVXIEav3akcJmd97xsF-ckmiuKDWLg&oe=6AE76D77"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simple File Manager", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1790390580, "lastRevision": {"nodes": [{"id": "1300799733119669", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1300799706453005", "is_first_party": false, "enables_in_a
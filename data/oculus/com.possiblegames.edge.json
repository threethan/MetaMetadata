c_ss=8&oh=00_Afz_8QGgoR7SlQalrYGuHr6UH5qRrSQru688NujDYWIpAg&oe=69AEDA3E"}, {"file_name": "migrated_image.png", "id": "529020007754505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_205124103181632_1312132266_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGoG_Oyj3-8Q7kNvwFRwVxz&_nc_oc=Adm3pau9tfOKLGJFMe-tBNwpdnIpM_exRyjA7l8xUP2zZU7fSRoC8Sqr8rtnUTtG7KA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKlRj1bb6Qb7cXiAUy0rwTpbc1sufjiSdIULk8lx8Lpw&oe=69AEDC58"}, {"file_name": "migrated_image.png", "id": "520524858662131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_566876116819959_205762901_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-0OQIymmc4Q7kNvwFlgEuj&_nc_oc=AdkITOql1JBK4xlWYWZNu-lCO8vPedjFxCagnU7r4ZvYsHl0FOwaZuymX-2AuYHnRDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVnkSopTfhXUFgu7KVRO6J1pNgcTdPng1cm1jlrucb-Q&oe=69AEB06A"}, {"file_name": "migrated_image.png", "id": "152327209319830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_1571866573104792_1729106967_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qPmgFdFcBsQ7kNvwHaJxvk&_nc_oc=Adk7qw3dMlLy_d__arSrfYBquckQkGmqeCqACfzTvinrJHIQ1hlSqmglfb5fKeNz2TY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZKCCWN0cl_uDOwAPb-epPwqqcd8EPb3cj-O427uJFCQ&oe=69AEC83D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Iphone6plus_2560x1440_V2.png", "id": "1083367198411288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602257_1083367201744621_144792659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtKu6B1rc1MQ7kNvwFGHQvV&_nc_oc=AdlWjRCo0QhkX11zZFgyQh7EPB4nRfA7zO0nnLLhRxe3BPS-3T1_-mhf9gAa3OYuSh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgFwKPtBor-eLshWGH8dlmd2AEkgAzw8n_1eXofsN9_Q&oe=69AECAA4"}, "display_name": "Adventures of Poco Eco", "keywords": ["monument", "valley", "music", "puzzle", "adventure"], "long_description": "A relaxing, exploratory audio-visual experience for all ages!\n\nDiscover a new world where there\u2019s a lot to see and even more to hear. Help Poco Eco, the curious explorer complete his mission. Your goal is to help Poco and his tribe find their Sounds that they\u2019ve lost by solving the mini puzzles and completing all twelve 3D animated levels. By downloading the game you also get free access to Iamyank\u2019s new full-length 7-track LP. \n\nThe game world is built around a mixture of electronic music and design, placing you into its unique atmosphere. It was designed and developed by POSSIBLE Games & it features Iamyank\u2019s newest LP - the Lost Sounds.\n\nPOSSIBLE Games creates quality mobile games that entertain and challenge gamers of all levels. Adventures of Poco Eco was designed by visual artists with years of experience in 3D and mobile game design.\n\nWe are excited to hear your opinion, please rate & review, send your comment to hello@possiblegames.com or visit http://www.pocoecogame.com/", "short_description": "Help Poco Eco find the Lost Sounds and enjoy the free full-length, 7-track LP!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pocoecogame.com/privacy/", "developer_terms_of_service_url": "http://www.pocoecogame.com/privacy/", "publisher_name": "POSSIBLE Games", "support_website_url": null, "website_url": "http://www.pocoecogame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "MUSIC", "EXPLORATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "17571230
-Xfxnu-RyAnZBoKOmCc78V0wDAMUf24lsNDNb8KtUaRLRgloyJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvdTgQcdvgD7zGf9jSp9fhSmujzzSvGCJl-8wOh6RfPw&oe=6AFDDC7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Taag", "keywords": [], "long_description": "Gorilla Taag drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Gorilla Taag drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. "}]}, "developer_name": "hah", "developer_privacy_policy_url": "https://docs.google.com/document/d/13h8jX_ptKG7LqoHWSmLwl6IhX1IFIMohILTXO096bdc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "z4eu", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NZ-HVl2Yg9oeBZkn4krBLG6WfeRvwcayikxbN8QXnzk/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "RO
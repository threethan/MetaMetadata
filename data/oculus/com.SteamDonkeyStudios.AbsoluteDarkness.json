u in this maze like prison as you are hunted by something that doesn't want you to leave. Can you find your way through Absolute Darkness?", "short_description": "Go into an abandoned penitentiary and retrieve a lost item. A simple job or so you think. Can you find the item and make it out of this dark and confusing place?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://steamdonkeystudios.com/ad-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Steam Donkey Studios", "support_website_url": null, "website_url": "https://steamdonkeystudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "501166778663861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568670_1322321668556083_1426702584001118024_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0244EL0XEEQ7kNvwHQapOj&_nc_oc=AdqhK6p7Gv7MKlLdgkK_NYZEKX_kNTWU4hCUMD2x1RYC2zeql7hGOdt4U8Pdcv50g6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfFagmeTbqRt-UzYNvI0IJ4tU9rJBkBB3UveGXj_xlVw&oe=6A95C853"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Absolute Darkness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Surviva
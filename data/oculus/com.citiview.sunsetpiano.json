AeyOYBU7o4Q7kNvwECaT6V&_nc_oc=AdpZcP-yoQrDypdh5bbdsyCyj1C1QcCgf3QSAixqMepzNF19UGeuClYjVzXAYcYVc8Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0cC3AD4n_kKotAZd4S_AvsBPcqIF__yd-vED5I-je-Q&oe=6AFC6EEA"}, {"file_name": "screenshot_4.png", "id": "1281934950730451", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1281934954063784_6971688798992507772_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G1vTfareiIQ7kNvwHCNfCV&_nc_oc=AdrAMIzs4x50HH6jIeUFSVd32gTSz1VySUzOZAnQALb-cfArPFg4V9KWzvzXkTCrxwc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Lk3NuFdSi_EbB1KItaKM6e8-IFUUKiePzFqm9wgavg&oe=6AFC950C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1619708406225137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1619708409558470_1877433504119808540_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIyYpCyQbegQ7kNvwGWQbK8&_nc_oc=AdrOajdHMguHQd58ZsisRdSGWZ774CRwoGdq6gWITltkCaxWCh4dbvlT2D7-LEVeWbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaHwKTeR1t2Y55AAcg0howfDnpR1v6KD7ta58UknsYcQ&oe=6AFC7F35"}, "display_name": "Sunset Piano", "keywords": ["piano", "music", "instrument", "relaxing", "sandbox"], "long_description": "Sunset Piano is a quiet place to play.\n\nA full 88-key grand stands in a penthouse with one floor-to-ceiling window over a glowing city. Hand tracking drives all ten fingers, so you play the way you would at a real instrument: press a key and it moves, hold it and it sings, lift your finger and the damper takes it.\n\nA REAL INSTRUMENT\nEvery note is a modelled piano string with real inharmonicity, unison detune and hammer tone, so chords ring the way chords should instead of sounding like a sample pad. The sustain pedal works. So does the whole keyboard, all 88 keys.\n\nTWO PIANOS\nOne grand inside by the window, and a second identical one out on the balcony for playing in the open air with the city below you.\n\nPLAY OVER YOURSELF\nA built-in looper records a phrase and plays it back through the real keys - they move, the real notes sound - while you play on top of it.\n\nMADE TO FIT YOU\nSet the keyboard height for standing or seated, and turn on note names printed on the keys while you are learning where things are.\n\nA SKY THAT CHANGES\nSwitch the city from golden hour through to night while you play.\n\nThere is no score, no falling notes and nothing to fail. It is an instrument, not a rhythm game. Put your hands on the keys and see what happens.", "short_description": "A full 88-key grand piano in a penthouse above a glowing city, played with your own ten fingers. No controllers, no falling notes, no score. Sit down, put your hands on the keys and play - indoors above the skyline, or outside on the balcony as the sun goes down."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/sunsetpiano/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/sunsetpiano/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1259556430583663"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "972931151732
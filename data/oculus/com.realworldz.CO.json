g", "id": "1195820735228875", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391885_1195820738562208_1448954671814684201_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WEwexGSVAMQ7kNvwHGIR0x&_nc_oc=Adr8IZNNyva_95sYdTQspcKTl6t53_umcaNlJ6tRamcfDzmAt7tQNAHiqb2JzKYhQEE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqwvpcWDzmTrj0SHtbopecgYzRHdFMUEhq3p8PiJjMvA&oe=6AA95D5B"}, "display_name": "Open Ocean Sailing - VR Backgrounds", "keywords": ["Ocean", "Relax", "Travel", "World", "Calm"], "long_description": "Open Ocean Sailing \u2013 VR Backgrounds\n\nEscape. Relax. Immerse.\n\nStep onto the deck of a calm cruise ship surrounded by endless ocean. Gentle waves and open skies create the perfect backdrop for work, movies, or meditation. Wherever you are, find peace in this relaxing seascape.\n\nSpecs:\n5.4K Ultra HD \u2022 Seamless Loop\n\n\ud83d\udce9 VRBackgroundsemail@gmail.com", "short_description": "Open Ocean Sailing \u2013 VR Backgrounds\n\nEscape. Relax. Immerse.\nStep onto the deck of a calm cruise ship surrounded by endless ocean. Gentle waves and open skies create the perfect backdrop for work, movies, or meditation. Wherever you are, find peace in this relaxing seascape.\n\nSpecs:\n5.4K Ultra HD \u2022 Seamless Loop\n\n\ud83d\udce9 VRBackgroundsemail@gmail.com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.gixcore.com/Open Ocean Sailing/PP Opean Ocean Sailing - VR Backgrounds.html", "developer_terms_of_service_url": null, "publisher_name": "Real Worldz", "support_website_url": null, "website_url": "https://vr.gixcore.com/Open Ocean Sailing/PP Opean Ocean Sailing - VR Backgrounds.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
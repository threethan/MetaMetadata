n1xy-__L3k1A0PNWg3vN4TO6g3Ov4ILdZPvvW4i5to&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz7wZKobGwS6o_PwpdJxLPrKeVN09KV26C2RmtqR36Mw&oe=6A902E9C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm64eIueXV8Q7kNvwEHU23V&_nc_oc=AdpWRKGw8O0B5fFme3yTaLGHk8n2AslMcI82BMIuzX_ZqJJToETO_1PnP0dS9ie8jEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0uPFZ-DJh_GyHpbuVjYaQ1ZgMK33_HSHRygM-4DBmyA&oe=6A90284C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F.E.A.R VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to F.E.A.R VR! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In F.E.A.R VR, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "StyxStudios", "developer_privacy_policy_url": "https://sites.google.com/view/metafearvr/privacy
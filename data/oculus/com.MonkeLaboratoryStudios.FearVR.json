kNvwF5P9TI&_nc_oc=AdoPcbV3qzXBZKNTKV8Oz3V77BnBnFd1z3nap-5KqI-V9JdeO4xRzJxg4DgCpWs-TFU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa684-BPPcHs6mhMY3s7XmqmCu9cR5wuasyjxaJAi3cQ&oe=6A8ED87C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxWrPVoadMUQ7kNvwHz9ODy&_nc_oc=Adq7U2BA_gzzYz8FSxTB-w1iU3xRG8-GZBfJcaDkq8NzMegb88mvtKDUM3V8omSHvLU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVM_3hohGAojXIZ72Gm_7y3-z7TkRaN7ckgU1Hsh7_aw&oe=6A8ED6CC"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJmkuIKVndoQ7kNvwHaOXrX&_nc_oc=Adr0BLVyTyvoda1pfm87A0F-33GnXcChq5g0EydKq7cUDeqrqI8YmRVe8ykYAx8IBrY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWM9Q3Pt3fO3HIst4v21c8uoDTEw8d1hcYaZwX8R4mwQ&oe=6A8EF82D"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukBgOj8N-ZkQ7kNvwH1lfBa&_nc_oc=AdpIfS1N2pePygsg7TzSi4zu00eOm4GaXw1rUVYgPrDBG5FeNnxUXAgZY0tjyt5FOe0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ9SjKWCK4jXg7H-lwZ0-8GHe4Jz18SFkUmt41UnqpBg&oe=6A8ED7C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc
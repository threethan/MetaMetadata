.png", "id": "482861480977855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_482861484311188_4469280178006163236_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLZHpMN9-Q4Q7kNvwFH90OV&_nc_oc=Adqn4LZxllWtqQM14OZWlMdp1Ao_QFsE1mPcjRNm0XXaZ2TTCSmeEGJGXPEdGvlQnsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSrJmoWan5u-ABsnaxjvb7TDzOR3_ER42cel7eA6B2zQ&oe=6B04663C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxdMX0d1WQAQ7kNvwH0lWqy&_nc_oc=Adpcr5w_oNwBlF_RsUMNaOfRY25sEIm-N0k8BwemezCqy-BDThqC0WjVWiJ0ICKjvNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaCQQCOXNWcWjx9ssVJ9P2_3QlmNyQNbtpm7iRVrkZtQ&oe=6B04648C"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGvx1kRZFm0Q7kNvwG9QQ6o&_nc_oc=AdriX2Ru-CWoGS50M2ylUfwfxKD6kVqOhF3Sm18r_QB8B5g6Y9k3wpdQYfIc63vlIzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScQTojbbw1SP3GEO_769c6nij5Z_qHa4a47VzEpwsI6g&oe=6B0485ED"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHPynUC4NakQ7kNvwEUQV92&_nc_oc=AdpME1nsVyK-FekNOx5EShFmKTonHRHA1mnhpe8ws-zVTDsWhmIJi4ug7kO72ggjBu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Ln20MIgfUKBhrupsgtzw4PIW3laZkDUVPtuoripGyA&oe=6B046586"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
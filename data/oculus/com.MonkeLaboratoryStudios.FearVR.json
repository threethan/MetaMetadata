o&_nc_oc=Adq0ixArMoNACCli6qNcmoskbWi-ALArg7MnkU_fWESjBUvK7ZLbCR3Iy7h083E-Pb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfPIyJhCs475HSShfs_Szj6TLibVIG5AAbsEGHrc0SwQ&oe=6A6DE2FC"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUmx26xJiG8Q7kNvwGH0ldD&_nc_oc=AdpD6PfrZIjfP_40nE3LcHB8CyfhSwF9EUqk8lUnYACWyqFpP6zE67TfFCjl_Ep_bCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe9sarkPa-VI-bdn_xgQ2pktrdQ3v9l6-Nsp93wyMVhg&oe=6A6DE14C"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOfD4OGNgkQ7kNvwF9rCNG&_nc_oc=AdpJVvd4dXEn0H-5OJeDIwJdxvm7B0euaHfIx6t0kcTN2Sgd-z9tWAUK7c-RCOKD194&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjive9S0XogBqgEa44vKjZKd_iJUXSdOjoVCVVVXx4Wg&oe=6A6E02AD"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqcQasXOLzEQ7kNvwEquvGi&_nc_oc=Adp-DKXkLBaxF6cb2RIgDurpBmVlv1RWHPQ7DkwrRCJWEXMywJx5nh50Q1ZEgEIaNdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByTV90J-Glp2LNhddf97LOsyoYwU3iSbxCioAGSrJpBw&oe=6A6DE246"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=
d3-2.oculuscdn.com&oh=00_Af2L7EeWmS-NfQbsctMSqH1HE8lqB0BIcuonUFlbsyJvlQ&oe=69F0A47C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VihnFcHK8mkQ7kNvwGa4d0q&_nc_oc=Adro5q14ecFgFyX-RgHUxQ_Q2zck5OGegtSVUZzn6yVJ7fRstVTWGve8EXrPGQLZU2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2vdabtaP_0SmZ4pCQr7vN8WBN0LniJdMBvmVWSPmPyRA&oe=69F0A2CC"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or3qKqgpxngQ7kNvwEzG3th&_nc_oc=AdpIYquy9IEpQXbqrBvK8iQfyZltE3uy9e9Zv2sOede0Ia1aU6HA-MW6M3L1G0NIo7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2WyAGGwQid5JCRzNn-_0G5hrsgLf9yQGsLE11yO6pFww&oe=69F0C42D"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_toNFyI7gcQ7kNvwGGeupz&_nc_oc=AdrX6l7ptvz-eV9JZkiPAZ0yMGyCrkc55Py5Mtkh31jW08rj4Ls0maW0D7ONHDRbbZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af39pc_p2fVbtBFCIIkse_fhbJsAVjWgij9a0kuYvlGI4Q&oe=69F0A3C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nt-EamcOLzkQ7kNvwH4xb-j&_nc_oc=AdpuqQVO_FZUj8xV8rxVFjdxz8MUpM26Sd3ta6KwW7uLcOFxwEn1yRYEoAGBoPod_oA&_nc_zt=3&_nc_ht=scontent-iad3-
d3-2.oculuscdn.com&oh=00_AfuFmKeQnAWRx2Rld1Qhu-uthLb2VbMA1dlzd30Xgo1j1w&oe=69A2DBFC"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm5azwIauIIQ7kNvwFMvwdw&_nc_oc=AdkOMKeKycfPmn2F4cgonYMMCbQumCLlm5VnMzovvUCGAE4OkD2zL6tkPgnJH9hs6H0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswMLq2DnZqBNqRzr4OwAINeMn0ERq8bNa9K9UydUEDjQ&oe=69A2DA4C"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2rwhb0kyIcQ7kNvwGz_ABZ&_nc_oc=Adnd-y7RF-duZ2lKmYakKqaB0AJBqoWsKgC-iYDTTo-iIw19mF77oyxsKmcoUge2ezs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjBgX11oWLS41y4vo-hkMLGja7uzGhnK_HmIpgaItyOw&oe=69A2FBAD"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVY7VG4r3W4Q7kNvwEESjxN&_nc_oc=AdkFABKFSUKOtHUz4git6mVhaLWv4uagd3MUJ_5t505nxbR4Aht-Yd6eGS6E48UXhb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPPGlldWfer_yRPNi9ZTuPrEqs0j602omqo1-Y_eoSAw&oe=69A2DB46"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMqQDKW_cyMQ7kNvwGjmXZj&_nc_oc=Adm0OqRC6bUOrwAxeaYJ1R2aYM6sk8OQAmHE-6B4cb5y1r27BPoSWm1FWO0ppwzqcBg&_nc_zt=3&_nc_ht=scontent-iad3-
.png", "id": "482861480977855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_482861484311188_4469280178006163236_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcCv6hhqRAYQ7kNvwFW1vHt&_nc_oc=Adpou3cm-lLfcP2tZiDnzYFg2Kl3Y1xVSCKVbJZL1WYmi-u4sbn1DmAmhTpB13PoFIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOFynYINOoB6bQROzbYyIEAusRVPM9zcMtM0akJSatdg&oe=6B0EF23C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhVcS7LpFjsQ7kNvwFSiP5a&_nc_oc=AdoRJ1x6g7GQiIOk4G-OFOF0FJwPJAzXya8HNHNp8qYhTDsI-wMktsqo4osoguHNyvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3Fd-xOyDWtzqQc1doWZdT4xPF9f0nkwhyxxkBjN6IZg&oe=6B0EF08C"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYjPqvjIzlIQ7kNvwGwuaAv&_nc_oc=Adr4cvsabhBdZSA-N4vzRqJY48fMOhuAZmEbfvbaiwRXA0JakgjfotxgjOr3iYB2xsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLyIB-O5OR1PEHjqOJnQYAmrx7dU-D38MGJ5ZVBO-EZQ&oe=6B0F11ED"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9wQAzShUOEQ7kNvwHTsD4t&_nc_oc=AdoNA0ydNOhIx9lpBBbfXJ6KeyFM06mmh6vUNDCNKTTbHV6jqifQ8VKuLLMiAFZ7syE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXocIRZVQlv9awN123v_VUXLhXbExVRwf-GpA3Jt8K0NA&oe=6B0EF186"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
6&_nc_oc=Adq_Z0IC9thxX-21XGUnXRxFfWh84LNC32YhDT_VCB41UJ3NCa7U1W7BE5CYBLVcx8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Ho1SYT-m29Lr8vDAPon5LUDcDQz0kAvsLxN1KrncPQ&oe=6A0C53FC"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neMZ2t8qdY0Q7kNvwEF9ay4&_nc_oc=Adp0gc-U_jum7gz1wPsU_lLXLcpW996PaFAJav6MGJqYABU8IFhIHuhNWCPRnqGrLRc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ndYAiEVCBbnPNClMXxl1G_xJh1yK8KZl6ttdTnhkg9Q&oe=6A0C524C"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx_obEuXf-sQ7kNvwEsalky&_nc_oc=Adrqd6Xk9Pc7sJvP2clRexiq0_1vZqelD8BC18tA_tffNx0aHTVzVmi6TbdKBQzoLf4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40ZOSjCSON6JW_czIzRz1j3Mp-QcUCfGInifWZxXCrjw&oe=6A0C73AD"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM3yZQyr7osQ7kNvwHIaa0M&_nc_oc=Adr2pRbUQAXfcd2HUN1W7bhp3X0YTXPS50IozTdwX631sxhf3CqNIKN84jma-GiBhYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LyxzBV7jq2yAa1EDoZ081O8TLzYDzJL1XyoeBvgytNw&oe=6A0C5346"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=
774_1085985080663314936_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jxwzipJgoYQ7kNvwFlK-bK&_nc_oc=AdoOnfvCdQmxTSiyqpF7evh1--K73M0x3fnm9Crk8I6QY9XWGx0htFFUrccyRSKpu7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDVDsOoE7tF-USBgfhRHSUJk4CXCgBrh0phN2wHg2Q3w&oe=6B0DA006"}, {"file_name": "New Project (51).png", "id": "532491816178757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395422_532491819512090_2430789316722762609_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anM-LJkVmnQQ7kNvwHht3H7&_nc_oc=AdoBnzM9vR01SrwNFi8znh3lF24jXV37IZabkvcsg1b1JHsrM5Fuu2WdEQv-BAyG0s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIlD4ifWqCUwfhEkaY6VuvhFJLQ6oxXMMH4pwjFCpOLg&oe=6B0DA55C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlqvfBDIRWgQ7kNvwHft-Z_&_nc_oc=Adrh90mJGtm_BaxkYA8KXIBNq03MxqacRik33G8yv-1zsPgnjjpCvO3A55AGLbCB-bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNHSIq07T8ZM03JzKdGWt7KMwaBkcq8PwyeN0TZzF1wA&oe=6B0D9F0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F.E.A.R VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to F.E.A.R VR! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In F.E.A.R VR, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "StyxStudios", "developer_privacy_policy_url": "https://sites.google.com/view/metafearvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Monke Laboratory Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/metafearvr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27386949257617778"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27936404292672269", "version": "0.10"}, "id": "920490233230935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinar
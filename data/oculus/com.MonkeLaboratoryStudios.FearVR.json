6&_nc_oc=AdrutecYvwyrhG-yukECmaBBqCRi69kqlJhCQzt5kLeSU77Zut5gT2HLa5oYKQEkcVg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E8nAAW-Np5Le-YNAxe1_cb1IB77cvQW9Y8o3UsTMIjA&oe=6A1AD47C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlgG68roZ7YQ7kNvwFCKB8l&_nc_oc=Adq0XLonmpqMJusm6VCxaUQZH6P-jTf-iI4ciBijUAtioFN7KYfruqu7n9nzwjTG_aA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p9odeOUWKYuSVLR2ih84tr6l8MrwHWjp7nPYrH1P0OQ&oe=6A1AD2CC"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFU4_f6iHW4Q7kNvwFsTAdq&_nc_oc=Adp01JF3ih1xbvqLZledcxraeqWBrWxnoWd__p2B90yD61NPsIELl0_pnpt7x9NBWDs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63-t2cwN6zpIr8ISVWNYh-kFR31F7myHFCmku4DAQU1g&oe=6A1AF42D"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC7FW6eOckQQ7kNvwFlnKzU&_nc_oc=AdpgdVWxqcJPC9aMVth3OnU22Xkle91sbwMAYfDWnc6Rn2zBfERMI1-_vflgAQg_2Kc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JovVYEBACT1aAcdDdqpDc-cnjSOeoJd4fdvcXvqk-ig&oe=6A1AD3C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=
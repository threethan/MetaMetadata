lQUZ93UCse9lrftfOBh7PzP3g74_P8nTfBtV5zSsts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18kexUk8N2BZnZNgIPHuF_dbyhEel9h3DttT_l96ayhg&oe=69D4F99C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1hdS3z3eIgQ7kNvwFw94i_&_nc_oc=Adoip2LjrIMkS_MvgQyT6e8Y3dN27enbP2FbbHx0dveEDHXSe6zzUgD1uECtLB0dZEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Td0nf4AAjxJzQm2mVFmMxW2h4JeWzo8dkuln1E8G-hg&oe=69D4F34C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F.E.A.R VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to F.E.A.R VR! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In F.E.A.R VR, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "StyxStudios", "developer_privacy_policy_url": "https://sites.google.com/view/metafearvr/privacy
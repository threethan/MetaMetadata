R&_nc_oc=AdowZT_QgJdyupomv6r8Sat5at55fnhYZBsu1-njrUsHVJK-uXZpzIo_ySFQnIvHZHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UQDBpfgRAd6bbhbOLR7W9fCL0P2loRqs6gwlbcXesUQ&oe=6A3EA53C"}, {"file_name": "New Project (52).png", "id": "903268395074992", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569443_903268398408325_3886243760179683351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzk_LK9GR3IQ7kNvwHPv9wE&_nc_oc=Adp93XbKN6rsgYFIxTHLnUKE24xUv3IGhUGCwvmz1mASoldsgDDkLMNRpoyorFlzevM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uVZTJKTLLrt8y5E7fU28l4apRk88oWebQSLDenB_rUw&oe=6A3EA38C"}, {"file_name": "Screenshot.png", "id": "1629183944300795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75500284_1629183947634128_5113999528427007256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qY8GBbSqfAQ7kNvwG3urid&_nc_oc=Adp0Qkkrnh0yEMt15-K_myVaQ-ICC1iQR1-sxVnaKERgTPjWOml-LFyfb-hI2gSWFZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91SNxfFgyfkltkyueY-NmkLhiOQNQJekfFHxSjz1X8Lg&oe=6A3E8CAD"}, {"file_name": "New Project (50).png", "id": "540521018464441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75644991_540521021797774_1085985080663314936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nnb6RCqZtDwQ7kNvwFtzLNd&_nc_oc=AdoMVqbGBxSxOsHIMXydbtx_1kvoMiNBYXXt30ZYZTPGe_v0vV0xJ5Sy_Mb8Sv6gnsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-mcK4pFtPhT43seHPYZd0VSSygJ6M-jC7_pU2J5LI5Q&oe=6A3EA486"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Fears VR", "keywords": ["Horror", "Phobias", "Monke", "Fear"], "long_description": "Welcome to Monke Fears! Your objective is to complete each horrifying level, while the threat of danger creeps closer to you. This game has a unique story line, and offers multiple levels and chapters. You are placed into a hotel, where you can conjugate, go to different chapters, use the computer to personalize your player, find out information about the game, and check out the hotels gift shop. Each level you complete will give you a cosmetic for your bravery. Every level is progressively harder, and will challenge your greatest fears. This game brings exciting gameplay, and has a different twist each level. Remember, the only thing to fear is fear itself. ", "short_description": "Enter a terrifying hotel where your deepest fears come to life. In Monke Fears, every level is designed around a different phobia, immersing you in nightmarish environments\u2014from claustrophobic caves to dreadful circus. Face your worst nightmares as you attempt to survive the horrors of each twisted monster. Can you conquer your fears, or will they consume you? Remember, the only thing to fear is fear itself. "}]}, "developer_name": "Kayak Games", "developer_privacy_policy_url": "https://raw.githubusercontent.com/Dxtorwastaken/FEARGIT/refs/heads/main/MonkeFearsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Kayak Games", "support_website_url": null, "website_url": "https://kayakgames.wixsite.com/monkefears", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27956737687305596"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982575_562463703200263_3228245607296744699_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=
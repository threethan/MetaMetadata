dn.com&_nc_ss=7f20f&oh=00_Af8Spvi_O2PlnBUuV0euo1XzdgiffWg-0kZr6agM3mFIoA&oe=6A3403D5"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rnN43bFIcAQ7kNvwFc5mJD&_nc_oc=AdruXX5OWqxERt4F5C6HlSYQrCYreKs2H2h4L_SJ_6TFfq63oJx4ksCeq5zLCap_14k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uYRRBZJPgQe5RpSmserARoTEGXgNTyv8jSazUTmMUlQ&oe=6A3411C4"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyXZS-FK9jkQ7kNvwHGNfDU&_nc_oc=Adp-4VdkQ7x8SfvyyH_itIlUaDKsiUYGAnQnzQJbkXm3oP4TF4cEP2wOuH3p9n9Xnt0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89x1c13SQAtO3lakcVMlDMQB4me52VnLPB5dh3OqpREQ&oe=6A33F9EE"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt26TMvKqU8Q7kNvwFPvtBt&_nc_oc=AdrXvsTajUe66t-ZcqhRuxG4KtsfTa8hpx2XGIlE4X-16UurEjEmX5VyD8pi24_9I0c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98SsdcTJJ3lpezQHdj5AKhaE7dx8sTNsApde9JNHdQ5A&oe=6A34181D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=094-AF3AqqcQ7kNvwGEBKvs&_nc_oc=Adr7NbA6Ag1sJ39op5Jr9x9fxfmWX7e6WVdr34Z1EQbQhzWvgLjp0L7_P3qjNAc8asM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f0ofGN3AozuY_Feijs97Ieq0EAohEAHR7hHkzXUos_Q&oe=6A340B26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
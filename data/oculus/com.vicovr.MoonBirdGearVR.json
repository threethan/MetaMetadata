dn.com&_nc_ss=7f20f&oh=00_Af_AY-weOsdAK3XEzIncaAu11oMAE1FcC9i7GNAGZwxVjA&oe=6A47CA55"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwCn8ZKh4g4Q7kNvwGhkQei&_nc_oc=AdrMSqJzm6_oIIjPKFpWJ65eg25UHqVSZ-Tww7jV7T2zHHVu2ePDJyAENR9c0YyGBGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83p508OvB-3M_bSnShXUQ93fzpOn-aml10EXONrkATmQ&oe=6A47D844"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHPt3UiAxHgQ7kNvwFvuPwR&_nc_oc=AdoraUVmJC7RP5fN08MxPNeK0BQ1bWIMxJYrbfyC8vo0rbgtdGrzS5So7I9a34fvFFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2mF-Z9ZciqJWBAt3UkPmdRHZ_fqoxw13XOdIceAlUqA&oe=6A47C06E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKT2puYMpQ4Q7kNvwGPCBv6&_nc_oc=AdqrFwPwduA_9nXUg16FU7QRpPn4we4bbMGh2p8h1rBc7rp_o8VKI4rScmBdyEIiZaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81vDa54OtBKj3ZOiZwTJDDWKgkHQ4tMwr5bIe9DTDY6g&oe=6A47DE9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0q8DI8K1lkQ7kNvwEtHPzi&_nc_oc=Adr-6JX6wkVfRPxeIdSFJC5ds668zvR3Yt9DRaOJwRw484P4XNbBB8VDuyteVLNHJKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z3870bQXrWy3zVeTPt4VRjo0uBNDDA5iwCrYpQs333A&oe=6A47D1A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
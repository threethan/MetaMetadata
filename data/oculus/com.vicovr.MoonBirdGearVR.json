dn.com&_nc_ss=7f20f&oh=00_AQSl_C98Xk4WApn_skPdrbKoSKk4KjG2Q5ombU1FZKaadQ&oe=6AF1DBD5"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTKqZv338PEQ7kNvwEML_gr&_nc_oc=AdrE7Qf217EzTkmxSPUmVz0JaLKOi6Wy1xpQdZFPQO94xMMhfw8ICC9hyj1ewIgAkqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTosnuu73LDTpagAaHCI-ZW3FBbydA7chskzbkyrMx7BA&oe=6AF1E9C4"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX5HfwGk5uoQ7kNvwGVfoXy&_nc_oc=Ado0DfStKDfBl6TEhVIdmL0gYNQ_KbdKD8XmEwqwagIX63GGz7VBHVun5UdebqNZW5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEM8nQZl2O5RwR8A4EUi0zY7FyvdrA2mMf58HB2bAQ5g&oe=6AF20A2E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjxBiWVf0jgQ7kNvwExVe5F&_nc_oc=AdqhjKiCeyvv2lDmUrLQlYi7Ix15X0mA6URuPs0NTXrSsgmNVJ9HY-8vt0bkBo5rQ28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNM413zcru7mv5Fijy96o7y7ynyftLgwLJ8gvwd3U80Q&oe=6AF1F01D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFaJGgiG7s8Q7kNvwFATFFE&_nc_oc=AdrRu30X19O9sqIC1y5k-R4hQJPtGN-YRcUlAtbzdALuOapFaSSVovut1-NRrPInuVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx3T9QJDU_3eKGEzEjxMJYGq5fMTHi19B9_RiFIDA8Tw&oe=6AF1E326"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
dn.com&_nc_ss=7f20f&oh=00_Af_B-548mM8KiQnJvOxjjHl7QvVbYS4bmjXG157k4GeeuQ&oe=6A3E8FD5"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLxbqKtJ09IQ7kNvwFgXPm5&_nc_oc=Adr1BobxMKKLePjak3s_peMM3xDR5H5Bq4JE_Ms4G-veY_OpPigGT_GZaYU78kuFY5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LM3E6_N-K0pc8oQ8OyK4AbebHlGv7uylBJ8UBcsE_GQ&oe=6A3E9DC4"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-MHXBASMOYQ7kNvwFwWBG7&_nc_oc=AdqsZ9YLzrg6VGBWnwuo9WI6dPzjcy0MLnQY0F78D_E1sf89UMqqjdoRL28U7-FdQD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aer6Wbo3czDwGSwVsYaxn7_QLG0eqRYK5e3sIFjoaLA&oe=6A3E85EE"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0Hf_SbPxKUQ7kNvwHALb0b&_nc_oc=AdrtgfkKhTwJT4vtbTaMtSbYbuR0GJRCn97rn6_pO_jtbWyfqHGg2LKJmoicP4iB2l8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MQct91h2WDEo07v7Q1T4mPI9kZnb7PH5vnhFlw2EWxg&oe=6A3EA41D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LsHh7pRK7sQ7kNvwE2AGsG&_nc_oc=Ado50yOn4IZ0LC6dL55H1E5scTYpSestOtkVCxvzDRtt_I2gE1pDdg0eXR82SKMwSlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qb7HXM2J5_aYVdFnv4zeByhFZmmUPuhAlYYMBvXG4KQ&oe=6A3E9726"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
Cyf7_wnPzfl-qwQ&oe=6A8D85DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_tumbnail.png", "id": "498769990511715", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12482153_498769993845048_2085529539324149760_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-AraMM8G1QQ7kNvwH-lCHC&_nc_oc=AdrOcGNItXG2ylW--oJ2kSH3US7CKsHD3i8vSF3cYwaX7PCXQEZVLh0K_AoA07ak2HY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrWlpDP6YeUkN78g0QR1uuBbuEJUN2oIklT0N7dS98QQ&oe=6A8D65B4"}, "display_name": "Moon Bird", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SIMULATION", "SPORTS", "ADVENTURE", "RACING"], "has_in_app_ads": null, "intern
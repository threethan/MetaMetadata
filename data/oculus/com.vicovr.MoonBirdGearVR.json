dn.com&_nc_ss=7a30f&oh=00_Af2dWVmQt73yHwWI87XBX7vVMj4MW3OHO5FgyuOotGBWrA&oe=69E63B55"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvpq0e-fB7kQ7kNvwHWivBq&_nc_oc=AdpYVtuJmjwm4og5QdH57whcZqn0N67AM_af1OqQFI8_LWd1Y5ErowniDhPng80rmE4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pal5CuL9Kvo-mBjt82Eq8PDh2050ONK3qV2Tw0fiDrA&oe=69E64944"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9KIolh3k8MQ7kNvwFwmhIm&_nc_oc=AdqgqIYnfR-QF9i2JtFMmdBpVUdISc-2II5PNvVjeprOqreThVXCu3E3VkK1QoQLYKs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n3_3PuTCWSiSJHRdMDmWnb_joTrcvMOaaTqZx8hWj9A&oe=69E6316E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhDXbeFj9IYQ7kNvwFG5ba1&_nc_oc=Adr0U9xiZSJ8HLx2SuTwKzxgh3ykakhs5x_69FgwZ1mS4AmoH6_7_3z2Q7vyUyHetO4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sQsK94BVOLNTLoawqxNDlkh3SKe-zKl3UvEDheSC0Fw&oe=69E6175D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN2AoimAp2wQ7kNvwGg3kiq&_nc_oc=AdpdlaCbtWgNLL3h7K5B-XA_M7p4lGM9WnruCkX9EymyZR3gROPnEqrbHKuGXWTcmMs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24xwx35l-83CmfcatBbijZymaEgHh0gCs4LvydrVFaqA&oe=69E642A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
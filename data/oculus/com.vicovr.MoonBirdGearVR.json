dn.com&_nc_ss=7f20f&oh=00_AQH4Gu67JY0F4r9HxMzUz9zNdNGKocT_BjDNKAmfOMqQNA&oe=6A774055"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-CHdAPqaA8Q7kNvwGoiOdv&_nc_oc=Adp8o9otKGifeNOn6TLeQlLN0MBzjuGGYiezoR2wtb4q_IIS9fPFPD8-NaL2EASt2k8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_EI4w_5qYs-GVpmALQNINAMBgu5ACLD0JC7Yr_8n57A&oe=6A771604"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFZ25cmeOzUQ7kNvwGR_yub&_nc_oc=AdpblZkV3ZXR4AyRk8Zfn_rMj8aDicUn2vrngOYy8Fgz1i8FzH6VcwI-wH4Dz72zxqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwv5WMo0makZwFEpu6I2ljYBxLfNUBeiUDjwgI4bE4XA&oe=6A77366E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pIZHWuVIuMQ7kNvwEGwu6S&_nc_oc=AdqFjqhTzSA-RiiGpSgPqiHBBMnwR6ptK8dWQo3ycEwj_bBO5pvFR_nyhY01H0mjC1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlRlqXvv1F-o6D7TAMCucchwqjzDC10zsdMUPC_VVXVg&oe=6A771C5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwFDU7vnhCUQ7kNvwF259si&_nc_oc=AdplSo_k99I1PdztHfjbCvM2_CvJZbFALqyGMYd-v9gIbjVrnI7PLkbihL1_WTz83WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4J7zAh1gfS-JqQ3piHCKCYTyMi8HFcIBMdL9_qk7QIQ&oe=6A770F66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
dn.com&_nc_ss=7f20f&oh=00_AQGrvSBKmuH2PfojbNNuj6XRea9QBkJr5fuLSRkofuYlNA&oe=6A897D15"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WurJ8YDsAngQ7kNvwHsipuf&_nc_oc=Adqt5P1zFmxKJK4A_rasaBH1nj0osyStYE9pWE32rR0qmd3Io0h4GBhAVVu5XBL-5KE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuC2B5UfLNBqu4NbcvWtBI9ZJ3sBekIiQcRPMh_-daag&oe=6A898B04"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyCSWnQkcmoQ7kNvwHP7-5M&_nc_oc=Adqt4IIE4esIl9OtXjoYVLoFwKNZSVl375YV7DJ-6Nw6VQumOpMn7epXqFubiOdm9jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5qNRvOM07qDoXLpuXgFe6TkSQAoVKIdEr9IYugsvsOw&oe=6A89732E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba2t_YgDwc4Q7kNvwFO8B5H&_nc_oc=Adoa3-VZWZIMnpuMMkCnQk3J8Rnc2Tv0w6oOYP4wNU4KuXZy4jiRzJDxqRBvvPaJVvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG32gcttpB_aiZz6gjmI6jEoZ88Ew7tfDIlSFGLTZNAmw&oe=6A89915D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laPSmIeI_wQQ7kNvwGjZYy5&_nc_oc=AdoqbCCyA2g9N8dtPmZUpsHawh34MHXC90ZSQhOVqC6Z4c55QG0GRr8lpBcMMJg6nNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGroKogsIT-plXShWOQ5Dx1e4ENyLY7Hek0RkAt5rY1Uw&oe=6A898466"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
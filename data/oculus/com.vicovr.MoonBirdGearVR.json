dn.com&_nc_ss=7a30f&oh=00_Af0NOTlj76ezEpTTMn2FdRdWRmwYHb2oTPbBIWZI3gFZVQ&oe=69D517D5"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ32K65cjNgQ7kNvwGuufSe&_nc_oc=AdqDTvQVEEVHQX3uOiZuatd8wcSjf34mnUPaGuydZLoQgSAmBLN0hH9yDseuEuOGtQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1brn7MQnzS85er6i6GKU7SAP3qWtrSwSueRpdvyeeO4Q&oe=69D4ED84"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqGH63_85P0Q7kNvwHD9ONt&_nc_oc=Adpc6r3ne6NYJk79UT1T8lYiJCAGN0fGti5AdIjioL7pozR_yjaWcGIrnqyniv_IGGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h6tjXo6_HQem03JyeA0-sZGyx5MujnH7wW_ycAReoag&oe=69D50DEE"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TaQULTy9CMQ7kNvwF5eGjs&_nc_oc=Adpek38PdJrtDxV-kV7y1DRZtKC6aHhAi8T0Fy_cX-vPcH0fYRZLiC_kDnkTZMJJAwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OzRliPKfApvdv-pZGNH4SBidztAAmTU6z80eumrPUyA&oe=69D4F3DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHoSNVxZAfAQ7kNvwGwCeO0&_nc_oc=AdrbGr_FRlh_o3a2DJZabDI_0keDmdZJn_LZV5bW0896ZIGZTnMJ_ymvpP0Ky12xIMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xmDFTB9WjUrW7y0q5_WblgaJqoOlYWqDRqd7xDtID-w&oe=69D4E6E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
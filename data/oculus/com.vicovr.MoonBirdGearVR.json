dn.com&_nc_ss=7f20f&oh=00_Af0bwrgwX8dlkxdnE_YOqo4UlO90TZxsaBdUghY3vq7U_A&oe=69F36A55"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL7QpbFYhTcQ7kNvwHzGipd&_nc_oc=AdoYt3Tas374Sbw1CXry5NXaPyyQLIQseMx6ws6EqDZfWHhb7uYz0NT3QAX09pPtdu0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21oQrE1RZl7cBLelfPh_4tp6rbV_zQqYSE1Pt5i-6mHg&oe=69F34004"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDQC2vNjvUMQ7kNvwFUPtt4&_nc_oc=AdqpQSo4Qg30qd2hcW9LA6Zoi9uSGli9z43NVA7mF6KazI7EEBL8-6oMWQ76ydZUKB8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PwOIrdzf5_ZIu2fmaBCy3eA_eiuTWCKjAlDnXXQy0cg&oe=69F3606E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc8UTpNPaxwQ7kNvwHMh1tW&_nc_oc=AdrMztcWwNPdce8R8czrDanzUJ1xYLVpqljGSNl0cGz6wDUBUx6_6qNHVHryRVkBh2A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15JjWXWEt1HY7v8c74eiUjCibeI_dW15FS8SCPHmFX8Q&oe=69F3465D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0wy7M_WzJIQ7kNvwEDIiaA&_nc_oc=AdphHOHMudfjZjELq60_CObhHMCx038cJv1BVAzlXAwsLwkyOGCzkhbZQ7JNtsuto9g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eWdhohrfQwjtK2T179qIRZOAxPb8NO1Fuxdg1xqr-5A&oe=69F371A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
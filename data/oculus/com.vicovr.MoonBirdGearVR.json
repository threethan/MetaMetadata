dn.com&_nc_ss=7f20f&oh=00_AQJUuyKJdDZr69jOZFp9QYBwVsNvyNWzCZXe7YgSbMta7A&oe=6A998755"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYfQwCXteXQQ7kNvwGdLvr0&_nc_oc=Adr3vIadtQgspmNNP9xNBRtNNoyylQA7NNMbqNq927pnLO1TgI_Gf473WGfRHUyjA5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQOOEJb2nfi-JBox7RxktF0VlrLT6Cd9uzrF4_-GP1jg&oe=6A999544"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RetRLZhpFIgQ7kNvwEDzJj8&_nc_oc=AdojUxoT4M4v7Kbro07c0KDtvZenYONenwbQxqrNSi1FvCamC6akYFGIIcyibjgVznc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIexORelsmZ69t7CcHSWe7I2C_Gn0W-AH5pju16TEPAzQ&oe=6A997D6E"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l18yHX-dyFcQ7kNvwHpkz67&_nc_oc=Adq8rULI0hCh_UZ1VB3Wp-UE37IgEAlHeF8mr7xOiVmvzYoENMHGHCjAlfszIDqjgP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZyhMauhGYlJLyhFStgVqC2pnNCCmoAciTFm3JPCPuSQ&oe=6A999B9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMhX4dScbXIQ7kNvwEDUKpr&_nc_oc=Adq2Gl9fZhXMVzMwThYDsUT6-_EBXcbcLHwbkvGZW4RUa5zolDTfpOca4YMANrysl7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdTQnNcFQuuP15y5MdRtvPpJOGstqn_iGlsc6R5Pxj_g&oe=6A998EA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
dn.com&_nc_ss=7f20f&oh=00_AQI_vityfj8vXyc0dlrTFqm7HYN0SZhxUcMPZ1FaY6SYiA&oe=6ABA7CD5"}, {"file_name": "migrated_image.png", "id": "653451245468501", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12522311_632078226983127_6487073584031203328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ft4Qd7FnSkQ7kNvwFmVZsM&_nc_oc=Adog435Ph3jJnANt05leJBBg-lWT6X9V9QvmIvQNhZz49XdQ_mRDt1H9A_gWrENoIYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5KBG5f4jarNCpqZPkf1kQ_P7M_w1WzaqgMWiIHEUBbQ&oe=6ABA8AC4"}, {"file_name": "migrated_image.png", "id": "505521096796198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522276_271440256646759_7191824262141837312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcTJSAP3YAwQ7kNvwEbnBaQ&_nc_oc=AdrmpX9xOSNj35sgoJ0TQHSwVL0ahD-ztwvvl6jRrNLvsZ0QK03HPHZn011PF2ZR4Qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA-35u7veRl4Qp4q0eBLIwPh2206rJZMGZkAe5U4dbYA&oe=6ABA72EE"}, {"file_name": "migrated_image.png", "id": "143916103627046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_1927632134148914_6125591565688635392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6Tp3uJmhqwQ7kNvwF6f3-V&_nc_oc=AdqaCRF4s47JxaltvQF2GMU79VNjNRqpDYsYKJamFux6rz6YnR8hYvolhSIPJIq2D44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlNGB0dihlMJxBdJhleV1qbkz3jsDrR-g8L7KbAfjt4Q&oe=6ABA911D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moon Bird Demo", "keywords": ["runner", "racing", "bird", "moon", "Moonbird"], "long_description": "Be the first bird travelling across cosmic galaxies. Prepare to work hard to get as far as you can by flapping your wings. Enjoy picturesque scenery of distant planets, but be aware of scarce air supply. \nControl your flight with body tilts and flapping your wings to catch as much precious air balloons as you can or your bird will vanish in such a harsh environment.\nThis game was designed to showcase full body control by VicoVR sensor but can be played in a more relaxed manner with simple HMD tilt control (if you do not have VicoVR sensor).\n\nVicoVR sensor is the World\u2019s first wireless 3D sensor for Mobile VR bringing your full body into Mobile virtual reality without PC or wearable sensors.\nFor more information about VicoVR sensor please visit www.vicovr.com", "short_description": "Be the first bird travelling across cosmic galaxies."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vicovr.com/", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "RACING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112119039585257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138835_1932264260428272_4712448085790294016_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnNx1W_R_pwQ7kNvwHDk3A4&_nc_oc=Adq6WZ22VGEXQLHDt3d5cI9vnKZGOF2IT1YabQlyR57wnzYIy_kXfHrSIA3jVtvxPuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjDzKslCuyCynpzHhYa54VtkKHmLkmh_PtIs3pD4KgBQ&oe=6ABA8426"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Bird Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1491980400, "lastRevision": {"nodes": [{"id": "1444293685642665", 
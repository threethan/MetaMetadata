_nc_sid=6e7a0a&_nc_ohc=JYQkUG4CqzwQ7kNvwHPNOzU&_nc_oc=AdpSrsGA_YlwjVu33jutSaCFFSAHunMBLdZlA0Gi1P2VaN0BUt40yQYQLo38t4ni3IA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eYhvCvmbee89Mi_b-Ie8I5PKXfbArHtRX4T71I8msMg&oe=6A31678E"}, {"file_name": "Screenshot3.png", "id": "1246953084064730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308699_1246953087398063_7278121404330845145_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC2JXu5E_v8Q7kNvwG2ayuY&_nc_oc=AdpkI_CrG4JS_UUzQzK0oLJxojIx9p1yMmvARVFCSiiGu7ay0cJUzNec2NSzKgHxv_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aTTjmawvHRnqG6ubkC9QWCH5gTuMYOVDxBh-z16xoYw&oe=6A316E63"}, {"file_name": "Screenshot4.png", "id": "2370116720140614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303679_2370116726807280_7652700225763731482_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS62BrKpadoQ7kNvwGNt137&_nc_oc=Adq6AVXh1DesQH3LKmNWZAwQm2nK-Jba49DAQYGVbeRyZm2MxLpVuCtLNvg3WCL2FEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IHsVdbqbixkjop_q6k1DoumQFZ-Ke9QsnC_ELi54nSA&oe=6A315E6F"}, {"file_name": "Screenshot5.png", "id": "1889244578395660", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295272_1889244581728993_6547507513622028734_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhv9hT7eyiwQ7kNvwGdTga0&_nc_oc=Adp0xKstbUPLd8GVHnatMWI-6DwOfdjdzGXNiM5eaSvE5CMIwuIE3hStoAqm44xBEJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q0PTobcgomTP6MWRTFEgqPRLrRyr8Rxdqucm1u81oAw&oe=6A315EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PA_Cover Art Landscape.png", "id": "1546795023045313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822968_1546795026378646_6907884857567118794_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uE901nmnYwQ7kNvwHWZdu6&_nc_oc=AdqQMCJhqU8fWcY1jLL_sO9MYmu4C0NySqBiFY3oh2Vd9vFp_b5D6_WpATNcPbZmbnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ymyr_DcNy23ZKgD_7xISIHtsML6Dt0uydm0i1IbyfKQ&oe=6A31665D"}, "display_name": "Ramp Simulator: Post Arrival Inspection", "keywords": [], "long_description": "Essential VR training for safe and thorough external inspections of arriving aircraft!\n\nAfter an aircraft lands and parks at the gate, the ramp crew must perform a quick but critical post arrival inspection. This app provides immersive, hands-on training in a realistic virtual ramp environment, building real skills without the need for a real aircraft.\n\nCore Features:\n\nGuided Familiarization \u2014 \nExplore an aircraft exterior learning a standard post arrival inspection sequence from an expert guide.\n\nComprehensive Checklist Training \u2014 \nFollow industry-aligned checklists to inspect for things like visible damage, fluid leaks, tire condition, brake wear, landing gear integrity, control surfaces, and more.\n\nInteractive Walkaround Practice \u2014 \nPerform full 360\u00b0 inspections in a lifelike scenario with a simulated night rain weather condition. Use Quest controls and body tracking to \"walk\" around the aircraft, using your *flashlight* to illuminate key areas.\n\nPerfect For \u2014 \nNew ramp agents, recurrent training, ground handling companies, aviation academies, safety/compliance teams, and personnel preparing for airside roles or certifications.\n\nNo aircraft downtime, no safety hazards\u2014just powerful, engaging, repeatable practice that enhances ramp safety, reduces incidents, and speeds up proficiency.\n\nDownload Ramp Simulator: Post Arrival Inspection today and master post arrival walkarounds like a seasoned pro!", "short_description": "Become proficient in post-arrival aircraft external inspections! \n\nLearn key walkaround checks for damage, leaks, tires, landing gear, control surfaces, and more on arriving planes. Use Quest's immersive VR and tracking for guided practice. Essential for ramp agents, ground handlers, aviation trainees & safety teams. Safe, repeatable, zero-risk training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.netedgevr.com/terms", "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32286661577615795"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1238323281133859"}]}, "baseline_offer": {"id": "1238323281133859"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771860780, "status": "PUBLISHED", "id": "1238323281133859"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33993339413614661", "version": "1.5.3"}, "id": "1561684624985285", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32286661530949133", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33993339413614661"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1561684624985285"}]}, "change_log": null, "created_date
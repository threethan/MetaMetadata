ng.\n\nWhether you\u2019re looking for a quick VR fitness burst or just want to enjoy some lighthearted Halloween action, Pumpkin Punch VR delivers pure fun for all ages. Sharpen your reflexes, chase your high score, and punch your way through the spooky season! ", "short_description": "Get ready to punch, smash, and laugh in Pumpkin Punch VR \u2013 Fun Punching Game! Test your reflexes as you punch flying pumpkins and spooky surprises in this fast, fun, and festive VR experience!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31731119679866277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819396_1154989186588648_479363385235640236_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y8Vlfk_oggQ7kNvwHTT8Yc&_nc_oc=AdpZi-4DFJWPDezwGOczuqmXANI76O1q4mPuJjo6NRsR_O1COu4NcPvg8O30xqYE9H4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3EFaSspB9I1IxKSaU8eD1UjF9q2p6--1g3YUCIgVexvQ&oe=69F20CDF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pumpkin Punch VR
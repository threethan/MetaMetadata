s://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618093_1185263986952917_4440421574496104768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTotn0E8ZKgQ7kNvwFF9pi5&_nc_oc=AdqADzEdSZlDEWXxqnNiqrjuAsPAn_zDBwZbbkzVGQjHgs8d3J0LJWPugUgC-hRVtB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GCV55yKDlnNB1EfvbSvoKIrXUKMhOBOHacT6pNkGGLg&oe=6A314BF2"}, {"file_name": "\u622a\u5c4f2025-12-09 23.25.56.png", "id": "850674767657193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618102_850674770990526_7422896971220087778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_KSUaAA_KwQ7kNvwHX55RA&_nc_oc=Adp41qvLYXOEo_i3Ihn17LlUGtr4SYRvV4GmlbSUv8qOgs4EgKbpZKsAMP60r5iH5wc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hv-Z986AIZ7DxRU-Bo_CN2zqaHEP7VSGswpVSa-leZQ&oe=6A316D97"}, {"file_name": "jimeng-2025-12-13-3954-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "836065415918924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620940_836065419252257_206443966995562054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWwZZ-oIqXoQ7kNvwEhiLcG&_nc_oc=Adr03MPQO7UrJpOxorCYiUmgaM_8qKZ-b4_TpCfZAqi-LhKVRcr0gDbAdRfwDVPHdgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oy-zkxcjbS7WisRvBsPtMHsQc-MY1dISgHQcLMH2sEQ&oe=6A315C24"}, {"file_name": "jimeng-2025-12-13-6748-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "3182153045297001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_3182153051963667_392283180582857958_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5tKqr73G80Q7kNvwHitDud&_nc_oc=AdpnpV6celk3hOBMMd2tC1Gg82eEWhsoPk65dAseSsYo0dOlVdC_z37rdsDYvTstcYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tn8-jAVzMOZUfMIzXyZcI1z6d2BpQ559XnYc2omGQ6Q&oe=6A316C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kb2560.png", "id": "742279601799370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823812_742279608466036_1301550994046297307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YF81GIzbm0Q7kNvwGKXjqB&_nc_oc=AdospcsXHEpvl2JWfifyUDJv3i8M-0igv9-YgMYKG8MJNbpZ5hhDf-VGqCvxGwcicg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87sb13E0Kkg5vi4tSwjui-6pDogt_RRciO0s8V0VeIOA&oe=6A315199"}, "display_name": "Keep Balance And Carry On", "keywords": ["simulator", "funny", "platformer", "balance", "rage"], "long_description": "In a nutshell, this is unbelievably tough VR game\u2014all about the \u201csimple\u201d act of walking.\n\nYou\u2019ll be strapped into two wobbly \"legs\", controlling each one with a hand controller. Try not to panic (spoiler: you will), grab every star you can, and haul yourself to the next level before you faceplant into the ground.\n\nWe originally made this game because we thought \"real walking\" in VR would be a total piece of cake. Spoiler #2: We were so wrong. It\u2019s straight-up hell\u2014but shockingly, the kind of hell that\u2019s weirdly addictive and hilarious.\n\nSo we cranked out 42 soul-crushing levels to share this chaotic torture with you. And we\u2019re not stopping there\u2014we\u2019ll keep dropping new levels to make this one-of-a-kind pain (and joy) last even longer. Don\u2019t stress (you\u2019ll definitely stress), you\u2019ve got this\u2026 hopefully you won\u2019t cry while \u201cwalking.\u201d\n", "short_description": "In short, this is an unbelievably difficult game about walking in VR. You will control two very shaky \u201clegs\u201d with your hands - try not to panic (spoiler: you will), collect the stars, enter the next level before you fall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE
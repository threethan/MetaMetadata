s://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_1185263986952917_4440421574496104768_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59TZ9CblqGIQ7kNvwHgn5nZ&_nc_oc=AdpAjSVd7oF_4U2HBGdXYX2WNN_FCM9agwy6ai6ZDgDo7OSr2I9H-BwzAHOKRH4YdzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xo7RNTrIbwpVn0kh21_OQLDdmh1j0IojzQ49t8SMFZw&oe=6A144AF2"}, {"file_name": "\u622a\u5c4f2025-12-09 23.25.56.png", "id": "850674767657193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618102_850674770990526_7422896971220087778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb8cBrFKyoYQ7kNvwGOdOf6&_nc_oc=AdrCQklOTTzCiiUujsI0zaJLjYGkdmdnKkCML1vAXom7k0gniyiYYeUKNISeMJYbnyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VyOZY7gRFZruhzlsJpu63RqDITaIc-cL1mkseFKDzQQ&oe=6A146C97"}, {"file_name": "jimeng-2025-12-13-3954-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "836065415918924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620940_836065419252257_206443966995562054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVX1d1QWU0wQ7kNvwGpnweb&_nc_oc=Adp725igG1wSnCszn5U_glTrRNy2gGcbkQtIv1jUlx5oMKft8T9OqAbze7Jna6FedqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cWJv5W0bh8tInDbEQq6IK52EgjXIAiWJ3zNVjDlWwjQ&oe=6A145B24"}, {"file_name": "jimeng-2025-12-13-6748-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "3182153045297001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_3182153051963667_392283180582857958_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tDqY6QWvcUQ7kNvwEOj0PG&_nc_oc=AdrelqRPicqVXfnemm00YGiJoeoDmj8M2TGTe4Np7912SDRu9kmYQAVypusFHmd0DBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AxYSoS_IlEGQQ2cjqNtNzwSqwwneWq8aHDmne_4WuwA&oe=6A146B86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kb2560.png", "id": "742279601799370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823812_742279608466036_1301550994046297307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImM3eMZg2OIQ7kNvwFfm_JK&_nc_oc=Adq1TUSB1XiHpkKi9VjyrGPNQVIEKA7q9J_x4l4hW16XpN4nkXoA6PEfcfS_SBN9tpw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cpKexQuc4LenRIKHvChgMWw1XwR8nmAkcFhXTT2njxA&oe=6A145099"}, "display_name": "Keep Balance And Carry On", "keywords": ["simulator", "funny", "platformer", "balance", "rage"], "long_description": "In a nutshell, this is unbelievably tough VR game\u2014all about the \u201csimple\u201d act of walking.\n\nYou\u2019ll be strapped into two wobbly \"legs\", controlling each one with a hand controller. Try not to panic (spoiler: you will), grab every star you can, and haul yourself to the next level before you faceplant into the ground.\n\nWe originally made this game because we thought \"real walking\" in VR would be a total piece of cake. Spoiler #2: We were so wrong. It\u2019s straight-up hell\u2014but shockingly, the kind of hell that\u2019s weirdly addictive and hilarious.\n\nSo we cranked out 42 soul-crushing levels to share this chaotic torture with you. And we\u2019re not stopping there\u2014we\u2019ll keep dropping new levels to make this one-of-a-kind pain (and joy) last even longer. Don\u2019t stress (you\u2019ll definitely stress), you\u2019ve got this\u2026 hopefully you won\u2019t cry while \u201cwalking.\u201d\n", "short_description": "In short, this is an unbelievably difficult game about walking in VR. You will control two very shaky \u201clegs\u201d with your hands - try not to panic (spoiler: you will), collect the stars, enter the next level before you fall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE
zfGXXXYcgutJH7EThdY6BB4f4PeOJEZX144BJvYWZqFwObS9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU2BJzdNOJrrtSXMrdschZZor0NgSLDDw3-psKEKDJWg&oe=69CA76F2"}, {"file_name": "\u622a\u5c4f2025-12-09 23.25.56.png", "id": "850674767657193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_850674770990526_7422896971220087778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XS7re3KVm0Q7kNvwFSKsyr&_nc_oc=Adr-DpabcMqgLQtbNmsHSS_FYH6XJWTLLcOEQPNsOrCcKgaHwSYV05df-4TjH3HWs7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT8fiq9xCQz3jS646OqHSfJIaFYwDMMAHOBu6Qu7Re7w&oe=69CA6057"}, {"file_name": "jimeng-2025-12-13-3954-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "836065415918924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620940_836065419252257_206443966995562054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhJzy222-H4Q7kNvwEeP_mL&_nc_oc=AdrLbGQrJMJ62cyHN7h0sFuf9vkcB2nynbx5VCsp0GvGnj9Y7fOC3nFqXIZPwQJu9n4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy47Osz1_Ct598SeTsXiRR55RhooV61OhoCsOE7FWZHNQ&oe=69CA8724"}, {"file_name": "jimeng-2025-12-13-6748-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "3182153045297001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_3182153051963667_392283180582857958_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYQzyzvJZysQ7kNvwEkeE7E&_nc_oc=AdpEq9fHvi4noH3CETjvYHjh5w4UW1IGNltHEhkLQcL97tfMH1D9VuGnizAqugOSjps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw28UtoeLlKac9PL-nWwZiuhMEM2K9brGE5z8gX4tecTw&oe=69CA5F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20251209-232136.png", "id": "1372267231286569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_1372267234619902_275821156816171695_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmyAqvs5n4QQ7kNvwG0mxr_&_nc_oc=AdpHCkAOiZf8dzq6NyVn2XaFYzr85e4HwoKmhAYSQAfSMG5RYxObpFFjXvQLXt4BUD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy508CquL8R4C6meQp6jPqRUVnkHopHfMhnbV03psHldA&oe=69CA78FD"}, "display_name": "A Very Difficult Game About Walking", "keywords": ["simulator", "funny", "platformer", "challenge", "rage"], "long_description": "In a nutshell, this is unbelievably tough VR game\u2014all about the \u201csimple\u201d act of walking.\n\nYou\u2019ll be strapped into two wobbly AF giant stilts, controlling each one with a hand controller. Try not to panic (spoiler: you will), grab every star you can, and haul yourself to the next level before you faceplant into the ground.\n\nWe originally made this game because we thought stilt-walking in VR would be a total piece of cake. Spoiler #2: We were so wrong. It\u2019s straight-up hell\u2014but shockingly, the kind of hell that\u2019s weirdly addictive and hilarious.\n\nSo we cranked out 42 soul-crushing levels to share this chaotic torture with you. And we\u2019re not stopping there\u2014we\u2019ll keep dropping new levels to make this one-of-a-kind pain (and joy) last even longer. Don\u2019t stress (you\u2019ll definitely stress), you\u2019ve got this\u2026 hopefully you won\u2019t cry while \u201cwalking.\u201d\n", "short_description": "In short, this is an unbelievably difficult game about walking.\nYou will walk with two very shaky high stilts, control them with your two hands - try not to panic (spoiler: you will), collect the stars, enter the next level before you fall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"
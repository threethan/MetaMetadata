m4YWw&oe=69F203F2"}, {"file_name": "\u622a\u5c4f2025-12-09 23.25.56.png", "id": "850674767657193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_850674770990526_7422896971220087778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-PDRrPijncQ7kNvwE57l64&_nc_oc=AdoD6cJmck8XgYkxnBt04GRqnCfiGyLc0CpR_-G2aKlRrdbKcsF0Fa5pRgX_UUaCIdY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af361V2bGYS9FHkyeSjuXK_sH_E6XF4yfxwOxjT99aFL5Q&oe=69F1ED57"}, {"file_name": "jimeng-2025-12-13-3954-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "836065415918924", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620940_836065419252257_206443966995562054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W0E6vEGGb8Q7kNvwEinkMn&_nc_oc=AdquCWw_F3McowLFeYhBiVZrReD_Nczg8SUJzrQFTMEVD3A1VQL3s5Bq2GF6i8aVcVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af309stYE0U1rsKp4R6ZxGqZlG6d_bGH6ApOfIkJVUT71w&oe=69F21424"}, {"file_name": "jimeng-2025-12-13-6748-\u53bb\u6389\u753b\u9762\u4e2d\u7684\u9f20\u6807\u7bad\u5934.png", "id": "3182153045297001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619680_3182153051963667_392283180582857958_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zMoDcDYK0EQ7kNvwFcOIJS&_nc_oc=Ado6Kx8qfZWc9awLQzxrk7MjaHm2TMy3j-BQWWnFYObFpluclIO4Y853jJZeTN5Tln8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2P_ObhGd-xT9mC8P5bg5DYKJPGojiirIKtEBcVibD4BA&oe=69F1EC46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20251209-232136.png", "id": "1372267231286569", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619113_1372267234619902_275821156816171695_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYqlXkOQlJkQ7kNvwFJtn8i&_nc_oc=AdpCLartFB8OqqaBUa-yIJFKL_4B9i7TvQP1XvRz3oxr_xV_CIFbUMCwUBxGLFuckpw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1QDtBruDd_j0GQqFENAc3KKBQSujDl3DoLSR0jGwCP7g&oe=69F205FD"}, "display_name": "A Very Difficult Game About Walking", "keywords": ["simulator", "funny", "platformer", "challenge", "rage"], "long_description": "In a nutshell, this is unbelievably tough VR game\u2014all about the \u201csimple\u201d act of walking.\n\nYou\u2019ll be strapped into two wobbly AF giant stilts, controlling each one with a hand controller. Try not to panic (spoiler: you will), grab every star you can, and haul yourself to the next level before you faceplant into the ground.\n\nWe originally made this game because we thought stilt-walking in VR would be a total piece of cake. Spoiler #2: We were so wrong. It\u2019s straight-up hell\u2014but shockingly, the kind of hell that\u2019s weirdly addictive and hilarious.\n\nSo we cranked out 42 soul-crushing levels to share this chaotic torture with you. And we\u2019re not stopping there\u2014we\u2019ll keep dropping new levels to make this one-of-a-kind pain (and joy) last even longer. Don\u2019t stress (you\u2019ll definitely stress), you\u2019ve got this\u2026 hopefully you won\u2019t cry while \u201cwalking.\u201d\n", "short_description": "In short, this is an unbelievably difficult game about walking.\nYou will walk with two very shaky high stilts, control them with your two hands - try not to panic (spoiler: you will), collect the stars, enter the next level before you fall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
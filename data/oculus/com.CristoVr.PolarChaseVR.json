kfBx2G6s0QHaLeSDrgw&oe=6ABE6EB2"}, {"file_name": "Colorblocks.png", "id": "1087926097104845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830576_1087926100438178_7274381290660284544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSgvs6Ls6P4Q7kNvwGYMuux&_nc_oc=AdozydEiPATCHG-GZ8PdIVTLgu0SrDuYvGaehuHyWvmc_82bVEqYc8EK-o6xq0XV9gE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-fnHKkffKJTrWdyVXxZw7OOBIvtMo7eYPPqz3dPgzoA&oe=6ABE5D2E"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdm9wsfhzZYQ7kNvwEab77F&_nc_oc=AdocaDBX6mY2VaJjuMeKKS42LwAdtXILVrm2GwsuuJKbjxRXpUkntNAThakQr-jYk5w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoMxbC4xbI3FLVLNR7FSZauElf4phvflDaKQU_cdjHag&oe=6ABE5B14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChase", "keywords": ["Horror", "Backrooms", "Mods", "Lethal", "PolarChase"], "long_description": "Welcome to PolarChase! \u2744\ufe0f\n\nPolarChase is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChase is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with sea
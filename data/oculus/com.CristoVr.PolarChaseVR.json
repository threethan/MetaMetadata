ce monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasonal events, new items, and new game modes!"}]}, "developer_name": "Cristo", "developer_privacy_policy_url": "https://polarchase.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cristo", "support_website_url": null, "website_url": "https://polarchase.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29757039740553178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499313063_1601190788069873_6526509308869461026_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kDPZfSPbgAQ7kNvwEUxQdl&_nc_oc=AdrfScihP-mjPyH8vTb6UEOLxbTF932sF5VOTeqKb6FM16pOnuoTDOfiu2o0X0rOmCs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkjCNCv5QM6EPImvzkaXWXqCHhJ-7w2bSP7YFlN2E63Q&oe=6B08415F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PolarChaseVR", "platform": "ANDROID_6DOF", "context_category": {"context_category
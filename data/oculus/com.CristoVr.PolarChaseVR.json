3WAa-g&oe=6AA812D4"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79LEEsPglq4Q7kNvwGFlh_R&_nc_oc=AdrG1gHOJ4piUJZ9V7WHruYrVS-m6miIidnQANtiLNfwwzTTJUxsiceD6j43ZoGy3Tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdroEBlViEHZ1kQGQvcWCCtsJ4PR3BnEjQuEmF8QNAYA&oe=6AA80532"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89oIS-ER5-AQ7kNvwGySUeU&_nc_oc=AdpZxzc2He-_W4V3MpFBNY0-_5bsiHziMq4KmqWJ7EWZj10fGFysL8K0dNbQpovdh2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvgDzU-ifMC1jMn0R1-t_B_P6Z4GzW50Xa1LScQEJcGg&oe=6AA7F194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 **WEEKLY UPDATES**\nPolarChaseVR gets **new updates every week!** Expect new game modes, maps, cosmetics, features, seasonal events, and more!\n\n\ud83d\udc79 **THE BACKROOMS**\nEnter the Backrooms and explore strange levels while trying to survive monsters like **Captain Clark, the Bacteria, and more!**\n\n\ud83d\ude31 **HORROR MODE**\nExplore multiple terrifying levels filled with monsters, creepy environments, and challenges. How far can you make it?\n\n\ud83e\uddf1 **SANDBOX MODE**\nBuild whatever you can imagine! Create houses, towers, maps, traps, and more.\n\n\u2b06\ufe0f **ONLY UP**\nClimb higher and higher without falling. One mistake could send you all the way back down!\n\n\ud83d\udd2b **RUSSIAN ROULETTE**\nTest your luck against your friends and see who comes out on top!\n\n\ud83d\udecd\ufe0f **THE SHOP**\nCustomize your character with awesome cosmetics, mods, and other fun items!\n", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, and get awesome cosmetics and mods from the shop. **New updates every week with seasonal events, new items, and new game modes!**"}]}, "developer_name": "Cristo", "developer_privacy_policy_url": "https://sites.google.com/view/polarchase/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cristo", "support_website_url": null, "website_url": "https://sites.google.com/view/polarchase/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29431989526391536"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1601190788069873_6526509308869461026_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=
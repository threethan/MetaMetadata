09Jl_OqLAw_MSavYJgfw&oe=6AC3B4B2"}, {"file_name": "Colorblocks.png", "id": "1087926097104845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1087926100438178_7274381290660284544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW3NncsKg_QQ7kNvwHLllXC&_nc_oc=Adr7pv26YQfOBpNz4brinBsYV8txaNmA7OF2GaJoKfONaVDw3a4BA1sEh2CgT4RjK2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIZeeuuqf7UdWkwzVi1WQ_9s8r5gJhl7ZjLuRFBRcwDA&oe=6AC3A32E"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSps4F1HO5MQ7kNvwHSZfKF&_nc_oc=AdpLmPp-nBFe9vQTlC4zqTctTYexTfSMPlV08M9sBfS85mR_Whv69NcqPxbq4v6krfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrwApRESBlaVJFLDykql_jaZ0U6p4A3phUl7AXwiqScQ&oe=6AC3D954"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChase", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChase! \u2744\ufe0f\n\nPolarChase is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChase gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChase is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seaso
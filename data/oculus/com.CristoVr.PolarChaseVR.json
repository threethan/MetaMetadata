g8H7zV1yyqhr6CPA7KC5sQ&oe=6AE3486F"}, {"file_name": "CB.png", "id": "1873181487396325", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303116_1873181490729658_8892021542498028854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNpETnrpH0wQ7kNvwFkAzB3&_nc_oc=AdrV03JG70g0MTGvr9b_XUGk-ZTlmEk9JnOtQVtnIPPuLn13sLd-LsPYBG7HQO67Br4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaa-aQ7IPez-Ix5w7OxT7UgZjZhimIf6aHw0cEWKYSCw&oe=6AE3413B"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tJl29mBkj0Q7kNvwFiOO-W&_nc_oc=AdrAqTxt79D-1CieKb1Y4W7QVpEWDpnWqFJUbSI01LXCblv1U94H0Z2din7-_XALw5o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN6gJQOkzxqYmCfQWb0-Q0zuVJ2-Ghuq0KrwPPS6uFHA&oe=6AE358B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasona
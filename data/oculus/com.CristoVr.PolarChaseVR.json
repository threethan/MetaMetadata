Wyaahop8AdIBiuX-UZsQ&oe=6AC657B2"}, {"file_name": "Colorblocks.png", "id": "1087926097104845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_1087926100438178_7274381290660284544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHW7AhcTq2EQ7kNvwFGrBys&_nc_oc=AdrzrnAY2elg4M8jp4aDV-qvtXcGst3B_z7pXjtzOmLwZZmQvQZt-vxg9GIVhjyzX_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-iPnCgEsMerKS4cRx8j3lg9YHzo5pW5mCn7AtCqPsgw&oe=6AC6462E"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-ObeJWYLWAQ7kNvwHixYNw&_nc_oc=AdqW6TiTknJodjIQRZuIwvS5r58o6ww_NF45DmDYuBWMwRmjgsbS3tgNmPJkGGz7OwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSwEr7Hzburljf1VQ9gW_K3iyZ2r7wJBozkwRUtr6psA&oe=6AC64414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChase", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChase! \u2744\ufe0f\n\nPolarChase is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChase gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChase is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seaso
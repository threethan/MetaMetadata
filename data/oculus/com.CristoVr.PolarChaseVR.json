rmALhCuccxMCXbM3egDlBA&oe=6AF9EA2F"}, {"file_name": "CB.png", "id": "1873181487396325", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303116_1873181490729658_8892021542498028854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kphUxcg7KxMQ7kNvwGZcv6t&_nc_oc=AdqkKXyR98ByG4wHdXfvh6QgB8_PazYIk4P9NRAVkyc4Esy9CKat0KIX7MRubOAcjcg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLpjG9n1-efo4_T-sCnkSChJpz7JPXP_k-x9-TkXZF9w&oe=6AF9E2FB"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrXVXyd7LVkQ7kNvwHDmAlH&_nc_oc=AdooKF_n7Lkmgl9gQFaxUOvnwVrlT-PeU9tdXYV_wYCf27kBKe8Mu6PVolaT95hdTkM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgJDCvajR0WZdVLyzb6G2VyMxywGSR-U8qlQmIuc3GLw&oe=6AF9C232"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasona
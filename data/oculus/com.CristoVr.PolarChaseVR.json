nxlxa_K4AI5_D7c3Ow19Xg&oe=6AD0D36F"}, {"file_name": "CB.png", "id": "1873181487396325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303116_1873181490729658_8892021542498028854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ6rOzXfJdIQ7kNvwFOcvIN&_nc_oc=AdoHioP0M6eHLo9UfXwXZ-DKVOHFNKnFfnOKBGvi6J32H4NFLSAnQFl8kPuUxfpUAV4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR_nHFUoryP48HW5C8oXvh5fWlORennv4-z9aMnDeeYA&oe=6AD1047B"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKtME3vwqw8Q7kNvwHEb59Y&_nc_oc=AdrbGecIT8w3Zyy_8hS-wrSA0A6LSjvuOSNDE9aAYyVEtIyMoPT7CkE3Dqd2IQ1eu9o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMuzD_mVSMzLiaQxJjda3_eBQ8HIM-bpElJCGvc2n5OA&oe=6AD0E3B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasona
_JW7JSCA&oe=6AB69354"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NasXNgS7JTMQ7kNvwEZ_QOX&_nc_oc=AdoMarviteH35WYhFyvvjjyPXiQUdNdY-0sejEoH-QUaQ6d4bKPXkw3cLwizZOfp_i4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuLrH9do7TtRUfTyME81dLII26W3YfpzqSkTqEFAUiGQ&oe=6AB685B2"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZZsSzrngn0Q7kNvwEpMP_3&_nc_oc=AdrJaJrS9A2ml2PwjnLqJ2QrEbXOeoXFjVWhajyhYxSVHoWesNSAvQ7WGclXQ5tyDnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbVSvHucZmETn4BxkzZ_deojeDh58rToSdUjnIk82b0g&oe=6AB67214"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasonal events, new items, and new game modes!"}]}, "developer_name": "Cristo", "developer_privacy_policy_url": "https://sites.google.com/view/polarchasevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cristo", "support_website_url": null, "website_url": "https://sites.google.com/view/polarchasevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29536596965930791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313063_1601190788069873_6526509308869461026_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ljcfDhtvpAQ7kNvwHE3iDy&_nc_oc=Adr7ZoQkmvNM4UksJu4lGcQGgctsppA3f9lzBstLEuW536vT6b-t86BVr8rRk6A_Agw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLRPOD-Mj8FxghuY5iHiT0Bqc0KDeb91D65prFG3QaEg&oe=6AB6845F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PolarChaseVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date
bynnZwPR0rKymumFOCFjRA&oe=6AE499EF"}, {"file_name": "CB.png", "id": "1873181487396325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303116_1873181490729658_8892021542498028854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrbPHHAipmUQ7kNvwHqTrUd&_nc_oc=AdrTU3sRt-CC6FXRx0JopTPseR6nZ9LAvHvcML_KwIMSIblvr1BaBisVRIw2dehQdOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnEj1BnglRvY5mzzRdKtyBIt0faJQMmN9SbrKnUsHSSA&oe=6AE492BB"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tJl29mBkj0Q7kNvwEzwdm-&_nc_oc=Adp3melV3o1cesfgegAEuD-O8yUYsfZIwAdJeq5KcdReLhWgwpVVbu9gbeMc-h2f76E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc_zNpDfN3cJQtxmBJmsBHY7VgNN0d9BxEtU63ACulbA&oe=6AE4AA32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasona
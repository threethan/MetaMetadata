GwUm79scJ3N9v7RLZ3w&oe=6ABD1D32"}, {"file_name": "Colorblocks.png", "id": "1087926097104845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830576_1087926100438178_7274381290660284544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPfmT-EFKV4Q7kNvwEXtwBn&_nc_oc=Adro9nfGtlp3E0jljN5U1rjMWB2ffeNjDcHmbdStVFgTwEXngPHy_VIgdUFSVTTOj4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJld2psvW0KfL6CPpnb_2uhM53cx2cS3VFQRMJNzt_04w&oe=6ABD0BAE"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdm9wsfhzZYQ7kNvwH8Y7Pj&_nc_oc=AdoqdqVUtsojmeKoYod_EVZIPP6EJwsg7oNkZNNtujIslYgE6U-tfrxow8CtAVk6Spw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFjnz9HQXiIzc86IONxtvSj1D2V6TPcGARsLjwzpKY0A&oe=6ABD0994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChase", "keywords": ["Horror", "Backrooms", "Mods", "Lethal", "PolarChase"], "long_description": "Welcome to PolarChase! \u2744\ufe0f\n\nPolarChase is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChase is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with sea
5j_laQAfAKQSLIaW6ANQ&oe=6AC26332"}, {"file_name": "Colorblocks.png", "id": "1087926097104845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1087926100438178_7274381290660284544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW3NncsKg_QQ7kNvwHA36Uj&_nc_oc=AdqDNn6MrcnrIuRbOPGinKgmqFGlQZQBbhKs7K9sQSm9byNwrF-sTHBNrdyPrSeXaOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLWbyxgsF1DkV-SkNXD10AvT8gKbwWAT6BfuZv6m096w&oe=6AC251AE"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSps4F1HO5MQ7kNvwEQ_oE-&_nc_oc=AdrXDvSqMywlYhDLrdiu5omDlTK1LEUIAvq6kLClnThOAyz4KyHJZVSPcbXr69as6XQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb-swZd3nG--3b2iwo4QnMKC6pbav37C2ZvBFXDFkrlg&oe=6AC24F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChase", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChase! \u2744\ufe0f\n\nPolarChase is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChase gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChase is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seaso
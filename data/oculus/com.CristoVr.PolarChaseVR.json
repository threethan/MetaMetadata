Bhy0RVMG9Y_xnsMhFprl9w&oe=6ACFBA2F"}, {"file_name": "CB.png", "id": "1873181487396325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303116_1873181490729658_8892021542498028854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUUtuVPtl00Q7kNvwGPAlFI&_nc_oc=Adov5BlsuulU5RX-tpYBRvGeyd6GBDnF4-gzXK4E8gyD6r4FbYzWbMk79A9ABr32vRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3pJH1H52MDu8qC-n0n_L8t789tjnyKOqHiaP-4fUVpw&oe=6ACFB2FB"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qUkcKH7Y-QQ7kNvwGkmYd8&_nc_oc=AdoPMhGmexhAXukpDhWrZzrqtL8RyF92-h7RINgnW8B4iInab-zL89EsyhZoMVkgFec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR1qFEeWL-q9q6yOmI0gXdFAZkkWove7dCTfasaDp3gQ&oe=6ACF9232"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasona
WUKfPiKB0c9jxInNM-cmAo5CjKAw-Xudi22gUg&oe=6AA2CCD4"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oESgQTtRmoQ7kNvwF1vD5p&_nc_oc=AdrbtxSjs56ObUSRy96RXR9X2T8b4aW856kjycmkbHKiK7r5562j_DuHtPLjyIHgrnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPi9IsrXkcS9DibSIhATHh3fEtPc0KSFfIssr8UPsPPA&oe=6AA2BF32"}, {"file_name": "Forest21.png", "id": "1125845268882494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392881_1125845272215827_7430940379198219300_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOAI3GSMloAQ7kNvwGFHDEe&_nc_oc=AdrvzQGA_ga0--RUa9xn9MQwKArhRbuVRrmJPbuVdMY-uGGskm86GouG_LCgvpGw4zk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ir6AUmvuZek8105FlKFqk3HfqBkXsLqZgZY5bU3uhw&oe=6AA2AB94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Mods", "Lethal", "Backrooms", "Gorilla"], "long_description": "Welcome to PolarChaseVR!\n\nPolarChaseVR is a PACKED with fun, scary, and crazy game modes. Play with your friends, explore new places, survive monsters, or just mess around and have fun!\n\n\ud83d\udcc5 **WEEKLY UPDATES**\nPolarChaseVR gets **new updates every week!** Look forward to new game modes, new cosmetics, new maps, new features, and more.\n\n\ud83d\udc79 **The Backrooms**\nEnter the Backrooms and watch out for monsters like Captain Clark, Party Goers, and the Bacteria. Explore the levels, survive the monsters, and try to make it out alive!\n\n\ud83d\ude31 **Horror Mode**\nLooking for something scary? Try Horror Mode and see how long you can survive exploring its many levels!\n\n\ud83e\uddf1 **Sandbox Mode**\nBuild anything you want with blocks! Make houses, maps, towers, traps, or anything else you can think of.\n\n\u2b06\ufe0f **Only Up**\nClimb higher and higher without falling. Be careful, because one mistake can send you all the way back down!\n\n\ud83d\udd2b **Russian Roulette**\nTake the risk and test your luck against your friends. Who will get lucky, and who won't?\n\n\ud83d\udecd\ufe0f **Shop**\nCustomize your player with awesome cosmetics from the shop. You can also find mods and other fun items to change up your gameplay.", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, and get awesome cosmetics and mods from the shop. **New updates every week with seasonal events, new items, and new game modes!**"}]}, "developer_name": "Cristo", "developer_privacy_policy_url": "https://sites.google.com/view/polarchase/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cristo", "support_website_url": null, "website_url": "https://sites.google.com/view/polarchase/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29380231891567300"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1601190788069873_6526509308869461026_n.png?stp=dst-png_
HC2hP-F0K6SrQMPervXsUw&oe=6AE1F6EF"}, {"file_name": "CB.png", "id": "1873181487396325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303116_1873181490729658_8892021542498028854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNpETnrpH0wQ7kNvwHqG-6F&_nc_oc=Adp1M4nzFv9ekXxt_j5Zg5eYyqf650yPTfb1-94YuVkhhGqdBUcWn2kQwP8MUzLE25k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuq7A_bZA-Bx8m3hiRi1Sc3bXfCcezTR1RmXYft6rN7w&oe=6AE1EFBB"}, {"file_name": "ou.png", "id": "1026373153340396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302527_1026373156673729_2819283372243424291_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tJl29mBkj0Q7kNvwH-oMQS&_nc_oc=AdoXdn1LxtL16FhHj2BnnDy3cKoHXowHx8dXeF0lAdhKBm0BvZkaFd1AvjZ3c7Lc7rA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7nxzzFA-QoQ0V0SMxXPJ56AGTQCKn-PqbAXCLIV9dfw&oe=6AE20732"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PolarChaseVR", "keywords": ["Horror", "Backrooms", "Adventure", "Mods", "Lethal"], "long_description": "Welcome to PolarChaseVR! \u2744\ufe0f\n\nPolarChaseVR is a Multiplayer game where you can explore the Backrooms, face monsters like Captain Clark and the Bacteria, survive scary Horror Mode levels, build in Sandbox, climb in Only Up, test your luck in Russian Roulette, race against the clock in Color Blocks, and customize your character with awesome cosmetics and mods!\n\n\ud83d\udcc5 WEEKLY UPDATES\nPolarChaseVR gets new updates every week! Expect new game modes, maps, cosmetics, features, seasonal events, and more!", "short_description": "PolarChaseVR is packed with fun, scary, and crazy game modes! Explore the Backrooms, face monsters like Captain Clark, Party Goers, and the Bacteria, or try Horror Mode and explore its levels. Build in Sandbox, climb in Only Up, play Russian Roulette, test your reflexes in Color Blocks, and get awesome cosmetics and mods from the shop. New updates every week with seasona
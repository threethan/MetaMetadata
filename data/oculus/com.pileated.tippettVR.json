": null, "video_trailer_thumbnail": {"file_name": "HG-Oculus-StoreCoverLandscape02.png", "id": "1585591624789115", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386450_1585591628122448_7941000819241910272_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEEpyCBWXgAQ7kNvwFpMQJ5&_nc_oc=Ado2z5ij5X3w4BK7bISskyItMlhWveaTrQfPHWHaBz2csIG5hPjx9ppcAG76FwxggO4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS_c_3W1QXWdSGwVvyOyvYSKLZcud3qYn26iJwEA-72A&oe=6AFB1780"}, "display_name": "HoloGrid: Monster Battle VR", "keywords": ["TableTop", "Tippett", "Holo", "StarWars"], "long_description": "LAUNCH SALE!\nHoloGrid: Monster Battle VR is an original Virtual Reality game by HappyGiant and Tippett Studio. A \"Hybrid\" Board Game &  Collectible Card Game (CCG), using the monsters of VFX Legend Phil Tippett, and inspired by the \"HoloChess\" scene he created many years ago for the original Star Wars film.\nThe game is a Tactical Battle Strategy game, where each Monster and Spell brings a unique Ability and strategy to each match. Play Single Player matches against the AI, or play Multiplayer against Friends. Over 2500 Team Combos supported at launch!", "short_description": "LAUNCH SALE!\nHoloGrid: Monster Battle VR is an original Virtual Reality game by HappyGiant and Tippett Studio. A \"Hybrid\" Board Game &  Collectible Card Game (CCG), using the monsters of VFX Legend Phil Tippett, and inspired by the \"HoloChess\" scene he created a long time ago ..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "http://www.hologridmonsterbattle.com/privacy.html", "publisher_name": "HappyGiant", "support_website_url": null, "website_url": "http://www.hologridmonsterbattle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "gen
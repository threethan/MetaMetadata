 play Multiplayer against Friends. Over 2500 Team Combos supported at launch!", "short_description": "LAUNCH SALE!\nHoloGrid: Monster Battle VR is an original Virtual Reality game by HappyGiant and Tippett Studio. A \"Hybrid\" Board Game &  Collectible Card Game (CCG), using the monsters of VFX Legend Phil Tippett, and inspired by the \"HoloChess\" scene he created a long time ago ..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://happygiant.com/terms-of-service", "developer_terms_of_service_url": "http://www.hologridmonsterbattle.com/privacy.html", "publisher_name": "HappyGiant", "support_website_url": null, "website_url": "http://www.hologridmonsterbattle.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "491078119293976"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "CANCELLED", "id": "393899697697466"}, {"status": "PUBLISHED", "id": "509316489442596"}, {"status": "PUBLISHED", "id": "2060803677541637"}, {"status": "PUBLISHED", "id": "756843994477848"}, {"status": "PUBLISHED", "id": "115572742446453"}, {"status": "PUBLISHED", "id": "1125444820900555"}, {"status": "CANCELLED", "id": "193871227842769"}, {"status": "PUBLISHED", "id": "479836339028109"}]}, "baseline_offer": {"id": "756843994477848"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "CANCELLED", "id": "393899697697466"}]}, "liveChannel": {"nodes": [{"latest_supported_bi
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJPqKaIEPY0Q7kNvwHV_Qm7&_nc_oc=AdoY8VF2WuUNyxDUNh5JHl-RRwLURwUb-kQFsGWc3_JprOK3f5uiRKuUkttmmJPysTM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aey3co1nI9ABcFl6dPWZEnxbhCp8CbXoy1KGzIKQAUg&oe=6A0F002D"}, {"file_name": "K\u00e9perny\u0151k\u00e9p 2026-01-22 095541.png", "id": "1217861333816435", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507829689_1217861337149768_3323518517693218239_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQNFwdazhp8Q7kNvwFp_bfb&_nc_oc=Adq4AqWRTBgHhnXOxBQuqzMocgknCAG-X-r6TxLAJ9Mpl-lQTtEQY72YjlcAFuZ_2hA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ASej0VjDF6O9jV5rAJfq12x8VKKWu96Jc6zX6e9v7Tw&oe=6A0F24ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "1598192407851308", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_1598192411184641_7768509647284292344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31hs1YKVg4kQ7kNvwE0ApZn&_nc_oc=AdqJD66ehZoqGYMkPy68a0OFxRgMLcldfWgJjlaipoelcftgIJm2PejtriuxrIUAz1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mLxwsarAEFb4lIIZY01hPXrp_QH7vF6txNQcRe3rFBg&oe=6A0F204E"}, "display_name": "VReduMed-VRoomOfHorror", "keywords": [], "long_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room. The system combines a VR application with a PC-based observer client, enabling instructors to supervise or guide students in real time without the need to physically prepare evaluation rooms. The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136).", "short_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room.  The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddc.sze.hu/adatvedelmi-tajekoztato/", "developer_terms_of_service_url": null, "publisher_name": "Sz\u00e9chenyi Istv\u00e1n University, Digital Development Center", "support_website_url": null, "website_url": "https://ddc.sze.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31605138639131530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_866315932976280_9126631463882894823_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DEMm-9PUnUQ7kNvwELZolk&_nc_oc=AdqZXoWXNn_4bjYTmqn7FW5T454GLz0cwLUkC-DjgtJx9t9xa4MrneQ7cJZmG-Qne1U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KFt2x3OZC1aNHumgWGQGDMeo99_kty-2mA5neVrJ7Jw&oe=6A0F0F15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VReduMed-VRoomOfHorror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learning", 
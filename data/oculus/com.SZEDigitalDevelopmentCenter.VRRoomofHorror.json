101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh96m1qYdpMQ7kNvwGYfgM2&_nc_oc=AdpZVMem0Yz5pswo6Mv3bbFR9x_eHe6mLn_uCQwb4fMwnj_iEKCgsQ3hb7V2YnOfauM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsEjl8xovA8cmU8J50lPSzUblybXnjOv1Ziw9YAPJeuw&oe=6A7DBE2D"}, {"file_name": "K\u00e9perny\u0151k\u00e9p 2026-01-22 095541.png", "id": "1217861333816435", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/507829689_1217861337149768_3323518517693218239_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyayhMsMbBYQ7kNvwHcHpSQ&_nc_oc=AdonFGS-j56b4xFJwWHw-XYjh1tLFUCsoXYDQEvhGUqTAcZExlOeZHqnTkXjSU2NNKs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkSfWmHKK063NyyPf4wxMsU050veIqXBFTDWQqTOrPPw&oe=6A7DAAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "1598192407851308", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820141_1598192411184641_7768509647284292344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs44boMn89IQ7kNvwGxVNh8&_nc_oc=Adoa8NqPv5h4ORTW13VoPDHT3hl75zkQHthPPbWUoESVUwHA5VQtcyFHBD4t6M6CJPo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO__orjlFealL7cub1neBpLAWRSbC4HxZdlwvV4hP_Ww&oe=6A7DA60E"}, "display_name": "VReduMed-VRoomOfHorror", "keywords": [], "long_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room. The system combines a VR application with a PC-based observer client, enabling instructors to supervise or guide students in real time without the need to physically prepare evaluation rooms. The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136).", "short_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room.  The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddc.sze.hu/adatvedelmi-tajekoztato/", "developer_terms_of_service_url": null, "publisher_name": "Sz\u00e9chenyi Istv\u00e1n University, Digital Development Center", "support_website_url": null, "website_url": "https://ddc.sze.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31605138639131530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823837_866315932976280_9126631463882894823_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zS9XVFWwo8Q7kNvwHaTpUA&_nc_oc=AdqyfSudNb56Kb_91BmX0KPd2iGjJuGEpa8fA5oP0LeAl_fQG8dgAwArtqFNLGTdJp4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCwdPX3Z_F_3kB1X1T0UJa3jInSsYi3hpJMg8hW5BDDg&oe=6A7DCD15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VReduMed-VRoomOfHorror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learn
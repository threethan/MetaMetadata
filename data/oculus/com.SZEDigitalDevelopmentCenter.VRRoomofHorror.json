&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8BhJHn9dhUQ7kNvwH4F9ru&_nc_oc=AdrG7jMJ2qYjEijGcrcr5guD0nTxbulhgQIzjLTbrCtMZq9IM3yfsz92Pfl9sldvSdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqJj2RregWUFk70VdzKXO73QrJQ8AOnKUwgwdB5HpBfA&oe=6A8455AD"}, {"file_name": "K\u00e9perny\u0151k\u00e9p 2026-01-22 095541.png", "id": "1217861333816435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507829689_1217861337149768_3323518517693218239_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6pPnZLiIL0Q7kNvwEm6lyz&_nc_oc=Adrrq1ibUhAuBo_wEy7im6tFeGp1vs63J4xf3mFeyefA5kXg9k1XmsXw5IbUlBg7-EM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgIABwbHVs0iGBD65qaEsYEjKGojSzJhqypf9GbD0KrQ&oe=6A84422D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "1598192407851308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_1598192411184641_7768509647284292344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djpVLHtSEMAQ7kNvwGjNLQm&_nc_oc=Adq4x6PTMpzaK01Bz16FEMX8vjLQUwE9KwKmuzPKfMGm5ANDnwjZ3BUaEVtlv6VEFFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ66elVIcNuAYnvvFMWN0vdaLAc48eIo13YMFJ-OAEhA&oe=6A843D8E"}, "display_name": "VReduMed-VRoomOfHorror", "keywords": [], "long_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room. The system combines a VR application with a PC-based observer client, enabling instructors to supervise or guide students in real time without the need to physically prepare evaluation rooms. The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136).", "short_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room.  The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddc.sze.hu/adatvedelmi-tajekoztato/", "developer_terms_of_service_url": null, "publisher_name": "Sz\u00e9chenyi Istv\u00e1n University, Digital Development Center", "support_website_url": null, "website_url": "https://ddc.sze.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31605138639131530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_866315932976280_9126631463882894823_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5xSgx0elkgQ7kNvwEL3eUe&_nc_oc=AdouE6pe3d9apleImm49bAeeabBo9j6fXBVrtgAkyLDK_4aI4KgyZVePLCqeVwyE13s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE81TzGWouGgtEqYJphsWlvbUjh9i2YuXRlz5lvkSwlUg&oe=6A846495"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VReduMed-VRoomOfHorror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learning", 
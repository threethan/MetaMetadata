e_name": "K\u00e9perny\u0151k\u00e9p 2026-01-22 095700.png", "id": "865491472973062", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827703_865491476306395_214174961165670539_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSZi-T2Vq58Q7kNvwHyRGd1&_nc_oc=Adp3JxvqbMfRyT8CzqTysrstjf4dLwvyT6tYf-Lrrq9M0_hgE70MuZTRNEU3rdsm07E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP2kcViMxLRB4Ww44sZ9IHsR4WROktk4SvRK4s_z8Cog&oe=6AFDD7ED"}, {"file_name": "K\u00e9perny\u0151k\u00e9p 2026-01-22 095541.png", "id": "1217861333816435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829689_1217861337149768_3323518517693218239_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3-OzMLK0rgQ7kNvwHwdrYk&_nc_oc=Adp15HyUNaRqEOPnu_LA98skLO705voJP5wqLAHQYWPIgRrXGjqr8JXkjWVBAhql1OQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRde-r_XLqb-BXCtTRGWXZqjHGsEeoerW8EbDlzIWDBA&oe=6AFDC46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "1598192407851308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1598192411184641_7768509647284292344_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLtzXL6VagwQ7kNvwHtLo5j&_nc_oc=Adp3dE4EGcE1AVnJ7_OhUlTvjqxIEH9MiBLSm8dRQ3o9bNHnwclL-rzgC7BrqKX24ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0oqxrIVqmxC4Oc_R3Eanw8PRS6pf32awTVRjxglZk4A&oe=6AFDBFCE"}, "display_name": "VReduMed-VRoomOfHorror", "keywords": [], "long_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room. The system combines a VR application with a PC-based observer client, enabling instructors to supervise or guide students in real time without the need to physically prepare evaluation rooms. The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136).", "short_description": "VReduMed-VRoomOfHorror is a virtual reality training application designed to help nursing students and healthcare trainees practice identifying clinical and environmental errors in a simulated patient room.  The application serves as a pilot solution developed within the framework of the Interreg Central Europe project VReduMED (CE0100136)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ddc.sze.hu/adatvedelmi-tajekoztato/", "developer_terms_of_service_url": null, "publisher_name": "Sz\u00e9chenyi Istv\u00e1n University, Digital Development Center", "support_website_url": null, "website_url": "https://ddc.sze.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31605138639131530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_866315932976280_9126631463882894823_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14W9nXBa1soQ7kNvwG3Uy1m&_nc_oc=AdoQMYNfL7BEdq0b-H7ILizUuDPinkLauZyh7rmrYVkHxHf0MtfFi_gRBZ1Lv7IDP3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXHTAR7eFX4-BP4tlu_LRuEKeOlrffbf_4XW7XU2DmPw&oe=6AFDAE95"}, "
f-2MBXrN4cMjd0SQEC8Q6S8SQQ-TAV532YrwZqmw1q4AA&oe=6A43D207"}, {"file_name": "upscaled_2560x1440.png", "id": "1545928227266889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1545928230600222_4299647387331349190_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_tor2F9BaIQ7kNvwFGm19K&_nc_oc=AdqbBp2p7ceLYLYhuZEnQAQi4tGF_6IlSGF6Oif1zjGlXWNyzXaJoqdUnXryPQUo-TU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-RdF6FNbdtjUtA16N0Ua7dnLBfKW1fMEXDIIvdKujOQ&oe=6A43DB4E"}, {"file_name": "HighresScreenshot00000.png", "id": "1881208279237958", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301236_1881208282571291_7560146938516804686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcR-WFvEaY0Q7kNvwFPDv2Q&_nc_oc=AdpDFg7ecSQk1SxvBI8yGgt7Kc6om6IEXY7LkJqQt9MLgC1mkJR_3ywbH284zoftLo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X4b4s6g1mdF7-UUonjepFqYL-YBZarBk4-vRm3qbL8g&oe=6A43D22A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni First Steps", "keywords": ["virtuix", "omni", "one", "first", "steps"], "long_description": "Take your first steps into full-body VR.\n\nFirst Steps is the guided introduction to Omni One, Virtuix's full-body VR gaming system. Explore beautiful environments as you learn how to walk, turn, and move on Omni One.\n\nDesigned for new users, First Steps provides a simple and enjoyable introduction to full-body VR movement and helps you get comfortable before jumping into your favorite games. Wander through ancient Roman ruins, stroll the streets of a charming Paris neighborhood, and test your confidence crossing a bridge suspended high above a canyon.\n\n**Requires Omni One hardware. First Steps is designed for use with an Omni One system.**", "short_description": "Take your first steps into full-body VR. First Steps is the guided introduction to Omni One, Virtuix's full-body VR gaming system. \n\nLearn how to walk, turn, and move naturally while exploring immersive environments, including ancient Roman ruins, a charming Paris neighborhood, and a bridge suspended high above a canyon. Designed for new users, First Steps helps you build confidence before jumping into supported games.\n\nRequires Omni One hardware."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix Inc", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1155237367675106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_1920426091969220_4138089994049465964_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxNkJdUOim4Q7kNvwHteVse&_nc_oc=Adoo9IIxXDmycz1n7cz2_-mzF7H_63zuL7hbsaeYok8vsbZt_NOOgQNoPVAhJgp1zGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--X-4ShV_MJg-q8Y_nQIuFf-DTXtUINJD85q0rQLxZ_w&oe=6A43D4B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Omni First Steps", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1782218220, "lastRevision": {"nodes": [{"id": "111141045205779
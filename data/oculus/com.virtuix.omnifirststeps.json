": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298398_1005787848516643_3102624636607419002_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpepBb5OH8UQ7kNvwEU0VWv&_nc_oc=AdqxYCrEFRAYSZBaJDzWAk_GEYFNXHyau7WDsDhjW0R11ZHhpriMhp7Uh6AG70q5NYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpvnhDDEbobZugzVQZu0iQSIRwMGIR553rtdMBeJOADw&oe=6A4A6987"}, {"file_name": "upscaled_2560x1440.png", "id": "1545928227266889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1545928230600222_4299647387331349190_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEYuMiEqyVQQ7kNvwEoT-Z-&_nc_oc=AdpRPS2Nt_1k91x5Ds6ESoSg6DzOK0kzosyz8Tf9RWuhxPc8F0rGGSPwrJPoi5JglkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSP3t0LutJwZeYyu2XiZVnqcy_fYXSckH7gT9oExgaoA&oe=6A4A72CE"}, {"file_name": "HighresScreenshot00000.png", "id": "1881208279237958", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301236_1881208282571291_7560146938516804686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCrBD8g1B6IQ7kNvwGFsGJ3&_nc_oc=AdrBCLu3MTG4381VUOswtwQTa7S5iH3EAEBicKElk8L7q7Vei_miG_q_G1yj5oBvFXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuSBN2_gF_lRJTF1jbZePRHQ0HHbDeKkSC5PsKh6qySA&oe=6A4A69AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni First Steps", "keywords": ["virtuix", "omni", "one", "first", "steps"], "long_description": "Take your first steps into full-body VR.\n\nFirst Steps is the guided introduction to Omni One, Virtuix's full-body VR gaming system. Explore beautiful environments as you learn how to walk, turn, and move on Omni One.\n\nDesigned for new users, First Steps provides a simple and enjoyable introduction to full-body VR movement and helps you get comfortable before jumping into your favorite games. Wander through ancient Roman ruins, stroll the streets of a charming Paris neighborhood, and test your confidence crossing a bridge suspended high above a canyon.\n\n**Requires Omni One hardware. First Steps is designed for use with an Omni One system.**", "short_description": "Take your first steps into full-body VR. First Steps is the guided introduction to Omni One, Virtuix's full-body VR gaming system. \n\nLearn how to walk, turn, and move naturally while exploring immersive environments, including ancient Roman ruins, a charming Paris neighborhood, and a bridge suspended high above a canyon. Designed for new users, First Steps helps you build confidence before jumping into supported games.\n\nRequires Omni One hardware."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuix.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuix Inc", "support_website_url": null, "website_url": "https://virtuix.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1155237367675106"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1645678453176436"}]}, "baseline_offer": {"id": "1645678453176436"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782218220, "status": "PUBLISHED", "id": "1645678453176436"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1139700742562102", "version": "1.0.0"}, "id": "1568865205240057", "channel_name": "LIVE"}]}, "is_for_oculu
culuscdn.com&_nc_ss=7f20f&oh=00_AQKLO8S4qdxpFiVsGxtftKxYcBxV5OLbIQHovKzyTYwJlw&oe=6AB7C985"}, {"file_name": "RIST-thumbnails.png", "id": "2160271214432815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619590_2160271217766148_627737671727372564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV2x6wNZ3-YQ7kNvwG8KHhF&_nc_oc=Adr-n2HNIcnyJD68GfvqJs6AC6GPTTUvDVO-GBy4ObOBouww9szJtyxo-Lvcy7LV-_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3oPOGFuotXIgtH8kR2yD41DS-6-dONyGq_PNGnse47g&oe=6AB7CDD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Your Season Your Success", "keywords": [], "long_description": "Your Season Your Success is tailored to sheep farmers, designed to build on-farm resilience during variable seasons.\n\nThis app will improve your business flexibility and resilience and help you understand how certain production management practices can support emissions reduction.\n\nYou can access a variety of interactive virtual reality tools and resources to help you assess your sheep enterprise flexibility and to learn key strategies and tactics to enable your business to be prepared, productive and profitable during times of seasonal uncertainty.", "short_description": "Building on-farm resilience during variable seasons"}]}, "developer_name": "Start Beyond", "developer_privacy_policy_url": "https://www.startbeyond.co/ysys-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RIST", "support_website_url": null, "website_url": "https://b.oncio.co/live/ysys/YSYSSupport.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
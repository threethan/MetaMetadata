_712044431413192_8843400854754358894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSnyKAH0ITYQ7kNvwFrZDo_&_nc_oc=AdpG_n5BCf5ClJTO4xABmg5brtHPVExt4x51ZjUjslMzpmXqOKHP3TPjxBsXX3rlYtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nESYiWCp_DtnecNmxqo2IcvN4mbd5m_6c2pdyX0lU4w&oe=69D3A0F1"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250523-164310.png", "id": "1390721145577435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820548_1390721148910768_2645064936084187561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oisSe2MG6bYQ7kNvwF3N-U8&_nc_oc=Ado_9r-HOnXQyvRl2Ln8cf22XIdKSAFeuECmMfYsG6Q93YjjqRuR5rjPX-tgq2Aak_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h_oq-jXPtJT17oKHaTVKnMXguhZcGuUzTbndlORawyA&oe=69D39BF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEV Technician", "keywords": ["HEV", "Immerselearn", "Technician", "VR"], "long_description": "HEV Technician is an immersive VR training simulation designed to enhance technical skills in Hybrid and Plug-in Hybrid Electric Vehicle systems. This interactive app covers essential modules including the design and components of HEV, PHEV, and MHEV, the fundamentals of internal combustion engines, and key components of hybrid systems. It also includes a detailed session on diagnosing faults in CAN-BUS networks. Whether you're a student, technician, or automotive enthusiast, HEV Technician offers realistic, hands-on practice in a safe and engaging environment to build industry-relevant knowledge and confidence.", "short_description": "HEV Technician is a hands-on VR training simulation designed for technicians and engineers to explore and understand the core concepts of Hybrid and Plug-in Hybrid Electric Vehicles. Learn system design, key components, ICE operation, and diagnose CAN-BUS network issues through immersive, interactive modules.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselea
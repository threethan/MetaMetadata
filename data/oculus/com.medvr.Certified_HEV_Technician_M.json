_712044431413192_8843400854754358894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22KMo7NSX6YQ7kNvwF2Wei7&_nc_oc=Adpvp9uLGnAa5Skw_lJ2UpFwNw9p-O2C10N26wcdxXhfX0KjaN58jt7lVHN7wgA4DCc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqKXmbd1Y_54z14dBvKLglu7teMcGZWfIFQdI8Qr0Wrg&oe=69C52071"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250523-164310.png", "id": "1390721145577435", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820548_1390721148910768_2645064936084187561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck8Z2kT7iOAQ7kNvwFZZJxD&_nc_oc=Adq6F3X8xzJVL8qo0qkUvsKyM9PyP80MAx-XqxMsZ3_f4xsBaFbdORfRlYXvgKJ3_QQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0OCFEhwnh3ln6e-o3tRWsqkPp2vWskik9fAY5Z88aEA&oe=69C51B77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEV Technician", "keywords": ["HEV", "Immerselearn", "Technician", "VR"], "long_description": "HEV Technician is an immersive VR training simulation designed to enhance technical skills in Hybrid and Plug-in Hybrid Electric Vehicle systems. This interactive app covers essential modules including the design and components of HEV, PHEV, and MHEV, the fundamentals of internal combustion engines, and key components of hybrid systems. It also includes a detailed session on diagnosing faults in CAN-BUS networks. Whether you're a student, technician, or automotive enthusiast, HEV Technician offers realistic, hands-on practice in a safe and engaging environment to build industry-relevant knowledge and confidence.", "short_description": "HEV Technician is a hands-on VR training simulation designed for technicians and engineers to explore and understand the core concepts of Hybrid and Plug-in Hybrid Electric Vehicles. Learn system design, key components, ICE operation, and diagnose CAN-BUS network issues through immersive, interactive modules.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselea
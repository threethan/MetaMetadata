MnQl4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX9OzzPzeUqKKU1iXGhl0OlxDN3Wo5YUYX-IjEcrZNhQ&oe=6B0706B1"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250523-164310.png", "id": "1390721145577435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820548_1390721148910768_2645064936084187561_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY5LuXuWz8EQ7kNvwFuzxqK&_nc_oc=AdpYpjwJwRwQcZymEqrwj_028FpMKtwbLzbBgP4nNg518BQKwia1T5AxJN_L5x8mqEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuKFDVFctSvSQQbtf9SojuFIIblyFMoqOc8GsinzUZIA&oe=6B0701B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEV Technician", "keywords": ["HEV", "Immerselearn", "Technician", "VR"], "long_description": "HEV Technician is an immersive VR training simulation designed to enhance technical skills in Hybrid and Plug-in Hybrid Electric Vehicle systems. This interactive app covers essential modules including the design and components of HEV, PHEV, and MHEV, the fundamentals of internal combustion engines, and key components of hybrid systems. It also includes a detailed session on diagnosing faults in CAN-BUS networks. Whether you're a student, technician, or automotive enthusiast, HEV Technician offers realistic, hands-on practice in a safe and engaging environment to build industry-relevant knowledge and confidence.", "short_description": "HEV Technician is a hands-on VR training simulation designed for technicians and engineers to explore and understand the core concepts of Hybrid and Plug-in Hybrid Electric Vehicles. Learn system design, key components, ICE operation, and diagnose CAN-BUS network issues through immersive, interactive modules.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https:/
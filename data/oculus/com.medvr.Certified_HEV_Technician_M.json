NvwE7_mAW&_nc_oc=AdolqwY-ZnZWF99NbLuiRjGt7afSSEDHDhGgFgBXe3VzQkXDRxm05u5RvkTdzD8lkuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EC_2SqFPF9Vao6h66XV-8Ce6r633oI4GbfGSab0we-Q&oe=69FC9077"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250603-181151.png", "id": "712044428079859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825091_712044431413192_8843400854754358894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH0CmPIvGH8Q7kNvwEnhxoW&_nc_oc=AdrYB9NMGp1ZDzuWg_daZASgfFy1g13XHJt0s-Y-G0E86BTJCiImH4_KrlscKUw1yfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62LTVmW7PwNp6yOgO9sEbWTeS9pgGKuH-twW8A5NbDiA&oe=69FC7F71"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250523-164310.png", "id": "1390721145577435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820548_1390721148910768_2645064936084187561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxr1zZsSwc0Q7kNvwF54p3Z&_nc_oc=Adp8Y5fWQdaiESW-KcFgsFJT1PgBlPP5FLie5QxSHjKta3B7vyKpRTL5JXALJOr8g1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PYUigi9I2_YP0Kg4xkS0tXllCBJuAZHRwlRDiTXn0KA&oe=69FCB2B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEV Technician", "keywords": ["HEV", "Immerselearn", "Technician", "VR"], "long_description": "HEV Technician is an immersive VR training simulation designed to enhance technical skills in Hybrid and Plug-in Hybrid Electric Vehicle systems. This interactive app covers essential modules including the design and components of HEV, PHEV, and MHEV, the fundamentals of internal combustion engines, and key components of hybrid systems. It also includes a detailed session on diagnosing faults in CAN-BUS networks. Whether you're a student, technician, or automotive enthusiast, HEV Technician offers realistic, hands-on practice in a safe and engaging environment to build industry-relevant knowledge and confidence.", "short_description": "HEV Technician is a hands-on VR training simulation designed for technicians and engineers to explore and understand the core concepts of Hybrid and Plug-in Hybrid Electric Vehicles. Learn system design, key components, ICE operation, and diagnose CAN-BUS network issues through immersive, interactive modules.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9849575771828640"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1403241097654773"}, {"status": "PUBLISHED", "id": "730075636146802"}]}, "baseline_offer": {"id": "1403241097654773"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749474360, "status": "PUBLISHED", "id": "1403241097654773"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24915601478132823", "version": "3.6"}, "id": "715567794746642", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9849575755161975", "is_concept": fals
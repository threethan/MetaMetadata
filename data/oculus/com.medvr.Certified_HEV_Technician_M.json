cdn.com/v/t64.5771-25/491820058_1395198561622801_8172657820895970168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT4p-luKQFcQ7kNvwF_ueJ8&_nc_oc=AdqMGPWub6Gt5Yo8evmSooqwOYRmDNB1wZqlNCaEOnZEfrxI3lIaF048wBO5xcLZK1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1YqYXCHInbU2CdXfsHh-NTARehqRRzU4B0wEv7Q4Nlg&oe=6A490777"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250603-181151.png", "id": "712044428079859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825091_712044431413192_8843400854754358894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqeDB689nb0Q7kNvwF300vG&_nc_oc=AdrcZGgVSEex6NP9rfqYYX3YoxuFZ5KjkYvQcUHctaQxq8qTmmmXZP17KmTi92gOa4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlLdgJnW5zf_esmaP27_esafIqW-FH0Sym8gbZCr6zkQ&oe=6A492EB1"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250523-164310.png", "id": "1390721145577435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820548_1390721148910768_2645064936084187561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgdrztSn8lQQ7kNvwH0Chkk&_nc_oc=AdpuylOuwGbJGPZNo7RPi2GLd0QdCeuk3kKuneVA5vANWtVidXcyfTr31uwTsQIc_JM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByTBKoW-ldhbLoo0Zn4VTRKQiQ-KWHtdw1S3Q2b20VzQ&oe=6A4929B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEV Technician", "keywords": ["HEV", "Immerselearn", "Technician", "VR"], "long_description": "HEV Technician is an immersive VR training simulation designed to enhance technical skills in Hybrid and Plug-in Hybrid Electric Vehicle systems. This interactive app covers essential modules including the design and components of HEV, PHEV, and MHEV, the fundamentals of internal combustion engines, and key components of hybrid systems. It also includes a detailed session on diagnosing faults in CAN-BUS networks. Whether you're a student, technician, or automotive enthusiast, HEV Technician offers realistic, hands-on practi
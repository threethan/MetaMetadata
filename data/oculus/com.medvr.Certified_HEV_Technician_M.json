ent-ams2-1.oculuscdn.com/v/t64.5771-25/491824045_1218950766267889_7451935666593395091_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkrZ8ucb-wcQ7kNvwH9XMyU&_nc_oc=Adp50CvdPbTSSrcQhE_hEotmjZb23zkPuoNZcpw-YmsEjVb4yMSRt27fCtih3bBR5lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rfTF5DY-Rf1I4Heu1FAGcZ7Fd4RPXhw066Rk2_HyYSA&oe=6A0B0A31"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250603-180858.png", "id": "1395198558289468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1395198561622801_8172657820895970168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpkINlaS6YMQ7kNvwGCVEx4&_nc_oc=Adry0_OEUYLZD_WDWA0pt6momQaraaTy0AXWwVvOWRmCIrw-OZVBpVwqPdLHKa4cTME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OLry4jlGh6wMXkdsK1UhOTZB76gCiaJVvrMQhw-Ekig&oe=6A0B10F7"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250603-181151.png", "id": "712044428079859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825091_712044431413192_8843400854754358894_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzhwCGj6NWkQ7kNvwFqS1Zs&_nc_oc=AdqXHMOh0JSIBCp7JhReS5ala2237ynZmKDBU0_spnOXfYo8lJOv-0DTbpXNkc3tiGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oHKKZ_TLJTcUN2MJZ5fGH5XME-D7XkUzegV9-PgaZbw&oe=6A0AFFF1"}, {"file_name": "com.medvr.Certified_HEV_Technician-20250523-164310.png", "id": "1390721145577435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820548_1390721148910768_2645064936084187561_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnenrxaTQwQ7kNvwEKlBkU&_nc_oc=AdpWQs66Tq7Kvw8W3Kxd9u_FvcZjKJY2CjtdWeoq6lh-vl8GucFAD-uHVvnmpOJGtN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jm81tcx77WUJLdpY-JTxwbyPckhfxFaGsIb8S7qoXBg&oe=6A0B3337"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HEV Technician", "keywords": ["HEV", "Immerselearn", "Technician", "VR"], "long_description": "HEV Technician is an immersive VR training simulation designed to enhance technical skills in Hybrid and Plug-in Hybrid Electric Vehicle systems. This interactive app covers essential modules including the design and components of HEV, PHEV, and MHEV, the fundamentals of internal combustion engines, and key components of hybrid systems. It also includes a detailed session on diagnosing faults in CAN-BUS networks. Whether you're a student, technician, or automotive enthusiast, HEV Technician offers realistic, hands-on practice in a safe and engaging environment to build industry-relevant knowledge and confidence.", "short_description": "HEV Technician is a hands-on VR training simulation designed for technicians and engineers to explore and understand the core concepts of Hybrid and Plug-in Hybrid Electric Vehicles. Learn system design, key components, ICE operation, and diagnose CAN-BUS network issues through immersive, interactive modules.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerse Learn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9849575771828640"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1403241097654773"}, {"status": "PUBLISHED", "id": "730075636146
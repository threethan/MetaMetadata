e_name": "6836850-Web-Discover-Landing.png", "id": "958678303336870", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618064_958678306670203_6062213190339292748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SJxJ01ZL5AQ7kNvwFBw6LJ&_nc_oc=AdoIlk8LRusrK3Il0_KQHK-3i9LPtqjJNhCOm-DpA9jyaKk6uaeOXamlBIhg4lfnGas&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rgGgYkYr6iAAej3jkfNqIocwwYbXRVb-EqQthLWdpQQ&oe=6A39417D"}, {"file_name": "6836850-W-cDVR-Recordings-Unlimited-Storage.png", "id": "796590540171696", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617729_796590543505029_515123457335106737_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cEzhcH06GMQ7kNvwEyk-yW&_nc_oc=AdpOrKTmDOjbGuhDulY76Zp3RGsd5HghRmF-ActHbGAaUudOdvqcICAah2d01pvJm8k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_07pUzidr3KcOM9WV3SsMa6LxUAAWDmol8of8sms2Ryw&oe=6A392FBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DIRECTV: Live TV & Streaming", "keywords": ["Sports", "Movies", "Shows", "Baseball", "FreeTVChannels"], "long_description": "Bring your TV experience into an immersive space with DIRECTV on Meta Quest. You can stream live TV, sports, news, movies, and On Demand content \u2014 without sitting in front of a traditional TV. Catch sporting events, news, and family-friendly movies on demand.  \n\u2022\tLive sports including MLB\u00ae games, pro basketball, and world-class soccer with FIFA World Cup on Fox, FS1 and Telemundo  \n\u2022\tStream your content whether you have a Genre Pack\u00ae, a full channel lineup, or a MyFree DIRECTV account  which offers 150+ live channels and thousands of hit movies and tv shows on demand\u2014all completely free\n\u2022\tLocal, regional and national news coverage*  \n\u2022\tYour favorite series and movies  \n\u2022\tSpanish language channel lineups  \n  \nNOTE: Availability of programming varies by in-browser access and subscription package / add-ons. US ONLY.  *Some local channels not available in select markets.", "short_description": "Bring your TV experience into an immersive space with DIRECTV available on Meta Quest. You can stream live TV, sports, news, movies, and On Demand content \u2014 without sitting in front of a traditional TV. Catch sporting events, news, and trending favorites for kids and families on demand. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.directv.com/privacy/video-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DIRECTV, LLC", "support_website_url": "http://directv.com/support", "website_url": "http://directv.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "361620458439488"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26369662442674644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499303672_1655446692462052_9147558423220645297_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAePq3ZlUF8Q7kNvwHysrSV&_nc_oc=Adoe5vMiA5YEswiR4MQUKrfWh3n4E1Kc7UULJYVc2SfPxA4jfL0jycacuh4yVfr7whY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OhQca-du2ZThFrZXrrttwfNZmhh9lu44I0oqHuo-3VQ&oe=6A3934DD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DIRECTV
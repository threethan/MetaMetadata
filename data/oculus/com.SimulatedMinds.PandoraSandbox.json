08_resized.png", "id": "558321513415683", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035397_558321516749016_6753816091515147136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2EkqJms_9EQ7kNvwEBkQk2&_nc_oc=AdnpAghIo5xsQ1iO1qYyDd35Q6ZWpZj-fmoytsVBNzblQvd8zzG79Blh7HNu6WHw5ls&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftzaYoNAY1xO7NqBAsPItyl3Jjh52gQo9lA28X3uXmJFw&oe=69A19B6D"}, {"file_name": "HighresScreenshot00043.png", "id": "1146755920477605", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393388_1146755923810938_4851621079172942954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cotN_LoZ7KUQ7kNvwEwbFem&_nc_oc=AdnCgAG8lpqwtV_NLyTnRZ8f37t2tTe5zqp9hDbm_CT-e0_R1tkDyH4Z-yMoSFA5dNM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvYczPz-jnmYqezHf5kjjXZVYYYX9Hq6ieX4HnLGAEbEA&oe=69A18550"}, {"file_name": "HighresScreenshot00000_resized.png", "id": "1026808455889120", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031340_1026808459222453_3107553487636415056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co1Ys7_gLjAQ7kNvwEKNiR7&_nc_oc=AdmSlGnso_HZL-uHW4sums3Pmxd9HR7jW-y95HjSoHITJ9plEhXHih4y6OJipZKCRzI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftx4X5szmT8DbJnZTNalrwb7hnZhydalLRB7FDC2JxtsA&oe=69A1777A"}, {"file_name": "HighresScreenshot00040.png", "id": "627981140167406", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391960_627981143500739_8897692734813935059_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txiHqujGTK0Q7kNvwGTzKc-&_nc_oc=Adkc8aaUyqZn6fOZca6YkIioIxSLuoJuRDdpuy297Z-ctB0UvDsk5ZRvtFISjrEJrp4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftrSU9uhliDGUs3Z0dyUGGm6VYvqSf91piHUWfgV9Psyw&oe=69A19B81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MultiplayerPlasticBattlegrounds_C_Landscape_2560x1440.png", "id": "1383862793440092", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619450_1383862796773425_7012660791558564071_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ6rFQUjKFIQ7kNvwE1sc3Y&_nc_oc=Adm0f4rIuQFQZ7A85Eum3W6zbgCIvarJIYhz_L6jyiWKX4EmzFEtIZqxrIAhvVX1Cmo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvvjoP_ZVA9le2qz2ikaZZ7C6v446f5FkC26wPP_NVLmw&oe=69A190D4"}, "display_name": "Plastic Battlegrounds", "keywords": ["plastic", "battlegrounds", "sandbox", "toys", "armymen"], "long_description": "# Welcome to Plastic Battlegrounds\n\nPlastic Battlegrounds is the newly commissioned sandbox toy-based battle simulator where your plastic soldiers engage in intense set piece battles of your imagination.\n\n{2333459627019818}\n\nSet up the battlefield with an ever growing list of units, vehicles, emplacements, and environment hazards then either join the battle as a plastic soldier or be life sized and tower over the chaos. Drive toy jeeps, crush enemies driving a tank, or pilot drones armed with explosives and machine guns. Discover powerful secret weapons hidden across the levels and find hints of the overarching lore of the toy world. Blow up toy brick fortifications and tear apart your virtual living space in ways you absolutely cannot do in real life!\n\n\n# Sandbox Toy Battles\n\n\nIn Sandbox Mode, setup battles by placing units, setting up spawners, and make  combat scenarios unique to each play session. It's what you could previously only imagine toy soldiers doing, but now they are truly brought into action! Make epic battles with four factions - Green, Tan, Blue, and Grey! Set up props like toy sandbags, tank traps, mines, and barbed wire to make your own battlefields. \n\nTry Conquest mode where you are tasked with holding the majority of capture points to win victory over the enemy team.\n{991644222871582}\n\n\n**This game is very early in development, there is much to be done and the toy war has only begun. Join our Discord community linked in our website to keep up with development news - see you on the battlefield, soldier!**\n\n\n\n\n", "short_description": "Create and participate in the battles of your childhood dreams, watch as the plastic soldiers and toys you place come to life in both creative sandbox and strategic objective based modes. Be life sized, watch the battle from above, and crush the toys with your fists or be a plastic soldier wielding a variety of ballistic or explosive based weapons with powerful vehicles at your disposal and gain the tactical advantage over the enemy toys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.simulated-minds.com/legal/privacy-policy-games", "developer_terms_of_service_url": null, "publisher_name": "Simulated Minds", "support_website_url": null, "website_url": "https://www.simulated-minds.com/plastic-battlegrounds", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "25278617228466156"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619096_4124944574502341_7926472710245185835_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ2sWzKFdRsQ7kNvwF3pVU7&_nc_oc=AdlWnZT5o_BCeXc6PYz9Si3FKZ3oo0DfUsfowPTglut6Z-MKQbemaB9VlyS65gxl3eg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv7KpAt04ddKtGqzhyjyPIlxcrGjxUKIIAqRo-0jFRX9Q&oe=69A1A235"}, "is_concept": false, "is_test": false,
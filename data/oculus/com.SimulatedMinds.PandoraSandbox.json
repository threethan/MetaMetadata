&_nc_ss=7f20f&oh=00_Af50ZKnbK5bC4XskW5vpBtqzcALC2UV4HgWTN80KChx1rA&oe=69FF501F"}, {"file_name": "HighresScreenshot00008_resized.png", "id": "558321513415683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035397_558321516749016_6753816091515147136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRqQO9xbRK8Q7kNvwFPw3Jn&_nc_oc=AdozEbPrbFbe7GAv5QzYgZKOwh91vguwGfxT-bS9muNFSujaMWYkb1_9H47ekM1ovQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TxY98rMVITQwOXUao2MEzVmpq0ai16LQUR2Sa-hzbfw&oe=69FF35ED"}, {"file_name": "HighresScreenshot00043.png", "id": "1146755920477605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393388_1146755923810938_4851621079172942954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-K080yqgHIQ7kNvwGAvmfD&_nc_oc=AdrMHD4kjifWqqbSr7a1SoP-_ugtb7NHdoSTn1pja6ESShVlzXq5WhnAkX8fSo0J6Mc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n-ljrjcVk28lvuboD4_qcp8qQrbDky2PdPPr_9t91CQ&oe=69FF1FD0"}, {"file_name": "HighresScreenshot00000_resized.png", "id": "1026808455889120", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031340_1026808459222453_3107553487636415056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZpum09jA94Q7kNvwH8BsqY&_nc_oc=Adqj0Kwwcy9qFIo9xjbzabrKL1URIN7VxBL6EOCchQ_Zy1dxkMwM56sc8k_ccoXbnos&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46GWfucrf_3y4fZWA4WMdxMMrNToEWhMtRArsCcVGcPg&oe=69FF4A3A"}, {"file_name": "HighresScreenshot00040.png", "id": "627981140167406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391960_627981143500739_8897692734813935059_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBe5rY8H48wQ7kNvwFP9VEU&_nc_oc=AdosSmXxS1pq7S1P2nR5Sjz4bvUIo2k9EWSvrDuktwbbeYgTQAU8OQAJ8ESG3GzP9vU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tFSCmfJr9f2NmTHdraUq8I27l8o0NB0lh8Y30U7NCsg&oe=69FF3601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MultiplayerPlasticBattlegrounds_C_Landscape_2560x1440.png", "id": "1383862793440092", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_1383862796773425_7012660791558564071_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NPkq2ogKyQQ7kNvwHC79r8&_nc_oc=Adp_pYsOGSBsJozebC28MD6M_T4idivxHZZhhmuTTE2hyaWRdG2RRsd8t9NbKxixrgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VVUsHunA3Rh_mLUQ6PmzVsvx124YuuZFNuonQH_bQRQ&oe=69FF2B54"}, "display_name": "Plastic Battlegrounds", "keywords": ["plastic", "battlegrounds", "sandbox", "toys", "armymen"], "long_description": "# Welcome to Plastic Battlegrounds\n\nPlastic Battlegrounds is the newly commissioned sandbox toy-based battle simulator where your plastic soldiers engage in intense set piece battles of your imagination.\n\n{2333459627019818}\n\nSet up the battlefield with an ever growing list of units, vehicles, emplacements, and environment hazards then either join the battle as a plastic soldier or be life sized and tower over the chaos. Drive toy jeeps, crush enemies driving a tank, or pilot drones armed with explosives and machine guns. Discover powerful secret weapons hidden across the levels and find hints of the overarching lore of the toy world. Blow up toy brick fortifications and tear apart your virtual living space in ways you absolutely cannot do in real life!\n\n\n# Sandbox Toy Battles\n\n\nIn Sandbox Mode, setup battles by placing units, setting up spawners, and make  combat scenarios unique to each play session. It's what you could previously only imagine toy soldiers doing, but now they are truly brought into action! Make epic battles with four factions - Green, Tan, Blue, and Grey! Set up props like toy sandbags, tank traps, mines, and barbed wire to make your own battlefields. \n\nTry Conquest mode where you are tasked with holding the majority of capture points to win victory over the enemy team.\n{991644222871582}\n\n\n**This game is very early in development, there is much to be done and the toy war has only begun. Join our Discord community linked in our website to keep up with development news - see you on the battlefield, soldier!**\n\n\n\n\n", "short_description": "Create and participate in the battles of your childhood dreams, watch as the plastic soldiers and toys you place come to life in both creative sandbox and strategic objective based modes. Be life sized, watch the battle from above, and crush the toys with your fists or be a plastic soldier wielding a variety of ballistic or explosive based weapons with powerful vehicles at your disposal and gain the tactical advantage over the enemy toys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.simulated-minds.com/legal/privacy-policy-games", "developer_terms_of_service_url": null, "publisher_name": "Simulated Minds", "support_website_url": null, "website_url": "https://www.simulated-minds.com/plastic-battlegrounds", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "25278617228466156"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_4124944574502341_7926472710245185835_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxkSLlCNsFkQ7kNvwFmI2rJ&_nc_oc=AdpDIFPWqcG-gOK_N10x_Jfg7rjZgi2rGFx0ml
_resized.png", "id": "558321513415683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035397_558321516749016_6753816091515147136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2EkqJms_9EQ7kNvwGGbHgW&_nc_oc=AdlC7WZFzVIr-WiE9ZRXkf03L4WcT5Sly5tOVG29tMGu-Y0q_BQZR9XyVDcqFh9Pvkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvFflz9z1ubjIoX7TDLhDf_QvVtj6tc9VDFG3UegLqT6Q&oe=69A43E6D"}, {"file_name": "HighresScreenshot00043.png", "id": "1146755920477605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393388_1146755923810938_4851621079172942954_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEOIo3hTxpwQ7kNvwGSNEXc&_nc_oc=AdlnyNxXQxlzkWSNAsuWHzm5VEyKLfU6YI844j8oqx0d4DAz2C95PB83zYpnuJsqyXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfveEczSsjvvWgMdA-IYKKbIlMNkj1egOBbfNGnPiaXCXw&oe=69A42850"}, {"file_name": "HighresScreenshot00000_resized.png", "id": "1026808455889120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031340_1026808459222453_3107553487636415056_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpSPitJ9zEUQ7kNvwHbrlX2&_nc_oc=AdmDcTEJvBcoQDUc15yZK732w3RgqLpvJ9BuabakIhjElfHHmTfvzISZTXWDQABclx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftv18bjQAnN9uVlaK1cx2De-1yU51JEzI-FF14p_eNXWg&oe=69A452BA"}, {"file_name": "HighresScreenshot00040.png", "id": "627981140167406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391960_627981143500739_8897692734813935059_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUEL4affZeYQ7kNvwGT8HcN&_nc_oc=AdnMHc2Mh0ZZvaS4metmvJ8K5mneLC7Tk92P-t6RfYOUtIebF8f1JZXDgU1LzOUprOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuLPh_7KiOK8xS3e3-lmPfVuivHWfX4m3DDegPAq12lCg&oe=69A43E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MultiplayerPlasticBattlegrounds_C_Landscape_2560x1440.png", "id": "1383862793440092", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619450_1383862796773425_7012660791558564071_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prEb0nQkQYoQ7kNvwHXiU_l&_nc_oc=AdkSOfh0BsP5dHrAzAUt-lG8THkzhk07s77xxPOYzbYcSd6EInkKzrnGEkY7DhyANVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvye2wxRcbF2y4abSfSBC0Gi8l7069tNmL0r7UNrEVVqQ&oe=69A433D4"}, "display_name": "Plastic Battlegrounds", "keywords": ["plastic", "battlegrounds", "sandbox", "toys", "armymen"], "long_description": "# Welcome to Plastic Battlegrounds\n\nPlastic Battlegrounds is the newly commissioned sandbox toy-based battle simulator where your plastic soldiers engage in intense set piece battles of your imagination.\n\n{2333459627019818}\n\nSet up the battlefield with an ever growing list of units, vehicles, emplacements, and environment hazards then either join the battle as a plastic soldier or be life sized and tower over the chaos. Drive toy jeeps, crush enemies driving a tank, or pilot drones armed with explosives and machine guns. Discover powerful secret weapons hidden across the levels and find hints of the overarching lore of the toy world. Blow up toy brick fortifications and tear apart your virtual living space in ways you absolutely cannot do in real life!\n\n\n# Sandbox Toy Battles\n\n\nIn Sandbox Mode, setup battles by placing units, setting up spawners, and make  combat scenarios unique to each play session. It's what you could previously only imagine toy soldiers doing, but now they are truly brought into action! Make epic battles with four factions - Green, Tan, Blue, and Grey! Set up props like toy sandbags, tank traps, mines, and barbed wire to make your own battlefields. \n\nTry Conquest mode where you are tasked with holding the majority of capture points to win victory over the enemy team.\n{991644222871582}\n\n\n**This game is very early in development, there is much to be done and the toy war has only begun. Join our Discord community linked in our website to keep up with development news - see you on the battlefield, soldier!**\n\n\n\n\n", "short_description": "Create and participate in the battles of your childhood dreams, watch as the plastic soldiers and toys you place come to life in both creative sandbox and strategic objective based modes. Be life sized, watch the battle from above, and crush the toys with your fists or be a plastic soldier wielding a variety of ballistic or explosive based weapons with powerful vehicles at your disposal and gain the tactical advantage over the enemy toys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.simulated-minds.com/legal/privacy-policy-games", "developer_terms_of_service_url": null, "publisher_name": "Simulated Minds", "support_website_url": null, "website_url": "https://www.simulated-minds.com/plastic-battlegrounds", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "25278617228466156"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_4124944574502341_7926472710245185835_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2SS6WVxY5sQ7kNvwFym4ZM&_nc_oc=AdlpORxLGkGncFjCxVBJTrdPuBv7kEfHhtCticjlVj6aT8wijpuu116aYvrOpO_tu1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvjFybFngQ_Dgj1V9aNcFi7lmMlMUekN9Vzmg9z64z8LA&oe=69A44535"}, "is_concept": false, "is_test": false, "
y6J1FQM_VFttFRpew&oe=6B0F0B42"}, {"file_name": "SS1.png", "id": "1494548359402216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620341_1494548362735549_8805069692308516210_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVcC5wBVKjQQ7kNvwHeoD0q&_nc_oc=AdoM1IVmtwEgtdNcM0fYtUboGPTBkY45banvLraKW_z3FZJGN0tdG2-gsnrsKsXAXdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXv_0wbuVg-GR_l0axipkDIobi-MP5uXBxE-MTR2QAXiA&oe=6B0F1334"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Call to Strike VR: Tactical Battle Arena", "keywords": ["Shooter", "Tactical", "Zombies", "Survival", "TeamDeathmatch"], "long_description": "**Call to Strike VR: Tactical Battle Arena** is a fast-paced tactical FPS shooter built around immersive gunplay, varied combat modes and replayable action. Test your aim and reflexes across Campaign missions, Sniper challenges, Zombie Survival and Team Deathmatch, with each mode offering a different style of VR shooting.\n\nChoose from 30+ guns, including pistols, SMGs, assault rifles, shotguns and sniper rifles. Build your loadout, learn each weapon and push your shooting skills through close-quarters firefights, long-range engagements and wave-based survival where every bullet matters.\n\nCampaign missions deliver objective-driven combat against armed enemies. Sniper challenges reward precision and patience. Zombie Survival throws relentless undead waves at you, while Team Deathmatch brings fast squad-style warfare and arena action.\n\nWith responsive controls, tactical combat, weapon variety and multiple ways to play, Call to Strike VR is designed for players who want FPS action, gun handling, survival pressure and intense VR battles in one package. Gear up, steady your aim and enter the fight.", "short_description": "Call to Strike VR is an action-packed tactical FPS shooter built for intense gun combat. Fight through Campaign missions, Sniper challenges, Zombie Survival and Team Deathmatch. Master 30+ guns, sharpen your aim, customize your loadout and survive fast-paced battles where every bullet counts. From close-quarters shooting to long-range warfare, each mode delivers immersive VR action, smart enemies and replayable combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nexriogames/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "NeXRio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/nexriogames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1478425148686406"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1915389383168681"}, {"status": "PUBLISHED", "id": "2195424557850604"}]}, "baseline_offer": {"id": "2195424557850604"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1915389383168681"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1498375946691326", "version": "1.0"}, "id": "1269297755394359", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__
771-25/596168449_1742751826950851_7326202901595391307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ul7Bno-TQQQ7kNvwHPKSdg&_nc_oc=Adoez4Pm3OxNOeYU_Z1LTo7kdkfzSvSIyR-M94HvpNtXJ7NxBBIwgvyQzAtCpB8xxsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3WW60dOtKZN5Wt-CheOgnwHAtLIpitBPrJvfnMbAMqQ&oe=6AE8ABF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AltspaceVR", "keywords": [], "long_description": "AltspaceVR: a social VR app connecting people from all walks of life.\n\nJump right in and make yourself at home. Customize your avatar, find your style, and show up in whatever feels like YOU.\n\nBrowse an ever-expanding library of user-created spaces, visit one of our preset event locations, or even make your own! Drop into games, community meetups, performances, and live events or just come warm up by the digital campfire.\n\nWe provide the tools to help bring your most vivid virtual imaginations to life.\n\nAltspaceVR - putting the YOU back in community. Join in, find your people, and Be There. Together. Again.\n\n**Explore Worlds**\n\nAltspaceVR is made up of different virtual spaces called Worlds. Some are built for conversation and small meetups, while others are designed around games, performances, communities or large events.\n\nYou can move between Worlds, discover new places and join other people already there. We're also working on expanding the tools available to world creators so the range of experiences can grow alongside the community.\n\n**Meet People**\n\nSocial interaction is at the centre of AltspaceVR.\n\nTalk naturally with people around you using spatial voice chat, express yourself through your avatar and meet people through public Worlds, events and communities.\n\nWe're building out the social systems during Early Access, including friends, profiles, groups, messaging and better ways to find people and communities you want to spend time with.\n", "short_description": "AltspaceVR: a social VR app connecting people from all walks of life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1StwiWB6pBf29XTZDxFR7zW-i-dTNUc6y0J83PKKdXgI/edit?pli=1&tab=t.0", "developer_terms_of_service_url": "https://altvr.app/terms", "publisher_name": "SideQuest Ltd.", "support_website_url": null, "website_url": "https://altvr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "2477829826033270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3423498527851554"}]}, "baseline_offer": {"id": "3423498527851554"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792775760, "status": "PUBLISHED", "id": "3423498527851554"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2508233902992862", "version": "0.5"}, "id": "1593378318795686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2432735420542711", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2508233902992862"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "
ent-lga3-3.oculuscdn.com/v/t64.5771-25/604370996_2544881189347215_3276534588084608930_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZPH_406wvMQ7kNvwG7Lo4b&_nc_oc=AdoSk5k9iJ5lcrk_14zf61clztMrki4ugDqXZaOiMxcTo3Wa9gH1KRMezNYLegbn-ks&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTicWT8pB7SvITg92GRnQZ_q6wzs6MIE2JpUfA9ZgxpNg&oe=6AFB1800"}, {"file_name": "New Project (40).png", "id": "1983323475689228", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673716021_1983323485689227_5423900428351850790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj3a7j5rtQcQ7kNvwGXQNNE&_nc_oc=Adon2fEfmc2t84tprhrw-oOJ8gBTXgSzb2P-Y0bQYALnQyVsucExLvvJkef4sXPNI9g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdjh9b2Q93IH9B9veDZb23DSmj-Wg-EUDM6UEeJMCRFw&oe=6AFB350A"}, {"file_name": "New Project (41).png", "id": "1742751823617518", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/596168449_1742751826950851_7326202901595391307_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDU28eX1BAUQ7kNvwHds3Uo&_nc_oc=AdqHYEVcp6rFqU9Gy7p0ygRYEXjFHjycHvN3FB4iBmo8_n0ZxakEu8Zta_LFIalRLbI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFd7qDmJALkfDTd7uczUS-MI8hAd93xFsrxx4p7cBr_Q&oe=6AFB20F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AltspaceVR", "keywords": [], "long_description": "AltspaceVR: a social VR app connecting people from all walks of life.\n\nJump right in and make yourself at home. Customize your avatar, find your style, and show up in whatever feels like YOU.\n\nBrowse an ever-expanding library of user-created spaces, visit one of our preset event locations, or even make your own! Drop into games, community meetups, performances, and live events or just come warm up by the digital campfire.\n\nWe provide the tools to help bring your most vivid virtual imaginations to life.\n\nAltspaceVR - putting the YOU back in community. Join in, find your people, and Be There. Together. Again.\n\n**Explore Worlds**\n\nAltspaceVR is made up of different virtual spaces called Worlds. Some are built for conversation and small meetups, while others are designed around games, performances, communities or large events.\n\nYou can move between Worlds, discover new places and join other people already there. We're also working on expanding the tools available to world creators so the range of experiences can grow alongside the community.\n\n**Meet People**\n\nSocial interaction is at the centre of AltspaceVR.\n\nTalk naturally with people around you using spatial voice chat, express yourself through your avatar and meet people through public Worlds, events and communities.\n\nWe're building out the social systems during Early Access, including friends, profiles, groups, messaging and better ways to find people and communities you want to spend time with.\n", "short_description": "AltspaceVR: a social VR app connecting people from all walks of life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1StwiWB6pBf29XTZDxFR7zW-i-dTNUc6y0J83PKKdXgI/edit?pli=1&tab=t.0", "developer_terms_of_service_url": "https://altvr.app/terms", "publisher_name": "SideQuest Ltd.", "support_website_url": null, "website_url": "https://altvr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_trac
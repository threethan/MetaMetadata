uscdn.com/v/t64.5771-25/806363909_1627896692242228_6771001441908125684_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKK7nhUuIgoQ7kNvwG0UdIi&_nc_oc=AdqP6FmvoHshOBdnb49TsoafWZdRjAMcWMMIbcdK1bJqX6YwlUW6rEQRS1F7bajq7sE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlvqodyxPVKyG58WNs4iVrZrO9xlzDbsPuCUyKbAtQOQ&oe=6B09A627"}, {"file_name": "ScreenShot2.png", "id": "5420940771464968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_5420940774798301_1420681419970297470_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aFGxbLrGUAQ7kNvwGYbwvG&_nc_oc=Adp1pwn0lpdAhyFWq2qOQDqClpMKL2FjGh4_kuAWB8z37U-XOCCO0D7QVQaKlbBatnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg1QI6fziYf3WJsA4PLPLkbVQZjjzGR3bEPLb5RY8SDw&oe=6B09BEA7"}, {"file_name": "ScreenShot4.png", "id": "2544881186013882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_2544881189347215_3276534588084608930_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1743JHU8nUQ7kNvwFGM9eX&_nc_oc=AdqSDhGmQWkZwl49WHFlWe5DZWVoCQeyu-IZzdT86zYUIsCM-3PrxFgtL_RE9brXS0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThjqWzlFyL-vAD_hFFxE-G1O05uF_AK6aXKm5E22LLAQ&oe=6B09D0C0"}, {"file_name": "New Project (40).png", "id": "1983323475689228", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1983323485689227_5423900428351850790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPwLx4Lm4OkQ7kNvwHp0ZwW&_nc_oc=AdrH1PrbtL7SBnSXIxP3lzosdkY9CM7HCm34yJWn2VIbixucoBUuI4oHM5Ia3wqWWAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6T5rULXdErAtoLoNjm1-7XR82bw4TqzjAx45ZezAYTA&oe=6B09B58A"}, {"file_name": "New Project (41).png", "id": "1742751823617518", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596168449_1742751826950851_7326202901595391307_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJJXiz4h9BkQ7kNvwGQxyOB&_nc_oc=AdozLy--Lw5qU1YaN0XGaMMJr6h-X9cuTOWVTHOBumx7Xrd_mz0aeaQfME_zJC_zn7s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5iIsA33OTujp_oz8M5pMrECxV8q2bFVN8ZiuG86hc_Q&oe=6B09A174"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AltspaceVR", "keywords": [], "long_description": "AltspaceVR: a social VR app connecting people from all walks of life.\n\nJump right in and make yourself at home. Customize your avatar, find your style, and show up in whatever feels like YOU.\n\nBrowse an ever-expanding library of user-created spaces, visit one of our preset event locations, or even make your own! Drop into games, community meetups, performances, and live events or just come warm up by the digital campfire.\n\nWe provide the tools to help bring your most vivid virtual imaginations to life.\n\nAltspaceVR - putting the YOU back in community. Join in, find your people, and Be There. Together. Again.\n\n**Explore Worlds**\n\nAltspaceVR is made up of different virtual spaces called Worlds. Some are built for conversation and small meetups, while others are designed around games, performances, communities or large events.\n\nYou can move between Worlds, discover new places and join other people already there. We're also working on expanding the tools available to world creators so the range of experiences can grow alongside the community.\n\n**Meet People**\n\nSocial interaction is at the centre of AltspaceVR.\n\nTalk naturally with people around you using spatial voice chat, express yourself through your avatar and meet people through public Worlds, events and communities.\n\nWe're building out the social systems during Early Access, including friends, profiles, groups, messaging and better ways to find people and communities you want to spend time with.\n", "short_description": "AltspaceVR: a social VR app connecting people from all walks of life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1StwiWB6pBf29XTZDxFR7zW-i-dTNUc6y0J83PKKdXgI/edit?pli=1&tab=t.0", "developer_terms_of_service_url": "https://altvr.app/terms", "publisher_name": "SideQuest Ltd.", "support_website_url": null, "website_url": "https://altvr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "2477829826033270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3423498527851554"}]}, "baseline_offer": {"id": "3423498527851554"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792775760, "status": "PUBLISHED", "id": "3423498527851554"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2533865987096320", "version": "0.6"}, "id": "1593378318795686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2432735420542711", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2533865987096320"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1593378318795686"}]}, "change_log": null, "created_date": 1795114152, "id
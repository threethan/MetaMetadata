culuscdn.com/v/t64.5771-25/499312454_2043305259675609_5071988347736828560_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMLuMzm1uWkQ7kNvwF0ttQP&_nc_oc=AdqDFPaEh2Isgi8efFvkRuXLzyfx-C77iT7-DBLcmpC2kohp9p-99gfkF2DHKJ27Lgc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNjDogO6nWJxl7jvsh26X7iR428iaYwPQmusAe9_zaTw&oe=6AFB3D45"}, {"file_name": "l_usa0Ya_ALhSECOpZBu6_V9AFynYL (1).png", "id": "1905789890831772", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313058_1905789894165105_534033338614470192_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfbCcy_oJlkQ7kNvwEJKDbR&_nc_oc=AdpxYgqplpfcWX5rJaya-mjeO3A69qqUXdNDK8q1b_QdI1fhPTf_jJdryfhV0IK-010&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnp3OPk3BhVjBbkvTVpyKCUhx7Nt0nOz1cj9VmPQdDxQ&oe=6AFB3BBB"}, {"file_name": "fc6JNl_ed9PrmiUvwYNOW_KjkVDAyC.png", "id": "1712924737012379", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312338_1712924740345712_7776058857775320262_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lOdNS38GD8Q7kNvwE99scz&_nc_oc=AdopvhbddXSXELI34CR2UFgzO8wkm0noSZggXs-YuGmz7NsUlZ6wpseWoV-d3T6pXyI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5TYxwX_oQop9iFvqNAmq2g42Pg3PsSP_KbpJc4I7t4Q&oe=6AFB1CE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (49).png", "id": "1158497126852875", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/786297305_1158497130186208_5258925737373806618_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1T4Up3CPt4Q7kNvwEn1Ql2&_nc_oc=AdrKXebIwdclDnEVIo4NolSSt0ueqov2Gpn3VLrmMFIB3PzN9HCj-loMCzr4GOAxOw4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI0xsGUD8754NPQqxKMtqjz-PTyYgf8HEooI3gTK8Njw&oe=6AFB2093"}, "display_name": "AltspaceVR", "keywords": [], "long_description": "AltspaceVR: a social VR app connecting people from all walks of life.\n\nJump right in and make yourself at home. Customize your avatar, find your style, and show up in whatever feels like YOU.\n\nBrowse an ever-expanding library of user-created spaces, visit one of our preset event locations, or even make your own! Drop into games, community meetups, performances, and live events or just come warm up by the digital campfire.\n\nWe provide the tools to help bring your most vivid virtual imaginations to life.\n\nAltspaceVR - putting the YOU back in community. Join in, find your people, and Be There. Together. Again.\n\n**Explore Worlds**\n\nAltspaceVR is made up of different virtual spaces called Worlds. Some are built for conversation and small meetups, while others are designed around games, performances, communities or large events.\n\nYou can move between Worlds, discover new places and join other people already there. We're also working on expanding the tools available to world creators so the range of experiences can grow alongside the community.\n\n**Meet People**\n\nSocial interaction is at the centre of AltspaceVR.\n\nTalk naturally with people around you using spatial voice chat, express yourself through your avatar and meet people through public Worlds, events and communities.\n\nWe're building out the social systems during Early Access, including friends, profiles, groups, messaging and better ways to find people and communities you want to spend time with.\n", "short_description": "AltspaceVR: a social VR app connecting people from all walks of life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1StwiWB6pBf29XTZDxFR7zW-i-dTNUc6y0J83PKKdXgI/edit?pli=1&tab=t.0", "developer_terms_of_service_url": "https://altvr.app/terms", "publisher_name": "SideQuest Ltd.", "support_website_url": null, "website_url": "https://altvr.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category":
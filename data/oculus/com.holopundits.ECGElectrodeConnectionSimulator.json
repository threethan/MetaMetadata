055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035445_1150818529495388_2006685117776233217_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjEMzOStquMQ7kNvwHHZ0eu&_nc_oc=AdpU7rW8ITWni07bdcfL7ul1A0zE-iZPLmNXnfyeMhemGCX4FOa-AgDrxB8Vd0UMLoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7UbZlLrJmw4kijY7HJcUoycGRaV_Ltbel4SsrjOmugQ&oe=6B0C6831"}, {"file_name": "ECG Electrode Connection Simulator_Screenshot_06.png", "id": "1486087411975972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031585_1486087415309305_7213549594852165332_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffMGs7FFh4sQ7kNvwGaJ5OT&_nc_oc=Adr2Yw69_PLTRoKE1rdYfhJ3zfrbRfanfisnLipQRlhq3Mr3RshI9U8vP2jFdtbKaBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN0ebqy_U9RRhPkgxDf8Fvv_SUvTr3Dif7yIOmd55XgA&oe=6B0C5CC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "7320587681372580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422379_7320587688039246_9004529337689774178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UwHW-4shGUQ7kNvwHuX24K&_nc_oc=AdqOLPL6idBbN4bieIpyqO9H7FqH27owKT1aIeAmzLtF4skoP84ZM0XAkJ9TdubPGuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5FhAgL0Bak19Wdsnde58p1PA9Jp5oIopdb22x5CSL_A&oe=6B0C72D4"}, "display_name": "ECG Electrode Connection Simulator", "keywords": [], "long_description": "The ECG Electrode Connection Simulator app immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master placing and using a 5-electrode ECG to monitor cardiac activity. This application guides users through the correct placement of electrodes, operation of the ECG machine, and interpretation of the resulting electrocardiogram. \n# Learning Objectives:  \n- Remembering the anatomical landmarks for electrode placement \n- Understanding the principles of ECG and its importance in cardiac monitoring \n- Applying the correct technique for attaching electrodes and operating the ECG machine \n- Analyzing the resulting ECG tracings to identify normal and abnormal patterns \n- Evaluating the quality of the ECG signal and making necessary adjustments \n- Creating a detailed report or care plan based on the ECG findings.  \n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are proficient in the necessary skills required to perform ECG monitoring accurately and effectively in clinical settings. ", "short_description": "Designed to train CNAs in correctly placing and using a 5-electrode ECG to monitor and interpret patients' cardiac activity. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7644457645644102"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1991809657892298"}, {"status": "PUBLISHED", "id": "1153401749309562"}]}, "baseline_offer": {"id": "1991809657892298"}, "is_approved": true, "firstOff
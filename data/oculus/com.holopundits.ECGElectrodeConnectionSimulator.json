ad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqbQ9YQpzqQEtrA-ooZgzkNA5A54PKOHqGn66_HMKCSg&oe=6A5E29F1"}, {"file_name": "ECG Electrode Connection Simulator_Screenshot_06.png", "id": "1486087411975972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031585_1486087415309305_7213549594852165332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgSnqLkym-UQ7kNvwGY1Ofg&_nc_oc=AdoGy_I2NLRtd_ygy5s1LD3H-3bXqO2udD6fcOiB6maU_Nc8iogGY_X1T0EEUtKQLLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRxCPXjD__TxQEP4LKR3yEq6dLUcxJJS-0Gx4JfBWkHQ&oe=6A5E1E89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "7320587681372580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422379_7320587688039246_9004529337689774178_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsQHHBTNWZsQ7kNvwGAZKD-&_nc_oc=Adpc-25rAkhYQAKPFx1SUp7u_nLDtADJNj9xiX8379qGy99gC3MZlh-cpODZvrVdoj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApxUSBzVChAfDENFkdDEiha0OdSGoomCT6qbMznRW-Fw&oe=6A5E3494"}, "display_name": "ECG Electrode Connection Simulator", "keywords": [], "long_description": "The ECG Electrode Connection Simulator app immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master placing and using a 5-electrode ECG to monitor cardiac activity. This application guides users through the correct placement of electrodes, operation of the ECG machine, and interpretation of the resulting electrocardiogram. \n# Learning Objectives:  \n- Remembering the anatomical landmarks for electrode placement \n- Understanding the principles of ECG and its importance in cardiac monitoring \n- Applying the correct technique for attaching electrodes and operating the ECG machine \n- Analyzing the resulting ECG tracings to identify normal and abnormal patterns \n- Evaluating the quality of the ECG signal and making necessary adjustments \n- Creating a detailed report or care plan based on the ECG findings.  \n\nThis comprehensive simulation ensures that certified nursing assistant's or anyone interested in the healthcare field are proficient in the necessary skills required to perform ECG monitoring accurately and effectively in clinical settings. ", "short_description": "Designed to train CNAs in correctly placing and using a 5-electrode ECG to monitor and interpret patients' cardiac activity. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7644457645644102"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1991809657892298"}, {"status": "PUBLISHED", "id": "1153401749309562"}]}, "baseline_offer": {"id": "1991809657892298"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743460, "status": "PUBLISHED", "id": "1991809657892298"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24096682929994980", "version": "2.0"}, "id": "442974695041189", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bina
_sid=6e7a0a&_nc_ohc=Sqe3EvGpxcIQ7kNvwFLUpQR&_nc_oc=AdpNjmiwbtSCalp8w8DVhYVrYKkXfWAP-YKda4XgfTXw29W1bSPi62WzSjnhL6u-P-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP1jyo8w54nXQtuRp5j7Eyw64PBdX79oTsG9Bv_Zrjvw&oe=6AFC5E6B"}, {"file_name": "03_mansion_hall_2560x1440.png", "id": "1103225659092448", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/654859273_1103225662425781_8671618337436213060_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGlgCeLMmwoQ7kNvwHS_UP8&_nc_oc=Ado6YTjGlvFB4OOg9pQyq6VluncW9GQkS0ooRoISUmmhLF06p_JeXOoSorY04XyaKI0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-nZMAjGvjYAlxX5gJNB1VEoyjW83OudhZskRcJPtg_A&oe=6AFC6D77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MBG:VR", "keywords": ["Survival", "vrparkour", "coopadventure", "coop", "farming"], "long_description": "**MBG:VR \u2014 Build, mine, craft, and survive together in VR.** \ud83d\udee0\ufe0f\n\n# Overview\nStep into **MBG:VR**, an imagination\u2011fueled sandbox where every world is yours to bend. Shape insane builds with tactile VR tools, dig for rare resources, and craft gear that changes how you play. Nights get dangerous\u2014fortify, trap, and fight to keep your home standing. There are no rules: create wild builds, pull off daring strategies, and write your own stories.\n\n# Features\n- **Build & Fortify** \u2014 Design bases, towers, and traps with hands\u2011on controls.  \n- **Mine & Craft** \u2014 Harvest materials and upgrade your kit. \u26cf\ufe0f  \n- **Dungeons & Loot** \u2014 Raid hidden caverns for rare rewards.  \n- **PVP & PVE** \u2014 Team up or duel; face AI bosses or other players. \u2694\ufe0f  \n- **Farming & Animals** \u2014 Grow crops, raise livestock, sustain your crew. \ud83d\udc04  \n- **No rules, all imagination** \u2014 Make chaos beautiful and play your way.\n\n**Personalize your avatar with skins, grab your crew, and build something unforgettable.**", "short_description": "MBG:VR drops you into a hands\u2011on sandbox: build and fortify bases, mine for resources \u26cf\ufe0f, and craft gear to survive the night. Team up or duel in PVP and PVE, raid hidden dungeons for secret loot, raise crops and animals \ud83d\udc04, and defend your home when darkness falls. Personalize your avatar with skins and jump into the chaos with friends \u2694\ufe0f."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "iiaiden", "support_website_url": null, "website_url": "HTTPS://Discord.gg/PhEWxR2KRY", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1422524747605027"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646448363_1312113397610495_1016630855698501189_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHTzjBUdqIIQ7kNvwFJbCsN&_nc_oc=AdoCkSUjU216QNNjlYy5lMlL6Tp6A6toXakP7suy_q8hhQ-4DzF_mHxDfhqCSaeV2Ns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAmO9BjLETMIOU92F5hp4dLkYIvsWrLUz42Uje3g-QjQ&oe=6AFC784F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MBG:VR", "platform": "ANDROID_6DOF", 
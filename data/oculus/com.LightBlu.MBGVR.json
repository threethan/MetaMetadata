nc_ohc=8cOiSrUQN1YQ7kNvwFrRdzy&_nc_oc=AdoNpFrs3avY5Afjd-DfqT4c4-HNa7O8hGzEUWgazx-cRUy8NQuKzF5Sqa2_1idlGUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNlXH936lutuudithDO39ZPX9JRsJlWsa7-PwIUA9-rw&oe=6B00722C"}, {"file_name": "01_sky_tower_sunset_2560x1440.png", "id": "957881343812382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646433061_957881347145715_2809084223585320776_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMAuI0WOGDoQ7kNvwGVsS18&_nc_oc=Adr4WDF8IKrczrV9qJo0wC-I7mHBqW4If4yyZaPZMEnSSkWqcpiLU07UZaJneAqQRFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0BelvPgucCZ-n3co4c_dLb9ceHktI5YD4SC5jK2ETCQ&oe=6B00586C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MBG:VR", "keywords": ["survival", "building", "crafting", "sandbox", "multiplayer"], "long_description": "**Climb, mine, build and survive in a free blocky world - with your own two hands, and with your friends.**\n\nGrab a ledge and haul yourself up. Swing your pickaxe into the rock. Draw your bow, raise your shield, carry your blocks and place every one yourself. Or walk with the thumbstick if you prefer - it's your choice.\n\n# What you can do\n\n- **Play together** - explore with friends online, talk with voice chat, and join community servers with their own towns, shops and rules.\n- **Survive the night** - monsters come out after dark, and some of them are a lot bigger than you.\n- **Build anything** - houses, castles, farms and machines, in Survival, Creative or Hardcore.\n- **Go deeper** - lush caves, dripstone caverns, glowing geodes, and the burning Cinderdeep far below.\n- **Make it yours** - tame a wolf or a cat, paint your own skin, or load your favourite texture pack.\n\n# Early Access\n\nMBG:VR is in Early Access, with a new update every few weeks. Join our **Discord** and tell us what you want next.\n{2237530143835431}", "short_description": "Climb, mine and build a blocky world with your own hands. Free to play, with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "iiaiden", "support_website_url": null, "website_url": "HTTPS://Discord.gg/PhEWxR2KRY", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "1502563866267781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295279_1439563874960696_942389172281500478_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45Jl77fMlNIQ7kNvwGctoIf&_nc_oc=AdrnbMKDvzg6VjQxTqqLFASIELdLsti5Of865hHRhpyfJHL9X5usS9UNe1ENbqfgdn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaU-lJvOZpWpAdrBlBc1ZGPKII0raoU8fZUUpZn6vLzQ&oe=6B005C39"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MBG:VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1790308800, "lastRevision": {"nodes": [{"id": "1320773451113491", "
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrGMen3qBqcQ7kNvwFJIXWj&_nc_oc=AdpGn_efMCKqoCVTKDJmFo5XGP3eGDA31Ku8CDHxUXXlk3jwzrNFn_bzFjelDOnjcVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLrfp9ybR5ZrDU8alv33TZ9un7WXHya7EWyR70ZPJdlg&oe=6AFC746B"}, {"file_name": "thumbnail4.png", "id": "1374039437657740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298900_1374039440991073_6620812805871628655_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwfeHPpOXkQQ7kNvwGz8nHD&_nc_oc=AdoeIPuc8XveIay0HWzfdnhZbHPbTJ3x8I6AuW1YpQUoLsvpMHnArnIUegyDx0_Py84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDppaozqkkG97oqP2awHYfsfFDGAppz_TL-iMCRuf44A&oe=6AFC7FE8"}, {"file_name": "thumbnail3.png", "id": "2951448055187482", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499295481_2951448058520815_2250392383395039205_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggsnWedZIBsQ7kNvwEHPS5p&_nc_oc=AdrPCmXXFzRU2yzDnP70jnDGdpaBhenu7eFDa26QD-xthiNC18sNHx1w4QpbhFFX2Zs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP8o2JvSd4BF3HqVlu8zIdp57c8n-OBpG4hzbm1DsnrQ&oe=6AFC7E0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MBG:VR", "keywords": ["Survival", "vrparkour", "coopadventure", "coop", "farming"], "long_description": "**MBG:VR \u2014 Build, mine, craft, and survive together in VR.** \ud83d\udee0\ufe0f\n\n# Overview\nStep into **MBG:VR**, an imagination\u2011fueled sandbox where every world is yours to bend. Shape insane builds with tactile VR tools, dig for rare resources, and craft gear that changes how you play. Nights get dangerous\u2014fortify, trap, and fight to keep your home standing. There are no rules: create wild builds, pull off daring strategies, and write your own stories.\n\n# Features\n- **Build & Fortify** \u2014 Design bases, towers, and traps with hands\u2011on controls.  \n- **Mine & Craft** \u2014 Harvest materials and upgrade your kit. \u26cf\ufe0f  \n- **Dungeons & Loot** \u2014 Raid hidden caverns for rare rewards.  \n- **PVP & PVE** \u2014 Team up or duel; face AI bosses or other players. \u2694\ufe0f  \n- **Farming & Animals** \u2014 Grow crops, raise livestock, sustain your crew. \ud83d\udc04  \n- **No rules, all imagination** \u2014 Make chaos beautiful and play your way.\n\n**Personalize your avatar with skins, grab your crew, and build something unforgettable.**", "short_description": "MBG:VR drops you into a hands\u2011on sandbox: build and fortify bases, mine for resources \u26cf\ufe0f, and craft gear to survive the night. Team up or duel in PVP and PVE, raid hidden dungeons for secret loot, raise crops and animals \ud83d\udc04, and defend your home when darkness falls. Personalize your avatar with skins and jump into the chaos with friends \u2694\ufe0f."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "iiaiden", "support_website_url": null, "website_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1350073561516813"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1561298205764967"}, {"status": "PUBLI
1073_6620812805871628655_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkKeB_ufPcUQ7kNvwHiYR5L&_nc_oc=AdpjPqsYr9PTxzN1atpaLzZITp2SxhtScUy-sfkG4RvrpsjZx_GWUUInOczRGex5rAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQROmcp1Dkm1MFGcfyW1H780Nn076Bj8ZAeS-gl2zeOTg&oe=6B0DA368"}, {"file_name": "thumbnail3.png", "id": "2951448055187482", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295481_2951448058520815_2250392383395039205_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_QqUxpDhrAQ7kNvwHaJ6Oi&_nc_oc=Adpe0aaKkqXUlYSvxI4t-rnic8p_hHKmSf1mnGRIhPuxnaBZKjIJxwXEdR84J0O1e4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgjfTOJzvFe0ecS_fyjG9rAJHEuT4L7EJNkp0xDN1hVg&oe=6B0DA18F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MBG:VR", "keywords": ["Survival", "vrparkour", "coopadventure", "coop", "farming"], "long_description": "**MBG:VR \u2014 Build, mine, craft, and survive together in VR.** \ud83d\udee0\ufe0f\n\n# Overview\nStep into **MBG:VR**, an imagination\u2011fueled sandbox where every world is yours to bend. Shape insane builds with tactile VR tools, dig for rare resources, and craft gear that changes how you play. Nights get dangerous\u2014fortify, trap, and fight to keep your home standing. There are no rules: create wild builds, pull off daring strategies, and write your own stories.\n\n# Features\n- **Build & Fortify** \u2014 Design bases, towers, and traps with hands\u2011on controls.  \n- **Mine & Craft** \u2014 Harvest materials and upgrade your kit. \u26cf\ufe0f  \n- **Dungeons & Loot** \u2014 Raid hidden caverns for rare rewards.  \n- **PVP & PVE** \u2014 Team up or duel; face AI bosses or other players. \u2694\ufe0f  \n- **Farming & Animals** \u2014 Grow crops, raise livestock, sustain your crew. \ud83d\udc04  \n- **No rules, all imagination** \u2014 Make chaos beautiful and play your way.\n\n**Personalize your avatar with skins, grab your crew, and build something unforgettable.**", "short_description": "MBG:VR drops you into a hands\u2011on sandbox: build and fortify bases, mine for resources \u26cf\ufe0f, and craft gear to survive the night. Team up or duel in PVP and PVE, raid hidden dungeons for secret loot, raise crops and animals \ud83d\udc04, and defend your home when darkness falls. Personalize your avatar with skins and jump into the chaos with friends \u2694\ufe0f."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "iiaiden", "support_website_url": null, "website_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1350073561516813"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1561298205764967"}, {"status": "PUBLISHED", "id": "2537499283354400"}]}, "baseline_offer": {"id": "1561298205764967"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791750120, "status": "PUBLISHED", "id": "1561298205764967"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1500178776506290", "version": "0.115.0"}, "id": "1541961740
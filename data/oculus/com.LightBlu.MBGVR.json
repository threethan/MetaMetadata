_lake_2560x1440.png", "id": "2393267358144369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/748811223_2393267361477702_1847889652551551256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLcENN30VL8Q7kNvwEL4Aj_&_nc_oc=AdrBDDP2NoLAIQLSzmk6nJaxvuuQirPS8gslx5rF8nLaHRyjoSYP1CKWgEpBuqRTU-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQR5rhUcDhc3OjjhaeHVfnYPlwWySC20q90-KGm7BTLw&oe=6AF88230"}, {"file_name": "05_ghost_graveyard_2560x1440.png", "id": "1396302862660271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_1396302865993604_4967136115555546812_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh7SKzRMV6MQ7kNvwFOfNvO&_nc_oc=AdpvcfgZvn5HMstj136fzW44-CKNXv1-D4KGmH0GhKdZARWV_uEv6XPp1pZFOJ_scaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60hV0RKnVom8VOjod_hfYwAaUvuPrTf74T576T1TkrA&oe=6AF89A6B"}, {"file_name": "01_mawgrave_lunges_2560x1440.png", "id": "1014411338331451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/754914855_1014411341664784_8838619686456239758_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Egxf-NutWAQ7kNvwEbmcOk&_nc_oc=AdpJheXKbTdghSWgcf454lkqnknEWdPLQs5Te12QXksQ9WChtUCFz8UKYGfRgHINPDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhZk4XkTZtlUFA3GTcz5VS4DmbQfTUlifxRCJEQCmkww&oe=6AF87C5F"}, {"file_name": "02_dodge_the_sweep_2560x1440.png", "id": "1105621498617754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/748811223_1105621501951087_2617644792978090509_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVtQGSafeG8Q7kNvwECOY9q&_nc_oc=AdoiOb6xpBJOQoewUx16Z73kVCccgkKHDMDqstLbt6OkeyQ3dyAIQaq0xXJB2JNpfRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtmUguh7znEk-7grvIpElMcusmqJel_GJgu4G4IwIs9w&oe=6AF8A22B"}, {"file_name": "03_mansion_hall_2560x1440.png", "id": "1103225659092448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654859273_1103225662425781_8671618337436213060_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChKkKPfTR7gQ7kNvwEFaZlx&_nc_oc=Ado23uv37rdwMhMaHaMI7z5TV-FagrIAOwwunBW2l1hMmR0nMRewXW4UKHScJIqfULY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu9q8Qu5FDvDfWPwo83I42VcUHVqb4R_6m1QAPGTSfIg&oe=6AF878F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MBG:VR", "keywords": ["Survival", "vrparkour", "coopadventure", "coop", "farming"], "long_description": "**MBG:VR \u2014 Build, mine, craft, and survive together in VR.** \ud83d\udee0\ufe0f\n\n# Overview\nStep into **MBG:VR**, an imagination\u2011fueled sandbox where every world is yours to bend. Shape insane builds with tactile VR tools, dig for rare resources, and craft gear that changes how you play. Nights get dangerous\u2014fortify, trap, and fight to keep your home standing. There are no rules: create wild builds, pull off daring strategies, and write your own stories.\n\n# Features\n- **Build & Fortify** \u2014 Design bases, towers, and traps with hands\u2011on controls.  \n- **Mine & Craft** \u2014 Harvest materials and upgrade your kit. \u26cf\ufe0f  \n- **Dungeons & Loot** \u2014 Raid hidden caverns for rare rewards.  \n- **PVP & PVE** \u2014 Team up or duel; face AI bosses or other players. \u2694\ufe0f  \n- **Farming & Animals** \u2014 Grow crops, raise livestock, sustain your crew. \ud83d\udc04  \n- **No rules, all imagination** \u2014 Make chaos beautiful and play your way.\n\n**Personalize your avatar with skins, grab your crew, and build something unforgettable.**", "short_description": "MBG:VR drops you into a hands\u2011on sandbox: build and fortify bases, mine for resources \u26cf\ufe0f, and craft gear to survive the night. Team up or duel in PVP and PVE, raid hidden dungeons for secret loot, raise crops and animals \ud83d\udc04, and defend your home when darkness falls. Personalize your avatar with skins and jump into the chaos with friends \u2694\ufe0f."}]}, "developer_name": null, "developer_privacy_policy_url": "http
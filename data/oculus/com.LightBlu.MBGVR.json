nc_ohc=8sDrXR0bvDYQ7kNvwFhnDDu&_nc_oc=AdoBkPBIsUyDujQpSF5eMQbDSccLw8E_JaxbgLy0vNMEAo96QGV5mE5QKyD8q9y5v8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9MuO51hd1F3Km4fOXfqc6-6fxIx9jsckdwhLI0JsGGg&oe=6B05B82C"}, {"file_name": "01_sky_tower_sunset_2560x1440.png", "id": "957881343812382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646433061_957881347145715_2809084223585320776_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFyFuGHidR8Q7kNvwGFfoWM&_nc_oc=AdqpscSGdikDzDBc6tBxxhvYM9HVorAEcWy-g0mD_4_rLMdpFkR_3wQWgwX40TrCEVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbgTZS2qEzuGQPtBkTCbF_OxGrBgzcXLiHtYR4xxb1bA&oe=6B05D6AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MBG:VR", "keywords": ["survival", "building", "crafting", "sandbox", "multiplayer"], "long_description": "**Climb, mine, build and survive in a free blocky world - with your own two hands, and with your friends.**\n\nGrab a ledge and haul yourself up. Swing your pickaxe into the rock. Draw your bow, raise your shield, carry your blocks and place every one yourself. Or walk with the thumbstick if you prefer - it's your choice.\n\n# What you can do\n\n- **Play together** - explore with friends online, talk with voice chat, and join community servers with their own towns, shops and rules.\n- **Survive the night** - monsters come out after dark, and some of them are a lot bigger than you.\n- **Build anything** - houses, castles, farms and machines, in Survival, Creative or Hardcore.\n- **Go deeper** - lush caves, dripstone caverns, glowing geodes, and the burning Cinderdeep far below.\n- **Make it yours** - tame a wolf or a cat, paint your own skin, or load your favourite texture pack.\n\n# Early Access\n\nMBG:VR is in Early Access, with a new update every few weeks. Join our **Discord** and tell us what you want next.\n{2237530143835431}", "short_description": "Climb, mine and build a blocky world with your own hands. Free to play, with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mbgvr/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "iiaiden", "support_website_url": null, "website_url": "HTTPS://Discord.gg/PhEWxR2KRY", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "1502563866267781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295279_1439563874960696_942389172281500478_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEAHE0Wjqa8Q7kNvwFlvM1h&_nc_oc=Adqro40BI1P41-xLd0Ter0YuCUVIqXYg4NctXQZc-7OkEvpZANd2cpGU7QUmDiGNUls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZqh_Ssiw0gcGMURTcfCRYYvzZWYW71_f113JXNR0RJA&oe=6B05A239"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MBG:VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1790308800, "lastRevision": {"nodes": [{"id": "1320773451113491", "
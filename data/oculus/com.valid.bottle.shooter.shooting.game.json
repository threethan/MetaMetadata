iad3-2.oculuscdn.com/v/t64.5771-25/499300897_1117867006924966_4464151437985705967_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdPtBwucQYwQ7kNvwFQRSJp&_nc_oc=AdpoZmnANvpzKKQZXj-TOpGuNiY4ncEBwgIFI-fL4vzFE7i5ymaE0levGKXDWIRckbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqpZW9OFCShHB1sgwTkQ8rI-Iji4wjPWLx_wFxgxR8lg&oe=6A579B5D"}, {"file_name": "4.png", "id": "2074138490000767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499309014_2074138496667433_817761184271074003_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWFGkdMVOGEQ7kNvwGxO2VW&_nc_oc=Adrl0Fq6pHZM-SEuwBWkiHNIjuyf3Fq2dlyQ9D54rAJA9YKF6d6SVOQr6NJ1gD_VEVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwyn2agsQVNB_g9w82n-rUCEof-j7_6LFuHq6mhxL1DQ&oe=6A577FAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Shooter VR \u2013 Shooting Game", "keywords": ["shootingrange", "gunchallenge", "action", "simulation", "vrcombat"], "long_description": "Bottle Shooter VR is a fun and skill-based virtual reality shooting game where precision matters.\n\nStep into immersive shooting environments and take down bottles using realistic controls and smooth VR mechanics. Each shot feels satisfying as bottles shatter with authentic physics and responsive feedback.\n\nDesigned for comfort and performance on Meta Quest, Bottle Shooter VR is perfect for quick sessions, aim practice, and relaxing target shooting without complex mechanics.\n\nWhether you\u2019re improving accuracy or just enjoying casual shooting fun, Bottle Shooter VR delivers an engaging VR experience.\n\nKey Features\n- Realistic bottle shooting mechanics\n- Smooth and comfortable VR controls\n- Satisfying bottle physics and feedback\n- Multiple shooting setups and distances\n- Optimized for Meta Quest performance", "short_description": "Test your aim and reflexes in Bottle Shooter VR. Smash bottles using realistic weapons, smooth VR controls, and satisfying physics in a fun and immersive shooting experience built for Meta Quest."}, {"images": {"nodes": []}, "id": "981651038155649", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Shooter VR \u2013 st\u0159elba na lahve", "keywords": ["vrboj", "st\u0159eleck\u00e1v\u00fdzva", "st\u0159elnice", "akce", "simulace"], "long_description": "Vstupte do Bottle Shooter VR \u2013 Shooting Game a za\u017eijte pohlcuj\u00edc\u00ed st\u0159eleckou akci navr\u017eenou pro Meta Quest. Prozkoum\u00e1vejte r\u016fzn\u00e1 prost\u0159ed\u00ed, p\u0159esn\u011b mi\u0159te a rozb\u00edjejte lahve v nap\u00ednav\u00fdch \u00farovn\u00edch. Ka\u017ed\u00fd v\u00fdst\u0159el p\u016fsob\u00ed realisticky d\u00edky citliv\u00e9mu ovl\u00e1d\u00e1n\u00ed a v\u011brn\u00fdm mechanik\u00e1m.\nZlep\u0161ujte sv\u00e9 dovednosti s plynul\u00fdm ovl\u00e1d\u00e1n\u00edm zbran\u00ed, realistickou fyzikou a rychlou akc\u00ed, kdy je ka\u017ed\u00e1 dal\u0161\u00ed \u00farove\u0148 n\u00e1ro\u010dn\u011bj\u0161\u00ed. Pl\u0148te ar\u00e9nov\u00e9 v\u00fdzvy, objevujte skryt\u00e9 c\u00edle a tr\u00e9nujte sv\u00e9 reflexy v z\u00e1bavn\u00e9m dobrodru\u017estv\u00ed pro jednoho hr\u00e1\u010de inspirovan\u00e9m klasick\u00fdmi ak\u010dn\u00edmi hrami.\nFunkce\n- Realistick\u00e1 VR st\u0159elba s uspokojivou akc\u00ed\n- Plynul\u00e9 ovl\u00e1d\u00e1n\u00ed zbran\u00ed a fyzik\u00e1ln\u00ed interakce\n- V\u00edce prost\u0159ed\u00ed s nap\u00ednav\u00fdmi ar\u00e9nov\u00fdmi v\u00fdzvami\n- Z\u00e1bavn\u00e9 \u00farovn\u011b pro jednoho hr\u00e1\u010de pln\u00e9 akce\nZami\u0159te, soust\u0159e\u010fte se a sta\u0148te se ultim\u00e1tn\u00edm ostrost\u0159elcem. Pokud m\u00e1te r\u00e1di st\u0159eleck\u00e9 hry, akci a pohlcuj\u00edc\u00ed VR z\u00e1\u017eitky, Bottle Shooter VR \u2013 Shooting Game je p\u0159ipravena.\n", "short_description": "Vstupte do realistick\u00e9 st\u0159elnice ve Bottle Shooter VR \u2013 Shooting Game. Otestujte svou mu\u0161ku, rozb\u00edjejte lahve a dokon\u010dujte nap\u00ednav\u00e9 \u00farovn\u011b v r\u016fzn\u00fdch prost\u0159ed\u00edch. U\u017eijte si ak\u010dn\u00ed hratelnost s plynul\u00fdm ovl\u00e1d\u00e1n\u00edm zbran\u00ed, realistickou fyzikou a uspokojivou st\u0159elbou. Z\u00e1bavn\u00e1 hra pro jednoho hr\u00e1\u010de vytvo\u0159en\u00e1 pro VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35384131057868567"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1975724790025459_3699470762077910384_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZnfIOgK92UQ7kNvwHiDrY5&_nc_oc=Adr3jKuS9Nj9L6G8dE4D-SugfTAzb0zZUWkvjN_lJ5-8KOXu8bSbcVJbaQjcpp5Sydk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_JeaQSQGX0uK5sQcICwIZpmOySJF1b9XbiRJgyPTFZg&oe=6A57A281"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bottle Shooter VR \u2013 Shooting Game", "platform": "ANDROID_6DOF", "context_category": {"cont
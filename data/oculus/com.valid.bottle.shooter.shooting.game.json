{"data": {"node": {"__typename": "Application", "id": "32879906881624343", "organization": {"id": "875784642289398", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26284596184538347"}]}, "id": "4227995920849727"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26131362596472316"}]}, "id": "1470273441283671"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25961992680123475"}]}, "id": "894620013345458"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26266739576243485"}]}, "id": "1275260831195141"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32992940870351444"}]}, "id": "2950987335096251"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25171410259210873"}]}, "id": "1558913495251431"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32879906881624343"}]}, "id": "1625321481961619"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25013175685050565"}]}, "id": "1365928914992417"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "32963036933294573"}]}, "id": "845484844895448"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24823524320683584"}]}, "id": "1168208654957526"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25327207263586857"}]}, "id": "3830774870562441"}]}}, "firstRevision": {"nodes": [{"application": {"id": "32879906881624343", "release_date": 1766524140, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32940953482186349"}, "id": "853043580774840"}]}}, "binary": null, "live_binary": null, "created_date": 1778069197, "id": "35359951176953222", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "35384131057868567"}, "release_status": "RELEASED", "id": "32879906881624343"}, "id": "35384131057868567", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "32879906881624343", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1489798752109582"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "26768302669501143", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Shooter VR \u2013 Schietspel", "keywords": ["vrgevecht", "wapenuitdaging", "schietbaan", "actie", "simulatie"], "long_description": "Ga in Bottle Shooter VR \u2013 Shooting Game en beleef meeslepende doelschietactie ontworpen voor Meta Quest. Verken verschillende omgevingen, richt nauwkeurig en schiet flessen kapot in uitdagende levels. Elk schot voelt bevredigend dankzij responsieve besturing en realistische gameplay in deze actievolle VR-ervaring.\nVerbeter je vaardigheden met soepele wapenbesturing, realistische fysica en snelle actie terwijl elk level moeilijker wordt. Voltooi arena-uitdagingen, ontdek verborgen doelen en train je reflexen in een leuke singleplayer-ervaring ge\u00efnspireerd op klassieke actiespellen.\nKenmerken\n- Realistisch VR-schieten met bevredigende gameplay\n- Soepele wapenbesturing en fysica-gebaseerde actie\n- Meerdere omgevingen met leuke arena-uitdagingen\n- Spannende singleplayer-levels om te voltooien en te overleven\nRicht, blijf gefocust en word de ultieme scherpschutter. Als je houdt van schietspellen, actiegames en meeslepende VR-actie, dan staat Bottle Shooter VR \u2013 Shooting Game voor je klaar.", "short_description": "Stap een realistische schietbaan binnen in Bottle Shooter VR \u2013 Shooting Game. Test je nauwkeurigheid, schiet flessen kapot en voltooi spannende levels in meerdere omgevingen. Geniet van actievolle gameplay met soepele wapenbesturing, realistische fysica en bevredigende schietactie. Een leuke singleplayer-schietgame gemaakt voor VR.  "}, {"images": {"nodes": []}, "id": "1784570679188898", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Shooter VR \u2013 Schietspel", "keywords": ["vrgevecht", "wapenuitdaging", "schietbaan", "actie", "simulatie"], "long_description": "Ga in Bottle Shooter VR \u2013 Shooting Game en beleef meeslepende doelschietactie ontworpen voor Meta Quest. Verken verschillende omgevingen, richt nauwkeurig en schiet flessen kapot in uitdagende levels. Elk schot voelt bevredigend dankzij responsieve besturing en realistische gameplay in deze actievolle VR-ervaring.\nVerbeter je vaardigheden met soepele wapenbesturing, realistische fysica en snelle actie terwijl elk level moeilijker wordt. Voltooi arena-uitdagingen, ontdek verborgen doelen en train je reflexen in een leuke singleplayer-ervaring ge\u00efnspireerd op klassieke actiespellen.\nKenmerken\n- Realistisch VR-schieten met bevredigende gameplay\n- Soepele wapenbesturing en fysica-gebaseerde actie\n- Meerdere omgevingen met leuke arena-uitdagingen\n- Spannende singleplayer-levels om te voltooien en te overleven\nRicht, blijf gefocust en word de ultieme scherpschutter. Als je houdt van schietspellen, actiegames en meeslepende VR-actie, dan staat Bottle Shooter VR \u2013 Shooting Game voor je klaar.", "short_description": "Stap een realistische schietbaan binnen in Bottle Shooter VR \u2013 Shooting Game. Test je nauwkeurigheid, schiet flessen kapot en voltooi spannende levels in meerdere omgevingen. Geniet van actievolle gameplay met soepele wapenbesturing, realistische fysica en bevredigende schietactie. Een leuke singleplayer-schietgame gemaakt voor VR.  "}, {"images": {"nodes": []}, "id": "1720279012296710", "locale": "da_DK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Shooter VR \u2013 Skydespil", "keywords": ["vrkamp", "v\u00e5benudfordring", "skydebane", "action", "simulation"], "long_description": "G\u00e5 ind i Bottle Shooter VR \u2013 Shooting Game og oplev medrivende m\u00e5lskydning designet til Meta Quest. Udforsk forskellige milj\u00f8er, sigt pr\u00e6cist, og skyd flasker i sp\u00e6ndende baner. Hvert skud f\u00f8les tilfredsstillende med responsiv styring og realistiske mekanikker i denne actionfyldte VR-oplevelse.\nForbedr dine f\u00e6rdigheder med glat v\u00e5benh\u00e5ndtering, realistisk fysik og hurtig action, hvor hvert niveau bliver mere udfordrende. Gennemf\u00f8r arenaudfordringer, find skjulte m\u00e5l, og tr\u00e6n dine reflekser i et sjovt singleplayer-eventyr inspireret af klassiske actionspil.\nFunktioner\n- Realistisk VR-skydning med tilfredsstillende gameplay\n- Glat v\u00e5benh\u00e5ndtering og fysikbaseret action\n- Flere milj\u00f8er med sjove arenaudfordringer\n- Sp\u00e6ndende singleplayer-baner at gennemf\u00f8re og overleve\nTag sigte, hold fokus, og bliv den ultimative skytte. Hvis du elsker m\u00e5lskydning, actionspil og medrivende VR-skydning, er Bottle Shooter VR \u2013 Shooting Game klar til dig.", "short_description": "Tr\u00e6d ind p\u00e5 en realistisk skydebane i Bottle Shooter VR \u2013 Shooting Game. Test din pr\u00e6cision, knus flasker, og gennemf\u00f8r sp\u00e6ndende baner i flere milj\u00f8er. Nyd actionfyldt gameplay med glat v\u00e5benh\u00e5ndtering, realistisk fysik og tilfredsstillende skydning. Et sjovt singleplayer-skydespil skabt til VR.  "}, {"images": {"nodes": []}, "id": "1510175657210659", "locale": "nl_NL", "screenshots": [], 
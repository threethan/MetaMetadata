4.5771-25/595129854_920034094171398_6070357019784352437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EiyolLwjfQQ7kNvwG36zJ9&_nc_oc=Adp0ZjSo8BsLkelnwzdIkY0Z2GoioTT9hutRtFJQlQP_aK5c-d3CLF2Z0h0d4_C2o3A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv2e0fLaXlzo3LoqW0q-b-4fLqMkm7pDVWL35zad3LOw&oe=6AF9CF44"}, {"file_name": "screenshot_1.png", "id": "1600184848555161", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604317775_1600184858555160_4695577658085862297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA200Vm90RcQ7kNvwGk-mkI&_nc_oc=AdrdUUJQ5K_Q1L0-JpgIwPh3MbUbhwPLKBXACHBqLadqVTZqJqymBcU-FUOw5_tz5Ko&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl4HnwbcMherw5hlSMKL5-3hgjptubBs5F0U18lW1lsQ&oe=6AF9CF50"}, {"file_name": "screenshot_4.png", "id": "1740152520369337", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604317775_1740152523702670_7560358713411533492_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T8NTDu6Ae8Q7kNvwHoGC7V&_nc_oc=Adrk9aiRydXhnsuUKqXwXwrVkm5ppUhsE1Uyj1acXVzy6xCqjGg65B36BgvbmnzBObc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9AUlQyfK8irTgrQXjQYyqm-cpv3c_HOfOWnT_CUzcOg&oe=6AF9DC05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "3015102262177408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604347072_3015102265510741_3978295604783838380_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxRHvhSbX3kQ7kNvwGsLE0J&_nc_oc=AdoCkWd_hRYedsRRkSoQxHsptgCk0lq_XAZnzm5ZZwnOxvLeYEmuUoWfkBmykEJj6Mk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpwgaJcKMKa-mIx1zXThhMF2Eg1dvJkocFiGJihpwvkQ&oe=6AF9B7AB"}, "display_name": "Basketball Pro VR 2", "keywords": ["basketball", "hoops", "arena", "sports", "court"], "long_description": "THE SEQUEL TO BASKETBALL PRO VR.\n\nGame one put you in a gym. This one puts you in an arena.\n\nA regulation maple court sits inside a continuous seating bowl of nearly three thousand individually modelled seats. A four-sided jumbotron hangs over centre court with your score a metre tall on it, an LED ribbon board runs the length of the courtside fascia, and daylight comes down through a glazed roof. Every surface is real PBR material under a full light bake.\n\nFOUR WAYS TO PLAY\n- Free Shoot: no clock, two and three pointers, just you and the rack.\n- 60 Second Challenge: the mode from game one, back and still the best one.\n- Three Point Contest: five racks around the arc, the last ball on each counts double.\n- Around The World: seven spots in order, and your fastest round is kept.\n\nTHE SHOOTING\nNo trigger to release and no aiming line. You pick the ball up, you throw it, and it goes where you threw it. A real size seven with real weight and backspin, rings modelled to the rule book at ten feet, and backboards that behave.\n\nTHE BUILDING\nPress the red button on the ball silo and one rolls out to your feet. Walk down the players' tunnel and look back at the empty house. There is no crowd in the seats, but it sounds like a full one: the room lifts when a shot drops, more for a three, and goes up on the buzzer.\n\nStanding or roomscale. Smooth walking and snap turn. Seven music tracks in the menu.", "short_description": "Walk out of the tunnel onto the floor of a pro basketball arena. A full-size maple court under a centre-hung jumbotron, three thousand seats banded round the bowl, an LED ribbon board down the fascia and a players' tunnel you can walk back down. Take a ball off the rack and shoot: free shoot, the 60 second challenge, a five-rack three point contest, or around the world. Your own arm is the controller, and the building answers every shot that drops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/basketballpro2/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview
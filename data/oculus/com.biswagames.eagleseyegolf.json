oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYfdotNmqyrL5-717-DP6qtofiUSPDRJFnhhv7JJlnLg&oe=6AFDD634"}, {"file_name": "e6.png", "id": "1687317551825540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1687317555158873_34280609032981391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV1RaHh18coQ7kNvwHGo0MJ&_nc_oc=AdqwB2EE8MG2E7po7JiDhEjGSA3f0NMfcx6g_8cc86BLNmq-1mWsaf83GtsbJ5B7q_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1lP1fUDr-NXqRRjh0arE71xRkHwuWaylxJ-__1UK15Q&oe=6AFDBDEC"}, {"file_name": "e3.png", "id": "605804225189650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_605804228522983_4889216185130821978_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkAci1bBIVoQ7kNvwH1FD9p&_nc_oc=Adr9QQOzkC_1iW1GopvALzALsXhi8c1464SVFYRqiZRX_nSxQ499v591EKU8_k9COoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNpKR0Vnks9WactajNVsf4SFmZEKCvxf-56dg9gppjCA&oe=6AFDB556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POSTER_A_New.png", "id": "1491167938229253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230050_1491167941562586_5392299526945980562_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dPavAHvAMMQ7kNvwEziuN8&_nc_oc=AdohjyGJFb8CW-k0qsrKM7rE84GkFEo73DTwgkdAXzxWxuiSLsDZWdIVKXBZGEsa_6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn6IMZMplb_0hMccQIy0ZN2ItSY8rwAnlvVAAqJewPFA&oe=6AFDD8E0"}, "display_name": "Eagle's Eye Golf", "keywords": ["Golf", "immersive", "simulation", "Realistic", "Casual"], "long_description": "**Your Golf Zone**  \n\nStep onto the green and immerse yourself in the ultimate VR golf experience with *Eagle's Eye Golf VR*. Whether you're a seasoned pro or new to the game, enjoy intuitive controls, stunning visuals, and gameplay modes tailored to all skill levels.  \n\n### **Game Features:**  \n- **Practice Mode**: Perfect your shots with unlimited play to refine your skills.  \n- **Casual Mode**: Relax and enjoy a stress-free round of golf at your own pace.  \n- **Time Challenges**: Test your precision and speed as you aim for the best scores under time pressure.  \n- **Interactive Courses**: Explore beautifully designed, immersive VR golf environments that make every round feel unique.  \n- **Realistic Golf Mechanics**: Enjoy authentic ball physics and club interactions for a lifelike golfing experience.  \n\nWhether you're looking to unwind, improve your game, or take on exciting challenges, *Eagle's Eye Golf VR* brings the precision and beauty of golf to life like never before!", "short_description": "Experience the ultimate VR golf game with Eagle's Eye Golf VR. Play at your own pace with Practice and Casual modes, or test your skills in Time Challenges across stunning, interactive courses. Perfect for all skill levels!"}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/eeg/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9866401993374219"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true,
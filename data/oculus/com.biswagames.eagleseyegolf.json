t=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEUitqQhEiSr1pYZHftAhuBHEsC7ib9lyTLp58XhAVIw&oe=6A7DA42C"}, {"file_name": "e3.png", "id": "605804225189650", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974613_605804228522983_4889216185130821978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWm4-8DpPvMQ7kNvwGRWegO&_nc_oc=AdqI0x2L3A7Rw9oEhPOkEYUxkl2hxfI6x6kUYoTi-BpJuXJLQubLbi20rnHA25HX5fY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEctrenIPwIThQ8Xkz5NcY1rvkg9cVZrfU84cV2aC4e-Q&oe=6A7D9B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "POSTER_A_New.png", "id": "1491167938229253", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75230050_1491167941562586_5392299526945980562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwrl_1ul-woQ7kNvwFlcAZa&_nc_oc=AdpiqwAR8CcDzi69OwwU-d3MeEsgRAP9v7XIP9C5yy_COl_3iemGDF4Hw-bToNbLkw0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQtowZBF1bK4C-LUXnS6Y2F4cla4X9wStivWm0aZrtng&oe=6A7DBF20"}, "display_name": "Eagle's Eye Golf", "keywords": ["Golf", "immersive", "simulation", "Realistic", "Casual"], "long_description": "**Your Golf Zone**  \n\nStep onto the green and immerse yourself in the ultimate VR golf experience with *Eagle's Eye Golf VR*. Whether you're a seasoned pro or new to the game, enjoy intuitive controls, stunning visuals, and gameplay modes tailored to all skill levels.  \n\n### **Game Features:**  \n- **Practice Mode**: Perfect your shots with unlimited play to refine your skills.  \n- **Casual Mode**: Relax and enjoy a stress-free round of golf at your own pace.  \n- **Time Challenges**: Test your precision and speed as you aim for the best scores under time pressure.  \n- **Interactive Courses**: Explore beautifully designed, immersive VR golf environments that make every round feel unique.  \n- **Realistic Golf Mechanics**: Enjoy authentic ball physics and club interactions for a lifelike golfing experience.  \n\nWhether you're looking to unwind, improve your game, or take on exciting challenges, *Eagle's Eye Golf VR* brings the precision and beauty of golf to life like never before!", "short_description": "Experience the ultimate VR golf game with Eagle's Eye Golf VR. Play at your own pace with Practice and Casual modes, or test your skills in Time Challenges across stunning, interactive courses. Perfect for all skill levels!"}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/eeg/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9866401993374219"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "972531641763187"}, {"status": "PUBLISHED", "id": "2129499230934362"}, {"status": "PUBLISHED", "id": "1292823355018764"}, {"status": "PUBLISHED", "id": "635141462925944"}, {"status": "PUBLISHED", "id": "1301550444504200"}, {"status": "PUBLISHED", "id": "2705898902946764"}]}, "baseline_offer": {"id": "635141462925944"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "972531641763187"}]}, "liveChannel": {"nodes": [{"latest_supported_binar
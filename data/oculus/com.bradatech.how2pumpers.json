e": "aerial_apparatus_T1.png", "id": "1722302342153037", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604360590_1722302345486370_4085053883149128713_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVz9HHB4VkwQ7kNvwHebvIt&_nc_oc=Ado2kN2a7VW5ywfLXz-fJhKrw5E11mWGYxI01L8B7L3Z36giTP_qN6bH7aASqPJ7IGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrLkGNtABcn15r4saRKBkN2hVY4G7RZaj0e6VwZGKuzw&oe=6AA56F4A"}, {"file_name": "SectionalLadder.png", "id": "1422377123154899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312422_1422377126488232_7323895719488656194_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQ3Zlc0W2lQQ7kNvwH3z4s5&_nc_oc=AdquZKiqZlufJchjJIQ0m-n9tju9eHTsSTwDseDcoOXBl6qGsWUNl2N3jQ2E1mmYANQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJleZUej5XgpiS3SFF636Zyrek_bx2pQ009PMYWIZgKEQ&oe=6AA570BD"}, {"file_name": "AerialPedestalView.png", "id": "2265734234379778", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673573223_2265734237713111_1860954931649624698_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWHBPYBvUmgQ7kNvwHmXSFf&_nc_oc=AdqCsMgB_sFdOoR2TSoshXgvmazKbMhRZSArm1rGrCOd67l7tpb4N5202D2oC0wLZ5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrjHaWc6sWDT4AKrAg3yAWZaDkRcHyCq314PkvS3DW4A&oe=6AA5500E"}, {"file_name": "AerialControls.png", "id": "1961739241177972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830822_1961739244511305_4609855028365327707_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsh5O4o-4U0Q7kNvwF9weyr&_nc_oc=AdqNdcrLttPihJFicOdnJgcHVxwPQCFCmovB_sHvIurq95yCnEC2Yv-9zh0XZiCL7bE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz93B3bdaoXcHxz8PZpTkctcEyaoOMuJWXwrty5v0UuQ&oe=6AA5614E"}, {"file_name": "Suburbs.png", "id": "2563494200503726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569468_2563494203837059_6334065415228405675_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuPLYwNnJJEQ7kNvwGuZdkA&_nc_oc=Adq68q707bmIeKQ9pO9NNRpxdncRqjb5HYKGmhfFdpYOVx7DVIINXlxatVPMMKhjKXE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJulhg16PaBejw5E3EKaGS1_dDCg5d-299kFD0CN21HSg&oe=6AA5761C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aerial_ops_landscape_PDP.png", "id": "1017015874487393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585766981_1017015877820726_3856530020120342612_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW0eyjwRhrIQ7kNvwH0IKXf&_nc_oc=AdqdTOu3PGyL7piCk2pV-0YoqUIsGe2fKNMve0ivDFHflz5vV4rA2Fliz9956IxnQhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5uciipyAqUGNzVXiICZnpJy6XUnhinFtry7uIJ1N1xw&oe=6AA57125"}, "display_name": "How2 Series Pumpers", "keywords": ["fireengine", "firetruck", "firefighting", "simulation", "pumpops"], "long_description": "**How2 Series Pumpers** is the first and only VR simulator built specifically for Meta Quest featuring both **Aerial Ops** with a 100-foot mid-mount platform and advanced pump modeling with fluid dynamics based on real-world fire apparatus.\n\nMaster the aerial pedestal, tackle high-volume rooftop suppression, or coordinate multi-unit water supply in our **Relay Co-op** pumping mode with integrated live voice chat.\n{2112775176164590}\n\n# \ud83d\udd25 Highlights\n\n**Risk-Free Practice:** Master pump ops, aerial setup, outrigger short-jacking, and ladder placement without the risk of live burns or million-dollar apparatus damage.\n\n{2311719076313547}\n\n**Immersive Training:** 360\u00b0 environments, lifelike rigs, cab-to-turntable sequences, and authentic fireground conditions.\n\n**Train Anytime:** Access repeatable, on-demand scenarios from anywhere.\n\n**Save Costs:** Reduce wear-and-tear on expensive rigs while cutting fuel and staffing expenses.\n\n{942517582203426}\n\n**Realism Meets Readiness:** Practice pressure, flow, hydrants, hydraulics, relay pumping, spatial awareness, and aerial master stream operations.\n\n**Boost Engagement:** Interactive sim training and dynamic telemetry enhance learning and retention.\n\nIncludes:\n\n\u2013 **Aerial Ops:** 100-ft platform, pedestal controls, outrigger setup, **TrueClimb\u2122** mechanics, rooftop streams\n\n\u2013 **Pump Ops:** flow, pressure, friction loss, water movement, relay operations\n\n\u2013 **Water Supply:** hydrants, drafting, hose/nozzle selection & line deployment\n\n\u2013 **Mixed Reality (MR) Mode:** train in your own physical space\n\n{1240283337201000}\n\ud83d\ude92 Pumpers for Quest puts the fireground in your headset\u2014no turnout gear required.", "short_description": "Aerial Ops is here! How2 Series Pumpers is the only VR simulator featuring a 100-foot mid-mount aerial platform alongside real-world pump modeling and fluid dynamics based on actual fire apparatus.\n\nMaster discharges, water supply, hose selection, and aerial operations in a safe, immersive environment.\n\nFeatures multi-user Relay Co-op with live voice chat and Mixed Reality (MR) mode to train in your own space. Built for performance and fireground readiness."}]}, "developer_name": "How2 Series", "developer_privacy_policy_url": "https://how2series.ca/privacy-policy/", "developer_terms_of_service_url": "https://how2series.ca/terms-of-use/", "publisher_name": "Bradatech Corp.", "support_website_url": "https://how2series.ca/contact-us/", "website_url": "https://how2series.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUC
XED3m7WhRoQ7kNvwG_c--f&_nc_oc=AdpDQXZxjvF9-VwDbJTAxu9__YuP4b1DuefKWItWCa2bcERu6yJON4mOJ01Y7yPbqmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKooAy2C-nzDhIFojGl7PmHBqF_na9J4BuWLUrI51gFEA&oe=6AA564A6"}, {"file_name": "Screenshot 2024-05-15 153809.png", "id": "352624324494258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_352624331160924_7117313349048322791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh8IB20BBloQ7kNvwHrOsIG&_nc_oc=AdoS3-4mvxeLP6wYfhWmUTSWTtBkbPZtx320KLiJgEm84bEgmEyFCRe_KIka7tsLCF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqf3BRw0JVuiLNgE0wDIkmXi3MEhCjVSdl4G7Ee8bAAA&oe=6AA558B5"}, {"file_name": "Screenshot 2024-05-15 153431.png", "id": "412391581721271", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031354_412391585054604_3175258053311532477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Tvx8WXrhfsQ7kNvwH4NfLB&_nc_oc=Ado0NJXGnYA1huHyBpWtxkmuYlTfmcbpFOUadpfK8BFwOPhVkzN4l_Mt1om5mHC28WE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIplu98JYPvi9Frgdhrdy0HhR4rtInCKJ36I6I5aXP3fA&oe=6AA57653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pumper Main.png", "id": "331885126235421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575357_331885129568754_4083058932275023895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Oh6tb34etcQ7kNvwFzgmHy&_nc_oc=Adpwr7aAPvHkk3wmVc7YwPQOA0jUdPnpR-CXm7E059BWHAPGwUxcN7CmYeeLKsI6ZY4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEbcTUlCeMS-cStVRUIhYQgvvbeDnJomSEJIAdWtc5-w&oe=6AA55D83"}, "display_name": "How2 Series Pumpers", "keywords": [], "long_description": "Our virtual reality training app for pumper operations can significantly enhance the training experience for firefighters, leading to improved performance and safety when responding to real-world emergencies.\n\nBenefits\n\n    Safety: Provides a risk-free environment where firefighters can practice pumper operations without the dangers of real-life emergencies.\n\n    Realistic Scenarios: Firefighters can experience 360-degree views and accurate 3D representations of various scenarios.\n\n    Cost-Effectiveness: More cost-effective than traditional training methods, as it reduces the need for physical resources and can be conducted without the operational costs of actual equipment.\n\n    On-Demand Training: Firefighters can access training anytime and anywhere, allowing for flexible scheduling and repeated practice without the constraints of coordinating with live training events.\n\n    Skill Development: Firefighters develop practical skills, learn to cope with stress, and practice using equipment in a safe environment.\n\n    Engagement and Retention: The immersive nature of our app will lead to higher engagement and better retention of the training material.\n\nPump Operations: Principles of water, hose nozzles and flow rates, simulates pressure, flow and ground hydraulics based on theory. \n\nWater Supply: Principles of water supply including the use of hydrants and drafting operations.  Also includes selection of hose, use of hose appliances, deployment of hose lines, and nozzles.", "short_description": "Our virtual reality training app for pumper operations (Pumpers) can significantly enhance the training experience for firefighters, leading to improved performance and safety when responding to real-world emergencies.\n\nSimulation of operating the fire pump, discharges and static water supply sources.\n\nPrinciples of water supply for fire fighting including the use of hydrants and drafting operations\n\nPrinciples of hose operations for fire fighting including nozzle selection"}]}, "developer_name": "How2 Series", "developer_privacy_policy_url": "https://how2series.ca/privacy-policy/", "developer_terms_of_service_url": "https://how2series.ca/terms-of-use/", "publisher_name": "Bradatech Corp.", "support_website_url": "https://how2series.ca/contact-us/", "website_url": "https://how2series.ca/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7960288183994796"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "329548022890847"}]}, "baseline_offer": {"id": "329548022890847"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715961660, "status": "PUBLISHED", "id": "329548022890847"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28690575763872735", "version": "1.2.2603"}, "id": "1091427765592818", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6349990841691213", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28690575763872735"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788543608, "id": "28731273516469626", "version": "1.2.2603", "version_code": 831, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28731258366471141"}, "asset_files": {"count": 42}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "A
898_5957741325474453349_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUlcvVrhYiUQ7kNvwF4xDlE&_nc_oc=AdoeRmmVrequ40VrR8HxRn65iMIhKDKhcecGsKXLKa0u-hlop4LqB0jU-ijsDTbBFNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBKqb-2SiwZq3Aw269XhCya_blwaGMcBncDjLtwPXd3Q&oe=6AFDC99F"}, {"file_name": "499296201_1006818114775512_1848294806646003899_n.png", "id": "1386262672671073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1386262676004406_5741164533069863332_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d78AavGPAv4Q7kNvwETzMAb&_nc_oc=AdonqujRqew2C8t7rsZ0tm7efzUOpAZ-Svf6OxLraWVpADEGWYo96UOcYq_Nx2KRfXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiU1wg9zmQxHPL6XzHFrVR-ic78LD8ud-GW17Lz6WRDw&oe=6AFDCA7E"}, {"file_name": "499304305_680675258065663_6082252127570210136_n.png", "id": "24509840058613683", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298291_24509840065280349_6985214498661132890_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99Ub-HJHGzgQ7kNvwHuZAkv&_nc_oc=AdoEkY_DTcyCv20q_VentGueeHXpOosXM7mRLTtZ31gGZdY9WCgwUoMSvttZts1qVS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ8wy3A09FcWB12odXahqfwY7QEtGYaGMiP3iYguWAAw&oe=6AFDC606"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Snowy Taggers", "keywords": [], "long_description": "Snowy Taggers is a fan-made VR tag game inspired by the original Gorilla Tag, built for players who love fast-paced movement and fun in virtual snow-covered worlds. Using just your hands\u2014no sticks, no buttons\u2014you\u2019ll run, jump, climb, and slide your way through a frozen map designed for chaotic and exciting tag battles.\n\nWhether you\u2019re dodging a tagger by climbing up icy cliffs or launching yourself between snowy trees, the movement feels smooth, skill-based, and super fun. The snowy environment adds a slippery twist, making every round unpredictable and hilarious.\n\nPlay in public lobbies or with your friends, show off your skills, and become one of the top taggers. Snowy Taggers is all about creativity, speed, and just having a good time in VR. Built with the community in mind, it's perfect for fans of Gorilla Tag who want something fresh and frosty.", "short_description": "Welcome to Snowy Taggers!\n\nJump into this fast-paced VR tag game where you can play, chat, and hang out with other players! Customize your look with awesome cosmetics and show off to your furry friends. Whether you're racing through maps or pulling off wild moves, there's always fun to be had. Step into the action and make every match unforgettable!"}]}, "developer_name": "MNM", "developer_privacy_policy_url": "https://sites.google.com/view/snowy-taggers-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "MNM", "support_website_url": null, "website_url": "https://sites.google.com/view/snowy-taggers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9711774322260369"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2872343099820507"}]}, "baseline_offer": {"id": "2872343099820507"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752086100, "status": "PUBLISHED", "id": "28
-1.oculuscdn.com/v/t64.5771-25/75371507_869641047342702_8926506147708523709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMoYYPK-FYUQ7kNvwHKnFjP&_nc_oc=AdrzHYrqXT376ciFCyplU6yLo4SDe7EzRvsMpngnzNRvu5_QDA_QjgATu_V2t2taOfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqrT7W0353j9giURHixoM6DZIAGXJjsnV5-9n_P5RC1g&oe=6AE21452"}, {"file_name": "DistanceGrab_Interactions.png", "id": "1152693381975879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031619_1152693388642545_4707446576890666511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dZGDrLZB84Q7kNvwEWQRsy&_nc_oc=AdryG--uDBMSSEQq5WfdD_8n7KqDqjGqUiDmwvT2c6Rer9uGrTykNLbjTAZbjC6F5sk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvBV4Q1re5F_r4CNlpGjBX0JBBW3dCyjdP8shFeMUprw&oe=6AE2101D"}, {"file_name": "HandGrabUse_SprayBottle.png", "id": "790969798771574", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476758_790969805438240_384180907024125179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsTUqVCXm0IQ7kNvwFFdyt8&_nc_oc=Adpvo9tB1fMNrsSiRkWlRDGFYMJA8MMZw8N-BRdm-cisjiUPTbEBefRdHCrDomJSsSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPSCbqP3NYdufy072zSxpCCk1i_a3bkWf1FzGr3z_mNQ&oe=6AE1F7FA"}, {"file_name": "HandGrab_Torch.png", "id": "466751461745726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86817056_466751465079059_7395397905970885120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5DtrgZnGxMQ7kNvwGWWIQv&_nc_oc=AdrjPoRkHSbZiQRrAxNvOE2fZ6y1ospwLECYml6aAkhnN1Yx1nC12_d5UOPpNw2i1us&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1m-DbnO1xzI7Vrw5RBOdvoaLFxaQDmO4n-9NscQrQsg&oe=6AE20ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape (2).png", "id": "627544722090317", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036606_627544725423650_8657003459039286021_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxVFtcMtd1MQ7kNvwGuW_Gy&_nc_oc=Adq3APWvdq5KvDYQO-X2_5DhOdNruOigBFpla6dekynNdl3OTLc7Hz0E5Ta0kDE6xhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUc2GNLGSCFcXavt-9r_w84nRgmM38IMIfzf0E9GPCZg&oe=6AE1ED9E"}, "display_name": "Interaction SDK Samples", "keywords": ["Interaction", "SDK", "Grab", "Poke", "Hands"], "long_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here to understand the possibilities of using Interaction SDK in your project and use them as a reference to develop your own experience. Interactions shown in these samples include poke, grab, ray, locomotion, pose recognition, transformers, and gestures.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Interaction SDK documentation on the Horizon OS developer website. ", "short_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package including grabbing, poking, raycasting, locomoting, and more. "}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": "https://communityforums.atmeta.com/t5/Developer-Forums/ct-p/developer", "website_url": "https://developers.meta.com/horizon/documentation/unity/unity-isdk-getting-started/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "inte
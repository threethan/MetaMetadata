-2.oculuscdn.com/v/t64.5771-25/75371507_869641047342702_8926506147708523709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp_QNZOPVS4Q7kNvwFUbVv9&_nc_oc=AdouHilWW_J66laCaEWmLV98PjNZQKnOdnjJQI4oywSWJgx_avR525hr_9fH2k2fMEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOS9ERzWK3_cfBYASyy_WUI9pHZnPxVbrK5WpZshEitQ&oe=6ABBD8D2"}, {"file_name": "DistanceGrab_Interactions.png", "id": "1152693381975879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031619_1152693388642545_4707446576890666511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlTcZxaD_qIQ7kNvwFRXc-u&_nc_oc=AdocBhmAFbbFsVFYDDa7xGuJ24n0o9_75UqNGFPM2cbeOG0oB56Q_XdM-OPRTXAZXlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ515AVV_hcd76G4kHYN_jDlBQ2iTO2wKJ8c6sTvRJ-dA&oe=6ABBD49D"}, {"file_name": "HandGrabUse_SprayBottle.png", "id": "790969798771574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476758_790969805438240_384180907024125179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voexlfLmwTYQ7kNvwF5pH94&_nc_oc=AdoY90f6yhPftRwnm0foAuKT5x4dgJINs8lfiNXHCNV6u6lErrKlbnpHaCdMBeU50G4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhqeGNUs6BFQUQYIA5HBRIsRKykXA01qJSDCX3iPjPYA&oe=6ABBBC7A"}, {"file_name": "HandGrab_Torch.png", "id": "466751461745726", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86817056_466751465079059_7395397905970885120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCnWnI7agx4Q7kNvwHEP6LB&_nc_oc=AdpESUYwfIhRdRV8EPQv3IEPEp82xxecSFMMdGHCEADBsMjy8J5cDJ43fnsNiyZL8ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz3dfTy2Mh4cxY3L9qe78FxlgseJ6FnCHrklMqtp7Lhw&oe=6ABBD34E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape (2).png", "id": "627544722090317", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036606_627544725423650_8657003459039286021_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePlLOc0F4IEQ7kNvwHSD8tL&_nc_oc=AdqeBx9Mn84lFhP-TiZvGon7LA_bHhxoKTavdiWBojEhSD6xR00rIPd3OzS717jlb9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbYf3PvVQx5uNPD47CFvKrjgbTPwqF55on66k_cLJEuA&oe=6ABBB21E"}, "display_name": "Interaction SDK Samples", "keywords": ["Interaction", "SDK", "Grab", "Poke", "Hands"], "long_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here to understand the possibilities of using Interaction SDK in your project and use them as a reference to develop your own experience. Interactions shown in these samples include poke, grab, ray, locomotion, pose recognition, transformers, and gestures.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Interaction SDK documentation on the Horizon OS developer website. ", "short_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package including grabbing, poking, raycasting, locomoting, and more. "}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": "https://communityforums.atmeta.com/t5/Developer-Forums/ct-p/developer", "website_url": "https://developers.meta.com/horizon/documentation/unity/unity-isdk-getting-started/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "inte
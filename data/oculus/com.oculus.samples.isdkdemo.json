omponent and ThrowPhysicsProfile ScriptableObject to enable customizable throwing physics with designer-tunable settings including velocity scaling, spin control, drag, orientation alignment, and built-in flight forces. You now have access to plug-and-play throwing behavior without the need for code changes.\n", "created_date": 1765833062, "id": "25691118413826461", "version": "0.83.0", "version_code": 8300, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5605166159514983", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28797794493158822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "594037768764877"}]}, "change_log": null, "created_date": 1764697120, "id": "25579653948306242", "version": "0.81.0", "version_code": 8100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
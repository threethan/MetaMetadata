-2.oculuscdn.com/v/t64.5771-25/75371507_869641047342702_8926506147708523709_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYZmYBBJoWUQ7kNvwFUhnf-&_nc_oc=AdqCj5TGgioTMrE6hH_PTcOgBvJpEJynU3auwInvkmeMxbrMDQSVQoQLCHz-PdW0z_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNke_10GtibdqiLPWz1ZTgOF39cKv_Lj4EOyoNg4dnvFQ&oe=6AC664D2"}, {"file_name": "DistanceGrab_Interactions.png", "id": "1152693381975879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031619_1152693388642545_4707446576890666511_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR96mGgTrj0Q7kNvwEJktEr&_nc_oc=AdoCe1bL3jfaXMrUmApzRe7AE-L1CVHiacPCsJUW4JQmCNgot1ZbFLdPgzMqptnVPnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhyx1yN7y74GmJf7yj5i9e4QXfLZQoKIqKpnyJHr-8wQ&oe=6AC6609D"}, {"file_name": "HandGrabUse_SprayBottle.png", "id": "790969798771574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476758_790969805438240_384180907024125179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW9CrxD4hxcQ7kNvwH3Brk-&_nc_oc=Ado33avQ8AiB8PxhRGwUfzBxT9EGWgrWXgHarKO56pXlyLzuc-UDHESAvQ9aspC_cgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKegBRExNii5CyHNGmFpu8qLZQMjb8bc9pkx6xv8iC_Q&oe=6AC6487A"}, {"file_name": "HandGrab_Torch.png", "id": "466751461745726", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86817056_466751465079059_7395397905970885120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU0ymu81RqMQ7kNvwEwEDHC&_nc_oc=AdpkS0q4rTG161rY8fb0FGoB7k_74JWrws6pxdsxE_Ums-TvOYGoX-_x4I7L7WoUcns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnP99EKU1jZ8rD3Curjlqfa29wzR4FKkhKqPvABvc2XA&oe=6AC65F4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape (2).png", "id": "627544722090317", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036606_627544725423650_8657003459039286021_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQrs7Na31E0Q7kNvwFBadQq&_nc_oc=Adp40TsyxrfmEEw8vccJ-XN1RCcYYz8ffA8dRtQDgaUJNePsROgq7tcsVoTrCpzXOuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP6Z-jRlrA8nMo0xivWLbCiYo8q7BURZX1UsD73pE6EQ&oe=6AC6765E"}, "display_name": "Interaction SDK Samples", "keywords": ["Interaction", "SDK", "Grab", "Poke", "Hands"], "long_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here to understand the possibilities of using Interaction SDK in your project and use them as a reference to develop your own experience. Interactions shown in these samples include poke, grab, ray, locomotion, pose recognition, transformers, and gestures.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Interaction SDK documentation on the Horizon OS developer website. ", "short_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package including grabbing, poking, raycasting, locomoting, and more. "}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": "https://communityforums.atmeta.com/t5/Developer-Forums/ct-p/developer", "website_url": "https://developers.meta.com/horizon/documentation/unity/unity-isdk-getting-started/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "inte
b=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5U6Ph5dS0wQ7kNvwES7ZC-&_nc_oc=AdosiXF4SJ2AjCQ-4hxnHx5gmzod5_2a1qOz4GPNQUTmjbhjnI_LP1kRPugAyk6KhsM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCPO5drM377g7VsfxeMYkTidqIEaoPL7RhiWACJp_ZNw&oe=69C3D81E"}, "display_name": "Interaction SDK Samples", "keywords": [], "long_description": "The Interaction SDK samples are the official reference for all interactions available in the Presence Platform Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here along with First Hand to understand the possibilities of using Interaction SDK in your project. Consult the samples as a reference as you develop your own experience. Interactions shown in these samples include poke, hand grab, touch grab, ray, distance grab, post recognition, transformers, gestures and use grab.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Overview page. ", "short_description": "The Interaction SDK samples are the official reference for all interactions available in the Presence Platform Interaction SDK package."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465481292257154"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "622164852956754"}]}, "baseline_offer": {"id": "622164852956754"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1663351020, "status": "PUBLISHED", "id": "622164852956754"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25691118413826461", "version": "0.83.0"}, "id": "594037768764877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5605166159514983", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25691118413826461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "594037768764877"}]}, "change_log": "Locomotion\n\nWe added an improved locomotion sample scene that provides examples of implementing new locomotion modes including Climbing, Telepath, and a more physical Walking Stick locomotion. Combined with the existing locomotion modes in Interaction SDK, you now have a broad range of methods for traversing the world to match virtually any style of play.\n\nThrowing\n\nWe also added a comprehensive Throwing sample showcasing the new ThrowTuner component and ThrowPhysicsProfile ScriptableObject to enable customizable throwing physics with designer-tunable settings including velocity scaling, spin control, drag, orientation alignment, and built-in flight forces. You now have access to plug-and-play throwing behavior without the need for code changes.\n", "created_date": 1765833062, "id": "2569111841
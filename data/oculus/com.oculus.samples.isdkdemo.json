eleased_binary": {"__typename": "AndroidBinary", "id": "28797794493158822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789119286, "id": "28641628538775419", "version": "0.205.0", "version_code": 20500, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5605166159514983", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28797794493158822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "594037768764877"}]}, "change_log": "Locomotion\n\nWe added an improved locomotion sample scene that provides examples of implementing new locomotion modes including Climbing, Telepath, and a more physical Walking Stick locomotion. Combined with the existing locomotion modes in Interaction SDK, you now have a broad range of methods for traversing the world to match virtually any style of play.\n\nThrowing\n\nWe also added a comprehensive Throwing sample showcasing the new ThrowTuner component and ThrowPhysicsProfile ScriptableObject to enable customizable throwing physics with designer-tunable settings including velocity scaling, spin control, drag, orientation alignment, and built-in flight forces. You now have access to plug-and-play throwing behavior without the need for code changes.\n", "created_date": 1765833062, "id": "25691118413826461", "version": "0.83.0", "version_code": 8300, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary
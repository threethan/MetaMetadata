AoO1a_LdgXtuOW_UmDAFQek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8jLcD_vjtztITZjaRxwqZWjFTqPh3uipYBwnCf0znDg&oe=69BE921E"}, "display_name": "Interaction SDK Samples", "keywords": [], "long_description": "The Interaction SDK samples are the official reference for all interactions available in the Presence Platform Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here along with First Hand to understand the possibilities of using Interaction SDK in your project. Consult the samples as a reference as you develop your own experience. Interactions shown in these samples include poke, hand grab, touch grab, ray, distance grab, post recognition, transformers, gestures and use grab.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Overview page. ", "short_description": "The Interaction SDK samples are the official reference for all interactions available in the Presence Platform Interaction SDK package."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKIN
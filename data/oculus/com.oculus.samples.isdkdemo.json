verArtLandscape (2).png", "id": "627544722090317", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036606_627544725423650_8657003459039286021_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mn468CQvVUQ7kNvwGbUaRk&_nc_oc=AdoJIKaIlEzS7EsertGPs8DLemrH6gX-L6ZgcX5AeCLkpM00tDnkjynohQHCXUPjxCA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFFip8ehR7WRT1feDeZy2ecvo7ORI3PlaieF3VignSgg&oe=6B0B3C9E"}, "display_name": "Interaction SDK Samples", "keywords": [], "long_description": "The Interaction SDK samples are the official reference for all interactions available in the Presence Platform Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here along with First Hand to understand the possibilities of using Interaction SDK in your project. Consult the samples as a reference as you develop your own experience. Interactions shown in these samples include poke, hand grab, touch grab, ray, distance grab, post recognition, transformers, gestures and use grab.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Overview page. ", "short_description": "The Interaction SDK samples are the official reference for all interactions available in the Presence Platform Interaction SDK package."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscr
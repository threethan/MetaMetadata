mPA8CRI73h2pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxy_a4G36EhVSZDbHYJDlH4ijOrxIhFOYotrWMHtecoaw&oe=69AFFA8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape (2).png", "id": "627544722090317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036606_627544725423650_8657003459039286021_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKAd7-39N5MQ7kNvwGRVqDd&_nc_oc=AdmPNOJ1hTDyhojvnD_0tSDeC1Edjao1-ntnYojlkECS5c5vVuAvHM_y-BTXHrYTBgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaTsCpwRUjpiPbuJndSZVR5nE4A09YFgCfYmUsEYS6Cw&oe=69B0119E"}, "display_name": "Interaction SDK Samples", "keywords": ["Interaction", "SDK", "Grab", "Poke", "Hands"], "long_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here to understand the possibilities of using Interaction SDK in your project and use them as a reference to develop your own experience. Interactions shown in these samples include poke, grab, ray, locomotion, pose recognition, transformers, and gestures.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Interaction SDK documentation on the Horizon OS developer website. ", "short_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package including grabbing, poking, raycasting, locomoting, and more. "}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": "https://communityforums.atmeta.com/t5/Devel
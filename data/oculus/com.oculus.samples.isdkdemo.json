dpjDhy0SBTZeEZnl5XONgll_thMVFpVZ-ZXN6gk6Uc6LgoDXK_rxikuhoi-xMxAFvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK90dr41w0QnzvvFX1_aXBcfm-t_vDm3zA7GFzTUPdU2Q&oe=6AB66C1E"}, "display_name": "Interaction SDK Samples", "keywords": ["Interaction", "SDK", "Grab", "Poke", "Hands"], "long_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package. Interaction SDK is a library of modular, composable interaction components that makes it simpler, faster and easier for developers to build high-quality interactions in virtual or augmented reality. Start here to understand the possibilities of using Interaction SDK in your project and use them as a reference to develop your own experience. Interactions shown in these samples include poke, grab, ray, locomotion, pose recognition, transformers, and gestures.\n\nInterested in using Interaction SDK in your Unity project? You can learn more about Interaction SDK and get started by visiting the Interaction SDK documentation on the Horizon OS developer website. ", "short_description": "The Interaction SDK Samples are the official reference for all interactions available in the Interaction SDK package including grabbing, poking, raycasting, locomoting, and more. "}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": "https://communityforums.atmeta.com/t5/Developer-Forums/ct-p/developer", "website_url": "https://developers.meta.com/horizon/documentation/unity/unity-isdk-getting-started/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "inte
.5771-25/491822553_4060305890886049_9210999616302689961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eawKC8QEbagQ7kNvwEDIjVj&_nc_oc=AdqeWK7tixzRNOcQ0Qf7XYAyLleL83s3Y7bYhx1z5ZPha8xTdERz8LwZu1KWwaLufPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XRE7TEtsqtX-X0RWIcA-oXniCeGh4yFKqSUbnSn1_gw&oe=69DE302B"}, {"file_name": "candle 2560 x 1440 (2).png", "id": "1877742759787943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818885_1877742763121276_9206908695603856954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i5NtOxCPRUQ7kNvwHsZBFE&_nc_oc=AdoyMdVi0EvbcU_Wk1_pOZWoABNMV7QpAq1Pv9GsOInJM-ilEAkTzWG4hgyI-xoDxic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DDQK4jTzwA8OUK6WROxYZf8zThGrMt6fWtp5UXDZ69Q&oe=69DE2AFF"}, {"file_name": "iceland.png", "id": "1977676902777096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302483_1977676906110429_1288334740935581379_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHYc47uVESAQ7kNvwH7K8AM&_nc_oc=Adp_kc0xpL7gLdI9U9rrCIllT4qV5qf6cl3LvyPZM_UY5G21gCITF41H8yKaPGqmk80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wrGF5GWG3JXCqF0tZ0HK_xV26jmvOOa1sZL_7XMgH-A&oe=69DE254A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover-v2.png", "id": "1198881635041207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619681_1198881638374540_3212303079057018365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuER0ULVduUQ7kNvwEz-UrC&_nc_oc=AdoC2aHVHdPjLkusNVAI6EpazZl4wrEdNSouiw1Z508NUG2VV_DuKqdll1RB-dYNjd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eb2LEX4HrqSJPzOUQ8jE7tjbUnFk_c05RwgSll_6TRQ&oe=69DE4CDB"}, "display_name": "Gratitui: Real Beaches & Meditation", "keywords": ["meditation", "beaches", "relaxation", "nature", "mindfulness"], "long_description": "# Experience the Magnificence of the World\u2019s Most Beautiful Beaches\n\nCaptured in stunning high-resolution 360\u00b0, each location surrounds you with the natural rhythm of the shoreline, rolling waves, warm sunlight, and endless horizons. \n\nWhether you are meditating, unwinding after a long day, or simply seeking a peaceful escape, these immersive environments bring the serenity of the world\u2019s most spectacular shorelines directly to you.\n\nResearch consistently shows that virtual nature and being near water has a profound impact on humans. It helps reduce stress, quiet the mind, and restore focus. \n\n\nWith every gentle wave and shifting tide, you\u2019ll feel your tension fade.\n\n\n{2122625038501843}\nYou have to see it to believe it.\n{1257599096476579}\n\nNo subscription required.\n\nCurious about the science behind why the beach calms the nervous system?\nVisit gratitui.com to learn more.\n\nQuestions or comments?\nhello@gratitui.com\n\nEnjoying Gratitui? We invite you to please leave a review on the store page \ud83d\ude4f\n\n\n\n\n{4383886111892018}\n", "short_description": "Experience the Magnificence of the World\u2019s Most Beautiful Beaches\n\nThese are real stunning places on earth, captured in high resolution. \n\nIn just a few minutes feel calmer and less anxious. \n\nHumans evolved to recognize the beach as safe and non-threatening, our very own sanctuaries.\n\nYou have to see it to believe it. \n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.praiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PraiaVR Inc.", "support_website_url": "https://www.praiavr.com/contact", "website_url": "https://www.praiavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
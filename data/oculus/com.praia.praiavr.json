content-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK18gBlatS3PlUqraVP-eXtqyPelQ2ds2D-aqhHGu8mLw&oe=6AB7D45B"}, "display_name": "Gratitui: Real Beaches & Meditation", "keywords": ["beaches", "relaxation", "nature", "mindfulness", "travel"], "long_description": "# Calm Your Nervous System\nAs humans, being at the beach feels good.\n\nThere are good reasons for that. But you don't need to know the science to feel the difference.\n\nJust a few minutes by the ocean can help you slow down, breathe a little deeper, and feel more grounded.\n\nThat's why we created Gratitui.\n\nBeautiful, high-resolution 360\u00b0 beaches you can visit anytime.\n\nPick a beach. Sit on a sundeck. Listen to the waves. Try the music (it's really good). Or settle in with a guided meditation rooted in gratitude.\n\nThat's Gratitui.\n\nThe beach, anytime you need it.\n", "short_description": "Calm Your Nervous System\n\nAs humans, being at the beach feels good.\n\nJust a few minutes by the ocean can help you slow down, breathe a little deeper, and feel more grounded.\n\nThat's why we created Gratitui.\n\nBeautiful, high-resolution 360\u00b0 beaches you can visit anytime.\n\nPick a beach. Sit on a sundeck. Listen to the waves. Try the music (it's really good). Or settle in with a guided meditation rooted in gratitude.\n\nThat's Gratitui.\n\nThe beach, anytime you need it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.praiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PraiaVR Inc.", "support_website_url": "https://www.praiavr.com/contact", "website_url": "https://www.praiavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomme
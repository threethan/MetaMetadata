png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4LyRrrGVNcQ7kNvwHVkjhd&_nc_oc=AdpxN0iTEot4GAK9HSUkdtbgA263AEqOtUxPqkJxZ1XtZSsymSUUJyT26rU8JKBGBV8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kEyrCtxgeMuQm6MokZ4M_F2GY6lGoxY2NGSgTsrgWZw&oe=69DE338F"}, {"file_name": "screen shot 5 2560x1440.png", "id": "1722222284926965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54770914_1722222288260298_4419162366756743151_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LkRpWHTCtAQ7kNvwHgZRbo&_nc_oc=AdoOfmMWA9h-bbI-oF8NPaGMhEG01bIw0rki8huND8qcpNJAtHzTmGobftFbmH0e7xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CMGCMXPABC8C92LRR90wPjOqBX4rYlLAzBoS5ClxrEg&oe=69DE488B"}, {"file_name": "screen shot 6 2560x1440.png", "id": "2676961355796049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035425_2676961359129382_8054731363822254197_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjzCdGSFvbsQ7kNvwHGhZ-i&_nc_oc=Adpnq-UQHBFZin0QcJhJH002lzrCURIlFcg1UeAJFBmiNdtnRJK7VopcU5FaeW-STsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fygywjpSOL0twDEaF4w86oXLrbILUb4wDK9rt8oUAyw&oe=69DE4C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "366515672526467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_366515675859800_5037170625869005808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUnZhngbb3UQ7kNvwGExBBb&_nc_oc=Ado6zH1FJFucnmpWkahY-YtuvhRgE6i-xH7a7JdzYJTHDFaszixf5PAIsUTopBLaebY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-vfIuWMDVJLxp5rn4DxLBxuKgbeT91vjS65M7l91Xzg&oe=69DE4FEC"}, "display_name": "PraiaVR ", "keywords": [], "long_description": "Waiting for a holiday is a thing of the past. Escape to the beach today! Catch your breath, be in the moment and connect with your soul. Never-ending real 360\u02da beaches from around the world with real time audio. Realize the benefits of short powerful gratitude meditations (2-4 minutes). \n\nStaring at the ocean changes our brain waves\u2019 frequency and puts us into a meditative state. Immersive virtual nature reduces anxiety, fatigue, depression and increases relaxation. \n\nThe feeling of gratitude has life-changing benefits. \n\n\u201cIt regulates stress hormones, helps with cognitive restructuring, enhances the production of serotonin and dopamine neurotransmitters, and fires new neural connections to the \u201cbliss\u201d centre of our brain.\u201d (Christina Costa, Psychologist)\n\nWatch a short tutorial inside the app for hand controller direction, only the right controller with two easy functions.\n\nREVIEWS FROM OUR FOCUS GROUPS\n\n\u201cFabulous, love that I am on a beach in some remote parts of the world in seconds. It really feels like I am there. Mindblowing!\u201d -- Dan\n\n\"PraiaVR is a welcome app to provide an \u201cescape\u201d, just beautiful and perfect - the beaches ground me. Love it!!\" \u2014 Lisa\n\n\"The sounds of the sea breaking on the shore made me relax when I thought I was relaxed. Wonderful experience.\" \u2014 Eleanor\n\n\"So very cool - traveling without having to travel.\"  \u2014 Melissa\n\n\"I want to meditate outside but am bothered by bugs, sand, wind ...this is a game changer. Love it.\"\n\n\n\n\n\n\n", "short_description": "Waiting for a holiday is a thing of the past. Escape to the beach today! Catch your breath, be in the moment. Never-ending 360\u02da beaches with real time audio. Realize the benefits of powerful gratitude meditations. \n\nREVIEWS \n\nThis is something I\u2019ve been searching for, finally! 5 stars!\u201d  -- Sandra\n\n\"Very calming, great idea to help meditate.\" \u2014 Cindy\n\n\"Fabulous, love that I am on a beach in some remote parts of the world in seconds. It really feels like I am there. Mindblowing!\" -- Dan\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.praiavr.com/privacy-policy", "developer_terms_of_ser
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq_x_PeQPVDXzXT0t6VvDM0xUbW3wJpC7afjj9RvFAhQ&oe=6A857ECB"}, {"file_name": "screen shot 6 2560x1440.png", "id": "2676961355796049", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035425_2676961359129382_8054731363822254197_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpNG0Sb675sQ7kNvwFR5XLH&_nc_oc=AdokLNRiEt1pNAO4Cdhw99HkgJKHDcJnMcpXhdtBDrWXnfc5-MYVioOx_q6_BOhKc0c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK2kjD0Za9eoUWSPJd-HC8x5PSZXVPYoXCJscEuPRdWQ&oe=6A8582DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "366515672526467", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982688_366515675859800_5037170625869005808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaVZY7T7IW0Q7kNvwFqow3k&_nc_oc=AdpeItwDWDHydtb9xe9PiWoN5diShc7671Vf1kcpxNhwDXyVV2IOThq1HvoLeP-pzN0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXA0gNpntvKc-PyxKa1O_1XlHuJhudIGI3fHOpU3xJOg&oe=6A85862C"}, "display_name": "PraiaVR ", "keywords": [], "long_description": "Waiting for a holiday is a thing of the past. Escape to the beach today! Catch your breath, be in the moment and connect with your soul. Never-ending real 360\u02da beaches from around the world with real time audio. Realize the benefits of short powerful gratitude meditations (2-4 minutes). \n\nStaring at the ocean changes our brain waves\u2019 frequency and puts us into a meditative state. Immersive virtual nature reduces anxiety, fatigue, depression and increases relaxation. \n\nThe feeling of gratitude has life-changing benefits. \n\n\u201cIt regulates stress hormones, helps with cognitive restructuring, enhances the production of serotonin and dopamine neurotransmitters, and fires new neural connections to the \u201cbliss\u201d centre of our brain.\u201d (Christina Costa, Psychologist)\n\nWatch a short tutorial inside the app for hand controller direction, only the right controller with two easy functions.\n\nREVIEWS FROM OUR FOCUS GROUPS\n\n\u201cFabulous, love that I am on a beach in some remote parts of the world in seconds. It really feels like I am there. Mindblowing!\u201d -- Dan\n\n\"PraiaVR is a welcome app to provide an \u201cescape\u201d, just beautiful and perfect - the beaches ground me. Love it!!\" \u2014 Lisa\n\n\"The sounds of the sea breaking on the shore made me relax when I thought I was relaxed. Wonderful experience.\" \u2014 Eleanor\n\n\"So very cool - traveling without having to travel.\"  \u2014 Melissa\n\n\"I want to meditate outside but am bothered by bugs, sand, wind ...this is a game changer. Love it.\"\n\n\n\n\n\n\n", "short_description": "Waiting for a holiday is a thing of the past. Escape to the beach today! Catch your breath, be in the moment. Never-ending 360\u02da beaches with real time audio. Realize the benefits of powerful gratitude meditations. \n\nREVIEWS \n\nThis is something I\u2019ve been searching for, finally! 5 stars!\u201d  -- Sandra\n\n\"Very calming, great idea to help meditate.\" \u2014 Cindy\n\n\"Fabulous, love that I am on a beach in some remote parts of the world in seconds. It really feels like I am there. Mindblowing!\" -- Dan\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.praiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PraiaVR Inc.", "support_website_url": null, "website_url": "https://www.praiavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
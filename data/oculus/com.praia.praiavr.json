d=6e7a0a&_nc_ohc=ayYavNVwSZkQ7kNvwE2xRr6&_nc_oc=AdlqrOcuZ084WMcs_-A803O_nkbafJ__Mj0eGOJozOFylwwcuw8tysR_1QMRoB8EOMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKkmcr-97jJgbDbuta_R2QB2d8Ce4doJh8yiV90ms6Sg&oe=69AC2462"}, {"file_name": "sundeck 2560 x 1440.png", "id": "4060305884219383", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822553_4060305890886049_9210999616302689961_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky-AHdYxoo8Q7kNvwGM6BFC&_nc_oc=AdlmrwjitzFgZymhXVs1cFDVPGZwPdeMvU2BvZdMecXwz9SQfoy4n48wTOP1dYB9pj8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMlNvky7mpOoesn2BbzmlIMq8f0EKXYNn2Q4v7Kw3NNg&oe=69AC172B"}, {"file_name": "candle 2560 x 1440 (2).png", "id": "1877742759787943", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818885_1877742763121276_9206908695603856954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQkEbWeecwMQ7kNvwGYFgrp&_nc_oc=Adlq2bFPyZrkG28csXxOHFmrLcoODWFJ1ZzBCYbiizK6yTbv_maNGSXUf4YcBLNJGSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztlIFaRHSbPjgIIPrHkonInchigfGxhVhj-T6ZF42d8w&oe=69AC11FF"}, {"file_name": "iceland.png", "id": "1977676902777096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302483_1977676906110429_1288334740935581379_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5C6SO4wH84Q7kNvwGkms3n&_nc_oc=AdlFPx_Hjy2EZDbgOQOQ7la3l0dyqmcXsCidbgig_lz9DrmFzwKW1g3w1BQRLx_xrrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqvsqIesciS6WqcLMJq8aLGJnKVmF4axnMT-MaOBPITw&oe=69AC0C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover-v2.png", "id": "1198881635041207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619681_1198881638374540_3212303079057018365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEs1Cn2rcgUQ7kNvwHQKY3K&_nc_oc=AdmWGYWkTTK1VMqkEhcuHtQ9nVosmYaRMDznawPxBnADYcml2IwuvxgsTMyYS3gGuYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhAnQw2_8Imu38-emhY6PdXsYPThVFLeaFSlmZCLTpkg&oe=69AC33DB"}, "display_name": "Gratitui: Real Beaches & Meditation", "keywords": ["meditation", "beaches", "relaxation", "nature", "wellness"], "long_description": "# Feel Better at the Beach\nExperience rest and meditation somewhere beautiful.\nWelcome to Gratitui.\n\nStep onto **real beaches** filmed around the world and calm your nervous system in minutes.\n\nStunning 360\u00b0 locations from Portugal, Malaysia, Iceland, and beyond. These are real places on earth, captured in **high resolution**. Each beach is a grounded, **stationary space designed for deep presence**.\n{1257599096476579}\nIn just a few minutes, notice yourself feeling:\n\n**calmer** and less anxious\n\nmore grounded and emotionally **balanced**\n\n**refreshed**, focused and ready to continue your day\n\nBuilt around **blue space research**, Gratitui draws on the natural rhythms of coastal environments to support rest, recovery, and presence.\n\nHumans evolved to recognize the beach as safe and non-threatening.  \n\nTry it and see for yourself.\n{1464450471861872}\n\nChoose how you unwind:\n\nImmerse yourself in 12 beautiful real-world beaches\n\nAdd gentle **music** while relaxing on your private sundeck\n\nSelect guided **meditations** or simply enjoy quiet presence\n{1444598177045149}\n\nHead straight to **Daily** for a quick, fully randomized selection of beach, music, guided moment and mantra. **What does the universe have in store for you today?**\n\nInteract with calming ritual objects like **candles and sound healing**.\n{1672027603956197}\n\nReturn to your favourite beach for five minutes or stay as long as you like.\n\nNo subscription required.\n{1972130326707768}\nCurious about the science behind why the beach calms the nervous system?\nVisit gratitui.com to learn more.\n\nQuestions or comments?\nhello@gratitui.com\n\nEnjoying Gratitui? We invite you to leave a review on the store page \ud83d\ude4f\n\n\n\n{1988648649203224}\n\n", "short_description": "Feel Better at the Beach\n\nStep onto real beaches filmed around the world and calm your nervous system in minutes.\n\nThese are real stunning places on earth, captured in high resolution. Each beach is a grounded, stationary space designed for deep presence.\n\nIn just a few minutes feel calmer and less anxious. In the long run your investment of a few minutes on a regular basis shows up with better focus, sleep and enhanced cognition.  \n\nHumans evolved to recognize the beach as safe, try it.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.praiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PraiaVR Inc.", "support_website_url": "https://www.praiavr.com/contact", "website_url": "https://www.praiavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26026719896980824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298219_839080959002141_5266612526944050375_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q50saIZQecQ7kNvwEcCV4e&_nc_oc=Adlwg-CRrWJjYGWQs6WetMIY_igDMRVOOnc5IDYUqKEUcD2kADzk-GSCIhWl8ih9phA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzY0qXj5QMw2CFgETKVixsk8hrrlzfnjJJiqvmMLfsxSA&oe=69AC1019"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
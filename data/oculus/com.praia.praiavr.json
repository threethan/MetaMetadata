9166871048_7151128231224401353_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG4SBL8-dIQQ7kNvwF9ppIt&_nc_oc=Adox40plZZoDYkWyszj3DHrKSRClxB66xTV55W_hMRhTT9KK_d0GlVRUGa5ZzCSeXTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEeQCvDuVscS5Xh4VAUsMDZ63cqd_qiy3AWFJK3H4ZYA&oe=6AB7BB0F"}, {"file_name": "screen shot 5 2560x1440.png", "id": "1722222284926965", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54770914_1722222288260298_4419162366756743151_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn_7Iz7l9goQ7kNvwEBhJV5&_nc_oc=AdrzIvmG9mKzzNY78pMkUrlwhiaQa1iYpjF-UyLPeOACyXnTOeeWcqf94Gq_fTtP5r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2_jYTUIWeQOJLX6CIerVNNGbYyGG0wDdzncokwgQLzQ&oe=6AB7D00B"}, {"file_name": "screen shot 6 2560x1440.png", "id": "2676961355796049", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035425_2676961359129382_8054731363822254197_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZcpDz73mOcQ7kNvwEXmmM1&_nc_oc=Adq8G9mKaQQR1zbmmTMVQ9GlAclyIpiNOer03yuFVooXCAWTmohgf861VUirleF_CUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy03BJ8vD3b6tkY7N-X5y8gBSB7sCubt4wQwyLyUAF2g&oe=6AB7D41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "366515672526467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_366515675859800_5037170625869005808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jDfoiX_IwYQ7kNvwHm6T_X&_nc_oc=Adqgu8hs7BHg6rFahEKhOsWZ5vQOt4jA_WagOeKwLEsMLMij0IQ43QQnVT56KsDdONI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIslEqUexXBX9KiHTPcT_401az9um3bHfpHDhpb6xwInw&oe=6AB7D76C"}, "display_name": "PraiaVR ", "keywords": [], "long_description": "Waiting for a holiday is a thing of the past. Escape to the beach today! Catch your breath, be in the moment and connect with your soul. Never-ending real 360\u02da beaches from around the world with real time audio. Realize the benefits of short powerful gratitude meditations (2-4 minutes). \n\nStaring at the ocean changes our brain waves\u2019 frequency and puts us into a meditative state. Immersive virtual nature reduces anxiety, fatigue, depression and increases relaxation. \n\nThe feeling of gratitude has life-changing benefits. \n\n\u201cIt regulates stress hormones, helps with cognitive restructuring, enhances the production of serotonin and dopamine neurotransmitters, and fires new neural connections to the \u201cbliss\u201d centre of our brain.\u201d (Christina Costa, Psychologist)\n\nWatch a short tutorial inside the app for hand controller direction, only the right controller with two easy functions.\n\nREVIEWS FROM OUR FOCUS GROUPS\n\n\u201cFabulous, love that I am on a beach in some remote parts of the world in seconds. It really feels like I am there. Mindblowing!\u201d -- Dan\n\n\"PraiaVR is a welcome app to provide an \u201cescape\u201d, just beautiful and perfect - the beaches ground me. Love it!!\" \u2014 Lisa\n\n\"The sounds of the sea breaking on the shore made me relax when I thought I was relaxed. Wonderful experience.\" \u2014 Eleanor\n\n\"So very cool - traveling without having to travel.\"  \u2014 Melissa\n\n\"I want to meditate outside but am bothered by bugs, sand, wind ...this is a game changer. Love it.\"\n\n\n\n\n\n\n", "short_description": "Waiting for a holiday is a thing of the past. Escape to the beach today! Catch your breath, be in the moment. Never-ending 360\u02da beaches with real time audio. Realize the benefits of powerful gratitude meditations. \n\nREVIEWS \n\nThis is something I\u2019ve been searching for, finally! 5 stars!\u201d  -- Sandra\n\n\"Very calming, great idea to help meditate.\" \u2014 Cindy\n\n\"Fabulous, love that I am on a beach in some remote parts of the world in seconds. It really feels like I am there. Mindblowing!\" -- Dan\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.praiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PraiaVR Inc.", "support_website_url": null, "website_url": "https://www.praiavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7042367529176013"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1425930545175544"}, {"status": "PUBLISHED", "id": "2348603865657769"}, {"status": "PUBLISHED", "id": "919467517403354"}, {"status": "PUBLISHED", "id": "1444524933722977"}, {"status": "PUBLISHED", "id": "1509474303617960"}, {"status": "PUBLISHED", "id": "869441642276886"}, {"status": "PUBLISHED", "id": "1021721613235100"}, {"status": "PUBLISHED", "id": "625947246894473"}, {"status": "PUBLISHED", "id": "8833082396751203"}, {"status": "PUBLISHED", "id": "1004498101329733"}, {"status": "PUBLISHED", "id": "995898844844412"}]}, "baseline_offer": {"id": "2348603865657769"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774119600, "status": "PUBLISHED", "id": "1425930545175544"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27756312827354847", "version": "3.5.6"}, "id": "1299471437366335", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
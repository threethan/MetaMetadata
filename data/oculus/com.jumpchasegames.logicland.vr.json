om&_nc_ss=7f20f&oh=00_AQSaL70G-trDT71Um0CzGR-odnD0sqJGss-QNJktx6gWPA&oe=6AFC6739"}, {"file_name": "03-who-lives-where.png", "id": "1619257223070696", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624606_1619257226404029_4739718281336471747_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PzKRfWvyH8Q7kNvwFTwp-I&_nc_oc=AdpdU9nu6VB9ZTcGoLmLkaKRDOnHaVaAg2SIXafCEumAJ030XBG39HaehbOiDHlu0_Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMT-Bu2gagx9Ds8A9KTPiWt6QKFRstHhT1fBTGeFnotA&oe=6AFC868F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02-title.png", "id": "1057760860375615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_1057760863708948_8837274825517508481_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUNf3TbB9y8Q7kNvwEqHGeV&_nc_oc=AdrA8b1LunULdJPMwXQPU7NeNWEWTBUee-5G3XgojT2SlKDPI6PoGJ6yv1-usn4SSKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRygCbOf_k3272_NBevPrB7kkBbNY6HNEVSQI_rsw6Ssg&oe=6AFC7670"}, "display_name": "Logic Land", "keywords": ["Puzzle", "Casual", "Educational"], "long_description": "Who lives where? LogicLand puts a miniature town on the table in front of you, right in your room with passthrough. Every neighbour, pet and car needs a home, and all you have are the clues.\n\nReach out and pinch a tiny figure to pick it up, or grab it with your controller. Drop Robin the chef next to the Dog, park the taxi in a driveway and watch everyone hop into place. The clue board keeps track: who lives next door, who lives to the left of whom, who shares a house and who never could.\n\nThink you've cracked it? Press Check. Each clue lights up green or red, one by one, and when the whole street is right the sky fills with fireworks.\n\nFEATURES\n\u2022 767 curated puzzles, from gentle three-house streets to tricky five-house blocks\n\u2022 Endless mode: six difficulty levels and more than 600,000 puzzles, every one with exactly one answer, playable offline\n\u2022 Hand tracking or controllers: pinch, grab, point and drop\n\u2022 A living town: cars back out of their driveways and drive around each other, pets wander, butterflies drift over the flower beds\n\u2022 A table that fits your space: resize it from airplane-tray small (40 cm) to coffee-table big (108 cm), and move or twist it with two hands\n\u2022 Seven kinds of clue, explained right on the board whenever you need a reminder\n\u2022 Cheerful music and toy-like sound effects, each with its own switch\n\u2022 Pick up where you left off, or choose any level you've unlocked from the title screen\n\nRelaxed, no timers, no pressure. ", "short_description": "A tiny town on your table. Read the clues and work out who lives where."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jumpchasegames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jump Chase Games", "support_website_url": null, "website_url": "https://www.jumpchasegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1689051389261752"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624069_4623056144596644_738054521733870569_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a
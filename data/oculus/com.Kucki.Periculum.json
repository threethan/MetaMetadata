732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=201AcL2hkGQQ7kNvwHP-PGx&_nc_oc=Adkk3lfjchhBZk0YTNuvQuR9DP87qX_R9xfsXQej28K2aU0otTVfaJbF580E_s8joU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBk1vgZQqYqAQdkLP5QHFLCwaoKH0ymdpudaF6IyuMxQ&oe=69A2FB6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1139189848221782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821856_1139189851555115_116666907001892448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFrZ9uDTAOkQ7kNvwGTOhNB&_nc_oc=Adm5PopZTsCP_ZbapZyR0nWXH8lRs-Sgb-aPpumBKcRlvc3L6I3-_Ux6LO_5E617_Wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPVfTnWhzpG-rI9IXI1PK8ecAETSfR_ueJc9q_uFhTRw&oe=69A2FC48"}, "display_name": "Periculum Demo", "keywords": [], "long_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless. With up to 8 different players/colors (bots).", "short_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_ra
732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPafKxqlIgIQ7kNvwFG9h6M&_nc_oc=AdkuLbbwcLmsEKF_NPhzptpFo8LTbSBFVg7NNqJfZu0_dT9HYfLKzC12xz-3h7vA3eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJePWr1d4rvG-ZCQLwdFVFcXKYxoiXHkk-aAPWAORXHQ&oe=69A0586C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1139189848221782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821856_1139189851555115_116666907001892448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tutavrNZe6cQ7kNvwH6-LXw&_nc_oc=AdlDGcKW00qISB2Fr31Ac1ochfpQ5qQ9K6Ui5_P9uy_DSRv-GJEsi-tgt6FlM-2HMk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXNjFHJrAgRn7GFKNBgJfsSVUAAtVAo1eK9WMj_s8LPQ&oe=69A05948"}, "display_name": "Periculum Demo", "keywords": [], "long_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless. With up to 8 different players/colors (bots).", "short_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_ra
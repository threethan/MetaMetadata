732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPafKxqlIgIQ7kNvwHi25GM&_nc_oc=Adn1RxKBqkYsjfn2lSE-8ycBTAEyWGTLHkve4C-f3iEfH0m8n4kNNcbtObDXvXf0B8k&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsLAFaqRpPi7bOXlTk5rF8vu1r0Dc6pnC_tz0GFpeDyyQ&oe=69A1A9EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1139189848221782", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821856_1139189851555115_116666907001892448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFrZ9uDTAOkQ7kNvwF7aDAM&_nc_oc=AdmWcbYCpWozM91VRdhSt1qqOkYq0UbJ2lK8CKzDX1Lc9jp6U5MglROwGgp-_EGSHrU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv4ITfVH2vjksKCsU5EnSlyoPxzVjmTKhYpSaaKB_sVqA&oe=69A1AAC8"}, "display_name": "Periculum Demo", "keywords": [], "long_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless. With up to 8 different players/colors (bots).", "short_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_ra
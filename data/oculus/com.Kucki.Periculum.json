732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnWZP0C3PEMQ7kNvwEPfoZf&_nc_oc=Adn_ZF-iC4qvBDWowvc-1DNC2WVzsMW0z6wERQwlMy2Q3HLoY69ilrxSS4EbGCPwgpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0bpIkG1wEruMiJSbEJWQivB4g6kR4COf6ja0Y4iioBQ&oe=6999C0EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1139189848221782", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821856_1139189851555115_116666907001892448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i9y8T-4ImsQ7kNvwGD-A9n&_nc_oc=Adkp_I0x9Gg_hPVp_gHtz4ybgCOH1AO9Iezdkv89adfzX7zC3kqaWzZmWuK7BRCcPfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveANUy5Ktm_RH8wjz5ufO18xLCoFqsPs4bx4u5fi_Bag&oe=6999C1C8"}, "display_name": "Periculum Demo", "keywords": [], "long_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless. With up to 8 different players/colors (bots).", "short_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_ra
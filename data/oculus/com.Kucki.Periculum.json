732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=201AcL2hkGQQ7kNvwFypcRL&_nc_oc=Adn8ayg5qhg3Qgca2NxkKMDnLYrgsIVI3Z5ja1bGq355mvGNKJ27va7yKcyVtq_1Vb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvsLXl1a5ABaaufFp0Gs4gDLU_EPQ7HQK8lkY1ysvpYLw&oe=69A44CEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1139189848221782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821856_1139189851555115_116666907001892448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFrZ9uDTAOkQ7kNvwH494XV&_nc_oc=Adnp1-YqVNkoPuWPb6_iPbF_nq8T1jcRb6YqRJieMrxhN2j-CNJ5g65PDkg9doHSxQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuf-920kXao1gyqzRX5QOeef6qhnBBcFFNSadt_xh5uiQ&oe=69A44DC8"}, "display_name": "Periculum Demo", "keywords": [], "long_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless. With up to 8 different players/colors (bots).", "short_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_ra
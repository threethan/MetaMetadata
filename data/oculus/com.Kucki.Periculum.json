732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPafKxqlIgIQ7kNvwH11Iyr&_nc_oc=Admu24YPuIN6VhEhbQa4-p0W7vhnTdk6TvPdZYJg-GaUkMnP7BaERJYQFTrr_ecwn-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsyvfWunU6V31CXjoGWWx8cn2avWOIUVEFxP54EbHuchA&oe=699F06EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnailOfficial2560x1440.png", "id": "1139189848221782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821856_1139189851555115_116666907001892448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tutavrNZe6cQ7kNvwH8tply&_nc_oc=AdmD8U1VlLq_KVKMM6-cCRNHvgYJF-_ra-_BhGNVzDGgZEHcuH3FHyG4ulM7CTUeb2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfupQDSTootD5W415z1StCRLyJCe3SYkGyaRmw6uNeWvDw&oe=699F07C8"}, "display_name": "Periculum Demo", "keywords": [], "long_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless. With up to 8 different players/colors (bots).", "short_description": "Demo for the new and upcoming casual strategy game \"Periculum\" about conquering and building on hexagonal tiles. Engage in epic battles against bots and create your own maps inside the level-editor.\n\nThe full game offers many maps besides self-created ones, plenty of game modes, and unique options to tweak your experience to your liking. The possibilities are endless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kucki.eu/periculum-privacy-policy/", "developer_terms_of_service_url": "https://kucki.eu/periculum-terms-of-service/", "publisher_name": "Kucki", "support_website_url": "https://kucki.eu/support/", "website_url": "https://kucki.eu/periculum/", "category": null, "comfort_ra
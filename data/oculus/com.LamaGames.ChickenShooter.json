f20f&oh=00_AQOxQe4v68Lm96LgnYFxuP-RrSqMFlpi0VuuXqd5D0-3YQ&oe=6AC8F3CF"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihvWD3RUF-gQ7kNvwEMgJj-&_nc_oc=Adr9tL0bKCxaQnpyUVpPQBuPA1sdOsXnqjZg7rk4kRCVF4b-YJkOPcrJRoMrutL8QAA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe5w7OH2vTCFTr8HmtzSWsl8QhsZMPLVdOPSM1UvocwA&oe=6AC8FDE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R-4TPyAInYQ7kNvwGxs0d-&_nc_oc=Ado61Kyk4Et7qkOADMn-qhLyFHUxx57zSwMOsYzYJBfQf0_8B66IMKze_EnGs2JrJwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGzsAq3yd2cJo2hJbl-rHFE3XHJMrzgmhKsAXjZdI7CA&oe=6AC90533"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
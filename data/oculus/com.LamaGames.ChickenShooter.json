uluscdn.com&_nc_ss=7f20f&oh=00_AQFDpVqBcbtLkIjM7Nf-dt9txWOnyy7zrViPeFlV0HjpBA&oe=6A857F0F"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIUphTT3bVMQ7kNvwGR-BN9&_nc_oc=Adp3ZqG34D2BCzkpiJWAIJNVOrSWA6h35C8m0WnH0RuaZksKb3jO-KaW7OUIqjSGRmo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm7p3U9OxudPi4ftucWMfCnD7oNB6q6f3K-JJFOCiU4Q&oe=6A858924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf-Q_qe-hiwQ7kNvwGfS4of&_nc_oc=AdozcewzNXjrPyfS_gb3CyWQbxhEaTRf_UdcS4fxTcjL2mHk8zBnquub_TTInl6Cgjw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeGLTkyTDGLmtU3MDMFLyLA48Ef6O_U3nzSMP9bHzJ9Q&oe=6A859073"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0131m", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT8_gyWCBJwyRKiAUrQn4vXPUmhuuvCw3a5zx8srPuhE5Pvc4Gg5YXQqkLRhUIryZM_W5Ci4ggyqsjH/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTLGIJ_ye3C99A4s4E7pkJGJwrIVN1cM4upq9HBZlnZZtAEIrkUOKsNFvfh5mxOQYVJZABzwVQvuFmO/pub", "publisher_name": "Lama Games", "support_website_url": null, "website_url": "https://www.lama-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373134302378642"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2170615056799704"}, {"status": "PUBLISHED", "id": "2070322406829769"}]}, "baseline_offer": {"id": "2070322406829769"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761937200, "status": "PUBLISHED", "id": "2170615056799704"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24774949112197157", "version": "1.1"}, "id": "733126629712464", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24289063940785679", "is_co
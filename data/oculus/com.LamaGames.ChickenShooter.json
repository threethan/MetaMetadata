f20f&oh=00_AQKl69RHjVuKcbK_wrSj3yqSI5Q_oz6rnvpEYOoT8hqmDg&oe=6AA166CF"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKQGVbx1kCwQ7kNvwHq4rro&_nc_oc=AdqiDKOjHg213OL1NJDzOilUGk4PI7yMDRvPa5Y44oT5Rh5zmorZyZeKT8Bs51JgcEA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3klogcpyiuZ4UzFQgl2wzUK2d6Q9HUxNdkwQ-YQSfOw&oe=6AA170E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VqZG4QFPekQ7kNvwGK57AE&_nc_oc=AdqfYbfOcKgDSaDUherNCaxFZzMySr_xnI4B0EUnIQgeKBgT0pbBPZsfujGTRLfwSSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVOYarN9DovduPeQ72-T5NbMP4WP58fW2eRx5zsJck2Q&oe=6AA17833"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
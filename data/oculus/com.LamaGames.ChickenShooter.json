f20f&oh=00_AQPtOw4y5QCkN6MoSMteNqJkkWfPWTK_ptRmOMP3kGxXTg&oe=6ACCE84F"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZt06dx0DSUQ7kNvwHSVo4y&_nc_oc=AdrwPqzQ8gqmZE4hTayy_u7CRT6ifL3ZqDFHjY3vDkg5xBuko9GVEW79qCnEAhTVAck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiY2SyuGX8vubPfAWr2Jl3RMH49j2lq4zUQ0KgE7XChQ&oe=6ACCF264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRyI_OVpiPcQ7kNvwF4N2V_&_nc_oc=Adot9KVqQM_uVYkfb7WfTrFaq2RE89JILW2SkKYeNIFGNuLET85L6hDOXk5p-Rfi5Fg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONny9pekrf3mT_xRnm_SdmBN0uR-F0QEOEA5IM-qT9Ng&oe=6ACCF9B3"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
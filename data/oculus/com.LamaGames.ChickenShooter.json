82784_8809463547511261562_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9iEqrYtHVgQ7kNvwFKQm7Z&_nc_oc=Adqy2qaOyG0bO5GTW8qOCDPXZP93ayf8fA9dNn-zuRNKNdfmzZMjU9TyIi0pm7ahN0E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPUTeCbJ_kJ5G2kfEQybIk2P2FFNwgMM8a25Wr8SJzpA&oe=6AAE7F62"}, {"file_name": "com.oculus.vrshell-20250827-163947.png", "id": "2291738814601588", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824671_2291738817934921_3919049431178630326_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX1qpKZZVS0Q7kNvwF6z48-&_nc_oc=Adqfovh4pqFSK1usRXJcsL2YbVBImYBE7E-gvsDfXdKdPo08OuMm_7tbXwsnqWRItFQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3Sgr31Q37RZhsP-5tjORC8BF3InBt8EDhbSsQ3fwuBQ&oe=6AAE95CF"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYWO-zFw_Z4Q7kNvwHeZauO&_nc_oc=AdpKrSJRd0xF8XgnLAUY0fghn27-o71gx2sCbgNu2M9EC0InR-cr8msPRHrJujTS9uY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhoY4_UhFFD03M6r9X3ta8Kuxxv9ael4tZGOzVNdpUbg&oe=6AAE9FE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEK5i68EkNgQ7kNvwHGI99E&_nc_oc=Adp1WXAKKrRbVY3F-3v-XKp93q9WbqSpKUNQcOAa5fGyRrCYfdI7tJi69cV_qkPfu2Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL84172DcRCs1figiZT57H24-mym_UMuFGFS5flLPioZg&oe=6AAEA733"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0131m", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT8_gyWCBJwyRKiAUrQn4vXPUmhuuvCw3a5zx8srPuhE5Pvc4Gg5YXQqkLRhUIryZM_W5Ci4ggyqsjH/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTLGIJ_ye3C99A4s4E7pkJGJwrIVN1cM4upq9HBZlnZZtAEIrkUOKsNFvfh5mxOQYVJZABzwVQvuFmO/pub", "publisher_name": "Lama Games", "support_website_url": null, "website_url": "https://www.lama-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373134302378642"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1
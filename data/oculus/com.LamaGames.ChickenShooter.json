uluscdn.com&_nc_ss=7f20f&oh=00_AQFgCPwC7rFiR6wF_rlphVRS7nEBnWcGYYkeon6NC4OvxQ&oe=6A8EF1CF"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgaCtHamascQ7kNvwEZ7i_j&_nc_oc=AdrAQZLqlDNw5bsC3I3FgN6s-XRfBcg9akwjnaY5clxxrwgeVPTpO_X_F48dKNru-Qg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES2yBOiDizjhi8t_nJhwacFkyjaV5HpP8VfKJ25nrPzg&oe=6A8EC3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8x5PxUDpWkQ7kNvwE8W5u_&_nc_oc=Adrn5hC6Qkxw47UQR3AFq3UxeSrvRqjnLL0Kc5cT0VpqHX9PHBb6CT209sksxoIow3A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqWX5Xrkar2tB1RGIYDu_sFTqJufh4Gdiz3SmtRYOmDg&oe=6A8ECAF3"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0131m", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT8_gyWCBJwyRKiAUrQn4vXPUmhuuvCw3a5zx8srPuhE5Pvc4Gg5YXQqkLRhUIryZM_W5Ci4ggyqsjH/pub", "developer_terms_of_service_url": "https://docs.google.com/document/d/e/2PACX-1vTLGIJ_ye3C99A4s4E7pkJGJwrIVN1cM4upq9HBZlnZZtAEIrkUOKsNFvfh5mxOQYVJZABzwVQvuFmO/pub", "publisher_name": "Lama Games", "support_website_url": null, "website_url": "https://www.lama-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24373134302378642"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2170615056799704"}, {"status": "PUBLISHED", "id": "2070322406829769"}]}, "baseline_offer": {"id": "2070322406829769"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761937200, "status": "PUBLISHED", "id": "2170615056799704"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24774949112197157", "version": "1.1"}, "id": "733126629712464", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24289063940785679", "is_co
f20f&oh=00_AQJEuQ_nfa8mJY5bcUXRRbLIj_rWo94NBGb8R1j53cUylg&oe=6ABD164F"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK-Gt2TdZuoQ7kNvwHbgeEI&_nc_oc=Adq68GKCBQLjJzZ5Th0sojs8Eqx7XC7aQGWSv7LM0IY8smnTX7G9WLSxLvNcLnxqFjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqXe-j0-jwF3zCOacU0tLPjl8mSMLOcN__mJSp1oyFKg&oe=6ABD2064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-laNsdnKOAQ7kNvwGVT9ih&_nc_oc=AdqGP4hAcT9zqpbBsFeLsMwSBYpa_egaAM9BoYcH94wtHVP7UurAGUyjRQZZJYnQNbA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzix9KVeI8yBU15FoGe-Nz821wHKXav1Hb1WKBpqVHig&oe=6ABD27B3"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
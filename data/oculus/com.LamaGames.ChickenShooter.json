f20f&oh=00_AQKCwnaT1mQxueR4aGqkZfXSpoScRYLnxRsJ1Ouf6LYhIQ&oe=6AB7D04F"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_OCKIBhNhEQ7kNvwEXpvvp&_nc_oc=AdoGDJ3sGVpeNePr5vNmJWyUV56eMAmILzXsLB5k8Mir53nKScwkZO0uCdexHkJQNdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqj5nRAThXX-VlgNtpNuu3uXliSE7iK6rUK5ZXm7PBXw&oe=6AB7DA64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpISaQ2W48QQ7kNvwFJ24gp&_nc_oc=AdqyFowiw70KTDhWG1nBi9mFBY3XpjeNwuBBmuSG4zzY1ErJLKD5wD1wqMAxL48ouPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1SScEv4ccdFxJkiFA8vcVi_zFNXUIWjHaTGvHtph2Gw&oe=6AB7E1B3"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
f20f&oh=00_AQMO2Q2nQKjQMNIZXWEukatTKDA8ob8NJuibjC1xk8NL5g&oe=6ADCBA4F"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwAmPiEHHcUQ7kNvwEGCSe3&_nc_oc=AdozBA5x6asZ9somwHrF2qMtf4TeTQqci9Raax7qAZRp8yaH3GFAyi9c1GmWInCOse8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjSmn_mHjyAu-qAbmKuUo827kDtTO8BCkOpgn9jYJz0w&oe=6ADCC464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC1TiP3qc6cQ7kNvwFo7LE6&_nc_oc=AdqgHh5NDk07PJiv14GgavtdMieA4TOQT7OHV26xTrcWtDsenaZduvhFgFvOzBjfEKw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTu3gIEhCuOT9EfI4v2TLd6Ts7GYAHjivCcUVsNAsW_A&oe=6ADCCBB3"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
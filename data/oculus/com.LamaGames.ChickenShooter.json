f20f&oh=00_AQDPHKXDgxyeIPjyZnTXMaTp98ujZwcIgE8PCSTsnmfgxA&oe=6A524CCF"}, {"file_name": "Sequence 02_Sub_011.png", "id": "2062535771220592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_2062535774553925_5121342344135323087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZno_ZmJX2YQ7kNvwGRb9o4&_nc_oc=AdpGWqJVr0wi3-1tqLuMZ0ZEeK5kJHs8dMIe6TBMy8viwg-xv7FbsAnR4KGmKqoRarE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrY-QJxU8RPue3JIQzZ2VaGJ3HkcWm28bYSNE7Pdkr1w&oe=6A5256E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EggspenderL.png", "id": "751864331166212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_751864337832878_7040348585708806203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73Xtiknos1MQ7kNvwFUJTYT&_nc_oc=Adp7wmRy_o9EWeaHYudvX_QfdudFT0MvKJJhRcsm8PJtv_7E8_bRXRag1xbEnbplyWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhW38dUAKyM4Nf2kXO2m1q0AdrH-hHXHR8qpRa0J6cTw&oe=6A525E33"}, "display_name": "The Eggspenders", "keywords": ["Shooter", "Arcade", "Action", "Comedy", "Games"], "long_description": "# Strap chickens to your gun, blast eggs at evil targets and rule the island! \ud83d\udc14\ud83d\udca5 Join the wacky arcade chaos now \u2013 The Eggspenders is live in Early Access!\n\n\ud83d\udc14 **Cluck n'load**\n\nStrap in your chicken and unleash a storm of egg-blasting chaos!\n\n{3321742234643302}\n\n\ud83e\udd5a **Early Access**\n\nJoin now\u2014the island is just hatching, and more surprises are on the way!\n\n{792291623477916}", "short_description": "Welcome to The Eggspenders! A fast-paced VR arcade shooter set on a vibrant solarpunk island. Strap chickens to your weapon, blast eggs at wicked targets, and rack up high scores in a world full of color and chaos. Early Access means the fun is just beginning \u2013 more features, modes, and mayhem are on the way. Jump in now and be part of the flock!"}]}, "developer_name": "Duygu Y\u0131ld\u0131r\u0
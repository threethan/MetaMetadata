lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2V3K-FthT4Q7kNvwHM9I_p&_nc_oc=AdpjFiQ4uiCtkYKF-JnF6Yq8gJ2fhNslDYiNGNclCwz6Cy7XdJfeZyhWCQwWou-Tops&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8SgCNWyWZr4NIytVCAW9ngpj3HUUXwm_RdcDUVOF-tg&oe=6ABFDA1A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRI8KukiteQQ7kNvwHJBjo1&_nc_oc=AdpULXQW97uafItO3iIfaqwpyqYVHOVbzEMt64dfbVAW2mix4Hg084ZHXIPUSZnsZ08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzjmT3UpomNvWQWrEdxp6EOi3BAqNOFzwYpMcOpyh35w&oe=6ABFBCE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLs9gAtUFnMQ7kNvwGmchId&_nc_oc=AdosEuoLwM17qbFzpRGeDHLq2tGRBhFxA_iCFuUD3TpawrnCYIFOqPQMlZjwlEENFAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYJWk9Rw-PhFfnbbAGvt_NL8WmzFIr1j56PTOxzOJJAw&oe=6ABFAA33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgvwcYvWbuYQ7kNvwEMMLmr&_nc_oc=AdqAz3pUVe294ull20kGh5Tnc4ydIveUO-r2A5C1tNrwk5bgihdC8ush2p4Xjzy7AaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKFD-LCrOH-pZzMuZQTfyFKicIHi2cb-z8mBHAXDANTw&oe=6ABFBF2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UovIP7eStvcQ7kNvwE_aQd9&_nc_oc=AdpE1npLflmUeEnMzttulNwxaCUgGkkcL9k0AhhP_rjXviFhw1TZIayPYBdG6rB6sdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt_RgUe-2lL7cii62zdfX261eDx5oxrmY5Ott-nos5jg&oe=6ABFDDB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7o1btJQEeMQ7kNvwEnxU9i&_nc_oc=Ado-YqRk4aav82UYXAXlAel5ABlpK1yKGhl3AvAmNfCqB6r4TXJaTqxug1oDnYr382k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9UvKpUHz9uGK6RB0SF7kUCJ9RwCKmT4yb7Mi6LSYY5g&oe=6ABFAA24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvdtD7aR0GUQ7kNvwGKyiV8&_nc_oc=AdrQQGzkqJVAteWVcg2n1nArIZ2KoN-8lSE6iH2gDccsKlRbQY5_HHqQeEPZOFLAJ4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO4lAFaHP82F8VhJJjTTE4YpRQBrx6hGjkPFl36-7QWw&oe=6ABFBC7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXog8M-IU3wQ7kNvwHXnhX5&_nc_oc=AdqW8iUN6A4RiOxrST3JRvheoNAmQ0hQpVrMRyGDfwn9WpWzE1mDPXaiZGLHZ9et4wQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFQiI620N0QvP-murLQmJ5U7VKoKIXvw8KWajtbajmwg&oe=6ABFB447"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
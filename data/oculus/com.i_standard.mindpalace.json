lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsBBVAiJ6nUQ7kNvwHKRFc_&_nc_oc=AdrkCBEHdIP1Ip0Ky0e_fTkdYInu6UR7r5LWXiDKYTOdfOYLaN9OVlXhynqgXndzo0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BFGj2CNzWC7UuGGZ4bJo7g1vbkgfYHMzda_8Q8FQ_VQ&oe=6A2AE09A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=velMJ7To2KUQ7kNvwGG7AKd&_nc_oc=Adq-ilxQIY52NxnbvUMqluMvyJhIAnG7ZD7rxF9KvY5L6KuT17Qp6ZPfAKqBtPGzQoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mXoA92spd5M-FSyIHFmzNFG1OO7ScAtr52Zt4ojNMJg&oe=6A2AC363"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ7spXMn6_YQ7kNvwEhyXIr&_nc_oc=Ado5RrS2ESEy8BjOs-7Md9SOIec3pxs9gd1gv8xLEKhPByuKXwGivk_eUiPARAYABD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wCe-CVFJjNthC_M61LPeOJ6maqNa_2l1uIpAZ0uN_1g&oe=6A2AB0B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNMAz4SBHpEQ7kNvwHgEZg0&_nc_oc=AdoC2Jo0URUggDZSMEWc9nrY2uHLbKLyGkVN01fnylHLpd7JneJibCcp7oW7s8zlOPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PGAcpE8F3OwcmQUDxEMTWnuoXLfors3OkbBN3qHv_og&oe=6A2AC5AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHubiLPUJTEQ7kNvwE1S1LG&_nc_oc=Adpa1UE5q3rDOBi-PdFtI9JdBRXQycSufpVJODNwgBXQev8ltTNiPjeyyXjV4bAfviY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GrUD-popBuIh2Bxbyzz3Oq8IPiEvXyUJ2-3GQB46E4w&oe=6A2AABF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGu8d0Zp05oQ7kNvwGBkTUh&_nc_oc=Ado4NbjADwZzPWAVBpbv8MLTrCJx4jmKYGUutIcxUrQd1COLKp4NhRNlhzHrGTcf_0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v-ql5aO2K_he39h9pBE6CiZsrTnhfLspu4wBVn6Nh8A&oe=6A2AB0A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvczzgpI4CIQ7kNvwEaxsmC&_nc_oc=Adr-_AF8A5NXDbfTvuON12G_8rSouvQAaAWJ3-xuyYZdzLNVwlM_Cv-Sdie3ufUghuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pwP1Vej9jBHmdMK4Qj5r0TXsSCwv0XNnS56LLGOhVtw&oe=6A2AC2FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1TemXeORM0Q7kNvwF0BIk-&_nc_oc=AdqP4bBvIU3WMDbYwsNrnCPs-HOBathL4jGsdkcLvAmIsAk9jmkUUoD_DvLupsVOwJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TFpbuBUFcClopMEuVrQNO0e-KIMe_l0AwElAcnIx19g&oe=6A2ABAC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
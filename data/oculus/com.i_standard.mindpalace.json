lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpv-ry4CGrMQ7kNvwEenErv&_nc_oc=AdqGjFrAcXfrWU9lCGfxPKKeCHwE7aKDadjLfEIzzaiOgYURNQ3iANyuyROZUS1RiWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6dIf4j98KkYq-0yhoudggR3WtHeUKFJiNz4jDDdvSqg&oe=69C6765A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JCd4kFF-ZgQ7kNvwFnTCmr&_nc_oc=AdrLV2uuUZYt5JpkT6eZCnDmPOnsoID7yCzZ_5fmLyNZssOvs9npq7Mp_7HpqIANqiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-4jtahG5TUujsPqvIQT8Y6yOc7vFKXfPtqMP0DWq6mg&oe=69C69163"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjd4_bwpOrQQ7kNvwFfqKgM&_nc_oc=AdpOe2ruPytKQ8CrLxdtmWAbEojDh6R9eLkieqZgIhTs2JGnaquqH9dLvJMxHhU7vfI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynZlVzc9ZPS-2V4BDsCm-dmrYAt3V0tsfax_CjRvm_vA&oe=69C67EB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10fZXx_9kz8Q7kNvwGZ4cYL&_nc_oc=AdrPLhtj2O_eHHnaDcmhjY-j7t6Gt6J8T1tMI_HCKdTZHwNEdega09bMopxIY0UOvLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_rcZ19ZHY48n9qGpDGPXC5EwKMpHf79RYB3ipMHVulQ&oe=69C693AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1q4eSwwDMIQ7kNvwHybLKY&_nc_oc=AdqzvwwN8BYXxKgioDly2VTcrv1oCQbl0fdqn6bl_JIR825Y4m5jhX3RF0aLcXbEFPI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxG3KYOiwzkTcbuEUf1N3tLjO80021QaC9oP2U4vTr09Q&oe=69C679F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aSrX5LOwI4Q7kNvwHlrxw0&_nc_oc=AdoGTKXNSK1gIkfKE4T9l5w-eEsTiUGhffTcncFaL1dLGFpRTYptZ4dqVIy5SaAd1JY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgemZYqy4OCILP8ykNdBjYa0QcjIqV3zYBOG4GZnF15w&oe=69C67EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RFXfnaLESEQ7kNvwEO9Mvh&_nc_oc=Ado02gyh6nHdosG3162D3mhBovOG8cy9BbPO67eArGnGSkyxqsL4YT1JM5MjSkbId-Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL-tGI1_LW-SvWpHvlly_TxS6tTMNDbxA11MVZyXf9UQ&oe=69C690FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbsxyds27KYQ7kNvwGAJbxM&_nc_oc=Adpi_6ZcIISQ4FMx91TYbvwYw6Q_MECxblA_hNXkZrsmJ3ArS5S1chckPYK0HxTYMk8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaUSF6K5gKifI4pQ53S9yJM9laYvsn0_Qm8wYgItEuZA&oe=69C688C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG3BVcqPTqwQ7kNvwE0dOBT&_nc_oc=AdoVBzgClZtDr-xGLpCD2bLG2njAJKSzKEJud-hWTVpDmJc8h7i1EiL8K3bsct-I4Uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPICpQx0pmM0eY4iRMLZ1CnQplHznHQGFZJDzZyCamUA&oe=6AD24F1A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zM0H3jhzL4Q7kNvwEWhBt9&_nc_oc=AdoSp4O2eME8JMDW7rHUVHS6WjrtAcG2qnmzzxs0ZgAU1uzI7Qvfj1b3SvJjMTrTAPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkmR2G2KmjEUBT1e0I5-uNyM9Hl2_ccHDlvu1dW7yE5Q&oe=6AD231E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JSOnPCYJuMQ7kNvwGxkReu&_nc_oc=AdobPOju0FZemF2ndzZq-DDZ3Zo8AwRv7XXNel0IEcHvUiw3C13GjiFPq1LdSzZr6vQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU94qOzyCeQUK68UWYRwCksCoyFRMNEu-iRQqV4Fpn3w&oe=6AD25773"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu5fnK0dYn4Q7kNvwEKQs22&_nc_oc=AdrwzOn-K8aq0B4XWc2nzSeavZmogeCJrZszPJBH4uIbJaVU3culbdHRRYhdfJRIujk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP91-yzV-gJTsThyfQUwLI9xIqceZYb7mpDiupYT6RtAQ&oe=6AD2342E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgOfQLgQEhEQ7kNvwHYi8Fx&_nc_oc=AdoPKxc0qGrTMQzZqabs3ENydVexefdPfRtvrZOUMCF5Smz65-X7TZGyUbhWYHGQdNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKNtxAcKvxdO0OHMaLT2s7DKSeRnMuEAH3wUWnjq10fA&oe=6AD252B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU-u8u34mHcQ7kNvwFvd3U1&_nc_oc=AdqepyNouCuV1J1O67-d9SI53BVjjlDxHy3phxfbZu7A_OfC7oOTIrMuZkBhIp3X0DU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5wEs-FvMWNMcP7lRxn_-EB0vgmg1lWCbY-fbNXJrfAg&oe=6AD25764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrCA3dAxVtAQ7kNvwGkFX_z&_nc_oc=AdoXobqiQKYCO2zpmtiufzj3xdLFIUTbdY892qeuDN2Zl0fJecYAXJvLSHSyd7eg_Dg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcSwiLyLE-e0O0BrBr3Xr0mRMs-eMq40SEv26hg5pPdQ&oe=6AD2317F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08IoF9584ngQ7kNvwHjYAb6&_nc_oc=Adot4m4hykZ-6LUNmfxys6DZ9ldGV_sa_tkMAEJEAo9d_wQ6kXwRvOG1BKcB1Rf7nz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMElpftr4_9oVgOql8lCUUkD06xG6t7v2mQsV5PMy91ug&oe=6AD22947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
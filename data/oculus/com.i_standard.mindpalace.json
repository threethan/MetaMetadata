lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz9TWBZ15PwQ7kNvwG8orob&_nc_oc=AdrMIiNG3ey9J-7s1wnwRLItFpwgQ0YQoQhnfYMt7JfxxEqbw3gNjEKbi1L7tFi1JEE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTrrf6syBTSUZajkLCEfcCBB99o8fet9L8ol8Xd1fIQA&oe=6A5386DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OBMUSEKXDYQ7kNvwFPdlE4&_nc_oc=AdrhzKLbvE1VYemdWtFg0spu5FEz_GY0RaARQJCYWFYGOgHEuPoNaXagrhYLZFQDAhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkCtgw3CrdzkW-oOIaNlbQg_kbFoRnjwSdDE1LF_vzAA&oe=6A53A1E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkIBpzrzrGUQ7kNvwGWo50-&_nc_oc=Adp3JNwZqYYme8ikz0UdGiU9QuOAMPX2W1Tka51u5gwLlp4gUpalAEqhqlq9j0p2GMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAop_dv8njjAUYtJOi_9ZrAabL_t6IToCfp7HjsFlRfVw&oe=6A538F33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk0x62DBPiwQ7kNvwGGYx-c&_nc_oc=AdpB0ZnEa0LNx49NO9MNAhwSgid_7E1sK_JMbJsKlLw-xJiLzWOSjg1FQul50cxTEe4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-d7-ZZ8UnD846CX4trutC1DLBAwzzsHIT3vpOKaZ8HQ&oe=6A53A42E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLfqzbYVWFUQ7kNvwETKY6b&_nc_oc=Adrl42NeJYgtrTFmVALRtZ4OY78yDo0nqUqsiRFm7s6Y2KGXtLsXUkLJFOoPTAX1epw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv0c3VKHRDCLqeUsAko5eAefI1SOAJZltydrSejzRDGQ&oe=6A538A79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsi112RSB-AQ7kNvwGTDPcS&_nc_oc=AdrAMfvfVkp6-Hv8RD9HOsBZlSJ2kRbGEdAwPCPsOG6lQgLuYGVXX0OxJdiU7Z7GRcs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIYEPrI88L4AABdGuJ9ysPRie6YYMLa9Xf7lA0YkzBpg&oe=6A538F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctcL4gm8HfkQ7kNvwEut5H-&_nc_oc=AdqXvSZUn5E9mBmMAAb4CobU1FfshQcXFN3nPLJz5Y6gzH9wL8OB3OpTpg5wqvZ24wk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9HpWw45PZRK8IZh8kjks_AsLJPd9aaoVhdIn0x0F9kw&oe=6A53A17F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqxsslHO8ecQ7kNvwEfwj24&_nc_oc=AdrKtLO1o5u1bRVltW16ou4D8jzUsixs7lghjVVoFRyYEBGFxtJPLwJgb79x4MUmHZ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP4SWE5f3-c_BRNqINzi8M6uRDuBovDDYpUFj5Airuaw&oe=6A539947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
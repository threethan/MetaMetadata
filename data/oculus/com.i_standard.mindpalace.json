lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqV1cOf6O7sQ7kNvwFn2zWL&_nc_oc=Ado4LwhjwTI4VapApqbmr2wN5IEgzhszUeFOvdTP6HiqO--mGkH7MPXEP5anKfv9QS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NcB86jflQuo5Q8iJ-wK5tK88s94fUuFmSZi_5GW6lBQ&oe=6A43B4DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkNiIddBlksQ7kNvwGsXj34&_nc_oc=Adqul1pNOfdJ4XXD1zMmyDv2w4UZ-fdt50vSoo4wloNIzuk1GsLjsjwvkTJTNPH7_Rs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H-vIJkYxftYwoOEm8EyBm_2yVcNTuT3cIpaD7zQM3aA&oe=6A43CFE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKw6WNSAAIcQ7kNvwF8wd0B&_nc_oc=Ado7mmaiExo_1KT9B5LqRGZTmnFr0ag2HQHKLx9b5teucn_FhPPvcb2fj6wC5t6tYvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hqQ1YthQH-naIBhl-dzfA2U1CRKv7XQ4zU-xviDkeeQ&oe=6A43BD33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usTtxPATstMQ7kNvwFUKhWr&_nc_oc=AdpjmNZ8YuCBlbOQbfb6U-9DpRSgEtihIH_XPzgT5J3IaK4pm7jsPfKqmmwq9yHRf2s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gm1qiZ9r1SOn7YkI-_UwbYd9UsGIKpb8g-se0KnA-JQ&oe=6A43D22E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqfOM9NaTkUQ7kNvwHbE24P&_nc_oc=Adq7wmUC2QPqaYCDf2gto0EyzuKoaYbjk_ttJwp3pPxGbpz4RmLk2WCy7A4fT4v5Qn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OFflkKTOgcd-M78RXM1qh3horJTxdUHvFeSJgRDupHw&oe=6A43B879"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGSXKHuB6vwQ7kNvwF8uf0y&_nc_oc=Adq3TymJMAlzgOfF3gU6YXnB6-wcp4c_z-3YkQQsbGD0aWe8DirghXjTJ9q-IKEzm3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dyNqvNXLjVhBTHsh4039a3WhI0NUufIr2sRTkd3CT-g&oe=6A43BD24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjNW_7zyIhEQ7kNvwGEggy8&_nc_oc=AdpAG1GXzOqzDzbhcbl2igYhmpvMDutWpNhRXZ8DtW7A-6gKAt-q43Qwa1NRZrNytwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GppDVexeaXA_XhwyMmIlX28-P1puajXIxa-5s8HhSsw&oe=6A43CF7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvVnCNzw9UQ7kNvwHNesCL&_nc_oc=Ado7sE5ElBch2oidlwjUrgbGMTWrjwlY4uIY9FL2Y6Sv9UWbYb47CpuYf4c89-Gt0ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hEKJmuSAL-Sn7f-cZiqPmMmqN7M0z2qvEGJJkDy1v8w&oe=6A43C747"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUf4Tj2oOswQ7kNvwHLD0pI&_nc_oc=AdotosBEh4Gm9lvrW6w4tD1gwGxVd7PEeZb1wLlvfevgtKCd2EIbtzXC9Zln8CnVCOo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Zv6VhI4Y6vxr4-cIDOxAsjmGJopSzY8ggm-K0TD6Fsg&oe=69F5EC5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuaQAoYObWoQ7kNvwElrqMS&_nc_oc=AdqsvdGYzwmcc1LBHc2QU6htRKPn6lgMXUzLKyuToh3zc2BDDvfw4McGKl3ehN8OnMs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26uYF1pANnOYijqukRpllmlpjrxjI1fWrZtXJvBica1w&oe=69F60763"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxWfkLqsBBoQ7kNvwFkMLHM&_nc_oc=Adosbq4Wr-rb_tcAYmOl-h1ca61TeILHzHkuIhoZ8i_Y5uyhfAzPxJ6OeQT341kIyzY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X3l_qTz1qDBAcwLqXRIux6Jyz-_oI-PATxEBef39yEA&oe=69F5F4B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX11MpeBcA0Q7kNvwHVEJqH&_nc_oc=AdpPy4F5FcRFLrROVdAe6NzLK736z7GW11PjUXknSrKc12xHd2Xoj94MZ81ZYtqIfg0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ui2HRidUi2fS1uBG8PxnLkHHtmVgAL3I87b3cIBt4HA&oe=69F609AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5blLDB91OsQ7kNvwF_RU17&_nc_oc=Adqu6m6XJP-KMk0tvMaZuDRem4ph5kyn173XTHnvZy2eooC34smWAbxUei0uf3AvuLY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LXPBO8agKUVF2orG1c6BotahUTJQrN8Fix00wV374sw&oe=69F5EFF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuHFIx_dvyUQ7kNvwHHflfP&_nc_oc=Ador92_Fov8E2BRY4CxoT_eIs0GFDQ-CSfE1exjbGMv8xmGF3z2s9R_JucyIdVxcQSY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rr8Y4DRTwKPaWcnwy165ad2tZ3h6lgQ_6So1--JPtwA&oe=69F5F4A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q7BjkBJXwwQ7kNvwGYQ-SU&_nc_oc=AdpjuMS8xadRz0O_HK2VPmMI1qmUc3rbaMupAfs51YqjvEOy7GXw3VF5clgy1vXBpTU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BPq4IjutEgbyX2wS8cNIi6bNugmuJUryz8YmsHOyTqg&oe=69F606FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy4X7HHLjxcQ7kNvwHSynV2&_nc_oc=Adrlu8dXOQprF7wn-RTUU4SFcgsoLzkiCGeGj9u-8fvM4nHEO93WHsxqLumKHaApdQk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BvHs_cYDygw9mHP4dbRV8TXCVso6FhSGrEoEHpE-r3g&oe=69F5FEC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
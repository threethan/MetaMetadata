lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXVnruSTwXEQ7kNvwH5Hsg2&_nc_oc=AdrPI99i3F-W9FXh4mxeDRqBR8QhuOfSdEb6sFuVrvS_BjG8SYBEU1EyOjaI-nmOODI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINPfJCLvk0ghpjAa6sNZ5DcKCoySmCaTWw_4COrS8ovw&oe=6AB515DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgpMGcWwKQkQ7kNvwH5zyYT&_nc_oc=Adpb1M1Y6Gbm0KKWRSIY3Wst9AQegz-3xhyGHhLFxwpYgXpJ-cWhkoo2XAUYHAirgYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLYURfY3IJUydP5bO22xtrSMSSF8vY3PxvNEKDM7Dwfw&oe=6AB530E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFPblfvlD1AQ7kNvwF-AeH1&_nc_oc=AdobpU86NcRckiU6Rg3Gve2xi0_RcTkQNbff8LrgBShtoobTSRaUSJ-zQT3LbGhHXas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc3ipEqUcZeojV912p34IxAaslVR3y9DuRjZVcnhH3aA&oe=6AB51E33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71hdmLhWHkoQ7kNvwEf2pm3&_nc_oc=AdoSO2rk93lH_oub5QYiXl9-HZnSBFIIKdNpx38-ZhpciBaSCeu1JrhCO0uoiqnaPXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz4ZwKwRm09lIzh-gLafhqmG2_FwMfHvv85okVqPnVlA&oe=6AB5332E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR7TqsnicacQ7kNvwHvCtXv&_nc_oc=AdoRQHZZ_FE6CWSCEvIMleq5_qTQiz5IcYao8VQI9LM2wwjHYzbaMa_kL2mIVA41TlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJarNhJ-giSGYqZVpMODHtUoAV8SB0fxSUsE44PE8_1tA&oe=6AB51979"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWnAZB4Ol8QQ7kNvwFYa205&_nc_oc=AdpibHLCb-R65zbkqdPD82b8IMnNi7FnUgk0n4-LXNcyJvsV0FvWvVYExxz28uggbm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr5iZth3A6hm7WrekzihpCZl3HX0ofdcWnw8-cd5c39A&oe=6AB51E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnKOMDH6hHsQ7kNvwFesGhH&_nc_oc=AdrNlPP3nixE4b9asmS47rFynQYG6gJtb1DDtE5IWhuexDgYF9X-rzTFUb-ZY9MhSqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1_BmpiNhMefxkpujjwTiRaov8p23b6qfT-vCUREvWkA&oe=6AB5307F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsOmq-Q0DXwQ7kNvwHoJ34y&_nc_oc=AdpfBTT4tM4Idpk3ELOGx1CpZ2w-l9rE_vsqA5va_H_-u-eHCn06MVBgkSmqNFMqP-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJX3YfT376RnniiFBGrpfhdU1DNzKTmnC-vuQYufM8Kg&oe=6AB52847"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
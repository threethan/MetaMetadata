lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io1PaszfsYgQ7kNvwFlwF3P&_nc_oc=AdohnjDy2S8vpz65CsKFk_B-V83PHcRMokihgNdL6y3pXIG9jlq7392dD-vEvAt5WuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QYV7ew-N2JpF7n3qVi6ek6cYgl5a_IKNgx5MEue7awg&oe=69E0D45A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7zsZXlclqoQ7kNvwGWudxL&_nc_oc=Ado-OB9wVgOwvKklNAV1-d6_Jme0Foxxo6O-6cBw45C7_v-RQrLDBs1gtkN1Js-94Sw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28CkK-a1xH2Ew-oDhk-oJy6nuaahr_mUwPnk8bedB4iQ&oe=69E0EF63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU-meIPX0dkQ7kNvwHUev1c&_nc_oc=AdqR9g2EQYiDQYaHAXZ_H7aBInZv80Epk8hABFYMOKptGpkfhxV1jIsHKpJI9mK5Go8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QrwLyhFOFLjf3T95dD9gnIO6Wj7kQKeSPw3TIWzWH1w&oe=69E0DCB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ7lnPK5lGEQ7kNvwEkxUqD&_nc_oc=AdrqeVTFN2N41yE3S5nSqd4uYXsaR9X-Qb5CJCLva3RYRurMYhK4JXx3T1YWYtFc2G4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VLS5ZxPVvdGkQ7KoWJqqkU579AbD4OxMHV9iMKAe2xQ&oe=69E0F1AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oenzY345XN4Q7kNvwE-bbbZ&_nc_oc=AdrfP_fEeNVNbvGnNOlfbtOlWQuivnYMPC-BBsSe5Z4B0-gEm5311N4SLeJuNdDV_u0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wUrVAVG9pIBAtlfXF4cKYtKMuNZoKYTYgjFnCyrXCjg&oe=69E0D7F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzv94TxLivMQ7kNvwHiZvfM&_nc_oc=AdrEfUseM0a0RBMT6B7ENWjklCur8UAPzRx8Q5Pt7bHhs6VPp0U424BCqwnzfD119Pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BC0h0CQtbNwisL6r1z1EdWiMpt30ri3EDmttOiY5mBA&oe=69E0DCA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apUfZwgjxAsQ7kNvwFZ9COa&_nc_oc=Adqj_OV0HSZz9n0t3-FNYdyZaTaFoIUYfWUWZcGnHVg1A2jPymMwem0QNPva_76Ir9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sdWPhncDg0kMLz4i04famRAcpim6X3dB95zgvo1JVDw&oe=69E0EEFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1SqDIbvDwQQ7kNvwFYMefK&_nc_oc=AdqRaFpAcrF40CftxD72BCbBBPHP-6as-jYNW_Fiw7pS8_GCZm_GxMFqUzl29lMFPSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26y4t-aDsY-iURRYyWVah5XFGOxPQYe4VHujSgmXcp9w&oe=69E0E6C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
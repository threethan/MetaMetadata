lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axA60r4EcZMQ7kNvwHLz8ex&_nc_oc=AdokRI2s85S_z63vSYpKO1FqJDaiBR3f5L5YTATrz-6e11Mv-t_01negwE_sq0cpeWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XZ44ioZEZoHNJfgkVxnIVcNUC-E4WXW9SZGqD1jrQoQ&oe=6A18335A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNuVKcXXA3MQ7kNvwEOUrhw&_nc_oc=Adoiw_qWpeVZ2ggGDvlya-SU7glRzo42PWrhpFNFGhO5LoyfD94qxxuO0CbyZR83a2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56PEKh3DSmFve5dej_aejyQhT0_uewk7PquadJ1TPbWA&oe=6A184E63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV-gQmtwPwYQ7kNvwH9gTFK&_nc_oc=AdqGbzwn5PEthIonUX6RWekGYo_xa1ktDhP_cp8HiSG1BjKOEX5WD0BsJyLFJvdzezA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IvQKYFR3vf_u2jHQS74NeFNmmgb3o_uddcgPgTB2TeA&oe=6A183BB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AT9052RHQMQ7kNvwE67P47&_nc_oc=AdoKWPAcRq2oYEQ9Tl93InHKI9w5iHm-spu7sGo4kI68FwN7Q8pOLYLnhFKAkSHYbk0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Amsn29L7J08gny6PJK9DImVWGSEcc4k-2srH27CRhTg&oe=6A1850AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xvz3E8rxLJ8Q7kNvwFk65up&_nc_oc=Adoq5SSTpZprOTms7uG96yIPOsHsiizoKwy6pEYnYP2YDzbc_6gDzGiQ7kUL0ei1JPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76P7fjzS3S68bXpiGD98MQLgrMAgyq8S54fta14FaHvA&oe=6A1836F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9--XJYzOZkQ7kNvwE6kbEQ&_nc_oc=AdowiYDEVljjPlpfOblT2GIznazlxjedROBBKFk22cFHFrRenQjGPUFBaQGiT4CMdVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42_ah4yENQd5assfJ3J1BfQ2cy-X1K-O2mroxDpSO6Tw&oe=6A183BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZGhrgoL-skQ7kNvwGp0RRf&_nc_oc=AdoMvDaWhszhhTVKeTYpt-LfgMkbJR6I181JX7gUHUaHkxYOC7gWzTvQWP-0zioqT5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hiE25nFBnjkShBo8Tk6Y7cvBL0DX9J1HgUbymiYF-YA&oe=6A184DFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG4yeOTMwSwQ7kNvwFy_eG4&_nc_oc=Adq2hMskGYF6Cyv7P5687yPG1ud0j9_VELmUEXUE4EKA8sAoMy2rBIpSS_UKyNy7dMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vabOkA9oZ88mLtFGBiDyRfy-aZxIppdNAX6roTz_mqw&oe=6A1845C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
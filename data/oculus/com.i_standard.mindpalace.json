://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maZB4JfKCPgQ7kNvwE7BfrD&_nc_oc=Ado9BlMWv-hezk5OznaAbByQR1aC3wff9gVz25nLpnmHgDXHvKGfehOTqkdv9obBYjg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1HXcwzBzYNcGcFajOrK5ampCCDymhB8vQiBM-kJrj6rw&oe=69F1F7DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZl457K674cQ7kNvwFpp2qw&_nc_oc=Adql6FArjpAKQxLchoFrjIqYzCiy149y0G6CG2R6XTb0uroArfEB5Ceyjr_iXlv4pT4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NCLLau9zcrMM0k2hlfg1z3QWkekXizsHdnh7E-sLyyg&oe=69F212E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm0ymL0nnhsQ7kNvwErebm1&_nc_oc=AdoRpRzyNmyU_Ok_LPha-fiLKhA6ERnHPIbjFNbPxAMLMIGXg-GKWi5qkvMWeZj8aIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BWeA76JNrdDatUtjoPy3uR9yWnYj2ZeBDCRKj9nxn-A&oe=69F20033"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB5mqGtMG7MQ7kNvwGrpkUZ&_nc_oc=Adp1WhGez5Gs2P_3U3O5kfVtktepq1RDjPjYMxda-0ZRzB2vwqkuMSfNYtRF47f8Dd8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3edgYH_ETY1wVSGzUbcpnfsL6_i8E0eCiYZdAtx8Q7XQ&oe=69F2152E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3eespaZdQ4Q7kNvwG2axn2&_nc_oc=AdrHNHLytWqbeUL8QBl-f4fbGK92i5uVpYdpBBBTYUAeu00O1T2mzYJ0S6C9YV1QSXY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2CIJKc-IA1LFcBFirOEhX5ybe2855L9hjuhC2SbwtIlQ&oe=69F1FB79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ706jgbAd8Q7kNvwHj1hus&_nc_oc=Adq-aksWSaAbcGgnGnnd3yLb4T_RTUoJLHngeo3qXQESXhKD7ss-lIEejkIwelaeePw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2oQQzcAvDEBZ5aWsxJGWMMyK45tLPHSEPgQPWH8cHrAw&oe=69F20024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S0hZkNS9wUQ7kNvwFAE1Dr&_nc_oc=Adoyex0JlPgZOfhOkYEbR6QoxxXEzF0LZKF4n-Xr5_bqN-K6gDGQQYSutaFj1TNUUG0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0zmdl_cL7V-E4OZwVv7Ww6q5GwxykhGqb8QxI5CRFlng&oe=69F2127F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbW7dEhjc1gQ7kNvwHxxMbf&_nc_oc=AdpJw-KstDxLX_oihhmMs0pxxBpfpqOpJohys1w_eSVgL72zByK3Gk5YRkcsnlNoUxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HXLoWyZ2Hl8f3CaSjv4meMsmRMagXHFtEViQFICsB4w&oe=69F20A47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date":
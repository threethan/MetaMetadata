lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GOWac4EkXwQ7kNvwGk_AeX&_nc_oc=Adp4-QhcbrcJSVCnP9DIb04W_kYYAodwE1xnGOAamtFk5QCAGfz6YzJvBiDo1jVWkvs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af666WaZ3b5WGwN4obdUNt6pRMnWn24Yw0FG0Z11uzwg8g&oe=6A1C601A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzlfw0VEt1cQ7kNvwGRYZiB&_nc_oc=AdqFZumSqql0wyVqAv1_sfPITCelk_JSp1YCGNDE58CrxDs96VQFarOjfaupfQjFDMk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WwDvxU7OBUPxWNFrg44CJB7wdhngwKHszjCol7SLhjA&oe=6A1C42E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwAwD5VUiPsQ7kNvwEm7BuA&_nc_oc=AdqvGt61ylfLhFG2T_aswsV_rs7ggKbb7G2nv3J1kRWL_zicuhqPEpe5jhm0hW1WpVE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J6RcS8mruqdlOn-6r1E3P6YBknrWX0Xi3PANsIHuplg&oe=6A1C3033"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEY5IEn21yQQ7kNvwF5rCdD&_nc_oc=AdosxKWO6P7gVKAkHAqOY9a6dJCIhlQHweh8e9AfF34tn826y_NLi8S9-1YB0FmJMtA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mj540qQ1TpqOFIvlhHspz-KAXRSSbminmINFV-Izxpg&oe=6A1C452E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKZt8frM1TcQ7kNvwG5K41S&_nc_oc=Adp3WU4itpPmTXblJNppxhlu6UbA9ddKVeLyNME3Pp9GkLL1k3-Cse6gsFks8aCnqAg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af557dDCBOWx3Og_cGIvgRo7is6Baau46yH3H3zixz-Xgg&oe=6A1C2B79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_PquD7fs9IQ7kNvwHHQRRq&_nc_oc=AdquqLhod0LH4pUcjc3KoKVPwpKA4QMMrzaFMB5yZZOM21HD2Jdbx9qf9qOTUpQHlFc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kvl9HkNr5QikTNkvFQt-cgpk4o2fXVoJFmOpTRj_mEQ&oe=6A1C3024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2eAAhg4CTUQ7kNvwHm8Gzo&_nc_oc=AdphbYm27VZeQ-2XqniZIWK2t4ZTZ1Y5YYsfqSXQ_tOgcj9HcidHi9DQxXVAZu9dib4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MOFAIMVxFLuFCnLETekMSDJmRdtDpsfKNmlpU-BrRmA&oe=6A1C427F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh7Av3mvansQ7kNvwGn3ZDK&_nc_oc=AdpHOSGMnkVPcVFvTC2U6TQwLw6J2Ah_kHrbo0AqRGkyObBSxJg0G0ENpvLTWmmc0dE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51LP9La7Ou3wLZW9Tvbngcp9m5VWcxF_HyJUrkuAd3hg&oe=6A1C3A47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
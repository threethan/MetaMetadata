lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrMQ0G_B--sQ7kNvwGNF6mi&_nc_oc=AdrUcvaWPaET4hcsDc1tewM4zR2dC1-WUp0BuM5LsUBCKsgqMs5J0e9VkGwon_WdUqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wt6Cf8OwDWcaPbpLEXpuYZhvs7FvHAs_KNkePiDpRow&oe=6A0DA75A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BzPP05p05IQ7kNvwHSw3rY&_nc_oc=AdrLfkr9hJW5DPxezsvE010S15h5q8jG75zFVVV7pnRlUr7vaOay1o03sRLH-n4Bw4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GLCe5bs4OvUCAkBKnHJdW7eB7NcTd2Ou323OfQaGDRw&oe=6A0DC263"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2faAYrt4B48Q7kNvwH29iDV&_nc_oc=AdriZECrVUe6nW3CvA6CBjmDb1tGR98FcHbTTaBx8ax_uo7j7JrVBdFAca6baZfDrY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X1xQjL-z9UTuXcIJmGiJA0Z020ELoii3o9Dru9YxTyQ&oe=6A0DAFB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtYSC8ZLcRIQ7kNvwHXQLxq&_nc_oc=AdoNzWkPGe4lsHL16dH-KkXBpy4ped1EIII2mYgGYFHpTuE0OUt1t0bBrHGsdWQP164&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SFsDbCfgHX2nwJLOQZ8Uu3i9ueV46EPhSAyW7kQxFow&oe=6A0DC4AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjCznD0nZYgQ7kNvwFCSY9X&_nc_oc=AdrfGqx3Xi2wCXyKd7NiZwxJIxy3_TgCUr27806k9t4CL2sVvAdqT76hVjSl_BBSsDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ColYr8lb3n6u8J9QG4wWYKFH-xwtJYSLwKvcA5sCt9Q&oe=6A0DAAF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZhoCrVthrgQ7kNvwFMOdvf&_nc_oc=AdrhACuz99u1GYCby-TSVaoUPGO__sfu4nNieX4t6MMtaQWx3pwWiZr4f-_4koQUviQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af417eMFf_wYxS5rfJFoXAytzeSsGr8TfT_Ln0q33eJOEA&oe=6A0DAFA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch0YYLP-lCQQ7kNvwFCxGpn&_nc_oc=AdrxEmm21lXanJ-e3lazJtxzN5lPmOs2ga4TRis1L5A-PZLudVnkCxKwj8vEecRkdeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42PE7QT1QqrsAqveU5vETL0sSyulUX16xEnORhuefOlg&oe=6A0DC1FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luyezybEmykQ7kNvwFguJdU&_nc_oc=AdqqQeD4zXWTju7xUAXZ2n05zObkf3LLSvGk9QKQHb_5FbMDpTdHSDVH0wQcHbl_49E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kBDqSDiZ1x0i0xNXkhBsJjNdrVshOWz_Asy04PT5J5g&oe=6A0DB9C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
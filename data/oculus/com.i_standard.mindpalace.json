lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjT6OqbgPP8Q7kNvwH3YyCL&_nc_oc=AdrL1myZ65rnCZPHgYDRhfSgeRms_zndIdPOUfxR3hPVFNOfkyc6uDI3y-Tjk0CaL4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8CcgApqICaw0QJ1Ce9GPs2COUzDkJ3uuOKjOyz3NSuw&oe=6AEF501A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efzgxG9Z5_MQ7kNvwE7BGre&_nc_oc=AdrGiBpMAE_j6QFhRqGww1dVsVshGH6j3WuVlhIU6-9nfLACDMA5t8_tugdQKU6aCFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKhRzky_osPbegLAi8XU8hsyMQPRQjRL5E1LhIstwmHw&oe=6AEF32E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmLegLmnNIUQ7kNvwGmFtUj&_nc_oc=AdrQHryFIcmpid2ef2FtR_PxM_kNG51O663xd0kLubagwxwIFIexZazTWMz_qWas9SM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzlFVor6ZGQKIQzzLqkNIEPxIAKTd82ldcYaqIw_C2DQ&oe=6AEF5873"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3ZlOK1iqvoQ7kNvwEcIupL&_nc_oc=Ado9bvs7DqWONNe4tkGOHHOD6-gN4PYDLvuIhU5rsXG7cgHnPtjIjYR9_LOfTqqlyvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7XDAZUBuPazpYOMoc7tziGrXx1aM8bORQRp7j54G5HA&oe=6AEF352E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVU9k-gW7pIQ7kNvwFEN1YO&_nc_oc=Adr3GTyl5qnd64JSXlixEEkT6IjSEIKZI5YD4QmzCvFxNzj2cR99DYQcD4DFBBL_-Hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStCxRmzrxpr1GD4PE4ID8Pt8WqGMmuncYeRA47fu8F9w&oe=6AEF53B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpcnsFfxT3MQ7kNvwHcBBOy&_nc_oc=AdpTHFbzi_hmUnMPZRygx7-lStcqIH4itBS_2QrigWXzOaaFFej0G52nypAt_OBBB5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4IiaJXCAnFiTTP9_xt-BdfZTlSf_970A-V2gz4phLRg&oe=6AEF5864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIatC-Y7qPIQ7kNvwFG0nxM&_nc_oc=AdpaVJOwh9ahtmghxEhT6EDUnbdgASsxW3KxWt_8lqSrr7wwfBmjuRI-1ZjTR3ZPjX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsfy7zGIzAD1Q3y3yybfjUq5JJytZG8Mj6hQy4FcQc8Q&oe=6AEF327F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aicJMabSnY0Q7kNvwFY9bfG&_nc_oc=AdrADQTKwEFtVMpmg36PxwX-IaS1vq5NFakeLfTZVz2jxWgUibO79Yvy7RfigPnltQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9fIXG4VEUq6AqtQfObN2v_iEB83eNZAy9vwgI-PRm_Q&oe=6AEF6287"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
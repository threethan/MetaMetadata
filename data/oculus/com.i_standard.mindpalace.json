lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlUUGrBATEkQ7kNvwHpZtLf&_nc_oc=Adp6AXlxozt0lTahGKthLYf1mMmuMoPKsLHD2WoLPmRjnWcBH4gWN0iyK9wojjYwVjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlKZYyICfAB_umSWOafUZSLtxeBxEthvId_xpKin0zhw&oe=6AEB5B9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Njkasq6IfKAQ7kNvwF_iHxT&_nc_oc=AdrqKHC0AU0KXJshaoGALp8E0D9I1y6GAlL1v7sjwRHTtKqo6Sw1FmME3VHRXBHGSTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnFeLwVvFWtrcj0VuH9EvZzN3bCA1eVhMxYwChCjAc7g&oe=6AEB3E63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzWUe91fzPQQ7kNvwGss6QE&_nc_oc=Adp-supZ7ShxsJhZwhhIPBKPwJY9q00iCN_j6JS-2J-O1zVfgBov066BJDsHeEVw7gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY8n3577hlB0w4yeTNF7TsjwoJrvyGe3I2ign6TVQkjw&oe=6AEB2BB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8ZxMCyHDksQ7kNvwGRFNeA&_nc_oc=Adry6VCgYcTphzNgJ--TB2iRgmlapweeK4rZNHvNPK4rBF84HOz2m3IYxoTEvTaiwEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTigyqJ03m2xRTzYGv0MQfrh3m7qZCQRJWUtUfN_1wm1A&oe=6AEB40AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be2WcdaL3WYQ7kNvwFO7fCA&_nc_oc=AdoRAKSkBn3W3y6nBQrCGX4Q5MJE0P3ObNDv-hSYf5QlvkVTH59nIwawcl4kn68Hi8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Qn2uziWAetXXnxSD93c0aXZn4VP0BF7q1fhYF5wYgg&oe=6AEB5F39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKltNl9zz4UQ7kNvwHXrB5P&_nc_oc=AdpxeT82OvrLEg2VOhhWp86p-cnmi85DS7hPduVZRrWHl8ISYoCNQpOnhVhuz1ihtyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkQYXTwL13Pm1YKmWwJGH6mJd2ys_Hb-2c2GE1fx8WAw&oe=6AEB2BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwMV17stRSAQ7kNvwEMpFYJ&_nc_oc=AdoLOmU6jhLt6t3X7DQvjZINoaDV0btl7wtNdnojoZLIWIQcyM9lWmvzSUzH3uvNInY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTosKq-N1Mvyv9nkpn-KBk_0CAyDcQLOlvCKn5-NzBaw&oe=6AEB3DFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSmveni-CZMQ7kNvwHJnR7C&_nc_oc=Adoi5F6Fa9Kg6Z2G8fY8jmaerKl1xby4iA-FySMq4JolQfs7KUh9takQi-QyOIyMfrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKi-hLIiurHtR8v-msU9-D2O2j38mPWTvKhSMkUXTkgw&oe=6AEB35C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9CDhxewQwQ7kNvwEUfHKg&_nc_oc=AdrLx3v0VRFSD3gn22l3skhszz3xPPHJAQUqxBfh9HX3VHbdc2z0CbcG7yI9p1YtOGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gz7vBE6khNhaBa81cg65PNTGapPmaY1jrQksORiROXg&oe=6A3FC05A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Eee9Kc2BnUQ7kNvwEX5JOL&_nc_oc=AdrPueG-6JGVUKgEX-nr-vixh7PC2XAB8DNtB0aACoUZOS3lJklI11-PBneJxSs7L68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tHhnXUeZREgS7HR1KMu_JZGS7QgMSn1mIFqsIgg27xA&oe=6A3FDB63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibI79VabK9cQ7kNvwFvD_lO&_nc_oc=Adqm9g1WByRoWuxfWcfr5dGP_dLkTa6mis-FJUimliPz8meta7DqG23znw-9ntEklBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5t2yuqodP4UT3Uqp0IJI6cXxCEMGRq91RCBm980-DLQ&oe=6A3FC8B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3-7P6sWOWgQ7kNvwH5rjH0&_nc_oc=Adqe_l_u9dpsZNarzS9dqMMUHEqjEcgPHZq61bagtBhyX5H3dMNL7WPyPkJsncWZ8nE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-msRKSZwszwcWFYKb6B0DR9nj_skS4z6DKnVmq6XNipg&oe=6A3FDDAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fGZHprbnLIQ7kNvwGHkdW-&_nc_oc=AdrKjhI6Hoc4-76p1eOMCQzg8C4YH9MW8OiFR3xdPp1khzVNwtx7QQktlAgKeKZlDGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sTyTXxxJuhjKD5efHwz28ubJoq497o2S0xBh8AY5FZA&oe=6A3FC3F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5AARVjgIbYQ7kNvwG8YxX-&_nc_oc=Adpy21ZDQMDOJ7GdjKW6Lc4EwgJDxVD-_ob6D3pgi3IaTGQ02HKYiXWtkhAWcm38vjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gxYcVrdvYQHVnEWiHMRCM4ETGZLUZU1p5Qw8fS7TAfQ&oe=6A3FC8A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAIbRIHCICUQ7kNvwHup71N&_nc_oc=Adrf6a7F-9dFpKCUlyqxAYZBlYQrq-yQ4MkL-6vpqCCGxO70sDeej-M4AhcbvmuDPU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XoDS-1o0g7KI48JHA6Ngs9OVY4ozPXkKqpzC7emXpuA&oe=6A3FDAFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPSRQWjMy_QQ7kNvwHVBBJj&_nc_oc=Adr0knLqGN9wNoC0VFKhQx2WE6ll1UWYMk7Tj-drg0dlOPBJ0OhPgH11y1PR0FVLhxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hbCSgsDYddPUEaHqxmwcKZZ2c72XuKW37_AaBW3HsGA&oe=6A3FD2C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
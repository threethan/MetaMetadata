lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsBBVAiJ6nUQ7kNvwFe3ZhA&_nc_oc=AdoZ_xYnHyHyZWh3ABa_4mqO0hbvpKuf8bypTtlxyWHSIo4mFflsmeNZj8kaiQtLhNY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O6TnVr2KUGnGzlRVTq5PYvo59506A-eFNCYm9fpw6hg&oe=6A2C321A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxi3J6NDBxgQ7kNvwF6Jjkd&_nc_oc=Adq11dIa-ECAn2D3hELpTkxNIwLpHdv1ulPdm3Nctbp7qNNsaL8tWoZHmxLMkQNhCaI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IW2SFoCXpMz9-DGu667lZY_VoVJV4uhvWlbkpmMdjLg&oe=6A2C14E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ7spXMn6_YQ7kNvwFaOWWy&_nc_oc=AdoU5YqTEQCmS6IKfl-QMor9oHWsDpaIP8D7MaIlulXMQRndRnjhQIKumBnAaQiA0ss&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VjBgGXedti8op39Dm9lfjp5LRD8vhsxg33I5ODWfNCA&oe=6A2C0233"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdHFl92Da8MQ7kNvwEJFV4o&_nc_oc=AdrugxJW4RX6mAT1Fbvj_9I9JdHAJs4Xy716SypYkH1q0ty-bsd1UJmvb0YISITqrKY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YSCmSm6f30Km8yvpXhetpEx7hQbhDdc5KZwhUZXHODQ&oe=6A2C172E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRozh4xqtkQQ7kNvwEA4iIU&_nc_oc=AdpkZhH1prjEkVQcZpz7eHLPou6oNSMHfSe2z2AfH9VNr6BKRa4A8fV2TEWG75gKdQU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aHggxsuGpzpWanbY4Dz8XgQN3Rj6zpOhkjXbtn-hxzw&oe=6A2C35B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwENHLziglgQ7kNvwEaXY0G&_nc_oc=AdoAtDx5oKzOrcS_Q4nh15OBti9WZiNxpsskxWIjs6yn89TREvVIjtnKDgkYnGlyZhI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vn0bPm37U8xtzDk_ZzjH33f5NzCTYK_0Jsn5S1Wkqag&oe=6A2C0224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTbQ-PW55KoQ7kNvwEgSN0B&_nc_oc=AdpqRJ8ayscrFwtFFCuU1DJBTxkDoxEh-hqsJLcv7PIL91giZnstAt8veAcwPR5PRJ4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HzDwFaGm8QCEFAY0M3gf2cZd4NcJr5kBindZeiMvJRQ&oe=6A2C147F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1TemXeORM0Q7kNvwHncyYh&_nc_oc=Adp2Y9N3Lb4KNFI4sYztC_PFwbFlMlRN6eHHLsn-LyfXFbQIkkQ2F59ZoFHHiObOtDE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TwXTwbG05pB3zE9oqZKs9dSvJmcvKMQtIX7qjMLamnA&oe=6A2C0C47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
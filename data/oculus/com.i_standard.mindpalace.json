lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ryfe4F6PgC4Q7kNvwFG-DE1&_nc_oc=AdrjsOGECasPd6hzHRPga_pbTqK0qoOJS4-R5oec7a_IUn4B9c9-ihBtJb_0fCeVEMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLE07PUNoPXY8HADiboGbTQrIeDabgKwaUjiTZ930xYQ&oe=6AB90A5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-owMSGZb61kQ7kNvwHJpIHm&_nc_oc=Adq4jDnvaPszmIaZZukM1F67XnXzup-h2UD1ZVSSueclMb2SMT1rLl_hso7zPIVCUsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAukt4_oaKgAQjU1S23HwG4a5L2ghUgOwwA8a-UKbFjQ&oe=6AB92563"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyhtGhq2HyEQ7kNvwEO0A4p&_nc_oc=AdqGAEbS-r5DGFS5QF0xZXfcwpaCBMFSFLZbtZ-EhXoj6fWvxc_Vb5uegTK9BV9V0f8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx19rA8MAFLvr_2C-SGzpi-Y8zEhzaFulHS4fvZFKKjw&oe=6AB912B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TlI8mb8pLAQ7kNvwFiVgSH&_nc_oc=AdrzUYOzZ0lWUGwLFQjwowEXpKeTVRJ5HMCcEfBrRKWoOHg9GuX1hGtrBix2N2ovoUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbexcwd6753xRQ_f_Keguq8zp9jVHgYCR-YO8Xlgb4zQ&oe=6AB927AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIyUwVbppIwQ7kNvwGcdmPi&_nc_oc=Ado9cWbbRl3H8hKnOBjz6bJpZkH2dZMAhzKImozsLmgwvZOGD4r1uw2LBc4zLaIJo_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKal_8RAJ2fGG8s57z0R8G6XGHhrkpA6HG8LgIw77DhSw&oe=6AB90DF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNFDE0rbKJ4Q7kNvwHCqoMt&_nc_oc=Adr39Uf0OTP7rvx9cXNhd6NPQeEdwGwb3d8OMQnvMNHxvCAHx5loYZE_ljNKJrQo1GI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJr65I-bhYy9KCervlPUVmAM_xMRTBG93JYY3N27XIuQ&oe=6AB912A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_dcyc3iPEMQ7kNvwFMC5tV&_nc_oc=AdqG8IP9nXOCHhlj-YW1mZmQ2qIUyyChPZAiPjFUH_WhpAErccJInAN-ZHtwP66sWXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcQeRp4AmFH7G3DH9cq4RmCtQqEPFcvp0gvyxIXE5wfQ&oe=6AB924FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00jM8fw-YP0Q7kNvwHSrVtO&_nc_oc=AdrZXOmI7hbFH7TOIsv3l629gXGnc-xc6kpbQ_IhqWDX2zlbmsXAIS5Q7jacms_-uhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNMLMlYDJqlWaGKrRMSGqBuG0mAJq-WTo0SzDfG0q65w&oe=6AB91CC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
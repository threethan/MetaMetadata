lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjT6OqbgPP8Q7kNvwGInMBy&_nc_oc=Adrvw1kkFqKQn3lcAnnbH5W5cMMSUn3P1V0Y3WJPWZqKJEiXanLYcX2KlMcxkzkNctA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStKHdt4SCCojfpdQU-eMRmGGHOENkMroz0MyaR6EaYIQ&oe=6AF1F31A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A07tTJZzt0Q7kNvwHlkLfA&_nc_oc=Adpt-x6Z9LVsXinCsnrPElpoaYOEq6gAd60AEM8n6zUDBe8dgGZDekbx77k54GGDdhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiNV1w9hP8hMPdFC_MRoa9p3jeWrLyFcBUUS1lp9W31w&oe=6AF1D5E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmLegLmnNIUQ7kNvwEGPwJp&_nc_oc=AdqCeWbQPM512m3Nq7VJ9Y1_QWQ2T1-fwHedjgIjwlXzlPAT0tpY5ajgtlLhhtv8gVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQno1BTcEyQzFYU67VjkQi_VcJNcFhnfERqOZLEQtoKQg&oe=6AF1FB73"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-yjRkkow2YQ7kNvwGvjvHl&_nc_oc=AdpDYC1eTh4OJjqCmSItTHFzMpmX2iTI9Hrmk1ug4-qRX02XY603rpUTFvGi8AzfpDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBjastPwymJWW2xMbkOYJgpxW0JgLe9XDKjyoxJo6csQ&oe=6AF1D82E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8oiWo1WalcQ7kNvwEVBqk6&_nc_oc=AdqlrLTDqVHrCYeszgQJZur2FraNPAzketkj9ScN30Z12vtxNJOs8dEQn93ONNZVUco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxMK9IbBDBOxQqKMA1tlrt0RNqrpcP-aCKxKz-zWMXhw&oe=6AF1F6B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA9HOT1-1U4Q7kNvwGugKQY&_nc_oc=AdoGajmxQWJ79cFCm511c06QHHwWNqf6W8BUE3ENvhB_MczEvNK_oTWhtVlfdn3TKrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6P6q3pUBYdrVgrmqR0RTdkj-0eJ-FFWm_hsBHW8xRXw&oe=6AF1FB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QsIK-99THAQ7kNvwFLsDaO&_nc_oc=AdoP1TkOELyB6AXk2Sn1Xqrlv7mE-lvpKfI52Xv6Qys9P_aXT5eth_BrIE47nAdlM78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_3cgfXY6tiKJ0dWU_vzV1Op1agNMRci0OAn4JF-Najw&oe=6AF1D57F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aicJMabSnY0Q7kNvwG4CW0K&_nc_oc=Adrt2Zn6GvIZt_wWhk3Ft5XVb6bBYu7EBi7wIm5phyde_A-p-qbxc2CtmOnbPtH3NpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHxO7RGugcma-UCPABQk0SpGstbknGkewxKsB6hwCUHw&oe=6AF20587"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvqILiCbSNcQ7kNvwFYEqII&_nc_oc=Ado7PZINuwViXOg9DnF8TlVc7yd5bZ6YAmKKto93nR7fIA3pold_uZVXn6bbeDdHX-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0u-k2ANhsR7tFiHRShThRyvnnI68Myp4LYak96hxQ8w&oe=6ABBAD5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wg1LvYzZCb0Q7kNvwEx88dO&_nc_oc=AdovtIaDdjTYf4LcwpVKTl99Tjs0WmYfqWRqIrpPmcvXuEn6WQj2LMZr-7CcDrZowJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTNc7qAILYeCWSeZosP3Lyf1HSRMQb3WnZz7SosWD5Nw&oe=6ABBC863"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3r2Sr-siqoQ7kNvwHqL3yF&_nc_oc=Adpc4KO0V3969uDCjJZMZ2lpuX6jiKxVzIyMWCJhfAW41Y67hpeOeIkGkJtjVduqCUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpnBse0a3IKB-OdMO0t4TG2cbBFIkUpDq58cetxDp7Cg&oe=6ABBB5B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtzX_J_pz3MQ7kNvwHA9WOA&_nc_oc=Adr3SUDXfr1n_rT4qztkj5PTWmJFvxhATDhwvxuXi2QRbNVaukYFPzE7rpiJIT2r8Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc19N5YlXXGdk9MnqD-XoDwhyYeFQJk9b8jkhgFE-t_g&oe=6ABBCAAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w7vQaPL4xsQ7kNvwH5PdoJ&_nc_oc=AdoMm8OSR61_qmMHyewwpLqiEYloori_gRH5w4yZr9WtwZSS-h5xFpz3-o0k1wwjk0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJol08nzShbrs218jLgZ-6n3sBslw3_n6opBscOJW_QeQ&oe=6ABBB0F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5agjg6ZgEUQ7kNvwFTdKC7&_nc_oc=AdrbhurUivHv2kFSDqr_CsoqlGEfz9VRVon0wN1A9L6OKPWvTv4AmlAj9uE6CQRyzvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDmN1bs8T6VNa97YtBbdYW6bFTFa6DDt3bltVEUQ6VJA&oe=6ABBB5A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BfFCTvpTfwQ7kNvwG4gHHD&_nc_oc=Ado0RIS90Qdl2P8utg_M7PyyWlcfCPE5DQdtM9sv0Y6IsNoAbh0g8EWWz3wNzOjKLog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3kukH-rl4mj3RN2z3qHOCJk8-ZtYeFwBsm2Qr67u1fA&oe=6ABBC7FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph7uXQXJAIYQ7kNvwHw_EEA&_nc_oc=AdrAMRmbO7V4wflUbCGPd7vHFZBNlbow1z5RthzyGExa1Ewdw8T3ji5I0u7fYwWTC_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIDU9FnB_3JKqOC5vkSF0AAJB4SIkIwH1QupADPTThxg&oe=6ABBBFC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
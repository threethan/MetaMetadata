lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC508laf438Q7kNvwEU7CSZ&_nc_oc=AdrOXiMZ-lzvrqsDsoEnM33x53rexV4hl_lIKvpUBIPQkqfUGYP749tQeRVR4uBJLLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcL_ApIOU38kRnR9mg9w8Wc4ZvB2hWb9f_Ocpi9KEvGQ&oe=6AA543DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2flAbFUacdAQ7kNvwE_dKGE&_nc_oc=Ado5nopCmZV1O5OdGpcxIkMd7ObhZ7Z51gU8j7zLhBQ3wX6uUINRizGYVqjndQONcBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJi6EBQ3RQHCflEM2BLnU9LKnpXg0EHps52cM8xpLMTw&oe=6AA55EE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPtfXNmklOAQ7kNvwGeumo9&_nc_oc=Adr2iuxRNI_xROaYwxL1MrQJieDE6PT9fKUi7653Nq4c5B1Xhz0IGfS6wBVYjJtkiCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-ABG6hiFY3Vxwj7mst2fe1L16kPZ3mNelFaY0TRsiLA&oe=6AA54C33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJp-nyg2X6wQ7kNvwEI6duJ&_nc_oc=AdoxBeEGmap67OpA5wjoRvwqFNDeb1ea96DJyNzz74rEHvVqt9nvhvJrFVpYPoHr2xY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0tkgRKq9QiEWRSwSOvZhzO4h23FToebS_RPKen798gg&oe=6AA5612E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvAqrZK88a0Q7kNvwEntk5o&_nc_oc=AdoM-afSjtFXYYvjWM4Tep2EGGSUecbVfiXqJmks68RHkLhIiIv4vOtP6Jvb5XsKyog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKmDAe69A99kiFMk3t3b20LaiYOYEe7iM5cWG-I-Cwdg&oe=6AA54779"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tK4hIu8jN4Q7kNvwGpj09d&_nc_oc=AdqfotLiX3PNlHbYU51wq-u628SFTJf9ULVoLNay9xSIsTYCOg6P7TapeZ_YsZp3hl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK85we7Msgrw-gygKRDJfY0k_1HuDO_FYJVEI1bRxcFxw&oe=6AA54C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znHO3x7kLzYQ7kNvwGtNuU7&_nc_oc=Adq1lmKI_A_iXUoGCmR9kRtn2iyC7iHTgrsbmDkxPBEozB8E5487Xi3r_5B5KcGS88k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9P47ZfJXwRdN0P1y1ew2xxfFOPuKFsCkxfzb1s-nLFA&oe=6AA55E7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yfiddwNPRMQ7kNvwH6NHNm&_nc_oc=AdoOg8SGVkC7c8VT2ZYebFBywV_tq9sIL_k8bjQrwd_bVhIyNDJPvkhSMJ0GZcxS_io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY0IV8c5MyaISNfQmxQcqY4HTNXK8XdY_geKHjtHCQcw&oe=6AA55647"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
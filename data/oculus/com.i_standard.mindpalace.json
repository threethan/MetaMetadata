lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io1PaszfsYgQ7kNvwE2Ictg&_nc_oc=Adrrn2eqBQOl9LK62GxZwrARIojDPVICZUBTfIFyXoVWgEuY8MAFiglCcKWgmTrvJcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JfLg-q0YdnzWuI8qoM6Ob7d79DKUSCKZfTNOfhgZ4gg&oe=69DF82DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1Vgq3vpRd8Q7kNvwE6e2TH&_nc_oc=AdpPXTXgJjWPuDz4dz-azWC0QCuWIscN1bvfNPC-om8xr-oO7hQINbrLaWEScSy9xow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Imqzp1gnABh9HmRjMgQAUzvpXkeFC6CyPuyrnEwahRQ&oe=69DF9DE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU-meIPX0dkQ7kNvwGPbvtr&_nc_oc=Adrb0v_EML71VHPJQEXsMS70Gc3UpcsXh6uveAv6d8QgK2CHmfGbXABh46jIf_ci0yw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xXAPUis7W-HVA0TTaFeXe7voG-lyBPoDINc0ehNQb7g&oe=69DF8B33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eZu-RZHojkQ7kNvwES1Jp4&_nc_oc=AdqaJpNd8FCZ2ryn-jglITX2P57Eb1LaRTEeVB6Y-LFEs3bSGT2RKAaZ_EIKNXoEZMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LPAE2e5Ibvap2gR1o2_lszyNuYkWd2PXJ7BNgV2dfPQ&oe=69DFA02E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25yq7DNlmacQ7kNvwEmNE3W&_nc_oc=AdrdBJPyVCM0NhDoNVKChUfz0EMHlex6rGRpDOBJ-p-jMCtdqV4J16-d8YEvsAg065k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DQZt59KRw2Twjw_ynoNRLV_FD-czROde2tlj3c0x05Q&oe=69DF8679"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MU3KAXMXJC8Q7kNvwEJZDsm&_nc_oc=AdrpqFqmvxuPGkicXEJnZ5XKYDoEbs54gPAQycGKQW5MtksiKWS5MurRY-AFtfOft5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fhCwcUNYvRxETEyhx0n0HnfKiebi9LWJzJh3e95bfsg&oe=69DF8B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-M0UBeZzSsQ7kNvwGIJ6-g&_nc_oc=Adr5dBat42HsMsPooGUTeKxSycDZLQgtS4TGqgSJDAGwIbkFjEABuYSrJEBx8fgdmmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sEFfYw2ebxWsgkbD3Hn50yb_5NEyrByzX40TRgCtlvg&oe=69DF9D7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1SqDIbvDwQQ7kNvwHzSOS-&_nc_oc=AdpiGLdoQZKaqPVfrNpOonvCe9YJD0UoHyVztPg82aWaG_-Rp90pRMamEPXIcC0ddaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-MQksU5KgMFA2SgUbtKJW_K05KzuudCsF6-K1Mq2onQ&oe=69DF9547"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
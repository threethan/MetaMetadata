lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GOWac4EkXwQ7kNvwEg9klS&_nc_oc=AdqIFMz_ePwppPkW93UnlFmVrE4NPie9AC6YFySvFNXJXQbYCSfIIqqNbQk3AmFIDHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VUQg-AmnemBAePWoOvqjgtMrs0B1IjlVf1OXBu_D0Lg&oe=6A19BD1A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNuVKcXXA3MQ7kNvwFt1Jun&_nc_oc=AdrVWWtGh8WhJ0iZDmLQZXgdl1NfvQhcuZpIXgy1BJSdAiWe_MTX-RXkhD0fflPNGXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h2SCqrDozkJwt-cpJoCD-lbhWU6neuY1MjbW_G2aZaw&oe=6A199FE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwAwD5VUiPsQ7kNvwHOyM12&_nc_oc=AdprzcQrDyCCLOQcvXV_QqsekusVkVj2waeQ5yMXSRPGUul8hdxVpiHJ5-daIjMjXJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TBbnjPQgHhg4tkUwvN6nLfve3HgR-3O6v5JYex7qDBw&oe=6A198D33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AT9052RHQMQ7kNvwEfLCez&_nc_oc=Adorf3gd1lzKarfTQdWO5NZsDelCTRvRlr0r_Zjo4YG7y3szN4_4rWYOhWOuXpYGCos&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qTvPsHGb-1b3W3qp2V_0tfl2HGXIejPwtzXpiaQigJg&oe=6A19A22E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xvz3E8rxLJ8Q7kNvwHFr9Di&_nc_oc=Adp2BrSeg5fUGgh_31ZyPPBXAYe21nUB9l8gkyNIQpBLInKUNJQiZZv9eQeOfOYX2eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UGjXova7OJ9faGf04y_q84VzsfkstpNBIiymmaT8EQw&oe=6A198879"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9--XJYzOZkQ7kNvwHvbTu7&_nc_oc=Adr7R6v3Cm36JLwh2oOUauxdzxLwUzi30T2GbUFGpIj__o8h9V1OfBCQZ48Gl6p3ct4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H8V6h4iAwZWurlRYgNCxCS51ed_zHnCaqbdNGfJt65g&oe=6A198D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZGhrgoL-skQ7kNvwFl5Kcs&_nc_oc=AdrdpcZ7ymsIOdzmF12FOXm28lTBmULeiyJ9PlJrSUtt5x6rddz82aavqgC5ClElI0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vwKGtPygHySfyMgo-G1MrTG9_AILrCPtZKFABii0mZg&oe=6A199F7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh7Av3mvansQ7kNvwE5AGZw&_nc_oc=AdqWH-YnNVJyJdXFHWNkLVU16P5aJah-2Z9uAFN5r2Oq0ryRUNL6J21sYwhE8iZHeUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yiLJA7qmN6iSlCEWurTRe-QQbNidz0hMG8IAR7_CqoA&oe=6A199747"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
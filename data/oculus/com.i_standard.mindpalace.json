eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLe9jZ_qDgQQ7kNvwF5HZg8&_nc_oc=Adph2JIWaR3kA1oqOQVbdlHyt-FRoTwhLSA4XECBdi39VivyvVNumV40YctDs5A8qa4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P-0dCpZ_Jw_t8M_hWPu5uzUtwgYWSAxmNLl4CkPrIXQ&oe=6A22F79A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZDnHV9LnW8Q7kNvwGasUjX&_nc_oc=AdoSLvPEz6okbw6_X9yo2w9AwxegUmB4kt2dEKn1mq_XcNtdHJN9j-eC3qIJP0Ul5vI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lRlqgwTKtvv_vTVXsl09tbJXBIJOcOK7bljb1HGx6cQ&oe=6A22DA63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z14R9jPPJD4Q7kNvwGY--tK&_nc_oc=AdpD8azYEw35J_TutzT4y94YJ5vi_donvm60-BLqDTEjMmCbMoZL1OtVkTRVwXaK5tg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hO_w7owurRsq0ftDkuALJrfVPUhw82nQUNJ7-WzI8_A&oe=6A22C7B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jZ1n-B5qj4Q7kNvwGmx_mX&_nc_oc=Adpv00UwyWgSs41IwuSU7sGTMRgPLGLABVYclJrJjiMEz1clGKizVGwS54ocPKTT8Dg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98k_gof_kwvsv4_cxY0m_1Yyd1JGMq7hd1sm0oDLrLpA&oe=6A22DCAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4ItzACn8hYQ7kNvwGz0Tdx&_nc_oc=Adod6-66_0s7xPifSxJuAlWrF6t4Ch725cxKluh4bN2ANDf0RV4auWaWOV5N4oXa-qg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IPdnjYt3oJ_aLyvR73Bzx43ivyd3yPojP-UV33NGA-w&oe=6A22FB39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j60tQrGshYQ7kNvwFJg2vw&_nc_oc=Ado5yjM_tza38u5TGRDGBR9JOWx2ecNSumUP4XEn4mANJad1viccQGde8ctfqmybpcc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rcY9HaT__xLpJ9m1WzgJ7uUloSMaiHP4cQU1_StPb_A&oe=6A22C7A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwGdN58Ub3gQ7kNvwGn2xVN&_nc_oc=Adq9SnG2oMEl90t8zGHWCT6sFB_t330sz59q3sqUwncMpdxSHR-jg5At66HlPhCRA7U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ro3JTMQdVLFbp6olQqNIIERIomcRi4ZHtv9X7CE3wNg&oe=6A22D9FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2UrEJYlOikQ7kNvwFu_1mU&_nc_oc=AdruNvvFNSvWXAovoko8eIakPIv_51tk8Djte0LhLajZTVR4QxnC5tYtJMh3Grl5FqY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rVAOOYFj3fpkia7iyptdkqVGG1bsyLHBrJL_AKrhS1w&oe=6A22D1C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6xfjIIW8TsQ7kNvwHj3D_A&_nc_oc=AdodBEZG7SmBprY2SzYfFX2W8bnhQ9JkTqSaLvK8FIfx1FYcUPS4w6XwWRlBa-dbHyw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qB-2VY_VphwIRj34w9jUHM3WDaqQtQFSthxQS9FuBIg&oe=69D799DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLGyFfDrxL8Q7kNvwGur_pZ&_nc_oc=AdqhAcdTefW5vOzAGAEx4f9frZ9QJvE-IP-gcnSA5tDU0sfYmB9TlwLoSXH7oRpeRlE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34eO4mPdsQLmunRVb1muauPL850L2n3N0BS7WWC4_1-w&oe=69D7B4E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co-jqECyZp0Q7kNvwHVpZ75&_nc_oc=AdoTIh6cTssMxPF48LtCCXQynzbSI4QGH3htwweX1EKXWfMTEUlVCg8cGYnUkPT1eow&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OdeYCL--IE-yak8cXupyq5E70XIWLTeRV6pbyz6oZdA&oe=69D7A233"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pxm98MzkwsQ7kNvwGZtZJF&_nc_oc=AdrbjUHz82ZSwwpeJlt8QO0P3h7TKIkm8YE7-aRMRf1yEQ5ZvNzyboRIBwlToYWObdQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QS4CDGfwRReqcHqsvXAIqtvT4KnLdpuYYXKbhTknF4A&oe=69D7B72E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNUU73S6D-4Q7kNvwFsbqsz&_nc_oc=Adp4leker4z42YMDOrMtuGMvuJP_5fI659HeOp8DT1geKAt7YbY-9ASzsmnvhfV9buU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mEPaaslEEqn9ZgDe-LUC4cdotYOo8rd68zLv2y5AlDQ&oe=69D79D79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KD8R-XoY4AQ7kNvwEj6ima&_nc_oc=AdrBJZSlijqJPGZDXFgIeWNC9tiWmwMzAF4JWID1At7BOjRKmwJdLf_hYMajqo7onWo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2acyqLvXeKWV23qDLZl0nnzypIeDnmxwuvuuefNWC4zg&oe=69D7A224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGnMclnu2qEQ7kNvwHIR1xi&_nc_oc=AdoBkKsMrxprGz8k8Og73QOL19HTdBqAF3FKC7HzIwufK8jsrryQeFknBLDpsaXTd7w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0igjbaxqTErhTYonpHF55vQQeOuACaZ2bDmmwiPMEuEw&oe=69D7B47F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzN-HNnPqO4Q7kNvwGMyf3b&_nc_oc=Adownk22eh2VsBj4mkrof8rokLiivv_iblGOyYwnkpBMQuPObqYWV3a5UNEZ_rAnGYM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q87iEQN8zXwZXuLjMpHaOI2Qnd8AARvTPb6pkI7pP6Q&oe=69D7AC47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIBRmm6bL1IQ7kNvwHNuixk&_nc_oc=AdpBeHqTTStvOrj3DaDVwaDPDKWVV3jQDlbwYaTFrfLNc4kPrB0bZ2jcP4pn0wYsLKc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HR_G3OzqeuNa0H7zMB445dLffPnr3dG-nMowg2Nd1rg&oe=6A36BE1A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJgTgYRaKLAQ7kNvwGHHeNH&_nc_oc=AdqA7Wj8hU0o6UQ-umyAZPP4jmblRBGBemRoCscvMHz6NQAfHSKl8Noud0GxsUsVPbg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YQkkg9V4ff0YWESYF90mWyTnj254Fv-4x9kSgNaZE6g&oe=6A36A0E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEu8hZTS_BoQ7kNvwETBEwv&_nc_oc=Adol9oAUrKkmRpslRUVkdG-LrGO6TYjTOZY51Z9gj_6xyfzoOPtkhdaEGRHnFwQRA_I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QfsQ5qAvhzuWGpSRP_IrsllgnYa2gEsEnoY1fidq3Hg&oe=6A368E33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZmTJH_LgI4Q7kNvwF0ynjn&_nc_oc=AdrkOdx35rncHBsGoC6IIYqfFINDE5CuN-U47oYQtlW5R2-v5jyy-eW0WvyKWG8vrUw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X5OPx8FkgqrCYk4hasHZBbXUzzSnb1-bOtI2TfCgmDw&oe=6A36A32E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xay84qRjMYsQ7kNvwGxdCOG&_nc_oc=AdqAlPUR9PNC7RLGd3q9pVP9Qta6cqzZjN5EkJNSL8_rXvffhKzdzTsB6YPsaxs6Raw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-S4lq8MpsQ-3VCBaYhlhPGdaYg-dP3jmUeurGdE_XAA&oe=6A36C1B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYUkm9p1NJoQ7kNvwHPrtf5&_nc_oc=AdpnqVOCtGgZI45OQSM26DNPCYCRl0Yrc3-jHrvBHLPX7d0UP6gtixaaEblRXa-ZRTc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jGDfn79HQ3EFvOZO6ONspD_YjkYAm6rmQWnmxKlesvw&oe=6A368E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVU0oKGC1mIQ7kNvwGexMMZ&_nc_oc=AdpIEETLqhRWfW3SkhciSC3bxRnM5GwEjZcpi5a7K1zkwXW1KoNr_vSCe3OrZCrm_q4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JsGcl91A0OnRFkE-JFR0aKCHrmHUZIZ5Pegddc-6jVA&oe=6A36A07F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP6GJk4WOiAQ7kNvwHr2Hux&_nc_oc=Adp7zoqSyuSN7HMpjFj7JNMpNICzmGlw8qiRcfEhsCuZkXDhiF9C-zAm9iRZPx1P5v4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UZLqvVl2iNmpTzvSZR1RV0v4nFZ_bKX1v3NFgARfnPA&oe=6A369847"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
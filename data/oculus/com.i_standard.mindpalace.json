lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjT6OqbgPP8Q7kNvwGvf-zj&_nc_oc=Adrg14cI3QeBX3in2lH-gAXhvLg3rL2XKLgluMMt1Bd6eGUB-REPK9F8_FV_mazahqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMDRWnnCA9sI_ANcUNiTn6-xfBnKi6Pq4EXXJreRZbhQ&oe=6AF0A19A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efzgxG9Z5_MQ7kNvwGrrpFk&_nc_oc=Adq25A5HPOcCorIc-RMGzmh4sF6zgzcD828plciTafz_jyuWLsmotNGh8h18i1CetB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHONQWgHzAHEKVjld9y5oKY6mH2-xmgLCDpUEhkmEDcA&oe=6AF08463"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmLegLmnNIUQ7kNvwFOTz7r&_nc_oc=AdqP-BY6pxaOK0ruvr6x8oQpBEl_XM4wXsM8CJCKFtVrWib39KNg0PoPdujGckc1M7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWJ_l9CiNklCz1g1wp3L3CtQNKArdvoVmqnbdRznqOOg&oe=6AF0A9F3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3ZlOK1iqvoQ7kNvwF61Okh&_nc_oc=Adrai7E1H-8XBYX80a-jggSo7LMstnD47DpkTRG57p0W-EOjnXC-pxv1KRjodBbjfuE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUWsrI9O5SNZlNtJOXUwCg1w69CWv1MgBBG1jF8792Qw&oe=6AF086AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVU9k-gW7pIQ7kNvwEGSF9W&_nc_oc=AdrHmzNKaqnJWlDG6avciFOkUwCGA3kYgNeaRQRPBe7TYKnXb51p_wtIQ6kfVTDWIC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9FIiDZa-VmoWvCrKqbsu8-DmzIkaXfjEAO_ST97ahZw&oe=6AF0A539"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpcnsFfxT3MQ7kNvwGpTV0Q&_nc_oc=AdqsBHyeDzaHz_mGd-grTtscS88bDcPDN_miPpDLVDsvfEtCsZwJao_JRfjrllCkRSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZP_u6IC79jyHide_CDzCx9vq6mlO3vKkcNprjTuirhA&oe=6AF0A9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QsIK-99THAQ7kNvwHj3EiW&_nc_oc=Adr5Unuf7S6NFznsHEpcMk6sutybHGzVQ_uA5olnaLt0kXQUG7U_GEmgzVnUARt0T2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSTXtEXYX3AqhuJ-Te0VKznWi0fgMbgscwnyZniNk6Ww&oe=6AF083FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aicJMabSnY0Q7kNvwHE_nYO&_nc_oc=Ado2Dkc5jVBeoDkoOOdTYmxUrl5KsJsEG7w5FbiSKsu_K-C6zBxQMLvgehRqbvWQf7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7VhDIZefn2bS-JRLcy5pj-8gS-iwiDfAgn3n0qH8cIQ&oe=6AF0B407"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
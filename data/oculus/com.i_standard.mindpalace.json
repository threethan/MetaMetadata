lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLSiIoCFFLQQ7kNvwGHFWiE&_nc_oc=Adp78yx6i7mAImDINEZ48AbP5eXVm_VTd8TCEZZTHJbpPrjpBtCxumNZyNBjbegV2mM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMtzbJ8VaMBq2r1yYij0XfG9qNdfk0PjxL5CIkm8K51w&oe=6A747C5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc-UcMNlq4cQ7kNvwE0ZEkm&_nc_oc=AdpxdqhW08ImyET9bwwjRza-3jiF8jxp3Ftaj-sfUxajsvl3piwicASYepRuNzyVn5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD0Ko7rmWOsSSaipHzyEaAHXslYztcu7bjsb4HkmZLAQ&oe=6A749763"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT9vVYLng6MQ7kNvwFjPOen&_nc_oc=AdpJMuge-XMuvfmdRGVfTtkWG7mV4ZJGdO_OyJCC6kmHt2HFQ_6U4yD1s6pFjffPAAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwp9yCn0ji2XobpRW9rX4yYUM9-2pttVTF3jpCb-OXFA&oe=6A7484B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRXT8twSDRcQ7kNvwGTYjS9&_nc_oc=Adr3v_t2Pn9N-q1oDc5UzmGM4K9MmRZkm_W1W9pay-rbXLfnAp0T_Hdy9S_q5qMM_3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6mvVV7Uyjrw3xwraskLjv399HufOqAyPu0FJWT7TUbA&oe=6A7499AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeKbebju9kkQ7kNvwH4ldf_&_nc_oc=AdrgKIp64HfVGW-7nQT_OoWvMvWQaZ7VxoUDvS41P2PLiCeMIZS72cDWvbnW3wsWqzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH09MCMxXdpTlQSLZipoaHiRbBhNMlqShcoGEhx3JYROA&oe=6A747FF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VPmJvQwTN8Q7kNvwEcwqWf&_nc_oc=Adq374tV9jGgTsDqA4DXV5Rg-R5PQGy_YYgKNsXCTyApgTK2wforFmcFZjtzumnaIO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzBVhQoqYhWi8ySnzmx0VX6GPwFGqWlFNdiwTL9SbTiA&oe=6A7484A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0cY5xlHNbgQ7kNvwFy3h3k&_nc_oc=AdprkowB6uVNRab0O-zysW7Mxsx0lBB5guOH69vm9LGa09lBWuOMk_ddToJoG5PkqF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMpKPAo1zoExC-ZUpi6kWv6J62PRCkGQ1vJSuR9rTQRQ&oe=6A7496FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNzrFByqOTEQ7kNvwGCZ-w7&_nc_oc=AdpEFh41-MGZkZ8DHJAn2k4BST8rib01v-SAGQb1dZnt-_3TzjPvYCznEGzHp4liTk0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_7W_mr6kCyhCJkHtwiFSEmpeXOWLtL2wEAlbN9VWjEQ&oe=6A748EC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
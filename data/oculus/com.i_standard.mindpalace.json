lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXeJvDkGMesQ7kNvwHUZ_CV&_nc_oc=AdonHl-0dmTfAFSDFVBRf0t3bKIfjw1JiPFO0mhLqN9fs_zlcrIHe45-SSK9dREQYEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnbCX_M6idzYBiSCb7I51uh3v7TDxqRhFaUXHdwt5o4w&oe=6A7B13DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCZBncnUX64Q7kNvwH8I74e&_nc_oc=AdqCShZYByIe8JVERffWb6J66Rni42GC1fQqaN5ILDQFivqfPbeKTuB0TPVL4QNWAqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0AY013eL0kfcCf7nS29X92v19VYOnZ4HCTeW0kb8cOw&oe=6A7B2EE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31xJ-kh-sLQQ7kNvwGcAQja&_nc_oc=AdqEMAh3-IEWfILBZR95ltY8z9Bdr9io_9dkhqT8NoYvrf9RYrYN7w0H3h7EBObiOCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElp2cuZjOdlJR8JT81ewGYI1A6n8RHfAjTjLCYbRco_Q&oe=6A7B1C33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67XEn0vMSo0Q7kNvwEG0TmL&_nc_oc=AdonRdsx7ons-bA8CBieQzXpPoZqAwlDr0WzWalsI2vBj2BvV2UKQp1TtMe4NJ2KQds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb2bA-DWNl2i2aTFTpqdnlO43Z94tHX7LalgxNUn20ig&oe=6A7B312E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cFUbLvnyNwQ7kNvwFIxyoI&_nc_oc=Adro_MrZhI4kYgg555zSv2ZaiTE1gwNi-tcJoUz-sc9HsZBbQ9ZnGYQdo4eRTPnvaR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7OgZDcXB_kJkSivL41FrDGjYsv8l7E84gp6et-lT2Cg&oe=6A7B1779"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytbuPPMUk-4Q7kNvwG0Z41x&_nc_oc=AdqW7Ku7kCDtydRVDxrBYq2N3AP3MAlEv-rlFJvODGevEq4gym90olB7BFRKBLmjqgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFopWZr2yjGrfWKK9fCCGgw6gIpIIM2OT1DZSeXCQmSow&oe=6A7B1C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JEGdjsQL9UQ7kNvwEe5pMO&_nc_oc=Ado86Gulb8NF7JJrVEo9Jkh73YTtpVYEmv0oXDlzB4dr67S297986Hjs66BvJm0DKcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLs0AyAbrC1oK7DZ4LoZfLgvIlhEjSpsDEmdq_T9IFYw&oe=6A7B2E7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQEFXLiut5kQ7kNvwF2r_G1&_nc_oc=AdoiC-ZEVLeMyGsoG5ZLoENpHyrlszRgzKd45u-59ljhSKfFDne6plNyzz0Kci0__Zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtxmaXLJuxD2YR4KOb72ydUZZXKHPEumQVWodNt8wbvw&oe=6A7B2647"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
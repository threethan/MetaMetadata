lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIBRmm6bL1IQ7kNvwGJRI6A&_nc_oc=AdruR2ZCl1e3Z037ENDOJUA9MCAG6562Px2iDkTUzHn8erMuBDi6qBedi9ZHkdk8olo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QovCqtGFKaUCVtB-lrOfkGpoaTBo7HeiX9Od3MuE7Qg&oe=6A380F9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHuj8LZmVoUQ7kNvwFNUqMt&_nc_oc=AdpcVh4O3pYLR2kkI10lt1N5blUgSyhhQJ0hOk5i1pW1P2lBX2wAcWxw64r2aN5hWJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H7Qza729zd5MKZo-dzqUTGfSe2I5PRHmfEABIs97Opg&oe=6A37F263"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEu8hZTS_BoQ7kNvwHsZErS&_nc_oc=AdrouBIfWSfwwtCQjqex3HwdiSSYXgko8dRAEcLxpQVcTdtihvxttWsLK6WjyHkAo08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WU2KzCa_G3mMD3UB-8FmRSpMwUcFqi0raMkjbgYDj_A&oe=6A37DFB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN_2aY1K174Q7kNvwF9-5LC&_nc_oc=Adpf_h3oSQjEz_Sy80dRway2rdocIp-Vbsi4RlFQahD_XTq5AoSjbmppSJdfb3RAFkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DCSZoMEIRGgzY0ejdJUwrwHsEoSiR_zAbgxB_FtxDnw&oe=6A37F4AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKc6fzTmwLEQ7kNvwGfPjkh&_nc_oc=Ado9T7ig7BMJoykoNzeFyyfEkPmcymzOIC3uSZFqTNsCW0-dj_34uJERZ7KbjZULJU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l8G3V9Ks2HVQ4_fRvI8CrODWBlU-O--AXQ8MLF-FeKQ&oe=6A381339"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fmNWc5nFMMQ7kNvwGvga1U&_nc_oc=Ado7DA7eeGKOp7G3KcTf4ymhc46a48_t7ue9BDn0vNKe1u4LnUPLO9A9NJvxOyae1jE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l_qJSYKjRJqrZkafqBe1yt3I5MGJ25trfhahQGYVYWA&oe=6A37DFA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUvvLQXU8FMQ7kNvwGqxv6B&_nc_oc=AdpXOJHaGE0mBKdm-jmQlfGpNvaeFmRR44PkfpFIH-Wvf00GFTSs57nGXnMA1SpF71A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ApiSEDpJw3_sz1Y5wlZLBOzVLWImeIjU7UobXiNt3SA&oe=6A37F1FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP6GJk4WOiAQ7kNvwFRLU_D&_nc_oc=Adr7w6iIPvMhhcrA9OxT5pTjTASF61lx8-6EefWlc6yWSbwxwi95oj0twwZegRdTjIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hms2jrusqzy2HwYHdPJ3zh7QN4sGSD7KwkcYQdJVhww&oe=6A37E9C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
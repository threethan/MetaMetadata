lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNoK95d9LK4Q7kNvwGotAtp&_nc_oc=AdqB92mLk6giFE-Mgq6N_hODh3GGVp15PA8ROW9_ccz-N8A4FTdvRfgaHyyIImbaFI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SqvKZ4IFbOBm1UcK3u_gOXyJ7LMQBr9idxpOqx-Azfg&oe=6A1D795A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzlfw0VEt1cQ7kNvwHvzFmT&_nc_oc=AdrvzGQ1MlEcw_d3hDgxBR-YG_ThuQC2hrSPmZ2CFJpy-aDd0YKKtnAqBob3Flj9WTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CRDtpJjojMJDLG0d1KkFZW2uhGE-aROpBDu5qtNYujQ&oe=6A1D9463"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm46qUaJyTQQ7kNvwG_vx5l&_nc_oc=AdpRcyndYsLGE-awcVRL3T2bPug-T8IMBU72uWOJV0OhJEF93Xg4mnRaj1CoPBz_w_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46hpRDKttijtu7wnwRi1G7anja8VG33gkjMo618JxD6A&oe=6A1D81B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEY5IEn21yQQ7kNvwF3jVVf&_nc_oc=AdoEjPqh8WTdqi1y4oksG-TtPLRAFope2XeobLr2EWQe171Ncij20RufllLxR5M5ksg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_LP4f4zQcf5RQq0aH_hh7UZb2DkNeEYZS3B5qH_404Q&oe=6A1D96AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKZt8frM1TcQ7kNvwFC0fvF&_nc_oc=Adp5a-eF4VlOKN2DBYhE4OkAqtppz5tEgJb86R0Y5i2mSrCl4ITDtnsKrxJiKxLK9r4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Uv-2C5o6IB7t2yKG6tIVEsR_0zuvp6ck83_l3A7HgYA&oe=6A1D7CF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_PquD7fs9IQ7kNvwHM6mBy&_nc_oc=AdrfbuhH0blwaxq6CA2FfGEwwh7mtXtUNLjbCfuBMxS8DzAo4Pm-NawXK5sAuLKVkIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75dR_9fPJSTe1FLIG1wOafx4n-gLVQmL4F3MBVQamOAg&oe=6A1D81A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2eAAhg4CTUQ7kNvwFRL_4B&_nc_oc=AdogMHFEJ6mgcPGa54HTAWTXgxY3Ii_6RZoOQveo5mGF4cPtMP0X1Mh5ktFPnXps5CE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VjpPgC5WFmHGzQChwnGp-TntYOHEo8eqM7xo_oPohLw&oe=6A1D93FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A559w0dEj3IQ7kNvwFoDYa0&_nc_oc=Adr0UGcehh4wGHPUGQTirEPLmwVk8zxFgVOgXOKfZNl1kR0xNHOAtNC5EPV3pANJieE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mk4usdQXzHJGSNvSgyemwPqVcCM3pQquI8gGzwnYRNw&oe=6A1D8BC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KF5RAaEg-MQ7kNvwFgIF_J&_nc_oc=AdrW8dbesDGLahTKuc-qB9q0vPLs8imtkvsU-No7LkP8vIlTofhzp12SUebXK4xRZaE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyvr4Kc7eLy_aw45Dd-ZS6gQz_fDOsjR_MNf6OTpTHDxg&oe=69CBBC5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_ORM0GnPhkQ7kNvwEqKSvM&_nc_oc=AdomjMwiK7tL0gonDimo7AndLk0Rt2OyEciDoA_NcMHVNBPkLfIg_EXKNbnECChZgJ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybqX-387_Q1jHKhOO_K5KIpj4yWRe40FGnDlQvfhFBwQ&oe=69CBD763"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMHpKQpTwtYQ7kNvwGIuNgg&_nc_oc=AdooefbOF-5E13-rrM2VrbItLaKnxpr2QKO2SI-522C6R2Fk8JE9eVE8Y8KL6f1sKGQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_uDs3Rt8aX6u7sqJ0TlchpvXFs0fPdq89IUOJML5lcA&oe=69CBC4B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hneAOLhC2b0Q7kNvwG_yK3O&_nc_oc=AdpTExoOJMMY8L88M_8LUVsCiecL3SoozqVnExz71AVZqI7ejzY1KD6FAC90ZejPTd4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUMjHQYlS_I_W-j75IYmm0sa4Rj7L7pdPnW9DSyibShg&oe=69CBD9AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J88SlAf03GoQ7kNvwFZOO68&_nc_oc=Adr3XWZy81xply6Y2MlJara8AQQjN6N1705ZcH2RdJIkgxD_S07ApJFeJq64ZZH8WKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxX_3tgn08L3d66A9u0r49n39rC783leB4XzlSfzzXYbw&oe=69CBBFF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AfuV0SuOqwQ7kNvwFrpduE&_nc_oc=Ado51FianCsXDQUV6Q9DEQYCn7WpxURvRoQFQpuKzBRffhVeTi3ta-QugKOvskiN4i4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzodJvfXDY3yAHylOBAWvq6sVJTT6UopAKrZ6TuXe8wYA&oe=69CBC4A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhevJeEVaQwQ7kNvwEKURLu&_nc_oc=Ado-BJqOWOSi_FahHnK5GdpqM32ah7QCGFkZpdBRKCKRsHJIew4iNsxSuqsIowtMJiE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwgx3asxxbqflpbS898FqjxAW6lAFVxGO4I8llnJXf5KA&oe=69CBD6FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-6agl12gTQQ7kNvwGL9u-j&_nc_oc=Adp8UMky2k8gnDhtu27VDPOWLy5Fg4WYrsplxxM8wHVBO2HRbDfIRSXPMAUBOm6wJoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJMHzn0fgP6ONdqUqd_fa97VRZPemE9I-xXQKwuL1j5g&oe=69CBCEC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
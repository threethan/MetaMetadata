lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz9TWBZ15PwQ7kNvwG929Cb&_nc_oc=Adr0-QbsnwFyIEYzm7dfQWvu3R6Nxxd3B41yt9avBzO8QT6HDgDcZ6EdmUmqGfOQxhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9F0EOj5aXF0mGyV85KZXNTijANfL-J3YNfE_Y_fPDMw&oe=6A52355A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMDf2CH0y1MQ7kNvwHYeHsI&_nc_oc=AdqQl92-Y2Bo2ltLhhbwBkJhjGVFOG0dRxTL595mO0i0YNC6YM26RkoyrdnuKHYr-Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFUPuCh9bYPAVGDf_5BhJeCO4qHnvuBTHGfqy6k5ETLw&oe=6A525063"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkIBpzrzrGUQ7kNvwEgdISY&_nc_oc=Adpc8v7gZMYUFzC2907uu7HZfWT5Ksm3wDIJfJhyzLN0d--1J_lJqjFeOKVYeePL-H8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx-iZzNWJlLKqM0t2SI8rGo74KcdGcsAYGHH-hw_Tc9w&oe=6A523DB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lq7phRHN8GIQ7kNvwHgaWjb&_nc_oc=AdpZdFjVktz2pmkcXdGrt5CNQL-r6qxj3AouytRpgX88JJkGLUydWFo00DfgoDzn4ZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnW7QMeUd8KXBJUsV1gB0_9Bi8nPFNkBpR_uhcBRREXg&oe=6A5252AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv5s5s732fsQ7kNvwHn-QNJ&_nc_oc=AdrCmem0qFYLh08GdxWr8buJtZPvy6JJ-PTLGK6eFlzmxEev5w3s2lrL_UHqcxvidb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwyhUdru6DVTFeXPACgy65d8jmmgQA3OGy7LgPondw0Q&oe=6A5238F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZSXbM8rTy0Q7kNvwGwvCZ8&_nc_oc=AdpPeno19IbbihgWeUasvTXVvafuDczQqJr4XOsyLLr2qq38G6OXoGsarvOO9WaK2dA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRmbJW8yPOM1MZe0InDLM1Qgwhst8AHfyB6d4bUt1lqw&oe=6A523DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsfAwYoCNVUQ7kNvwFZCj_H&_nc_oc=AdqEH-svVVoG5-786rMvm9kCauoPTUly9YFNFuJrVSGclyavlRl9hizBSCQXUEksqkA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdtzJ0V2BKBFoQQyN5lUaJnnJnZ_As7OcOVgxczW0hFw&oe=6A524FFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqxsslHO8ecQ7kNvwHjzq05&_nc_oc=AdqfsvCWKQnTS7smaH9G2JxZo94D84v52CdQNhF1EwuqGaIFmddL4kYmk4wR6dsmig8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZlnjcT9u9IXWV8UV9PdmQbUGgbVVW5ywchF8Pu4m_uw&oe=6A5247C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXVnruSTwXEQ7kNvwFvVXlU&_nc_oc=Ado0ld3aOl-mo9yz9J_K8FuX3II9kAEew_BtzU-8TrDxVxb3FGNbTNVFtEI8q8Xtoxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5SZvCAsMJeQ1RlqXP6lWChtkIX5RAf711l_yI-l0Z_A&oe=6AB69F9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-owMSGZb61kQ7kNvwE39TJ7&_nc_oc=AdqVQ3i8qa5lmvcECzuyuodq04XWDyDR6Te5EoSRAwo0rG_-AlEW4RFahEZ_Kif4Q5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVTL__ZVT4htqmL0ZEleolxCd2jkOjhTR6j2eeILuOVA&oe=6AB68263"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFPblfvlD1AQ7kNvwE2gU38&_nc_oc=Ado1c_ZnZSK9TIc5G0qkYkjBtFPIHJq-6YzQPA4A68sk0kC6KzTCKuDZj4UzGjvjEFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3E31HdKmZ9Ah7EYgcvNzepdsBqVBSxhUoS0CV_K-7iA&oe=6AB66FB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TlI8mb8pLAQ7kNvwHqTnjd&_nc_oc=AdoCPwVWgWabtabRUJgJcaZIw9oqk4THsJi4vNjfFADIRnaQfe7gsMPE3udSCpl2Z8g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6TiutzYuBpeHv61L7L6CCwOZN8EFNildiogzFUc_0Ow&oe=6AB684AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIyUwVbppIwQ7kNvwFiNWlU&_nc_oc=AdpcyuSdrQP52yfBYmJGP4HryKSRgmCLiG5LCvRDX2YWoz-TavCD4VNGX_TDMSTMkx8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId1Fs9_XXhv11d2GRDD1mEDz-A5IQE7dPcOACdoCzoRw&oe=6AB66AF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNFDE0rbKJ4Q7kNvwGlMWci&_nc_oc=AdpmMAee23ZCl5Cpt2iPlK2Uo5ePKWpv1i5qbqWj07bF6iMc73b_pYhkWS30lOqu_Ts&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6xmIKx9mmtyf07kCx7p6XRDzhtqSkr1-lSyvjLCARRg&oe=6AB66FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_dcyc3iPEMQ7kNvwHDgJPj&_nc_oc=Adrfr2GSVZ9xYl-j96ZNGEdC0PnHJFjWuFDUtBzYh2xxOvkyS5qSxxDfIEgAtdT8U3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsnJPAk3YO9G6iSOqSOowFqJa9UwIJb39hamUtqJgUxw&oe=6AB681FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsOmq-Q0DXwQ7kNvwHQIRAw&_nc_oc=AdoYzKF93NfxJ6mC2M1tGkcyPHiwmp6nKnaT7G-LmezLLiQsHmhVJlxh-hAg4g7c9iA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU7vcf5oRqGohwpVV-HINZ4zWDk9giarfhEIYCobiHAw&oe=6AB679C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
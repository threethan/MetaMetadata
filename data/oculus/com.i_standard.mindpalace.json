lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ltC5LuRqw0Q7kNvwFHVkuH&_nc_oc=AdpucSa2ntqZeDY3wo3J5neDhXHjjefq7GPa1PCRDW6HIRvsn7HUwO49-4OcDtNwOwo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB63e-blY_WBxuWspBkuS0-4ZNFagwF2Z9zUjMyyIbWHw&oe=6A54D85A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OBMUSEKXDYQ7kNvwGGUhk4&_nc_oc=AdpDsTthnGDP0efVfGWy1_PvLicFRX7hLid-fGqNHprO7fEE8xnyHHn6Qht0GT5Z-8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr1aFkIYiT-Vsqr9xnEb0P0Dj_sxp-aOwk3mkKI0kqwg&oe=6A54F363"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvpG31xEVk8Q7kNvwGvckCG&_nc_oc=AdrlSKv3mz9Amr8dSyf_8uj_CeUH96dNoPSUQYcL1-G1j4BxdRkABvSZ_dqTHpcHYn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVFZw32n1rvD-CNayejOcyd_ZPAQ7jZ8UGYPDAZUZb_w&oe=6A54E0B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk0x62DBPiwQ7kNvwG_R34o&_nc_oc=AdpeBbcsSsUgykH2JMrxTkfgzsBzo16lyW6Un7ntYHfkNL0GSn-3n6GGMdEGMZ9sWpU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByLbSxAZ4xyzDolWuqBfruIS9_n8Ftv-oK91zSxAGvKg&oe=6A54F5AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLfqzbYVWFUQ7kNvwECYz2N&_nc_oc=AdqrJMDkaxyjo8run3dTgbST6bdpwNrXbjDg_SwIOsnSuduQTv9qBqkDV-PqiqqW7Jk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8QqTU2JvWjA2MTHph8_buCs4MUl2sKoAbXYNLZ17b2g&oe=6A54DBF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsi112RSB-AQ7kNvwH_s7k0&_nc_oc=AdoMn0oCxFquuiEJgBgd95cezNkwO0lURCJfF02C1M9lfi9RkNBPf7DGIV3Xl3lJwUQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbYXxutEwogjhgMK2RLf_xmpo87CMA2caXMDTIUvFyMA&oe=6A54E0A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctcL4gm8HfkQ7kNvwHfcKlx&_nc_oc=AdoSLkyI01Y8X-T4UjG3JL6f9P47Vs5LGmLd0duvFpZKFpjsXqQWTj8Uwllg2whHChc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5Ccc-vxH4uzx7H7yft4orKYAEaIG7m7fei6M427lEiw&oe=6A54F2FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9KMDT_zJGMQ7kNvwGioi6R&_nc_oc=Adptyhb1q94MY1W8B08_cn_rXH1kZdngQHHo8yaBPmpQRg63PzJJuJCrzk7i8ylLAuk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnsW5luduw0v4PSRy0ttH_6jw9taisdcWDQ7m8sWr02w&oe=6A54EAC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXFYDi04GqcQ7kNvwFwu8dR&_nc_oc=AdpLjT9_kVttudocBsVYu9dup7MwRO0lbUgA6ZdeCAqTLJBSdML9PHC_oxhwP5u5B-Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKukTLFW7CHpg0V9_BX1GviM0fDtAnAavlnE_ivxg-gfQ&oe=6AA9385A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_Z1XLjnsVcQ7kNvwETjTLO&_nc_oc=AdrcmTxf0IE8pCRPf2Eg_b9DWqIjC45UfBh4ReUDKktlJkQghCI1Rn0oUbY7kLO0WY4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKq7Vr7Oefz0yyenfBRPA4-EPDtikNNiaQmBYhBFFPDw&oe=6AA95363"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbr1dZq4VK0Q7kNvwFHUD-N&_nc_oc=AdpjGO9Xd4nSoBtMtaG7Zm9Dqs97w0mLKnV_R5T4JAqsqtXfMPuo6WGyGEWF6rOpzc0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoIZCpehk4Vm0GlBzzhnvCJv3P7VZC5XZXRAPgjRXuFA&oe=6AA940B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUKMnXU3h0wQ7kNvwHMefUF&_nc_oc=Adq5NONlkfjS7jGCCMJ4cikpZjqNHV9x5SBwAoAfMv870ocahxFRHN_WjzkygaCUm3g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrT_R31HcNKCiL7_OgMfsbtnfrQMOTSHhRKVUqDe7BEA&oe=6AA955AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAiIojEPFQUQ7kNvwEa-oj4&_nc_oc=Adpg9x6UVMNfpZsoipFoFZ4aW0DHKRVr-yJz9nwL5891zJcjZUFSWlRUyKuQy6pVv_U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_UeEg2wQKBbNRTY4osr41I3K8NLVbTTuE1jzZupV-KA&oe=6AA93BF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9LwA0gaOpkQ7kNvwGi6QwF&_nc_oc=AdqgiUym_xxtWQK5NfDr-FMtST-qYplsDmER_0_4V7UMGU8GXzIjgbMS2K2s_FrwCyw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIFQWM5VbJ98y5Wt7wSDWoRFYY7dN4_mQxh6sQqnpoQA&oe=6AA940A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1IATPBH1ugQ7kNvwFpai7u&_nc_oc=Adr6zjmS1Z533uNzIZAQ4--t7TFRRofwvJOMkgmWKnLKm715CgvYL3jU5YYq8FKFWpg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRr_d1uEal6cJCDvtyxFpSUqIJ4F3SMslVHhX66aRZ0A&oe=6AA952FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyXa2LHmPV0Q7kNvwFbJOZC&_nc_oc=Ado3QoS5PbZwWqQZ4ZA9fP2cRela1tfqaw_r6ulNOmOyoVMuvHhdbfKy_txDqGTKGI8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8bulLr8jFLLxGkC78j6qrbmdlIbjSBy7f3xyLb6uLUA&oe=6AA94AC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
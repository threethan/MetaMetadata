lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_20keGBQcuAQ7kNvwFjMMBm&_nc_oc=AdoLsofP5IgKDgevc5LvQ5n_iTbYG-NKhgXTu9F3WOB4SEwwylQGB1iUeYJvJ0aGNWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9GjRuDtRxxalI-eEKGITLgbVuIT4Lyj0huzI3Oyi-rQ&oe=6A5F645A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVReE9mmsV8Q7kNvwF_mKaS&_nc_oc=AdryuqTPaEDQLrgnk149nt2LQvao_xqJqQXApdDKSjEvSxYN5A6zdtPywgwzE0JdEUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9ZyTgWOdIzBL8Bb0GIxqSSS5591ykPZQsO2rrRRcKlQ&oe=6A5F7F63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YkBZ73ZAq8Q7kNvwG9VLmJ&_nc_oc=Adolnp5o6CJ7GBGkWMFyoRpSArShXd24QVjRHX75ISfyc16MQM513F3KAT886MxDIDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvzH0Rw0riAuCflEe7MaiXat9AcXpSSWX9r-Sus_0NDQ&oe=6A5F6CB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRhM0Z03hL8Q7kNvwGqflUG&_nc_oc=AdpV9RFPM76EheAF81A7GSP74cHSeQ34A1c4nNBEtijMzKbA1LVxnmuMP214T9Hikds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlGDQB6ZX8UNLR_Tm0OFynC-EK7FolUjnJNjdmDjC_hQ&oe=6A5F81AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQNvJLXVcb4Q7kNvwFboF_x&_nc_oc=Adowyhu-c0bBWcwVT2a046tk12XzVX-k3z2QGu9b4aAHGbxnsxOnJk6e9vDTx18-zKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYXhDjvxeDSwBiYRfGgTIUDey71qyf3CX9jLVnrYbNKw&oe=6A5F67F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omY4S6OaWpEQ7kNvwEszhqU&_nc_oc=AdrHGku6AVe3_jOxWXWV8CFf9sORAP7rE09Z85Y5Y1ROp-MjHF6BJCU-29pNLE8URZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKPrvu_1mIDuvOv8_5MdfbUFNbLTs8yTUwIAUX-Ggb1A&oe=6A5F6CA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJAeUnLLHigQ7kNvwEpqZfH&_nc_oc=AdqmfOsjRKCbX6fxA8dfv6a4vtxjQ5xlLQeZHWPkbI-zINXQk14zW1ro3b-gapuhKAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqfpPEVHYX1ypv-BKjIe-AXTpN5a-QKuaDQBh_xhenng&oe=6A5F7EFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ-hcKU5WEAQ7kNvwF_zmB0&_nc_oc=AdpU_6bphOnPQ2nQiOhQvFS3hEC8EmePAO8jpmzig61mpFemwXCjn7tykOvvkyZYmno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO9jEg9y8_vYrD6H27vANw-5-fnlr3NM8Pkx-O4qnUgw&oe=6A5F76C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
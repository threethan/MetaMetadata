eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q5yG-q833QQ7kNvwHnjXR9&_nc_oc=AdrnyXKDsaXIetz1w4b6-56n0HlqtcwVz1dQ7fqoBpWWcFvO63KFcV81znV52tXSn40&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL0VNf9I5A8WsfdZWo393Gl4_I1eSE3JMUEpiQRWyrwg&oe=6AAE7E5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TobYxI_JI4Q7kNvwEn9zmO&_nc_oc=AdonZn7gRPbXBmYhQeVUuiLPYO-ImXYQY81CxHAyxUBK_uPbFg2YIxHzw16tE-LMaDw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2CXl14j3CTC4_e33Jq5a3VhCE6Ie1EIm9uBs_S5itnQ&oe=6AAE9963"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSOm0uc66hIQ7kNvwGt11eQ&_nc_oc=AdpSW3VHJ18n5KH1ou8cZX7kf40hirVQxsPNBA1Mdave8lnbtW8yjG0egbL--2Bg5Kc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1xMnjxWkmeNgzYWOmS8l5XJEY_Nj1Ql6V_AjsUU_1fg&oe=6AAE86B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rckycrb5tr0Q7kNvwGlcL7g&_nc_oc=AdoS0bTi4QwPfVqz4fNKFS5irpXVeKVR5ODwZntQdMoup08XqOYlCAkxKh35A7DfznY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVR2jUM5eN0OgAhBrzEimXPFv-pKcrqF7U3PHBCq4A8w&oe=6AAE9BAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06tgkAjPPAEQ7kNvwEPImvH&_nc_oc=Adp2bWnWhMt3hLza7mDj7qRjUgUlfPWLG4OH0UeAgrx4_wWU8KMtFr9nHYTTmI8o8nc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvxzpRrf_KfsOaBUlsFif07N3BYTd4VX7D9sqGpnmnVA&oe=6AAE81F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUTsKqUOJ04Q7kNvwEYPCqu&_nc_oc=AdqAcw4XfXZqQAReGWmakXQVoT-lSWruhg-ytthAAOBUYG4yH2M_DN9jf0Q_z2AB5Lo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5prfs4yZ3C5slNZu5bjeIc2HMalLxP5sMCJZqMQu-cQ&oe=6AAE86A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zw6BvNbXwUQ7kNvwGpvHVZ&_nc_oc=AdrqrgOjXhxRzJVSR-qbV3BXzulyDytD3jpr0Mia-maW32Likaflyna9d0vCio50-9g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7Jdaw3KnBqQ_erelzU2I74YISz7ysC97AytM86fFg0w&oe=6AAE98FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtM1WdMXWPoQ7kNvwGmIMO_&_nc_oc=Adrr-SD0QYmaW26mGUTqsHifFXQqZwNG1P9dF35rDQblTfqg_BeMW0vAUPWafVXKjH0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE0DyR2KuTHygFQo9cEPycyaBR1Z18RmyhOl5iR7wu-Q&oe=6AAE90C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
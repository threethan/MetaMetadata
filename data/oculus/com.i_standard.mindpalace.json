lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlPMkYBCJz0Q7kNvwF-GteY&_nc_oc=AdrPNZvJKWy-WAPFhxUQx1YxmTdaM1xpp7DGj7TMegzCod7F9iNKfPsdGNFekoQsiDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9fZPyxoJoSWYTGgKHyDZ7VknpHrqiGU3b8FheI1tG9Q&oe=6A844E5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E_Ni4861_0Q7kNvwHUEZ34&_nc_oc=AdpODD15dLAVOgAyk-KN10-yNMc09QVDOzJ_0HXW_-Hffp2lKcVppw0l35jkscNfJO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTE2kLaqDHrnx6XRsorsft4eXmTTP3l9K8Z3-O8_l0UA&oe=6A846963"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvjWvc8-7tkQ7kNvwFjx1jY&_nc_oc=AdovrRieT_LyRzLfQip01U45Gcji924bAL1OQexwVTwOK1h6nHNswMbzpL4e3hDpPAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRTtC_jVzwhYNyzuG3OfHy1T2h8VSGLOAjQinm3gVgWw&oe=6A8456B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORRyGa3pXvYQ7kNvwFinkyo&_nc_oc=AdqtthvQI3gyWDMfJt-lI6IvyVeagTe7k-ElthKTuRV0xo1ssnOtDotCREg0azQiHnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVzJ1FjOunZd3wiLLd8KHLfg0vdkJyiDqxILKg-fDOwQ&oe=6A84336E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTga8NPOqYwQ7kNvwFORNcj&_nc_oc=AdrpQyFbnpU2HrwV5ket9MrenxkqWUd8603fp3Z_fp9w9t9LCcC---8Ki1IFRa8ACGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtVmmAtG4fTEz3TRW_Zb9JOuf9-naEbxpbpDWHko8m9Q&oe=6A8451F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S4fXZbmPUUQ7kNvwHLHd8-&_nc_oc=Adqx2AEqCylvIWxPP4CWEcvSgPgom8YaByz_89cdm7ZF5bStT0urMIdqErEaye1zJYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgU4qob7ZA4kG3K2Nc1M0yjKNrTGVBALljUiwllPM7Ng&oe=6A8456A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8dK2auwPVEQ7kNvwGfbCH8&_nc_oc=AdrLPm6n1kgAQ0j4szb2tYD0u8EKk7aImEbWqSQKhG_9y-wX9EZpNYjKg1_x2JIcVmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE50JLk-d7xwIf-z8OpQi8DbI5IZVNChzOZNDqX8OdWmA&oe=6A8468FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1LSgKrnUAcQ7kNvwEsyfqt&_nc_oc=AdoJpn3jc96FEJodR7jPlwfJBS92gmgcR8DMzYawDU6uCRLbQG3X65LOf49Arn_2Nu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqG-nP8mRXVPrqCxJO-UP45nf01Lyv9IXpDNrUreu2zQ&oe=6A8460C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A5iobsX284Q7kNvwGmo4UV&_nc_oc=AdojsfhY6WzmmSZnKUbcPDTlsQtxcHV2shiVWm4AK_XLGI4bxHEGM8HgBKKRawwr2lQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXiFgwHBM2XY2iadnWi4BneuIBXpcOPAdPSXV9JSJu9Q&oe=6A674D5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzeVi8KHtl0Q7kNvwH90Tfd&_nc_oc=AdoMUGHF24EBi8eLD8Bbb0woUU8SyYpyzAPM4Ax2Bw-BoIyzIRNAMl8pQ-QD-lJZ2r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoZguvoWwbSb-fabHqU8mLsYNP0yWzTBCS7vZaF2M-cg&oe=6A676863"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MigR9eIZo1sQ7kNvwGNFp37&_nc_oc=AdoCeGSDVTtfN63tx_66dWTbjYRg_GX98rmuOyWCyQGP01Tfu-1yIfWxopu1nZYBgTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiQiO1tJqPSwzbrgcle7IHhrQ6Y3B5wSDtd4SRZl6R_A&oe=6A6755B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxNZToZLrNMQ7kNvwEymT_m&_nc_oc=Adrn3if2TfaTOy9EG5KPIBMaYlhNqZ_w1N3v-ZtozmVTYYNXGNPKH5271sE0HRHi204&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL4hswSPw7Ke8gBCgijTQkY5WVbyWdxYPw9HHW0y-2HA&oe=6A676AAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCoZCe8pdxEQ7kNvwGn0TcL&_nc_oc=Adrpi3O1MJilaNDT1Ts2frgHPw-TiPw9mO5ZLsQ3mpZZtfa9fCYH6TmVDP2LENOUfZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4YCjC8gsIplbo5gQuXiZVg2b2qsZ8v3Eh-rFvNbibJA&oe=6A6750F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1bmaREMoB4Q7kNvwF7KYQD&_nc_oc=AdrMRgOzUuQT0UqQgqEz9HRn1yqufNQ3HkAgZgZ38cxHGtIJJWq51DXCfgubDQ2-IBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEQw63rmKMmFX6e9HhY7121gjaTB7F9GPvi0V7kSraVQ&oe=6A6755A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJNdgWx3b9gQ7kNvwGGhaI2&_nc_oc=AdrvOjsc0s9LVuz9t66LtMuiF7gnxHNmFvFkXG-5Rsq-NXup80c4G_Na9yJQKpSOSo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdYex7fQ1q6EOd4VgmxQBrdGE9A0PUXmg40-RkFlAfmg&oe=6A6767FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdPilQuVZEIQ7kNvwELZLEZ&_nc_oc=Adp5a0DGuC7nnV1WH7zv8ps0N6DKomhXLZPuA4ed5Sc1konxqMFLa_WYq7-kUNrW0Y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6za8-kjTCujVH0bgU8wIWVopohrN03rUr70dOY_zSQg&oe=6A675FC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
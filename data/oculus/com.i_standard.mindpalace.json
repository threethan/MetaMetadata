lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH1P2NKFfPgQ7kNvwErCRo9&_nc_oc=Adr0pCOzF-woWYaPb0tZZ_RYAVRZ_GTtNRPRIkmeXYzqk1hv9qeNQlgMD9EgKz2yAYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS55YJmHHH99Wcqlktu_3V78kB-zuqRnOdUMChohGYYYQ&oe=6AF5E79A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PdMUy0JujEQ7kNvwHDLJR7&_nc_oc=Adqh_3_vk3a1WLnVkZoV2G47fIgI6LA-Ri2Laln9C2iSirKg2d13kHBPaJ3h5ruAFmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7a76_Xys90UEFwXFstSWrN7bkB9GyHzMNO3jVhQQNXQ&oe=6AF5CA63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuiYHjSeXCAQ7kNvwFo1zwh&_nc_oc=Adqad_fOPDaH2z8CQbl2ZV_mzAqnR5PnB-miJ5_1bo8MkzRWr2k-fKJ-OFPf3xUU_fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJOUEoKNXqcCCWEHyNYXN_RNujl27mZC7i-Fe1HJmF7Q&oe=6AF5EFF3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae90mBDd1v0Q7kNvwGFV9fY&_nc_oc=Adrp77WxoPOSXd5mVkQYs6jKOO99yW2ePgdXPSXmrX17BM_ySDJJTvxjRsoPCXLv0Tk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ791pgHvjA0_qRLPVBcjMCn4Rjh1poqlbL8HlbSWWwaQ&oe=6AF5CCAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fI4Ktt2fEUQ7kNvwHccm4d&_nc_oc=AdqRaOQXY3rOQ8belpNmrTGjrGVNKONXwBimEv2AV-lbWKuIaLdRUwrc4zNysN7CV6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8-agBroyrUt6v-7zQliNTDPFJKk8yYtJj_UkgxedeFQ&oe=6AF5EB39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqO8ANa67GEQ7kNvwEgnlfy&_nc_oc=AdoJ-3g1Wyj0WeO1E_1urFMyr25Ew6G_Gs5N-6W8hRu515OqNMM0aCoYfPa082A5eXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSmxuBpWltNH8puUh6YVy2rN-295cI4T8AFSj-qEKQ-g&oe=6AF5EFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx0FdTqSd6MQ7kNvwG-tmbI&_nc_oc=Ado-6j-7G-tipF598o68t__3FD_xN8inUMAA2U_E_E3WanWFQhudPEHlQE889O_jpY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlggCRKavHvQ8ihFVyWrQZ9oeXMJZjMHkmiXrH5kR9ow&oe=6AF5C9FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBs_octjYt8Q7kNvwG5quB0&_nc_oc=Adp3MCvH1RpRvBkzmyI3f3tCxZEmCcLne8YNLSiU4I8W-7IjwJVusonrVSBlcXHKHFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUp3ffY6WDYI7sqvMdKDNkbrbvjaVZX_qNsPbrhdLODw&oe=6AF5C1C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
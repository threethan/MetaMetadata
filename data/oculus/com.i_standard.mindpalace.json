lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnjEx6Ssd2cQ7kNvwFeSe0I&_nc_oc=AdoKaNH5lr0xmpLk-vVvo4_sIuoZs2cyU40PXYI6wNlAfoE7wWtakxldKaICKk1HTnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RzaxK2PYuXqXW8DaUuU1vUmhwrv5ScYcG_lsqS5lpPA&oe=6A341B1A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJgTgYRaKLAQ7kNvwG-KTsA&_nc_oc=Adqwgqb1FptAh9nVwTxPem5JhUFzr5hgSr4WbAztzIoMuc2KxOWOdRscUYJOHcCg46Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af833c7AQVwmolwtrHT-ERCAzxrxd5LrMLYdWNFUWXVzgw&oe=6A33FDE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jJGNDDkxLQQ7kNvwGOrf8V&_nc_oc=AdqBUrUmA1btDZSja5zQvmtScbIQnF38c1wNJQtObelkEkSzisApMrf00CILghphVC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NL_K9ycl2OtEBJgqqojzll8x90TU-DaJ_UxhzbGjVZA&oe=6A33EB33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZmTJH_LgI4Q7kNvwFIZrzL&_nc_oc=AdoRcB2cvvPF74Edha16eIoHriiTegka8hnUZsMj_O-H7RkprX_lnjqFmfT1nu9r9oI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dk5tHCNCm6tMuPuFbcvbn8wWoEyetxeh46LW6aLS-XQ&oe=6A34002E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xay84qRjMYsQ7kNvwGFXchw&_nc_oc=AdoKnxot0PUJ7Htb9uRipXVZ8QE0y_L5NPYRyoW93ricwC5wD656awKwJTrXXhMVF-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z0J6uB1W53MJkTGgTaL0pjW7jBUVZCaNbAnRMldMsBQ&oe=6A341EB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYUkm9p1NJoQ7kNvwFOWmpe&_nc_oc=Adqz5aYPaaa-GFuMNxxcU6ENsPNcU893HLTfqRvGxKxOkVN7ry4zOyZ-0ZNCl3UzJ5I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iDG9NwlPpSjShY0dSdtojzDFKFyA-Q_PLydI_mFxISg&oe=6A33EB24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVU0oKGC1mIQ7kNvwE1POft&_nc_oc=AdrgXTsS-FpjZvMZqkJoOnGjJW7lDVN3PWRxMs04CbnR6HoebkroWyVjkk77PSag5FE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yNmEkjdMzxncPGZzynlUoimOwoSbs1NOHI-ZfjIbfcg&oe=6A33FD7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwy558KXwxoQ7kNvwGioe1H&_nc_oc=AdoJQchEk4vaYh8abEww4RDi7SHM9BBB4MNOfW9sebrGwTiNTt6EXDdc908fUiBWsoQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88CwvRafLE71dg4Ww1DLE-0WBgJveLLU0Ggr1OJfpJZQ&oe=6A33F547"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsNgo33TAiYQ7kNvwEU8UYa&_nc_oc=AdpmR5WQuR1rZKQVPuodWQ1FT8tOQnlhKmIcSHkZ5y_HJuvFtB9-5jAzPTwwBcCGiac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nthko6ciknvjjfQHUUz8eVrb6mG4vKDUWiksu1qXTww&oe=69E3775A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7zsZXlclqoQ7kNvwHzapJb&_nc_oc=AdqIy9fca4aVujx7MYhebclY2YVmwhWpZGoWnO1NnK74p4QOa5waNfRUc3pHdWeiQB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JvHFB5IV--T-ioluTLD2dLbtxZzyUkLiZ2fQ2rb0nMw&oe=69E39263"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKpMoj8W5GIQ7kNvwHkD8kP&_nc_oc=AdoOdAi5zwGaATYSlN5k7PkcdKaakZxG7WjLon88Zr3awvK6UHhvKTZfemF51cRxh7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23ZAaHw1aRMTbAMoe_I8z5ouFl75PzqgLBFetzt-BRrg&oe=69E37FB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ7lnPK5lGEQ7kNvwFv9MWr&_nc_oc=AdruhPbNl72TaZb6RcOhfFfdh_H810rSQE-zvnqKqeOxkKtHY_MkNY3WEzOfmis5DX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3deuQIe7aUA8gfzlMcb_xU2HINiNWhI6PXWPrzhoaY5A&oe=69E394AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oenzY345XN4Q7kNvwFRAJn_&_nc_oc=AdqUgvxvsJvqiqJsFtesAnOLQOM_Hn7fYIzxdmIy-s0VBqfuyvzVN55VGQzZHrLpJg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VAWw-5tvTOMfS4vodeK7vwbJp6OLIddkv717bJgQYzA&oe=69E37AF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzv94TxLivMQ7kNvwF4p9te&_nc_oc=Adpk2-3GXfR_RDNZ9O_v38oO3hsIDt7J-kEMIJffF1w1EENharyA0Izd9NseRTnIjPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03LvDmzo0IEi8WAejIYpEQGU-3O0zk-xhwmPkPg4eYZA&oe=69E37FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apUfZwgjxAsQ7kNvwG63C7r&_nc_oc=Adq1CABb6fYJ8iSyTT5g0C6OczaZPv0lha9x-jN-JorbdJjn-RMr_4bBMCIPteG49xE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XzxdZVDU3EtiAAHy9fiIvdcK5fKrW_GsHScc84w14eQ&oe=69E391FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn4iU-XYkxsQ7kNvwFrs4Bk&_nc_oc=Adqd5FqEe9cz89TtJ37Wuh5cRBmLMO6JJnMtQXaqayGP73ePBx4pY2FrC_T3a-XPzC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-xKZ1mvNXk2h4jR5fliZ8z5iJhPlVWTZJ_EuMtN_LsA&oe=69E389C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
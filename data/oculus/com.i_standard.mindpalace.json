lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFT5CCyLePYQ7kNvwEstQ_y&_nc_oc=Adp8WApOs31l9kjbU3VGvdiUFNmMrBoypKWjV776yoCZlcJp1eGwRCeLCg6v4Es3-nU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOdI-0IQnytYnH2yaBOnN8tvSDF_hWtpZ01oFAW3HVaA&oe=6AC9149A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K5-0MzezjcQ7kNvwE3hPLd&_nc_oc=Ado1IYCpEKdwr_XaTxE79rdLvxPyzUASwmqLPFnGK87Fc2iXZ2yzNi59m2MjniqnpK4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBXBoji5VCHQXxMBxuTUB7ESRDWTPqPd_VbExZRHejUQ&oe=6AC8F763"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKC3w6ilY-sQ7kNvwFTFXPI&_nc_oc=AdpmYYVH8CM30km1wbn97BFjE9mkIf9JGMNcafZ9th13gA3-9cu2l6-pFGYH5U_m2Wo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvt_C710OmJVkXo--_gWPUvb3UI0bFG7XUF88dUXxGrA&oe=6AC91CF3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqHoXYsfqccQ7kNvwF4mkh9&_nc_oc=AdoJoVJUgRLsZmOqxb2_8vRsMKPRQ1Ty8MsOrNijao_qyO8Xl1ZnoPH2sp2TjTk7egw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQzFfqUG_xA_1TgjqxGIZ3emPYSwhduoicyXlFdUsRoA&oe=6AC8F9AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L10QaYb5ld8Q7kNvwGyr2qr&_nc_oc=AdqOAQpCmf-EzdPUrlzvyrPgBEtSMeMlxBi_zBFwWiKE4DQq6HF6xl8VMI-j5pKvwBY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA9v77Pa_thmHLMvI99v0LvIPvXyhvRmFm-bDCWRsb2A&oe=6AC91839"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IfqxRAV_NgQ7kNvwHjXKVo&_nc_oc=AdoBg8H1LS97Kn4Sm4R3CgIfhPZ2EEm2qHenSVWsibefmcdDGikGcuPse24a5FtrWC0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdV-lBvOo0zFjvMznvA14o4HlewrTZqJJW3k9Iz6Hf-w&oe=6AC91CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUjY8y0O84cQ7kNvwGE68Q8&_nc_oc=AdqOATECwZph3cNf4SEeYsili_WThO7oMsEJr5yxFWf6JFeFQbuyh_8Ep1_bgQkBp3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfdPzLVlP-xtpnflBz-dMQuot6To5zym3scWA1fwbJzA&oe=6AC8F6FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELoc9CWCUGIQ7kNvwGWW5eu&_nc_oc=AdqDnMhxlLKK4AyHNNZurkIQHjWCPOLdBXRF4R7QU2igFe-ggzyfQPR4ydN0cffCvQI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-k4WG3IK9e2HwuwcBUYIG200qt_Gap6rXJYqIA-4fhA&oe=6AC8EEC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
yhyS_TJ0ekKZP123RvZkDwCK2phdzH6MVnp2fPZTQfIw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCR1XHzRYx4s6vkQaBkb2akX0IiBXmSV7NXT2j0Ln0TQ&oe=69C133F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4anJ27Hd79UQ7kNvwG_fQ-2&_nc_oc=AdrEeESFexbvHYC3PT4M9ShcjLQmNwZME7MfDql3NxdcMiyJyG_Hf7hGgfJEMMHnUew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-Re11W_ExWnkzw78_4oxokxL2QIC2CjZ1N4Todw_7wQ&oe=69C138A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Ctk68j5ZQQ7kNvwGXQsJ_&_nc_oc=AdrQ9mTtoW3lqHKlqL6ryYLEe1CR7lNHQaXTeY8KWxkJdfw7hS1QxVwh5wB2yDMI0Oo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxSwQkco9_orte0uJvEGTVNuyM0tIg_df4g7AtiljaP4g&oe=69C14AFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize y
eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUGd9n9cO70Q7kNvwFafcAv&_nc_oc=AdqIu_m_ruFSJ_o0e3BZm9qxkG8rCOdRRC-RVed8PEM1Kd_OYqPWiyPmyfIiqetSEGk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxBpiEhz3Z1UD6C5FPISjTJ4E5fdtEPEqrXtCcnj0LyA&oe=6A7DB6DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCZBncnUX64Q7kNvwFs2QBE&_nc_oc=AdpkcJi_sb5giwuY51mx6BU8CKFh1-1O0oHLMun4s3oufacFoZg_atQKtn4FjpPGzuA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUJltXgjvvBX_W50zPtMV27gaM49Y0GVLiPLMnYS5VeQ&oe=6A7DD1E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQFIM3sDv5AQ7kNvwEt-2WI&_nc_oc=AdptCOP09OrJ08756Hk0BrJU7cjcveCCNJdjwPXotTga_BKU8bvczbvU5oiLbqgWkRo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECxEiYeJSzmb0nR4aujc-eA5B6jyWrcaRjPQ5jTZrjoQ&oe=6A7DBF33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67XEn0vMSo0Q7kNvwFF0uWb&_nc_oc=AdrQr-vqu-bMhheVkEbcIcgjVcJr7jG4zG3JhIymCRhUicBGZ8OLK-IWfLsVR4JwkJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5h5JLp1QsiKe1e14d0rmAhy12Wc6dTGJjwYCWgiz8nA&oe=6A7D9BEE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cFUbLvnyNwQ7kNvwGb3nJz&_nc_oc=AdqBFoMs-xRJclnoyqQwJ_6wTtwtzYdcWE6NVFNmCs_PzudEjS_0H1kA1hrsy8Cq4f4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuKuNfa0hZYqS2yOA_KI-xtoXu8I5g8CtErFClKqJVyQ&oe=6A7DBA79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytbuPPMUk-4Q7kNvwE9mrT6&_nc_oc=AdphdCSJL_8LzlxAke70O31JWZyyVcscU_jc19QjIy66G0JN3Q93F-exkrtp-mYXxHY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUYTrmwawkHV8eMb7XzVRAyzwowIne2Zi8e4tam86Xww&oe=6A7DBF24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JEGdjsQL9UQ7kNvwG4LxIp&_nc_oc=Ado537ToU9jvXDgpCnjxssBuCK_trXzL-AFsudXmRKcT3FL5wDlKmGB32xRk4v6iui8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiqB_e_93WoRYYbmnu8ymo3dPk4J_j3FcdCFHqHVrKSA&oe=6A7DD17F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5581wM-ArAQ7kNvwFIoMSU&_nc_oc=AdqGXIgYaaMkyZwhP5i1qFjgsSRIM5NlYTPEx9SGH2p3dkKI57dQNY3ermu7mYkRwio&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwMfZxBKrpC8tDRNqbFsXxW1S2OpyIk0qcSkCwfELpaA&oe=6A7DC947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
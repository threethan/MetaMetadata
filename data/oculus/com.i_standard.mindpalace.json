lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ryfe4F6PgC4Q7kNvwF9dzdV&_nc_oc=Adr3eWRsQnROHQcTtIS-mkQmZugpoceADOQPistHsQk5XJpr6wz_FAj45NAd8CyYHgg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Dmn7DuwJq9uqhJ5B9PuYxnEcx8nIUazkZdScEXQvRA&oe=6ABA5BDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wg1LvYzZCb0Q7kNvwEB0wC5&_nc_oc=Adq32Huw1mu6wbyzsar79zS2pRZHTLcsNsMDJ8YsepYxxfbiJzCqAYyx-WRWo5TJOM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMMHzuDYNkJop5jtCuv6wooRQQ_NehlMx9EGIrUDRfBg&oe=6ABA76E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyhtGhq2HyEQ7kNvwEPKnNx&_nc_oc=Ado-le616eknjf2H85dTBc-KEmj7IbI-2oty0NVpdO85zZ0MOX_TNTRKbgd3mhkpd-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImQPvyQQId2v3Qw8OkKRNhfA3z_HBuYI8vQ8EqyKRPgw&oe=6ABA6433"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtzX_J_pz3MQ7kNvwFg3TP8&_nc_oc=AdpYPjYjJ_6C8T8HQhic6tSqZLgAjPkwiLWNU7EdKbXISJV2ffFZ7eAFZmUgP3DqADM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI473mnmA_UXFVAXMj4vB5BaJK0i3sERRB1hwpYOxHKQg&oe=6ABA792E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w7vQaPL4xsQ7kNvwHVt0Jb&_nc_oc=AdpO34zuCgGca-G_gpsFvl-qAzlWO50HhoJg2D-71nDsMehupID6Gt-mCaBuW9LubFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-QwCb9nGxgEjncP3Nn_xsV85XWNFUj11EriRB68LXeg&oe=6ABA5F79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5agjg6ZgEUQ7kNvwHPc2vI&_nc_oc=Adop0LvItMH5ypnhuDWnDcmAN6dgwznZd8snIkONum3MbtDtDjTitJqf5sIMEw6aw0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiCzFMk8qXqedtZtgRTFDQKktIxzug4eYJldwseZVVSg&oe=6ABA6424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BfFCTvpTfwQ7kNvwE4LSbr&_nc_oc=AdpwT2Bc7zw1Hw8TQW94MjZxeOcE-AeCxXqe2dLwpWzjR1rjfWMV9O4wYWW-k3evoTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPOP6pW9LAD9u1QlN5ysj0Ym8RsuFh2Cbvt3ubnIXD0Q&oe=6ABA767F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00jM8fw-YP0Q7kNvwHZjmeZ&_nc_oc=Adr6xwnnm7ey3Ex-rs4YiTbnayBJtpgBY_1-6wNQCRtmAtk7460cCq2wE9SQDkNn53Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBB48oP9zfEKTo-GljeLiGcysdvViqn7PEsI1BgmLZMA&oe=6ABA6E47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tf_lx43L3IcQ7kNvwEqttP1&_nc_oc=Adq4zbNpf1kjz3KpB_OKVmI7IVsNPJ3m9-j1nDUmbmOPrmPgC-ZRrG4x7HuH9-2j7eA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqcWVxMs2nkfErhI0DDBMkw1D4kehQ37JnaQsg_IThgQ&oe=6ADDF45A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s4rMNUw8yoQ7kNvwGcu-nz&_nc_oc=AdrvHdCOzIFOm1h0Wya2f8HXjJVeuJeXAgY6YesEYJHEZiKRvhws9AXJCxQptUnrp2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9EtwXywydYmItFtIgf-GLnCU8W72ljirM2yhMPs3j1A&oe=6ADE0F63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pggjd1-quMQ7kNvwFTF1qy&_nc_oc=AdpgRTGoGpoIxbwBEgBF8FD3LALNRSg3h1T-q3wuy7D2Vg2sqRIVSdC1N4lqbgYBltM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpUj94lANkMXnkQsL3-ST29X-9XLARrn4cGlETt_Xzxw&oe=6ADDFCB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrvLAQ8cuAcQ7kNvwEN8QzR&_nc_oc=AdpYkmcueu1FIx8bPF6bAgNpu5_FTlNgvBm0dW2O3-V21PKGzVojKRXdxPumsGIOvjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGwxPvkzvQ-xwiskWi7hA5sz8va08_hIAV7IxOnyD_gQ&oe=6ADE11AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rMIC2vZTQUQ7kNvwFya7UI&_nc_oc=AdqybsmQcJy4lSIznHD1TewWcAyvAHC00zV7oH84amb0DJaM1qtHmHAjEgZdOZ0ofOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2SJaI_ZmvWO-LYnQSSqnnUB6Hk8ytQClwBbporhofPA&oe=6ADDF7F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BigpSOkogoQ7kNvwEBTzRS&_nc_oc=AdqLf8r8jjemIWpIqt5Bq-8cFd4LUjm1YC95qbxDOHOHLuFfM9wvbL5G5lkfa5-Knh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKsGT7l6pYo2Dwjxk9lEiQB--G0UsLJ1pczD8lCOWZgw&oe=6ADDFCA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRSRqJBp3BEQ7kNvwFb4gRk&_nc_oc=Adq7a9Hsd4tC7WQgwRPE1eiDqehAH8LUnh8mC7cDBhQ1uV19Gqct5BOoEyKIQI7d0is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOKtCT2m02EChZy43q9XmZ8ZmhX9JzBKLm8Ou8GZ9ksQ&oe=6ADE0EFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS6PzXNaK5AQ7kNvwFNxswV&_nc_oc=AdqrS65cBrI1l8jv2wEc2K3nv0kMP6I_K-K_V3HTZj8CooKUtghiLx5iZ0HkyNpZDF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW3wWKFnmrmlSV7DWTEgD7zLnafcs62PjfNMiCdbsQag&oe=6ADE06C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6xfjIIW8TsQ7kNvwGQzZKq&_nc_oc=AdpTK65XfZCeyNXlvDJB7iAM-rd2O8KWjzEzRB_kHf8wIiErHHJYLJjDe6OKjzXfhIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X-AupQHvyuDFuaGg42-X5Qd9cprJViwrQYYngsjyvLQ&oe=69D8EB5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scdYwQEBrzwQ7kNvwEqklCO&_nc_oc=AdonNOBgD4GaTFJnJTe9uxky_Vji8Fq1in93bV4MHNQtFIvoe_-cwCUAioNm7TnXxWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1em2F9hVBBW-im7Na0qOpsC7GArK2w3kU3_eyc8KO3qQ&oe=69D90663"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co-jqECyZp0Q7kNvwFItkT8&_nc_oc=AdriHJ4xkQm9sgt07-hrkhCUXOSFJT7zlpNcvQzeHd0Ges0pWUYWfg0Ox7gGB9ttFbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NATyudysb2vOKEekiSu9NqS8ZxS53LoZe17KluCX1Ow&oe=69D8F3B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkoQ6l-JJ28Q7kNvwG5fU6S&_nc_oc=AdoagAl92hf9wF6UiGyabHUupBACPatSFet-UqjX3sdEWEPHBvREBliSLZn0zhNlLZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dADg-WnjjwprwjQYVp_DXef_nOHilQN40y6BIfBot5w&oe=69D908AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z5yTCh7lBcQ7kNvwGi_P_1&_nc_oc=Adpg2o9VkfbVfl8dDf-m-4C3S8OC8ydTbwvUInar77cHwI6lPFJpdTk2wRMtpwzIRbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dJI4_zeYMFfuNcUB9Sg2OvP2cLC4NwF189x_guI6KQQ&oe=69D8EEF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSzJTaHDOpkQ7kNvwFsfvsk&_nc_oc=AdqIJecOTY-GFlfluG0u0o4fTImuSUOkkz75ttpdtopuNPYrfeGC4ENtYZGZ98ihSls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vKRPgyx_GAaIMoigAhl9IjH_xmrJz9o1UPLvV9JPNAQ&oe=69D8F3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3QwxFOisdEQ7kNvwElBObL&_nc_oc=AdpwWclVHHwzAhKpDQOSb-frI1Ss7ewhZxA8u1tWDvDRAv6M6waa_ojMRi5x_Raxm50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cbzQhBafAVZui9mKSOzZ_NCcw033A_fjWMXgsXsUM0g&oe=69D905FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzN-HNnPqO4Q7kNvwGyqYKi&_nc_oc=AdrY_5ubgbmv_iMVO-dcuJI6G0YymrAis48KdMm43ifF3gUpePHGQEe7GArpcgNyWMw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Th6Ib6_S21772OE9y_YhOwLXBsKsbheC0MJA7A_cefA&oe=69D8FDC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
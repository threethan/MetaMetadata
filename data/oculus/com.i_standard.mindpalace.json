lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsNgo33TAiYQ7kNvwFpkIy5&_nc_oc=AdqiltRzwUZItPVqDPP8uWWkvHfdleLAw1Dip-qa5AaJAvN7YC_W-UBx2uPp641NS_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10b1a2yvgPTX1xXCiXyzrB3MCxq272vR1_JfwbFWbKCw&oe=69E4C8DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgyj2kaXq_oQ7kNvwEbksx6&_nc_oc=AdoENHRWTtOjV9uc-ck5KULXTd0tz-f4TM_Yuue2sa2i5JlbILE3SRodYxywGY3msAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-Ii3jxTKy3P24cIRzyWqBcAs8GDe26D4-davkzSQXYA&oe=69E4E3E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKpMoj8W5GIQ7kNvwHVe-_L&_nc_oc=Ado7V5QVXC4SA6B9RpHqQvTiVTzVQ7eph6V-stO03LuDLhqp4wXOY0d3Po8g4xIo85c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39xwaUIICHNgTEXd0YW_SPe9iYndeLvEwaEWqo1Ieq6g&oe=69E4D133"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Fk9kUPhRLwQ7kNvwFNiKTn&_nc_oc=AdqQkQCQFSfib5jatb3kwHadqd9BH1tqyPJWEnXdNdHLILIJwyNMZ-GmVl96W57v2is&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VEp_mprj8VaXGYlKuZgoHtM4BQxmZolSi_VsOgk8LLw&oe=69E4E62E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlr8tKufZ84Q7kNvwFSar4P&_nc_oc=AdpScgEXHe4kfCyc3HWLNRwtzRA9Jt-HSoSIL6ixeEn2XRogzmQzjrXTmKcufDIGBYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KpSU__xYHMFj-B5T9-a8m2IUiFVEDcQ-SFj7_GOtMwA&oe=69E4CC79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjFSwRgPE04Q7kNvwEyGz0Y&_nc_oc=AdpW8jqJdXw48EanEyDbtbPbkY6zBOViFlQT3xWbLEP8Cv-ugpWc9O3j98kpkd1F_fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OJVVCR0mloTUy7Ngln-Sukxgf61fOMfbnMS8FMQkyhg&oe=69E4D124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSPYcT-oIVAQ7kNvwGTIpep&_nc_oc=AdqBoU3AHpi2oJzEDNK8xPghoKL762VTfIQtG0m-uOrbRJOuhUqlWDvNcuv1LNwWPNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xNAH5g4gwYfc9vPmLSmzf8A6qNRA4fZ5nNBQB2e0Xog&oe=69E4E37F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn4iU-XYkxsQ7kNvwErgWxQ&_nc_oc=Adq3grd6qRuMsqtd8Bk-6OVtDQxp4F-T8zR4z9DsKhLxXRMOORRLS1AehrT4zys34H8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C59wzwuRTuO4xDNcsHe5ObN28VEPqh2tOyOHzTbx3RQ&oe=69E4DB47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
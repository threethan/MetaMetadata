lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vqo-nvhYcKwQ7kNvwEyKYcX&_nc_oc=AdqVrND2eawxZtPQyntkZXxjaQXJd70p-De3NY_rmtBf7-nW7fy0DgTyjUrTe9GsIM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53As36o0PoNtA2Ah_yoRb17SJpcvDKVmdQbBjQtEXVjg&oe=6A14771A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skjmJeWHhhoQ7kNvwFpLuVo&_nc_oc=AdqS8rNAt5CNg0M4hjWQ4VxqhQiC--fvPYbFyywqanP76HKOsXLMz7aNKx4ds06hyx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af737t9KyFUhB8SYPkHNxmXRUTHEeVrFPSq6saM4I53a6Q&oe=6A1459E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbo1uTLZJYQQ7kNvwGmjVaM&_nc_oc=Adqls71xDch-qHBT3rDix4AC_wqsfACZrPdLFkv1lyyEOb3_CWla-2oUh3G3LQmo_fE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jdvdcbppeIeTxuvzNy0BeI22-MNqK9HpSu63wrsJK7w&oe=6A144733"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz1POzAlO8cQ7kNvwEtcQOD&_nc_oc=Adq1EP8jufCydKDGVaZKyoBm4LYaP7Ki_qUtOwxt-t-enTUzv-fyddXvSs6q9IOWk-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c7eyQhPVmLQp0yr54Fz6W-tUJBjjITe90bXwtKhbk-Q&oe=6A145C2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmZF4CqN8RoQ7kNvwEa0JYC&_nc_oc=AdrH-Pl6ESUrW0PMWP9l2prPXfzFOO-Qel8g_BqKOyprPe8ppyEMKEelPFQRvNIsJjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YgpWK1Z8hAijGqPOjlJEmwNUWvYFsxYnXnrIySeXExQ&oe=6A147AB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDx22u_fVYQQ7kNvwE7uuSk&_nc_oc=AdoCjEBVQeRCCOQUmjiKBVrtX59IRpzHeESj8zV4lKiRi_ghwrQQkM9wk8qXsxwdxMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54rAoMewCeTIlSv4tAWWAa6aM65xIFujp2lsVZJ4YPDQ&oe=6A144724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgKuVTZMtSAQ7kNvwH7rNv-&_nc_oc=AdohFko5QTeWvO0ig9C3Ud5yLaPja5cA5G1lv2408IRFIQ52e6UULvPL8QXxiEswNN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VukbKL0JyZAoQkx_ApDL_E4aNANN2KNCGDTkQQUjCLQ&oe=6A14597F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTokcpH7Iw8Q7kNvwELzfrH&_nc_oc=AdoqbKmj0f_LcnXBbh71AfYLjuD_L6RRBLcVL780vuqtKMF4yUgGWflUlPhVZii2QNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QIdKpzhCcgS7Q-fmCaxkMFngiiTp6lJ7tzIVPMcadUg&oe=6A145147"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bphuaM-fXFcQ7kNvwGpT95U&_nc_oc=AdpzS797ovzFConchkHS7R0Al8f5YOJittHy9h-uEMVSSklITbfMDdmQLSEdUJGO-LQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9Yho8xJerUo420QNqD04fvkw9_ZZcrJKGdWEMb2fdxA&oe=69D1025A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM0tLcvCut0Q7kNvwFK28q1&_nc_oc=Adr81RHgdx4mFOz_H2Z9lb34EARs05uW4tHvqVLSB_CU-cuaBOHgwFv9b81BJTdO9Ps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweVAPlA5J1o6qhX1kG95UKL-Nb0j1h99LtUZkKOpfAoQ&oe=69D11D63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkkllziQCfoQ7kNvwFNJbCp&_nc_oc=AdqpGu66TQhDhQWYu0SJzaYUbTaep_QuyeicHIi6DVA493v92TOI_cFknxs94Yr8XOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1Gx5v2RSRzreR_LAkTAvPwQTbMDSsYREITnUyHDZ8_w&oe=69D10AB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJoDQMhhvYUQ7kNvwGAZaXd&_nc_oc=AdpXtPbbuT0FZFoNWhdEwKnmZ00mPSh6Ak5nIEmq4UMY-iCrTNKpltvz6kdvmHZ24X8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afybpa4qV4kQ_MpsMNEUIIri8Fay25tghHXv3Il5HI4NDg&oe=69D11FAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJfx9O18_KQQ7kNvwHDdT9M&_nc_oc=AdoUmXXlanaHTZmWs8Z3fWUQAJC-qaGijhWaCzAD4KWnqHqYfjh17_i8pHGWhLKdwCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv0mpH2PvY8IoyAN5GkHCdkPT6q5xjVAN5yRgX9q1Erw&oe=69D105F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyYjjqHqTdcQ7kNvwEGn7pe&_nc_oc=AdqvkYbaSpxfV5zLzY_b8-ugpjUFEb248ZHzonlK83oT3HJItb2uQr83vql9jDXAts4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE2k4-Ejl88vZIhO2qfmwZ37wbl-aWaGMM-Dh72dShEw&oe=69D10AA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BgSapy7Dz8Q7kNvwHcuORN&_nc_oc=AdopVFrvzn8Z9RhHqt1Oq2J1TU-rLRBVIxXG_MrM1FxoV_CbgYQgQzR3lbFo29qQnEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPiuv0pKPr5WHyVy-mxYKHU7VvomNRewI2T0rDEVLmUQ&oe=69D11CFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2RPhHmX91kQ7kNvwHfyrSa&_nc_oc=AdqO_h9-zuDIe7D5jjsGv3CtRXdQTWFDHI4d0zG71C_iWjJx8UADsw08TFLQvsH3BBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcgzQ4kXTdwI52NMqyNthUh48zJIu55CpytqF6BQxZxA&oe=69D114C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
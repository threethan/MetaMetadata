lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2f_BDaxFREQ7kNvwG3uzyF&_nc_oc=AdqxXNQ7tbblorFoJ1JN6n2AzdENQJdR_tcBuTiSOg3DSeXrYtRZgUP8RPM6o2phoaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOC8pQZUc3hJYdYIk19NTMJ9eYVkNLW35jHBqCB4zBdw&oe=6A999E9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbU3pQTWDiYQ7kNvwGNZpes&_nc_oc=Adq0-qeKBM9nwEYksY_SWEIwpUsvXs69OfWBy6_ztgHpbEzacMA2tCyP9DfJwsYv2HI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa5QjU_VyURxmlljb9mULDBq-nzRCjNMKqdAvWFpCJMQ&oe=6A998163"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsSyPgwNvXAQ7kNvwHjk-Oq&_nc_oc=AdrHf-zpYb42yedWNT0_F9-zwXHnV33ymQeR4tt-kKGIiLd99TD1pnSrC_LGW4QI7Ho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxGIduSfy5WSKWFv9t8FSuyPhXsjX0U3tzf3xSwMAaTg&oe=6A996EB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxepyAvxjC0Q7kNvwHALU43&_nc_oc=AdqIIazqwsKzvrvSAeSt6Gt-wR1NaRSCqsXTb6XocugrTli0XRIBn2e3pzeEAIdB3cQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdrG_lqDseFVkOQthJsyqA9di2QB8qPGJn4RPU0epwWA&oe=6A9983AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bql6eJMwh1sQ7kNvwHYhkSo&_nc_oc=AdpSlGmrT01QHi9EaQxF0F5euHlK5obPqpeSnqKWWUnKvvcMoRNXYKzhh66rE49ad6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJw0Z6yxBzAi83ySqyXO0u_50xYzZZ_ayKfcKHy8g1RA&oe=6A99A239"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPi1lVMAvPQQ7kNvwGpMr6O&_nc_oc=Adpizdjo6AlVP4hRmZXLTIKezYH47wcaWpXOIGkoBmFuBsoFLzwmpemJw1BgFizbUc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7k2J-_wnBEF1KFv5FQRLMa0KiyZRf2Jt49U5x1nyMVg&oe=6A996EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX3CT2l0GZcQ7kNvwGAUPVA&_nc_oc=Ado2HDmXh-8QlwPxSykCMgwROt4jm-_8GO4BEVWRh4rkSIhCH_7Ssy-vqcoLEAlqnfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo1KZavF60zKcA3QXQVLtWWyKpPBUbsQRySxqx-LTOEQ&oe=6A9980FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGTM1UstUawQ7kNvwGK2GDb&_nc_oc=AdpHn2hjKgrOeFqM15cUBNiXjn5Tk-QU0jple9QEAWhvFbsJ6ATixyi4Nd0s4_7mPQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_bNOX8jWN9z9A4C4DuHGybPgwzUSp98ZYhjxvCus7Dw&oe=6A9978C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
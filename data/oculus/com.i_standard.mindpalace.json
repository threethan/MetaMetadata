lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC508laf438Q7kNvwH_gINy&_nc_oc=AdrdI_kN4ovjEY3-0HAGeITWuHKCz5AIZBkW5qPWjwYMrE-ktyR4UrH9KMaEMIacERg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4fCtIeDJyGak53JG5Fe29tyX4i7Mst_PeAdv3HQihCA&oe=6AA6955A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_Z1XLjnsVcQ7kNvwGZMH6O&_nc_oc=AdqXthNVFxT3wbYVIw75nQXsv44q9ehcNPGVTRlyn4c-KJlWohydc_doQuop8n2jbQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8XCT75YKHRbKwbcPZ5dzP1SP7fhzRpMkvtOyeMQiD8A&oe=6AA6B063"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPtfXNmklOAQ7kNvwHiNoWd&_nc_oc=Adp3COqgPrsFz241zGowC4qLTw_ZINBB9H837r6DmPcNKBk08Srx7L1RSWpezkRVrbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5xFIEvjJbyjEa1VaVCe8k9JMlXQ0FPBIPzaD6pZ2R9g&oe=6AA69DB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUKMnXU3h0wQ7kNvwHLkymd&_nc_oc=AdqYx-XSxYLcAzOLjrUuvO8obz2HC4FkhhNRfDRIbKVuD34coI1ei_LyZXHVFPUfmcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlxn4CqxXVHGzP3AqdG4pitlvE6jyjuvGHG9AbyBp5Rw&oe=6AA6B2AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAiIojEPFQUQ7kNvwEcwYcu&_nc_oc=AdpW0QgVRPQkruhr2LyQJhUpU8ENBPCZ7SNbtk_87gg4AHer3WdZbUWth0RYIdY1EMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhZrNSToc3Nz4Gsg9eckadeNO-4SkEdOH1yC_8ahfEFA&oe=6AA698F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9LwA0gaOpkQ7kNvwHNFTJY&_nc_oc=AdqOA_4nj3-kZWENPYJ3_gVWlSqkfyrUEzpWP1_s7lOl4ASjkOewxNbAJfVftIo21ag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILeOx1NiwGeY2G1lvgCwLLibPhzf9TsBNHIwiSmBm4Zw&oe=6AA69DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1IATPBH1ugQ7kNvwG-zlDU&_nc_oc=Adr1PM5OovZx_BrSO-T3TiOoafvlyhtbi-PRLbD1hRjAgdAIvLjJXc0CYJiuhFcpDrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITnoSuRr2pIf7TsBiauGsxvGlx8V2zkKQG0LcWbS2Chg&oe=6AA6AFFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yfiddwNPRMQ7kNvwFAasEc&_nc_oc=AdrrUK7Puty_hz2S5oAmUChuxBysoai_T7M9hSClMxIzeMlPNikXHrsHRqAcQIOx0qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtBtRf0rPd-LyoHsgG3pM8BEKpkHy8tkQbpmTMh5cAmg&oe=6AA6A7C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6624-9KeB4Q7kNvwGT_fOi&_nc_oc=Adq8PEyBBm3CUqpeD9V4oK_Coc5oqmTacNhotzb4UOukpV_FaVnkBZ7esaSDZ7XaLxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOblQdJ_pMiCRrmQUn0NPoq3RVhTQIWHvgIi5ewd_UiaA&oe=6ACBB79A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RslZdt84csgQ7kNvwHc6LRd&_nc_oc=AdqZOmPRZSl_A_fXjq6QIBqkQh-2bLYcOJAh_VR_Z09EsAgb38yALQok_wd7DhBbFzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3EEZiYnqNfzParTCzuvVMcU2BZia6EGXTmfrwJ_ssJQ&oe=6ACB9A63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IG0KE5ak5IQ7kNvwEc2RmT&_nc_oc=AdpPf0Hbb9YAB5RGdWicpsPq568__yd8Ua249p_gwJD7uRz8mLAZJCRejLq9tDVQAmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPESBPeeF6MZnSuv66GLTS1WwcBje3Dov9NTsXILVk8gw&oe=6ACBBFF3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi7tlnwIFpUQ7kNvwFsfk2V&_nc_oc=AdqD5KUVX9sG_Ox8gFSBPgvXwakaawNMb7ow5doj0PTt6BAnuSgLwMBmB1sdJWs0XSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkAZ8NoMnrw1VyKycMonTzFNpnphqNDbmx2rbxnH2R_w&oe=6ACB9CAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4_Z48o33y0Q7kNvwHg4IX6&_nc_oc=AdqhbcrlZYE-n6a6mSTc0CDaZUCL8Gucz2-my5PEIv2lPtn-xM4cskq4k4DyVLY83S8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNopDoW9E_rXcJLJuQbpbB4E44JsrTaDkbdhS6kYwsaEg&oe=6ACBBB39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VHxQYbAugIQ7kNvwH_htpa&_nc_oc=AdollHPy1rJM22MgX2QmOkswULXwfoWD0WhWjQtRxyYn-kMxAbAVEvYlJcJ-I_3N-uE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0JoOOPSje8hI5Yu64FClr2-bT7gWEdAENc9ESuEkmNw&oe=6ACBBFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEbxHsAMx5gQ7kNvwEZriJ4&_nc_oc=AdqzkGMVx0zcY55S5PWD_D7ckgVwPdRgVCWhQzW0ACAsoXGth4txhSIEQ2zcu_cjgTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPjiNGmkrhp978-nFFdZ_fq0jd9OmfL4K_htBpdT-P1w&oe=6ACB99FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soNSFLvXDzMQ7kNvwF9PFJN&_nc_oc=AdoeQr88sjwwzIPgTqrCIzpsW4RqsGAvqeUuBNI3CVpx5QUt-PIYaBuRI-KmG11_sg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJsjlG2KTn-XpygqjumlWlCovZG8feyrH49dQg-06Rzw&oe=6ACB91C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
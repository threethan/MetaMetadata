lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqV1cOf6O7sQ7kNvwGc1_YF&_nc_oc=AdpZPQezlk0m7N6Oa-HEDCm8dN7NLvG1pwZ5weUU-WUMevii3hD3VqjE-8QBgmlMdE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S8xhByEwa-rjF63eTwflgzpL1l_lrczWzoF108_zE6g&oe=6A4111DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Eee9Kc2BnUQ7kNvwEmBCcg&_nc_oc=AdqG3oJsEWYgIX3hMoWHM6oBmSVPJKSYnBhTHQAyTa9zEtwR6LQQA-Z4Dx7b7hHE6T4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T0Ggxi1UfKJICUOfE7rvSa3r9gn5xaMv1dB_Kotozsg&oe=6A412CE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKw6WNSAAIcQ7kNvwH1PExc&_nc_oc=AdqFa1Ls349aWlATXJZIWSKAx6vq7BHSlQDVd_7z0-aPPVCvP-RsGmboQVZRvMqsV9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j6w96n8LT0dNd876FtwIiBtSRjZDkvH48iUpW-tJZyA&oe=6A411A33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3-7P6sWOWgQ7kNvwHOTeXg&_nc_oc=AdoQzSDuLxdEfvcaH2UM-Vt1hPy48X8wzJQR0atTqyxlyGNKesCKO0onOGnbb1j7I0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WWu1M998KoiLX03JNoYEKlhGL8e8du0QDu_2Kgh4iVA&oe=6A412F2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fGZHprbnLIQ7kNvwHdTNBU&_nc_oc=AdoxqyF9xFxivyozA0Txa2rWPcp8yRGr3QQ1f2QZmL9NoszavbyRS_jMQo1SuyTHiLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xjSY78Qi1NCSGIZeDyV0SwipjpW7B1WYLcIOssqjbAQ&oe=6A411579"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5AARVjgIbYQ7kNvwGl_ftx&_nc_oc=AdoEHoJSCx6avOdnWwxt7zAwxcbR4RUx8QyeFYivToJ6iSBDmSOcGuurIxtS1_BKkLg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91oemYw6AwmluT5uFt_qd8dyykRHoruisg7tBhE57u7g&oe=6A411A24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAIbRIHCICUQ7kNvwEljndl&_nc_oc=AdrIrRflb64j0KwIAjygNx5RBx-bOrsdJe7MVkmbUok3l-o9rcD7zOQlRZZ51TcGWc4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aGLhyHjQYfXFMRo97KZxAYbF8gzhf8rNFIQqVtK7SrQ&oe=6A412C7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvVnCNzw9UQ7kNvwHO6kw2&_nc_oc=AdovLSd5pzHSnoYoEnUK2BBM1OXbepD2ojh4lhIJcsBttJ6apCcln0YPRtFnXdyqMCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J0n9LtbZooAkt6jsT0m7sOk_k0aP0K5LR4uv_3WtYXQ&oe=6A412447"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
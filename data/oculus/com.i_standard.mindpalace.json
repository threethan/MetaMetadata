lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXeJvDkGMesQ7kNvwE72d8R&_nc_oc=AdrQLx7ttCPnAnxtbj5EDKK7Jt5WLZrSZEl_dr91K69kUklgPPi7kxXJ7n_EiWScJ6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx6Zdsm73rxnaj6h4NCuvE4CzJ3q4YS06IUzVrJErtjw&oe=6A79C25A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5PtE600WjgQ7kNvwEgNjo2&_nc_oc=Adq5SgyEOHgVA4jnPPOjpMyb9920oGukuAZAS0LMTJzOVa8sNz053zveDzz7A6rwN04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwI7IPf2BxWfpTKqMgUHr1jCm9f5luYXKZGkDb_rvE9A&oe=6A79DD63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31xJ-kh-sLQQ7kNvwHSMuJm&_nc_oc=AdrHWydrqO2Iw20v2av4KOj8EwkI0saUtuV8mP0mRswreRVTaCVFLeaZW-Ft3ZQa6Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg9iyXYwwD2l3QE9p8JtbP6VauYtgKCJsHQL6y0XNjyQ&oe=6A79CAB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=952g23Mi6UsQ7kNvwFv01kS&_nc_oc=AdrqPVJdVsQO36V6-LMAs3-OVjH9AvzN-k15DYcKqEhJLmLhkoiP2ND7GnP-RckfjQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKEJlwOrbW8kHaeowrSi6A1m-hybDN5YZt9NhUN3xzUA&oe=6A79DFAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF0Us_mKwmkQ7kNvwGyOIqE&_nc_oc=AdrUIKHg6aj47-OHkzzxQi82kKYEgIHwkvnXSAYNk4ypCBq4X5CIHFKlTsCgIMYoOoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5MZ46WtFsfKr834KOXeTlaP4WmZdF7LApsuhve_96ag&oe=6A79C5F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiKroAq-skEQ7kNvwF7awXK&_nc_oc=AdpZAfeMm60O1__UrVim3yGPkcw3IgdDP_oWwQBIcxx3Zz_pTkTEgwUO4MuLnWgP7BU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx-HZHv01eGD2uuSFXg5xaqKA9HM8ZBXYJzueyo2xpTg&oe=6A79CAA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJDurJaljRMQ7kNvwGSFuFg&_nc_oc=Adp_kj3bezooTM2-9ULoXlFjO0kr5ZZm46lBnnruOQQq7tV7QThLwofW7nIKTrqmDW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL1j9_pmGu6rSubjhKMDSzfibxNzPUaIrkYXTusbEhXg&oe=6A79DCFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQEFXLiut5kQ7kNvwFuG4II&_nc_oc=AdonjRHSrWnwhaLS9Pt0hlly1udEAAUQX39DJuxPZIvhaImhKUkludLRmbaw4xAAKhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8F-J7trYbKq5Q91p6bRelfSzUWVhwoaTuWhwGqT_XYw&oe=6A79D4C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0euMVou6sYQ7kNvwFywaDB&_nc_oc=AdqSWYcHHpP8GFhTHUhRrIUW4UUnFxx67f4rLvg5nDzMW8Hqyf6s4XYdCJ6QOD-yaf4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN-WPoI10s4rIYua2hSXmBFrZ4Yh2wEq11RbWE35xIfA&oe=6A89945A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHc7LLdVwCoQ7kNvwFymMpO&_nc_oc=AdpaxH6KTH3aB-KEZ-339RgzJA0cEco3PML2s-8-9fxldCBXdg9ZlI9oQsi0_AcA4wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjeZD5omYfBUWe9msIjMpVZ0eaOvXUzd7cpzKouQ6t1w&oe=6A897723"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaCStzgg_dMQ7kNvwG2tS4e&_nc_oc=AdpmuxMn6LbEDhHlFLJk8RvwjUqRH-aUZcTZzg609a3ZptSddupJuG8E-MgeVwTSORA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUbB2Jzkif-ZZmrtYCKfXXl282GVmLH6RT7Wtl8sR38g&oe=6A899CB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWJ74VS4p8kQ7kNvwFybZPa&_nc_oc=Adpz-1i9BvRf-JMXS3lspDnJcrJ23eBZqWF2tQle_CNUic4DkkkdpQEFjMM221Fc25s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGUSdTwzHWV9Hm41XyMIUtVZ5cm7HTYXMtXXoRSc2yBA&oe=6A89796E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeyi2l_oyZ8Q7kNvwGM1eed&_nc_oc=AdrjA37NANbaU8y7P_yt-GGEhnrXGrvnEVeNen5KuxqMmIiYAM2EG-sTd99w_h2iW3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwNfK-84o4Nj-WnRQkNEa3J_rSmJoqSloCLbl7N7LQnQ&oe=6A8997F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FlbSDeUxf0Q7kNvwHFTVYP&_nc_oc=Adp64hOez3hgvcDtQySlCxDF6fSs-__RW5wOzcXYMceIEtSGsfephOMwehbfEvSNiHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ITT8aWPci8BUtdrSAObBRA0CSeDu-4H0FtkA2CS0jQ&oe=6A899CA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxx_4z7nZNIQ7kNvwF883dW&_nc_oc=AdrqzC4s3T-yJYdU3eiuS5HCjMRCR1oK4EXROqPhQibHGr_P3HqzwB7j4ksU70M-qME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCwKnpvVizDSkoTuhCcmKfmK9qjDFD55rSeu-O007i2Q&oe=6A8976BF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQeJoAt-Ee8Q7kNvwHedSiD&_nc_oc=AdrntyQCUL_S15g8LWQgjxygmsr3WmXrnHiG7x9jribOwAkTjuqL2vu0ED4Hc9hDr2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI-wLLTdBaP1871NeV88Q8BSPvJMGELxN2UspsqE8NNQ&oe=6A896E87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
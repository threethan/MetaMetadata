lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6624-9KeB4Q7kNvwGl7eLr&_nc_oc=AdraFRaqpQK00e9F9q8kQ096GKa49jD4lM4n8AVHv6ZbrS-_egmL8Y0oqsxpsUORNSs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBY-ZnmdVFOtkmHpsUHw-fkTvN5ylqtT69laksIXAH6A&oe=6ACD091A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RslZdt84csgQ7kNvwH9IhDZ&_nc_oc=Adr3pb0nP9tdo5a5S3nHB3zFuz2LrYEqu9tPu39w0W0yPjw7r6I2ep8f7wgj8EbS0Vs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUbUIX3tGJEEvZKThruXatu6m6MD5zypegIJAIsAy0YQ&oe=6ACCEBE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IG0KE5ak5IQ7kNvwEten9Q&_nc_oc=Adpnt6sLbOABUHQRHtxWTCE_HqGGk8HB0zcYq3Atr1MwnVTUR5omBqvJdjoStk6M0sY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaMZgFc8ODzGKAmoAOwdys2PiNcpQq48v9BH3-LV_23A&oe=6ACD1173"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi7tlnwIFpUQ7kNvwFc1v0F&_nc_oc=AdoyDwM2r2f9j9A1FCmXOkp84SxUoXB_bTIF0IrwLbYlZHgqtnO5xaMDujhJnlg9Dc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpobVhu3LK7s2ojiCf7q14H3u1mpyRnuIYSYKj-DTMsw&oe=6ACCEE2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4_Z48o33y0Q7kNvwEEzoYZ&_nc_oc=AdquKXUvEKjEsCIOSSMz4gxzwmPEmTcy0z4VhYkYb3YKyz53YCjx9anHsm4UzcRSCbY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQlPG9qtp4He4LZUgSe65CGFMA2cON4HKAJ3wf0LTh2g&oe=6ACD0CB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VHxQYbAugIQ7kNvwHviqAf&_nc_oc=AdqbK2jTE9dozw9LVNNJQ4VNn-BK5dQNePkT_l96sM7bGpiF2thfkvsSNo71FbGs1Wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTTk_y29ypYqhu03xVGMO2Zgk3G3A_Iu2ZvWoll8rRIg&oe=6ACD1164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA6eQAjGkFgQ7kNvwEGoLGL&_nc_oc=Adpj9d-RoDkTtpHEreqXw10eQHi-BQ0t2Rid7hwJ3BUAichJzrsZN8d4BeEKmcXrhpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMuZcY7FfqTCFg9-9GdQ48Mj-9Rz-SMcIDFcAC3npdKA&oe=6ACCEB7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soNSFLvXDzMQ7kNvwEBEBLE&_nc_oc=AdoscPkxBf8vMjR4b0oI0DznYmsTvsSe09BVIQvxfA8OG16lXVKyzDVjiXgByd1NkFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkz7_PQe-9bdnBonQadGbhOaATtPJG6m1KqB5RrkYnrA&oe=6ACCE347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR_8Ao4hzKEQ7kNvwGaZPIj&_nc_oc=AdoWEmL_ozl0mDrGf-dUAQDCAv6AMN5M6POUPXj65ZSVQJZqI1jminHi_zlWHmeOprk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wmWW5pstn-o4E2tcx5duItYRzsIUAbrUQpJXb1iuA2g&oe=69FF26DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLSCmNGiyusQ7kNvwGyy5A-&_nc_oc=AdrqFiCttAzbvM_McAq-iXgzft-D4vB3sawdxqLb2Dm1P7AyawfH4PJAYRIJr8uLTNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lGEvp2xgI9FcvH0V4YfdGM0hW5u52CGvSGNldLsV2jA&oe=69FF41E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqUTAYbwkcwQ7kNvwFhY9De&_nc_oc=AdqbgjExn9_3GezjGmKGNNpCgbFZ87DQ0I1R-Gdo3Df52knKknPLh7bBS7RKimoB-eA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MGl5dxb49-XfViP_Am8wJTNzHzd1mcP_Aizu9Ma3j3g&oe=69FF2F33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAhe6dBVlfUQ7kNvwFvyJRz&_nc_oc=AdpqbAatdVhv6FIf7hMxdF1ZT7UK7Z78EUY85eNcjK58hXa9xjvMepPKFzzMmDYQqi8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46quZR8c2jijhCXA0oCOciyr7CH-KSNT4BIhG_ojeHtg&oe=69FF442E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX7apbQwZF8Q7kNvwHhJPv9&_nc_oc=AdqHjNYAUD8c8HwgY6kvgmdiTAeL5PZbbCD5kccfboEThPzCGQTndyVNJFn0w3JK5qs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ee63StzQ0lWpGFAgStwmNvUJ9ZjMyMXJJ7teidbV0gA&oe=69FF2A79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iGIhjqHeekQ7kNvwF6Zst8&_nc_oc=Adq6oTrZhC2aV9VtCEENHwSlCqnw3dUqZOSMwU3Eo2VKxRvvu44SWg_-D7B058j-WqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wnKcKU3K3rF7rDLs6ljtnSQEZ5PWcqY7QF7XCJ3ChbQ&oe=69FF2F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3irHIu0C7R8Q7kNvwHz-M3c&_nc_oc=AdqA9oORqStyh2aoUoptcc2cTTmqQkefOZJx5xaleXj5jnc-tSP-2qFO-BuAGhAhtok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AQfbx3ucrHi7O7TRX1t0lvL4G8nCGpw42ShAfNtr5vA&oe=69FF417F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVFO6EhNWooQ7kNvwF0I8vT&_nc_oc=Adqpn5Itpqa0g2V6bh9NOODeHQm7fON3cjpL-KB9JCl0hnhaFRY2cbhq4WsS-_Z88ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c-18urfeO00AduUQY7IxBARH4U1miWPa75Wcp-pLLNA&oe=69FF3947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
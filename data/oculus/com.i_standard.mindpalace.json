lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqV1cOf6O7sQ7kNvwGrbxR3&_nc_oc=Adq170Bq1h9xDunphJjUDwf9rfY7qxxs7VWkkGu2ZTI-6t27TFbjJU3VL6gSN8EpwQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qdwhRiiAoyeCEBq_gIukimf_RFnQa8qu6XbhOj_Ufww&oe=6A42635A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Eee9Kc2BnUQ7kNvwG_L0NI&_nc_oc=Adok8uDliTeZRDRe9tHbFnsD3mnjjvfh5Ecx7BYHxVo1EtjA1lG7HqXwIfHFaPaOHtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A_UcVdejRiFzm_TNcOFeDvEiFRTpKS4TllSK-uCd5hQ&oe=6A427E63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKw6WNSAAIcQ7kNvwH9-WVO&_nc_oc=AdpgWl9HfEQ0G-sbYg5spS3Oe3Pk7l6F9Ycz3KAFjQid1qqJ0Qenl3AF19bXsyMu7pk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jt-HhoRKCUgSZ59XravkQldlCFv5yjk6Iko5ltPnL1Q&oe=6A426BB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3-7P6sWOWgQ7kNvwFJaoIl&_nc_oc=AdqxTDkOdP9sC3NbRhtRsJzGefCU96mQp6I7lniHgtiZ10RyHDHu3ODvzS7AZpONYek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fZ74TIkkY-0U-3mPVMYF5L-FbhJWVwPbhYrUCh1PqVQ&oe=6A4280AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fGZHprbnLIQ7kNvwEFfeoS&_nc_oc=AdoybLqyHyDRT_c5qgUfNT9n-P_ff5QoviF6DK6MbgqYBmcBTT9m3_XldxfrFRMo3C8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8asxE1tDCI7v1o8g__4z_0bLLPu_FLhpkCDD61mgTJKg&oe=6A4266F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5AARVjgIbYQ7kNvwEhy1QK&_nc_oc=AdqQZwoCW13E6amjwC6eIQoH9V2fwjHHLmMYHUUcaed_FTK8g8gqLXLfzDeM2cxRWrg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EXnFFQvDlg4-zYtctl0mpbhx3HlEOh1PB3YBAhlRXTg&oe=6A426BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAIbRIHCICUQ7kNvwGsTpVc&_nc_oc=AdrEmbvuJ_SG_VAsCW9wueyVgzLo8ZkFyfnQKW9W-jQ2-s_D5XVHD9VPztDZKZtOArk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g2kP1yUgg1NquPrr7aqlgm6WCcQ47wo9TY5u_RyjMxQ&oe=6A427DFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvVnCNzw9UQ7kNvwGF1mIK&_nc_oc=Adon0QnWwWfJGTFo-gYJR6bzmi3BTPF0TFWlkevHdBLr4K3YdiEHKYg9ASKRWwzOurA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pK4fkJS5gLMPztBv8C9Ctu4eVXyZq96X1kUHqV2krig&oe=6A4275C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ6Dg5POf9gQ7kNvwHx8VSJ&_nc_oc=AdrULbiDpoo2HmNSqcTKvIQojtbOqB8VAf_EiLr5_OXh0Cwz79TwNl4nz3d01L6Eqsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAUfhQH0tHV69wC-gEG7aJtX1chNi_Je6-W1tM_1mWsg&oe=6ADF45DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s4rMNUw8yoQ7kNvwEmalx9&_nc_oc=AdqJc0C079pCEqtBzHGtxGWTeRH7nGuMzJstl7GfEKiPKKu2i4bbI4DIvHMwTWMWNMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4u659NcF9pwRq5PqC2SQUfQn4HnKk-Qh6-N0Uk_embQ&oe=6ADF60E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A072CksY2cQ7kNvwH5m9SL&_nc_oc=AdpRo3eRgnCgEO7vCv46EARC9G5ckijEY4EM2LP0J7OULS4otgZj1fwhaxk-8RBD4nw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx3GX6WMJgQreSxAg_iZ5RK4mtLbmQHosjJbhnDMjgJA&oe=6ADF4E33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrvLAQ8cuAcQ7kNvwFNqmv6&_nc_oc=AdqGwEiEVK2bjUks3Ll-8M75pGyQrN67kHqAJ_7ngbTpNTwqRUto8QeUXuPUgNAy3lk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg15hC9WLpmYg6j6yzt53rNLi9zB-QlNroKuHak7uh5w&oe=6ADF632E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rMIC2vZTQUQ7kNvwEgCEfe&_nc_oc=Adq_63RnA2KsyMdg3d2S8Ao_5SkrpQE_99GToqfIqH0RwFvN0WsKEejuMkBsmH6h7sY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFwxw5F4Ws7-UR4d6F6ZvLHb20jEI_2SFVrJ-d0RQCMw&oe=6ADF4979"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BigpSOkogoQ7kNvwG2ZWf8&_nc_oc=AdqBopDXr6iwrg20PvjYDX40ymDhsheVYJZN8Aj_Iy8-3nUlWIfm_UkjSEQpsdjiIk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsu2Q2MgDXHSuDk0AdpqN7LJemmmnXn8EsYXg4-3Eedg&oe=6ADF4E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRSRqJBp3BEQ7kNvwFepl2_&_nc_oc=AdqvO00hWr47N9CqdIKEsOOu2OQlefZyPy8XQR3fYZvO61Yl6Sdqbb2MjP3NRrDckro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC4bxkzknzEy2bTDxif3dsJGnvVcxtSK5KsYkGUos7Xg&oe=6ADF607F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnrDsOmaJtYQ7kNvwEq8bSC&_nc_oc=AdqPtEqigZpagz5isvwXkJyZ8mJDUvpoZWr6ROXlY40LgPOA-w0Q49L83JfQLiyCZfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4Kl-a4RfuAxO7WNpGlUAd1S8LjGITI9SDRjzpYzYD3Q&oe=6ADF5847"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
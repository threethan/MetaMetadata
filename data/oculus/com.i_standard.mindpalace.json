lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGwsU-m7Ee0Q7kNvwH8A_cj&_nc_oc=AdohPWgZOe5ws7MQQq9SW8cOmhmMt22jQFMNqnfSI9FG-wvpOb0HexVngsm0WWjpJH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nwRDKLgKa8MMWP1XxPs-G6KRSDND3D99tu1ZliVJsSQ&oe=69DA3CDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scdYwQEBrzwQ7kNvwGkHdz5&_nc_oc=Adru6nSxp9WhfKIFjR2ULeEkNT_8ZmnP_Rx6mQBKr-Zzm7kGLTqjxtKzqvSVx2i-nWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xobu2cn3PCJsVyziV-Lc_ILj6cnNjWF-QhxIXpmzeYA&oe=69DA57E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_zE0kNinzwQ7kNvwEwco0i&_nc_oc=AdrTk_PeczeCV872h2pOfTkqa1E0FluGSPcGoIlFGJHUpVQ9j33shxDDr9bxF0O0ntA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01za1bDO-Be0giMI6gtY5u7eplJQavcDlNd_4yi_H7UA&oe=69DA4533"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkoQ6l-JJ28Q7kNvwGmFCAO&_nc_oc=Ado7edLTdWwE1r17XfuEblWa0kU23FAyk1q5zaiYbeph4tYkO-2t67zZB7N4duuxFmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kT8luFy-9IEJIM-8wdDgV4qAjdphTu_XPrn5PMg-2Pw&oe=69DA5A2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z5yTCh7lBcQ7kNvwHMPeG8&_nc_oc=Adp4Oqkth9IIM5Ob4JTxIEhY2Pj7NDNZJLyosErBm_GpW0pPGRXxRA4oeCOaP4bMrD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jDDdDvHsfXVsW3lYOqWUeYzum8qdq9_MJsdMtQNAFVg&oe=69DA4079"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSzJTaHDOpkQ7kNvwFhrW3r&_nc_oc=Adp8iaEIQJNxJ-tRor1TO7SOh2MPbhj4c1wWiN1cabeAwkm026fzsvrbWGRxFRf9EF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BkS9uriR8NGWeQjc6wfy-G48jrLcrD7Ndl9hCbvmPtA&oe=69DA4524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3QwxFOisdEQ7kNvwHC4BNp&_nc_oc=Ado6at0fGukRdCwBu98VnHvrmSOuVl086LO-Kduu7KT8fq1QwegplNX8dA26jC6hBeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xUbk_TKKoGcC5VdlwXXF3_wemGKMJCwBi2E3a1SxlUw&oe=69DA577F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5FM2K_RlEgQ7kNvwF0s8l2&_nc_oc=AdpD_l2jne5jcV9gJJJPIC9JXtB9H-1FlAyd9j5yRUmLhTAfEPo4F59H0IC_iycnvFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15hQb6kMuQ2v4q81HFaECuh72T9M3ernzxemnXH0mP1Q&oe=69DA4F47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
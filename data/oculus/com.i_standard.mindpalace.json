lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNoK95d9LK4Q7kNvwHfrY__&_nc_oc=Ado0_0eQiA-T6-bPmwgFxBsQ17EctVPOoWl4EzFvL__hC33-KVrdpVd3Q6TPBsEDGtQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vuwhGYcQK5M7t59CFga2vnEOIJQ8CrtEknP6ggfieEg&oe=6A1ECADA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzlfw0VEt1cQ7kNvwF4h6pY&_nc_oc=AdqqVpyE-SLedsQNhIoDK7fmPwcUwyMIJ_F9wgmjU4fONTOnCiiBIDbBwGwgpQ1hO5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DOeAYjuTy737L61ilKOnkwI-us3knikFSFaTrA1kqRg&oe=6A1EE5E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm46qUaJyTQQ7kNvwFYMXOp&_nc_oc=Ado8JMCEGwplgmV4Kcprt4W2IrKWS4PyALIEdZlGkyCVtleEibNSs3ivdzTXEgGgP84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75lmJhmVDPsT6EgJer-1PJK4PoB4wmHZ6uCvn9n2f9yQ&oe=6A1ED333"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEY5IEn21yQQ7kNvwHw1oXO&_nc_oc=AdoVU3Sp6qCrnpBP2cXjHECQLZpcwS2qhJrqtx9cAusvPbIVea442U5bc3PItmbFtD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YTybtYMSlK8lwiWlqhfkFLCn-EQ53eIMDYJ8iHaNorg&oe=6A1EE82E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKZt8frM1TcQ7kNvwGiDys3&_nc_oc=AdpUyzIHOlp9qmagEDfrIY4FI0owFD6wZJYYg42dGXdwDyGNgMERRh67te8N6rTjsoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Aitqft9H4t7LA1KwU3xv9X4IMmuBBsulhYdjOik2s8w&oe=6A1ECE79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_PquD7fs9IQ7kNvwFVEAvV&_nc_oc=AdoufpqHv6YXmpcPiwozQ-8fTbaV4rcgZe6XC8q1_aEBWI3MXi5WomzozdfQtKCobDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XslBX8CeP92tRb8DXtpUjojZ6WCJ4vZ-tyzajdQKpsw&oe=6A1ED324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2eAAhg4CTUQ7kNvwEubLih&_nc_oc=AdqwzLhAW7UBzvAEE-IY2fMUUJB8_Il8C3LH4TbYb_6slOGmNpgCr1ciZEDFF9OG3tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79QVGTSCpG8Fo6J3r5MDXj7MWlaeOaRzf-CmQpwzXszA&oe=6A1EE57F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A559w0dEj3IQ7kNvwGs746Y&_nc_oc=AdrCZcOMmIXabF6nzptRfDRKLSeayBIdvQyqi9E3DmFC0HSP_DIfetChwl7QrDCf1z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ndajMIec8gXk-tpinEi5gNUt5HwbW5weeQC7BDj5MBQ&oe=6A1EDD47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
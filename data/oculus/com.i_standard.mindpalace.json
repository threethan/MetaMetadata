lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-jEk_-zEg8Q7kNvwHHBH6g&_nc_oc=AdpJAgXbTmzcelgFZCm1pio9iw3JRFaaMIrQispHWNp6tIzkjje3eQ0Yn70zQ6Bm7II&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LKE99ou--4pnRknbUnH4UlJZXiqaQX-JPrqngAIdE0g&oe=69D3A55A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM0tLcvCut0Q7kNvwFk4DtX&_nc_oc=AdpIE3uZragHXdLESCOz9gGm66VV8yR_0jiG3VAx87GlOfM65xjQaFRkV1bw9rlHtQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04Ee3DKMGN1-WZwJsgDYT64kM2HHXzsQ2K_Kd801IeAw&oe=69D3C063"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWLR_cOs1eQQ7kNvwEO7xDR&_nc_oc=Adrlrz_VX3HGvEXI-irjWh3cTnw9fspOaOaRttfPpYIrFFJUwaGAIZHJHpUflPwt3Z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vp65jof085EENDGo4EMcXVXagVqwhVQLPgJyol7xxaQ&oe=69D3ADB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJoDQMhhvYUQ7kNvwFgufqC&_nc_oc=AdoPMwxu4031eMvDLRNQSKxaUQsgqLKHqIEqKv1JROxziZALmrNqtH4CQZ4MnbUHzDU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af182UPqevRRRC5kI8U0XXUL-cfBuKESNaFqEh0npaS9kA&oe=69D3C2AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJfx9O18_KQQ7kNvwH_nLsd&_nc_oc=Adq4NRTiMfFtEeBnO4p974Xi88WXHpzYoO8ZvNGi4qLraTtzxzwwCKhKER9Z2G2xcOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ac7DPTuKz1gWncS5DJvyLNyMSnj7LSBa7JJQydabFpQ&oe=69D3A8F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyYjjqHqTdcQ7kNvwFTLchF&_nc_oc=AdrU88Ozk0gT3HPfnDbX5t6KZTlzMgHtCfadxhT-64cOa4kwrA-COR3oq-rHf-SzVz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z5Q3ri4Em7TV2sLYbANfa3rAC_Do5gLuvEPeUuVpxvQ&oe=69D3ADA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BgSapy7Dz8Q7kNvwFAWwp7&_nc_oc=AdpnM251VwEE5KfNr9vIdG8lKvOrNGfqT9fZfiX053SPvXxkVgOuNC0n7tuELXmQbBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rSFe8_h-K_AO2RAzsjII978BehcWvB_SVdL2S9xz0wA&oe=69D3BFFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rz3BdXW3mwQ7kNvwHRZJoO&_nc_oc=Adqd15-VLBwQ5zoLvTkPlY3k-I1kIHyAjE6p3sKqi6YCs0EX9Gn7zvKWjf6pmM6yWj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26tue9RB8sxUL1hm2OvOIts_Dr1dfLkdsl_un7Ze3GJQ&oe=69D3B7C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
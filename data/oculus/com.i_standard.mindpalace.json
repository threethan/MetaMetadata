lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zikj4CPNzRcQ7kNvwFu3W61&_nc_oc=Adoi6cC_3i4TX2Mr2ZB0V2neHaCC2Xfovk3am81jsuRDFUtCHX7Ri0oyu_9XOXoU0Qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISpZD5ONR2acmRP6HtpYOKTvHI5Cq3LDW_MeSX2DaMQQ&oe=6AAFCFDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TobYxI_JI4Q7kNvwFHTKyq&_nc_oc=AdqoZvZj-F0eA1k8jJ4SLz8MIbaymfzTFWc9vF8GjaEJYSXjjPXYUxCp0Go81dw679Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIinkNXv3GGq3S1lMPLe96tDYP-hbnvsW6zYID7lbp-Rw&oe=6AAFEAE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ3hP5bxsN0Q7kNvwFGvwlK&_nc_oc=AdoEyKsOEnwfQ5rH4V8HXi-0UcfVOZH_P0Qi-pIeS5bbh2sMsvQ_aE9rZmJK_FHzQXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGHixvnYl6SvhX7brBqDK_6DrYzvWGNRj96fg_v7dueg&oe=6AAFD833"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rckycrb5tr0Q7kNvwE7Kwo7&_nc_oc=AdrhMIkw5WklrNa_X4LPLoqnTVPUa-ThctgmW0H-Ni9l03auvQGaZeY0kuTm5Lk4Ni8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6nLjGNaRl1_0ra6Y32aLzWLiNddVmezUPQICnrfF94g&oe=6AAFED2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06tgkAjPPAEQ7kNvwE0iOUR&_nc_oc=AdoJblWLzw1htwkqYycurWDDpD_HS5uCdgCaG5heyUoTfWeVyfTXrn7EfqXqyr7wqzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcRCTlyjHjwtLCAXfiY4j7sl8B7qFTHrjOILcS9MQpRA&oe=6AAFD379"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUTsKqUOJ04Q7kNvwG_22Zw&_nc_oc=AdqxwOU4d1iwXLEfNnl4oS7pb7AQfNGyH2fmXfkiud3uDJ_aFWvGRGU4ZnzHX-EYVME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6P_Pxd4XqR_s5HqOyi2VpcFZqy8UtrTQdpuZoIbTHcQ&oe=6AAFD824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zw6BvNbXwUQ7kNvwH6T4RS&_nc_oc=AdqYnnCUf8_DdYmjYobpzmPMsanTZXdbWutsntWzq9uE2Ll73Yd7_O5UQlWIjxY5dFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1mJD3izJfYGBI1YkOCVRWkkYw9sWczqCrEx_M6VqiAg&oe=6AAFEA7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfIaG6YvVzoQ7kNvwEXMMBL&_nc_oc=AdrquZtXq4Iv2SSdKhia54q-JEvv2VsvPCFhoid6MDSHXyklw4J5xkgcSIAY_IWZFeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZZp5VJ7GSB278fatjuB8HKOOjLS6RCh2lVaKk9yV-FA&oe=6AAFE247"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
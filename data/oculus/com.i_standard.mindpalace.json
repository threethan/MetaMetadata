lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GOWac4EkXwQ7kNvwF8PInP&_nc_oc=Adr5Ctm7URQbPFBssTL4TiGSw4-Z0ysGDmeYpflH46yz0SKq8tOnOZUeoc9clo_1rjg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79dAIGYONxxvKeW4HJF05mGIYygXG9BjEEQQmOH_7Sqw&oe=6A1AD65A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNuVKcXXA3MQ7kNvwGpBPyC&_nc_oc=Adoz_g2e1SMESyRNl8vfsECBrYL8BhTvCuIMzeNOYRiBGj2EaYgfcuNeXuLhGE1_bYA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aq20-Qg1XHOCnb5ni5w39BwUPID8TjRtndQQ3NyCDVw&oe=6A1AF163"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwAwD5VUiPsQ7kNvwFNOXdM&_nc_oc=AdqKPiXLZhHQ_erHCr56a9HdDLAEOl02nLrHoB4l0lZ44tVw7rLrb8wUhiboBZHD9fs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OQBc4viPVyNXU-ykH619CO9740OSHsDsathVpn24uwA&oe=6A1ADEB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AT9052RHQMQ7kNvwG37VZi&_nc_oc=Adoie7p7A_6XY1ghk0R2TBGj3DEz1LPAqVOY39dHJE4dDhRlXvJ75MzCIsyqxudKRjM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-ettDVU0eJZBkdjT_C5i9EZZKiy5uEA8fMwD_cryDEw&oe=6A1AF3AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xvz3E8rxLJ8Q7kNvwFZWfnl&_nc_oc=AdoGMvcyYl6H78ZY4sHyJTpgguuOrHCHLHA4kHNcZ4B2G76eX70DRMQFsKdie-DsjmA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hr0m1wBPCc8RVDkHe33vLBEkmOX9ffaxAlkRkQm3wVA&oe=6A1AD9F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9--XJYzOZkQ7kNvwHYdpaO&_nc_oc=AdqLv78W1ZGKtiKWEzY3n5_c3UT3hMuVk0_gaAkKO2EDpLeRHAp7wnPRw6iS1ApmQAY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41L2MtaNQhTGKUAtte7P1wMNrIF9vrXDwt0pe-e1PcNA&oe=6A1ADEA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZGhrgoL-skQ7kNvwEovqoD&_nc_oc=AdpXI_o75CKaC7tRjLXonaX_yXp-u3vwnQR9vOyxm6Hpy1RxoP3jhzNmjhppgBu-tek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CxtLwCX-ucfEGKx81A7s95xaa-J8p4Ns1jnLH5wQgUQ&oe=6A1AF0FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh7Av3mvansQ7kNvwHU4Df1&_nc_oc=AdoSAJrS_80lHH4zXshCLc8XTp3NDOzxhVGXl5nWsD05ZT2g6fQZmpSJkDe4F-8NS3c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HX3S8NCTODeFXvPgf_5dI63NUnCy8PMsCQD1Q1u42Mg&oe=6A1AE8C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
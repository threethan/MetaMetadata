lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBYYpmIVxi8Q7kNvwHU3_-2&_nc_oc=AdpwHbFfBJjkCrIs3QZLquXrhGxk4Pc1MOlr64cD30u4Cl1nziqmJ3G-nz_4xxNErBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hQ2QRNr0mBUe6JdpvE2Ovho6F8kzCQGBlpfar-j9qBg&oe=69F9E0DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_F--OcetMEQ7kNvwHYr61n&_nc_oc=AdqFejlkX-QJUpN9OZlTjYGpmP3am1hRhfaO_ULEFFKsIq4BfteEUz63633iCmycgAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jm3v6FXePBcX8Mdlr96ZyUs_lcVecOXGkP8M9R_xmzg&oe=69F9FBE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNanLKvXDscQ7kNvwHHnZ3B&_nc_oc=Adpb9tlqculW0I5p2rtT8DfJYlCDN5ZAsp6qvzF7Opb27jEDj3mydpVw5HZOxWf4f30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48urAHp4NQNRogiBnHmq1tSqckDx5p37hG-WFs1BeQlw&oe=69F9E933"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA0YXhjdVKcQ7kNvwEpiRXS&_nc_oc=Ado05Zor0PgQikOxELS0C1n5yd5Fao0TtiBeKIldX_caMYWcLkEmtwfRH1-b-x7aMq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TBAuQxrq2hlMZkU_wXP_vAvfKGg74hw4yn1qOSyRkuQ&oe=69F9FE2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_nH0iM9Zm8Q7kNvwHawGGG&_nc_oc=AdpMmziSilYTyk032MYMekjSZqZZCrireihMEFSYdFjEgomnqnWl_1HTts0IAqko5Uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FCyh0tUicDaNe5nGWyazIs0G1DFjL7ilBbGCG-IUjSw&oe=69F9E479"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lEJ-kvaPcQ7kNvwFFAA_-&_nc_oc=Adqg_wl2Mdf-P8mZO_nD6Cy5tgxjkm3QcCwnsTILZlw5VvNVURkp3zBGCScmiaKPsxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IjSvHvyfioUmPUWE2zLdch1OUPhDs2ybSABnZb2MVgQ&oe=69F9E924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQpxEmLOqZ8Q7kNvwFEwwuc&_nc_oc=AdowpnXo_sn8VYs6LSygPmD5zJSv_9-nP6oGWh2CdXV0HcRyFse7r9Vv9k0qC8Ma78w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ideXyoTIQ61BcJzuEK7r7CiyOCDcX-SkXFpCaIYpQQ&oe=69F9FB7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm_EYTIMCn4Q7kNvwG6RiDl&_nc_oc=Adp2GWH0u-xQw30TBUV1LelaK7fJzqo8rf32-lnJ_mXxz8Ryf_wEYwsK1IaZt_vlnYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gTrKH7SNTt2QZJu3WfkWESnEj1o5V0gHTAHDVf8aRYA&oe=69F9F347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U4bc6YzqIsQ7kNvwE9RC_6&_nc_oc=AdqpBoZcl03ELQ0fpO74xo_5nWzsDCESYovepm6Rc80VzkzixNjWI80zMPYefGxBfqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_b0XiJHpHpxE67obg-RIgmGi9qw_LJ91PUSjO28FD5A&oe=6A05BE5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_HeefgerA8Q7kNvwFSHJ_f&_nc_oc=Adop85b1RXmsgGM_-beOjR_CW0PNev7eB6DwqKSDkrA_U8jrubA5fRo29B8xwgIozDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oikSCrAC05vDibZepk6sJapizFZLmXmTLRAOw_QTXaQ&oe=6A05D963"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NNeSnCj16wQ7kNvwEel0Q0&_nc_oc=AdrOsiYK3tyitNURe3Lglhy_n_PENcY5NLghBLE1jipZ4Jqdb6fk_UMYw7CI-BzJFqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gCJu9kzuHImfA7TTjM7rrQbquJ3HnJc0LxmFVHqIFQw&oe=6A05C6B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n9S33SFOuwQ7kNvwGGU8xf&_nc_oc=AdpGdmLSJ-HsVxUFBZeGvxf5QhmGSZSIKQ9nRuAkeqpY5hX-mKWiBq90Nxl-OQ5DOS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZUXlIUS2ajN_wERaRLWtpbV4RR7dqHn-Tx4mtqn6GPg&oe=6A05DBAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccJuzXclPFUQ7kNvwHu3-3r&_nc_oc=AdokNb2QH34l5WHz9-MN4nMKxNjT_vY-MZBLO9qejuYWDvWTymtu6n33qKhhxlyTBiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yCwiqJe1d9i5ZHYhTYl1PZbRcxmJt1DKJFpk6ANyMKw&oe=6A05C1F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNu9Xd8gAtMQ7kNvwFenqdS&_nc_oc=AdqrK_hVSod7z57CQVb2ypb36wjFUSFB01-m4O_uI7CQkfeR3nJwqghvUWpktRgkoRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7usx-Kqy7sjt8PpT-nYgsAxoTL0Ppfc4-1AeV_EioC_g&oe=6A05C6A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FYuzDk3sHYQ7kNvwH1QInb&_nc_oc=Adp_V9O77A1VjaSDAiUbyYnm3HkWiyYVsyl8dEbteeUwQWHVQ8jjXAzFq4j3gWSrsks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZgpEqI0RJjDNpK-VMKZHzJNmykrn3UR5G-Puqvlxwgw&oe=6A05D8FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9al1Py-Zg_kQ7kNvwHYLWPA&_nc_oc=AdpMSrczBhY6_bPMms5O4IQ_CxAcseUNIskouDOeweK47cbfW5JT_dWfEySXSanid9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nQ4Vit0zER0QQUqQ696WKcHdmBORoZY6NzzyreZmYKQ&oe=6A05D0C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
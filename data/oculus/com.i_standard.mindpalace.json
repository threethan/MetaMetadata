at=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be2WcdaL3WYQ7kNvwElO4no&_nc_oc=Adp0VLmGDWUZFydKH1b_kipwWZbO17-fjKIe-AjdGFphjtqfGarw2WVqG41kWUuJtP8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXdj5WRLmmsiqkssvjpgcuO5YkaCKOd0oaz_N07Qz5rw&oe=6AECB0B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKltNl9zz4UQ7kNvwGUwG7l&_nc_oc=AdqJlpnN1lC9vDWxSthjhSuDBCWbWBzNmKoJkQ_jSllJVOdkkiBL6mOg-JMTNgndu1Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA5pOmGZT4PLHqWAGNpbTqHWihJesdjXwLzDbbgHRwDg&oe=6AECB564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIatC-Y7qPIQ7kNvwHZZfB7&_nc_oc=AdrNZIX1j2fkOqj1g97B1zYoWZNIUMmKPpDQMzyytPpBSVWX9XkeYzkqOWr2QR2YmvY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoDq-jsPHWtPf7UE9Q0D-17y_ljXxlohI1jlmiNZ3HqQ&oe=6AEC8F7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSmveni-CZMQ7kNvwHWyT7d&_nc_oc=AdoMkjIE7BEFuxx2h5Kp4Qq8pANpM5T9y1BtHbsg6LTt96aKD5RJmn4AYIPSnQ6hDZk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjtQrj3o-vP-_R8wFFfpIFXxTFILIRqoqoUYRb4sMzPQ&oe=6AEC8747"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
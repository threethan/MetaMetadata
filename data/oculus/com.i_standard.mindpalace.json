lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abVdYj8ejvsQ7kNvwFUW5kJ&_nc_oc=AdoacR3B6JX_SyI75k7tSzYzMeJc6JZ0YpM6yXfiw0Z3S-UL0GhgFghv3COtoNngKE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DBrT9A9g9abGszlt47M8h5jQgO5NTysvpcE6FrFwj5g&oe=6A031B5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYlgONNT270Q7kNvwF7GvKC&_nc_oc=AdpEaPPtJJTEHahe3gZhjZRR65rsM5-5KrpR4Cl37sfV2W0xYLre45PrpZPRn4apo4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MJ_TrqqOVTpvUUKcJ-0qCmx63zomtCbtb3s-OdpT3_w&oe=6A033663"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-J_Z-MheeUQ7kNvwG6aQQv&_nc_oc=Adpfv-KQAKGFqFBH6d1CDsPMFkTHbBLxNTQZJf7xElDEuzC1zjQC88e7k1d42vhr-04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kZBEFWwPaKrphtzQ4p1RiyJZAYm-gBi6i1pfKuFMkcg&oe=6A0323B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mx0GANNR8EQ7kNvwHimStp&_nc_oc=AdqMkZXaSTLHqlKsdjhYSWGOH3bBgDnKBKIOLLsESO1a0zcrfnxLVXLjTApg6foU3vc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DNULdWv050VxUtjebLm847m_esv5f7KWQQ0ggOf4AjA&oe=6A0338AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i50qGL3ngZ4Q7kNvwEBxej9&_nc_oc=Ado19RfNvndOTuc2rLLZ8uwXpZq01vB_X940vTo6w0_SPXyqhRSW9qB4aOsbUSZjLUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7boHZh0U_XkSOdGrgjx7YMiTzfzojwX5llUp0bA-Glog&oe=6A031EF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvkPQLgvFQsQ7kNvwExlDH8&_nc_oc=AdoxEdzX1Tq3D4SmBwibwPQGC6Of9mampmhwvr69rqHwbiDTeNuoT-Cb2l_et2dJG6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6agkzsTg6Bit01W50cwRIpnHIVNUKGf5t9u5V_-SMJ8g&oe=6A0323A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KBlR8LYqlMQ7kNvwHnyLoK&_nc_oc=AdoKIZpnB7nHWgqAtJo1n4LaeXo3ocEJfpFrfF_1tWoxmCioGw7rRjUg43BuxE7HjNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ax1qCIRQ9own7EwnyNX-9Keka6V2Ffuid2TSVCMs0zQ&oe=6A0335FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxTWDoVT228Q7kNvwHiySaY&_nc_oc=AdoVL03bCsi5eYfoYd9fQ0EUhRt4FWcx0Mi0KaUq4n9ojtzpPaM5vuNkep4HV441dyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qI5YfU6DXioT0bOmJWUCdj8rSwFgbtdxpJ46XA9dfQQ&oe=6A032DC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
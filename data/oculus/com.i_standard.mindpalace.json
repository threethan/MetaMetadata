lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHAM6H29ENYQ7kNvwHTd_iE&_nc_oc=Adr-1EXVeNV1tLPgTUA6PiGF_e53uaEmIRjINCd4HRHNM9Ojd8slHVCmLvwz9gH1XPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqn5y8D8NNBBBgumNTF0FfYhQI_JqZdVyTKQ4fvZeihQ&oe=6AE7671A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkX6xjM4rBwQ7kNvwEMtVmq&_nc_oc=AdqBunIUm4NLgcxZzK4uDHcXrt_x0Z-eZDTuIGwQOEnwefJK1EoJMhhaFM5a2vdp8-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-OroPYpMGTa_67CbiGThlBEODHXJNWPaN5fw1Fc-6Gw&oe=6AE749E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g6h1cUmrLgQ7kNvwGK_Gld&_nc_oc=Adrh18FouNUvGPUGy0q6HjiMbUzl7T4ahYuOyMTI0jqLWeTcHb3PrHL9Co7huSTnBeM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuNdjOQ4C42VrLGrQfzZzJ0GIuNCJCnuC6qvZze5t-Yw&oe=6AE76F73"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKqUaIL_n7oQ7kNvwE7WP1l&_nc_oc=Adqdx4hbnMbgl1itPoVV36dt04KodsNFeeAT9HtIExndTYCfXSV07BBK8mYBLPWTdQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3BR8TJs-sAdQKPjJzm_54yk6ZXLTrJyXuJ1brz3hEBg&oe=6AE74C2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INiGzmwGgF8Q7kNvwGqhO1v&_nc_oc=Adq0JooWRbI2AEoAPMrj7P89GloBC7ZtQqp2kvYWziBCiGN8lRoNMSpSVe8ukrJ759c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkWsnc18ymCgRE3qOzIAxg1VbtUADosnhS9uz-4zyPVQ&oe=6AE76AB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNDZqfmX0BsQ7kNvwGgDo2V&_nc_oc=AdoELjmdItypvN31bDw438tkBaBAWHh3TDJCxZAPxk6nYQM3RhlLY3az20O9EV7ynLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFQvnMTsdbnPQtvHqCg6kKUD4haMxYeP4qaGAV_wck-w&oe=6AE76F64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKr6err8ET4Q7kNvwER4bO5&_nc_oc=AdqKQEGvTp6Yq4G1OdqAFryyyfWUqSijH-wWZbFRilA8xMb8ig2_TU2vMhIioPNkjzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBeOY4-Vnrk9X0bshopA--SOQszEhYhqJ90KBkB9EvGA&oe=6AE7497F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfkAat6rookQ7kNvwG5h6aG&_nc_oc=AdrdKknW0wglBOX6w8UHppK--tltAMuF3rPVYM2esOcPT7OUbglucKy3Uym4dVWR3Xc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReP1DFBiqK_EFldXHumjoo4HJ9QC_Xe_qW7LCcPLVOug&oe=6AE74147"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
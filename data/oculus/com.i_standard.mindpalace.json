lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMkOqfOHxFAQ7kNvwFGxn2E&_nc_oc=AdqE9hAJkP-8vSjxvCiQduwWff2iA-iCoZHZ7GyXa3HYagKKSggbXTUTXcj6_VLDBhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEDg5fbafmXb4ll0pUQ9MjKY44YRbBdOsihi287XC-RQ&oe=6A902BDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdauM9_XkhwQ7kNvwGOkUiT&_nc_oc=Adq762M9sMMJbs_CfhlLBW4BGVzOrytHF7qlDXwYnKNwc1GNNtbDuo52sEZB-3GuudA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFen2O-kyjSnuax1PkIy9x8xIY0iRcu0_uJ9aFQYb4Bg&oe=6A900EA3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLPn4BFM3eQQ7kNvwFBeEZO&_nc_oc=Adr0u9OIiUz9WgoiEI8eGOlgTcKK3VCHZBqT_2bMZlzpkInzkwnWMFuf9brNbKQR878&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENLahSFxqoNbrIQgXTu6_VOLumW14nf8AUZt7A14faPA&oe=6A903433"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU7SVJrAviYQ7kNvwGQhWgr&_nc_oc=AdoE3LLedqp7l3YBctMdQik3z-PayoqWQpsP9zNrWm5gRq7sSOaJ3tjUH5fPvyy7ojE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGToxGJSJzQOpCocP2ycsOjR9ltx7BzS2toQB3nQXZr3g&oe=6A9010EE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3_Ms_f5vCoQ7kNvwHZHyZk&_nc_oc=AdruuKJNeDpUD8Jh9bjH5uGT9-xz_xQTumNwRYdGmfYoNuWlZm2OjyjI3iB0sMPq9D0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo7CXwt8ePiSYuXIxYl5ZZNbgOpgg_1if3kd1Wj-Abpw&oe=6A902F79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4fFalIdan0Q7kNvwGatAcC&_nc_oc=AdqvcKUzobA7Kf18BlFBx5uPz5pbLtgWW2FQwRUYK9zDNCWhOdh98yFzi9ZQ3eCTVuQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmWRfsF4UWkHBTOq3ZpM7KQvNuOMsEMaKcOjqXvgGkXw&oe=6A903424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uiWWUoNnyUQ7kNvwHnfF5f&_nc_oc=AdrJYhgnKHRa2OpKieKOluaO9EtzS-gFQzc8vQ8Aqu8wGGf-DU1hTv8FGcbOqRPgTfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWQtyf9kA79yZXrynMa4tYMoFbKYCGMAj0BElHEwnbHA&oe=6A900E3F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xySSQo7EssgQ7kNvwE8AeUa&_nc_oc=AdrydXkPZ0SjSmsRCqSZSPOm7__g32vPKZVO1YxGfYP6JbI_Qo68QQylNGA9HJPaRgk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDG37D_7_Lwy1NDpj7dCPLZXwICYb3fqPIqI1zQpAjMg&oe=6A903E47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
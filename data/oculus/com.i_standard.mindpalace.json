lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V1jnXbDWdQQ7kNvwGPeU0z&_nc_oc=AdqT8csVeFpxhZ-byCiQsjcKygt946HijaSeOjAhTaNv3cLXMpO7zbCFcyGLomUTsF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYbzY4pQgzV3quL7K2sTc-8pzmh7ZGOoTEXtdFe1w6kg&oe=6A69F05A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzeVi8KHtl0Q7kNvwGBGIGy&_nc_oc=Adqr0dUAqOQNQh-vLcZMuHeBdugdrAYPj2hPfaxGoDcWAxf_Nqtk3edrzESNY9HrwM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMOyjQh7nE-XvzT2AQzzZDduhPMG4m-1DW_pSAsj0Lkw&oe=6A6A0B63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag-KELbyHrIQ7kNvwEly_Sy&_nc_oc=AdrjEmR6iuNNek4cU18ewJOoSaBnkkzbWzvDME05kvbjaQKtTBr7EtzqzCVDmG7VAEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtLb9g0Hf3JXQuOfeanRZLNvyQIEKHjQ6ttccpIqgcIQ&oe=6A69F8B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxNZToZLrNMQ7kNvwGdvSWp&_nc_oc=Ado2nrz8hHbP5ANZm1aLHbxZf8HROhr046ooYw8ulLUzJ4vQY7uz63JvBuAidhFlDr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmOtOxzP7z25axXw34JT_CPWdT6wVnea21DZzeB8ouLg&oe=6A6A0DAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCoZCe8pdxEQ7kNvwFKfcBW&_nc_oc=AdryeuCbU0J6gnXXLOx-WGS5UdsCuiOJshY2SgA93Ng6t8JW5laOwF--7fpIt4N66mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxan6ItOEXDuDRR8561eOzX1CDkdiUctTgznvhR1v_mA&oe=6A69F3F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1bmaREMoB4Q7kNvwEyXEBb&_nc_oc=AdryBaUHnIapjnwxhweWH9arwSVu2YQoa63uLw8aZ83gV2CnRbkmeAoyNEW-hCrR7bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYCdr4DaapIkBhuUQwVBwB9Uj80OXYtfXJl-nb6hQtIg&oe=6A69F8A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJNdgWx3b9gQ7kNvwGv7LNU&_nc_oc=AdoBjH2tgWZ_JH--fZZ_92Sz-h4OjaNvRyO_CfUbuPo-MwdSo6QYVItFWkXLpMTE-aM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIO9Y9mmeU35iDjBG9uDzg5aBwW4Rm4INV8CB3Y1D8HQ&oe=6A6A0AFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjzavCoe6LAQ7kNvwFqA3gQ&_nc_oc=Adqzy07MuVDMae3RtcyUH9H675V7_HiAZGTpVZECYsbHbQOHtz14n9qMJIYko-14XPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj38uHbxdV-s5l1EiueRnczURwScXxx2KUhFo6hiFbUw&oe=6A6A02C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
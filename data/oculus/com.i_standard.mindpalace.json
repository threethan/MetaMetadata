lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXFYDi04GqcQ7kNvwEy34yQ&_nc_oc=AdoWkTjWeVBamO0cRGxzW0uE14PGOCXaGTm8gM-9yH0MSCQ_duQeTwiG89JumzHdGrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHxvGnZEG8qgDYCQFHhqt4R52yjnf4Jj2H4Iw0EYD68A&oe=6AA7E6DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_Z1XLjnsVcQ7kNvwFbJOHX&_nc_oc=AdrtfGGayTvZFD2anpLDPuXdfzf0QXpG321WsXj9lO4Yfnc6CFumf0oD63kJldRCX-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBpZeKV_8Y-R_xL_ZfI4JLmclRGqUrrNB7C1fQ-dPzIQ&oe=6AA801E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbr1dZq4VK0Q7kNvwESn3Xq&_nc_oc=AdqlQxsnTcRQ1HHqepllxvHsfR_WoKR-jyf2fT43hSqf3lmb-52N2uhbWU7ZWrtuCjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbCoJ85h-SZOkI7R2zq_k0mVIzhXWhSvQzs47nEB_6YA&oe=6AA7EF33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUKMnXU3h0wQ7kNvwEyildZ&_nc_oc=AdrFvHrtoKzlcG4xk4H2lMCNlXB_AL37sLyr3Do5ox8P3t5rnEqMtEmr122y5PlAtUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1UAd_T16_xBEbQJff55BrvQYHSkNrkBi534VcWWKSDw&oe=6AA8042E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAiIojEPFQUQ7kNvwGcW17v&_nc_oc=AdoYTE5ozrb8nVCwjj-a0F_aPO8LtZziNWXYyEI-v15DqwXSdWLRjXPRFY-W4e-X_Cw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRr_jTkuEKwQR9pq4vVj1qSLcdabKI4B9gAhKSpKTDNw&oe=6AA7EA79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9LwA0gaOpkQ7kNvwEKJfV-&_nc_oc=AdqP0IdxkPyaSu--4ohsNYNUlJOxdXriac5-vMjOlbesWkebitdkdKnVPE_urCXhmag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC5PFtTb1EwbL7efuMjtLnXdfIr5gJEGpJF11zXQR18w&oe=6AA7EF24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1IATPBH1ugQ7kNvwEpLOCT&_nc_oc=AdoQErBHTGAAf-BJaH--Y39BXZEr8g2Yc9mT05O98cgOC84nbw6us_W89HZQcLPPcps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ46nEw-BK3N-H3CyLNL-ZrJWNXDNwqAqKvioYHI1h-tg&oe=6AA8017F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyXa2LHmPV0Q7kNvwGCGOQA&_nc_oc=Adr7amcqc7U045nGhTHM14tX8Xfckc8c4g2ClLn-GTfZWk7IvZprCAlgf9OJ7_OYU0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc2Vt1YCVpdyzlheTlUqorEo2qAaTsCI0kObhAJb_hwQ&oe=6AA7F947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
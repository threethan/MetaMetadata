lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLSiIoCFFLQQ7kNvwF2pef4&_nc_oc=AdqPMJAv3PB9NL_RjLEpP_D7JrrQIVlMTJn4Q-covhW_PCTvmejPOCLheeTeoCm-2-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFshhd1rmaYUep4xjbvIu3nEV16i0h18el9Ts_lsvLviQ&oe=6A75CDDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc-UcMNlq4cQ7kNvwEg3Vez&_nc_oc=AdpvCRaJ4l7sWomtWOFj5IiuFeNHGZT3uPOxm30xs6k2V8emUgND8NySERKMBryvgNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd99OpuT95pIJUAmTPzdTMjGWo5m5PHnDvjPlQFpQpyg&oe=6A75E8E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT9vVYLng6MQ7kNvwGcgReo&_nc_oc=AdoTSJumq7L0Q0I0PQcSnYS1zBqAQ2mpdB-7lDJrjIQV3GVhzFmZFK3c1j_BV5zDtTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtPIgEhUrUh5WxC1EgUqz5mHohyUlWVHwCVRch07GrAg&oe=6A75D633"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRXT8twSDRcQ7kNvwHns_TK&_nc_oc=Adr3YwpOMMZUPq6WXtePhPARubsiKocXkeY0AlyOS_fPPspQEt418-7hv1BDnzUEOjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6S6h-E1QBg54E7rnG1uU-o26M4Gee6nw8WpLIxjet6A&oe=6A75EB2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeKbebju9kkQ7kNvwEz54O0&_nc_oc=AdoNaf566dhuyyW5mSMo0S4zcpXBWjv06mnvoUVInSxjkuj0Svu6p-HocThZZ6rUONY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3cgqHmWrFi-R4roeMxYHYfjoNLQno8h0lbSqJj2o5Bg&oe=6A75D179"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VPmJvQwTN8Q7kNvwHSfSay&_nc_oc=AdqBkaUEp2R82M1SKRvtDdcU_KCWA5FS0-aVF0vGTO5xkEiiSMWhTw8sZkr7LVuhlRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsU2DP7tdcN9kk21M0k_094brGIz4T6MG2J4yWRj0GDw&oe=6A75D624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0cY5xlHNbgQ7kNvwFuj2-P&_nc_oc=AdpMpNTCyGOHi2OypuOc1zmieG7m-rFF7YKs6A7mP7d1_XmfyakuMlTQ82KIiAJ205g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDz_1-v2VeS6tcl0oU_cb4xyvNNdlBcGDwhJeV9VMSSQ&oe=6A75E87F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNzrFByqOTEQ7kNvwHKS7-S&_nc_oc=Adqdo800z3460-T9fep0NItvD1Dlhtl-FXuPRVndNbtD8s7Zv8UQ-FalcBeRqJJCh1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiV4gUSQhbFRJB2Thq1t7bN0gDmjPaWMI2prYxKK36CA&oe=6A75E047"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
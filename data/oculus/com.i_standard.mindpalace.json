lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBYYpmIVxi8Q7kNvwFCC3qD&_nc_oc=AdrUwZxu1N1epvyX-LI9TxGGizepGL8DbNvDcgEOwQlrQV9LwbgNudq9lfmhmY9RVpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C6iqoDhNc6CwIfOmdUm2HrBnQum_V3RPahFohl-6lIw&oe=69FC83DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLSCmNGiyusQ7kNvwG8QnSl&_nc_oc=Adp6givI2Ad8IifFxPwTnLmeF3DTryoYpPX0-glTI59NXQNNrgcskggFwHt7_79hl7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o6zDR_6cP0SGoI8OvcN0eV4JDWYIu5ud7wsm8XT_5jg&oe=69FC9EE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNanLKvXDscQ7kNvwE0wAms&_nc_oc=Adpx6j17pwoaDR6aIelXhl9ANw42mxduDc8ZKNDHC575zGNM0whFrT8_xhqAg3CtOs4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79FZMuSoECb3GMgMarn7jOXlxnfaHMl0-8tkUM_jeJVQ&oe=69FC8C33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAhe6dBVlfUQ7kNvwFViXDL&_nc_oc=AdqN0Ffrlzadsuiao_PVCrRh9pxlLzz2YctZ5t02hpQKfBU6qw3I5gtXszJdKU3P3FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rVtFpKoK1n1NPE7isS_zIuL84kFUjhyGWvicy8jXXPg&oe=69FCA12E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX7apbQwZF8Q7kNvwFK2ErH&_nc_oc=Ado8PParIiwleVTg_5GXaiQ2IjgIGKkoQ8AMKhOyzfPobc-CePgCUAwVwqnsz0zo-1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YZHd4EZ2Ty_wwW32TTli3I4yRHyQUpiyayWzOv4-DQA&oe=69FC8779"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iGIhjqHeekQ7kNvwH-PYWg&_nc_oc=Adqnf6nyWqGOHqzv5w94Kb9dedw4xpqm-XKGgY_CKSLB6ThzGVLu24YrGPSrwuC6Rbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V1tQpUq-Wt_JhVkKSeLu3LhdK1gyUap8sVaz5OESSDg&oe=69FC8C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3irHIu0C7R8Q7kNvwF1_Gcn&_nc_oc=Adpp9laKvpYDTY8rht1BwcRP9hngZD63rEZlF35yV29DSduyOHD9h5JfsO8GbGSNjro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EpxGkcrgxI-z51qw26D5Hauheci2NciL4zcZRU4s-yw&oe=69FC9E7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm_EYTIMCn4Q7kNvwEpZDDD&_nc_oc=Adq4fMYkuaZVhWywut_It7JB02j1v9YKL8aLQnh9sWt0rS7JvLSbOw22HWXDLEdQKCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sCKdlN1X_zUU6G-GRRrhyNoeWGqu_UvZHax3bd2E8tw&oe=69FC9647"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
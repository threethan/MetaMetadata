lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNoK95d9LK4Q7kNvwGwOvSr&_nc_oc=AdrWtj9dHO3tAPNLISE_LcP4O7-e4LVEUrYf04UNpMQkQ1litJyneVRlouZZyec4DlY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DHAbM6EtTOrU1yPLozb3dBRj_CfaN88ouGEwhzg1NsQ&oe=6A201C5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZDnHV9LnW8Q7kNvwFO8A7b&_nc_oc=AdouLPzdclyx-lDteBCbiDOIwHv9deHzKRKmtfMr54xrMS0tiNxSWER4PzomLPsLVJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BsJMg2cpHSm96yGEdVO5AevTTPFYwOizNT0LWTJFysA&oe=6A203763"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm46qUaJyTQQ7kNvwHiRUeI&_nc_oc=AdovvuNFA41q_6NXdl5-D6iS-KHXULMuNxZbZyXDu3VFtIcML-_FDHRRNJHfkuZ5wOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Qi2t4DPuPp_RN9-4a9DxdjAOxnJUijUgPr5FHnsTUJA&oe=6A2024B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jZ1n-B5qj4Q7kNvwHmFa4v&_nc_oc=Adog6j6IDGj8BjLQfGW56O2cVqjdtS71DOWjIHc-6hjLSJi_5lmoMmdMB61HfuXhNQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UlIDBpcuwH6nPRXj26yWTH3c6FrDz-TKcdDbx-y6bVg&oe=6A2039AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4ItzACn8hYQ7kNvwH_IfJJ&_nc_oc=AdqUcH2QU0kHoGYGi2cji-aBqht55y2VyQRRSylBwvvg1nqpEA9xGL16JkdhpZ9MNcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xSZdzlziEEPJSnDDrKlVXptj6hl6RhUwJuWvMPGJ4pg&oe=6A201FF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j60tQrGshYQ7kNvwGWX00k&_nc_oc=AdoEVwXD9NglBsrPcgFJK_AXZun_IE1GMWO8_XepwsmwKK0rU-V4TJxM8aS8mKwCI4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uj1IQi35V3Q0KyaaZlpU1-pIk5BVqlKgTJVDiL6CLMQ&oe=6A2024A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwGdN58Ub3gQ7kNvwEiUC07&_nc_oc=AdpHXWz2z0wIaE2dbJqpKufQXneR6AfSJuVZ1iEYrMQ03oVpaclms4tOyfb7cTMJZmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af521cetrTAonZp-P05gp3BsTGWxM5mbjzxjWLMxuuM4HQ&oe=6A2036FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A559w0dEj3IQ7kNvwGXAtr8&_nc_oc=AdrCFdOzXMQiy-gBnHA0QhemDcwSHzCz5UliblxAMCfxHWaxoQGkPrfnAXVJYdPtwOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k6dxy1PtOTjidjxrJIiic-zr_-9EM5LRO8JK31ji2Bw&oe=6A202EC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
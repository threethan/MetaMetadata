lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUf4Tj2oOswQ7kNvwHQGp5r&_nc_oc=AdrAodIciqrmWOF_57UW0-PcL3ACU_pIpNEc6sVyUsjHTeHX1jwv50cxModFDB1jq6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jmRcxFbPzaMXAUHBB0z8IWIx-LyuMo02Wo5bNVu_X0w&oe=69F88F5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_F--OcetMEQ7kNvwGa28h4&_nc_oc=Adqt8f--jm3oki8Ytpo-uVkODPXi-iRK4NHV_nMtNInNqZmxLxObJhuxFQx3r-RjspU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qRvGEeUGcbiwBBsJzbmF5TQgNhn3j3Ra0HuMHTXnLwg&oe=69F8AA63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxWfkLqsBBoQ7kNvwGVhODW&_nc_oc=Adr3x1AqogSrbH2UTmBZq3d9nyoir4OE0E2lWvguiFEXWma9XGgKkk6vrE3PpSdxSk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yJemP9bo7PCkL0niJ_0GRNbp-g5m6phd8ikbBRS0FVg&oe=69F897B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA0YXhjdVKcQ7kNvwF_mgJR&_nc_oc=AdrGHieUxYo1VBYm2ns5HnTuhsyf0ClgjOGPSBrwWpEk3uxY73S_9WA34TYmbknqyw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07IktsZNoBWv9sW17_Y3JWHSWYZEJtK7Pdgv9TflwAzg&oe=69F8ACAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_nH0iM9Zm8Q7kNvwFbq-qU&_nc_oc=AdpkL0j5-FXNZuXxBNCLMIubPGMoij_AZ3BgzvFAv6QXISaNrFAJxMdsHOLtro9svp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3H_B6C5RcboR53K14kJ-7c8AO0llVZW8rpBavb_HaoMQ&oe=69F892F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lEJ-kvaPcQ7kNvwFguwgz&_nc_oc=AdojbgIcxRt7UclU_BTVAYiFvrZbrn5rh0WB-4F6YEomraVRpWrSalaKKrLaVn82HFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uYOCBKNNs5pNIzV2nRv85wIoPdncO5k1IsVJI_OUD-w&oe=69F897A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQpxEmLOqZ8Q7kNvwFPn8fC&_nc_oc=Adq0GSAtZY5Yrknp62y5aDiK7jH2VYtmF7iw2bUVK63YqogAnkkq8YAFjvyql2zuINA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37WY8dnPQJGiQoCtNDyuMxoLujCmsPVbvFX315OhPkMA&oe=69F8A9FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy4X7HHLjxcQ7kNvwGqL57_&_nc_oc=AdpygukyTX78MUKDMoC-7L37DHaFNuumMb5dh2vJ4FyhgTrVYnShQgUzWGrTEpdCTcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0b9rfK-Rv_-zuyr8HZx2f1wUFKlpmT6I9lfw055VCPDw&oe=69F8A1C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
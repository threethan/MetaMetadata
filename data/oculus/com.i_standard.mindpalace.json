lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9CDhxewQwQ7kNvwHyAJWZ&_nc_oc=Adq5Ta7VhDcOE0L7FmEZhBJf-sygN4_pYcYNIe5t6tV1SQPhewl115zEmndhAh2cwms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9roOg_6yxHFA46q33nBugXyTnFujRLkAHFy2y0lKDnrw&oe=6A3D559A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN2djjrhEXkQ7kNvwFiyGZr&_nc_oc=Adqr-Sopgfej1RbsiTQQ3RmKZ07gyR8S3mMN-QHjCIFoJ3dqeHP_9mWC_IChzQ-WL1k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7OriZdwKg03q5TH95tilHDFsW_Bj5L-MoEyikNSm_pw&oe=6A3D3863"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibI79VabK9cQ7kNvwGTmNP8&_nc_oc=AdrH5gZq0oW3Z7YoKJn_XXN0SXFxAWjAIbxUsDDN44_-keing0Nhkvw1LDZCtR7427s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6znIGjnMU5T2LhmzVfju1To9QnIyPda5z3aeGClD-0A&oe=6A3D5DF3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2_TQFFvNnAQ7kNvwEqJX-w&_nc_oc=AdpEMHP-H4oFFQsoPmgnDoBwDdiq3FTxp88fU1DspljV-fud9IB2Cm_XWsv17xJ8Jnw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QEAxqVnFhE_UiHBMQsSAeRRrf5hMRhnrY0LPf0wke5Q&oe=6A3D3AAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p8i2vrYLvAQ7kNvwH3Y-L_&_nc_oc=Adp5z2kKip02lNv_EgiF7-RsE9adDQxG4xUCuVER0AVUx-OdznCdEm52YtxvjDEzDM4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_liL8S-V9en3V2abtowIJc8e7SmYJJqw64J_Q0KlJf-g&oe=6A3D5939"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTv817CAJvoQ7kNvwE1It7a&_nc_oc=AdqjadWwMmwokdGLEL2xzr0Mw_5mLsa_edq71VNDD2wAJAg7DIVLYuB83DJDo-IKwfU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wsTGn-MgN5zqdmyYYFtJ3w6-WZWYMVgXa6NBPvMQv1g&oe=6A3D5DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bga4hOE7oLQQ7kNvwFlVq2G&_nc_oc=AdolPOT_KIG85Sj-nYcBZXuwhpjIiV2-5GMjLDOr07--b1N4GL4gL50M2awg9K79ito&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rm1lIxbJwXVVBwXhv6TGc7Gxe8VquVhy_fUz3lKq9mQ&oe=6A3D37FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPSRQWjMy_QQ7kNvwG7sFcD&_nc_oc=Ado3C6qF9qf63jnnkmj3WQ1gB0wMbNnL0ko2Nebz_z69wzZ-_tPSUTjW3_C1K-p4-Bk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KL_ezMpR8GH2RCwO_nOYZkDkUbNzGWlyNgOdI49_1QA&oe=6A3D2FC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
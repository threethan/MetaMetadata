lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axA60r4EcZMQ7kNvwFIFF2T&_nc_oc=AdoNuwC7dpLDOs2067UjkQWB-wiAM0kIH4VEu-Q-DCTiys42hZpxrJcytXVvre3W08g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qhUH4fSWqdAo4mvtuw561TPyBzOAMkNoVHjYyBaE9bg&oe=6A15C89A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skjmJeWHhhoQ7kNvwG4oUOK&_nc_oc=Ado6C9LR6mkRp7wQnM9shFWCfGaWuNfOauJ2LONApGBXhr9ukAH9r6CuU6Ss14KtKsc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PtxFtxzzBa5uI8B6EBgSPuu9ZC9qjOwsXFGxPtEhFDQ&oe=6A15AB63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV-gQmtwPwYQ7kNvwGEBF8w&_nc_oc=Adpc0rZpedyBcRzziDCcFob0BWZOADifcgSMfNeayUrHoKGjVs_cpYOIZYPakvf4F14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PejOBOfh0FIoosHpU24H_whLGbQ0fHsnhYu6u5H5tgg&oe=6A1598B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz1POzAlO8cQ7kNvwG_mDFj&_nc_oc=AdrhVmlJW-JOW6j5CMQIHhbpqNweQinnVHNeYebbFDUYMXCia9osSie6NulIAp_ZQYA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5exdifPdNyeKh27Gkf-HsD1fOx4DyV1WoHI451sH8YkA&oe=6A15ADAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmZF4CqN8RoQ7kNvwF0lMtj&_nc_oc=AdrCAI8K89nS3CvOndgEUOMUfYYmnWDqI2ROAyq26G8qlpT_3uG_cBXjBCwN2uLtZUE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uGr_plORsNQffjw6wkHYnblIC_05-56JDshLWYjm-rA&oe=6A1593F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDx22u_fVYQQ7kNvwEwdaNK&_nc_oc=Adq3zYuFUiF0GRjR3Y9SAsebJQTFpeXBZOs64Ne_p3zfrj5v2Jl85AbMdXmwNxcClas&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70eWlD2LEmo1Usd4fF6o8H7HnwV2vbPJL_N6pdqW5AbA&oe=6A1598A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgKuVTZMtSAQ7kNvwGh1D0x&_nc_oc=Adok1uxgsNbxUyPG2u3A3_uEiImU8TdRA2ee7wQBS1BtPSxLE4m7lp7Qi-yGpOazCvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EpBD20s3IGEeir1bSo3zWx-I8bUbc2r3DFnbk7fGjjA&oe=6A15AAFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG4yeOTMwSwQ7kNvwHZRyeM&_nc_oc=AdpCRFl5JOY2sNDzjQY1EFiW1zQqNi6Phdd0oPbQRNJFTa8eStl6xKPYij-XwMBVvKk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64X9B8abS2oDkBEzRbnzqiP3WNl7hjdhWKSxEMCR3_Ow&oe=6A15A2C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
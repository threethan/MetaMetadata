lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abVdYj8ejvsQ7kNvwHv0D93&_nc_oc=AdqF_WGMA75TYcRTxrwbKw-ZT7W3wrziaKG8yz043vaMVpubwPb6tmpNd24vvbt4X9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lxPIITKizFUEkav9MpbVDqOmRKbkyUMjtEskIUqdiDA&oe=6A046CDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_HeefgerA8Q7kNvwEHtADh&_nc_oc=AdpQxFfqMwzWqlCIrv2KPL9_BIHkU5Vsq8HMIWYLGkics-s_tYzf8p_-3erHEJGvlW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WbmUzxswMiU6KNCkXuCbaJSI1bqU0sabEUnkJVOkUmg&oe=6A0487E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-J_Z-MheeUQ7kNvwGfidVl&_nc_oc=AdoGM4hZXC4LXZVutBoj8Dhbt1uyuf6FjrDINmoc98D3c_7KU_-oGwDfikW0yyJqKfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6izbAO21fft8NhDMDWXgcEL_2FuYYr1LyHPQNlY5jFhg&oe=6A047533"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n9S33SFOuwQ7kNvwGY2_4u&_nc_oc=AdovbWrVSE1GSoKMflwIGezp6mofnCd-HzKGpN772T-qlkwgNMrbdCVL8F1wOTae01Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gK7WnrjaG3too3fWO5xg55U993SArRibe08kO9_RUbg&oe=6A048A2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccJuzXclPFUQ7kNvwFdqzxa&_nc_oc=AdrOctl7TKgGpFN6eJQXbt48VmBiWS1duSIvN6WuJWrtokPk-Nae4GVz3WSXOAT9O1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61lfJWrU2d2RTLVYn2Wu1-FnLz6j204QynYJ6UPxtctA&oe=6A047079"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNu9Xd8gAtMQ7kNvwGmyiOj&_nc_oc=AdrfSJbK3a6LQexgsnv9-gZWLcb-BXPLXk8Ii-XbD2uTR-21uWnEy0arMdt58xXrU2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56fW2iYk99i5W1Ib8O79GvyAt384B8QVZDcmaxYv3Huw&oe=6A047524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FYuzDk3sHYQ7kNvwEWfYNm&_nc_oc=AdrHtfJ42iA6zLbR5c3KtWQ9smYz7Fc6X0BSPUVE6qXrsVtSHXmdz-O_TDo7r33c4x0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b8COffm8nDUVGpu508v5eJtD89Y6MBj9QaPGpiowMKQ&oe=6A04877F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxTWDoVT228Q7kNvwHaGHSu&_nc_oc=AdoJJx9meYtyikPqQWi5NYRq73AproF7twx8ZMxnumUnX12lIuteCt9th8rg2LhKf1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PDBou53dB38gnw1RrRFnU8MBKOIborgo_mSnV7gVPgg&oe=6A047F47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
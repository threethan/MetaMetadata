CpRgaYLHZSap3W9F89JJ_GyUxbsnUrJsr2uU8t1CT_LY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSRe1GOkHL0DVEUqwm_ZajULNLBHHR9_n6FK44Jjfpvw&oe=69BD3F79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtcsX2eSfCIQ7kNvwE_b1ar&_nc_oc=Adm7RtepgzRgIr933gd7V_i9D6MNeS99r2GJoUK19NnHhiK2IvJJV-d9P6NHadTo63E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVu4nUL6pAMw58MAm5Un5kreyMKlzdtKqrktyRFm0GgA&oe=69BD4424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-xYBrOOJMQQ7kNvwGpRHMU&_nc_oc=AdkozuamrslC4UQuPYlyJ8JSfaSupUtJ0OWtu_yLkCFXEuqBQxT_LOCOh876SluJ-9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUxeK-AyMf-jzUkptjDH3oor6mRwQRSjhWGJkdkJka8A&oe=69BD567F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize y
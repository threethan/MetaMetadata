lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwQebYyww10Q7kNvwH8ZaL1&_nc_oc=AdorefLuVS-CbpBzlDqUvq5Xc98nvIxemWElsg4g_YqHQDLjnCIN8XzJkSX9-QpcdUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PFX_MFJ0a2JhzIPq0svczxgapzu2KBe-XGg75EZpmzA&oe=69EB605A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAdCZ7Gn_BAQ7kNvwGtZym6&_nc_oc=Adpf9bj3PEejiLD347lPo98QEWbGcbzGB3U0gvZuFmjQAqpep1FvpgzDIB-VbdrT6uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SIWhqdfz-nwm8r3l9x6nKy_MWvRePEX5FBsmAFYauvg&oe=69EB7B63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GbBh22-_C4Q7kNvwFWk5pj&_nc_oc=AdqbesjNr7uUCMVaWwDQDwLHqr643Ma8LbVHd338A0f_WHGItQ6P82aKimr9dNG3aHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jOiPNiy8P5SOorP2n8EZx-FWvsulXF1K85_Ka2_JOxg&oe=69EB68B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbqngryOtxoQ7kNvwEVUXSF&_nc_oc=AdrbDCI8IAoZKs6Jb3QJREtcwTL_0hEEk3M3kTzrxHC7Q83hJFWX9UmKR-O8vIbw3sY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rxDH7GTaowu56UFGjvTUxDrHJes14E5G3suMuuWvXcw&oe=69EB7DAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1s7w7M4YeUQ7kNvwFXzKlT&_nc_oc=Ado-U6wKZt7NeZz-xrHOzv79ZqtaCxh4sDrW36_lSKF4QAZ7qq8VldY9bGrBEPkw3DY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MLxx7xJFXRPU8brC1QhUUFgnch1aR5WHZ5-ArH9Npgg&oe=69EB63F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IktohsqnBUQ7kNvwF0R8B4&_nc_oc=Ado8Gf6qnIML--VyMQws8JHVl9khNDBE4qjZLJQ8FJwYDdT11-DOA77BmvUMkokHzDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YRvRTncqriKMsvoVUt26CL7xR5zzxaqWCMwKyx3Df-Q&oe=69EB68A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ANB7q4UnH8Q7kNvwEoRkr3&_nc_oc=Adq92hnMJj0Qozcci_DwBMJGdvl39uyOyrWoMBbErEbo3GOWn7KKE8fHUsWTuiP7nVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kTvf-WbES-lNILVYRdpN0KzQ4va_yXaqt-TPR0evm5Q&oe=69EB7AFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkPYdYzztUEQ7kNvwHWeEjg&_nc_oc=Adq0wn0mNLBtXKLMSzyGII0_Y1jjHzaYIczzebwqSUbN8loTp1u4BMHFYAF9BM8KXcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25SRY9dmMgog43fhuIrlrNFzHhXa6CjpAqc_4OYzI2ag&oe=69EB72C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
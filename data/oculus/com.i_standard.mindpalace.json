lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq9GufqqMm0Q7kNvwGscE-5&_nc_oc=AdpHJvd1WHJGJ3NnjLGycDujNSTSl2HSVfZAH3CeFi23F6lSBJSe5fmWhPPtDRukCKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zu489dG55OKdfdMcIX4v3gcdN0UDfosjU5L1MtMPRuQ&oe=6A3AB29A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHuj8LZmVoUQ7kNvwE8FgAB&_nc_oc=AdpH_qnYI3Gb_0WLVP3IAoVZJcZgCkUZlKvm7Yl52CKbHB0o3yZC_efNL_Rou23HvmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96NrBAmfkvziAXylcFIvbT33JNNawmPVTxDVOVJ1w61g&oe=6A3A9563"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rcB4icnlNcQ7kNvwEPiP6A&_nc_oc=Adr4rh9sVqOMa1Nx7DbeArkc5B3J1CFbB6xm4xOu5eJaWQ8MPD4v5n8uW70vKuXVyPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J6l-SAo4Ip_jcWUfIfzlvDlC2mu1C-AqlwvDZB3w_5Q&oe=6A3ABAF3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN_2aY1K174Q7kNvwEqhROT&_nc_oc=AdpgOHgyZkmB5AdKPkPYLqMaEV5Nkt7QvOTugr5pj0MjSWu9mzsVQvQIS4K0wB738xU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9odArYORsSDt90FpOjM5XOtM-LITafDmnUEAArjlsBIw&oe=6A3A97AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKc6fzTmwLEQ7kNvwGLUflc&_nc_oc=AdoW4hBRdtaUT8_gLUF2xOrlc-fAuQYEGgL2JFqFTRIxTHSBwkYZO8JExFyV7QcG7xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oxbMPeNT_kuotioyLFsjvjLXpERZe-BQzlnAvrEKmXg&oe=6A3AB639"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fmNWc5nFMMQ7kNvwHJNR3P&_nc_oc=Adrof9V2jZIKjcBZqeyRTJ7gIS6jnFyE1YPe7MCrMolXXZJpTA0zQju5EaSX78rJBmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uxngjHmQJPl7IlmkImisRuZGlVK-S2eGka4hbUXkLsQ&oe=6A3ABAE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUvvLQXU8FMQ7kNvwG0p87G&_nc_oc=AdohM9kTm-Ay_29dMNUo-c538BLTnyhzNMEilsBYT1YxdTsii-bZOmjQoa2hB7VAXJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UQsHT3RgdfuQ_k-NO00FLRJ_eW7YPFxwXDktrIeMNrA&oe=6A3A94FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDcazdpinJsQ7kNvwFbFASZ&_nc_oc=AdpPP6aeDwMw3NRu16-raj44swscMeDm10BWSZNqaS5VLUPvBqoLZ0maD-xRfu-ecs8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XhVVB5TWAobqbmXhsTc3kVVsu8XAwYpfLswFuzBaRLQ&oe=6A3A8CC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
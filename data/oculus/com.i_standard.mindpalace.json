lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ6Dg5POf9gQ7kNvwFbxE2j&_nc_oc=Adrim36m49aFgJbmBB1O3TSJo6V0glvYMqKOEeHlXSy1OUNAHt3CXkR6hfpvUc0GAtA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPjq5j8Cp8ncpz5aPUOhhj2whaS6h_KIYMfOrhhxQE6w&oe=6AE1E8DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s86VcE7WfDcQ7kNvwHzLjzv&_nc_oc=AdqC9qE2706DEoFV7pICDJbenVqBeV3EMp52jW5YZs5AjHcS_D0mWV58ZchNzUlTvjU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe0TeILDCwr2L1ZIMBBdyyG2aXmfg86fGAC6Wkf3msQQ&oe=6AE203E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A072CksY2cQ7kNvwEOqH0H&_nc_oc=AdrCcckqi3Cc_nFGJyiF5j0HaSKCh_ahl2ikGv6bys8It1ZKuzup_1WMjkyKlCXXn98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuDROPFYUxpZhpRaIKfsllliO9LVJkEiuisFuuLvThdA&oe=6AE1F133"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmKpO1xlcggQ7kNvwGGnZ76&_nc_oc=Adorg8L_UctP0aqT699O50CiNnv6-uxKRFsFPJgX-eC6xBf3KQbTy6F5Qap8-hALJFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqLPLpJzANh33LDzPNZdpmbvbxwg1xUurIePiVR6wAgw&oe=6AE2062E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYfv29Q9IqwQ7kNvwGKnroj&_nc_oc=Adog20rJrMbXjrgTY4Vl5zQk9muHOodEWRpgbm7vRZEdZGOO9yFodaCNXouKkTeB-ew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPQUdllbRyjXAqqYG0vhwVKCrHyzUTEsRrlJ6Wk6iO6g&oe=6AE1EC79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I306psaD4jwQ7kNvwFdzKLI&_nc_oc=AdojWSZqpkD0YpUakDCwiNDXfiD_2Bs-xOqzcfNEf8dccbRPfsjzK3eHvmTDwp8XW8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbWiwPwX3YreI-08qkd7i9VNxWoVLx88lAeuysX5KUmw&oe=6AE1F124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TjP_VSgxAEQ7kNvwEKpBOX&_nc_oc=AdoMuSd6yrLkkQUejOpLIGmqhtj-Qs0B8yiw6k1rEBkb7CPwX05LMQNB6sCSbHkufb8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlUt-CnpH-QdeJ_akaBWvwQ4bGhRG5EK3bzt3mweNZLg&oe=6AE2037F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnrDsOmaJtYQ7kNvwG_2zbs&_nc_oc=AdoJnhQlCVOwhOfDbT2mgLnWJBL8Z7QRfSx4Hphld5rMemQUJJA5mbwggnrfupbQQ0I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNERD3fj4BT5dNbyxIPfuFW2J1PZhkegO5JAnKmF6uc1Q&oe=6AE1FB47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9CDhxewQwQ7kNvwGmglK0&_nc_oc=AdpRVd_ZMfEGv17U9jE7MoqmrIp3VOB7wOd-43IXH2pXjdEzEJRsk-t4ucIsvOpR_Tw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RkiN6gwjnwFlhfZTNM0QSRiPJ8MHZzaZWE0pvSpSNBw&oe=6A3EA71A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN2djjrhEXkQ7kNvwGprYKf&_nc_oc=AdoR6c4eaTcAj1mbmppMoA0XsBiLLWga6FNzzOJxJBAxp4WkHBcY8Yh6Af_2pwq72gE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Aaauwkse6jCVlpWMVB18_XZovGsQ1uvQLmMaIljfXQ&oe=6A3E89E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibI79VabK9cQ7kNvwG2pePJ&_nc_oc=AdqPhMeNpDlkYMWu07sdlkneDPgMRxMySqTpxClU8E-7qGTl8CkA2NxOKXNH89l29oI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vim6yXXZZDc6ysYn-jYLvOASUGhpj6wMNKyyY0pFxlQ&oe=6A3EAF73"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2_TQFFvNnAQ7kNvwFB0_Pk&_nc_oc=AdpPsk9izDIBQiurxNk9ZlY4SQAAVJkX13j55j02Nxq4gYncjElas-mYeDnMZkFYj_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wRY2wSTICRIDBzaK9Wipx0ki2HOjAxu_G2gf9pTfQ3w&oe=6A3E8C2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p8i2vrYLvAQ7kNvwFBJHhg&_nc_oc=AdogZ0fy42iABZuhN02H0CeTMIwTYPwFNzfb2utbGDZauLwifU4_L6P9Jdya-i6khKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KlK7h-H8AoLsP4e_nUreSPlu7TYKYUnXDQFuOH2GsyQ&oe=6A3EAAB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTv817CAJvoQ7kNvwEgCTDH&_nc_oc=AdrtrmEGVCtzC9XKLJVYuCs2xNgkzp49aCaCKYDf1uEmW-kE7eTdZeA0QrrsGMF7jVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JIFu-zdHPbjd_SQrxB9jy_ZOAvpdg79JanNGTOud8IQ&oe=6A3EAF64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bga4hOE7oLQQ7kNvwGzgXjI&_nc_oc=Ado6A44R9w2IZgyhT7VSKezMefVV7PFlZ5Q9hUEuAbejwOfQnvuyFMCLWU9o0QvyoxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZzWMFT34gI6BzNycMycrkHxbDQxGm9TSC1lHYsq2A-w&oe=6A3E897F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPSRQWjMy_QQ7kNvwEtMfP6&_nc_oc=AdrnEY6reDfhKbcH9FS2HV3OGb2yb1_jG9BYccTkNYghQdnLD7HWjKwmixTNf7Irz5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FGmC3Br1aZ6dDBjQY3mKa8PSiItBgaMcSrQ1w97sscg&oe=6A3E8147"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
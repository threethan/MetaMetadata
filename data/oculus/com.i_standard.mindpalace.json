lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rfimROi9S8Q7kNvwFT2NWH&_nc_oc=AdpALgYrVBcbc7Y007gUfFipXo7n-RTUz5x_m6SSWLd4p0u8GgaR1LhxcE5_QSK3dfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEUt5qgGiRMtq3Qcd5sOQ029ncb1HEClC6xeJaZTNrOw&oe=6A6358DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKoqbHrTIeMQ7kNvwGU61Ry&_nc_oc=AdoCYbfjAxevIe_M1yeKgkjc2lp5xT6jIpRdOZBsKoF9jexihiyFmCQuNF5e67Rux4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeWa4xQi1ojqmT264wYThuF_c2qrxdo-Hvoi6ripuQ1A&oe=6A6373E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwJEL5ZsMhEQ7kNvwEgo1Dj&_nc_oc=AdrnDJnRl1d-hIptAgGF9nv67Kpq5RGyQswXlIkt3z-OiQEE0JDXK02HBtNKmviXTmo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAjkBKPBYc2zpd_zI3YIRTYHXqvz3PDztMQxJJfhjHAg&oe=6A636133"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma7Nga4l-eQQ7kNvwHSiyib&_nc_oc=Ado0evnP5WnApswcX9y-0jo_voj_LO9EKpNRq-8kmgZoZAPY-8Z86FdH44LSnkieuQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApqklU5vbgmQk19CdbFy4sT7AGAdgz0g_TK_JUAWaYug&oe=6A63762E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOjBEOQpnVcQ7kNvwEw0zqa&_nc_oc=AdoOcYK9PzVssrGE1A7i1n6p5xICPxByLNrUUMm6eIyfs35HQ9woyN3363qjnaoVjOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1_6tfoIOYwyV7WfHHHneGMC-elVedUu7D2Du53Ne2vw&oe=6A635C79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alHmyRM34HkQ7kNvwFDKVLi&_nc_oc=Adq0e5XU9t6iAZJY535yoOlT2MOR--C0TbDvps8LXlHEv-IOcB7FpZEXDnBfmuIlzGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9mnDXxynxVjs3PrMJDmDA3vSssRIZENuYoApf7XSrtw&oe=6A636124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uQfFsrKfWMQ7kNvwEK8NbJ&_nc_oc=AdqA_Ta6H2vDT75trWO4cCkpynlGbd5X0oPT9fHwjh5Hr5gvT44rbbCWatSVQp_289w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMvf8void4l-4ca6zQDWJrjoTZELmPKDbOx0H49-LFvA&oe=6A63737F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLnMN-lUsN8Q7kNvwHvWwvv&_nc_oc=Adovr17W56A_YWKdnU74K56275lFeXhxNaeGDJSn-Osl2iPwSkev_as3nfv9Khilqtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzDe39kZ0CM7hZg9P6LF4ZCMhC8bS0v3lxFBFgrAb0eA&oe=6A636B47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
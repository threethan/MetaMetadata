lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_20keGBQcuAQ7kNvwFM5pMG&_nc_oc=AdqYQvhaZ4X-W7sJ8ew5LduW2UZnMQFqQcli8AiONbjdd-qv-46JHHu2WAZRW-oDX6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdRngAbNCSapMJKCUxCMF52LRFt7nUi07GjaV4gtbF7w&oe=6A5E12DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyEQSaLGpQwQ7kNvwH2YKKv&_nc_oc=AdrCRvqqeDLhYP5UBDUyCv1B0EiwbhiwRV1iAkW6FxDEqBuFkeEYiFh8SvIdiOCMp9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJW-4Cp-gnFvyL23clX8wWGrzsEiiz1nTESGjpkArmxA&oe=6A5E2DE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YkBZ73ZAq8Q7kNvwF0ANzc&_nc_oc=Adp9ctCake3hwtxVWrAY5WX2dVs9BbCLhIyAbn6ueA5ACr4oFblpAE2D-nimSQH6ipM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOH0ER84iay_SA6_HTiNRoUa8Ghh7RgJ0R1n7pIr7RNA&oe=6A5E1B33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP9A-I2AhIkQ7kNvwFcU5DF&_nc_oc=AdqNYMVWx0pVYSpivtbvgKsmd76j-9BTNjKD32nmtK9ckLAaZZjVeNaYYVG09ZGzSX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbKepotKSEunMxsPZUcBOOmYzVOR0v-Gi9hPEprCr28w&oe=6A5E302E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4MRsXYehp4Q7kNvwEqWzLa&_nc_oc=AdoGXmrfPwW48eraTObuN1G-tB3qpkZNNHn6I-Yk1ZDMzo7Loj7iBNHO-kPRXJYDyYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ1FtJ6rGdCoxs4fD91Fjte8VS51462_rG7tEDlYsOXA&oe=6A5E1679"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmC9EAH8cDAQ7kNvwGqu4aB&_nc_oc=AdonzGlUib67l4IFoegFlfz_V7b9cr2yxOWpeGCXxeAXSVeK7byUybZCmsc_M4bxfVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT2_qg-4alIyogIloaiiyNd22F2UHhs2Xw33iDZokeEg&oe=6A5E1B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM1RYmEToTsQ7kNvwGMQ3Iv&_nc_oc=AdqsUVpzX7Kb_zrMcMSCYt0lXRkYkdn4j5ZFsge7Q9mLrMZ5xWSvZgeup5eqrUXdfp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKKfHI5jvY1gjeKUFVoo6NEGzBxgF1DHho0NJhFyqVVg&oe=6A5E2D7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ-hcKU5WEAQ7kNvwGJ9LZg&_nc_oc=AdrkeeNXjhFEy7zpC5oWKHRZnyxuKs--AvpHhOx8NtPhI5W3JbNTgAFH0Zop5jCxDl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8NzOd_sQZmJ2w_pTVtKqcxyirovkjJbG_2xtOahkSxw&oe=6A5E2547"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
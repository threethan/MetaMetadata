lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5GA6ui7hHcQ7kNvwF67FPu&_nc_oc=Adppgoyw3drrrc-WdeYMTA-Lo32Vn0Z1OejbXJwKzVySwm1485ebvy5558Hw5pXBe2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0NSkabzly1L9dhq0hPiYYTa4hzDa0nZ7Th9G3KyeXcQ&oe=6A7087DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zyL1TKqRPkQ7kNvwH0Wn7W&_nc_oc=AdpKDLZeyO_r5qUcsJdJNPgBrmNSv13yxzM-4-E1jhj2nS3xYpl_Bg2z9MIP9Ii0M-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbvW2-TMFqDahk-IGVE1fWOqq8TxF-3L45EyEsoTklHA&oe=6A70A2E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqu7oqaGkGUQ7kNvwG0i1NT&_nc_oc=AdqwOGHjgb9EmzY5a50gXOgZRqs8lNXXfQJBnxCOWCgbZHS3IXJJ_8Z7ooi7QLd-lGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC6UhztsD85ikUwDmC8hJIJq7XDChzVjdwyJGaKuJQag&oe=6A709033"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrCJm7Iqfy0Q7kNvwEvw52s&_nc_oc=AdqIBUPni9MYkHukHdaeFvTIEUrvdAaZBflneoq5Zbab-X7sdwzzLCwWbn4yuQLXH7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyzyAYF1EzbOYmOcb_z4edREVDArfZ9HSDLeI6FDN8bQ&oe=6A70A52E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA_cRKI-jtAQ7kNvwGvwx62&_nc_oc=Adp15_EAZM0ilLPoWyUhPxCGiaRlgJvBOmClGgfDiHWrNJt5TwnTHs4Z7cQl39VV-aU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4cBAbtxowSHCu-b2vtMIdBL6im3rDm0dZbm_XlyWfkA&oe=6A708B79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqxirM3hCSsQ7kNvwG26fXM&_nc_oc=AdrFIwEOJXLhaPLynF47mNeQNzC3GLcZiR8MfTAnX5hIlgsJnOPcs3od-8bujdRyl5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsA8cCx6YecO0MJ7km2JFQvFrTEvX-6gePAuzsCdFKrg&oe=6A709024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAWvIm8GpSYQ7kNvwEMR4t5&_nc_oc=AdpkBAT3JFhXAsJYgAwt9wbKsjDLiCVzgdmCUHwe2E3UklmqN1HDegwLeMfqp1fno5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8DHaZOu0eiGysHj6IHzrbW7ol0L2ZMWCs50P5oRGl-g&oe=6A70A27F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_qy0p56b6wQ7kNvwGWsPiX&_nc_oc=AdrosE8qCZaOk3K-nAJlVeKKU8pBiyzIZofV1OSYsG7sHbw0I_miuT0OiGbDZw3uVj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ41OM7p2G7906HLG_FEUWWxHmQxb2a5Vycy2pG-rTvg&oe=6A709A47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
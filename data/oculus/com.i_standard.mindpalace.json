lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2koWz07eZMQ7kNvwGkXLU9&_nc_oc=Ado2-jc25OtI7JPZ_eIxOgliKn1CDm3583B38vlMlNUD_cBs78zJ4Ft3LzePdb5BRZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNIRe2yEPGGRal06OrYAvKmPf4UcBli8rS6tOnygwfPQ&oe=6AA2A0DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2flAbFUacdAQ7kNvwHtlaq0&_nc_oc=AdoncK-xJ1UFCl_JBWA555rLBaOYV7w8XMaW34OsHR_9XulmNOlYyrQ5YqpCL9GSa-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVB7Cg77uXsgAXC3sxhU2yvqF7b1TIQ3T7yNpU0L4unA&oe=6AA2BBE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DI3HhCzqk8Q7kNvwEGmGBC&_nc_oc=AdqwzXCgjAyekmZ5GNLu3owpIWQ4VkD8YMXFsXw9rFr2RbHtRX2nVRBXOk1SqnFjq38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkPU7B5o1sE3DH7QfQljWU3YloG4qnJzXmb-qeN9YVQA&oe=6AA2A933"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJp-nyg2X6wQ7kNvwFO6rml&_nc_oc=AdqiCMghmfsfPoXnUZUZ_ReQ6P9f61Il-lcxS1wGYl3dNT4Az-_XmiOztKCxbuZfTiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvrXDjlDUBlujKHQ6_06ZeUhK6gyrkNiHLFeww3mB6bA&oe=6AA2BE2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvAqrZK88a0Q7kNvwHxWiFR&_nc_oc=Adow6Ow8S4zG43jipbzHhud79Vqj6uogbtMY0MZ_r-iLroiY2D3fzdQDbKQYhEt0900&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtBo4qWAMgz7XVs5_3Nd6UYh9Xhd3XNVC9321V8B5KAg&oe=6AA2A479"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tK4hIu8jN4Q7kNvwG3msJi&_nc_oc=Adp2YqmEne7Pg-UkAcZH9brei49uYzYNTQN7xRLw1Gtvq4Y4A0tOw459LcwnwWmmb6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-0o_mJ65u6GrhhMUBDQZbSteR73o0zK8_qcuG2WVNHg&oe=6AA2A924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znHO3x7kLzYQ7kNvwET5mxz&_nc_oc=Adq48GCoDVfYNae5nXjslwdnvZTM1320OktV77HLJM1vn8mCP8UC3KUN72Wiktd5knw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV0sbkV3fHfg2DD48lAdlY4Iy443sbkUwaVwurZMpNMg&oe=6AA2BB7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmNxikO7CLAQ7kNvwEVtJij&_nc_oc=AdqKCvdUXsZJJFQVyMo2gEgI2bv_Jn3haSej8aNdIIaLJlrl-lJV-ZdqG1QwlyPI7qM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_mpbaznE2gy-nw_P9kQgBwBFl0vjPNufODqmyk65Oog&oe=6AA2B347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
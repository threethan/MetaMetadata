lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH1P2NKFfPgQ7kNvwElxX6P&_nc_oc=AdqYj9h4Q0gd4r4vhcrYjBR4GyUUSp2j1SC1SSidT_qOoPUCSMjJhns1z66aG8ss92c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe9ikiqu7-f0harjfjzyeHdhaVenrwYpwZ0THcGV1iiQ&oe=6AF4961A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A07tTJZzt0Q7kNvwHN_qEQ&_nc_oc=AdpgqUF2Y5xD_Kc7FqJI7em1G-6cisZi1oYcbN3wQZPQ_jq90YeqEQDZA-iaJdMJeVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUr2iApnoXuauFIksgaRZdAZ-P23C4p4D35_n3wtFHiQ&oe=6AF478E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuiYHjSeXCAQ7kNvwHNauwc&_nc_oc=Adpi1GroMQ2cu2eejMI6lqjI27ZF3KC97yQ_4nVnhkaBBDSzA3n8zihp8uqiJtgzET4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYCjaWgFj-5ruiJ2GmG9kFoXjsGICuFlkut8cYiiq5kQ&oe=6AF49E73"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-yjRkkow2YQ7kNvwG6HJHh&_nc_oc=Adoi643IU600PxJdZljGlUBcPEEcYx6P70nWtPH3oblcauru1AMZQkThdeQRvvi31DA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGaa_VuXrSxAIQjWk7pZoQnYKeud4ZpwrZwP7SuClprA&oe=6AF47B2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8oiWo1WalcQ7kNvwHbwFQA&_nc_oc=AdrPf9H4G03o5yQfNQPH3BL_1JDQMXNU-IVv4Dwt7o4BkBr8YUNqDMjL4mHw3y69UOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNMrokcLOl_vgIYERorIZOfGSyqbm-cep0VwWkPt62kA&oe=6AF499B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA9HOT1-1U4Q7kNvwEHa15t&_nc_oc=AdqQ2BV2ynGWmkIEPykapK5vSkr6sNyF7TS3bN5HoFMD-4vflqZe6yPyedeFVjYkL-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-aBKU75NP2vUShfO3Kwiano3XeNhH46vWCgorpdzFHQ&oe=6AF49E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx0FdTqSd6MQ7kNvwE99ckV&_nc_oc=AdpoCNEtLC1uG4cDBLLyKzpBTqJNzsP2OoP73e_U_p3izg9AtspEtQqxlszRkRZSbh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcysZvFH16erCO9r4UmxbyHzm08sGAqOqIjj2cLtzKKA&oe=6AF4787F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBs_octjYt8Q7kNvwHgsjQA&_nc_oc=AdpLHK06UTI5JUxX2h3kUXYndh2-91wM9NvHlbBa7b6iM9hu10qSBlIPnQB8wBKd3ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbOGFeHNGymD0JRkrG4D4_iOz4isrV_e-ZDsdjip2vFw&oe=6AF47047"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
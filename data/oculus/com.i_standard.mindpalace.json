lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvnDLyv3aGcQ7kNvwEoR_8o&_nc_oc=AdqVn5UAh6NrKRPitoxMYmT4ujfAdYjgy4jlKQXuR3jCW0bVk9vKy6rDk00Ns2bnWrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmEAOeFlqMF1zRggjwERCvoJkYLR0pZYL0ItLhesgkiQ&oe=6AC6719A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K5-0MzezjcQ7kNvwGsC_LT&_nc_oc=Ado6sXqfkvwGm6wW6FXdNyGNfPfzeQaZzGUVyE9S97N7QdGw6PvyrwY8mstsWNluvHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEWTvoiSsuc0CsM7NywNX-1m-AqkJQ43wyaplP8sxjQQ&oe=6AC65463"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwfaeAsXmioQ7kNvwFkzWWR&_nc_oc=Adp0rgL5Mc9BCwPhgF378kgJBavwKPUqSm0o_xD-wiZ3zLKcvVONEtHTqjusFhUdw4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbNmZy05MwKWJYDsKKrHScjqJ-R3A7t0l4v_2V3stGuA&oe=6AC641B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqHoXYsfqccQ7kNvwHrYAkp&_nc_oc=AdpRlN-ghOkunE_6BRI_Mxru-zfLiZ3jKdBrnCEG4rhZb2NVTK9gP7t6_QhLgpNjCu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODF1Upd8HI5vSqVm1t8fhtINwDdzX1sQ2Ty-VabxIZfQ&oe=6AC656AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L10QaYb5ld8Q7kNvwFZRH11&_nc_oc=AdrD1ptnz93DgI1mDSegYKx87yj7B3tNujb4u02a97SCdyNU3j7RsyT6AfuE4e92DEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsNOSSNFQtGu3W4_XuCgYaYt174r23Wf_Mk7Fhchk6gA&oe=6AC67539"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IfqxRAV_NgQ7kNvwHG-Y7A&_nc_oc=AdqVleSaqy-6W42JT9_wZyr2Ax6tyKLg3o0lFsLdVL9Ol9anrbr-v_rR77DQ_-0ualg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw1bKhH3r4jk2hSvrFRgWyVUxNNommvI-UOpYhGQCbyA&oe=6AC641A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUjY8y0O84cQ7kNvwH7yU1B&_nc_oc=AdqxMWRilhIh8n9D3H_F6VAPhwT3fK_80KnPHNBpKEQD1xlfDUXehjDXIFx8-n2turw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPXfvwGHFj4BGMpYDbotIC97rUJAzJqAkp2flR6aghOg&oe=6AC653FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWnylReSszMQ7kNvwHIOXDK&_nc_oc=Adqfe9dPe7Xr61GFVxRwaL-iRTkprlvb9XOebY-S6hiWGJ1Wb5V4ErC0JfIsV7PTYMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9FNKZSS8JC1cGjxCmHQyUhzpk2aUU6OhDiRnW64g3uQ&oe=6AC64BC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aKb4imdN2QQ7kNvwFd9xJy&_nc_oc=AdqS0Z47PA4A5f_5AJzq7tMDEIFVY3N7fIyMN3FRsQFVDPfOM6jy49rVUalNEWoVCxE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDFtmzsWTvRK2GmpwYq_j6Sb0tBciutjobT6ncGf4QhQ&oe=6AD3A09A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zM0H3jhzL4Q7kNvwGXo4pc&_nc_oc=Adq_kDk3jhfABric5xCzgI9j6X-w7FSVihLt17pmzM6SZZkvzwkGcyhVcgt_0WLp4JI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcyzH3th7SPCqmRR3Rq7t5W_IV-cDd0Iz30SqAFLDCCA&oe=6AD3BBA3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Di0R_86WqCAQ7kNvwHrUegk&_nc_oc=Adpq0i_9GW6IMujg9OTWLnduZWM1s24WUFoAuZo66NkfdYd7ObPeDWvhEFWDwkeGKhQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQP5xOuWqDeu3UIaB5Lj8nvkvvw7hG4DurpxmnhSdqNQ&oe=6AD3A8F3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu5fnK0dYn4Q7kNvwGB1OrX&_nc_oc=AdqTLT9dpuG-0Ok_i7JMZfMbis1mrupZ309o59n-Y6gMybDWB71zD42_P0ZryE2r9tA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjpEg478Zxkyw32Uh22I8RLFkbnvKRzMK1oqq3ManRzQ&oe=6AD385AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgOfQLgQEhEQ7kNvwH7sV87&_nc_oc=AdpVAy84iY57ab_duiIyjlZI-8PU1v8HU2XS_721ef6-1ehh8f9bwJ6owad_Yf60uKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM00OsA7mTpGXTyc5gv19U5leICDq5GtoilvXMS8JWUBQ&oe=6AD3A439"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU-u8u34mHcQ7kNvwHmysHS&_nc_oc=Adojei0le3kMzZHzJc1eJ0y0qv9ey-bn-8ZgiJdMoFFYJOivKhyxK8YTr3hSlew-IAg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrrtz18dh-FfydJscw45gq0TiC3pFc8b32QK4-Qod6LA&oe=6AD3A8E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrCA3dAxVtAQ7kNvwFl7n1Y&_nc_oc=Ado0LRxRHj0R9g6RuvpxThzrDFmr9CiD9rk0Rn3biwbF4RJvpJQdRCNz8NpiWks7caE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzCjlRNBxrIuX3nP7hsod8sN7GLFJ6J8CGotWL7NJb9Q&oe=6AD3BB3F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnU-wb4D15UQ7kNvwH3dJVm&_nc_oc=AdpBeVwp1MF-N4PJbLsoZtVL4u-j4sxcEIc9z51ICv26UFMYjnRQ5sjm2Dv-wz40ojc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdlE-zsZvlYMZWNU5SOoduAEPprAjr20s5FqIvyVjLaw&oe=6AD3B307"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
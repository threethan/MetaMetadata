lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vqo-nvhYcKwQ7kNvwF_hwIO&_nc_oc=AdpgIDjm8QvGUjFJ15ez_f3q_UmQjbm5edTdH4yf8iP1ys4IyVW1DqsjdGc6j53WbPY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lDGrsvV6il12RyK_3ztSe4IRyNpjydgOGoepWIF9E3Q&oe=6A12ED5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAcWUrdnxbgQ7kNvwGgu48t&_nc_oc=AdqdW2ImJhFodc_0f5Xm6kUwe2pI8-6L0kmHEt2ykC5hiPL_NMFL_7dxsA0zo4exdU8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cp1ZnrmUUFtkjsSymtYX017T5qi9jdLBaiaiKlmOLbA&oe=6A130863"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbo1uTLZJYQQ7kNvwGnlqJ3&_nc_oc=AdprRgstS76focRxaoH5-2H05XPIWn_ZqL9P6p7cL4ZUUMe--A8hskvqjmpeIajMktI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p90bT3yJ09byvUKGzP4GJlq7GgQqjh1ahEnRgJskyuA&oe=6A12F5B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYvlGdt_wmgQ7kNvwFu66Qn&_nc_oc=AdoQRfiGn4aSlWh35Ur3UeuFW5bU8Jdd-MjPohrtmmObqcoD5AzPvjrkBx2nnm0cd-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66acB1pvcLkl_YFnEwx95RCinhzOgTFPjndv_yKsCfXA&oe=6A130AAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVNuTDt-y0EQ7kNvwHFOqRA&_nc_oc=AdowgOXH5WnCKukrReVB1fkK1m4q4WZ1-Y1QiO7QshlDkpw6WCFDtNtLAcVSxQhVNvM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fU4-2P5Xl8Hz1LIJi6GYAlWa3orq6fZYkjU-fN7kKDQ&oe=6A12F0F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXAJAxkY6AwQ7kNvwEtBU4u&_nc_oc=Adq9f3ufK2PXi0_TTavTvJ3Wn1HJ-HOKFWY2BiYLC2zyH9_kmA-iCvMSvvemyjNVKXk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41h45F4JD3wwu8043cx2aG0-WSAblifp4wn15C2umfSA&oe=6A12F5A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2e3hP-GcmUQ7kNvwH5QWwm&_nc_oc=AdqBF_Um5XepjiFXcLqIjjcKD7RacOFFNKRiyButTnn0-UEemfFwXiFMFKke3sVUbC4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v2bujeQDzNhb0P4Ugqk41gnSTKLY0Axxo6NYexk-zww&oe=6A1307FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTokcpH7Iw8Q7kNvwGkUQGx&_nc_oc=AdrsqJkRZqtTHQTRX0ReVxxe3iUmJeAuPBTjcww9QxfoDcWhJA-a_yMxKz-tu7ASK18&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53j5VuraCW4wA-Z84ZqN573aTd--f_oXO2dx3jyEe9iw&oe=6A12FFC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
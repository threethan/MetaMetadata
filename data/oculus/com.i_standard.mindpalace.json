lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maZB4JfKCPgQ7kNvwGbrBzp&_nc_oc=Adpd-HQEmM6s9dDSl5xrUR5RX-xUqqbojBelx6de13ITpYmzc3RV7APf2ksECwSThLE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BNDEvXFf0rHuMdnnNWmjU2ARQSNBjiWDU9vhnsA99xQ&oe=69F3495A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZl457K674cQ7kNvwG2woL5&_nc_oc=AdqoksBNLOn29WZMbFZRTJd_Qzkm4SLv3Z1X4ydDWJztLGPudKMF6BcINIy7xBLIFN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YDjn3YMrt652nEoDTuF0vQT4yVa1PBdIx92EJV2S5hA&oe=69F36463"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm0ymL0nnhsQ7kNvwF0KjZr&_nc_oc=AdqscGt1fAz-x6t4d12FPXHEkl3Ri-6Qv7tc3gJCkHVia36rK2n9K3iC1LvS4Dkg6fw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jN2pKpJI-IBwfwwIhJu8w41g50rWyEmxksTVUzXH4Sg&oe=69F351B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB5mqGtMG7MQ7kNvwHSnpej&_nc_oc=Adqnkc7nyLAoawAtrzyLrhrgHNeSRoDaynwzWw2KoighppYi7a3HbRirhK2_fEkyC_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Lhu6SEbv_tSkhPCyCVJC9syVNnGOSW8922a-DQjVupw&oe=69F366AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3eespaZdQ4Q7kNvwGI25Sy&_nc_oc=Adrnqo-Fz9pK11GbaqYFO2S7N0Wo-CstKsz0NHVe6Hv3bCOJSDtyysPgsZEniBv25xE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lqXCRVxmvAAeyyKSyUTxIrRMjOKJ5Owyizxs8CEAXiw&oe=69F34CF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ706jgbAd8Q7kNvwHq0qUy&_nc_oc=AdqpUsCkDSGnAieCICTR12QSW8d_JJJ6VBIeqip2XQPSIP-Wd9mDUm9FjgEzHrrBPNE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1V7g9UbeLihnsu09h8IJm6MhGrOOWPF4xVFJou6SfIbw&oe=69F351A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S0hZkNS9wUQ7kNvwFwK4H9&_nc_oc=Adr0TEz5OwqGxysF52z1e8P087UcvSg6dVUw5tif8_j5_W1fixohcG7WSHM31KXH7TY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0J0MAxavHDd27pFEeZ8PcmcXIRI0XpWxVwaijyn0Hv0Q&oe=69F363FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbW7dEhjc1gQ7kNvwFuVPHR&_nc_oc=AdqhAANxBoC54razQQYH1SAAgf9Vtsg6qTkvO6whv-H4A6MEJzNwyDcTG_S2Z4GHFC0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24fKcAexoPaiY8dhuOjtq9W0YCwjuaM3ybJH9CfZDEMA&oe=69F35BC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
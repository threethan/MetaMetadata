lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZEVb_y-IkMQ7kNvwFvt-_h&_nc_oc=Ado16Y35F2c5LN1YPtX-CmUAmBn2RDfZxDoRqPB5ExPDgfxc8h4pEC1ySC15lu-Xpno&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zokBI6mYKDTQdPZgjTpC813JPYz9iVTM5ZpDhii574g&oe=69EF54DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyeiTtNavg8Q7kNvwEEEEqm&_nc_oc=Adoi55_tPiKbuxe4_dUnMzQ4YNLc3E7L9taa2ZV_KjRE0kAj_P3uA-MfeSHoaAVFphc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eRbBbI465HQxvUBPDZOgQABVtKg7PZcgCq0iDknRQyQ&oe=69EF6FE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jorlcJcFO1YQ7kNvwHlOvRG&_nc_oc=AdrsPfauielQsz3uLFF5CSPBcsGGs8XYtmwF9eYqZgOJ5ZXKtBpK0z27kDRr02X3raI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27nqf0iGDvdMvXh1zaagXhnD0zCBGx8g04BzdBGoePfA&oe=69EF5D33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G8h7HjjolwQ7kNvwG0UdgJ&_nc_oc=AdpLFS0cayLsfMYzURKBLeHBmoUWhEWw9y9hpUROICBSB03vvzt_4T_pLPcsKpWQZas&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03cEytSIAWlg1l4bsauwRQD8s0OpLv4eCsFbK5Q-X_pw&oe=69EF722E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH5fjmMsUp8Q7kNvwFemGFN&_nc_oc=AdpWwUguGGeCOu7lARTE3Xy8q9_SuNsD3IVt6fNRchUnpAhnxX5ePZ_ihoqRkhGSmds&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bVCuREQhOdcXpb200E-80Vet-JZ2JY5NFHpPaGJHptA&oe=69EF5879"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh-SEyf461kQ7kNvwFZb_Hc&_nc_oc=AdoGdYadz524r0e9nfDe4bSQfzwEmEKeR6VjFaWheWL1le93r_IICBE3wd1_6eLp2Us&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20Paj6SuH7yggyMEXKHAnE0uetN5QsJaOVIwknPgvEkA&oe=69EF5D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OvvduBFXpoQ7kNvwHosf2H&_nc_oc=AdqQPgpnlBsvbBlnF9Co7_ebXUeH1vja1VoE_TveuTxOKwdfs3Ov90uxR4rDymBXFWA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RSlUst8QPlSys3WndltmCrNy3IdlFRHbT56ssI5jYUw&oe=69EF6F7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NSPh1RQEeIQ7kNvwF6bmd3&_nc_oc=AdrZr3RHFwJ4uPyr4UbINptSPIdhHducbuvfgznrxeQtV3PhPdarR0eDhRc7Yxiy5Xk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1A9ifwCkngXPXKBAl0ZdcvuFNK_A85pBzpKO0y_p6D6Q&oe=69EF6747"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaHgWhLB1cQQ7kNvwG1yF7s&_nc_oc=AdrZ1UOT-ZvsMAEHSgrOEM8EWTCLWa_VSWNij2eU0KFUQl6W7FgVCCdSg_R4f3zW4Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJeG_24AwFjONaSam8FRxGWHC7-SFSouS1jfPJM-yysQ&oe=6AF7391A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PdMUy0JujEQ7kNvwErH-I7&_nc_oc=AdqE2IhBQp-KRtk133Xf1ymvMCeBR6B-k621HEI8sByxbv5Wq3iiWth_hE4H6TZP7sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4PGltSHjExiU3xyS8e7Zz5kPfQUbUhFDIavS_LMSGHw&oe=6AF71BE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC5YNqYWZe8Q7kNvwHtEh-B&_nc_oc=AdpB553R2GazUZXsbq0-b4yIUm9brju8YmNCrg6x8O-liBwtqDO3cWQSKoqkLpaGx18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2w2cszcUILWlQpSgz79N7UT51_6zW0zsaRftgD5XFpw&oe=6AF74173"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae90mBDd1v0Q7kNvwHJEIlH&_nc_oc=Adoi6NL3hOGi4gclFZcJPE2P5onVCxF2CyMtpWqH6cta7nRZtNi3t_Zz5k3wQ_NV9EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE-ai8hhsmISRpFPoZxMZL0Tz31La9EEAcaz70apUhbw&oe=6AF71E2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fI4Ktt2fEUQ7kNvwEDZYHI&_nc_oc=Adp1OD1D2faG4PB2yvBJWUn6PrWTDa1gBP4KjfeufUcMRgnwmwkjyjHoPoG5NXb_V6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSUM9tpmN05-d1CDN9appUw2oIZSQqv_RtarR1T5EpfA&oe=6AF73CB9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqO8ANa67GEQ7kNvwEhESou&_nc_oc=Adp477UmgCG8k1LkUA9E7lemIGQLYL5mU1moJRooALUvqZRb6I-slwPaAPhOx5Lwqys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcnuAnuP7nstkr_-tuUoWz1LtgfV1AL4ryQ13B9zvl0w&oe=6AF74164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx0FdTqSd6MQ7kNvwELJN7l&_nc_oc=AdqtE6O4iyZlmrogQxiU27myPKQFbxO5I6uPzSLpOnzWH9kdRVjtCCogtq5ZZ4uzOcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHcqxzAQKpmzKwVUBB6DfxH8R6uT75AaDrzc-JWdmJsQ&oe=6AF71B7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2vpfZR0bZoQ7kNvwGYfgo0&_nc_oc=Adr_6W9imuwqAvpxDSunqeaEtvd_aRSd1_9cgms-9-ZpZTu9t0KFN4Tn-4Y-ce1XfFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMWwII-uupHQqwHXpYZHUAfrzjfKaWy5oWIBf6EbTAhA&oe=6AF74B87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
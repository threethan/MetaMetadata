lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q5yG-q833QQ7kNvwHOs0WL&_nc_oc=AdqNM-b88XWqmfPauSgRHSDp_NoDRLL3FXtMl8jrl2uVvTssBEuBjZRIsrw1Roi49lc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_pa_AWujda2EkGZKiaMVOHTGCPNgXupJV4JhOxeggUw&oe=6AAD2CDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GtdgI_xJpEQ7kNvwFNG-T-&_nc_oc=AdootYsl2VGmpz37WyOSm9OYpWTYowvNpLqw_4DkoKOXiYcwo0p2-_-OEZOWKFRSIoo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkEotIMRj40Q0fYDiRvmwNDkmzi8CpwAQvET-aFiwatQ&oe=6AAD47E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSOm0uc66hIQ7kNvwH4XRuC&_nc_oc=AdpXJH829UpycDduUNJA0DlfskuwXflHoGAYjxSeDIbwAPtBzDvhQ4CUKGWds_gpbOk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJs0fe8voVnZelEbPu87avbRYF22lVo0hKsu9U0xyqJA&oe=6AAD3533"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAj8SlQ1re0Q7kNvwHHdZ0_&_nc_oc=AdodfNjcwEmws8CuLm1nPDymWvCkppWe6AROO7qnBKoYY1S3NRtK-kFMSt21U7iGPUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ-LNN1VPuBzDHZfR80BVrsNbDY36IEIIlpszI6uNniw&oe=6AAD4A2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi7rnN9H82wQ7kNvwGNsXJ8&_nc_oc=Adr7upXwBbKIbv4i5jx1hPSvdSGXc0tjUmDHfHT7jSwjIE2CQmgQbRTb-x6o8oatjOs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvZyMtfUlvHxV7hmy-ibvl3HT6sR0_8Y2kSm6k8ZM-Xg&oe=6AAD3079"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M0ZDhXw4joQ7kNvwEf19oQ&_nc_oc=AdoBL6snSjfJ3komL-CmpnS64b3mIDM4zY_ZPD6LxPUBLzIShy3aT1KS4Ta-K2jUtaE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEWnwJjMCJnhQbnNz-jUN2cbLyHlRi1ykly9AiN8JBVg&oe=6AAD3524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-sLLG2nJtAQ7kNvwH3D76A&_nc_oc=AdpM87e-luQvKseiN17enSlgUDJA7LS8aBapnbyFDHd7e_9ZZ_fQajQUX6mVB0qrm1k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_g0mYze-8bwr8o8Cjz8f2uNgV_y5rDMa6y2dnnuSd4A&oe=6AAD477F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtM1WdMXWPoQ7kNvwG6zh08&_nc_oc=AdqN7MQ-_SDDsHrA1ydQiMFLxOxINU7qNDjfwV2GuUOdchhxfMDEG8Kho4kyFBE_wkc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpT-0BJ0iWhGFSaMS_k4IPsw749PZxSiDJRGWsRUOjAQ&oe=6AAD3F47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
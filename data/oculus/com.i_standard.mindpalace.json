lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A5iobsX284Q7kNvwFgLMQt&_nc_oc=Adoisom4V2dW6d55R0hSSUjsxXVDqdPsf3_5no6qsmNNuKhNWlAD3Q9Im4kI1McE2vM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt63AZGywI0KASZX3dHR0Exo73D_mGe7wCIHNna_G9Tw&oe=6A65FBDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKoqbHrTIeMQ7kNvwEaLQNR&_nc_oc=Adr1f4Bc8QNR0h0jqPmmRWFOmEdzHBuCC3dy8d1as_Azt3pE0dXS5Y0UfLvSUalqlas&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Cd7SO5egE1J1BhSziMokuQYvpumNXVCwNlL6gJ6Ayg&oe=6A6616E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MigR9eIZo1sQ7kNvwHdb28G&_nc_oc=AdpJXVVyLMMsJkvhc-tMRSXKMvMEISMjE_wn9xQTEX-7HpNmLRKWGcLdXy8BCVGoHbc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoOHgzepyMgDN2-5Sx36b1DUWeyU4B4KhYHK1g5s7mDA&oe=6A660433"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma7Nga4l-eQQ7kNvwGTXIfc&_nc_oc=AdqDph7ZuM4B8XuNL-ecLMdsU6F3FVXH0z5-MjLHGKyhCLBDuU4cvdm5b80TsQO73iU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm4MsKAruVtg2dWD2NFIswQQUr4MaFhRQsvw7TgxmGTQ&oe=6A66192E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOjBEOQpnVcQ7kNvwHLDd6b&_nc_oc=AdrdMXbAfauzkgjH4vjVGaqm1EEqZVIRaYmhoSmKnvchRx5_CMb2QisE6LCVgJ90TYQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmMU-S259_L3z8bjx9_r0iyGgtso4mKWbOQz6ja5LCCw&oe=6A65FF79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alHmyRM34HkQ7kNvwH0lMb-&_nc_oc=AdpiWneUc9rRFV1qhlDCM3W05NDMFE7QotvVuQaUIhVg-JIKCT7bJKhkTNKSLbJ7B7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAqae1LXfE4fHukyktN2LlXqaNsJAxxAaWmZDo3ogAmw&oe=6A660424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uQfFsrKfWMQ7kNvwEqi6VV&_nc_oc=Adrs69RKVUSgJQBodU_jxvZZbe3RCpO6pmWNmm0xZ2MfrkRSepobgtPjdo2BHsnztvc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdLfL6-nWm1Ljdr0_DaMvMKfzvXjgbaIT3XiIqKq705A&oe=6A66167F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdPilQuVZEIQ7kNvwH2UBV2&_nc_oc=Adr3Lt2rgAzO9fKTobSkWazi_wpuDIKBzeZp2NK66DHD3hOxO9LjPDfd6y8k9bhUUjY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0_R5AGJkS6w7UfYRTx803SE5q9W-Os71F_aVE6O86og&oe=6A660E47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
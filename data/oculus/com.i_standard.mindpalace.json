lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=al7m63jBfW8Q7kNvwGlcs7u&_nc_oc=AdrikXF6P6VayHttuZUqoWkxRSgtH4My3Z8FIaz48Qjm7-y9WIiWost8lER1PqZ9SKM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_rFdFmJt2aA3u34vylLrV9DTNt_nQOy9Sr1CB28o1xg&oe=6A81AB5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbQCtADIkXMQ7kNvwH8pVOk&_nc_oc=Adp6y5tIIpIxOy-HYAgIkNDvbltBXD86YoGAJJBjHl35dS35pZMyROiftHiyV1gvTxk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuTbVlN9eqcFK7O5ttK9cJYwnLz-G_1xs2TEK3GTp_rA&oe=6A81C663"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gd8lan1rggQ7kNvwFIzEPH&_nc_oc=AdpmAzG3pfM-jvAKTM0yjPp1SYY1v2ldga44Pj4eCRMu_rEzP2SK8jucKvpGaSEuFnc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf5HzAJMTCMX8D-Vydqw2iygsOy9aDYL-KossDctLRbw&oe=6A81B3B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTP5Sm7oWO0Q7kNvwEL6hOw&_nc_oc=Adqpkb87B-v4va5ijorllqQDaWOT_U76UR8v7zvd3WJT-5IU1q_WilTSu4YekapOsRg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjotGFll9qgSY16kUULoqVQeq7ax8zeGyT4Fmu2CUe0A&oe=6A81906E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6uYzeAf5YMQ7kNvwGdcfk4&_nc_oc=AdogwdFwyG3BfpfVvcBg4WJy9jwZ5hcBj0KMa9_l4KcO_lS0TSR4qEj3xuEe2Y1E5zk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGV3exvLBsMDKF1EE8sirncP3hOlT57KdJL0vOMp3JMA&oe=6A81AEF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld8Xh5dL3ZIQ7kNvwFqIQ9c&_nc_oc=Adqx0YH53sXyTzojO5UaR1-vQifxue14m-r7e_3wT1nfGqVLe7W8mI42tulwsHOMnNQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXpe8Tk2F3J2HsNQvkytz3NfXXHeY2hs8VfuKmrNjluQ&oe=6A81B3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLpQbVRW6XcQ7kNvwFzKe3v&_nc_oc=AdoxPOwjFTy7hoXSNICl9aIc8cmcmu3FI_invptNHXTIoK0Zo6DZxva1qCcGSCcBySg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUFuJOyWVG1y90f057n4F-CyDZOMn0NYnOkT9TPoDCYg&oe=6A81C5FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvIe2IBuUs4Q7kNvwFc_jVN&_nc_oc=AdokXFspAL3uaYsxKJnbDJ3KI24h6Y4JuhAsvrURksrrLoe2IhAvkuAUX-YpsFZbDgE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIhqS4GDc_HKTROZ_Y-xbXKLmcBoRXc08wmPP19IGQzQ&oe=6A81BDC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
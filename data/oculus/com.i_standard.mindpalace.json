lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnjEx6Ssd2cQ7kNvwEOnUBq&_nc_oc=Ado5jM3Solyj_o5nndOTIT1gTQ5--m3NihXLkArMa76vKJH0Y3vIKlZCzo-FDCGNV48&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZLqYpQunUh8w30ctah6QL3EFdTV1WDpdQwTCN1NvguA&oe=6A32915A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JgooBlg-NwQ7kNvwGT66YF&_nc_oc=AdqIXwQmG1YVBqJLe1X1qLQvBHdwd_otCRbXLRFxLJwClKL_69wMepsA36r5JUfzbTo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PD-ArL24SqKonfdD4q8rDHqcDIZa9YYqpe6dEtnUH7Q&oe=6A32AC63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jJGNDDkxLQQ7kNvwFgbrHe&_nc_oc=AdpM57iHw-D6QK-G7LL7dZLicoe8r4-6K1yL9vhsZyuuuICfVCuXn-1ZJhR2JyPlqhg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i6oaxzgJHvDvtgn_i1EYo3sgzJi_pE3xC5MQVH5Db0g&oe=6A3299B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpTMmS363ykQ7kNvwHE8MwG&_nc_oc=Adr8o92y6wp6AXiAsRs09qSeOTIo56NLDMFSNEKQlyMDJVFYD2jQmpZZY7SPU-hMIlA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JhGyHlNRNPO1rmI76aEC4cZOvc5Ak-BMMMqapF7pYxg&oe=6A32AEAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L0vtowry5YQ7kNvwELhtEH&_nc_oc=AdpKnXyzW9_qlGE8-xckfL10XMqk7OgP1IfVEg738Vq_I8wIsuXKj1bmGLFBqVsEgjI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Ex_szeI70G5oKrbI_46G0dXZNCK6BPU_XNd5wlpcrQ&oe=6A3294F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KY72_ZTWgkQ7kNvwG1MDOU&_nc_oc=Adqc8AjYptNPMXlpR-UqHVnQlhI5DWUfsUPo3hGQSz-jpM_3R8-e6PBJmeAag3mV83E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af965QgefKZ28A1wcUFaNo1b7Lq97cQVNUbSsUCKj8G59Q&oe=6A3299A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfh6AF6RUqUQ7kNvwEacYvR&_nc_oc=AdrhnQrCHJAOWhk_0958sVk4u78HWjgV0rSxudckowjwOl-1wk9o0nw_Aty7YGoLeDE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_17Yo2QA7IoyxoV8kPwecpZ7gl7OFBpPnHoNvgFS2QTg&oe=6A32ABFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwy558KXwxoQ7kNvwEOdxUO&_nc_oc=Ado-pQybn3LCGxadjqAIWlpTu9u5YT2fMinuA9q1tfo1ka1TpOMu8waBIycRAj4ErOc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U58HRYylWCQNyZ8OA8MZiazDNDQiGAyvzSYWKkAIDqQ&oe=6A32A3C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2f_BDaxFREQ7kNvwEwjf7j&_nc_oc=AdoVKOfRmI0znYi5oRouovJf_CKS4SaH3E5ZxK4-PJ7BqcTtg6FrVnXLq0dPwgla23g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoQWbvWBqKoedyFoP3owIp4bXNUUcVtGUXqU4SDkl5Dw&oe=6A984D1A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbU3pQTWDiYQ7kNvwH1_M-k&_nc_oc=AdpoNQc9SILNWK-AEXY6i_LR2rWZg4bxAqveYNZhSUSkMkaZWnhA68HsBQk4Rqedqls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoFZEbgHt7yxmq7u5-T-PfxOU_o0jHBEGXYE76j-57jg&oe=6A986823"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsSyPgwNvXAQ7kNvwHfOeb8&_nc_oc=AdqgLV9QhWNOOx71RyiKtHLEOiP7cnOue_dxelHLlXfO4Mo9oNKQ_-P68JBRg8gNa2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYIEkW1lbixUZ9qLPVext2qwPV7enSWl-uFq2MBNKDdw&oe=6A985573"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxepyAvxjC0Q7kNvwEdJy91&_nc_oc=AdpoQeSCdDPe0fRa2uBQvsepw1G1SuYxpkakp255-bfZ5GsYtWxFfQOyWasSCMMiG5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaWN6zxrNHKsncjZbD47nYiY74kTgrWaXUucP7A3ntgQ&oe=6A986A6E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bql6eJMwh1sQ7kNvwGcHZMu&_nc_oc=AdpWYBBhjS6MsahaXHSv2QSu-yYH1i331ZO0FTKbTcQQ20SDhzyqy6Umaapw3IbGQJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3gqEiOuqwyuXXTMg1pL2_dBte2SGVPfFPsNPR3y38wA&oe=6A9850B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPi1lVMAvPQQ7kNvwG3VlbR&_nc_oc=Adojjs2Jajfn_NPux80_U2d9cAe1elANYBmQ7iIX11VlSyyvCUcWmx1YOoXj3dMcEuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW1Pt8krjg5skSjDqpOhw_xImla3oBnyNMUuQBP-dbMg&oe=6A985564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX3CT2l0GZcQ7kNvwFSUmRF&_nc_oc=AdoBN1psIqlxwqitANz2x140-gADEvqEtmWx4tJwJnWBgwVoqWZ5f-XDXfrDB0j9X2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqZtLDgIi7PYmSynAdngcWLhne9jHI2u6b2gf8IAd5pg&oe=6A9867BF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGTM1UstUawQ7kNvwHF-cM0&_nc_oc=AdqQJwdK0gpYsYgJCmC6Oeipz3LvFtx2dp--fHyLpLqnC9NT1fOkRRWwYEQa9OR7gco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxnf-vvYu97uO-_A9sDPysYO9ePLJXElTjScJEBbznlA&oe=6A985F87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
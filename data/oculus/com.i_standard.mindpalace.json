lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6624-9KeB4Q7kNvwFf02be&_nc_oc=Adol4VbIE62l_31uw3ebjahtjI17xRMO2TUvyRLl_csahqNjBp3pTci5AP5t74px-oE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMESy_AN-nntFAc_FTZiBd6db4pmeJ52nH-KAB9YFVYOw&oe=6ACE5A9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcAyAw0uP14Q7kNvwEIUBkQ&_nc_oc=Adrak70DHbjw8ixvbf4_UyoANt79MYxJ1VsJClfOdrlT3LneFzLBOzC_NfbtGYsaA8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONz-Y08WF1f6yBxrZcbAhpr_7DFYiICPKIHQaSPAuqQw&oe=6ACE3D63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IG0KE5ak5IQ7kNvwEwpPQ2&_nc_oc=Adqxnsn7ntKfalUTR5o2q4A5K9TmHlqjRCD-RU6bdRROLt8-0PKGlJVsJzqr1cAVzU8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOytuHTILJiTMyJxtw1dhysgQ-nOBOcYbm1jRwC3ZFRXg&oe=6ACE62F3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3meAyX7xmPcQ7kNvwF7R7XN&_nc_oc=Adqxts7Eu-sSrn_xy4PzKzf5g14Dz2xwViPWXUDoJOBsiYuAafeEbCc_X1mhQJC-bhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-5b25rRt5r0zMLR326NWQ-JLlVQ4IfT1QSkV9KljjOw&oe=6ACE3FAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60iSiSh6y18Q7kNvwHcE56h&_nc_oc=AdpxYVhYLOWsWPVMts36CidZuU6nZ53y7iVaDq_v0m6tCQ0N2rPyz88NwWffYOg8pPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAEjNrXn2Ohf5Dw-1PZnNtsJTiIg99aAvcXBVX6Uhspg&oe=6ACE5E39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agOHXsFKgJoQ7kNvwFKVpZs&_nc_oc=AdoVp4-tH_pSWk8fUOULuGvhuWFbW1Mp7RpfJ1V6_l4Xjq8ocLFh9gTsQoiWdKUyIXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk8GCcZA6rrRLH9ysBI6hREbJsMFFMo8F2oFa_aArwBQ&oe=6ACE62E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA6eQAjGkFgQ7kNvwEdXocy&_nc_oc=Adr3duINMXQM1zCYDx25tEZPTfg1p4_XwmAHr1VpfL0ZnEQUVC3vbeaNhB7Q2yusaew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSleB74hB6c2FFHvD54BYcbAIXAQRtmNIMwi_EzUJimQ&oe=6ACE3CFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soNSFLvXDzMQ7kNvwFWsEe4&_nc_oc=AdovLHSMCXaEocbiZ4ep0XYpvHqOzCnTXCdN2yC5_kVSiL_wtvPRTQee6R_B_LxVVzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCBP84dvV96TyoyTje_kCoOnngspXxd0Zr-l4GrchzpA&oe=6ACE34C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
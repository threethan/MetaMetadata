lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGwsU-m7Ee0Q7kNvwEEKBUX&_nc_oc=AdrMwMfj3s5WrQ3haDrQYqyiXUDZxRoj7RzABbqJF-8De1F3dYGVU7da-qJVKbw58iM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VNcgL2cR_5twt-K9DDIImYiFp3BW9bWZmI5sQWBINEw&oe=69DCDFDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1Vgq3vpRd8Q7kNvwG4G68g&_nc_oc=Adp0899Wnge1mKaMQthODxSV-XzTDPp_8E-RtVI7-aroyoxNnEtmL9QgFXJhnIo8SKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c1gMeqZQygv_kpllqxWoTIvi3idVKEMOvmoQPTaMCww&oe=69DCFAE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_zE0kNinzwQ7kNvwF6JKTC&_nc_oc=AdoiUdIBxzgbUwDElN664KTcNWsqDcFODIkZ6vG7KOBJaXb4oopZEP-mOZTgtBZSCWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wUlTdtxe4_87wjzjZLE5wqBq_JrommL-w7mWGrEiaGA&oe=69DCE833"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eZu-RZHojkQ7kNvwF6oFjx&_nc_oc=AdoWxgNEXNmuXlubP1aoy-77G0no1N0k_5mw6QVtxjE0UhUrR7vZv05HrqlfHhidyZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LEqiT73VrCUt-Vx6q2p6A9TAQorJZIvTn1Cv4LOgi4w&oe=69DCFD2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25yq7DNlmacQ7kNvwGyecVH&_nc_oc=AdrAVnALN-dHfNMqkRM1VxVlTDSW24DKrzdAUIdwFM1dOZigt70zWGyZ_CLWymb_bsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GWXMhvHJm2vd4ez9kPQbdOK354eGOy3fZq_bHdae8IQ&oe=69DCE379"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MU3KAXMXJC8Q7kNvwEd4s92&_nc_oc=AdrBvE8lr8Lq-VololnQiaAEJpqztMB9cE-QUAKDi6y9Nb9eda7VN2fuJSHSj8KQR4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HHvlQPPvtGCFnmNgZIN7NsqiS1RylZX0n07OKja8IRQ&oe=69DCE824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-M0UBeZzSsQ7kNvwEZsxBi&_nc_oc=AdrQaDLE5tH758rEof-gSpNZQzICwBvgAzyTL0kexMSg9fbVWUV3yvPBkjqxaZ4Jw6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Lyhgd30dwsAk6REPtuFq-KOijHYKsCGC9I4wFeAR4HA&oe=69DCFA7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5FM2K_RlEgQ7kNvwFE4U-8&_nc_oc=AdrRZseGgJ8H75KjDwpfCMr69_tHsgVqIvkoZLsW8ZU5qKq371He6N18pBb7HTbaykc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QUhLTMr-CYxSLhzNwcb47G-ox53Hpnp-GA0UXuvR7DA&oe=69DCF247"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
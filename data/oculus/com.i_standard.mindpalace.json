at=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xay84qRjMYsQ7kNvwFi4sBn&_nc_oc=AdqFSeiBHotKQ5NcLS5Vjl1Vat7XIfs9x8LIeHlOt_sHU9bQMu3VjU0r0yVZOU5hdBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cR8CIX3O1zSxi3y7-L8IBIBGKhtBmsT5KO7rkDrVUsQ&oe=6A357039"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYUkm9p1NJoQ7kNvwH5dhIU&_nc_oc=Adrc1a1Sg1Qbum2CcegBiw60eaxlM9sagc50KewwdWhz12BDKC9bT9BsSSaQbHjJFWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uNBcUBrTsMWDco3smKssAILoXokbLGpJnGnc0GC_w0Q&oe=6A3574E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVU0oKGC1mIQ7kNvwFpoFiq&_nc_oc=AdreSrfhS_NjOGSepTXyE5ftga2jFkg7Q01s2QMYrbE-U4DDSG_a7jrQnstwgLqjU4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hRIDJAmO8X1sfRTYr2Ivqy3RmKrduLVeKJxLfsLnb-g&oe=6A354EFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP6GJk4WOiAQ7kNvwFPs9G8&_nc_oc=Adqc5nUf_Yx0kmi_v-unuca60lvWylRkFPJwmXTATQZ86wN2YG9QygALKz2EIVDDalg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vVcO_bspJ_5p752ECIqUwT_B1HzKlZ4BMBpOB4fnHiQ&oe=6A3546C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
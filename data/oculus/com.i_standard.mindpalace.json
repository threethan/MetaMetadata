lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFT5CCyLePYQ7kNvwHt3IvI&_nc_oc=Adr7LegFioGaBuJjviaqN5xkzpmByKVeif7R8CtlFhpTUpKN3SC9ZZ770gGmhPbaOUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEVqBQdPJdZRMjLVtWd0qZlA9O2YveSYh4FAbwF3VXeg&oe=6ACA661A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RslZdt84csgQ7kNvwECdQFY&_nc_oc=AdqgL3R74QPgUsrdwcjHyS3FEXR9wGB46y1LHQIXgTb7uaWIIAI6lDyejWMFIH5X8y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUVAyAygftAtSUve008P-5pC_KAB8FAyrUTJJSB3jlxQ&oe=6ACA48E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKC3w6ilY-sQ7kNvwHHRUGJ&_nc_oc=AdofumACfghfA8sDzf5Rf4Z-lnz9k-R9ri3N9_dI0_9ZI3cbvf5N88-Cor_uFH9UN7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIjUhhRXrWTOmGFyMQzmP6hyy-WxJaITJ3eZRlT1618Q&oe=6ACA6E73"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi7tlnwIFpUQ7kNvwElxllG&_nc_oc=Adrvn45zPA3NBoUeuC9qkvWSULznwWkeZvz1-ht3nIQBV83_AqZeKGbQ2nurk4r-oW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOohEAWuOxxuXMsKieDxs1PyY-gSQv4fdICGGIRpBz3jg&oe=6ACA4B2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4_Z48o33y0Q7kNvwGM-mif&_nc_oc=AdoLEmHtka-Cuj6hCU1VDRmGoMIiVxvUTPXyN_V9E5YDWcNHfI3YlguDS8Vau6vSPy0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE-LuRlDiYRpyrRYTzz6mNRAyZlUeEGvoZy65r2L3dLA&oe=6ACA69B9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VHxQYbAugIQ7kNvwF4dE4C&_nc_oc=Adox2BtjjMoZhFyeRxrf4S8hqCd_DIiLwobzddxdHk3oP1UewNZkQ7EMDKgxlklYNEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_7IpuvK8S72A2fjAL7z8WSMbH5WzBC7ANIcDlUhi_4Q&oe=6ACA6E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEbxHsAMx5gQ7kNvwGm_g2V&_nc_oc=Adp8Rd5iZwFsLwVSFr3zsrFFvdgW5pNYEa6XVaiKoQN3G4lC3S68EAMYkt-B-WULfks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObOfX6Fxc9wLZbzAtlgO91_8u_oft7SI8XUcUL_L07zQ&oe=6ACA487F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELoc9CWCUGIQ7kNvwE1VpcO&_nc_oc=AdpcLt9HeZdxaSgem9zNrt32tP4eZbCuRTR5r6TqOJqbqXOWptjExiP2qDOlc3ukFCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODtzpPmGYwluyichjuhcLAPnJnjl6UQ48IV4zVp7KxrA&oe=6ACA7887"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
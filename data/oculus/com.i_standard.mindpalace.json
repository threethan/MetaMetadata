lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1TFFJHWJhIQ7kNvwGUK2yW&_nc_oc=AdrEYhraNX3Egqrw2Odo2OmF8hOR-zehlzc9otnK8_fxrtTouCuHlvp28lXcgdBH0bw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gKJMizZ5TnIHJakhQ4ONV22jmfvI2tXaUG3Zpbm5kOQ&oe=6A2E9CDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxi3J6NDBxgQ7kNvwG_BxFx&_nc_oc=AdpSdJ7mbR4M83d2JngLDKYyhR-uME9m7wZbSB93Ax7gpKy5YToj5agJz1j097pZKq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ep-RP9yGeC6SOot3nk5iDhM0ayFm7U0hGQ66luezjQA&oe=6A2EB7E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORw7oKyorBQQ7kNvwHVCUAh&_nc_oc=AdraSQu1rx0ayIHzC10a-9rMhkjndItHu0YxctNWFpnwOmVu-gjYove_xupCL4Fo_Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9hjJOZIvCC1oa6bJz6BdSp8m9Ll3Qoej-5AaIYsyHsg&oe=6A2EA533"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdHFl92Da8MQ7kNvwEvA91Z&_nc_oc=AdprqdXahh-9Gm5Vy3X0Ia_M5O4OWiPrQA5PDx6vnI31q9hxycyH2s-D91ENvVR9168&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SkAL7npLueBTKsz1fxpq550csUMHMwuM4XXChgEDSnw&oe=6A2EBA2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRozh4xqtkQQ7kNvwE5Zm4W&_nc_oc=Adoe-JOIsTY-H6GMEZPrQIJj8v6wSpFShXz0Pr12pFGL3vTvc22dOcHEqTZQNzssxn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pLickuD3NDkYlu_8ZZ21c8fi0cqOuPIQj_D9xaqj2Qw&oe=6A2EA079"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwENHLziglgQ7kNvwHlcJCR&_nc_oc=AdpYv3i3WZr6TEANVD70js2Znk6eXjd25v9fBaA7I97g_pnmC8ckTCdARZYeeNzzVTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K6CPaAcsBz4QYUWRtwvSam_9Gb1E0w_39cR7kSNXVTA&oe=6A2EA524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTbQ-PW55KoQ7kNvwHCuhos&_nc_oc=AdoqDJtfWJXFpsudpO_d0PDioluhbZVN17Q9pV1v4tD_iDsxxOR4nayvozuGAZaNpbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a5EispOdE44OUyMp5ltanqXyOmEuPuWdDOmJJ5ewStQ&oe=6A2EB77F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJizzr83dJoQ7kNvwGmVAu9&_nc_oc=AdpYw5cXy2IX_nWJ-7ZVN3ITaS2hvB-PRk3vIylbrTfMBi1nvmMjrLaxTT6sDy_ZsU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y6jzOUMa9eZhjedHQq_5x_G75VHwGBu1YZCMJTlc-tg&oe=6A2EAF47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
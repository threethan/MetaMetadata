lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLe9jZ_qDgQQ7kNvwH2xPBU&_nc_oc=Ado-9G6GT5iuzuIy2x4-wfY9-WDVbVeOTyIG_QKjppjOMEldOr7iFg64fJCPIwGxISU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rYLQykKRS0T0Yc3hu3b5ub_MSildFkSHLc7jUHz8B2g&oe=6A24491A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rcUwhL3LbMQ7kNvwEmwnzu&_nc_oc=AdpkNr89jv6IDT8KqgLlUNPrlXQB7i0Tsr1r_XeKelKtPw98czxYReNHlXDWRCu9SZQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W_9tIag9-UHbuDIveDUV1PY2WuebNhrMoo_Mp4xBorQ&oe=6A242BE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z14R9jPPJD4Q7kNvwHfDAgc&_nc_oc=AdrDpqVhv2cnFve-qew1ne09VaTgYxRgLpPViyIPGtc6Bm1lS5PHjfebffe09yvL7lA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QyVTgORmwJTHX06-cIVgTU8VsT609mNftKjstgJy0cg&oe=6A241933"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8envAlZwv78Q7kNvwGbmiNI&_nc_oc=Adr6uIcWTaWm5rTSHbjHM3N6g8dsHtoK3vN-jOSK3gnXFywpNFheVAa7lph5iwOODF0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W3eM0OMVNwD5eTxB34pYMxaG-VFL8j3NjXy0wu3HZNA&oe=6A242E2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzMwCYj43mUQ7kNvwHvaFMF&_nc_oc=AdoEqnVljQkiYirW5DwQ8zjJTkGTmS2g5wGEM_179gdEHTMTNqin53pfujM4Y7X1nGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-68953VNAU3qbxoabIE3TdlA_QZUNfLqgSW-y5y4BtGg&oe=6A241479"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81-i2p-jowYQ7kNvwESfAKG&_nc_oc=Adr_4yquFC1tx2vgQbQAmjI0PJ6v59VzLlUr9Ge9CnE93O4VEqt7qYN47JwmffIHKQI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1d8R9I4CxluF4IRt7aBdU3qN7t8BIuYHaWusvCb8eaQ&oe=6A241924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4P8kLPDAlsQ7kNvwH1fErJ&_nc_oc=AdoBmqNuHinp2ou-7tBhCBVttm_UswBeAFlECknbdEOIk334swYypPr9_jOHg8j0_Qk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fO45qEY7whs5x8GbaeP-O8GBT2b2Jwnp6xdGvwVtPpA&oe=6A242B7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2UrEJYlOikQ7kNvwGDd4Ij&_nc_oc=AdqVR_JOWYJ2RLNjYrYLmizdqbUPHFz1hzGrC0QQWAAC2XBbW4NARYoZnhxhS3KbkR0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fEGlZ3Voq4iY88EoDAtAgRHCAOyMwzz3v6njdJIFomA&oe=6A242347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bphuaM-fXFcQ7kNvwFnQEWV&_nc_oc=AdoxRVOciCFpkcf-8d_L_CL1eksjUYoL8fCses4gixTtBBUf6jSUeFOeRj1neISGWx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq7VoqGiTD47prVM539Ztl4jkIVYVsVVkVvWy6xkJb1Q&oe=69CFB0DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WhPozCub_YQ7kNvwF5P-Qw&_nc_oc=AdoPsybFMdtcUa0-kO9cfe8rnqKr2pyFxuAvHYjIEW-5rUrOPlsX5OSOGclCl032nzI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV-E4k3pHiocH8Mji5EfGS4Xw1lZ-9da_6EXmYARBChw&oe=69CFCBE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkkllziQCfoQ7kNvwEp86ji&_nc_oc=Adp2tV273zv1oUUerNYtYdBHg_FiYicdB4s4Rcvmvj-I605sWB_wytMNef4PbbBpg0Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGHyvD1hbSBVa4ZceFfcsWIfqaj4G02CKqVpqtdIJbug&oe=69CFB933"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsgGPu1C3HMQ7kNvwGK7eWw&_nc_oc=Adr8avMeYyge1kpNfA2VJ7kyyH2yxnKnoUZ-h31MlyotvWypULnT5hFunU_9erXb-n0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBQt1GYFOz14xt0uA7nZqZV7eHRIXk3UiZsLoo-XIAGg&oe=69CFCE2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO8ijeM-T2oQ7kNvwFgQNp5&_nc_oc=AdpT2ryUFXkWFdt1-23L1efJJYu2AWeDUBoJcZSH_59YlsZDvepnkXSamh6n1mfux-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_PsNnTeS9ug0SIwue-sFf3e6BXDVg8vUvDAgkbBLnsA&oe=69CFB479"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bTHFVMalUcQ7kNvwG2HRlj&_nc_oc=AdqSViLwd5MokEWAGPh-U7zJMuYiuK10LtL3xGy4DHcRMPHN6Ngi40X_0VERCT07e7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRFqFkpTIPjafHH3h86LyqdViz51nucFD_uAaPbtjTUQ&oe=69CFB924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htlCfJWLGvkQ7kNvwEewVHL&_nc_oc=AdoC2FqZDtZE-Qlwmi2lVUMvkavbDwtm19UUDHRWNEvRz7Y3r8-wxPTrPm3HngBp3Bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJcasQSjh4SioG4EhCiraZuWl_UgUCLf98ozjc8niUnQ&oe=69CFCB7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2RPhHmX91kQ7kNvwG_VEcR&_nc_oc=Adoe0JgYnH3gMkFhzFPdFchs1JKrUWdq5gboRsiYKoRU_5O0GDX3JFFyARaWy0JkjSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4cwjpwTRvmTG9IFFB2oSYLHuczvOa3_VNOcCpzVPutA&oe=69CFC347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
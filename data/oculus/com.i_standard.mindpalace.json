eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo7toZ82_DwQ7kNvwGYjwUn&_nc_oc=AdqF4XARjjJxVg4Ue-6HaKa4HGltYXmX2k_Z4xlj69npjZgHDecJ1o0Da7Is-GWQTXE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CPZf_gmLuDF31OVhkAhtKbJtRvGNxSJKeUk8Vta12Lg&oe=6A46901A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkNiIddBlksQ7kNvwGVNsOj&_nc_oc=AdrdjkyCVxLxjoK2ne2rT4rmB2Q43hTQi7bTeSy5bD_2pxSES-aplaYMty9uBLiWzAo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q4mGrVFC23mFc7OXrX7C1dU5MGZ5Qa_Flw_5I8O96-g&oe=6A4672E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjFbtwSrW0cQ7kNvwFKWWAw&_nc_oc=Adr6TsLjoJ4RGmrEUS0sPON7f1VzUO0Vkp7FOKkCVPGRUasZ-3GLX0WV2l8lUnkTbZU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FGGPi8ediLz8-wGHb94ATLY1W6qSg369f_pkku5BYaA&oe=6A466033"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usTtxPATstMQ7kNvwHSjvcG&_nc_oc=AdqI1NdnWFme5p1EG9Vu_GpDDs1te8UUgWXkR50J6RobCWFDd4FApzt0GxI4uHlJX38&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K_K09WL-fVPyhSGYFle7JRYnmNLttfYo0z6xpZuJ8vQ&oe=6A46752E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqfOM9NaTkUQ7kNvwG1Ldut&_nc_oc=AdpMsQAJLY5k5SMraD3bPGTxcczh7h45Ltq-MMDjT30Co_XrQ3c9zGhMx23jXiGD__I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qWTb-x0pXfN9iDqz6hjtmwabIpo6I2cvAg684Newngw&oe=6A465B79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGSXKHuB6vwQ7kNvwHUw03G&_nc_oc=AdpfKpkMezQdMNqPIn1tUfM8mIxmvrmv7HxeZioFG8RuK1Qz_0RaiTQ29WslPpqCN2s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jWwppXpjV2yLV21Xvu8Xir_mD4d4m2SFd4k4UWTB-Lg&oe=6A466024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjNW_7zyIhEQ7kNvwGsmplk&_nc_oc=Adqt5GfOCvTqF6_u4VAINsumZgjVy2VqUkbYWGxnHMBaT_YXSyA1Ex9Qz3cVeP50Lmo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VbKbcvYgKYAEiDDX_xbyEoe-OlrAyLEvthbXcOFwd6Q&oe=6A46727F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RDLs16uRVEQ7kNvwG2JcHj&_nc_oc=Adp9lxHRDN2PReAfPY56IAH3nBMHxc3HOX9wCsRtx9EewdCfIHrf7EmJKwfzWFC3oMU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iY_PdQ6ZhnqiG4Zjrg82KUQ0KSbQZ-Q4LTJfVF_BfVQ&oe=6A466A47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
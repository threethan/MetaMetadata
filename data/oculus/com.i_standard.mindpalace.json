lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaHgWhLB1cQQ7kNvwF0ErCM&_nc_oc=AdoJd3bvrgWJYyifrPnWeLNVqCIXKZ-StBgO0I8AdxoKyHg8QBA6de9IzbKnX-nU5F8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMrRqHOzInW8HSU9ma92HyxJKotp5KzRIf-36eakN5UA&oe=6AF88A9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PdMUy0JujEQ7kNvwHaqnWP&_nc_oc=Adot6_sUSeypdLz_D2J4giwaKLVnpcHi3bC2JE8op3DAtLznbTqUTw4FvLGOM2ysm_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBTHNavRiq0zOnZ5Atg124thjMqVlRQtdk8yzO_UUVAA&oe=6AF8A5A3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC5YNqYWZe8Q7kNvwGJaCP9&_nc_oc=Adogz14tygXjw4tSCLAW3pw2JZRg_cIvb9IvmTqwUxsnqbT_WjlFsvUD1B6xcEmarkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-lNyRAUE7B3DFOGE-BJbljmnP0ZtJTNx6TvjyRiT9rg&oe=6AF892F3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34ZK8zGRJHoQ7kNvwF16VY6&_nc_oc=AdrvOEXzKOARLZXSFlSuTuZcKBjASujZv-xzV4QB48ji2UVXInxxF1yNrj6tE7Q40Bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThch12HgnwIxULK5y2Gx9atOaJuFaU_-tkSK9mnWMmWQ&oe=6AF8A7EE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fI4Ktt2fEUQ7kNvwESI_pD&_nc_oc=AdonBJkFLNteAnmAK3oAnpfdaxFIt6iTnGvrxfKoebRCBK2ABGVuhxrbTV7ar-X2D0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNGTosWT6aThEfujYFDx23IcZuODvOag3SMgUgevNXpg&oe=6AF88E39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqO8ANa67GEQ7kNvwGfjmz8&_nc_oc=Adp1oxnYvgiKiLbbZo4fX8hpK6Fte4Wg1qfh7Jei2QjNR2QfE8fl-k4-Q_lqATCHYuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVqAol3jMpP6Tpqvnx0uW5KWEvwH9lXb5kGXrdc6iqDw&oe=6AF892E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUsCWGDpfBIQ7kNvwHvdP5h&_nc_oc=Adqn0hoc2zgKvgSUJNTeFIb9KJjrTtrFZBIVN59NCE6bcz9cVdzMewpsZNlrmnsm9M4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSglP3Df-8f_4sP_4P5GD8pprvWDJpb7N1Wv-8XN0Sa8w&oe=6AF8A53F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2vpfZR0bZoQ7kNvwGSw5mW&_nc_oc=AdpvQR0mWJr53JLqZxlpsDslZhiMwW0L13omWzPYsRSb_S11DzNizz237vDWSVpQta4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe5pdnlKSOdOyavCRPkYM6uYgq5pPQIhbEa2bOxwtbnw&oe=6AF89D07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
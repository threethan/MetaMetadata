lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bphuaM-fXFcQ7kNvwE5OBo-&_nc_oc=AdoOcBHeIwlXfJfsBxhVFMKDjJP9Lswi9Hhum-vi9QHZo_SQrgNfTxrNX5pZyoZ7wjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_8upuYN2KJELiUWpwuHeKF2dMdyhInbXHUqezVvT1TQ&oe=69CE5F5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WhPozCub_YQ7kNvwF8l8Pd&_nc_oc=AdoDZr6kVc1bqoIvWBDjXLgy6T1ufpZ4pSCv1ntOdEmpZ7FVi-4w84mV3pmvtnHwQjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6GBcksVIBBhsYGycgkedCkv6A9M4pA9S8vHxA77Mo_g&oe=69CE7A63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkkllziQCfoQ7kNvwGWpRlA&_nc_oc=Adq66iBQhzVtlKADuTWZa6KgOpcAxu4StqErHPlO4mPJelFzu6UDoqTFtkxqoWO_Yhc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhrWaxknZLhSkDQWC9ojqv9YU77p_epe9-duh4hcF6LA&oe=69CE67B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsgGPu1C3HMQ7kNvwFI7oQE&_nc_oc=AdoYsZZ9hkb_S-ppcrEjyk5-uaIBJ7opDD-cVGDAj7zhQ2_Luy00J0bTeHTtGC9iFDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNfYnVnBJhduLemdZUNt-Sop_X5stIn9fy8EL1MDGPkA&oe=69CE7CAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO8ijeM-T2oQ7kNvwHxgOqb&_nc_oc=AdoVNKxbv6hiIZP73Sf-BkhuWiT3UNGaFMgP8oodzuJKXoRDHuGWtL8NA--hlgK1XV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5RwFRCFCJYa4Ks25l3i0J7uGLcRN6TyVy0b2wgiCjDQ&oe=69CE62F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bTHFVMalUcQ7kNvwHJ54Sv&_nc_oc=AdrT2lgGwj0VTxNW35VMkuAk1ONdVihNEKfupM6QLSuR05e1fBb3y69TSpBAE7Gisho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykLOuSEOBEmhsaeJY-jg2tCVESait-cEnl5uoLrGkyxQ&oe=69CE67A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htlCfJWLGvkQ7kNvwFbkyds&_nc_oc=AdqUATx2I8SF47Z544yyfI_aLj1qrBp0prOeQlH1B5lD6xEYJ41WNcbAtChsgecbc44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsfqzVi_dnfPORQ-AJGhB8q3Nb7NvZa2AELUoWb30M6w&oe=69CE79FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2RPhHmX91kQ7kNvwH5Nep1&_nc_oc=AdpIcj80WHpqpkL7R4p22TkpqdGu3aUPssyOPiPIPXMF29J392qJl6juLxwGQ0-iRQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH86XK4_3EHSHZZ0TGKFRt4eOErLYYrnJBQpJoCIURuA&oe=69CE71C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
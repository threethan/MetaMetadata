lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYzVFtcmbDoQ7kNvwG1cc5t&_nc_oc=AdpFh2drmot7bFn4I9bgv9ITVCR-Qjp_-NUvzQbl-ygttsbOq2C4L2U9c8WNT8TDwGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxwIoU58QOrr8f61iDlRJezWJMRmUeZzEuOfLypVRxEw&oe=6A9C419A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXq6C2vf2dcQ7kNvwGrihiU&_nc_oc=AdqCTQhFaOvPok1pvFM6O6EgqaeJodyg2Hj5gBSd3m4vIe8C9-DGibwpzqwv5hKPiT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcx-0a--J3W220RIdsteyvhGXJCp60j9auw7FGKsmsGA&oe=6A9C2463"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOHDXG2vo3oQ7kNvwHRDMjI&_nc_oc=Adq1DzEa_eDc11h8ebhVYZW4uKnRDgSpi4NpvFh9p_XEy2C2T-gTxxpkirNrMGNweXk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAv96ADJsUPCeNdVE6L7Y13R73cb_2fTXROMXynY4LIw&oe=6A9C11B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBZb_7twnsYQ7kNvwGwlHmt&_nc_oc=AdpYr9V1ZtH52uaHl3R3UuekTjRBST86-BfAU9EG1MsUupZRdN6-XFvD0rP3VnPIumA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOi6RdDSnWK57-9dbmYidwqE6vfO8dMw-LT8TU8fC4Rw&oe=6A9C26AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2phYFUOhplIQ7kNvwHNHxrf&_nc_oc=Adq4IeRn7QRoo3ULSJVcJy6H065-BA96orVQFa8NHORJ7wRT3kK8tj9XT_Tki34O1TY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPQobAZelRFt3SsH3M_kIrh64N9lU0kGGDhzsg7112Ng&oe=6A9C0CF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTISQKSS47IQ7kNvwEBiOt5&_nc_oc=AdqVdfNtw27eZcuFcspwVNluCVoSmAf_lve8aQmLB82MOA_vgIIki86HZPUqxx_qKSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqTTF5z9vMViIn57yEyFfyaDVTlRfR5SsJqtmF5dPCAg&oe=6A9C11A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6vOKPrDNpYQ7kNvwHyuQvP&_nc_oc=Adpnsz_Oav8hX8B-4E3QGVQHi7iLQxdL2N99NhKpf3KSSx8zoXkVowPsCamEpLtnFkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaLikSCPVA0_BWKPFL_2FuAkONuN5NQENwnURAzGp_WA&oe=6A9C23FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU-dr6OFinwQ7kNvwH2jUtR&_nc_oc=Adp48lwTW_mtZVjdJohclLShqETFr-2mEMOg_6STku91ztywOxf35Mq6Ovhxz-_EJRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdEw6fxrGSQTW67Q__xNQ5CRf7PzXvqXPkzAXAnyOG3g&oe=6A9C1BC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
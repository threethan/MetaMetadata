lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6CcRD5QZ1sQ7kNvwFD2owM&_nc_oc=AdqhciPdkRoXNcYTGzC8YxQJV63Mg3Rv8cXPR_EBW8TMp1_Xadx6xH3wAPW_7QuteBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1D5sf3zSNVGqssVooT-a7QQOUhEBPcTRBKW16R1-k8Q&oe=6A95E25A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZVH_tmM-58Q7kNvwElSZtg&_nc_oc=AdpwDXcByjnwpbCGmIRweV5RkZSo6t_I7qPCJn4NBez26r3WmLDa0CVK8k5LxGAzlNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3-w9zw16OcN69X46Np9BM3fXTvUzmldLpTa9NNRcdDQ&oe=6A95C523"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr8BvmgUzAwQ7kNvwGrHol2&_nc_oc=Adrb9INT0U28rkdxYthJRTycR5Bu-2tpxPmS9A7mqhxbIKZqWFj2QsNc75bjF5ZwFHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6oALVYY1ctMxPvMwqa4Lr0FAvTYbdb9sUxkY1iMEDRg&oe=6A95B273"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxepyAvxjC0Q7kNvwETw5b2&_nc_oc=AdqCoMe7LKSQGGCeF7TM79qE6lQwuTmh95j9l0Y1C4r80hyNQ8VuOiY3tvZebQ1V4tY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxB4-af9mxjD_PplVzD4t0L0Tc6GiXsEFiN6euwvlhCA&oe=6A95C76E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTpJqgVYb0sQ7kNvwHdzwat&_nc_oc=Adqd1U4Gwvfvx-_HX_KDGQpa0VaFh8JuWorD4AwUP5grmg_5dk9OVjlHNnQAKI7NgSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsD_yvxVzcoAcmRt_rxLCcSwYh4FRSmGOb25IB0ng4CQ&oe=6A95E5F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPi1lVMAvPQQ7kNvwEKbfCz&_nc_oc=Ado28DK0UYV8E1PT3hkx8bdpj7hD48wnJEd4rY4pOa_-4cZRtmf07WjTCd7zeLdzKmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu71ml3R6NiHccGlJ6kCOAwDRohlYHaa9BBhsFgE-L5Q&oe=6A95B264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX3CT2l0GZcQ7kNvwFeaBGB&_nc_oc=AdpsIloMo4hD-ETXobeOTkv6htnYLW4IxUhn2IErg0enYJh-Lx_-E3nldjlLLBAGknE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCh2e2CebWFZv8pmXKDCKJnbsQN0b-XT97fsm_TDzSDg&oe=6A95C4BF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6tBr9eu0A8Q7kNvwGhP_pI&_nc_oc=AdqVJrxUx4cqsMs308zJUt1O5vCKO6oD4hqHSgNbbO7jJxb_bijRR3wKS9h0lDPZrl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ILfnlKhWmQK0O9U80IFRyCzF_Q9vGHkzD_EHseEaJg&oe=6A95BC87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
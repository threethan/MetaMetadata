lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6jrtQ314jAQ7kNvwGuB5R6&_nc_oc=Adq6LQfgdaRYKmeQbZP9e9-Y9ma0lHRQGhq4wO_xqoPWoTi8_KFgX976LO4_-urWpQU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucOhlfvSxbhZmdOq4G262OHb1fcr7FT1gzzHV7tsibQ&oe=6A0C55DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BzPP05p05IQ7kNvwG2SzII&_nc_oc=Adrvz0Lqo0AfjEO4Qrm0Hfnk6Oj7YG4ZlK7Fgfxl_sW_-j6sc7SdxoBEka1jjTzXK8Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LVdwUOSUgZYtkSO3EtVLhX7kldD4m-QCQKfsAjg4EmA&oe=6A0C70E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0aTG0IeiA0Q7kNvwFoeMhf&_nc_oc=AdqZW6uupp7fNGD_dz2pUk-ZdVyHbXMtIc3DB_P_BECk3cSpg_egaOmrKuzp5obuRKc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xbXScOCJ1WMqfIQTj6fjtQN-T0BdUml2PP7kurif5FQ&oe=6A0C5E33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtYSC8ZLcRIQ7kNvwHNCyQ3&_nc_oc=AdrWoDHZtfjml7YbXIoKRqhmn5uGL9hRc2C0rY5-dmAQ4TWpceHwCPykRYEuya0AaXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64HR1YMgHoecGHHA4L_c3dV-2hL7gWbBlMI2HjuWNR-w&oe=6A0C732E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjCznD0nZYgQ7kNvwELOtXL&_nc_oc=Adq4ytUIUrrReq3QYz7ddoK0lqpotjnSO7ps8jId3Vuasl2UX8fJDF_uJaKL2cZ5hIc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60BSLA92NBTtxXRGJ71KRa6Ta28VAxjLCJPacU2kvk2g&oe=6A0C5979"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZhoCrVthrgQ7kNvwECbmv7&_nc_oc=AdpJFB6QPltGXJsy5B0MGSlGM6uspt9T6aO9vONT4Wzy0nXp77pbVpVseILOq2jjM5I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zKt3vN8wglsibYC98uz2loEm097vH-N3XEN0v50Heuw&oe=6A0C5E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch0YYLP-lCQQ7kNvwGNM1Kb&_nc_oc=Adq8WQkhE3y3b222ua3cxkXwcynR6F6V7hyuE44dkd_RSJzEk4-YKQBgdy9pKituVCU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m51HcEkcdsDWQpFreerYofVwVEbIHESugVERtI75tfw&oe=6A0C707F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QngwkgTcqJUQ7kNvwHnlTc5&_nc_oc=AdrZBClHrUl6IBaCjEcqlv5kwZPWi-jhjLhG-Q-p-1UzfmS6CuOQhAFNkMSP9LRDMTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wx07iYMj71-Zixn5gSYUJHUQgRqIpq_Fn9_Mz9T-39g&oe=6A0C6847"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
eLogo_Text_Black.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq9GufqqMm0Q7kNvwHw7ZL2&_nc_oc=AdonU8u4ADwBoDxsePT1BaVT88g9Pw3ZnWIFgHUVX9YU_3UttF-fJ5eRCsruJhmHASs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_laN1a-QrjNfKOQjojDhMbDTM7ah0aH3h_vOMYwRAOg&oe=6A39611A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHuj8LZmVoUQ7kNvwGG0fDH&_nc_oc=AdqKxrC74Oy6_b0G4CO0jslpz_B0sc1dsl1lvxojdLFz0ZbBWvQd0bMOFtoj3PgSzrE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85OPls-_wZzDfCuots5K7XNjduiSJocExiLAJTPVrMyQ&oe=6A3943E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rcB4icnlNcQ7kNvwFAeFQ_&_nc_oc=AdpwmTP6jM8Jmlf7MJw-vuSs_4WT096KD-T8LCxFtUntY68GvIiMZS6m0WA0MzgNSzQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5v5yY6KpG067EEWpIPsB4y-pnHrk_GshY5Vx84ELIxQ&oe=6A393133"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN_2aY1K174Q7kNvwEMSe92&_nc_oc=Adpho_GTGxEAXSIy5FXSOV1bVixnrVawcGDkhdsT-r_MA4MMwjhO30XCk59m5Ms2CEM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z_EGC9yYmQa_YQpv4h5W6yLqFvT2XFhOUFX1wnUpDPQ&oe=6A39462E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKc6fzTmwLEQ7kNvwFL8DoT&_nc_oc=AdoYsAGJcA-vS8qx9NLOg7Tbwjj7jkPfCzYiZaXW1TUQqh-dOtdRLlj1ZiqI313ox58&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aIZQoBR-LZN_LTsVwfEvxuKjqbPaiiNEMKEF0okytPA&oe=6A392C79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fmNWc5nFMMQ7kNvwHJBHtT&_nc_oc=AdpgLmKpFGjZYGJGRV1Dsu3uGLYnt1s6PNDDe1LA-v_JB25ABOQEyfj0fhvk299Gq0c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w1J33EiYAzvDl9Iy7x8cRhw5zPrVZEWODns-g1zGRMw&oe=6A393124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUvvLQXU8FMQ7kNvwEkKRTd&_nc_oc=AdrdYazawbZNjRqYecpYmxlFU-hubG6rupcNCJEionhCiAoC22DQDMuNPQsure-ZTjE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vbp3O8AVIg4SAInE08zmSPloHGXNNWU24JGjqAg5Y7Q&oe=6A39437F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDcazdpinJsQ7kNvwERqq-5&_nc_oc=AdoygY2RwknpzX1YyJhLf3GPilyzFf619eSeiqlkRKhMDPCwurreT_RsdTb5aedch_E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eO9baaYDfm7dfXf356FF1FQQ69KXFx-l4lfap0eJ4uA&oe=6A393B47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "co
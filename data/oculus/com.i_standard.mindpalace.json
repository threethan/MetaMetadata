lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0euMVou6sYQ7kNvwHQhOGc&_nc_oc=AdqAClkoAGy0wNa4tmX06qVIcQCaLS7qn3WWGGxh7MLZitiFHTh6CMn0LEAAxQo93dY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-o_ldrtYkLBhwnV3OeZTT0Q08JgBZWY4D7bQ-IhJt8A&oe=6A8842DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHc7LLdVwCoQ7kNvwHBA2fs&_nc_oc=AdrjtmDDlnR2dbviM-dGi5hCP5YnpN7d72ikJVZCcUeU6p2h2SE5deA8tV0M-Bzq8c8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9rtnsNFMTLDl_9CbK3BZuLg87s6_0GmeWe3m8K9iwfg&oe=6A8825A3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaCStzgg_dMQ7kNvwFj2B1O&_nc_oc=AdqI8ELBSKhBQUJG1O1PFPlzg3hJ42FruAoQ36mqA-kLzLZU_HmabbljUdJbNB1BQR0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJS1BwrGtmuvl32_PqoBPBiezMsnhAKgc73cHlfvrQ4g&oe=6A884B33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWJ74VS4p8kQ7kNvwFKitOf&_nc_oc=AdpvzQcIZc9hRmxmoLRSsrVN8Ce4MLahuWmDql-5BXGczm8omRE1iYgTWuj366GE2mY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdoxlyp0qvA7vXBvpTnKPR2Wh8KZfaatjI3EBfLlY8Fw&oe=6A8827EE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeyi2l_oyZ8Q7kNvwGv1Pq1&_nc_oc=Adr6VJfmgqJlTYd_UNqjuzeKfcz8UveqNf4QQArWG-NmN6RnQq_S0m8s8xmZyRyrwQc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb8qTImOECiZtaP_iS7Ze3FBJ2wn2AcsK61N2bjWlPgA&oe=6A884679"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FlbSDeUxf0Q7kNvwEr4q-b&_nc_oc=AdqiZ-s4WrrPY-X80MjZpCCegVeTtapIKuFUCR6oyoLF9H7nnrz64NoQinXIp3IqqYI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHN_SQPRxr1RUmqsVRAg8OQfM2w5IwPcvxsGHR1tLI0w&oe=6A884B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxx_4z7nZNIQ7kNvwFDtDnn&_nc_oc=AdpqVLVvHRaIk-Yhz2J4adjXHUGrkytX_CN6DztpIZENvqNd-KncNQysNUD4stA9Z-4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrzFHw2UjdJ0827_x0lChU1nv1ibvO3jeqBCr8zj0qqw&oe=6A88253F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQeJoAt-Ee8Q7kNvwFKLedx&_nc_oc=AdpsKCv40GZntH32KBEo_cnQTj2sAZ6T2kZsH8mPqQH66xKjJOyBjVuotbUW4hsmhuk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3lZacwyJwENGjPfPBfs0PhK7kO4M6aop3RxD1BN8nhA&oe=6A881D07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
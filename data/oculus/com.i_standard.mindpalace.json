lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbjFzhYoN2QQ7kNvwFWx9NO&_nc_oc=Adru1DQWNNXYM8dq71c6gbflrSEzO7jQPnN3DrfjNHdMK9-fTOwTGwAJHF0H2spfzYA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwuz3agdksziFOdSFpd3u9YnO0HbV6QE5BtleNwJpcn8g&oe=69C524DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JCd4kFF-ZgQ7kNvwEMaYYv&_nc_oc=Adrji2Sv5tK4oFJKkd12Zxhs1fBiNsuVn8yeln9Dp12BxCORNvbjs6gRFVKQIjeOYBg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoXx7-cYI4Td615KO0NkGHmfcUZnG5z2HaCkpfu3wioA&oe=69C53FE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eVXFFJMJfMQ7kNvwEZjwZe&_nc_oc=AdqI4cwD9mwxT5w4LyqgRXgRhYcIx-41pop4rwRIe7ArZDchbpp5fsnpVqx2N5dlgcw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTD6Crhi1jNs6-anqK2FYWCu8K7kcqansCAzivJ8x29A&oe=69C52D33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10fZXx_9kz8Q7kNvwEkgcu5&_nc_oc=AdrjowFB5pDEgGIZTkT0O51w4w8fmrsfGWe7cvSQdjx4vh8afWJtpYG-F9-tEM8NT7Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9HBcQ7l1vbQQLH-XfyguI4NOo5APNO7BDmmMv-66-EA&oe=69C5422E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1q4eSwwDMIQ7kNvwGCwyQ4&_nc_oc=AdqHPV2k8bWcpVLrCdkrp6RFWg9UEGWaWgwdXb80p7Wwz9JgqM7p219ptej_TF5lHgo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOqOjHeY-rmAMMNBEjCu1gqRrUcUFKC2PlklMLV1bmFg&oe=69C52879"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aSrX5LOwI4Q7kNvwEDpH_a&_nc_oc=AdoYWi57WMzYi12u0q0XTimMsE6RtK9cCiH-FVBa7mwxRqZPa3hcyiG2AzdL5J6l0Q0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzvys8zkcS7ULGTsF8HtPmjHaZn3Q_HGfK76TcP4gBmWQ&oe=69C52D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RFXfnaLESEQ7kNvwEhD_4E&_nc_oc=AdpaN5qXnrkSRWbhvJ7CgRyW7ZlBVVzeVpMrEAulj8uNuZ7CP0O3oNjccG64uOwKBY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYCvi_3eAbzvLVHVqOelVGmL3L8YevgVjbriQMw-TPGQ&oe=69C53F7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usvu63I3E7kQ7kNvwFSiePB&_nc_oc=Adr-0_pEFOd9o3N8V4zNp4_6SA-pXqP4IXPBOzH_pNUjVaU6aFyt6ByPHtNkWIYpvrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFIG2eIUxTtzn6SJB9oQWmE3eCY0WZFHBx6KpSSXJ_og&oe=69C53747"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
84\u306a\u74b0\u5883\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\n\n\u3053\u3061\u3089\u306e\u30a2\u30d7\u30ea\u306f\u4ee5\u4e0b\u306e\u7279\u5fb4\u3092\u6301\u3061\u307e\u3059\u3002\n\n3\u6b21\u5143\u7a7a\u9593\u3067\u3001\u30de\u30a4\u30f3\u30c9\u30de\u30c3\u30d7\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u601d\u8003\u3092\u8996\u899a\u7684\u306b\u6574\u7406\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u8272/\u5f62/\u30b5\u30a4\u30ba\u3092\u81ea\u7531\u306b\u5909\u66f4\u3067\u304d\u307e\u3059\u3002\n\u30de\u30a4\u30f3\u30c9\u30de\u30c3\u30d7\u4e0a\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u540c\u58eb\u3092\u3064\u306a\u3050\u7dda\u306b\u306f\u3001\u30c6\u30ad\u30b9\u30c8\u3092\u8ffd\u52a0\u3057\u3066\u95a2\u9023\u60c5\u5831\u3092\u8ffd\u52a0\u3059\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3059\u3002\n\n\u3055\u3089\u306b\u3001\u30eb\u30fc\u30e0\u3054\u3068\u306b\u88c5\u98fe\u54c1\u3092\u8a2d\u7f6e\u3067\u304d\u307e\u3059\u3002\n\u3044\u304f\u3064\u304b\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u304b\u3089\u9078\u3076\u3053\u3068\u304c\u3067\u304d\u3001\u88c5\u98fe\u54c1\u306b\u767b\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3059\u3002\n\n\u30de\u30a4\u30f3\u30c9\u30de\u30c3\u30d7\u3092\u8a2d\u7f6e\u3057\u305f\u308a\u3001\u8996\u70b9\u3092\u5909\u3048\u305f\u308a\u3001\u30eb\u30fc\u30e0\u5185\u3092\u79fb\u52d5\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u601d\u8003\u3092\u307e\u3068\u3081\u308b\u305f\u3081\u306e\u6642\u9593\u3092\u6301\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\nMindPalace\u306f\u3001\u30b2\u30fc\u30e0\u611f\u899a\u3067\u64cd\u4f5c\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u4f7f\u3044\u59cb\u3081\u308b\u306e\u3082\u7c21\u5358\u3067\u3059\u3002\n\u76f4\u611f\u7684\u306a\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u3068\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u64cd\u4f5c\u6027\u3067\u3001\u3042\u306a\u305f\u306e\u601d\u8003\u3092\u52b9\u679c\u7684\u306b\u6574\u7406\u3067\u304d\u307
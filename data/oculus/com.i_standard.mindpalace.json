lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwQebYyww10Q7kNvwFrueiK&_nc_oc=AdodiRUsghz_1EfrhmSJV1jZnQSMP4YvN-kKo6qB5v-cEJB1DcFBGMc2FNDI5DfHsz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2umD-p4EOZ9nYbjyvyhyPBWcZZo-d_3byxfP4ZACGUzQ&oe=69ECB1DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyeiTtNavg8Q7kNvwFu4-LZ&_nc_oc=AdpixLpy2kyqBpjhHtdJ8j_oNpRLb3qn6QjgfJrogwYneoL7cJq08ynk7-w2hrqAeKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h2CFdg3wvV4SG8Z46o0mkdYj9kIhasMVypWx9Q0KvFQ&oe=69ECCCE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GbBh22-_C4Q7kNvwGojHw2&_nc_oc=AdpbhZ9_Woa5rW5fcVUQI4KNaaij4iL5v18mNXJ4gTTdceTwFQYhofJFyuzsUgJdGRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-tcd8JjXr2ZkdPXpVdfHw15p7VHFadqa4bRq8RKp8wg&oe=69ECBA33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G8h7HjjolwQ7kNvwFAdmVN&_nc_oc=AdrCCS3xjGNyVyofghNoWYUFWKj8pdpOH23QRgGjhMVFqpELFr5YS5iIyhgbtAeyaOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XU-j2PSzlB7H31HF6K_1_MGaFLmsII34_PdcuXeZpWQ&oe=69ECCF2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH5fjmMsUp8Q7kNvwHhb784&_nc_oc=AdohxA-tnKFFkllEMKShHQx6dN_q4If16Cop6-sYWwCkTlmdUsyNprXl_exU-ONlIq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UR2MoNSMjd3lTshYLJIr4hJEPP4IWbWHvGV-qnDcIZA&oe=69ECB579"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh-SEyf461kQ7kNvwEWueez&_nc_oc=AdqPyPPFkQAO18VtAf1B4jC5Fpjw4fs28cbVoasM6LqMFRbTLArlxr-f5NCMVHUkVh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TfoTXg73TavGmqv-Y6Bu9TSr_5pN-UpoRsb2fh2H8Lw&oe=69ECBA24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OvvduBFXpoQ7kNvwHX8zRP&_nc_oc=Adp-X0hyPD_V4cWZf7-smrQtPAm74yjo6ejiI0w9O_Y-jXfVynQn6uijB9Kt5uZ3TLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s-0zQjQrZGEf6yRU4TDKUqXmIrWmlQiYpJK3C_NPiBw&oe=69ECCC7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkPYdYzztUEQ7kNvwF8NUKm&_nc_oc=Ado-PbMuVtpivdwgBTIfXPxePyookRt0BB9eRoR7VeHprmr1zGG0tqcf03YmhJjQ1Eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cWz5FXVCBMZhGzsj-FohdOJ9YC8FXKa-nWmXn1Q2OPw&oe=69ECC447"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
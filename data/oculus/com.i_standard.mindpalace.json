lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS1HfUE-DO4Q7kNvwFD_Pue&_nc_oc=Adr2kt-EOgAbOoSxEknSPq_Ff5kfIhEAnfzDd1-1D8NBZUMKOAXfT9mUcONamADAedE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wVTrVSLnmaoGthyyvpSSVY0nHpCihCM1Xjrd9uDqMcQ&oe=6A259A9A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rcUwhL3LbMQ7kNvwEfjgPA&_nc_oc=AdqECDlNtWZyakiKmoTQb7D-WQPp-o7UaMFieF0OAEWJWKNvDqU0KMnJTUOuEkT1ZJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94WfAzdZQT2u7l-AqP24RTBwpwC3GHKmu0drYjnA2xYQ&oe=6A257D63"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1L7h90KiagQ7kNvwHjR9Iw&_nc_oc=AdoCfsQyAyhqrs_-8Di38nOUAnDF55liF0gRdIiVbSrmRxCkn28OUYtxzOVvtpJfv48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-kkyKz8VaWLtg2f4bBNQmXdmQzcU16mFN2Du8eri6fw&oe=6A25A2F3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8envAlZwv78Q7kNvwG9CFAM&_nc_oc=Adq6kY84_SqpNjLvueiaXokMOKNgEcmGpO2tkE-td0QSYB9qPVr-QTFcs4ynYCeuvL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yvTSHra1DWWMjTu2VKTcwnEp2Ftp6ZT8mQvPYeP7JJg&oe=6A257FAE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzMwCYj43mUQ7kNvwHnzwOt&_nc_oc=AdqUbdgLHZR_DbiOI-w7UXf5GS0PCSzlr-v4jJkuJr4Uq-duYK-RRM_jc2o8P-SlG78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SsR-RFBNcg63Y11sGfA7EkYsTWTKeXAhNnlfUuQ6vmQ&oe=6A259E39"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81-i2p-jowYQ7kNvwFoWwJP&_nc_oc=AdqRvuKejwBxNnN2kyHiQxV4CIVn_YO5Eo-q_EJjtM1ZncZjTUykCmN3vTisrVhsol0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KjGtebUnfcuvU2166pXwBGPuIwcJ44VFvx680fFkfOg&oe=6A25A2E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4P8kLPDAlsQ7kNvwFJth1l&_nc_oc=AdoOOkGW1TgaDrsJFe-_rj2jWdNuqZD-gkBx6tcaaOQQyjkMnCalZCZWSZRRpSIkPCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GlOG-nQPWGLRSpqFyhhf_5NH5e9-DcmJhokLXNtNm9A&oe=6A257CFF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQopJ0zCjMgQ7kNvwGiryza&_nc_oc=Adpfg_FeuHMIaELnO7V5tO5RgAqCFbX8rlqiVKuJe_jaA3WAWH0XpEEAPcqDp54LbLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_mQMEeHRQrQT3-lV2txIPOzFnTUNo5YzJxTxwzeWD9g&oe=6A2574C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
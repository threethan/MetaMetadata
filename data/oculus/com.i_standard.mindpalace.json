lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AVKBQluTNEQ7kNvwH319Z7&_nc_oc=Adqq3D48gB59hTcb4wjTfM1vDvjPtZ9GUeC3hvIULTAmEfCJR6J3aU2SRXAltJ1A4F0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HtPmeQYnvffYU8jU2gTb4kJIAw2TlCflrDmM05mnU_g&oe=69E61A5A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgyj2kaXq_oQ7kNvwGjxeMo&_nc_oc=AdrcQEfDtT7r3eKDtcE_vBJ3cgldhB6fqYNMO2fsjYNEA4oQjUbJGy-QE1PS2GfBpU0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f2LWCWTqUTOXVTqxEXFkHbcRTVDZE5TReOwTy6D1-nQ&oe=69E63563"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxSLN_XKpWMQ7kNvwH9PPey&_nc_oc=AdpRsLu1dDjYTst1ds84LtWfea4j8LZQhyR89XOPupZ1QUXyjIOUzeiOogjN5A462dY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02LzfqYrdo43g9YTMeMKwyTCjhiW4frHXOjjLmpOGwbA&oe=69E622B3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Fk9kUPhRLwQ7kNvwGuKMsm&_nc_oc=AdqsxR7ok9vDzXkQNw6tOZ6p2qg4IEedeT77UpPZgkK8LfV2GXfqJEhPgh-C-1GfNP4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iMjjQu57uH7ZmFVCJA_8WuxuVRRNLoUvmrPYwVvowfA&oe=69E637AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlr8tKufZ84Q7kNvwFx6mZV&_nc_oc=Adp4RINSLgtwwkBpWyra7_zOjGTLCc4RFQGlHnUw5XAakpebURdNX3lQeazx8HRZGXw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aO_HFJZ7IhXEX99WNoNL_LbykaiK4p9hLX-lsOrPO_g&oe=69E61DF9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjFSwRgPE04Q7kNvwFKYwRw&_nc_oc=AdojIrgIYUcTBqmy43TR7Z-TY-ggzF2kb9INIM6VSKPNA4fhjLEByaxYq9WtVkfjK9c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TO8sBKyUWCkyOg99PBnxOcIEBjI5KpCLpLQDWF718FQ&oe=69E622A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSPYcT-oIVAQ7kNvwFPfzOR&_nc_oc=Adq7BFJ3ZWYby9mw3CVUKGLR49hGGVs8gAbTOh4GrHaNHwDfwML14IwDTexv1akmDjM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hwl6pId2rck8a752az5gvayHwaHdQ_Y6xRZfbgGxevQ&oe=69E634FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8woknXZfGYQ7kNvwHt-Xxf&_nc_oc=Ador3hViXXqDikDjbeThoxFiUS6jPXPY8D08bwtkCQZnRFK5i4Beoy5h79W-kilMjb8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P_t0CUqNisOIHYsTF00Ysd735HRzcC_BJdeckOTLrPg&oe=69E62CC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
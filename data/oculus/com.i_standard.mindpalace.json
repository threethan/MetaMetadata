lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KF5RAaEg-MQ7kNvwGgrQaW&_nc_oc=AdrXO0bKce88X9fVmb33T2vjKU2TSFGxZ6Wv3IfUeDnPuzEWJz29jxC2YcVsB9pX35c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwsws8cyOKMdU0clbFKwNE3canGxoLZ71QtH5aWs2zkxg&oe=69CD0DDA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WhPozCub_YQ7kNvwHov5a2&_nc_oc=Adrkgw50aNH8kVredxflp8Sg3v5iF6IhBDh7srDox4b-r4MHkYZR4kt1lkjd4x-4Cd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjCu892mu-X4KvuANhoy9QE4IINvm-DUmQ7CfNo9hJkg&oe=69CD28E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMHpKQpTwtYQ7kNvwF8TAGq&_nc_oc=AdoYuNt2OAKt592-YGQvIiT0jdNKbqw9tKzlCsOmEUdZdJ2T3ZGODeD5QbQCWeKRo5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmiuLThMvHip-J_RIo3rpFqZ-BEJe5S7mZnqFe2EJWPA&oe=69CD1633"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsgGPu1C3HMQ7kNvwGQnJn6&_nc_oc=AdqVTLd-n2UhT9v4eNhvEM-wwzkGVBlnpdigBAjJEVfbZYD3vZJNZPFTaAqtmI-Or1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVOO0K4GMgW1k-Kb73YyZ7I2okVbA97GdgdKRaJiaVGw&oe=69CD2B2E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO8ijeM-T2oQ7kNvwEt-GMf&_nc_oc=AdrcnO6fybuCdD9jev8u4q20MUcN74EMl9Hi7J5MFnExcoEnTjfzTWsGYNIZI6GNrAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLvyeqlcS_haagriIBkBaHFYlcQk4wGa4BQCzGdYLVNQ&oe=69CD1179"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bTHFVMalUcQ7kNvwFxmcGz&_nc_oc=AdqBM53cyNL_gJW8L6B1V7I5I0MBqBe-9c724Wmezt3JDUJ55ek0Aq7cHe99Ga44Bz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOSRe9o4c38h5ZoKssiji3EUe2Ehg9smiCCfX8ZVDWUQ&oe=69CD1624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htlCfJWLGvkQ7kNvwFfb4vz&_nc_oc=AdqVQnVv0XuHLv2D7mBVJfOk5FchMZoNxV9EjnzyT7sYenXLwQmbNMRuf87C2c8Jq9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwQFEerAEWA28YYPsTTvtRvRomaZGzEvduA-_OvX9UvA&oe=69CD287F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-6agl12gTQQ7kNvwFdBddU&_nc_oc=AdptGJOodLTWl25OlIP0tZruolZUrOmBLJ90s4t1LUZ0aiZN7gMaUpVS3QGrOGNqq3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbgVc0edOJZaneBfIHoYKXOCr2wCuu_abdJoT-4RraYg&oe=69CD2047"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
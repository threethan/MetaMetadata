lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUGd9n9cO70Q7kNvwHnB4nI&_nc_oc=Adroo2OIADrG1ppa9RAi_cjsBf7NDllBABACkyuJBqJotyEXxXJ_CJE_Ks8lweOfa7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbdQPw631cI5zS6P7C93-dTAFNQsEtDzfHEWdF-SoVcw&oe=6A7C655A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCZBncnUX64Q7kNvwH5dcAv&_nc_oc=AdqL9HFEm6t_LuEZT8V59v3yhESy82QRKMzrZrIchC-amjogqcrFhEOJU1zDelqemBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3xnc9NVrN8I1hEsbUPBCVq_t9jAF5Hp_zNyh4KyJnhg&oe=6A7C4823"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQFIM3sDv5AQ7kNvwHChF8A&_nc_oc=Adpdl_kQbvnjc32Ly12QHhWNc22geHc9Rvi1ErSysbc_UK07RVog1W9LYwSwAxT0z24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaUPXegXuywgchlMkG_ahgMf955ao4xLYFtu2ObHSc0Q&oe=6A7C6DB3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67XEn0vMSo0Q7kNvwFdGLDi&_nc_oc=AdqFpIExqG9hYdsUf1Po8KxWzbxBFlOWeL6Vp0OqFZzwZFO0WF8ByutMG4bAsR7t0cQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1OsjPJufJ5dYxkgxXHSp7Z0z0gCZQR21uyajKz40dnQ&oe=6A7C4A6E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cFUbLvnyNwQ7kNvwH5engE&_nc_oc=AdpeiviD3v2pCkKYPKrduOz8dodnBYrCq8weaXCEQ1odFjGr9Lq0jWxQe47MOr9qTiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4qxNVoY_2yqijIYQzKPk5I3PrBPJ_h27FSX-Rcb7VhA&oe=6A7C68F9"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytbuPPMUk-4Q7kNvwFttDXN&_nc_oc=Adr3xtQDgdROXiDt7o1S5SUAPaCo0WEzUAf9FNfrePTr157VtLweNGcTgcA00p-B_Z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGavJUxujJPrBKseKsOwwM06pRE5V7DqlOYCpyqOwQe0A&oe=6A7C6DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JEGdjsQL9UQ7kNvwHKKk-t&_nc_oc=AdrhvtRDJUdV8D3KVrUa1FPVoJtzfRkbAHY-sNF70aSwLCU9ktG4PG_JQTRCnbdg7Es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjytA8MjaxMwV0ZjzbJ6xKFnWFWkV_Wse_3mgYB5r8AA&oe=6A7C47BF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5581wM-ArAQ7kNvwFYk98c&_nc_oc=AdoUQcHyuCnT5222WBjrLYudWqiwrCodFCdzAv2jie0IMwJYdfJDnVBLsVwgseF3-IU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoegVpAHNmNLgCPqJ2XlHjPqhBWHfUIGP2hCjENm6eqQ&oe=6A7C77C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
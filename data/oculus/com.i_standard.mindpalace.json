lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsBBVAiJ6nUQ7kNvwGgbpOp&_nc_oc=Ado6g2oJ9cndZNZ-YmosSJvKM56QzcKo2J_tk5VxRf1u3pTHybQY82if5HN9yn1frZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZCHTEIYPiSfJPrpgk-MeptLx3Q6USKnL8GnUG-q9wBA&oe=6A2956DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=velMJ7To2KUQ7kNvwHMrsgq&_nc_oc=Adp6bUHEY8m13SOqm5O-nrE1Va8fKv3FIUV2wic0YSEAFyo3_0x61bP2_IvULCydcLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ir0q402NV4936Yjbow7pwj35KaGbBi6eih15a6JJOSQ&oe=6A2971E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ7spXMn6_YQ7kNvwFEz90I&_nc_oc=Adppb5e2rVnTmQVVjT9IR-iv6sAA5PP8nJTaGnw6CFuaR6GVPMW5j4bd2fRSeVKjl9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af911LnyJy_qjwYVlenyFLMKcIeYj9KY5QhMhGc8I_-1Cw&oe=6A295F33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNMAz4SBHpEQ7kNvwH-Y2bM&_nc_oc=Adrbe-pW0XJNNPQjLV3TXKpdawFiULJQerHU7RZDn0LennVy6kcpYJfV2P-eJ8VPAPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CuRHeqmUD9iHJS57d5cU9G1djj2zL_es6U9EXBr6Wcw&oe=6A29742E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHubiLPUJTEQ7kNvwHGOij6&_nc_oc=AdrI9qL23xPsdc1zbwazvnYX3Wnm1iBZ6s11Q-nbuF2Fgz8VXvZs5n5cpEkLMYh9j1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YupR9a-f_dyo2wAsV1arbQHiH3cPg2aFbUIaNQumNgw&oe=6A295A79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGu8d0Zp05oQ7kNvwHFoQBX&_nc_oc=Adqfnh20F0RCqZfErbPSHrTu3fHaPbgnGKkJmS4BeL2-JlGYMPt3X9GONbQp4eDXLns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZNg1DqLJPzyjmantnRiKTsPyaNaNokE3Y3_b8iYWf8g&oe=6A295F24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvczzgpI4CIQ7kNvwGl5KW9&_nc_oc=Adqyq3bNiNQBun1NeVpVEhHeGYWD9rR5OU1pNMGDN5kHAPvB9RitWwo3TSt34TE6ZUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YpRVteDBJO12IcURex4K_4sXom7SdVDrKbu8SUkY5Dg&oe=6A29717F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1TemXeORM0Q7kNvwHA43-X&_nc_oc=AdqQSUyWzbKsITbxukWrVPnD43G5vbD2Tuef0EVirL57TsVCrCKfGNnRznFpwP2u0V4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yv9T90ks-0jHsdJiXmX2rpK3hhm7gNfXjW78Tm0J9_w&oe=6A296947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
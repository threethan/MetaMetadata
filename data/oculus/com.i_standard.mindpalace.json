lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH1P2NKFfPgQ7kNvwEDtnwx&_nc_oc=Adry9GaI2uAsxn5jDwnVlN4WncSpm06Xg-pt-DCWHya1Il1khTBqswNsOvU-G-r0Zt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD8GhdF3GRFCH3_USD5OfoX5PxQqCkoChf8CIF0AR2lw&oe=6AF3449A"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A07tTJZzt0Q7kNvwG8w3Vi&_nc_oc=AdolviD0s90LGij8y1wlwrjzPozVOFRgl6Yy_LHBSrThgJIQo0IclEX3AsNlvnKZGSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyLXSHd5n-syUE4M7xOrrrJPoqXzZkc1yKAqyB3nxeyQ&oe=6AF32763"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuiYHjSeXCAQ7kNvwE4yClZ&_nc_oc=Adqzj_2dAJoKAzpvca0UEmBW4MJu7CI-J-IuiEZwK3HLIL2sN74wXPT3Dk_x7xZD228&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Cil_JU3WKQExLpbuhiOcxAtABg0qSe_feqk-oGDL7A&oe=6AF34CF3"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-yjRkkow2YQ7kNvwGmZ7Fr&_nc_oc=AdqyVce691AbwaHmnEB46d4veCngzZIHO7NdzXRYAmu3AGRgkmrGEoSWn5WhOaCDXe0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMi60ChglBAvIw50DBrqPgBzuj8Z3KIxO--_rcMLctDw&oe=6AF329AE"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8oiWo1WalcQ7kNvwHm05cm&_nc_oc=AdqvTgMTuSyZvTP_AuqZXdvDLO6nBn3c7IGMfRgV-2Zk1mw0pFxgJC6Qsvqa1kWNe8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx48tazKfi9xYFGHBiLd57ZRvNslVtO8B4NBtcJjPqug&oe=6AF34839"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA9HOT1-1U4Q7kNvwG3sOdH&_nc_oc=AdrHNL4BpAGYDy8fv5U2KpN49Xrx46TEoOa1lViXBYWNGIqE7i7f5SVDkbxi6r2PoiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoNzLglU1NFBEA0CYGTS_aPuJkDiLPs18wwexgCCanxA&oe=6AF34CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QsIK-99THAQ7kNvwFHDfEX&_nc_oc=AdqjzrHYq26t4iqcZpabp8d5xGqVkH8QgmgY5Ign5yTuwrntD7cHgYQZLpAi2dJcing&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReDE1PkhYCPEjoh2GQ61NlTkBNLgmcXq_kzNwSxE1m3g&oe=6AF326FF"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBs_octjYt8Q7kNvwGbMjNZ&_nc_oc=AdpTWW9JSg134UpPDZ2jsNsbk0b9DXhCswTULa1pPnqZghjLz0-Mg6wAZtGundcSCDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-8RX4Ga6OSDx8Tv-ANE_a0AfqnBFzx23e_8UTvGggQg&oe=6AF35707"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
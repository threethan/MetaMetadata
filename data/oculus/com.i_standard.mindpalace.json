lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ryfe4F6PgC4Q7kNvwGRpDmC&_nc_oc=Ado2Ilx6Ccw_upa5e8XFP_5-SmFTBjo3qK_ETxOrDepcfu7ksoecOksv3XwAf1NLl9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk78xevolSh83emusGoS9ocmO6rxNcbQG1Al_Z2nHbLw&oe=6AB7B8DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-owMSGZb61kQ7kNvwFBnbR4&_nc_oc=Adrs4zeHut8B2ZBLNljk4G8STa7sCJBkYltGw_tJ9nS6vpRM_0Sp_FNeymy8w8rkrcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRE4-GUsHdPWSIVmEvdmQCxchmqnJapZxr0OrTafo9kw&oe=6AB7D3E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyhtGhq2HyEQ7kNvwGjxaxV&_nc_oc=AdqGIjR9Y9yxKuQHnHhRr7sbxHVupj5ybl2kG_7jJI5NIiaqzruEAPTVGGKKsf6qI0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa6pmc_n4CDr4HMoRoOW18NGeehjkFj2b0Xm-MGQYEnQ&oe=6AB7C133"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TlI8mb8pLAQ7kNvwHTXZea&_nc_oc=AdpOHjwSKEOrzIH0nZIoCm2XrZuVgAs5Z-1KTRNkic-3iFFGtAGJCTMR7537bLx1OVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI7B3NdSq-7UUX_2oNdOfoWOZ41_sKvE59tLhNRdLD4A&oe=6AB7D62E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIyUwVbppIwQ7kNvwF90wlg&_nc_oc=AdqYyymWdE9ODWdSeo-ZhfmNET5N1lNuJ9rGpHwuc4RXIeTC-2kQfFrH52_2awO0TrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAIkS9YAFR58ayH1730F3XFGqFl7zAAW6g7SA_-r_8Qg&oe=6AB7BC79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNFDE0rbKJ4Q7kNvwGmp_Sl&_nc_oc=AdqZKMb0FEJOkGGdqrixyF9J0DR64WZP3B1SbPXqY1G7o2Ffw1dYucr22Ypn2My6mqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKci2S60Lk0e4PAzdMkbjNfGKgACPUBBsxHtdZU234GHA&oe=6AB7C124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_dcyc3iPEMQ7kNvwGc9Vl5&_nc_oc=AdoE41-Hdsp82gFf4TmLn9iWrHqtrzamWqQFHp--6mnIYZRE4t4WfrR-KZBCYgoDzog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO8Nwd33knV0q-0URXnTGdtYHwwl-nYH2bMWFhE07a6A&oe=6AB7D37F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00jM8fw-YP0Q7kNvwHnihC_&_nc_oc=AdrJGG46TS3kSgcNEZZ7EKgYwW9ZhXYEwx_kpWlsT5o5BSFHBnkyYZLXDblym7e-1X4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK0yfv8maV80pZ9Ix47Lxn_wTufdnv3X4RjwZjwVblXg&oe=6AB7CB47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
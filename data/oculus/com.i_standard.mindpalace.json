lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-jEk_-zEg8Q7kNvwG1XOIn&_nc_oc=Adr3zwt08qGbD7UGMpkc-xa0hg0ifAtk5pN8x_V9APdhzzJBCs7FS3BHrhWXpPJGuvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BGrXrbhlbUQw98IlZy0r6guHLq31w3-0zPliOTHeEQQ&oe=69D4F6DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLGyFfDrxL8Q7kNvwHD2RvG&_nc_oc=AdpXiiyCnKUyIlQ5mzS3l5OYlI-kmewoKqa8sF1f84SrTuXsU7OcI13VHyW8-qBpCcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yQYvuICBY_wmGqYF_kvphb7fHSVPHeNUHAEGKpwKDfQ&oe=69D511E3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWLR_cOs1eQQ7kNvwHmoazL&_nc_oc=AdqgvT7fX8wBPX-ZcenHvrsXg4zZ4slwXlNClUxFHyBR-XkqvVJd48VHNSjpbGCN2h0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tESX_fVB3X9pAUURajP1GvGO6vCkYXR92iIsAFmDWxQ&oe=69D4FF33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pxm98MzkwsQ7kNvwHk_e7u&_nc_oc=AdpsVU7Fe2rgaqAr0SYDcJKS4DPtLzJph_RUa50UaBUKcY2FN1TtTlPyE2Pch_KMBa4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CIzq7xTP2DYSZgmcN4Sem6bwmV9ItIeMbCjJNDpN8xQ&oe=69D5142E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNUU73S6D-4Q7kNvwEqmgzq&_nc_oc=AdpvoulAHrdgwDC5xYdma8jtM6y1K79gzaK4BGZNh_J_kOabjC4li7-uKVbE1iwOCXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ILpRclYshU19tvScHm8CPSusez-qX9EMeiTpLwjFpvQ&oe=69D4FA79"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KD8R-XoY4AQ7kNvwGPohcc&_nc_oc=Adq8ZYbIxoi_eVdk1VIb4icLbiehFeSJzkl1Znc-rFyTJj2ElKXbhhqWoI6Tw44hUaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hdATz5egZhzQPEzp_QAqanD7C_9Pc7AqGYk3vEoy-9A&oe=69D4FF24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGnMclnu2qEQ7kNvwGPfSi0&_nc_oc=Adq3r4HNxI3suq1aClN79Lqw8PwKFkAu1UK8mu1mZWKirdUeTu1ChKnOVNX9_wVPp0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z7bCuaU9ODV1xcLeARGqQY7peNk8p6H2snpv_6k2qBQ&oe=69D5117F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rz3BdXW3mwQ7kNvwHkY3eF&_nc_oc=AdproRZb_7YGsUFM92FRIj4YzxhdKVck7FdwTPiWXo6YvEGMZszE9yMn8La9J4iZOag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tkseZHagC4amNRjzKnyEmjfcOKKKLNKA68xuLcpfQ9g&oe=69D50947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
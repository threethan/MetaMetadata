lack.png", "id": "295787106186238", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982592_295787109519571_922937597949772464_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6CcRD5QZ1sQ7kNvwHWNng5&_nc_oc=AdqKGYVNHewWgaKuV6B7cpUkylnWMbOqq_cdPGOJuAi3gd765iJd5mu2cxQwi3LZMig&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2dn23O4ohW_s7DWKSLS5OrA-lOznDr86vyOXzYCbkpw&oe=6A9733DA"}]}, "id": "640315258025634", "locale": "en_US", "screenshots": [{"file_name": "Preview1-1.png", "id": "231791866414770", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75617321_231791869748103_5600140972245738952_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbU3pQTWDiYQ7kNvwEt39FB&_nc_oc=Ado8jiYxXjyNPbjThGiq2gm4C533SCwTwCp6rG2hio3YlpL6GpIEWOVM8NLILGz8Oy0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiP39kFPtZebC8kGcrqA7Cq3Zmw7BRtiUtyHZP3O7CYA&oe=6A974EE3"}, {"file_name": "Preview2-2.png", "id": "789887072614929", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982674_789887075948262_149142216419763776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr8BvmgUzAwQ7kNvwHbc3N3&_nc_oc=Adok0ArHAhGnze6q4iRoS5DbSmsMPBPivKtYpGrNtNw3VH7ZctHgWGVcS2io9fEYlhM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX7k7mQBFtJwbb5V3p69jCNRzuCGJnklSsOMRabLVyow&oe=6A973C33"}, {"file_name": "Preview3.png", "id": "3512117552368483", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031538_3512117559035149_7512024637542534264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxepyAvxjC0Q7kNvwEmAlXT&_nc_oc=AdpQDDhGdgHlt12H9K4bNvOJ_FNUedIEZisWCeGxc5fPaHY7uqbKnQHdF5xJzdyHZyc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRdMqNyqpPcY1z9RBeM8VdA1JgfF-hbb3x4vNHd1WPQw&oe=6A97512E"}, {"file_name": "Preview4.png", "id": "600277595426221", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982545_600277598759554_1181685002104447294_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bql6eJMwh1sQ7kNvwG0ZjZB&_nc_oc=AdrxfModmfDEigBzWno36UoW1Vmo09yVEVkRojYcxI7P3ChtYzY6a7W4aP9XLlpxdo4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcFhh5GGej5bXXUjKRXalN5HG1MYlbWeICK8yBxXkLZw&oe=6A973779"}, {"file_name": "Preview5-1.png", "id": "251504337630601", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974855_251504344297267_2704252636234673923_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPi1lVMAvPQQ7kNvwF6BSiv&_nc_oc=AdpP441dwNWTrjdwxnln9Lqz4yrSVIju7xlinn0HvqDCNFDwhQ31IXQUe7D9jiv_kZU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXGmfOIfvMvks-fecEpH_75cUj6huhN3R24Qm_YqNAxQ&oe=6A973C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u898b\u51fa\u3057\u3092\u8ffd\u52a0.png", "id": "1013340913157774", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974727_1013340916491107_6987464292749567898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX3CT2l0GZcQ7kNvwGZ490I&_nc_oc=AdqDgtX2pAUi8P8Qm17Na2UT_2iYbvpk8JlArGKIAAMJL2V_PJak6-D1O5qm0GXQR7M&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqoYIO7nOXXrotQwZRRaIV43ze5d5SPsrf9D-fhynGjA&oe=6A974E7F"}, "display_name": "Mind Palace", "keywords": [], "long_description": "Mind Palace provides an ideal environment for organizing thoughts in a 3D space. \nWe offer a room-based platform with the following features.\n\nFirstly, you can create mind maps to visually organize your thoughts. \nYou have the freedom to customize colors, shapes, and sizes.\nIt's also possible to add text to the lines connecting objects in the mind map to display related information.\n\nAdditionally, you can decorate each room with various objects. \nChoose from a wide selection and even climb on the decorations. \nBy placing mind maps, changing perspectives, or moving within the room, you can temporarily step away from your current thoughts.\n\nMind Palace offers a gaming-like experience, making it easy to get started. With an intuitive interface and seamless interactions, you can effectively organize your thinking process.\n\nWhy not utilize this space to clarify your ideas? \nMindPalace serves as an excellent supporter for your thoughts, helping to unlock creativity and insight. \nThe preparation to get started is already in place.", "short_description": "An app for organizing your thoughts.\nThis App can use by Oculus Quest series."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.m-palace.com/home/privacy", "developer_terms_of_service_url": "https://www.m-palace.com/home/terms", "publisher_name": "https://www.i-standard.jp", "support_website_url": null, "website_url": "https://www.m-palace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1433463757194750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982694_583587917268359_530868824494148936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6tBr9eu0A8Q7kNvwEU1Mkw&_nc_oc=AdreYiixPp8b1heWK0WqnJFimyZgMTgoYtfR3ZI7n01UtC8foRMJYaNsH8CmbJVO4Gg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn2IdmupYk4mQwyzZ31r_qGs4chi6rLhNWavYwafJ-DA&oe=6A974647"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mind Palace", "platform": "ANDROID_6DOF", "context_category": {"c
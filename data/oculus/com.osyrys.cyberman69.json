r_thumbnail": {"file_name": "Hero.png", "id": "976523980922191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75241700_976523984255524_5462762179228486472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8sT2dpPebkQ7kNvwFNsA3y&_nc_oc=AdoLlpBxx0tBQalw9T_oKxk-q6M5n8joo9H3xRNEWO84SZX2s2GzZ-f5s9JfXL1_1xU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XKMW06Dl8gNJzqpNHsTf5jIER0LBohQmcxz0P5poqmw&oe=69FF297F"}, "display_name": "Cyberman 69", "keywords": ["arcade", "fast", "speed", "casual", "fun"], "long_description": "# \u203b WELCOME CYBERMAN \u203b\n\nEmbrace speed in Cyberman 69\u2014a high-octane VR game that redefines fast-paced gameplay!\n\nSprint through the metaverse with arm-swing locomotion that eliminates motion sickness, offering buttery-smooth movement.\n\nExplore six adrenaline-fueled levels where your goal is simple but deadly: slay sentinels, get the orb.\n\n# SHOW US YOUR SPEEDRUN SCORE, ROOKIE!", "short_description": "\u203b WELCOME CYBERMAN \u203b\n\nEmbrace speed in Cyberman 69\u2014a high-octane VR game that redefines fast-paced gameplay!\n\nSprint through the metaverse without motion sickness with arm-swing locomotion.\n\nExplore six adrenaline-fueled levels where your goal is simple but deadly: get the orb, slay sentinels.\n\nSHOW US YOUR SPEEDRUN SCORE, ROOKIE!"}]}, "developer_name": "Osyrys", "developer_privacy_policy_url": "https://syry.notion.site/Privacy-Policy-a971178684334c1b8f53f59ea181631e?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Osyrys", "support_website_url": null, "website_url": "https://www.syry.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "rec
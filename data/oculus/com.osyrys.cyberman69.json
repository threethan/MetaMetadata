QUJde88eLm_yXQePw7qfoNYvqDvm-rgeU_lDriSoNZC-w&oe=6B0F20EC"}, {"file_name": "Screenshots.png", "id": "917179133740345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035447_917179137073678_3101775448462125760_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwy2iszHHEcQ7kNvwGwqFq6&_nc_oc=Adqmp12rY-Lg5O550gmgwF6jiV5adH1yfTXtC09tal312IAL5bQKCfWpvT8Bo-jRkhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUWrelDOSfh7f88Pf_L59_aYoTCrdZqqjKWjLssCDUbQ&oe=6B0EE98B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero.png", "id": "976523980922191", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75241700_976523984255524_5462762179228486472_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG5LC8chXSQQ7kNvwHStTto&_nc_oc=AdoAT6sQ9QINtMX1dKnCOIOEmV1FIp2lGhyGpUQnYMKRPFADuPuqBDeoy_FDFX5aXVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6tygp_hLlO7nIi4ojlRHy5SZ_Zx6n-l4G8Vwd45-I9g&oe=6B0EF6BF"}, "display_name": "Cyberman 69", "keywords": ["arcade", "fast", "speed", "casual", "fun"], "long_description": "# \u203b WELCOME CYBERMAN \u203b\n\nEmbrace speed in Cyberman 69\u2014a high-octane VR game that redefines fast-paced gameplay!\n\nSprint through the metaverse with arm-swing locomotion that eliminates motion sickness, offering buttery-smooth movement.\n\nExplore six adrenaline-fueled levels where your goal is simple but deadly: slay sentinels, get the orb.\n\n# SHOW US YOUR SPEEDRUN SCORE, ROOKIE!", "short_description": "\u203b WELCOME CYBERMAN \u203b\n\nEmbrace speed in Cyberman 69\u2014a high-octane VR game that redefines fast-paced gameplay!\n\nSprint through the metaverse without motion sickness with arm-swing locomotion.\n\nExplore six adrenaline-fueled levels where your goal is simple but deadly: get the orb, slay sentinels.\n\nSHOW US YOUR SPEEDRUN SCORE, ROOKIE!"}]}, "developer_name": "Osyrys", "developer_privacy_policy_url": "https://s
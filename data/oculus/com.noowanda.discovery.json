ground.\nPlace torches or design complex electric circuits to light up your creations in the dark and enjoy beautiful day and night cycles.\n\n\n\u2022 Creative sandbox block-building experience: Create your own worlds with more than 215 unique materials.\n\u2022 Jump into Virtual Reality and experience your block world as if you were there with incredible 360 degrees immersion.\n\u2022 Inking system: Customize the blocks with 16 different colors for your own look.\n\u2022 Easy accessibility, Simple controls", "short_description": "Explore a giant world made of blocks and modify it with your own creations. Construct houses, build entire villages, cities, monumental constructions or dig deep underground.\nPlace torches or design complex electric circuits to light up your creations in the dark and enjoy beautiful day and night cycles."}]}, "developer_name": "noowanda", "developer_privacy_policy_url": "http://www.noowanda.com/discovery-privacypolicy.html", "developer_terms_of_service_url": "http://www.noowanda.com/discovery-termsofservice.html", "publisher_name": "noowanda", "support_website_url": "http://www.noowanda.com/", "website_url": "http://www.noowanda.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "905611933454343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031399_451506939144559_963985197778201615_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_si
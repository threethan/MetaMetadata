a0a&_nc_ohc=owGkgquuN_MQ7kNvwEUPQbZ&_nc_oc=Adru-O51FBE2JvrV6HN_hVGNV-d8B66CI7wh_zNP1wM0ys6Iuwun-5X_0KkMXsESKv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfbJHP5XKK-DSExp9mzxeuL-qSQyC8CtY7DOTbmhFpVQ&oe=6B1049A2"}, "display_name": "Discovery", "keywords": ["Minecraft", "Sandbox", "Blockworld"], "long_description": "Explore a giant world made of blocks and modify it with your own creations. Construct houses, build entire villages, cities, monumental constructions or dig deep underground.\nPlace torches or design complex electric circuits to light up your creations in the dark and enjoy beautiful day and night cycles.\n\n\n\u2022 Creative sandbox block-building experience: Create your own worlds with more than 215 unique materials.\n\u2022 Jump into Virtual Reality and experience your block world as if you were there with incredible 360 degrees immersion.\n\u2022 Inking system: Customize the blocks with 16 different colors for your own look.\n\u2022 Easy accessibility, Simple controls", "short_description": "Explore a giant world made of blocks and modify it with your own creations. Construct houses, build entire villages, cities, monumental constructions or dig deep underground.\nPlace torches or design complex electric circuits to light up your creations in the dark and enjoy beautiful day and night cycles."}]}, "developer_name": "noowanda", "developer_privacy_policy_url": "http://www.noowanda.com/discovery-privacypolicy.html", "developer_terms_of_service_url": "http://www.noowanda.com/discovery-termsofservice.html", "publisher_name": "noowanda", "support_website_url": "http://www.noowanda.com/", "website_url": "http://www.noowanda.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommende
=00_AQS6J8pk4GjaTKb4odFi9-RN4uWNgJyJDTqkGVNFDzABfg&oe=6AFF0605"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162741_137935686799281_4229751593454534656_n.png", "id": "29598556633166616", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/613094043_29598556646499948_5565688570141585669_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OE50YhCzTUQ7kNvwGHdxNj&_nc_oc=Adrofy4509pCnThWjz53UFjgyuEnqJrEg0tyVYg2-0Dqto1E2yLScFkV1RnfwgTKd6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIxpU_xS9hgISoQOEE7j9KM_9qHjIT3764L7WBV95tHw&oe=6AFF2FFE"}, "display_name": "REAL RAGE", "keywords": ["platformer", "rage", "parkour", "retro", "obstacle"], "long_description": "# REAL RAGE \ud83d\ude08\n\n**Feeling suspiciously calm today? We can fix that.**\n\nREAL RAGE is a first-person VR rage platformer designed to test your **reflexes, timing, memory and patience** \u2014 especially the patience part.\n\nYour mission sounds easy: **reach the flag at the end of the level.**\n\nEasy... right? \ud83d\ude0f\n\nJump across platforms, dodge deadly traps, smash obstacles and defeat enemies by landing on their heads. Some traps are obvious. Others are patiently waiting to ruin your perfect run. \ud83d\udc80\n\nDie. Learn. Try again. Forget the trap. Die to the same trap again.\n\nYou have **unlimited lives**, but every failure makes your **DEATHCOUNTER** a little more embarrassing.\n\n## Features\n\n- \ud83e\udd7d **First-person VR platforming**\n- \ud83d\ude21 **Rage-game style challenges**\n- \ud83d\udc79 **Final boss fight**\n- \ud83d\udc80 **Hidden traps and nasty surprises**\n- \ud83d\udca5 **Breakable obstacles**\n- \ud83d\udc5f **Stomp enemies from above**\n- \u267e\ufe0f **Unlimited lives**\n- \ud83d\udd22 **Death counter**\n- \ud83e\udd2a **Weird humor and retro vibes**\n\nThink you can beat the game before the game beats you?\n\n**The DEATHCOUNTER is waiting. \ud83d\udc80**", "short_description": "REAL RAGE is a first-person VR rage platformer that will test your reflexes, timing, memory and patience. Jump across dangerous platforms, dodge traps, stomp enemies, smash obstacles and reach the finish flag. You have unlimited lives, but every mistake increases your DEATHCOUNTER. Survive all levels and defeat the final boss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/bandnclimbgame/posts/263625351840411", "developer_terms_of_service_url": null, "publisher_name": "B&N", "support_website_url": null, "website_url": "https://www.facebook.com/bandnclimbgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3476113609236653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1124202139942622_890176524189801513_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNfur40m_LoQ7kNvwHXFwdy&_nc_oc=AdpAsjzxsD3kO0d_B_4WWme71gA38TBaOwPdE-KLGbfv0-TR11VoBckXkHUQohXEAic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8gnLailGkQcKFct1RPYvUIvY6BPqXqDfnFWb5AZRpoA&oe=6AFF25E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "REAL RAGE", "platform": "ANDROID_6DOF", "context_category": {"context_cat
FGZEQ7kNvwFXYyPt&_nc_oc=AdpBve3qljWYNKmzEDnwCJ4VVRcj8ywtP8pB-RAIS1YF_hHM1jHXMU6OzX2wEEmlOFU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJOBIrmlO4czSadcZQm6i1oPO90QzhthX2PfbqiZ4-fw&oe=6AD0D027"}, {"file_name": "10.png", "id": "1376623690965888", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819323_1376623697632554_3176638292113771578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROtac2yvkS8Q7kNvwEKtVyE&_nc_oc=AdqKkpMAnxX-TMxTx8Yx4clEbnIqErGrNLmMEnopnoOhjzVcqFeUrUbDIN5XbOqOiMg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrlRQXWVEOrGhAqTR7UYGEMTSPIzLMABb2OSzLHkw1wQ&oe=6AD0F31C"}, {"file_name": "9.png", "id": "1197674635700328", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_1197674639033661_8706012403887705119_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILRIH8-W4SIQ7kNvwF_DW8V&_nc_oc=Adq_M43H_V4jzZgSvIF0XulAsDtWc4GsQ7Iqs4akVK2LovMzvIikdzZYsCJGSPhIInA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTNxNlw_2ne5If3p0yqCcysqhv2HDKx7t1rtMO_007Dg&oe=6AD0EB10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1418629280069022", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307505_1418629283402355_6963972932983621021_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D917kzqCp40Q7kNvwG4qO9f&_nc_oc=Ado8LO6nlbQ4r8Mz3tTeYLTQGM49VrODuDA2WvvMUu9cARKOt1o9WC0MRgQzwjZt5Rk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCh3Wxf-h5R8K8btuy4woQIG9fpUSxETg_LOEDagTX7g&oe=6AD107BB"}, "display_name": "BlockVerse", "keywords": [], "long_description": "# BLOCKVERSE\n\nEnter BlockVerse, a next-generation voxel sandbox built for Meta Quest 3.\n\nPlay in two unique ways:\n\n\u25a0 FULL VR MODE\nDive into a fully immersive voxel world where you can explore, mine, build, and survive in massive sandbox environments.\n\n\u25a0 MIXED REALITY MODE\nBring BlockVerse into your real world. Build structures in your room, dig into the floor beneath you, and create persistent voxel worlds attached to real locations. Your creations stay exactly where you built them, waiting for you when you return.\n\nBuilt specifically for Meta Quest 3, BlockVerse features advanced Mixed Reality technologies including:\n\n+ Hands-Free Interaction\n+ Environment Depth Occlusion\n+ Real-Time Passthrough Lighting & Light Direction\n+ Persistent Spatial Anchors\n+ Room-Based Persistent Worlds\n+ Outdoor Anchor-Aligned Passthrough Mode\n+ Avatar Support\n\nSurvive the brand-new Zombie World mode, build massive creations, or transform your real environment into a living voxel playground.\n\nYour room becomes your world.\n\n---\n\nBuild today. Return tomorrow. Your world will still be waiting.\n\n---\n\n**Create. Explore. Survive.\nWelcome to BlockVerse.**\n", "short_description": "BlockVerse is a next-generation voxel sandbox for Meta Quest 3. Play in fully immersive VR or transform your real world with Mixed Reality. Build, mine, and explore persistent voxel worlds attached to real locations, waiting for you every time you return. Features include hands-free interaction, environment depth occlusion, real-time passthrough lighting, avatar support, room-based persistent worlds, outdoor MR support, and the new Zombie World mode.\nBuild today. Return tomorrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blockversexr.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Running Pixel", "support_website_url": null, "website_url": "https://www.blockversexr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": 
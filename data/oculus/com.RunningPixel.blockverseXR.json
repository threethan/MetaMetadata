4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAJG6lhhwfQQ7kNvwGiD6RO&_nc_oc=AdpAuHxUOHF4TKxsJ2G2oXm6oQ5HFXfYuAy51eW7SOiqHiDHVpAA0gnQfF1w7DuOmeg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAcPlu34LvH5N098VBxoN6FBBogsTHITAbdmb-N4bYpg&oe=6AEC9A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1418629280069022", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307505_1418629283402355_6963972932983621021_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1w_t8ujDzIQ7kNvwG-b8Tf&_nc_oc=AdpoaIRRXVPH_0L11AeGLXpwWZiUk8w2WrGcvKs_vOfVV4bhaCIoUJIZZ2Q-3YUeQus&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFvklgLmP8ygVUCfIVzM4dI1oMm8guJH5lFUgEPqg2Tw&oe=6AECB73B"}, "display_name": "BlockVerse", "keywords": ["voxel", "building", "block", "mining", "exploration"], "long_description": "# BLOCKVERSE\n**Build your world. Transform your room. Survive the zombies.**\n\nBlockVerse is a voxel sandbox for Meta Quest 3, combining creative building, exploration, and survival in immersive VR and Mixed Reality.\n\n\n## NEW: YOUR ROOM. YOUR WORLD. [for Quest3/3s/pro and up]\nTurn your real space into a voxel playground. Build structures around you, dig into your floor, and shape a world that belongs in your room.\n\nPersistent spatial anchors keep your creations tied to real locations. Leave today and return tomorrow to continue where you left off.\n\n## FULL VR ADVENTURES\nStep into fully immersive sandbox environments. Mine blocks, build ambitious creations, explore, and survive.\n\n## ZOMBIE WORLD\nTake on zombies in the new Zombie World survival mode. When you're ready for a different adventure, return to building, mining, and exploring your voxel worlds.\n\n## MIXED REALITY THAT FITS YOUR SPACE\n- **Hands-free interaction:** interact using your hands.\n- **Environment depth occlusion:** real objects naturally obscure virtual content. [for Quest3/3s/pro and up]\n- **Real-time passthrough lighting:** virtual content responds to your surroundings' lighting and light direction.\n- **Room-based persistent worlds:** return to creations linked to your space.\n- **Outdoor MR:** explore anchor-aligned voxel worlds in passthrough.\n- **Avatar support:** bring your avatar into BlockVerse.\n\n**Create. Explore. Survive.**\n**Build today. Return tomorrow.**\n", "short_description": "Build, mine, explore, and survive in BlockVerse, a voxel sandbox for Meta Quest 3. Dive into immersive VR or turn your room into a Mixed Reality playground, with persistent worlds waiting where you left them. Take on the new Zombie World mode and bring your creations to life with hands-free interaction, depth occlusion, and real-time passthrough lighting. Explore outdoor MR with anchor-aligned worlds.\nBuild today. Return tomorrow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blockversexr.com/p/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Running Pixel", "support_website_url": null, "website_url": "https://www.blockversexr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28840740498950810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64
=2vkR23RzkesQ7kNvwEyZA5P&_nc_oc=AdnGJ6jMVtI_CqvVFhWLNXDgvybIyYeW4XVa4XHFzji007gQSH0CqKY71xbhOrgxWNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsLlfC04KTCExeCF7ahT39BA9YlhL8HuB8QPsB0wdjCKQ&oe=699B0B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover_image_2540x1440 (1).png", "id": "377752276665189", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984443_377752279998522_7673553025954997757_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8d-hCk9QHUQ7kNvwF3z_9m&_nc_oc=AdnM6H2g5WluS7HUXu4JDb-FAX8UCfOdJZDQ2niFjI9ytXhzqrYd1O0AriGujFdlIRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftINC8RaF2Q9ZFEJsDdcWxcKitMCm5tYIa4gqR9GfUkUw&oe=699AEF21"}, "display_name": "Holofit by Holodia", "keywords": ["Fitness", "Sport", "Rower", "Bike", "Competition"], "long_description": "WE MAKE FITNESS FUN. With over 100 workout options and regular updates, HOLOFIT makes sure your cardio workouts are interactive, motivating, and fun! \n\nRun, cycle, or row in 11 amazing worlds, use one of HIIT, Fat burn, or Time-attack programs, compete with other members of the community, and spend up to 400 calories in one session.\n\nWhat do I need for HOLOFIT? \n- Monthly/ Yearly Membership \n- Optional: Compatible fitness machine. \nStart your 7-day free trial today:  https://www.holodia.com/consumer/ \n\nWork out in Paris, Antarctica, Babylon, Snowy Mountains, Tropical, Saturn, Aiguebelette, Cambridge, San Francisco, Underwater, and the amazing world of Troglodytes! Measure calorie-burn, save your workout data and progress in our Android/iOS companion app.\n\nUse your bodyweight for rowing, running or cycling exercises, or connect HOLOFIT to your bike, rower, or elliptical to completely transform your workouts. HOLOFIT works on most bikes, rowers, and ellipticals. ", "short_description": "WE MAKE FITNESS FUN. With over 100 workout options and regular updates, HOLOFIT makes sure your cardio workouts are interactive, motivating, and fun! \nRun, cycle, or row in 11 amazing worlds, use one of HIIT, Fat burn, or Time-attack programs, compete with other members of the community, and spend up to 400 calories in one session.\nWhat do I need for HOLOFIT? \nMonthly/ Yearly Membership \nOptional: Compatible fitness machine. \nStart your 7-day free trial today:  https://www.holodia.com/consumer/ "}]}, "developer_name": "Holodia", "developer_privacy_policy_url": "https://www.holodia.com/legal-notice-holodia-virtual-reality-biking-company/", "developer_terms_of_service_url": "https://www.holodia.com/holodia-legal-info/", "publisher_name": "Holodia", "support_website_url": "https://www.holodia.com/contact/", "website_url": "https://www.holodia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPLORATION", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "463024375438113"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "152578286662252"}, {"status": "PUBLISHED", "id": "1867402020279124"}]}, "baseline_offer": {"id": "152578286662252"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1610042400, "status": "PUBLISHED", "id": "152578286662252"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24798173746522933", "version": "6.1.0.1"}, "id": "3
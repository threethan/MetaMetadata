.com/v/t64.5771-25/473392147_663512583180931_6702880122962278028_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUmFP1pR5eIQ7kNvwHseo9-&_nc_oc=AdpW1TfnVBPhevuEJuPqnZTE_B3ABZmPmh-jzu4KIhm994oH5DWzjOep79YrKRzt3dI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcxEC-fhQaWUOqIELdH2_d7KbSQb97sm3w8whISv9olg&oe=6AA14BA6"}, {"file_name": "3.png", "id": "1238613814262018", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393848_1238613817595351_2436570928281380267_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYhCUzr0CKAQ7kNvwHP_50s&_nc_oc=AdpCZkP-2UurFIkwzoV5IwqEQ1jZ0GAByrCNcNkudj_-SfI9GF4sMvCJdO_yXj4TvXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq9SOb4pYO11OO5Rm6fkp5Z2DTo1ZDhPRnvE7cpTZrbg&oe=6AA1530A"}, {"file_name": "6.png", "id": "1642127443146896", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823878_1642127446480229_8381857360930863963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhsJ3w6Nc2EQ7kNvwELElSY&_nc_oc=AdqIUgWWB8y88zwM9MEEngWlx4U081HpfaMoaVIiXaDzKaz-ixdr2Z5j9SFZjqYLF5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmMfyo3daSNl46ROFXGzldMOoqlC-BvBPJICZxQNsdIw&oe=6AA1712E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-summer.png", "id": "1521421423055145", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310731_1521421426388478_470386038477014855_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os8bhVqZAcoQ7kNvwGxOBux&_nc_oc=Adrbi1rASsMA29SNZOAqpuGJcEnS9NnmyLpSZc_Z_CS3LIO8v3HmR2IM0KSWi9Pdsfo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-j_TlAjYMgn9YbH0AgQipw2i2r93ZvlCjI9ornZA0Gw&oe=6AA17171"}, "display_name": "Holofit: Make Your Fitness Fun", "keywords": ["Fitness", "Bike", "Workout", "Rowing", "Cycling"], "long_description": "Some call it a workout, we call it a game.  \n\ud83e\ude90 15+ virtual worlds: Tropical, Paris, Antarctica, Cyberpunk, and more  \n\ud83d\udc5f Guided HIIT, Fat Burn, Cardio programs   \n\u2b50\ufe0f Monthly & daily challenges to motivate you  \n\ud83e\udd47 Real-time multiplayer with friends or other members  \n\ud83c\udf89 Monthly updates with new features  \n\ud83d\udeb4\u200d\u2640\ufe0f Works without any additional equipment through bodyweight, or on top of rowers, bikes and ellipticals   \n\ud83c\udd93 7-day free trial, risk-free  \n\n\nThis subscription is valid for consumer use only. Please contact us for info on commercial use.  \n\nNote: Bluetooth connectivity may not work on some devices. For any questions, please contact support@holodia.com ", "short_description": "\ud83c\udd95 UPDATE: New HOLOmissions, Canyon world, new world soon  \n\nSome call it a workout, we call it a game  \n\n\ud83e\ude90 15+ virtual worlds: Tropical, Paris, Antarctica, Cyberpunk, and more  \n\ud83d\udc5f Guided HIIT, Fat Burn, Cardio programs   \n\u2b50\ufe0f Monthly & daily challenges to motivate you  \n\ud83e\udd47 Real-time multiplayer with friends or other members  \n\ud83c\udf89 Monthly updates with new features  \n\ud83d\udeb4\u200d\u2640\ufe0f Works with rowers, bikes, ellipticals, or without any equipment with bodyweight exercises  \n\ud83c\udd93 7-day free trial, risk-free"}, {"images": {"nodes": []}, "id": "1037687985319395", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holofit: Make Your Fitness Fun", "keywords": ["Fitness", "Sport", "Entra\u00eenement", "Rameur", "V\u00e9lo"], "long_description": "Certains appellent \u00e7a un entra\u00eenement, nous appelons \u00e7a un jeu.  \n\n\ud83e\ude90 Plus de 15 mondes virtuels : Tropical, Paris, Antarctique, Cyberpunk, et plus encore.  \n\ud83d\udc5f Programmes guid\u00e9s HIIT, Fat Burn, Cardio.   \n\u2b50\ufe0f D\u00e9fis mensuels et quotidiens pour vous motiver.  \n\ud83e\udd47 Multijoueur en temps r\u00e9el avec vos amis ou d'autres membres.  \n\ud83c\udf89 Mises \u00e0 jour mensuelles avec de nouvelles fonctionnalit\u00e9s  \n\ud83d\udeb4\u200d\u2640\ufe0f Fonctionne sans \u00e9quipement suppl\u00e9mentaire gr\u00e2ce au poids du corps, ou en compl\u00e9ment des rameurs, v\u00e9los et v\u00e9los elliptiques   \n\ud83c\udd93 Essai gratuit de 7 jours, sans risque  \n\n\nCet abonnement est valable uniquement pour un usage grand public. Veuillez nous contacter pour plus d'informations sur l'usage commercial.  \n\nRemarque : la connectivit\u00e9 Bluetooth peut ne pas fonctionner sur certains appareils. Pour toute question, veuillez contacter support@holodia.com ", "short_description": "\ud83c\udd95 MISE \u00c0 JOUR : Nouvelles HOLOmissions, monde Canyon, nouveau monde bient\u00f4t disponible.  \n\ud83e\ude90 Plus de 15 mondes virtuels : Tropical, Paris, Antarctique, Cyberpunk, et plus encore.  \n\ud83d\udc5f Programmes guid\u00e9s HIIT, Fat Burn, Cardio   \n\u2b50\ufe0f D\u00e9fis mensuels et quotidiens pour vous motiver  \n\ud83e\udd47 Multijoueur en temps r\u00e9el avec des amis \n \ud83c\udf89 Mises \u00e0 jour mensuelles avec de nouvelles fonctionnalit\u00e9s  \n\ud83d\udeb4\u200d\u2640\ufe0f Fonctionne avec des rameurs, des v\u00e9los, des elliptiques ou sans aucun \u00e9quipement avec des"}, {"images": {"nodes": []}, "id": "776130968916170", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holofit: Make Your Fitness Fun", "keywords": ["Fitness", "Deporte", "Bicicleta", "Remo", "Entrenamiento"], "long_description": "Algunos lo llaman entrenamiento, nosotros lo llamamos juego.  \n\n\ud83e\ude90 M\u00e1s de 15 mundos virtuales: tropical, Par\u00eds, Ant\u00e1rtida, cyberpunk y muchos m\u00e1s.  \n\ud83d\udc5f Programas guiados de HIIT, quema de grasa y cardio.   \n\u2b50\ufe0f Retos mensuales y diarios para motivarte.  \n\ud83e\udd47 Multijugador en tiempo real con amigos u otros miembros.  \n\ud83c\udf89 Actualizaciones mensuales con nuevas funciones.  \n\ud83d\udeb4\u200d\u2640\ufe0f Funciona sin ning\u00fan equipo adicional, utilizando el peso corporal, o junto con m\u00e1quinas de remo, bicicletas y el\u00edpticas.   \n\ud83c\udd93 Prueba gratuita de 7 d\u00edas, sin compromiso.  \n\nEsta suscripci\u00f3n es v\u00e1lida solo para uso personal. Ponte en contacto con nosotros para obtener informaci\u00f3n sobre el uso comercial.  \n\nNota: Es posible que la conectividad Bluetooth no funcione en algunos dispositivos. Si tienes alguna pregunta, ponte en contacto con support@holodia.com. ", "short_description": "\ud83c\udd95 ACTUALIZACI\u00d3N: Nuevas HOLOmisiones, mundo Canyon, nuevo mundo pr\u00f3ximamente.  \n\n\ud83e\ude90 M\u00e1s de 15 mundos virtuales: Tropical, Par\u00eds, Ant\u00e1rtida, Cyberpunk y muchos m\u00e1s.  \n\ud83d\udc5f Programas guiados de HIIT, quema de grasa y cardio.   \n\u2b50\ufe0f Desaf\u00edos mensuales y diarios para motivarte.  \n\ud83e\udd47 Multijugador en tiempo real con amigos   \n\ud83c\udf89 Actualizaciones mensuales con nuevas funciones.  \n\ud83d\udeb4\u200d\u2640\ufe0f Funciona con m\u00e1quinas de remo, bicicletas, el\u00edpticas o sin ning\u00fan equipo, con ejercicios con el peso corpora"}]}, "developer_name": "Holodia", "developer_privacy_policy_url": "https://www.holodia.com/legal-notice-holodia-virtual-reality-biking-company/", "developer_terms_of_service_url": "https://www.holodia.com/terms-of-service/", "publisher_name": "Holodia", "support_website_url": "https://www.holodia.com/contact/", "website_url": "https://www.holodia.com/?utm_source=oculus&utm_medium=pdp&utm_campaign=website-link", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPLORATION", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "rec
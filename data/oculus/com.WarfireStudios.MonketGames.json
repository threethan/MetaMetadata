CzUHpS8MksHB9TwY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO7eSzLbtItUPspRxsLvpz5oSBCAbiHnyCTdyjmfBiNw&oe=6A8ED2AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monket Games", "keywords": [], "long_description": "Monket Games is an intense, fast-paced VR fan game inspired by Squid Game and Gorilla Tag. In this action-packed multiplayer experience, players take on monkey-like avatars and compete in a variety of classic and original mini-games with a thrilling elimination-style twist\n\nWith physics-based movement similar to GTAG, players must run, jump, climb, and swing their way through challenging arenas\u2014whether it\u2019s dodging obstacles in Red Light, Green Light, surviving Glass Bridge, or outlasting others in unique, monkey-themed challenges.\n\nCan you outplay, outmaneuver, and be the last Monket standing? Or will you fall to the chaos? Join the fun, survive the games, and claim victory in Monket Games VR!", "short_description": "Monket Games VR is an intense, fast-paced VR fan game inspired by Squid Game and Gorilla Tag. In this action-packed multiplayer experience, players take on monkey-like avatars and compete in a variety of classic and original mini-games with a thrilling elimination-style twist"}]}, "developer_name": null, "developer_privacy_policy_url": "https://m1dnight1274.wixsite.com/my-site-1", "developer_terms_of_service_url": null, "publisher_name": "M1dNight", "support_website_url": null, "website_url": "https://m1dnight1274.wixsite.com/monket-games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
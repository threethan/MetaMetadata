t=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyqffjp1cV3NK5-SS34uYzf0uxvUnQgh0L5I-DYSHO1UA&oe=69C11C71"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu1DKvOCj7wQ7kNvwFFFqTv&_nc_oc=AdpJqh4bYCl_hxygF6DqsXTenaAVhKJhugcXWRnWXRAc5NmTSYEV9T_FkYEC6JiuWAE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyU1PyminoNeAMt5Ae1BOwvfwEb2eFVxEmWngoEDIziZw&oe=69C141AA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQoVVOcFP0oQ7kNvwHK0gHW&_nc_oc=AdqaFvCzXVcYkm13L4Qn2opSt-HdisIy8pA1mqleyEThF3bJ-4c0AIaaxFAqcIODjpg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRTCNyp7uU5UzhiymsoK30kcwXl3U0Wb6U6ygD6DMzLg&oe=69C11FE5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwMl7vARypgQ7kNvwEemeaU&_nc_oc=AdpabXALLhdTml9QDerjsUcCHMOSZXDZJdi3ccbiTLaHp6RywilNwvmBvAuGxUTZKv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0wtwGmi2B_j2Bk5nRmjCF8YXnRaIkumpNQm-APrX_lg&oe=69C1312B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5-lClOlHNoQ7kNvwGbThXY&_nc_oc=AdqhlgabboOIqC4dqcuF2Cd--XqwEStstkdEsriSyc8_SdZSpJoN_P_0SRSMtxm3ybQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6Uqbcfj1Be3cToI9xWKcHFz73Fr6n2doQtVl8X0662Q&oe=69C1404F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
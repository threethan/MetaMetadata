r7i9m7pZdPiw_sPRRo8axguLJtv3W1bURsVOoozBg0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjjJbN0ii5SHTH_PZd08HqJp7ournji26qp9EipuzDlw&oe=69C66271"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rQr_VZRADcQ7kNvwFWVrQ5&_nc_oc=Adot4JMDxl74q-dBDv3RF4pbB8x6wmjYNbHR_-v3i_knZkw4elBpTTkn2Hmrj6pPMkM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4nA4qKoCl3o0A8ouPWDikQzHNgsd3Vmh1nr6EkyrtzQ&oe=69C687AA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd0tb19jWwMQ7kNvwG2_A0Q&_nc_oc=AdqZz1fZxyYnRRz4xGrey3IfjRZs7_PrZ-d-PMzG7euW97k8ci18Qg67zG0qCqoNb3Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYpVHz8_jS54xSZd9ce_FeepIAyPWmqFKGKq_Eah5ZnQ&oe=69C665E5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY94TqHuKzQQ7kNvwHLs482&_nc_oc=Adr9OzHR76iZ27zGCi4-Ew4qKO5VBg0c1-wdVUMA5xxEDVVDtHYJ4bBx-w3B3Pw_otU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrmPharvWpH9DXYbcn-glFCaWw2Nx2LGApbFsbP3rFPg&oe=69C6772B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sv_FyAS3h0Q7kNvwERVowl&_nc_oc=AdpZEdSQnhmUtD5Rb5Gv0p2-kCiBMKqOWX9lMLq_jvSdUJsjsbwQDcJ6eX5aBX6VR6A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYz8yFd--6OVDNa_SJDxJxwhO-oT81UrS8MJZei5OjfA&oe=69C6864F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": nu
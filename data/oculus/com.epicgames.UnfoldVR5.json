F8y2Ni8-fsAUJveA4n60nNtUKa5qP31cjIBxR3RBRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxByjH88N6JvsKyq-eZ40G1v8WAtHGZwfdH7Jy8TN1hNw&oe=69C90571"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rQr_VZRADcQ7kNvwHf1shb&_nc_oc=Adq_2oOpYee8E_2bsONQCJL2cji_AXX7vWinXdUTYrrnj7Diie0iGfAhjWaHG911vAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUFV_Uzusajez-spVNPU05N51EFFMSLtjbpDp_gRn6Tw&oe=69C92AAA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp3FBTTAnZgQ7kNvwGmO9q4&_nc_oc=AdqXjhAWjxY08U6h0byb6wF-XdvoJOkb-v9HZ3sHRKvK5F8UUkdIzJQOSk8FU22V9bE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGvdS1fg_IgvFGF_OUErcDkn69zbKE-PvXHLnhk5Ggpw&oe=69C908E5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY94TqHuKzQQ7kNvwHd5YwQ&_nc_oc=AdoXA2YgfZp0mu64j0Pdw32eNS2ze7iKGJaAZh4YtDNGtWsECaQdkvsyV6pDR95laLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUDcxRiQbiYfyj0mV3b1DOAbCcnZ4eywlsA5MSW_xbDg&oe=69C91A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSJ5aDQkiFYQ7kNvwEAgmU1&_nc_oc=AdqIkRyBWmfnq74Prn7PS1UVVhY55SG-Q3vqvRmc8yTwvWKUvafOfpQvDlP2OVdGdSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRC2bbIw7o_wWvur6ztE-GAPmXmM8v89fpQygeD7B6pw&oe=69C9294F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": nu
t=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfynWuMLmnYDYvT66bF2O9VLzzHhUTXqUop1ygQdDl-sww&oe=69BD27F1"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z-ynVCfYuAQ7kNvwE71ss7&_nc_oc=Adn3cibMiXG9ym7RT9S49RDj3G_YjxzEGKH_u5x0LQn4LrfP-zwuKkk-PQci7fAF3mA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCvaofFjWKcK2XKcjnznkJJsZ2htkwqYB-7-GCzYF9RQ&oe=69BD4D2A"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bY8KKRwlGcQ7kNvwFbW9Di&_nc_oc=AdmyxUhoE1sZxWMxW59lgTmQHJAzJfRiRDAuohZYwwLLxESPunShhwxH4bRQpkpy8_g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcojA0XBCThSiisc_o9qZyOqHZXv3q5w5HqnIAfQPaYg&oe=69BD2B65"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGoLuo2HXg0Q7kNvwHMPTqy&_nc_oc=Adncj7Io9jlbM2jOHG_Ug9h9btmbyuwWmyJY2r8qYwKw4ehQqpZ0YAH6FTN2nfiG534&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6jr8olAN_3zkVNvIpcs9hShg0JZKaEIfaSjd7sxa26g&oe=69BD3CAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7HR1-yJNbkQ7kNvwEHnjyW&_nc_oc=AdmPzcLUHK82IziyHM8CkpBwpsh4rei1pll2H9SFa6Zf7OrqcJFWBDu8IZzpB8WSrX8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKo6PGTu8VB8z_bM16gW_cou_56FBM1fguulzXZVNrNg&oe=69BD4BCF"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
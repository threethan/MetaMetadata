t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs4vb1K4rs-JCDg5bGVV2TX3GPyJVzvMu8y3Z6C9Hxrg&oe=69BFCAF1"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu1DKvOCj7wQ7kNvwHj03-E&_nc_oc=Adm3Gx_rRj6EAsHXMEfxA8a5fdp7NhZWtzkADnavsdf-yrkIC8J9RLTKGzCkvqAS0K4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9CiBNHG8fxKSk0V3ZHcWotOtlpABVQM3pEGKBqbPe9Q&oe=69BFF02A"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bY8KKRwlGcQ7kNvwFEUNKe&_nc_oc=Adl_LOaLn_lQ6_HUxLRAqD6PcXZPLjZ8I59aAfcFyf0-3sMQwl-oP9fu_P8GIWQix38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd5dyC0_f6qH8EdVkL_joNnwzE6Qb8so4Tm72deVF_kg&oe=69BFCE65"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwMl7vARypgQ7kNvwFu3jzN&_nc_oc=AdlMubs4i4Jh8AVZS63RB7RL2rec7nYmzBzGiKbSGDzpbTftuea8tFRypcV5poX0XzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwL5qx1cNcgPILPh-FWwZW79hSnFwMZ5CmS5iuzaS9tUQ&oe=69BFDFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7HR1-yJNbkQ7kNvwF9J0Q8&_nc_oc=AdnGp4e1f0nHi2Ybp0J9U8O0G5noAN0b-_OPyiypeu_VHLGOytZ5qrGSVIR1XyCf98o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgqSjorQvj9Yfnr_aae7zt09WVsWLTxxNxqU_R8ojCjA&oe=69BFEECF"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsXAIQX8TWRabiavokrbXHXu1OTd5V684FLuSI41R2OWg&oe=69A96171"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRWRNp3wU5IQ7kNvwHGQ2CM&_nc_oc=Adlmq6AZZ9N8UFKqCCj0hUhyjfhZVzpF1TEptBGx61IJys1m_VNK1sJMZsipeo_576g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2Xn7U30P1t3_4ZJplO9DqGJu9YyXDhNivg_Nrz2OnxA&oe=69A986AA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVuS6QJWUI4Q7kNvwEEs812&_nc_oc=Adk2k2v4qSmkbbxoSWEZg5v54vKZtMYR0w4ZCIEEIhIL-o96RM96tr7P-3mAKMiNW44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsGx2IyL8S_KwPAw5gzDg1b6a_tpA0jQy5qSaO0Srhwyg&oe=69A964E5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBeYdhLod7sQ7kNvwFXaphw&_nc_oc=Adk-JdbqDoRG9rGcgyi7E7X1lPqG2LYSx0Q2pmYCF-p8otLYASg4BP_uXDdoZ4lfeqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsjs0EQKFbDlG9L-5-FQhZoaNKowlkm3Obi7gGQsz_Nbw&oe=69A9762B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eFqdur4IDYQ7kNvwEHTPxo&_nc_oc=Adml3JjLQIpgIy1V3VwYGynFcRy26sxJMrB00jYE6q0PkhCuz-Er-TiIigCpYf555FQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftZcEqRb5j6WjKukV3jlXuyPeGud3LuphAl7kI274riOw&oe=69A9854F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
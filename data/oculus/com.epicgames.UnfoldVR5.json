t=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwaHqdX2NwqSFOl4fhL1uFHAENIAH10BvX27sWKhHo4rg&oe=69B29BF1"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atlJ-Ce4JTUQ7kNvwHnmTLH&_nc_oc=Adm5Cdc4i2zgTFdGkpkqgx4JmdVGSw41uxn8VDVtsM7L9Tg7CdRVU8Dt0OnW8LojIxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEp2d5kWY1LrdviSQEVLfVILqXJxg87xF8j8h6G4bQug&oe=69B2C12A"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdjWwdwUbtMQ7kNvwEdipyP&_nc_oc=AdkemZ2qssbmrLqyWORDsjA1t3lNAVurwxAW5vZGnRD8p2na9Lyp1ics5UM_91jl0xE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9u5SZc78ZBilyo8ErI8U_J_ptBc0K95ODLeBnOYktEg&oe=69B29F65"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1ytWeA8DakQ7kNvwGuv7Hz&_nc_oc=AdnhHW0LNoMgHSFhw4VRpZDF_BAIBhcCggjaZcSYhnPJvqbWAHwlsljDUxqre0i_sRI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6w2uoP75k5VC6T2cCmWrOn_6N0w1B_TwTqGxHMSZKqA&oe=69B2B0AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPxqFJqY7TQQ7kNvwEanwub&_nc_oc=AdlPbJW0iflUHRwDyxvlRZ_cRkpA-6DOkgflk75pZOFRel9gORnRCcNq7dsY7u3F9FY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUFOblO_hMuDlba1AK-cxq7axVsoU3G5-BrP6TemYfmA&oe=69B2BFCF"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
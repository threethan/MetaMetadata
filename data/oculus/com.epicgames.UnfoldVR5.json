t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWvdma8r91LNQawsH61SOQEijM9LxfAHk7J8mS2T8Rfg&oe=69BC0EB1"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z-ynVCfYuAQ7kNvwH_j5u6&_nc_oc=AdmbQPzgPl45qJp7t4QAJY689UjwCT03xoM0tV3pIb9DnDp7b7Lhhd5nN6Rdq696nQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4b4HRkwG1---LUQKp8r7e81HJJmV56ke0Sw378NJmPw&oe=69BBFBAA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p01gRGt7CtYQ7kNvwEA23Nd&_nc_oc=AdmhdUkhTmAokznj0zM_ZbDexArP53ie8nzwgOnE648IonLBCWXuBdu6xy1GkGat79g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzY3fjaU29Fh3-lcTWMQ_LZxlyu8-KNrvo5v8mQqq7Mjw&oe=69BC1225"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGoLuo2HXg0Q7kNvwGUIP7q&_nc_oc=AdkTVeAU5N9kiiaJFDH1RsjJmM9AXoeKmh6_dYKxZFv2lagAQ1GWVh5lHG2fCEYPss0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDbBQW6TD2iGHGv0TRqqad-Bpz3MrQHOrrK42rpqWWYA&oe=69BBEB2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z73UOLEmyBIQ7kNvwFAjCXM&_nc_oc=AdmVrK_aOVIijQmcIMjAL5e_GniD1X4S6wAWReqLGHrVGE9heEHhyPrWIOOkCn4fBfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxW99x5SjuKnsbRIFz8T_5FU4fJsivrjk7PQWQvNCAIwA&oe=69BBFA4F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytMZmMcyDjaf4JI_7wxlR5Y56BUUGXebLbarP28VddFA&oe=69B93371"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q3akyneJ9QQ7kNvwEpdGHR&_nc_oc=AdmurKimFJcCd_nuoTR5MYoyQv5bQFwPbfFf5C5_lPGVIvx1RYdmCMt6cuK52B050dA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs6BV2NqqhDnYfKJ_j0w1PuTYkrPAw5a6MqbGrovPv9Q&oe=69B958AA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p01gRGt7CtYQ7kNvwENIMtQ&_nc_oc=AdlX3R-wA91-jA_gEAfwTUXWwSxRU876SEXv7Z98jyfen13GL5l6u6_fRXUgcjyv0Gg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMgl60KDFgBCe1UlQ4Av8dFwCcmwONNpWmtoOHIf5G1A&oe=69B936E5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq-zduoR5WYQ7kNvwFzvmGJ&_nc_oc=AdkkNTiUVMzxid3lHMJF5LVgPayHUwKQrgEJg8fj-m9xnUSto9mlGXlSrgolcByLu8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkjPp_0qMkcM9RGeuPqlKznSImfj5HXXCIdFSTNs8o4g&oe=69B9482B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z73UOLEmyBIQ7kNvwHOkem3&_nc_oc=AdkvXQSfuicI9J8m_HD_Z_vkki3_dE0dJgHAYBJrPll03VE8TTBEoaV3MRy_U42JDMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwk-trXN50qYJp0AqwMQtxv1YngxeqDWyk39qis0NU2Nw&oe=69B9574F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
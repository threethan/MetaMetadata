t=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsSuRXg1IGBU49bqquuDvPdZn1kEWKk9o2rFVS542nKHQ&oe=69A80FF1"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRWRNp3wU5IQ7kNvwHbqHqs&_nc_oc=AdkmNO5AWkRX7KmeqpnbT0V-oRWEdBCjm8xEllNv1r04hniTngeMeDVKJtNOn1Fdqs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftiN0PFIh2TXNvD3LZHip30SQdRFfYfUdlvttwlKKP7Pg&oe=69A8352A"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD8rx0bAGAkQ7kNvwEz56Wu&_nc_oc=Admkjd2N6Qs1qJUt6QC0X_poVQzCcLtDhp8OiVQlvGWlegtIBAyt0KVhVhZsW4GdqNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvcDWKpZVCKhH8zK_GjTCeWJ4zGXTXfsIpTQQ8Q7LqpDA&oe=69A81365"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBeYdhLod7sQ7kNvwE5h75g&_nc_oc=AdmL19kCAp-R6alrnm026XZbdNnqrJ6dF0AQ-WFpnEB41l1lhPn069aG3NnyMUpn-xQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftU_MHce0g9vjxcrYW20OVszz-QYEYUl_MA_nwJm0HHuA&oe=69A824AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnsSHQNiWHAQ7kNvwHkp8BC&_nc_oc=AdnPjteDSBftncF2fCR-vhu-khJjFbf4U2F4HLgl1EI-xCQcFHhNDQZMV_4mc73rxPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvX12IutRp4qQik5WUDJF9yfwBo-_sKXMuuNRNGx_Liyg&oe=69A833CF"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
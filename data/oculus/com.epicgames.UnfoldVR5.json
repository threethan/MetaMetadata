t=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIOzDCgWsqKCDKUaneaa4sPbh1fKScHoF4Mm48KAus9w&oe=69BA84F1"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z-ynVCfYuAQ7kNvwH8QlKE&_nc_oc=AdlsHunSVC4iYGc3EvHF_j3Sawm7kKxUl7rhs1Xb_pQ6HrRYu3POfaLb-aehzPWXwvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2B9s0Jqbv3wcJ1B425CFwoh3I5YMu9I5igyI7zZYj-g&oe=69BAAA2A"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p01gRGt7CtYQ7kNvwHYOv8R&_nc_oc=AdlPSyT799jFJBj280L9ZYx9NJnB2K1uUoeLjUqmOXWQxb3mR8z_i-0RQJJUMlbnxF4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3ngMYY_yGkCYr1ZX384xfvovUtcAU_4f607oDBMWP1w&oe=69BA8865"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGoLuo2HXg0Q7kNvwH2leZ2&_nc_oc=Adl2qhSaPg2bGSYaXlzYoLB-5hl_G1apTEsJ2z3y3WHw_JzHU34R_4T1cp9c03kPCB0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3dLU7GPKB9AsLeBWMXx-5riutAyc4s7XC3HM53PBiJA&oe=69BA99AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z73UOLEmyBIQ7kNvwEStqTk&_nc_oc=AdllYHXf5Xa1NJ5ZNaG7WnbMBVjcR8mRB0pPTNLaIxEWJjWKDMLqomZtNlhPGyoUaiQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5btZG65I9q_tqWPB9Z-NSsMVFC0FYWmzeUnNdUj75kQ&oe=69BAA8CF"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
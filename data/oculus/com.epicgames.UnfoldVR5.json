t=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9h_KcHCy2f8xSpsZuWqSKifhmaCkjSTWx_voPIyHv6w&oe=69B14A71"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVnny7pxdugQ7kNvwFLn-1Q&_nc_oc=Admazq8Pdns1W3vWBkE54US1HOCdhf_BZs5iSINmukwdZ_A0oicQsrGT6aFBQ4IHR6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl_egBUzxt0lZAx5XLy6wC9niIcma7ilzMsdlGfV8V8w&oe=69B16FAA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdjWwdwUbtMQ7kNvwHVQlLO&_nc_oc=AdktbGjK61pGj4QC_ljr1RtM01xT1bBYAOafHpM7VCLuqjnDLuRXgTyhtwGMd5Wv0qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2UUTDCc_ao0xXVY4I50sn0vKuhc7AsU-pE5BWcak7eA&oe=69B14DE5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGcZdal3w8cQ7kNvwF4176Z&_nc_oc=AdlJzUet1ekNOxGr2A77wPz9ada8_QjGSFbGKmWgTgkkIUfcjnWvl4KPrGrcSTXdQbA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGyUQxzauA2M7gvlMWMf97G7VDi6BV3oJ0pVQQwzdnhA&oe=69B15F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPxqFJqY7TQQ7kNvwEoKgzR&_nc_oc=AdmgGRIJzjDkwkRTtLP1kBdioqK0St_wfRlEhsnVdmEnGuoN2MyH4yuq8340EOP_xaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfychPpuoYDt8gii1Pf8c1QlfGmJ51bjHjZ0S6YvTnhHRg&oe=69B16E4F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
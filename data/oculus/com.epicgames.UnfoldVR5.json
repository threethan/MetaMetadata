t=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa2SslJ4NNCHUMIBCAWMomYJSbsVb_tX3dHBOdLF0fHw&oe=69BE7971"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu1DKvOCj7wQ7kNvwFBPE6z&_nc_oc=AdnclIzXnCoU-kyrwHtt8IgjoCYJnacOPPWM9tcP-HiDndgjomIin4tDXgI2uApr-e0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzetJWChFs9j75th-FWX0m__Va1CqXn7i7M5tNh0-JXHQ&oe=69BE9EAA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bY8KKRwlGcQ7kNvwGRxp7O&_nc_oc=AdmgqymxnxrVNcvJ2dwmnQEwqveYp91X_UO-UJhEXdAPmhBjEah25cPL7FaLusCp5k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtQcvKsLm4vglO_rB7QBiDKjNjLGV3bEXG0SYxkLs0Aw&oe=69BE7CE5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwMl7vARypgQ7kNvwEju5Z2&_nc_oc=Adkr7z9650vBjJx8HJA_-dC57jztQeF2AYwdcwE_ehcHr1rP5ro0Q0UIFcHKf8kcDZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx5R8ekF8Nd89mwO-ySNdTW2E1KNOpp0fU8-fb0cVJUg&oe=69BE8E2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7HR1-yJNbkQ7kNvwEQT1QK&_nc_oc=AdnZJRN2h4M3rux98UvsSi5FiVXcwn8JTPAXscFWdR2fZ8t_EaWL_eVE42HWBYOAENk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs9b2Z0fgwY8Yat-5YEYM7JXhB92KmxSuqez7WZbLARA&oe=69BE9D4F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unf
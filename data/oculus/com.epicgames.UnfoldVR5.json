bPv8dzKTOCsGihtEW9oMQp4Kr6U3CQgVMa19UqbV0g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzjn62up4UaFsa7tV8HkLp1-yNkUWH5LZCLMh02JQoSg&oe=69C3BF71"}, {"file_name": "newss06.png", "id": "832771245636659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001662_832771248969992_7419383448759978925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXugbHkNvMsQ7kNvwEse_32&_nc_oc=AdqXpke-XYu5sWeeMDnP6CXgjSPNURF6AahDoaVjeaTQg_H5PfFOepK5ovonrmi1fy4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZp1yOFP9uUzH8q7HKcObJx8KBu4qm4QkSDeVP4sblJA&oe=69C3E4AA"}, {"file_name": "newSS03.png", "id": "8109082935839208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974689_8109082945839207_1895842965746061433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQoVVOcFP0oQ7kNvwGlKBhU&_nc_oc=AdqMyfTB1YJFK3t4YimYkB-a-FfRio16dY9kBTz0n8O08eIyAMhPHTOUhERd8Vzi9no&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxthUNQ7fKxzV__MwJFdMEMvazp5_BAbiq8tu4U1I41pg&oe=69C3C2E5"}, {"file_name": "newss04.png", "id": "8010643942306832", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031554_8010643952306831_1755293534683580490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IlSo6kqyHMQ7kNvwHze_X8&_nc_oc=AdpI9XlJ-pseJrogtto396kFriEtRHtBPogj8vNnDXvH4GYT-1vm8iZL_PeL2tdAYPY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxm4LVUd-p8tI19hF2ESfEeWfLrlBwQ7FjYo8Cw4KiDkg&oe=69C3D42B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailNEW2.png", "id": "396805850150855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974724_396805856817521_4419882606604565804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5-lClOlHNoQ7kNvwH2-CVg&_nc_oc=Adp0cfcWhUN1h780ZV33P4wi6h1q15MXZbiE-A3KKQOz-3JnqqBiyMBHqqx5gmoaOoY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxky9OEWpozcgi9YVTnhq-nEYi14Zop9XAi2FnGrml2hw&oe=69C3E34F"}, "display_name": "UnfoldVR", "keywords": ["voxel", "sandbox", "creative", "drawing", "blocks"], "long_description": "# NEW VR Charades mode launched!\n\n**UnfoldVR is a collaborative playground for Spatial Creators and Explorers!**\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\n**Multiplayer Mode is Live!** Play VR charades, meet and chat with other creatives, explore and rate other drawings - all with in-game voice chat!\n\n**Become a VR Storyteller!** Using the versatile Remix Drawing Feature you can add linked iterations of any Artwork. Piece together multiple drawings to tell your Story! Invite your audience to join in.\n\nAll Published Drawings are instantly available for others to explore on the Explore Page. You can Like, Love or Dislike another drawing and also Remix it and make it your own. \n\n**Super Easy, Super Intuitive!** We designed our drawing tools to be as logical as possible making drawing voxels a breeze. We're also actively listening to our community and taking feedback seriously. Join our discord to follow up on our development progress and leave any feedback our way. \n\nWe're actively developing UnfoldVR. The goal is to create a social sandbox platform. Where you create & explore amazing worlds, compete with others in interactive adventures and connect with people who share your passions!\n\nUnfoldVR. Cubes Just Got Awesome!", "short_description": "NEW VR Charades game mode launched!\n\nUnfoldVR is a collaborative playground for Spatial Creators and Explorers!\n\nIt's a very fast way to Create and Share voxel 3D models with the world! In minutes you can have your  Voxel art published or even exported as .obj file.\n\nMeet, Play VR Charades, or explore drawings with other creatives in our Multiplayer Map\n\nBuild using super simple, intuitive tools, dive right into the fun. Not sure what to build? Remix the best creations with your twist!\n"}]}, "developer_name": nu
=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ249VrYQMnCr8EN4wFjMY7NzHWYDZjAjhXBkV3yY2Bpg&oe=6AF9E5BC"}, {"file_name": "screenshot_08_boss_destroyed.png", "id": "2132308304830534", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823802_2132308308163867_2967679306940308832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flt9vExme3cQ7kNvwERrFMU&_nc_oc=AdqQ9wrjNG0S4zpQBVHvjADhrMzRh5hwtGg0aXTHG1dy3VLljcgTb0J2g9T4fnRZeyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS7yZM-G-kBMY0-psjAPOKpWjrEbdj-52rU5T9n1EBZA&oe=6AF9E37F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyart_A_boss_cover_fixed.png", "id": "1530467908830240", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825470_1530467915496906_5434914615521098684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf5-7_h6D9oQ7kNvwHeD1YL&_nc_oc=AdoRIv2D5x_eg6R2IiMeV7MB3hLLaDmRgPk7wRSomCS2QVMf3KFnQzK4Wtg5Oor_1dE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMRPr_nDmR3PLx820Fw0XkBcO4P4pJ0cLcDpMA9o-VAg&oe=6AF9C208"}, "display_name": "XGalaga VR", "keywords": ["arcade", "shooter", "retro", "space", "galaga"], "long_description": "XGalaga VR takes the classic fixed-shooter and hangs it in the middle of a living galaxy. Your playfield floats in front of you, wherever you want it, while planets turn, a starfield breathes and fighters bank past overhead.\n\nAll fifteen original waves are here, driven by a faithful reconstruction of the original game rules. Aliens fly in from deep space, take up formation and dive. Collect upgrades as they fall: double, triple and spread fire, extra bolts, machine fire, shields, smart bombs and extra lives. Grab a Nova for eight seconds of piercing fan fire.\n\nEvery tenth wave is a boss: one giant with escorts and minions that holds formation, fires in fans and lunges at you. Break it and it comes back ten percent tougher, forever. Beat your best score, then beat it again.\n\n- Play in deep space, or in your own room with full-colour passthrough\n- Move the screen anywhere with both grips; set its size and distance live\n- Pointer-driven command deck: point, click, play\n- Positional sound and an original soundtrack\n- Easy, Medium and Hard flight profiles\n- Seated or standing, no locomotion, comfortable for everyone", "short_description": "The arcade classic, surrounding you. All fifteen original waves in a living galaxy, with upgrades to collect, a boss every tenth wave that lunges at you, and a high score to beat. Play in deep space or in your own room with passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mwdesignprivacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": "https://mikewickens.github.io/xgalaga-vr/", "website_url": "https://mikewickens.github.io/xgalaga-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263293053538903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821704_4092982467664026_4469196102582996460_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmA6Ucfo7n4Q7kNvwFuIDNn&_nc_oc=AdpkS-rq0BiECezK3hrPkVucsIVeSUX39wDhmKFa9VBS5VJf0
25/491824292_1432586768824088_1755522330609314635_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzkLFgDjpicQ7kNvwHzNJHf&_nc_oc=AdrrzkJ6J2szHenhqDt9IhsVN5_6M96O7584t-IDRhesL0VhvwcVwuZAvdkswWqDIus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0HXI5gKunUhpf9Y7Jefz6uX_0vZiO6HeAHdHEafnkYA&oe=6B0F1836"}, {"file_name": "screenshot_01_deck.png", "id": "2056675562401844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827567_2056675565735177_7840253249956827605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIjvbWPysSMQ7kNvwE-jvVw&_nc_oc=Adper3_qMJn8XVJM7L09x174CE-guWAwx-hZtlziR25lO0lJiTSTCPQ6Jg0C9dQ1zXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0cIMBx0NjnarH44F-remuii7lmQbnCHgHfOrEWNpxqw&oe=6B0EFDBC"}, {"file_name": "screenshot_08_boss_destroyed.png", "id": "2132308304830534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_2132308308163867_2967679306940308832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOrn82iEsggQ7kNvwGjL-kJ&_nc_oc=AdpsUix95m75SYdKH8wbw3D7gmrUmk3ijHA-HNWj9I_inF9U75Nzh2fARGb7l_tQvdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrYAwj7dHtJKd-Ky-_6Xd5ktZ08cTBJZNG2kyHVCQd1w&oe=6B0EFB7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyart_A_boss_cover_fixed.png", "id": "1530467908830240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825470_1530467915496906_5434914615521098684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BfN8ElxLBUQ7kNvwGNpJWo&_nc_oc=Adr0Yt3iZ8djmGfOfWcMPPambt969RfmR_hqXY-4AqFlEmMpGs3j6x9YfUvXWnlFjFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6NSA3jMI4CU7MnsIKeyA5vnQD8neJOp-hWUGyDKOkEw&oe=6B0F1248"}, "display_name": "XGalaga VR", "keywords": ["arcade", "shooter", "retro", "space", "galaga"], "long_description": "XGalaga VR takes the classic fixed-shooter and hangs it in the middle of a living galaxy. Your playfield floats in front of you, wherever you want it, while planets turn, a starfield breathes and fighters bank past overhead.\n\nAll fifteen original waves are here, driven by a faithful reconstruction of the original game rules. Aliens fly in from deep space, take up formation and dive. Collect upgrades as they fall: double, triple and spread fire, extra bolts, machine fire, shields, smart bombs and extra lives. Grab a Nova for eight seconds of piercing fan fire.\n\nEvery tenth wave is a boss: one giant with escorts and minions that holds formation, fires in fans and lunges at you. Break it and it comes back ten percent tougher, forever. Beat your best score, then beat it again.\n\n- Play in deep space, or in your own room with full-colour passthrough\n- Move the screen anywhere with both grips; set its size and distance live\n- Pointer-driven command deck: point, click, play\n- Positional sound and an original soundtrack\n- Easy, Medium and Hard flight profiles\n- Seated or standing, no locomotion, comfortable for everyone", "short_description": "The arcade classic, surrounding you. All fifteen original waves in a living galaxy, with upgrades to collect, a boss every tenth wave that lunges at you, and a high score to beat. Play in deep space or in your own room with passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mwdesignprivacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": "https://mikewickens.github.io/xgalaga-vr/", "website_url": "https://mikewickens.github.io/xgalaga-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscripti
=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-6DVPzSuJNP1Vj5iD3AO4oRsMIH-f1yJHnbwopOSvbg&oe=6AF34E3C"}, {"file_name": "screenshot_08_boss_destroyed.png", "id": "2132308304830534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2132308308163867_2967679306940308832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjIo9ukb-6sQ7kNvwHKHnLz&_nc_oc=Adq0qBTTqQEQZl_W5rCBkCZpnX8rAW2JkmcQIqdCz252Rc1wP7dNYVLJrrK8kM3GyKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJDJpZG0X5AxpPyenVdx8bClH7ufD5m8MV_axOTRLivg&oe=6AF34BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyart_A_boss_cover_fixed.png", "id": "1530467908830240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_1530467915496906_5434914615521098684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt33T5vJsbIQ7kNvwHdUfNH&_nc_oc=AdrfMA12qbH6TP2gp34dXONDiyLsosp0F3AfVNZvIV3CC0Er3vAsVp2mDBKNZExSaPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNJnAxVbftBvNANZY5xv1F3eKzlgGkJfdVmgId851I8Q&oe=6AF32A88"}, "display_name": "XGalaga VR", "keywords": ["arcade", "shooter", "retro", "space", "galaga"], "long_description": "XGalaga VR takes the classic fixed-shooter and hangs it in the middle of a living galaxy. Your playfield floats in front of you, wherever you want it, while planets turn, a starfield breathes and fighters bank past overhead.\n\nAll fifteen original waves are here, driven by a faithful reconstruction of the original game rules. Aliens fly in from deep space, take up formation and dive. Collect upgrades as they fall: double, triple and spread fire, extra bolts, machine fire, shields, smart bombs and extra lives. Grab a Nova for eight seconds of piercing fan fire.\n\nEvery tenth wave is a boss: one giant with escorts and minions that holds formation, fires in fans and lunges at you. Break it and it comes back ten percent tougher, forever. Beat your best score, then beat it again.\n\n- Play in deep space, or in your own room with full-colour passthrough\n- Move the screen anywhere with both grips; set its size and distance live\n- Pointer-driven command deck: point, click, play\n- Positional sound and an original soundtrack\n- Easy, Medium and Hard flight profiles\n- Seated or standing, no locomotion, comfortable for everyone", "short_description": "The arcade classic, surrounding you. All fifteen original waves in a living galaxy, with upgrades to collect, a boss every tenth wave that lunges at you, and a high score to beat. Play in deep space or in your own room with passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mwdesignprivacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": "https://mikewickens.github.io/xgalaga-vr/", "website_url": "https://mikewickens.github.io/xgalaga-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1263293053538903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_4092982467664026_4469196102582996460_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHZrvW9YGKIQ7kNvwHl5NTj&_nc_oc=AdoBOLPr9ehpgabRgmmGaI8UsdPvk0Eh3ame0Uk1OXtkDA-u1
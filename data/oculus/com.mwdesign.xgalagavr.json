25/491824292_1432586768824088_1755522330609314635_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvtszOyT7uoQ7kNvwFWsIhy&_nc_oc=AdoFHFOVjYxYHDyk-e4z7a-vmbEkffESHtcjH8q6nbVY7AeWpG1kmu8iGSvdf69i9Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6Qw8JqD2XW9DjGYyuDXJB-SRIKJbalQ9jHlegB3iyEQ&oe=6B0DC6B6"}, {"file_name": "screenshot_01_deck.png", "id": "2056675562401844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_2056675565735177_7840253249956827605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIjvbWPysSMQ7kNvwEQ7APn&_nc_oc=AdqVtnQS8NdiyXWsCSS1V3FZQM0hCbHBZzJFAimyq20klMmGxgT35yDr2jPFhh1DoEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQ0RMw1P_pAQ-K3HRvuhjrzuptlBBR7MZgGWhj1s8wKA&oe=6B0DAC3C"}, {"file_name": "screenshot_08_boss_destroyed.png", "id": "2132308304830534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2132308308163867_2967679306940308832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOrn82iEsggQ7kNvwEB2xMU&_nc_oc=AdqR2yZrg5-wWdAjToi40bDX2zmbWcY_Qr0zfBhPMdbzWE4sHDBAha7Hdas3WfLu75o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSC5FPdHX8XWhecemSbpRzZ6mmRYaV43a9GjDXuK_kY7Q&oe=6B0DA9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyart_A_boss_cover_fixed.png", "id": "1530467908830240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1530467915496906_5434914615521098684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BfN8ElxLBUQ7kNvwFsLCsa&_nc_oc=AdoGeMAu0N2JNM9TME5gOGoR7HQ_bnsKMaAx0GuU4YqVVVc6p-XcSDlKgTqTVlkX0m0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqNHz75DeRF_vR7FyfYw0kHnm6HG5beEuadGUUJ2s7zQ&oe=6B0DC0C8"}, "display_name": "XGalaga VR", "keywords": ["arcade", "shooter", "retro", "space", "galaga"], "long_description": "XGalaga VR takes the classic fixed-shooter and hangs it in the middle of a living galaxy. Your playfield floats in front of you, wherever you want it, while planets turn, a starfield breathes and fighters bank past overhead.\n\nAll fifteen original waves are here, driven by a faithful reconstruction of the original game rules. Aliens fly in from deep space, take up formation and dive. Collect upgrades as they fall: double, triple and spread fire, extra bolts, machine fire, shields, smart bombs and extra lives. Grab a Nova for eight seconds of piercing fan fire.\n\nEvery tenth wave is a boss: one giant with escorts and minions that holds formation, fires in fans and lunges at you. Break it and it comes back ten percent tougher, forever. Beat your best score, then beat it again.\n\n- Play in deep space, or in your own room with full-colour passthrough\n- Move the screen anywhere with both grips; set its size and distance live\n- Pointer-driven command deck: point, click, play\n- Positional sound and an original soundtrack\n- Easy, Medium and Hard flight profiles\n- Seated or standing, no locomotion, comfortable for everyone", "short_description": "The arcade classic, surrounding you. All fifteen original waves in a living galaxy, with upgrades to collect, a boss every tenth wave that lunges at you, and a high score to beat. Play in deep space or in your own room with passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mwdesignprivacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": "https://mikewickens.github.io/xgalaga-vr/", "website_url": "https://mikewickens.github.io/xgalaga-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscripti
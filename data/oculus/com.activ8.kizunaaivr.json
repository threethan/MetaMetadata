t=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAh5p5e5pzEQ7kNvwE1b-6A&_nc_oc=Ado2rKYHQxLNxbJYnILF14gKWiZunoF26zNC65jI3aUhOQ47iZnmhAZhuPVdH2v0aTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KZwbV_E2WbDS7WETluKkNHmwU9FgRDPJ2XVdGvMKZ9A&oe=69DE3943"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hello.png", "id": "712376593019095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003226_712376596352428_8703783657411970236_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPdFWWbjTo8Q7kNvwFZRKf6&_nc_oc=Adr1U0iwaPbDhs_7ZYyWVxV9uhlR2-SqxRqgsYEHahjwvO-CU36BeAxlTwJQrwughQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07TzdtvAzVWxrWrq9HnAGBOfXAZoMCTAGmQ7J7snramQ&oe=69DE2D38"}, "display_name": "Kizuna AI - Touch the Beat!", "keywords": ["Rhythm\u3000Game", "Kizuna\u3000AI", "Touch\u3000the\u3000Beat"], "long_description": "In the game, you are an audience at Kizuna AI's performance stage. Feel the rhythm to the song and hit the notes that come flying towards you with your penlight. \nThere are various levels and note speeds. Try out the different difficulty levels that you prefer. \n\nOther functions:\n<VIEW >: To be able to watch the performance from a close distance, which only happens during the GAME mode when you reach certain combo milestones.\n<MOVIE>: Watch the 360-degree and 180-degree videos.\n*The MOVIE for\u300cmelty world(Prod. TeddyLoid)\u300dand\u300cHello, Morning(Prod. Nor)\u300dis the low-resolution version movies that you can watch for free on Kizuna AI's official YouTube.\n*The MOVIE for\u300cmirai\u300d\u300cthe MIRACLE\u300d\u300cAwakening\u300dand\u300cAgain\u300dis 180-degree simple videos of the Secret Sky Music Festival performance in the form of watching the stage from a fixed position. Please be advised that the other songs do not include the MOVIEs.", "short_description": "Watch Kizuna AI's stage performance and cheer her on from the front row seat and use the penlight to hit back the beat flying towards you. The better you play, the closer you can watch Kizuna AI's stage performance. Aim to get consecutive combos!\n*Now offering the free promotion!!\n*The 180\u00b0 and 360\u00b0 MOVIE which you can see for free now are the low-res versions of the official movies you can watch on her YouTube channel for free.\n"}]}, "developer_name": "Gemdrops, Inc.", "developer_privacy_policy_url": "https://activ8.co.jp/policy/", "developer_terms_of_service_url": null, "publisher_name": "Kizuna AI Inc.", "support_website_url": null, "website_url": "https://kizunaai.com/kizuna-ai-touch-the-beat/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "zh_TW", "zh_HK", "fr", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27850700171242383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86655522_1417927045047758_2131070167373881216_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JL-53aJL9EQ7kNvwGJeiNV&_nc_oc=AdrOUY7xlAKTE-uCVGcY3dr6u2EvV51aeFYTPahBmYKrK3CNhnOYi_vJDfNLIC5peUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WC56tDs22_VUkQ3b7OfbodQGvIfQkh0_67ihQpH1QXg&oe=69DE3ABB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kizuna AI - Touch the Beat!", "platform": "ANDROID
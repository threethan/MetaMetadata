t=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHgeaTywqpIQ7kNvwHsF6Mm&_nc_oc=AdpJOQPooHpYd1ie91TgU9PyNVGXmyeEsZQz8zGi1KU4pP8J7XORw-y1FOyUsXFzGD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS2Hv4SMj_3w3z7WMoZBa1hRmWK5tbsLLSVwHVxKo1LQ&oe=6A6B49C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hello.png", "id": "712376593019095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003226_712376596352428_8703783657411970236_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG01TPMhZPoQ7kNvwFSvvxk&_nc_oc=AdoK3Klj6YHf5cqvcYX_SsdfTpqr6zOIKfxu5IvieHn-ahyz-EAMP0iT7aPh8E92ohA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgiF6IzXovBU3co2d3YKO-wc2wgNKdC7nRcGuLjcVt_g&oe=6A6B3DB8"}, "display_name": "Kizuna AI - Touch the Beat!", "keywords": ["Rhythm\u3000Game", "Kizuna\u3000AI", "Touch\u3000the\u3000Beat"], "long_description": "In the game, you are an audience at Kizuna AI's performance stage. Feel the rhythm to the song and hit the notes that come flying towards you with your penlight. \nThere are various levels and note speeds. Try out the different difficulty levels that you prefer. \n\nOther functions:\n<VIEW >: To be able to watch the performance from a close distance, which only happens during the GAME mode when you reach certain combo milestones.\n<MOVIE>: Watch the 360-degree and 180-degree videos.\n*The MOVIE for\u300cmelty world(Prod. TeddyLoid)\u300dand\u300cHello, Morning(Prod. Nor)\u300dis the low-resolution version movies that you can watch for free on Kizuna AI's official YouTube.\n*The MOVIE for\u300cmirai\u300d\u300cthe MIRACLE\u300d\u300cAwakening\u300dand\u300cAgain\u300dis 180-degree simple videos of the Secret Sky Music Festival performance in the form of watching the stage from a fixed position. Please be advised that the other songs do not include the MOVIEs.", "short_description": "Watch Kizuna AI's stage performance and cheer her on from the front row seat and use the penlight to hit back the beat flying towards you. The better you play, the closer you can watch Kizuna AI's stage performance. Aim to get consecutive combos!\n*Now offering the free promotion!!\n*The 180\u00b0 and 360\u00b0 MOVIE which you can see for free now are the low-res versions of the official movies you can watch on her YouTube channel for free.\n"}]}, "developer_name": "Gemdrops, Inc.", "developer_privacy_policy_url": "https://activ8.co.jp/policy/", "developer_terms_of_service_url": null, "publisher_name": "Kizuna AI Inc.", "support_website_url": null, "website_url": "https://kizunaai.com/kizuna-ai-touch-the-beat/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "zh_TW", "zh_HK", "fr", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27850700171242383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86655522_1417927045047758_2131070167373881216_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWAu5lB1vi8Q7kNvwGeOXIl&_nc_oc=AdraLksEDvsf5-jtxaBfXYsEmNwO3fAlotGwkzYzgQ8pB69pSZlUdRoCv9H8XosjtZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDve86PsARBKhPUVKcTclrExOA7YOzUxYiHElCZU484dg&oe=6A6B4B3B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kizuna AI - Touch the Beat!", "platform": "ANDROID
t=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIpALCNcgKEQ7kNvwGPXNxk&_nc_oc=AdpxOqPMUISHbWUi9tIfuCtuxQFvtvdA8KZ7Van1y43lJb8XYoYlOgi2pq_SmAue_68&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpja3zEe3xYGA7lhTVSCoRxJhznW7kaVGOsULYxV7RUQ&oe=6AECB503"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kizuna AI - Touch the Beat!", "keywords": ["Rhythm\u3000Game", "Kizuna\u3000AI", "Touch\u3000the\u3000Beat"], "long_description": "In the game, you are an audience at Kizuna AI's performance stage. Feel the rhythm to the song and hit the notes that come flying towards you with your penlight. \nThere are various levels and note speeds. Try out the different difficulty levels that you prefer. \n\nOther functions:\n<VIEW >: To be able to watch the performance from a close distance, which only happens during the GAME mode when you reach certain combo milestones.\n<MOVIE>: Watch the 360-degree and 180-degree videos.\n*The MOVIE for\u300cmelty world(Prod. TeddyLoid)\u300dand\u300cHello, Morning(Prod. Nor)\u300dis the low-resolution version movies that you can watch for free on Kizuna AI's official YouTube.\n*The MOVIE for\u300cmirai\u300d\u300cthe MIRACLE\u300d\u300cAwakening\u300dand\u300cAgain\u300dis 180-degree simple videos of the Secret Sky Music Festival performance in the form of watching the stage from a fixed position. Please be advised that the other songs do not include the MOVIEs.", "short_description": "Watch Kizuna AI's stage performance and cheer her on from the front row seat and use the penlight to hit back the beat flying towards you. The better you play, the closer you can watch Kizuna AI's stage performance. Aim to get consecutive combos!\n*Now offering the free promotion!!\n*The 180\u00b0 and 360\u00b0 MOVIE which you can see for free now are the low-res versions of the official movies you can watch on her YouTube channel for free.\n"}]}, "developer_name": "Gemdrops, Inc.", "developer_privacy_policy_url": "https://activ8.co.jp/policy/", "developer_terms_of_service_url": null, "publisher_name": "Kizuna AI Inc.", "support_website_url": null, "website_url": "https://kizunaai.com/kizuna-ai-touch-the-beat/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "zh_TW", "zh_HK", "fr", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27850700171242383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86655522_1417927045047758_2131070167373881216_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcYpvFJ4MJkQ7kNvwEg_Rwr&_nc_oc=AdoxaaEIyrR8f2GH4oZ1fcdymLSsa52XWtCmzh6uxooVOWMUYEj9Y7I5ySEjztJKk74&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6770-4H9mo2_3gkWkB-pbOuc-AT1mNWDrN-lW-hZf0Q&oe=6AECB67B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kizuna AI - Touch the Beat!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1602514746, "lastRevision": {"nodes": [{"id": "143374697322590", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "38570
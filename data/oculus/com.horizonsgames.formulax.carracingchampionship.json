d aerodynamics for peak performance.\n\ud83c\udf0d Multiple Tracks & Environments: City streets, mountains, and high-tech racing arenas.\n\ud83c\udfae Arcade & Competitive Gameplay: Perfect for casual fun and hardcore racing fans alike.\n\ud83c\udfa8 Stunning Graphics & Realistic Physics: Feel the speed like never before!\nWhether you\u2019re a casual racer or a professional speedster, Formula X Car Racing 1F Championship delivers heart-pounding excitement at every turn. Are you ready to dominate the track and become a legend?", "short_description": "Race at top speed in Formula X Car Racing 1F Championship \u2013 be the ultimate racing legend!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27114668721450685"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1454878549324403"}, {"status": "PUBLISHED", "id": "889050107430780"}]}, "baseline_offer": {"id": "889050107430780"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "
no0MK5GniqgzFqbgaVbg04M7jgEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxEf1YTDTE7yrdUCecgbwwzriNunrVgRv5F0uFRvQ2Hg&oe=6A60D477"}, {"file_name": "migrated_image.png", "id": "256985215295530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162676_1596267863719641_2493871437572472832_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTslfxd2pesQ7kNvwGQOhhC&_nc_oc=AdqP5G1CUsK-InhP462FuxV0tcWSHaptwv09X2l-NLI_4QaCjFx17PTuQ5jWrLy6Xt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtxcwho7S5SfiBR1_1wpMZupRUoJT-8xtRaCHP5jnscw&oe=6A60C1CF"}, {"file_name": "migrated_image.png", "id": "219188252523146", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_344632745955762_2655651761712267264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hasox2Qh4UQ7kNvwHWsC6H&_nc_oc=Adoct9xGEOD7PnHTD4qf1Xh6xEp7zpDe9LGKK1oD7OFC8PZrGE98rrVyEQKg6PVP6MU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY9gSUFdQ4d632ZpDpbJWaoMad2dSzfh60v0AxMQxaAw&oe=6A60B11E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest: The Bird of Light", "keywords": ["visualnovel", "animation", "character", "anime", "FullDive"], "long_description": "The \u201cFullDive Novel\u201d:  Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nWith character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist.\n\n\u201cWhen you step into this forest, you lose one memory\u2026\u201d\nInnocent Forest is fantasy story about a girl called Luclei and the memories of her visitors.\nThe forest of lost memories: a place where they say you can forget one painful occurrence.\nKei, (voiced by Yusuke Kobayashi) a young man lost in the forest, encounters a mysterious girl named Luclei (voiced by Rina Hidaka) who lives among the woods and gathers a flock of birds. \nIt is through these birds the past, present and future of lost memories unfolds.", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nInnocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.innocentforest-privacypolicy-term.com/", "developer_terms_of_service_url": "http://www.innocentforest-privacypolicy-term.com/", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://www.fulldivenovel-innocentforest.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE", "MUSIC", "NARRATIVE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3447514162039498"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_202739470253850_7983228074407755776_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2-lbsB61GIQ7kNvwHvT2pr&_nc_oc=AdrUaj20-QsY6FiX-Ziy84bo9K2WQsZO3-sTiHw_hwgWT_2PwdMUU4k_lj92y_LcvQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwyKqKOAd-2jV-D_LHDzUcubBJBKB-piQrWGSYyH0AMA&oe=6A60D3BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Innocent Forest: The
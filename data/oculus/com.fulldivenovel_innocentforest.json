luscdn.com/v/t64.5771-25/11162676_1596267863719641_2493871437572472832_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iHaLpQuMaQQ7kNvwEAZp0k&_nc_oc=AdpcoEXRncAvvcltIRQHHqML5U4dFGgMfQjdn1Sy46f00Nc3QRalWmUCr501hsHsWPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YrNvelmvU6Npyn5ziv3XhDAdye2QI-VL4zySzw0lmXw&oe=69D8F74F"}, {"file_name": "migrated_image.png", "id": "219188252523146", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_344632745955762_2655651761712267264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJrA-ldrQlUQ7kNvwHZW_p_&_nc_oc=Adr8gqOfVgoyDf5FiJUDAnRFggvc0WGcUBEMZOOMUd2B-rysnyOTlih7R467aDmpcW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pE2vftRq7M2KvNKftzbfgtMZdEaaA5Q-S4RNFWcP_Cw&oe=69D8E69E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest: The Bird of Light", "keywords": ["visualnovel", "animation", "character", "anime", "FullDive"], "long_description": "The \u201cFullDive Novel\u201d:  Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nWith character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist.\n\n\u201cWhen you step into this forest, you lose one memory\u2026\u201d\nInnocent Forest is fantasy story about a girl called Luclei and the memories of her visitors.\nThe forest of lost memories: a place where they say you can forget one painful occurrence.\nKei, (voiced by Yusuke Kobayashi) a young man lost in the forest, encounters a mysterious girl named Luclei (voiced by Rina Hidaka) who lives among the woods and gathers a flock of birds. \nIt is through these birds the past, present and future of lost memories unfolds.", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nInnocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.innocentforest-privacypolicy-term.com/", "developer_terms_of_service_url": "http://www.innocentforest-privacypolicy-term.com/", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://www.fulldivenovel-innocentforest.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE", "MUSIC", "NARRATIVE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3447514162039498"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_202739470253850_7983228074407755776_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s51uE3pgWeoQ7kNvwHwKBvb&_nc_oc=Adohexu1ZfZAZ2yE8JBrWdKzAh7DLfYjGYI7AroyplbkchU4IN8rela0J-0_-WVvaco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ma85EfivWcmvzdV41CamawRDmkXwy67p708kJWYFHFQ&oe=69D9093F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Innocent Forest: The Bird of Light", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1500921044, "lastRevision": {"nodes": [{"id": "299594483785065", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
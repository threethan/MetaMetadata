m2Occ_j2rsjnrH8qfKZZtFxoe32c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGaqKzxWRdIvurxjSA3zuXlKtAah5nLQWJfDiUIjFp3w&oe=6A58EB77"}, {"file_name": "migrated_image.png", "id": "256985215295530", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162676_1596267863719641_2493871437572472832_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0TTUrqdnzwQ7kNvwEmYWB7&_nc_oc=Adp4ur0F6CEQ6pZLjV_b3mWbohAztjkzdXpaY0rvt4Wdz82hjLyHSaexAt0CzfFceIM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ78zrwZzm1yChNQWPD9XRAfAj3EflJCmH_NZ8Fdpd5A&oe=6A58D8CF"}, {"file_name": "migrated_image.png", "id": "219188252523146", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162718_344632745955762_2655651761712267264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NARc7jb36eMQ7kNvwGIxh5-&_nc_oc=AdoWsDXeOQPgcaKRbBdpBgGTJH2SLTOrjVCkReHYPoKrKuDd8hDW4nvUp8cXfbnp-sM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzhy71kf9h1E0mX45LEEPGVN0I7H3t-3ddtUq8JyiIOw&oe=6A58C81E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest: The Bird of Light", "keywords": ["visualnovel", "animation", "character", "anime", "FullDive"], "long_description": "The \u201cFullDive Novel\u201d:  Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nWith character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist.\n\n\u201cWhen you step into this forest, you lose one memory\u2026\u201d\nInnocent Forest is fantasy story about a girl called Luclei and the memories of her visitors.\nThe forest of lost memories: a place where they say you can forget one painful occurrence.\nKei, (voiced by Yusuke Kobayashi) a young man lost in the forest, encounters a mysterious girl named Luclei (voiced by Rina Hidaka) who lives among the woods and gathers a flock of birds. \nIt is through these birds the past, present and future of lost memories unfolds.", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nInnocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.innocentforest-privacypolicy-term.com/", "developer_terms_of_service_url": "http://www.innocentforest-privacypolicy-term.com/", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://www.fulldivenovel-innocentforest.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE", "MUSIC", "NARRATIVE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3447514162039498"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162704_202739470253850_7983228074407755776_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ksPOviW1_8Q7kNvwG9KAna&_nc_oc=AdoRSaP6Yp9esfX_8CbFJPIyY4qfiAHkZeb_now6jnMxOQRsBTqtrNMLoSKv_5TNiuE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuPGAMKXVTxlKqJsdAq2dGw558-478EWrE0gcdEgbPug&oe=6A58EABF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Innocent Forest: The
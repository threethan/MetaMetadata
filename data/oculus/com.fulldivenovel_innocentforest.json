88512_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dONCuRakTAQ7kNvwFrLptP&_nc_oc=AdqzCJuO8kbPt9e1DzrdDlrzeTFMkJlDAaONecPBn4-RUfUYfBSq0puqewU7Eu8cvuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVHYoBdC1BrkIkgyLYH-ulSKv1AqUU-E5DeC_GvRr1xQ&oe=6AE4AA77"}, {"file_name": "migrated_image.png", "id": "256985215295530", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162676_1596267863719641_2493871437572472832_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljnz2Fmm8yQQ7kNvwESrRqM&_nc_oc=Adpn2zL14_r_bms6nwrUua0gMIrrh81y0FSTscmGZHjigGP283fLSrHswJ3tlL4bdY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4D9BngA5cCEZE0OOlS3UDyigUUBYrqXGKFL5Tvqtzhw&oe=6AE497CF"}, {"file_name": "migrated_image.png", "id": "219188252523146", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162718_344632745955762_2655651761712267264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY0VW_HaOeMQ7kNvwEl7Nt8&_nc_oc=Adp2empR9WY6LiGd86sV5QVQOFBe1oL6TLX8VIqecEeocttRFedag3PGQWdvKo-eJRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfwec6L08e8mKMXwbDviedj6-KHEev5sy15SxBzEdVaw&oe=6AE4BF5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Innocent Forest: The Bird of Light", "keywords": ["visualnovel", "animation", "character", "anime", "FullDive"], "long_description": "The \u201cFullDive Novel\u201d:  Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nWith character dialogue voiced by high-profile voice actors, and illustrated pages turning into 360-degree VR animated scenes, you will be absorbed in the story, and feel as one with the protagonist.\n\n\u201cWhen you step into this forest, you lose one memory\u2026\u201d\nInnocent Forest is fantasy story about a girl called Luclei and the memories of her visitors.\nThe forest of lost memories: a place where they say you can forget one painful occurrence.\nKei, (voiced by Yusuke Kobayashi) a young man lost in the forest, encounters a mysterious girl named Luclei (voiced by Rina Hidaka) who lives among the woods and gathers a flock of birds. \nIt is through these birds the past, present and future of lost memories unfolds.", "short_description": "Visual Novels meets Virtual Reality in this ultimate immersive reading experience. \nInnocent Forest is a fantasy story about a girl called Luclei and the memories of those who visit her. With character dialogue voiced by high-profile voice actors, and 360 VR animated scenes, you will become absorbed in the story and feel as one with the protagonist."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.innocentforest-privacypolicy-term.com/", "developer_terms_of_service_url": "http://www.innocentforest-privacypolicy-term.com/", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://www.fulldivenovel-innocentforest.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MOVIE", "MUSIC", "NARRATIVE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3447514162039498"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_202739470253850_7983228074407755776_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFUVc3Id6HIQ7kNvwGJrmsC&_nc_oc=AdqQ0yRA8h-8NB1TrgjKTntaOxXY0-E9fPNLzAkVHkt2kNgyvjCkL8pNJ32eI0q_P0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmv5qHh0WgHDcGQBKS6k2eDpE7ndfZtOUy9PI7weQ1
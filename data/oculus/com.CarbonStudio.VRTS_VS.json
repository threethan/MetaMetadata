_nc_ohc=Sre0jKwUiqAQ7kNvwHA0Cow&_nc_oc=AdqBKaISIBpNBiVG7qzlvaS8yHwZijgE3xvrirDt5mnQe0HTx4M8g_Z82gE6X71mvl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFt-8J8kIpWLe6lc5VQd030ILvHJSgcd7fMPTDiQkbEw&oe=6AEA04E1"}, "display_name": "Arizona Truck Driver", "keywords": ["simulator", "driving", "car", "truck", "physic"], "long_description": "\ud83d\ude9a Explore. Deliver. Earn. Grow. Build your trucking dream in Truck Simulator Arizona!\n\nClimb into the cab and experience the full trucker life in VR. Explore a huge world inspired by Arizona, from long desert highways and major cities to scenic routes, changing weather, and unexpected road situations.\n{2940438059635043}\nStart with a single truck, take delivery jobs, earn money, and turn your small business into a growing transport company. Expand your HQ, buy new trucks, hire drivers, unlock new licenses, discover new regions, and take on bigger jobs as your company grows.\n\nMake your truck truly yours with 350+ customization items. Choose from 6 American and European trucks, personalize their look, and experience different handling and driving characteristics behind the wheel.\n{1395434862073874}\nTrucking is more than just driving. Refuel, wash, service, and repair your truck, interact with the cockpit, haul challenging cargo, and enjoy radio and audio channels during long journeys.\n\nExplore 12 regions across 3 different biomes, enjoy realistic driving physics, and discover 25+ hours of trucking adventures filled with progression, relaxing road trips, and new challenges.\n\n\ud83d\udd25 Start your engine, build your fleet, and become a legend of the Arizona highways!\n\n\n{2220155092178679}", "short_description": "\ud83d\ude9b JOIN OUR DISCORD & HIT THE ROAD WITH US!\nhttps://discord.com/invite/YK3yccnxM4\n\nStart with one truck. Build a trucking empire. Explore Arizona in VR, haul cargo, earn cash, customize your rig, unlock new regions, and grow your fleet. Cruise relaxing desert highways, face tough deliveries and changing weather, and enjoy the freedom of the open road. Grab the wheel, start your engine, and become Arizona\u2019s next trucking boss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://carbonstudio.pl/en/polityka-prywatnosci-arizona-truck-driver-en/", "developer_terms_of_service_url": null, "publisher_name": "Carbon Studio", "support_website_url": "https://www.carbonstudio.pl/contact/", "website_url": "http://carbonstudio.pl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8670558633021729"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1022223497554150"}]}, "baseline_offer": {"id": "1022223497554150"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792688400, "status": "PUBLISHED", "id": "1022223497554150"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29041031155547844", "version": "0.8.14"}, "id": "2135571463504100", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8670558623021730", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29041031155547844"}
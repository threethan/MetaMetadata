_sid=6e7a0a&_nc_ohc=7lntL2luEgAQ7kNvwGO2vj9&_nc_oc=AdpCcLVevRZNaswsOh5kmkZcmvbUpWeHHhqPiPDNwK6z7RHKRyiVgT7XFlVf4hDRSBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmq71DSZBuBiUtj5lYLrL92mzo3rdu0fUmR8v7lszcIA&oe=6AE9EAE5"}, {"file_name": "ATD_Screen_02_2560_x_1440.png", "id": "1268241598722992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_1268241605389658_2998498129846243007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux7eOEFf3NgQ7kNvwFQ9sBr&_nc_oc=AdqHtpZ1eaAIDntFTJPXpQB3RWVw_sGdF64tJNrssL2Fm9ys2pYPwxocG8IkqHm82_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVC5yIX2xDmYBvWt5mJ0d6cntCWmTwwBgWNfQ66s64xw&oe=6AE9EA35"}, {"file_name": "ATD_Screen_05_2560_x_1440.png", "id": "2931248647229258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_2931248650562591_1936455890332658975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paww2GpwOWIQ7kNvwEx66V4&_nc_oc=Ado0-QQLY3oulehWw5kHwMmENelQHZVTwE5v3qDYT04MkFdXyyBDMYtqlmbp8Cbd0-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqyZW0PH4zJOyD1HU4qrxVWuuihdRfIYvAG767UiqTgA&oe=6AE9DF41"}, {"file_name": "ATD_Screen_01_2560_x_1440.png", "id": "1733315404562223", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_1733315407895556_5952467847634950830_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gslrX9uf73MQ7kNvwEC63yd&_nc_oc=AdqI655cWHx1xB_0r9QS0XYXyFJhDdorjf1jjtJcBU1cthgtDr_ibAu3uiMCESthoLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZL3pWWEkmNAoi9AFPU3xQipHBu-YzaYok6-UMbYLYrQ&oe=6AE9FCFA"}, {"file_name": "ATD_Screen_04_2560_x_1440.png", "id": "1065609432996226", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_1065609439662892_87248964986931090_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUxGclcyP_0Q7kNvwFqGu4u&_nc_oc=AdqhtgDwjicVyNgDdea636ffo4PPR_CwabQWHtDBliuOL5FsBfTtd8miOQEqVhbQcOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzTp7pPW1EZQu11YLJpbifEaVbSXKJg2KFP1fJlZKUQg&oe=6AE9E365"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero2560x1440V3.png", "id": "1570604007392902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1570604010726235_717702441505081993_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sre0jKwUiqAQ7kNvwHA0Cow&_nc_oc=AdqBKaISIBpNBiVG7qzlvaS8yHwZijgE3xvrirDt5mnQe0HTx4M8g_Z82gE6X71mvl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFt-8J8kIpWLe6lc5VQd030ILvHJSgcd7fMPTDiQkbEw&oe=6AEA04E1"}, "display_name": "Arizona Truck Driver", "keywords": ["simulator", "driving", "car", "truck", "physic"], "long_description": "Your truck. Your road. Your American dream, in VR.\n\nClimb into the cab and live the full trucker life on Meta Quest 3 and 3S. Take delivery jobs across a world inspired by Arizona: long desert highways, cities and scenic routes, changing weather and unexpected situations on the road.\n{2940438059635043}\n\u2022 Drive 6 American and European trucks, each with its own handling\n\u2022 Plug in the trailer lines, refuel, wash, service and repair your truck with your own hands\n\u2022 Grow from a single truck into a trucking company: HQ, new trucks, licenses and bigger jobs\n\u2022 Explore 12 regions across 3 biomes, with 25+ hours of progression and relaxed road trips\n\u2022 Make it yours with 350+ customization items, an interactive cab and radio for the long hauls\n{1395434862073874}\nEARLY ACCESS\nThe game is fully playable today, and we keep building it together with players. Updates arrive regularly. Coming next:\n\u2022 Now: forklift and bulldozer cargo, sound upgrades\n\u2022 November: story update, new cargo, traffic and visual upgrades, air horn, ambient sounds\n\u2022 December: global leaderboard, winter events, daily and weekly events, trophies, Tucson\n\u2022 2027: maneuvering challenges, glove skins, hiring drivers, night driving, changing wheels\n\nThe full roadmap is in Updates. Plans can change, and your feedback decides a lot of what comes first. Report bugs and share ideas on our Discord: discord.gg/YK3yccnxM4\n\n{2220155092178679}\n{1752819515774516}", "short_description": "\ud83d\ude9b JOIN OUR DISCORD & HIT THE ROAD WITH US!\nhttps://discord.com/invite/YK3yccnxM4\n\nStart with one truck. Build a trucking empire. Explore Arizona in VR, haul cargo, earn cash, customize your rig, unlock new regions, and grow your fleet. Cruise relaxing desert highways, face tough deliveries and changing weather, and enjoy the freedom of the open road. Grab the wheel, start your engine, and become Arizona\u2019s next trucking boss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://carbonstudio.pl/en/polityka-prywatnosci-arizona-truck-driver-en/", "developer_terms_of_service_url": null, "publisher_name": "Carbon Studio", "support_website_url": "https://www.carbonstudio.pl/contact/", "website_url": "http://carbonstudio.pl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "es", "pt_BR", "it", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28985841394400154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_28505002439110100_2498546982417806844_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np6i5m1TfK4Q7kNvwGNuGQu&_n
g", "id": "422596403610506", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974924_422596406943839_2745392382726454647_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZH8axpX2eQQ7kNvwFZ5ivz&_nc_oc=AdrvaHwfOG4BWAkxPjIXyZHYls-lWGowD_lbIiZg4iWErmQsLtMD2Ljn-vyxRdrLLiM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr2VqgIukKYauC3OzLgDnEx-J2l-o4s4_HxKnX39OAQQ&oe=6AAE89CD"}, {"file_name": "ss1.png", "id": "3718700695018265", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38984459_3718700698351598_1318569168901487800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShYMGO2qHJcQ7kNvwGycBx2&_nc_oc=AdoR1PAmYgO1c225CA2As1weu1UJSrNOkCS2scFwvU01A7LXYTOJRzEobSkBYqdDbYM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHBvdKnwz3XEdeoJlETLPE91LD64sl_AAenc1Cqz9_yg&oe=6AAE86C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1533759374221023", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031587_1533759377554356_6966422538287816002_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9nDt24RskwQ7kNvwEVzxtA&_nc_oc=Adq2J_OWifGziNpXhbkFwaj2R5-76Ly368WddmZILqq4Z7P3NwVIiGk2reW2A-ZPlcs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSmPOOGJf0izMkdlpXFsL9cvygJgIDLtdShq8BNd4vnA&oe=6AAEB3A0"}, "display_name": "ImmersiveQstVR", "keywords": [], "long_description": "ImmersiveQst brings a next-gen Virtual Reality Platform for healthcare professionals to help them learn faster with better retention and efficiency. The VR training module\u2019s retention offers 5X efficiency compared to conventional sources. Healthcare professionals looking for hands-on modern technological training in Nursing, CNA( Certified Nursing Assistant) CCMA(Certified Clinical Medical Assistant) and PCT ( Patient Care Technician) can use our pathbreaking VR by ImmersiveQst and experience a Immersive learning world. \nVR training offered by us includes- \n\u2022 CPR \n\u2022 Hygiene training \n\u2022 IV training, various medical scenarios, Medication \n\u2022 First Aid \n... and many more skills and scenarios.", "short_description": "This is an Immersive learning VR platform for nursing students."}]}, "developer_name": "ImmersiveQst", "developer_privacy_policy_url": "https://immersiveqst.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ImmersiveQst", "support_website_url": null, "website_url": "http://immersiveqst.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8141718649188298"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8237806226246206", "version": "0.1.12"}, "id": "1415940342630464", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8126877044005792", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8237806226246206"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "14
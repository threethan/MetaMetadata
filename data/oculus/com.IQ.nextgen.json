giene training \n\u2022 IV training, various medical scenarios, Medication \n\u2022 First Aid \n... and many more skills and scenarios.", "short_description": "This is an Immersive learning VR platform for nursing students."}]}, "developer_name": "ImmersiveQst", "developer_privacy_policy_url": "https://immersiveqst.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ImmersiveQst", "support_website_url": null, "website_url": "http://immersiveqst.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8141718649188298"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8237806226246206", "version": "0.1.12"}, "id": "1415940342630464", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8126877044005792", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8237806226246206"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "14
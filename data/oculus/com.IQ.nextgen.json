v/t64.5771-25/39031587_1533759377554356_6966422538287816002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6iJ4H2k3pQQ7kNvwHtBXL-&_nc_oc=AdqzfCUq8-63gGxfckYCcT8Prbu9dU1HOvxvhXTN9stXgxDaYGLQY0PagIq5jGYezr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiew_Bp1rp997B_E1SzFGgMSFqXtwMkTDR0HRWHrRsZg&oe=6AFF1F20"}, "display_name": "ImmersiveQstVR", "keywords": [], "long_description": "ImmersiveQst brings a next-gen Virtual Reality Platform for healthcare professionals to help them learn faster with better retention and efficiency. The VR training module\u2019s retention offers 5X efficiency compared to conventional sources. Healthcare professionals looking for hands-on modern technological training in Nursing, CNA( Certified Nursing Assistant) CCMA(Certified Clinical Medical Assistant) and PCT ( Patient Care Technician) can use our pathbreaking VR by ImmersiveQst and experience a Immersive learning world. \nVR training offered by us includes- \n\u2022 CPR \n\u2022 Hygiene training \n\u2022 IV training, various medical scenarios, Medication \n\u2022 First Aid \n... and many more skills and scenarios.", "short_description": "This is an Immersive learning VR platform for nursing students."}]}, "developer_name": "ImmersiveQst", "developer_privacy_policy_url": "https://immersiveqst.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ImmersiveQst", "support_website_url": null, "website_url": "http://immersiveqst.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
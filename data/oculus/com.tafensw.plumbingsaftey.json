560x1440.png", "id": "1003673383901988", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031495_1003673387235321_2863088526016688718_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jklxRDfCdMQ7kNvwE_NSYa&_nc_oc=Adpg1VF8e574W2bAdqmm7unUtORiHREPzDzVU_kMpIgMI32NbDubAEl91Jp8mjrDz6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEyNKoAYBVHsit7op-7popojNkqm9qVOg3AZF3fdQLdA&oe=6AFC70CF"}, "display_name": "Plumbing Safety", "keywords": [], "long_description": "Plumbing Safety is a standalone experience that allows players to learn about, and test their knowledge of, electrical safety for plumbing, with a particular focus on cutting copper pipes. \n\nThe application is designed to teach players how to safely cut copper pipes, while avoiding any risk of electrocution. Players guided are through the process of safely cutting a copper pipe, using various tools throughout.\n\nOnce this guided section is complete, the player\u2019s is tested by completing the same process with no guidance. Feedback is given automatically as the player progresses. ", "short_description": "Plumbing Safety is designed to teach players how to safely cut copper pipes, while avoiding any risk of electrocution. Do you make the cut?"}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
wKLGzAPBlAziMtDPdOniDOTvJSW60xfCKEjwwUdC5edOEwpB4yxLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e9AuR26jymX_1QCr3d5N1_KyvXgoVQKZR1KvY1Cm4JA&oe=6A341266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "plumbing_safety_2560x1440.png", "id": "1003673383901988", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031495_1003673387235321_2863088526016688718_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivKlqqsbegcQ7kNvwF-zpSm&_nc_oc=AdoLTa1OQCICI_vtAoH_ENBC6tcLsMumDvRcWSu7wila6Jdc2U0RNOYmC6dmcJpLgw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UHU74uSQ3Mj5YGMIW7cFTnpX0raCEWL4pKKirtE9Kuw&oe=6A340CCF"}, "display_name": "Plumbing Safety", "keywords": [], "long_description": "Plumbing Safety is a standalone experience that allows anyone to explore, learn about and test their knowledge of electrical safety for plumbing, with a particular focus on cutting copper pipes. Players are guided through the process of safely cutting a copper pipe using various tools, followed by an unguided assessment section. Feedback is given automatically as the player progresses through the experience.", "short_description": "Plumbing Safety is designed to teach players how to safely cut copper pipes, while avoiding any risk of electrocution. Do you make the cut?"}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
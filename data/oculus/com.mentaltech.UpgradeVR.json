_ftFUQ7kNvwF0ZZDi&_nc_oc=Adr4Mc5cJnX86kUFjp6TcNNOAdIOOS2xoMnmlVDAWnZha4NgSL5IXTtGVe06xXEyH4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EVfFsoBKfB7XsMI5L_XogZ8xMO7pvP11WClGOgrifUA&oe=6A298A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPGRADE_VideoCover.png", "id": "456245369483804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035406_456245376150470_4810981854464787811_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg6BUxZ_i48Q7kNvwFK7YIv&_nc_oc=AdoY4j2GbipWvZocer0Ee2tQTjSF1WQf0qfV20WJTVEiYJZj7vMfhnFe0lAaQ4P2eYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DyhYEqmV96fEGa1ddUeVWxVggfU7eosJ5Uxm3QGte3Q&oe=6A2982DE"}, "display_name": "Upgrade VR", "keywords": [], "long_description": "Developed by neuropsychologists, UPGRADE VR is a fun, simple training routine that helps you test and hone your brain\u2019s cognitive skills.\n\nExercise with UPGRADE VR every day to improve your cognitive skills, such as:\n\n- memory\n- concentration and attention span\n- reaction\n- eye-hand coordination\n- stress tolerance\n\nOur entertaining and engaging workout only takes 10\u202615 minutes a day. Training feels like playing a game!\n\nTrack your progress in our mobile app UPGRADE VR where  you can review your achievements, read interesting news about brain-related research and the latest discoveries in neuropsychology.\n\nNote that cognitive training could be a useful addition to comprehensive COVID-19 recovery regimen.\n\nUPGRADE your brain now!\n", "short_description": "Developed by neuropsychologists, UPGRADE VR is a fun, simple training routine that helps you test and hone your brain\u2019s cognitive skills.\nThis cognitive VR-training could be a useful addition to comprehensive COVID-19 recovery regimen.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr-upgrade.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "UPGRADE VR \u2013 FZC
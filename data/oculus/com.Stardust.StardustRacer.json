_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm0PMP8CCr1Tcd9-c9X3NViSmhAC1T027GwpbXkiOcDw&oe=6AFDBA2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner high res.png", "id": "1129485589771835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623565_1129485593105168_9065539824552358179_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3W4Stlar98Q7kNvwG61rZK&_nc_oc=AdoRJokZXluikxBfi9_qfeESwp8iV19fmTVuej7i_eH3igfhyQZse7DJHDCKt78XJ_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF8wY2LL5_8WkC4Cyo9OkzniddNMeW7lkUUjPTU4Qk8g&oe=6AFDB096"}, "display_name": "Stardust Racer", "keywords": ["parkour", "dodging", "space", "hoverboard", "racing"], "long_description": "SURF THE NEON COSMOS AT LIGHTSPEED!\n\nHop on your anti-grav hoverboard and carve through a procedurally generated \nmetropolis suspended in deep space. Dodge high-voltage laser gates, hurdle energy \nbarriers, and bank across 3 high-speed sky-rails in pure adrenaline flow.\n\n\u26a1 PURE ADRENALINE FLOW\n   Instant-response rail hopping and ducking designed for zero VR motion sickness.\n\n\ud83c\udf0c ENDLESS CYBER SKYLINES\n   Race through an evolving space canyon with procedural skyscrapers, stardust mist, \n   and deep-space nebulas.\n\n\ud83d\udef9 CUSTOMIZE YOUR RIDE\n   Collect golden Stardust to unlock sleek hoverboards, cyber visors, and neon particle trails.\n\n\ud83c\udfa7 PULSING SYNTH RETROWAVE\n   Fully dynamic audio that pulses to the speed and intensity of your run.\n\n*Comfort Rating: Comfortable (Engineered with stable horizon physics for all VR players).*\n", "short_description": "Stardust Racer is a high-speed, zero-nausea VR endless runner built for Meta Quest standalone headsets. Players ride a futuristic hoverboard through a procedurally generated cosmic track, dodging obstacles and collecting Stardust coins in an immersive deep-space environment.\n\nThe game is in it's beta state so textures might feel a little low-res. Improvements will be made to it shortly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-policy-for-stardust-racer.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Sameer Abrar", "support_website_url": null, "website_url": "https://github.com/Flexcrit", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337323856134286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_4585482805062841_2755363617441291859_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsVN2Qztt6oQ7kNvwGb_8i7&_nc_oc=AdoDubCsrN8zsU64Nmo5sji-qKYyNQ3dvjw9ezahBWeEinnwd8gvMBDVZPoLLvt05uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyLgPKDV1iyr4WCzBz3NO70bQy3Gtix-pcxQKA-AhXhA&oe=6AFDB6AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stardust Racer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1791910560, "lastRevision": {"nodes": [{"id": "1319727114560627", "release_type": "SCHEDULED", "administration_status": "A
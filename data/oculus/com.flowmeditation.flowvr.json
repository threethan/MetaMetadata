W7G8FM2zUAQ7kNvwFTe3B2&_nc_oc=AdrO74o73_YZewx2FUBeqHJ2W_YLmT0qNHOvtpSAdcQ9lJTUVlU_M3m90VfyB0uNszI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mmxNf7RLUnK0MXEMSE6Yai4v74OQLFWex-gsZdppGLg&oe=6A259D89"}, {"file_name": "migrated_image.png", "id": "207776113777383", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162763_900047566828388_1414691098349010944_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjVLCD-_3CAQ7kNvwH4e3Tf&_nc_oc=AdqW6V0MNcpYWoICrPyT-IM3w2x9E3uoRUMKybYVWKQ0JgfOkmlxxsp97EM_meOmx9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KWMb822mjacIKv2OU2-sQdzu7GHstr_vGIZUhAieDIw&oe=6A259404"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FlowVR", "keywords": ["Meditation", "Therapy", "Music", "Nature", "Wellness"], "long_description": "Meditate whenever, wherever you are by being transported to a world of wonder. Tap into meditation\u2019s infinite benefits through a virtual reality experience of unparalleled quality with 4K 360\u00b0video, amazing music and quality guided meditation. \n\nYou can experience the gifts of meditation from your very first try. Learn to expand your meditation through our four modes: 1. Breath, 2. Focus, 3. Movement, and 4. Calm. \n\nIn just 4 minutes you can access more of what you are looking for in meditation, for example, more calm, focus, and energy.\n\nOur mission is to provide a meditation platform that gives access to progressive, accessible and powerful modern tools. \nCreated in Iceland, and inspired by Iceland\u2019s vast untouched nature, this virtual reality meditation has the power to change lives. \n\nMeditate. Grow. Inspire others.", "short_description": "Meditate whenever, wherever you are by being transported to a world of wonder. Tap into meditation\u2019s infinite benefits through a virtual reality experience of unparalleled quality with 4K 360\u00b0video, amazing music and quality guided meditation. \n\nYou can experience the gifts of meditation from your very first try. \n\nIn just 4 minutes you can access more of what you are looking for in meditation, for example, more calm, focus, and energy.\n\nMeditate. Grow. Inspire others."}]}, "developer_name": "Breach", "developer_privacy_policy_url": "http://flow.is/privacy-policy/", "developer_terms_of_service_url": "http://flow.is/terms-of-service/", "publisher_name": "FLOW Meditation", "support_website_url": null, "website_url": "http://flow.is/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "EXPLORATION", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "608774996884171"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "343079873627493"}, {"status": "PUBLISHED", "id": "268683877337511"}, {"status": "PUBLISHED", "id": "441333833326809"}, {"status": "CANCELLED", "id": "1941819299470477"}, {"status": "PUBLISHED", "id": "454371411778796"}]}, "baseline_offer": {"id": "343079873627493"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1602280725, "status": "PUBLISHED", "id": "343079873627493"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3342235939178116", "version": "2.0.2"}, "id": "1761228214168537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application"
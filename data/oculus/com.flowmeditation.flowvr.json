05&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYw4U_GsggoQ7kNvwEsVy76&_nc_oc=AdpYNf3I1vjPeelWPq2ZTisqtaR-Sc5-vhh0ynbp5EmFQXyVEZ5LjFFeH8Svj6Wqmqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2dPuCUE7dD5nDSFOXhHSo_4P0p2ZLkHzLMJWqGw6yQrA&oe=69F0CC5C"}, {"file_name": "Menu_Calm_2.png", "id": "751988035656104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001727_751988038989437_6805975984856689367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Lzf9yUqHhAQ7kNvwG9cQK2&_nc_oc=Ado0xhZLd0G-57FxfqMsuE-6AlalOqPJ8PzBkiQAewbMHyTArLeCYeymrIWwhynEAT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af10TboDBSgcSPoEg2XdcYVzhcMmNae85Vp4i-QQ_1rt9Q&oe=69F09E5B"}, {"file_name": "Menu_Breathe_3.png", "id": "619501105398872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207237_619501108732205_7619529618197854481_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acgCESP5G3cQ7kNvwH-XtAO&_nc_oc=AdqpvPLqmisBY0DM_R2r2TPJyevygQMXgiTGpML8R6DrLbpy_VL32wKhFdLJGfarYr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0M_Pb5NC-nPn1F7sdzbeT8sNZIYIgHVm-6cSjFh51TSw&oe=69F0CFDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC08419.png", "id": "1257474627926372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982645_1257474631259705_7127465445463891458_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPOipkb8tSkQ7kNvwF-OuAW&_nc_oc=AdqIO8LJDB6oWZyeRpzhwFfWcRqStzXu5sFsEQFpTqtv3MrMPGLDWDFGfrnsBs5e11g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1r2aLD_tw4UQOc21MdDkwYSCPuvXhP8OnbLlhtxLzecQ&oe=69F0ADAB"}, "display_name": "Flow", "keywords": ["Meditation", "Therapy", "Relaxation", "Nature", "Mindfulness"], "long_description": "Access the proven benefits of meditation from your very first try. Tap into meditation\u2019s infinite gifts through a virtual reality experience of unparalleled quality with immersive pure Icelandic nature scenes, carefully curated music and the highest quality guided meditations.\n\nWith each session you experience your very own meditation retreat in Iceland where you gain more of what you are looking for in meditation - for example, more calm, focus, and energy.\n\nWith continued practice, expand your meditation skills through the six modes of Flow.\n\nFlow provides a meditation platform with personalised, progressive and powerful modern tools. Created in Iceland, and inspired by Iceland\u2019s vast untouched nature, this virtual reality meditation has the power to change lives.\n\nMeditate. Grow. Inspire others. Go with the Flow - Meditation for modern life!", "short_description": "Access the proven benefits of meditation from your very first try. Tap into meditation\u2019s infinite gifts through a virtual reality experience of unparalleled quality with immersive pure Icelandic nature scenes, carefully curated music and the highest quality guided meditations."}]}, "developer_name": "Flow", "developer_privacy_policy_url": "http://flow.is/privacy-policy/", "developer_terms_of_service_url": "http://flow.is/terms-of-service/", "publisher_name": "Flow", "support_website_url": null, "website_url": "http://flow.is/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "is"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4738144302967948"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_787185825415208_6889798518682183261_n.png?stp=dst-png_s360x360&_nc_cat=108&
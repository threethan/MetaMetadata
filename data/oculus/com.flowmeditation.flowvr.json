19", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031315_333074794663052_3512127702799904247_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElXiLr1-jKAQ7kNvwE8NwNC&_nc_oc=AdryZi-DeXoURD2M0bdRwCiJgMQlX4cxibXlEm2Qkx5FvP2Bs_T1CgTh_uaqYJyUdbo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGV9p28A7oxIMo8PnX-j3sS506elu7P1beEO18I3yirA&oe=6A7DA49C"}, {"file_name": "Menu_Calm_2.png", "id": "751988035656104", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001727_751988038989437_6805975984856689367_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdCL-U-0smEQ7kNvwHhKyFo&_nc_oc=AdrTSO2ZRCKXyL0akK0NS1DaB9p_o4XT6Ik-16xRX9OEYqvhSEj306DD-W45lCxSKpM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQsqmlC9z9hdIaJEpV69JbAQIGDTpXFsP2CpEC1Ev25g&oe=6A7DAEDB"}, {"file_name": "Menu_Breathe_3.png", "id": "619501105398872", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75207237_619501108732205_7619529618197854481_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WFBWdzJaToQ7kNvwE3SXlN&_nc_oc=AdpIXKXey78q3YnbmCswom2BGtxcIBOiVPr1ICG86PmL962r_Vyu_iMIaRl0_VP7jDc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfjg06QKl9FwZshsER0WSec7RpmrNHj4jJLcMR6XwrVw&oe=6A7DA81C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC08419.png", "id": "1257474627926372", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982645_1257474631259705_7127465445463891458_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNZ7vrGgXE8Q7kNvwFpdunF&_nc_oc=AdoUCsezwu2tze27PIRt7grNn6_trXEIVkG84flSCbaNbvjjhfLFg9aRFKM88K1HOYI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeNf7smUJ1SiTyVTbSTUfHjQ0CR9He-yGmXga1d0DS8g&oe=6A7DBE2B"}, "display_name": "Flow", "keywords": ["Meditation", "Therapy", "Relaxation", "Nature", "Mindfulness"], "long_description": "Access the proven benefits of meditation from your very first try. Tap into meditation\u2019s infinite gifts through a virtual reality experience of unparalleled quality with immersive pure Icelandic nature scenes, carefully curated music and the highest quality guided meditations.\n\nWith each session you experience your very own meditation retreat in Iceland where you gain more of what you are looking for in meditation - for example, more calm, focus, and energy.\n\nWith continued practice, expand your meditation skills through the six modes of Flow.\n\nFlow provides a meditation platform with personalised, progressive and powerful modern tools. Created in Iceland, and inspired by Iceland\u2019s vast untouched nature, this virtual reality meditation has the power to change lives.\n\nMeditate. Grow. Inspire others. Go with the Flow - Meditation for modern life!", "short_description": "Access the proven benefits of meditation from your very first try. Tap into meditation\u2019s infinite gifts through a virtual reality experience of unparalleled quality with immersive pure Icelandic nature scenes, carefully curated music and the highest quality guided meditations."}]}, "developer_name": "Flow", "developer_privacy_policy_url": "http://flow.is/privacy-policy/", "developer_terms_of_service_url": "http://flow.is/terms-of-service/", "publisher_name": "Flow", "support_website_url": null, "website_url": "http://flow.is/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "is"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4738144302967948"}, "review_messag
QAzfYLlLyr-fRq70M3ANU3_JQEtQrWFnXia0Ga0VxFukg&oe=6A68AA92"}, {"file_name": "screenshot4.png", "id": "1078034953591259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974779_1078034956924592_4483564050662264505_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mABb-MSs9_cQ7kNvwGKZ80Q&_nc_oc=Adr_Te1TORKEy7fABlqWGKPp-tiwdnd-YD-7hs82DMHQrhDU-a4-cPwd1w8SZ1hYAfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5QhfkhBYtlA_Vzc3jgCIjuZKDqPYGWP0pPFoCU1Ad1w&oe=6A68A2CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloATC", "keywords": [], "long_description": "This app show live air traffic from a number of airports all around the world. It is indented to be used with hand tracking only. It uses. Initially you are asked select an airport, then select a place for the airport center. Press fingers and thumb together to place the airport. Then you can watch air traffic. More options are in the hand menu (hold hand up with palm towards you).\nYou can also see aircraft pictures by looking at a plane for 3 seconds, and select a single airplane to follow. This will be shared in all headsets watching this airport.", "short_description": "Watch live air traffic control from a host of airports all over the world, right in your living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.schaikweb.net/HoloATC/holoatc_pp_en.html", "developer_terms_of_service_url": null, "publisher_name": "Joost van Schaik", "support_website_url": null, "website_url": "https://localjoost.github.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recom
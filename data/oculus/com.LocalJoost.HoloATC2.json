culuscdn.com/v/t64.5771-25/57570306_659358622609027_8220325365912306423_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVi8_2o6Ok8Q7kNvwE1xZaW&_nc_oc=AdoK5ZVqSR3kE_trlUsTKCDGzQ7Z5IJkf4BxnW3h4U_J0J21X_V9WiU90aN9cVhMR6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdHYC3A-ptco3KLt1FH7iBbfsz8lS9LI1yirXviYbWLw&oe=6B032252"}, {"file_name": "screenshot4.png", "id": "1078034953591259", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974779_1078034956924592_4483564050662264505_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iC-8V6CIncQ7kNvwEjp_RC&_nc_oc=Adoj9L44rChStlNFQu0w7XClNnDYZ9Fy1B3KClGXql2-lJtN6uJ9A6n4jNZWNtNZkuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM-x5Fp9H7parcHeagWTISv_WUMUdm_DMMOrjWwT9xLQ&oe=6B031A8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloATC", "keywords": [], "long_description": "This app show live air traffic from a number of airports all around the world. It is indented to be used with hand tracking only. It uses. Initially you are asked select an airport, then select a place for the airport center. Press fingers and thumb together to place the airport. Then you can watch air traffic. More options are in the hand menu (hold hand up with palm towards you).\nYou can also see aircraft pictures by looking at a plane for 3 seconds, and select a single airplane to follow. This will be shared in all headsets watching this airport.", "short_description": "Watch live air traffic control from a host of airports all over the world, right in your living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.schaikweb.net/HoloATC/holoatc_pp_en.html", "developer_terms_of_service_url": null, "publisher_name": "Joost van Schaik", "support_website_url": null, "website_url": "https://localjoost.github.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
culuscdn.com/v/t64.5771-25/57570306_659358622609027_8220325365912306423_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lw09UllSWAQ7kNvwGfKRHl&_nc_oc=AdoXSOid_efF4qhEk9TP3FH1SXGgIJUS7_XCd-LvjNLOjmOmyWQBnuzrW3kHDDZU3i4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAT9wYXMVozDPqkQkGD7ThujXRc2AzJIAptyfmhJS4TQ&oe=6AFF2DD2"}, {"file_name": "screenshot4.png", "id": "1078034953591259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974779_1078034956924592_4483564050662264505_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpHjwhBi690Q7kNvwE27zNo&_nc_oc=AdohPvb36vTQ2srPWhUTSQJ58cSiPACPCoIkKZ1YKF3_Vpwm_EwqTQ-JVBdrfcGmCjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs3KUzRDNZFg_ro3NIB0QYUOeNkCTax4kyu2rvROaeww&oe=6AFF260F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloATC", "keywords": [], "long_description": "This app show live air traffic from a number of airports all around the world. It is indented to be used with hand tracking only. It uses. Initially you are asked select an airport, then select a place for the airport center. Press fingers and thumb together to place the airport. Then you can watch air traffic. More options are in the hand menu (hold hand up with palm towards you).\nYou can also see aircraft pictures by looking at a plane for 3 seconds, and select a single airplane to follow. This will be shared in all headsets watching this airport.", "short_description": "Watch live air traffic control from a host of airports all over the world, right in your living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.schaikweb.net/HoloATC/holoatc_pp_en.html", "developer_terms_of_service_url": null, "publisher_name": "Joost van Schaik", "support_website_url": null, "website_url": "https://localjoost.github.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
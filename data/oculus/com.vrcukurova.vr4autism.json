PoyV_xw-lWGJ6lnX0DuduDzFfSLqKwF6zRuX54fbVhFasUH3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bipbFftgWXDL7JYHlHmeP0hH5o2_RxOJB5E4eQg5gDA&oe=6A1DA936"}, {"file_name": "MathWithApple-2.png", "id": "1206369397681056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828087_1206369401014389_4937983546596103131_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQwL17Zg4MsQ7kNvwGKdN-J&_nc_oc=AdqP0HY7By8nj1_AbO0nVINFMhPzBcWMU4DZDJ6ot-0ty72PwWJ0zeRv5NgT82Xkofo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RQi8SQpu_7QHwH-lu6wu3B2IZX6bCRGBCrEhzjZDh5g&oe=6A1DA849"}, {"file_name": "VRide-2.png", "id": "900209795790622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_900209799123955_19772091293922375_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4-qJ4KpPwUQ7kNvwHG6aBE&_nc_oc=Adr8WQDziQRWGmpZ748L1lvnBRdk2L7JIo0F7CUvJGPjfSkTbjbvxdAgr1XSWyPujVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yot1a7oKvUGGJUS5qHdNDnaE7gyXgr1PoB0sukQsGEA&oe=6A1D7F15"}, {"file_name": "games-2.png", "id": "1388051852810043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_1388051856143376_9026209735170811435_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66vbE2aay28Q7kNvwGux5m1&_nc_oc=AdqbFYnUOUXSLo5T743_vYvUcFYmclutRIWZ6yMSAiz8vYdO00uYs8fti9s2-eZsrak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6abkpLD7jDW23-M6ah5cCyMOyzNiP5q-AiOTT6Y35iQg&oe=6A1DA417"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4Autism", "keywords": ["autism", "education"], "long_description": "VR4Autism is an educational virtual reality experience developed to support children on the autism spectrum through engaging, hands on learning activities.\nThe game includes multiple modes designed to improve motor skills, cognitive development, and learning through play:\nObject Grasping Exercises: Hand tracking based activities that help children practice fine motor skills by grabbing and interacting with virtual objects.\nMath Exercises: Simple and intuitive math challenges designed to reinforce basic numerical concepts in an stress-free environment.\nCycling & Animal Discovery Mode: A unique mode where children learn about animals while moving through the environment by cycling, combining physical activity with educational content.\nNote: The cycling mode requires additional hardware integration. Please contact us for more information regarding the cycling exercise setup.", "short_description": "VR4Autism is a VR game designed to support the education of children on the autism spectrum through interactive object grasping activities, basic math exercises, and an animal learning mode powered by cycling interaction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrautism/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "VRCukurova", "support_website_url": null, "website_url": "https://yuemco.github.io/VRApp2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25806834358929346"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25855953607370263"}]}, "baseline_offer": {"id": "25855953607370263"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769583900, "status": "PUBLISHED", "id": "25855953607370263"}]}, "liveChannel": {
BxjcVSbTQrQGccjdtBrBHwHQphsS7727YA7zXgFz1gA2aw5C8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnHhburk9NZrrRuEcw6Ck-5j2pjwpv4QFPXmWP0jNMHA&oe=6A7C5CF6"}, {"file_name": "MathWithApple-2.png", "id": "1206369397681056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828087_1206369401014389_4937983546596103131_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDZ-O9bl2FwQ7kNvwGAzoTl&_nc_oc=Adrwtk4SaIaJKVBk9CjhrYPCPa-tszlhqlIZbHtMIYQo0mnvwu01vZUzLGoWwwMCNFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaw-GCF2V_M4wImuYmwt1fkUDPuzsdP2kOQObfMqs-6w&oe=6A7C5C09"}, {"file_name": "VRide-2.png", "id": "900209795790622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_900209799123955_19772091293922375_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZTthuG8KZYQ7kNvwEF73Nm&_nc_oc=AdpeCBWEj97KOWkWW-A05ZQLVLdgQzl8-aWlq78Wd8MO6k1D7xhkPYmBSOqNBoIdXaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKiL9kivuZ_q-Xu82aEuBFOiyRQP0FAgHaLe2JoHFow&oe=6A7C6B15"}, {"file_name": "games-2.png", "id": "1388051852810043", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1388051856143376_9026209735170811435_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqpjNU5ZzdYQ7kNvwGDBavx&_nc_oc=AdpYmwhOhNRMnpUaNVnVXbrZeiSJ2lDwOCLPUpkNxHD2OfzFxIqmrRgtQmZ1u7od3jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuXGs7tf9eVIiRqgchRc70GWLNaFiEdQP1sGboWrqgnA&oe=6A7C57D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4Autism", "keywords": ["autism", "education"], "long_description": "VR4Autism is an educational virtual reality experience developed to support children on the autism spectrum through engaging, hands on learning activities.\nThe game includes multiple modes designed to improve motor skills, cognitive development, and learning through play:\nObject Grasping Exercises: Hand tracking based activities that help children practice fine motor skills by grabbing and interacting with virtual objects.\nMath Exercises: Simple and intuitive math challenges designed to reinforce basic numerical concepts in an stress-free environment.\nCycling & Animal Discovery Mode: A unique mode where children learn about animals while moving through the environment by cycling, combining physical activity with educational content.\nNote: The cycling mode requires additional hardware integration. Please contact us for more information regarding the cycling exercise setup.", "short_description": "VR4Autism is a VR game designed to support the education of children on the autism spectrum through interactive object grasping activities, basic math exercises, and an animal learning mode powered by cycling interaction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrautism/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "VRCukurova", "support_website_url": null, "website_url": "https://yuemco.github.io/VRApp2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25806834358929346"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25855953607370263"}]}, "baseline_offer": {"id": "25855953607370263"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769583900, "status": "PUBLISHED", "id": "25855953607370263"}]}, "liveChannel": {
01686_940393047783733_6280142818640104830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0rSkct00FUQ7kNvwHmoY1U&_nc_oc=AdkgJQTVcdXkF09ZTXDFRK1TH59gEDLdSWOh9lrD_TQBxvTKFPtvzcdlFmDbgYtxXK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfujTvoUrH9ci-dT6hTM5-L4SDEyPg93ms8P_ymtGwn89Q&oe=699AE956"}, {"file_name": "image_2024-05-26_001823850.png", "id": "1160544514967469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330720_1160544518300802_2759453784499451324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1VDKTB9AEoQ7kNvwGBT9KE&_nc_oc=Admzahdw7Ke93IvFBAXQ2I2ToRDNofTUrmS6NERbN8HfSRvaas-feEkIBAtXJ5WPqnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft9RAYyEdbCJ1Ogozb126gjoOW0Tfd2uiTIJ9iqmupN3g&oe=699AE8BE"}, {"file_name": "image_2024-05-26_001831763.png", "id": "1164866334583210", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43997716_1164866337916543_3509890935369151886_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrJ4MIn9XrQQ7kNvwEToebR&_nc_oc=Adkgwh99LylFEAHYntrqZDMQR5NWnhM0HCZMQYCFpe4UymuwGfQrHz64ViVwhs046js&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv-B7c2jfVp22A1xZokkwv0OKm6TMNud2nACTltiUbjYA&oe=699B08F7"}, {"file_name": "image_2024-05-26_001840281.png", "id": "7564926693626297", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974887_7564926696959630_3060361769582008323_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwfH9ECEHKcQ7kNvwEd-ECY&_nc_oc=Adns0ibmQ7ATsOcZH1eN8dqW5PvrkT0KvtRyXoHzSsDuI_j1U30Dhezazi5f3YrPylc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsFyHFMfl6TJRg-1Ak5P0IL4PJtv2pE7brL6uo8k9kzQw&oe=699AFF63"}, {"file_name": "image_2024-05-26_001845812.png", "id": "1643454329804339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610703_1643454336471005_6043412212073075318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FavkqzogwpwQ7kNvwHWOC2L&_nc_oc=Adn-FH7cR9e-hz7akm1YI4Y75FYwi7EWXhmM-XR_RCrH8ztE2OVvAkZd1TEkFguJK98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu_Poh9UbvMK-FRTSdGXJgSGqy1HRk8BshfkUVpqdyWug&oe=699B12CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volcano Runners", "keywords": [], "long_description": "Volcano Runners is an action-packed Gorilla Tag fangame that thrusts players into a thrilling volcanic landscape where agility and quick reflexes are key to survival. Set amidst the backdrop of an erupting volcano, this game offers an intense, immersive experience where every leap, swing, and climb could be the difference between victory and a fiery demise.\n\nIn Volcano Runners, players take on the role of agile runners navigating a hazardous terrain filled with bubbling lava flows, erupting geysers, and crumbling rock formations. The game's dynamic environment is ever-changing, with molten lava rising and falling, creating new challenges and paths. Players must stay on their toes, using their parkour skills to jump between platforms, scale vertical cliffs, and swing across dangerous chasms.", "short_description": "### Volcano Runners\n\n**Volcano Runners** is an exhilarating Gorilla Tag fangame that plunges players into a molten adventure! Set in a perilous volcanic landscape, players must navigate treacherous lava flows, dodge erupting geysers, and climb unstable rock formations using only their wits and agility. Race against friends or foes, leaping from platform to platform, scaling vertical cliffs, and swinging across fiery chasms to reach the summit. With its dynamic environment and heart-pounding game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/volcanorunners/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Volcano Runners Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/volcanorunners", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
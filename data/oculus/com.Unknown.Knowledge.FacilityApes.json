 yo can use your arms as your only way to move and get around just like your favorite game you will have to go thru different levels and explore to find your way out and make it to the end while trying to get away from monsters and solve puzzles as a group of your choice and while making your way threw the game you will also meet different people along the way and team up together to beat the challenges and different obstacles that u will face together so join now and come play and meet new people along the way and make friends.", "short_description": "Facility apes 2 VR is a backrooms game with a few levels (there will always be more and more coming) and a store where u can suit up and play with ur friend u can also beta test new levels coming so go ahead and download the game "}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypoliciesfacilityapes2", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "website_url": "https://unknown-knowledge.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27251991324478994"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1422133076535635_79260427726873054
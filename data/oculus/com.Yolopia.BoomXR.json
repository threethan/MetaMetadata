19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hdaUrdQ9skQ7kNvwG8Dg0R&_nc_oc=Adpj2LSRMAjwJy1a-Lqu3S17f3R8sdd8Us64bV1z0zJ0LLR_O9g8qhydfATMgpWQp_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VQ4c8az00U-4H4LMfOiVgPSvThyXtP6DAZ_DmdGF_PQ&oe=69DCE201"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYucWL7zQVEQ7kNvwEh7jcG&_nc_oc=AdrxnKIaxHicNnoVWc1mZwV0PNdGYX1eWutkCU-YIVxvW_xT97Qe7DowVvm_jdJn0VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gjmKaOOfNicpQKhqJGVBegjfnEf0WNfANHZbNIJ4Rxg&oe=69DCDDAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWHQ_oHuU7IQ7kNvwF7mXMh&_nc_oc=AdrPe5-CHTijUEH-ruSIS4FDA8rYKVy1aUX6cF_K4BeZFdCCy_3tZKf4PcgACQxz0pI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EMRVIievr00A28WBLIDDYxbVPh-B0xY140HSQMd-zaw&oe=69DCFE3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3Z0mIh8XWsQ7kNvwFmKpCF&_nc_oc=Ado0rCtZyXZFwjwUCQisiQkp7_3fZwOfuvg7-s4qDIMggQPXU7M3Og9OhlChJAgOg7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dQjYVkg-nnNtAVEJXIVs9ZSYvJWqGKZZk9_kdjS9mlQ&oe=69DCEFC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrVWcTkQCAIQ7kNvwEwRaPu&_nc_oc=AdpSJYVzpeAQ9fJyjQfswXiv2MrkkXABPMvhthgXcVewmgU28vDGCIwL-3mbBNbfoc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BgwzRU9UcVZGwvCi2-3zPl53SKHf4HVU2YvGmqOdijQ&oe=69DCFAB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M1ycBfhbIAQ7kNvwHOoQzU&_nc_oc=AdqxiWi_ENYHfMCRKpPq29ib9RGRbth-M8tdmMG3OoMPSeOefMen5BBrkiyd2n2wDG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GHTz_VN8cPpzpZHhDihJSVCzaz_h3dFdKwGNPVA7_ww&oe=69E76E01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wszn_crVBVcQ7kNvwFmmrMc&_nc_oc=AdpHGGdx8LZ8tSOy-opavkI0CUvGF2NzmSwA1lNYnc1omTAI0IhZSJQoP4ueLIm9esQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33K_61g8p8M7EjutbAVfQyKFfI9j4ncc8HoR210qn_5w&oe=69E769AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjk2isdEPLoQ7kNvwHKFjJ2&_nc_oc=AdrKps2A_QHDX5WEgN-lR-qBFOxu4oyPVvD-smm-8ORJem7sz1xYCbfYA7t6BqKvFPA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jOtWmU9il9JGpcYNUuqk_e8O344aRIAMscbmAQv5HqQ&oe=69E78A3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8s9vZqjCDgQ7kNvwGKNfTS&_nc_oc=AdrtAvL976G0qMgaw5g0H8CuWTj2HuglHb2tRpXnge6wTYvBCGm9AwNqb6NyGIWwvcU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I9MRT69-Ok5sH4e4QTCNCW273HU_Zbwam8E-oZQ88zw&oe=69E77BC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlaiNf24VrcQ7kNvwFicnqD&_nc_oc=Adr8w0CKFm8Kfly2BVNVoALKzJFWgf39Wn5JiU1-3jJTcGnnsBEbwAjVtL2zksUESgo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YLYFhukC9yYZl-PbAWoN284fhz2OpGm4f8gjkYdT5PQ&oe=69E786B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
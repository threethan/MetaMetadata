19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1onRMewqMgQ7kNvwGo56Fg&_nc_oc=AdqA1L2j-EmzUHpQPbESxgngbIbNDqP2mE_WjmzVwa0lNYDngMnen2SJ2HsPI1hi-gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj0eYWNDt1xVlTkpbFz-S6JQo_nu3f-5okOSznwbuw5w&oe=69C91B81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHqfX7cVl6EQ7kNvwG45xVI&_nc_oc=Adq8Nn6pzTTT0nGctEnKDlblwyTmNsOEUU0g_QMPX5uN2Qh3cxWRhNDk46om9Y9Aez4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTMMFftSswHve-R07qI3wOvPMEZ03BziT80DAy_C6-rg&oe=69C9172D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKjkANHsZkQQ7kNvwHgP_w5&_nc_oc=Adov6y3h-LWNKORvOmON-3NDQ0HvJp0kNqtgMT5TvF6jx_weX8eCI65HxqUbZwqZMiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHqzpopR1OctJbG6_-gdhnS7hXajKH77NugBlYjjV7Yg&oe=69C937BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU5Ujqwf0BwQ7kNvwH5Cc_Q&_nc_oc=Adp0iUeLzP0yEFN7GF_ZPpanyvcNaQTXwQmwXHHdNds6ejS5Yv0qG_3LcdYawwXl9tM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv6MPrn98EnMf4HC9LhsT-epmHYGdjfK96g43RtvjNvA&oe=69C92940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcV5QKwr8qAQ7kNvwGKhlmx&_nc_oc=AdpfEla_iWaMPf7FU1Urqi_2y7IHod_akvihrSOXN4hPOjeor77Ejr30xhKMCur-x1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHfsOxdznHkpWI5gLw_mtYF-uQuJf36hs2oWxpt3BT8g&oe=69C93439"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
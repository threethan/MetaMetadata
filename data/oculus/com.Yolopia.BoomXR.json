19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fqkRsS3iz4Q7kNvwEvoSqd&_nc_oc=AdrBNfHXtWSuM4_7xHHKIf8cFwuY51_sv-6reiRmtvgK3aElK2BUrboE686XlXJ9BEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Fch2e75oKx-9dhICZmVD_nI8Mbx4o4vF9rBq4Niam3g&oe=69D8ED81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JmHcenTnUUQ7kNvwGGJCD8&_nc_oc=Adp9jGnfd_WOvQY-j9bXjoh08kq4DQ4oBDlDZlPVz_vK0RfcBq-TKwUE255uP6k6Nk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k1MXS3X9Tmu7oHAOt8kSazT7iHSLZX9LyCP3NtyNLYA&oe=69D8E92D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvNhmN1IaGQQ7kNvwGPbfRQ&_nc_oc=AdpzU3mUz1dNgbDOKsoutAC0VxEqN9rHB_a8FJyXTqTjd8TDphcUvsGbekxJufDkh7s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BEyRGzQJwELHd_fOVjlDeBw3dwgiV3uYEbAykhDWF7g&oe=69D909BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWZTb9hSeMgQ7kNvwE7snbS&_nc_oc=AdoBfAP7KpK_s-7alc8jsYIPBu3PEBJfwV409Uopt8DVTP-B0D-LlKn3KBi9RetB1lc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c7G2hJHA_iOsT5gnYjKpCqf1htgQEze7Stko0obJU2w&oe=69D8FB40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joy5odB0CrEQ7kNvwGtuWWF&_nc_oc=Adrkzkb5hepW0SFkA7L7yOJsaaGMp2JIkmQAUXY348GR5WwNO796QL3rPSleGXgtz84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EsJxWlWD4f3lulBHOfqGM8WwpmxoCKHb5R-hO1Mo7BA&oe=69D90639"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
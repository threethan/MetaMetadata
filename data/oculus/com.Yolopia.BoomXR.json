19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3owezsGeJsQ7kNvwFm2mav&_nc_oc=AdoOjwuhuO93Q5_3iDijaz59kD1X3iGevHcbwpw7GR9N8ye1XMoVqnaPMSC3QDYqim0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3PpNB5DG6pwU0LKehW7beW6lcALp1JtXM08bdezz1tw&oe=6AE5DF81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2HcNERC0I8Q7kNvwFz125I&_nc_oc=AdpNc4MOEbn9DiDTU9gVvtaCcmjKlCliK3WPMNhghPlxveMSmlPZmehgLfjws0_ko_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBN1lr9EsjfZ6vCsnxKVTNfAbIPmSv8MF8qJVUL9fw4A&oe=6AE6136D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_ilRXmB-1EQ7kNvwFDFPQp&_nc_oc=AdpaDADtWnPT6ZRraECZUNgCwNzP8snj4hKY_2-9qM6ponWtlsEXtCuVN1Lc4VFLxhw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYeS63HpK4Z5ZeJxgKfpS1y-zxUyjZmHb6eWW4r2dVdQ&oe=6AE5FBBA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gAtjjwHH54Q7kNvwHdkIYb&_nc_oc=Adodxs4Xtk8gmPTm358WXY8C81yVfhfWilYQGKJXPX3h8n3wZHFpO2B-jWHMdEGSjLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN1z4EVNYohuY6p4qTSwJ0rI6MsgW6tiGP4ShY88KR4w&oe=6AE5ED40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW37ebaSDzQQ7kNvwG01Ca5&_nc_oc=Adp1DnO2LQEofTi_FocwOsXp-nN6YH8O4XsLbNAMJHOTefqAtzXwn-cG4_zhMmJze4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe8ccFgkjZtFZuwxQnFm2gMetOyxoQ0YBsEZj6A90Seg&oe=6AE5F839"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
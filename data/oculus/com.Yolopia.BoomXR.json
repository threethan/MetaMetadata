19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hdaUrdQ9skQ7kNvwFoG_t_&_nc_oc=AdoXvj5HW5tGz78pYpwmLIhk-_rMrXnSwMvEvdkf_JS-kA3lQ3Ohwanafsmvadwfc8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wYrCvhdwVsIE3690CsgBa5V9Hb321WFniY7qGD5FGfw&oe=69DA3F01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYucWL7zQVEQ7kNvwHO5oFX&_nc_oc=Adq9fvg_u1uDuKRZ-DYrHs-slGJeLgt0yZVFu1nbw6sN9FJpvDuJmnyhOcnkF6B9GVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lqW70bmorWyRW_HDF0ZzQ3HCGwdpF-LKCyqgExZhPAQ&oe=69DA3AAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvNhmN1IaGQQ7kNvwFWslya&_nc_oc=AdpzVTnuVSCwQ_ekTVQu3ru_f_VE2M3ua1ulSX5Wj08cG_dD1s4OQCB1xHzBpGcIuJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JrUTnwBMnarhkN92PscuMisQ8UtU7NSgMVAyIRUx7gQ&oe=69DA5B3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWZTb9hSeMgQ7kNvwGOA-az&_nc_oc=Adrl5bXCBkYE71Uc_gIwVhxs2ak8f3XfQejnajH_tJbt4E4RZEl3YRZvdSWSLPwfItE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wz64pH6kbP_b5r-eKPnJUq0hXv222s7vO7Dlq-GLMNg&oe=69DA4CC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrVWcTkQCAIQ7kNvwH58EIM&_nc_oc=Adqv2EJr1PPpdTLIznP-hwHuTua9N5xGXYBnNQW73rCjQPFr1-1Q8tB4ndpMxURBUv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yLZvwYtEOYLWJQFA8IrGUwUhf9veIeJznzcJbyb3l_Q&oe=69DA57B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
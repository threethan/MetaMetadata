19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xREDKbIDlwoQ7kNvwHrE0Hj&_nc_oc=AdrRNupoja7BaHvKigx9Fm0qVccwHByV6aw9m5rSoTnEvFvtrLX8VoxhMdOzduQky5A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KKInMLO34r7UTnjwJwt87rl9YblH3YA7g_7KGgM5rig&oe=6A09B501"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCQUeeoZoWYQ7kNvwHJphpa&_nc_oc=AdpM4oX3JlBA00KUqkhu5P0P5x-mlH3GfJfqS4gFMTXQjavnNrRHpwEXOlri1dsIUwk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pc4koW3ex0pJOMuOkwGMKA4nypaRbrOOyjyTXCJifqA&oe=6A09B0AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5meYvOLiO4Q7kNvwHnxnrR&_nc_oc=AdrJKypuhGopnHTnjfr3x3mUMCbk6O8hcTJxkcIRLcH121NFWR604vcWSnra5NjQ8fk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-EUYEsZOe9-rNJmhSjM9B16qP_y21VsmI4Dhgezig_A&oe=6A09D13A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVh4VDbVu5oQ7kNvwEy_7Wm&_nc_oc=AdoqBfJSjPqjradTGsU3Km9vWzRrZLPjEkPisVoz70vmvcpBQKdT_6KfWHdiVL035fc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aM387Y5WCex0ZyXJYeD0OgZj4rpdFb77ALCiGORKqfg&oe=6A09C2C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvuLv-NwBgYQ7kNvwGbSFpU&_nc_oc=AdpPJ42sLWvSmRkhBDqjwYHN2SUtjx0yBYt-tKQ_cPVOiijO7dKt4HFL72LcSRIw_N4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MSFd9h0lvkroPSHhwyxeEBlxUDyoXTJ_JoaVl3BCPAw&oe=6A09CDB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
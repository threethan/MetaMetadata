19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmC9s9rJAKQQ7kNvwHekjF3&_nc_oc=AdoQZcgECQFvPIoLPk0fuSqAIGhx4NckZVDy2ZFdZA25wemAO-2_ocIjVLQMlw_luEM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XbyIwGyXrEsSzH6ilzuHflquEyJBiv5P4tsgNYWns9A&oe=6A1D7B81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIx9hYvaH7AQ7kNvwErqQuF&_nc_oc=AdonCR8d4YBNFDzv_Vi2aEGwsr4uenSRI2cLY7BA0iI4rwIMAjdj-5qzkqPf3lmXz5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A2SKjYIMukmxaDx8edIIq32c_jNP85p0UmY2FV6w5HA&oe=6A1DAF6D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPaAp3PzsHkQ7kNvwGQOjpY&_nc_oc=AdrhxeSQoBo2-GVzwnhQXlB13d3KfK9T__srilx9buwgZ8ypySx5KlH2MUeLAg_zPAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MKwiCMHrpWanlxQG6LAt-MlNFrPkoKG3vG60jP7stVQ&oe=6A1D97BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1bYGYJgG0kQ7kNvwEu5BrN&_nc_oc=Adp1-zkG9vy1R7GdrBSt-qS-1ZlLK1bxZc3QlqM0eoXG4z0AJ8srgnjkfcfqZZ2yy5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MpHbd-jfMT3x8EQYs0BwzJx1JJnRy7TJP7JZDO90Y2w&oe=6A1D8940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvpgPhjefuIQ7kNvwHsvx9o&_nc_oc=Adpe8Y6vuNvq7ez0xkGNX5yydB-AOUceailAvFnTTsQ93JoCzZXVjGHHTDRAwz2TQDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UyD6Hdy5gy5V12K-qJ52EpYXKHpYfQ7rNGN3eoPkDaw&oe=6A1D9439"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
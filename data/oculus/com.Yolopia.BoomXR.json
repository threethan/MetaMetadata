19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cuzGPSpsgAQ7kNvwE0snC-&_nc_oc=AdpUAPg95Ry3zRn5d6Y8D5z5yAuT_8v5lyLxJyYgaJQbzgGWk31vBYbrm_KRVPN6mhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5jutiqDT5yVGPvMlEGgsHAdZiT6zUujLt8YtlKMXGbQ&oe=6A5B7201"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ8jPDlJrTIQ7kNvwHBrrz4&_nc_oc=AdqS_KYld1EmZ6kEOjMAglKjUx6y89pL3UHzcB75fKh4maHBlysVU93akfG05t7yoQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByPMm2mYVh4veVX03nQk1lpaeqkZHuE-1dA2a30_vwhg&oe=6A5B6DAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD3KG_p3IeQQ7kNvwF9NqSZ&_nc_oc=Adr3F4Up2JZXlQst1M2mPTIIz19Ag5P-U9qE-HB2iSlIxgnL0JZQBPAPDBqw7u9FpD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbr0G1ascQ-hqHJjCUyVYnd__TCXASxiTNfnzDrI3hzw&oe=6A5B8E3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcapotelHQQQ7kNvwEVGT59&_nc_oc=Adqw0mQY3j_LWU-eIpRw2KP4omB51zyCDOAOtt7oU-TxSowOIiUgA9QUcHvd_dYc4No&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkNYhote85xD59QBwQOHg4z12OvMQ34FnucJDCR9QSKw&oe=6A5B7FC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9jKdsbd144Q7kNvwEznBr6&_nc_oc=AdpGC0TwVD3Es_CTK1xYWblr0MFu-DT206ZpQ6ZWAjoUAEzT5slfuCYbDReUD35HmsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkiAH9mNi70ecquH-8KRgPm7x04ccat1tPni-iR2VNjw&oe=6A5B8AB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRPJlsCSQ-AQ7kNvwHDoH9s&_nc_oc=AdrkM4t4i1--nM8uejT_h_lNb-I-O_gFK949GGbjK4hoXG9KfmDybVT1td1O23MhWok&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39T329XxYinJJ2lfKIBWw7utZbhsdaztrCDAAAWmOTxA&oe=69EF5701"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tPOKXsyJ7wQ7kNvwHqHhlk&_nc_oc=AdrURA5jQE3ffLmhGkiIboF997oNtIVXGaMi6J_aXY-154Cy5Bx3-ugjC0iRjln__Eg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38EXrcHJt3jKZ6erlsI6qc2m6FeUgXYdYb7jtsb20sZQ&oe=69EF52AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su6O5U-vrxEQ7kNvwFBIXbS&_nc_oc=AdpZ9SqMEvLZcuE4J7LnS0rqRXJTS0gOB3_ZeLwtzIkD1E0BMIFCmVEXDVe3iGAHEC8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jEjNX4fTldm7erm30w-MjyTeeAa2Q4Q-sdSmEQuob7A&oe=69EF733A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1B87CZR00H8Q7kNvwHsA-gi&_nc_oc=Adrb68Zwpl5QNKcZoaPeKKM2YNyQjfLxW87KUunWi7BHWF9wWJdHVz-QrdH7wojUhpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05z3v6KpXIEqN6ZuxR4Wip2ISVCDUyBtjeMnIFKJ0yXw&oe=69EF64C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7ejxkBL9F0Q7kNvwH_ZDhu&_nc_oc=AdobeiQe_mLpV2ekRfjwm86VS7GeMyyx1RHTyAVQVhSY-9iHZ1KF0iMCzDD0WazflG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UWskXOFsj-lOTNV5SK17UO25rBOJJN3iJd_W18w6mAg&oe=69EF6FB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
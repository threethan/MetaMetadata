19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIq7X-pxVhEQ7kNvwEbo-2o&_nc_oc=AdqoYMV20Pp5HYrx5MBtnbFPOYKLyHsZMjMcyHwrw6Ns7KEOFrcKhIQ8hURDjHrvEDE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEjzPhp_L5gI4hNLKDtFZpBiSmIEC2-HPTjuDCg1V_Pw&oe=6A917F81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqt4hhK1FDgQ7kNvwG_f2na&_nc_oc=Adrx6wJ6PJH3d79jdr7xX24kxapxUV3npkQSLgkbP7EGFt70K6q-uGigAKoWWSDo82M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG34aiBef6Wz31-o0HcLU_Ua1b4Qn2j1Cp1RCTgkRl8cQ&oe=6A917B2D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KxodRcnLyAQ7kNvwFMDdXn&_nc_oc=AdqTCoWy-4Z_WXTrWL3qkPebeK7gHlReq2mnVCLrCBzJKTJkYNh0hxDG7RzC0IiXt1I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFumGV0AQcms6teWiJ4H_4iIhWRjpku-c7Uswc3yVEgKQ&oe=6A91637A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUC8bij2T8MQ7kNvwGmZi1f&_nc_oc=AdrQ_W_nkW4FAqxRtq3Tn0vKOSWMpxOAVpKBYXiBqKPbp-peJMKxMkjCALVtwx38zOE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFEPf7YVPMHLgIpLK9CsuZYL0Y40B5mLqaP5SwP0Jw3Q&oe=6A918D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VDDc4THIIoQ7kNvwFqjv60&_nc_oc=AdqjsLW5Za4bM5pnzvc6z4kJ3oaGILnsM0KUywgyZyXkxkf2da_sfv8ji4pG0g41Tm0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN5tIGEpBt9wXG2rxxBrsRSYyJuW7emm2RxaBM5lGC3g&oe=6A915FF9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
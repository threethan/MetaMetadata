19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQBT6e5xIB0Q7kNvwElC4e3&_nc_oc=Ado_MmNliSL6zAsDIpIcsyNMeR_UHw0crdm0-jkEq3BsQRzEsBqK3zRiYDIZvm3LfaQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdqoN_D3xDQ5P3oWx9orm2rwqWhf5ZPKbEtEwt3EU4Pg&oe=6A81AD81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hlmq6md3TIQ7kNvwGiCynv&_nc_oc=Adodk-vFXwuIg-q_Gcpoxsiqoym-ZIg7kxPO5a9PWEDf70VLMJVM0TDxGib5YVP2S5k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIvtfkQH7R2T8jU4ltX3yRQsAQsrYKqwNw2QtnHIRnXw&oe=6A81A92D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lauM2bYoq40Q7kNvwGb1vmQ&_nc_oc=AdpHTqgOe6rjxQt-MtfX4FjrHhqZ7v-XMOwZHsFXHIYuIaqppkFdjbedpnc4SQS-NO0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxYVbZqpjmch0OB81aH3w0yqCQz2JB3ub1wMNk4rDcrg&oe=6A81917A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKTN4SM-gbwQ7kNvwGY2C74&_nc_oc=Ado_gZYvAehW1l_mEwXr3UmruU4LlPPs-ylP6Yv5CtCia4RNejFBYKfBh9-5vNhkANQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuH51j2Hdw9JnLf_QbOSL4VygQZH8X6XVzRizhE7ZIyQ&oe=6A81BB40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDezuB5e8RgQ7kNvwGFrCVo&_nc_oc=Adqrv9shMLAnTrKbUCF-91c_zjv_qs9mNvojxZEBFj0UH-xm7AK6ZmaYMxNv-jUUScw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh-fOfQzvu9sz1YkXH_UqGaaAuEzkS2nza-U0xGk9UzA&oe=6A81C639"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
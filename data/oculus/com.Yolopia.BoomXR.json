19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNqQqIrFIocQ7kNvwFaJgXN&_nc_oc=AdpZ5it6FCamzku83d3gxjIHYkv9T5pRiOJXUFrEhhdUkBbKYqWyIgVZZWToP752uZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw5lGufxavKwShdLIdwbPhRtO3CXnyXp6w3g32vE75MA&oe=6A635B01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeBGhKSJkTsQ7kNvwE0lWg0&_nc_oc=Ado49hBmBEyf6avTJGQiOiCuIcT5j2bk6e_o8uZPCzby_G7mzgasH9GH7t-L3y6z7xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAezKRbAC-3aMPPgBna-iAqfcj9YvfC_NzkPp-HP0P6qg&oe=6A6356AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsJ-lNHuttIQ7kNvwHCHszG&_nc_oc=Adpp2IgVxOifmoFUx5vNBtA5f6XAWQB0ngXCPpxQtehMSI8laQkZfArAQMmXtakTJMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLh_VvdGvEN8kSkyI9EC8PCqYi0LvGL-u-U3WYG5069Q&oe=6A63773A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlOBgPCck2QQ7kNvwFdGSSE&_nc_oc=AdoNjCVHP5vheuYDwgWRlSiTgg-suMXw3TTE6X6llDX0OLWPF-vgGeu04wEBvHNX1NA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpyE6j4W3XH7wkAa9CH9nmV7fgJhai8FwWtf65UgTHow&oe=6A6368C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg9qFlXYBjwQ7kNvwFWKLJx&_nc_oc=Ado8tuxdjJsG-P7tIX8mKI7tmkdkrM2jfUDGqhxzOGQuk62cMEj1aVayN76xdFV9fW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwhsW6GoyXW6dPuk5NH9a0jt8GwJsJCqpJT8Q_Nb7oQQ&oe=6A6373B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
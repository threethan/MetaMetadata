19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHecHUn8zeQQ7kNvwGFcKRn&_nc_oc=AdoZwNNLfqOphbl54e3L-6MteGUq_TsesmXCNYF8D2juldW8aGvX1SQ6TI6Ya7lgJBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY_I35R-iM4FMmU9uYly7Zi5ToEwphUfbrktct_KPe7Q&oe=6A772181"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hsI1AK0HTkQ7kNvwG9Fi03&_nc_oc=AdpW55TZrclffjAk9XVbnXWB4Swe8GLbYHqh_7gqs5oRMN__d7JgCQDO4bOAwYpEJ8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtokg-oSMltEbVfFBbIoX3DwZiltPg4NRHF5JhpD1iZQ&oe=6A771D2D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBj5oxcxSS8Q7kNvwGEVk0K&_nc_oc=AdogaUqeG_aDcKubf5JSEkW0rCAt_9T05b8g6h2h5Cns6sG71CHBwkJeqBOsXZwO4Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNVQAO6C0kMS_hXaRmirrFmHM5pzUmSOUFtx1xgMhkJg&oe=6A773DBA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bceypwZP4iYQ7kNvwHmriPu&_nc_oc=Ado46vySds9B8W-0yw0ABF1INenVeB22uUb3NTjxLoRxQ0Tw4AuN7db2EnBhiZsIIS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpooQoZtt6mrMZkghzpAqhxsoOQwkv2P5anmJmsixRzQ&oe=6A772F40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUpJ4uH98IUQ7kNvwHXrL63&_nc_oc=AdrGlw1c46GysF-UZJc7Tpe5atuKRg6VYCt1HKNZixj7K-9Ot6-qTf16DqmbyOWJg0M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI2kHRvzvIlrJv7I3Sojvxn8067pn5u90uuVY9kvJAZw&oe=6A773A39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yxaWyKVFHoQ7kNvwFpPUfH&_nc_oc=Adq1SLZ_KR1Z36ekUHUSKP0uCNRJ9PkiOV6pAtOYj-stLcl7qH9Txxnhr8o96hgkZ9E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zKeMv2pPTcO1MZoncUTyEQ6Qv8xaDa2i3BGTYkLRZVA&oe=6A244B41"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIxQ5zZ_2VAQ7kNvwF27TSs&_nc_oc=AdqCNKypyrRJSIhaea_top5yc-WvjfeVZblb74ZqpULoZTplH-BYxhx9kenci1iVx4U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3-WfpZjsXF_iOE5gXSlXFMeYRQA8gVw-RMXXvAB7ONw&oe=6A2446ED"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9rcThk8NZ0Q7kNvwEfOHbQ&_nc_oc=AdqsFrtKTnoqBTJRumgfaIsXNGTvWjLw8XPgX6SeM569ABinRdr6xHfi92hlyWusoIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_SIZV707fvRFfGxRa0XNkILEwZAZ6rBXEDdAkNqT9wg&oe=6A242F3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1IuQZ2KI9AQ7kNvwF22OuP&_nc_oc=AdpMOsgT6WnLG22NfwdDRE7xvz8bm6d92_dDjA-jiE3MCQoox_kWeF8KnDSI60OxZxo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-a9KK32Jem2TfKah6qiyih0cbvBpM0KS6cTg16zha9A&oe=6A2420C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIflAWAtHeMQ7kNvwFFBftE&_nc_oc=AdqPoSD3s3ZSnbYudKcljIdBXlkzIROfD6SY6zeDZDYX8GisPI0ZWA44BKF_EauLRmY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WS6s_DuX1aG-WougZiAQGkgnktOgMQV86EaWcWgAVow&oe=6A242BB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
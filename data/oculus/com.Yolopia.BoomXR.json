19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS2222VThgsQ7kNvwHH6M7J&_nc_oc=AdpDBWDtlS1dLR5PO1X4mWUTE9r7BQW_mTqsJMGpHBKATVFRnjtMdfv3owCIfJlzg54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9XVvpdkEG7iCvK3-ILgcClWMMACzJl_tXP851gahprg&oe=6AF0A3C1"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw7FrlWIneoQ7kNvwEL3-dY&_nc_oc=AdofeU0PuA8awn1vhUuztCdWO7vhcYVX6_i7OfxOUJg8vuz_LGhW31It2j7LLQ7kQZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrndIAt5y5SbapaUvpE4diUmV86EktaxJqnSbbYeQL3g&oe=6AF09F6D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAnf_-IGS6AQ7kNvwFxDNGV&_nc_oc=AdopCaylegob3v5yTPxryzLozgl5kXhSOmKWyju7Hi-lYwFfhPqE8Shm-jfHc5YyjuE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfDihonGrI_Rack-EKg_lymB80EOHRotXgl_gvoFiHZA&oe=6AF087BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MSNPQJCycoQ7kNvwF8ySm7&_nc_oc=AdqhEk0yp31kmV92JrUXwCW-dTeIdqjz33iYWJwXZsmZ2XRYFGY_zX48ofl61csFI_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6oaMcvi07xDFR_qjU-tVigWLYeyLdBQfKTJlu5FdRZQ&oe=6AF0B180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R80idcrqczwQ7kNvwESDEIr&_nc_oc=AdriHtUgHs2zdWqUVKBNxnunjTEuXyz3hIhCIE9sIRH0v6gTvdYFc68nhQa8NKhQyEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvH6Ud9g3VlqZwYQSOl6x_ORGxVjP57QRIl_dw_7h18Q&oe=6AF08439"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
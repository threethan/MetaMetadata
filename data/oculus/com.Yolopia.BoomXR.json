19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kheaqez9IqoQ7kNvwHJHH2V&_nc_oc=Adqp394pOzgoN6PLJAC2jFSOReu5_2pPThtd5EHaT3nbKfpDOfhcB9xbm7LU1Sl7cn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2zlNqKNZtiGXcoZIcXRmRzSfCvJJr3ne-gWYXpiR-EA&oe=6A4E4301"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S8Y1QyHG-oQ7kNvwHlXDSV&_nc_oc=AdqtMFLuKmR-GxDCT89DSF1DiAmlDWpWQIxWpm0O9esvZDbK15tBGcPdnEKNsko9WHQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVNRu_Jow0xDsaHppeBCJH5MBItxOc3dGQexTrBD4Aow&oe=6A4E3EAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIigEt1OhnQQ7kNvwEgHN6_&_nc_oc=AdqvRayyhMl3MnOaIT7tPQ8OWbRUC-Jk6t0zR4bhSqWzo4sVqLzM0g4fB2NXrvSJ3kY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1WIGZQOCBDwSyZTNWpaWvO6YE-pc8TSvVrizYBfzRow&oe=6A4E5F3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbWT584D-GgQ7kNvwEwrEmr&_nc_oc=AdqKbuq1wlRkIYeR2ExB-IjZUHbe3iNGG1NuocDScx4LfVuvPDCqPPpySiAam-gwdA0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8fFOxz-YMa9KKa5nEVTSIROJWN-0bIJoIX1EumgfVhw&oe=6A4E50C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ZtSWQ1xSEQ7kNvwFxJ_2W&_nc_oc=AdqgQ8b_itgkA1XIIFsMuRjqFS5nsehhmBfIc-9wvdM0mzzvpPuJfEDslWeFypLTbDE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBznGzIsIHxKJU4eP0xM9_gyv7bhxAcavpOZrEKX8U70A&oe=6A4E5BB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQBT6e5xIB0Q7kNvwHzE5aP&_nc_oc=Adp5rc6SGoxYUvgRrXDqSarLTOw_zI61Z1UbqTYU5zy02bMb4Plz0LlLI6BXodQJ2q8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjNgSl4-fK_bmZDvXaCGtREANmBwIhjDcenuMu4OsRaA&oe=6A805C01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hlmq6md3TIQ7kNvwHwOblS&_nc_oc=AdpSGnreTZFWKLzpWkKTzDNk7rHritoKF1Kvhbmx4TSiinnFb87K1lsi0u_11VT4rbk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6SXhHx0nNbupilnbeXOtpZvlggtPQO3pUsmirDGFrqA&oe=6A8057AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJWibFMGHIAQ7kNvwF60PQJ&_nc_oc=AdrK4rmQ99JY055qya8QbrtBy9RMKmw1Rqyx1MnM6GTdIO3WRp30ETeqPQayEQ60jng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH05u54srt_PvjrBaFgno88gXp_fTEzWdFVTLP6CiZymA&oe=6A803FFA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYuceTTLAiAQ7kNvwE76U_n&_nc_oc=AdpAKlASun3g8WkX2CNOTLOxwCz47WqYdMpfgOoP7XblzQig-oATeV7NrollY6f3q74&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYSN2KTLx98sjmbszCYrUmWQJp6L5VHiql4sKZaYjtxQ&oe=6A8069C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDezuB5e8RgQ7kNvwEmDpyL&_nc_oc=AdrZBCSmwUu9kuDEPNjEAqRwiNTPym2z4TMlN9fBwnAvhyZ7uvMFydWGoCX1c39QW08&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg5DFB05lnanA28HK35DWuuza3OwLDV7LgqGh4LkQq7w&oe=6A803C79"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
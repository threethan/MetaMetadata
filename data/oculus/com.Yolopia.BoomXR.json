19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJ8k6DJ30qEQ7kNvwFu7gdG&_nc_oc=AdqJIsiBslNzZUIbGr1roKZa3OSsJfPrjLf4J3fuCRNcw57KPeR9TmbkEGC1hv8rLMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYRxMK-uX1CL-yoJxfVS6k3IDxJ7m2EYNIUr4s1uEtPQ&oe=6ABBAF81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VLUN5Y6U8sQ7kNvwFoo8zo&_nc_oc=AdpdblJHAbvuMHjl_4BvjfeFtwnDGZlxdAIz7jXfnAodu3v0wqJWCvWu0RDHO_RWpmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJucVUipyvF0TKyeRNwDDKyZkAVc2ZZrPWXQf1rtx3mug&oe=6ABBE36D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G34BpYpn7YIQ7kNvwHDS8d6&_nc_oc=AdqDQVkP46exk95B8KS0k62vlV5vSiOpQ6pyk84SdXwcIyW0jDdCgElDnf2ZqeZ9GDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe6NRCRu3tzmtGTQFjvGxMSPj2qkMwTrnN7LH_mU6v3w&oe=6ABBCBBA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPwaAItCIwEQ7kNvwGYKqQz&_nc_oc=AdoYTUs5RoBK1_kTYwHlL4xdgnr3jR1EyzRXtIbtulRUXJw4kXZLeAUcV4T1vtLeauA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIz8TJjTp1jUb98q6WQ3_6nS8J57Xn7qwRNRgoNKbKBg&oe=6ABBBD40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmB0xWkd-tIQ7kNvwFLD4zS&_nc_oc=AdoTzyQF0s0L3EWcXD3sLGvkr9s3biybFIf1djm6dE97_JMGuzMxPrxz9H3_g7vo53c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINLL_KFpl6CCMvbgs2RTreoFb6yiktRMDOaJoy2sWr8g&oe=6ABBC839"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV5ZlN2eb_wQ7kNvwEvj8jh&_nc_oc=Adrus9ePmWlCkdobCL6i45LY6IvJYr4sddAltdxjIVzM6yFMx1ImuR79FOlcLhvpyGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdbxbXqaimYYhXMIdEGS6qOOqr96Ku2AT4Sr4RB9plAA&oe=6A6F3881"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PF1N6vFkCkIQ7kNvwHkLEMS&_nc_oc=AdoBtKyDubD1VFlpp_xbibJ_B9Cqs4GonnCalUKfrfvNRsj0QlN5pjbEBx16QeGEX44&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2KkLmBNYJzoxpgypYNEEB0RV7yda7vOp3ULTzyALkOA&oe=6A6F342D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZOIP4uV1DcQ7kNvwHZofYT&_nc_oc=AdreM_B-WfK7O54cs-nYhN3SqiVipjhkr1mazHIXuhM7W5CMYtbE5_NJ8i2poQvnT1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWfjUY1WTcrQPGcXiV9bOzFdlgULQ1RqUhcXeOQwxvzA&oe=6A6F54BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0UhmIhVgjwQ7kNvwH0vXDd&_nc_oc=AdpmIhkimFwj6J0ssYbS7u_f1vZLTiqCnTRgedN9FS3e4RigbT1i_5vRkMY2ZPgxFcI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8A9CjZ_FhqyB3gh-YCHlbNLS1_Xl3Vla_esrINGxVIA&oe=6A6F4640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPndprrU5b4Q7kNvwH6Af1L&_nc_oc=AdpNXdItclWqZ_UjCJ0JQ8OO0XYYFVtbkL4chuV4ghzxzDnV2WbPAYzcNP_KyN52Pbk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDKBURa5pKe-AG9MSAnDKWBeAjoZd3yu1iaskQ9470yg&oe=6A6F5139"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
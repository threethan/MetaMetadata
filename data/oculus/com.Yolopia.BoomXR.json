19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu_LwSxMh40Q7kNvwEAyYIT&_nc_oc=AdrFyU2uagKVIq1r7tTK8j_h_9YsRWn0keLyHbnvWVBuHwf7qC3cKkxm0aZ_tZaMZnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AuDLT7XehULdLWpScCOWXEHyU2kjLdCNNy-Do5pBMrA&oe=69E0D681"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4G2T6Xj_Z8Q7kNvwH6v7Sk&_nc_oc=Adp44WiL_RDu7V5CXkd0dFKDbj56ZaNXCunaduJSJwLC63HgCEKjdGRvr1FgZzjrK1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SlolrU6kFgKEZjYiXcLA395G85KWp-ndb9A-AfJ4seg&oe=69E0D22D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EE4NVBehvYQ7kNvwGDSlb-&_nc_oc=AdoL6n3OzdnO6eA22kirWe_GygPHsQWBOA8SKP9jHqEWvuKcdz7eGg_J9OiuY2xbDZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fxSE_QkpaODXxsNVu1anN5CoLkGvnOAt74YIjnCFNPQ&oe=69E0F2BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kow38-7kcqQQ7kNvwH0K2wC&_nc_oc=Adqd6DuVvQRp9VqNHfG_XT2aRwU4BjWyJBRa0_trkn2B6oyfiH-n40QM3Qg4IuWRISI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UaW98KGVPtaggo71jhyWiRuaeRPEfstRrgigjCrV8tg&oe=69E0E440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTS4nvwXvm0Q7kNvwFCypu7&_nc_oc=AdpBN0XitcWMwqgzYrfwlGaSXm333KJrZfRVAR32extETP1bkOQwubC0EG61JWCgiVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I2jl6VDGNQjvbELd-PTe1nrjm8jYv3DIYQoiCe0kzRw&oe=69E0EF39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
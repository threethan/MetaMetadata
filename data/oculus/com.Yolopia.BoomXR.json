19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xREDKbIDlwoQ7kNvwHifkbs&_nc_oc=AdoTIHKJZ4oYOt-xdhsTeNp8HHn2ZpSxYTtdhuU_mL1P3HVFl_Gzz5D1CfI0nBXsw_M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NudCsVPKVPE1s9CfJfrfweSjgNTfExfqUPABG3VZUPQ&oe=6A0C5801"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCQUeeoZoWYQ7kNvwEgl9Wg&_nc_oc=AdrA-v0cbT8ZkDXjiom3iArbQ2cT9VrRWCqGu3KO6a2GPJ2Bz98dGBN1BnZkQKkZ2Nk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lt8n94TbF6U8RRW6ZS1SC6TWXmOw_dLWCT6iaSaIOWQ&oe=6A0C53AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUCbsL6HXu4Q7kNvwFVTUzL&_nc_oc=AdqG4W9xhQFzOpiANgZ3V4x7Uh7ybsVWQpodZWGuPo-d_t3SadqaJSuI8m_O_Ys10Nk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6asUAyUMpLvyr0ldkblaGmZhfCcHQMLa-B67REi1yY0A&oe=6A0C743A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfOJxfNNvAMQ7kNvwEnSxz8&_nc_oc=AdplCRB-RJ14SrOd3cs9JjM-A3km-gU88yF-wT6SyooCp-hW9VOdLhCdw_DeL3yDrq4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gq6VWQhAhvIwtF4xt4xEK-FvNuFDq2f2M-1EijMq5Fg&oe=6A0C65C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WORq3Vt1RxMQ7kNvwHXcBRV&_nc_oc=Adq7nm9h3-CRknhsrzamHWwk_T-Mf8H6v-lj2XGJkzmSM3kILprIIHoQmoYoI4FazWo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sjrZBSNvWWJsgbAzGX9-t6c74dDtFfdnzVDT0LimWXw&oe=6A0C70B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
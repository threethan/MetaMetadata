19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-YZZLqVfFoQ7kNvwF6Q4XF&_nc_oc=Adpc26-UlSto0pcW7s2dErFpnkFhpee2Tgt9s2uXKUg1lTgNQZIYjplb1vHVH3Vt5qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfzsImvXC5H3wLWbtEuyBLRIfKde1paKFDDi-fzuCEOw&oe=6AB3C681"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QyI11rK9LsQ7kNvwGV4N8S&_nc_oc=Adr--tU9m-CEL6vfF63QtP_BIB0yXBO-jmWapNkPWxx4LFMi5RJ5e8pl0TLlr8J8-pA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI58vsF0fW88VegqCUJ63FvZrrm94-MImEzfaMYrJ80XQ&oe=6AB3C22D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxh39xSV5y8Q7kNvwEuC8b7&_nc_oc=AdpPybAiGPMw2_jjs_XpnZLXTSzDf3L0eIkoHrQXHZ8WT1TvyD039ES33VpRwuOEHSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCYBq5Tw28Uu7F7c7G4EvIcsRrbrVgp8KdfvyTb_m2QA&oe=6AB3E2BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRjAvso50jsQ7kNvwHVXCP5&_nc_oc=Adr48trs0CSGaoVKQ8qc5RqyQsZA5SGOoGFqO0abt3xV2bjDjXxT6vw17rw5XhrjWEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJnGsEqYSr9zNdfoGyZL0SkoAZF3DEkvnh_8ioh-mIIQ&oe=6AB3D440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycNWUdoeGi4Q7kNvwFBKJMv&_nc_oc=AdrjWyEi_joUYf353L0lxoWmDva9gNHWSIkKIsG5aTXO7n1VTCUEhxbSjOQnyOmYluM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-uLwG8RqCkWW2KPSL774HabgqHjcPNllyA7ZECg_3CQ&oe=6AB3DF39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIWDvUc0M9sQ7kNvwESgzmK&_nc_oc=Adr4t5J9HVO8H13P39wrBBNwxZAq_wsS5RcxRFOwNCpOkuPbk4vf3a5Tg3f_06Fzevc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TN_2vWph-Z4I9VdB3JOhOqn1DVf93OHPsAZbO0Chngw&oe=6A16E401"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlVAIDuhHIIQ7kNvwGaUwYa&_nc_oc=AdruifseR6MefZ_VXNEXIxQjXYZLcE-rtpGzqkAl_mBxz9v_KQYo8y5RPVyM56jdYLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t67Pigwc3aD0Hwz91eb6H_R5Dgl8oczzcvpvNhV1mnQ&oe=6A16DFAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_nmkmxEwUsQ7kNvwF8v5_k&_nc_oc=Adpet2vusguPoaorVWmnuZ2hnAhP_lVtxPygCCZAaKHPT9Z3FK7zmbJ-rXzfaXSs4Mk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HPvPS55lwicfpXFANiYYTFtcZAU3rWrSd95t1OtVPyw&oe=6A17003A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i14wJDO6eAQ7kNvwH6TVQz&_nc_oc=AdrT1kfa-5osa-1Xt0sZJ0X4dX9aJ7Y_4c1LSYKczfN764XZpKtXJcaoLpRYaQdc-eE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P99PWeNiqM0DTKehcxPKE9MflYRmPo_O6RUR0wNbahQ&oe=6A16F1C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJo_IMsFfx0Q7kNvwH1_nUq&_nc_oc=Adr49rDpEJz5Q7K7YhRD6MDv2c15O66JfUHVXNqbWpK3sa5Hk-HqzQIjOfgE3UJAfdU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZSEYexbBZI1KjO49w1TNR6Pjukutl3dyipnu4euimHg&oe=6A16FCB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
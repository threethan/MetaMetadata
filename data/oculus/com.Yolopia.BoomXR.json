19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHecHUn8zeQQ7kNvwHmNMnE&_nc_oc=Adr4Kx2XtHX5wAk6wGhWdfrGEkA5POsIbTmtBKf-xn85QPXeMBaLq7owjjRRv8U1FQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3u1qG0mbGSCNIM8rJ4jLnPvsNsq1MjKwtTF-fW-ds1A&oe=6A75D001"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hsI1AK0HTkQ7kNvwGohVrH&_nc_oc=AdqzRgfDTv0VZYeEJPnMS13OBp_Pk-hnIzA83HHizXNtmMDaP57LfsIHWEV4z6KHDF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgrkpZv3pbM0ZxRhkP3pWrpkfSSl07RejJoEk-frBhEA&oe=6A75CBAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBj5oxcxSS8Q7kNvwFsvMc9&_nc_oc=AdpwYf2VFq1x605WYmF1rP2G06itonuA7LkVxDDzmNmMuw8mO-6DU6Te6_raDWHFU7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvBrZdsAwWj0Khe74E0g34MQh6nkwNIiKzkWoM7CDRhQ&oe=6A75EC3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bceypwZP4iYQ7kNvwGOA1_W&_nc_oc=AdodhSvH9fXDcVSikhf4G-TIhYJdiPpHpGVMMyWySW3lsjElE8-PODHIbAqt6RR-mFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmeUJoFSw_PRl-RIOC44hrpXMln7fqM6aCTNktPauv3w&oe=6A75DDC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUpJ4uH98IUQ7kNvwF4uEoX&_nc_oc=AdrpO1LXRqiEEo0Jl5ImUGsJDU4MLHsmP0fBetYs7REUK2sbnBl2MjPrO3LcYvVGB_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP_Ztwwb0HH-oW2IEtAVyOV3WaI4uDoN_8okShk8hAVw&oe=6A75E8B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaK9VahOwxEQ7kNvwERQBSe&_nc_oc=AdqDAfXaoIWjRSoOM9hxpR5NEBLNkMYlEb-4wzE1q8thPu1JtrrSgAa-trkMFRWPFAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ukjHImobr-o5CakB2vUvpzttsv2_lU4hufT-4UWHwSw&oe=6A086381"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq3-N5sB4qYQ7kNvwHnoRHm&_nc_oc=Ado1vJnjMrT2mbziqMp1hn8zjYqhGmfTQzqpbFrg-ZSryJXKPK9Es47o5pKDlbWxpbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ibCUqDymMaPoAh8Betv8KJ0-JqH96Hf5YNeld8Dv0Jg&oe=6A08976D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5meYvOLiO4Q7kNvwHIMDuj&_nc_oc=Adq8NKxijVcvtac3XqlhPne1YEjFaU_0VfE7NHyazW_GB1rqjAVsLoXZhQNuwaUDF5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ITeco6E4tv4lCX38shkoAuj8UE3ruwWabkm7M3I427A&oe=6A087FBA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVh4VDbVu5oQ7kNvwHYSC_e&_nc_oc=Ado6AUp4jsp6-v15G6ImNmoLklDpwM6zcf8eBJo7YC_Kok-3VaBQI9STpTIJGqrSipk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uU0EwJ_5mpatVEWY9u-DtZNxjlwPRfPLFG_NpRQXmSg&oe=6A087140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvuLv-NwBgYQ7kNvwEQQqen&_nc_oc=AdpzEpzeeKUs6pXs0zVy5hk8X4w_NmoHTCg9die78ejPOWyxD6RB-aDsuZtXFfgGjn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A2pnMufpHpZXbeBgUtXDPTmIo7QQf05c5E7eQmsuFpw&oe=6A087C39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
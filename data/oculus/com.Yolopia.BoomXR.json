19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v67633YQGw4Q7kNvwG5Tn7z&_nc_oc=AdrU1yMUai1kBvpWfZCB4VK5icH7QltR-e8khbJkCM_igPA7PYS8nUoMvu8ScIqq9IU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tNjt_L-VdVKH2SPvpFeW_45Db9x0mNVu9NYcFZSMe4w&oe=6A217001"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIxQ5zZ_2VAQ7kNvwFdeTnG&_nc_oc=Adpgqsrfu_40r1O2G-28k3wlQQW5BzBOdWAGuvvrrcKhK8IbJEB_Vy6MTTdQ5w9oEaI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CbXxb7NOlk_Y_aIeR8zgisazwrWD9xzgYzXKHRVhB8A&oe=6A21A3ED"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qdaZJDD8W4Q7kNvwHqoBwl&_nc_oc=AdoJ8HGGezR_Kjz2mMT1570z3eqUi9lyV_OvIKMOu20uaqEi32165FigWsTSBPcl4ls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SlqzsaZrP3j48Bq7RyWtkTqssRzEE9zGLvc-7AHQWmQ&oe=6A218C3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3dFRYirggQ7kNvwGEC1Nl&_nc_oc=AdpfH36cbyLUKGA7YqeCMABGy-jKh3_xWES_lB92W5Fa7hOeELVBKk-N2eDDEmboSCU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8b3g0w7sDcdLJ6IAV1y86TD8aCXUM9F7Znd4G56HQWg&oe=6A217DC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeAYdYQ0ZjAQ7kNvwEhqMmA&_nc_oc=AdqxvJoy9nDIhrNXjDIZTe6I971lzVhi9bes9-mYMs96mykxd_sb6t4cUWkGyxhjvBI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mMRoQD_tnBS3sWy3GJ32sa96ePjNcfLVgKRJPvIhbOw&oe=6A2188B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
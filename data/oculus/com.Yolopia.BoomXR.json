19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exsrrmHXkRsQ7kNvwE7NNOj&_nc_oc=AdpRyvjwf8Xf6iSMcp0JeoV8OS_2auKFEnH0SAoT6qL7RgHuz4DqO2h51qG7ABJgxiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUtHiII27jP3qGeV2dakUBXS69vV1fhWDXLOOOb7Xd3w&oe=6A9D5D01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83OoZaA4pbAQ7kNvwGJ4yUE&_nc_oc=Adq1pUHmkL0bzdO_7-lIIkFp6XiF1guYMlN1u_7pZ3EEXM6hDoT9LF1wzt48LDRqPOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdjN-CeI-yhkpx9hUapzNC-57HKdbZqI6bzClOidKlGQ&oe=6A9D58AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejnwagih9WcQ7kNvwGtjPCb&_nc_oc=AdqW3UuiwQCndgOkagywbcZzyHNOWNUQaCegpfHyG264E9M0zZi9Y3aEWe9xd074mA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu2GCb1-IWN31iXys0PlWpSOx1q8pIubwTMlpmcRQ_fQ&oe=6A9D793A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sag3Kds9xxoQ7kNvwHX7k7m&_nc_oc=AdpfuR4RT7LuIWlC85nrGOPPERconIb0s2JUb74a0z9I_AaCgo_PU6DGU8uh0ztSF18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRYzgU5mowf4KGLJT_Ca-3Y5S_4ReJVP_Yki_UYFaqCQ&oe=6A9D6AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYMcAW_w3jQQ7kNvwGz6o3f&_nc_oc=Adoqr3rMoIWIzD4qL0E278h-iJMnbi1M8WxSoOTgK-LmHRrNfr1Lc3x35hD-h0JrYv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6VSUM_iL08pNLnoPxhJt1hpLUDT3Gbx6oPVdqY7sfHw&oe=6A9D75B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5lgRW-nYfkQ7kNvwESuuCx&_nc_oc=AdoVAfQsP-YH-xzCQRWz3ER5gfYLf7TTR2H0Mqb4tWzzeY3hQ4XgS-a7_qOaHKVlbJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D0f5i3ujrqyjn3TQIhCkzs2zcTU0k0d2WNGdavavqsQ&oe=6A3EA941"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MILDFzCR4bgQ7kNvwEn7UsE&_nc_oc=AdoCBwVJLrpL5SEOeYJRQiC6nGx1wIHV9Mmdb1dr3qX0BJNP8tNnHLa6N7lxh_EMkL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mxEBLPKsNgaHj7SfSpJs1P2lgOBGiVD5KMIVCngQ4vA&oe=6A3EA4ED"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7P4fL6yC0hkQ7kNvwGx8UBs&_nc_oc=AdoEqcxT4Tj5AHsJte1KATyFUSbnZopdgzV_Mh1uwG-ugMz_1b-KEyW8m8NMNDItMJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9drUuaQ9rPEHzF3VcRejvFFsVXtOv_77bXuXlsRMt2ZA&oe=6A3E8D3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_5k-ScIhHEQ7kNvwEDyODa&_nc_oc=Adp5eufuCZZ1tAyPsIBlO4v4zEtfRKYJaisJSkHbMcWX0VmhUSlslfv4W4kFVuglWEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f1e7pswzBSLEz9jeaDhvLmva805rleX_TaWZHtt6n3A&oe=6A3E7EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLNyLA0jXM8Q7kNvwHVYZ3k&_nc_oc=AdrnbGYyyAkNtpfBg7CKxsa4TvBaFqqUZHG3T-GUM9QdQzSdyLHB4v52EYsdUPjJApo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C36wMrU75NnCobPtnAhNrPi5ZgMzkdcUDI-ThnWHdXQ&oe=6A3E89B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
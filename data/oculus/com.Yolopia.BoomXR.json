19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NJrt9E2u_wQ7kNvwFk5bqV&_nc_oc=AdoeTshusf1DHhSg_IjZ-4zfY9OZ1i06kpXWNhCMD3Qc0r4U8VEozSyyFSG4IBpBgzs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AIMEGT2FziS32dbc4uotOAQxPSu36wsTr3BPiaML53w&oe=69E22801"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG-7tJkbBd0Q7kNvwEbY5NG&_nc_oc=AdpKwN74aOfFMeWC__K9jk_et2SVXlG4rc3Kz1nfqyE0GLaLOXxMf7T02WUgyzBWJ1U&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XP0UYU3BFgJYZGIUHF4UPjuF39w0OcR-ico6jP1m_IA&oe=69E223AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EE4NVBehvYQ7kNvwGmgnpY&_nc_oc=Adpji0jskODEgXRfwbkWUKRva4rDj2CiFsuefes2K-vSG2mjWYDcQSaohJ1QNqlNNq0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-nLaMmzInw9ibupBoFfNHFHDLfa7qLbaXb_S6fRmCTQ&oe=69E2443A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kow38-7kcqQQ7kNvwHsryEn&_nc_oc=AdrF7gQ0TD9fWJKfMd9arshKf30J4Wyj0eA_5-h4_FlRJ4yfm7yPWE9la_4lVqTEJSM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b37i7wCEhLYl9bBFGHV67kKud6ijFHL14D3pK-HYOHw&oe=69E235C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGhY5XH_WR0Q7kNvwFTqJ8X&_nc_oc=AdqJngSLn8y0exKQNYWDPq94uF87p9xSZjjXmctKkIsTKAnAcLjTdnhJrLD2ztJpx9k&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C4UCTVMlQsFPwVSMCkwsz_oC84L-jtPI52gHoTGUVVw&oe=69E240B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
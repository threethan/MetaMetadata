19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cuzGPSpsgAQ7kNvwGfw0eV&_nc_oc=AdqZou942MUQ9jbjiX2J1SD5zD4wIzgQ9hM9R7sgEii2i1x_hqRq-icWfXjy_nDM_JI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwcU64x3a9ZLKjKD_WYoY6zfz836ugWHAdOYt_dsRhGw&oe=6A58CF01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ8jPDlJrTIQ7kNvwHa5tQk&_nc_oc=Adr3t1BBwZSFZ2eKc33D401whO0R_YV_TdTywGodvUvvV09NUZCMCEI04frKqxI1RDQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiOeKK44kFNBvX6J9uqo5ewyOaRzi7N8YxYYQLtZKdJQ&oe=6A58CAAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvRcEO0L8-gQ7kNvwHQn8iL&_nc_oc=AdqccGdT5KEjUFEnHnJ6dVYv7bSsp-9Sd6_a9DLsf-pNyL3nCAo_zfy750-fFTQWTC4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQKC7NHlfOGkT6C67QWxdwI48dE9gqKeISEMxozwFBzQ&oe=6A58EB3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbOg4gG2KFIQ7kNvwEQMWtd&_nc_oc=Ado5Ta4RNp3bB-ul-uUwU12niMocOSpiBR7ee7JHgSRD1QSitRrzlP3tDO_5ZGJlnFE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAefXsOYR_JKqgc2S2GsWoUllAHE46fjSD6isO3KD8pnw&oe=6A58DCC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9jKdsbd144Q7kNvwGpiZWc&_nc_oc=AdqGfq2hcuhbVCT7IlNZL9pZD5rMlgfJEbprMLFyy6MMpP8pqX4i6S2RfKcuuHmXC4w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr_rB4URZ8rNS_5naxt50g0yLOv41lzUkELyOyJhukWA&oe=6A58E7B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
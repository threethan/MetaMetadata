19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fqkRsS3iz4Q7kNvwFvFPk9&_nc_oc=AdrgEhiWyWz3MUFE4SPU0kTYVnim7yTHOm0cgnZtpivJxgSk4B7Foh-2u7G6hsIp0yg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ult7vEgz2wkhgYyuM3QVvtWXmm0-M8r_Z1L2nCvx33g&oe=69D79C01"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JmHcenTnUUQ7kNvwH2mP5U&_nc_oc=Adqfp38348IANjVLGXpGsw07hAsBzDTY7XXJ3DbsDM6jOk4cPgCvru4_3WTzcSykvng&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SRnXpvAgN6gs1-nsMuae4pp2hHfJW4N6X8-aKwyA2uQ&oe=69D797AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvNhmN1IaGQQ7kNvwGQUJZv&_nc_oc=Adqt5CI3nIya4YFHhVicF_8W7Bh8A-WTP30axJY4xsp4MtKNJ1bbQ7tOd0T3j2Z-ox8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33iYZulLZDNKBn44SHn29g3hX77IZnBQX6PrC13p-TDQ&oe=69D7B83A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWZTb9hSeMgQ7kNvwEsvHuW&_nc_oc=AdqT8rwwEMkZIj7v07W7mnrmcFf8JYrwpx7BgkZHeeqVyRj-EOEpC5ugP3mEDLOTgHc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nWG5TxAHUsiLjwhhNqgzDQFqVdfFy9eOi7vsywtxGng&oe=69D7A9C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joy5odB0CrEQ7kNvwHInVRd&_nc_oc=AdquD5FtvRhPYlatDLZYN0GTyVdG6awxoqyMVsSSR-2SGQrV3fjCTTCn4BTHEWATKCM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DKt9oY0_K3Yxv3lffpvaGVSAq4tfBX-5sgWT7YArz5g&oe=69D7B4B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
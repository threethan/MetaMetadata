19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PNpdnOHPoMQ7kNvwFHLjRZ&_nc_oc=Adr6iNeFOz5E60C8mJneJVc_uGG02hEauHAm3HCegMpT74h7SW_6HhjdBfyNTzK15uY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtn0K3hMZ4xpFSy3arn1eJKLsaLUn7hjuoEosGco729Q&oe=6ABE8AC1"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VLUN5Y6U8sQ7kNvwGS8AZE&_nc_oc=Adry567L9BvWaCJnsshq4j4NaAiZo3K3N3khj6unmXbnqasWQjLSgWTEKOaZJi168xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjfVb6RkWDGQ0-zz3FmsMl_BaYHBf6wG7MRU7SeAlb_Q&oe=6ABE866D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSpdgb0v7SIQ7kNvwHaUOMx&_nc_oc=AdqY2UTRdFshmMHQQv0ZV_Hu02e9lM2PXmwJEXANMA0kAszEQ846CBF22Ppp9iKsc2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS0_AaBz8X6s4POV7lCzdtKBdpO5qcwpX_4PZABmwGiw&oe=6ABE6EBA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M44c4aXHp9EQ7kNvwE0NJv4&_nc_oc=Adom3calYA7dpIn24-0yeLEwkN-UIIt6gGJzMeeStU9UcjW4gZ0tvmG5pTbJstSH1rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkBlTHVExb1HP4GOUFH-uTDDHrioD8aodRXP7fzMk-Zw&oe=6ABE6040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7agK8FaN-kQ7kNvwH0Dqz9&_nc_oc=AdqgQ2et1MBjSzgdcIKafD-ZrK5FazOmf_adnsT7pHVcMEzEEQfKIlNhai_djjTI1cM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLebBZ0DlTcspfMETrjcJf09RUtpODHhyXR3rf36p8_Qg&oe=6ABE6B39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
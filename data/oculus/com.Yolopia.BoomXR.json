19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaK9VahOwxEQ7kNvwFEVhWl&_nc_oc=AdrAMj630X-3UsUD_XsgCOet6J9FnVI8ItFXYBqGzbxICyhiBiTlMB0JiJ7D31FihFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SuIYwUE1kDa4NYNps0gMgFmCo2FbWNFcgDgn_z4pl2Q&oe=6A071201"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq3-N5sB4qYQ7kNvwHY2-sS&_nc_oc=AdoSEBGYux7pIE_KDClsof3rUuctIUYPNN6Lf0qz1qODUNv5Nsmd6POHj7azJ1FEE9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H0fOlzqqAs0lLdVrho9i1xOTLH6ld3pLZy1Rp_-z-PQ&oe=6A070DAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5meYvOLiO4Q7kNvwEwLOqw&_nc_oc=Adq-bF-U3x3-8fUaK5MMSv7vZ2lGk7SAN0_h7JSLnRW7WIoQiNoTh_50aViSNKGrZbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P9bi0R__4HD94CJ3gCJK_B26GXOmIXOezx3k5mOQ5FA&oe=6A072E3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVh4VDbVu5oQ7kNvwHpAbVk&_nc_oc=AdoQwpCF6mKMdmxvb2ceuQOHjFwRZEH5yxMqGmMmLUfVUmlw8oQaJgphi4E3Ix_T-eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pgJqO6Azob784CIHttgW3kj0YsKLc9hDJ3-ExOlC8FA&oe=6A071FC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmvpn88mvVIQ7kNvwH1fXxO&_nc_oc=AdqArgcCezH5aKIO5tBi2X5qviAIDPVSRK3aPVO9T43PXqzq-XuVNvpPjleUvhHQGn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rQcnBIJkdOFeIqOmHEgslYcHFLX9h1lTGHr-au4T_9g&oe=6A072AB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
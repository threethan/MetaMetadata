19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIq7X-pxVhEQ7kNvwFMN-XF&_nc_oc=AdpsscRSa7PbAXqDBjK4eikhuPWFGPsolh9J9QcDOe6Gc4O7wN2ejG17_WSAFTpJ5eM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpTUkBJvW0e3qBbCPGpV6YkTLiFwRlT5byHoJW7CDSmA&oe=6A92D101"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqt4hhK1FDgQ7kNvwFrPib3&_nc_oc=Adqo7myZD-aDnFaKz3rd4DqkQwo46w2EIVTgXQH0DAPmEMpvzcGtRe5JLHrmXg4b8xo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE480JMbnHgq_gP2i1S1PWccguTKlQAE2Fd4pcrtuRIxg&oe=6A92CCAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KxodRcnLyAQ7kNvwHgE2d8&_nc_oc=AdokK8VxmULjen0xL3-uwo-1fhdcgACpuJFbIeX_L6mO-USNIUwdWIi_y294fZBZj58&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlERUAslGj3rMgF8OqDEfG23iWCnxrFhWZoXdYUdUfFw&oe=6A92B4FA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUC8bij2T8MQ7kNvwHLHRQx&_nc_oc=AdoqA_7DUhib4oRrQJChOxfLAoHtLINCESAxRbKsfqQEjQ1zlTcjAhXx0YmY6hhNRJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6gAH6fI1dTDABQ1WxGzlzrtuoprHVg9YgkveeaAz4pQ&oe=6A92DEC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VDDc4THIIoQ7kNvwHBoMab&_nc_oc=Adqe-oWbxINMYqfkhozq5rrG7XPXpfy_D1wNa1VK9hnQGMcNRCr-AWoHTTtGmMxeOFU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl4PquPOMLpK_Hz9YoQccbHVhzfvVqNpTkJ9gokOAzxA&oe=6A92B179"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
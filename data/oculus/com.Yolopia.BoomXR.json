19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV5ZlN2eb_wQ7kNvwEG9hS4&_nc_oc=AdpGuIQcmSVwZ2qBNoHJfjAgdjx57CPX81iAM50N6x-rgot82Dnass4yHxt_jYDsZG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvqwiZdQ6DrgX6P_YBQbK0OkE8D118VQWUkzLPfUwHfw&oe=6A6DE701"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PF1N6vFkCkIQ7kNvwFeRxSX&_nc_oc=Adocpe9pVbKehwHkbv9CTsFx3xvt3WurVO3feZmQMo7DyGiEYF68uX7TvKPh83UGhTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD75ku6I109Ym-x1HmmG9bZMYNxT3EID4_NmOs95FRmQ&oe=6A6DE2AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZOIP4uV1DcQ7kNvwE5F_9W&_nc_oc=AdoV28MqO2F_fjs-fpfyof-MyYWhBHUQbQZlgoQzM1UoXq6BTTv9KavT-UOm_pMmsyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyPyZgb5eMaVbtkTC4v2TJxiWshnxBCqMqq6qyLMC3gg&oe=6A6E033A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0UhmIhVgjwQ7kNvwHWeFZG&_nc_oc=Adqgh0yEkbeGJrvB8MacGaF7bs21-IZyYMLVqkJsRDRCiMDoCyg-X-kRRpOd-MjzXO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLH-wFb0l7gC1flpSkBrFl90wRr6cZB--L6XwyNwRlUw&oe=6A6DF4C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPndprrU5b4Q7kNvwGnIft3&_nc_oc=Adre1pJ2ikyI77ARalvev8eIkBctpbLMRtdqGFHfgjVQ79jpAHnzeNssHh59EvEYvWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-5XLTedQMxh2w6k-O00nsFNwjK9FTnLr8wsonuXx9xg&oe=6A6DFFB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74IM_PwsExcQ7kNvwHSmM5f&_nc_oc=AdrNprUgM0eu8BxdNa9ljnbiif0qVIHSf82QMEJqdu-TneUwcEjrAeVjxwFsKWi847E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLppRouUJ1UJQVut6I2aQhyBkLLomGo40y5gkaxiNyKg&oe=6A7B1601"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v2ejX5BJYAQ7kNvwF8Fh0E&_nc_oc=Adqrn-uqhLsxhbq8VFTxTV0zduP_K4-pcspj7wZIGFdTcj__NmZ2F49pTV8hyKJW_f0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyIpBEaK5c3Ewrhe5ttOO8O7990BJaV_H44BGl6FBKnw&oe=6A7B11AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHYaqPjTon8Q7kNvwGSXs70&_nc_oc=AdpborbD-G6cYlBdgYB8CTiHoEkM9138JvZOy7bIAIwPYn8JEKV8dNEEfDz1ISS9GUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ4tV5H0VdtYHhVwfFOf3lD8kjENr14usmGAjMnayk3w&oe=6A7B323A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5VTIEc-5RgQ7kNvwGwNngc&_nc_oc=AdrRXMDqOMDZ-FVqacLKA-K6q6RJhaaHtQxQqiOHoEEQVcQePkFDnL8_YnjZax71AzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz11Mu_li8xOQQErLLsDoR3uEa3HXBx7XOEwfkkhw1_w&oe=6A7B23C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvUeloMzfoUQ7kNvwELF7rv&_nc_oc=AdoNXv9LrnLklb8eUyvydABk57CtrEemj6-u-ZUNynaVD__2aSoNfp2eMQZYLvZN2ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhcUBFs_sK5gy0iPwShiLW-xoIL2q7rBAXLykURHUXgQ&oe=6A7B2EB9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izTDfZwfEVAQ7kNvwHfjLHx&_nc_oc=Adqn7rh8y8f0SwxmJaUReeFt_gvu5iAZkE0m2ikncj08nCPh1_h85TJfd5D-CVNuw98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRNnynf3wwG322JpBlSmS5INgBV14RkmEl0XCuxghKGg&oe=6AE76941"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3PyAZuJseQQ7kNvwHCxHmJ&_nc_oc=AdoRfN73mybZkLQVx5nH1ezb65WgAC9VeOqqt0ipqcAylr9YANigZ1mVmupj3hE5YUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwp6vW4mmLXSowYAW9vGKKhUvVp9jnZNcCuUKpamp6zw&oe=6AE764ED"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_ilRXmB-1EQ7kNvwE_9zl9&_nc_oc=AdrvrJHBI55Qetc6hGsj32Ip6pYeqCa2VSranCg_tXtABGJs4XNEQxgRDatHQEqnhWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_31Mk_lw_1FzknorpYq0lmkDj5PcvoxJ-f6NSb9q5XQ&oe=6AE74D3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gAtjjwHH54Q7kNvwEfgaMY&_nc_oc=AdrIR3eMwEPnDC8PDMyComnm32RMENOCC6GVfnALwtDQ_PRh3aF8BM8nqT5OV26LcLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWcOYOVZ6eRT8d16JTBOrQKY2r1nb0Wsn6dUASy0TIjQ&oe=6AE73EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW37ebaSDzQQ7kNvwHgsUMM&_nc_oc=AdqF3r31qd0SMMCPs6GeK72Z7sCba7KCw--FGbAjMtU3mn6HLwTVM6JRcPv8Q-8sSkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSShWr_U2cDUUcRsS6Ubz9XY8GGPixh_7whLP0l3qHNlw&oe=6AE749B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
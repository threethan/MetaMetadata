19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shxM3hxLyWkQ7kNvwHSuFTg&_nc_oc=AdrqMObCK34fPH4TF-gSzRkCvunNrLr3Z13flvlNngHlGhp6WQKZ4eU2wcaPpdpb2no&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2QP4XORc0_jzGpl283zqewQo8MIyFRtqZiLdc2YGuYg&oe=6A884501"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTE4ioCFpJEQ7kNvwHUVu9U&_nc_oc=Adp3fCxAskC1e1wQhMau2rPt_IpN6o1O5YpF1TLaP3CQ7mDefYGNLGerfCfVIKTuYRw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8lslHebzO6Zn3FZBQ1FRNc8mF-iL_v_2T3jt21XtP_g&oe=6A8840AD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUdTZWBZkHkQ7kNvwHkohxf&_nc_oc=Adqoi3nhjFvQid2OtJIq_cxmS_n-1OTMtPbFQEwxl5oYne6wNeo3U3IZ7sd5DMOGS8A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZya9E1o2rdR5664j3_pJKJzZ5YQDPl9rhwBlnBYhiww&oe=6A8828FA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aP8ZmzU6Y4Q7kNvwHz9uDd&_nc_oc=Adru0aIztaZinMkR394_ND8ShYO1UwUbUWr6sRklUG-nU3gm12M286tLXBbtTtjtFoI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyqGqZr3o2yQrCenFT2o9mz6HEizuemqBX5jrWCQ97Zg&oe=6A8852C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5EF3qHnTZsQ7kNvwGS6e72&_nc_oc=AdoxAptpd2vdX9fjxZxHPZeccVNiNSf_nC1YalUHYfuFESeBpjM6KRms-KF3KIuTg1c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK8gXHvhWVIaOO21cNeCyA2ev9st5wKsXtxkHFHBgbhA&oe=6A882579"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
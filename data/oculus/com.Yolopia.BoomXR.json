19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT3qMzfD85sQ7kNvwGzxI9S&_nc_oc=Adpsv7YiU9o6g0oWEsia6CdikqDF7bgL4WFpnG4Vx1AWlixWfvbRRXDz95RE6PO8e8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wk9AB_LrGNNm80mxW-xchPXStmEXQRC8NaxchvqJ6kw&oe=69FB3481"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vol7Vaem3sEQ7kNvwFLETZb&_nc_oc=AdpAF9nWwFhyhL3XjbZrBpgDSSt-CVn0Zt2ti7YIzLhOO-q8wXLHH6gloWTEL-uc8yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WPKZFRyHRzPYOMgkPQGvNyGgSXy7ROR7Uc8T2TrWvig&oe=69FB302D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9aincjPHroQ7kNvwGCGN1t&_nc_oc=AdqdgSNCKAPElt7NbtLtLLyB448Tlbzq4FVilYRcb7FZoTLM3N3tJME4U-Z_An7H7zg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lY4UV-26VSVbwDmbUXYYJg0Vng3PjpYy5mBdwY58iGA&oe=69FB50BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABXXtUqBrGQQ7kNvwFTMhx3&_nc_oc=Adq7j6gQmjFHnksjcq4cowDW3ER1hIhSSp3DMZ6qvK8WTVFG9vJJbf4wSafwLShJ8H4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7akS7h2vSFWY6Wi8Yrak6acgqlSk_Rto3nlrcqd2Dkig&oe=69FB4240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB6qw2eAqpgQ7kNvwFjKZu-&_nc_oc=Adopuv9KnJQbSv8aea1Q9sNBB6KLphV9Y4SWRuZ2FwZRmt1cBnfKF6oU_KBS6ZqQsuE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jLecrwBVqVnY9rxNxddbhtNn5cLsfmJhGgDd90ecQnA&oe=69FB4D39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
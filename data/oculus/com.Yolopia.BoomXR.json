19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqdr-v2CbiAQ7kNvwFihn45&_nc_oc=Adq3EdIASQjFxD3xUFoGRIROBkLTCfinzddF9JQVjs9Ymvj0aoxfWiHuYY2s3PRMPKM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gCgu_n0kmuHXtRQ0icJ6xM4z36Db7Bz4rw_mCmtU7kQ&oe=6A104C81"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxZmP_B3MDwQ7kNvwGTVsMs&_nc_oc=Adp22lhxtskhEyeklmlVJOeMFVVsVTLdDCL_ktNmaoZ-Bh1jeJS5DMSloD98ChxEM6E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61PB1g2Z1yRJKf-M0nFfQ525Fr7M7xkP5SKR9aeodjAg&oe=6A10482D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVfsDctxIFQQ7kNvwGMRmCa&_nc_oc=AdqDBdpyxHYzSm038ju33J_m4w0axoBx3H2C59q9T3KgK7jHbB5ZzsBPVuGaByMemjg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XyITTNY0E1u3iZsylg6K54tQ1V8hV1NH8nZjZm1ZMpA&oe=6A1068BA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvgW94mZN-sQ7kNvwFPsPSd&_nc_oc=Adqzl4O-prmYaZkSxxbCu6Zfqz0QeQDn_O2EmzlqDwFLq5zTmao3sjJPzBo28pCApNg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u_ppQus-WkNhrDag88o6fkDCy63XPtclNphCzxr3INQ&oe=6A105A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OheGUMEqSQYQ7kNvwEAzarQ&_nc_oc=AdoId8dFUGVq47cMdV5e6S3N5H_9llqU8rl_WMDp7kMnSVPizMG7dFnT2PEAIDM49aA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QsNFJzKRIPaYedmPAi_CHEd2JGQqfsWLoUaXWhX9VyA&oe=6A106539"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
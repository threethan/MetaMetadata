19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akE9SbRIGicQ7kNvwGUT1ov&_nc_oc=AdoZnl1dCUSS6UkXC5R4GYfoiWHNCF4NY--_AAEnAMouzTMuSUlk_ZQpsXVWePtaYqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwgjvuOPfLmKG7Acv9IUm4zokDsjOml-UXke9VbZiAuQ&oe=6AF346C1"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRjrsb1ObnwQ7kNvwGU8y5f&_nc_oc=AdoTCBEQwfKhLbaLQFA5Ot89zL6kewcd13NcodSba72dZ-m72MSLnCkw5v5DQ7NONps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Vm0LFuhJHIT-f4ZQ-e_z4sX8G1U5TpCe_zmCAj8EcA&oe=6AF3426D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAnf_-IGS6AQ7kNvwHzIN7j&_nc_oc=Adr2SjtWh4EnmQR423U5qp7kd-rEr2UVgs3NKi0YN8datz3Q1hyYABxL_nez61rqdcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfqaYM0YDXtGO7nALrLCC58FypzMB30X9AM7E547VI3Q&oe=6AF32ABA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MSNPQJCycoQ7kNvwG7XwWE&_nc_oc=AdownJ7ozLPQrlj6z-GMNQHJkVI7dB_WFmZT7c8zJqcEnNvKVGemHI8wQzHz4BkAohI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHqdyFOZ4J9pdXpmHlpCW1B_hwmowggHF8Bya3xoS0Eg&oe=6AF35480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z199rPg6SNsQ7kNvwGGH7co&_nc_oc=AdqRHSMB7JBIHDnEN6V3ftFIibtOF4B_8p6P0jLkRHUmXBdIW_glNMIuACUf6Z_-2QQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlwmJ6sGhhapX7FfCslKBGwY-4rI2kyyaIp_phG8qsgg&oe=6AF32739"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
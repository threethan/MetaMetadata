19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKi31prVvR8Q7kNvwGniveF&_nc_oc=Adq_F-lkxZ7TkT_5rYn4ZJrgoYl6ISM3m0jZtgUjC_r2GDGajYDzas6IHZ4x7MenVuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO_AIFOrkWFvxVNTmZ103eP5hPKB6L0xv3t62lIx_flA&oe=6A4BA001"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQcFSA1GMKUQ7kNvwE6T2La&_nc_oc=Adq3Npy-PBhthcOwrSCH1d3jkYg3FHqBRl5ZISiYB7f3AK_wO2KNXsPOpwjU8IcYAtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrvz9KkTR-NWWlMsGWcWZlOz2L9gqmx_z-b4Z6GU8qYA&oe=6A4B9BAD"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9vkz4E5o2UQ7kNvwF8QRlZ&_nc_oc=Adp9O1EkspUcfjuJ5LZAhlKPW0VkudCVRPOpPZWt9mbmsPR12WtIPEcfO3TygE4n_ik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBUEVn1j6a2HlpLWkgT9cQc_G2la3LIS40VEo-gOj1nw&oe=6A4BBC3A"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot3kQtPf8bgQ7kNvwHSHKqC&_nc_oc=AdrZuGeKGidtkgg93-8Ew1AqlvqEYVE0fxpJ-uAvL2kTHAqyjIDO7LUhhUwL_iI1PyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClyVziRT5SisIMy6hVf2_MlVD3VsApCSV8lzr_PW0wDg&oe=6A4BADC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ZtSWQ1xSEQ7kNvwGsYw4w&_nc_oc=AdpKiZbG6o0eSPJWnq1Ky5eu2dMVaTdejl9fLHrFS431AsoP-y_WYceJirXi12Jy66c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLWgw0D7egAjki5poG3AnoPuyZFL7lRZwDaB0fx1ZOSQ&oe=6A4BB8B9"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
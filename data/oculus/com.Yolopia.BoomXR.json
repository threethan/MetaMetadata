19_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu_LwSxMh40Q7kNvwGIzSX_&_nc_oc=Ado2NOwzAsfKQ5VtNVPCDhdpmrpprLK_eHsnvS53jzwIFpfa0y3uTMEpQZtDJLKLIik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qqih3PLhdGsCRYO7z2c7YMIS2k55-AbltHc2eCVXftg&oe=69DE3381"}, {"file_name": "4.png", "id": "353702976195723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974878_353702979529056_6304600782254362547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4G2T6Xj_Z8Q7kNvwH8sAMf&_nc_oc=Adr0nZIeAAct9jk1TvFXhWHsz-p6TVkRsr9ppCijdlhvCjAn6C1Pg-2cTVIJQsQ_BYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PlE0ItWXsYAbf8QLG9De6wEjBmLEmrnKCDOyWEh6Wgg&oe=69DE2F2D"}, {"file_name": "5.png", "id": "964566334384343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_964566337717676_1169298822759567376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWHQ_oHuU7IQ7kNvwFB8d1g&_nc_oc=AdoO7ru56-uxPp8ma97Im5ZxW7Wq8YyhWurhl62mpf4ePEMTlsstQdyl6wRELf8zLQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h-i3VWOOBY6GMRY0EbihayRsRUnop50f_oKURswNFeA&oe=69DE4FBA"}, {"file_name": "3.png", "id": "4486719454727031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_4486719458060364_1113984044610949546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3Z0mIh8XWsQ7kNvwHCSeTN&_nc_oc=Ado4tBLJJgAInfag1u9R9s30AoXo58w-GlxX8tpLZxCoNBK9ROTpGQGjiSvb5yx1T5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VlkK35Q3h2LXLqpcbvTxwHdFl2_koYhqTdvomJ1WPgw&oe=69DE4140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "508612663541185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974510_508612666874518_8175450015938176745_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTS4nvwXvm0Q7kNvwHxlyI8&_nc_oc=Adp8i0QMDl311EQymj940Nyu9ihRCv5pnJ5cr3RmDJAUDe0jHpVEj8NmKmEa7sdQtZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f7brHQnMB9pk88buzKVKNKCwIaVsr-6vNQcG4P3IREw&oe=69DE4C39"}, "display_name": "BoomXR", "keywords": [], "long_description": "A boxing pad trainer where you hit coloured targets in sync with the beats of your mp3.\n\nYou'll also have to dodge and parry strikes as you top the ranks of the ninja shrine.\n\nStriking angles are strict and the game promotes hip movement for intense workouts.\n\nThe dark setting combines elements of rave and martial arts in a colourful experience.\n\nAll the beats are mapped in real-time by our algorithm, including the default music.\n\nThe game difficulty adapts to your live score so the better you play the harder it gets.\n\nTIP: Create a folder \"/sdcard/Music/Yolopia\" to limit the mp3 search in that folder only.", "short_description": "Ninja rhythmic boxing workout"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yolopia.com/privacy.txt", "developer_terms_of_service_url": "http://www.yolopia.com/boomxr/EULA.txt", "publisher_name": "Yolopia", "support_website_url": null, "website_url": "http://www.yolopia.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1608226852865879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569478_675820116616496_790858228840571410_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_s
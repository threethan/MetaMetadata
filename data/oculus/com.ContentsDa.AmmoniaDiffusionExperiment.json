986743_4518304671208019622_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PwfWgdSlcMQ7kNvwG2nBfP&_nc_oc=AdlsbusxsY55Ye3LjQoP7ysA7zHEg1WowHhBZmR2fSnfMUyMRra9C5zLoGnBT6_ndbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJOyMN-WTRBxnRl4TqCX6pjDf6PPuz3K9pi1JTUj-Kog&oe=69A96E0B"}, {"file_name": "ApplicationFrameHost_c4K2kxpJDi.png", "id": "566933419043264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982524_566933422376597_9050014874276581405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do3MUeQOQU0Q7kNvwH4Knhf&_nc_oc=AdlAD72S9YC7M0uOcUdbJt5N5nURUJiKf2W7zlevnAgPik96r3d2CXTp9D3uiU3mwV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsuB8PYAjvAg-Xe3mkn1wcocsjLkiV0Xzk_Sn_s48gS0A&oe=69A96A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ammonia Diffusion_Landscape.png", "id": "244853718574136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580067_244853721907469_6301256585689989538_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWYGAGxC3FsQ7kNvwGmqoSw&_nc_oc=AdkS0VxnaFt1AdTXcEPSOKFE44ohrmaXYOX38EQuoir7T0TbYSdNPBluJ2MtVwPImpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfulwEBPP0c2XjRi77rcsrgYE5OIyy2MAJpI77W1Z6QVeA&oe=69A983DE"}, "display_name": "Ammonia Diffusion Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "molecule", "science", "contentsda"], "long_description": "1. wearing gloves, place cotton balls in a crisscross pattern on a petri dish, four at regular intervals from the outside, leaving the center empty.\n-Use gloves when using the phenolphthalein solution and ammonia water to avoid direct skin contact. Ammonia water can cause skin irritation if it comes in contact with the skin. 2.\n2. Pour a small amount of phenolphthalein solution onto each cotton ball, allowing enough to drip off.\n- Phenolphthalein solution is a colorless (clear) solution that turns red when it comes into contact with ammonia (to show that phenolphthalein is colorless).\n3. Place a ball of cotton balls in the center of a petri dish.\n4. Add a drop of ammonia water, then cover the petri dish and observe the change.\n5. The odor is strong and the lid of the petri dish must be covered to prevent the gas from escaping.  \n6. (Result) Observe that the cotton balls closest to the ammonia water turn red, one after the other.\n\nThe cotton balls closest to the ammonia water turn red because the ammonia particles are moving on their own and diffusing in all directions, encountering the phenolphthalein solution on the cotton balls.", "short_description": "Step into the world of gases and discover how they move and mix. The Ammonia Diffusion Experiment provides a captivating visual demonstration of gas diffusion, showing how molecules spread to fill available space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8612101258868701"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_1057187212206726_616078411
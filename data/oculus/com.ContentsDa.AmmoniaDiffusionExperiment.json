9_1090700092643417_4289183535863583609_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9tvkrt_do8Q7kNvwHxeEjJ&_nc_oc=Admf0I7nVSpbaM94a3DzsZOqifFyYMBIRFNtb-5akA-3HtqjReuHTfZbWOtecQPUVZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvcE56_PlfrmeXbiHXzgOEEo8jwsZAFwT0fpPZHuR88_g&oe=69A4415F"}, {"file_name": "ApplicationFrameHost_uFAS6f3N6O.png", "id": "1092485509191495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974456_1092485512524828_4991190816067442088_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gYTQ8MLqdQQ7kNvwE54E0C&_nc_oc=AdkfnuUOcRcACQVjosNYGNEYDG2JzVP8s3aifkI-Y84DU-WGoNKQmwI0H7hU4ipEgAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvaIqivmHZpqJi7m-vPY5GeCCR2oBFZ_vcGZWVuKJP3A&oe=69A424C7"}, {"file_name": "ApplicationFrameHost_Vxmki6Ulu7.png", "id": "597011689653410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031493_597011692986743_4518304671208019622_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5YNhxbIRXQQ7kNvwHe69Hu&_nc_oc=AdnYP9xO1r357RR5_U5iw5UQeiPOD8t8q1wv2LadbKsghFpbwo1jgQkLrEcWo0kqias&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft0jqMXrW1ASkoICenoLoHTnyFmsf0XEAWp6bOf5Dm8vQ&oe=69A4280B"}, {"file_name": "ApplicationFrameHost_c4K2kxpJDi.png", "id": "566933419043264", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982524_566933422376597_9050014874276581405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtHQ3lrsYvAQ7kNvwH3kKA4&_nc_oc=AdloV4X4Qg6XvQ5Vb5r_hzCpZJ7Eir3H315tC_-QxGTz7Bg2X0mptKamLf5Xh2_Y1sU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKSSZ3uBt9N_Yl8U-toqWTL_GCaq5FgedoWzHUOrfVjw&oe=69A42452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ammonia Diffusion_Landscape.png", "id": "244853718574136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580067_244853721907469_6301256585689989538_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYBZl6ZPBTUQ7kNvwGmrlOO&_nc_oc=AdlMCAYjZDNHMdZl7FCLVCMFS55rnSSlCQNYtfPTYyHO0fdP_0Z0K-R0ztH-cw7Yqko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs_JkmbLvy4ZjEBrqLvUeXdCo6AV5vhDBT-mYWCPJqNAg&oe=69A43DDE"}, "display_name": "Ammonia Diffusion Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "molecule", "science", "contentsda"], "long_description": "1. wearing gloves, place cotton balls in a crisscross pattern on a petri dish, four at regular intervals from the outside, leaving the center empty.\n-Use gloves when using the phenolphthalein solution and ammonia water to avoid direct skin contact. Ammonia water can cause skin irritation if it comes in contact with the skin. 2.\n2. Pour a small amount of phenolphthalein solution onto each cotton ball, allowing enough to drip off.\n- Phenolphthalein solution is a colorless (clear) solution that turns red when it comes into contact with ammonia (to show that phenolphthalein is colorless).\n3. Place a ball of cotton balls in the center of a petri dish.\n4. Add a drop of ammonia water, then cover the petri dish and observe the change.\n5. The odor is strong and the lid of the petri dish must be covered to prevent the gas from escaping.  \n6. (Result) Observe that the cotton balls closest to the ammonia water turn red, one after the other.\n\nThe cotton balls closest to the ammonia water turn red because the ammonia particles are moving on their own and diffusing in all directions, encountering the phenolphthalein solution on the cotton balls.", "short_description": "Step into the world of gases and discover how they move and mix. The Ammonia Diffusion Experiment provides a captivating visual demonstration of gas diffusion, showing how molecules spread to fill available space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https:/
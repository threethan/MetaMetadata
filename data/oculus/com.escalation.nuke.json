=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMswaji2UAIQ7kNvwFM-3Wj&_nc_oc=AdqLOoPOw7hGAcPNxb4GdUEJc7D1sh0r05jPVHOMIImM_U408-ibOb--yt20Bp2_JJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC8ei3H1TgZwHVjHCU9EG0V1CuohDWhZli8uXNfe6tWg&oe=6AC27412"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxjYUd-6N68Q7kNvwECwqbL&_nc_oc=AdpHbLooSCBRmSIIFAF_3wB71nU8rw-2K7dWSWuCCfJYTzB4-qcAXYTSEoLya_ypVcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZsfMm9UyLeJztojUM4MqYWjDbko7uijp5wnLFfXarUg&oe=6AC250D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwm5eIm-AB8Q7kNvwFlBOyE&_nc_oc=Adp6o-AobD4fdWPCj2wCnPd8t0X8sQX5tx-B2zHzNdRMv6vbBPsPWBayrNc45JX9lgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOu0sSmFPCYONALw5uMX0RTGWdoD8W6o9xx-y0w6XmWA&oe=6AC25AF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsBMIBy8aWkQ7kNvwHcXN0O&_nc_oc=AdpFATc5aEAkZx9CnN0kQimUihrv_K4hydLRxMXGWpU7KUtJHpHIBcWDrLEHOk5cUB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzAyQ-C3_5XI9IWe5K8ti-dy0-fWeCeqFyxhRf8HAY6Q&oe=6AC25B84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1smHJ9nYO28Q7kNvwGZ6nCn&_nc_oc=Adrg16-uRx0x1G_Il7CcHY7tUIJoDzVc97wl5YvL_bHLMkrOIegjAFloamb6dz-aRyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWfSSQwfk0_cjT95SYIXfF-0UREieLpkVY5ukUXJYqWA&oe=6AC26A76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
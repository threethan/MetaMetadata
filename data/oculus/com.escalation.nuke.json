=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOk9QjgtOXoQ7kNvwF_hcio&_nc_oc=AdqErPDrTZJoi8pxe3E1_UzJnebI5qOtglA-jVUkoI1ZUYjlXeTEs0JEFWd5QhANKHA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yJq0k09PI8yxCF1lEnRK-JuJEawSb_C-m7d696NLeaw&oe=6A219D12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hhd8wv5KCgQ7kNvwHf3Ti2&_nc_oc=Adq4TKbIF4-7Jrmb9M7KwUu3q0A0IAkLamBvSvrGc7YyhjnpggVJ7sn4_jHuhxUhe1A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DhX5YRftZxErpm6SDws7psstc_A05Ke4lku7Xf_pAEg&oe=6A2179D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU7ni2BSuOkQ7kNvwEnkHLX&_nc_oc=AdoOIyMAtmZOicAKAXLfh8FVvQUFV9Ie3Ox_NF34Y7fcN_2Sm8ZpmLsv8cbs0mA-tqM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pxKbcAUBNs1Ouh465FEH1zgpAmv2M8Ee69lLO1sjfSQ&oe=6A2183F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42XgnBSWNxMQ7kNvwEeFHxc&_nc_oc=Adr7PkrZ0FJ8fGPCyJnnlcinYuj4-i3JuCEqZBqNJaIzQ9yH2FhmARP0obl1B_VPYrs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h1-1skhFKN9yNq4x0jh20T5m9LWpmBTV_kg-oT3xBIg&oe=6A218484"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F9vMVVzaEoQ7kNvwG9fdjx&_nc_oc=AdrZ08gb7FZRVBRcYq-byGaot4fBvaLFShNwj_MKJLsZXIXg3KYujXjOEv9ZgwhbbtI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j-aqiEDp40boT5X_WUye7SusmTSc5o0-UqNFp6BDhgg&oe=6A219376"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
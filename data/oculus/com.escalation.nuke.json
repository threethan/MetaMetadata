=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_8HOqQHNEUQ7kNvwHBcqtB&_nc_oc=AdrQ7Qpe0uR4rqvWVHVfRggdrIKrPrEsYghkoXm4QKO--0zdgnQJXkENuH9ju8dbZNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pvJqUC_BD6JYCWGQ_caa_RkyeIRjh1YbVeA_DQEIpkQ&oe=69FF1DD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXMCpIGeV30Q7kNvwHXPmSR&_nc_oc=AdoroX3IBsT34P30E-6SFhG-cj7sfjtwVantmAgKXs0lPYpfvEGATeH3m-BUbPajNvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NTFBfWiBaLRrA62LWNYvyMYQ_PwLpY7Rb60hcaSE_BQ&oe=69FF32D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHYf3Xv13FUQ7kNvwFX6gdK&_nc_oc=Adr89YdXlgiKulOPAwoWUetkBUe_N7wryf0QYErrqTaxvCd8t0NNDzvcTrkhuwhIH34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zRuNk505L1w9czvGraA7v5D7-KDPmEsIvTF-RLmAJbw&oe=69FF3CF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kh1-K7Ab_G0Q7kNvwGUxV2J&_nc_oc=AdoZ9eR6MiilZayajNY0ShhMR3TWHZ9btU9OFyjFFQmOHnrh_FGshjgJIfvoJj-V9No&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h-i51jyvOwbMEzxOZLxVBfLTbL51s8kQSX2HAF2P1Eg&oe=69FF3D84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1dB9vIwCB0Q7kNvwHtR2o8&_nc_oc=AdrQ4g5WqPdV-NeLqbKtquZAFHlYiD0U9MHBSHfgvaq2H6swQvFb1MWxpsJ49SX8qtE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PX-4gXqI6A6p4yiItH7foRmVEn_TpndaZUODvwobdEg&oe=69FF4C76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
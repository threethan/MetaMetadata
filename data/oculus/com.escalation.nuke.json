=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXhGZTOuIwAQ7kNvwE2Y0FV&_nc_oc=Adp62hrkFZ0ntfuNx_shqYh-4VjAINsmGJAcI4qWNW-_-9ialmC9LWOWedI_UgjrSY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS8rvff09fk0L8qBph9LBGdB8-kwCv6-ToarjBLNvApw&oe=6A7B0AD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIhmctH9hZYQ7kNvwEmS4zV&_nc_oc=Adpun6YZzw2lCPpBltMbP3tbJZPolWWmB6PVThjMfSAxHU-WzugVoKDl_wpPNbLCrFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8uNYgYO2LiZ3CZV-q8iykUnubea3ULer_tmgGbsi68A&oe=6A7B1FD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZAsTV9wCogQ7kNvwECksbs&_nc_oc=AdoOxOoPL7E9MJgK9wm1AsJPYZfGRdBZsiUO2wEJfeuaO4G7-BfSZat7c1fm8zchUxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq-TuSgbp_an7me_UHywyuleb_PtI0sv4MXTB_b8MD5Q&oe=6A7B29F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L4MVUGKpTMQ7kNvwHmlR4t&_nc_oc=AdrgGNbH9C4I1jLaWKBvZcUTt--SUUDMzpHoZLKKQJ3jLHwecqAsg06af4Ff8liXvio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbWNBBUrkUo_BitPKImvT2_ozpo4twimcqeeggMRKbEg&oe=6A7B2A84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNAspz_EfMIQ7kNvwG0HoXj&_nc_oc=AdqoIDP7Nixuog123uCHuTB32Eyg51ysDHlS04vc_dunIpdynI0K6wI4LCnD4AhQxIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgYe7BPi3YtIN6gda3HWjZc5YZA3MuD-TtFXHHjNBqDA&oe=6A7B3976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejBEA5-EI7oQ7kNvwH6lPlc&_nc_oc=AdooQ3iyTMbRJ8uIi6bH9SWUHyhIOPBPQqmnzd5OW0fKKTU5PNdOyNsGZQUSlQVtlYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADIP1kAuW8w7j-nYuUbblPBhfxdRahzGU_LQvDRvsCKQ&oe=6A537DD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XNWC8iCVNEQ7kNvwFawz46&_nc_oc=Adp-SyjKBdizIq04_nu6TpcIKq2EHPnQzw-whyMJqO41omWQBsX9YNK4M8vI1smjiqE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcHDUoW4-fFIBjauLFFVRaHLIpXVR8O1I9AAJVhcAkVw&oe=6A5392D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja1YRmDzhAgQ7kNvwEXfchm&_nc_oc=AdrTMZ5r2YIKRqOG6LvNPl5zXfzEnVlCppTF1DHZ2_3ewG1-nwMT_eI9A6CuGqzyrpI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuXAL06y_9uvi2SvDRJrtS9fowct5RNMaq3OcLGSdudA&oe=6A539CF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCIadfdWWrAQ7kNvwHxiYj2&_nc_oc=AdrL7qrS6x47duqu78J4-WngGg0ffK6qBz2eseG6IeZwYI7iOG50sRDdWbX1NxxMZ_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG2w4DiMxELdnEi1IaDQ1YNzCbukbdbB2H4q6X6_WvFw&oe=6A539D84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LPytX6B7FkQ7kNvwHN3Hfi&_nc_oc=AdpVRn0Mc5ZuGtUlB_-RLcsZDurROO8kgmMnBd5X0hNWSx5j-ru6_RPDvFRxw7FLLfY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmi2uROxhwobDzOsx5qSlzvbb_42x5MxdDrLuPQJX9Tw&oe=6A53AC76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
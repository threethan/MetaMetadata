=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5058G6SMrMQ7kNvwFvZfNy&_nc_oc=AdqsUOLPrFpbLC3AmIns8cx05VmnTR8YTYtie50f0zx7dz0ChSIeS4GKaPEbXgmgGnE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rnYFIpXyN9LiLMn_948H9sIZkLwslDuDd4_uq5ulOkA&oe=6A19B412"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A9Q42NEM3QQ7kNvwHP4ep_&_nc_oc=Adq9x3cv13yXtbzeqp-3S7hZD-ET5WfgTaY9l3agxabAq6lvw0539i8E9Wwma-N0hn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GGj_TUeCaIVw5kDVghDx_Oauj_DGBROCzDQYDd1ejFg&oe=6A1990D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAdfdPm3IfAQ7kNvwEKxqWq&_nc_oc=AdoukAXf48puhUr4A5eZbRGHVgzW5pt5rhT4rC42EJpWkdQgomSQMf_mgFyOGpOZuuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RgyADhcQUK70FCp-zltxfMBQa072fFbDnU5aWnZjgWA&oe=6A199AF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAcrwYijCdoQ7kNvwGECraY&_nc_oc=AdoE35_0doMIt1Q19Lk6XeT4w4n5yrBIZofgvFMWLMinlEro2987y3KoVVNwlel-W00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73xKywdnLYNc1HJvtvoDtOGzZYOs7mTw9MWgA5ufDNjA&oe=6A199B84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmvIcdD4sYEQ7kNvwG0xMra&_nc_oc=AdqN1uPSNwFRQxvIputjgghJmlbRfk9Huwo83Jpm5w8A2JCSWdlQ0nZLIwG1QLs6v68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69pdNw4NAG8gMCV9SXREsWuNYT76WGzPUlQgwscIhvSQ&oe=6A19AA76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
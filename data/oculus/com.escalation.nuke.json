=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgV0n49H2VUQ7kNvwH4ftcP&_nc_oc=AdrAgpi_djCDYZ4dttTpR1zcySMAHWx8GiLScwwdfYhAFs_royMGrZAKxewWcklZFMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oVBTdtC2My3rq4UU3TPJF4ApwYtbgE4g4Xf8KxN-2zQ&oe=69E36E52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ3QDDyejuwQ7kNvwGe9d36&_nc_oc=AdqmAhU7WKuKXlx1jcA5g0Ti-6IYnXMIO1xJvqDQTbDm-Vyt-weCTl7NHEaEjkyxA-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OrtDZibTq4Qol3UURJ0Zs4FPiIfkSgDMiOfkYm5ZoDg&oe=69E38358"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfIqN8G0Q7sQ7kNvwGnARJ-&_nc_oc=Adp-Vq4L6XI75sremLx_jXGnhIJ3JVzKHMSc1fXC8TN5WUA2ukVkY7GiDFBGwvFllAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3STQs5f0lsL3xxk_D0lr-g832JhfJ74Z1HVpHuDBd-kg&oe=69E38D76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6T6ZeP857IQ7kNvwFa6xg2&_nc_oc=Adoy9ZB_1LifuyCPk5Of6mEpm6W-YQVIFs4UmEomDIdV8oOgs1CIkNJfOF_GQQx3BF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uSm-Hz3Bh38JZ7njHDFdbDU61ZtAjmUBTQeVIinE1gQ&oe=69E38E04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoSeNlvPCI0Q7kNvwFmUPZb&_nc_oc=Adom6lcnVG9Xjple50e0sJiK0fPW-PzQdm1KdC0yQt63jwKv9xaXzlw8fazhNi9xaLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BJvSN81_C7NXIdFVenf51FOa9rmsEQVCeSAQYt6SI_g&oe=69E39CF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
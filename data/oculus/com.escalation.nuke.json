=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI3I_-9Vc4wQ7kNvwFG8Vir&_nc_oc=AdquQwLqibM58Q5LpPMhhMOX2vZxcE-HZ2pM2mxSS6jeuGzTeF_xzD6bxsG8vPmEFGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZwgKRZP3q2UNKmZgAJzwXLCMEUv4v1qJD88acTuDSqw&oe=69E0CB52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ3QDDyejuwQ7kNvwHO_7AH&_nc_oc=AdqnZbyCV02Qoas4m-YBgboBKkgc9Yj6T--7rXSnHP3hq4MoWWS8jx7S5ZrvczdOLik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CRINll_qeQcW9jkqX6yUpQ64uYFFw9IBfk-q51qsMkQ&oe=69E0E058"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5u5bwam9r0Q7kNvwHxOYxP&_nc_oc=Adq8jm7V8Y_jbnHIi3OzYZteuKjUGUJD2EwM3gJuY61FKDQB7WEXEGau9y37WYHXzSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1payrc1G9V0UJhGV52XGERDvGtsTMoBnI27-Z026rFXA&oe=69E0EA76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeYu51luoEwQ7kNvwG9afbY&_nc_oc=AdrUs7ZLwSTImu9EifKD0e1_hyOLGxJghOqdgyHp2rCsqxWPplyp9FNg_FkLPjqUw80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vfwhkQGdX9qrND3JU-6mTwoUPNzfpuyOC5aELvWA8RQ&oe=69E0EB04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoSeNlvPCI0Q7kNvwFUDD_K&_nc_oc=AdoRHGA70LlvXf_pi50SZIdyD4n5__smatjf4fLOZcwudEbZ4fL1Yi04B5PJzv4TKgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gZ5w0nfS3OWul29qUimUoKqKOy7U5Rdi7etoGlIP8dA&oe=69E0F9F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
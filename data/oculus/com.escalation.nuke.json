=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqgg_20AEP4Q7kNvwFq7S6d&_nc_oc=AdqUSYbd_uoP8guWa0shPKbwUavcKykGVKFIRhedQsgFBn04b-WxhFN59w7qyI0NiF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzdFR7lW9Gh9yNcFbIeOCUdl2KXtR0M4FYCSTPbwyqwA&oe=6AE21812"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXVe0JJ38ewQ7kNvwGcyXx7&_nc_oc=AdraqDxjqH2RHx7ErwFHGDW3d7CvlRS1V8Yau9LpEUzvYJlKkcp8E3anB0u9IFgMkqc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-gc8YM4qHohmWXMKgiQfw9aFG1QO8NzldvuUUs13JSQ&oe=6AE1F4D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEb3KD2TYCIQ7kNvwGrtjtY&_nc_oc=AdoqEp2L9YopyNvySKECtR5IHtUn4SXdCKxoyyEECgXrI1cuNV1q_Gy06X7EWUsczn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4LThd_TAxfq4iE3ap3LKLbTIwSNpJPgg9oOaNkIizMA&oe=6AE1FEF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq8HHe_iNC0Q7kNvwHvuZoW&_nc_oc=Adou5kU2zjq7k-ZAwJXcQpaarELdL1PjOWhPatjsL8xZDqNXle-Js5XD6HeQU9rT7HM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGdjyxYRdqbTPNXO4qede7gnFUNtq7nlU-fNsLFKDdhA&oe=6AE1FF84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt5tLpKvufYQ7kNvwH_Vaka&_nc_oc=Ado6L_IiLd9xP1TuP2jX1AbpwSn0tGpOXC-reymLpihWDV1xMy8BBPUcM3J7Byk0QXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNimqKLdpr1aWhrX3E1vMa_PlAp8wRzhru1auLaWhd4GA&oe=6AE20E76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
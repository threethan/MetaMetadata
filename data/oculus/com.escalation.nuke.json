=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI3I_-9Vc4wQ7kNvwF-1-yJ&_nc_oc=Adr8b5_iUW6VfShu6uTLTQmVa-W5Ebmv_nlZRrAsSiSYBLuvV6hnS1ulj6-NXbmjuSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pTSttmZjB5q8gwJ4iZoTJodl5VWGsC0zoPdrtwLxy1g&oe=69DF79D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTfo063y9nMQ7kNvwFBjMGG&_nc_oc=Adp4v-KN28szmv572mDTQ7UJvGaA7TAVD_tPm2H5zl7SXB8c23XLvCKaHVJa-jRyO-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z8tRLCXvR2QlO9B4V1myUynG0VNjpu7cOLpvGSjnPCw&oe=69DF8ED8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5u5bwam9r0Q7kNvwHDFIkD&_nc_oc=AdqBN9Ww2BcvY2QxdeFujZQBuctsqUtMLk13yUlKnT06toixhG5Q_7_HbYJWZ0eoOBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24h8uDDRjlkLRyu3MYTgmnz32WBwITosb0aYHumpOVqw&oe=69DF98F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeYu51luoEwQ7kNvwHyJAzh&_nc_oc=AdqMGWklKY_rcbs6_O-XJ4f76PBM_-3MPbnVPzLEkFcja9uCgFX-CVJfgctni2kgqFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af238fwctNXBntGKJryfmLRczybtovR6z3GPa3jaIEOxCQ&oe=69DF9984"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJKpFLWKZsMQ7kNvwFD-2on&_nc_oc=AdqMSUcWzrem6PDz7bANf0Ht1Rt8ZYWT2sl7jJUmvrb4abOzqOQtDbsfsa59Zvet1Co&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MFwu2-6lzFHm3xUxzUr3t0HzTyqgGh3deNUAzAhUJjw&oe=69DF7036"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
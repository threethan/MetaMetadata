=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAKbtzUeAkkQ7kNvwElZ67t&_nc_oc=AdoPZKRiibS8VgSJwwt8Ztud16j8nZ1rSRTdjeXlYqDhmQyIJmt06fIE5WfM3_4SMIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WBpPnlf1g3IPXsmDCn7yrDcE2a_5ptln_NSTtgVenwQ&oe=6A356392"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJl2RetKvugQ7kNvwGKSr4c&_nc_oc=AdqVfu83Z66mMF8LL_p3YrsZuQ3G0Pc44fzThWDJxCD1O3oD4lFHbp8FcRSmkLrlvXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C2bZ_VhTAC1XSHw23n4UHXUH0EjQgz_AxaqGIpVdbQg&oe=6A354058"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0kfvmhuXgUQ7kNvwH7AeXV&_nc_oc=Ado3ylqcfyrMLW6g-2CX7MqpNxH8adtcQNIka2d9nT5Bfi44AEs4XNFrFnGWIw-NdNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LCgYr-jRiY9JzlceOwaVm2ib7RBENxR50qn1Dq1q_FQ&oe=6A354A76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG3rnev2Ec4Q7kNvwEP6TW6&_nc_oc=AdqpT6V1wvHw-iQWuZ6g27uyLIq1K05s7KAk86t0zI0A0bCu4xR9wwe2p4cXKD2sGgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ra02f-ISBbyfmAyZKCUDx7ISRT8rqFLX2_trBlBqNkQ&oe=6A354B04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikswvs6J1FkQ7kNvwG3Y3Ag&_nc_oc=AdokCmMyum0XR-3UoY57VDJDeO2oz68HQZn42_3W6K6ZxtU3a1-CHtJtaaBEy9YcM4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86gjViVgeSHEAeYO3JFt9apQUUnKJ4r8aBaiPkF6m8Tw&oe=6A3559F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
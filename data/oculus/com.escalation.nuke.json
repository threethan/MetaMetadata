=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_tQ1OIYDlkQ7kNvwEWlnY4&_nc_oc=Ado7z2bkYJJVriXYNZ_nvoWJwpW_eit5cy_wfriS2HXLuz5yA2V5Wlb6Y7YpUkUlCBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X-vXZQW7sSw7ghR7FeXc0imuoQP_QCz7w7gADGtSn4A&oe=6A3FEF92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RHA-Cq1U9YQ7kNvwEwMlJm&_nc_oc=AdrOCCTLMrjVW_IY0m-1TFjf4nS3qcLOkVIfQMB3nvwSELusjF_IgicuWPMItz-ns0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3OFrlQ5nPj5iJ0pnl-laXV6-dL1D_gxNd-_iMH-Qr1A&oe=6A3FCC58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ng4eH7EOO0Q7kNvwEfIvDL&_nc_oc=AdppAHev3v8dSl2JUnxZfopfMw8JaHJQ33hAZpq9EyfnBpeab3tL-UD8CtWCei2mr3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ug9eNQGhlilZ2EiT9gcyhxl474k26INeln4bN_m80Dw&oe=6A3FD676"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WExqJol1CXkQ7kNvwHZxw6N&_nc_oc=AdqGpyCk6Gy95l0U1xMsQlbuuY-4cJz259OGPkoigyiQsQOMz56hfnEs34gO-OcnOyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P-7-YIh2x2VMQAOfh1Vr0xvBrtwFiWbA74KpIHBh0Yw&oe=6A3FD704"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU9d_8KDcrMQ7kNvwHRWxjf&_nc_oc=AdoO89DQnLfARcByg2-ER6QMiifmjw6_gB_HZ72zhm2jQV7ecWq9yUl_C1P87JZc_bI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84fCeig931VKVs8EfrD7ivmmdxpNvfsVP184RiP6q_1w&oe=6A3FE5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
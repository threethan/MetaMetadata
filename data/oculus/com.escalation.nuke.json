=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SndIqRG0YCwQ7kNvwHEfI9C&_nc_oc=Adof3HseJvTEreNlkkjLCI54J-EUwV7yljHbmcAY1ZdvC8g1VfWWxKGYtpqbjkhJXX8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nL2648F2FYTRUfnzAKAvKl3KgFzvnluYP6grx-wI1Ig&oe=6A0C8512"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9Nc5sqaDhoQ7kNvwGgS3XR&_nc_oc=AdrBeMRbZClh_UIo3-jbqj5FluxWXHlENOaOjptR7DLileqYohFrbrTeQssubs9AxeQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nyr_a1AvvSW9uKMkHsrHFUXqp_cvNPnmYLL_Rt-0M6g&oe=6A0C61D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvS-ewpK1dMQ7kNvwF7Zv9i&_nc_oc=Adraq86mKxKtExPV5TuU3zrPmSxAmG5EWNWazQipd4F_KCkaITi4DA7DEhd1CeEFzMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iNRS38g4hQmlfNhFDIvgcHeD9kI0dfH-zjAkN3K20_Q&oe=6A0C6BF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDgseTH8VJgQ7kNvwFHOLGv&_nc_oc=AdoL6-mWdw-2E9IMpMYYQmW5KsX7MGMNTKj6ZzyLfsSzxFTTn673Vi7WR1zkwU-QJ2U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af650l_72THhaNfFAovNx3firx2_yxe4nNQ9Q_qfQnnvMg&oe=6A0C6C84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D34D3S_cSTAQ7kNvwF3akm9&_nc_oc=AdrFrsMBxOvCVo1quig2U00cn_b-t_W0dCEyWWeICKzPE5f-bE49BXO1q7VLzhj_1ak&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A5EPB5rUmnoixdec3upfQ02DfNmB_90NjdgbGn_NR4A&oe=6A0C7B76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
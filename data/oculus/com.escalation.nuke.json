=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5JAu3Ebg7QQ7kNvwHromJF&_nc_oc=AdpLpIJLxhbC2CvbnxLrSaPdx8LCI2FLdpN6_WwAZ46W_dVQ1kXvlYisJptt4kLvUx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAJtZFOoPKqWHnlh-PcU25peSE-6ZQPKExY1cSN02tsw&oe=6AD24612"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IthxErQkspIQ7kNvwERLXK4&_nc_oc=AdpTNvl4ap9lM-mqtYmSO2FpNp6UR9tIwBSuU-snsyo9X6U1p5upai9RQsozARFnUdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP47o_K0myPj-oM7gthXnMxxBzI7uJDtTeIOupKJcnyeA&oe=6AD25B18"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhB-qxZ9rogQ7kNvwGdvTAl&_nc_oc=AdqctKmXCQJ2GhZFJyN553IKEzaS9Vh1B2BKRdPcGvO6ffyJ0Oue289OH9Xg8IqB-7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtqcyglsqf2csP8Gf-NB2oxrMGDYh78cfgt-L_ySGt_A&oe=6AD22CF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6XOQwe_0rgQ7kNvwH031nQ&_nc_oc=AdrhifJ3A3-x69Rr9WTNiZ17Z2RYvNMcDdAePNYc13N3d3RI7KTZSNwTsH97hGD5doI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaiUsPBX_egVKhympOsaIKlFRqnu8_nTLzFlYvMPW0_A&oe=6AD22D84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiiT1qcy9QYQ7kNvwHX9v71&_nc_oc=AdrFnud32vQQ5AnCb2sE0fKQh58MdSi6y9KDGMJc9Hj0UDbloOWvUyTBgeI36k2kPJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwQLlp04QMHzFE2CV85dECTQHhb6gTO6ND4kOXA4FuQQ&oe=6AD23C76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWEm0lqwysMQ7kNvwGQCae-&_nc_oc=Adpprqg0Xp6IqNURByAUGwsrFhgrZDiJPUX_YpeVpOCOc6Pj1PtEoElfinOeFCrRb9M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03uy92gAcD_qktto2bzwLoNjghNUpNAuDujFnedZ5VrA&oe=69DCD6D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTfo063y9nMQ7kNvwGGTZmX&_nc_oc=AdrFb-Lz5YSaN5SEISiZn7e5iKFg88Cjkn0Sr1lx1OZPKngaz67C-mpJ0zMR49cmA8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GauWLQc0r34aaX-PeLRafArOsvqtLUEQGxx9JrOriYw&oe=69DCEBD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BBlBcth7msQ7kNvwFeJgL9&_nc_oc=AdoW_zx9taHa1ZV4UsPJPMEFi1_aLsohjQ4OV0hsttglbwVi4DmO3A2EH9zD3AL-QYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w_XAtucJipolExicrplXcOSWxa0o5BjNKEKShAUVkWA&oe=69DCF5F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufv5HzPlWEkQ7kNvwFfOyub&_nc_oc=AdqkD_R4592Ga-dl2sNDkovoqzhhQJyvzNTsiB2rQmSNY3cYFS6UAPM7zSPRgkHZFoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hTH9j3qvMTHEhcijkCFKWLF6k8U6tz5ZRA4Aid6iYxg&oe=69DCF684"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJKpFLWKZsMQ7kNvwFJTgat&_nc_oc=AdqKxhUPy6iEWTZgO2jFo-9MbuTKSvADczdLPbh2gCtA0wYBlEBEugrA2hdZH23flgQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19JbMPAxAuJuR5IZjMajp-up3gOnT9XBoUNi_CLeKVfg&oe=69DCCD36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
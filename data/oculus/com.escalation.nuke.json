=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9og6mk1wU_gQ7kNvwEknLqp&_nc_oc=Adq0w4-kQEUDhpLDKnvorvQtfq3XP6OOLg_jU4KdJcgg792M-e6LKb2PzCpRuGTuSnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EzjWhk_DbGNFifdpqbDTd9ZR_lTM8nadetdRiCPJIbA&oe=6A3BFB12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr_kIhohNNsQ7kNvwEpf3PV&_nc_oc=AdoywkvWaPrlRRlgpqXV7iUSqB-M3i91YDzo8D1E__s_hYBW5iSr7S34FrV34E851gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AnE6xsZcAgYUKaZvHauGVPxXcq3PjwBtF7xYUMOFiKg&oe=6A3BD7D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhYtVjbbhg0Q7kNvwEPO74L&_nc_oc=Ado4AqyF6Zojao2Og3IZzjTNpt-jq4Yhzhu7QCb7WAQgsCeLfDR4eMLzKCPgu1j7EwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aaQH57_9w6c9Fon9ydsvK0KQJU61K3ExO6ZyDx2StBA&oe=6A3BE1F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ImwLijxcPoQ7kNvwEq0kBl&_nc_oc=Adr-6UcHKaBXpG6t8c6Dg3O4Zb1O9rlMdQ2eiE1SKR6hovVKWZjOL96nkzj8OGGowP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O4n_E8Bc16K8809D1ViYojp_F7rdqRGfUyhYjgoRDLA&oe=6A3BE284"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66jO8Bw6O3UQ7kNvwFMci5h&_nc_oc=AdpNgbFlnefllethf2nYE6KnYBx_6PzZzQfkNHhjdorc-mH4GEOhGvgfAaX_fZ9fa5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JMGdh7XV8VwsuNycjgwlpRg25Sho9lD11lRd-cLtKsg&oe=6A3BF176"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
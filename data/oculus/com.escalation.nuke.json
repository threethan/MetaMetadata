=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69lOdl4eR3kQ7kNvwE0bMfl&_nc_oc=AdoVHfiaCA-wSqm7add8j1mABzaPjjhFZ4MbfzcERwqZCXjXqreBktuDL68vibPivQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV1jW_W6TWZMZMorZns9Jtj6DqG9ThthjiugpkMrnkCQ&oe=6AEDF592"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBKsSEhjbm4Q7kNvwE2fj1F&_nc_oc=AdqbkgtnoE1sSX6ZC55N0AfATm5jIqs6ED0UrsFvctAShMGcxu34bqew9e03RMRVLJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZYBNsMrH3XVytrH5_XYMUA17NTtcpbAoGy-e_QBD5kA&oe=6AEE0A98"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p_l2TKs9G0Q7kNvwGGX2sw&_nc_oc=AdokXdtooOj1o215foMNSghmvW6AXgSNL0-rePYitLmYmdpT2WwWniZ_DZHXng-xYmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1FK2ekphwu7R6crBp1qKW1CMv-ioFwAYyLecq_vhWw&oe=6AEDDC76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI-1LdEti-8Q7kNvwFB9wiS&_nc_oc=Adq46jfy8313G1U1WLfoEEOGqFTuHrRU_crVJVQmPYQMBryMtIVelE8KytPp0UHIpbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7ejw4faYQ5cXhhLVN5lSuqRPLNSWi3y--7i3eBXkgfQ&oe=6AEDDD04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8eBfoaAvjQQ7kNvwFOV5U7&_nc_oc=AdrlVnjRw9mZekOTKQHUY6AL4RpQfJQ54dVuN240QBVZznRHO-5oZqWAlAboN-Rjx4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_0_zwa-yJYtTWLY8tMBOQWYiUoqRG27S4U-C3RcZu3w&oe=6AEDEBF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
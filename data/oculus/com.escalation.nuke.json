=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DZtMV9Q3o8Q7kNvwH5yg5h&_nc_oc=Adovqb-80zKlRkb4uCZxIuI8b2bcBPC1Btc8tyaMGcur8oeyOnlioOcFv57cJhApIHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zHEJ_iRu2hC-Aaq3U0bpZ8zMXK7BjGrywnTNRNRGTOw&oe=69EB5752"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsIiq5uGLzwQ7kNvwHKnUt6&_nc_oc=AdoU62dzwirmqhPI5YlZYBWoxKxsMWhUVHhMkmtQ5M2b9XeWKhqjdWaKoJra7TuRWWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qFy4KaE3LNU-9N7I3ayL7mdzdByyuKhdRVa033o0Z7Q&oe=69EB6C58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM8fLUtlVDMQ7kNvwELUiY8&_nc_oc=AdqUGsSShQwcZQVMmyznh3gTk3xw4cxDxQO0ufMx_GU46YvXYd3Ej6IOv1Z7c88VSxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mH-WvbhBJjim-p8dWG88o0JS0hMdmm0z-OcBRfBSDXQ&oe=69EB7676"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T34cEstMxvQQ7kNvwF0tryY&_nc_oc=Adocf-Hy0xfaBzKi9yZ_ZlhmXpPFk4HPoBcnzOEeZIcnYpbLMgzuyZv7bJ5Ckigv9nY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y-bHJ_JvSsIcxf7dDGyujlxtoh6nA4fIV_kiUxiugwg&oe=69EB7704"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsNDsKoGXeQQ7kNvwEDdm1t&_nc_oc=AdrNbiPT6OYqe1OZKa68E57iQGzmGeFjGvw8Q5T4xTabUtUCL9CaNxo5t736wl5ZnkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0suT2qIxkEdaS5zCUW8gsONQ2T5gsHdDAJyyk8XG5Wtw&oe=69EB85F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
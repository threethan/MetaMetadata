=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvy5F1xyIFYQ7kNvwFG8-4r&_nc_oc=Adp88mg5MoNcjRZWHn1F9AxiIIXqzUUH1A7eJ4nnK1EglXqkT4Ms_uKZXG1koVb42hM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuMuFX58H5Ov1qK6cu555XnHgIeEE3191_dfme8ogvCw&oe=6A60ACD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pUeqh-IDisQ7kNvwHi_K6F&_nc_oc=Adr615DY2yGwESOItknx5O8xnExoc0gpMnDULbR9z1yYzi678RojyCAZHUr5u4cZ_4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDztv3BXNgfKdnwZDrZ2jmiVrQFplXKF51S7XnnuX1lg&oe=6A60C1D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQE_PxWk55sQ7kNvwEcN1Za&_nc_oc=AdqR5PUuQbd-9jHOgD0yoV41YmKiWwuskPiSMSIOWaEQAvbnARkCGWMacWY7MvZMhII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVuW3tAR38xMM87x4qPUm-wDBe69SDxcyUqZqiQRtqig&oe=6A60CBF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saKyICZDZOwQ7kNvwHyhywp&_nc_oc=Adr6D4NZUgM-HtUvXnm7qIIBxSsrzVRewaf9yjYrS0WNdPz0OT09xgJmvIggKWy0BR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUBi9VZCGTccEB6HlNwGhcZQ3V9-otJj_0dFo_HmI59w&oe=6A60CC84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWCAeQDKs20Q7kNvwHY-DKB&_nc_oc=AdqL0CeHqGjvWeidAGr71WRq3v4P137pW3d74LwxZn_Vj18D5pRL8JqCM2JGlYZm4uU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk2UMWIYn031KEjmIkZWnOnQ88tOB1Hg8IFS8AQ_SXeQ&oe=6A60A336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tePbnvg3Ib4Q7kNvwGXvqra&_nc_oc=AdpbScnMe81puMCFDTFIMoU6qGrkDpMPBUquyIzZc98Fr_BP-YgQm4QwZidnoQiPZhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXfLsJk3f4FcROazZlR37sSfLcogq7EzX0sPTlmTSKAA&oe=6A6895D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2o1Rt19HhQQ7kNvwGmfALw&_nc_oc=AdoK1h1RL0XTyYjXYbbDtKx9omSQc5gZ300KRLfTG0k95kj6yt2ZVCgtSvm6WveLYxw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqZu9LRMy5I-8PaQmsTymtt_juZeIiuTDJHVbDPDvwtQ&oe=6A68AAD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ia3z_8gIx8Q7kNvwEzMWoj&_nc_oc=AdpuATxGllScHQKv_eQY7zjvIME3zkEUP6JY40pWRuglnPdRKkgxfVXKbdt27VmviyQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8qtPKufj9XIRl9hE3UcZ6IB-KfHV-rwGLNh44CeWe3w&oe=6A68B4F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT7OZvbNc-8Q7kNvwFYpDOt&_nc_oc=AdqHTa8YFgRNAtSMMaxukCIZDGyhJPm24woymI9blL8gStPrL0P9qb3fHc3TlcxPfu4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4NnFnxPnpkVy1mVtLnqO_7d1lWnmk9ESyQoRfO-ib0A&oe=6A68B584"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYu_Y15GWCoQ7kNvwFh2wxh&_nc_oc=Adq80oB51d0W7hKY5e1RLZCFQ5FAFTO026CPXTJuRAJcVYopa92B4jgyi7mTks_oQN8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUCtFCw_afrXA_aGqul2HUiiUE2XhLuHNND_JA4qOEmg&oe=6A68C476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
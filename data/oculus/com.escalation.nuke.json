=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75F9wUmZo3sQ7kNvwFEHou3&_nc_oc=Adph1gV2uEtky1z5h3sUyqzRx2X4ETy5yohJTjZuUcTxoyIygAatFDPATT8YnOT2FjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkJpi7d60kD7j81DhfzrNCY2FpIR4Lt2GnuTtDAcVBdQ&oe=6A4D1E92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTQEAWnfWs4Q7kNvwFH69qs&_nc_oc=Adr-eV5O-uiTmxuTMfXhhSs9xHpNpi-WgHHvzkWojcd0dVbAwNx5jJ16ApXQ5PKzjTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIGzxDfkn5c6q-LWw1FJvwrQDrNtLRGawJO-DOqEhojQ&oe=6A4CFB58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R1BblsNshIQ7kNvwE0LX9h&_nc_oc=Adqh0Sf-CnkqwlQmiWegeOtTwmM7mikT7i7eevh6bddRIWBT_oAkJOgXW7gxpqdJki4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC86Zdg3DEnkkL4SiIxg4yC5W0gbR9hk9waTDIKLcoGWw&oe=6A4D0576"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-yVWkQsBEkQ7kNvwFYgMfs&_nc_oc=AdqiEQw70EX4a9od9uaOX5Ewi4xGxXsBWGCmLm9rEKKAK6Kc5f7oyALdO4FreSDWaTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvmWtrw84wQSBR-epaWb6_XGDkrh_ttCU5u3CFyOm0dQ&oe=6A4D0604"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9Wuswd7z7QQ7kNvwG0-tvn&_nc_oc=AdpMliO0wauqg6yVO5WcSL7e6yUVS9prkuE3ly7XFrgV81SHoNFYKAx98vZTBi9dPQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOKiJMm18iDmp9IQDs8OVdupFUgFGOJLdk1iChca25qQ&oe=6A4D14F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
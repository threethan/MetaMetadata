=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-xu_OAS6aEQ7kNvwFJUnYz&_nc_oc=AdosI_n_EyEAyAN_ErEh52xew6mElL7ged8wVF7blGQZrvCSKSTrkals-VJqQeEp0ik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iFWcn234h0Vvmn_okNDZxOtMxizCL3iTeDcrRIBbMqQ&oe=6A2C2912"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VktzdNLR5PYQ7kNvwHOhUFx&_nc_oc=AdrActbV189yfm_JDYKsopdjQjo4keARy7bpKIZ5o6IhpXY7iWfZeAGnY2P6Li8k9Yc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SSUmBVj6XwvIYZ-KPzsemMVF38MPgBz8WOHNk824q0g&oe=6A2C05D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0hA-Mp-UQgQ7kNvwGGBwsp&_nc_oc=AdqeRdROLi66Lzh0ThI_mhWMxF1-p7xPoRKyGZUmnWU2GaowMOrNsR00TVZ8CXryFJ4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tNt2cQCbVKs0gxUpb4eCPkOp7y6aQhO6zvaGxCZjyAw&oe=6A2C0FF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1WzS1amVfQQ7kNvwH-yXKU&_nc_oc=Ado3O9R1qXvjh5OBJlJ988sezZW-yPhEcJz-k303FrHVnbkX2FDTq-hyu0i64Zd1_uQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5MeRjimaZ7hT1KmmpYA4jYXXtmVdtl-uUcH5eBwLTRA&oe=6A2C1084"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiqZlyfY7b4Q7kNvwFfu93V&_nc_oc=AdqdBiaTxlEWOlLtDO0YFUFg6CVUctxOws08UyKIG6foxEw7u2O95pgR2VRmL1kur-U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1S4ljhdKVeE1xzOXisjOnoYBMLT8H7JLsIOB92rkeXg&oe=6A2C1F76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
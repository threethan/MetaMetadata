=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwdNUSHyhUgQ7kNvwEgOIij&_nc_oc=AdpEqeipa-UqYHHXyd2U65aLEwNPL01daP2J1Ijp5o6kly7xaBVbkAeb3bePql2epyM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKq-UBsaom3LL7j1vvQmCKtsGpEi9Yp44lb_VQzBPw6A&oe=6AC90B92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L667ZhBOId8Q7kNvwGvkZhJ&_nc_oc=AdqR08pHHQAvnlnC6WAYVdElg3bXrIIM0_2ZWPLC46qILEVQXcOFTW1ujsIycn0jcH0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzBoLqxkvJ5D9C-l8t9XBER4EgHaLEexPTHZAOFSqYrg&oe=6AC8E858"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjH8jfJAgUgQ7kNvwFJ0yvL&_nc_oc=Adq3ouIw4U4QOcCep0DXXPevKUf_GZ0yBQpNTV0LCm7NeFUAFiN1AaXuvKfmkrqc8QA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO933FpCluEk1GdPAdPhjF6RZ7gQ4Y7GBDHmBXxElkobQ&oe=6AC8F276"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caiTKZDLrL0Q7kNvwFspkVt&_nc_oc=AdqYe95RlSKnx0jTMkgHXWyf1wlT3b343Fm3sN-_a4HSLK-XrJyUblF2PqBbyhcHqnk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCQGxGiFu5Wf8XnLdc0VqOcX6xRk2IkKSBcHrEm9v16A&oe=6AC8F304"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQoyNJB9LskQ7kNvwHdakmO&_nc_oc=AdqUY-7EEzwZO2ULw-iw-LxEj8YvvGZMJkqD75FEoyQBUO3xMHWldPKn5A0SOaaONEc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfLN2vxNhik2CX7GH5bvHtvL0BKLHq-SxtZSeplg6lIw&oe=6AC901F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
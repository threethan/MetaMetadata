=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mIJrTP_kmsQ7kNvwHlSpYh&_nc_oc=AdoEU9OvdO7aF-ZeoBOUtVcdfLST-vtHYdD7Q_xkP-x1xjgR4hyAfMOqYlH_De-sX-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOM0Ik--Wqui6Nh1Pis4aSpHdId9ghnIXcrA11_SECFQ&oe=6AAC0A92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0SyMOPQlpYQ7kNvwFsjdLe&_nc_oc=AdqSn3V3S7d3O7L_2HJsQYnvuKk0oMHUHCBRRP1peCTV3k09Cr-uC6b_7W43-gNOcBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbJZWQe8DmMrQKtT00yZWOoULpS_117IHrnJjqziX7Lw&oe=6AABE758"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ4nrqAlx-cQ7kNvwGYigax&_nc_oc=Adrph48hkFuf5wgWxIhQuaxIOaAZ1y8mrGo2kxdIY5n6MHgwu0uhBUUeeaId97ze6Mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKox3kHpaERHZxS1jRGTq4DBByq5EL1hE73z7oZfxdTiw&oe=6AABF176"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jalQ_SMxuu8Q7kNvwEiewFY&_nc_oc=Adqag1KPeEDqP-M34B5qz8SVQOAnQP0eOqxfq14rPLMo2DxvuSNIqjKIetvUlRQoOZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWKCfe9F-cWmnMFPg1KAWKMVTqziu-MyRn4xgBJgLxvA&oe=6AABF204"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkuQ2FoKzbYQ7kNvwHB4_Po&_nc_oc=Adp3NcIxscy7yq4LNHExOAITC9N9dETdcsDqmE9ULWfWL0UyH7k9vqrTdxou67C2Pbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDqh7rzOxNCkCJW7raT9KiU5ObAy17hmkqjFEtgIzwDw&oe=6AAC00F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
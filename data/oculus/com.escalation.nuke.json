=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA3v785OszAQ7kNvwHzgr9e&_nc_oc=AdqsuZroOqccWLYue437u3Z-otliDRnSQaBxG0Xr99uAdk3F5V-0IKDJaqK-g0qRKEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyihaklDxxtGn_A4k1ajbKaogLaUu4-M25tKcodUVX_zA&oe=69C91052"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X_hToX4ZbMQ7kNvwE_RVFx&_nc_oc=Adq6Pq8rPJg_6OpQMGq_1Bny1eCZAf2m3g9g2Mi1RpLNCX7upFAPTA1cxgMoLaq2O40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Rg-BuywKMRZzpOnS6r6fktwlxeXpTX8GeCLPNSQrYQ&oe=69C92558"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyf7q9aMCBkQ7kNvwEUE_-P&_nc_oc=Adqjd2ytXoUAtUs_x777lFLWuQ3hJFlQY6wOqpSBPQ8rSxjQJAXJxsWTTj7jjAbkie8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBKgnVL8Ru2euA5GeyNgjrDWepVg0UAb6f8EUyacLlGA&oe=69C92F76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQLmqbotyZoQ7kNvwFUDx2Y&_nc_oc=AdoGrNSC4h484KkxdL_pZSotOGwm-5-7F8gCwkZB1hWAZVDGRJjT0bN-iK69j-0AjBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKhZGkAtf9S7hKLAdfgZ9d3HmeqSlOGloa8vDv0s-Zjg&oe=69C93004"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTK6ss81EiwQ7kNvwGlL8S-&_nc_oc=AdpRRz14lTWjaApNEo69r72k9A22Ji9MReeO8C5k04Bht7lIsX9RXTJqABvVJ71EobM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVr2VENbbzrkQAMXypngBljvB8Iw59WEaRGVtGTl9dQQ&oe=69C906B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
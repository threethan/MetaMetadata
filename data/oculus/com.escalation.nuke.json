=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mIJrTP_kmsQ7kNvwG5mAia&_nc_oc=Ado7yDzI7KWiPBSp4QsROxFDHuUfH-XwE8X9B8rB8Spqxmg_i8kmS2x4YItwKWeaMf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI40ang1OfyuoFDhC5hAQdkYlzEdf9mZO0VBpelmSO05A&oe=6AAAB912"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0SyMOPQlpYQ7kNvwHfZrCl&_nc_oc=AdqtXKPQPNIKFzG7qTwjMCNAbWWyT8JB_JP0oEsqbKZ_see2CrsfyRJkKoCxCW5-fJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBAP51QvEZRjY76xAgNUu8qYp0-kyQQqr1ra96Dm4jEA&oe=6AAA95D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf-rB3J8a1UQ7kNvwE8qFzZ&_nc_oc=AdrVKZDAgPJh3Q4MVYhRMcM-_N0qh5r44p9PdgutR6yjBFIVO6YCor5IJcW47Kbewlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBR0I7R_Y57WncwHjjUJRXF2hOmw2BeoXryUbePU4Mlg&oe=6AAA9FF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jalQ_SMxuu8Q7kNvwHOi8On&_nc_oc=AdoYpo8QmFOVDQ9_OnqEWSO2GuFCkafI-GshhCXK7IigWm88rFYgnwQQuKl9VU7mNng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiV8b99_MX99ZzEiVcAp4n0149-2GY7PLFofSSZJFauQ&oe=6AAAA084"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkuQ2FoKzbYQ7kNvwFGlXxP&_nc_oc=AdqhYP_qpgJhUltiwrLS0tbP0UCN6YYOnzRHtJYbhfoh-r4nbn5L8gLBtHeVkr_379s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTWpcOXtY0DATyS91FhLRNSm5bseAxwCleoWu0ivwyKg&oe=6AAAAF76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
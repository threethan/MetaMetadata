=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDn9KUE1S-cQ7kNvwF83Ud5&_nc_oc=AdpMoK8Zkr85HpMln14zT8gilD_fHc-Dok18dRTlLmCj8L1uB7p5K3unT5WVADMyYDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYHz5eC2KR0_jQ-XoXNyc0w3ImFY_gl92UggsuG2JhSg&oe=6AF09892"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBKsSEhjbm4Q7kNvwFGcX_F&_nc_oc=Adrnw30kvdAXW72vYxoEt-j12dIMuPnXu5-V7mICoKtYoSvSr0hdWL0SI946_iV72T0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyLH646NlnZmacQKaJFBeiqjNJSl_XQzDwQk3zoJaUBg&oe=6AF0AD98"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR6tcGWt8qoQ7kNvwGtbu9s&_nc_oc=AdrinRZRBBnDrp3MnsWyr49y69QW5u4v9luDb2Vv82TuTAnRj9CO0ZIUYDZ8bu286QQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSht8QpaTNg6PNXH4ttUSB6LEvybh7i4TYyrx9diOYm2w&oe=6AF07F76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxSch8NFMMYQ7kNvwF77-1r&_nc_oc=AdqCzZKymqBmDb4VgM6lypqORAkADvDmUB21sdI-ClEZQCXKwYau1HpTEmpzU17wWTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9GCY9kFnSYVBpkBkm343LmYHsMiY5Ydn5Z8GVQznBeA&oe=6AF08004"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8eBfoaAvjQQ7kNvwFmDjvy&_nc_oc=Adrrz8ybsIxwU-3E5_gblHFVX4DvSYjlrgIKEeh-GJlqqwyp-0JnLnywtymOfhsa2oc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-eHBBiOHcF7SfYDGGrQw7aCF7sU44SeKYTRYjIHX46Q&oe=6AF08EF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvy5F1xyIFYQ7kNvwGGqKMF&_nc_oc=AdprJrYThNNs_050fPbJsaMbHdaXbf_ip4_mZvnBBqK6Da0ESE-2kX_KEXpxPLohs5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwJOpCi0-I5ppf50sKSJrfTG6Faqi-KvxMTflTCWiq7A&oe=6A5F5B52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pUeqh-IDisQ7kNvwFU8qpa&_nc_oc=AdoSYfPDpOcFpxtJilgUSuZKilDtVGISc_Av7kalO6SuFjMx0zFRnYEpX8wsm1sFSwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-ppnJPtY5l_Nm3374uuo_qcmuUyFPR9f81d2fRwrJeA&oe=6A5F7058"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVamPdFBd8QQ7kNvwFDGElU&_nc_oc=AdpLsv8IkpLAIfx88gZWGJV_jScj1f6jQuMbjVx9bsEcLLCTj91eWWGEk96oQJt37YU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKQBE9L6o6ZSYkh9LR5rtw25JJi4xMZz9Rg7P1msSf0A&oe=6A5F7A76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saKyICZDZOwQ7kNvwFbrKWn&_nc_oc=AdryDrigfovOvyt7Iq2JqFcM4VENRVj6oIOtJXw2wspmWwrlUuO659dZ3Z_uPpt70-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6JNqUeXmsj8_nAUCEajKqfkelMRs0s3ZqOWlQ9OO5yg&oe=6A5F7B04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWCAeQDKs20Q7kNvwGnazww&_nc_oc=AdpJe2-tiZGTGwyvZ2kgBznIVKJXvXm9qsN3nDE14bh_zFd3zix7kRHkWqduE0b9vZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABdw49sGhHMK3Q3oluPUjsGA8EHXGyTBxOjFzua7I6Iw&oe=6A5F89F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
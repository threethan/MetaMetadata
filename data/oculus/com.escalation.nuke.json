=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4WYAFvTsa8Q7kNvwFNgJiZ&_nc_oc=AdqvNejeP7wSw-HaqG_88e0K5E28QOm_pGtmBfn_y4nlyqlAD21yNnuoheR4eBrTehk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKNin6gZmASipyT_YT7QWjM0FgTnjp798K3f7-heGycQ&oe=6A75C4D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDbwRGWIy6IQ7kNvwEeIh-C&_nc_oc=AdoF3vXFtVIDi4Q5CAO4mtqH0sGzjarKnHW3FrpKIcmxJxud-8dkW6wfJAc4A16JY0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhjRs3saSh3kJwJA-lFhkzTOqZv4R9v129zzm8dIYxXA&oe=6A75D9D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z8KHFDijGYQ7kNvwHCl97l&_nc_oc=Adre9jchHIcdHy3sST9JfBrLQ5QSX5gBU42Em-qU-WZJ6EhMsqO3LbrXcokfm_nn6bM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGon3_KySBQvi3ViT-_ywp88lnLGvwR5sT87Sw1d7fkdw&oe=6A75E3F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIQH2wBiwG8Q7kNvwFwlVpX&_nc_oc=AdoOlPdV9M3Cp65Ky0paUL1wUYar2hZO87GkWvRryzbRLySxJmqa_c7AxoVBdhyPUsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1SfOdWf4EYV5DaR6uoawCCBMEEvepBO5pFiUGU0Z9DA&oe=6A75E484"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GMiiXl8tO8Q7kNvwEXMADD&_nc_oc=Adpcjaws0KP-K2W1zmxiLbyOXpqYlUO7XudIataGdh3CZrkX7T6xH-3bDh1zLYwwGm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkbHwvYxUTZoPU3MthdtTpdP4en7QzZRAmNwW9DGpZTg&oe=6A75F376"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
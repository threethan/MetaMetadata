=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFVSAslq9SQQ7kNvwFAEgB_&_nc_oc=AdqCTrYf0wUqS634MITsJ9ckeIJe67W6cEC_ZaxXt95HFDw28JDoekrDsijuOclIfuc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw7d5w4RiTFI530QAdxW9IrTC9PEV4HibFLCswP518Pw&oe=6AF9D312"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKSufJ4r_nAQ7kNvwHj_Y-w&_nc_oc=AdrJo1db1hF8mJsutPA0octg3TTcjfkjWGb0kIf4P9qLhf4XB-A85VNRuJpMc5M4gzM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2iNDaoN-qizN3TWtzbhD7GlYlRRnVDLmQTUnzko0EAg&oe=6AF9E818"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r98-ggyCTKYQ7kNvwFnEI9S&_nc_oc=AdrVcUhU5-HKqAu634foA0rNdkDuuNlXISI4hASqIpk151RKPiby3xraqt1_PnwNS9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqiq_QZMoyX973bez_B7KEHsOvMsFggbPU1zYJsNoRcw&oe=6AF9B9F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pabC78GbE8Q7kNvwELG-zT&_nc_oc=AdomkIQn5wZ6rsp5F9D1TWCQi7JwmI0cMVmZGSHNyM1SvSBEqjYo7bsIK1PoU1Rrhxw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThMhZCbAQyOrovU89Bae3DpmAiRnB-Wr9rg30ZqZ-jLw&oe=6AF9BA84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeS8bPjDS5UQ7kNvwEJwKot&_nc_oc=AdoOaAW382x7As_f-TNigHp4EI3dohZVhsXuQyfTxjmGtRAqXUaItrJMnJcP32j3ONg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH9TJYKfXVaOHTLuBS2zscjsnUo2YWK1dAgTxisc_d4g&oe=6AF9C976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75F9wUmZo3sQ7kNvwHNJhuf&_nc_oc=Adqw81nhBdUMCEnLfwkJT_8uwdD_0XyDVmZsDvItjN1mSkQUWfyJ0ItBjTmv-ndQUdk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ2p53hOYeqgtlHbF0sK91-3XRHajDIDS3Rr_lYh6iig&oe=6A4A7B92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJPjJ_ClSz8Q7kNvwE5f2qJ&_nc_oc=AdqwH8czY2FnSR0xRuHbSKwxfz6qRbXMhsmGFdK3Kuv7vYQJBbvaGnbUEF-5gKGdSQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuVyv3wuOxCVsKTcDF_o2jGk5h66vidtydqpb1ShjQiA&oe=6A4A5858"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8bbNnV-gxEQ7kNvwEggVCq&_nc_oc=AdoC3mjU9OKUzZGdhXBPhNa0-yqO0ve7JDUTkHgWnxvfaxVGgsYfsA8XMVOhLzJYWr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVQZARDMrRkoSHJWDXkdcK87REZlobyS3PolTx4MbSzA&oe=6A4A6276"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-yVWkQsBEkQ7kNvwEkcnlz&_nc_oc=AdpYWDycbrq19DItCCYsxp-AMGxHhrWPMrNeB_riJ2V0nOWiS34YgOS5wGDvAL3dKxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbeJrATTW3SkdXdRizJQL06iuE9EeFNPw1-KKROKRYSg&oe=6A4A6304"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtBu87FDdXEQ7kNvwGu19kP&_nc_oc=AdqqPmaGJQH8kEtntrGbQgQ2uSLdH1Wm8b_T0H0mwLIC0Ov95ePbOYZRtG0_9ktfAaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDghjc6qhL3UIuvEtvEH15mwTepJJO09_XJnaTN7Dy-g&oe=6A4A71F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPsWURiIq6YQ7kNvwE8RkC2&_nc_oc=AdpM5jP8lQySpieNXw6EctgsCM9eOcE0d0HYDykamxZxNqyrVtufIdddDUerhCMKLjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yRkZ2W0N7JfqRjKwpXJccw_GQH1gM8E3w3StnBd1m6Q&oe=6A089092"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPnNkh9sJLMQ7kNvwGLsKbJ&_nc_oc=AdpLZegs2cf4OcHiLFfxA6lCP1RqirGiZH43y5PsUhEaP0T1rbixt0Hg9P8PB8ldMpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nV196hglsoDenc1-MzNeGdsZlcR_0qM9On8Yly-ZOSA&oe=6A086D58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSHPghivCWsQ7kNvwGcMAMQ&_nc_oc=AdrZ0uFHdUI8RenFytzxPVh9E_2ndXxFYTMAX_w5Tby82nRh7_rEQB78CGhkt6DSg2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_V2fcibl7m2MTT_aGiRQJMC7t9OQT8LCKiacw1f-Qyw&oe=6A087776"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=715GYRFdqfwQ7kNvwGoIw9D&_nc_oc=AdqLNcQovwM9niuzOJhC6J2YAoJQ4v9CxtQwIEcL1YH2maQk3wvFMl9n_B8MGRS0aVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZCRxp4dvKVQ6n6U-_vNRJrMQJNMTPNrNyky-ukeWHsg&oe=6A087804"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bez0evvKfX0Q7kNvwG73Rda&_nc_oc=Adrl5URA4TUZxq8Fmss-fDdrtTnFXx98kfRpcawjUSMxy75yYkPeZbGPZytEJ14Q2Cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OQXz0wxokqkvMGXFGNwlI7ZjjdjUg08X-U98pgrgxBQ&oe=6A0886F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpT1XJM2ccEQ7kNvwHwD0bG&_nc_oc=AdrZX7C1o4eUUasOWjecaJb9gz-vCqK15jv009Rk4EtFQfeDdr18mI52ZcW-q6EE4_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWVYrQ6eTDFgKXTWET3PANjz_NrinY3bDH0KGjAiK7CQ&oe=69CD04D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18-6I45L94wQ7kNvwGFiAis&_nc_oc=AdrJhrjUg7iMS-RRsZIM4kneG2On9KoltVwEsTMoFipmY8wFDfZnnH71IatAGpkDHP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw17rkQA9G71ci5x5CyJWJVNxAhvTaAT4dKic2on4fQnQ&oe=69CD19D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUqNYbrt-a0Q7kNvwFyVwTo&_nc_oc=AdrpB8rGpR0J7qNkh8QLAresd230ypZcirL_z8quNC9QzOfEUmHMTJPhouQPWH7C734&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzdcwh3k65846sFLoQvXjkJYl9ag7yUFMdql4SuGVY2SA&oe=69CD23F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BYXQrb1h6IQ7kNvwEwWT6E&_nc_oc=AdqZzYrAuaeppl-eTnAW6_z6T-wPrnFe7lcsUmPbcIxV5hJgA6syb5hKN0ricC0gnwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA__miaTnLhShHCOOX3JN1g4Am9BpronhMAtKkV1pySg&oe=69CD2484"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7Dd86NJtLsQ7kNvwGfZEuZ&_nc_oc=Adr_OuTkVkw_EvzUZLeuJaqpJdhRGXtugtgYwncXUU8TK3hIevJueXeUPE35pYO_0EQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRzjMIY4dIXFx7RWMvpWhC1T9Qo1vOKfdkKQWEjDyvHA&oe=69CCFB36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
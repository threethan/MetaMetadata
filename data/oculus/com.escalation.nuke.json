=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YMUC1IkcscQ7kNvwHSIkWx&_nc_oc=AdrbHxoLUFd6wHw-VhG5F7CYudPJNOiNDIBj0Klmrm6w8I_f4AGRo53a2xMc2lM40Dw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUjCDGpH7bETNTN988bABWZ61HJ1k9mKbbaHkftGjJNw&oe=6A917452"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E_vKU60OLUQ7kNvwHjibc6&_nc_oc=AdoqANffLi9RsDLSXZoFfIz95VFxMgFbm5mfne11oT9220Jz0YawhkxjENsIfgcPaxc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG18qxay7HtTKEf5CNtSme4Jc-GQX0ETZZpc31wlsFVBw&oe=6A918958"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DY54ikF2zkQ7kNvwHSgWDx&_nc_oc=Adq-EHooK0C1XYApQAZMODwbgHtKe1a_0CVdnq_Obb2UEUkFuQHo_BPblZXHs7CKUKA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiT6qdVfhyrxwDL-kdP5ssWsZV6n8Jmh-ZN-XiToC0tQ&oe=6A915B36"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl21itYvBmoQ7kNvwGrtXyG&_nc_oc=AdryF968KdF18dM-B5sXVeOSF8o-c5NMNiVTkHrtg1kRmjzethDOgTBJJnGsODT1pwo&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELOzEKZLvMdacEaq_vHkqBQQv2YX8DWbEmu-SYNLjr3Q&oe=6A915BC4"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BibmvL3bvPgQ7kNvwGbEdnI&_nc_oc=AdrRSaHvCEPsr8-WGteyCiAgkaLTA95B1z_fNpsQUmJVjiuyYyzyWg0F66mb2BxqOcE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVJRmVgyemMfr8Ovf5LU9gjCdUtD7XCpCmRu_Zvs-z4A&oe=6A916AB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
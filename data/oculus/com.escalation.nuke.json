=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWEm0lqwysMQ7kNvwG1g2wd&_nc_oc=AdpvY_gfokj3nAuAYYZL908SKBJBnXPQHWD070NoLfZ8pJ8nh_qQdfERPbgX66f6PDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OUMlqYEYWFK8T3a1JEjCo90md7evW2n62UoyEyvnTQQ&oe=69DE2852"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTfo063y9nMQ7kNvwEKVWjo&_nc_oc=AdrgHl-RSm86VWIfAIIUmwpdDAPgj8u5IKBO1fk3H-voNY1KjaI9wEnE5IJs8y_9fkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PNI5tEf9PplR0FG05HJIxGNNNl6ZNMqvrSIef4Wv86g&oe=69DE3D58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5u5bwam9r0Q7kNvwGNl7x5&_nc_oc=AdoXgz1TEipcMXDMObqDPxNblhMPtOsN7nGYpBGcCPUmDXmRkoTnqiRXKmMd7l1cir4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t2hg_C4A-nVdtMKV91tx45HU45qViMUmlziQeA4tgWQ&oe=69DE4776"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufv5HzPlWEkQ7kNvwGjNCqV&_nc_oc=AdqCayeDZ5c_ZGDCnfS8HY4z00s5YYmKxMI9nirYt9Zf68sVSqjrtOUY54ZLnqhCwpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yxGVLH1C5BzO2UUguIK7wDDN6OcK9C53pvdJEv4m-aA&oe=69DE4804"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJKpFLWKZsMQ7kNvwHFopFt&_nc_oc=AdrUvyq9N9ZG5D6EgF67Tay_a7ACj2Ia26eIp3rH1NKnV88gKmTZ_o-VbPvqHv0Iquw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yiRWfs2_1xZCTtqW1axrJ3djtHylcpMUaxmAHO0ClBQ&oe=69DE56F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuIbE_MweZAQ7kNvwEo62Qa&_nc_oc=Adqbc86ug2jOjCWWZgmIw2syPmED0esKo5n7fCRMp6C6tWIit3dd1T6APFMPV0Mqoa4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPLwgSwsoH-hnQg4FgoH3xGZtRVqVLhz8brLKXuMJDXA&oe=6ABFD112"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHXDF1nMYs8Q7kNvwFOwSbH&_nc_oc=Adp0ENpbtvsanmDP0D20sbZ-N0VKgY8Xpt6UNbKjKCGM1FqKHIdcufNbGpTnd0xG_co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfgmEEsX_Ww9__rEvl8H-p9bcRypL9hYyAonAYgM7oEg&oe=6ABFADD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwm5eIm-AB8Q7kNvwFmGV4v&_nc_oc=Ado_U-9PTbs392hS1Qz-jXL0MZsJLbkBZRuafnSy2KLPICdUk1gbsREJ_sc2k8V4R_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyFlFYAp8Jb8GmSCVxlUYtLD6hwYs38OKQ9H1m0-n0Pg&oe=6ABFB7F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjuF5dBeib8Q7kNvwE-h8Fv&_nc_oc=AdoPvTBJPX8-MPJkQ-_MviZ1VCpekLHrxxgQvNAX8hpSc4q2u6rXOdM99Ah7LkxAb68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLseIuHJisYhZTeV_SExjm7JrY-OvEbGFwOrO81sN3iQ&oe=6ABFB884"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLWYysIle3YQ7kNvwHVSJaU&_nc_oc=Adq_MOdc0z52bLujOxsfArnqH8GO1sRaDXCegr5HQVxh2cleE5hB5oVz55xXiLfPkcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3EOjf8x5hBew_2hUw86sNNsJTaaWPLlRUCciJh4SdMg&oe=6ABFC776"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
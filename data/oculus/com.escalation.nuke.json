=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHoh74MkUKoQ7kNvwGbWwIz&_nc_oc=AdrhkLs7W5kRuwa3XtxkCte64th8bg6xlraxIb2YGy24dYnEVJYi2gIFTGhLZ5cRSOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ihd2J1KZYTPM7j83kFsAia3-3zzF9oqbHv2VXVpbQ6A&oe=6A049C12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddFvbo50uLoQ7kNvwG3kzN-&_nc_oc=AdphbB3Mm9SDMpTs2U5RAR5DoTiMdEUmX5dZtwELdFmCNij3VEBA4E-bKQfrfOfQrrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BKOgYOrDKzT8uTdbCf8bJnOTRoiUIQ1Saej_Ts8xJAA&oe=6A0478D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZtJar5Mz9QQ7kNvwHlQ_Zt&_nc_oc=AdpK-Ali8sw0KE0mIq73EQb8JRX7hGvDf3gSwkSDK49mNzKOqGWTyhUrOqRCm8LjcmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dUFnDijdN2tZMa5rSPKPvEm1BW1RXuVq5Us024zRIWw&oe=6A0482F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSLOqyVZPMwQ7kNvwEoutEm&_nc_oc=AdpoG_Jtn2wEDPGoOFNzuaqXvr18KjyJSjg68pbbZvWW5M8ELVVhH5XPEersw7h5qkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JiatK6FGjH0uELkvR-gKL0jBGS8rxG6oMaMMjyFDRtg&oe=6A048384"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFRMVIvh8qgQ7kNvwGQmel2&_nc_oc=Adpu8goZBEQ-qDxogQWWyJZIdo6abNm3OawpIyrmeUaHZOnuyi_ecW_03IZ5CruYW84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_qhvtDh1Kj7YLNFqrarjXpuG-Q2Exic2lxQ_7SL_2kQ&oe=6A049276"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
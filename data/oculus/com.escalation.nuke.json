WJEXTUY05NEvmVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcOdaKPbTzr1h5umKMXkixHf4jwxmgzOu2Bu6q_jhFmA&oe=6AFDAF04"}, {"file_name": "migrated_image.png", "id": "2833549020096458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5eSNm0zQSQQ7kNvwGROpyO&_nc_oc=AdqPdlWdtKBNT4iornu5rf_q5D2Bfas5o9WdlWvNi07E6ZD11lLCVpPMNBvU8wpuYPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvOhbWxW9WidrcyviQ-MEvconUuCKoUTy42bqohpCsqA&oe=6AFDAE76"}, {"file_name": "migrated_image.png", "id": "3141053795906722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHC2DjKuhaEQ7kNvwHJejmj&_nc_oc=AdqCR-bnoyb3GiNZUhelVyOc4CMQh1VbeQDstGxtH64EdbhbpHvWDUfkUrsm3INeA8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLIYt5gNDIdbA1mE3GEKAwes9Vq72CdsRSgXWtIGK7bA&oe=6AFDBDF6"}, {"file_name": "migrated_image.png", "id": "518734439075611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427506_995671227154355_1057277512_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzmZgI5OKbgQ7kNvwE2x0Ms&_nc_oc=AdqCEBH9H5XQfz1lF7jIJKFLEHwTtb6T0bUg7QL0beiD2Jhiq5WVTQLhKq1-_FeJmiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe5j1NUOLer9COJ7zY64rN3UdUYDd9QQRAet2vk6IbSA&oe=6AFDC792"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "BulkyPix", "support_website_url": null, "website_url": "https://bulkypix.com/games/please-dont-touch-anything-oculus/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494900098730791"}}]}, "scheduled_offers": {"count": 28, "nodes": [{"status": "PUBLISHED", "id": "2078418378848423"}, {"status": "PUBLISHED", "id": "707288109708545"}, {"status": "PUBLISHED", "id": "722706354605669"}, {"status": "PUBLISHED", "id": "856108581215886"}, {"status": "PUBLISHED", "id": "142591142895778"}, {"status": "PUBLISHED", "id": "1384951278276392"},
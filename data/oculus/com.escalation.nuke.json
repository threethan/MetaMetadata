=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GCJ9cL2hA4Q7kNvwEjrqU_&_nc_oc=AdoSesrH9lKvWD1yB9oQrLO8rBTHBs5pkzsDSKwq9PRFeY11dvkt1mUAP_9g4wRkXeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNfu6hOxaki1XeGerobI2calLfYXbpGpn7mceDK4C2Ww&oe=6AC66892"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L667ZhBOId8Q7kNvwHdlpNu&_nc_oc=AdrhesYXf-m70WyC5cbz6WeWGtQVqJula4uOxtH89eMo0TZ9qNOTNzAjZ1n4lKel6fY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmo5WRd6hDwn6T5hFoz5dNvGA3fn1eU8ptOpBzfph7YA&oe=6AC64558"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6vjV0VhEkoQ7kNvwHydx8Z&_nc_oc=AdrX8Xrrrs9-7gG2junhRffLP8szcKX9vB-YfctqP_WP9IXhEoiRUveBrz_lShAyNhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKIrct-khgHS3J0OTeQz6N0rKKx536agDsjs_JDzrtdQ&oe=6AC64F76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csIfn_BlrLAQ7kNvwGxUUYx&_nc_oc=Adq2QNqhX0rp9hhskMBBQfxLZXRZepjDy02VCfY4-AaIkEZjo9sre5mHDH3xWADPwaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3I2zZ-VwEGyQ7eQCach5Lntc38c0mAyvucbqHuVqzFA&oe=6AC65004"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQoyNJB9LskQ7kNvwHjIs7q&_nc_oc=AdpzKAGeHeJuN9o7R5J1oZhGxQLp78WJrVSI7IreQO19jU9zgKPlwbd803aeg-sztes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJip9doRTpp-E7mzALEUwdYl5FYpoTx4BsTkjizEojag&oe=6AC65EF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDn9KUE1S-cQ7kNvwGOwjfd&_nc_oc=Ado3VztaD26MPR03J6e466MLSu-qfjJhbtOQK3RekFmPGDx8Xp1kiweONH355lAa5Hc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRecCcqY56UBl97dmABtUCf9VXqJMM3fQkw_iZvmqvlYg&oe=6AF1EA12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CADM1mTPuQQ7kNvwHHlPed&_nc_oc=AdqHreAKQQc0h1hzQn9AhPY1yZxVE95mS2BpkpY1n7uGUsOiukj3Ut2ugITxn7FJlJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqOoo5us9zHbGqwHubxS6m9BTOtqmjOQNI2oSpMZ5_GQ&oe=6AF1FF18"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR6tcGWt8qoQ7kNvwH1DY8e&_nc_oc=AdrhC0W7PfTdIWNamU2SEfRKjQNeh1gpHYL2cF9Xh_cdPgT1DiQi_A_rgYqbp3Wnw3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2iZDecPBO_egBzLZJj6otjgHsXT8drZhYIm5PwhY9aw&oe=6AF20936"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxSch8NFMMYQ7kNvwFMuH4I&_nc_oc=Ado5BQliNu33GEVP_8-RDE1egCy8QZBxdNmx8MkBzDyCJM1bLIONIWJC8kWAA5OiO1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNZh0XpkMDcCHZX8pGwmRJ_vfGJ89MMeoPFYC4Pxk2kA&oe=6AF1D184"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu6-kP2iC7sQ7kNvwGvS58P&_nc_oc=AdoCMv2iHRrbENfZ-9TfHJfdwL4ERwelvhLv1Ql58cw3EPvIc-h9MZRP2Qcmigz6QpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStVKbjj-YhzceyAIkl5hlHZY0bhAinv9kPWjvz74LRkg&oe=6AF1E076"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
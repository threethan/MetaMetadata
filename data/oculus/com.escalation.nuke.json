=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9shuAW-d_VAQ7kNvwH4KUAC&_nc_oc=Adrp96V7gxBZevWBVcC_qy1xFcXWv9-BbgcNG9lZTU3L2mLXhxTcRADTwgFRHyZcb18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJheQ7-jjmXyNeULKubl1tsChlgpCCvaTm8aCIjtg24tQ&oe=6AA6C492"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDwPCLwXpJ0Q7kNvwHgx3RR&_nc_oc=Adp4S0u6fHVAzQzeSCKfwm8QBG2yZ0wEFKuOvDpe7X_tB1gJ2l6WgqN47m3gBd-kkRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkE59jSc9iUzCYq6cLZieJitpAtmEbC9CpGjdlmKq72A&oe=6AA6A158"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ps_sbBoULgQ7kNvwGNkQ8D&_nc_oc=Adr5rXEeQy3Sw1Eg5kbsS6hVYUKvG5-VmV1G0Omz7pM1e1vzH3fLU_rS62_fmSjah8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvrBEetkVVvTadTHEZGMhCZYoI0dG_R_JQb3yewUM0qQ&oe=6AA6AB76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNo2zwHNgEgQ7kNvwHdw5BE&_nc_oc=Adp9tQUoVv9AIGR5tjm2-6XFflH9I9fa3NNORCnvIiF1Vpn8qGd5GSpdyS8rNGtuoDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRvpJbL-j_eiqGFt8Itf2BVQ3Aho0j56_RemnRgEH_VQ&oe=6AA6AC04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZXr2gW7KVwQ7kNvwGqHz6n&_nc_oc=Adr-MKGUBPD5tZxva9zo1qBSDyGsCFi0MhSeALwfDg5UhgcvquSxLhpwqQbYBp5ZkQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJZ9Klj5RHjyIlgq4rypw1y9Y1RB2-sgLS9tz0DTMNuA&oe=6AA6BAF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
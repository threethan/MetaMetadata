=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r34tFwCrncUQ7kNvwF3L9iB&_nc_oc=AdoeOch0STdcnp2vTOLMwDvv-G-vCzRMLaDXKNHyNP2KrzwbT6V3cHWJADB1u7f9SvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1pr5ZFTIwc6C_gg2NLv5sHprPC0JYH5FYhhDZJXV2Ww&oe=6A453592"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbOIs7Vug_MQ7kNvwFbxT1e&_nc_oc=AdoMN5UA8V1b6tAt-uic7ou6hNQfSrHEV7yrAp2vDxAcyAsspx5uiilJ3HMDznsgwR4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95obkPmP0JUvHvJjZBFsLbZvL_2pbwStx5NF7npH2_Ww&oe=6A451258"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kocJwYXkYP4Q7kNvwF-BQhA&_nc_oc=Adp3dvxuAzcX2zcE8FJbTig4Ud0vulo99npqSlOZWYasqqZdX7PzIX9IpWbWSYc7Jo8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kPfLjd6-GU5REZgeC9KZIqDERrtN4ynCFMH8OWdQmWA&oe=6A451C76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trMvsKZFu-0Q7kNvwHuv1of&_nc_oc=Adr6YED2wZj0Aku4AqhwkbaoQJByBPKuKz-U9GsUL-lWn6TvRYt9JQAKx7zWEKrnHIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1elYnepfAsiwefHKXv7KAmeQ8ib96TTu2VFjL3DvZZA&oe=6A451D04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Tu2ed6MO0Q7kNvwEPU09Q&_nc_oc=Adp-qTu8aG12dhvS6SUET5KOhZ_ZeoBU9rqviC2YxwdYXN9n4Gn4BAIvIHtjRBzGTlw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9POuKJw2JgTuX_Cn731MW-KtF0BzTdq_vj5a4MzFCHCA&oe=6A452BF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
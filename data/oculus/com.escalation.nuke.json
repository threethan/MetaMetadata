=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPsWURiIq6YQ7kNvwHC6cPt&_nc_oc=Adoyb6y-YToV6NXghiqyhpuJDpi_Vq6g7gTQjt39QOWH5F8pMbwBCdNhBvW3VIeyLTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LGnT9d-fzi4yF0IH86m3BVWYf8CMFrIjmOjTIdXWFwA&oe=6A073F12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddFvbo50uLoQ7kNvwHSu-Uz&_nc_oc=AdqtTHvQJlkVH0y9ISMDAxdyMVzXNYlIX2bxtPlungaJmsLvwr505ZJoAypVWbkYypc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l9eowJCpO4k39zXfrojMtSJYvB3O8UiWN9x0rpyfFbA&oe=6A071BD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSHPghivCWsQ7kNvwGa0bMk&_nc_oc=Adq-GQBmQOxZdNoLU9pijBP0Maf6ElCghoOEXu7CkhdLhzdyc0PrUdr9ksXmf7w2h98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qPmrX5Q8quRx8Otdg4qlAYU6Yu1vi6g-aV20TcnxbEw&oe=6A0725F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=715GYRFdqfwQ7kNvwFnjK8r&_nc_oc=Ado-hlfmO-FUUAJd0zmZWpyIreVBbWOORkwvvRvBHimTOHuuO9aBWydKC4RC2PVTx5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58dFIvs95u5xpD9zBFooesImwEGW1q936yBuuFqdE5EA&oe=6A072684"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFRMVIvh8qgQ7kNvwFnw147&_nc_oc=Adr_lh0BxS_ogDgxQhwc-E00mqrom0C7mSkES3zC85B2ktR5_I6bRoCkA1mpKIDDznI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IdROluKcj8z7yWpnBw7xA3wMeKSQY4JJEm5SuXcFxdQ&oe=6A073576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
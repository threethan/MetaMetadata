=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDbIbrgKFd8Q7kNvwEx7dNa&_nc_oc=AdoUZIceanqvvaoPC-FwKslarChOlpDk9MZSD9JyDa8-eKn0iXreBuz7K5u4gUWhRGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9IV0BrfhWkjbdSX_l0ZESv5XBp9bJfSIzI7duKQDivQ&oe=6A999592"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6GXBczq3VEQ7kNvwEk_VhJ&_nc_oc=AdoYGEx6tCxkG8AQdGhydiLy9Y2adqGlxd0VzLUfHGv1Kt-gz6G_somDbBuGcSHG_-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpmfQj5ljGFIBubFB2C-Bc6moy5bnvBW_6kH3C4m3xsA&oe=6A997258"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59-l-En4RyYQ7kNvwHSLRdh&_nc_oc=AdoQ5BgmYasJ6YKtp15Nf_INgvYvvAgUIe0RWJKQpYmRv2uUh7IlNuFUlL6IbVsJspc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-mHEFk-ZfTRKpytUUjKdp0pUvaMwIL6QvIRJSLtxBsg&oe=6A997C76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFI-KrN2tmAQ7kNvwEUWDpK&_nc_oc=AdpvEe_YJPuLvCrbtsdLRH989NIMO0kF78GTcXc9waTmFxfpcrdmgMR7e6O-GDLIQsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp6f9j8a35fiidNgfJ029SwjdYhhBWDdsM5Na4bF4TfA&oe=6A997D04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8rOUZ9uzFoQ7kNvwFvGapY&_nc_oc=AdqW4GkD3kBNXP7OELC5P6mSw-yz0r9OMsruuksN3mddvhY4DzcAzmNPr1dyeUzDHfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLacG1JKd93U8Emshk9Etr5T2041RrS5QPPVSeiuSrFPQ&oe=6A998BF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
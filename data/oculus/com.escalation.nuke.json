=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YMUC1IkcscQ7kNvwGirEG_&_nc_oc=AdoZ-_2XnyiTs8Ol1QEnadazBC6aMMmFYVgrhM_VrMLB1BeR7XlqiCeRmPHUcedLyT4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeqv0l50trNM8MJT5S5wBRdRbv-Hxo8HV5DXVKaGCjzA&oe=6A92C5D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46hWUNLHHecQ7kNvwEN9y-i&_nc_oc=AdohZx2aXr_Bhfzy8R4c8Fsc7-SAlGySVBPEYupFSihlScCWlwVbgHe9K4YCfx2FIIA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqsTjYNoHUGDzY9qGR4-rorCj56lEhQ7dqKv9tDI8EJg&oe=6A92DAD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DY54ikF2zkQ7kNvwEX4mrY&_nc_oc=AdqIgAd-yyYbWpre7d5FBdKQAjyvSLZ-GcLPEnV3eN4T-85JgEdSYT7DFgga3zt_SRA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEvjijWSq1V2tgxwBfpNZYybCddcVl0Mdg-lPZO7bZmg&oe=6A92ACB6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl21itYvBmoQ7kNvwH1FIQw&_nc_oc=AdrHgkG9W1O70XJxYeowEKn0Wm_YO6XNHWwYJHq-ru4OXqU-CE3lvV69CvA1pe42S2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOkHUgKDiscu-YfyabH14bqXwBvJET5ZAx_Q1t4Rd_ww&oe=6A92AD44"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BibmvL3bvPgQ7kNvwEcrACl&_nc_oc=AdoYb_Sit465l73H8gLrmbf4uocS__2aIp5Ze7Ygdzk1ueDOr5qDQ956fgyHNd3MFfs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbO3yGbM_fVhDDzKj48-uNAYZU95-VSrDT0UgwKplY1w&oe=6A92BC36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7iM1CnoyHsQ7kNvwGId97t&_nc_oc=AdoQ35aVvaDEPceY0oipvMixjzQZvnW_nHHdtwaPvA6gbr8X-7KsZpm06sR-Mmia_S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz9u-kmp1e4rmmlDOkw8o73WVtyvbjGDcpRJ5yffmsMQ&oe=6A4FC192"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpeL8ys7VLsQ7kNvwHsfMp1&_nc_oc=AdqqHRgSebxknl_E_9Yh8rHS4CdbttaHTJTdrWV6n4oonx1GAQjXRbyXUq6nYx0g9iY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4qI_ZY1wljxBUL7zGrIuziC7PYrMGZORrQB2iNP_gYA&oe=6A4F9E58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R1BblsNshIQ7kNvwEksHar&_nc_oc=AdoC_ugSCUjdkP2zhqiaMsSvaC5y3BtuceXkiAXfwY23AyAzX1J1SBjUqXiCbhwTFj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVfsW0PVZyF92DJmeryS1_SSQVD3pJzsF7KMZ7vbYDJQ&oe=6A4FA876"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIKBOr5jcbUQ7kNvwHT9wxk&_nc_oc=AdrVLIXOJNuXd-mRRiVhFfCp9c5ynp8TGcQxptFr_cPiCvyc1DigQMhzEDgKqCosqew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWyf9St7GJRrikcEqPoC1nmhPjmKmV3ejmALynu-i28Q&oe=6A4FA904"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbGyDk1q4GoQ7kNvwFWND-R&_nc_oc=AdpCSn8d7upftuwlzKLS3bCSluVU7tZg2vvPQVR4D9WxR3Vz7xAzLvdJtmTz6pteX6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeFuqt9ArodXojxUpymkCx16CyBeJvQqvKRovPz_xolg&oe=6A4FB7F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
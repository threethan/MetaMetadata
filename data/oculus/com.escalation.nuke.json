=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxaSlSuLbZMQ7kNvwG3Z0lk&_nc_oc=AdpiIePiwPhA1i7KBwAQvrA1WHLBYjJqoXdewxI2JP30FEk6O_9ltXd7kTahhU1dXZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4tjEyO9mWItrcnqNroEPAemHKj8POM6e3s4c_WGi4pQ&oe=6ACD0012"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK8_vTJtkdMQ7kNvwENImH0&_nc_oc=AdoRSoPSN83LAePmErX4uzIyivMh8r2_XwvTBuZXSZLnPg1k_XpfUhSBUvJCb87eVaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP02rEu10SJaI8b-_lR8lS15b4ytUDGGKP2xAhjcr2h5Q&oe=6ACD1518"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8IVrnIhkIIQ7kNvwGF3c40&_nc_oc=Adp2vhyjMcVcSkMepgnkV88rSStMfTmlNHC3F9AVtif22yM6FMriUJvnTM9kRNscfsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZzDJKT8-I_0zNu6ERrzJQGb0hmjYoEMerbo_Rmdbz_A&oe=6ACCE6F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mnz0sCTKgFUQ7kNvwHdJ8kB&_nc_oc=AdrIvxAweAjE6jm45fFLagOZR6furNh5hcv9LEOrUz9PLgH3oF5jtZWR6z4nC9BwJMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB2ZipcAUzZifjLRQolDkV0zypip9hHlkIlqKUxwmYuA&oe=6ACCE784"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPcIMrmCfFYQ7kNvwHS6j7A&_nc_oc=AdpYO9s4VcQme4pDWC8njgzkTlyBPcZvJTkk4QaBj1aOTJm3NGy9b1fawUWLSMdagMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCEJl3S0U1NzMe0WT8DYEBMX6aoDOjg0ZwI4Bupc-1fg&oe=6ACCF676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqgg_20AEP4Q7kNvwERTBDW&_nc_oc=AdqrrQTgWN54_94-qve4_3R8QSxNKjsKtm89wayzPPj8L-XxaPjot3UKRE0VyHIdYJA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEsm3hivXwpI8LfdNrNP30j8tTUOJXplCfVkVMdkowSA&oe=6AE36992"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXVe0JJ38ewQ7kNvwFQzDPw&_nc_oc=AdpU-fJ4IT2WYW4atEt8LYSClmRRVZ7VYSCawPSVL6ut5dTQWZInCc01XtCcp4Nxl6A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwcKl4Ndc2FtUkjIMW5ExGEgenN2mFnxVvm9T_BtDjxQ&oe=6AE34658"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQDHibRANcMQ7kNvwGMdn0w&_nc_oc=AdqRbOkDEGem7rp6yIndKuNT4fKCVKccP0wLlODGI_aUUXEMjv3zWMyMShIEPWdrgVU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSVAYgTShaC0D2tGXdzFv-hNrWPQVE5AVZt9gaIs5CWQ&oe=6AE35076"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq8HHe_iNC0Q7kNvwF1pReo&_nc_oc=AdqWJ10L8C40YSjD3jUkEVoxaKB8Fyw5DLAxNET5wYM9IniypURNS7Y3ZGbdjWiyF8g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2JDcPNXQOFFpvTOYpEpQEqg2bwlZWwx3OF-LhV4ZYqg&oe=6AE35104"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt5tLpKvufYQ7kNvwHcOa2L&_nc_oc=Adr74pgOdwXgFVrnw71lqD0JSSmP3qe2p_PMU2TLXLgeCHzlY5pBtVC-_yK5PJKpWt4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3JA-3uMLx88PK8kBE-w1Qqg02TzPpA-I9fEz0Oy_krQ&oe=6AE35FF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
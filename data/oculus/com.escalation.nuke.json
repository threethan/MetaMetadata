=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOZcSnYKlUsQ7kNvwHOE4RG&_nc_oc=AdrybHpFhM5aRPQ845Jvk913PPw3Q97UuYi84f5PrAAaQc-yoG1hRJggdh-t-2xW0wU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsZanEjEz1M4RhwNqtucSFgpN0BO5vwX5Gl2aV4cT5Bw&oe=6AA17E92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsLW6h5EVMQQ7kNvwHjiEWi&_nc_oc=AdpNjC8RjmXu2AT1x2z1ymYBMCbdArUCK-idd24FdoNr8WieTMtpw56yMwWsHU62Vhc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoVdYDK8bMk7y7KNN2JpvCM6g0tLHd8YglUmntUV7xLA&oe=6AA15B58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSHKFrr7kQAQ7kNvwHZYO2g&_nc_oc=AdqfBCh65ydt1T_o_bHsGmza24f4ubrnAhdWtKaSvfCp2o46v6rGEf-GKyuhMStbD2c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn-iM3xKEtGTcyYMyV4e7rYhkePktFYRO8g-icXAqXUg&oe=6AA16576"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0WMwiOGiDEQ7kNvwFq1-6N&_nc_oc=AdqEnWLl7PLKoSZFflJ5UN7Dpzoq2L8-k_-ixIWKcBpcDfm0ay9qxFhbSbnsfNucBjw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAZRl_sITw4ycth5bGlVvheHEaXnYgRm56znp6JdWhgQ&oe=6AA16604"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOM8MYbwir8Q7kNvwH4G-nl&_nc_oc=AdoIO-jAgYx1Yg4vAphRU5eknshce7xyFQdSVXqyTSJ1XIEAxEtojPaAFlrIG8fbj7E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1YpMuhyWCslcu6ZmTKiDPlvabSggkJ9oEqYG1qVLhnA&oe=6AA174F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG1BUZHGpd0Q7kNvwHb22Xh&_nc_oc=AdrxO4XaGyCNiSGiHrkA89N2wwKbr-2kE-r12u7XHz5QsffeTbibbbAiQK5mRHDJMOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAoTcIQybnlFeAAoNgK0aX3ZJoiVSezM-pL20QkBws3w&oe=6A5B66D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo0IlliXVq8Q7kNvwFm47uz&_nc_oc=Adre3wGw7Kh1hCoHmN0lvr90aUvDvcQg6uCcjXHdjLvmfZZyRRHKfHM6K85fIwe_F74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwC1iCU2iU_GGbYziaieJ3bFY7rDTwxERsyGkJGPsehQ&oe=6A5B7BD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN3V2h6XVBwQ7kNvwFhy_JS&_nc_oc=Adrd9NTN7ermjixhXQFb1k3JGXbjnGTB9IexhxFwrQlLMFbmKP928lVRGAm86QsYBv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSjFmlL6_ndf5ESJalCa4lfc5urvrbomVOUuwPG0M3xQ&oe=6A5B85F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivdo6Q9XgZIQ7kNvwHFELmt&_nc_oc=AdonwKDF41-dLOXKhpZCYEVeqlqN5olCTaOwhz_cDM3CgERw_UUBOOfgr8ItOe9MOPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd3tyfoHeuz6GeoKnPLp7h5SuUGpCqWjFZUzVHyA4biw&oe=6A5B8684"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RkAqyuqCGgQ7kNvwGZsO-6&_nc_oc=AdqFGhXP4xLImbzgT8JzTtPWuLeF3m00j6CERwKL96KSclY7ruKsHeZaaJmfmsF7GzU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALYpuCKuwPaW5hOCK5DXcsz8ttHL10FPcM3zbRkPmNAg&oe=6A5B9576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBHeC76Vy1IQ7kNvwHpSTrJ&_nc_oc=AdoaMGmAZFxT9FfEjSEGzI17smaQOawX6Nm3UEkTrPtQzEtNRI7gIBiVdVEFGBfuVe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACoxZxhsAt5hIzsSjxuS-d100gGKndF31Lt82F-hNOFA&oe=6A638812"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGIa-oUOW78Q7kNvwHa-mo4&_nc_oc=Ado05lPOfWSpJSYzCniZRInUxQnhSvgCZtKaF93AKSBXeYU448BOoAWcYN0xEHF9wq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf48aN5GPWHNoe3epKU6r-ARKf0yJTrZDpJWhP94CeJA&oe=6A6364D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQE_PxWk55sQ7kNvwGSJfRR&_nc_oc=AdqsrAHROjGMEfeIvhnebFNgikoNAtHeaY4TNTQZOsDfYG-NQMZOgMBXJg3S6pEdt8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcF9DPTGSbp_InKmUQXzPalq1MrdqFYCsVTGpfJnqJww&oe=6A636EF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1aXjXWKQjEQ7kNvwGmsPXD&_nc_oc=Adq0T4nWkaJoT5xvLjsMB_-u8d5iAWVbCOcRibeAsH-mrCbaGt_rlDruEM0MT3eJWsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQnqGveLwSYBHErxstH-t-NRoeZ2t7XZXtVO4P1DYjRw&oe=6A636F84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyFtfDTQ7tMQ7kNvwHh6Dr3&_nc_oc=AdpQ2XXyTSdVdzp3M3SeyfyOmzFYiIMO-CHFg57w4viCCTuh_fk-WLAIb37ZXACLA1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMNBhVd0JKOopHs6NAypYOsxEuS8R1kKOu-UBNDTYghA&oe=6A637E76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
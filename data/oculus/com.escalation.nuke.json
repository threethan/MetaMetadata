=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJkMjshdj2MQ7kNvwEC1X44&_nc_oc=AdoQ-HBjID5qlOvj-Wazw0aN5ElLpzpnb4TSuQlseEi8wRPVzVyUIfZfkgXZ8VaRAlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VErVBWZNtoO1O5UjLgqqep1eveCRAIFI1lZZArHLOjQ&oe=6A380692"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMyptxHC_rwQ7kNvwHPQF_v&_nc_oc=AdpJwtzJLLeqWAxzbduRoJ2A8JmU9lkHobvIcqwdAqjaA_wt2QuOCbnVVuOOjymVs7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jE5aHkGK5qvi8yNb5Y71buistcYyHTrJkaAAAbwiIUQ&oe=6A37E358"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0kfvmhuXgUQ7kNvwFEaV9Q&_nc_oc=AdqJP6mn8qLMl-1Tz8Ec0eSjNKJKiJxHiRFvBGnfcJBWGfFyQk2G_FkQjiSW2sjVtaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bTQq4w7I1RxS-ao3YWAaPM3aTwifgpmZ2aAfJIGJssQ&oe=6A37ED76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IUm2iZGkDQQ7kNvwH1GTR0&_nc_oc=AdoFHSDn95GyRo61CTl2brFYcsF9k5A9DqHMo7gx0vEAqQonpfAs6XZnsEHXo2f8RCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P_3JuUZSM1Q0E-9qfYMAULGOTo8GtcxUqHjX204oknQ&oe=6A37EE04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7y09V-uCUEQ7kNvwFVCClY&_nc_oc=Adq494i6HUHMYFRcxjkFXTqiUQd5_B6hIRJ2ZC636pA9xVe7SJ86sdh1YSbvCk8nXkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LpkSoj4bw0240kkPqo0S48ep1ICY0IPRlhYOami2z8g&oe=6A37FCF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
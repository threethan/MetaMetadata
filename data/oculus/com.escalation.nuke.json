c3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8qylDiz_74Q7kNvwEWC5cM&_nc_oc=AdkABJHTWQMVxJ5IVvMIw5G6e0I4CmM5X25_g-giL0Yn1hphJPzbgfg0QH7ixI5I9oo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4mEAo8XFU7yJfEDx2BwzZVxAahpXkPKH0B2BLudxUGA&oe=69B691B6"}, {"file_name": "migrated_image.png", "id": "518734439075611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427506_995671227154355_1057277512_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9C_VB8pX5sQ7kNvwFPjRQh&_nc_oc=AdmG9MlpDoEaDvm3w5I-VC9C1c6ZvJQwEGEaXYWERiqddbTvd2fkoJKOfJReul5dG9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afysf-ZVJb0axs7rWKM6VqGT6eTuKptJTNGjgkL5djGQdQ&oe=69B69B52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "BulkyPix", "support_website_url": null, "website_url": "https://bulkypix.com/games/please-dont-touch-anything-oculus/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494900098730791"}}]}, "scheduled_offers": {"count": 28, "nodes": [{"status": "PUBLISHED", "id": "2078418378848423"}, {"status": "PUBLISHED", "id": "707288109708545"}, {"status": "PUBLISHED", "id": "722706354605669"}, {"status": "PUBLISHED", "id": "856108581215886"}, {"status": "PUBLISHED", "id": "142591142895778"}, {"status": "PUBLISHED", "id": "1384951278276392"}, {"status": "PUBLISHED", "id": "270897266965735"}, {"status": "PUBLISHED", "id": "935045353540142"}, {"status": "PUBLISHED", "id": "303995393748040"}, {"status": "PUBLISHED", "id": "358961731527401"}, {"status": "PUBLISHED", "id": "1937754452964106"}, {"status": "PUBLISHED", "id": "198080274478204"}, {"status": "PUBLISHED", "id": "2693195307572364"}, {"status": "PUBLISHED", "id": "584036918805746"}, {"status": "PUBLISHED", "id": "381431502554977"}, {"status": "PUBLISHED", "id": "377702872958077"}, {"status": "PUBLISHED", "id": "796842203849267"}, {"status": "PUBLISHED", "id": "806009129770233"}, {"status": "PUBLISHED", "id": "1906697449653084"}, {"status": "PUBLISHED", "id": "163240670933667"}, {"status": "PUBLISHED", "id": "118076956140551
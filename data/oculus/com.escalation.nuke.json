=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBHeC76Vy1IQ7kNvwF8xUZR&_nc_oc=AdrOuPsF9phkeCbaqJfmpvs9PhkBa7lqOFCNn42HMU8L5XUlLMGI_lTXdi_CpEfIwXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbO7V6NdRJN6kajer4QEY0DVo90dXX2sHcEMCiMXNr1A&oe=6A61FE52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pUeqh-IDisQ7kNvwHYRkM_&_nc_oc=AdrPBqJ1IusH5P4rr4shyR3T-Pu2AacCVCewi_O0GJcOZjs4hW1O1VVqdP8n1xboXUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlAZZFwxIqD9uDIuTLeMfdiJhzF8SwSVA6uyTAhT8QvQ&oe=6A621358"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQE_PxWk55sQ7kNvwHFUNBH&_nc_oc=AdocVuC9gxlw_SwlYT1e3trSezAIUaq1IDMIqGwgi2gfTUM7Dr_NciaUr6nhvvSgTW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-c8M6VqoZ8Ww6hnhcLakvwsMrVUAe0mjkAAwM75Ov2w&oe=6A621D76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1aXjXWKQjEQ7kNvwFNey0o&_nc_oc=Adoz9KQL4WVus1Gts3p8py1mRPoxidj50Z06VY9W28zGjTxET66voy8ISxk7cT313UA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpzjGlS5knPz7RWf64t-ffVlg6gEmUFpLlgTi6QI355g&oe=6A621E04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWCAeQDKs20Q7kNvwHbSnrJ&_nc_oc=Ado38bLEuQ2Gl7EO24ggPTchP68gh1819z9KdUAZX93cm1QcMDzioN3wk48FtkKR5Go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkh1aWlp_Hqsdz9AaAFQthcxu3LB3CArCI_YUdB5Rb7A&oe=6A622CF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
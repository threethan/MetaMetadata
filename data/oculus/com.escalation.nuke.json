=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPUjM5HB3sYQ7kNvwEivlnE&_nc_oc=AdpJFU8G3A0PDncgjGtvYpIrsOD5uWcJe6LsbiFDNjJUHmw98E9I5e5QDC61zmU3Tu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqV86-7Z_S1XypTwagO6yaETAfJReLG_ZJTmyYFoT-Cw&oe=6AB54512"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h6AtsTjU0IQ7kNvwG_rdtg&_nc_oc=AdqhCIfIq1QehrowiCRb3JJl_7rPOr4uCyawowt2n0zq6_0-zBrm7cwyG4KHfzfvE9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1nRTIybYNUZuInQ5dcjcVvYJ_WtW-OyhH3a_HIFLYUw&oe=6AB521D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R6bhXeSDAwQ7kNvwHEPKmj&_nc_oc=AdqllzvTGr3K8O0O7ORpqsq8Py82nyZYA0FmR3Prqipb7IHf3SD_iDUgPaI_NK7QgJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO5VK39RurjO2OAUvyuf_ogMg6FbRmSgyutnn1YZx69g&oe=6AB52BF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMnIbklnllMQ7kNvwEsWpET&_nc_oc=AdpOlzikiNAekgabeClGrz0x1d50FA9qtAiip78ZGYK4kUfhGAPML2rDZZ1yUr7Gex0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZe88q2uE7i3uzS3WgFlmuAr_oNT0I4Tp1PQkEMI0meQ&oe=6AB52C84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_15-5rlvrrUQ7kNvwHt4Zm8&_nc_oc=AdpTUhX46WnneTukHWUJgEpEdnlflFwH_DHgcC_n6rZgjOQLmtLZ-aBnDYHFXRGryGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwCT9lqh7C3SgiOBMC2QmcuZvoTU5nmO8i9HmZVCFQvQ&oe=6AB53B76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
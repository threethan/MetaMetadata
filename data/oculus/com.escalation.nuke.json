=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgV0n49H2VUQ7kNvwEYIMbo&_nc_oc=AdqSbdgQxrZBusBYIgplxQVORAgmvjTrl0JZStwwic5aGrb1y40DOcuowdKwaxmiGgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01ORGagWGLbYGNXYudNBs1NJjr5qEoqoFHXxfkCKsRmA&oe=69E4BFD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWwDvzLcj3gQ7kNvwHQNfHp&_nc_oc=AdqCwC6Mc-P9Ps3fpR6Oz2vPmrlo-K6TLQ2DwnUBdgRUSsDjtMq0jqd5QP5MyIBuDWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P7kdlowEm4IW64EBjhHl0RZHQ_x3MY5oDfIrEJ_4ffg&oe=69E4D4D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfIqN8G0Q7sQ7kNvwFV6Ict&_nc_oc=Adr53U73zLqEcGfhGeRVs_OPNEVDGramsz47gKLE4xLuM-hddaoDI5iK_morEHKq8bM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HHHTWxC3tq1GOflfpWwbRrtKxJ-7mIVTXQfuKin_bIQ&oe=69E4DEF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6T6ZeP857IQ7kNvwGfknPJ&_nc_oc=AdpdcdS5UXmLe4HqnyndPMbwnglfpkE31c3wnVBOHYXi7Z7uhOGorxmGJm0QaV0lP4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F_ojZk66MCuF-T2PezwQdmlw0zORiOzCbfS2DF1ghnw&oe=69E4DF84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0YnMgsg5C0Q7kNvwHHKG3Y&_nc_oc=Adov8mOW_rZtkwDi2c3HAmWaDEhl2zON2TavK_3OGZvMDY-NuQ3c0zRw6yQY46_g0Tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F3mCcz12XWNQqwavNNANRwxOXM77-6kDgdT8v5e1u5Q&oe=69E4EE76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
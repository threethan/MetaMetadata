=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79tzQNpwq1sQ7kNvwE1jeLj&_nc_oc=AdqVZvkIFAGsFaWet9IMf9A6Mm2CoDiV5Pwf10mH1jbchKiZ5-fSflO0Ya8rlGNcutY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqMXSUrnDTYYXp9LIcTiTdXbsXEOccnhOdiO2e9M0x5w&oe=6AB93992"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seBmH4knvQoQ7kNvwH6jfFa&_nc_oc=AdrJf3NQvqzw21AGpOKupbz11JfU8xOU-ffmQLTRTghpsSAiXMoKp6bsbkHhivAx5G4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4I4846ICeZPe5mDlY4iFosfhbYCPTq0IHYjr9HpEzXw&oe=6AB91658"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDBT5zbnimAQ7kNvwFHgETq&_nc_oc=AdqlSTe3VKE-vgK9eCPUDimPnGyo_Y6f0naaS0Xdt77CiZmu3bYxmRw1u12fRoQVPcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtKSliEIFxl3u-TvLyhaHJa_VT-e6AsMA5hm6W060Tog&oe=6AB92076"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB3TfkS6aIwQ7kNvwEBp1NJ&_nc_oc=Adodfzq7FSAFbHVMmGjWmrqVA0NAMXLGcSYm_6oJQrFZUtjzauC5kk-86YMjrytXj40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT21zXak1KrFRu-PnjMnzNgY96ymPldmyehxna5NwcMA&oe=6AB92104"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V27k6nkS-PkQ7kNvwFeb-QG&_nc_oc=AdrSLSi8EzluCG8q7UPMxC-5kMSlmC_S0U1506fyynvQYtvHd1B4zvt6IL8q7D0MMyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK50VcpZ_9luaWn8cUs8zWO9s1pNci9NLVCk4LhGslxww&oe=6AB92FF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
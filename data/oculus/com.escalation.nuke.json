=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MEuEM4XfMoQ7kNvwESgm9w&_nc_oc=Adq074OiDtEk4yufBpYr3OWF9MAwwmGJiRpxTefVXQanCc-_M_Rcdu85NY7Sz6EOlEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-rBGs8nlRwDcB9sJseQGBdxcSJedFdI5hq4erAmnJZQ&oe=69C66D52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjZm3B4zR-oQ7kNvwHwhreM&_nc_oc=AdrUcQovvRwNDG8X_LbXdFgkVnr0NjQoX1BoYo4duZ3r6pwmfGYPkYrrfTW0J0B8-Gs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoxtOjPpLwIR9bwyO2P5ftWBLy-z_jevLDKF6nG_uSNw&oe=69C68258"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xyf7q9aMCBkQ7kNvwFSQMmh&_nc_oc=AdpgNJI2PfdQJpljeXRLFVz0K3oTHBEuCSrZpnPaFQZfMLBSWtVp0cqINBsOToK5Ei0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydFISOoTQo535EBC9gPGwV0w7iscXJmM-h3etvG995ZQ&oe=69C68C76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kopCYE4lx8Q7kNvwHl_eMp&_nc_oc=AdrMRkbGgA0c6R12f3mtKPIfcrozZPzb2ZpZS6PRdaY4FGVNX4_hBhsxQD74EXup7zs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwjDEhCEHu8xvBjXRLZQnoTtBxn4348pGzUQRc_YwmKw&oe=69C68D04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya4ZOL9ulpQQ7kNvwFVs_Vo&_nc_oc=Adry2e3Gn0R4-zXqVXjHi_JXRA7p17omCGiL5OtgVIpgx-bi84Pc5BosXjl-cJWYABQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUptIBFrV2rVkQtqglQWjPd_yO9FdvWp146ebXdnMMng&oe=69C663B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPsWURiIq6YQ7kNvwHBigSy&_nc_oc=AdpD16jqff1y5LJXZN7JOGY714kt7Kk1kMR2C9JRQXSN9Qp1ibg7m9iWK5LUZ4Kem8w&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WwRgs23gjL5krvtfjG74RQndKGEtCeIzNcvOXxQSNdQ&oe=6A09E212"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPnNkh9sJLMQ7kNvwE7KG1L&_nc_oc=AdqJmknIZwf087IDMq0mRT1ODTcCWDoLNrbOYhSxUiBHMyvVrZrwF3AYk9juqTkOwx8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55ctAwiyDuV1I-HVUdWOmJyUYbgoNsA-aJfnsU-QBDbg&oe=6A09BED8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvS-ewpK1dMQ7kNvwHsi4BH&_nc_oc=AdrPYmQcjdAWm5mEcYDqpXrtcWBWJGrBCZ7j0Yx4qJ20Z0-3MVFrZJBOxMElz2Uq9m0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e7bzh_u1Nrn1i2yhJ0dSleZmSTXOY5yklSeYEhniMzg&oe=6A09C8F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=715GYRFdqfwQ7kNvwEYdqp-&_nc_oc=AdpnywFTxGo_IhSNHzXiq9DDY_enrbXRt64msI52WB1tG8MFPbskQKEQbqgy5DCUEkY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43NEfXhBUwYRPeo7RlE5dOH-c6h1-qdSJGzt_B0dYdKQ&oe=6A09C984"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bez0evvKfX0Q7kNvwFy--o2&_nc_oc=AdqXP4PO7-K1djaNPZehgRG_yVBQ9Wv4naWYPnjaAR2rrVfBMVrKhNz1b1N3DSEncO0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fpL8hYKW7AFU_tizZ1XZF6C_bXAiGXKOe2El-WmUa7g&oe=6A09D876"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
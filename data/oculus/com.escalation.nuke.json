=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNjJP2r4mDAQ7kNvwHsXwEW&_nc_oc=AdoUkMnVNmC6uA_0K-ienLGSchpfnBmug3fCuXBwP7nYyPp0snxnbYhAO5_OQj1R9NU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LSCZEX7GDShCdktHMGummdFq9_OujcygKNjNEO-7piQ&oe=69D39C52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRS0Fn7LbVwQ7kNvwFXl_DJ&_nc_oc=Adr6naw__eaMrUcEKLXmZmTmAC5WI0e9jk8T27mOdeqb2-ROLkZsLgSCJbh2p5W9H_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fUo4n40S3X_Bd_ZrnPhm3HMjBxtDslE3eSN1MwADOyA&oe=69D3B158"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKK1FA0C7wMQ7kNvwFklDXm&_nc_oc=AdqZMJsd1aBZMFgYtHyyfZjt-UmgQhgjXTpBsZl74IYij6BKfjL-VK0dt8geuaU3uxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VXAZdr99VbSJWfC-6z65RRTf3G8WzqrlFoON6kXyDLw&oe=69D3BB76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu7hrwV-xqIQ7kNvwF_OnCV&_nc_oc=AdpcfNLEeRioAST2nQbX6zh0icRgpPxCCEkZvYlPYRryrmcm2r1cygrQ9WNa_eUifSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m7ePaOJRvy-f0UReBkQoYAOMMOOduXqkEbaD4AX9oHA&oe=69D3BC04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GR_0bpa-TYQ7kNvwGdAB53&_nc_oc=AdqDnkCbkwAkuhyxTxDPsefUecsbvylk3fnefoN7Mdc6baD6oM0XMjsU9G6Heyvf0gw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s92TuEqD5BvOgCx2kjP6bmR1cygDaW_kXKHjA7ZhXww&oe=69D392B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
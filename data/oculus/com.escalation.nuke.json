=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7iM1CnoyHsQ7kNvwHdkiZV&_nc_oc=AdqdYWae8SKWV-VAKdZPFHuGdPOA7qg7gcpU5ejbJ12DMIwVyV_RPq1XG8ztpzXtFXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX1VAhSnv9yRvbTUwxxY8k829DC1HvowVtAXw2YtGmSA&oe=6A511312"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpeL8ys7VLsQ7kNvwGVEJLO&_nc_oc=AdojQpe91jw0VIBH0CUCp5qF3TDYG3JKZxK1i_TZmO0tJ87IhIi6ZHujbtSaH_TyeAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmh0aYaATCsajHJ2BAWLTkHig-rV3w0TFvICUJu8bAiA&oe=6A50EFD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja1YRmDzhAgQ7kNvwFUsxP8&_nc_oc=AdpsaUt8VdFlIg-U5ZLhu1nLvfIsPIKL6XqhJyxojHxBCVNPRb6BUHLKP3fZUjfqcUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMat74qVQ96vMQGoZBSYX5mLmY0tKiCxIh-72jNRVXWA&oe=6A50F9F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIKBOr5jcbUQ7kNvwExl778&_nc_oc=Adp3CMxcuGvvmH2ewH5CzlvbV2mTDNqvwUTie0LqwK1OLTDKyWV_T1qEzk7WTC2_Vvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYACyb971x6NVt477BLuuYOI4Hc8_RxptGJjm5ITe7Ig&oe=6A50FA84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbGyDk1q4GoQ7kNvwE-G5aL&_nc_oc=AdpxYlmNqX1neCk8xr7uIx9_SjKxsfgs7q3boTtChF9elhJU5KYtOGMrSLvVANcnUzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgsgjuke6aqGxRtMTXUENTFLO9epXaHVhQy2G6PzGQfw&oe=6A510976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSkOWYs3_EsQ7kNvwFPPOpb&_nc_oc=AdrNnChE_pdrl50FuRoo2ozqkxdabELSgYiAcqgjcgYLQhVCzFDvkIxu2qCyrhADFoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Yh-AfWQMZllktRFbwntmLXX13Z_NipKxU5qMN-LyPA&oe=69E8B452"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsIiq5uGLzwQ7kNvwH1jUG9&_nc_oc=AdoHSI0uJAoUUS8clNcCt5InpMmLarRtVOGUfkC0aJldUIxu2Z5J-40-g0LM7KIoQZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-iXkCUfEiV5RmSnuIkIpoJ_HvSXcN_BB5xwNFG6SUTQ&oe=69E8C958"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmBO-y7dQI4Q7kNvwF1FB9j&_nc_oc=AdqMnsGoHc0MpA4Xgnnwz1Oske4h_mizfXecG2tvF6TFSfqGONqvEm5_wMDj7GrV8XQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32Qw9cxT7lI1U8e0E3kjnTU9uAac97HGm_T4gsanMkcw&oe=69E8D376"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh8EZAlSfaMQ7kNvwF8wh-R&_nc_oc=AdrheMHDxQoG1zKaZ3G1pnV5eXaKun6uzMOO6rsJQG9zhDhRvvl-vNQvQKPEyDarKiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KQD7L2mbxqXfcpe4ccVrr9_U7fY2jOVxgRNY9rjSSlg&oe=69E8D404"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsNDsKoGXeQQ7kNvwHR94fE&_nc_oc=AdqxqEMQ7iZ8oLsoDxyNcP0bx7x6TpdN-ehULkcPwlUC-IfaE2oftBHz3R729k7E284&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rp5vyBMTjihJ_lHlPcVd7zc2RcL8Ixzo7NiZB_8fFOw&oe=69E8AAB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ujh1GnJPw8Q7kNvwEHZo0t&_nc_oc=AdoE14HMUpwkakrUhk9VEuUX8V7-AUfU5N00wWRDTyW8d7njficvyycTYfhUzqZVDTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMj-flj7tOKcZFkt7m-Ix6nUuQFcp_ou7MqvGgskvWCg&oe=69D0F952"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRS0Fn7LbVwQ7kNvwHjKub3&_nc_oc=Adoa77wH4SsS8P2Ek2bLF9wUDuDeTsA7zrdMAKfgyz6aDuToA1rlSawGjNhCJLYt3mM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyd_QhrOmmjH6NOEApr-V14FGOfVzcuyRIcq0xKzaUCPg&oe=69D10E58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UWbYITVqFIQ7kNvwE1baE-&_nc_oc=Ado0bUAIcnqMVG_-XXrC9nqT7xj5lgRWFZ-tAhlVC7iCyYZ5ZpSTPfbUbv6dQzPK1KY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrkkrzJka9axrWeRvBxgDyibqTqL4Dq79rqdkdG4mDyw&oe=69D11876"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjn7uNbHQ-oQ7kNvwH_-k1M&_nc_oc=AdpHlgpqrIT5dcOg3STjkDeB2cMNjjyqql5XdZ1bYO5fechBEp2qBFIA_yWN1XWaa9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxatc7prkYna21Qw1NwwQSXknHz7wDhqUDvH_6KI0yr1w&oe=69D11904"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GR_0bpa-TYQ7kNvwGe8eZ0&_nc_oc=AdpNBsWzoxdD8qWkCpILq9iRo_BRYYySjCYMfHjcp4ujcjaJgxntQhp4GFty3muEbKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy972i2RyRkiPg0fJY-K2SmdC8OX35CmOwMpcLeG4gWfg&oe=69D0EFB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMswaji2UAIQ7kNvwGSgvAD&_nc_oc=Adr4442c_Y5FQK1VEN4lBvAn0QIVYzQSOq0ndD_-WSnScbrAlpfPeKlTA_QiY5prcmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD5lWLQSy1ltbjOZkEMHhYvrvehqA4OB6jA8YZlCDVNA&oe=6AC12292"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHXDF1nMYs8Q7kNvwFbHY_Z&_nc_oc=AdohEo2TFvH5UgUkr6Q-4Wj9a13_3LNQAv6LH84Ujl1hBGkXnAibUP6K8ddxEqXgD94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWHFG-Ge97eJixVrVesjMnY2UVGfD4jw_CVc-8Z8IKFA&oe=6AC13798"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwm5eIm-AB8Q7kNvwE0hnxC&_nc_oc=AdqZN9NXHPhBjgCjT_Si6VVfvYLCQ3vBxu7GxlDEedC_un1aiRFv_o5i3nC3PXSVwHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUNupyoNq_yhQjpcnB1nKtVpHmuMy7aKDg1k1v4nr7Sw&oe=6AC10976"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsBMIBy8aWkQ7kNvwF7KRtp&_nc_oc=AdoroR8TRDn1qrC63SQDzFsUzJfU2_a9rScRzGwgdMkMz0uDNxXyUCAbmI7Aua5dKlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxxIHX6jONjUtKTUkH3I9kJsYpsplvvApVrByRGn1skw&oe=6AC10A04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLWYysIle3YQ7kNvwHQPE1U&_nc_oc=AdpDg9PjlGoxgVy7nW0x0TO_OILr5sBYjyHpMHfiHm0_SsyexsrS6l6OV6OWV7ReNDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtduYw5udF1q-IU0DP1BWMmJMr3F7fbjNSZGTLqQ00Rw&oe=6AC118F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
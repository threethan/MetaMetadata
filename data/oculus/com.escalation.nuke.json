=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ohae2pK3qkQ7kNvwGtK8oG&_nc_oc=Adq_ookD5YQ0Er2xxA-3982X4XK2LJyYjfU9iBqwMtfaJchPmOXLAO0Hf5wVWgfV6OI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC1FDkbNm2Ag1y0ZidczajOjZOXAT3irxXp4h8yIZgSw&oe=6A9EDB92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsLW6h5EVMQQ7kNvwF04sea&_nc_oc=Adq_Sk2tRt9IkVSE4JfGUZa6gdZ2OJZXXRN5MJwDz3zXfnT8HXo3HSIKKr3rcTOOWJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK61pTg4kLe9vwZcnOx0C_jbRLOA7YwXmYTv0VbEHiIWQ&oe=6A9EB858"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYL1p0gkWYEQ7kNvwEmvHco&_nc_oc=Adr74wgtn5pCHm8JCXN9FvHwzWWSCHj1Rzj464uQWN-OD72f9pcAjQVor7SWi57lcFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6cFJl_j6GOzgx685565ZAoa6F2L5yrFSEn_k6GXoNtQ&oe=6A9EC276"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOL1xDBh1CkQ7kNvwFNTMD4&_nc_oc=Adrf76mQk64pv6x9x3a0EBTMe0wEom8v4DXgAuXN5vT6E3rBsqZX9IVGzn-W8HtYQPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkRid55UG0fvVATtlEYSMrn5GHMNftFnsrDlyQVbp2xQ&oe=6A9EC304"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOM8MYbwir8Q7kNvwGBlR7k&_nc_oc=Adom4ZnijbIyEUIw34vwTs-2Gtx7vg7QnP-dXe0Ul2cHafaI4O_7Pznfsh1_dbGlDek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoj4O5Bubf5x3k0IKoTtEe9sZ5rP5Iq8wB_WjrVeuYhg&oe=6A9ED1F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
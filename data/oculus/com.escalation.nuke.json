=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmvSam0si5IQ7kNvwEju5gD&_nc_oc=AdoLyDqgqW7rKY3NZKAcF50zRHNVfHfcXMnVwIA6fxRpGQO9cGJ2s-bGBUpMsSZcNlM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcpa1oPJzkGCEQV8rH92yo9HhOWKY6H-gxfsVTqpuDNA&oe=6A8839D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH3zaNkkMSwQ7kNvwGLNZ-5&_nc_oc=Adp19rjjw1b7FTc6gL8NWtRONem5VHt6oIuhyzrSxo6_nprDyUpHJ3cIVSRG61CsWww&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaQn7yRDXTdzEyLebrllH1EcOrhqQo3ojnbU7JOFJSGg&oe=6A884ED8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etRmBqghtAAQ7kNvwFdf8VW&_nc_oc=Ado6HlPb3a9U5u47b0YSDf7d7L0YTfzqP3QclUwe1N5Om29ZK8pfJrn9358tI7LzLZE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXFtOS_Scxg8nic_dyeozxFRB8vo-Ht4DTQ6a-DjLAhg&oe=6A8820B6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG9WqGe37fMQ7kNvwGr5dld&_nc_oc=AdpQF0Z35dLyruY8vkEm1NFMrtl3_6WKNWoKwjMg9a9FL7gn3PtYFEdb3BC0JHqq75k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0a8vKFH5TvxRXNyNjrWsyMy0bHQdqfvYKJgMd34Z5Rg&oe=6A882144"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY2xUSS1KP0Q7kNvwHf5osR&_nc_oc=Ado9CP4K-QOCkDT6H7STd7_iNN3sBAiZ9WqXD_OZuSvQRGhxmMxakjsMRuaruxy1oBM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElBynviHan3pCGdRBMYuY9Sdpj8EnVu4nL6h_8p7_Kog&oe=6A883036"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
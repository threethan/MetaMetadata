=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWt7q5qOiJoQ7kNvwHEXEpV&_nc_oc=AdpT3SzY96gS0NJuAJf9Cv1szFCxcvyD2BGM7G4-BbblSJBmC6GNTqEZz7IJz-4PM1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rm---Icyl6qkodgPi-oUxNhxfvUhzu7lEnw192jvXOQ&oe=6A259192"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1CKWTbPhD0Q7kNvwGty1qg&_nc_oc=Adq6hNJ6CmTH8AjAV1cJN_9iLwEtg-KsnEtj7R1Z_rmxo1aM0lQVhbg4pDqzbfmkdKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sg2Y_qacbxpJo7XJcpqRaDP8kPynWa8YAx9MdaW3W_Q&oe=6A256E58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os-jrct42dIQ7kNvwHTKI0A&_nc_oc=AdpWmVPOFsYpFUjbevUa68oEP8p_EZDqekclu4rV7CLrt1bYw_HdI57Ff-3zWMmEYVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pWNXBbVxMRkEjDsZIBNo8WCaqIYRB3ZG7lHGL-6GqKw&oe=6A257876"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBzL8zidf98Q7kNvwHZYIVZ&_nc_oc=AdqPAErVDt-ceRPO6PTXxz8303TC1g6tKJvX7r_dnGJQCYxTqsyqSS_02DWda8HaKn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wlrtluFIWlQT3KzgAiQPm-iqTXogFmDTNZzr6VlXgNQ&oe=6A257904"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URLGaafnfrcQ7kNvwFB6K_v&_nc_oc=Adr4Ehs46Y-Hom1p_HY7KQYF46QaHZdkGyiq8FQaJy1mo9xY3ivw6viZMvh15lfGABs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PIAwhOScZyeTp8W4MnjwZdUMohDCsWCBJlK1xBIRiOg&oe=6A2587F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuIbE_MweZAQ7kNvwHQhJtc&_nc_oc=AdogzCfLTvJdnaE2kmBjM6cSDfNr4FY_Y9_4A1hbOdCoMk6edvZWI5UzE-wtQBBEaWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsc75oTZA9STTIMFuRRP7CipUPgkb0ZlawMiy5n0rmjw&oe=6ABD2E12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-bcSv1bjhsQ7kNvwGOzH2k&_nc_oc=Ado7txBnSfjR7rTQR0ZXuUB58m7wwCjG8RisnkjYtWgB3AAaAPbOgg7ifRSY8w6Tnak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR4IRJWVC-8vqOLHQ901eQvQfCXBziPoK7LlPUWyiVeg&oe=6ABD0AD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjbM4Sp0kOoQ7kNvwFs-9T6&_nc_oc=AdoiSP7G6AXIOOmDGStfv74yr7bqJxbdaedPmHrzAaDsWsE5J2tNNpwz4l1xSCwRQ24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYwDqcyWua_dGWufirhS5IKkFlsUmW6sPmeN-Uwpo_CQ&oe=6ABD14F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjuF5dBeib8Q7kNvwEmXvAw&_nc_oc=Adqd_7NsMuO82Jr0ukCKQT-xmPjr7Kl9vgXfX7z8FmUvoc2c_sqD9gazyJo2i1631Z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1oG8zZC-bsLI3K5QS4CyT6DvDujNrDO4PA8iRR4zoKQ&oe=6ABD1584"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCTh3KE_O7gQ7kNvwGXnBZL&_nc_oc=AdrID58bAzV_UYTIZ4URFyh0OM8KACD7YzLOwCLwQofhIe0CKGHqtptzRZPFopJubeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS4T85_UfmAsspJg4WSegPhpnPGQLrsntVGpHKwp86Tg&oe=6ABD2476"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
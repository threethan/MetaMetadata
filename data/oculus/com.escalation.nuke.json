=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udqgCaijlFkQ7kNvwFj8tNF&_nc_oc=AdoFC_jELXJS-c4ne__JstHi0NS03PiTqvdbaoEdadoPjX2jaf9PCh1FaNq3T0NOpPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmGMeiKpHxdVdnU4lgFEK5G8YlN6aVhzRd9uyRFD1Q5w&oe=6A984412"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6GXBczq3VEQ7kNvwG5M_DR&_nc_oc=AdpnNQDlzM-nlArsdHrDKIhISjj-4V-YenAKZJFFUErY410PKpV0yl6ySUO0OL10440&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN50pWR_THtbwUuOdmG2VRWyYQn5oaijSlP9VWYueuNg&oe=6A985918"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59-l-En4RyYQ7kNvwG6OTX7&_nc_oc=Adqy5J8_nTDO0eAA2l-FeWWfTuQ6s2h0pUMnLHZl6rv3FQ44_fOq2O84opXF95LsOlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf1jNC0Ap7Epim21yD3y8o040dUb9g38o_f_A56m2CEQ&oe=6A986336"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXcztlAls_4Q7kNvwGy4Bp3&_nc_oc=Adq2TtjAmrVtbrIRFXQNUxmHV92w9cZyyV-nrazOKZLn5eJVPNfYZmHh4nKMn9GOR5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWQLVOZrwRDNtOx74esDo2FOOQYPjQp70x1vwMOtzGAg&oe=6A9863C4"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8rOUZ9uzFoQ7kNvwG3H3G8&_nc_oc=Adpw32wKK_QGBPU_b3tCcLiSRWKJ1T9kfBB7Ax5iS5_EqzIzQ9elBLMUr_4b0TIlJ3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3Y3N20OsClD9dZUyMcTKHAuW2O7AuH6VrNaHP292RIA&oe=6A983A76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1h1Tqtwr_kQ7kNvwExastY&_nc_oc=AdobtWCpBCHFZ46xrMTA0aRpcC0TjQcrzAxgAe31Jms-Yss5O9nYI7-j1OkKSkT9_Bw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG3p_qIp6tfjaG6Pfa1IP6ZtDuwMvLROj-o06Q85ibkw&oe=6A8ADCD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWWsE1DNvfsQ7kNvwHVJrQ8&_nc_oc=Adr6b54MVYYfYI4rt7KXS5NrShSf-94zIba9KyWVtG_mr8hRubQ_40CAPpl8dLMH7Nc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4WYPLFkQiWWIEavGPgPckqSu0FFj5fSSs7dBsXPJYyg&oe=6A8AF1D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etRmBqghtAAQ7kNvwGN0DY5&_nc_oc=Adro4aVfxkSqqZ2aHXNeOUC1nO6dSTuCogqLSgSxwSyGFVsbbgfaASLoTL1AqtV_E3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyFRoOJaEQNi4k5FOtQWdtj1EV9pkSVo2or6He9LjpCg&oe=6A8AC3B6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7R-yVJkjAUQ7kNvwE_anjw&_nc_oc=AdoYSt6AkFMZ0uZFBr7rD1YbGsIJO_yUentlCpGxXrVQTZzAS37JIGdWfgN9ep1YjlE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWaVzlhkBxf1Rtxwr0AFmxLIjFK6yHqYt5DycMAbs92Q&oe=6A8AC444"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY2xUSS1KP0Q7kNvwEA1Iie&_nc_oc=AdoBb6GMLYt0LqQW2GkStwylktzVmWlEouOHnvluWqmy91oIINTKcSkYQCW5mrG8bF0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8T5zz3rzUQdE9QCGrd413p3fWNAMxUXR0TIgl9TAGJw&oe=6A8AD336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNjJP2r4mDAQ7kNvwEiTKJU&_nc_oc=Adq7ULPQQSDioQ3CXsGaOWw6no_58el6T5Wl09g3MU9bt3r5BCGTZBvWjEqudtKrH6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24-SIW2nGXymSzY0_47Mh9IDvaU3hm5t6UA_zDuZUtUg&oe=69D63F52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulyJ-0PDza4Q7kNvwH4BqnN&_nc_oc=Adqg4ViyliW1dJ-TEwyhXcIv22cXcUpOVKqbi8eld2LWOeAS0ovEwNMFnQ7wSF-C2kU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vaKuGgayTbEUhRo4dMNJER4ncklGdG5j33nsEU4H_Tg&oe=69D65458"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hxz2hl1adIQ7kNvwEQVdpa&_nc_oc=Adqvm33qEA3Mc_pWZwTzQv6IV5Yx8ZN6SiwF0fglp_dKF7Km6Cp1huSH_FObwakRZz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AUy_Mkm_BZydwCTrlJOxGwPsm-HSRQPGCOUCc1ZBFoA&oe=69D65E76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu7hrwV-xqIQ7kNvwG32ZHC&_nc_oc=Adr0Ha0vTdDGTZghh_2SxVlk7z-XaWkZStyl__rMOmI9BxiVOkC9gOPTS4w7CY6U3ec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HU3LcwptiHsd9NhNUk2jJEWHn9XkNSvoU26Y-yooiaw&oe=69D65F04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2qZLLv2UMYQ7kNvwFtQJtN&_nc_oc=AdpBd92HBVLk6mC54DhxTaJ5MjZF3N4Zh6SaacgL_KKMhGgz9t5wmQjee1UXi8j-BwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XPT0FYbatQw4kvrDuj-tDmdwVKy2bFjNN4O4rSi39pA&oe=69D635B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
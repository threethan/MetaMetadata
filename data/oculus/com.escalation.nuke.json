=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNjJP2r4mDAQ7kNvwFS0zxg&_nc_oc=AdqVG9E7oCwqEgSaX07tq7Es-NGzofddQu-YjMVc49QWBWnNepEIqQB-4ElPHwlzsRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16-1bxZpzejT-YFTLj00TbVP9HN24dE-q2Df5mblMciw&oe=69D4EDD2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulyJ-0PDza4Q7kNvwEogTrO&_nc_oc=AdresMltbRLlpi8miHudjVO23F89-hHEPXcU8IG94ZLk2he5gSvV4iIMyD-ehgOR-f8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zFK6vlvMnbPGWzoy-CFDoNQPqOJiIiChKeApXI4ut1w&oe=69D502D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKK1FA0C7wMQ7kNvwFE3PCZ&_nc_oc=AdrYO9frwyn2-L5EKqVE2hMu_Z6__t6OkP8PCqoIapRBzNiUIQzyEGrrIDsdEFa4Trc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yhORhtGuGQQT1SdH7PllyhI5nSOIg-LO94bTPc3_YKQ&oe=69D50CF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu7hrwV-xqIQ7kNvwGHFLVI&_nc_oc=AdrKpf9VOvapH9GPR8Q_OzmcgGUYxiY5TlWGxOvN4aVt4rbZ5I_p4HTCcic0ipOT0_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e7lW3BhbruoGR_HByHMAbT0-SMkeeakMMFgBEk3m-qw&oe=69D50D84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2qZLLv2UMYQ7kNvwF8HINc&_nc_oc=AdpYUW60q61px3CMtBiBqJNyBB5I1vy4-49CIIVmOd04kAe2qXGQ2X5QsVLkPV6zhFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vO2QpNllZF2LARPnhZlg16gpyETZfcA2CIVQDrHJxOg&oe=69D4E436"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAKbtzUeAkkQ7kNvwH-23nG&_nc_oc=AdpUXRGzJkMfARvxAPGki-CkjrozukB06bSOdZa-AuP-EGjTGDm7-pR4Npkjvhkv5og&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p6sqcpkU7AOHAj1KHjAz-Eyh_09S1CwYHwO_SLO2I9w&oe=6A32C092"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsUA_R85DpAQ7kNvwFZoLUW&_nc_oc=AdoMOLwX1OxMDwdziPoKEYubzeoa59sjNw28aTpu2amG0xCGTqVByQyhxkGgi3PFdBs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gw_klq1Qu-QGZ6OkBb5zYVAUEqBVxUVXJy_UHqeHDvw&oe=6A329D58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPIDBFkyvWUQ7kNvwFdlJO4&_nc_oc=AdqHs0aFgUF_ilAeR6zQPt5_ym8rOAAOXkWX-P_bsrApseAKNRbtktgXn-R1tuM6gok&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9aMrfB88ZM3nANpV0o6a-gc9DTdCEsZ54bIqv-ZApPw&oe=6A32A776"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG3rnev2Ec4Q7kNvwHf8QvL&_nc_oc=AdoNY8scXmR6YzULwQtbuNdXASk-4IB3b5CrCZRKCZ_lYOGpoaQG-VeEdD_LjWDDuwM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zuDrH_IGB5KPZc9J7SBmx8Hpd-n-fDh1EnfjlnH-rYQ&oe=6A32A804"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9lEtF6zYhIQ7kNvwG_0QiG&_nc_oc=AdqUjWa2YsDPHCttewpEnTpHBC-PpuXOTQGMBFr67Cpl-gsZdFfeIYVKmKG-QT4XFAk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97JSVFssEME5I1bS_nkGxunGBsbGA29Hi1PdHsmR75Tw&oe=6A32B6F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
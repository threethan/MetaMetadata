=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75F9wUmZo3sQ7kNvwH-35YF&_nc_oc=AdpqyR0Oe2TW_PvKTArtWzptdli4ya1s7xWorlvoIkYQ3OPCBBTaLKEDxxJSLfpH6Io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPh-SCy5SyXsuKALyIa3AYXJCrynXgJvvUNW5nJnVB2Q&oe=6A4BCD12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTQEAWnfWs4Q7kNvwEE5HpG&_nc_oc=AdofOgGDzSpEZAZJinWzSfWPE5dSvhQO6n7RrJNIHmg1KWWW0R3v9z8siQYKL0xB4aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA846DxtojPNqi84pPuz5y7fjUf5GgpWiNotuMNhJfJCg&oe=6A4BA9D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8bbNnV-gxEQ7kNvwFplOKQ&_nc_oc=Adrl160gFpUciQ5yODrCZN3Obqh3f98RuKWPSNX4izflZBVSrbfThSK9jef98j6cd30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqdYsAgW6Ls1rSUK_t2hXyyS3SnH1aJbVHZ_Yb5yp4mQ&oe=6A4BB3F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-yVWkQsBEkQ7kNvwGvJWfB&_nc_oc=AdoWubPYhRhDzjeieSWIr2hMrbWAwei97RGG4d3hewxPs6vQidAm4AbdcIvpIZNfOEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTNIcxOljgIbzUFcBHSyl3F5KHScqf17gUy8SQOmt-sw&oe=6A4BB484"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9Wuswd7z7QQ7kNvwHjfPqN&_nc_oc=Ado6S6y5u8lBcmiVy0TEhsTV7jAj-2zce-URdZu48B_Z5d3ns2aN9NSe5FXt8g7lamc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo_uR_jDUsclv1-wGQ05yZfoYT5hJ7_zyzag-xJZivGQ&oe=6A4BC376"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9nxNeY6xYAQ7kNvwECi26X&_nc_oc=Adohfg4TITWXbY0wvFC-2D91CW0C0koYOUl61iOUuc4QTUNDIqvGZF_-HihSi98lnzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEMj0BUwKycTqdITg505zus2SxnJaPttAaF9ipzZ-8xQ&oe=6A844552"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz_eDTuEgUUQ7kNvwH4CEjV&_nc_oc=AdrtXqx0XbkYs_MXqHrmuCH_shWaGdjk_a0hDMTftduGWeqxFZyDO93VmXsmVP3vqrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGajQsqZQ9drtMVNu8EDvBB9_egxqfJPM5wyqSalXbyJw&oe=6A845A58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EOpImXE9xsQ7kNvwFO2fGG&_nc_oc=Ado7dhd5F5dPv8B1kRudb7kjjtiDz7OdW89uvgvhHbCXn-Jschds03kcExmTYV9Tgps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEmAxAwsY0WY_OQ1pZk3HvlwPGqDZOdBtYA8RWyQ-Yag&oe=6A846476"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1LuQniZwZUQ7kNvwGRx-Qq&_nc_oc=AdrxuKhWjvvLe67whMV_SObBqcHy8AM_hdfBKWqryFuowVDlelBfuI8T1x21wzizdwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWMNF9BwvyqBn5Iri3WqVIjiQ46uAKORr9l4gTUkz4aw&oe=6A846504"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q995Yp334r8Q7kNvwFbjXlO&_nc_oc=Adp-8kBUxzOQTApZuoGfcFZK0pA2lax1Sv5DvUmBhGgs28ZCAFIWZ2cgHREBG_7-koU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAK7gz9_TBZp8VDFVqQFChzC15sTA2-JTtYAX0vCbE1A&oe=6A843BB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
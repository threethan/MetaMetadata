=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaEb4SArI4gQ7kNvwEVf7-e&_nc_oc=AdoDs7vRRfF79gbKcPRZ52eEGKd63P9Oepb81LuLN03ILyP_ekgL0LgBhBk82cv09Rk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j5Z4VWXV-EWWdoYXQV1AiAA11pkr9UQBo-Flu0QvUjA&oe=69D790D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulyJ-0PDza4Q7kNvwHzfxnp&_nc_oc=Ado0iLQOPM6ZEA7C6cbPUEUuIVKkhMMbQubkTpnTtWmbhS35ViQ6mRnBjbBXEU-pvKs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aGR-WZFF6aA-EFubad_qo8UrSScZH6PA_qAGa2tOT2Q&oe=69D7A5D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hxz2hl1adIQ7kNvwFBFaDF&_nc_oc=Ado_kPc6ZN3t2ahlu_if5fOX6Ju68_s5Kjr7uTplNpxpwkt6eAyDaf5lBZ5od59pIJc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07-tMQ8gsHfO-N6cAI6l7s_J118Wyh8sxVwkA3Cd2ilw&oe=69D7AFF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zMzJHCO66sQ7kNvwF0IP2q&_nc_oc=Adr8Ga5wlFB8U75izV4-navbDQ7Tm15P6pF6kSJnZcCqAg0bc7C1WqulC5IytbLgWOg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qa9xwTK1AcFPRvmTjmBHi_uLFztjrub2rJVEyH_uMmg&oe=69D7B084"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2qZLLv2UMYQ7kNvwGrHqf3&_nc_oc=Adq8Ozvwcq1OAmYGNufpdwajN6BC9r7nfbxSX2uuJkHnqv8nVx9h-7CibhJTpw74K3k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MgDyanqSvrt2_3nUcpU7wtIIrrgWSAon6Zif3QZwVWA&oe=69D78736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
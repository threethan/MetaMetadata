=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-xu_OAS6aEQ7kNvwHQzZbL&_nc_oc=AdqtgLIYU93VDWQ2Oge3r7L6XFPe1TGHS3AcrOEX2VtrzIM-niBE63_ggYLoMVQMSPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B5umTCEyzOiLsEUtT_-wZUfISY5fjtTuCG0TKxY6MWw&oe=6A2AD792"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxxUIecqS38Q7kNvwFvF1M4&_nc_oc=AdoidHEJKpK_wjV0_BnXzB8IGy_XIk567X9UzQDdSIlEYGKuhRcjRJ1hJf8sM59w2vU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WdHdYsfwvZdoR1t8RhLi7Nu0nFLKfp2tTkKdQ43kVSA&oe=6A2AB458"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0hA-Mp-UQgQ7kNvwGjX-gB&_nc_oc=AdpDN29dwp5R66n90TRAxJ_wqaugOqnDURSNDo0_6eyCJDagcyf0taCNJuhMQhHVmpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80_3YMRwEsNgh2t5dRZF331sENlmmpNYtv6ex4_SwJQA&oe=6A2ABE76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1WzS1amVfQQ7kNvwEpJfZe&_nc_oc=Adr9UrK4L-AnCgf3gdb3dTrAPYJEbo-hWnCi_xux90VPnrQIHQU48SgyVz1Iu-rHz3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eIT30jyv-uRM72JRkMbsNjIc2sRcQKsb-qJ-d1oaa1w&oe=6A2ABF04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2E_aaYEQz0Q7kNvwHdDfcv&_nc_oc=Adrg6MVyNf0iYL1iGXaVWc89hTmEdkKIGeNmTzQqyM5r-HFJSiulhOLv_J6_EAITETM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KO27sWSB01yqRftQA3rHffsa03yvTWG4plGmTB-ynGw&oe=6A2ACDF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcvzdFQEarcQ7kNvwHJyTm5&_nc_oc=Ado1AZZ-qejbSwqtx74EqH_35e4AzJjNqE44RCWP138k6T444pjzb-sOSpTwiKjox2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7igrPunjWxz-s1XwFwaU0oNIDZTuN99ZNPewSDQTnLLA&oe=69FB2952"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1SyF-uGkAEQ7kNvwHDsMcl&_nc_oc=AdoNjRTUCpftcoCnI920z9M4D3GNN7lam8AqKusXvE7SbTEkrwK3a1tSAn3oYVp5hJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6auW7G18vg1jkrJ9f4ZAipTMkWojhbpQRmldpLX7ul6w&oe=69FB3E58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEKAdZNREJUQ7kNvwGjUrp0&_nc_oc=AdrXfXHbJEM7OErVDZsR7Lqp8GfzlVd3aMffBrL7ri_wWd_e3gV2LOhfr_byGdok2Ws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bV7lcvXssfn9NA18UW6tMUESNehsUwQMYtuZZZaGFVg&oe=69FB4876"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCtE3Bn2jPYQ7kNvwE5aY0m&_nc_oc=AdpO7zyK22c9a-wWIcVzbLaexO58kHijEaPf2sr52iIrZ0YFq7zevY5L80vWFSN1W9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VK7F0He_ajXl2gpX-tnj_sq-Yw8AOhSVskElUf9rxig&oe=69FB4904"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft2a5Lsn97YQ7kNvwFoB1Uj&_nc_oc=AdoDUOFpEriPZQPjF-b1J5sBrPEOTeWn-e2nHymT-1N9-3FN16Un4hs5YR_5g4dO4TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iFJtd4Eo99V2w7n2DttZ-lHHb92w1l2eqCBuuuUIBEA&oe=69FB57F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
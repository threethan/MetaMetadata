=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5JMTvvVgJMQ7kNvwGbMGEK&_nc_oc=AdpX4lty0gmkTA6fZpGyP4qJI1VvVEbErMA_vf7zPPmCNMoubIhhc9tFRvGkZxULBKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af843T6x57NCNBd3lUdbSSoo7pWf6C0afXyTugJEqzeLsQ&oe=6A316F12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsUA_R85DpAQ7kNvwEXtTnZ&_nc_oc=Adq8JmayHpm0K84A8FwUh28NhX6A7UcD9JhiLzd-hjx7sf0Xw0cuk9meoxF-aX5cx4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CvXCca4yj74oNf3hl_NkwTt94HLJbrWTQCk4MCqtJQw&oe=6A314BD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPIDBFkyvWUQ7kNvwENnosh&_nc_oc=AdptJ8J2dVj14oElbx61DyYHQ4BMeiP15Owg32uwUX_XdLRMSGqfyS4AbAJrWDVubG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_RA3MXKmwen_lqiGNH5H93au7_hx6ZSto9ezJYxhsRw&oe=6A3155F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kkRIduQ05cQ7kNvwERQR4R&_nc_oc=AdoiN3NoFDj5vBj32X3ivc4_6PTwuDSQL3wTBJBOjGD0SrvL35RwSu4CfGEcliCJvsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AJ9nHf3zmzfBCXVq-ohLLPBXqkl65Lsx2EU3fJNIcKg&oe=6A315684"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9lEtF6zYhIQ7kNvwHnui1A&_nc_oc=AdpPPJ9jnkwvWV0SoZ0S09xYbJsoeR1Y1qn4TvmjDjXrurSohoqO18u7TqI-DNUp4us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p47jlOTYYScjY9UWXpXUjQlFuawI5U5Krot4sRCsQCA&oe=6A316576"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
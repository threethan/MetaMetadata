=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejBEA5-EI7oQ7kNvwHBGQhn&_nc_oc=AdrV2qMFu4Lt6ATHb2Tlg0OvRCQLKL0AOTnQxyHnz-Mp7My4wES-C9hxItwRElSiu3c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJXYPAzCOt6RHcDOYAeyuJ_8GfJ1RNDD2EtQeVLFrJMA&oe=6A526492"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpeL8ys7VLsQ7kNvwE38CjB&_nc_oc=Ado_QwkuxqZL7TKGjAbF_Kqyvjv2nAZHBD2oB0AIP1DdfIWvaWKohrb86RJ5Woyn1jM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEQBqVKN4Ca2PTkh8iKjeARMDSvr_NrferjQE0RwGPhg&oe=6A524158"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja1YRmDzhAgQ7kNvwFRnNZC&_nc_oc=AdqotE__mqXVE2KzqUjDyeS-gjw5QaIFcerFK8pil5S67MP4RiRrZVsgQ1EZqEKIEV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdyYadSSNK9uW79kPF2EUzLIOgwI-RgJb9MFBI2dWBvQ&oe=6A524B76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCIadfdWWrAQ7kNvwEcmFFA&_nc_oc=Adq_iL3LoHqbx6b7GN5r1ScXUxfJcMtGZE-9xJq6TR00qYhBCr-g6MkJ_Sfs-elKdqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTUBy13dZeXOYzvibHc2OFHCzcxOjH53Ktq9EW65iudg&oe=6A524C04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbGyDk1q4GoQ7kNvwE8w15U&_nc_oc=Adrvd2gbe_PlmDued6vEdIsNJTrPiVa8OqB6-Ea8teoXZ-wX4YEhwwUzY56sz4YaacU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjvsf6aQuU81otC4qSqmBJQ7qj1K04cjhnA9RYf04DyA&oe=6A525AF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52thUw0F9GkQ7kNvwF1iXdE&_nc_oc=AdpkusHcOnaT8b5PdB6EHzIvUV9Mf_znbHYRaRW7ILiaslgLjIGjCvnNR_UhbKaPojs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMAifmALFL6F57WU_RFUrT-3T7v6icWgKYHGWkWuNWSg&oe=6AE8AF92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-IgaeCdVeUQ7kNvwFXCJC7&_nc_oc=Adr31De5-Okc0d3UOFOMzfmOT4OslOKROIfAcCf2oO4GR4KVcj42rDqgPok4pTQhtXA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNoIy1nQELvAuwdZ0jEMoMoRHoyLir5PtFBXXhRMbcQg&oe=6AE8C498"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMQNDdgI6vEQ7kNvwH2Vpul&_nc_oc=Adq0ZazGjzxiXZywYqE-i--Fo1HwJTXU8-2sw0X4D0GjDH_5dnRCPotA_Y6Fion9QL4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiWjLMPa9emv8ctFQTUkA25eSJ4t-1MrMtnzor5z9URg&oe=6AE89676"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcURQUpW4GIQ7kNvwHM33gu&_nc_oc=AdqNMKBS_QkXpTw16z5vnNxDHjV9hESsBVEup9ZqMQ9_vKjAVz1VKHcknLttGNerh3g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjvIvoLXYfsFdozVwAXJK93tQ-tMpsgaaVUvDZR0XfFw&oe=6AE89704"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3OWbn3FgDYQ7kNvwFTgZPT&_nc_oc=AdockAciJo0G75Uo9NWmkaw-y2VqGOQRp6-N2b7qHcvq3aDdi96owbxrKoGFWQ7Eu-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVPLRQjXYgA3lc18BXe_VFDafuk9RuwRRXiMJcT3XgqQ&oe=6AE8A5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
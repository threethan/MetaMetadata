=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zL3Pmt5ab_cQ7kNvwEGg06j&_nc_oc=AdqsSmvdR_s4Kr2vBFDOH18cUMY3Kc38Icpdibb5rgximx5LSP-d8FMxljG1B-bvJ4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyUUthdtH9rGYUDNxtNyQ4h2zmFIzDEFfxnos7r6Qv8g&oe=6A6C8A52"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToyPTPBs160Q7kNvwEHfZdg&_nc_oc=AdpSFCBMt8XO-VTNdTS_ajwSK1hvjo3AyfXRMpHd6ltQlJhXUu3aaECzDsS6ThIL-2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD95KW-T8JEppumMa-GIXOY-a-aWV3MGBt825OHS8uS8g&oe=6A6C9F58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zeSMpEW_U4Q7kNvwFoUHaP&_nc_oc=AdriwRRymScVyq9XCWH-lV-C2vMPdPyTzbxYSz1RKWtq8zSAgxj9KsTiYx5JCYxIUL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCgY0c1jcHfGbeI3fsMMOtuBoxJncBGOT6jvmPefDrzA&oe=6A6CA976"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuE7Ywshv1QQ7kNvwGkEvSM&_nc_oc=AdpwEkmLy9fmDSCrvL64rIyapEpXWe5cRmudW2mYd05eql2JFMvjt21k6VEl4dzda8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQmLqmHYVYQNYpgmDoOnT8xZLngQ5LIuQUNK9PdgZhjw&oe=6A6CAA04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlPKTyDaRvkQ7kNvwEFNqNy&_nc_oc=AdqpkSEeE9FxC2Omm_aOvsLkgXunvclFeIhCaqYThJmcjm77sLkgtiU6mxhJGF27v8M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2H8IwGCfbuVGVcRp-3DLPt6nv49qLpc6pHRr-KK8sKg&oe=6A6CB8F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
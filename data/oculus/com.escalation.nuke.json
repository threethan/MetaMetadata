=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG1BUZHGpd0Q7kNvwHD2bv7&_nc_oc=AdrrnRcGT1sBSOtQ2DTsUmBaOO36bYEnELKAHcmTGhqzPpqEA7wuDFfOcMM1eG6WMvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd5FHlXMSjGstweEPcILhVCFLqKSdYVOCMzLKYd01FHw&oe=6A5A1552"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM0PnSI8exwQ7kNvwHXIcXq&_nc_oc=AdokAsmiWBZksmJ8JOpMW3YExeuZUfJv4-Guz6WCzp5fO6sJfzm0m6_XG5wixwBSjIw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-ZwZGdtL_wde4oj1EBVyJq26O3frXOHyIaSv2-41iIw&oe=6A5A2A58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN3V2h6XVBwQ7kNvwHJkv2f&_nc_oc=Adq_cnBLwTInMx28u1tqIbIkWRksfwtJv29UT65qwONVdSeszh0XF42NnBlCPSz1Q2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_qKM2MFz3jE7KNOALC86pe6c4a39OLO9ruKftUjNFJw&oe=6A5A3476"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivdo6Q9XgZIQ7kNvwFTpn0a&_nc_oc=AdpwXYSJDvRljTNaVRhtvtFgMulMcb5S75pvvIgeTuGhJHv8hnX0GlQL-LbBXsWua-w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZG5HQa0eKNIYUQ8BrvKkv8gC8C2TR0hE5nTPaQn9onQ&oe=6A5A3504"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7o6KChhobUQ7kNvwEQ71MQ&_nc_oc=AdoMY513zQczeCoJvvM7V6u364BfLb9Et-tddQxsMtvQXzoAWKm4tm9YcEjNd73MnX8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyPr2yrfx-ghwB-OE0zJUsm5KWFqkiFSOeJ8vk1p5qqg&oe=6A5A43F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
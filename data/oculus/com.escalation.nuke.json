=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvy5F1xyIFYQ7kNvwE1rU_k&_nc_oc=Adq7-mSIa9WaQ71Ej6HqDEMHHQZIlHZYeUX3LZ8apOTI0oxw9HmzCJIVXx6hj4O5zf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUhghUeaXtGNBZ54jRO7x_JXL3uJ8_9UU4zJ-6FAzWfQ&oe=6A5E09D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo0IlliXVq8Q7kNvwG2ZNU0&_nc_oc=Adp8onWMDLKLZP9kBAACVOTZREyULN7i2d-8RYZm918Q6QNCncXGCVsxQIaq-Q4kK24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9kkYtnIwELcGtHIb_LoDp7hgF6QRdLqLNTYv07uLwgA&oe=6A5E1ED8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVamPdFBd8QQ7kNvwFaVvQi&_nc_oc=AdoLcxPLc6oJbdWk3gJPW8cmHL-p_75C852-sllC2FA_qAORfatTFHeJF1SD4iwNUoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKaHL39iZynvvyHSxv6a70GgaoAnwah7FD0l8CozVxFg&oe=6A5E28F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saKyICZDZOwQ7kNvwGe5RHO&_nc_oc=AdqQQQUOO2i_SHQ7TbbvWauUujDQEj-rcdbETLGgoWnsqrCGaImBKLulepZLVGBlJJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPDBMY6vhO7WhPmgGS5tm6C7Lf7-X0jNxoLK-1oX0t6g&oe=6A5E2984"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RkAqyuqCGgQ7kNvwHAEHLL&_nc_oc=AdqypCw3gkXyTr_2r5UfTUtOH2zN0U4W0BEjlQJQ9p0sYoY38x6PQ6aykWesYPzamnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNeWbHbkBOyql_kOAdwNepD2kOuhXZ2j6gYdYnc_qLzg&oe=6A5E3876"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
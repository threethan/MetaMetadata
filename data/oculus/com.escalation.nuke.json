=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SndIqRG0YCwQ7kNvwHFZrwO&_nc_oc=AdoxVTPGiVum2GqvceY_kYGOpWOsqEuTLbb7LpwmZbnneTBWmzcmksIhpJTIX_aDovY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AaTeTw4FHeymAjSu4J2fmASdbJdqeC7F-CHZRuD7XBA&oe=6A0DD692"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9Nc5sqaDhoQ7kNvwFMo4NY&_nc_oc=AdorlP3TBDkHbbgHm3iEkmtNtHWbh_ad0LtA64S_lfV8jfN7dEO3PtXb1etml7shSSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dmI54euzSTLqDz1Yt-vQxTdwHEWdjTL8oDsjFR6xPeA&oe=6A0DB358"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GBXFdnkvjsQ7kNvwE5GV8w&_nc_oc=AdpXkSLYxFIJM8XeW2f0Ed2ocPB-Ogw0h8C1X8MJYugIU2FWkM_CfdAZS9fHKzuYBgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zJKgzLWRLjCNxvzPr1qOR69ElNxqf9pi5B4d76aeB8w&oe=6A0DBD76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDgseTH8VJgQ7kNvwHkc543&_nc_oc=Ado1L3_5n5Z0HYPnfMFT_uAhJl5dWvH3HII1ugo2_LzJRy3S1jXxXRjx623Tx3JO76k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65tKziUguG_x7vzYwiIyQ2yWXoDU9m-SRscI-m-aOnfg&oe=6A0DBE04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D34D3S_cSTAQ7kNvwE_HkOa&_nc_oc=AdoV1M63fgE7wJB3uryJ2jEVN2h28p8BBc4gB5mcC8Gx0Fgng9NpRUMXlWA-U7Xoxbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a2JgM3vjmlUP-IeAc9wPfz51jcQa6bPEefG5Pum8JeA&oe=6A0DCCF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
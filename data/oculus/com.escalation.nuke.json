=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHx6I0evRhUQ7kNvwHSH0lS&_nc_oc=Adrv2OSJOsyy2NK_PxpRHYnwKsmb3Ag8eo4ZkOPpc6SPXNb1yev0qbmKbRP1Mgs7dY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GtX0C66vcTfkT2OClpBlhy5oSNJa4oludwllreB3nqQ&oe=6A15BF92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKTXV6mpRasQ7kNvwEgq_xn&_nc_oc=AdpxQSq-wz3TdJww0LRc3hWe7MdrvuQurm9lGoeK5b2zmpkjRgAKdI13afAonJVYcBY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gi2EdZsmScWJrMM2SRz69x4xHLTcFXDAQq75nGQCF-g&oe=6A159C58"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRYu_eG1YPYQ7kNvwE737ic&_nc_oc=AdqI7yTJi4UBJeaZtoeuTpFfhbCQeg_c4oC6rAqrBzFI7r7Yv94sS9-HrIaDIUt1JUg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AqQ0DH1Mwt1P2i-Jnj8Ps_WUDSg1HTZ0mf9ENi4j38g&oe=6A15A676"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooGc2Y7LhPUQ7kNvwGxrWfW&_nc_oc=AdqvlUsR29MWYTrIo95fIVUuDRn3qEU7QPS8Z4rYHKwpFiVQkAMexMkG8kjT0n1eVDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Z0abiI7wY8PNCn-bZdykOtI3ZDMb_c9p3K3qm8A2xw&oe=6A15A704"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0rLy7hYhO4Q7kNvwHHxC7N&_nc_oc=Adp1tRjf9p-AaG5S9Q89dJeOLy2xiwGbDcO9sGqjpm0H-Elnw6NIF5AlmfHfGeu6cmk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r8FVORWa_u0grAeOAALGn7roLk5nYTCMe2Fssp4tiHg&oe=6A15B5F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
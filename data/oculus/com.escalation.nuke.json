=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOk9QjgtOXoQ7kNvwFCNhz0&_nc_oc=Adrw09iZ_iUkiLVCxlPLK4jky2MDunvjerwo-SoR1XI64FZSgROAXNmOyOVYQEnJ9bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ghl5f6hZDQ3zfk3XCvS27iG3xPWt1N2gPODJadIcOdw&oe=6A1EFA12"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ErU5HspCgwQ7kNvwHucJHx&_nc_oc=AdrEjrvN7phSIDgcG8uDrrASydWvZUuZqzj_5QhfmZt5UIFv8WUNP_XpPyQASzQD5n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af520-E6bHBHDsFDrh5J2FCsiXxGUamGJlheAejy_M9QgQ&oe=6A1ED6D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB8AGwzTjLEQ7kNvwHLLP2d&_nc_oc=AdpSzw02lJo8MPt6LksUNtEF6uKksuhv9GoBt9WoDee1urf69qP0b9_y9NChNG4Cg0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xrq-1fs6f8QaIs-qE-yKY5Qw7vXKqBZiQGOfxSA0Sbg&oe=6A1EE0F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42XgnBSWNxMQ7kNvwEvbXNm&_nc_oc=AdrZQMhqs9AOMAB0fNChu_3HyrXEGOk7NO3hm-stPryQWnXjNvhnjf6sNl5MiXOnItA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xkr1ODRC4CTZVR74-26r8QOVRbVBT7B8bRHf4XxlH2Q&oe=6A1EE184"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fc1v4_eQiUQ7kNvwHDoFdv&_nc_oc=AdpZ0RCmt4llzkhAx7sFKdhWjVIPZhlBCc1xlhiMtVdVqQL0K5yBYjOVTCRsdHExU2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eWSO3HBaj3JLVErQoh4ocLmMG41l9IPiEd8Mj2u6U0Q&oe=6A1EF076"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
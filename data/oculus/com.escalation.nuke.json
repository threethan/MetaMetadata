=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-wbA7NQKQgQ7kNvwH8-s2Y&_nc_oc=AdrHDh20nSaa_W3qmgFopy_7weeliLx8XK7gfOP6rBmkEjdvcQI9ZFKTO4QFUGoSkYo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rVN5c1Wmad99qCLAcWzmX4k4U9-QN12gefFJNE-lPiQ&oe=6A0F2812"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9Nc5sqaDhoQ7kNvwFIo1VO&_nc_oc=AdqM_GaPmFwF6LNKHmxmMuhljxqU5xVq8sPyin-boLcshUj5in9OYV80_16e0gR0Xps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qYxRzOgqHxv6Zv9WLKxlqNbLT5WENUClIuPrntgJyLQ&oe=6A0F04D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GBXFdnkvjsQ7kNvwHqzU49&_nc_oc=AdrXB-ioXMPJo_-MGTETLHzZYMNlqSZQpNvJrQ3fb0n1Hf4J_F1Q_kmjgCLsVMbWfNI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tsskvKpNtW7OKJ2byHWosikLAkkuqK7niRWBqF5h7Fg&oe=6A0F0EF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80kAiIbNq4gQ7kNvwGfKdas&_nc_oc=AdrwsexsZ9F0_ResxTcX2v1F2r_HDlkTJc1w3JFC3LjFEeVKtKZRYhqun1DASXV8oJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xZUq59ispMU9koNS7DhME1PogtW_K9Ua5rO47X42LDw&oe=6A0F0F84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D34D3S_cSTAQ7kNvwFjR6k0&_nc_oc=AdrrI_sg1UZiAexpQrUQ1aYEKz6f5koI1kJ9NhWWzx4qpKSA-XeQ-U84YPKATe39T4E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lBrGlO83MAQ5NGoDk02o_gMSVyg629FM9g3fN8SMjIg&oe=6A0F1E76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
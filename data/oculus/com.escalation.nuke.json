=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptsNoYuVeFoQ7kNvwEIMAS9&_nc_oc=AdrNleh3uwQeyFEpkVaLE7_N5fS6n9aUDcNEE7MpRLEWQj5zBDJ0j8pelf-x1TVkL8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2qYQj674OJ7ASoPV2DC13SIvNgj5t7CyIEV43BxUcXg&oe=6AE60C92"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-IgaeCdVeUQ7kNvwGRMWm1&_nc_oc=Adqas7ZCrIPZ_w8fzlHPVc7UTF5oRkUEqS26t56SWQkKEozx-6Oo4KiO4p5_MlXeB48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdkwJMZSPY1P-bCrzka5zxNnm36zX1JRFQtorH_Ry1LA&oe=6AE5E958"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQDHibRANcMQ7kNvwEBq5g4&_nc_oc=AdpoBkY37Qrf-yYdmChuInAWs_kq6XllxwILuKn_2ARPQenmVh3Jf-lgYDgaeGQUFMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqEv6r133XJnNfR6kg624Ai936tze6jazf1TJJyPUudA&oe=6AE5F376"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oReIVC8jN6UQ7kNvwG07WGX&_nc_oc=Adrl9h4ZaH5nZeEM58KF8oeZ3nDRNnB6uytqC8wz-D-pBSldt_qPcEhY7xY7rMs9MaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj5ItVhMbiSJ5jpNlBYRLGeMtNG15aSapcedwWi3q4vg&oe=6AE5F404"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3OWbn3FgDYQ7kNvwHh5YyX&_nc_oc=AdrVObAqsegyD_mCmscnbDKEpO1nM0CGh0iKiWR5shnGxxJ_rNhCS6dLNrA6xLvJYls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWQzDszR_yq0GxVbFjs2u3Xt_PWVEYfcAUt8aj--e5BQ&oe=6AE602F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
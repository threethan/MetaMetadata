=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxaSlSuLbZMQ7kNvwHu0loQ&_nc_oc=AdoTykiQf-WqgrV5PKMKvWk44dkCJ-GKiNNUh_TaegFgJiEk1kPhMUhiuA2z5udFf24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBpB00f3cJT1k_VyKzQCB4n2hCPWmrKKcWIbBmZY2HfA&oe=6ACFA312"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMmj3Ugsc-oQ7kNvwG5Usph&_nc_oc=AdqgaR3Gw48tCUfFp9vNbGTSwXEqEbFca9WQIv04hG52BH55pRVnir0vaAoTvd4qIoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9fTKD9scb107nqvWVvk6Hiawuo5iHZxxSBDnKtnz2Og&oe=6ACF7FD8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhB-qxZ9rogQ7kNvwGiA2Zq&_nc_oc=AdqdX3Kgx2XPF8FOQuLBex8aYzaGEr2oFdmTi1lnmYtD_uxLXZhpe4hMOhyVm7quWp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7-VadoNSiXU-F3eKulZerZfmszGNe2R9RBWc1RnXlqg&oe=6ACF89F6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mnz0sCTKgFUQ7kNvwGRgA92&_nc_oc=Ado4JSVvdmPTMUhvlmNCU6iBIBn-tF1jYzhxeNHoIJFHLB0iuGO3YUCNi8AoENjHSCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSajSgBWW3d0NlZhHe-WPAGo04KlREVbXhxcUzDDfcxA&oe=6ACF8A84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQqMLoCXMSQQ7kNvwGtbeUb&_nc_oc=AdqyAJMPnjD7v0vhw78reoP3dkMGK5855UBCjwTS3QRo9IOWgR1JiBVAkMWHpWQvsSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVkZSUzCRaCd6364neJxhiN-iAkeu-J2EtJskZEEuD8g&oe=6ACF9976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
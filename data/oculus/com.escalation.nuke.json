=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SndIqRG0YCwQ7kNvwFzA8qj&_nc_oc=AdqAwHFwtXWVZDevrhR1hFmC1zzl92SU9RPkSD_4WTVTG_QSEyFvnY-De8M-RCE-xpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hBf3Y_xvFXVCNZvyzQyRZ5lZhOE-LYXUpFjwt0RUgAA&oe=6A0B3392"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPnNkh9sJLMQ7kNvwHOue40&_nc_oc=AdpzH72ci1W-AE4p_gu-twvyQw9YYML8R6tJqwoPhT2FMLYrlyH4zu_x-2aDcdoTThk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RdQwQHqZ7WPZ3bG9QuqufuYdJElK37TnNyYtQ4D-1Zg&oe=6A0B1058"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvS-ewpK1dMQ7kNvwHy4iQT&_nc_oc=AdoaVxq4JoSwwfeFMxKajNkLz5pSAj3RxSSrltWQm6T9ccPuWDlYLR_50nicVVGkcps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fmjq_K-VKDzDZEYucf1LNTljIXCIdQ0iomHKdE4hViw&oe=6A0B1A76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDgseTH8VJgQ7kNvwGy4spK&_nc_oc=Adq-4lVDQ3f6TlvtNUoO7Dfxg7GGNd4Epv-2u6aCnFWKq-ARm0GZVHLZD4pecRnbxy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aap5AS9p9ewmF4bTEycp1LZMiWXGgdow26-Sk8WxFmw&oe=6A0B1B04"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bez0evvKfX0Q7kNvwEpYHBS&_nc_oc=Adpn3mlRbcalC5nGjaNx-XfbYzfFl3fTlLeAdbyD51uSbIJKA0FrJ3gbypKJCPOrj3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z0k3iIqXbuasxrCfI_UV0NCG0Z5W-aDRptFqFB9crgQ&oe=6A0B29F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
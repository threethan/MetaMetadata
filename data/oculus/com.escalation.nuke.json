=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzRDhfaioT0Q7kNvwHFfHRL&_nc_oc=AdpacZcrjK3-zuNvnOgwtZfkkaJndW7sz8FUtg3T8_edk8aQL5iCdccW29yx2Mi_Avc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5CEpkxVr-AD_gHh44fpRtW0e8QmgCXwUU9rhce-crxg&oe=6A71D052"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tgVkWesTGsQ7kNvwH6bnaT&_nc_oc=AdoWhIFMMkkJzNoJU9PKShAIHoNfvSCqLsd7WiO4OWbzCx4aPzY9w4RnCPu_zyTVNqk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqi6BpbDpGXTglMB79-Xuwudr6yWXJu_66d_fpM3nTrg&oe=6A71E558"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LD33PisejMQ7kNvwHCbEC5&_nc_oc=AdoWb8f1Gd1gB4uky-LScCvACztpiO3WzS3qg9ZlMIu1SoukyHX0cktn_DuyybcauCA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFphmiuZfJuTo_C0aiAv97XsuH75r0PM5MMydobCRGECg&oe=6A71EF76"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kowy67eEFQEQ7kNvwGd1fu3&_nc_oc=AdrFTSUWqnQUACnmrfnfEqa44ZShuGArEDV2UJ6mzAaJQi3vnvF3sXjh8UIE7SNQA1c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTwaJg1bi4r1d-GGT0neq_bI5hawJOb4XUEQfNQaDKHQ&oe=6A71F004"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCYKvHcINwgQ7kNvwE3kV2f&_nc_oc=Adrh4vlAvVbuVWthZtrjHN_irXskTnpJ63XTjj26CFir-1On4x5ZJnu7zE4maLNSJck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4wmKTmc1FYzLoXnsr_-C6o7VaxQ7rOCg_nSZzSvkQpQ&oe=6A71FEF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
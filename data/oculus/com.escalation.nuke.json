=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_8HOqQHNEUQ7kNvwFVGOiw&_nc_oc=AdpT3d6B9J0fDmSvsEhWZ8jfgTztbylwvXI864GDLBL93Ug-VXhfwalQM-7BpukK_XA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5waBQE-xdRpWYaWlC5o3b0H4Z4rIy_3H7LQhuUSHSMAA&oe=6A01C0D2"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUiSVfhcmSYQ7kNvwFUkCyS&_nc_oc=AdrSYAzdYoomEJ_L1R3r62GHWKbEaYH3lGyDjYuF7oFO3wSYmT3e22TxYjWaZAUEt1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GUmxP7zMs3dfyYmi6Nww49i7JTsT385_2XL5FCkoHVw&oe=6A01D5D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZtJar5Mz9QQ7kNvwHJXdSX&_nc_oc=AdoKi-_-Xdc6jJa17ULAciucE9kxQ322j70jyIR-7ynWcrgZgKhGbmt5um5NssINrag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W8_YRKznkBaHoMgC0VGRK0lO1c_ZG1K7P6KwIxnsEpg&oe=6A01DFF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kh1-K7Ab_G0Q7kNvwFjZOVr&_nc_oc=Adr92t4V_ehuK1th6ePJBZsfrNeAPkDhUVQxKqGZl0G9xNMnibXnIF9MWOAaoTQFhn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jgtUquqLJEF797IrQd8xI56-jWxUiC65lBqbb_64ZXQ&oe=6A01E084"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJMF_E2qgzcQ7kNvwGFptVX&_nc_oc=AdoKPB1IkKPPUmHBi1_351zJfIQ0aZh-wIlCB99dU7HbbX1bb4ei05GcAccM0KKnG8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bWwLXKxsg_YXRpQfxsCA9f5PzkFudGurnRQp11g4SSw&oe=6A01EF76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
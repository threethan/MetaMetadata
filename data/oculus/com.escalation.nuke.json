=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDbIbrgKFd8Q7kNvwHUmHek&_nc_oc=Adowi7cbH1l6q1oEECe-lYSFUq-CbhTNCp_ei0vRC8h3r1gzSm7je2lsit0LRuNBNTY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjAeVHkMWVN7bgzLd44TtkIbrAQFjo89MCaj0gX-xf4w&oe=6A9AE712"}, {"file_name": "migrated_image.png", "id": "1111049075906178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680263_1032799206756019_1859891810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjKnjpjXsUAQ7kNvwF39gVL&_nc_oc=AdrNFR5xHh0-Ri-5CISH9dSXjOl6pP-d4JEh2puWuF2PGORjwVLbDJNsp5yPSoV9F7Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVXkYpBI65dyMryNFAnDkDbqhVy00euw7JGb8lTAiAsw&oe=6A9AC3D8"}, {"file_name": "migrated_image.png", "id": "867553247025943", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427718_240290853001186_415158866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59-l-En4RyYQ7kNvwFS9SPT&_nc_oc=AdpcZGxaL7X7VwkHZJEt_jVxtomLEtDKpMEGp1xUu6u8eCUQKE3Bu7A_VJeQDDNLI0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjghxKES7COIrb40Itq9MK_5BiQfB4BYx-j35lzzzXHw&oe=6A9ACDF6"}, {"file_name": "migrated_image.png", "id": "652651025492544", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410272_1222536501090589_591842894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFI-KrN2tmAQ7kNvwFU7ReN&_nc_oc=Adraeh5REWs_-hlih1Sp4cSQhj9-Y3_7lFIWmXwttL7cJxd_QUqJQl2aWn3neV5K-Zs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI76QubMhbEDG4Q9KIJgFbXmj83cgQ3ierK0GXEGrseIg&oe=6A9ACE84"}, {"file_name": "migrated_image.png", "id": "205264410725808", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12680283_613924178759681_699648469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0k8dNOcZqsQ7kNvwEC0tKZ&_nc_oc=AdpQqPO-TRViX7Q6z5qJnv-7_Z94nmggA7SeRlzJR0HUwADZGh42kxzgTsw_ybmlk_g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnQMri5b7Iy5xvrmtiqy6MuNLabDlFx8t90Eyw4zhv4A&oe=6A9ADD76"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Please, Don't Touch Anything", "keywords": ["PDTA", "puzzle", "indie", "pixel", "escape"], "long_description": "Please, Don\u2019t Touch Anything is a cryptic, brain-racking button-pushing simulation.\n\nCovering for a colleague who is taking a bathroom break, you find yourself in front of a mysterious panel which only component is a red button. And since you\u2019ve clearly been instructed not to touch anything, the only thing you want to do now is push that damn button. \n\nPush it and expect to be held liable for any unintended aftermath. And there will be many.\n\nScavenge the room for clues, tools and buttons to solve riddles and trigger wicked events rich with clever cultural references. You cannot begin to imagine how many mind blowing surprises such a deceptively simple console has for you.\n\n5 new puzzles have been created exclusively for this Oculus version. Players who already beat the original Please, Don't Touch Anything will be thrilled to discover overhauled versions of the already existing endings, which feature new ways to be solved as well as new endings tailored for VR.", "short_description": "A brain-racking game about bathroom breaks, screwdrivers and nuclear explosions."}]}, "developer_name": "Four Quarters, Escalation Studios, ForwardXP", "developer_privacy_policy_url": "http://www.forwardxp.com/legal", "developer_terms_of_service_url": "http://www.forwardxp.com/legal", "publisher_name": "ForwardXP", "support_website_url": "http://www.forwardxp.com/support", "website_url": "https://www.forwardxp.com/please-dont-touch-anything", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb":
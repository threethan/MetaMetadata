uluscdn.com&_nc_ss=7f20f&oh=00_AQFDvb4I2fAVBhMErHIJdo0GPJMtlSHGSrvkwkh0-Olezg&oe=6A8D97A2"}, {"file_name": "ss5.png", "id": "1225056619054089", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391926_1225056625720755_5180597935378176545_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-qtD4VWFQQQ7kNvwHvqxUG&_nc_oc=AdqNwMAmO_3HLndEPeTidKuMt0GupAsJ0uCqojgEn6DTaGMZXF9Ng8jUydhFf2zG_RE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1YarOuQUNld1M_o-W2xOQQYlTNHx3BVaYCzv_cVQ21w&oe=6A8D6D85"}, {"file_name": "ss2.png", "id": "1348181786542278", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391946_1348181793208944_8762724714042919453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ok7-9L3ecgQ7kNvwEZSIXL&_nc_oc=AdqBFJjczaD1XvWxfRMbhvJZfTRAHh6V8Fr14_EhSuwQhlNvh1Z3sdFgfVmmYKf0U2w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsOZ1i-9lS0lMF_L_mOIh6Sxf33UuBaz3jh3kIeuAG8A&oe=6A8D8C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-blue.png", "id": "487015384178913", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392010_487015387512246_5876064315367559226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4PyUgxksW4Q7kNvwEflI5N&_nc_oc=AdrC5KxbS7HXM75_aeTMcmm8E6wihapy0B2MIB_6TICwC-8oblp4NZbAzT3Xj0Upok0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbbQJZGpAiY5GLSsIkUy3wx9n-FC_wbvAKeirHveaBIg&oe=6A8D6E37"}, "display_name": "Aqua Strike", "keywords": ["racing", "boat", "water", "shooter", "combat"], "long_description": "Aqua Strike plunges you into the ultimate aquatic adventure where speed, strategy, and action collide. Compete in heart-pounding Race and Chase modes, conquer diverse challenges, and prove your mettle across thrilling watercourses.\n\nChoose from an array of boats and jet skis, each customizable to match your style and performance needs. Experience cutting-edge controls with a revolutionary virtual steering and bike-like handle featuring two-handed operation, delivering unmatched realism and precision.\n\nArm your vessel with an arsenal of weapons and guns to outmaneuver and outgun your rivals. Whether you're chasing glory or escaping danger, Aqua Strike delivers an adrenaline-fueled experience that will keep you hooked.", "short_description": "Aqua Strike takes you on a thrilling aquatic adventure with Race and Chase modes, exciting challenges, and customizable boats and jet skis. Master the game with realistic two-handed controls, featuring a virtual steering wheel and bike-like handle. Equip powerful weapons to outmaneuver and outgun opponents. Get ready for speed, action, and nonstop excitement!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddytroupe.github.io/games-github.io/tspp3.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": "https://maddytroupe.github.io/games-github.io/", "website_url": "https://maddytroupe.github.io/games-github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9216366545137249"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "3085436868261535"}, {"status": "PUBLISHED", "id": "1127592642351169"}, {"status": "PUBLISHED", "id": "1922635398692406"}, {"status": "PUBLISHED", "id": "13512570
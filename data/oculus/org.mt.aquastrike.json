d": "1225056619054089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391926_1225056625720755_5180597935378176545_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83ueSnZwkIIQ7kNvwHXtsPt&_nc_oc=AdpNfuoQbKm6P3e4lB0yhO-RHomGA8ARoFGMQVeXxCui7z6Wq6-W8zOOKLI--BVQJVY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3bpgwEM_q-ZAIJcA839AxXFLAjJ18kv93nnTj5sKMtHQ&oe=69F214C5"}, {"file_name": "ss2.png", "id": "1348181786542278", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391946_1348181793208944_8762724714042919453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIu9zURamuIQ7kNvwHwG2sm&_nc_oc=AdoCcuV5iB8G0bTvpjMB-Vssmc777jaSGZD3JtfS2tVYiQjdYnMXDRu0NKCaHPnXqag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1CGhxNirrbsQw8IjaKR4O2mD9s11lCUId46DBbdbZQRg&oe=69F1FB6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-blue.png", "id": "487015384178913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392010_487015387512246_5876064315367559226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjUe5MHdYgMQ7kNvwGC494g&_nc_oc=AdoEBcU2cAIva2kXhZ7oXeHbSLPoYdIuqitId3JFvJl196UvaXb4cikNwJgQoHyjtpE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3QqWx8mszcU3rKFXaJ_xpN3bQS6ErYJHQk5zpKiq3yTQ&oe=69F21577"}, "display_name": "Aqua Strike", "keywords": ["racing", "boat", "water", "shooter", "combat"], "long_description": "Aqua Strike plunges you into the ultimate aquatic adventure where speed, strategy, and action collide. Compete in heart-pounding Race and Chase modes, conquer diverse challenges, and prove your mettle across thrilling watercourses.\n\nChoose from an array of boats and jet skis, each customizable to match your style and performance needs. Experience cutting-edge controls with a revolutionary virtual steering and bike-like handle featuring two-handed operation, delivering unmatched realism and precision.\n\nArm your vessel with an arsenal of weapons and guns to outmaneuver and outgun your rivals. Whether you're chasing glory or escaping danger, Aqua Strike delivers an adrenaline-fueled experience that will keep you hooked.", "short_description": "Aqua Strike takes you on a thrilling aquatic adventure with Race and Chase modes, exciting challenges, and customizable boats and jet skis. Master the game with realistic two-handed controls, featuring a virtual steering wheel and bike-like handle. Equip powerful weapons to outmaneuver and outgun opponents. Get ready for speed, action, and nonstop excitement!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddytroupe.github.io/games-github.io/tspp3.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": "https://maddytroupe.github.io/games-github.io/", "website_url": "https://maddytroupe.github.io/games-github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9216366545137249"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "3085436868261535"}, {"status": "PUBLISHED", "id": "1127592642351169"}, {"status": "PUBLISHED", "id": "1351257013684495"}, {"status": "PUBLISHED", "id": "2323095471442271"}, {"status": "CANCELLED", "id": "1864641637785057"}, {"status": "PUBLISHED", "id": "1451017376044303"}, {"status": "PUBLISHED", "id": "1235160524996080"}, 
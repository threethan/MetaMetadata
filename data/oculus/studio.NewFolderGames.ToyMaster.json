ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVJW6li6vEQh0531rCha7_NbNdcYpVRrC90E3JKnqkYg&oe=6B0DA62C"}, {"file_name": "Image Sequence_070_0000.png", "id": "1548924799394617", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_1548924806061283_1159651631559933711_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drTBLBRT5hIQ7kNvwF8wKKN&_nc_oc=AdqqR2GpLM5vh3N7Ebe-J7Q9tWStDwuGz_5swcnsunqDpVT_72cC4RItfWLDxvSSOII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9sRM4RO_zGsuDjYPOlkabPQiQOX3JAD3uBnqRfCLGSg&oe=6B0DA2E2"}, {"file_name": "Image Sequence_067_0000.png", "id": "1068525021098970", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303838_1068525024432303_3486368841342252076_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n50--svkEoMQ7kNvwEpBkuk&_nc_oc=AdrOImRgdMGtyxEDLCWse-HUOAb7WXNe_G8NYX9CDizpEjAoWdMYfPio92VoCu-hXik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJj9bdu58vPs1Zjmlx9mrLJGf9ym1MX94V8QLr07Bikg&oe=6B0DA4F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 toy master.png", "id": "1447150539209590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031588_1447150542542923_306021620979646302_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cShLXrRyguAQ7kNvwHY5c57&_nc_oc=AdpJvXkHEaEUGzKO9uXmlHgcz9CCCa6O5zhMo7reGJMAfCXPy5niwt1IrX4vFCehkjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEtwrOHjDfl9Aigy-dE6RBMt3iUeaBrSgBYjfDiEoLzA&oe=6B0DBAAC"}, "display_name": "Toy Master", "keywords": [], "long_description": "Early Access\n\nThe game is in the early stages, be patient, updates will make you happy soon <3\n\nWelcome to **Toy Master**, the ultimate construction simulator that lets you enjoy the thrill of opening and putting together new toys and delightful eggs. Dive into a world of excitement with interesting game features and a laid-back atmosphere. Simply unwrap the package, crack open the chocolate egg, and discover the special toy hidden inside. This fantastic stress-relief game is like reliving the joy of your favorite childhood treats.\n\nExplore the fun of opening various eggs, each filled with unique toys that you can customize with stickers. We offer a wide variety of toys and eggs, each with its own special features. Use different tools to enhance your enjoyment during the assembly process.\n\nImmerse yourself in the pure joy of unwrapping and putting together toys in Toy Master!", "short_description": "Unpack and play, Toy Master's way, assembling joy, day by day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24144393341909777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031387_7129909110380162_3869317236226471517_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28PgeGsiPL4Q7kNvwFBeOv7&_nc_oc=AdqPCxr9T1xv-62ZtmFLgy--imN-hZyL33otih7t7HzY4uxNI7yCuyS-yN9gkvdflSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_
ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoZprpHgsMHRveOHLjYcH2HGktfesT23qHb5ezCO7oyQ&oe=6B10492C"}, {"file_name": "Image Sequence_070_0000.png", "id": "1548924799394617", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_1548924806061283_1159651631559933711_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drTBLBRT5hIQ7kNvwEtYOsQ&_nc_oc=AdqUuWDVJjswmv3qkGV04suqnlIYceYTrdJuuIuuQlhG0y9L2ynNYg8N06wqI2I33Pg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWncB8mAlyc_1mRaUWxO-xwYxFEC3pxbVIIJhXPDqz37Q&oe=6B1045E2"}, {"file_name": "Image Sequence_067_0000.png", "id": "1068525021098970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303838_1068525024432303_3486368841342252076_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDi81UB_1qYQ7kNvwF5irDk&_nc_oc=AdpDNuTlTC516oXh7GFNC22HTup2lnwwqb750_dOwhqpS3eUvvLtgneocrsfu-OR-s8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXuLAQLFnVxrtIvSSjo0wf9wkyUSzLFk2F9kOOSosjO5g&oe=6B1047F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 toy master.png", "id": "1447150539209590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031588_1447150542542923_306021620979646302_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cShLXrRyguAQ7kNvwHv8Tvo&_nc_oc=AdobO-0ypFUry8tEcjddhlICq0NYKtTKYyjKDd88pQxZvD9Y3EcOWRU4lxa3Gk_42Y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-jpWmD6Fu9je9r75j_EbJggCWprQt4h1CnwqMkRvAVA&oe=6B105DAC"}, "display_name": "Toy Master", "keywords": [], "long_description": "Early Access\n\nThe game is in the early stages, be patient, updates will make you happy soon <3\n\nWelcome to **Toy Master**, the ultimate construction simulator that lets you enjoy the thrill of opening and putting together new toys and delightful eggs. Dive into a world of excitement with interesting game features and a laid-back atmosphere. Simply unwrap the package, crack open the chocolate egg, and discover the special toy hidden inside. This fantastic stress-relief game is like reliving the joy of your favorite childhood treats.\n\nExplore the fun of opening various eggs, each filled with unique toys that you can customize with stickers. We offer a wide variety of toys and eggs, each with its own special features. Use different tools to enhance your enjoyment during the assembly process.\n\nImmerse yourself in the pure joy of unwrapping and putting together toys in Toy Master!", "short_description": "Unpack and play, Toy Master's way, assembling joy, day by day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24144393341909777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031387_7129909110380162_3869317236226471517_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28PgeGsiPL4Q7kNvwHUiBDL&_nc_oc=AdoxyzzLFrMXq2pEy33dml99wvDi91QjdhKVhxmFMYL5gZDfGwf_OC65JA5yv5Ewabc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_
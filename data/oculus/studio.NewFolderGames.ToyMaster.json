U-o5&_nc_oc=AdqVOW0ifcDrKMIB6xFTheWJInHPlJQgWg-pfO5H_DcUytr9GtYEXXYG5WRGH9TIMys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxrXJLKlHmVAC1XQEO356KGiBuIEtofUSrZfdtdRXw2A&oe=6AF1F362"}, {"file_name": "Image Sequence_067_0000.png", "id": "1068525021098970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75303838_1068525024432303_3486368841342252076_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koRGWKFm5ZgQ7kNvwGn2k02&_nc_oc=Ado_uExGaEQErXTTLRg6GdDVsCwZndedplr8fbT-y2Fc7jsdaNisTyJC-xmLf3OMfoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkMrpuVeLGc0u-dhG83UedENxk3ek3ihZhHE7uwJplyQ&oe=6AF1F576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 toy master.png", "id": "1447150539209590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031588_1447150542542923_306021620979646302_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-vmGscQiIwQ7kNvwFXTZVi&_nc_oc=AdqfEpCWRnor74n4k16HYP4sGU2e-XeKGHQw9szN8K45-971j-l8atcy1x3O-IOwXck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBilCreV-PopbNXKMPXwPE1qzvw0eFMxSwEA8MoLi5ew&oe=6AF1D2EC"}, "display_name": "Toy Master", "keywords": [], "long_description": "Early Access\n\nThe game is in the early stages, be patient, updates will make you happy soon <3\n\nWelcome to **Toy Master**, the ultimate construction simulator that lets you enjoy the thrill of opening and putting together new toys and delightful eggs. Dive into a world of excitement with interesting game features and a laid-back atmosphere. Simply unwrap the package, crack open the chocolate egg, and discover the special toy hidden inside. This fantastic stress-relief game is like reliving the joy of your favorite childhood treats.\n\nExplore the fun of opening various eggs, each filled with unique toys that you can customize with stickers. We offer a wide variety of toys and eggs, each with its own special features. Use different tools to enhance your enjoyment during the assembly process.\n\nImmerse yourself in the pure joy of unwrapping and putting together toys in Toy Master!", "short_description": "Unpack and play, Toy Master's way, assembling joy, day by day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24144393341909777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031387_7129909110380162_3869317236226471517_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlQLSYsU2dsQ7kNvwE8035U&_nc_oc=Adp_A2sz42MIyUOP95kITIWrCqUmxUgDnGxr-4CtEeS6YYjmPW1hQu-hUmZrQdyqnyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTov4hHG3CCXV0q3w99-c5hkAENCefdx0a6Zv83aIYSaA&oe=6AF1FAC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Toy Master", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1708123740, "lastRevision": {"nodes": [{"id": "6606552126120503", "release_type": "SCHE
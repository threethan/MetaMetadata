b=1-7&_nc_sid=6e7a0a&_nc_ohc=nSMSfAqYK00Q7kNvwHR1Eze&_nc_oc=AdrXIIDTskEki4aPSE5Rk4Sjm-Fvn3cIBC1vIK1YVcqLSIcejDeoY_cYRrMu5lMY1Co&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG6xt_QlIEy_WBF30whB5Ew7dduS5ukqJhtaetLR6f_A&oe=6AFC7F62"}, {"file_name": "Image Sequence_067_0000.png", "id": "1068525021098970", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75303838_1068525024432303_3486368841342252076_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YwgfHjpDB0Q7kNvwFiv4yI&_nc_oc=AdqeoVvAeEWXYlA76O1wjFAAaUReva92AGW0xu-QJdMBWlMHTWs2KpVRPYY5Qno_f3o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk8gFbaDEahhjoioYWezH-8pN9tZY60-7DqaZheN_jzQ&oe=6AFC8176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 toy master.png", "id": "1447150539209590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031588_1447150542542923_306021620979646302_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WsISAFngbMQ7kNvwEfANO6&_nc_oc=AdpP9fcenyK44qyGrrGxeZJfWMDtCP7-bijpG0QxyZrGPmaK-Yb9Guen9B6FRPOZGN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMi-peDZVIp8H-6oISqIH1PzrWZbJiBA4r63Y2Wr8GCg&oe=6AFC5EEC"}, "display_name": "Toy Master", "keywords": [], "long_description": "Welcome to Toy Master, the ultimate construction simulator that lets you enjoy the thrill of opening and putting together new toys and delightful eggs. Dive into a world of excitement with interesting game features and a laid-back atmosphere. Simply unwrap the package, crack open the chocolate egg, and discover the special toy hidden inside. This fantastic stress-relief game is like reliving the joy of your favorite childhood treats.\n\nExplore the fun of opening various eggs, each filled with unique toys that you can customize with stickers. We offer a wide variety of toys and eggs, each with its own special features. Use different tools to enhance your enjoyment during the assembly process.\n\nImmerse yourself in the pure joy of unwrapping and putting together toys in Toy Master!", "short_description": "Unpack and play, Toy Master's way, assembling joy, day by day."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6606552112787171"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2127150381572426"}, {"status": "PUBLISHED", "id": "1598492378044414"}, {"status": "PUBLISHED", "id": "601965629210173"}, {"status": "PUBLISHED", "id": "913136540764670"}, {"status": "PUBLISHED", "id": "1325043022202687"}, {"status": "PUBLISHED", "id": "1249007503198950"}, {"status": "PUBLISHED", "id": "531511289405190"}, {"status": "PUBLISHED", "id": "3454374758186256"}]}, "baseline_offer": {"id": "1325043022202687"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "2127150381572426"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7242189019223474", "version": "1.1.2"}, "id": "892830702346408", "channel_name": "LIVE"}]}, "is_for_ocu
Q&oe=6B099AAA"}, {"file_name": "1.png", "id": "1215233139295007", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974738_1215233142628340_725345302402453205_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwb31QR7bv8Q7kNvwGidAXH&_nc_oc=AdrLMBdEapnfui77bqpiyVkrSOGhRkjQ4R8aA6wO1n52iPC9f_INxwdbF8YGcW1OjEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmwAcOaCMSZs8mgm8q8U99LjX7IRVEL2xApjT7FM-jQw&oe=6B09CA79"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcYVdVRmXG0Q7kNvwF5mzbV&_nc_oc=AdqeihDGLG961Hy6zLOk7VDo11yrrbpm9gB1osppkirGbPzPKsM0tec2TaJv1r6uOXk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXKEjv3-N7NUDA0seDGOdF0kU0SepSL3_LbpswD6hsqQ&oe=6B09B8D3"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um-F1hrTS5wQ7kNvwEzK6H0&_nc_oc=AdpZVJJVW4epgI0CILxkbBajVUg5yWanwUzUeYaB_fBZBdRKbRJ54M6oN-TH7Y_WKjE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt2utVE8qMO0GTc_QNQ2VGdU9p1no7Y94DdLxFkgebhA&oe=6B099AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCGDrQ9Y77EQ7kNvwE95scq&_nc_oc=AdoafM0DaW_M3uVsjcZeigcDVZQBZIeC-BcvoCm9flBHkekwJh0pxHSJujynJlWdSL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo4cXhM6BA3hSzcueVwt3uFykm8opwQUwaD6ifytmPgA&oe=6B09C783"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
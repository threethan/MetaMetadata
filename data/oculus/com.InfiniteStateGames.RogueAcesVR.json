a30f&oh=00_Af0ai6I67wNAibRkK3USxJvL0OuzUeoMeovDKoKr6nMFdg&oe=69D7A493"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MpZh9OybxUQ7kNvwFbvM8X&_nc_oc=AdrSTmBmzJqpquREX5v_BvHJ4a1PPcX7_uy5vsxGYRlDTcNUhWwGYZHxyieZx4ltbbQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31yukGAxQv98F5cJcG7JSlbqhhkGkK6yekoSnhU8Syfg&oe=69D786AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvMbjIEn0ukQ7kNvwGxY1ge&_nc_oc=AdoexcJf8bdMrgfJ7e-FHMi8AIwfMRqzVUdtr2eWKCaRzRLAIZs91Dbu3NskId8fYUI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qKHe8h2-c6Y9yg_0n8hh1Hdf3qD1BRbemzL7R3-FJaw&oe=69D7B343"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear five islands of enemies in your best time possible. \n\nEngage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks and battleships.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nGOAL\n\nThe game has five maps. The goal of each map is to destroy every enemy vehicle in the shortest time possible. \n\nYou can see how long you have taken and what enemy vehicles remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nGood luck, pilots!\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in each combat arena! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/2018/12/06/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507062007728013"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "602166181241182"}]}, "baseline_offer": {"id": "602166181241182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657321200, "status": "PUBLISHED", "id": "602166181241182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7635417683199231", "version": "1.0"}, "id": "1346146725852348", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7330521523688850", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7635417683199231"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": 
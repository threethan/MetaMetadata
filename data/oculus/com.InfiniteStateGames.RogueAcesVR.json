": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031368_400990948626678_4925636473850726754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCgiE1zqmu8Q7kNvwGKKRDc&_nc_oc=AdktgBizWC_NIDUchNoR-QOFKy2HHilkpiw9gBn9kohjaI1rGtDGbj6xUV0PKeGxkhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5os23Jwa-xm-C8h-P-2W52cKM7y_zkhQB3GimlGWPwQ&oe=69B2C436"}, {"file_name": "Game Tile.png", "id": "398958428759023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031372_398958438759022_8558055848853916165_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivfiELoo2E8Q7kNvwGuZmdS&_nc_oc=AdnuhiCJuhnzTmIY79IIA3tpCpQVdbevY0OlGpduYXjy5antVSSL883P2rmhGQT_oEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzlpIJxTKSpOhmPuA99S-6ibG4IQfqfhXeJ6Z68W3ObxA&oe=69B2BD36"}]}, "id": "1461982117573052", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1036289743675399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1036289747008732_5728556310863142625_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smgjEtqOA9wQ7kNvwELXqnJ&_nc_oc=Adn3tu5YohO80QqzyJuSDXluFPZjHy2JYEbBgvYv_00cq9VYO9mFiho2MFyYiPz8-uM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwI7J2laB5Cukblw8-shmP62YYZyWgLaYBh5Tww4Fj_KQ&oe=69B2C826"}, {"file_name": "2.png", "id": "561217068871215", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982698_561217072204548_8724085997848119081_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBXHgSf7Zl0Q7kNvwH65QaY&_nc_oc=AdnxFs3KfPu0TbwoKhXFwUNE5Ct49jQk7zOHjR1Sf9OYKT4XAxnidPRFJ1AB9uAggmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2Tf94JEF0rgCI91e0BDRFOfTBQOdBFV_aGmttT2sw9Q&oe=69B29C6A"}, {"file_name": "1.png", "id": "1215233139295007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_1215233142628340_725345302402453205_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHeZrV_SW8AQ7kNvwHTbQBS&_nc_oc=AdkmjrH2B84P245opc6EEMUV4Ic8Gc2DqzmB5T2Br8TfOGVMEZOVAXOxtx5O_zP8J1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxMJLN1SxDQpkssPz9eMvUHYZpLxhnckSgYJ06iCpBMjw&oe=69B2CC39"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4KzoIt4VWUQ7kNvwHQq5K5&_nc_oc=AdnOvFMT6SHNs55lwdllE0P4JW8xD26tj_NqGlzqnJRwT1CJ1QLA_bjy2QhuHJpqtdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOBaaUlezh0mqJNoiK_KhOjsaMB6vTVACH4hbRQYtncA&oe=69B2BA93"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5afMPxcaL0Q7kNvwFydB9J&_nc_oc=AdkySmKPn3XLGFNH_PLSlCHIhoOLK-1voJeJAPY8suU78ukw7CcU_PWq9sftmiP_VCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcTf3Oa-4RiHM7dixrga5JUc-GfWeOyRGq5DF7v_yqkA&oe=69B29CAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcvHvDYsw08Q7kNvwHVPsvr&_nc_oc=Adk5oluGLRBePSL0HJiZS1NOcR31n5oiRdiLP0QgoQLrvb6SN_p9HI3hJd5CuJPgPZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOj2ij3GtNA2RLTKO7VUAnFG3EIHLHzzYG_T5XsjBwbQ&oe=69B2C943"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491724572715404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_557052799320107_5046866176231441177_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPrnhKEvhSYQ7kNvwFS6OzG&_nc_oc=AdkYuepyJit
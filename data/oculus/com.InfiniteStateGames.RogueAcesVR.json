_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhETTG56-pwQ7kNvwGCPnYQ&_nc_oc=AdrHfY2bzisYw7p7SLJsNTlMwNpC3-uKao3UAsO6h_RlEvJ1VfSo9wcdRv5R5SRycBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6JTrHwzFBzDEeJjCd2evhPtgsdjvQsw2P42lxGkh6Xg&oe=6B0057B9"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKyOAxyxkD4Q7kNvwF7yn1S&_nc_oc=AdoLQEEkHvFp09Zzierm6RPFOeRBZHm9G4hAusAKMLWv5nCQUwGMFUX-1XSYhfjvtOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb2PuRryzzsqo1xTqZiTsiJ8yefJM349Fn66tfwUqXxA&oe=6B007E53"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i4ngPkXmhcQ7kNvwGh-wFZ&_nc_oc=AdrNIQNpRK4hrr6bob6WRv8JDvVcs2ltrgwvxczzvi3wOeR6cg1hSkZwEmCHykINaWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3awiYj_-ElWRA3zdoIsC6ibFkv6LGSIzUUDQzShBLKA&oe=6B00606E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2szbMMlZabwQ7kNvwFOTbzb&_nc_oc=AdrbfNiq3ye56I8oK_lHm1vK6W_yGB9iL_LEKxWW5JOE2zDy5ZG3BgIPQz1KgIhmIFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNguzQe-yTxcaPPFUlGO5nKjU4a2qwDnybibzvaf8_yA&oe=6B0054C3"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear five islands of enemies in your best time possible. \n\nEngage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks and battleships.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nGOAL\n\nThe game has five maps. The goal of each map is to destroy every enemy vehicle in the shortest time possible. \n\nYou can see how long you have taken and what enemy vehicles remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nGood luck, pilots!\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in each combat arena! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/2018/12/06/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507062007728013"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_b
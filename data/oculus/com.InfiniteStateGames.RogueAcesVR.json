oculuscdn.com&oh=00_Af0xABemBDaKHz_qlGaNZG9-dgmy7Vf6s56sWgn6TV5tAg&oe=69F0C2B9"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaqrkqLICtcQ7kNvwHa3OHj&_nc_oc=AdoY6U2WWLJ2YP_EnvFsXoGO9i8wzJv4WmPcZsG5C_09u-_w6xqh0Eih4WECgmw_-VE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af25nJZ6M27PovK67uPbCWkFsbhfUlvOrk13RxquEjlSeA&oe=69F0B113"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-Yrqw4eQqwQ7kNvwGqtfBF&_nc_oc=AdrBAd4-NKzVIwyYGuSJXFO98GSXV_TFBnL9SS-11uBfaJv8VGDR_-9bIzyUJKXhcZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2bHOxz8IEOSxmatzTYnqeF4IhBNwUmDyZBAm3HzKDODA&oe=69F0CB6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw5thiTxcsYQ7kNvwEuJgcd&_nc_oc=Ado-X2grdmI7AZa_KUJ19VYst8B1vGYE9ykSXvee6idn3yracoYgOIGY7oHpra6YyNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0d17J_SagVF944PqZuxEaveNlojGJJ3DVCm4jLWGAtEw&oe=69F0BFC3"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491724572715404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974680_557052799320107_5046866176231441177_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYL2qdVW6PwQ7kNvwHSR9G6&_nc_oc=Adoy7u_JS6xwW2w_RQ6DX8clTssnNQQSS1ANXFGBhq2E7KkmQA6VyH4iHuHgj5GwQ_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2bnAa-
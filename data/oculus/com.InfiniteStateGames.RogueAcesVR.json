": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031368_400990948626678_4925636473850726754_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtphsYQd_9MQ7kNvwF3DU3W&_nc_oc=AdkZugQawKfCZuyNwbffMJQs3sePo8NUGeeJ2r8_ORvzCNYD2ZDkPvvIbfAB6hAlQwU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlbH-qTQGoQpMWEw96Qt2RYq1tSKMZAEgVyq1FedzANw&oe=69BD5036"}, {"file_name": "Game Tile.png", "id": "398958428759023", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031372_398958438759022_8558055848853916165_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uja7WJ69PIQ7kNvwF5IOQj&_nc_oc=AdmH5SkFwMzTwNywGAdVsm6rI-6BrcGZ33V2Y71xWBljtt5Xy8J7JA18fhM8MhdhO3s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYkzSBMxBfSlA_y2LBtOiKlrqcpb-SMGFeqtlNzpr-SQ&oe=69BD4936"}]}, "id": "1461982117573052", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1036289743675399", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984446_1036289747008732_5728556310863142625_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv4RkGPJxQcQ7kNvwFO504W&_nc_oc=AdnI54lWStGba72CO0twy3hQR7F4-wPPFofOItHtzCYA3qYt0v22X1sxLWBo9Trui3w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXHUi0gywKuCUaMnhbFqsZm9TBTmc2YP9CS_i-mxdBJg&oe=69BD5426"}, {"file_name": "2.png", "id": "561217068871215", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982698_561217072204548_8724085997848119081_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y04tJtFScYIQ7kNvwEVkzoI&_nc_oc=Adk4ctoLpSZSC6fxlaWwyXlmsZHlO_Z6iBlwbbWBTy9Wv_Qu4cWj3YYe7wSoBkAqOnI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOc8Rgd0OeZ0WGBpviyqt1A8bDzg36BRkYNCZtizDuBQ&oe=69BD286A"}, {"file_name": "1.png", "id": "1215233139295007", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974738_1215233142628340_725345302402453205_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL97pdBW3UQQ7kNvwEsAACn&_nc_oc=AdnEp9j0SQ1NHinI0KaalvUryuEob1ivd8ssgxOf422No4nflgMfMC-hUnSJJvW4y6A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxABoiTqIK1B82hYxv_YmDSCW1bevEmPCD436dfT418A&oe=69BD5839"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koH-SKrBlyQQ7kNvwES7Xpf&_nc_oc=AdkXUsqVIiFaft534tcoaU3NxcrxBxPFH3zE2Gzcg7VOyCKA6m49sCub4DWV_wqyZfE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyl3B4raYMSBQtn6hGvScJ4rOzyFpII6315sye9qLJsfg&oe=69BD4693"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqH022xZ-XgQ7kNvwHheEr_&_nc_oc=AdlkNA1ht3GskMEBDPpk29c-KpAHyq_PYVISwS7BLX_Xd3gj7ER9TTcbMty-Gt9rvT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEDs5IJPxKdafCcoSQwFoUIuZfAHsaOwuaoeaY25gpeA&oe=69BD28AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxEjKIVF9VQQ7kNvwH_VA0F&_nc_oc=AdmdrOlqtYiH2quJpgh9mrOLibSJL8uq4b0-8Chbq93An7TM4zc9QYnjPTvb-DrtAbM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTXZHm31bXg1mmiGXNW-KLrhgjPyBD7ciI9kB2ZFcHxg&oe=69BD5543"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491724572715404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974680_557052799320107_5046866176231441177_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRbY4euALfoQ7kNvwE9BSaY&_nc_oc=Admam_-yAMm
oculuscdn.com&oh=00_Afsiw6cBcVmttdGY0OohSC8ycPTVW-UhEZr5qa4NVI4wPg&oe=69A6EEB9"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODoP3LY250EQ7kNvwHclOo6&_nc_oc=AdmlSOHXEJBWbW-V9D56ciERYKmj0qGRUuV_IPGexDfv9Ko8YI2NmssKHOqyQscsiY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHzajV4VDpMkWDc20RPS_Gziky6L28vUK424D9BnrLxA&oe=69A6DD13"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewz6B89FfJUQ7kNvwEWmLSm&_nc_oc=AdnKjHwLTpMJ_mtirjJSHwjQwoC6AxbO6vsEx--b-xHF9n5mu-QRnQe3OJm0dqp3qzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv07t4mNapAu-_AHGF3S10XOTk7ZINzghT8ZVQPHqG_tg&oe=69A6BF2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHLuh2XnMb4Q7kNvwG1YKVV&_nc_oc=AdnFrPwUUf4p-KBNrURMd5PyWAuNbHKCNHiMBCMnqDC3eiVrFA5H1a3S7bfaDm5jUqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHAjN-UsflazDiAhpnjw4DD9QSXyofzKE8DD8t9dBm_Q&oe=69A6EBC3"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491724572715404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_557052799320107_5046866176231441177_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rYQvikwA2wQ7kNvwF5kYhk&_nc_oc=Adky_n0mCuvQCuZi7G5VNE68oKIFvPeKDKQBRtnhESAtF62WIxbNG1xZ09t4ZPtoMMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuaci0U
A&oe=6AFC6BAA"}, {"file_name": "1.png", "id": "1215233139295007", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974738_1215233142628340_725345302402453205_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQ4Z9kBzXuAQ7kNvwFs9Sbn&_nc_oc=AdqeJqo-mfFx7NKB0_Kk5a-gH0T5ivLezeg2J-bcjMgitWYJT7t1jU6nl8nhxN9cwp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUFMsxH2mDINc6hZeYGx2zzPnVQoxcIQu1ko5WBQKY5A&oe=6AFC6339"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7oSUkwSNqYQ7kNvwEkwA5d&_nc_oc=AdrmVxJK_Hyi4lBTyPZ_o2xqvH9fNnfcr4aGfMMYqA4UnLiV8_MLzieOTD55rweQpgM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1ckSfHU3ZeeljaN-9h45QSsUNKKSvjFzXaOA6UOpWsw&oe=6AFC89D3"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg_Kypth2Z8Q7kNvwH-WPiH&_nc_oc=AdpxeiVpDVFjrVbE1Q5JzONJCa_Xo2ypr6nhxuabd-IUmqLTJ6E8BouYG0uhwaO1glk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb-Tf9jc1c400B8XhO1BV1Ww1keITrSZnJofNUHDNixA&oe=6AFC6BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOhifPOLqbYQ7kNvwEpmHIY&_nc_oc=AdqExN-1yMJKk2hdBOY72qHxvKII2kG39B76aARssangTyVshWBmXdFCTTuISjaMRaw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOXYrHh-Bh-rnDrMFmeWh_FW-hL37juqmL8-Pl-Us9Iw&oe=6AFC6043"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
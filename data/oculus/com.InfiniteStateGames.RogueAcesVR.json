Q&oe=6AFF0EAA"}, {"file_name": "1.png", "id": "1215233139295007", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974738_1215233142628340_725345302402453205_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhETTG56-pwQ7kNvwFfFBSG&_nc_oc=Adpnd2Dt_oT9efzlDtazn1C1ovbInnyrWSzdrs3N-TKi69rH7jL9BmZoJPngN2VFYbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60n2ihOoM3_VmpYPAldUprL9SdJxvB4yEYUENkxVV1Q&oe=6AFF0639"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKyOAxyxkD4Q7kNvwF24MUN&_nc_oc=AdqNVWVUxldQAMjNj6F3P7qlNZwSKB9f06V5XWiRzxFd6OYDnk8VbNmy4cIkVa0XzXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjyCK_qe95KbrqTidCwkGohNVXvzKG2thkq6J1wTOFlQ&oe=6AFF2CD3"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i4ngPkXmhcQ7kNvwFAsLjw&_nc_oc=AdpLCvduX6CWUuNEAL3qo4mujmzXGL8tJu8xg_Lvpq1piHYev_VSZqwYSE9T6QvTGsg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmLSOhi8WpBz_xLtKQnAOeb_O3Ut2pX1Fr3m3yU1zE5w&oe=6AFF0EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2szbMMlZabwQ7kNvwFVaEe6&_nc_oc=Adq7HIP4tVzwN0QAAut6tUFnHW08QqgIuYjjSO3-Jr37bBgYD6uLyNgZ2kY4GXpQ0PM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtE48snhf6hXudHx9vKlRmpnRmr8t8jeAZxr52uzlvTw&oe=6AFF0343"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
oculuscdn.com&oh=00_AftwxIPTVBtqjWdoLJcF4NI81pzIp_aLa_RFNS2lVsES4w&oe=69986E39"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUYhzTySbcoQ7kNvwFDstTC&_nc_oc=Adk3a34YT1Slp_mSvDyqloh113xzOgmn3_Ckoeqiwg9IXuDVvwWKRv5912cmRHCss7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftuqURTF1fUD5dhPI-2JktYWjxjYuDuDYYHx-_zm7BYdQ&oe=69985C93"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pGn3-MQhMEQ7kNvwEOUYI1&_nc_oc=AdmAbZEbZZc9s0GA4-RIijQI8BUEsPzIxdvJ9VhuOuc9KAh1IzM3CrtAiRpcRh7DXI4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftxZQCLGS-CoasWaOBDKsn1csOesNSLm5uurAGVMIocOg&oe=69983EAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqQTM0L-CbQQ7kNvwFCSVph&_nc_oc=Adkt31QLkqPzRmQBOW6hrk1_aXmGLbQFbt1vKoLYh3SRzT2ik_y_stZ4AnABQlBO8-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftUd_tEh0SdKtJVdICnpVAqzZwYMcb7jjwZIuNbNx83hA&oe=69986B43"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491724572715404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_557052799320107_5046866176231441177_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhcq_B7ammsQ7kNvwF9Osqm&_nc_oc=AdkTAPOzVgB6hEanwBLf_1vSjKC189VPklwzdZJvg92PGnhEDHKLuQiNqP37wpkzryU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs3YrRo
_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQ4Z9kBzXuAQ7kNvwH6Zzme&_nc_oc=Adqbxl7xWt9Q90TeC02At0NPxjCiq1oEGqH7PiCl0pcYnAi2_5B8LvWqqflfnjIWuNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiAoNSs0JgEL9_UlIfwqk7fy2UBpiP3ukERE-yxaMndA&oe=6AFB49F9"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7oSUkwSNqYQ7kNvwHleL1L&_nc_oc=AdpEy8lNj9qwRhw4e1jkXhmEZ4hZlBDKRV6dMqPCvZ_OnMZgqg5_qlqD7leij9zJqgQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDa8VB4ZeUfFtNDbZF6WBNCN2PKQJBGf10dykPkgzgnw&oe=6AFB3853"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg_Kypth2Z8Q7kNvwHrYkn4&_nc_oc=AdpJn3DiAmoiX46536CKzGO0_GnyKTUwgNMgM34Y3J3xTwp78t_X1O-QecNsw0bTTC8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5WmsGNASYOTP1IUeXrvcqBXw8C07-3Gviy2YM1nJywg&oe=6AFB1A6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOhifPOLqbYQ7kNvwEFX-7a&_nc_oc=AdoaV8eNWliYwYqYuIPIxE1X6krz5j5JXM94ywsmNykvRLAz5CxI40NDSgyZOSEhhLM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIsbckGuOukXCWLLVux_fbocU0CJss2GZW72RgT9IZdw&oe=6AFB4703"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear five islands of enemies in your best time possible. \n\nEngage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks and battleships.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nGOAL\n\nThe game has five maps. The goal of each map is to destroy every enemy vehicle in the shortest time possible. \n\nYou can see how long you have taken and what enemy vehicles remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nGood luck, pilots!\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in each combat arena! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/2018/12/06/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "507062007728013"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_b
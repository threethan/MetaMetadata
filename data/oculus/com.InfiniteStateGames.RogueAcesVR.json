NvwEg1T2m&_nc_oc=AdqEtrEFNf-6g33vO85AbR0mowaWncu7NwCZykBR2McrgGMJLl3hn6ZEZkPgEn9yiKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIrznpC3L58gapbd9QmIcmB-SynyI7gZd-HWsZO2BFuQ&oe=6A70A439"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0NlCsPTkkIQ7kNvwE4HzcF&_nc_oc=Adpu6kKNP7St0ykQI6XKX17u417cPRv6FQs86lcuwejOQ4aJMizjdXezmD9MDxVLGf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzmss-qC4gZWv4xXCQSlpIqijJAgh3FG-MVGsYH0vIkw&oe=6A709293"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRstz8YY0GMQ7kNvwG6H70_&_nc_oc=AdqZ1lNf8kseqC7dt2tx62HGMXQxm5j3VnLGKqXLtttuvWj_aqLFmLpXts0wQobpTEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGam85lP14cJ2Z4enxj-HyATOWoUqlLGJounpQO0Fl_rA&oe=6A7074AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF6q6fzaGvMQ7kNvwEeHitk&_nc_oc=AdrlUS-XqrZ0yzeGNf_ZjBcYzgN94e64ca6sf5l97vG38MQUvjQQYyKBw3GH5wFk888&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGksP6R_rCPywBaXbnebecukid-0d0uuHMw9ay0hbn7jw&oe=6A70A143"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491724572715404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974680_557052799320107_5046866176231441177_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0
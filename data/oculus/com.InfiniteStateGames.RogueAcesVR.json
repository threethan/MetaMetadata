g&oe=6B03032A"}, {"file_name": "1.png", "id": "1215233139295007", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974738_1215233142628340_725345302402453205_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQZxrqIm33wQ7kNvwGcUdvf&_nc_oc=AdofbMETsVsdjQOe8L8pUJYJ9B8YyYWYgzPfOtobXqqnnm1mFectHdUpKJCwbVHTyis&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAXJF5dths9VE7E-bkBR_Dzpb0gQeBRnsKvQuiU5f6qg&oe=6B0332F9"}, {"file_name": "3.png", "id": "574115980743104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036641_574115984076437_4097138641690751244_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tivMcGlUrncQ7kNvwE3EBkN&_nc_oc=Adrnzl1K9tJ3sB0xvpCoCF3XRpm4hlIT6PAOditZsuXR3N6iLaCjm2j6ciV5EHTnUo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTRVnd82-gEqqaqPHribEdv4GilDS7Fw62H3zehOJxZA&oe=6B032153"}, {"file_name": "4.png", "id": "3260708867547370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001687_3260708870880703_434701774327048216_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwEUh8y8yxcQ7kNvwE0KPs2&_nc_oc=Ado3fLUihQg1ygrY4tNi4rZTjZjQmuiVbxadym_pGiHdydpSTbQFYm_Dlph2S2IMuTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbxMPRmwKZ0pFZT03eBh2qMvWD37aL8i0k9ey9LkWwxw&oe=6B03036E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cobsfaerart.png", "id": "604410024141445", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974742_604410027474778_7192091848183044562_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJRHyZjOc10Q7kNvwHu8dj8&_nc_oc=AdoeBmc9uGg9rUrHBG_zV3Kbp_AMUU1htI4wRGQFHfgUGtHXK5BwnKCPrmznP4Rk8iQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5MFc_OTE3WFHnRufbQSPjHXuQQR4kAjfQGpOWr-LN9Q&oe=6B033003"}, "display_name": "Rogue Aces VR", "keywords": [], "long_description": "Arcade seat of the pants aerial combat like never before in VR!\n\nClear eight islands of enemies in your best time possible. Engage with enemy pilots, dodge anti-aircraft fire and take down tanks, boats, trucks, battleships and even enemy blimps.\n\nDiscover the Kill-Switch mechanic - the faster you kill, the faster your  bullets become.\n\nWreak havoc as you see fit - after all, you are a Rogue Ace!\n\nThe game has eight battle environments. The goal of each is to destroy every enemy in the shortest time possible. \n\nYou can see how long you have taken and what enemies remain alive if you look down into your cockpit at the plane's dashboard.\n\nWhen you've defeated all the required targets in the area you'll need to fly back to the carrier to move on to the next set of targets.\n\nCONTROLS\n\nLeft controller \nStick Up/Down = Throttle speed up/down \nStick Left/Right = Yaw left/right\n\nRight controller \nStick Up/Down = Pitch up/down \nStick Left/Right = Roll left/Right \nTrigger = Fire machine guns.", "short_description": "Take control of a single fighter plane and attempt to eradicate all enemy forces as quickly as you can in eight explosive combat arenas! Arcade aerial combat at it's most manic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://infinitestategames.com/rogue-aces-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Infinite State Games", "support_website_url": null, "website_url": "http://www.infinitestategames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
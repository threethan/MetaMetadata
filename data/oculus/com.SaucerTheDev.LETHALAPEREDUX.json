=6e7a0a&_nc_ohc=uLlduJPZMwcQ7kNvwEyuFkU&_nc_oc=Adp15IOfONuxPP4DwW8AnCyub_KqDPldHUc9c65-Ai4YUV1r1QUNcAY1bwIveusgc5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0hsztwQxINLm8cL687X3Ut9nWlyWvwE5kPAZRiqAIQqA&oe=69F0C37D"}, {"file_name": "Screenshot 2025-03-24 044210_resized.png", "id": "9028136927308088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_9028136937308087_6082834305206585519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYzqo8nwR-sQ7kNvwG4GV9E&_nc_oc=AdqZ3J_wov6B8Vl1ocnmgEQjG8YAaEN2xo8s1RS2WKs2LbILiG5UQ4jyHzCOIbDA1AA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0AJpOpOxCbBLnC3jM3jSIaAAmXaJFGc1Sv2Na7hBDRNQ&oe=69F0AA43"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLP2y2S56JYQ7kNvwFUtwR2&_nc_oc=Adq6wAzmOwSelhrcOVFTh-2vgPhNJmXEMNgWDT8FbAwDWxWH92JVndAo2r0d3AUegms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3vHHCQmwzDGHmTVM7I-0soNxK181nz7ujovOX_axpBvQ&oe=69F0B6C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Leth\u0430l \u0410pe Redux", "keywords": [], "long_description": "Leth\u0430l \u0410pe Redux \u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "Leth\u0430l \u0410pe Redux is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9990358341018129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1610040996330503_6540983452498229273_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5eg5Ge0si8Q7kNvwFgZqAS&_nc_oc=AdraH5wcE3jg-sj4EYnLdFpIUusxGHlbv-Opd2XlKkqTZP_H4ikI8x3Cy_FxSrSf4RM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af21UmUrUG-r71o5Q0kBEWLRNmezwB9Cgqw771-nfXrhXg&oe=69F0CA71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Leth\u0430l \u0410pe Redux", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
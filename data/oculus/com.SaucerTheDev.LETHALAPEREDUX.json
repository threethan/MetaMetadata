=6e7a0a&_nc_ohc=O8FwIeYQ9R0Q7kNvwHov-Bt&_nc_oc=Adm_FlrV2rc9Od4aIi2SojH9pi0Vo6x37I7kJMlh3IUsPcjKGC0NaoRaLlkNDk-nlTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsEz3op_N4aO_MwAnfqjyMuxUxDUBBDqRswtFqXoOTpWw&oe=6999C07D"}, {"file_name": "Screenshot 2025-03-24 044210_resized.png", "id": "9028136927308088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_9028136937308087_6082834305206585519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgRh9LlgNF8Q7kNvwE1XZ1x&_nc_oc=Adl9XZ0NCQs7uorHM2xreGxXhyJeK5oPlcvH7abpE9nU36zDZyPjGjSjZYEpDVA-cvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgFGJdHC7vwB-2kVAPycFLYwNANDydrjOwUxoatWLmLw&oe=6999A743"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TaLAW7uXPkQ7kNvwEa1Ja8&_nc_oc=AdkvrrBiKxWvtW4wSXM4KUtpHokYWribpA4CJRutTqs0IPhoeyhxA_g-LbsF17txrH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugR3fgVoFPx_18YnOQ5hwgdgyOkWw_g9XrYu0QLNVYdw&oe=6999B3C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Leth\u0430l \u0410pe Redux", "keywords": [], "long_description": "Leth\u0430l \u0410pe Redux \u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "Leth\u0430l \u0410pe Redux is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9990358341018129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1610040996330503_6540983452498229273_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLiVZLUk0LwQ7kNvwGEWh5B&_nc_oc=AdkTFBIrn5MZ9iUmHoJb2eV59LPFSxN6gVROV0Q_OAE6YPBb9m0Pj2HY2J-4ckNAvfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-ERw3A5k2VUOn23DbdzLeSiLT2dSruHq78cjOTveb5g&oe=69998F31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Leth\u0430l \u0410pe Redux", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
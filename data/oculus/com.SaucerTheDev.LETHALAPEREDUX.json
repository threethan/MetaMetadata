t-fra3-1.oculuscdn.com/v/t64.5771-25/473392019_1041895524626218_1889269938319684470_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9Had9ZvF3UQ7kNvwHqV_Gc&_nc_oc=Adog_mz01N2EN8tVJc9k4jQgTT9OFRXscBnsSshTA55qBKnYwR8j4mKCCrygbrZzJdY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVqOGvWQJey-uw5Mr4zNyQ76rKTBKhLiF85hUTcd6izw&oe=6A5646FD"}, {"file_name": "Screenshot 2025-03-24 044210_resized.png", "id": "9028136927308088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391883_9028136937308087_6082834305206585519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4wSHCCUgO8Q7kNvwH1hSd4&_nc_oc=Adql_BE6yDSQCI_nVcAOSM_T57aopOV-wJEMLZrHm5CpqOGvjoY1VgzBFjXO_hIm4jo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB37LgL9HuB0_doUZAyJpdZKTF2vo6uOap5wywzMSPOOA&oe=6A562DC3"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubNjX9AtyBgQ7kNvwEGb51Y&_nc_oc=Ador2wq6mec1n25yHxlVv2IitR_67MQYGd6wFmwSishHUP15FkYlTPB4gTeQ60v_oIA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTOsLC4is2TXPywMXZxL4n3vgO9zxlfwApDHG_iIodDA&oe=6A563A42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Leth\u0430l \u0410pe Redux", "keywords": [], "long_description": "Leth\u0430l \u0410pe Redux \u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "Leth\u0430l \u0410pe Redux is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9990358341018129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391911_1610040996330503_6540983452498229273_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOKJBuDH654Q7kNvwGoV9qI&_nc_oc=Ado4VBSlDhqcsOwEiD3VJqiDpVo2W7tWLOekbPBixXJQybo4Zq_22fL-HpRvuypTyao&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw3GmpZSZt6f14kU7dZapkZzz6ca-WGT-dYT7akpO3yg&oe=6A564DF1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Leth\u0430l \u0410pe Redux", "
t-sjc3-1.oculuscdn.com/v/t64.5771-25/473392019_1041895524626218_1889269938319684470_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhsjMMOekjkQ7kNvwGzizNn&_nc_oc=AdrEGrTMGssp0O4weI3_1KnUCufXQ-kk-APktG7bmLWdAlA0LNr7r_g0wJ_mWp46lJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9UeB1ORboNnikp0-ag06LOv8XQjs10B6nx_NHshFK4g&oe=6A5B8CFD"}, {"file_name": "Screenshot 2025-03-24 044210_resized.png", "id": "9028136927308088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391883_9028136937308087_6082834305206585519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2nO8MiRgYkQ7kNvwHBHDuh&_nc_oc=AdqRtt_QZVHxi_WlBPIEUekD97ViFwDL5gePtM9HUi8TDOHGWCaVGImFtBkbBlVdo8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSQELrBXVMsjfrv26pOIw4jM183wWzUw3IHCXdd2AnQQ&oe=6A5B73C3"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry57nweVnp4Q7kNvwFumtvY&_nc_oc=AdobvcikLg3ariBtgOVYssjKzWCLol5Qay_lQdeCk4KTl7kiUjpnuRSrQVwsZXbbbGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEUVOEAMwf1c5HXckDUoNcoSjjaVIwBGdJIPrrAHE6KA&oe=6A5B8042"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Leth\u0430l \u0410pe Redux", "keywords": [], "long_description": "Leth\u0430l \u0410pe Redux \u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "Leth\u0430l \u0410pe Redux is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9990358341018129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1610040996330503_6540983452498229273_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQBvm9Hrq_AQ7kNvwH6AtXT&_nc_oc=AdrwzjwbIgZ3n7TFuaauc7AWnamkelE-tm8HIerh-ul7zKMdeq6attWBJs0lQzOL6dM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7u7V7lUDHDZ7qw5W2Z-VMxtdvlSgLSU-6ivE16CMlng&oe=6A5B93F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Leth\u0430l \u0410pe Redux", "
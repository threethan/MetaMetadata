39jduvpwgu-6O4bjdwlDNNuwotU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qiaJX1Cg_0uMozgJQwnifv1YjEkP8X7zxfRjaDXch4g&oe=6A36C203"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Njby8oofSmUQ7kNvwHWCai-&_nc_oc=AdoTKQHLil9tYnxTXyM-ATPTcrth9Yxhs0fOaV2A2DuT7o7Nsw9VKGedvUHng2Ec-DQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kCSXxKUP6GFPG52SwVNtI5-ztUon4qh8skAwNQycU_w&oe=6A369642"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LETHAL APE: REDUX", "keywords": [], "long_description": "Welcome to LETHAL APE: REDUX\u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "LETHAL APE: REDUX is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypo
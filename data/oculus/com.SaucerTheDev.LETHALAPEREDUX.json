=6e7a0a&_nc_ohc=MN1dp7PVRu4Q7kNvwG7JIqL&_nc_oc=AdnqLWbUeZ2OJogMmnrJzh3rXu6A1JKDWOs6I2d-bIOSZ0KBXJ1oIDLPRAD6wr7cjfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfviJFt6Dg-hH0New9oFrCTlpOFSbSIU9Z8CpU7wL1V2Dw&oe=69A2FAFD"}, {"file_name": "Screenshot 2025-03-24 044210_resized.png", "id": "9028136927308088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_9028136937308087_6082834305206585519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S7PqcfOoysQ7kNvwEzzE2h&_nc_oc=AdnNDWpod6yamCnHkl-g2ON3mD5VB-tB-CUTTGywoXFTAuFqdajvpTyKr2aqS6uG0ho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSXPHRf-J_c5qPYjEMgBpDYoIILdCw3R6ZBQcqsWVP7w&oe=69A2E1C3"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmnKFWa9jlYQ7kNvwF5EZy6&_nc_oc=Adm9lL_Q5dh1YhL_nms9CR6-j6Afb8gPTImscGXT3nxUwJyKECfJm9HEzD4sAQXHswU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCZvC-6AgQPPag6sNiSMG-HRVc6NqU9zMHIoIovW1xIg&oe=69A2EE42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Leth\u0430l \u0410pe Redux", "keywords": [], "long_description": "Leth\u0430l \u0410pe Redux \u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "Leth\u0430l \u0410pe Redux is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9990358341018129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1610040996330503_6540983452498229273_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wtJN9vZxToQ7kNvwGcX8Md&_nc_oc=AdlyNZMwbaxXIM0L2fg7paKgZCdIo3VwdL3YR2U2qEd66PKFsQXM3LABBe5YT9PUmsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft78doYL7iUF15kzENXDqn192ImYZE4BK0dMRNACZII1A&oe=69A2C9B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Leth\u0430l \u0410pe Redux", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
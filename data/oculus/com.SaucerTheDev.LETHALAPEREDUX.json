5rrWjucPXO9Y6R4-1bXaM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaJUwdWTHbMYI0WY8RF2JrpcypF1FK491H0ZTN3ofYqg&oe=6A8EDE43"}, {"file_name": "Screenshot 2025-03-24 044153_resized.png", "id": "650843207648552", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392010_650843210981885_5363059805810285899_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYq7_K3bNfcQ7kNvwEoy0To&_nc_oc=Ado-Tzj7csaoSQU0rmr2bJ9z8GN22JBAO89xeziY1NCJ4DEqrbtqtgUBC6Je_50RdNM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOwLSsc-H6OlqRfib6viHG8Rqmts1Dv2n9IdTNb7ssQg&oe=6A8EEAC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LETHAL APE: REDUX", "keywords": [], "long_description": "Welcome to LETHAL APE: REDUX\u2014a visceral, pulse-pounding survival horror experience. Trapped deep inside a shadowy research facility, you awaken to blood-slick corridors, flickering lights, and the distant howls of unspeakable creatures. Something has gone terribly wrong.\n\nNavigate a labyrinth of decayed labs and forgotten chambers as you piece together what caused the outbreak. Armed with whatever scraps you can find, you\u2019ll face off against grotesque monsters born from failed experiments\u2014and worse. Every encounter is a fight for survival, and every shadow hides something waiting to kill you.\n\nYou are not the only one trapped here. But you're probably the only one left alive.\n\nEscape... if you can.", "short_description": "LETHAL APE: REDUX is a brutal survival horror game set in a decaying underground facility overrun by monstrous experiments. Uncover the truth, fight for your life, and escape\u2014if you can.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "SaucerTheDev", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalapereduxprivacypolicy/h
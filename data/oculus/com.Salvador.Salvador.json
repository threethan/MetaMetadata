c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dToU8l1ay3UQ7kNvwGUEvxu&_nc_oc=AdkshheWpEOQ2yWmdwcBA4SXH8hpX_vi9W06COdZWMzE2ePTfnk7J2NPChJnr_7OYg4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzE60s370z52O0m_F9BikmgRrKhJQadFZ6p6AlyXzPzGw&oe=69B95CDC"}, {"file_name": "2.png", "id": "630667388802356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982713_630667395469022_3602993365764030672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bpI_KbLcsQQ7kNvwFMdZzh&_nc_oc=AdklsEbcGo8DbTpa-FAcdYwj89CUSOstre_dz3lCoOwmVSN0KZ1nQ2w9tOJNUIYasPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5UkgtoyfyykTox6qW0EryLGusyuJN8XbP7UaGABBz8w&oe=69B936DA"}, {"file_name": "5.png", "id": "480597667374519", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_480597670707852_9051582468326614860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDOV2QTfi2IQ7kNvwHGsZtX&_nc_oc=AdmwdvAkeXg9lP3PZnffWnJtWGdOcwr2PUCvuBIUhyn8dMtUNKJu1Q4Gep0u46MuwUg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEj38F8zC18jONLY1HIeNkyAdEyBIqThWboQLuELNAMw&oe=69B94FC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "688216005840170", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_688216009173503_1632770246060063771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx814anhUOYQ7kNvwF-nwDr&_nc_oc=AdkgBQRRmYHGCC8NnKJdIQcTiD3gJW_W2qCNqqvhBMWUugt6mxs61z7q6_SrX6BpV9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzidIPzoeKJ8hcHFija-w6gbvABM_ppwAmFQZUXzgfdhg&oe=69B948C7"}, "display_name": "Salvador", "keywords": [], "long_description": "In Salvador's  boxiing in the galaxy, you are the one who decides how hard and fast you want to train yourself, to someday become  \"Champion of the Galaxy\".\n\nFor this purpose, we will begin our journey by adventurous training - but at your own pace!\nYou choose how fast you want to be.\nYou choose how strong you want to be.\nYou choose what music and atmosphere you want to train along with, from a long list of songs and genres.\nAnd you choose if you want extra motivation and encouragement when you train - or not.\n\nSalvador Boxing allows you to control every aspect of your training experience, providing you with a rich toolset for mastering pro boxing.\nYou train at your own pace - you choose if you want to listen to music and what music you want to listen to while training - without worrying if your punch hits on the beat or not!\nSalvador is your private boxing instructor.\nLearn pro boxing now with Salvador VR!", "short_description": "Fun boxing in the galaxy,\nLearn boxing - the fun way!\nStay fit, in shape, while having great fun learning pro boxing!\nHooks, uppercuts, punches and dodges - and all the skills you need to master in order to become champion of the galaxy!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6f2a6f09-9d22-45df-9403-e19805c526df", "developer_terms_of_service_url": null, "publisher_name": "Salvador", "support_website_url": null, "website_url": "https://www.facebook.com/groups/639737564050715", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "FIGHTING", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "fr", "es", "vi", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "839169827128970"}, "review_messages": []}]}, "cov
QohF4k6-ZQqYTcdWrky3HlArUmbb6Aa8849ASzHi8Y-uZpiKHJa-qhPOvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af33FjonW7Tr8BdUqwZLhuMPpTb2EyiAvBovQUTXPupsEA&oe=69F0BBDC"}, {"file_name": "2.png", "id": "630667388802356", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982713_630667395469022_3602993365764030672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZYlc5JpfsgQ7kNvwGCgtdH&_nc_oc=AdqcwLd1fH-1kK9AryCKGxLuf9c-WbWNM7jG_WSFXkQPpuXJ3ow12avkUzzgYMtZnSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2hvo_vSKEjhPqUtE_z9-MNkVMkNzgsOOARyFipoyMYnw&oe=69F0CE1A"}, {"file_name": "5.png", "id": "480597667374519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001729_480597670707852_9051582468326614860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hxHH6CQbyUQ7kNvwHmKSwF&_nc_oc=Adp5SZHFmCrewK_MVRIucHmrwTagiUaWWCKrep-mj6t2PpxYM7-d4ZjIXxy_8XdVVQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2n0bKC0rPjfdyG6YYtxIa5bD0EHwqS8Lg2EiUvW0tMkA&oe=69F0AEC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "688216005840170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_688216009173503_1632770246060063771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omk4RgcZX6QQ7kNvwGZMrov&_nc_oc=Ado5IKyBTZwV2wiHges0uRzaOpBnHnsU3JtdyUWDYwSGEBeWomOM3Sl-fc7fpTyp7VI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3S41suJyC3OnCHGL6sAtNDnHnR4AYtxBrQBvZIdNS26g&oe=69F0A7C7"}, "display_name": "Salvador", "keywords": [], "long_description": "In Salvador's  boxiing in the galaxy, you are the one who decides how hard and fast you want to train yourself, to someday become  \"Champion of the Galaxy\".\n\nFor this purpose, we will begin our journey by adventurous training - but at your own pace!\nYou choose how fast you want to be.\nYou choose how strong you want to be.\nYou choose what music and atmosphere you want to train along with, from a long list of songs and genres.\nAnd you choose if you want extra motivation and encouragement when you train - or not.\n\nSalvador Boxing allows you to control every aspect of your training experience, providing you with a rich toolset for mastering pro boxing.\nYou train at your own pace - you choose if you want to listen to music and what music you want to listen to while training - without worrying if your punch hits on the beat or not!\nSalvador is your private boxing instructor.\nLearn pro boxing now with Salvador VR!", "short_description": "Fun boxing in the galaxy,\nLearn boxing - the fun way!\nStay fit, in shape, while having great fun learning pro boxing!\nHooks, uppercuts, punches and dodges - and all the skills you need to master in order to become champion of the galaxy!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6f2a6f09-9d22-45df-9403-e19805c526df", "developer_terms_of_service_url": null, "publisher_name": "Salvador", "support_website_url": null, "website_url": "https://www.facebook.com/groups/639737564050715", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "FIGHTING", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "fr", "es", "vi", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "839169827128970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86809996_2351983001627189_345283619946
5146964_1215568453103120311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCd9nvfjIqsQ7kNvwH-nxeZ&_nc_oc=AdqrCpp1YbV0_vDCbj-6Gy423Bmj51CRB19lX11vsrDeDAFghTKiYuxJbrG3HCpja2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk3oQdnE2AKfTiDBUNNuzBX0S8WTkmndOtTW4OagH9qQ&oe=6AA5595C"}, {"file_name": "2.png", "id": "630667388802356", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982713_630667395469022_3602993365764030672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUTaQ4nkE0oQ7kNvwHFodJw&_nc_oc=AdpCVjHAuUtFM0ambcV608EwugCmJz-ZEmic2HQm-7iPy-PG7XSfz3t4qDgMwse-YTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgSequAh2sp9ZbfjyOQicEFQCPxeLjhHrn4RRkwaS_9w&oe=6AA56B9A"}, {"file_name": "5.png", "id": "480597667374519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001729_480597670707852_9051582468326614860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTOHPhjPKr4Q7kNvwHSegz7&_nc_oc=AdrLwFXPJx8w8LjH7bFa1NJz4f865QbrdgUlTA_IPq8-veyst8Zlb4h3gfKmjYaCwMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1iOMHVGQRAz1CC08QlQRdd2alQYXYFrsal33REnWxOA&oe=6AA54C47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "688216005840170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566678_688216009173503_1632770246060063771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTZw2PdD4JUQ7kNvwH_TT3x&_nc_oc=AdqNWhIBkp9qZvcY5rtmvaMbYPa0ITj5ve3cW1nrz_5VRFwGI3lT7f6aVVqPXfNHJWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITQFMgLAdwz6s1VKXN3OC7RqKixFGtbgNq6QWArAxN0w&oe=6AA54547"}, "display_name": "Salvador", "keywords": [], "long_description": "In Salvador's  boxiing in the galaxy, you are the one who decides how hard and fast you want to train yourself, to someday become  \"Champion of the Galaxy\".\n\nFor this purpose, we will begin our journey by adventurous training - but at your own pace!\nYou choose how fast you want to be.\nYou choose how strong you want to be.\nYou choose what music and atmosphere you want to train along with, from a long list of songs and genres.\nAnd you choose if you want extra motivation and encouragement when you train - or not.\n\nSalvador Boxing allows you to control every aspect of your training experience, providing you with a rich toolset for mastering pro boxing.\nYou train at your own pace - you choose if you want to listen to music and what music you want to listen to while training - without worrying if your punch hits on the beat or not!\nSalvador is your private boxing instructor.\nLearn pro boxing now with Salvador VR!", "short_description": "Fun boxing in the galaxy,\nLearn boxing - the fun way!\nStay fit, in shape, while having great fun learning pro boxing!\nHooks, uppercuts, punches and dodges - and all the skills you need to master in order to become champion of the galaxy!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6f2a6f09-9d22-45df-9403-e19805c526df", "developer_terms_of_service_url": null, "publisher_name": "Salvador", "support_website_url": null, "website_url": "https://www.facebook.com/groups/639737564050715", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "FIGHTING", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "fr", "es", "vi", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx20o2et8awQ7kNvwEAEFDW&_nc_oc=AdniyqKlfDAAIhDxAh41seyPWVjQXqfd8G485h3j3c_fTpflr4MtCsnhtcGZaee-HjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNty7JpbCofe_doePSVIWvo9ae_nFdGCR9XOzfjU8iyw&oe=69B416DC"}, {"file_name": "2.png", "id": "630667388802356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982713_630667395469022_3602993365764030672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cscpyl4d92cQ7kNvwGNbJnG&_nc_oc=AdnjJIVlkM6IjJaUkAdvshZRlubXOp7bc7Q8YDNLbYI7Mspd2fepUPErWlYSE_41gng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJotPO9P6ex9DyDRIyxU_KORs9MXHeOsy3L0WUpxLXxg&oe=69B3F0DA"}, {"file_name": "5.png", "id": "480597667374519", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_480597670707852_9051582468326614860_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ceh8cHz_dKwQ7kNvwEGCTaQ&_nc_oc=Adku6hMb7blsfvcBACyYtOmDii9EPnxl1IqJJ08XftCxWconwpVSDpMpIjYJc-mWqWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwovJ-JZ0ESAS0fLC8TTC5BS_JDhqFrUkMiYX32k0pjkA&oe=69B409C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "688216005840170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566678_688216009173503_1632770246060063771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9MF-UIzQtoQ7kNvwE7jlKp&_nc_oc=AdmhSarqmpVSy2UiSk3Yq9c09dDydZSNOXlwWEMxopDnRXIxw_Pk7rTn328R0l37gzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy28lNdc1A_5XaUozb0VWbNu9PTygukYs_YQXk8O8Bv6g&oe=69B402C7"}, "display_name": "Salvador", "keywords": [], "long_description": "In Salvador's  boxiing in the galaxy, you are the one who decides how hard and fast you want to train yourself, to someday become  \"Champion of the Galaxy\".\n\nFor this purpose, we will begin our journey by adventurous training - but at your own pace!\nYou choose how fast you want to be.\nYou choose how strong you want to be.\nYou choose what music and atmosphere you want to train along with, from a long list of songs and genres.\nAnd you choose if you want extra motivation and encouragement when you train - or not.\n\nSalvador Boxing allows you to control every aspect of your training experience, providing you with a rich toolset for mastering pro boxing.\nYou train at your own pace - you choose if you want to listen to music and what music you want to listen to while training - without worrying if your punch hits on the beat or not!\nSalvador is your private boxing instructor.\nLearn pro boxing now with Salvador VR!", "short_description": "Fun boxing in the galaxy,\nLearn boxing - the fun way!\nStay fit, in shape, while having great fun learning pro boxing!\nHooks, uppercuts, punches and dodges - and all the skills you need to master in order to become champion of the galaxy!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6f2a6f09-9d22-45df-9403-e19805c526df", "developer_terms_of_service_url": null, "publisher_name": "Salvador", "support_website_url": null, "website_url": "https://www.facebook.com/groups/639737564050715", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "FIGHTING", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "fr", "es", "vi", "ja", "pl", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "839169827128970"}, "review_messages": []}]}, "cov
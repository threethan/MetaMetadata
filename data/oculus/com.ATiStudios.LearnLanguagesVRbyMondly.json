g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBSsWCtSz0AQ7kNvwEcUCCL&_nc_oc=AdqfxUyAK3TpG6wys3jTIfmRH5fv-BzGf3u9iU5MD7EnaBmpUv5UZg4JzbqRdl1fcUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dai0abjru5umomfzBBuSf1S11INxFI6CnzkyeFg5C9Q&oe=6A354066"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvRzPIGHM5IQ7kNvwEy35dF&_nc_oc=Ado3SRbLM8AQV2My_b9uU9W9crYBdOSPZ35oyt4Sqa3KiekuGmhabkmz88Qce5uiHCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lEDQwhMoEJw5bVMvKHKx6Jnpj7hsufIN2879VGFJHJA&oe=6A3574D8"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnhyTPXXe-EQ7kNvwEiUvYM&_nc_oc=Adq_5_jCF16H5hpsVC8KHKPbWM0oh7h-GnzlcY0pMOyaG9h3XpOjlxfq_zUn6sC7nEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XaFk4GLEUzpEQQH94AUWdo0ZZctMuJ_a_E73lanZZBQ&oe=6A3559ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zf7l9UoWoBUQ7kNvwGw3qfm&_nc_oc=Ado6yMsJPKxNRggS_6g0Jgil-MWTx50QjgxcUbC-e9zG-wXqZ0rLC8TBVTdHeB6D2l0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KBa-UTmeyr9c3wJjx4MZ4bdaLd7ozi29blHeoXKwvdA&oe=6A354042"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYI8bPkofVUQ7kNvwE5-67I&_nc_oc=AdpOwEHVokC-xAbT5fJ1tj2-AWrjFeypvXObKppCADXB7wqNFcgcXJ18PXDkBDVtgs8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mFg2iDdMwCdWZz6WUQK_QhzhErBKuiDIsJgINJzZsBw&oe=6A354E19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXdR27YpGYYQ7kNvwEaL1M6&_nc_oc=AdpIRK68IoGfqVYdcZ_WeaLxZEDEcG6FWIvfKc6WVrPWtG4a6Y7n34lG8EHh5pqga6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x_LAxNX8YAIiwfd1HL8SkmxqYLCb-cHctAAPIebCr8Q&oe=6A35672A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iImrid1DUqkQ7kNvwGJIaHo&_nc_oc=AdpLfVD3tmBgA34eWYwE5YSG1RKwjoMkTNSTd9BSB9dHkA3P9B8J_1szBwHgVvusI4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pq4rnj0-uir7KVjbVR-V3B05wzQf3YDQbMPCwccUETQ&oe=6A354ADA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
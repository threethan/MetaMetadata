g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=larjYYGdcnoQ7kNvwEi9pQN&_nc_oc=AdqWd6nMyNIo9qFuUoiW00pO0p-5jHjxVGXfSYNDDreNZ0U6Zr6FGAT5WMlnjdc-Gvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFLc47qJBv56G_9OsGZQXbl8SFEOIRA6A-h7C0-35_SQ&oe=6ABBB966"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bw7TsD52tIQ7kNvwGmKdiR&_nc_oc=Adp230yMQBZUDEXt0DJOADX1FkiPBy7kbJPoByetAireAFxUyPB60vEX9Om55VVn3ug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgvdN2EfbDDdQTd6_WgE9xQK6qZeR1QaBv0L4ssmFpPQ&oe=6ABBB598"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob8BXI4xHFUQ7kNvwEnf6pP&_nc_oc=AdoYPMohQi7c37eJKybmaS9sp0LtTzkj7O99R2zAz_ERv_blsigcwASfJYGygwbMpoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrp2uQH_2zvCTRTW0tX0hKR89fG24cq-UUtHRg2cvL5A&oe=6ABBD2ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPWBKTa_6CMQ7kNvwG9gdbd&_nc_oc=Adp0PzekWP_bLZSc9tuLIZYm7-4zPK6qxJ0vUXqxfYLKqVw4maedfsSy_FyN1EoxEJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGf4V1aPH3sr6huCxlQz37FyAebVXl-KmUmllL6mEnQQ&oe=6ABBB942"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCpwJwypZYwQ7kNvwFg3Upd&_nc_oc=Adq0OrXrCCXBvIt97_duun4ODh5GpW8_ARyY0HgRs7vlhraKzoP8PW3cJJI5bmvIuIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfmcDmwFwuumlL0-len2Y1kr2S9rHpyV75zbYp-57b8g&oe=6ABBC719"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z3kbOKlCQQQ7kNvwH-0rHd&_nc_oc=AdpmzpDUp4xDb5pIgaYEH9IKYkFSvtIbUpuh_m5aAsL0_tkXkiUE2jaUItWykQBS5BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsaVigiDRpYXkiJ7rzgISG5O1i5-YohWq5azdlomi0vA&oe=6ABBE02A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8ZMEuWyTzwQ7kNvwHmzzfP&_nc_oc=AdoZqBtXRXPbY0ywx32mYUY4S-_f94farTjFhPfeGYy74ujc2ouB3U9XaSrWa3FcHyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb1x47iH19qDXpcPdx2AhsVCQWrOMWVYTDD9ZQBtzU5g&oe=6ABBC3DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
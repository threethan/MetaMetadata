g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dxphYuT0qEQ7kNvwGioIQU&_nc_oc=Adr0HqIg44XG_GJ5GNvcZiaQx3QmhJrf38Vo0F5Q7vc1lnNwVwv2DHFmUbK6d6eEo6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNAB96DOYYYTlIxkVQga2i0kjKM9lGvcwiHflUDYp0uQ&oe=6AC0FF66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQyAu9nIbtsQ7kNvwH864c8&_nc_oc=AdqAFGs9mopLxpSpejowpNdxYf3-dvbrYwYKFfHrkCePpr9CdkdVvTO5el8G5Rf-9eU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvw8-7ZpNyJsgkF-oRRvOENia0-iClXgB36naKxjFxwg&oe=6AC133D8"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06f4EJ35rhsQ7kNvwFiTXB1&_nc_oc=AdoyULEEbUKIxF5fH-YS-_3ZaFEOZPopaGhlmdJcHcxjC8HPQJTTXAF6rOZeyh1umnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe8Wln_SqkNi1R_Iz77eg9qRGMZ_QAbx2pReEMUZdJKA&oe=6AC118ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRi_JJq0-v0Q7kNvwGeFc2I&_nc_oc=AdqR7HjvnFwg3k-c6fu5nC2npRtu-vyQlSk6xqP5ckOOa0WyzAkkKlk3fWXTC_lfNqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkQTb8QUPvdjLBB9pzd-Pe5sOR4FAQfJQVBSXVVEyg8A&oe=6AC13782"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okksYZPXnowQ7kNvwEoZKCU&_nc_oc=AdocPUNruv9V7BYjA8oCQg9SaQIfeOMIITolEdElk8BlBt8ZI36aAW6L6l5qWzxBshw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFtFhxWCm2I7lX1unLPFHfB8dOgTB8WcQXc0Ee6rgNWQ&oe=6AC10D19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2BaQR7B11QQ7kNvwFbTsJF&_nc_oc=AdoOBI48E9bL0j7bjaezRgegTgTjvx_2ljEhAFpKp3mDTU-TauvDxLxh-_8mQH0LTW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2Hkl-jrIksVmv4CRVYNh2S3Qhx-4VDmFD_DyknRHbZg&oe=6AC1262A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRV_RE0p_FsQ7kNvwH6ozoF&_nc_oc=AdrEX-YnyiQG98lAHSiLcvnjPsRfHdoIiQfLR3H9wXQ61r8Ta7Gdu8uS6EuG67tDzSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZHvhZU42m1G_Q77yy1XpWrLJYtqjel_G2aqh61CA_rg&oe=6AC109DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
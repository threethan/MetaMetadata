g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-qLhvgsuCwQ7kNvwEWnXDJ&_nc_oc=Adqloxn-yZw9bXqrG36ZMZgP0YkAGEBt5IudzmpCE99pAOHpICzdg0wMpTcyDWf4YbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M62WMbn2EjDYMSnUicDxPVkoAdK7NUwW-c2CKH1zgfA&oe=6A43C0E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbv8tsc-3s0Q7kNvwE_h0bY&_nc_oc=AdqujhhDFxmgzWSdGI5EAarISFN9qDrbFQuFwhjYgM27BzkEl6uoSmsAgUkWCvXe5lI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hvoJ7-3jizxcLyKNNd4aR5F2rLUXKvCko2C18BJcyAg&oe=6A43BD18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UT_VDrOO9kQ7kNvwHQpj3K&_nc_oc=AdppQ__v3XF5IpKO4JFUSRG_GcjCNf7jW7lHDQJd1IBRVxhrExogdUrOEOQTtZer1So&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HgxAT_RcD1pJX73b6W122oA_uwwRShZyhs3xjoB881A&oe=6A43DA6D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHHXewc2QYgQ7kNvwGi3Ml0&_nc_oc=AdrQx2v5eILENfIzrZ21cl-_gl2RW1-XGmHfT-2RQN2K_XItVxIZnU14LBfjObUuFPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L5gRvD0r0BgH-nvX1a48YO1zVYdWHfJkFLG-A8htFsg&oe=6A43C0C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxrw-9OavQcQ7kNvwFf-1Ta&_nc_oc=AdrkQs5qwPITlGnpNLW2Ip0_UskC09ybFfpFn3O0sR59tJg72HPqCvOa096I2CMGByM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TXIyhLAdF8mBD89yROISModqmpDB39GPCf-K8Zo7lGQ&oe=6A43CE99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T39hBgw2xhkQ7kNvwHb5sQh&_nc_oc=Adp0eaxAzZpDye1hiakIMYg507Q5b4nWwBWVwnn092BuujYpwluXa34lhARdPjN5o-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8gE9cTvXYXqnVLO6_w3dXRlp8YtmVNi_Yr4BFjKV8RA&oe=6A43E7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbO1pwjqk2QQ7kNvwG9Jh3t&_nc_oc=AdqQtY9TW2Mll7OSyDyhiJuQ6IUcVolElmkq0mlaj2TfjD0KcFMT1w4fwDnRssDwoxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N_KWWmzlSoDS0KT5YRWHPHcwLUaTrwg9lijIs7U5fig&oe=6A43CB5A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=778JPB3o0z8Q7kNvwG9THNS&_nc_oc=Ado_4bS69hapmrd4K6Q-DgyhwHBEkAnhGdQZcCX_IH3Afr3ni1ysoW_AiVuGpII9f0A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNQQ0fDayB06xKmnJdC70vuL8cwZ-f3tMf7z7PgtKRPQ&oe=6A4E4CE6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4h4K9GdvoAQ7kNvwFNjv2X&_nc_oc=AdrytzI7_ZViYTQSbLIyN5nf6pZOYT_7SyMtV4DgEIwBnW1xn3YiZ8FHL7JdCH5yVIk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsSLhGvddUIr77X7iwbkj0qM4m7a26eE4nEVYCGtMGVw&oe=6A4E4918"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xElPqL3yhG0Q7kNvwHzoiUr&_nc_oc=AdpVZXVZlh1Nzihfh2FYn5wUgQsp4DSFzyDactGkHfRntsef2YQ99iAKOJ-hdTwa9iE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCm7HxIYZP-rhT-akVxsJt0I30rplXI7PmOjNj8EQH9w&oe=6A4E666D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Yx4CHonuDcQ7kNvwFuyGu_&_nc_oc=AdpLP-OtFem7b4cxeE3Kgzz-myXpI3akdgrCtWUkG-tbUkNiP2PoVtAuJXvBt3Fkr8E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3id1LXrsQ-tMGkKSfDgXXueVuxdErimN0VnWVovXhYQ&oe=6A4E4CC2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeJd84_tju8Q7kNvwHSvUPU&_nc_oc=Ado3YEdoSkLEj-gbM7UuNYM1Leo79RRa78CVBUetI58zHbjC9P1ng_yZYlVFc5C6a_E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL3I-HYWTd-7aRAa6iUnD1k8IPhD4eT1yY8ZpIApJHLw&oe=6A4E5A99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C75abgmV6fcQ7kNvwFp4e-T&_nc_oc=Adr9q0P8Em6UCRJ3JGFfVmAY1nPt_6AeNU3-nlm6nKghRxEJU7gXz-askcXrjuqDKX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATSySwdXyFiLhBZbT8F7uUUu0RvrYLkEaBaFPAGq_Gdg&oe=6A4E3B6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPJ1E6SxE_4Q7kNvwGKdXtI&_nc_oc=AdpG5N5cnmF-F-2OD-yfW0qSDHrVHtWkONy_m7tgGA9lNXFLVNvc1T3uFX4RrL51Kac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAKwnZSxTH1n1mAWlAadSTk5IXfVV1qNdgeMRObLwZ0A&oe=6A4E575A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
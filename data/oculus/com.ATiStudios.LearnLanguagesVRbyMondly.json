g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wOGIWmCrm0Q7kNvwGNqptQ&_nc_oc=Adq5qXSlIqGZVMJ1tSH4wzJPoNzg2K6t6unBYI5CmH_w0nl3K097wIlwhTXFpOzRKUM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2aDh_C2b0qkG_LO5uRujVvLAgJSPSBWtVuvqOKZI8mg&oe=69C3DF66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZk6V4Nhg_AQ7kNvwGl9SJV&_nc_oc=AdpwRXhmPkS7Ffthlv-QXNiSsqHzGUDrCSxVlDjrRhFdMPyw6-0ZQsEdWPASu3_VhPE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVcfNsfYT0yLzX-GuBN6WxUYZcigs8jGKFEg5B68xflw&oe=69C3DB98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL2yomKpf6QQ7kNvwEFSMen&_nc_oc=AdpQiPTckyBbQpjF5kZOud8WHJ9falpg2JtmEcNtiNvjX90lAhwF9DIph7-j-fH-IdY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBfRKXg-X-aE1SvWsIqBht0N-JX-FoDyPe1EjhYbcjsw&oe=69C3C0AD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56FrIXodcnYQ7kNvwFJWoXq&_nc_oc=AdrgA3TMDGe_ApXWAhI6gNTdtznvWVI8jwCaz9ZMm__7c_LANLfoI77xtF-qybw1eto&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1OV0ah8afdTQZZXJzC6Ynlvt6AKzUSqsQM5f1k59Sww&oe=69C3DF42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwQK5omn1GUQ7kNvwFMjZI2&_nc_oc=AdrIr7P4y2xKMmHELuFXLtkJ0LrvRWTV-hOTr61CYMoiP-5fD_aQ1BGhLoQ2WJfx_3w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbeV06FT64FbQXc2TV1QgHqyHPA_9xw9CM5Wqoe7AP4g&oe=69C3ED19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqfx89NioiMQ7kNvwH0I0of&_nc_oc=AdrKbQUjoakkXNAkihdPYMW5z2oj2rEwqAGjMHB0ZFYzAt5ErXBekt-N6sJrAIElaoc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdANFzIl4f9df6cNDXZgbeBbtNycBwoaTvzzdItXScRg&oe=69C3CDEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS8MVfXuTrsQ7kNvwHU6c7Q&_nc_oc=Adp6AaiheTp-BIJqg83bRpRmlcJ-THb3YIpMyl9BNbP-xHxQ0YwwfP4uF3I_yN0WrCc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxvt11wR_bIXTRo7NDyKU3CZ79yDW6WK9NqwCvWZ0x4-A&oe=69C3E9DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
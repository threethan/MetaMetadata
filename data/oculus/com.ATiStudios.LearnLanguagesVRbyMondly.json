g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnnAguMB6qkQ7kNvwGXRJIp&_nc_oc=AdqkAMyBio23fH-GU7p5psmO0pOrVD-jDAKjQnV3yUbT_cZ_odRr-faiGAnavseLrjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6noYnajFjAgSPdaaTLrDrVy4tlBnUIoZjrObY3mlprQ&oe=6A5F7066"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI3cUHjkb14Q7kNvwGZ_fgU&_nc_oc=AdpPltv7rKhKFGdr-Jur44WtqsYsP5iuJOh2JDNFS0w4eG5G0-CRUZrDOJEdvqAVEtU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqYQV2fwJJYDge7eEJW3jIW94SKCsk-aSj5zbLwjijRw&oe=6A5F6C98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z58IBE9B9zgQ7kNvwFb0dPu&_nc_oc=AdrRuR03UUbVgAVYXVaOjN95GSERKpa4o1JgH3Xg9hU0fLy-Ok38vSjf92lkB78kZ0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoQwo5z3PqLEb9aTP2UovcQiB2wCGeD-N--VzD9nOHFQ&oe=6A5F89ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyoQKbiAKxYQ7kNvwH17hXo&_nc_oc=AdpZgKu3LcfE_n3p18h_YAXGUHEAENPmniOaYQFJudb3rLtC09KeAal7XoSRMt97dsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA11BQZlRdkLxRWosSDpzKF7WKz0GN5Ibr23k6HN1X81w&oe=6A5F7042"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ial4Irm-5hwQ7kNvwEvLMu4&_nc_oc=AdqbzcPPYIsqHxvFZ69yKQH5dOFOHGAd930RS8ZmRkSnf1HY4BuezHRxuBoac1Zsbo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9aoTzoKfDUXPKpjKjI2MNeaHia9eYR0BvAxVFV8QLAw&oe=6A5F7E19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R11h3ep-ovUQ7kNvwHLuAnZ&_nc_oc=AdqbHfsdhqxsJjtwWfPyaBXhEa7wMRdJ6joU6U8Uu0mSJ9I_TSX0myH5F3Q7LescVbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkvDPuMBtEWrXehdx6KIuUIhRainsQ4VJdc1vBuWTnmg&oe=6A5F5EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PssplJe3UBIQ7kNvwF8ruMK&_nc_oc=AdoyPKX5S0NZJkQUOwJu96XVu6UC_EHUXgolzS-bDCmOEoeAtbCiLhOIdi1LOxwDp0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDembY7U1j4eNFKIr4o5FMMov2jv2vmmxozACwEqJW9kw&oe=6A5F7ADA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYYPUJZDJE0Q7kNvwEeWRmI&_nc_oc=AdpuifYrwJH960T8mcAE8H_-TtnruWo_92z7yaGC4C9N1_DnpbUsuBCNLbgcajmIOmU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nOxhvq0OLSChRLLT0t9kPuothFmZ6FP4Uv4v9zglweA&oe=6A3FCC66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7trpKLfrE0Q7kNvwEaalpC&_nc_oc=AdprA-njyTQjv2e7rQVZcfY2eRbUbZOkftwRasVEyjU_ilj9kxkxm60aieEwqJ-WOb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qu4XvYf4J9jUj68XkdBHXlq5hQwahZKx6yS8ymxYGYA&oe=6A3FC898"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuFgLmVxwIUQ7kNvwEmpgSu&_nc_oc=AdokOUFWxgMIBj7le5e1l4L2yAaSToYpcjnJmHzEGTRIWam9q8QRLX9iLfor4Czkm4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EoG6kXWa37tPw7KvxtanjdVko8Spl2-TSVxRD2q7qkQ&oe=6A3FE5ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41cQGdPqpOoQ7kNvwGubdeo&_nc_oc=AdokJw3aY4iLBOBExBMePzsjPysOozm73pY37RJ-IwuKK6eLn5-VK6Mib5O7Ep7F00w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TkuETtPe7RONR4UVipHn078X346mG96RfyghFzbLgKw&oe=6A3FCC42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzBA_1hGveQQ7kNvwEg0VPp&_nc_oc=AdodYJnNSYFqU7KjF7RP_JZ4C_aGTWmgfSFlc_A8VBLsxQHjAZ2wTXYjQNttk_hdx4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cSkbgGZLZu2MbMVgTintplJxBldzwfddJOWVa4WjChA&oe=6A3FDA19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdmMzGhVSrEQ7kNvwHYsnyL&_nc_oc=Adqr9MQwtMRc-QepUiatLAhMd6ufThuUZ0VdHQCtFipfm8a47p6CskTVQRQsIP8IyPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lo_ILv9ra1hEbKdY9R5JRrgbtEGaHYyQJ9_AKW2sdvg&oe=6A3FF32A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1gH8M3b8SgQ7kNvwGwc5h9&_nc_oc=AdoEJOp89Zce3ZWReP1p4fnYmHvw47yC-fWXu9TXxQH5c3aR2vuIYE2ol3x-xRkOEao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pS72wSiBjyV3cfZBwrhhLNhGfZBmonVmrLvhg_8cTug&oe=6A3FD6DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
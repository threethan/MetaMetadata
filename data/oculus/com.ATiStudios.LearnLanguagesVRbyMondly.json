g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUE6ZGptxQcQ7kNvwFbe_Fd&_nc_oc=AdpgUAVuR27s_7P5rk2k88txoHPLII1uiNQ9s_C-PwKVsDAz82GGmRyC9E81iGitUlQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0A2V2pzjG3z8gLoozU9BfqV7_MJffpuext3Ri0JqwBoQ&oe=69F5F866"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddLTdaUzshYQ7kNvwFMC5ai&_nc_oc=Adow7RYw10MgyUgC9q2WGUnvMIxG5UIGu6mCsDCN8_1vhcSEZIGUK24VISubT3Py5b0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YIO-rpm_EnsfCk5IwlRZfsThTGIML_Cd_lqKYj-u6VQ&oe=69F5F498"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbSD0Zwd3G0Q7kNvwGCorae&_nc_oc=AdqMUGbDX_7hZYmGr1IauZW020bo6c3iUDabFKPEtU2IhNHsm7FXj2U5po-6KEJK7dI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UqULMZ2leOnxGN9O7e1KKHCKU_5YSkw8EBTaMz0T-CA&oe=69F611ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyDp5GnW0VUQ7kNvwGR1UhQ&_nc_oc=Adr3YNx9xWCv0Waxuy2FrX4XGSFfLr2F5G_HiVIVsxDYl83BQsCGPOkIbPovMAFslzY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13gbtJWXYY7uo8fxfEBzh2Ityz746j02RjMd3w_XVrew&oe=69F5F842"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0q5J4Rd1TAQ7kNvwHMRewG&_nc_oc=AdqwgMKIzshJrjqpuEfbhd3v6wnmWFhiq7ydGshjvfRUAEkohI0oTa3wYEGjzE_RnN4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0p6pU8_nis5XOIuB0j-q62naQZRw1eMpglchXcpzv0Vw&oe=69F60619"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA8QdNrMJZEQ7kNvwH0rrA5&_nc_oc=AdrbkB4rErVPMia8ldThVtqjwqRBk-B5X1ZEuTfGoygEU3W6FH6SLDJ0ItWt7MMSbds&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gV4qgIlHQnmDgrVcsnmgh-aF36axreDzMavDXIlv6pg&oe=69F5E6EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDtvJHTf4TMQ7kNvwHbJ43S&_nc_oc=Adoqjkw8JjqiVWRrlQple4EfUFfW3L4zty_0VGFjvqXggpM7D3xCbeIBZzBrLIl_7UA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pR1LlYyTNpaZ4doLhgYPslf2tCFY8KoYHwD-tJSchjw&oe=69F602DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiINCoYv-IkQ7kNvwHigqaZ&_nc_oc=AdqOKEnLz_6c1hxRdOcfS49HP5h1XTybm6abIrW3Ae9jNRktTEfkO_e9pXX-6W_x3cE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLNoMXg0FdMXBFBjt_lT7oq457Buntg2X7kFr1oDPV2w&oe=6A9C1566"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke5M8CxWo_IQ7kNvwHs9YZ7&_nc_oc=AdoRZOVybnnPbnbYAt1iEyhBMns033YKo9rSz_aSsaVEPaAnjKSg2MOcY8RrccfeLRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ2UYScyhU0WABuh6uMJNR4crSaZyD2bgqsG5yLPkzGQ&oe=6A9C1198"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkgCI4uTLKgQ7kNvwFsDliJ&_nc_oc=AdorQ99DPqtyJnMwQSQlZ6cYvYanSceDsuEmxvoCNgn1PpOMA5LZ_9cLy0XAZFbRFk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIGoL7SGGoMx45E3gfnftgie0C05yUgAMxj2IO9AVGfg&oe=6A9C2EED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-Drjec6QYEQ7kNvwGLj_g8&_nc_oc=AdrfUrxlADXCtjFZgDEtdIz3DB4CrHv7ikZJpL7s82pNtZLYw9Wb2PSYlOrM-oGuU7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMNThhE7r9051FE1O9txrONv-YL0lhzNhHrTimzBuPoA&oe=6A9C1542"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUP3iTFhSJAQ7kNvwE-oFAM&_nc_oc=AdoyL0fN-TKTa-Cg-jWhXkWUXkQzU62HAcm5NtNkCdq_Qtg-pZfkDOT5eiXB42OIZfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlpVtouYuF-lIqRH1zLNX5OQeoukMtf-huHNkijVelXQ&oe=6A9C2319"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nGoSQco0ekQ7kNvwGo2e7C&_nc_oc=AdqjBVpBZUY2wTklnMGbDmqS6vRPbG0PFpGIj6-OfOk_aiMAuY-ffUWsQCdczruKh_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAhsVDDB_94PMlETJ-63sSmxymMXf4QdgUzQD-16dmMg&oe=6A9C3C2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3NICOKR5H0Q7kNvwHmjig-&_nc_oc=AdoyZ_FhZ6LE2ovweY29wjSQv87hZkMHz11OB8ND8qIg0VQ_FMOB16RROltYrkBg1Tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJDlL7Ycm8wuHIva2bN2IHdpBAmFOU-q0vl8LHbLG--w&oe=6A9C1FDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
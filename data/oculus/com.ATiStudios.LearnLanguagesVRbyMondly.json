g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfJqoc72s-EQ7kNvwG-PaMJ&_nc_oc=Adp-c7w3QIdozjK5DER-PGRFgVLn610XfynWeedrcYUrlllknH0RkI7hMIb1LaarWJI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsgF4IRkQxKWteJmga4MdoZZPkk1iKDB1mifwmYrcDcg&oe=6A5392E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1IjVIymFA8Q7kNvwET16OV&_nc_oc=AdrT8zScE30QS5NHGxrWWFh9FlTeh6ywLPl9fuUjRCqDEX5ZcXhpMUCQhZHpv9BNlwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8vLbjwhrAWUZ3BNknaRNaM2qRbOJ1y5T_OlHT5bw1RQ&oe=6A538F18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xotv5A1dma0Q7kNvwEEsaxF&_nc_oc=AdrzAjT5IgyWBnM2pj3ffWW9YwWDdP1mEpu91ruxzSjlkK3lkYJiR9kUETj65khjoEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqJP4Yj_p9iHC0T-avwLRd4jH2-P-_kIu9uQ0A2oBbEQ&oe=6A53AC6D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm7jeH9_iDQQ7kNvwH4RyKr&_nc_oc=AdoqUuRG0QuOuyebPZiLgaVqvy7ngLL5Ou7VAqn-O259xJzZaod8INAjolYaRNLmoPM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQk3Joqa7ffp_Jp3rduiT1EpRSMhByxj11iDjbd1UNtA&oe=6A5392C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNmfKeFzni8Q7kNvwGDEBbR&_nc_oc=AdqrQuqRlWJXqzDmiCsbJUIaWouNq0JKFJM4FY1m0_Nfi_sc3wl30X_j21NfNTUqq6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLaN84gw_tDTzLOlboET_xyPBQ6Ci76sWP2drXqatF7g&oe=6A53A099"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRa2TB_cEWMQ7kNvwEZpU6p&_nc_oc=AdquKLTJZXyuO7dl9DDZ_hMHCyhKm0WuJ1UEGfrB5hd3_1A2hcysXH60wyJOosZ3Sa8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLTkIHRGNBYWa00uD5ASjClOUXwS6NzVfrqGuZb0IcCw&oe=6A53816A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOchgmnlCl0Q7kNvwF2O1A6&_nc_oc=Adpbjfh_Rm_uMvlvUpFJOMcvmUrWH3Ptc2hkLj_QCEe3uKFyWAiLRmFpALt2jiDIEs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvRE7_YYDRbaasvihUbJ48C3WrF5Q7pAz6wy3zHmyCPw&oe=6A539D5A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
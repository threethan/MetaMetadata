scdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT9S-Wkfr5EQ7kNvwF-y0CR&_nc_oc=Adphzv8-urvwUx2_QibTGZ05IgLHNeLh0ItHHuOq7HDvceIqsW50wxTTwAL_kqFClPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlmbNRlOLWERCadardaHFAHSsU4oPe3X4ji0fgWQ4FcA&oe=6AEB3D19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE3zuEY0wwMQ7kNvwGLW-yp&_nc_oc=Adr-aE4gZ8k2fkDramt-qzv5KIEY5HAFUw0kEr1YeF8pAi-BYG3fJUVPfXFNxmFVRoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrfIEMykkrDSXw37A-24kAigujysPMytZXfGxre8LjBQ&oe=6AEB562A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZEm-hLo0OoQ7kNvwFrM7we&_nc_oc=Ado4J-62xmj4R0OzogJQzTz4J05g67KeQho3mBJz2GAVFEm4zns_81NuR1EYNDJ9BLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzPMKawDHsaY_D8mO5lvjW4j_ioay5_hgv5Rg4tCjUnA&oe=6AEB39DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes":
_icon.png", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6ttHzD9B7QQ7kNvwF3SL8S&_nc_oc=Adqfby7sDRhd8JtO0d2Q05mLG730ZucFOHA3DKw41A1GUOta0p2P3QiBP6moAMQSVMA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy3EgxZbpen1RnKBbzR-iGq-CgOyDw46WAqzQS55e1Zg&oe=6A7DC2E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCbkwSB-eHgQ7kNvwHNXuxZ&_nc_oc=Adqt343LXN4_2SageOKTlIJNVvHd1ly3-Pzk53r7HjJZPJBKrLuODA-YXrIEyjdWIHU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzXxJS77B_5hg2iruBHcHbDc26ry_K67cuet5fgCbrlg&oe=6A7DBF18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXbiL6MPAjcQ7kNvwGFIIr2&_nc_oc=Adpp-ByRZk8d4bmTpLGqFy7yMyFaiHBV4NscErZKZ34NOwqTEUnOPahXHOR6KFB-k3k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkszEImItBbYYQFOvyGezmOt7qVDfG0z7tLbqJFMO6pQ&oe=6A7DA42D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h94IVQC5_7oQ7kNvwFfeUVI&_nc_oc=Adp3YTLHjgSBrbnQ6u08ypA6oZ4bnJXfjNECuWMHQ18_eEs6sMVjeha6xeQlkGbVAlU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGugkyrTKwW33Rw9UNH0clxBSKSez_nO_98W3da5u9wfg&oe=6A7DC2C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkkIh_70pTcQ7kNvwHhZRH2&_nc_oc=AdqmcvZo3jiVTmwKfOIPEe81NgM4kSX5NYGEg1w7hrI_h1JVmHCfKITJq2YgbXYiTtE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxKkIzyD_lA9pT8X9ObEYN32jyAub0HYglQsud-d708A&oe=6A7D9859"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDRLyxdFg4IQ7kNvwExH9GA&_nc_oc=AdrM8-2M9IM3OxDK0ctdFPdM5gW3GZarwICXIXe5arXwv7otIy1gyjPJ4H3ETVkWbh4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNl78ALTZ1tRpT4tSbJxWNBOHx6pHPzODaBc4XxXgsZQ&oe=6A7DB16A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7jWcbdD9tYQ7kNvwGGkiIy&_nc_oc=Adq7BN6aP71cShMioCu1q5tUQNdkpe6Mweliac30sHlO2EGMbgtrGz2Gtr5FqxHaRGs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeQojABGE4-O1u-2OjlR0qZxvdI_hM8VLYay9jNVyQaw&oe=6A7DCD5A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "schedu
g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ5Mzx-elH4Q7kNvwE-XhTu&_nc_oc=AdoUupumUkhh6qnO5eeZBiNI20lh2qlMr_9JJOzH0bNxQSh2Srd7pFJqYB5gpYjF2tg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNUaD36_SG8zIWZHBsSJAuhxF8x8cYjbi4UT6kdlEyFg&oe=6AE88C66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBYRTGkInGgQ7kNvwFu9fnM&_nc_oc=AdpNPGK4AtyK-CeQu3mBkfpGzjhwDcaLH2r9cttYchEkeF-6BSYkoOf_TVbQQgZoQNc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRluajoWy181EgIbXrQMAabFIXfiX63l1auoTBWQE7V8Q&oe=6AE8C0D8"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPSyDyvjgtUQ7kNvwGkh1yj&_nc_oc=AdoVWubg2fOFaeKmsmpRBCAPe8v7IUCVv277hcfKGpqN28xNq1iSw3DEF3lSMrXJt4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3xYW06MWVo9vUA0CPxHuJem4rFncoc_XtkaA3Psm3ow&oe=6AE8A5ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V2Fi6l85LsQ7kNvwFlZTqj&_nc_oc=AdrUffzmw7YE965E6doNhm2cIfjvtcuHgPwgn0Gz5CPu-6Ngv9l8igCZNXv3e27P93E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG6RrwHHtJ3twGTaJ8Q1UyiYUMXqBbRJWFDvRbXxJg9Q&oe=6AE88C42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b74NxNQZIk0Q7kNvwGXkzyU&_nc_oc=AdrUuvkpNePKXvWwTCLU3j6GchA3ovnvQzOHvjuo4Ta25ZQtB24WjlN-bzc9lLIvwLI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4nXePo1Vc1U4X-JKFr6RAXwo8EOgEPPdbA1Pa8NxNew&oe=6AE89A19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE3zuEY0wwMQ7kNvwHnI7F2&_nc_oc=Adr-t9GtPeb_HSCNeT1TnQ8-R7gD3-xaz_MCelXUNy3VIUNRqdk9D061VJhxa1RjdY0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFkUMnYJPoeDM3GjFilGvmoD--ic0Fn7sA_oRNLNjjDQ&oe=6AE8B32A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3vvNxqlyUYQ7kNvwFErq5n&_nc_oc=AdpW1nuOg81w3_4Bm7K-ZX9OA1B1212JRpzvYoalUih57qmYIOiHuRetW7wcLK1stTk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgQkwKZwv15QC2wKk4Sk_WihG3NOGwN7jMFkHybDhR0g&oe=6AE896DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
-iad3-1.oculuscdn.com&oh=00_Afs9deJcj2klRUSkiXNXtrLzT90AWXKxjQnUaTaImXb9lg&oe=69A6EC19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHiTu-s3YVEQ7kNvwG5GbII&_nc_oc=AdmqbNWvfEKe_QTGJ_OmjAggbXUk5boD76gCyEBF2SwCPBTxbYIyvu6qCroxiuvPw7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKT8jwnbuDZEw2ejJkxTydbuRSV6WJ-IqWui4M4uVVbw&oe=69A6CCEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRoHngFFEbYQ7kNvwFlON3R&_nc_oc=Adnv6qiyvuYQgpuBSRzewoOoTLfcEeeUsDCuw7TYRbf4FBD8XaO48c9CsOcpbZNOPDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afubt4U9g55K2fa9UfMoDT3q2kxhqDdUnH9boEqV0JTzcA&oe=69A6E8DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers": {"count": 30, "nodes": [{"status": "PUBLISHED", "id": "25137289765867250"}, {"status": "PUBLISHED", "id": "1338345423847281"}, {"status": "PUBLISHED", "id": "426949773844072"}, {"st
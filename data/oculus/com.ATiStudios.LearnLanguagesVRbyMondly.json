g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BopNlzeU5oUQ7kNvwHm1NLh&_nc_oc=AdpS7pkfKWownCIhGnbgFtrFeJKGF87SyOk5ly_77EX62N2wCVC-lqFOjXvLvFB4Mds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RbQm732UHgVRNHUGZoVPi-XFYJZqhkk7NtJR82R5S9g&oe=6A0478E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvjXX1EN5coQ7kNvwFCNTWP&_nc_oc=AdreAcujvkphrXmdqjDP0HxfI1WQnn9LKW4O2SY2S97Ylou13Xec_tClfFNNW_W9p_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75Jf1WWUSqyEWTupv1Sfjan6L0l_SRhooUEAdT2UiNgg&oe=6A047518"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xYUFT2RbUoQ7kNvwHwM1NJ&_nc_oc=AdoYREcNkpWhDGZYsPPKKh4EybPrxXmlOl862SiRk9POWDLo1kdFIvef12W7-d_4sGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iJVp1IeSbQXZ6VGE6YbUSfz1145dbYtVtb9pa-smk1g&oe=6A04926D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGPzMFA4QGoQ7kNvwFA_yFq&_nc_oc=Adpr0lW6L6qJmlM8XXmSWrrDP7fZjupXfgFdNmbYpbhkvrdGZ8eQ--aJjjz47krTC1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-IGCmTuScr_CwOrEl2zDvvHrfNz05-tB7nj-uHqj1Nw&oe=6A0478C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGtWNRSX_OIQ7kNvwG4aJvO&_nc_oc=AdomVZLOxWWpdriJt1q8uva7aCXaYZ_qDO5iWq9P173qlv66iKlfyZ3BdHKlBbJ80Gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55aZgJ42DuxkJH0T25zOgy7eyhFJ_PH6RuHnzahIeSdQ&oe=6A048699"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG--xy_E1hgQ7kNvwGwTE9i&_nc_oc=Ado_wYgWXSejKIbRXvimb0gQET3w03WOhzxT5qCYTpUmO5t0XpQnHkt7xz2SzCYU_MI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CgXLY8woYRxXI9uSg5u8oQNm-mTgqAVYrmP3dpUpQeA&oe=6A04676A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=691Dkwz-1sQQ7kNvwElXwqe&_nc_oc=AdqCxycv95wnhe6f6F4UKHdgyyDWYWW6_EFsriSIrzvARsW5kgDwbS3vgHaCC9jPwKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jxck-p5F9cmvK2n836NhKpYba5TlG8A72v3REXbgBnw&oe=6A04835A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
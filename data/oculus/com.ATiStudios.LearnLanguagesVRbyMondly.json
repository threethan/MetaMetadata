g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfJqoc72s-EQ7kNvwHTFBE0&_nc_oc=AdpdCqljfaov14EmuOCFmlpQCEuPy439cauDFdtPVQMkZIV-IR9m-TuReCAJfUGKm3o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXSDqdk3AVdJW-8t3LXH6Cne0-Lw2ru61PJHANRAdMeQ&oe=6A54E466"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1IjVIymFA8Q7kNvwHUL2JL&_nc_oc=AdoMStUqhpsAzCyDHID4lYZ-_Fj1VjAXqknlGAFKkZvX5z14UZJW4lSED07cnlgsDtw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFd_eXOWM4oE6_0pjfK1kX47nu8MivLHHundos50zMoA&oe=6A54E098"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYjN9ajtS3QQ7kNvwHwJbCz&_nc_oc=Ado18nyBGD70lFjvuyfnXCripuAHomRxFRcqdgdW4LxCkgeD8sgFSX41J6836ELtnEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxdouEAZMDmWGEw2m3f9yyRnzsIostOKNFm5Oo4QGkCA&oe=6A54FDED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm7jeH9_iDQQ7kNvwFaxDAD&_nc_oc=AdrGp2dJgKACge2Dzx6uV27OwYcnc9HhBodE1-jkohDNgDxTigPn2zeixZ8Pixvpfd8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpi43c0uS-9ASszllakn1195696ff61KmHjszMX4MbkQ&oe=6A54E442"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D17DhT6JfMQ7kNvwGNDlfq&_nc_oc=Adri7uqHay4vv0_WEKsuANtuWHm9tqi5S4T1AsGqiwK_WivekeKYOruXEIStN-BkWB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_eOU7MVfx-x-X-bS1cJTsJgnuCldhIPSthnbqbqOzSw&oe=6A54F219"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRa2TB_cEWMQ7kNvwEtDCqP&_nc_oc=Ado4AqJbnIzGUrnmL0Uq_Ms09up1x-MFxqTJgqoSKzjoIikEF4kjXppfKDFj_A8B4WM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw-X8H4WdGKmpk9VTxZd5uHCw3-QwwaogrgRRsnrk3fg&oe=6A54D2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOchgmnlCl0Q7kNvwESmvW4&_nc_oc=AdrI2ZxyTzL5QMr20KS1zL36gFyE4CXXLGUJVAcPNG0DkuWIqpTwIiQQGACrIXztOMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIa6652sitGGjQKLxL-CxWXCz827f2OrFoZVyg1sjDyw&oe=6A54EEDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
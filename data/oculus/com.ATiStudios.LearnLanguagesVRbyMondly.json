g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npR6hOZ5qZcQ7kNvwGAwCCQ&_nc_oc=AdqGtm-en_bogrX10WHVMOH9oJHjvCYF-oAPGySWE-4iPIJm6pyRUZkwF-pjC35W_0Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxi5bowEFeFpe4c3RiStFyyum5uhkWUFKnvDbzJ2qXUw&oe=6A942C66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBjR0FVteocQ7kNvwFrzUFY&_nc_oc=AdplsIR4DkBm9kaxI80XeM_U5v89pzU1akympkY9b3oyNcuXT3sHi98u0I1EdeB2pxk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVQKI3c7OZ5ygGfj-Auj6DLnL7kjiLsK-8hL16mMhHrA&oe=6A942898"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aBLd9mR15AQ7kNvwEqTVCC&_nc_oc=Adryof5ylld4uTXjkBnLS7DlOzOZEjrc9jHj-MwhrEeoFeGJqlb46CMSxnqKivqaYDw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM0vOJvTcAWfnWZH7u8mSo3vl9zyUhKucFZdH1yLxT3w&oe=6A940DAD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr5Wxk_eLZgQ7kNvwGTtmAN&_nc_oc=AdpXv7Zkh9KzTstwnUu_0lQS7sYossRpCWOrXFAlzmJV9Bl6zu5ZnchVjYhZOwDg-k8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH_klA2VO4VXBD9P2nqSkL7zxWeIfSlaLUbuVvNctxJQ&oe=6A942C42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY3Ostyw8lUQ7kNvwHTieVe&_nc_oc=AdotxwfrM_2iooYSzBX-Dv9eZMsgrJDIAMEmQeXj68g_8YWTx7AL4W-ThDXj_71TaPA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnnhbDiz4CG8YCNiZaVfTXjggC8a0oMlJkPMHvC25haw&oe=6A9401D9"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGeXDKkTsLwQ7kNvwExZ9xL&_nc_oc=AdqQnrOnVJzLUCua12LbnAdTZ5MRK8xcnwuc-0fsPe1MJxJOtTWgXnHnmnZ50JCpjoE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnQm-VnnACAq4k0POvOZn8Z6lWOaLvBQZidTj5cSYIgQ&oe=6A941AEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq_UpHOdChQQ7kNvwFFPwH9&_nc_oc=AdoznDasVyn-Y-2-tbudOVnw-h2PqoCe0oOSinquui7De3Ju1iuP18Ac2xcLHa3qpB8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIY1rt0qfG2ABTdyX6K42uk9iaN9uiHa_wqPZKFZY5FQ&oe=6A93FE9A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
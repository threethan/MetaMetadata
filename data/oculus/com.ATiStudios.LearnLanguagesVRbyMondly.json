g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGGSt63v1d4Q7kNvwGELq61&_nc_oc=Adqq0NY4sB2GwqLhUCsIqVH2r_WdYxPU48uPJd8n_dJkSIZun3xtAc-PLC5Rlx99O-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jxPvrdOkNL1pOkuCAdkqjebLN8cAijoISg9gcVT6MXA&oe=69D502E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxm0KnTRpegQ7kNvwFY6Np-&_nc_oc=AdqoctoqVQtEw6WHx3dhyiYchxpz9Hf1fZGN2birg9IntYetOlmLytSjhkTQPamTAmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TFxIksPokLyJvOQlKPMGdQtuRNldUHbGUZt7HGHJLLA&oe=69D4FF18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDLVoFdjZL8Q7kNvwFI0uvq&_nc_oc=AdrCBzwma-ESukwdKqYFAucogSHt6wuhhVwlWGMAh-OuoGBl4F4H9qIuxbpya8tsFqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FtxRy0InUvUd6XgE_tQX3KnUQI4zQ-ZiEKTeVu39wvA&oe=69D4E42D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37Ubg4m5txcQ7kNvwGF_G6P&_nc_oc=AdozpXM9cyM7MeJ1VC_OcU7CB8LzcmVh-A6egze5xEohOpSoJST_MLZDaDBdXOPiLzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NjvPSTOkjA2spmCyDzHYHdHOKbLhKzo9ULtxvyEYwKQ&oe=69D502C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnVvkQGQMaIQ7kNvwErZyLe&_nc_oc=AdoheCJ1THlkn3ilOo1n_7Rw1XtQgsqFJHr1LL_9xB2PShJzOYDaZ3uggdGvCXDnhUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S_pqmQpEeuN5AiRhR-LXXMUmWFI74kGpBMne67YYB_A&oe=69D51099"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmHBaar1LN8Q7kNvwHH04XD&_nc_oc=AdrHRfhH9lbD6PYWZSJEBxEJlkHLOz0cvQ-QywVzt72Rw85m7uRgMPLJrd20YzGtr2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YdYCfrfRG3ngMh6PomVCOkbPUltK7FnGYTPtlwro0NA&oe=69D4F16A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NshvW0CeA9gQ7kNvwFOaO0Z&_nc_oc=AdrYpe_1K2TsyfAWU--ouAcAST3lUic7j3kHuVyreytoIYQNfa2tgRQXvz9amH6zo_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l9mc0Nt7cAe27l9bK9Slj0q97htqti0Il-ToYUvyzVw&oe=69D50D5A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
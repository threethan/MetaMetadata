g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXSg1TVygpoQ7kNvwEO3e3g&_nc_oc=AdoM6C_ZSXQXhYc5e8WakxCHBrgr4I_8YaqSYpDOWehJoMr6lLrEeRDWUf1Uuv5ywII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLYC1oHQulSa48Izipb4l5j4UpsFyE2ecN8jd7SRXzeg&oe=6AE0A366"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo0HDuFd_eUQ7kNvwF1sUz1&_nc_oc=AdrjjDBw9Cul3KRKV9U7TokDGnEBaMdcMRNin_aTclPDDdw5J0Sx91af8Z090QiQ-r8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJtwm3cbqXTofG9K7RdLGeFlHMiiYQWZnlCuKzPclbzg&oe=6AE09F98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYV4TvnLuKkQ7kNvwHB3DB2&_nc_oc=Adrr4ILI7J1kM7HgtV2r51yBNF1CYNqu756F2o9bhfaO7TQsrRwY-HO48b8LtVFcvrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8itDd1e09bmmbq1WUXD9g1tEYmnA3Hpry2p88WJeY_w&oe=6AE0BCED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLA6lI9opdoQ7kNvwGrBTZ0&_nc_oc=AdofF0aIDTUS8RWp3fgriEjleVRUBpu2NF2ah65v2j8YMIjJCUC_zTH3CuLCYXySdyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH8Ehod083pu29DH1g0vQ1hT1KGtX42NJourKISERnKw&oe=6AE0A342"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iemn44QeuZIQ7kNvwFf_tIt&_nc_oc=Adox-Nzt-xYPwSVAUqYaBEYmH2QIojsqh45HzV0a1ZBZy92dKNAzciMyb5hgEhnVSrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHCywwdPFBmPdC7njWVa-p5VFmA2r9awKTjABnP3k2xA&oe=6AE0B119"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgdq5qP1lAcQ7kNvwGtlg1m&_nc_oc=AdrAJmAAf9CfC8_052QjRuBeFzNtqNhtbIw5RzzUiXgw7T6doiWb64xP1fjT2RkztQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPxg7X15s9qBmX6BkaoHlsy54GUdRTDzaBBq4wIrWgCw&oe=6AE0CA2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie6XWXZV1rwQ7kNvwHwvQjx&_nc_oc=Adrq2rWy1Zh8N5Ij67Nq_ePWMOT-St1QY4idQTerGF4vbArBgpe_4MhOfMrnZFVd9_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOTiEhLhDdCv7ferNRPfEHtq5w1id1r6HebjER0gVDJw&oe=6AE0ADDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
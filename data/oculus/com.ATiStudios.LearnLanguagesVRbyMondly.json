g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lddzZCAl1u4Q7kNvwGSAKwu&_nc_oc=AdrqILgntjidT5FIlCCNQhQ-fC8hN__TDUeeRbtsfVnqLRIBpBR5bwifhhBp1Vd2oVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nbl-3rfxSfpo1TqZlAafn3c5-pw9xr4SEEvu30uDIAw&oe=69DB9A66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV84lF7uUKcQ7kNvwHRBfgX&_nc_oc=AdoPC--WYUctTGZq6v4NsWvTGf5W223_otcP-1qIJd2IJzoDh7lefZPcLCBfEDqDl_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04XruCZpt1lK77v9FVInc6QTf0ADekZ6Bh0yNEjVuqRQ&oe=69DB9698"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8Vdr5xgfesQ7kNvwG6TgZK&_nc_oc=AdovszYWViZu5KtKkoDgl90Rweou3-iimiqb7Rmh92ZLdS9PHBX6SbEGHxDiUdTLkd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12k_TRlFHqpM5yNwuURbVC7ZciXXx3MM0bndsUYXJeVA&oe=69DB7BAD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNDyWbvV_TIQ7kNvwFVRD__&_nc_oc=Adpmf4cuSgyE17br8RSoweJ7MyQhkgq7_fApM1JtuSGA_ZTnw9kwm7Deq2TKYIX7w3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Hm8Ti-NRrqIswNWPW037IqyBRQH3ATKjv9r7gPVE1wA&oe=69DB9A42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7K8ktb25TUQ7kNvwH9J7ib&_nc_oc=AdpnBtV24A4v53aloTqqlY4nbA3IfKa9epJ-HMebT0fSthNr0j8aR8OG1sGcGV4sNT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gsBwYzAfttCKccR3aV2HdTregM4fZcKCu5mQYKkWQNw&oe=69DBA819"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFQK3Z6kuUQQ7kNvwFFb3ST&_nc_oc=AdoMjLM5DeWxIHDRgym1nXB63mfoqsdFwt4VhdEuMSCU6QDbo-FqiNH-2URKPSyilyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WmDzYlLPIDNMit9mFH3Nu3zaNVoq_t4cInb_x60R30w&oe=69DB88EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHdSTb_cIlsQ7kNvwFEt-JN&_nc_oc=AdpfmBJ5TGR5OHPRAytdcboPHshO1g8Ga5U0N9C3SILp3d_ZV9X7anr0HMuXs1wvz_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OpQVQVC1xHUknGx0_jHUSsi2SPeaika9Cby4vbejxgw&oe=69DBA4DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
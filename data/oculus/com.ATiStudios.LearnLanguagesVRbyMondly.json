g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKN5_Eh3xjIQ7kNvwEkjYAF&_nc_oc=Adp4Rk1iCjqnClLSiV84u5-dAnJWZrLhDPnkfDLxKI5Jmh00YCxV3zqP4q-ej6p0pwk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWxupHjz5kaEVffIwfewlrNQqWvl2eVSx8ud0uCDqZ5g&oe=6AB67366"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU8YYkzfXK0Q7kNvwER2-wN&_nc_oc=Adrh6DjakRQ9lGWDHHIeAe25eRdqY6eTtjliqZ6xnJNrIKy7swXG21Mwlfa4eOEbOPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUUrTY3bIAfpkCsLv1OMtW24yjGYs0vfmAEtlsf372aw&oe=6AB66F98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVLCYcLZWg0Q7kNvwHyO4n0&_nc_oc=AdrkwOQcaiKKrOSj1FTrp4wCnOo5lVElM78nhdy55LuAvgD9JKbFBHO4dLMG3PCQoww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUUW_hOC6cXlBf32L2AEox7TK95bZsgc1LFtyycNDq_A&oe=6AB68CED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHm8-gnOolwQ7kNvwFYdRPy&_nc_oc=AdpE8JPutI_Ol1jcoUfd3awpldlFfCwQreVzU1-qa01Bl9PigXBP8Ku1vUmwnqU6WIE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6b5T6O8dhKiKorQYgfqy8kXH5EQtNdms05fd3Tg5eQw&oe=6AB67342"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI4HVSBk6uUQ7kNvwFgkN97&_nc_oc=AdqqcXPY0iy_9N7pUtZmmaAt7qcT9idI8ryzgeOBO-iIVXd21xvZz90jn-rlButwvFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRMhgbWLpzg5w_UPwuENONFuNHfe58nEOgALVaz_X_oA&oe=6AB68119"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hxxfdn7YpkQ7kNvwEFv4OG&_nc_oc=AdrX9U-5G-BO8bKgJ46T6FtCnDcnirKdnYBk2JdWs6_rKQYIxdfIcDAM1DPV2DMdPgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINycMNjnDQDKkTVakqj307LOwpxkaIqyyjeVXiObSbFQ&oe=6AB69A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH6KlQNQjhcQ7kNvwHPHLtA&_nc_oc=Adrd6KsWGgU5e72X6bDtGxscP88PZPlZ9ALPOaXBp3vMtfXtFo5_Td7Z4qjlLSk7934&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN4jZR0NoxPlwG_aTXPC85480Zn1DjCWsPuzUYh2rnIA&oe=6AB67DDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
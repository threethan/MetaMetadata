g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6WdqWj-yUoQ7kNvwF201KM&_nc_oc=AdoaofylefGnYPRrKZukzc4LDEdE3pwBwzwNoYeKs21vZuRagYWqjZ1wGKJu41YG2JE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rOAyHvFC3evryjC1ZDFmq_k1bewiwgP5RqJACt9Pp2g&oe=69EF60E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF2Ra9g2E2UQ7kNvwEFcviu&_nc_oc=AdoZngjlLn1DdvjB_q0zY018vEXFXq1Xia1fhiNTM8viXEzCv2qXvJOKl0fmAHVgT60&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Dx8zxPT9n-HA1D-OYGWei6bigyLJkxKm8HcHQdjwQcw&oe=69EF5D18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFGilPgGA3IQ7kNvwHsA5LH&_nc_oc=AdqyhzJW8B8GuB_BFjBa1WAfyJ5RCdwduM5UvZCxQE3XfZeJ4EQ_UTxdKdPuUTV_Ul4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zBphZRs6xENyzQcwslM4pyKeQkBHVQnEV-X1s2ZPboQ&oe=69EF7A6D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP2FG8qVZoAQ7kNvwE2nnS_&_nc_oc=Adqeyvf1ACZqkGH3NxHaZvNkxjfBxz8a8rr8jvm8cj1gan_eKL1SMsZLLvxO8kiEnmw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3u7bpK0tRisEp5b73c1a5j6jV5ufqY1UX-8Kl0z6WoeA&oe=69EF60C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUCca9F8tl8Q7kNvwEMnjET&_nc_oc=AdqQNZVea56zk8c2CS0rr0E7atYygM59wYxgNWuHjWyd3aP3Xyw8rCadDfL4uC6r_gY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11yXAYUCSFlTK16kwzHbzdXJHinZYJsFEiEyCgYmRNSg&oe=69EF6E99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCem4CmI5qMQ7kNvwFHu4x-&_nc_oc=AdqROtTDOPnS7rw8AWMSy4Hc1FnVr925xLZS4HNembsQe0byQgqbfhEeQEA_PTjC-ow&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af134shGRCbonwcQYtb8bnONDag1A7DUsi_vT5oTpqSW9A&oe=69EF4F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA5nSoJHHXkQ7kNvwFMR0Jw&_nc_oc=Adq4YHJaDk1N5_K0b3KlzTeFyRnO4YvPwskmy4nXoNxVaPSWPTaF5dDogZKxCoP9sZ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jcdP6dK5uAWsFaN1BJE2GZJCLwY98r9HTOzZ1PT_dcQ&oe=69EF6B5A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
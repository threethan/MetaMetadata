g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aymh0wXCkk4Q7kNvwGcij9V&_nc_oc=AdoNozuFaMPzWj_maO5M62dMAIJnwpAS2g--zAHlnZ9Vf-5bdtaQTqWYMP8Ke-25TEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXoc43p3we51ceyPPZgLhAaIbQaN1t6v3UYsqNbxI4gw&oe=69D10E66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeYJQ60eDk4Q7kNvwEaPXow&_nc_oc=AdoXXRVf8uTpIMdWd8yAWqa2uG3HiTWcYb5um2AdL9wuBcMA_mceckk_gajF_EgJgSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwanOTr6OPBXIKnjGWUrUMz3r9qxak4I2becE99joArIw&oe=69D10A98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRweFAnY5fIQ7kNvwFD0BRJ&_nc_oc=Adot56foACjpL3IGKs2Y1aTibdKXtHszw-ZqsbfzRdK6E2FqDlDtKx4KzIPxbj9fxM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ3xC7G3CpUIY8tJkhTBTjPckg2A440RTWywnCNFpPbw&oe=69D0EFAD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw4Rt2_E1YsQ7kNvwHYChZH&_nc_oc=AdpgG7WaN-hKO46uZ-aBh32-0ZfU9oseRVSBbAld5x63HBPgo2u8cIcnTrkj-aLiNYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXau1bD-Bgr0-nU8goLFCPOkIL6tnimqTA5LGy4f0psQ&oe=69D10E42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMDjl__lHdUQ7kNvwFN0-DS&_nc_oc=Adp4UNi65288twJ955PYXaPL_0tjgx4NB1dfRXQtcDW9jhgHIC_BkWfBY9nHm11h-Xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-mHenJdxUEDFBngdXmevuN2sNANb5CWZOKMt4qqE6_w&oe=69D11C19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EGH1-_xEY8Q7kNvwEIJjvz&_nc_oc=AdoYNlp29ZKhi2nWf0-hUEnuED7bEQ8p2mIq04HKTSA-mKkK_sMNSn5_oCTY60gamzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkAsl7JSt61VOw2DMsyyKqbreTu6FPZeycPsJLSW-hGQ&oe=69D0FCEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kANZiHnQUC8Q7kNvwER3r3L&_nc_oc=AdpJ8k-cC-KJF2GH8OVhCD_KeoBWnw9Cb16zAmTn9pLGKfzYIIdzJikunCS9vqr9tvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYGojuo9xi-i4qXCQLVrPRo-43rPodagJFuRCdwoFlJg&oe=69D118DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
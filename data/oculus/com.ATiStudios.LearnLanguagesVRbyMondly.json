g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khwhGJZrf5oQ7kNvwEqK_cm&_nc_oc=Adr1-nlbf8hIDaHzuOF747YGYk9uYPx5ZMZyhNIxG2w-aG57NrLPaMNWQpuhXYOLXUs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPrHc96SekQIRh1f_ou4jrv4_eTie642LhE5f1Oo_4Lg&oe=6AA15B66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_N_nHkHs3QQ7kNvwHoukMI&_nc_oc=Adp7ZknuGrGzG867Aex2ItJDVvSYHmDO6Lktjeayw59ND35S9DdjkbMnPYXXFuGY65M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg7XZA0RhO5aFlkTD8YNIpra7CgLK0z3Y3cZTz-jqpww&oe=6AA15798"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWyvSFTXzPkQ7kNvwG8B6-U&_nc_oc=AdoJDjMs620Ctw6yc7n4LRo-XkcT62GuvKV-YCfkWC2AeAtcON8fX5QkVyh0i9bqGBs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICrKu4AS1o-BYGEspDObDXZAKmYqlcdi1wMj1En-3gXw&oe=6AA174ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFVpvZJ4b24Q7kNvwElxqni&_nc_oc=AdrzxZbCpbAWiMLu0q0JH6-DUl-Jyw4eCTRuruCnZkdMUDTGXhXDMhnBw-d5fGXBf9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5nxIsnfqRSvLSv5hhsIdIS0AsDqU9L49cWZQFz40Skg&oe=6AA15B42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paUDq_GvnRQQ7kNvwFNPu9h&_nc_oc=AdpJZ9aa_qSCm78FxEsUBixdB9RyN4Vrki0gzb-vy6cOZE87DB2tINvAcELUDWU9JBo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPIBg9LVbVfkS-D9JyvLjDgHWvlMDIfBlzRJrWBYlvSQ&oe=6AA16919"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_cv9LcYPT4Q7kNvwFamN-2&_nc_oc=AdpeD1rjGRr40qS-hWE7FuiASY_ztyPR-eFEkoTwU2ZgAZiWhFnvmxNjEs8FALIohhc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcfAIbVMy-jbZHRKBpq-ltHaup4l15qB8rlayLXvovXw&oe=6AA149EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DS7dhK0ldd8Q7kNvwFYAij3&_nc_oc=AdqOWi6fLdnhN-3r3DHCxUNJe8BYb4qZ1CT_VMGqYmYOwxxVLAJoIHnKKfzeYGdLQhs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHELYE9o-QNe-6psB3B-142caoah_qPwm2u5-rPNNTLg&oe=6AA165DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
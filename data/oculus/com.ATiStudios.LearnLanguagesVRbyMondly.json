g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1kZNBiw4V0Q7kNvwE0SR3B&_nc_oc=AdrZx2KugIubPvyn0Um2B2TkRtGon5lnn4X1KX5XFYVUQVdRvCHfgAli-B7L0-x4TNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc0_dgoXJGUFBR4gfQd5G1Gb4Pd2udzSD0BcLexa0kBQ&oe=6ABFADE6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfyCJXU9llUQ7kNvwHe57Sd&_nc_oc=Adr-ZPzDlrfkR8ma54wxEhyrq9g3OPhcWk5ptxKrHePBsBda0YWpwZRr39C9lyqgRec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPAwckF1_2G_CnBoGAVV0n3rS4s16hQJIZvZHj8wYaYA&oe=6ABFAA18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06f4EJ35rhsQ7kNvwE5nWKB&_nc_oc=AdrQSjOgCkYNb6Mfsj9fKh1HwN8rf0RfyRMXnV9rZi6FLa_EVUiPMBjABHXQ0pQJ14w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIVOtB9UmazPgP4i1NbzaUOt_R7fmaamTEum3C-3IEuQ&oe=6ABFC76D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRi_JJq0-v0Q7kNvwE0L33j&_nc_oc=AdqBlPE0c0xJDhBJ8sHFO7RnR0BG16cAMuHjzkAVjErcHVoX9so0IMXOG0eNh0aynHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRtY0arcH3mEA-O4bWJoV5E-RoH2i_kvhj_GEK6122WQ&oe=6ABFADC2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okksYZPXnowQ7kNvwE3RC4N&_nc_oc=AdogWHeupgGPw6KWVlnqI3kNVpEGG0Rw9aEHCxdYGKVdid8kiCiOEmC3Pyawz_yGkas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKVFTtfPgcudxLvQJCovwMs-2iouqG680s-bgHnvNhpA&oe=6ABFBB99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-jnd156ms0Q7kNvwGaYmrr&_nc_oc=Adot8vssw3bm_qFV2FgiqTSPGQtsRsnQ-Hj4Z3YuhCz4jkWUQNKIMI2CH34II3L9DSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2jWv89EVuoe4SFoBywRWgB8LolNQVAALL28YdTHWzpg&oe=6ABFD4AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRV_RE0p_FsQ7kNvwGx95jH&_nc_oc=AdozVn52KUCs6yhxgAp9VNbp5PcsZLjyWejjrB9EjYdfRdQ4tjExMIEaIvEqUNk7gbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWUWM0-LqjkM3mJTuaxp1gaGiuB1j51n1gdm3ejJpIHw&oe=6ABFB85A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
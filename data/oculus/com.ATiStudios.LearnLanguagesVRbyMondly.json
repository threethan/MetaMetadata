g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogy5ObUlI4MQ7kNvwH3c99k&_nc_oc=AdqAMK2A4XyOGZUv-9jOZ5Xne6P5xSJtItotNJ1D9z_Fk6NiQHaw5fxzT90TJouojrg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQaTG2uvgostJodqEXKgG_3BbThYMQ6iEL1srl3q5REg&oe=6A81B766"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOVnjGi-tB4Q7kNvwGZFr8z&_nc_oc=AdpYsa2IVPvRYQBacXKYsi0nwGeL_xLdDRw-q_HE1526PZQPlbaqJPqrI9DUeapEeS0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxlHlB6F9SLGWXdwDlD9xqg8BR4bYXRztH9ylozimE_A&oe=6A81B398"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8gkkSxVcAAQ7kNvwGMbnke&_nc_oc=Adq447S6dc4r7VRoiI4_06_1tOboJKKIp47bzTIx6W4YZ4AaaINWT15rJn_BKFgy0Os&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT9FLquOeto-SBXggbhGXhjV3JJ_tsIzxcEdUQ38J8rg&oe=6A8198AD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrXJgq7LrigQ7kNvwFaarnq&_nc_oc=AdoRRb_ySZwBr5FpmoHjyLDNp1k3ztGxPDHMAX6xkj6vp1uYzPYdhg1WioJEnvkKqFU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY1JAE4Wf9iRiSv0k7N6KHwdhS0CdTvypQ0DfHGpADYA&oe=6A81B742"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMYaQPnRTYEQ7kNvwF87jGd&_nc_oc=AdqYjikf3Bt4JkXNnWMttiOv-6Fx5drz7H-Gf3D1Dl9pHh57blrbRtO9l3phLXF3UKQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENAOsorRBVQoift4S3Kk8f6J5bfS2gQ5DApCrWreR2aw&oe=6A81C519"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hjeBpATrO4Q7kNvwF-pO5C&_nc_oc=AdoAg8OQvLx72gZrPe0PHNU00VFrde1DY-rEMvsQPicn8HCo0aK5bESZlB8oYC_ApYo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSG20uxoRSBcDW1ADqsZi1IzIEeNLhXaSEKjhy37vS9A&oe=6A81A5EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaIxOKEvv3wQ7kNvwHpNllT&_nc_oc=AdocmEZLpFEURin66OOwrZfiASMgkhkSEGhJavatMPkqN7WxCs3Nc6hnJpwY-x5bOhA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFovoHr9E4tSBjB1LODJQ6aXg7TlHCRfauVv8nRCuUZ0A&oe=6A81C1DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
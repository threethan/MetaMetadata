g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp11qdOuXKkQ7kNvwEFv5f3&_nc_oc=Adpxwpv_njAvx4H-qt-S6IiaaaBBWlMrUxAtluYJ0arFPsoBUenidQKaIx2XNTQPrhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_db3N7Zz_-zUEVegLcEsTn1HNg8sah4HRw7yByORkznQ&oe=6A37E366"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDRrxUhq-5kQ7kNvwGxIHuB&_nc_oc=AdrH0GwGd35ypfOPCXANtJJk8FU0n6x3rS5XpQZv7tAmvTLBi5VrbwT9qu-EPaM1MO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UGfA_KME-xd0mlvGFoTVfr_NDCISlOAQP7i_yFswA8A&oe=6A37DF98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnhyTPXXe-EQ7kNvwFeIHhf&_nc_oc=Adodw3tKLZtVhywBwQRbibEe_6uAJYKfAn3QeBWT6po8uZjM54B280Zna6DVe_5Nbto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0EZwDPq1SeH5c3ST-JzmAlEnSwu-zX3t_kgBlXF_5aA&oe=6A37FCED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6yNxPzZEpcQ7kNvwErZ6nU&_nc_oc=AdoVg8sm-_sZcHMnLg0EtTnncw4YM8p9-XX8H4CfreVbHomcLBZx4xe9FUQ8Wvsg7MQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I4LS3-MkSkO6F-abCJOgRl8ECo2OFZ9ErHDyGOgTR2g&oe=6A37E342"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYI8bPkofVUQ7kNvwFaKU0y&_nc_oc=AdoT1yg5tzEfGwmKY9J4ciahR8z37e3eymxdPDoZ2zvUIDDA6cz-Vl9gkKkUb6poNxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hHt0BlUjlmh7Cc9sjP_tJMZTrQlCfkgbD6qGuve1HpQ&oe=6A37F119"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GjhYbyfNq0Q7kNvwF97We-&_nc_oc=AdqL779xbrqKh9swln8y7iGNRabqO7jAKd9VlagjOHlBqZwS5XPXNujiGV-LDMrwVUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ev-F2fq2gO-JHBSwC9L3HJGQs-e7ey2xFJ5IS1Dhazw&oe=6A380A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDJ_IgRzSScQ7kNvwFTQHwL&_nc_oc=Adp2RP-Qh6_rPo8s540OiWU8zwfLKFWlbKibQuSDyTQ-2xpZKi2fGCpd3in_o8_-VMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sbXOlnax6H-r4gGB_uOTTjYCUHkS52QJPwhZG8CbRvg&oe=6A37EDDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
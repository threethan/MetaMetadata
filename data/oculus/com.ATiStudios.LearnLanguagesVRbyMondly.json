g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SxiRwu83V4Q7kNvwEPSRez&_nc_oc=AdoKbKeANFNbIqZBa9wegMsg25MJFY5Y_nfsgcywAQwBWUA9rfPzAGsgwCjGLI8Z9qg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL06eO4XlOG1q_lmMDgIX0_yFZAFKm9jV6I6JCoQook9g&oe=6AA009E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZCb_YbQB1wQ7kNvwG3al0N&_nc_oc=AdqhSziGjrJWW-2DedsLb0kKdWEl8p_hby6SDRPglhPhGXHXdOnKnyi_gnmgoOr3jJk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6buERd5IWcaM7oNmHlOlJx0PZ-tG3fJa-GipC1t57BA&oe=6AA00618"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWyvSFTXzPkQ7kNvwEcLfWQ&_nc_oc=AdpmvCzydNg7Gw7-P-s5-_FAla6AQV3BQSE8Fj2hS29ozBSEp9VOCgxP9Y8Tt9zm3JA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSoINe2OYT7ymHJQ-5V_2RcaHphfzrR4CNbtMW8RZizQ&oe=6AA0236D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFVpvZJ4b24Q7kNvwHC7aSU&_nc_oc=AdqJCjhkxi9818wht_iwfaBrEuz66o1uD7w7OYkoYHhpZz5-nXGov9pnlgP6F2r5rG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs_EOA97FRWiY0B-vEXpGiClCOtuCz1r5yr0IAoOnWkw&oe=6AA009C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paUDq_GvnRQQ7kNvwFEbECJ&_nc_oc=Adq0enWWVaycXp5PQO0AziKVvBZPQGmU_HT-glazxMct0NBvz0c7hRFnpXgOthWIeUw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvdp7swC3Vlrebbc6LmufHo90bmYquRyoqe7lKM20NRw&oe=6AA01799"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqJPKGWAxeoQ7kNvwFZUiTu&_nc_oc=AdrSgsDaw8--UJiyBtYW6-7GPojYkqg4jaXvOjLW35CJgrkSUgOEMm65j1ajT-JD0aE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJFZjUkxdKjEWIU62rFdbg4xmutT3GvMgALGcQjlfD2g&oe=6AA030AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DS7dhK0ldd8Q7kNvwGD_c--&_nc_oc=Adqyr6ulPA62b4e1v7u0e1E24JDof0TASo7oEvXEm7gh_KwodB8i68rTEVqF6Qos8Jg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB6GTmybblEX-pMGn1txpLnqSsvw7B5yvx8pwavgSseA&oe=6AA0145A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
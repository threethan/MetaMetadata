g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJNGJipI3IsQ7kNvwGbCIqL&_nc_oc=AdqcIHE20ZbttE4vWHkKFcM8P9m9P4nGIHAz9tvf50d09EraEjaJtDyF9R23AlwzSmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4e7PtBcuPQ4In9wVc-_Cx81-7c98wten5v692-qKE_g&oe=6ACE66A6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6yLvkMAoywQ7kNvwHP0LNL&_nc_oc=Adqlc01kfxxNrsFJLb6hVHvBiVVZXrNwyW40xx8I5Zv035AeJfI5u4h87Xw4eEXuEoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXhAhm19ozEhfHaPdX6CURl30tkuRhZY2jS8IvTzmlsQ&oe=6ACE62D8"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dmAvUbOs8YQ7kNvwHDcDfo&_nc_oc=Ado_XQ9ebr9XeZX8dfrVHU-EQF1IWHoQwFm3oyavFFVKDWamatus119lcubwHiziWi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmbPe26K8SUNSN8yVo4X0iaW0CtD5jHjxcHuNiP7fe-Q&oe=6ACE47ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h04EblW3shkQ7kNvwGpAfv9&_nc_oc=Adpl2lxEBkkP63oMCaUs7ASyYCXFK2j7vlSSJy78AhVdkEPsfS7kkF2TJ08fRNbSsk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6QC9Ph08sMvY1hYVNNquGArv36vly5PNKXRN1Mxy8yw&oe=6ACE6682"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRCTGEt0ZmkQ7kNvwE83-Zi&_nc_oc=AdqVH4Ij8ujgUUGLD25eNofTdFVx2EQ9JlvSi4EsIujn80qgBKKaqFRjLG-f9aH-fDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNudODjduwi-sBl6tRYfHNVw4rYHC3jXrTf2B5PZ6HNaw&oe=6ACE3C19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnaUpEP-6AAQ7kNvwEeedlk&_nc_oc=Adp1syut6QT2GwKRneuaGQHlnTKKPmwVIQgCpC9iVk8-u5cebydyHPb96QF8TXaDyRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8K5TrtCJ16hVzd-U2Di8zfJ7eRfMUjLjzcWef-g0PCg&oe=6ACE552A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBdrz2yB-GQQ7kNvwFsHHyX&_nc_oc=AdrMjRbpd5wVN5g0FJ8KqFjjBg5kz4sCq4VL0DLmqFRHGcV6bifPVSGUBEj5tQPHfoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0_L1THOxfOX6z_1E2s0jS7_8DoGczfivHQ0ZGd6gY9Q&oe=6ACE38DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
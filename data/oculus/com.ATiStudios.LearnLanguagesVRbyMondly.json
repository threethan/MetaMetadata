g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEnx9C41UGEQ7kNvwEz0oVd&_nc_oc=AdrXQDRksb-vc74iTk2jBz13WBtk-M83VKmUckQZbWueektgLNwIhJ7X70XJErSJsg8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IfCPhNySuXjuiw3dWtdD6NN8M3qoHix3rrU2E8RaiAg&oe=6A2179E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6W3sXGYGRYQ7kNvwFQscJ0&_nc_oc=AdrCkFYurqG9H6HcfAIPvZ5OQ0FMCRvpP-loXlJcMjXT9rzVtQskoL2_T0UG7QA-Q3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FafjD6gH5wUbwQpIGfFMmB24vKwFznkDeV2TdE27LCg&oe=6A217618"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38va4RYUz-gQ7kNvwFT-oJJ&_nc_oc=AdrlQax1tzQ5rYLwlHPCyPcE0RJHPifNwIbF-9F40JpxWYxnOwYayFEC2XqOPz4jbh4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_hySo5OowPsmudGSXGM992l_-7MiEDtAsacEvdzJTpQ&oe=6A21936D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chkwjgp86wUQ7kNvwGAdTgR&_nc_oc=AdqrKYMWa9ijYQ9uxz_QAhHwo1hPP-T40rccQicNusjr69avRZsSkGusAWNK3tsDpkg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iZpfNrbKUWiLRSGyC0QpzVwTXCJBTDYxTguGwoneivw&oe=6A2179C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFbq7TmWahUQ7kNvwHI1EQ7&_nc_oc=AdpSR3OuFbiPLJnWfcpTTe6T4XUVh-29GPxRCHu5mgTUHUBDijzDtX-FwIApcTOvNbg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SXngPROolsEvZkmZL7ppeacPqyul1rydTrdG65zPVcg&oe=6A218799"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p91nMQ_B0hEQ7kNvwGyfNgw&_nc_oc=AdoWzcxiFgr1guvXoGs49i0GwRhzDVGqsRtJ0q7B_2LItAxyf_HVeSbXfIPEm13Ovbc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Igpj24dKFSJeP_nOHF9bmU-X57BA0x_4a24m_aO0SVw&oe=6A21A0AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOLE2wwPSosQ7kNvwEHr1Aj&_nc_oc=Adq92oYJasbx_Ic3FkqyeCy_RgDx-gtja2IM6_wWcx7bdCa2ltTzCdhMvaW4nKCANaA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b9cGZhKWGgbkaSoC98YRSunLXrfHtorTON0GlSpKoKQ&oe=6A21845A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
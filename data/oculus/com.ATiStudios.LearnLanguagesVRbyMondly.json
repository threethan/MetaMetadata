g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wOGIWmCrm0Q7kNvwEy5tJS&_nc_oc=AdqDMesm-4clvlM94Gtt_XqHjdovsTGky0kq1REnf3NYggovWyQxA2e0dwygyABySmA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-cQ7rqF9v4h2i5oXHDbZiZy0SGWpAytZmJnRwkLLzJg&oe=69C68266"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZk6V4Nhg_AQ7kNvwFlgHB5&_nc_oc=AdoEyc-FbqPzZx7tNLnjgDrE-65xnDD4Nm2NGmhRd0c435oSJWBkL8xORPh2Q1OHlOQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0azDOGyoIjFzTcjIQuAZLbL736zo6iMIgz4wUKNDb2Q&oe=69C67E98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ9lppDaC-IQ7kNvwEVMRwp&_nc_oc=AdqaVuEvwpXdRepSLcdm8bxT_76g_FwT90CyMEajrpine5Jwary-jMnEkRU98RblCBw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAg_Wv9koBedcNFfFSyElNDF6JhfJRTjA_Ez0F3dauAg&oe=69C663AD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhPRVtSi8Y8Q7kNvwGCvW5l&_nc_oc=AdrSdd9EyT1sS4fYS3dt2O8l1r1talB3UQEKK_19P3PF--qNjAZ_WQOeiZGHaC8FMQo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl9uhNpbT9gNkmSW1Gm2dBEIQVeGewiLxfzauZ7MhCCw&oe=69C68242"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUPiNDZadQcQ7kNvwFokWJE&_nc_oc=Ado8x7rZSOhEjMTs7VXA3xpobhGPRMTt9xiWlBBUZJCqZk22GwKM2uMJF2SDUqFyFnQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEhPjUv5rpR0Fg69G30C16Ip9KOPJQ-r3QRNWoCbKl2g&oe=69C69019"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqfx89NioiMQ7kNvwHsCdra&_nc_oc=Adr1Aeb332a26wwdvTphKm75Z9CslgCBckpmsPjFWd7VWOWP38gtRqG1eoMLVXCnvlY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRSAIkZ5h9EK2il0wlsM6sjp47yaS2iqXvnvYDUst4zw&oe=69C670EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tHYYfVyWtoQ7kNvwHlntVF&_nc_oc=Ado_ec6u4u_gQXcDPvKssgQvr89NsiplEfd-MA5aljah_SaXU-v9YvHWiboG7rlxZWM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjQ_PwQxTrxwnS6yfu9fIHpb6Irr0ztQhcb2QM4kT5RA&oe=69C68CDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdXZKgjrKOUQ7kNvwER5jlT&_nc_oc=Adq8mP_hgHhBk971htSUd_iwlma8OpjH0YJhwiIr_4B2V8ITZ9QcQ6KD2hCgxvOJMnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXJR8_UDVAGO7zhinocpQNOb1faOw4_X1oF5EZdYWq0g&oe=6AA54FE6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voMLT_IhJqkQ7kNvwH_8MZX&_nc_oc=AdrJXV1f5VTFF3xt1QtrHK2FNnkUUeHCdTej1D36GercVPNi8GfzZcwd1QWvJQvKrxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3_U-FQ16mJ5G25NBQinzJDVOkI4Lp-RS5qJ7vXAOBIA&oe=6AA54C18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUP6k9iL9jIQ7kNvwFwCZQ1&_nc_oc=Ado2y6JpnU-SiaDaO4N8yBCdHwhXdIRuPSqZW8reoAJFhODkHxqVShKzctZaJ94nuKg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ01sS0UweebNHww3o2z5JnQfwo7HtZbhRn_VRny6JyYw&oe=6AA5696D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pkerf1ZC16UQ7kNvwEZsoZC&_nc_oc=AdqlF3plP2vcDMIz4C2uPI6XNMcu0S_qpNPrPWROpuMZiCqjnz9aJFc8dFz_5YFdn7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcvhEYeijcqOQWELLynv_q01o15-EoSTiaCRcbsD8i1w&oe=6AA54FC2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN-SwHc3_BMQ7kNvwEiKPR-&_nc_oc=Ado9xsvpNW85SvQ55NWjwQl3C9sPycA0ysC6v_koEHbZYMolCka_0WkKYx5jCSlUxNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUD9VhBydA0iIbwLL5FwhktstZA5qclKtnT4X0DbmDjw&oe=6AA55D99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYvCX6EeagkQ7kNvwG--PBO&_nc_oc=AdoEEu0qYl0c00qMxqkL9AkvEAgm_Z07eygwMHFBaPHURSJNkUruusXQnW0j6p6RMfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9U4WuTAjxhTamJuo_eXRUqF3BUByGGoKajvz1pMi_jA&oe=6AA576AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFLEaYXIhM4Q7kNvwHxx-fa&_nc_oc=AdrotDJ3lOx1YODeN2DQ38C8YViSTSkfRRR3fiJLToLfbOsdIKxrAaNUnWizZSXRaO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP_LebNEObeMTmNm-DFEF_xawIRAEVk4bWZVYdMTe-cg&oe=6AA55A5A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
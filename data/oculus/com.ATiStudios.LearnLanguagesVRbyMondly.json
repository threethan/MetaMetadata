g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaSZSs2ES1sQ7kNvwHCFGKy&_nc_oc=AdrZvV9OrYndzGwdIjQzudH0CISLwMxFZ4Imv1oeZd0sk6sODPqd51u6J3sfb7vPQYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MaMDvCanBVQbaNsUJENJQ9ZNRAJfsDoQ9LjaEd4H4AA&oe=69EE0F66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVye6XUCiQUQ7kNvwH58p3R&_nc_oc=AdozYxZdWDE8Wzta6IPw9CyIOBZidK1b0Bum-yfXhpM8jOYF1-1nq-PmZZn2evdqTdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-fZuqzV7_VZHHhGW8T6TTEvQYn8beynNztK8VBbZF9A&oe=69EE0B98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFGilPgGA3IQ7kNvwFh2xKt&_nc_oc=AdqQ6A6i-68nVvLSPIWHuM_W1qY4BYDc5colw-G5sQM-i4TgAfpYLjxKQSRu1FZoviY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rybGNteAfHcNdC6nJW1iEcQQWWQhHAjDxybDbfLhU4g&oe=69EE28ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP2FG8qVZoAQ7kNvwHboE29&_nc_oc=AdoJdt2ag4TkkYNWogV3SaozYMdCezMspxltyOJBuVHsc52Qy56gPWLwf9264Z2LzvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af276j9v5oUX3fhkDqgbEmFktc4JlxaFkE5d2mtVYH46mQ&oe=69EE0F42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUCca9F8tl8Q7kNvwECb64A&_nc_oc=Adr-S4ctIHtn_ZXfB_8kymAVMIl0IKrCPU2aCDe252KtP4FGVDr_H-tvvDh29F6pwQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eoSttWo70ztnzrILuVlzFVv54uAdIsUgq9ICsAjt4IQ&oe=69EE1D19"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TcSMKiq2gMQ7kNvwHkoZVw&_nc_oc=Adrc1WkrjYhXeJbSyznnwWlLe78UuKlghJtjhGfSHOwLvsZtgmWRl8lNkBieLAJGaD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32lU8u6wrN1L__w8jju8tZawsRXOhXcSzKkFXzH_eB9g&oe=69EDFDEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA5nSoJHHXkQ7kNvwHivPuk&_nc_oc=Adr2w6HYAQu0UP2WN26su7Zq_CqnHTc7rwjo6VRq_O-u76Bn6odyQnJ8gNghjckB9JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wFjZHeNT-WbdER58FZ7X8CAwXtXPs-gUXG15Ca_wdWQ&oe=69EE19DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
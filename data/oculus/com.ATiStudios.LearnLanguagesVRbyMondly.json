g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbHQFU4SZukQ7kNvwHXqAPM&_nc_oc=Adq1cyOnaFPQYmDUaolrhRmQKzWdTUZtsWnGC1yjvIy_lKXKVTUYHyLKgRyHJm1M_3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqE-mVOljYLr9cRDMFnf-Sk_RGvYaT2pNOg0jbh-Nh5Q&oe=69CE6B66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgvAfY5FmfUQ7kNvwFwCEeR&_nc_oc=Adr1V6oMfHoDanUk8WeDaojmAzbSnHvX2vJkXd68po6JjKPGVCiShY_FjdUEN2_pNcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAUTPLaQn1x0uUF9PQ9nXya8RX1l4Icrpts5xMP6hpsg&oe=69CE6798"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRweFAnY5fIQ7kNvwEhQCGQ&_nc_oc=Adp27vdB1qs2iXQfNuaRB2Fvc4AONtnvrflCeDYwq8DyOTvn_HJMguK-3gq9e0cagQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwif2BVLMbRhWBfd2Aa75h6lxzju8lh4Nt-kxm5uBiFvg&oe=69CE4CAD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjaInVk9PtIQ7kNvwGILmXo&_nc_oc=AdrGTpO6rco9YvVx1dYb07fTT_b23DohmINsJqnO3iKHSctIUdLNFU2mTAMYsAUJhn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQoIGgtV6_0Jzgl7rALNVsBnuJE6B9zz321N_XRT9hWw&oe=69CE6B42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMDjl__lHdUQ7kNvwFJiI-L&_nc_oc=Ado7CpNZ8q1WUSn-JRfuco_7GghyRyV7TlWplCCO1hl6oJNdcvmRM3RTJwP-FFa6LEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhUlYitGUNaADBze8bsXValH8S5hpcYdiva6-a7lWPeA&oe=69CE7919"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdiAjOD9ST0Q7kNvwGesmvC&_nc_oc=AdrEtaXNYW8j9SBntwSL0VzJ6LTAx8tZrVAv9eBbmi9eo4Uol5kwLiN-VDKvkvgUWW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyrd5fDXz7HXVcm9VjOTGUtjHaxa71NirTYT7b4wumIKw&oe=69CE59EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umubuIMvy6kQ7kNvwHaM7GI&_nc_oc=AdrgmHBgc05wAqp3rP2dhoGSxQvMKOl22Nmohdr_eIFMSYQ97sBht3l04QAxuG7AU78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7iMYfrvdDXjH7kJs-iCzq6aM05uXk7bMbcY77ctm-EQ&oe=69CE75DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
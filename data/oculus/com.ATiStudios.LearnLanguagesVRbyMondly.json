g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVyz402ZBmgQ7kNvwHisngF&_nc_oc=AdoR-gDZYPXV0z6l_xYzn8qf3hnUEm_x-JqmYsWmnYUxvvtniGKPpjy83VsxS_yZccE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmLDwzLVsyGKgYvHWfk2l8SAi7YbqClcA6Tocm0IxzXQ&oe=6A89A066"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzKh_0KPJYQQ7kNvwEkDEGe&_nc_oc=Adpt3ALe1fpDE5uEIMKI1oJaycCUkonf68R5h0Hdjs48lJK8mYtJlkxtskm3Ph2pzKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2YrdTevFX6FGHkOrrCLRa_iVFNy8GN1YFz17eGYCBnw&oe=6A899C98"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg4VACKWFcYQ7kNvwHY4jS9&_nc_oc=AdrM7HxRckVqjbmsuGzWmBRW6dC3OXS47MDtbnxmIAn6HqHHHey-Go7q0XyWagvVrMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5H1fMFU1gCEZhajk3b7_04SCxEcMGs4ZYMtILT3MlMA&oe=6A8981AD"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnwqRcqBqZ0Q7kNvwGq9zKF&_nc_oc=Ado1eLN-A4umb0uCBRB8W4s1C3dRP3IBH6VK4wlaqoZzAWtthC4Zz4T15-ObjAAnjLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUc51jy3lFRaO8oeFBS53ItoibKfdw6pjzbcWOjgBEXA&oe=6A89A042"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swCLB06QHwcQ7kNvwEUj3L5&_nc_oc=Adpt8_Ry-1lnF5s9XP26NZ2A7iz9znfWYl5PV9pqloBg0kaxaNlH2XyB_BcngmurH98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7E764qrYbQ61y1_sgolhCMdfJNR-08pUzss6YwjU79Q&oe=6A8975D9"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A5d1lm86SEQ7kNvwFjikTw&_nc_oc=AdpkVR5KO4I-fwPojPRSvh2yRz9vhKEARxXGyPnRpHdBKP0csZtCBo4PfJw5nL1wuAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHIxdNwFiRekJj0Li93VKF00A749noet38RC8i4lpjow&oe=6A898EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpUGPoiz-QcQ7kNvwGHXlwn&_nc_oc=AdprLTWzp_Op5tZ8asBhSfetmjXZrG-SWIdDKObUTGp1qiDDfNvpgnxqjdCH9yaRgHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiAix6xlBV9OwpbAX0_06bdWXiQVAg9WILtsG5acydUw&oe=6A89729A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
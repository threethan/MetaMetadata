VR_icon.png", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmWyi3PkM_QQ7kNvwFbV7dp&_nc_oc=Adrm5OQIbf3b6lGl-4m_LDgjPP9_6ku41YYf1vDWg8ksHGt3YL8Z6wmH6Zf8f5rKGzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG23R0_JTOXef32ErGTazTXoEG-NpP3SSgE_DNTLVcv9w&oe=6A8D94E6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFqe7r0D-h8Q7kNvwGmTB1O&_nc_oc=AdrB_BR42QHMpyHd45jLPBCPRUyX4luBWvMTfsXJu-VS-x-srFOEpvQv-Inut5xQb5E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOxL5gFPkczoeBMM-lYpaS4ZwAQh7DNfL-9pkPmgSAkg&oe=6A8D9118"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BkWxeOkl6oQ7kNvwGq-5so&_nc_oc=AdoWwlxYeLq2lThgAgBkXm9SRnQ8LhsvnlLekxK-VlipGY-6TliCiT0U1UR7lbmUkfU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuNvJGDcID2LMLn0qTEoEcq2ddGrzohoyf37AwAYDy_Q&oe=6A8D762D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TpEVRiolc8Q7kNvwHy5KM6&_nc_oc=Adq49dW9wvs9EW5VG6QqRAJElW5l1ZRRwoDFFoGLinUnKxhrE8C_aZWRqbb7lO0SxrM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHq3oXTQ_0k6FEMVLaMcKOJnoS5abWyJgnkH0CUHTU4g&oe=6A8D94C2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0dCg2dL_hcQ7kNvwE631Lm&_nc_oc=AdrFzwsWpgAu7odTCBwXiyMA_Su8m2y6msQ_PuCHg45wiTUvbWYaBoMtKE-zTLuvCD0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECNq7-WOD-9AQvC-ySJjQ5-sK-O1pJXV_1cygz-Y_hew&oe=6A8D6A59"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUXtWxJ7sLkQ7kNvwH0S_9f&_nc_oc=AdqPy1pGqC6iZBZum9ROCp01S8O-e7w58e_apH-nIDyrRRcpr8iBeN0LtnWylL2LokM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh11eJmlyF0NYi20CQdgmP4kEloFO0KEHTEP-K_COktg&oe=6A8D836A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge-Jnq8CjsEQ7kNvwEDmD4W&_nc_oc=AdqWkPftwUP0W-fC3RJShZ8Ll2xNIAvoT_1rJeNnMkWo5gfOVmdrQPO-X40HXesFbsA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwQD2uxraehXODZLLdO9o_a5MG_AcpVjB3vn0jyetSIQ&oe=6A8D671A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "
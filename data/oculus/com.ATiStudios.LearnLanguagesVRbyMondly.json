_icon.png", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyDaABRyNzsQ7kNvwHlBC95&_nc_oc=AdogPQo0y_s5AT41-myc2A1WsXGOmVJtjSap8vVRV3uwozY-vWoDaA8Vhr3sU2dsZwo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XRnvsh_3BcyKb8j4DrSbVxBZt34fDPsipbYwGGCWafg&oe=6A2303A6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9D-A3gUOMoQ7kNvwFFd7d6&_nc_oc=AdoUkThbZAtM8kWtd2W57ABhZfB5Hq9QRaB3iQF5TFwqv97tGcGOQCHqxNIv-OKSKXo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LT0zuoUJPlzHsd9ChuqJYbCz8lnaI1_mRYkN9fCmWaA&oe=6A22FFD8"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38va4RYUz-gQ7kNvwFGnR0C&_nc_oc=Adq6aIHDXHzzHLk1y5bHK9NrvlK32cKGESDeJxiBYIhik28NlGJBYsyHqom7zB6n8c4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eHrPdnIYZtBCkJXEHFsJxWpF0oYhVFwi3s2QohQG6EA&oe=6A22E4ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chkwjgp86wUQ7kNvwHcEicQ&_nc_oc=AdphRaIkXVNjBiKjuR7xUWyAFRmdQxmMYJFVb2A_PHIMOuRpwOUM--A8grP-gQMRJSY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iTqpoIxrcTeSFJkNRRUH8RElyfA5FONtQkB4Y0qUhKw&oe=6A230382"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFbq7TmWahUQ7kNvwFUoP9-&_nc_oc=AdrL63AgFfwtzeKVb_o1a2xAwvaOXkdI1taTDtT3rdKNpHpvsQofLck3qe-ZjPm7-qU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9TbvM4MSpYZtT5EaO_XTh8qG3Ih4HGoHRuM60zcMHxQ&oe=6A22D919"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmdecx3DHywQ7kNvwES-vOM&_nc_oc=AdoY2M8t8SkQVbMbffwlI-RzEzuPVXc3bEt9-wIJB0adQU8Z0NP9d7ZozgRYSUysjvk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8It7QYWmcak1eCu_y3rZbrwj9RZnLcfogi2u6gJDmO2Q&oe=6A22F22A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOLE2wwPSosQ7kNvwGrPJL-&_nc_oc=AdopUxKjO4na6utUcne88WGlc2gO3AUmRPfMaoqJP9IIlzx3rO0X6bs33BSWm5vxZMk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pl8jGr0AMihckYtKuqXZNWKpui-drAskf1QIUFmUX3g&oe=6A22D5DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "schedu
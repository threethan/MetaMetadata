_icon.png", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBVwTYm_OrkQ7kNvwHb3gGS&_nc_oc=Adode2g9EPmZkIdGKLXRvHSaph-ndlkXQ_qxQTD55Te5tXCb9qDDpIW1jpi4S4VK3SQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaRxlmsWxyCoFX-g-7Qf_KAdIqtFA8L9yujguQLBc0JQ&oe=6AA94466"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7lIdZT03i0Q7kNvwFHDrVK&_nc_oc=AdqTaoHZrhY96WJxym7XdaBnxMtoDUM25SH20oy-mBM9bjXwxnC5qBiGrMRm0mq-5Q8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5oBVfMHq1bnlIAhOoZalIzcDETd3ksP6ctr-Xa-naDg&oe=6AA94098"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln8pGpY-YvoQ7kNvwGrhDpb&_nc_oc=Adp4W74Gyij14ulSQ9usiH2r9pCjew7Jr0GTSyYdZYB1vmSEa9zYgUG4Z2KYZCP9gk4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLheMijOvFf2H90NeTJXdfZ0_cGNSPuPRjeFSFf970vLA&oe=6AA95DED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k20rVkIJU_UQ7kNvwEGbQii&_nc_oc=Adr4GWEqqPkeYoBwQs2ppQaAvKJg5ef5CZl6bso_F0xG1AksQ7aYBOnHAQNhJwGNP24&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD0ddronwuWUB0Vp4J1S74j26_AGFsUftxdnNZfZ2c0w&oe=6AA94442"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxcLpnXwQj0Q7kNvwEiRvpt&_nc_oc=AdpRofoMf-jntrB0DgNUgYV8gOJGLePDUTvMACHH3ZkUaZqBrjzdkGZE8oOklHPjWxU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYMKmxQAcu2m4cIQlj19dgIHCF-MDjjYasXM1TZLS6zA&oe=6AA95219"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGeeUgIiq4gQ7kNvwG7sr4b&_nc_oc=Adpv0iiOrre5ER5nUEkneeCZ4yjs_zObqgT06TKad9Kk-o8qUYlWr0bmeYjCBE0O6es&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8IWQifcGXXg-tZe8H1oiVg1FxtKE7rNc4FZJppY02cw&oe=6AA96B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1HApBzQJtgQ7kNvwF8nQpD&_nc_oc=Adrg7DwzE6uw1kD4sdYhKlZhdVDENLuO-KclwplKtBV4uSdx1ZlqURj8ggwSWcZFjHU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGd9IvSWHsyJdRkLMwHO8nWa9WXc7QgASCC77y1mibIw&oe=6AA94EDA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "schedu
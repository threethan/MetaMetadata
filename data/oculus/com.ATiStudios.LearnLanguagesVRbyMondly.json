g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnnAguMB6qkQ7kNvwH6YA8M&_nc_oc=AdqXWaBZEEnl6rt4-QSfepqJRo3bCvFNBU9tHe2rzBO9TZ5gS52BL3K2zKox998RqAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6w2_zs2gKJ0XHw8LO4VS66R2exJi_4Q549NE99TzFfg&oe=6A5E1EE6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI3cUHjkb14Q7kNvwFD6Thu&_nc_oc=Adqvl9zPNgbXcKUG677KzLu1QGspNJWpm-9mOfL1SDrkhTpfhUdXOcZbxt7eX0Ua4DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHWseqDyT3ih-L8uMGuQDg_kds6deGuFrtpDA92YLEAA&oe=6A5E1B18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z58IBE9B9zgQ7kNvwEe3VBU&_nc_oc=AdqcHhkMHu4_OJEZMVnRDQrVlNiedbQ3UJjXnxTb3Rat0FdyywiFok0ZEeDPn3sCyEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU-y--XKZLxf9_iKbtVXNly2x0BTsYeo3J45ikbvuUCA&oe=6A5E386D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl1QduV7Ec4Q7kNvwFZR79X&_nc_oc=Adr-N_1gqqS9xAS7BrYlZnGKANcPJ93gpV3MjWP_e0UHEqElW2lRB-sUSUFm-hCX7Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjiUhfkNGhILJsaGXj2eMQJFbPRGsqTwR9EIdcYHmAiw&oe=6A5E1EC2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ial4Irm-5hwQ7kNvwHg2DEx&_nc_oc=AdoDbCct4rHLJU_5kJju0CGxRN8sZ7eAD8FEPdwxCTZgUHIjbtScc7jxs5E5MpCbieo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbOqwiKpGMrwoxCShCfrjlqQreaAJyanL1xvz2481-aw&oe=6A5E2C99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R11h3ep-ovUQ7kNvwGKZQXD&_nc_oc=Adp_st0PFNSk1I3z9aC5YNicn7asiVBpu8rF0hyCv6ci9XPua9vF64h6eLBhG2mKgdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnWqWq2bGM2EntGuWgstgG77WKANMF5tx1kEQ49IU2XQ&oe=6A5E0D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tb1x7UmKRIQ7kNvwEyeDKT&_nc_oc=AdrpECmpR1YkETRgfwPnVq_TFlG4_Kq3eSx4DWDGc2lo1Tx49ffnuFk2i5egF_ZwBfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYr-9Mpvr0uOsgZRRw5d3BNqn_p6Ghn6-w7cjvbS8lOg&oe=6A5E295A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
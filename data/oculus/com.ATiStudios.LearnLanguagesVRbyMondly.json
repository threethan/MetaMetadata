g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVqWxaNGGl8Q7kNvwE0i7H6&_nc_oc=Ado-L_BX4RyjqYuRdbrxCOYEbdag_ORZ4WaUBzghuFe4ksuHiuV9sEEvgsghsawgUq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kgHB9pUdDv14HjpBQg5_8GqhI9DTgRddnphzRA9euYQ&oe=69F89B66"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xg4Q5cdPsIQ7kNvwEVB74n&_nc_oc=Adr9BHXFKPRK_yLYXTLQQIF2J7S_7GcncW3o00Siz1zF5v3-0NKED_ZjposTzf3_bqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TxsnxM9tahIrxaww6teAF5DjRTUTMu2yO38LgiOiyIA&oe=69F89798"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbSD0Zwd3G0Q7kNvwEkZ-3O&_nc_oc=Ado_FAIlU7pRkcgUhh51XspeRCjpYiaD89ApugGtrtFjfqlR-2nYDH7tFNmoS5eYEIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27RZAaLraCYQn95IGiRFk11BSPl7BeqaDzCh-ShXs5Vw&oe=69F8B4ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erNEPJc6dS4Q7kNvwGmjDqS&_nc_oc=Adr9uvaSH_O_Cosg3h5ZXBzh2duEs0nQ75yv-IwdL8hHtW543XM4b37agXlUQu5JeN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_zZAindh7877ZLu6zVdM7NpeXYwpsjkxnsdhPJab6Rg&oe=69F89B42"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0q5J4Rd1TAQ7kNvwFrE_AM&_nc_oc=AdrXBrju7SgRpuxS_xyCXEfbjqymLKOuexq1Wc7WZxCdjR-mqBH5z9OBkR34FKncpd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YcvAvpS2J4u_ZIhDeSCbJZacui6b4erDpgrcZuU0ugg&oe=69F8A919"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmqoEBuSBoMQ7kNvwFUiMvz&_nc_oc=Adoig2-fTJsqnbdtr-9L9_7_RTxmupg5cdAubofp0r7lRcDKXrA_tAJr8V_5aX9xFig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af143ywEQYE6pGLt1cU0aTadBqMC7yLIFvuJ26Hrfu5Tkg&oe=69F889EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lJOcOYdbxsQ7kNvwFJJ7CP&_nc_oc=Adrzdlm1n5Gw1li2NZE_LZIetRpHnNuP6lU7-HuJoUBZYt00BUJEJrxHz_9Aq-44llc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NGSENpVbxDc5pOcO5D3uHPF1WdYsdQ4b5LNaBgT9FWQ&oe=69F8A5DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
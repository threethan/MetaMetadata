g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0M9VWxNdK5EQ7kNvwGuBL7L&_nc_oc=AdogzlntP_AfYeH_tvvgTrxohPnrNSGPYRqhMjHp1FopJHREuz3tFYd99kr6PSeQFuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX-GGg-uMNkty5ddMLhF3dst6tGAbeQjdZ_LGJzc2OQA&oe=6ACBC3A6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mcCJBTxz_cQ7kNvwHcN7EN&_nc_oc=AdpNXHhrNR-Ih0xk_ED7YGdtJH17CpRXcmudodH_5SfHBK86GiOwMgwAdhG9EgR2W1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8qUgZ0y_i0l-DpRBIC0GmWUQL7rAz3wM4T_0HsbVV4w&oe=6ACBBFD8"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dmAvUbOs8YQ7kNvwHqSfjk&_nc_oc=AdppPaS23VZRVDi-4RmW4Ws3pHtrRXEoFyvYCBeU8DnDJx23TB9fbQxv5IRYQe6xCz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs42vhn-j1QRR4xEaG-HzGmbFIGdnXNPVkZ9g2IBPfsw&oe=6ACBA4ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lS7HQdZS7EQ7kNvwHEeG1L&_nc_oc=AdpyLkRYo4oqrrlCZR2dS5pxcWvEzAWBu1-oXmabrY6OsobtKHnVmuljJP-AMmVXfMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME31Dtd-S3dXdeNVi1i_JDKnkiuJtouJWA0R9CY75gNw&oe=6ACBC382"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRCTGEt0ZmkQ7kNvwG0PPaP&_nc_oc=Adr5-X8oa8ov5puewC425vQkyvAD136AuQX3Y8N-WharUgIAbHC78KRoW49ufd37As8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNswHLeHE_h9zexTdHJe0HNZdR1PcZ8yrQox4clguBQBg&oe=6ACB9919"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfV8RCAdExQQ7kNvwEItu5g&_nc_oc=Adrlxkie2q8G6RZz-sYvhCvFWKSgbFWMHYzEoL2cZSnBuXVcUtJHLOSEWY8e-IvHBOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzjjcan5i8rrEwgi_d72WjTt9mIPA9U7drBhqEGC42rQ&oe=6ACBB22A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTw2s83qDsAQ7kNvwFY1sxh&_nc_oc=AdrkyD-DW4p86GpCYlXxR4uJUSNcECd-bqRNx2PBKhwEx3Sz7IAnHUlMHhLI-4jz4jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6rhHJJoNQVqr-C7znfJ70ScZdxQDN6OlmLVODOf3-og&oe=6ACB95DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d_4esbi67sQ7kNvwG9fV5L&_nc_oc=Ado5X71dqoLuGJnOYMUKudylJo7e_QpyfWQs4WmFbSmNRiItY1vmLzQYcoWzrBn-GVs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ofzILse8bGX-tNuq0X0Zm3QhnMFVUE-GWKCoJcttPcA&oe=6A12F966"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPiyz30W-RkQ7kNvwGQti4l&_nc_oc=AdpGg-P7MjTuo7ud6svs2LUHq8-16hIiFZKCXJ91XsD9JJ6ZA_HYk9urJXcNEbSIbIg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Jp-uuT9CmpzXe-5KEIsECqWNfm7CQz67Def74rerig&oe=6A12F598"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYDGMVK8yZ4Q7kNvwHbFrnc&_nc_oc=Adp3BKgUdPx9QswZVZZK4VRCVAagPGdZxGOe0bDuWGpkYxnzjZd_1hwAnDqba86r-GQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D4VWYz-ZE6y7sEIjhIVPErWDK_JHOwa4Y262EW1ueYQ&oe=6A1312ED"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1mIwo39CsMQ7kNvwFh6kV2&_nc_oc=AdoHOn-5sflAA9L4-oBIGBbR5IPvMW-SRX9d-h3dR1hd4tKHCcta_FNzotQrvpmX0f0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CsLMmX2GIlS8Ga0PDgQ5D0RP14zRsLTAG46zfycEPfw&oe=6A12F942"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvKbSqN6WPQQ7kNvwGqDVi2&_nc_oc=AdpFtQ2tz891LTvjT6kKDivbWM2C0hi3uoj1SeWYaES3r77QGQrc22xit85SWLLx7os&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e8t2FaPwsEHoyjyS292VWFIFXMepoAEgWpNCwBdhwow&oe=6A130719"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO5EABfnYMYQ7kNvwE-JXkP&_nc_oc=AdrR5e5yX5q-E1kYPpOuJdqIBWXbPt83YxkNlguG7VXRpIwPRbpIo0734O9tXe37nYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AULa9sq1vbPEhrUQ_tx39xtn-5DlMBgrVBNn30wHfdg&oe=6A13202A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FSowq2MnX4Q7kNvwEB8Pxw&_nc_oc=Adok5MER_a8Oz6jJVG4VVPE6JGkt7QdxMpBVAgwLiB1nODyV2mITgTvvMsiQkk5XwmE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nM9v3cmUnYuCaYDmWf2tWXPlC7kg_adNOV2GdmiBXhw&oe=6A1303DA"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
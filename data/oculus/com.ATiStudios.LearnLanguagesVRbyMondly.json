g", "id": "199358028612715", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982619_199358031946048_3158888635705848252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYYPUJZDJE0Q7kNvwFBu62-&_nc_oc=AdqSGiupVypC13yYMpls5ox3aH2qQRq-C0rJ9FUvY6DXQNZ4WBeukWnykcwqIEvk_JY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EOQhPhsnXYX4pl5oPpwhom_llfxLLlcfMYwz1Nj96kg&oe=6A411DE6"}]}, "id": "249281936706854", "locale": "en_US", "screenshots": [{"file_name": "Languages.png", "id": "252263676398854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035340_252263679732187_3192445456160815339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7trpKLfrE0Q7kNvwFwHq-v&_nc_oc=AdqEEU8BfKZzirxz7q6FY-sMrSDdYpyr8QPtrGPODtqcb8-zdToBEwu0YxOsqJheDeg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r2T87Vh_0JZM1G50mCTNi9jkguLrOk9wvZHzo0CH6yQ&oe=6A411A18"}, {"file_name": "Reception4.png", "id": "251176983147444", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031606_251176989814110_5052221203544402627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UT_VDrOO9kQ7kNvwHNA5gT&_nc_oc=Adpo5p8rCX4CQ-JwRFR-lIoiMKsZJmDaqioWIN8VbQqf_q6Q4zP2sNd0QiOs8wqRqjU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dJYdyY-HWe5gi_H6z1mz3goeWpBOaxHK2cGJCUF4kew&oe=6A41376D"}, {"file_name": "Restaurant.png", "id": "182051733431284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984460_182051736764617_750989904305018005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41cQGdPqpOoQ7kNvwHtdpBG&_nc_oc=AdoVZXgwtFzzB6oJPN738GTigMlz20BMDe5Rgp3RKupySlLwdIUaZNlk3AbNmhB6FjQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RNTl8qwZCcmF4d-rQ-8Xyt1bf4DXuKsXRXhjj98BZSg&oe=6A411DC2"}, {"file_name": "HotelRoom.png", "id": "300954294731215", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982671_300954301397881_6472248080342983514_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxrw-9OavQcQ7kNvwFL_OsR&_nc_oc=AdpgYoHAVmU8KIQDyL82ZGAMecXmx3Ar_nMW3FUtQ8W53pmCydEtSs5r6xy7qs4zFEI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82p6zpJTfxiun00os3Sk6ckSvLKSd-i256G5lFErxJ-Q&oe=6A412B99"}, {"file_name": "Taxi.png", "id": "718325395520296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035356_718325402186962_5397838698957384174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdmMzGhVSrEQ7kNvwGD-AfN&_nc_oc=AdquOM6hu1NCtSy5mwcN3iyqvk-lM0iQR8D_GCeNs0fWzFIGrMLbXNTwItTiYoYwMPA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YU5XJiYHFHJndGiMuc25OKHdempoaG0NoalxOz4NEaQ&oe=6A4144AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_thumbnail.png", "id": "120511630225314", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75371506_120511633558647_467724166899617108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1gH8M3b8SgQ7kNvwEWS0QN&_nc_oc=Ado92-y9YP_p0LbeGlZRM7ycZuPtyOjQ2sNMID5DLcHkNvJnsuCEYTITluIlLP2lCNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jyEP0uLkq_AFW8kStEpjgEkLzOLXjors-wxtWtGCnhw&oe=6A41285A"}, "display_name": "Mondly: Practice Languages in VR", "keywords": ["Spanish", "German", "French", "Italian", "English"], "long_description": "Experience the most advanced way to practice languages from the comfort of your couch. Mondly VR uniquely complements Mondly's mobile language learning app, enabling you to refine your speaking skills. You'll get instant feedback on your pronunciation, suggestions that enrich your vocabulary and surprises that transform language practice with Mondly VR into a one-of-a-kind experience. Join our lifelike characters in a fully immersive language journey!\n\nTake part in realistic dialogues inspired by authentic events: \n\u2022 Make friends on the train to Berlin \n\u2022 Order dinner in a Spanish restaurant \n\u2022 Check into a hotel in Paris\n\nBuild your fluency in 29 languages: English, Spanish, German, French, Italian, Arabic, Russian, Korean, Chinese & more. Mondly is a leading language learning platform with over 80,000,000 learners worldwide. Our mission is to advance the way people learn languages and to endorse cultural and linguistic diversity using cutting-edge technologies.\n", "short_description": "Experience the most advanced way to practice languages from the comfort of your couch. Enjoy dynamic conversations with our virtual characters and boost your conversational confidence in real-life scenarios. You'll get instant feedback on your pronunciation, intelligent suggestions to enrich your vocabulary and surprises that will transform language practice into a game-like experience. Build your fluency in 29 languages: English, Spanish, German, French, Italian, Portuguese, Russian and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mondly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ATi Studios A.P.P.S.", "support_website_url": null, "website_url": "https://www.mondly.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "hi", "fi", "ru", "sv", "ko", "el", "en", "hr", "pt_BR", "it", "fr", "hu", "es", "cs", "ar", "vi", "nb", "en_US", "th", "uk", "id", "pl", "zh_CN", "da", "he", "ro", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1775286619331306"}}]}, "scheduled_offers":
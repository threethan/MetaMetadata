05", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035403_2204847539907538_45620361154282998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVfw6Zim4qcQ7kNvwFOP9qT&_nc_oc=AdrM2HbTRbBUmKVmOq3UN56RJPw1POBt9vYR6zYoxGpZSErtfrmx9RESlvy0jVgUUXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_HdrklHqLwOT_4l79HmEc_p9-XTvd_tpFAtGiTJbAKw&oe=6A89A1F1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a80aGOQ0kG4Q7kNvwFIam-p&_nc_oc=Adq1oMTHaf3q3PlSXvTF1b0EGYGBXL8CmCfqoB52m3Z6GM9YvFjzMWveInUXwK1dy_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYzm5k7LxwipYwGCLRhEamv2Yqnb-YAK8xeIOAoT9byQ&oe=6A897802"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpteUXz3YnYQ7kNvwGmMjXy&_nc_oc=Adoug4Ls0SgvJp-rbC0oYG0avTANFFZ1lCh0EF9ZU6kx_4611-QIruheU1K0snDchCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkz16lrFexT3c96mVQKgorXSOvJyR5oXkZSUKPC2uhmQ&oe=6A89881D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CN9LStr-r3QQ7kNvwEufdYv&_nc_oc=AdqvbvHWC-I0kaVtvGd-QVGMIduqntF9eMgCb_CJ5UBt2hQNMq1r79rXQ0Rgpsn56ts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVAgC5kht4x5BlP7tyNaih-nFmdf2CKlP7r88tiYcaFA&oe=6A898D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGIRgInh0g4Q7kNvwGbCsho&_nc_oc=AdpBf6D3NJbZdhqZyeZseWjDAXqBEBqTW2TCBe_PqPmxAAWc5HhMP_4fCXH0M8hyXp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjvsUaOvkNt7ESPvT-PrEw0JAI6yx9RnfEGNgkDvtg1w&oe=6A897D40"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25835704039361470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982486_1596562591133281_1313940139573391383_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anmYEUdXahwQ7kNvwF507k7&_nc_oc=Adq7_n4iJb8y_ad9w1bIi3aDAtX_u2G_bQ56NtUNNHTDpxoi9OrroQ8MOtUKpLxLU58&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzq-QUQwDUC9PwKzDEbpWfPtd_6U4qHGSaNvso58NniA&oe=6A899C62"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monki Business", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1695668400, "lastRevision": {"nodes": [{"id": "9646673045357827", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9646673035357828", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1007304773950047"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"n
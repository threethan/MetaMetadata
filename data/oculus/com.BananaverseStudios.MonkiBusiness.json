irhCtGoEYjbFLSLTHcNuRwbeiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftjz1RsrGAKNJacc6OPkm7IMCnvz2_84eNAT6nLFDJZsw&oe=69A6DFF1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPWPqQ8LFoQ7kNvwHCaBDR&_nc_oc=AdnZ8zjDnKu8GPR0OLlXefFM417crq1iRyVIwgYhtBgVGIbEDxasKnGqi3goaF5VkJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTL-yTkGGajmY_LWFHJyGxbmxWW8lEr7V3YqLRBvsT1Q&oe=69A6EE42"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1xfPCsBz-sQ7kNvwGsUnUD&_nc_oc=Adm9_fI5dTE_TI4uwZkOlua1-6QPRnfIr4DldTMg3-QgGbnVwGBCvOBSgOGtFX1lOwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1ztYeqhis_RreJlSC7_RLChq0vgSr6BCiybW-bGXS6g&oe=69A6C61D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSnlSk9nodcQ7kNvwEhkVO8&_nc_oc=Admbt6Kiaslfkf7hfpasuqpaATE2gB36vIiWNc6Rs7nph5RLCCHZrBUzFyEuuAfZgNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuP3Wm0XHQxIO3tZKYyU66OMQtWKNJdkmZk02NUD3ac3Q&oe=69A6CB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k54u8uUTYwQ7kNvwFC9k9Y&_nc_oc=AdmnP5PF_npJ5fvfaTB4a2TQffk8gEtg1Wyp3BEWSEmWu3O9Lawrj3K23pMigy-_EQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYSGuud4qdElbMF66lTPEzGko0ty8kvgMJgWHHWs1mLQ&oe=69A6F380"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
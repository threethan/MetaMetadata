bfjSzIVwJeUQ7kNvwFNG--y&_nc_oc=Adl3LVsuE0R7bFJDfPUL1A420YMb__XXIB8XzT6_YkliiWHqT2Yld-Sn6kwmIXexgGU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyT2nFxTcVAPHfnYceLFFjQvqsTNqWBrifwhCeXDVE8bw&oe=69BAA671"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD6KJYJp_acQ7kNvwFzinwk&_nc_oc=AdnVYjEMT3tZ97TefDoiyf8FuSkTnsAR9N_rams6AOIVY8oCks6YYDWiPrW_v2D46rk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyz19JkmZEE0Y85MOcw5QD17suRxyyk_96wZprKq2QYJA&oe=69BAB4C2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAGnpevm5sQQ7kNvwEt9MhS&_nc_oc=AdmCQshxSfKSqDZrld5IpB43G-qauhh56nUgW0rbXBrFqkB9menC3JFVVgBlNA4qwNs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUHUDiCPwMOz0eDFtaZ_8MtQ2CpJj0Yqn9Ff296zr_ew&oe=69BA8C9D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUvSqiIgHRUQ7kNvwF8yd7d&_nc_oc=AdnKPf9XIlTvX0VMAGC_U_YcjqkjSq8HG--Qqf5XcpaH0LEt8lysVmeApWBZfcpiNLY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyF54AoAX5Vh-68pZEzFYapcXsaIPRVzbY2lJt88oHYZA&oe=69BA91A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh9AbfJsDJsQ7kNvwEOxzTp&_nc_oc=AdnKs7PkgP0iGs3DN6YdQ6-bzbrdNUiUMBSxzzRp8wNTZHFK_xv78EN6mBJDSEz10rM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfjoQsaqkL5OUdkxdETabz4L9wJWWOWbhCAbBU-61X6Q&oe=69BA81C0"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": n
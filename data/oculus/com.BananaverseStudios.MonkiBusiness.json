ROCmuKYorRBKp35hbmIVB3Tnwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_Fg4HsgIVB327Xf0OBD7EvydO62pknFVPDBzNuyfvpA&oe=69A04871"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZUPA8wIamwQ7kNvwEKorYZ&_nc_oc=AdklXhZaCCp3gcdwhVAKO9iCB2tb1444i6llNTciMCmZvf6BFUuYnnRHXjHUvmzkEbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQJKGWM89UiTIzM1cEr8Tuxsa6XKHZ7wxyx0j1j-qe_w&oe=69A056C2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Qn1YtS1qKoQ7kNvwEGR7I2&_nc_oc=AdlMDEbOup87_v5qxBjSdmvjZJ-shi7TU5sl-jcEJcsab9UkkfEvI1X2gi0RXxLUH_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzE4h4JYwoHUWvFo4J4UpoJZmDriveXoESQB7v6beMOg&oe=69A02E9D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZUFklwjbCUQ7kNvwEsGr6f&_nc_oc=AdngjrpNUU4UAM5Bs4_T25DCI4apP0UDGaZfitEY3T9hQSO2bBDfxIVs325owQjVGvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuE833nRMD2kKbn7zbIUHtBVx2EwUIzkzYZJ8IfXy4EfA&oe=69A033A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfqMUB6PcaAQ7kNvwEdUxPm&_nc_oc=AdkwX6bVCvIl6g2Ns0lGac-Fh7F28CnZ1N1C6r8IF_m0vzp-4A7wgGTqAWrPCS7MZcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs0niLIiVmg7khpCvaBErO3RiGfPj2ZlxhLRp6p4AG2bw&oe=69A05C00"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
tDcmJUBZbd51Qqs2i8AnnFWeTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsOtiqxgd4xcVKh7C7OrhR9T7lUbho-9ieE6qi5a2esNQ&oe=69985F71"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWQTp949rz8Q7kNvwGC1QdO&_nc_oc=Adn9rv2Qz_UqUM7nAgW8LqhzdtRN7mKpGxNSrHuU-mc95Tpv8B9y5ALxvpIWLo7mol0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsNoiBpRv12akTg4559hgmoNe6HTA6PhUwXvUSh1MfDVg&oe=69986DC2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzJDfEj9YwsQ7kNvwHoZO2i&_nc_oc=AdltIg4O2z9qvyLK-Uu8VQhRkbdOMqioo1REIFrLKRy39YrhzcxQdAvvAxp48DxHSo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvFwWK7LoF-Ze5GTq2jblBJZ4ol_Eea_IoL5Fs6TwuT-g&oe=6998459D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dZp3IzgRS0Q7kNvwHGs3Wz&_nc_oc=Adn6XLT3uyQ0fCMxcpTxyskFRxjiAUo94ObYFrdiuloRCjg-a4KGSlp9t8jdfdZiKA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft8kd4Xr9UVXd8UEsnOHiLefLQSJPa6A10Ec--1T1KGkQ&oe=69984AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwdSZy0KYwcQ7kNvwEoJNAL&_nc_oc=Adk989OKiBNO5NDxANKZSN4CHgeFEfRTdngTQ9bB3LcdlW8R-C-BzJR-uPWdVXvoKGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfupoCmoevHCd446VJKRNny_aAhccH-efNVInBF6AifnJA&oe=69987300"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
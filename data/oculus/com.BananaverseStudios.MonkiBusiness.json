VzqBgf5MguNKnbTrny08jRIx58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuOHTGpEM-BUnfao-_HNPpmJDm2PZx3OhGlSHEXw8BeWg&oe=69A58E71"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPWPqQ8LFoQ7kNvwF-wiUv&_nc_oc=AdmHnmDyiFq5GyVefS5oDqP2w9uem9OZTahmXJDHzMMahch2Iq1-udJzPLDEQxaKuzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftmBlic5Bb7RY4xYJ-hRB8Z4uZ2SUXsxYtJdZ-1JfgCwg&oe=69A59CC2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1xfPCsBz-sQ7kNvwHYid_k&_nc_oc=AdlFhwFaJIQ8I57x9vtVkNPx2KjEidCUHlK7TK3bwN8bseOSAfhbTe-ggLeH1OFzPms&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv7lfcv96EOC9a61OzICptl-iLFoD70QMZnWZkwoOJ3zg&oe=69A5749D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSnlSk9nodcQ7kNvwGW4ZGb&_nc_oc=Adn_sJLweTsPsVjJyH4EOIDzcXMgm9zbP33r5Snxzt8XGWC6A22y6BOxF5VKgmTmFZY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsT6dnCnXl7UXlmdzVHH-S3qYgyjleWEyHxpJ_1J9txVg&oe=69A579A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k54u8uUTYwQ7kNvwEFOg2P&_nc_oc=Adl6xzEJzqxoloo761Gh748C1YcHw0GlVD1jWNRKDmJS2muXrnWf5g5defym7AXkkJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvfg5rBQxMKTgjN0cHcEk4W255uf_FAylEw_VL7C5xDyg&oe=69A569C0"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
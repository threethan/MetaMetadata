04847536574205", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035403_2204847539907538_45620361154282998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8KJ7luxoTgQ7kNvwFadin6&_nc_oc=AdrcrF5-k8SzB-5s56AhuzVTmK9VdFF_QcTu5TWLxPY9QRSzhnD1V1bz1t32I0HMBAE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOUfCxwkI5gnYFm6TKvevJ3Tiak2IrYjG-A_lEyiPmqw&oe=6A8D9671"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sp7ccU8jwgQ7kNvwEwolfQ&_nc_oc=AdojuLWkRqwx0N6BEaJY1dKhGclCoC627jPgaxJHL9zvfsP-jpscq9cvRZYkwGydVNs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHsYMaPhrRHiksXh9w0Fabn9IbjslIu1Pn5FABtFH8Nw&oe=6A8D6C82"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP9mT6sStZoQ7kNvwFAKbmB&_nc_oc=Adp5q9IkYcBC5bJQnhPUaAswIcUp7y0ppeBBE5gjh6WVMZiWQgYDgWksK-3Keva5ga0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBMivw3zrFqQxSkdVg-av9Cmmy01gVW5qSfQj31bBvwg&oe=6A8D7C9D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut9o5NHH-UEQ7kNvwEUWJ1H&_nc_oc=AdofjvSShJeeJzbXhFkf50z56Rm4HQzmx78JlSm2fTinQ-V1ALpCUL01c57DzMSwdiw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8FCL7NgGJxtBz0QwPqYiQuGezC-2jxD4wB1e0slTKng&oe=6A8D81A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU1CzssiLjsQ7kNvwFj0HWj&_nc_oc=AdoNwOB-UWh9aup4ZsZuaBPvCEbxVjDC0aAbRtGG-0EbQ3gYmRM52vm4jc6T8pvyVj8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWmA-MpCgph_TwMnHlYJbYw0jI-edx_eMi7El1z2Twjw&oe=6A8D71C0"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/vie
4KqEfYXRPF8j4eh2hipr7r7JAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuFfvHx1dJVIppuA2ypOA26oRJWtlf-rgg62u9a4H3Ikg&oe=69A43CF1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPWPqQ8LFoQ7kNvwG2T8Ly&_nc_oc=Adn4yP84XZ2SGyOKO_dqk64afVlc3eSN9H5ZAkU38XnjxM-uqUq30FR9fdHh0F6-4Q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuen7FGSpMsEqi5aKD9699Iv2QM2hb0ZZchUB_McpYv3Q&oe=69A44B42"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1xfPCsBz-sQ7kNvwHmNUwO&_nc_oc=AdnJV3lzole1U-y1_ofxEWF1hVEBXQeBRcR8AxelEviGxUJZTDZhB7Q1zJEZFLIZxbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftyQP5g-OkQMIBtCRrLpaU9DiHG-Vpwtaw4Qjt_JaTJAw&oe=69A4231D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSnlSk9nodcQ7kNvwGbh6CM&_nc_oc=AdnyWzICzMwqlEcE5JNTh_15FsLvsnTDEBXoXcAZOUI98tueYd9Y878UvyLBsLu_314&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsqjcBGcXIEkygo_fziaJv_X7RoEqMxFkgUIVt_v5h0pA&oe=69A42826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k54u8uUTYwQ7kNvwHmm81y&_nc_oc=AdlvIr13bm8vCjvHu-ylOxj_WTFDPZ1dtr0y85VbFg1otFDLKA5hD6nwuHxRZBJM35U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsHOHl2rwLov-fyTpATke48DagZONFBWFsRD3Xy_L5yOA&oe=69A45080"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
MYZ2DzfgpkQQ7kNvwG0abbp&_nc_oc=AdlNn4VclCf4HSrpyE_cKPYnhxD6us7Tj0RjMZIOQjxMG7-JNQ9TKZAKIEe6qnhuJ64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTW-kUBpzv2sF2shR5Jd6erk30QMII-DXS_KNiX78rZA&oe=69BE9AF1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83MUMXKCZocQ7kNvwG-JOVP&_nc_oc=AdkjfwnO3WRC1KbrQHawHOIXt1cajNRqlDAMohz91HsS9F3UtTnfbhJeo32o0GN4XQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBffKImYTETzkFsE-C70CkJUCqyBctsYkk_HNu4hvOtw&oe=69BEA942"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PHjjHJyhuEQ7kNvwGk21Z3&_nc_oc=AdlVPrtf-0xg3ZpL6hL7bGJbcBnHscw0I2MfQ6xgHodJDFBQV36gHkEI1Vnjj67C63s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOFyJOg54u7Terkze-b6hpQ_Q0ntzODaQSm3RVJxI_9g&oe=69BE811D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRp3citz6WEQ7kNvwH9W6c7&_nc_oc=AdmoiPlbSFYCL2H8HYGo2_Y8gFfsnrV2JHZoDmMyLhh3pTU-RYcAW2q9soAhJELYVFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxapMYARC5Pw80wOawQCFl-Mko4mOx7ZUbUsS41NmEoww&oe=69BE8626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOzYVCGvhJIQ7kNvwHI_Q7M&_nc_oc=AdkMUJukLCOlaZTl-DbbjxfZud2IoUDPlj8sbFfuahgaj6B7RQdDkvL35nw6hzKGKdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP5_QIM0hJfpleqpnBji9LosU4qe_oUPPHX-5EbRk4tA&oe=69BE7640"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": n
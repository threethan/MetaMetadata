&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb0D8nYx1PIQ7kNvwGY4sc0&_nc_oc=AdqB7Y1BF5Dd1eJqvYBJI8SXM9wyZDV2yftu1Udd3mvVMFumePdHuF2wxSP_nG0P08U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZTXqhKtdO-7M32UoBnxPJJadVGFMHyXkOvzG6VoubxQ&oe=6A2D58F1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqouJ3JhWsAQ7kNvwGTL9Ch&_nc_oc=Adqe042311Oa_1BLVKkJ0MuYq3mwvAjnPVfIviltXm9QMlqH9U9QqOYxXlnh14U49Qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m-p65A28mETqEG52oiKgKcTh9TTof2aQ_1BwvGfxAiA&oe=6A2D6742"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Lccf7Agxr4Q7kNvwG5_vBI&_nc_oc=AdrDDaPQNHG_bF5ETcHcGtuyMxZQiCwFRG1yx83ZRajcJBxpqlIESPh22Om_IzRDO7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__GevJ_xEFLBNth3JVNEm1XK5F-DMp4VzDZmQNhvHQJw&oe=6A2D775D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XVeO3Lu3LsQ7kNvwHFhTyx&_nc_oc=Ado2rCnBNs9PPl0n05u05Qi6wpObBn7IL_-32TXjLvoWeWGaE2MkoPActpnJoqB5pzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fI15OMIq837FuMXqjhILsE4F0Nh_pOyWs8g9yW8bPIw&oe=6A2D7C66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jn9w3qCo3YcQ7kNvwG_Vke0&_nc_oc=AdqdSM2zgFSt5ESuzPjsAsBKLNi3s1m8D683eDiD8gREFMOZLTSHj2vUmiy6Ld5-wgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DBqFIHSTezKNOQKeimFgTIjXNdBHYbNCE0L-qnHVX6Q&oe=6A2D6C80"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkib
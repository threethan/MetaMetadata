2204847536574205", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035403_2204847539907538_45620361154282998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK1C4bbrU_sQ7kNvwH5UFI8&_nc_oc=AdoRYdOC4vRLNjaHjjbTOf-lpiD3YHSqMJ28kH7SVjTPvumBd7QJPnf8qaZv-G5Hywo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvbvQ4I5tAvRBRDRwWegNATiCIWTKwnVZGDezBSemRDw&oe=6AA3FFF1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocD5S_Io-sEQ7kNvwEZ0B8A&_nc_oc=AdqojYgXDz7dn4rh5xuqaIusbbagT0xRWkOiUtAN-HPaPAcF6kjXJg6qVDqhIKM25SQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMxnpSMduez80oaGdaf8BXCanHWNBTVfV-ALJESECGcw&oe=6AA40E42"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeSmhqur4GsQ7kNvwH9r1aG&_nc_oc=AdoAsW89mmBb2WXv5dcm79TOKNK4qb0CGzGEwkZZfLEwM9ko0tNi_zwA443BJRBIjZU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2bSJYEKWosRCoUgptiSm7xrGyUuNeDVejc6JPbB5DJQ&oe=6AA41E5D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X2k7FaD40IQ7kNvwGd5Bvy&_nc_oc=AdpSxIK1EPL3iXM-FISdxE-t6ll8f7x8We3CGuHspRg0cl_mSwp0tvQ2O9xNlNK5hIc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHJo48LqxIJJGs0OdWwSpiBMxIVYgjkoWzWuSDnr02xg&oe=6AA42366"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWq-ouJ3lFIQ7kNvwGd6Qfh&_nc_oc=AdoUt2nQlH0aZnAP4AlwSC5ucG_05k34KznLOcMn6WemSAqaDue9xmsfBaIzhhGoEeM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7zKNjTPH2GPgORbgVDeZoBf11_4M5V6Eixz_U9794OA&oe=6AA41380"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com
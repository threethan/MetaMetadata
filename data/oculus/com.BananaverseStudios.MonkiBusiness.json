uOz636uuJfs8LtztIe22w1JB4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDoRhVe61GwU7bGUSsD_diHHksPUyIud8cV3TSv8yhnQ&oe=699DA571"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZvmHR52rbIQ7kNvwEnoXYf&_nc_oc=AdkFYj1bdX6eKIRrJCFjbxTFYm3ET-oGxDbU3HxZZ9qFH1ImxbexN9MGfHRgcxneEW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUHTQwuVlQJ05bGTmDe2cu3-CX8_QxBLQPo1ZEmYIsdg&oe=699DB3C2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFM60kx8MzIQ7kNvwEKO2kC&_nc_oc=AdnAchNSwJSaXDuL_oQL1AD4FYqvZePheM8NBLFOUl3d5jhKADBChko500Z42J2O-0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswkZgvsp5ilk2TUgEBG-KqypqE0uynhM-z3nozqlR1OQ&oe=699D8B9D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmo08ceNIJAQ7kNvwEiaxn6&_nc_oc=Adkisl6D64HRi44BSyfcVY5p4WEyDTsoCgWPCW_2TDjo7x5g9BG0a6-GUm4mhToEcog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTLdl_1qaeaZx0w5T9EryfuAM6k_854sn13i5WiEOsTQ&oe=699D90A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fEgsBUajJAQ7kNvwF2oyL_&_nc_oc=Adl0rAmUYFlsZHO8vdkK4virMoxeTDSIpbCzC6sHyhK7VNwnds0o4MvqwEIRGu3XnMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4VybxyTruFi1wVoZXyhgSDRNqZsIWOWQUpKDVU-2Q2w&oe=699D80C0"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
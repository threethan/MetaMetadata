05", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035403_2204847539907538_45620361154282998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK1C4bbrU_sQ7kNvwHo7P21&_nc_oc=AdoeX_H8GyiQxC6UZnQ5yAocJC7CkQq0a0KYq4mEbs3BVtc_FxqzbI81h9HITirv07w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLopXdnHt8Qf1FVINVsVUgHGGf1vEVAz3ftjxHCKaUuIQ&oe=6AA55171"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lx6wQFLGmgUQ7kNvwHaWpEK&_nc_oc=AdqBzvutt7YEtiME-AJUtmHGatPCRmogP5Gtl6T4--Bkog8PLoYH4E8pRgZ6NPnYxUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI0yNXueJZWeecP0mVXYPQARWEkgfblLFvHeKvVxO86g&oe=6AA55FC2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WKIveW2uE0Q7kNvwH0HNUj&_nc_oc=AdqjkgPrLydYuKdKV0ZYtzmwZ7WhVsqR2VIYhZl_KeLlh2Odco_QTdcCwXIER_OHTAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcwCQmN2r-63X3hl0PDTphML8EbqlVX3h2kg3vx-4RAA&oe=6AA56FDD"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PirTNTJty3AQ7kNvwHeuLnl&_nc_oc=AdpZGrr4bvGQw5cbFnUINhxfz8VOHQxDDK8OJnURu99pbUxWAJ5XztGWpS-2ueMRdBE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7WFIrUSq32fH0IriOzSfqLYsM99DFN_nL6Oa5yC5tlw&oe=6AA574E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRYExQW_huMQ7kNvwE-y8VI&_nc_oc=AdoO1hj_UU7iTDXrIApZToZ4rtGQHQKdxHKL78JskFohm6ypx40DX70u87Zh5Fie0IA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6Qug2Vgp8j-MO9kO5saA4tnk8jh4QTTdETwxJUr8Sig&oe=6AA56500"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25835704039361470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982486_1596562591133281_1313940139573391383_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhjgyeN4HKoQ7kNvwFIYpzS&_nc_oc=Adoc7G1Dfj__3FIFDT7VrBsVlGBH8Fn1EBg9dGSfVEZBWLo9Lc3rffywqrIk7G-yngY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPgJUmd309c5p1FJzE0bzpk5RfCafFuFXq1xIYX6Ph9w&oe=6AA54BE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monki Business", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1695668400, "lastRevision": {"nodes": [{"id": "9646673045357827", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9646673035357828", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1007304773950047"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"n
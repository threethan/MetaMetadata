6zpjL6mavgUN9TVuAD6KhaaH54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu_4LStNxBfjp_3b38cFlXjjpw-A3Rhfwy2MWa9kOj3FQ&oe=699EF6F1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZvmHR52rbIQ7kNvwH2LLbY&_nc_oc=AdmcK39pQy38DPmSrvRgXqd4HNv4-YYSi94lkiuSFWKdHIOui2KivF42qVeNX2iqTpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft9CgUiiN1omm6VGPMgITcbcgTr6uciIA0Ju9gr_OWSJg&oe=699F0542"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFM60kx8MzIQ7kNvwFJqv0J&_nc_oc=AdlvloEtEq4A5mfrptTBJmHRmQETBRu130RQ0F3vO2O0Vm59e42QSU7Y_Db-3KgwDYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfscdUlDARhtJKeEXp0b7zw4AvgugvNXa69e_Qw_YN8I4A&oe=699EDD1D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmo08ceNIJAQ7kNvwGr5JkP&_nc_oc=AdlBwpKrFQFMgMtE71MSpOyLAXUGNNcoLBe01ANJLxXSsu1GtPQZDFUp66jCkDJkY2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu45_QiAvY92iL3nfZjzTlLr9_NZzC3fyQanbMwmlrpKg&oe=699EE226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fEgsBUajJAQ7kNvwErD7-_&_nc_oc=Adm4Tb1hUguLQLCMYoXrt-wC-IyfhxULVJjHGtAGy4XVDE6XHpxy8HHVtxiQ8V-I5SY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afug8XwAjAQzlckqaIZCiDZg6S5vCMKsHbdGUaMeHmLQNw&oe=699ED240"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
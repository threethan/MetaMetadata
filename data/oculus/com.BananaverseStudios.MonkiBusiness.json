2204847536574205", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035403_2204847539907538_45620361154282998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opo-NVg18W4Q7kNvwER76pd&_nc_oc=AdrzdLHUcGEYXfL3ORjgfSlWtmdse2iqL-tk9OTqO-ty-2R1GY72Hg21Yo92eSlVUFg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEYLeM1dM80krBNOJhi-sZHUy6BqagX5qJb_4BikNqhw&oe=6AA945F1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4pCBS5hK3QQ7kNvwFIfubB&_nc_oc=AdoV5ezJ3ZJmjjgLONgomCTlLeRg7817iDhayzWo23mtLYk2Zvi44d5SD9N7w1jhlrE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLanHyxVN1NB0A-E0bsUU2EO5MsNK96PR_8F0QPXnyGcg&oe=6AA95442"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8OqFDMv4mcQ7kNvwEfY0c1&_nc_oc=AdpXoth6JeLPbph8WWt1iYWqyuyhdK5SvhDipKwkgq6-qb_fMirTK-J3kchkMBeBgxQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIfJ88JyN-8QiOu64RTri5S4lpjSJlLCyxIqOkDWkZBg&oe=6AA9645D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u4MQhBCRIkQ7kNvwEdtr9o&_nc_oc=Adrau_MVbvSwYL1OVGk-7vpGynd5c1pKlrwJf01sNVx7pxvl5Vc4PjuoJEM5keokZj8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv4aTq4fp3wB-mst4zIZRqc_kVxUQGeCdeiPiV9fYMnw&oe=6AA96966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuJzrWtEnLQQ7kNvwH9KQ7p&_nc_oc=AdotXnJUPhS1Q8IW6Z9akrKVs0Zt3uUNGhv-3u-38spdFBJoXh8ASL18-GCnzYF3VZU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNejErCeC92GzhAynEjSvSP-2BdAYDcUNKaGw2cY8cVA&oe=6AA95980"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com
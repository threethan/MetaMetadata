04847536574205", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035403_2204847539907538_45620361154282998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znqP56Uug98Q7kNvwEtkxan&_nc_oc=Adq6th0xIrlA43TlvFMC4RpF7HO29wgNG3U9NAp0_RDogijV1VDdBhhpm4ZrUVLif9w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN3Ed-ClkIGCvTgN78R92NHmIQwIAJt858r9373YvJFg&oe=6A8EE7F1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sp7ccU8jwgQ7kNvwGAgx7a&_nc_oc=AdqBruQlRGmbpaORsJ5h9Sp-D5Alo7BxZhXaB688Tvr0dyB6sP2PfE5XbCxTTNkV1pk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_zeAKOAInbmHz4-fTJ_v-Uug8TdxdG_rB9h13_TLrww&oe=6A8EF642"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP9mT6sStZoQ7kNvwEfH6Xj&_nc_oc=AdqAFWE9jopsASLLGeGS3my5QVUg2QqLuASnXU26naX5gswMIBIGhDQxjGoR6cFuW-g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFp2xSQwAR8rqR78splox2Wlc_nQHn6vgbEFZ3aicD4g&oe=6A8ECE1D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut9o5NHH-UEQ7kNvwETj0wX&_nc_oc=AdrgTDHyKKbocdhiakikan37uYTXsTDzdRFX6hb_xRxFasAO_nE8UT1o-HiEVfsdWqA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLOu7T1AeFB3XOpvNCiYHBBncehr9Wu8Rld3xFfPeO6w&oe=6A8ED326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU1CzssiLjsQ7kNvwEi7rnn&_nc_oc=AdqG0ECgVE_MlEFoWG37TcNtDIsmFdbDT1lRgQJGatS4t9f-zdMXz8F4tjDRvwt4k2Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYPVSPaCCsMm2a8DIVetA1eucb7hP8z14xS-KS6aSlxw&oe=6A8EC340"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/vie
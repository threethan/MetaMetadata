m-vvXLuCpwUKekmScupiAlJYdI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv6zl1NI3MKWqZMGDw9RgP0_BiAQzdnCx6MnedEkB5qRw&oe=69A199F1"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZUPA8wIamwQ7kNvwGpCMjK&_nc_oc=AdlCGPlFGcze51CAOv8BC9Jc09-ZuZNb0iyh-lj8XQKx2_mMiNgD2v-839jH4MHFIZE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuonUvr41PHcQZBc-WncYxrMDumtHVFbZopA3zdcBI1ng&oe=69A1A842"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Qn1YtS1qKoQ7kNvwFcZumc&_nc_oc=Adm71I92KepOjAqmR_lv5BhQ7r3po7IPTj6TR73bjzgv0ZW-mnhJpWR5_2gNymyTLcA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuINp1ZyQv9BEufxiWt1BXIyp8BCc_x1KcGvgOE2vxLLw&oe=69A1801D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZUFklwjbCUQ7kNvwFY--6p&_nc_oc=Adk6FIumoH7sa2xcQjbGCbNOhuxxWZVvhcfNtIGmTKKqK2OvXvK1oDCtB4bE-YdigQk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv12mki9ysPzN6VUfB1TVLa3OEsGM433C_lWqGEnsQLow&oe=69A18526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfqMUB6PcaAQ7kNvwFlg9-H&_nc_oc=AdnsYTE9RGENMZhL205FDffKkseyR9V1fMHPo--Vsd_-W83GWusGBbru1FWX_TebDIw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft09Of9tbhzm9hMYi6S1Td6yCKFUc45ecYb3lXaOcwy7g&oe=69A1AD80"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
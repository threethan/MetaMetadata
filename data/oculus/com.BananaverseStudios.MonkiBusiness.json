&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HszhAOB9Z30Q7kNvwEDOf6K&_nc_oc=AdqgBWMPQx_uagniRBYDyqcO1KeexAWiLKtXuPxj7owtKNPR4_SItCpDqtXkOVuRrAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XTvH9OLleMT0ZntgtWHIaDLRS7CxY6ej6Z2TNjnPpsQ&oe=69DA4A71"}, {"file_name": "MonkiBusinessPage3.png", "id": "482501601138327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974581_482501604471660_2430712926524491407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3PEPBYdVqMQ7kNvwE37gKi&_nc_oc=AdrkTaAzrK__Cj3BkBOJwSBY-pfMl8BbWU_-Qc8yqNwNkLydHVgBdGXVO28Q9NPub00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PPfiOc2e6D9q37kPddzomN5XNHyRN2vAerEhZ82G7qw&oe=69DA58C2"}, {"file_name": "MonkiBusinessPage4.png", "id": "2955339421272533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031407_2955339424605866_7481353779934191144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u4Gb5NUGhsQ7kNvwG1rL1A&_nc_oc=AdpqOuCqVRkA1FKtZ1Egcc-bwKyFlA_-v0h6eDkWndi-oqVfq_1xqHd6F9J6cOMWE7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UEFqjcmRdv60tZJVzGlx9VQF0jJAnBNrocTprR3Nj6w&oe=69DA309D"}, {"file_name": "MonkiBusinessPage5.png", "id": "527828089905492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031350_527828093238825_615326198620745687_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiB3whiQjNgQ7kNvwEGrZGB&_nc_oc=AdqLRRMWfIYkfAFiscSk6nIXKtr7QUEn2G-aaXsNO8i15sd7yoIOHnR1NPXwLYqOka8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fWio2URlQSFRkf5G8-Vs4sn7w8w6YS-tIDgchs9RNzA&oe=69DA35A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameplayTrailerThumbnail.png", "id": "401979989527888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982491_401979992861221_8193102897001981962_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaikRZgLzBYQ7kNvwGoK-l4&_nc_oc=AdoKcaVGnhNLBskym8ftho7YFAeJ09pF2zlF1x2ACVelnOvD4VwphmxuKwO4DDQi4pM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FsAxkjjQ3TX30SWAgrBuLYkvNqvoqypbNc1gGjNmWgg&oe=69DA5E00"}, "display_name": "Monki Business", "keywords": [], "long_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb.\n\nMonki Business provides two Gamemodes.\nCasual - No Tagging, just casually play the game with others in a Public or Private!\nLava Tag - Play Tag back and forth with two players, or play infection with up to 3 or more players! This works for both Public and Privates\n\nRun from the other Monkies, or outmaneuver the survivors to Tag them. Parkour up trees and cliff faces to avoid and chase other Monkies down. Hang out in a virtual jungle with randos or group up in a private room with friends to hang out and play. The stakes are low, so feel free to just chat or make up your own games. The movement is easy to learn, and hard to master.\n\nVisit our store in the Monki Shop, with a rotating inventory of items to buy, play with, and wear to express your true Monki.\n\nReturn to Monki.\n\n\nTerms and Service & Privacy Policy are listed below:\n\nTerms of Service: https://sites.google.com/view/monkibusiness/terms-of-service\n\nPrivacy Policy: https://sites.google.com/view/monkibusiness/privacy-policy", "short_description": "Run, climb, and jump in VR using a unique locomotion method that only needs the movement of your hands and arms. No buttons, no sticks, no teleportation. Push off of surfaces to jump and squeeze them with both hands to climb."}]}, "developer_name": "Bananaverse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/monkibusiness/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkibusiness/terms-of-service", "publisher_name": "Zero", "support_website_url": null, "website_url": "https://sites.google.com/view/monkibusiness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25835704039361470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982486_1596562591133281_1313940139573391383_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU35IjxSwh4Q7kNvwEQOGa8&_nc_oc=Adr2ofxDPZx4X7sesm4jJPOKz4MmJIEX6Ktfz72pdoUgFmJQuVa45p0vD_7BCeGht1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MleyMogQj-Jy-gA_V5DJeDekBRr3qn3sRbTIdXKcGaw&oe=69DA44E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monki Business", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1695668400, "lastRevision": {"nodes": [{"id": "9646673045357827", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9646673035357828", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1007304773950047"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "MonkiBusinessThumbnail1.png", "id": "2051238088562155", "image_type": "APP_IMG_HERO", "uri": "https://s
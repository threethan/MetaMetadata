36_5208914606674678736_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDS1kbFR6yYQ7kNvwGuC7ED&_nc_oc=AdqDfBVD29_OrkZG4KkN2sKfhZ5VZkoKLwlvVZMdPbYjEn7Vv7PKtEhtp-zRNlkNqGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_GGUINxhodNEaeN-if2EWBX5cjxqpnknU0YRNGrAg9w&oe=69D90F69"}, {"file_name": "image 2 2560x1440.png", "id": "1442613883921567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1442613890588233_2140330901219438368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HAP-R-B7ewQ7kNvwG981RQ&_nc_oc=AdokvzzfeVmoZ0kG0Rz7SmV90R6rR82Ifj6xortgd2ju3WGtGINZnWpt7dm83vhvO3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33xCU-TpUfSVPDxiriqEOP45swMfZpDfAXmvZn6KKIow&oe=69D8DB41"}, {"file_name": "image 5 2560x1440.png", "id": "1568545711017552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1568545717684218_8186249954886211518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZLL0BoD4HgQ7kNvwHJeTq0&_nc_oc=AdoMQ19WEhAJ9Vke_9Z0iRiva1UyFqKHFS_EHCjn2v7yYDh7RQ82cgYizjAdh1XWZuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38gWDxgCrKniVZ4CQjADgI2oopMUC8z5Dvmoj5qEjcnA&oe=69D8FD67"}, {"file_name": "image 3 2560x1440.png", "id": "1943310263736694", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_1943310267070027_6208208022242253210_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6VT7r_7Ub0Q7kNvwFXdIcx&_nc_oc=AdoEXQvQUguj5XE-kjhkaezr21AmZ45XxUiQsyn8o4puFUkCEcjj1jNPS3fYWkUE064&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RkBY46kE2BY6kKgML-nuJD0sMyq5pd16lVYv8Bxgg-Q&oe=69D8E3BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT", "keywords": ["FLIGTH", "VR", "PLANES", "RUNNER", "SIMULATOR"], "long_description": "Infinity Flight VR: Beyond the Horizon\n\nExperience the Freedom of Flight \u2013 Without the Limits.\n\nStep into the cockpit and prepare for an adrenaline-fueled journey through an ever-changing sky. Infinity Flight VR combines the addictive rhythm of an infinity runner with the immersive power of virtual reality.\n\nEngineered for a silky-smooth flight experience on Meta Quest, the game features a refined locomotion system that minimizes motion sickness while maximizing the thrill of high-speed maneuvers. You aren't just playing a game; you are mastering the air.", "short_description": "Infinity Flight VR\n\nTake to the skies in the ultimate VR endless flyer! Pilot your aircraft with ultra-smooth locomotion as you weave through a relentless gauntlet of moving obstacles. Test your reflexes in a high-stakes infinity runner designed specifically for Meta Quest. How long can you survive the slipstream?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.georgegamesnation.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jorge Poveda", "support_website_url": null, "website_url": "http://georgegamesnation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25205331642473607"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "982137611144953"}, {"status": "CANCELLED", "id": "788046594356712"}, {"status": "PUBLISHED", "id": "1147356634010698"}, {"status": "PUBLISHED", "id": "1216752803898231"}]}, "baseline_offer": {"id": "1147356634
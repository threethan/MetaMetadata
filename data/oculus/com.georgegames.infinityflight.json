{"data": {"node": {"__typename": "Application", "id": "25161600496846722", "organization": {"id": "966805429856380", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25161600496846722"}]}, "id": "2098532787664135"}]}}, "firstRevision": {"nodes": [{"application": {"id": "25161600496846722", "release_date": 1771023600, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 5}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25487956270877808"}, "id": "898386122886733"}]}}, "binary": null, "live_binary": null, "created_date": 1780927809, "id": "26441192858887473", "is_initial_release": false, "name_with_fallback": "v6", "pdp_metadata_with_fallback": {"version": 5, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26443056195367806"}, "release_status": "RELEASED", "id": "25161600496846722"}, "id": "26443056195367806", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25161600496846722", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2085324512365019"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "27158184013837490", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 VR Space Simulator", "keywords": ["VRFlightSimulator", "EndlessFlying", "InfiniteFlightVR", "HighSpeedVR", "ArcadeFlight"], "long_description": "Infinity Flight VR \u2013 Beyond the Horizon\n\nDefy gravity. Trust your reflexes. Own the sky.\n\nInfinity Flight VR is a fast-paced endless arcade flight experience built exclusively for Meta Quest. Step into the cockpit and dive into an ever-evolving aerial challenge where speed, precision, and focus are everything.\n\nThis isn\u2019t just flying \u2014 it\u2019s survival at full throttle.\n\nDesigned with ultra-smooth locomotion to minimize motion sickness while maintaining high-speed intensity, Infinity Flight VR delivers pure immersive adrenaline from takeoff to crash.\n", "short_description": "Infinity Flight VR \u2013 Endless Arcade Flying\n\nSoar through endless skies in this fast-paced VR flight arcade built exclusively for Meta Quest. Dodge dynamic obstacles, master ultra-smooth controls, and push your reflexes to the limit in a high-speed endless flying challenge. How long can you survive?\n"}, {"images": {"nodes": [{"file_name": "logo infinity flight.png", "id": "4243850329168761", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819356_4243850332502094_4831283372490355261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nHxoD0p3y8Q7kNvwGO8Wo5&_nc_oc=Adqi2Lv60_M9hues0fVXo8_FiqB6nU7d6W5jCP8RC5rfFld70B4X9fjZp03JZciT83U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK22hledewXHe1jzs8LpE9Jcp8Z9Ny1PuF-Fthepvewyg&oe=6AA942BB"}, {"file_name": "image 1 3000x900.png", "id": "2112227412926999", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_2112227416260332_7573008206508835293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jo-UOZLp-gQ7kNvwHlUJTw&_nc_oc=Adp4JwNOVTdxRzBwBlFLhWMwYbcjTsHEze_p-_NOedzMZeqv9tMWkF7QypHsqYJJO7s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMe_dm1ZAj_UqKQoJqIBwg4amIZgCEhRrcgjaNs_hWEA&oe=6AA93C5B"}, {"file_name": "image 1440x1440.png", "id": "1662537848238897", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823296_1662537851572230_3179451702616403183_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btGrF394nh8Q7kNvwHTioEM&_nc_oc=AdqnHWgiejYB_SkqvTRtfuYqn9HsqTIfmy-uSxNPa3ac4N1m_sUthBwWdRu6iO0_QmI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlLnRcilEenmZXT--fDnLgr75HuZmp7va8KlRkpJkmGw&oe=6AA95ED5"}, {"file_name": "image 1008x1440.png", "id": "1298300182109434", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819281_1298300185442767_7462991030345067517_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbLX1OLkbHoQ7kNvwHsjkCV&_nc_oc=AdpgsH8hJvc7bZr5vtcYSbTa_MN_HkAudB_r3s-XxKiioXXOmFujionzKGbteY7l7xc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoKyATZg26BLAU5jj_8Rvd4h2PPBe6IKD2HXNuAvFlsg&oe=6AA9492A"}, {"file_name": "image 1 2560x1440.png", "id": "1199792645473261", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821674_1199792652139927_2896524635217421880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNUVV-aHVtwQ7kNvwH3xZjJ&_nc_oc=AdqbBX9kinaJMfnwyGqaqBzR8A5MHlb_xV9hk1vTuIBwBMu7gStPTIxtNUFMpSTzU4c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLngq4fW10tHeIn_vd2BdX8977fnrsr9ERsL4XpeFDd7g&oe=6AA94952"}]}, "id": "2094018214826426", "locale": "en_US", "screenshots": [{"file_name": "image 4 2560x1440.png", "id": "2581558352216225", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823296_2581558355549558_6591222960026724240_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr-B6I5foGYQ7kNvwHVB-dL&_nc_oc=AdoxbBKvOAFAO2g4JvmTCrIXzshLH5NabEbcLQNm6jz1Bfd01ixAQ-LP24YFRjWOfzA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPMIVMMcJ7Bx7D7VAsyGYCR1khnXwzacr9F_K9QQcxfg&oe=6AA967CC"}, {"file_name": "image 1 2560x1440.png", "id": "764935629534270", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818852_764935636200936_5208914606674678736_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evaoTHmFzbwQ7kNvwESQp88&_nc_oc=AdpTCEGvZUwfeCBe22sIIDsfjAldtjyaItUyuMd2Z850dvn-i3uewrj1TrT-5tPJI0U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlVi8NqgLAvCFMV5G7d828WDqDB7lbHrW69DCzNorRSg&oe=6AA95C69"}, {"file_name": "image 2 2560x1440.png", "id": "1442613883921567", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824322_1442613890588233_2140330901219438368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOy6Y2wvjZEQ7kNvwHu4DED&_nc_oc=Adpy6qU2V7LIFtdsG5rh7mmNYv6i1waFSpWjh00MzduK1thBRrpFHmFL0ZkS1udlvDE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdYnyiBnwdfrK2z4q6gHpoiRYX4JK9pbxiJNzQCr1aaA&oe=6AA96081"}, {"file_name": "image 5 2560x1440.png", "id": "1568545711017552", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821719_1568545717684218_8186249954886211518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm0ouDzHRv0Q7kNvwE8ckjl&_nc_oc=Adr_XMwP-mNdv3pDVru1DuK12TNk1Sr_T96efcl_KD0G9IfnYSc0f_hYITKV0VaagRk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_asEOYujn0Sq5zOKrc8xG_V3K_tiMjOfsg9p3n_jBrQ&oe=6AA94A67"}, {"file_name": "image 3 2560x1440.png", "id": "1943310263736694", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821682_1943310267070027_6208208022242253210_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcNIk67WrD4Q7kNvwG_N5Ou&_nc_oc=AdpKmOuPQEGSQH2W5qvZRb58HAb_WZmgPtbWYSWp8HYeTkKKOaz2Q7K85-FAYK79k9k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMS8_fuydK3lXe4GB5MMfApZMyKtNlLVR2dBcRIC_BOQ&oe=6AA968FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image 4 2560x1440.png", "id": "1687831815912115", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820855_1687831819245448_3336004857835521274_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy_SbQD-i84Q7kNvwHkfaCt&_nc_oc=Ado9YmfhANZ_fjWiIBye79m9HwR5crkGL7rIH6FfumcnMhJpXH9M1jzDaFqWa5jQt0Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7UROzjdM-2DExVVse3BMynalL5OlghCI_N8hcwjd_hg&oe=6AA96659"}, "display_name": "INFINITY FLIGHT \u2013 VR Space Simulator", "keywords": ["VRFlightSimulator", "EndlessFlying", "InfiniteFlightVR", "HighSpeedVR", "ArcadeFlight"], "long_description": "INFINITY FLIGHT \u2013 VR Space Simulator\n\nDefy gravity. Trust your reflexes. Own the sky.\n\nInfinity Flight VR is a fast-paced endless arcade flight experience built exclusively for Meta Quest. Step into the cockpit and dive into an ever-evolving aerial challenge where speed, precision, and focus are everything.\n\nThis isn\u2019t just flying \u2014 it\u2019s survival at full throttle.\n\nDesigned with ultra-smooth locomotion to minimize motion sickness while maintaining high-speed intensity, Infinity Flight VR delivers pure immersive adrenaline from takeoff to crash.", "short_description": "INFINITY FLIGHT \u2013 VR Space Simulator\n\nSoar through endless skies in this fast-paced VR flight arcade built exclusively for Meta Quest. Dodge dynamic obstacles, master ultra-smooth controls, and push your reflexes to the limit in a high-speed endless flying challenge. How long can you survive?"}, {"images": {"nodes": []}, "id": "1621904905553534", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 Simulador Espacial VR", "keywords": ["SimuladorVR", "VueloInfinito", "ArcadeVR", "VRFlightSimulator", "HighSpeedVR"], "long_description": "Infinity Flight VR \u2013 M\u00e1s All\u00e1 del Horizonte\n\nDesaf\u00eda la gravedad. Conf\u00eda en tus reflejos. Domina el cielo.\n\nInfinity Flight VR es una experiencia de vuelo arcade endless de alta velocidad, creada exclusivamente para Meta Quest. Ponte en la cabina y sum\u00e9rgete en un desaf\u00edo a\u00e9reo en constante evoluci\u00f3n donde la velocidad, la precisi\u00f3n y la concentraci\u00f3n lo son todo.\n\nNo es solo volar \u2014 es supervivencia a m\u00e1xima velocidad.\n\nCon un sistema de locomoci\u00f3n ultra fluido dise\u00f1ado para minimizar el mareo en VR sin sacrificar intensidad, Infinity Flight VR ofrece pura adrenalina inmersiva desde el despegue hasta el impacto.", "short_description": "Infinity Flight VR \u2013 Vuelo Arcade Infinito\n\nSurca cielos infinitos en este fren\u00e9tico juego de vuelo arcade en VR, desarrollado exclusivamente para Meta Quest. Esquiva obst\u00e1culos din\u00e1micos, domina controles ultra suaves y lleva tus reflejos al l\u00edmite en un desaf\u00edo de vuelo endless a alta velocidad. \u00bfCu\u00e1nto tiempo podr\u00e1s sobrevivir?"}, {"images": {"nodes": []}, "id": "1582471523242867", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 Simulador Espacial VR", "keywords": ["VRFlightSimulator", "EndlessFlying", "InfiniteFlightVR", "HighSpeedVR", "ArcadeFlight"], "long_description": "Infinity Flight VR \u2013 Al\u00e9m do Horizonte\n\nDesafie a gravidade. Confie nos seus reflexos. Domine o c\u00e9u.\n\nInfinity Flight VR \u00e9 uma experi\u00eancia de voo arcade endless em alta velocidade, criada exclusivamente para Meta Quest. Entre no cockpit e mergulhe em um desafio a\u00e9reo em constante evolu\u00e7\u00e3o, onde velocidade, precis\u00e3o e foco s\u00e3o tudo.\n\nIsso n\u00e3o \u00e9 apenas voar \u2014 \u00e9 sobreviver em velocidade m\u00e1xima.\n\nCom um sistema de locomo\u00e7\u00e3o ultra suave projetado para minimizar o enjoo em VR sem comprometer a intensidade, Infinity Flight VR oferece pura adrenalina imersiva da decolagem at\u00e9 a queda.", "short_description": "Infinity Flight VR \u2013 Voo Arcade Infinito\n\nSobrevoe c\u00e9us infinitos neste fren\u00e9tico jogo de voo arcade em VR, desenvolvido exclusivamente para Meta Quest. Desvie de obst\u00e1culos din\u00e2micos, domine controles ultra suaves e leve seus reflexos ao limite em um desafio de voo endless em alta velocidade. At\u00e9 quanto tempo voc\u00ea consegue sobreviver?"}, {"images": {"nodes": []}, "id": "1316987456562962", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 Simulateur Spatial VR", "keywords": ["SimulateurVR", "VolInfini", "ArcadeVR", "VRFlightSimulator", "HighSpeedVR"], "long_description": "Infinity Flight VR \u2013 Au-del\u00e0 de l\u2019Horizon\n\nD\u00e9fiez la gravit\u00e9. Faites confiance \u00e0 vos r\u00e9flexes. Dominez le ciel.\n\nInfinity Flight VR est une exp\u00e9rience de vol arcade infinie et rapide, con\u00e7ue exclusivement pour Meta Quest. Prenez place dans le cockpit et plongez dans un d\u00e9fi a\u00e9rien en constante \u00e9volution o\u00f9 vitesse, pr\u00e9cision et concentration sont essentielles.\n\nCe n\u2019est pas juste du pilotage \u2014 c\u2019est de la survie \u00e0 pleine vitesse.\n\nGr\u00e2ce \u00e0 un syst\u00e8me de locomotion ultra-fluide con\u00e7u pour r\u00e9duire le mal des transports tout en conservant une intensit\u00e9 maximale, Infinity Flight VR offre une mont\u00e9e d\u2019adr\u00e9naline immersive du d\u00e9collage jusqu\u2019au crash.", "short_description": "Infinity Flight VR \u2013 Vol Arcade Infini\n\nEnvolez-vous \u00e0 travers des cieux infinis dans ce jeu d\u2019arcade de vol en VR ultra-rapide, con\u00e7u exclusivement pour Meta Quest. \u00c9vitez des obstacles dynamiques, ma\u00eetrisez des commandes ultra-fluides et poussez vos r\u00e9flexes \u00e0 la limite dans un d\u00e9fi de vol sans fin \u00e0 grande vitesse. Combien de temps survivrez-vous ?"}, {"images": {"nodes": []}, "id": "1002409026014621", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 VR Weltraum-Simulator", "keywords": ["VRFlugsimulator", "EndlosFlug", "ArcadeFlug", "VRFlightSimulator", "HighSpeedVR"], "long_description": "Infinity Flight VR \u2013 Jenseits des Horizonts\n\nTrotze der Schwerkraft. Vertraue deinen Reflexen. Beherrsche den Himmel.\n\nInfinity Flight VR ist ein rasantes Endlos-Arcade-Flugerlebnis, das exklusiv f\u00fcr Meta Quest entwickelt wurde. Nimm im Cockpit Platz und st\u00fcrze dich in eine sich st\u00e4ndig ver\u00e4ndernde Luft-Herausforderung, in der Geschwindigkeit, Pr\u00e4zision und Fokus alles sind.\n\nDas ist nicht einfach nur Fliegen \u2014 es ist \u00dcberleben bei H\u00f6chstgeschwindigkeit.\n\nMit einem ultra-sanften Fortbewegungssystem, das Motion Sickness minimiert und gleichzeitig maximale Intensit\u00e4t bietet, liefert Infinity Flight VR pures, immersives Adrenalin vom Start bis zum Absturz.", "short_description": "Infinity Flight VR \u2013 Endloses Arcade-Fliegen\n\nErhebe dich in endlose L\u00fcfte in diesem rasanten VR-Flug-Arcade-Spiel, exklusiv entwickelt f\u00fcr Meta Quest. Weiche dynamischen Hindernissen aus, meistere ultra-fl\u00fcssige Steuerung und bringe deine Reflexe in einer Hochgeschwindigkeits-Endlosflug-Herausforderung an ihre Grenzen. Wie lange kannst du \u00fcberleben?"}, {"images": {"nodes": []}, "id": "991739173787781", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 Simulador Espacial VR", "keywords": ["SimuladorVR", "VueloInfinito", "ArcadeVR", "VRFlightSimulator", "HighSpeedVR"], "long_description": "Infinity Flight VR \u2013 M\u00e1s All\u00e1 del Horizonte\n\nDesaf\u00eda la gravedad. Conf\u00eda en tus reflejos. Domina el cielo.\n\nInfinity Flight VR es una experiencia de vuelo arcade endless de alta velocidad, creada exclusivamente para Meta Quest. Ponte en la cabina y sum\u00e9rgete en un desaf\u00edo a\u00e9reo en constante evoluci\u00f3n donde la velocidad, la precisi\u00f3n y la concentraci\u00f3n lo son todo.\n\nNo es solo volar \u2014 es supervivencia a m\u00e1xima velocidad.\n\nCon un sistema de locomoci\u00f3n ultra fluido dise\u00f1ado para minimizar el mareo en VR sin sacrificar intensidad, Infinity Flight VR ofrece pura adrenalina inmersiva desde el despegue hasta el impacto.", "short_description": "Infinity Flight VR \u2013 Vuelo Arcade Infinito\n\nSurca cielos infinitos en este fren\u00e9tico juego de vuelo arcade en VR, desarrollado exclusivamente para Meta Quest. Esquiva obst\u00e1culos din\u00e1micos, domina controles ultra suaves y lleva tus reflejos al l\u00edmite en un desaf\u00edo de vuelo endless a alta velocidad. \u00bfCu\u00e1nto tiempo podr\u00e1s sobrevivir?"}, {"images": {"nodes": []}, "id": "968985642638999", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 Simulatore Spaziale VR", "keywords": ["VRFlightSimulator", "EndlessFlying", "InfiniteFlightVR", "HighSpeedVR", "ArcadeFlight"], "long_description": "Infinity Flight VR \u2013 Oltre l\u2019Orizzonte\n\nSfida la gravit\u00e0. Fidati dei tuoi riflessi. Conquista il cielo.\n\nInfinity Flight VR \u00e8 un\u2019esperienza di volo arcade endless ad alta velocit\u00e0, creata esclusivamente per Meta Quest. Sali in cabina di pilotaggio e immergiti in una sfida aerea in continua evoluzione dove velocit\u00e0, precisione e concentrazione sono fondamentali.\n\nNon \u00e8 solo volare \u2014 \u00e8 sopravvivere al massimo della velocit\u00e0.\n\nGrazie a un sistema di locomozione ultra-fluido progettato per ridurre la motion sickness mantenendo un\u2019intensit\u00e0 elevata, Infinity Flight VR offre pura adrenalina immersiva dal decollo fino allo schianto.", "short_description": "Infinity Flight VR \u2013 Volo Arcade Infinito\n\nSorvola cieli infiniti in questo frenetico gioco di volo arcade in VR, sviluppato esclusivamente per Meta Quest. Schiva ostacoli dinamici, padroneggia controlli ultra-fluidi e metti alla prova i tuoi riflessi in una sfida di volo endless ad alta velocit\u00e0. Quanto a lungo riuscirai a sopravvivere?"}, {"images": {"nodes": []}, "id": "916169144799624", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 VR\u30b9\u30da\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc", "keywords": ["VR\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc", "\u30a8\u30f3\u30c9\u30ec\u30b9\u30d5\u30e9\u30a4\u30c8", "\u30a2\u30fc\u30b1\u30fc\u30c9VR", "VRFlightSimulator", "HighSpeedVR"], "long_description": "Infinity Flight VR \u2013 \u5730\u5e73\u7dda\u306e\u5f7c\u65b9\u3078\n\n\u91cd\u529b\u306b\u6311\u3081\u3002\u53cd\u5c04\u795e\u7d4c\u3092\u4fe1\u3058\u308d\u3002\u7a7a\u3092\u652f\u914d\u305b\u3088\u3002\n\nInfinity Flight VR\u306f\u3001Meta Quest\u5c02\u7528\u306b\u8a2d\u8a08\u3055\u308c\u305f\u9ad8\u901f\u30a8\u30f3\u30c9\u30ec\u30b9\u30fb\u30a2\u30fc\u30b1\u30fc\u30c9\u30d5\u30e9\u30a4\u30c8\u4f53\u9a13\u3002\u30b3\u30c3\u30af\u30d4\u30c3\u30c8\u306b\u4e57\u308a\u8fbc\u307f\u3001\u30b9\u30d4\u30fc\u30c9\u30fb\u7cbe\u5bc6\u3055\u30fb\u96c6\u4e2d\u529b\u304c\u8a66\u3055\u308c\u308b\u3001\u5e38\u306b\u9032\u5316\u3057\u7d9a\u3051\u308b\u7a7a\u4e2d\u30c1\u30e3\u30ec\u30f3\u30b8\u3078\u98db\u3073\u7acb\u3068\u3046\u3002\n\n\u3053\u308c\u306f\u305f\u3060\u306e\u30d5\u30e9\u30a4\u30c8\u3067\u306f\u306a\u3044\u2015\u2015\n\u30d5\u30eb\u30b9\u30ed\u30c3\u30c8\u30eb\u3067\u751f\u304d\u6b8b\u308b\u30b5\u30d0\u30a4\u30d0\u30eb\u3060\u3002\n\n\u30e2\u30fc\u30b7\u30e7\u30f3\u9154\u3044\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u8d85\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u52d5\u30b7\u30b9\u30c6\u30e0\u3092\u63a1\u7528\u3057\u306a\u304c\u3089\u3082\u3001\u30b9\u30d4\u30fc\u30c9\u611f\u3042\u3075\u308c\u308b\u8feb\u529b\u3092\u5b9f\u73fe\u3002\u96e2\u9678\u304b\u3089\u30af\u30e9\u30c3\u30b7\u30e5\u307e\u3067\u3001\u6ca1\u5165\u611f\u3042\u3075\u308c\u308b\u7d14\u7c8b\u306a\u30a2\u30c9\u30ec\u30ca\u30ea\u30f3\u3092\u4f53\u611f\u305b\u3088\u3002", "short_description": "Infinity Flight VR \u2013 \u30a8\u30f3\u30c9\u30ec\u30b9\u30fb\u30a2\u30fc\u30b1\u30fc\u30c9\u30d5\u30e9\u30a4\u30c8\n\nMeta Quest\u5c02\u7528\u306b\u958b\u767a\u3055\u308c\u305f\u3001\u30cf\u30a4\u30b9\u30d4\u30fc\u30c9VR\u30d5\u30e9\u30a4\u30c8\u30a2\u30fc\u30b1\u30fc\u30c9\u30b2\u30fc\u30e0\u3002\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306b\u52d5\u304f\u969c\u5bb3\u7269\u3092\u56de\u907f\u3057\u3001\u8d85\u30b9\u30e0\u30fc\u30ba\u306a\u64cd\u4f5c\u3067\u6a5f\u4f53\u3092\u64cd\u308a\u306a\u304c\u3089\u3001\u7121\u9650\u306b\u7d9a\u304f\u7a7a\u3078\u6311\u6226\u3057\u3088\u3046\u3002\u3042\u306a\u305f\u306f\u3069\u3053\u307e\u3067\u751f\u304d\u6b8b\u308c\u308b\u304b\uff1f"}, {"images": {"nodes": []}, "id": "783790564729708", "locale": "pt_PT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT \u2013 Simulador Espacial VR", "keywords": ["VRFlightSimulator", "EndlessFlying", "InfiniteFlightVR", "HighSpeedVR", "ArcadeFlight"], "long_description": "Infinity Flight VR \u2013 Al\u00e9m do Horizonte\n\nDesafie a gravidade. Confie nos seus reflexos. Domine o c\u00e9u.\n\nInfinity Flight VR \u00e9 uma experi\u00eancia de voo arcade endless em alta velocidade, criada exclusivamente para Meta Quest. Entre no cockpit e mergulhe em um desafio a\u00e9reo em constante evolu\u00e7\u00e3o, onde velocidade, precis\u00e3o e foco s\u00e3o tudo.\n\nIsso n\u00e3o \u00e9 apenas voar \u2014 \u00e9 sobreviver em velocidade m\u00e1xima.\n\nCom um sistema de locomo\u00e7\u00e3o ultra suave projetado para minimizar o enjoo em VR sem comprometer a intensidade, Infinity Flight VR oferece pura adrenalina imersiva da decolagem at\u00e9 a queda.", "short_description": "Infinity Flight VR \u2013 Voo Arcade Infinito\n\nSobrevoe c\u00e9us infinitos neste fren\u00e9tico jogo de voo arcade em VR, desenvolvido exclusivamente para Meta Quest. Desvie de obst\u00e1culos din\u00e2micos, domine controles ultra suaves e leve seus reflexos ao limite em um desafio de voo endless em alta velocidade. At\u00e9 quanto tempo voc\u00ea consegue sobreviver?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.georgegamesnation.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jorge Poveda", "support_website_url": null, "website_url": "https://www.georgegamesnation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26443056195367806"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823296_1662537851572230_3179451702616403183_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btGrF394nh8Q7kNvwHTioEM&_nc_oc=AdqnHWgiejYB_SkqvTRtfuYqn9HsqTIfmy-uSxNPa3ac4N1m_sUthBwWdRu6iO0_QmI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRFiaxn1DC8NXDeX-zbWvlfh4c6JcOZWiwP9sXYHB2bA&oe=6AA95ED5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "INFINITY FLIGHT \u2013 VR Space Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1771023600, "lastRevision": {"nodes": [{"id": "25161600696846702", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25161600496846722", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1607006846997058"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "logo infinity flight.png", "id": "4243850329168761", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819356_4243850332502094_4831283372490355261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nHxoD0p3y8Q7kNvwGO8Wo5&_nc_oc=Adqi2Lv60_M9hues0fVXo8_FiqB6nU7d6W5jCP8RC5rfFld70B4X9fjZp03JZciT83U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK22hledewXHe1jzs8LpE9Jcp8Z9Ny1PuF-Fthepvewyg&oe=6AA942BB"}, {"file_name": "image 1 3000x900.png", "id": "2112227412926999", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_2112227416260332_7573008206508835293_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jo-UOZLp-gQ7kNvwHlUJTw&_nc_oc=Adp4JwNOVTdxRzBwBlFLhWMwYbcjTsHEze_p-_NOedzMZeqv9tMWkF7QypHsqYJJO7s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMe_dm1ZAj_UqKQoJqIBwg4amIZgCEhRrcgjaNs_hWEA&oe=6AA93C5B"}, {"file_name": "image 1440x1440.png", "id": "1662537848238897", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823296_1662537851572230_3179451702616403183_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btGrF394nh8Q7kNvwHTioEM&_nc_oc=AdqnHWgiejYB_SkqvTRtfuYqn9HsqTIfmy-uSxNPa3ac4N1m_sUthBwWdRu6iO0_QmI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlLnRcilEenmZXT--fDnLgr75HuZmp7va8KlRkpJkmGw&oe=6AA95ED5"}, {"file_name": "image 1008x1440.png", "id": "1298300182109434", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819281_1298300185442767_7462991030345067517_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbLX1OLkbHoQ7kNvwHsjkCV&_nc_oc=AdpgsH8hJvc7bZr5vtcYSbTa_MN_HkAudB_r3s-XxKiioXXOmFujionzKGbteY7l7xc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoKyATZg26BLAU5jj_8Rvd4h2PPBe6IKD2HXNuAvFlsg&oe=6AA9492A"}, {"fi
36_5208914606674678736_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikbVLvJ_MX8Q7kNvwGEcNkB&_nc_oc=AdrHLgqxOW96mvRZOdZp7aUqpIil1EyL3dNG00tkBr_IUV_5rgWroGAX-JGBc0jDS9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MeTzg7oEKcQr3ytejINMLNP8P_XbD6YORLWznAaW6Og&oe=69D3C969"}, {"file_name": "image 2 2560x1440.png", "id": "1442613883921567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1442613890588233_2140330901219438368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjQ306I5784Q7kNvwH44yXs&_nc_oc=Adq6BWUa1BHBvGOpRGlTI4KINEPPtVG6bqt4GHmBz0IFsv9D8FdJtT8nJnjtnsiPXcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Xrw0VXxTt5LSW5A-Wo95VoLbBSIKaZ3sKX2I29Q159Q&oe=69D39541"}, {"file_name": "image 5 2560x1440.png", "id": "1568545711017552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1568545717684218_8186249954886211518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XExSQwCGs0MQ7kNvwF2aHIY&_nc_oc=Adq5xuN3UoNCnsoyp1w7TEI2D7FbM8GDDzC_9tjKSfN8vNFkJvXvyh91vFWhWANzZAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qFxKntOw0LxrnyWpEKuSlIRhhMzjWUkppO9C_wPkkwQ&oe=69D3B767"}, {"file_name": "image 3 2560x1440.png", "id": "1943310263736694", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_1943310267070027_6208208022242253210_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk_tHWR4qj0Q7kNvwHkM8Tb&_nc_oc=AdrMdlVBZ0ZjCoJVlkswrqVLZcvP_l-GQyzDzi8F4ITfpBOJ9scmJRl4tDjnK3gpCTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dP8z1UWCOnjn2KaQ_BLMu0vfR33FixpppcEZPAUdsdg&oe=69D39DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INFINITY FLIGHT", "keywords": ["FLIGTH", "VR", "PLANES", "RUNNER", "SIMULATOR"], "long_description": "Infinity Flight VR: Beyond the Horizon\n\nExperience the Freedom of Flight \u2013 Without the Limits.\n\nStep into the cockpit and prepare for an adrenaline-fueled journey through an ever-changing sky. Infinity Flight VR combines the addictive rhythm of an infinity runner with the immersive power of virtual reality.\n\nEngineered for a silky-smooth flight experience on Meta Quest, the game features a refined locomotion system that minimizes motion sickness while maximizing the thrill of high-speed maneuvers. You aren't just playing a game; you are mastering the air.", "short_description": "Infinity Flight VR\n\nTake to the skies in the ultimate VR endless flyer! Pilot your aircraft with ultra-smooth locomotion as you weave through a relentless gauntlet of moving obstacles. Test your reflexes in a high-stakes infinity runner designed specifically for Meta Quest. How long can you survive the slipstream?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.georgegamesnation.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jorge Poveda", "support_website_url": null, "website_url": "http://georgegamesnation.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25205331642473607"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "982137611144953"}, {"status": "CANCELLED", "id": "788046594356712"}, {"status": "PUBLISHED", "id": "1147356634010698"}, {"status": "PUBLISHED", "id": "1216752803898231"}]}, "baseline_offer": {"id": "1147356634
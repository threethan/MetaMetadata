nd witness the fusion of technology and artistry.   We'll explore the incredible potential of AR/VR in creating unforgettable entertainment experiences that captivate audiences like never before.", "short_description": "\"Exploring the Frontiers of AR/VR: A Journey into Immersive Technologies\" - Mayaavi is a fictional detective. Mayaavi detects and uncover the potential value of VR and AR in real world. Education, gaming, film, industries and more - we are exploring the VR/AR opportunities with the latest high-end and powerful cutting edge technologies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mayaavi.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mayaavi", "support_website_url": null, "website_url": "https://www.mayaavi.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "686083326896154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566698_226013403684660_948341631333485070_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLaz0otTE7wQ7kNvwEIb17o&_nc_oc=Adl9kuOHHX3pjfxFSVSo6DBbXmlT0xOa85Vhw2r5tEOIGjwa53Heu0VU3Om3_PjgoSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsC4J9aCDeL4qn2WlpDNJ257vVuX2otqjUj_md0o4fvvA&oe=69A6E1C8"}, "is_concept": false, "is_test": false, "is_t
j1ngzi4pY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVpTNkQHAY0WeANhIceS9ZwkumUVFO_5yN8r3hhoUySA&oe=69CE5D94"}, {"file_name": "My project-1.png", "id": "943581313417556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75234365_943581316750889_5742763679985636552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rH3l0qfM-MQ7kNvwFY1sRA&_nc_oc=Adoacx8xHYN4xBHFddtsy8_PYfujkG1QNIRKMaYeCi-bSLA6obocxY0ImEvxUAbAe-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMx2dt4Rmqm-IHibffO7doMM-LVQJJCEh-suC5Y4kS1A&oe=69CE65C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MayaaviVR", "keywords": [], "long_description": "Step into the realm of augmented and virtual reality as we explore the dynamic intersection of AR/VR and entertainment. This App will transport you to a world where imagination knows no boundaries. Discover how AR/VR is transforming storytelling, gaming, theme parks, and even live performances. Experience breathtaking virtual environments, engage in interactive narratives, and witness the fusion of technology and artistry.   We'll explore the incredible potential of AR/VR in creating unforgettable entertainment experiences that captivate audiences like never before.", "short_description": "\"Exploring the Frontiers of AR/VR: A Journey into Immersive Technologies\" - Mayaavi is a fictional detective. Mayaavi detects and uncover the potential value of VR and AR in real world. Education, gaming, film, industries and more - we are exploring the VR/AR opportunities with the latest high-end and powerful cutting edge technologies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mayaavi.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mayaavi", "support_website_url": null, "website_url": "https://www.mayaavi.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "conte
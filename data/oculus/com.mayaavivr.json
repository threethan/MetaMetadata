railer_thumbnail": null, "display_name": "MayaaviVR", "keywords": [], "long_description": "Step into the realm of augmented and virtual reality as we explore the dynamic intersection of AR/VR and entertainment. This App will transport you to a world where imagination knows no boundaries. Discover how AR/VR is transforming storytelling, gaming, theme parks, and even live performances. Experience breathtaking virtual environments, engage in interactive narratives, and witness the fusion of technology and artistry.   We'll explore the incredible potential of AR/VR in creating unforgettable entertainment experiences that captivate audiences like never before.", "short_description": "\"Exploring the Frontiers of AR/VR: A Journey into Immersive Technologies\" - Mayaavi is a fictional detective. Mayaavi detects and uncover the potential value of VR and AR in real world. Education, gaming, film, industries and more - we are exploring the VR/AR opportunities with the latest high-end and powerful cutting edge technologies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mayaavi.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mayaavi", "support_website_url": null, "website_url": "https://www.mayaavi.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "686083326896154"}, "review_mess
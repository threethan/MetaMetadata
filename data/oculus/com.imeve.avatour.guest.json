x3M3v_zlVM3ENWbWT3Kz6L44dc5nI_NyPBBwUDitqO8FFwKgwVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt7_0ZxEl5cUOD75k7C58LdRxpdGDJ0MnilDvuOjArgw&oe=6ACCF20C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1cppcrj9M8Q7kNvwHqLxl6&_nc_oc=AdqVx2_bTzDCIquwYpxea2g_4ormg-xzl-Gr5cczmop-pqfWqQJ9CSGG8QtZ90zdfsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7YJtrqUIT5npjj8E9PUNsmLczoNEOdppqGOQlIvmJyA&oe=6ACCEA66"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loAHDV7KpqUQ7kNvwGFQ42O&_nc_oc=Ado_QWwvfXy2qOGvt2WjGpynbWp4JGs2f6wADqtzDrgvQ-bME6MKmt2DYv6Ts4Mqyrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGZDTFZJKdYq4z9E5gXAGkotGQzL-POK6aGYjJzAbjFw&oe=6ACCFA90"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WueB6Q-WkS0Q7kNvwH9iSy0&_nc_oc=AdrE6IWPhvT0DaK8DHvHXcDkJ4qrCm9kAAL_ujrAEgdnXj2RAT9J6pEgwklI0iJT0z0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObn3rZUdfnKkLahlsZCe0pZrXN1FM7eq9v9y2Wju8vMQ&oe=6ACD1262"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7n2FZRI7IkQ7kNvwEwGuBi&_nc_oc=Adp8xcfkepBJ723ps8uuj19a5nzjTzQFmnEuXBMfK850QQ9qgK4MV_Pig_tCMWJXkMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-nvu1H3eVGxL_7cE8TyGAQXuJivWV5_7SfWQROm-lBQ&oe=6ACD0566"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
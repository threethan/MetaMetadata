9-mtJKxRQEnIsocy6GFGUnt_CR8M5ZXQwLvGMd-ichtN0PPVcC4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq28cIcChwcdTwWz9mIsAyUDA_UyRc83F4IcC4yyWDtg&oe=6AE35B8C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jdVciQguP8Q7kNvwFlN5be&_nc_oc=AdreeBeF583S7vn6qypS_cYaM-Vn0zss2r1poY76ZJTbro0HHh55qaZGvtsVWw8tc2A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO035KrmkKmKf6bMA-EpUsOOnwJmSI09l36zzLU3_Nlvw&oe=6AE353E6"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGVy7aZFXsAQ7kNvwHWs8zP&_nc_oc=AdqZFy7fzxyDdjTUL6PBfM1goVrEsf1lJ5nni0sy_DiwAUX42zFCxFpViStSLxgNWkU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNidgu0ivqbEUnPKaStoPIYPbP10GByzXkExaZn6dzC3Q&oe=6AE36410"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlQI1drWYrAQ7kNvwEdF7In&_nc_oc=AdocpkESYEBD68Bsbjfod45a7TVzeg1x_1c2fhRLYYDvkkUBTLqHSHg_xc24ZCudzWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZeIdjb6dx8nw56eO3Y04CaFFCQRDgn_KaXtvuHJZynw&oe=6AE343A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8Dtf1Hg7EMQ7kNvwFcF7pI&_nc_oc=Adrx0Q_fUaTDLxW96c7uQ0Ctd-0qrbZh-eCoiiuNBnLDlo1zsHpeh9T8647X3SNKz-w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5f5n6iSuybpInwYQOvv12uZbbjnC-PWH44_xfCArV9w&oe=6AE336A6"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
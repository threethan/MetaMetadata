B_mvmvbVGXOqJ72HZv_WOkevDNC74yYQgC0P36m59tuLKad-fIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfYzey8u3XDgqQavzN71M28MTMiOUNuDaOD7fMGbUV4Q&oe=6AE5FE8C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7at5uopt0GMQ7kNvwE8m-Me&_nc_oc=AdoNj986yN5VXuUWSKG18q_vYhmxpeyioU44iSZ5ijjEysfQLKE4HrxHJlqUxpyECMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUSkTIo-Ot1kwSHwp7JZW5lHCSA0VWrC6muJ9R3aW8dw&oe=6AE5F6E6"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp3KDjxxUfYQ7kNvwFg90H3&_nc_oc=AdpLINOWtj4xtNVkBgTnbxDeT0YYZHExLLjKApZRaeVf5QvdGuhjAubIOU6UzXsoVxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOo-ZqQRUIP65LMTstPaYYIj1taNGDJC4yShn0igoOZg&oe=6AE60710"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3fF2GCaBS0Q7kNvwEV_LA8&_nc_oc=AdpXlw5_ubnpW4mmgYFbZArFYWY5Bah0q2NQhhAX3elLBAhtw3lkJzwZBxZ6Gr61yqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtVVN0eOdCgRsoWAD-lhj07P-wEUFfOFw_ZyTUSMB-ew&oe=6AE5E6A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdfzyRTA9IEQ7kNvwEpV-xz&_nc_oc=Adqu30lv3SQMh3rVFXeiYKdmgAb0oqbd8WjY10Gd9jsnj9SHEjnC0KTncMn2E9JL_AI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjeJDLgmerGFUf7ffkQj74_lke6zNPE8GJAdH-6jlfjQ&oe=6AE611E6"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
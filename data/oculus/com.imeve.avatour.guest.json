--5eJhcEAN-5WmQPKqoRAlppkpdX_GtNIw8tcEhCA9iZe3TdQUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU0PHPi-AB_fIIicA27nUAqlzmJ2-iMp7Ti1Jif1QONA&oe=6AE9F30C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV-i_dbTmU8Q7kNvwHbXNWZ&_nc_oc=AdqtR8KWlhDkhyYD9FLTDhYiTxW30bWgq8q0GUlzo15zn_aT2zQbSQCCCm76dqtpUsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSDVsQtJSLlHoJlUgQFNAA-jti1hUiZSx9XErM7_b5Dg&oe=6AE9EB66"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB-kfKUIq4MQ7kNvwED1Ji1&_nc_oc=AdoyNrPdItXdECDyKj3J4U9Dgo6sZQlR0UYA9ywHH1lm0z4lvSjJgnEcBrcux_Q-ABU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqxWcBMOA63Q-dL3JpL53tMH2Igd7n0Ia1MZT-I8kzsA&oe=6AE9FB90"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voxAknhovfUQ7kNvwG1v-5F&_nc_oc=AdpGqZfgacZ0MMZnrW0NcDQ17t4QQuDVxeFn_Npu-1CObmPwNMk37tnNf_WyEbP_Ea4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgAqhb7eTB6VjgCqzFAdHteBCxphXYRixKlfDL-jReSw&oe=6AEA1362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phn8_cDA2sQQ7kNvwFs6FIt&_nc_oc=AdpkB12ZyHf8593hECV-cDwYNN1Vv2RIfNyHNCnfvBk-pmvTVJWARpljNNhzWIywaPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSykS8xXB9K5dUmqVHHbpq4V_Y0i_C8NyNxhx-zNyhmg&oe=6AEA0666"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
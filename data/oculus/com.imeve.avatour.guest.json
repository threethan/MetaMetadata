k7P9ycIenBa96pf8l0Q3wyXXnLysU9BWjNhgNvOkgbIbC-85buM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvAraZdQf0PURR4pf-hga6C3cQzHd3zDLzFt42B4xUMw&oe=6ADCC40C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8g-mlyls9IQ7kNvwFiYrp9&_nc_oc=AdoEBG_8RC2yuXLVQnwgjqT_0vWpwdgmbcMAAMOsg1ODaBN48lD1cGTq8Vo0WLjOvrE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMztbuBhpmTeHGvitY43Mb2btcNmE8LojoM2DDPQ4KA0Q&oe=6ADCBC66"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KjHFH6fpncQ7kNvwGipTcv&_nc_oc=AdoAPD88bDELdDZrUkty5MC1BOV5WUJ-KUQVNutTpOIQRX3abQQb5v-0qqgujc5tmpE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Qpun17zOkNbQa_j-aHVQu7e5IDnug6mF2OZfjWI2Ng&oe=6ADCCC90"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9pjOtQ3BNkQ7kNvwFTHMqB&_nc_oc=Adr72hKToFmFNt166KnkNUw5RHuH_j0FBOs5oUqGHFKLyO8BPhZeuAHtHy4OgYyZq2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGOIh_7HHVPAv1aU9Lk2C6D6huVDFUqvmlC6LpO7pcmQ&oe=6ADCAC22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgBrtCzGbGcQ7kNvwHLGSM8&_nc_oc=Adq3EsHJ3Et0NV0bRQiz6_5ex1u2AXk7X-gSzbKBmrAQtlB4bd-2Ao_XLHh_cSuT3mk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrn2xHNPtA5duG8pBaU5u1RvLi1F9zCOLz1FdVmU7Klw&oe=6ADCD766"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
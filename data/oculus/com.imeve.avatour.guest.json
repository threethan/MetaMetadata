1671481992721_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIqKKUDkxWMQ7kNvwHDenap&_nc_oc=Adp_9eD4JG2Ld4AdpTk5fP_h2TyEezwJfGtbeLr-zny2-nTgYzF7TUmm9MLn_TyL3Ss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTokH8U0s2okLS5HEyAyGJA3Qil6Nb1fk65MwB2DpTYQ&oe=6AFB29E6"}, "display_name": "AVATOUR", "keywords": [], "long_description": "AVATOUR makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an AVATOUR host can invite up to 9 remote guests to a live experience of a real place. Guests may join using this Oculus app, or on desktop or mobile using any web browser. Unlike a standard live stream, an AVATOUR is real time, allowing guests to communicate with each other and with the host user in the real world.\n\nAVATOUR is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.co for more information, or to register for an AVATOUR Host account.", "short_description": "AVATOUR makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an AVATOUR host can invite up to 9 remote guests to a live experience of a real place. Guests may join using this Oculus app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "AVATOUR", "developer_privacy_policy_url": "https://avatour.co/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AVATOUR", "support_website_url": "https://support.avatour.co/", "website_url": "https://avatour.co/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE
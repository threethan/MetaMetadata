3aXqYf43M-1LEYF8Iqlbkne-a1pTohLmFqgJB1c9kteCNGdkzuo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK5EvADFJBn_NTG9AV9CKwNMPcfogbkR4o963polPTtA&oe=6AE0B88C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVWAsq2skqUQ7kNvwEU6mDg&_nc_oc=AdppRN2iDVDEDu7sbXuCG7I4aqdVN50zgbswRQ6ykhlY6UJxFa2B4GbJ6Iws-vf_bDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9daKRpvQjh3r5ekoUEfMRTKyaEhYvx77_8p_Pg9-pmQ&oe=6AE0B0E6"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGVy7aZFXsAQ7kNvwG4yIgt&_nc_oc=AdrJJnFg2AcCYZ5NpNGxkAX5qqw_jNO-O_Ad3GoWWuiab_cm_x_8OiI8d5A_4IaoE-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTQcRu0_2KuMi1D7pncZuKdsR-waY6WRO-L1ZTZQQjIw&oe=6AE0C110"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlQI1drWYrAQ7kNvwFlPkOp&_nc_oc=AdoUwdhp95oYjlNb_2MpPhkgKWqUit8TELFah9-e8eS4izq0Z9_WGj2X3VXOVbfJ8cU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPouWVwzhcj-jzNtnt_RQElPrx1Xk5R-RLHQuT4-MZDWQ&oe=6AE0A0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8Dtf1Hg7EMQ7kNvwEmmMoF&_nc_oc=Adr-a-J0PADkwSY-MZLhlAL2wC1ijEHkFQRPWLgyLwWnOIY21gaTTBfx4KFwk74kpv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD8wPYvN-7D7pj_RZMGSNUATrf8oIGe2_07v4ygh2kDQ&oe=6AE0CBE6"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
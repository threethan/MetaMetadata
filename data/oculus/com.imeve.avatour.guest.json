Z90vWvPZ1lCwocsOqvgxC68tu-mkvkCA3kP7CawCTll5c2ezrD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcypA5MAepTWA1w1ieBG5TLea9HWsy5uHPHf4v14HM5A&oe=6AD2380C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRLcs1aDcpAQ7kNvwEVC22Y&_nc_oc=AdqGmP3dSq6jUf63IphTTLEAxn1N_CrTn8nYsqvizbp8b3rksp4q7PU9jCSoieRyBS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGP7D_tCzrqhPAQ4V5IqsjwvkFdyZPuKAg3SXTNWQJrQ&oe=6AD23066"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JH6pUgFEZecQ7kNvwEwlAwP&_nc_oc=AdpZ4GhW1fvUVPGL5P3UlILahJAsC9Xy4uPmCZcR9GdORKQR08nU-SQEbZK_4frchYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPug8WDZisxUOgA6j2oNbJvbfsI0iKiYP28CG2kiH-R4g&oe=6AD24090"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nLs_zsGWAAQ7kNvwFK6kgG&_nc_oc=Adq9RAr3Tin9i9nlM4RcWGBzwo4ZFNNjWIxntN9A4CAh8flepFrkodDG6ycXSha4uAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTnWUPwNttyx2mn8FOX7L0cOw3UvnBr8x5M3UTC3BfZg&oe=6AD25862"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rP71p7Au2DgQ7kNvwEO3dLO&_nc_oc=AdoG_ODWeMt2lULtoS9pgKzyIFcxpcoZva6-3O6LhDpsmUMDOMddSnWerTrUXUZRguU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMivb1UVZeeAuIF8Bb3NsWpnDABqkfm4K0ca2s6jtQ3qw&oe=6AD24B66"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
vatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
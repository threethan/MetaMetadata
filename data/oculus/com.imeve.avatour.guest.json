fIqBTWeW1GJ8WmXOtWiG4PvAeXNpNIKaUw9Dp8ZpJxTGw3dVKoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfEss60V8gfP9TN5h8sKhth0otEEuC-T9Vop8fG2vGTw&oe=6AF1DC0C"}, {"file_name": "Screenshot2.png", "id": "253691356159375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974450_253691359492708_4776878758096807810_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcTIRlWw9V4Q7kNvwHnZVsZ&_nc_oc=AdoMT6NnJzz4jsuqWQ-MODbR9_-RAm6jMcPisteQB6_JfAPafKsjGTBkEa40fhoDHo0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3BIcZsm4DSRZ2DwJC_9u9X2PCA-8d19UkSRQSSdiHPQ&oe=6AF1D466"}, {"file_name": "Screenshot5.png", "id": "240804537710081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_240804541043414_7298889680304212542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IMsKJiev7UQ7kNvwF0R7Nk&_nc_oc=AdqgPcmXj4WR40CWAKXoKYjMKvPalo9OLX7wYoxGWsNzJ5_knpMEiwkrS_Z389tAuRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnK_eJlwGA84ppSsQtNem4LbiYx8BhX1jMlmbQRlVsPg&oe=6AF1E490"}, {"file_name": "screenshot 4.png", "id": "120325976640476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003269_120325979973809_5828314934285205887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8E6OFyJUZ0Q7kNvwHRjyqw&_nc_oc=AdrpCdGTNHcIxZyXxVp8j_BO49NqX4Ocbbi1WVi6d7E6F501_Jl65HZ8PpqBYLuT178&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh1mwZV2Nr_slx5P79xpvf5FvlY4QrKmC8yIa4kVswJg&oe=6AF1FC62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video grab.png", "id": "269496784567893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031446_269496787901226_7817961671481992721_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2UNJUgyf5gQ7kNvwHVDDHq&_nc_oc=Adq2u0TXW1Rcwve7usXLcAbo42_6yuusX0KOR4rsT5eXBz8ckS0ff9AK8udYnGqsqJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToR-niiNyM5eKbdPAMKJ1sEPnopsEdessaqmq-vdj7_g&oe=6AF1EF66"}, "display_name": "Avatour", "keywords": [], "long_description": "Avatour makes real-time remote presence possible for the first time. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser. Unlike a standard live stream, an Avatour is real time, like a videoconference, allowing guests to communicate with each other and with the host user in the real world.\n\nAvatour is an innovative new way to talk with people about a space - without having to bring them there in person. It has applications for architecture, retail, property management, real estate, construction, tourism, and much more.\n\nVisit avatour.com for more information, or to learn how you can get started as an Avatour host.", "short_description": "Avatour makes real-time remote presence possible. Using an inexpensive 360\u00b0 camera and a standard mobile device, an Avatour host can invite up to 20 remote guests to a live experience of a real place. Guests may join using this Quest app, or on desktop or mobile using any web browser.\n"}]}, "developer_name": "Avatour Technologies", "developer_privacy_policy_url": "https://avatour.com/privacy-policy/", "developer_terms_of_service_url": "https://avatour.com/tos", "publisher_name": "Avatour Technologies", "support_website_url": "https://support.avatour.com/", "website_url": "https://avatour.com/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "PRODUCTIVITY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
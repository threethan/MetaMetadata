BmtiZG8MmnR40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlSzcGn5eBfrbhnoBQYISD0K_1--aWC3DsdMKvCsVbEg&oe=6B0DB58C"}, {"file_name": "migrated_image.png", "id": "237198264103499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533901_425474347785621_9039821537103839232_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCwpB8kPT6AQ7kNvwEPiWAx&_nc_oc=AdqEvyPzFv7cu3s-V3-GAe-aL-Pl9t1YsxcDFdIY_ry00VDUKGA763M7TQlx3ID7dHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxx15GdBH4pqC8mwF5xNbz40auoEQckF97xftnTGUiew&oe=6B0DA807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots 3.png", "id": "126709887840660", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533901_126709891173993_4204062144221675520_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTSOCPTWvzEQ7kNvwEblLch&_nc_oc=AdqoJQQho9M8c1o5TCB7r3EaWEF41kQ18AuK9kIWlOLY-yH4Vz9584_sgaXCgp6EGCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQc7uF_3Gzfa_ab4OyW_GkSlV2BuQuzeM0a_Eq8D_PvtQ&oe=6B0DC580"}, "display_name": "mindZense De-stress", "keywords": ["meditation", "relax", "destress", "tranquility", "peace"], "long_description": "Are you stressed out? Then take a break with one of the best apps for calming down the mind and body! Being stressed usually means it can be hard to find peaceful moments and it can be almost impossible to be still and meditative. mindZense De-stress is a great tool for stress relief using VR as a distraction for a razing mind. You will find yourself teleported to a wonderful universe where a gentle narrative and relaxing music is designed to calm your busy mind. \nKick back for 20 minutes and reload your energy.\nMINDZENSE DE-STRESS FEATURES: - unique virtual reality environment with unique meditation techniques - captivating and relaxing meditation music - adjustable music and speak track - gaze based and intuitive UI - easy to setup and use - highly effective against stress - relaxes the mind and soul \u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026 One of the best guided meditation apps. Vastly improve your life. Forget about stress and everyday problems. \nHave a wonderful day!", "short_description": "Take a break and reload your energy"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindzense.com/wp-content/uploads/2016/03/Privacy-Policy.pdf", "developer_terms_of_service_url": "http://www.mindzense.com/wp-content/uploads/2016/03/End-user-licence-agreement.pdf", "publisher_name": "Minditorium IVS", "support_website_url": null, "website_url": "http://www.mindzense.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "521014675876243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727868_1093303744131311_6556054753124548608_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L3nMZfFqOAQ7kNvwE2cZIB&_nc_oc=AdrR9npIqKY1G3Hb2tLAV-xy535MhdNOs4zEWz80K0ziK4_csEHSTBeQtaRg-lvRUNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRmOvqUkP_LPeJ5E-faqroM_-QlCy6IhUbPehkcHH7TKQ&oe=6B0DA7CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "mi
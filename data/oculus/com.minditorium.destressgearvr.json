_9039821537103839232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv0CajlK3sQQ7kNvwFyxoXP&_nc_oc=Adqp1Ej_0uGsJ0HHgMTgIkdzE9ra5icUBx05wLVkgQQa6zusR9GAtUufpB_WLICpOR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B-z837-AgEBP1bYWKpQvgpYEYfTYDqIMoshSJnywofg&oe=69DB93C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots 3.png", "id": "126709887840660", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533901_126709891173993_4204062144221675520_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWblhz8SIqgQ7kNvwEMygNw&_nc_oc=Adru_nygrsTeAD3qCaBs09eAYEIO5IMwDyKhH7uubwlxgzcNl72XO2x3bH41XvLP_1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M-jZwKYEGAFZ3eH5xm8vyB61CafNvIiibowyvzebF2Q&oe=69DBB140"}, "display_name": "mindZense De-stress", "keywords": ["meditation", "relax", "destress", "tranquility", "peace"], "long_description": "Are you stressed out? Then take a break with one of the best apps for calming down the mind and body! Being stressed usually means it can be hard to find peaceful moments and it can be almost impossible to be still and meditative. mindZense De-stress is a great tool for stress relief using VR as a distraction for a razing mind. You will find yourself teleported to a wonderful universe where a gentle narrative and relaxing music is designed to calm your busy mind. \nKick back for 20 minutes and reload your energy.\nMINDZENSE DE-STRESS FEATURES: - unique virtual reality environment with unique meditation techniques - captivating and relaxing meditation music - adjustable music and speak track - gaze based and intuitive UI - easy to setup and use - highly effective against stress - relaxes the mind and soul \u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026 One of the best guided meditation apps. Vastly improve your life. Forget about stress and everyday problems. \nHave a wonderful day!", "short_description": "Take a break and reload your energy"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mindzense.com/wp-content/uploads/2016/03/Privacy-Policy.pdf", "developer_terms_of_service_url": "http://www.mindzense.com/wp-content/uploads/2016/03/End-user-licence-agreement.pdf", "publisher_name": "Minditorium IVS", "support_website_url": null, "website_url": "http://www.mindzense.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "521014675876243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727868_1093303744131311_6556054753124548608_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-ecoT47DXkQ7kNvwG_Yn-7&_nc_oc=AdqosXwx7y4jNy2MG0JdVAuyF05Nc0J3rloplAYmXizBaNItNB2eLgSLOAu6t8ENfZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00VNlFjsk3wudou8RNSFzpmcSGC3d8agGeTP1qMuvLWA&oe=69DB938F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "mindZense De-stress", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1488355200, "lastRevision": {"nodes": [{"id": "1362837260427791", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1452559921492021", "is_first_party": false, "enables_in_ap
f agility and quick thinking.", "short_description": "In Gorilla, movement is a key feature: players use their hands to push off surfaces and climb, simulating natural gorilla locomotion. The game's emphasis on physical activity and dexterity creates a highly engaging experience, combining strategy, speed, and social interaction. With its playful aesthetic and fun, competitive gameplay, Gorilla offers an unforgettable VR adventure where every match is a test of agility and quick thinking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1U2vZHM6PMEV2ryFg5vbGY_IBNFU239EE8rj2WpkWNug/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Rezy", "support_website_url": null, "website_url": "https://html.cafe/xe0c2428a", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25579025861701209"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_2088433911963684_2101326962722558952_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae4fGUpHeJwQ7kNvwF2V5Ol&_nc_oc=Adra7YDHVB8wZPfzpYD_UP--J6vYdOIlRpqA2ZaKjSK7Qpu7m5m-Yfct-x_8QTFIMSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIkzh2laQ5NCZgBxwhjAqiiXNrxGiXffQc1YldJEO1TA&oe=6A787F0C"}, "is_concept": fals
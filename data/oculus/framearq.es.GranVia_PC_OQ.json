4.5771-25/38982535_320248426521744_5420097289928342818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLkxdZORSKoQ7kNvwHMDO-x&_nc_oc=AdrQl0Tg3EvETO4xHqGDmtpMwg2GSngI6XAENRMfYlwkwKjuBKa8eZ9Kb9jGK4EIgQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K0FjnKxO2I-keWku6CKo9p24VPTkbflfsn9uBhIk-lQ&oe=6A43E168"}, {"file_name": "framearq.es.GranVia_PC_OQ-20210915-151855_01782.png", "id": "262380659071680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_262380662405013_1837969736866656824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtJFaDfS-r8Q7kNvwEPEf2q&_nc_oc=AdqW6dtKOO4J5uzU4E5Y349GjVwoCnEKR_g67W7weFWSLFtvv5WaSgMDFiKf5W69H6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--y4iSLn-CsaGrlgBBtjp7TrnxRDaacm3mz-n8-jK-_Q&oe=6A43D5A8"}, {"file_name": "framearq.es.GranVia_PC_OQ-20210915-151855_02886.png", "id": "830477104310215", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_830477107643548_3235432984191117326_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kD0qtjFBNAQ7kNvwHiSMHX&_nc_oc=Ado72Z977320tHwq-XdWzWYMNEXwBBEnsUFlMo5D00CqlZpW4XwHL8jdJmFKmsr8NkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fpe6Fs-hIliXWmOHL_dx99202SXaDuhFQaitbPMgyCg&oe=6A43CFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "framearq.es.GranVia_PC_OQ-20210915-151855_03231.png", "id": "573899373783008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001723_573899377116341_7543787012198902017_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTpS8P5-oMEQ7kNvwGPQIT9&_nc_oc=AdqYaGGbMdnALR2Pre1sGlKGVbzpTttBxTYrL8kELy2tOPero0zzxOvjusB_H6Ts9EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82iXJPFCvvcCGjvIgsBcmS1GtvvZEBjxKPrcNaliGrNg&oe=6A43C0A0"}, "display_name": "Gran V\u00eda VR - Framearq", "keywords": [], "long_description": "\"Gran V\u00eda\" offers a 3d recreation of the architectural proposal for the restoration of a house designed by the Metamorphism Architecture studio. Through the application you can explore the interior of the house interacting with its elements. There is also the possibility of using the different tools offered, we highlight the dimensioning of elements, making annotations, saving proposals for materials and colors, or viewing project plans.\nThe application is totally Cross-Play, allowing users of different platforms such as Oculus Quest, Oculus Quest 2 and Windows to interact in the same environment.", "short_description": "Application for 3D architectural visualization of the reform proposal of a house located in\n \"Gran V\u00eda\" made by the architecture studio Metamorfismo."}, {"images": {"nodes": []}, "id": "564361818046264", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gran V\u00eda VR - Framearq", "keywords": [], "long_description": "\"Gran V\u00eda\" ofrece la recreaci\u00f3n 3d de la propuesta arquitect\u00f3nica de restauraci\u00f3n de una vivienda proyectada por el estudio de Arquitectura Metamorfismo. A trav\u00e9s de la aplicaci\u00f3n podr\u00e1s recorrer el interior de la vivienda interactuando con sus elementos. Tambi\u00e9n existe la posibilidad de utilizar las diferentes herramientas ofrecidas, destacamos el acotar elementos, realizar anotaciones, guardar propuestas de materiales y colores, o visualizar los planos de proyectos.\nLa aplicaci\u00f3n es totalmente Cross-Play, pudiendo interactuar en un mismo entorno usuarios de diferentes plataformas como Oculus Quest, Oculus Quest 2 y Windows.", "short_description": "Aplicaci\u00f3n para la visualizaci\u00f3n arquitect\u00f3nica 3D de la propuesta de reforma de una vivienda situada en \n \"Gran V\u00eda\" realizada por el estudio de arquitectura Metamorfismo. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framearq.es/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "Framearq", "support_website_url": "https://framearq.es/contacto/", "website_url": "https://framearq.es/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "651778612754684"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "592652035258223"}]}, "baseline_offer": {"id": "592652035258223"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633635660, "status": "PUBLISHED", "id": "592652035258223"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4987289321334933", "version": "1.0.7"}, "id": "541675813779638", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4643198232410712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4987289321334933"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "541675813779638"}]}, "change_log": "Versi\u00f3n 1.0.7\n-A\u00f1adida la funcionalidad de ver streaming en el televisor del sal\u00f3n. (Para que funcione hay que estar en una sesi\u00f3n con un jugador de pc y que este ponga la url del streaming)\n-Ahora es posible conectarse a un servidor remoto a trav\u00e9s de la IP del servidor.\n-Solucionado el problema que imped\u00eda a los jugadores cliente usar los marcadores.\n\nVersi\u00f3n 1.0.6\n-A\u00f1adida la funcionalidad de alternar entre el d\u00eda y la noche.\n-Aparece la opci\u00f3n de borrar todas las cotas a la vez.\n-Aparece la opci\u00f3n de borrar todas las anotaciones a la vez.\n\nVersi\u00f3n 1.0.5 \n-Ahora la aplicaci\u00f3n pide de forma autom\u00e1tica los permisos para grabar el audio y guardar datos en la memoria interna al iniciarse por primera vez. Anteriormente hab\u00eda que otorgar estos permisos de forma manual.\n\nVersi\u00f3n 1.0.4 \n-Solucionado el problema que imped\u00eda conectarse a un usuario de una red distinta usando la opci\u00f3n de conectar a IP. \n-A\u00f1adida la opci\u00f3n del volver al men\u00fa principal en el widget de funcionalidades. \n-Aparece en el widget de funcionalidades la opci\u00f3n de silenciar o activar el micr\u00f3fono. \n-Se ha solucionado que cuando un usuario abandonaba la sesi\u00f3n no se eliminaban sus lasers y el tutorial de los controles en el caso de estar activos.\n\nVersi\u00f3n 1.0.3 \n-Se ha solucionado el problema que no permit\u00eda guardar los cambios en las modificaciones del mobiliario. \n-Eliminaci\u00f3n del teclado Vr de Oculus que se mostraba por defecto, se ha a\u00f1adido un teclado propio solucionando de esta forma el problema de ver ambas manos dos veces. \n-Optimizaci\u00f3n de materiales y geometr\u00eda, lo que permite un incremento de la resoluci\u00f3n consiguiendo mayor definici\u00f3n. El men\u00fa inicial pasa a tener una resoluci\u00f3n de x1.5 y el resto de la aplicaci\u00f3n x1.25. \n-El efecto fade-out/fade-in al teletransportarse se ha suavizado y ahora se muestra de forma correcta. \n-Se ha a\u00f1adido el efecto fade-out/fade-in al teletransportarse usando la herramienta de marcadores. \n-72 FPS estables en todo momento.", "created_date": 1639783422, "id": "4987289321334933", "version": "1.0.7", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4643198232410712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4987289321334933"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "541675813779638"}]}, "change_log": "Versi\u00f3n 1.0.6\n-A\u00f1adida la funcionalidad de alternar entre el d\u00eda y la noche.\n-Aparece la opci\u00f3n de borrar todas las cotas a la vez.\n-Aparece la opci\u00f3n de borrar todas las anotaciones a la vez.\n\nVersi\u00f3n 1.0.5 \n-Ahora la aplicaci\u00f3n pide de forma autom\u00e1tica los permisos para grabar el audio y guardar datos en la memoria interna al iniciarse por primera vez. Anteriormente hab\u00eda que otorgar estos permisos de forma manual.\n\nVersi\u00f3n 1.0.4 \n-Solucionado el problema que imped\u00eda conectarse a un usuario de una red distinta usando la opci\u00f3n de conectar a IP. \n-A\u00f1adida la opci\u00f3n del volver al men\u00fa principal en el widget de funcionalidades. \n-Aparece en el widget de funcionalidades la opci\u00f3n de silenciar o activar el micr\u00f3fono. \n-Se ha solucionado que cuando un usuario abandonaba la sesi\u00f3n no se eliminaban sus lasers y el tutorial de los controles en el caso de estar activos.\n\nVersi\u00f3n 1.0.3 \n-Se ha solucionado el problema que no permit\u00eda guardar los cambios en las modificaciones del mobiliario. \n-Eliminaci\u00f3n del teclado Vr de Oculus que se mostraba por defecto, se ha a\u00f1adido un teclado propio solucionando de esta forma el problema de ver ambas manos dos veces. \n-Optimizaci\u00f3n de materiales y geometr\u00eda, lo que permite un incremento de la resoluci\u00f3n consiguiendo mayor definici\u00f3n. El men\u00fa inicial pasa a tener una resoluci\u00f3n de x1.5 y el resto de la aplicaci\u00f3n x1.25. \n-El efecto fade-out/fade-in al teletransportarse se ha suavizado y ahora se muestra de forma correcta. \n-Se ha a\u00f1adido el efecto fade-out/fade-in al teletransportarse usando la herramienta de marcadores. \n-72 FPS estables en todo momento.\n", "created_date": 1636314095, "id": "4850347788362421", "version": "1.0.6", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4643198232410712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4987289321334933"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1636313526, "id": "4850327158364484", "version": "1.0.6", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4643198232410712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4987289321334933"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "541675813779638"}]}, "change_log": "Versi\u00f3n 1.0.5\n\n-Ahora la aplicaci\u00f3n pide de forma autom\u00e1tica los permisos para grabar el audio y guardar datos en la memoria interna al iniciarse por primera vez. Anteriormente hab\u00eda que otorgar estos permisos de forma manual.", "c
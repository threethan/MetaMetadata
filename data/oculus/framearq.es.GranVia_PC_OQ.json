99377116341_7543787012198902017_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTpS8P5-oMEQ7kNvwGPQIT9&_nc_oc=AdqYaGGbMdnALR2Pre1sGlKGVbzpTttBxTYrL8kELy2tOPero0zzxOvjusB_H6Ts9EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82iXJPFCvvcCGjvIgsBcmS1GtvvZEBjxKPrcNaliGrNg&oe=6A43C0A0"}, "display_name": "Gran V\u00eda VR - Framearq", "keywords": [], "long_description": "\"Gran V\u00eda\" offers a 3d recreation of the architectural proposal for the restoration of a house designed by the Metamorphism Architecture studio. Through the application you can explore the interior of the house interacting with its elements. There is also the possibility of using the different tools offered, we highlight the dimensioning of elements, making annotations, saving proposals for materials and colors, or viewing project plans.\nThe application is totally Cross-Play, allowing users of different platforms such as Oculus Quest, Oculus Quest 2 and Windows to interact in the same environment.", "short_description": "Application for 3D architectural visualization of the reform proposal of a house located in\n \"Gran V\u00eda\" made by the architecture studio Metamorfismo."}]}, "developer_name": null, "developer_privacy_policy_url": "https://framearq.es/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "Framearq", "support_website_url": "https://framearq.es/contacto/", "website_url": "https://framearq.es/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": [
ZuHhmKwQ7kNvwG4g5bn&_nc_oc=AdoWabRUAYf54wjoGcZiENGoMI74bmN9AbLuFTziWUTDOd974SbqyPAepYM0lQbPC28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXUNiEb8f46MPjEYJiJJoB1ee92AN2DeRvlzrkmQkakQ&oe=69C1512F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Monks", "keywords": ["monkey", "fangame", "tag", "shop"], "long_description": "Welcome to Space Monks! \nStep into one of the best Gorilla Tag fan games of all time. Explore vast cosmic maps, swing through zero-gravity zones, and put your parkour skills to the test as you tag friends and foes in exciting intergalactic arenas.\n\nCustomize your look with tons of fun cosmetics available in the shop\u2014crowns, space helmets, goofy outfits, and more! Whether you\u2019re hanging out with friends, chasing down rivals, or just exploring the galaxy, there\u2019s always something new to discover.\n\nWith regular updates, a growing community, and thrilling game modes, Space Monks is more than just a tag game\u2014it\u2019s a whole universe of fun waiting for you.", "short_description": "Welcome to Space Monks, this is one the the best gtag fan games of all time. Explore, tag, and shop for cosmetics!!!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/midnightrunnersvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Toaster", "support_website_url": null, "website_url": "https://sites.google.com/view/midnightrunnersvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
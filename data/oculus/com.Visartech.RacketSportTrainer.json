5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS7bo70n4GkQ7kNvwFZJ0wa&_nc_oc=Adpv3FU0ZQCh2B_Hynm1Y-Wy8lNRO4MvmRDzcRxMQ7DkAsFkNEcB2CsSLU4TVI55_hw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uvDJV2MMQ4QGLs9T6n17wofzEytZNSo_Jt5aFuukjAg&oe=6A1C2B33"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGLrYeLHJ0YQ7kNvwFh0CzU&_nc_oc=Adp49AJcVQwhudu83TW2XyqT3yhoZG1NzD5hVOPTIWnVm2Rno4cr3bRGTSzvaD8Iihw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gz94vXo_nVnlw7Cjx1T1__7UiyIWdCubGyEx8o3nuKA&oe=6A1C3284"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMI3Q-Wv4YUQ7kNvwEyTE-S&_nc_oc=AdretseAkAwKgO7uFWVW_YFynN83dlZ0FsSqTd-f2Eg2W0OhtGM54fvHcUWVqiHRin4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y0paGpuOJ4KCnj89Euh3QQRaAHSiUSRGmuoYaJ3qylw&oe=6A1C3760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_OYE7WYzP0Q7kNvwHP2Xiu&_nc_oc=AdrS2xhXXD9DKzI_e13ieaaAbF-UO8weQPtY-qTTuBKoPZ9Q3ujiy6wCQA3HbylnZwI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jpTJxfDpwiixQBD5Z9vRFJsy55Aeq4v_MES7u45qWFg&oe=6A1C52D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
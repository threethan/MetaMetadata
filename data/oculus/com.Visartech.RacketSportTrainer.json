5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk04rZ2j0CgQ7kNvwGGH8NK&_nc_oc=AdqziAjMFbeuUABCWfQx4nHgfjlJUPlgs03FCmVX8RBZ4BdSN52DU8cqk4n4fuG25TE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cpitajj82xLqealpLPOG8aJ_Gy1EIAwppfiEt3T3A8Q&oe=6A3FC3B3"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3RBYkojMOgQ7kNvwHbPLCA&_nc_oc=AdrEVwAWI5RmdpWA_3mZm7rhP8_mnxDvlIcjiKCXkPz1elVd2OlzmLxfSsBG9Yw38KI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HknMvDjUj-e79dZJMRS-VRuJxYiLkL7ui2Ap0y_kGzQ&oe=6A3FCB04"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DM7ezEgtycQ7kNvwFxmAyq&_nc_oc=AdoR2eIKty4afkaSe-TdLYXt0GXQqfLAhvgbw6zfLmpJvfypelsUdOOuxllvMsilvvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HG11WM3JFGkKpAuU3IbWK4vkUUOyq1AUVksl5Mah3nQ&oe=6A3FCFE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDfozUre8GgQ7kNvwGT-kMg&_nc_oc=AdrgwzsZxturfwRjm5KpcTRzO03UeDjKy8U4cv8f-e9K2nu9LJg_ByQI3SbtYDABhLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A0S8JHqvjSthRji3YhA0VoUuLQT_u3cU52QRRM0esQA&oe=6A3FEB52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
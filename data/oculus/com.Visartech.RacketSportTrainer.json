5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9xp28GRv54Q7kNvwFVuFY6&_nc_oc=AdoeyAhsSYlY1c1qEEQn1TngpkuqPDJulAWRHT0jNoPGSm4FU6ukryprEfuBW4H6nAE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWtV5wQNmI8SvNxQ1eUKExH0kKjdyLp8pH5CeCxOyVow&oe=6A973733"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaE_oM42fcoQ7kNvwGguGSs&_nc_oc=AdoRJcXkno7nSsQ1lOLg_zfG5720HM4H8JWY53f5cHEDxD5f4XcyGCYa7VETMayrY08&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRgDG0q0gfLD7InhaR-njcwAlsedP3j-_DDKIo9i1wpg&oe=6A973E84"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHM740f56sQQ7kNvwHL8F3P&_nc_oc=AdpcXzcj86-rifA7pR2D0Mr2FtYQ__qmBNyS51TEzjekoia2pGKzZLR9GMA6PxZWk9c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcL14B_p8RHlxWS0Y44JDY2_k1RQY8JdQ0auj3q2rMxA&oe=6A974360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iYIquQKyT0Q7kNvwHrCTC3&_nc_oc=Ado7vT9PH1xSK7fRXGT2bo9nxBk4vE4Iwx7p5CXT9nJrcL1_NS3Ef7bdoEZSP62KdYU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF06tChIMIULry2S-nb8IKFKE_61nQL76cQ-xcriDl5VQ&oe=6A972692"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDd6C8A2wj4Q7kNvwEKjkPK&_nc_oc=AdrtY4zeLDDgM4CQTeHxXAPyGGEdkn30s5576LMrNoGUh3FGC0177tG6xm_T0kIv61c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpew0XOuouJLbgj8DEbvNvYrAb9oPu_3TXGRLa8l59wg&oe=6AF9DF73"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vzt-izXKDEQ7kNvwFLVYwL&_nc_oc=AdpHcqpB-pRamOtahnknDLBFlkpbtJM9fe8q0vCN_-_LxX0mO8ORwtbvj6Elft_gY48&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5_Pfc3Hr9LO2L8L44CyvZpBL-SpdOquBhTBTI_IE6yQ&oe=6AF9E6C4"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hw24D67z14Q7kNvwGl1u56&_nc_oc=Adp0_DlISQE4ELY8p1pdQB8nYXCSob7IbES1eGFoYG3fFRIrd_o7BpHK7Z25gbXB_FU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_VJTS2V0m39zEHGfDpSgSd7SG4xbe2pfHc90sMW0yXw&oe=6AF9EBA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUVQL-DN3CgQ7kNvwG8sJXs&_nc_oc=AdqGknijQbiiG1WUIIVg-XSXvWcGO2gP-pk4fkh4YEg0Yylt9x0QdalfpeVUKhMB1YI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS37W8vTf0A8lDNhwlVqT6rGHVjh2mBH6fqmywwVRagHg&oe=6AF9CED2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVoOylpbMEsQ7kNvwF5SgAN&_nc_oc=Ado7Tftx8WEWXZ9K_Ia7y9DhGrOKuZ1tGFRTbJtyjXZe-2vtOmh8e4hk8lDgKp-8uC0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJELkDOmMcS69x7ammnpTz0EOrOJ4SNVLtDnBCC1p6SGQ&oe=6A9AF373"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8V4u9Qnzg4Q7kNvwGZl8Tu&_nc_oc=AdpHesjv9hz0rU5XYpp9_LuWDEoBE4yVwBwEEKqZRWIy6c8to6bwPzmOvrYvlRBmCDE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOElWmH2TPrCh-VR0aLjeLyKnMmpTsunXhocWiKlFQRQ&oe=6A9AC284"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tZiLG_2DZsQ7kNvwEmyWZj&_nc_oc=Adrqf_KB_H0oWcoN6z5cOOO5NE5S6FGb51XUHxWiPrFXdWc_TWBz1_WzaC7izMhkJbg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJffczO8VGf4KVoRPoMuPmA0kqgn8NgbrK8WDhI7NspLw&oe=6A9AC760"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84XwMKSKjPMQ7kNvwHFgfHH&_nc_oc=Adr4JH2IMyTc0znCaqCVQsulL7JSRV6Z4pla7W5oBWug3SR3Vi6VRTTZBn6EBDNY-_Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq2JDwVMtrVRQVA2saaHSL85n9RSKaexnO7tfUoKjSLw&oe=6A9AE2D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
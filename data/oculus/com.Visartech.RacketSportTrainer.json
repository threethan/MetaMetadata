5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQDjDChif5kQ7kNvwEUTBov&_nc_oc=AdoHxLf6VtDXkUeHRP47JVr4x_rNSlyjU0ZgsIkOpr1W1OD1jZWv8eJguCELXF9wcNc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE81pQohn2ndIVUXdL7tH6aLxyDu6XDvc4tfHMnzNvOsw&oe=6A830033"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBjfwVbMnBUQ7kNvwE_aegr&_nc_oc=Adp5kcKHROMKVDQwwRsh88g1xzMBAwPM2j6iA7Edd9x3uHrcTNL46DWxeZW91Boh9D8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk9RUyAsl0nxTE4TYdrNG4K3-Mp-FlQDZeFkL_o9qKqQ&oe=6A830784"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVy7DJo4AXUQ7kNvwGE9Kaf&_nc_oc=AdrpeY4OXqD-B5GuF0Me673p9VJ7gn9d3jkSvOMku6eiJMQiuRFRIWactD0w6ujRriE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvTtNRPVsy-ZBTvLPNbY637z-td2AjM15pYVEztJMghw&oe=6A830C60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ssaJolpjBAQ7kNvwGXpqb3&_nc_oc=Adpk1fRp8EzdsNEZICFH_pu9ltt4eejfJ-ZZCL63UVfCP075lMFnkwTK1femHKM7MD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIrrIu8-7nFy2Udowqwgjgn-O4Tn0J9zvgLmXCPQBoYA&oe=6A82EF92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
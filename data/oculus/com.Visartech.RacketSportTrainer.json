5/38974871_937587360127009_7764466315753064776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRuX-mimSb0Q7kNvwFKasw4&_nc_oc=AdpI3zXPPtowLoWlOwbe7aNCp53gCCJ_bFuBub5FLcEWW_6tLoMjKVq9nPpOlYhM8DU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vId8iGOVGAHE-q9V7H9Ui2Vb2zadAp2JtnT7kiR0Low&oe=69EB63B3"}, {"file_name": "View of Hub.png", "id": "4690571401070027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_4690571404403360_7441034460172253668_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dTPOvpDOJAQ7kNvwE-Hrs2&_nc_oc=Ado_iPS8x7jMb21kSijxKjBVNDJcEJ93_4qjN4gkea5Ek8Pw2dSqYCVrQREkJBqxSc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33yPqa7o8jwa5xFiIkVwT5p_XJWVAZPi-ieVbnFQ6ZBw&oe=69EB6B04"}, {"file_name": "Trackable Stats.png", "id": "672531493983764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_672531497317097_2963365780966734699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOVO70am7Q0Q7kNvwF7HonL&_nc_oc=Adq8osmmy5O4U2IWE6TdqXvjDgE2_byRNF_IZSMufvaGy94UYIxjwO7vhcOTC6Ni_t0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XKCi4JYoxlmtSJjrYerfaSR0uQbdi-D0_UHllVpxR2g&oe=69EB6FE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickleball Vision Training", "keywords": [], "long_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels.\n\nThis was the first VR app delivered to the pickleball community. ", "short_description": "Enter a pickleball vision training app! Developed by a group of vision experts to train eye-hand coordination, reaction time, and improve on-court decision making. \n\nThis is not a pickleball match simulation.  It houses strategic drills to support your progression in the sport.\n\nThe app contains 6 keys drills that prove to be powerful for training and engaging. This app has something for all skill levels."}]}, "developer_name": "Pickle Docs", "developer_privacy_policy_url": "https://vrpickle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CVC Game Dev", "support_website_url": null, "website_url": "http://VRPickle.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6899427870110070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_1306608436485171_8926125106184030615_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fP8QwYGZ4QQ7kNvwEAl6Hl&_nc_oc=AdrYPwmYH0fTQPIMdYJPbMyhaC_nw2u9lnVav63Gm2zfFexeKLlntPQC-Yfqp2gryAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h6o8d2QDW01sdk8mRdRj99RXmFfVGIxcdNceXs2A7wg&oe=69EB8B52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickleball Vision Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"
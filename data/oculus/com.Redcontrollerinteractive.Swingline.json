2Rli-8-o5_XpgNm3wdvGYojChD_0poXnccCTA&oe=6AF9CF02"}, {"file_name": "New Project (22).png", "id": "1003142159164130", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624395_1003142162497463_3272781613414032794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLMGG-s53bkQ7kNvwGsyjSP&_nc_oc=AdobkJa2KAIpi7uOZJvHMPaY8f5Z04E3dqGPwIF4LweE0eDSL0gH7-Q4XFexb_NvWP8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvI0iKiLm7noPxZeLPeaf1XdMfkkoexKefzqkPJrbFIA&oe=6AF9B742"}, {"file_name": "New Project (19).png", "id": "1367046208658574", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593902063_1367046211991907_8162801866889663572_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26cFaQp9g1AQ7kNvwHrlcwS&_nc_oc=Adrpxhj1XwqeiiW6cUoHl2zMfkIAQowjgcMnOALf5_YIEwIBAKotkaoaXIYjZewtEWM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiFFn1kG3DEOm21wyhWf_-CNnXNCeSG5FD_uLdRsgQhg&oe=6AF9CD98"}, {"file_name": "New Project (24).png", "id": "1522908379871989", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310734_1522908383205322_2794070546688425127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTjMJwjoRQ0Q7kNvwFZy9bE&_nc_oc=AdoQLDDF-s9hryBea3YI9YtCdVgbYUHBTXB_JkmMTN50XTA8rr8P-rhnGepzXoSDXTk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0-nW53KkET1VifMERY94HV2aMTUNhU6anKZ2BnV5HGQ&oe=6AF9EA18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "swcl.png", "id": "2136134683612800", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819775_2136134686946133_2811983521501243797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbCiWv6gY9kQ7kNvwFVF5Dl&_nc_oc=AdqmjJWgHJyOwxQooyig6kuLmGZXPTe-Wp1ASX16r-sg9gnM4myE8Zvarh6ZsXbKwaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbMBiRk2u5lhZ_DuZRt1RczvXKUS2k8YUuTWLiW7W6_Q&oe=6AF9DE6F"}, "display_name": "Swingline Climber", "keywords": ["climber", "Parkour", "climbing", "Adventure", "Grappling"], "long_description": "\n**Swingline Climber** is a colorful VR climbing and swinging adventure where your hands become powerful dual grappling tools. Aim, launch, grab, and pull yourself through floating worlds filled with crystals, towering rocks, dangerous lava, sky-high ruins, and fast aerial routes.\n\nBuilt around satisfying motion and momentum, Swingline Climber lets you move through the world using both hands. Fire your swing lines, catch distant surfaces, build speed, and launch yourself toward the next point. Every jump is about timing, control, and flow.\n\nExplore vibrant low-poly environments, collect crystals, climb massive structures, and test your skill across routes designed for vertical movement. Some paths are calm and scenic. Others demand quick reactions as you swing over lava, dodge obstacles, and keep your momentum alive.\n\n**Features:**\n\n- Dual-hand grappling movement made for VR  \n- Swing, climb, pull, and launch yourself through the air  \n- Colorful low-poly worlds with crystals, lava, cliffs, and floating structures  \n- Momentum-based movement that is easy to understand and rewarding to master  \n- Collect crystals and push further through each route  \n- First-person VR controls that make every swing feel physical  \n- A fast, energetic experience for players who love movement, height, and challenge  \n\nWhether you are carefully climbing toward the next platform or flying through the sky at full speed, **Swingline Climber** is about the thrill o", "short_description": "Swingline is a fast VR grappling adventure where you launch, swing, and soar through colorful floating worlds filled with crystals, hazards, and sky-high challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1CzYUcZRsVD1TxozHOfv_EuMtj0GHmZaPQUgY2ZmmUSo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1560540275856476"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1018098337703415"}, {"status": "PUBLISHED", "id": "1355158646576739"}]}, "baseline_offer": {"id": "1018098337703415"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786797300, "status": "PUBLISHED", "id": "1018098337703415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1593798579197312", "version": "0.1.0"}, "id": "1028353889664437", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1560540272523143", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1593798579197312"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1028353889664437"}]}, "change_log": null, "created_date": 1786791043, "id": "1593798579197312", "version": "0.1.0", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1593798265864010"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryW
l": {"file_name": "swcl.png", "id": "2136134683612800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819775_2136134686946133_2811983521501243797_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8hjrWdUGFYQ7kNvwFu1BTA&_nc_oc=Adoq7GSuhwNihJukhjtwaUsL9lIrLc-a1Vwte5d3mm6_46lvXrjXg17Td76mpvqceCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYg5EL2AJwcYtqynSY_p7fKLqZrrOvY-2PJzBne3uChg&oe=6B0EF66F"}, "display_name": "Swingline Climber", "keywords": ["climber", "Parkour", "climbing", "Adventure", "Grappling"], "long_description": "\n**Swingline Climber** is a colorful VR climbing and swinging adventure where your hands become powerful dual grappling tools. Aim, launch, grab, and pull yourself through floating worlds filled with crystals, towering rocks, dangerous lava, sky-high ruins, and fast aerial routes.\n\nBuilt around satisfying motion and momentum, Swingline Climber lets you move through the world using both hands. Fire your swing lines, catch distant surfaces, build speed, and launch yourself toward the next point. Every jump is about timing, control, and flow.\n\nExplore vibrant low-poly environments, collect crystals, climb massive structures, and test your skill across routes designed for vertical movement. Some paths are calm and scenic. Others demand quick reactions as you swing over lava, dodge obstacles, and keep your momentum alive.\n\n**Features:**\n\n- Dual-hand grappling movement made for VR  \n- Swing, climb, pull, and launch yourself through the air  \n- Colorful low-poly worlds with crystals, lava, cliffs, and floating structures  \n- Momentum-based movement that is easy to understand and rewarding to master  \n- Collect crystals and push further through each route  \n- First-person VR controls that make every swing feel physical  \n- A fast, energetic experience for players who love movement, height, and challenge  \n\nWhether you are carefully climbing toward the next platform or flying through the sky at full speed, **Swingline Climber** is about the thrill o", "short_description": "Swingline is a fast VR grappling adventure where you launch, swing, and soar through colorful floating worlds filled with crystals, hazards, and sky-high challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1CzYUcZRsVD1TxozHOfv_EuMtj0GHmZaPQUgY2ZmmUSo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1560540275856476"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1018098337703415"}, {"status": "PUBLISHED", "id": "1355158646576739"}]}, "baseline_offer": {"id": "1018098337703415"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786797300, "status": "PUBLISHED", "id": "1018098337703415"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1593798579197312", "version": "0.1.0"}, "id": "1028353889664437", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624395_1003142162497463_3272781613414032794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLZkKRgzUcUQ7kNvwFvf6rA&_nc_oc=AdqxKbMPBufAuW_f5Tby3zv2kgRD9Gti0T3EANV5wo3aCD9jnVuir3rtu1c_HviPITQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFCBLHAmTlSNtmllULMgKYKuFzrcG-VcsUW33ob-E6mw&oe=6AEF6382"}, {"file_name": "New Project (19).png", "id": "1367046208658574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_1367046211991907_8162801866889663572_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPWh8svd3x0Q7kNvwEfcCdG&_nc_oc=AdqpyS7tewFcUMR5QU122o_7k95ngFKUqIV-XAdmg26aG2XNCSPNQC8cymQJSnhW0hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_E7qrkvVBNDepxX_PQHnNeUrJPP__KUvqk0Ue5i4P3Q&oe=6AEF4198"}, {"file_name": "New Project (24).png", "id": "1522908379871989", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310734_1522908383205322_2794070546688425127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqjSGrTS5zYQ7kNvwGWgVVk&_nc_oc=AdrJnZoQlNr_qG_RKA0XhPGUh-iJ2GBDeCoq9HVcUKf4AnwokdpjL8Bzo83_yo8EJXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi5EUKh94OiFslXkEfxfeCvthDNsvlX2tLHGHm-2DXYw&oe=6AEF5E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "swcl.png", "id": "2136134683612800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819775_2136134686946133_2811983521501243797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24rMBtkaqV8Q7kNvwFVZuun&_nc_oc=Ado3PuE0wQP1onRIoqZL2q16PItA-re3WLQRgFazMbaXKTuSUAdAW-B4FmyeT1cODF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIAlAewqdZdzM_mjxjoyKt-pneOje1SdfO5EynIRSnQg&oe=6AEF526F"}, "display_name": "Swingline Climber", "keywords": ["climber", "Parkour", "climbing", "Adventure", "Grappling"], "long_description": "\n**Swingline Climber** is a colorful VR climbing and swinging adventure where your hands become powerful dual grappling tools. Aim, launch, grab, and pull yourself through floating worlds filled with crystals, towering rocks, dangerous lava, sky-high ruins, and fast aerial routes.\n\nBuilt around satisfying motion and momentum, Swingline Climber lets you move through the world using both hands. Fire your swing lines, catch distant surfaces, build speed, and launch yourself toward the next point. Every jump is about timing, control, and flow.\n\nExplore vibrant low-poly environments, collect crystals, climb massive structures, and test your skill across routes designed for vertical movement. Some paths are calm and scenic. Others demand quick reactions as you swing over lava, dodge obstacles, and keep your momentum alive.\n\n**Features:**\n\n- Dual-hand grappling movement made for VR  \n- Swing, climb, pull, and launch yourself through the air  \n- Colorful low-poly worlds with crystals, lava, cliffs, and floating structures  \n- Momentum-based movement that is easy to understand and rewarding to master  \n- Collect crystals and push further through each route  \n- First-person VR controls that make every swing feel physical  \n- A fast, energetic experience for players who love movement, height, and challenge  \n\nWhether you are carefully climbing toward the next platform or flying through the sky at full speed, **Swingline Climber** is about the thrill o", "short_description": "Swingline is a fast VR grappling adventure where you launch, swing, and soar through colorful floating worlds filled with crystals, hazards, and sky-high challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1CzYUcZRsVD1TxozHOfv_EuMtj0GHmZaPQUgY2ZmmUSo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743
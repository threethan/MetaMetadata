_nc_sid=6e7a0a&_nc_ohc=dSfg2SFq7M0Q7kNvwEPty7n&_nc_oc=AdofTXB56A8ZybldZOoec-2PSBIU7ajsjoX90pnTsyop6j6CC5UrPu6yyKY1Y1FBK7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9xw-tXgn2qbCon_nRzu5vJg2sne8lKwSjY4YwFYimJw&oe=6AE9E542"}, {"file_name": "New Project (19).png", "id": "1367046208658574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_1367046211991907_8162801866889663572_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QNEDz7MQvgQ7kNvwGOXpUh&_nc_oc=AdrmUMbpBxSgHQ1F1RnTGlMVcFq5aDIVy2hj2HIug2Sh5GSBUuHLYE732tla34f-T6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCVED0rnNAqOeuJOg6Xc6v4TDVVszgA1ecTpg9ndfnfg&oe=6AE9FB98"}, {"file_name": "New Project (24).png", "id": "1522908379871989", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310734_1522908383205322_2794070546688425127_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nQhBtp72iYQ7kNvwGtf2CI&_nc_oc=AdpZrRY_1PouEFkUKKajNPv12ym4OcXAO5jbYxd2FmwBTo5NIHra1UIFm7bqCI_xvbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpSVCFp7vZ1vAB7J8IXQJo4g2EdE5UpCdHVyZW_T9-_w&oe=6AE9DFD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "swcl.png", "id": "2136134683612800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819775_2136134686946133_2811983521501243797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YnYuFcrwLkQ7kNvwFllQqx&_nc_oc=AdpVVzJ7ixWIDhGFgsuwhXUhxsRNKgnxlz6zPWCwthTrSFzAY6J3Tap6jo6immfFqRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8C08SaOS5jODpj-sV2My6FsyfIg251MFxAPss40hzzw&oe=6AEA0C6F"}, "display_name": "Swingline Climber", "keywords": ["climber", "Parkour", "climbing", "Adventure", "Grappling"], "long_description": "\n**Swingline Climber** is a colorful VR climbing and swinging adventure where your hands become powerful dual grappling tools. Aim, launch, grab, and pull yourself through floating worlds filled with crystals, towering rocks, dangerous lava, sky-high ruins, and fast aerial routes.\n\nBuilt around satisfying motion and momentum, Swingline Climber lets you move through the world using both hands. Fire your swing lines, catch distant surfaces, build speed, and launch yourself toward the next point. Every jump is about timing, control, and flow.\n\nExplore vibrant low-poly environments, collect crystals, climb massive structures, and test your skill across routes designed for vertical movement. Some paths are calm and scenic. Others demand quick reactions as you swing over lava, dodge obstacles, and keep your momentum alive.\n\n**Features:**\n\n- Dual-hand grappling movement made for VR  \n- Swing, climb, pull, and launch yourself through the air  \n- Colorful low-poly worlds with crystals, lava, cliffs, and floating structures  \n- Momentum-based movement that is easy to understand and rewarding to master  \n- Collect crystals and push further through each route  \n- First-person VR controls that make every swing feel physical  \n- A fast, energetic experience for players who love movement, height, and challenge  \n\nWhether you are carefully climbing toward the next platform or flying through the sky at full speed, **Swingline Climber** is about the thrill o", "short_description": "Swingline is a fast VR grappling adventure where you launch, swing, and soar through colorful floating worlds filled with crystals, hazards, and sky-high challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1CzYUcZRsVD1TxozHOfv_EuMtj0GHmZaPQUgY2ZmmUSo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "N
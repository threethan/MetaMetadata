31430_596566496133577_793757579260021690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrTW7SZFF-QQ7kNvwGLJw6k&_nc_oc=Adlzzd7QBmP_Ax5nmawMzejOA9R07m7AxGU748soEdrV9bMq1F_Dz5DfOKwbz81KusE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxO1x4Pn8lealGFCqKgrWlMCWOq6gtVCKip0rGhPBemRw&oe=69AEC15D"}]}, "id": "1085088483113744", "locale": "en_US", "screenshots": [{"file_name": "TrafficScreenshot.png", "id": "1299228224835758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_1299228228169091_4563789821062843063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiAZranMOqMQ7kNvwE-vy2c&_nc_oc=Adkr-KIZXhTmKIL09WWkK5wpNUGWr7IAO7W0a-NBJLkA2Ztt9phoenYF-YL68wM8Z2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxthW3tSwxx-8XjOU4muUSaFtVbdAQPhE3VRCS0prn6sw&oe=69AED4B9"}, {"file_name": "crashscreenshot.png", "id": "1552702705355332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_1552702708688665_3842435594195653890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTHDFBc_UUcQ7kNvwEGSO3g&_nc_oc=AdnFO-JqZeRcDNL2FmGSQGXiz5XcQvunjWwsLnWvJ20dQSG4COdpWN6SlyPsx1NHKBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDxEb6_-cpQufXNJvejcDah1gYtcBexGbDKtBh7AdDxQ&oe=69AEAA2D"}, {"file_name": "blackholescreenshot.png", "id": "1300718464455973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974876_1300718467789306_2308127272415118220_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzhghEorMT8Q7kNvwGhQlLj&_nc_oc=AdkOcFUoAgotzAeOIL4ChZ_wAtnClv0cT2Gri3GB28a1ELelXkRq2VIOTBzO9XrfsiU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxDNarwg1B1AxhMhW1bcdvZPoWS2_fzyuKeJSesvL9PA&oe=69AEA53D"}, {"file_name": "BonusScreenshot.png", "id": "1106681824791508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_1106681828124841_4623660140586044353_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vIGY9OudaYQ7kNvwHHkq-C&_nc_oc=Adkbpk3NL02WIhHTpUCKTCNyX76AC5ktS1EQUX9iL6MMliQLJG3lbdVHwtQGK7usNOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMlBi5VXKbNMiRGedkTV10XLSuMc_pZWD1FU4yDVeprQ&oe=69AEA9CB"}, {"file_name": "asteroidscreenshot.png", "id": "1131061525405707", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982476_1131061528739040_1828175284449478797_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNwdHA1O2L8Q7kNvwFitOBM&_nc_oc=AdmujSjZIbMv-cVRg3wfCgugSaISMmHCPx2Fk-YU1cJlpuu11Tr_zOcfp-IAGlR-uz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBLmqUIEj_1Sb26-TZm2He8bEGSs7GMRv2lHDRn3MqnQ&oe=69AEAEBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "540707698927577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982544_540707702260910_8978510910524126312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD72bhmgnAoQ7kNvwHWXhEz&_nc_oc=Adl57MArwrWvkmieI1QmK8bZkJLifkW5GYaMgzvx9r20C1uhbchQL19XrVls_ewWE9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7QWvdY6iGqVTU1OE-kuYVfWL5Ak7yNLR9QSgWLXvO5Q&oe=69AEBC1A"}, "display_name": "Galactic Traffic Control", "keywords": ["arcade", "space", "ships", "traffic"], "long_description": "**Congratulations, you've been promoted! Your room is the new galactic space highway...**\n\nDraw paths for ships to follow \ud83d\ude80, avoid crashes \ud83d\udca5, destroy enemies \ud83d\udc7e, and navigate cosmic obstacles \ud83c\udfaf to get high scores & unlock power-ups across 4 challenging game modes + 3 difficulties in this mixed-reality arcade game.\n\n# Features\n- **Hand Tracking**: Pinch ships, draw paths, grab asteroids & pull apart cosmablobs with your hands!\n- **Room Sense**: Your walls, floor, ceiling, and furniture are part of the game. Route ships coming from your walls, smash asteroids on your couch, or put portals all over your room in Wall Mode.\n\n# 3 Difficulties\n- **Normal**: Just your regular day working the Galactic Highway.\n- **Zen**: Take it easy! 10 lives, no asteroids, blobs, blackholes or hyperdrops to worry about.\n- **Xtreme**: It's going to be a rough day at work.\n\n# 4 Game Modes\n- **Classic Mode**: Route the ships coming from your walls to their portals on the Spaceport in the middle of your room!\n- **Wall Mode**: Budget cuts have hit the Department of Intergalactic Transportation, which means you'll have to make do with just your walls, furniture, floor, and ceiling!\n- **One Portal Mode**: Because of a clerical error, your station has been replaced with just one portal. You'll be fine, you just have to be a little extra careful when routing ships!\n- **Blackhole Mode**: Due to catastrophic technical difficulties, a blackhole has consumed your station. There's still traffic to route, though, so best get on with it and mind the gravity.", "short_description": "Galactic Traffic Control is a mixed-reality arcade game where you must guide the hyper-jumping spaceships that need to cross the space highway (your room) in order to get to their destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gnomecap.games/privacy/", "developer_terms_of_service_url": "https://gnomecap.games/privacy/", "publisher_name": "GnomeCap Games", "support_website_url": null, "website_url": "https://gnomecap.games/projects/galactic-traffic-control/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"
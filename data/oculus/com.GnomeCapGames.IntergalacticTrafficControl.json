JJFkwRqfYpTFJuQIPjRpGdbC_MpKd_gqNF-fDunEoauf3vKTFUGgiTRq7PCMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8TXqH6aOPTBOyJUFANuPyRaZleHQRddJrqui9y0bf6g&oe=6A5CAFCB"}, {"file_name": "asteroidscreenshot.png", "id": "1131061525405707", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982476_1131061528739040_1828175284449478797_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yx__i11ro4Q7kNvwG3W8pL&_nc_oc=Adpt1ku2LdUahCiorP-flQPcyJMa6-kJaEGQHjp3UBoe955MQM9mk6kW8SthjLK91RQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7I-9CNSWHWIqTDG8qwJQvU_T5UaHQdG5l9q7mbCm0Jw&oe=6A5CB4BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "540707698927577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982544_540707702260910_8978510910524126312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAahPBqnFfQQ7kNvwF8pec0&_nc_oc=Adp9evusic-B2zHLtPQdS2t-71lXSTdtRd6tJV-BZ79NyX9_r4CKbfFOi9yZSrffdR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZUShkhhuvp7gI6NAp8aSwG8pn6iI2jMJjiYZLd--8Ag&oe=6A5CC21A"}, "display_name": "Galactic Traffic Control", "keywords": ["arcade", "space", "ships", "traffic"], "long_description": "**Congratulations, you've been promoted! Your room is the new galactic space highway...**\n\nDraw paths for ships to follow \ud83d\ude80, avoid crashes \ud83d\udca5, destroy enemies \ud83d\udc7e, and navigate cosmic obstacles \ud83c\udfaf to get high scores & unlock power-ups across 4 challenging game modes + 3 difficulties in this mixed-reality arcade game.\n\n# Features\n- **Hand Tracking**: Pinch ships, draw paths, grab asteroids & pull apart cosmablobs with your hands!\n- **Room Sense**: Your walls, floor, ceiling, and furniture are part of the game. Route ships coming from your walls, smash asteroids on your couch, or put portals all over your room in Wall Mode.\n\n# 3 Difficulties\n- **Normal**: Just your regular day working the Galactic Highway.\n- **Zen**: Take it easy! 10 lives, no asteroids, blobs, blackholes or hyperdrops to worry about.\n- **Xtreme**: It's going to be a rough day at work.\n\n# 4 Game Modes\n- **Classic Mode**: Route the ships coming from your walls to their portals on the Spaceport in the middle of your room!\n- **Wall Mode**: Budget cuts have hit the Department of Intergalactic Transportation, which means you'll have to make do with just your walls, furniture, floor, and ceiling!\n- **One Portal Mode**: Because of a clerical error, your station has been replaced with just one portal. You'll be fine, you just have to be a little extra careful when routing ships!\n- **Blackhole Mode**: Due to catastrophic technical difficulties, a blackhole has consumed your station. There's still traffic to route, though, so best get on with it and mind the gravity.", "short_description": "Galactic Traffic Control is a mixed-reality arcade game where you must guide the hyper-jumping spaceships that need to cross the space highway (your room) in order to get to their destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gnomecap.games/privacy/", "developer_terms_of_service_url": "https://gnomecap.games/privacy/", "publisher_name": "GnomeCap Games", "support_website_url": null, "website_url": "https://gnomecap.games/projects/galactic-traffic-control/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_track
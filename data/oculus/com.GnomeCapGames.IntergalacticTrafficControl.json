pe": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031430_596566496133577_793757579260021690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSCRc8_zm14Q7kNvwFh5Bed&_nc_oc=AdoqDA7izgY0OpKfBvW_Gkvm242Kq-LV9BiomSEKmk7WdUNH1jIs0uiEAW7fIvTeKUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8NZPdXNfUwyG0YTCCG0qwSFvlQWnahlk-wujZPFE-ig&oe=6AE09D5D"}]}, "id": "1085088483113744", "locale": "en_US", "screenshots": [{"file_name": "TrafficScreenshot.png", "id": "1299228224835758", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974889_1299228228169091_4563789821062843063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpf6a9_5s6UQ7kNvwGur3dz&_nc_oc=AdrvLlh5FOxdkS_9Q7JhUWwQx3TP0ScJqmfNem27efmFhVzB3B_Iyzqk0PZ9pZ2gOv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0kmQfW3bbZZKJROiFkxybQwwqNZ6hxX0HzdZ9jTLANw&oe=6AE0B0B9"}, {"file_name": "crashscreenshot.png", "id": "1552702705355332", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001717_1552702708688665_3842435594195653890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-mmIr20kBUQ7kNvwGwkkBY&_nc_oc=AdqYt97WnXCW_R0d8kyBL1kqdfOntw6MQkFhdRUTrN4L9dASK26gooucnMX8mJYozUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuqwZr4pxZtB0JcVt1wJUHHnf71la8E9KzxMDhR11_4g&oe=6AE0BE6D"}, {"file_name": "blackholescreenshot.png", "id": "1300718464455973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_1300718467789306_2308127272415118220_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcA5dS2uvUUQ7kNvwFEIK1n&_nc_oc=Adr1LxY1E6G6sUoxjvOEX1o8FsfdY3LIjHqJAOOcq2muQsLMIyErXsk6Xte__UiO_fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS6R5duw8Y9GUc4I_-_ZpInugW3xnG7wePS9u3l8YrhQ&oe=6AE0B97D"}, {"file_name": "BonusScreenshot.png", "id": "1106681824791508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974879_1106681828124841_4623660140586044353_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr-yVi3tq7wQ7kNvwFBBlVK&_nc_oc=Adqr__8KsRFXVEJ0-uLe4zSnoGtwd9dI_SnzED7bMt9ZHABB1K6ZRJHQ8vq4P2ykEiY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ6yVV0XK2fQGKwmnvq7bdCG1S_3wnD9ySLctRLr5BYg&oe=6AE0BE0B"}, {"file_name": "asteroidscreenshot.png", "id": "1131061525405707", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982476_1131061528739040_1828175284449478797_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QDhHAjA5RAQ7kNvwEtBy58&_nc_oc=AdpcJAR6dokI0XzZoPfa3T3IKZDnSbIopglhHcfQoCmN--oY9WAjZwX3_qBrEWilyKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX257BXUyWpSFSF_NwmiOnrYK77HCNMWCWdfXwdNIGbA&oe=6AE0C2FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "540707698927577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982544_540707702260910_8978510910524126312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=appfXgPUk9kQ7kNvwHgmEBW&_nc_oc=AdqhZ_QDBBU1oAISmLfsxbX-l4YT7IXk04nnUkx7ppiMuMtOYgw9lg9BdR5ov_1yWIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJtLKivRllrp95cN27XX8Q4-9HrZod13fK9RSe1wlkiA&oe=6AE0981A"}, "display_name": "Galactic Traffic Control", "keywords": ["arcade", "space", "ships", "traffic"], "long_description": "**Congratulations, you've been promoted! Your room is the new galactic space highway...**\n\nDraw paths for ships to follow \ud83d\ude80, avoid crashes \ud83d\udca5, destroy enemies \ud83d\udc7e, and navigate cosmic obstacles \ud83c\udfaf to get high scores & unlock power-ups across 4 challenging game modes + 3 difficulties in this mixed-reality arcade game.\n\n# Features\n- **Hand Tracking**: Pinch ships, draw paths, grab asteroids & pull apart cosmablobs with your hands!\n- **Room Sense**: Your walls, floor, ceiling, and furniture are part of the game. Route ships coming from your walls, smash asteroids on your couch, or put portals all over your room in Wall Mode.\n\n# 3 Difficulties\n- **Normal**: Just your regular day working the Galactic Highway.\n- **Zen**: Take it easy! 10 lives, no asteroids, blobs, blackholes or hyperdrops to worry about.\n- **Xtreme**: It's going to be a rough day at work.\n\n# 4 Game Modes\n- **Classic Mode**: Route the ships coming from your walls to their portals on the Spaceport in the middle of your room!\n- **Wall Mode**: Budget cuts have hit the Department of Intergalactic Transportation, which means you'll have to make do with just your walls, furniture, floor, and ceiling!\n- **One Portal Mode**: Because of a clerical error, your station has been replaced with just one portal. You'll be fine, you just have to be a little extra careful when routing ships!\n- **Blackhole Mode**: Due to catastrophic technical difficulties, a blackhole has consumed your station. There's still traffic to route, though, so best get on with it and mind the gravity.", "short_description": "Galactic Traffic Control is a mixed-reality arcade game where you must guide the hyper-jumping spaceships that need to cross the space highway (your room) in order to get to their destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gnomecap.games/privacy/", "developer_terms_of_service_url": "https://gnomecap.games/privacy/", "publisher_name": "GnomeCap Games", "support_website_url": null, "website_url": "https://gnomecap.games/projects/galactic-traffic-control/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8671169856307057"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "967697682559136"}, {"status": "PUBLISHED", "id": "1630477004936527"}, {"status": "PUBLISHED", "id": "1652156432092861"}, {"status": "PUBLISHED", "id": "710632861483776"}, {"status": "PUBLISHED", "id": "460847363771114"}, {"status": "PUBLISHED", "id": "1111275420405280"}, {"status": "PUBLISHED", "id": "586571097389816"}, {"status": "PENDING", "id": "697603349111100"}]}, "baseline_offer": {"id": "1652156432092861"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "967697682559136"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28110926608571425", "version": "1.0.0b"}, "id": "338968608997761", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6943041092453284", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28110926608571425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "338968608997761"}]}, "change_log": "Welcome to Galactic Traffic Control 1.0!\n\nFeatures:\n- New Ship Behaviors\n- 2 New Soundtracks to Play\n- Achievements System\n- Commendations System\n- End of Round Report Cards\n- 2 New Enemy Types\n- 1 New Obstacle Type\n- Record yourself with the new LIV Camera, and try out different galactic colors for your avatar!\n\nPlus, tons of miscellaneous improvements:\n- better hand tracking for Quest\n- better spatial systems\n- various bug fixes\n- ANIMATIONS! Tons of new little interactions", "created_date": 1788925489, "id": "28110926608571425", "versio
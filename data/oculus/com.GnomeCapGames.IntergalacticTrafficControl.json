430_596566496133577_793757579260021690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEUv8AdqMhMQ7kNvwG9nw_P&_nc_oc=AdlvmB75WnLrlnn4KJm7XTDxOqp7wDk5WrKxEs5hZvytHggGS6S0E41PKc6RVE9QBPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftxynUB1-e4uXKvXRqFjpdP1--oxGYvvDi95sd-vPWcrQ&oe=69A829DD"}]}, "id": "1085088483113744", "locale": "en_US", "screenshots": [{"file_name": "TrafficScreenshot.png", "id": "1299228224835758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_1299228228169091_4563789821062843063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTMNPoYcRYIQ7kNvwEU9F2Y&_nc_oc=AdkFl8GvWLWIrtM0AwW7JM97Tj4jhmZD-TqhFOqHjn7UgxWmWFt23Vo-Tr9aZEHfXa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7QLr3fPRyYaFwvfb68GBewDE9aMxo-vWaC6BjMGdcgg&oe=69A83D39"}, {"file_name": "crashscreenshot.png", "id": "1552702705355332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_1552702708688665_3842435594195653890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snfSLXY1UY0Q7kNvwE0ntE3&_nc_oc=AdmJDlH-3dko1n7f5RRfftz4UcXcdd7JFFNGotHSWX9pLLaidnAj2Q2mB-hWlKdirds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvVePrAvBogg8UbJ23_R5dAN_A0xpCEwmm7IDSk_un_Xg&oe=69A812AD"}, {"file_name": "blackholescreenshot.png", "id": "1300718464455973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974876_1300718467789306_2308127272415118220_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXm2xEHZnSsQ7kNvwHXr2MW&_nc_oc=AdnEHGK8iuSuwVQhWxSo2WkJLXNzHYHXGQF3oufzO0q3PCnxtprM6pLOmVuU3lsVgjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqU7AZj2rjVIPlVnfFpbRUrkV9SKpnmsOD2-uyj9V44w&oe=69A80DBD"}, {"file_name": "BonusScreenshot.png", "id": "1106681824791508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_1106681828124841_4623660140586044353_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Six69vkDOS0Q7kNvwG0FZUj&_nc_oc=Adny7ngaSx2iZ2I6dK_A19GqGS9S8k2GT4xELTrrQuoXiblimFQZ57-C6_u13HCaRrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu6uM5_0vpw6mUqMGtaBiQWm0SVlX8ymkxccsY66RS1iw&oe=69A8124B"}, {"file_name": "asteroidscreenshot.png", "id": "1131061525405707", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982476_1131061528739040_1828175284449478797_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TASJEWnGeVAQ7kNvwE6-3ZG&_nc_oc=AdnMvGN5ubW5eXMvoffVe06LaMkd09fBZc8E1V4AA4wxUS7gqrAiBSJc3KnfuHLhqQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftXHARGxVhnigcNAPPcFzDOSV7738omfeJYASqp4snhdQ&oe=69A8173F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "540707698927577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982544_540707702260910_8978510910524126312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgHUWfzMoyUQ7kNvwFt-qc9&_nc_oc=AdmSM1AnM2FZ6GI3Lyh85JMJmzZeAV2PJJ3GJ0fZmAsx0xcSdVQNsd9nC6j_PypGtf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftuYdHewSTlGVsTxWaEanj9hrw8Anyfdj_KmYxiDolvSQ&oe=69A8249A"}, "display_name": "Galactic Traffic Control", "keywords": ["arcade", "space", "ships", "traffic"], "long_description": "**Congratulations, you've been promoted! Your room is the new galactic space highway...**\n\nDraw paths for ships to follow \ud83d\ude80, avoid crashes \ud83d\udca5, destroy enemies \ud83d\udc7e, and navigate cosmic obstacles \ud83c\udfaf to get high scores & unlock power-ups across 4 challenging game modes + 3 difficulties in this mixed-reality arcade game.\n\n# Features\n- **Hand Tracking**: Pinch ships, draw paths, grab asteroids & pull apart cosmablobs with your hands!\n- **Room Sense**: Your walls, floor, ceiling, and furniture are part of the game. Route ships coming from your walls, smash asteroids on your couch, or put portals all over your room in Wall Mode.\n\n# 3 Difficulties\n- **Normal**: Just your regular day working the Galactic Highway.\n- **Zen**: Take it easy! 10 lives, no asteroids, blobs, blackholes or hyperdrops to worry about.\n- **Xtreme**: It's going to be a rough day at work.\n\n# 4 Game Modes\n- **Classic Mode**: Route the ships coming from your walls to their portals on the Spaceport in the middle of your room!\n- **Wall Mode**: Budget cuts have hit the Department of Intergalactic Transportation, which means you'll have to make do with just your walls, furniture, floor, and ceiling!\n- **One Portal Mode**: Because of a clerical error, your station has been replaced with just one portal. You'll be fine, you just have to be a little extra careful when routing ships!\n- **Blackhole Mode**: Due to catastrophic technical difficulties, a blackhole has consumed your station. There's still traffic to route, though, so best get on with it and mind the gravity.", "short_description": "Galactic Traffic Control is a mixed-reality arcade game where you must guide the hyper-jumping spaceships that need to cross the space highway (your room) in order to get to their destination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gnomecap.games/privacy/", "developer_terms_of_service_url": "https://gnomecap.games/privacy/", "publisher_name": "GnomeCap Games", "support_website_url": null, "website_url": "https://gnomecap.games/projects/galactic-traffic-control/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
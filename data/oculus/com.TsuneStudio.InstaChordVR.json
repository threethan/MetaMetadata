407992554_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDbIf29HIZ4Q7kNvwFpAm0B&_nc_oc=AdrdmmCfMjLZB_tecIgP7GGVUiy3GOFrKMJnTR4ixff1ZqQ98vwWS3QnHzDEQljEf7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT80HqLchXKLbWnnhQNCbjp_oNg1iqxnVAKHDnimiedsQ&oe=6B05D026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30d7\u30ec\u30a4\u52d5\u753b\u30b5\u30e0\u30cd.png", "id": "1074551730010543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207241_1074551733343876_3758072879519379470_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMYTikcUh6AQ7kNvwFDhhR-&_nc_oc=Adr6Gv5vEhrvIEOfMmNp8jTeVqr38Ga2dzX4P_ySqypccsNR7CDwOOJmY1u4naVO2mY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv7kCO1VX36-4_xVf_G51LjN_tPvI5-oZLPFVEkiaAWw&oe=6B05A65D"}, "display_name": "InstaChordVR", "keywords": [], "long_description": "InstaChord VR is a music app.\nYou can play a song simply by selecting the key that matches the song and pressing the six buttons.\n\nFirst, search for the song you want to play.\nThen select the appropriate key for your music in the menu panel.\nFinally, touch the button with the numbers from 1 to 6 in front of you according to the number displayed on the web browser.\n\nThis app was developed under the supervision of Yuichi Nagata, the developer of \"Instachord\".", "short_description": "InstaChord VR is a music app.\nYou can play a song simply by selecting the key that matches the song and pressing the six buttons.\n\nFirst, search for the song you want to play.\nThen select the appropriate key for your music in the menu panel.\nFinally, touch the button with the numbers from 1 to 6 in front of you according to the number displayed on the web browser.\n\nThis app was developed under the supervision of Yuichi Nagata, the developer of \"Instachord\"."}, {"images": {"nodes": []}, "id": "227353216136428", "locale": "ja_JP", "screenshots": [], "video_t
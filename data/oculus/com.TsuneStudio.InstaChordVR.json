407992554_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_HNlTX4UEYQ7kNvwHwdYYR&_nc_oc=Ado9UlYmGb-YJTTly2hezKzYijUvJf0UOvyj1GpdtxvKVAxP4921WlLZ3VmgBtcgG8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDNwwy89ffIsHmswfnusb2lbTaYNjb-2z3LcW4m6XvLw&oe=6B032D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30d7\u30ec\u30a4\u52d5\u753b\u30b5\u30e0\u30cd.png", "id": "1074551730010543", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207241_1074551733343876_3758072879519379470_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU-WFECaa2cQ7kNvwGfyCSj&_nc_oc=AdoCwI6I6GYvFe2JogWaiPnKq2mcVgxq7lK00DoAAAy2h2RwA74rkMD9lQrrqWh_ZqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiQYrnRLDCP7dIaBZR0ZLJVgVrBPlz9kyL8Oz1v18B-w&oe=6B03035D"}, "display_name": "InstaChordVR", "keywords": [], "long_description": "InstaChord VR is a music app.\nYou can play a song simply by selecting the key that matches the song and pressing the six buttons.\n\nFirst, search for the song you want to play.\nThen select the appropriate key for your music in the menu panel.\nFinally, touch the button with the numbers from 1 to 6 in front of you according to the number displayed on the web browser.\n\nThis app was developed under the supervision of Yuichi Nagata, the developer of \"Instachord\".", "short_description": "InstaChord VR is a music app.\nYou can play a song simply by selecting the key that matches the song and pressing the six buttons.\n\nFirst, search for the song you want to play.\nThen select the appropriate key for your music in the menu panel.\nFinally, touch the button with the numbers from 1 to 6 in front of you according to the number displayed on the web browser.\n\nThis app was developed under the supervision of Yuichi Nagata, the developer of \"Instachord\"."}, {"images": {"nodes": []}, "id": "227353216136428", "locale": "ja_JP", "screenshots": [], "video_t
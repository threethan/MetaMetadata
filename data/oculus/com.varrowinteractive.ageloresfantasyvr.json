yrCVp1ZpBFDFapE8y3pu2YOqNzew&oe=6A5A3656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store-Cover-Art-Landscape-16-9-2560x1440.png", "id": "1261776600555605", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427537_1261776620555603_3495362913697267712_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y-BfZB5ru0Q7kNvwFU4lRf&_nc_oc=Ado76D1fGQVEhCQteOUHJf66QBXJp-vn581vNynIQv8fTiaSrN8xGJscP4dxbXJ248M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_7orCzobLO_eJ0D5c8FRlzelGwJbDHS2Q0V2y6V46cw&oe=6A5A2C56"}, "display_name": "Agelore's Fantasy", "keywords": ["fps", "shooter", "magic", "touch", "wizard"], "long_description": "Agelore is a made-up name derived from Ageless Lore\u2026 A never-ending story, this is what this game is all about. Endless fun, kick ass enemies, upgrades, and your trusty all-knowing staff. \n\nPlay as a wizard, blast enemies with your all-knowing staff. You have the options to upgrade your damage and health.  Enemies will keep getting stronger, and they will rush to attack you as well.", "short_description": "Epic n' Endless. Play as a wizard, blast enemies with your all-knowing staff. You have the options to upgrade your damage and health.  Enemies will keep getting stronger, and they will rush to attack you as well. That is all that stands between you and the end of the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://bigimmersive.com/legal/", "developer_terms_of_service_url": "http://bigimmersive.com/legal/", "publisher_name": "Big Immersive", "support_website_url": null, "website_url": "http://bigimmersive.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "rec
dn.com&_nc_ss=7f20f&oh=00_AQEv3c07fvAi8QFU0Nu-u6lV5PHfNEKbIDE4Jgy8pl2k8Q&oe=6A805258"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO1qar2duOcQ7kNvwEb8m1h&_nc_oc=AdprHZZyEK7olpr9PbJAzK62-vmmDs9fWl8bF8eU6lLtDXiBYareAN_5fEFup1NVqr0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5i-olMPm6dU4Wba0W3kV9326ox7sWZ1x6tgjxqEKsZw&oe=6A806E23"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zADuj9MGedEQ7kNvwFpgkaU&_nc_oc=AdqS3RxzcVMzv4fGpcYxoJpaHNpmi-OecaxhB08-YvcdO4vkk-iarWCEhfynEZ2DLuI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzjVewRKTKIuKJ6BHisW1ta19fOQoGHxBfoExmgBS_1w&oe=6A804FE4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2USZLGD7fYQ7kNvwFw1qXB&_nc_oc=Adp8CAyxGrVcorhkoYyi-qxWO8AVC-8I4JpSGdmlXu_28pLXrqT4zIL-jOO_zQRKf64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQQe6bZLgZFrkMSIxCQqXMTU6SPWAVtuuvCM6AcrUlsA&oe=6A80697F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTweZONuV5EQ7kNvwHWHIkJ&_nc_oc=AdpX1umKxEGvgFaIKRNsxRlLoIsOaxizDhOgkSmOwJTXJhdNT8ce-bu4WzZaU3fjmIw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwZCPqfXzCJSNF5rOBd9Dgo3bns-pWmk2mMvgLIqseIA&oe=6A805427"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
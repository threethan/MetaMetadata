dn.com&_nc_ss=7f20f&oh=00_AQELEmAE-nxTSWlui0ynt-fNFFrl84BNU-3ueNo3iLdpEw&oe=6A972C58"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFjw4c224bEQ7kNvwH_ntiE&_nc_oc=AdrJPWMM7mUWWgg4KgQeOkHbPb3tO6ldgoh4_l7ECj-w9tBVkNKlJC2qs8IOfFb2ECE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkjYeQk-hw9Q4J7_H1hZCHZr3igRagd3fQ7dB0JAL2Yg&oe=6A974823"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRosgCDyhisQ7kNvwGtWWkt&_nc_oc=Ador47qhzywK0m1DiLCw4ySCuSAmzYkSJmAn7mXwAJ2i_UOlY2ajBABYfKm6fEu4sr8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQn0xzefkBDd9-Tz3tsMO02KbiK9nS44-XptfdtZxVeg&oe=6A9729E4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVLN57Wrk2MQ7kNvwHUNR2_&_nc_oc=AdpsGnSGLDoSVD0y4fKu46pAAacDdsdGy5U7MkSDYICXTf5eU-d0VnWM1QdbVF4YoGE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIAjvhkD1HZgalQc2TaVmu1xWBX58FMAvpkRiy_7aQbw&oe=6A97437F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey1xZnTotNkQ7kNvwGxmdL-&_nc_oc=Ado68xRLyGky4el463u9Nk5IBIpugMWvMJg2ua9H7Wb4lupT_VzfK5uyVT3eihCXzQ8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaCFpMWEfRgMvkwDH50X3qYbYPMSAHoUckNgMneWekWQ&oe=6A972E27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
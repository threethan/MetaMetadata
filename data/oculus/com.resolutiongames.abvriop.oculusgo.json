dn.com&_nc_ss=7f20f&oh=00_AQLE15H5OY7WdcoD4ypmqzWK4VpqhaQV7vh7dRvijFv8Ug&oe=6A9AE898"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kw72eiBQPEQ7kNvwFd6DS_&_nc_oc=AdqtTb46eRYqYcPRZHX9yGhM5CS3DlGU_K67XEEBWvKUagr_XSfswJmSd0SDyesbzUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTFpXj40H41ypKzCxGCWBp-RZibGpxzPfroN4U3B8gqg&oe=6A9ACC23"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4Jb4eco82kQ7kNvwEyiQpb&_nc_oc=AdrMlGgzzj_l4PXIlYSdIY0hI6VjRo3FFYnR0JndPQPBmx-G-lSgStkPBtm45uORYGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYgEBuzIAIjKllwLyWtEuC3heVN5O6mVkQfFTd9_A6iQ&oe=6A9AE624"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2bxxrj6QwIQ7kNvwGGOaBM&_nc_oc=AdoVFvqDCLjhrhipajMdW7M5_-iTBoUBCYE19g6A87bqhrf4jaXK_VwkFdrkembTZ24&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKId3mV2ATvbKzfzkWvH6EYiBBXShAhYv2Y0YivVXoRmQ&oe=6A9AC77F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-8ZTWof74QQ7kNvwEgAq34&_nc_oc=AdpN_BJfGd6vXBV3125jTLGWZwTwfnUzXSP-qe3s-K-AEWNFg7OuybDJIECSHOKaxcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpTVOzFO7QriV-N1SyJIsTkH5uBqSIviKa2mjJw7WoPQ&oe=6A9AEA67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
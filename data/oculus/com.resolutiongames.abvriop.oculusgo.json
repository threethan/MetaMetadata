dn.com&_nc_ss=7f20f&oh=00_AQNztEhsx6t_STsEo2WVDQe0DTpUOmr6GzcTKdkxRoJFzw&oe=6AE0C818"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiIoDS39uiUQ7kNvwHHfe9y&_nc_oc=AdqLEl3AQt_xOXZ7Xgk8p5gvy6G8SevtYScAk73xdhr90mm4DlahkVUkwzXsCr2u6Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4T5V_DmZ6eTF6t1A3Q7U2MQ-mIajO5Lt8OMNOUmTESA&oe=6AE0ABA3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBjJcd5LTEgQ7kNvwF19MgQ&_nc_oc=AdpLbYaT-zMSqGhk4NHNxsGH_2PhJUOCo-hVtD9vEZ8gnv7GansozdOKpw3iXr1W4Qw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKA_16k_L0u9t9mbbXGFbKv-GJh4apG2rcgAWR0YWCHg&oe=6AE0C5A4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZRGtdboiDgQ7kNvwEoVVso&_nc_oc=AdrYobN0LgqKt25bo7B3bvc5zg1lMQPwyYD-U9dDukdeCpzMPfajhzkM1XJ27OTkeWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN89QbAILXy1R4jzklfuDo7s0rmvAfTQW4yVm5iFw5Agg&oe=6AE0A6FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67ZsSBWqqG0Q7kNvwFhrOX3&_nc_oc=Adpaj2IHfyrbZWFog4tSYLwWwETp2zRDLlTfICtl_3kZRBPWH3uvu-jfH1rQkvSPb-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG5RKDLYEXTUTaU8GEY8DDL5BPz_4DJFwWLVJINdgeyQ&oe=6AE0C9E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
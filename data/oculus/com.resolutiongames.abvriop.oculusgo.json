dn.com&_nc_ss=7f20f&oh=00_AQHEz9HZwfx71se2HCbL-Qce2DFQDfzjJvEbnZ3NsQDXMg&oe=6A9175D8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yklWm7o-3KsQ7kNvwGl4m6v&_nc_oc=AdrRLGGOgQz9nRXwhO5DyKKsL6R439lt7RO2dtwbao2IyPjBOCcFxoGX66nb0MZUkCg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGghoDRGIjHygM8SCYUoPWRkQ4qGAFBXBSom-XGsYx5_A&oe=6A9191A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrngMyrefGkQ7kNvwHB7Txz&_nc_oc=Adq-jkaqVhEwlXmaej88IQz7m34gViAcULvumLN3Ft02QZ2ETxLaQz9nog09wSNUy9Y&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqd-j-yJWUyhVB9gteY6ujDBN7XCG59AJvJOWGiIfbQw&oe=6A917364"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDeZsuGgMuIQ7kNvwG7--JJ&_nc_oc=AdozVrKbsWufYRc5QvPBwUBM3NYGk7EqnNCPEY23rWnxzUNW2lHuEZuy-am_BwoJdcQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfal73DtcGVpbo84dmjt8Sqftm0W5lgAJXf5drsyocjQ&oe=6A918CFF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqrVVT68fbYQ7kNvwG5iIzU&_nc_oc=AdqsgEktduOpaRlnGlhOYx8G_zhahrYF_FUqeTtSJRoSi-2BLVjtgKLjUjpB1h1TFMc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbL9n-7_fYVD75Wlo-rKnex-t1WH3SNxtLvH-j28NXNw&oe=6A9177A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
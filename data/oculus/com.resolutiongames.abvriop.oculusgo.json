dn.com&_nc_ss=7f20f&oh=00_AQLZtQPEpcsUpKYhvG0OVWAcCi4FqYBjqbvvUm-Ue2RMdA&oe=6AA02E98"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceagA37EGUEQ7kNvwFG5M3B&_nc_oc=AdqIsghgF8-dOu7aGukTFgvvKZL_aUkS38m2sX4q-Wam4lf_o2W2nV62RFqfR0Mp3to&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ1xUdJSU6WyTXbeeWj-lCUeFXCNouy6N4EsLEv9C76w&oe=6AA01223"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqsE2RcfaxUQ7kNvwH8QVDu&_nc_oc=AdqkYggiZ8WoxuVecbfCv5BuYi2Rgl6YKaNZO4WDLFTmJn-wTidS0X1TmOP6IjfboMY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8w6ml0Y9ftbXgdakfwr38UOXm2fTjVN-sCS2q5gbGVw&oe=6AA02C24"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1MEp-5v6u4Q7kNvwEhDcSh&_nc_oc=AdoKftYrAVqePT2GHGeNjzFEfHe3Ugzg6C9kdyQmayZPLs_Tzd9tRdwv8z8_2p7wVcE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb_oLrmK2TmRXsYV24eouYcF30zjwA_13KYbfmZOHXWg&oe=6AA00D7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvW41TqtoUkQ7kNvwFuQcVa&_nc_oc=Adr9k7C5wHD7zEl82CDNNiRbMzDbcwSIsRXkVeUA9fgDtOFec2oesY2uC-1zA3yDRRw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYuyLVxMokN6yRc5ok3FpreKZ1dX9qNctUr57fwTFXDw&oe=6AA03067"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
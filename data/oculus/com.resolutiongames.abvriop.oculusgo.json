dn.com&_nc_ss=7f20f&oh=00_AQFelj4WbcuJKfRJOlYSwXEDDk294_XIJYkD7KmTksXBqQ&oe=6A8C2FD8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqGEgI47hv0Q7kNvwGH0Kjn&_nc_oc=Adpf-eXL8jJw9zMqyr7Ox2HMoyJjkaZ8AlIUxgAIEUCF6_pxKUGN1fY2T4xPH-qiqR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-i-k-WttYFN_Wf2exW7kiVLcrDqXhORJtdq3V5J7Y0Q&oe=6A8C1363"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1UWpfvH8eUQ7kNvwHgsqjx&_nc_oc=AdooeSwQQNqielGsvy2vwn_t7kJb3WN7WSmg3JL7vqh0Br-SUT3-doGiUrva_tBsuyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVLv5X1HxoJpPg0pgznUyviNfP7KPngYzCNlHnlFSAPw&oe=6A8C2D64"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwXZ__6UNjkQ7kNvwGRx86L&_nc_oc=Adqz0YKUyZrecFgbGJ1cQsLV7g27gYN0iCm-OGidZOwLpdgG6IRNWKlZfjhrP_sx6rw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYeC67Yso1giTgViPgOkSazaSYk_-sxugFAvWAw_zYXA&oe=6A8C46FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ioJzOzze8AQ7kNvwEFjRgx&_nc_oc=AdooYxloRoNRWJXmgABNIAwL1jH3Zk5YIVekchCcsdUWcBJLhv6ZRT7vbx2We9fmrtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGImKgUJoZ4BqyZED9jUNiaNLJy-aG05_bFQotEKTaxiQ&oe=6A8C31A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
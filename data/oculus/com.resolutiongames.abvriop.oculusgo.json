dn.com&_nc_ss=7f20f&oh=00_AQDi2KPdMRMoDFmdEkp796vxvK8W9n6clO2PKBRSJjW6cQ&oe=6A492B98"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7S1b73NdLoQ7kNvwG4CyaP&_nc_oc=Adr6CXdC_N4mAx-onOahaGW2Hz_6Je5afwi1C200T2Z0X7om_Q5_VM24rNqDDXWz1lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwye1Ex3YYdS-D9ldUpkDSiBeA5AWDBIrvc7wAbq19qA&oe=6A490F23"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly7eZi8xTTYQ7kNvwEpaClg&_nc_oc=Adofmgnh9VbDIR-UBio1Qt3_-6PONUdD5TDzeJjfh4PwA5RievEZ8r0eB0r2noabdME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPA4QnqrzcU0r9UY2n-Z0Q45e1YklCTwaZIaDBwEiPNA&oe=6A492924"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCGUXGZIXQgQ7kNvwEMWxj4&_nc_oc=Adouj1jHi4Pu52CzFIEXV6qBiXIQqQKAvrRpTTEFzQbCnDeBOSnhgVg3wuBdh3TL9dQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAas2DQPA08Jykw_OdjXzZXlpz-M_Fty6Fp3BIvMfdz-A&oe=6A490A7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2SvXIB8D_kQ7kNvwFnUBRH&_nc_oc=Adqie_RRZzGSN_VULvfJFk5uYTpvvck5Rgs8-lvxGi3g_vE4s1mof8TGU0CO_87VyDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsaAUtMMzXCA26_mRaa4fw4RgnyH6L7BAAkbAzJT68Ww&oe=6A492D67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
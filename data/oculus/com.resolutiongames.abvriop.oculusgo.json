449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRosgCDyhisQ7kNvwFcnG4A&_nc_oc=AdoPnfnrLFUbFemjlxyfzS7BHR0DbNZUU7JOR4HaSrAgAgiv_fMDqttpXlpgyKqZVEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL42ZzAL1eHBxNFfxxfP9k6_MRFy7ZqGeLScZOwIdQp4g&oe=6A984324"}, {"file_name": "migrated_image.png", "id": "2949834788371824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVLN57Wrk2MQ7kNvwF6mWtt&_nc_oc=Adp_hPvRUQl7VP0MLilnxqA0aC3jBr4r-kRuQTfVyvHH6xD_PdQ80rpGvY--Gho8WHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3jQ5GNqq0ZhZiU8aYmBofcK-2xxxvk6aqNi6lKUQ2Ow&oe=6A985CBF"}, {"file_name": "migrated_image.png", "id": "206666960587252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey1xZnTotNkQ7kNvwETw1Wh&_nc_oc=AdrqF7k2zL4JwpEJyEwvs5anoUAmwvJqVwJmvJxq36adVyo9k1BDvIpGZYYERKxDesU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq1mW9esCRTDCrklOmnWIZ0k9nPy7Agjg8Sx5NnPRk0Q&oe=6A984767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/BGkdlA", "id": "448302755956559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974630_448302759289892_5666675134744756224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0z2VmuMV9EQ7kNvwHueV-G&_nc_oc=AdpEFntLuLKuskwol_w8XNn2gHlEzmg0d20oiMnr3H4_M7A3RUBGtjD_JTRjwrHJPfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIElVVxIIuXQ5Oy9f9OvUoaOCaRoFxuaGo3IzIXo9vHkQ&oe=6A986A1E"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
dn.com&_nc_ss=7f20f&oh=00_AQLRGZonmpSgAbrfsuE_zpmD9GhjpY7RYVfRskY6AFMjsQ&oe=6ABA8C98"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkQt0u5DWuYQ7kNvwHwtnXX&_nc_oc=Adr73BKQ3PRwXQw1UfghuEaKhR_IVa3BRahSf9HW1aNqtKHiJWb7pqpBhQGfxB5n1s4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYTL83WR5lLSFGQZrWeXilBA5-bfbM5DLgR05DSj203g&oe=6ABA7023"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ3SBt9GfYMQ7kNvwF8U3wI&_nc_oc=AdqwJCuvyAaKBJEySWWwzkBtTfQZrTfDogIl0MJtVYGmKrchbnD7Ij05PxefJgdsphU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDrvnaHDbUnRvv21Ues4PzpEmLSK4BoLCPD-cVLbaX0w&oe=6ABA8A24"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPkozNTNMpUQ7kNvwEp9ULB&_nc_oc=AdpJDsEkUw5RNgQF4cpmE5fMaXCZllH3DwxoYAANjSHdZ5PdMIDpV2ECgAiWVA0xudo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuxXaC-OQlTUgnyEP8gwHVlupioLFRzGTTQ6coSuaylQ&oe=6ABA6B7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEXquI92wToQ7kNvwHXILuW&_nc_oc=AdqMcnCYtB-0IGPs4ccqusbBQXJgj26zVLx9jIIbFc5-qkmTGAjfTZNKAdPUMRdk7ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmL0UI77I8hisoB0xm-DvDSZQTKQQBMXG1Xx77QithXQ&oe=6ABA8E67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
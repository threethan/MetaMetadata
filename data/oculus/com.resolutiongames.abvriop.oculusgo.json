dn.com&_nc_ss=7f20f&oh=00_AQDBHJjYolddkZ6PHb9kwFQWZSvZzlKhJ7Of0An8tMKWxQ&oe=6A58C558"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jue7HIOyebcQ7kNvwHaQ7hw&_nc_oc=AdpZ1Or0aQTqmyB_5Bc4hbdzCMgzmaudgmrjg5CzChecojWKpfW6cQOd0JviiBEJ7Hg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA69pyD3l5u2VWavBEwgfM5XKPBSn4aQc4XoeQEgvPavw&oe=6A58E123"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNHXmk--lDQQ7kNvwGgueee&_nc_oc=AdpXknzh9uNKlyZr_OObFFV2oeimWmUtV9gYfjWLulUQ2T9R7aGtcwi6P_8BlpXBTMs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKSBglyXjNXcPh7Pp2UfTbwNK-tZlTGlFR6KLUs4yNmQ&oe=6A58FB24"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJPsvW5MfToQ7kNvwE1cxqz&_nc_oc=Adq616gU4BAQN2tx2M1RbIYVUpmnmB_7o6OeYb8VXa3RumybzouzpZX1-oXIoadJFtc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ao-9aXtz5BuELB5OGVPypkztgvuWemPzATDc0aL8TA&oe=6A58DC7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyGzd8ZmXFYQ7kNvwGrOUrJ&_nc_oc=Adpk80uM4IFeqMaee7ZkCTEqQ6iPj6cGVkASKI5Ojn7qEO7It2e_fYaazwyVtLbG96o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfSXUL14kvPWfxIaahqrzCIw-ZyMtTUHhxEzp3uROruQ&oe=6A58C727"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
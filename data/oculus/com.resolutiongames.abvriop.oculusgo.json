449", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn_D-yd0_icQ7kNvwF4xC5V&_nc_oc=AdpPf9bLuqB5-QpSQVa2hNpz20HuH5Lp1Oa7cgflyUw5vXna5rRek-URn8D6GoyAlTI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy9377pV6XzKXjhLZC5k5jXScL9Ul6eL33f84CURz_3A&oe=6AC7B924"}, {"file_name": "migrated_image.png", "id": "2949834788371824", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaJH5Fif_coQ7kNvwEOymeM&_nc_oc=AdpH_cHmVU_14itOeMPoOvpm-Tt2F1WvorvU9PMBiNuS8zlULumzwfTT7i0XDshqPdw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVAf8TgenUJBZwE6QzeAKIRP7Nz4u-pfOYLVu9SUL3Rw&oe=6AC79A7F"}, {"file_name": "migrated_image.png", "id": "206666960587252", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFjEQqWnLZEQ7kNvwGORepN&_nc_oc=Adqc5E306s0Bh32Gnh7IvCKqP0dGF2mAcxR58tAOKhTb4W3PS-qNpnO8japp3d6mv0k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPchHG7Lf1ImOytCWm5m004CcvGblqR15F6YunHzkVGvA&oe=6AC7BD67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/BGkdlA", "id": "448302755956559", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974630_448302759289892_5666675134744756224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rozTT8egAaAQ7kNvwEccaDX&_nc_oc=AdqMc-S6vbh-xGoZHy-FMpSVw5kWm6m1oJtsia3Kn9jXG-0S2z0KSb18lrYOh98Ga3A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFDtpncdhOg8sH40OFRVQZXjqBYbk8U7K6RjWIYVV5xw&oe=6AC7A7DE"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
dn.com&_nc_ss=7f20f&oh=00_AQMwRlICkFBsRHBLnqhKhvDEWv0qly_fTtJQFmGXNTAvWw&oe=6AC12418"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9ZXCqjyuWUQ7kNvwG-5wL9&_nc_oc=Adr05SqUpICYTax12MZI4RRmbYiHWhxgxw-GxlrucKbtc1OizP5qKy91ymyn7tZwNqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-V2odR11x_JXGfeb69vIsonR1OhKaX9XsvXhMHGEEtw&oe=6AC107A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qnae89cjMkQ7kNvwGo-RBS&_nc_oc=Adr_OZc8LvpEbSzVHIp6Q34R4cFABPpEG-IqZiDMsqBvO0JTEI2DXEIKMJFKzVTYZig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ7CI6dmejum__s4IXgjlL6q7mg3He_lH4xoK6CILQmQ&oe=6AC121A4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ09MmPfpaAQ7kNvwEr5YVa&_nc_oc=AdpvqY98mwS9A6zpkpe4ZlYIwIRKKuJyg9WxNwM3GgXnPNkETo07B0oPq5LBfIr7ywQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAJYHeTvEu6bdF8tBJ_RfE_dbtyTVBoMWaQqCj9yuf_A&oe=6AC102FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhGiY3ygAVEQ7kNvwHmNjOs&_nc_oc=AdolRw2Aw6OB97ZmiHraxBQPf7imWoC2umo4iV6sdW5fxB0MUcC_QllLeHgOJWQSa48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ7wFk5XLrDW4x-VA7oHiqNG81NKiZ91phLdX8M62SJQ&oe=6AC125E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
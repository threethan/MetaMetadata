dn.com&_nc_ss=7f20f&oh=00_AQTZBOAuFY0aEQSWMBdqSdB6FAEpKfN8j6GNhfIQ68eBjQ&oe=6AEDF718"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsWtwJrz21kQ7kNvwF-fPyu&_nc_oc=AdqiKttbtiBVbyCXTtZAOy7vS91rjC-7bx31ZICNrftkXavNDeEU_CcRDz3PJIwcoU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ62B7RSXVrQw3T9ARGBzKjV0M_Lcn6qPibf1xEb5F2g&oe=6AEDDAA3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IX-U8tFbMgQ7kNvwHaX7eS&_nc_oc=Adr6MO7ucEq_A4Fui5unOa84DnKAmo2MVrLSf42qKMe1qOIXf4eHoE2i6svgwOay7DA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPSHIguKJe695_UHVJcNHnlrGLSS59Z01Luqh4Rp-irw&oe=6AEDF4A4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwiFdSTnOjgQ7kNvwEhbo_W&_nc_oc=AdrOo5H-5SDm8NVZOKMMG-vOdX4I436dHe4CaMSoukDqE3b3-IhtZH2_zBDeV1Re75Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXps5sHmkXNtP6IL-FuHk0aS_tHQOLOnkGfpzCL3u8_A&oe=6AEDD5FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k174EsSHCBoQ7kNvwGn1W3x&_nc_oc=Adr7VNwVm3sV5p8eE6YOZf32q4O6boN_RdGLovePVXjFxlbknv6sHtGmmizTEU7R8rQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkfuybjyE8hfOdtxP2Zh67N_oywofH7RYG8iVLq9H5EQ&oe=6AEDF8E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
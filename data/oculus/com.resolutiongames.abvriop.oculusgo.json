dn.com&_nc_ss=7f20f&oh=00_AQNadwAwFEgRwdWLIxF-cZT0z81XMSr7sO-0rwIbuxCZcw&oe=6ACA5E98"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp_1mbUNFqkQ7kNvwEDqkyH&_nc_oc=AdqciUJXVg4OTfputXU9Y39kzwK3WVrNOpm8yK_yAJjvuwMLB9VupT91gKm5v6JrMw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBDEwvI-mFH2tfDVO-AzXcmWQ3f1hHmAFpXTJ9b4vPiA&oe=6ACA4223"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JA-V_0JcmcQ7kNvwFrYCkK&_nc_oc=AdqD-Gdbj8UHMoIer7X6Mo4aCRJLBa7jgEcKNEQg-JiDURNtWO5PGNqhyNpBCifcFwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYXf0N6x2tseiOvL9Ozgl0VPhKTFODESm6OxE-YQ62bw&oe=6ACA5C24"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IipIly9Z3GwQ7kNvwERg0qt&_nc_oc=AdrKtAcHJEfbE8Q7rD3_ms9jn3rTFChjP5SWrVbN83NcpDypFoYEI0PJ7diRaixmvTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMISlcd0EMkETY6c5RJ9OQikQ5QvJPJbSpXYgEYgM0KMA&oe=6ACA75BF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff54Pmk1sE8Q7kNvwG0zTaC&_nc_oc=AdrRFCmWkl-GCXpQDpCNDyr6m_g-XBA54isP-Mrw2oUxjWJIHwgEqCsz_Tl4VYDryEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCrPbHTX0wFKLY4FE7pfFvEIs1JQtZAgCeh4ppwT8tFg&oe=6ACA6067"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
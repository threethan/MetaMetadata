dn.com&_nc_ss=7f20f&oh=00_AQAdADnsW8-ysYir41T4STGjahZy95_zzerKTtvfId1GSQ&oe=6A6C8BD8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOHq2yzI8qwQ7kNvwEiF2ef&_nc_oc=Adrs8asTGO_X23DRIiBFi_3jw4hdrPS8z_-xRvYU_60gEhgXldedjgZL303_ZtQyyRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJDhXy6KmPQgdWZDP5gRfH6XeJI_spXsznDk4jZM8u5Q&oe=6A6CA7A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg3c3m7Yp6AQ7kNvwEt3qQT&_nc_oc=Ado_6OmBorOxVW7h6pwTyWAtQOYC9GhWMTKjKY4OR3VTh7XPV8I6_5co_FR33inVXCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeeKAxjAsOJieK7_IS1_tNippZ2HRfwfdpEl9SUlQl6g&oe=6A6CC1A4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJul8o0GWRkQ7kNvwGQELxE&_nc_oc=Adp64SzWXzEL9b_3qDXNRCFHc3DnQb3EYPOyJT5PbWXp1gKjkUOPr0wnDB1sCx3OYf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXw2MT3PrjVq-HXhurspIEQ1Ov8gizwh4c4iBU63r9ng&oe=6A6CA2FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObsM98gZXeEQ7kNvwH_6Je1&_nc_oc=AdqCFvflo9VX2orzhuIXrS1jnHtfnuAx9juv4B_5uJK23_rCnoFvvPeNt8EccvaFS6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyN7QSCNJSa278vxP4hrfxXRWzBsCKJD7oESRSivN1QQ&oe=6A6C8DA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
dn.com&_nc_ss=7f20f&oh=00_AQHh7UcGbPQjpuYBxryNJJYyP9PF7eP8Fu7VH7j-50eNuQ&oe=6A732358"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-oaZOS90EQQ7kNvwFaypEh&_nc_oc=AdruWQYqER7yWRCB9tYdxcrrHcy6oq2WQd4LUnLUrdqmqu21a3-TJUqxO5qkgvdYslA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVzANDWQfItUuuv_favta86V8dJTNEfK0odmF1G_sP-Q&oe=6A733F23"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldAm7c_XVG8Q7kNvwFkTfUM&_nc_oc=Adp1HgmRDZqE0edEO-cERbAnKngi_bX388OAf6fY8Vaet-HmxS_Ie-pR6fNXc7PhbA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnLhDHG2v4jhyAOViO4jffigVESdHa96z1MrlkgRmU6Q&oe=6A7320E4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_CCBWuQp3sQ7kNvwFxcu_E&_nc_oc=Adq49Jy3ip7ZfgqUlj5PRQcfgP1NQmS9Y6eC5n-3xfWzZG8BFExHYx5ny-vGmPU9jiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBwjTC9uvP67_tYeJMKpO2nJOoWghEUH5bHeTPG6l8Yw&oe=6A733A7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=437qwh1MC_YQ7kNvwHnGHUf&_nc_oc=AdpUY7QKqiPD0t4HXmxZPEVy9WgxGXoscLp2ssC2erY9Q2eD02ndFg4zOqphKGHTMcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG-gJk1nAij8zHPSveXEwsO4miFoRE4CIO_fR5tJYY4Q&oe=6A732527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
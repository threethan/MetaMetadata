dn.com&_nc_ss=7f20f&oh=00_AQCYuvl9dYDt85Ms3xxYY8Ib7lpAS1lshgmb69FEyx1S1w&oe=6A5F5CD8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-0PYYNVjv8Q7kNvwH5azjF&_nc_oc=AdpCfqq8L5IezeQI00X5oLK8LM7fhnLFVq_bsZQjGMvAMWHzsYEU6rR6B75ppyOTHNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGhnOySPD8hXw56FZQBotEmiqWvgsw_tmS7qHo6h-xNg&oe=6A5F78A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=homrZ_lY0uAQ7kNvwGvi1pb&_nc_oc=Adqkr1qyomZdGXNHZjmx8HNiq1tnVKunZ2ZKf2Jj1rOfw7bA-bCPMvSAOHNoS3LrO0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNFJ71P6Iq30vH2iLdZLoLsZ8yYBCz_spRK6Cd8yydUg&oe=6A5F5A64"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdZ_VaswES8Q7kNvwEoKkTC&_nc_oc=AdrwMAGC3IGc9PmDOz2s_kdYfXXA9DUxZgkkNePjiv_dx5Ac_5zRNtlThQh4ELrsN38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYK-NrNykURFXTpQFswMAMpAPLo0ZBn2B1Q0g5qzurvw&oe=6A5F73FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcFxsCFoB1cQ7kNvwGWk9gJ&_nc_oc=AdoazJIMWtvEMoXjxFTtcCh2P7M1rwABDDi6TDPfDuh4Zi1dtZkgugt_7cKIzlw9-FU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUc2ZgU-2CxL5bB-juG8sSJ92r69KkgGAfmbwbXLn5AA&oe=6A5F5EA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
dn.com&_nc_ss=7f20f&oh=00_AQBkWYjOAnNuPYQt_bzTL-PGhRLOcGhAKj5iSMXYcZOQiw&oe=6A65F458"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQwrj9Z6_ScQ7kNvwFkEKbN&_nc_oc=Adoqy9ePJW6DyDzyiFH6uuMmZsdQbIZmsYbmH8mgT2zy1L3KOkJLOJQ5hQY4GekYJjE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkPHPutRjMvnyeP07fo61cEOEHZM0J8_pB17U9xCtDpg&oe=6A661023"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBFMTWBOktIQ7kNvwE8XW2w&_nc_oc=AdrK4_WOMFG5MOf0WjRy7AvD90lVp6A04hjIlwyFc2DRrr0ez16kxQ7X_yr9UaD20ro&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJfywDNYhF0LZm0zy-vqu5bx8Uxz5NPgxfsjlT4Y-cCg&oe=6A662A24"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXLWcODsL7YQ7kNvwGzJMRx&_nc_oc=Adr3BrgjbVs-8l_IdJyOUHGM5TK7Iv5gp9S8W_e0qMxPyDC7SdC5et3lrUi2B2ntzYw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjjNu_nfWjHfOg86bmb44S65zIDzUMP9JSWf63j0zosg&oe=6A660B7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR8GgBwACyEQ7kNvwHS2E0h&_nc_oc=Adq4XpkGA-appZ9Sp4z5Crdong3dHsOF1E8V2d7u1KfsXDSjNiDL0ezaOwhPWgERlKk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhGTPo64DEzRSt52W3BH1DBkHeaZNelmiY9fGsAOukNA&oe=6A65F627"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
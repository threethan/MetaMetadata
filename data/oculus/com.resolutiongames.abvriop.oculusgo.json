dn.com&_nc_ss=7f20f&oh=00_AQA2YIOzuNyoCGpWpI2V90XjUd_A-R0EghulhdQB1Zkswg&oe=6A61FFD8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzQ9cHWsKzsQ7kNvwEVjqwv&_nc_oc=AdrniPBAJgs9B2bTgvDHokSIToKP_znOFEctgj1BF3H5yA9B8e6hsg-A_kgQmQL33p8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTV9MHpGESEXXytiEOgMepCA4zlmmIrj4Ebvx-6Z7HdQ&oe=6A621BA3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMhkKnOBGDkQ7kNvwEsES7C&_nc_oc=AdpjkPb0YVcN7vcBja52ZFivFrsD55tQQ6MSByZGz0OXUt3s8HwdNvPmMyRfIeyTDFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcXElPnHSbFL5oV4YWaxQOb-LZshOg75vyPg24jWX_DQ&oe=6A61FD64"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdZ_VaswES8Q7kNvwF5HOfx&_nc_oc=AdrxBdwN8KHJh2bGKbbhNJYF7kwSHIoMvhp92I3lZ6jKGTo1danOkCGH5NUJGMq9-qk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwSwJZ43V3w9hC2fZHki9Okv3_APwSnJ51f3hMw6icHA&oe=6A6216FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcFxsCFoB1cQ7kNvwF2C_iO&_nc_oc=AdqYKwVbYeX6jghVrXPH-mbYRLUczkllSn355Dcjl6gARFbYJ8-fgGrAnTxAOqlMJfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRF2TMO6KJEtOpiP1lpYidQ02kDULBzNPcInii41G8yA&oe=6A6201A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
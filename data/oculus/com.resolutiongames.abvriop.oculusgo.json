449", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj-8hv3h0boQ7kNvwHbo8lw&_nc_oc=AdrDYNBBw93xUvkSKXk9I7pHraqyJd6pNurSpi4f615H_ig50wh6W_Y5BaB5O61EBHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLKw67eJAsZbSrNhIUJVejEz9uLImjAIZ6oCgpFLAiaQ&oe=6AEA0024"}, {"file_name": "migrated_image.png", "id": "2949834788371824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqeI8r3XQLYQ7kNvwEIM-60&_nc_oc=Adqa4e0LNIBEloTafYd5xNiNJk2YixA6C25vaDaurdkwvjw3_-dK_pWF5VZ2iz6jVOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQprVlIyI-UZkj5eiF5AADQtJV08odzYe8KoCKYZp1RZw&oe=6AE9E17F"}, {"file_name": "migrated_image.png", "id": "206666960587252", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAYRgcu2P6kQ7kNvwHzC7Ya&_nc_oc=AdowZiWS6y-C6Zsvj6zlwFfDKR5jf6Cr2ddxVscWM3KzLSZkqqg0obKpLeUMLDPP18I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9CFWhN1puaOqYlidVhx--Rcqv_66y-UnJ5UunI_tB8A&oe=6AEA0467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/BGkdlA", "id": "448302755956559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974630_448302759289892_5666675134744756224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BClviKT3ePwQ7kNvwEnN1sU&_nc_oc=AdqMCmxeaRfkX-3UXOWytNe96zo3u_odj-QQMXjdTB0aw-JzQbTiiVuJ5vNirIxoR6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJafCQOLs0rvdJbFkg9xXuKX6o6JlcKOeX9xeYhcD41Q&oe=6AE9EEDE"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
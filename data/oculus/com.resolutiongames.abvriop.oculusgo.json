-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDvv6sAASQ-ds653XrE9ZJnTHT_fP-msna-nSPjRnyzQ&oe=6A859858"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVIk2M0xmpEQ7kNvwG25baJ&_nc_oc=AdpFZGKpR3jRqN9qh9VaYPcDxdnB05CJpLh4_mSDLMmySR21oOZnq4y8KMHRDfTgPas&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU9VEnOmg_2tc6nmuT-5RTuMguVyDagnDFKMsrC-OE-w&oe=6A857BE3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtxT-gGVnAkQ7kNvwHGSPl2&_nc_oc=AdrhKRYD5oMUnmxpAzdXlLtqT8VXKvfhtWwOuybekYMF9ge6p1jS2ieqBrCzIsYfFsI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzQsNizYFis8QzghqogHHR-IwmPz6NmKrs48XkFSXJug&oe=6A8595E4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuA4CsWtvHUQ7kNvwG4UZCL&_nc_oc=AdqV-oIIYOXBizFX7DsSbKJiKoOBXuKFbydVh6MznCX6dAacCXrV8qsJxKKlb7JOZRE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIZDk1zEIM9LcrkUYoK-c_Jqyl8Vwvv0-c5Mvhw0EiNA&oe=6A85AF7F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHV7Z1e-M_gQ7kNvwEzDgCG&_nc_oc=AdpFuQL0tXO-0KDchvoD5HAAL7oCHAMZT6JSwchIz2FnI-YsYuoBb2yVQ0_vZOGnSp0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvYBVw3z-bi6MAehLRoTVy182zxGgs1SFh5nSMB8tBFQ&oe=6A859A27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads
449", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGUDK9nDqkkQ7kNvwGS7srt&_nc_oc=AdpZsEcmCB1mGTHjw4rhcFzxjEI0smdFAdkvMy3-WQcTq4TZDngVYfJKe7XuSvjBqAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvlT-v39VMe-ZnFBAb1TGStMOPPRDRPj6QS8Rl2Kdq8A&oe=6A844464"}, {"file_name": "migrated_image.png", "id": "2949834788371824", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuA4CsWtvHUQ7kNvwHRGEw6&_nc_oc=AdpiPHYlc0dcGEux9u8pKX-rsqFp1JjAnW4uW86fiGVnj9k-OGc73kylKip9qwf1MGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoVdxIZspXPZty0uOshESFJNcwRVkzIKpm5vkAzipglw&oe=6A845DFF"}, {"file_name": "migrated_image.png", "id": "206666960587252", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHV7Z1e-M_gQ7kNvwHXLogE&_nc_oc=Adojn_Vdxro3RFwWQPhefsk4f5XhROH7I2TImtpKuBKWS24tcVFjzAy43x4V2pgjCkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBZSgguNY8lsZRnErQ3G0TpLVLZrr3lrE4K_-iY8wFqQ&oe=6A8448A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/BGkdlA", "id": "448302755956559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974630_448302759289892_5666675134744756224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS3WXNlgWdIQ7kNvwGxtkr4&_nc_oc=AdrEGHOMfWBIq2mC3qEBYCK-Lw9U_Wfepdj0MIiebalpWFOJecni1VUZPmlZviZfg7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5SM_8K4N2NmkbiH998ew6i6dTKH3yZkO8iPEXNPAfmA&oe=6A84331E"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
dn.com&_nc_ss=7f20f&oh=00_AQMBNewe3eGzrcx6nqTfBgjIbrC-tRJpiunR4padRPpt3w&oe=6ACD0198"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrK9KZGRdNUQ7kNvwGTfn6Y&_nc_oc=AdrLojWQlTyY3wprDiSS_GQtLPLpK4Amf2XCj9nM_1XbvSOM7VIfGrGRP5p_Qf-AGZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWEIdoiBhYu2nU8aie0SaheTKFxki6QmdJIa9tfE_KCA&oe=6ACCE523"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FizzSNFAhJ4Q7kNvwGxt-pq&_nc_oc=AdqPu6FoibiBDbTB5QZn0plPhyD5Rpnu8781DjQ6qIbmJdFy9ZeIvrLDo4laKXngNUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO0b1rhrl3ocqaaiQW8yGC6nG1DyNL14UPlkuBtbsy4A&oe=6ACCFF24"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IipIly9Z3GwQ7kNvwEfRLFz&_nc_oc=AdoHK5ZkHlaOXnrwX3HgI99DXaEp8K5Jh6vlpJG6tQlD5YX1BQfIS1Gdv8vVD26iEnE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXPrBGV-mY3nZ8LvRHFbhY5e-1yHZxEztXhQBn1CBe_g&oe=6ACCE07F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQWUsmi6qFwQ7kNvwFLW7DU&_nc_oc=Adrm3veIrbPyhI-uytlClT8xqiWFiAFpxNTj_qlBlMlXaG7b79GBfkL514IvqTMe9jM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtDiKL_qhkJFu5ezkJJqTPPUyMg6sbSnq8onettlYGRQ&oe=6ACD0367"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
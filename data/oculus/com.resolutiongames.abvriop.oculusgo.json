dn.com&_nc_ss=7f20f&oh=00_AQJ3NO1wMJjusESuZ4cr2lgX3-dMQsVex1Z3Sv53EJDVSQ&oe=6AA57498"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QZ9uSCatwkQ7kNvwGgbTGv&_nc_oc=Adqyf0r-gZ_SNTmg7gwTomMwP64zpqF2PmH2wEpQ401E1Cns4y1qk3Cl-ecc9I1By0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAr39hlbdDzdNBh6qK_H5wIdBreHRXSciDrPdE72XNYA&oe=6AA55823"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBYrcwsJIekQ7kNvwGh76My&_nc_oc=Adq4qfkjE-UMrlxckhHB1Lu2vjWfED-aqIktHM0fzOhFuKl6p66NaPmT531_AWPuB4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIqdI5qO_rmllXPHAelpJqaliRgB9JhMY5YxRsTaG8Ag&oe=6AA57224"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB2NXE6YASMQ7kNvwFVIvXn&_nc_oc=AdrJ79gv-S5su-yJfm6u8queeeLXmeu4wlM3ekJ4ZpgLLQNDR--x6XIuHd3SFBa7YzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILEc9quRc2H9cT_yLiG4JofKos9bSBejb3R8vKHDcEHQ&oe=6AA5537F"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNN-trzbcmwQ7kNvwFcpEZP&_nc_oc=AdoiUCpQkHF325OaGgiGZyiuXRl5vDdBIKW2nmOfjx95lxCj44JpnHqmpa-abawBceo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzxhf46CTExbH_XA3siVOhpaEPVqxKX4XD02w74SraqA&oe=6AA57667"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
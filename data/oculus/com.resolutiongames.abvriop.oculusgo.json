dn.com&_nc_ss=7f20f&oh=00_AQH0p-plTATgC4sxQYmzT06FanyfOfv9HgmB_0t0gFzQ_w&oe=6A79BAD8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kKwcpWX8_MQ7kNvwHkuhH8&_nc_oc=AdplNeqVJyNoj9fuwFYw43ywsaaQbdLfMBsNxQCIDPGv1Y8_gi6nd6GxsvtBxaysz6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE98RtIcj_FZcRdBUgxPzfEdi1yGZdwsqGCEs7jORS2qQ&oe=6A79D6A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBqHn_kqm0EQ7kNvwEm6NkF&_nc_oc=AdoYJsZdEvj1-fEmcPOJNnNxsgJ-UtvMrNCqkS3P2arDQzjQmyvgJjiYK03apkg6m7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpnF-LH2GoT6sR79ME7WxISXbwCmFEClubwWgjHT9r6w&oe=6A79B864"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbiLnc0zzhAQ7kNvwEsy8US&_nc_oc=Ado1YuEZ27hTOTc3jWqcmML8kZY3mwwPZvx30ZMaHBLlwD6R4vYeFhR8RnvRWg5gpig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG63wbCZBJf3yOt9BNb_Y-EIYF9RC-8FbpbQPcsy4CG-Q&oe=6A79D1FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHv349N2gFcQ7kNvwHidCt3&_nc_oc=Adp_wiDgzyEv0ASevBiALU5MkRrNTXac5lbAueOlqrqFTF3yH0qoe7SkTekV55oTAOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOgBJoukTy1WcRFzYImV5dO5POQZqe1qn_rxxsNuCNbA&oe=6A79BCA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
dn.com&_nc_ss=7f20f&oh=00_AQBsCOq2to5qwflR6aGG8uC5NpKZsOnkH_qaKipW1rY6JA&oe=6A526618"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VBJ-9oVkYAQ7kNvwGxjd68&_nc_oc=AdoXmcDN8ySyP2W0nKdB4SyYejFE5y3n5C5Gf4S0prv0m1yU2spwZrEeYl2SNtc5CQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Bgkzb_cRpS6fnPCiLj3FhdAofQTnBPjV5WoUBAK4rA&oe=6A5249A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKnmZKTBky4Q7kNvwHFEKW3&_nc_oc=AdrvE1ZG8YKLMo2glKGiql9exBFX80F8y2EohxbZwhNtjpUJqVgQCI1aB4J4Ib7Bbhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo8Yc65dcI9uF2JCmB16mQaW6eaS2KO97Ax_0TeiX7aA&oe=6A5263A4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfASwSqHGpcQ7kNvwFWn-cC&_nc_oc=AdrkkYOLJEOhIpZw_oQaI_4kZTxa5npSMQbtTjJi2Aq4OcYae7IWXtp_z-BEGIHTtTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAohg6lFW7qnui7SXf7h-ik_oiAL-UjN0rA03O_f6-A4w&oe=6A5244FF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ9OEVajzeEQ7kNvwGyLHwd&_nc_oc=AdojBxZt2oFqQ1qFewSK8XnM9GtyFKNhQ3bReNFQnnKETftlzs3_9lwT-P0SU7j97xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuIS027yTYL8_aiHCAjEdminP_oOof5JqaQ7nWrNJENg&oe=6A5267E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
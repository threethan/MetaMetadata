dn.com&_nc_ss=7f20f&oh=00_AQI-W2wIYmhZQ-T_O-fj7ILAKhDrvo6RciWL7aSZUPJjhQ&oe=6AA147D8"}, {"file_name": "migrated_image.png", "id": "650105325561375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031456_388391822030572_7665327694808088576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceagA37EGUEQ7kNvwH5YKyS&_nc_oc=AdpDrA7LFpDfJRmX5VgZeqZrvpD_KAtqzIdn8Ev_db20xEEuRjMJIJCW41mRjyHK5PY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUgxdI4GxVNFY1Q4UUAmJX5tSfOcQiSxuxXUFQtItILg&oe=6AA163A3"}, {"file_name": "migrated_image.png", "id": "554997101777179", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_azrOXouooQ7kNvwFLcPfq&_nc_oc=Adq5cZEA6i4vvUX0EpYrY9F13mULRMtvhCOi6S0grndyZvC6Ye-wzt65URbzrCNAuSc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt_ecLfmgD1I0V2j-YZtUy25CWmuVD-chFQ-uH0Dy3ZA&oe=6AA17DA4"}, {"file_name": "migrated_image.png", "id": "512815216099867", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1MEp-5v6u4Q7kNvwHiJPgj&_nc_oc=AdqJcn7jDzqC4r1RgBDtwbwdGvfwh2Ilr5OZGosl0-bQg4TgrVoQ2YxzQTqMWacvllU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbgn-gExY6L-6SsAi-Wy65DRGEXnf_YP78yu0o3C3JsA&oe=6AA15EFF"}, {"file_name": "migrated_image.png", "id": "662656904536598", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvW41TqtoUkQ7kNvwFQzbJM&_nc_oc=AdrC6KJlzexXP44IhUfiooPLByFsxSq3FNeysa2f44lq7VCrNv5dkKgy6pA-U9rwACs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_mcSMU8DpXp0_kDFxmS9Ww9pSSrMWoK-nx5YedKW9Ug&oe=6AA149A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "inte
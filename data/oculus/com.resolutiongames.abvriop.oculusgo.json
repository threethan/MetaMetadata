449", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974553_681780725567157_7788089035632672768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qnae89cjMkQ7kNvwGVZc2k&_nc_oc=AdpHbt7QWf-191ToC0vuJhH-oZZKT8Rqt9S7SpQJgDGWq8KbhaxNUfCwYwbWN8pcZCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUuCDEAgHtktHeJBsHF_YyvTNQsCGmEDXOTSuYzzzmag&oe=6AC27324"}, {"file_name": "migrated_image.png", "id": "2949834788371824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974495_385212442114202_5687870347378950144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LABs7sOAxHIQ7kNvwGa5psJ&_nc_oc=AdriJd29Saigp2x96UNAAOrpKFfx4pg1uKcfLxP4wczRbIhh1pUCh9s0b0zU20Dplw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYjDy4fBUe4Dmx4jufvccWONrXLZ_4lvshHuoPMr5yEA&oe=6AC2547F"}, {"file_name": "migrated_image.png", "id": "206666960587252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_610408216032643_2886481776853647360_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhGiY3ygAVEQ7kNvwFO21bX&_nc_oc=Ado4e62gIevZxF3ovb6LSQOKb9CgSQyym0LmYajSQfxJMo2u5QGnPlhEuWALVNyo5do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyBwRIKfs0_PkXcRgKyP9I824sJoSy2K9lPrPObZ6Lng&oe=6AC27767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/BGkdlA", "id": "448302755956559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974630_448302759289892_5666675134744756224_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAdYKG5GtfgQ7kNvwFs8zyK&_nc_oc=Ado3m90hLE9QtYk_N3JFMSKoF9XuaZjUVpU0Z1kd1kKVgkWP0EJpxEVVe4dDsfT5CQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGKLoYiIgvYknzqL8KgGWnhGm5Rstt9Ii2CyF0GZNLfg&oe=6AC261DE"}, "display_name": "Angry Birds VR: Isle of Pigs", "keywords": ["Angry", "Birds", "Pigs", "Isle", "resolution"], "long_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! \n\nExplore the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels (and more to come!) Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars.\n\nChoose from different angles to make your slingshot, using classic Angry Birds gameplay elements to progress and strive for the best possible score. Tough boss pigs, balloons, boulders and fans make each level a challenging puzzle in its own right. And using the bird\u2019s special skills - like Chuck\u2019s super speed or Bomb\u2019s explosive power - will help you earn maximum points.\n\nStay tuned for more levels. The adventure starts here!", "short_description": "Join Red, Chuck, Bomb and the Blues to save the stolen eggs in Angry Birds VR: Isle of Pigs, an immersive VR adventure! Discover the remote island where the greedy green pigs take their vacation in 50+ fun-filled levels - with more to come! Make your way up to party city through exotic beaches, steep cliffs and snowy slopes, destroying their structures in the most spectacular way to earn those all-important stars. The adventure starts here!"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/angry-birds-vr-isle-of-pigs", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
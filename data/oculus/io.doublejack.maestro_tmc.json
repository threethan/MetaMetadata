nc_oc=AdkIj7RYY6qq2vPwqFt4dwm7tNXsE9nW-UokypE0y0Y42z6A12_h_xjRkBuAMDxYEyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8fk82jIF7S2a5hI5GlwtfVhfcC3GTfiFNL69IGxXPJQ&oe=69A053A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "5224521377585105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_5224521380918438_3554792086355919042_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edER-sFScR4Q7kNvwHtRtSW&_nc_oc=AdlYXhkXabgPo5e4YRbM6Q4UUIUhiWzwjSUnNJFrv2EgfHlqFVp2U4SZ0HzXMrpClls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuluRztD0e6j4Ffyw0J36QeYMIQqBg5SISptYBJa-ayRg&oe=69A034A3"}, "display_name": "Maestro: The Masterclass", "keywords": [], "long_description": "Step on the podium and become a true orchestra conductor in Maestro: The Masterclass. Play hands free or grab a chopstick and master the real hands motions that command the orchestra through an off the rail conducting masterclass that culminates with an epic symphonic concert in a packed opera house. Good luck, Maestro!\n\n- Step into a gorgeous opera house packed with a thousand music fans, face a mammoth orchestra of over two hundred virtuosos, and get ready to throw some serious power moves.\n- Learn to beat tempo, cue musicians or guide crescendos with the power of your hands only\n- Conduct all music genres from Electro to Jazz, Hip Hop and finish up with an epic Symphonic music concert to become a true Maestro!", "short_description": "Step on the podium and become a true orchestra conductor in Maestro: The Masterclass. Play hands free or grab a chopstick and master the real hands motions that command the orchestra through an off the rail conducting masterclass that culminates with an epic symphonic concert in a packed opera house. Good luck, Maestro!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQchKcAJz15RJwRzoOYKTPM2xqzk_3USAS7mSXQVI63k8zBRTkP6BVlRifGdSjSa5ALGtGgQmQ
ults": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1729853377, "id": "8191600124279296", "version": "0.0.213", "version_code": 213, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "426610022635003"}]}, "change_log": "Maestri! \ud83c\udf93\u200b\n\nWe are delighted to announce the release of a new free update!\nWe want to make Culture accessible to everyone, so we have added the option to make the experience fully playable with controllers!\u200b\n\nConcert\n- Updated gameplay score for Verdi - Dies Irae.\n \nSubtitles\n- Added subtitles for the Masterclass and translations for all 10 languages\n- Subtitles can be toggled from the main menu\n \nLocalization\n- Translation fixes in various languages\n- More content was localised (ie: end of concert quotes, game logo)\n\nController support\n- You can now play Maestro: The Masterclass with controllers, and haptics!\n- General bug fixing & improvements\n- Improved audio issue that could cause severe latencies\n- Tweaks to audio effects\n- Tweaks to improve performance\n", "created_date": 1706190432, "id": "6741777065928283", "version": "0.0.212", "version_code": 212, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
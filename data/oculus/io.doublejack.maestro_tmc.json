8335820978782_4282314951259127723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBaVrHNokr4Q7kNvwHDDEc7&_nc_oc=AdmQfgvUoyEB3zqNt5Sy1z4jLlvsvJE9zx99OaM_4vGo3NyAZP3kLBS8a8xRO9mw6jU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBkqbYJ8KBuh4jc2MBzDfT9mI4McCjZRF2kyIZF2EygA&oe=69AD82A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "5224521377585105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_5224521380918438_3554792086355919042_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCojKEgBb2kQ7kNvwF_TCJE&_nc_oc=Adk4fnPULUbE-qyCqToHx0dPuJF_VKHssW0oiPwI2xIWZH4p5dNNUgU6xckQoyCOdnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWfh-S4JbTGkWUQ97dD1zyYYom9ut3voaxPi3r52oHdQ&oe=69AD63A3"}, "display_name": "Maestro: The Masterclass", "keywords": [], "long_description": "Step on the podium and become a true orchestra conductor in Maestro: The Masterclass. Play hands free or grab a chopstick and master the real hands motions that command the orchestra through an off the rail conducting masterclass that culminates with an epic symphonic concert in a packed opera house. Good luck, Maestro!\n\n- Step into a gorgeous opera house packed with a thousand music fans, face a mammoth orchestra of over two hundred virtuosos, and get ready to throw some serious power moves.\n- Learn to beat tempo, cue musicians or guide crescendos with the power of your hands only\n- Conduct all music genres from Electro to Jazz, Hip Hop and finish up with an epic Symphonic music concert to become a true Maestro!", "short_description": "Step on the podium and become a true orchestra conductor in Maestro: The Masterclass. Play hands free or grab a chopstick and master the real hands motions that command the orchestra through an off the rail conducting masterclass that culminates with an epic symphonic concert in a packed opera house. Good luck, Maestro!"}]}, "developer_name": null, "developer_privacy_policy
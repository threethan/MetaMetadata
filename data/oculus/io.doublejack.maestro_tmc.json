-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_1198335820978782_4282314951259127723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36VbgYzwfjoQ7kNvwGBkvV8&_nc_oc=AdrnjjMvxtYWLRefpTwGOSZkuvGiTqIYl4uy48tohk7bsrEhz5zratS5WI0t06bPwVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2KCCUPehNCG75SB3UhcywWeu2sL2dwSGynUmLjHCLCA&oe=69C93224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover.png", "id": "5224521377585105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_5224521380918438_3554792086355919042_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFB-mxvdA8AQ7kNvwEtMkMS&_nc_oc=Adp9NsnQ5ngvSWcdeqKsicLtw7UgQbDD_il9FFHGRvoAx4tJmNx6O9uQYxOkeCT_tl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmolLh5l9gw3YvKXMsD329wDxTorZ1bvQK4QbUxQlwUg&oe=69C91323"}, "display_name": "Maestro: The Masterclass", "keywords": [], "long_description": "Step on the podium and become a true orchestra conductor in Maestro: The Masterclass. Play hands free or grab a chopstick and master the real hands motions that command the orchestra through an off the rail conducting masterclass that culminates with an epic symphonic concert in a packed opera house. Good luck, Maestro!\n\n- Step into a gorgeous opera house packed with a thousand music fans, face a mammoth orchestra of over two hundred virtuosos, and get ready to throw some serious power moves.\n- Learn to beat tempo, cue musicians or guide crescendos with the power of your hands only\n- Conduct all music genres from Electro to Jazz, Hip Hop and finish up with an epic Symphonic music concert to become a true Maestro!", "short_description": "Step on the podium and become a true orchestra conductor in Maestro: The Masterclass. Play hands free or grab a chopstick and master the real hands motions that command the orchestra through an off the rail conducting masterclass that culminates with an epic symphonic concert in a packed opera house. Good luck, Maestro!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQchKcAJz15RJwRzoOYKTPM2xqzk_3USAS7mSXQVI63k8zBRTkP6BVlRifGdSjSa5ALGtGgQmQYRWck/pub", "developer_terms_of_service_url": null, "publisher_name": "Double Jack", "support_website_url": null, "website_url": "https://maestro-game.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "748704793107144"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1235871638305182"}, {"status": "PUBLISHED", "id": "461509242157906"}]}, "baseline_offer": {"id": "1235871638305182"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749118680, "status": "PUBLISHED", "id": "1235871638305182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8312537308852243", "version": "0.0.215"}, "id": "426610022635003", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "426610022635003"}]}, "change_log": null, "created_date": 1731682150, "id": "8312537308852243", "version": "0.0.215", "version_code": 215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "426610022635003"}]}, "change_log": null, "created_date": 1729861484, "id": "8192215820884393", "version": "0.0.214", "version_code": 214, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1729853377, "id": "8191600124279296", "version": "0.0.213", "version_code": 213, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "426610022635003"}]}, "change_log": "Maestri! \ud83c\udf93\u200b\n\nWe are delighted to announce the release of a new free update!\nWe want to make Culture accessible to everyone, so we have added the option to make the experience fully playable with controllers!\u200b\n\nConcert\n- Updated gameplay score for Verdi - Dies Irae.\n \nSubtitles\n- Added subtitles for the Masterclass and translations for all 10 languages\n- Subtitles can be toggled from the main menu\n \nLocalization\n- Translation fixes in various languages\n- More content was localised (ie: end of concert quotes, game logo)\n\nController support\n- You can now play Maestro: The Masterclass with controllers, and haptics!\n- General bug fixing & improvements\n- Improved audio issue that could cause severe latencies\n- Tweaks to audio effects\n- Tweaks to improve performance\n", "created_date": 1706190432, "id": "6741777065928283", "version": "0.0.212", "version_code": 212, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4813149252124417", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8312537308852243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1704906643, "id": "6687589104680413", "version": "0.0.211", "version_code": 211, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ttps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499626636_705754639266299_1775345576266690861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHtHaU-1tk0Q7kNvwEXuSrH&_nc_oc=AdpPImlsM_D93EZ6Xwju6DdP98EUj00eALeOGCSCkvuNZF5kv0tVRRd8GTp5iDHsDzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2u6ftLnMserYRLomGZRjR5qTxMFRlz79-zhRadKV3WUQ&oe=69F89301"}, {"file_name": "Fudgerz3.png", "id": "2198171077585624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_2198171084252290_3740107234794837213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQTKaDiq2gIQ7kNvwHMK_UO&_nc_oc=AdpTGbtWyo91pou9QzBnZzlJBYuBf6aOVNGvXGjgAVaZOO3Q1mJfXWQETkySU-MQw1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2z9HM5bZyl5Jox0bsi2nIMJEuQ2JoHa4wjBw8SW8wYnA&oe=69F89199"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpuyGsMCJLQQ7kNvwFMPfpl&_nc_oc=Adqw5BNYgvkIW8u0RmaxSoloLtKf3gYk25r66xUOfh8Hh_q30ln6DlmoJxM64PyKaJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JNyipk6imQvrpWaPXJmlH7MAV2LzDz46fLU10Fu2CUA&oe=69F88FB8"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBy8oZOY_4QQ7kNvwH4pNEe&_nc_oc=AdrKffo2pGs35SO1aQdPuVHWhRDKlp9jSKVlBvDneX5UM3KN4zfqLWZOPsGFGTpHq94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31g5iZFJn17yXxUIauLX2XfldFaeFHOz6Yv_HZf3OlLg&oe=69F8967C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
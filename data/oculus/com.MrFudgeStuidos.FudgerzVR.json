nt-atl3-2.oculuscdn.com/v/t64.5771-25/499626636_705754639266299_1775345576266690861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nra6KYZmPLAQ7kNvwGG0FnO&_nc_oc=AdpsqRhd_OOYxucglHZbgssm7m1WXKb-ls3mztRgFTOwkkrYVt4K2p2K85UfnJrO9Y4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af39Jq1FjSAFBtxzzrtzyfE0Qn6ebVhCp9E4JsvSdp5-nQ&oe=69F1FB81"}, {"file_name": "Fudgerz3.png", "id": "2198171077585624", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824307_2198171084252290_3740107234794837213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meDd6i3pwVQQ7kNvwFkbI9m&_nc_oc=Adp7ZyplUQx1DkT9CHi6Fj5yxRdAU7xV0eznwzseK-24wVtM9tB-bMcPsfvFsxZ9eR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af13yJPMIewLrQxmez3S5UUxyY1OQNJanztn9OEXOLSCdQ&oe=69F1FA19"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqlEf2VgFDwQ7kNvwHqn8Kd&_nc_oc=AdqnEqg82wl_Yz5Ny_6G5AM-kFsVKSxHAUzb3leBCqRfH5HfddVYYKH68BtSNlXvn5g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c_AMAGMPoYziT3xR5XWZtvWSwPYV1HR6Ff_Nt2MsOjg&oe=69F1F838"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKIJ29SjQkkQ7kNvwFf2qrU&_nc_oc=Adq_jYFtVEPlNQrDzR9ynXioBJWqECIhJtprazDcX92j8hat6WCnpatH6BrJIVwOwa0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2I-uzkGQBo-i-LYx1-qI8mMAgjuU8K4vkiEu_uB8-X8g&oe=69F1FEFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "
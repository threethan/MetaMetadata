ttps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499626636_705754639266299_1775345576266690861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pI85wVdTCAQ7kNvwGfiY2l&_nc_oc=AdpFVB7E9yz2rVSBTYDGE9eEDJDOjzok-1qnfMRAwY49mHaYqoaK9LcUm_gzA6aQba4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h8JERfHQXj48PCoFrXodjXpzBlQK2vSQsfSXCzDi8Cg&oe=69FDD901"}, {"file_name": "Fudgerz3.png", "id": "2198171077585624", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824307_2198171084252290_3740107234794837213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXCPof3V91YQ7kNvwFWotfg&_nc_oc=AdruYxbJYQkFq-x9sk0x4QHVrNHijsNcq4isXCYyLGw3bQjMq9PEgOirpo8gww8Ti4M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4natYUjq_p9kzzN1dVh69kscUoCXEcNfuOlv1fqbYj3w&oe=69FDD799"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVYXqheBWHEQ7kNvwFjgqGU&_nc_oc=AdqoZ_Eyr9x5hGwRXmOdntNXGQKWGEEul5VhFjvRcrMvwXnf3nW2BGneVHUt5PtPZkI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NkGDZMQCC3eHREp72bgnPullBLlfs-_b92xQOBrnEGA&oe=69FDD5B8"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esJKlj6nt8UQ7kNvwEwo6Z7&_nc_oc=Adr40LWcelOGSfq7T1gZHdVG76UuVdGrobCEQWPZ_CcepHmV0ioHaHkVrz3RBcF0sQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WzQth0HxgwMwamQH597paAgioj_Z45KzH6c9IuwFYmg&oe=69FDDC7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
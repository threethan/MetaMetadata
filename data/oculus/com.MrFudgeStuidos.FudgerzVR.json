=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ6bUEa6SdMQ7kNvwF728hz&_nc_oc=AdosPdk9vQq8FtKn_DRUwaqBMYyMF6WYUUsNsRihiG7QYBzYQSVQ_VPRf7qDvZm_-u4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTINucSks-PHyN15-58MR4jeQWRq6KnY0S_weH4VCszfg&oe=6AEB5DD9"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB0t2h-MUCoQ7kNvwH_9s2X&_nc_oc=AdogPxsKqB2vkjGUY0TOi7jQLrHT5E-awYL3x2XhCtqR9ElOtgTEnJLZCCp7zYt0e3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuynZzRKb2SOd73V-SP12ef-5eFndHGpNZ0YYB5gHQEQ&oe=6AEB5BF8"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5z8udXrEA4Q7kNvwFllbQO&_nc_oc=AdpU3gC5BT1No_rFK4lizsR8M2MNqWUG0dGA2RwSL-oVTQXqVBjq5LVOC9JKqbicbDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIT67pbuJlm0MErDdeocCve_JO2F7hw6_zaQHXec8kKA&oe=6AEB62BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35081845318098053"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1642475136806955"}]}, "baseline_offer": {"id": "1642475136806955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776111660, "status": "PUBLISHED", "id": "1642475136806955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "
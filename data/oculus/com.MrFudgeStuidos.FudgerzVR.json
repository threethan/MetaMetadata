=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOavs-1kNTkQ7kNvwFlZGGt&_nc_oc=AdoUu2_YO-lVuhv_8KQVyU8RDH3LXwkgYDFWZMzESP-Bv_Md4q3d3YdXAGeDNKf56oA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoiU3sOw3QtiR2v5X96dlnIsmYK1eDnZPK0RWKHmdsxA&oe=6AF88CD9"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRZEb_uTkSoQ7kNvwH7ErV9&_nc_oc=AdpXUZi1QpH2Etby2H0cZV-VwaN0qjZ1LV4Mx1TF7gLblGTlKuxQs394ilPhPiYiKw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROgm-OctTiKbpEsJsfq6xezRn9SlK6mkoOESD_kNQznA&oe=6AF88AF8"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwB1pi7Y4-gQ7kNvwH87Lec&_nc_oc=AdpxLIILDPCq1bPYklJfSc3L2bFTX3yge2rjf_jbasHioyBPRYe2R-yGCRcN-KaonWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHF41Fvu3iIQ-6QFeeY0aoAj5Xf72NfC3hsekgf3vi4g&oe=6AF891BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35081845318098053"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1642475136806955"}]}, "baseline_offer": {"id": "1642475136806955"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776111660, "status": "PUBLISHED", "id": "1642475136806955"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "
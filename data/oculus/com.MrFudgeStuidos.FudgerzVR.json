90861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nra6KYZmPLAQ7kNvwGj_lAa&_nc_oc=AdqHJPBO-2F8LHwsZSc12O8gnAn_e5Nig6ceIr8GDX78ShOSCTO_J0Vcheq2xV3nHLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3d4SBfrMt_4S4Ao_Fmyor_ZYN38YlGfwyHIfJQjk1wBA&oe=69F0AA01"}, {"file_name": "Fudgerz3.png", "id": "2198171077585624", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_2198171084252290_3740107234794837213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD3V0Aolf6MQ7kNvwGX-X63&_nc_oc=AdqK6LCn5n5MyjxWPTPxT5WUMuGa4f-rF3h3rDAidze6r5zvE9TLXnHwo3qPkQ99E6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2jvBBPMq_oF2cqDtKd55UL3tDKga9SLsyb1ftyiYQmZg&oe=69F0A899"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqlEf2VgFDwQ7kNvwGKEx6T&_nc_oc=AdokVSyBbFKcdkvC09E0W-r8bTJaqNSDgourLF6BiUudImq3U2-DGQD0QEOFhVciAWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1evOgC9fl37VTmRgKD8cQqxL0ajIUZzES4OlrTzjgi4Q&oe=69F0A6B8"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKIJ29SjQkkQ7kNvwH_QzQt&_nc_oc=AdoUaIqdClaOPIWEU0oLijrFJEVJXwCzHcj2saGSKZYtQCBjrf84EqMyDgzFwFE1YkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2SoXAx8av47Om9aCafGUSjKkSytvXKl9-SD3PaaKlDhg&oe=69F0AD7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35081845318
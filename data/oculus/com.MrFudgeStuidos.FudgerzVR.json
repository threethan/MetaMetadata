ttps://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499626636_705754639266299_1775345576266690861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AfvC9gzTu0Q7kNvwENncag&_nc_oc=AdoIf_Sc7J8XPEoe-XnjxXc90zhC8V8fZsX4ui0l3cydhzMjNgpY1EmzaU8rHXPmcGg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3To53kZzpVpUwMggPTfGLv3zIctCkRTr3Z59wMx7UZEg&oe=69F5F001"}, {"file_name": "Fudgerz3.png", "id": "2198171077585624", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824307_2198171084252290_3740107234794837213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQTKaDiq2gIQ7kNvwFpEL-4&_nc_oc=AdrEgD7bMlExwyaYwoXOJkPBryv1Vt5Yz6uHmCGT9RPXEwfI7m8LAYfpEjXAAmVtiBE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bRk1jQ8aAN5GGP7aNu39oZ-lGp8GSUYZaJmMCPSPhww&oe=69F5EE99"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJsqRgxxlJsQ7kNvwF2VfAx&_nc_oc=Adrm9Y_dPiRB5TTX2QR-yW8RwjLwWIefnkiTieddXcOWYLhSyt0Y17HV_NTjELl4AMo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_pHTx_1kq2db10fS03H8yASVqrlfVRaFgYze-alszMg&oe=69F5ECB8"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7MWvAxnTNEQ7kNvwHXDeOU&_nc_oc=AdqcpYJz-1IRJynJUv1reIMSI3mkr2Kke3hadQsHQM4FbE7-nemauppem0DblUg_akc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kCnyy3RswtjTrBKG2klIPEfDKJ2NK6gFnZQczi6HGdQ&oe=69F5F37C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
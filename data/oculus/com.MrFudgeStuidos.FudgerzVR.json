ttps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499626636_705754639266299_1775345576266690861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AfvC9gzTu0Q7kNvwF0xSoK&_nc_oc=AdpFLE0tk6G22zFa9dOgPmTOCFqU-KJmcq-3SYpdZg9UZwKtdNBkChqJupyKWXRVS3A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QP44XBnd1iL7OtNjT33WB0n9zNq1P5RvzBS2dJEPb3A&oe=69F49E81"}, {"file_name": "Fudgerz3.png", "id": "2198171077585624", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824307_2198171084252290_3740107234794837213_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meDd6i3pwVQQ7kNvwF-jJ3N&_nc_oc=Adoq2G9UA4MLplFLLTB7hlJ1hrq1ZbjRid0tq1oAAVcRnTxN0XiOnCpvD-1KET5gwKs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HLpsmNvuImQu8dAuv_hUgazupHOuBj2KNkleO7L4G3Q&oe=69F49D19"}, {"file_name": "Fudgerz4.png", "id": "947630868131809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821782_947630871465142_443083352016514584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJsqRgxxlJsQ7kNvwGodatp&_nc_oc=AdqzFvDyFXJ4BKv6lX0YJDMFYAvEIy2kbhkeWr4j3PsI34Y70AYp7cWXjfFu8VGtUS4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0X8ueanFoipf6i6HFPdRlK3vkmTLzbibqiElP8cZt8uw&oe=69F49B38"}, {"file_name": "Fudgerz5.png", "id": "2424686007944913", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818860_2424686014611579_8984537087583653104_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7MWvAxnTNEQ7kNvwH0v6bd&_nc_oc=AdrSKCUyMt_vYE3EqPKveUQJ32_MmDv15-KNApO4Ay2h7Uhc4r6Hx5yPMRGfTZzfSgk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2x-OjwgEmsc1UxE91OFlaqfGpI8ZnLb4LKyi5TPiOWIA&oe=69F4A1FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fudgerz", "keywords": ["fudgerz", "mrfudge"], "long_description": "Fudgerz is a fast\u2011paced, fan\u2011developed VR experience inspired by Gorilla Tag, built for players who love energetic movement, expressive interactions, and immersive social gameplay. The game focuses on smooth, physics\u2011based locomotion that lets you run, climb, vault, and explore using only your hands, creating a uniquely active and engaging style of play.\n\nEvery map and mechanic is crafted to encourage creativity and replayability, whether you\u2019re mastering routes, racing friends, or discovering new ways to move through the environment. Fudgerz aims to capture the excitement and freedom of movement\u2011driven VR while adding its own charm, atmosphere, and community\u2011focused design.\n\nThe game is designed to be fun, accessible, and constantly evolving, offering players a lively world to explore and enjoy together. As a fan project, Fudgerz celebrates what makes movement\u2011based VR special while delivering a fresh, enjoyable experience for both new and returning players.\n\nCreated by @MrFudge\u2011YT \u2014 search the name on YouTube to follow updates, devlogs, and future content.", "short_description": "Fudgerz is an awesome fan-made game inspired by Gorilla Tag, offering a fun and exciting experience for players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FVVppaDQe5cRxY-9W-oAZLHH5IvNlSeT3G8PjmhbAg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MrFudgeYT", "support_website_url": null, "website_url": "https://www.youtube.com/@MrFudge-YT", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
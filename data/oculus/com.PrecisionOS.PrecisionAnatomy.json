_ncwEeWmOSmxkXy2AMYW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftB3R0BdsRwCyJ9gUictjwx726suLeRlOFY3mcgKWSUiA&oe=699AEAEA"}, {"file_name": "MetaScreen_0001_Layer-3.png", "id": "864200262333096", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036657_864200265666429_6313634239333222300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB0FUUKhZAoQ7kNvwHnepzY&_nc_oc=Adm3AzqW-zrcQy82LTiBJWsjvmN3f79sdJK-iTMSUfkYYQ-cqGqLmErL9eO9xBRaRVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuZln1QVMSA94Lfm1CUefvyBEBPU21yfYXgjKKb9FSWSA&oe=699B1264"}, {"file_name": "MetaScreen_0002_Layer-5.png", "id": "1190633428839444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031544_1190633432172777_526839017652229245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQXF4oN-VWwQ7kNvwHJuYUH&_nc_oc=AdnNEkFYzei3Yk9-kKC2hugJMBhjB3YrNK4lxzW0MBsRYJKaX-Eb1KIG_gUflxLv05U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afscaw07kz7yjg38riynbU7aJ4rJEEuiTjjtyRuPitP9VA&oe=699B1230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1480550985787828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031626_1480550989121161_7431607364599380139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7agvX4XTP54Q7kNvwEnJHbO&_nc_oc=AdnC2k6lpHEhsVPz-zlFC2rbMoreUok9-5YwmMzs9DH1tF0KsA3NLsHBuxMlk2M61l0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfudfJD6fvPoWB0nDqlMv3Lb-V_amFhqY9ayG2X2tOzWwg&oe=699AEA23"}, "display_name": "BodyWorks", "keywords": ["anatomy", "Body", "health", "medical", "education"], "long_description": "CREATE. EDUCATE. LEARN. SHARE - A virtual reality anatomy studio. \n\nDiscover a revolutionary virtual reality anatomy studio. Explain complex anatomy in minutes with simple, high-impact videos. \n\nBodyWorks is not a game.  It is a powerful tool for educators, healthcare providers, and content creators.\n\n- Learn faster\n- Simplify concepts for learners and patients\n- Visualize concepts and structures \n- Stand out in your class \n- Build confidence for the OR\n\n7 Day Free Trial!  Subscription required.\n\nDisclaimer: Body Works does not make health-related claims or provide content related to the diagnosis, mitigation, cure, or treatment of a disease or medical condition; additionally, Body Works is not a medical device, medical content, or software for medical devices.", "short_description": "CREATE. EDUCATE. LEARN. SHARE - A virtual reality anatomy studio. \n\nDiscover a revolutionary virtual reality anatomy studio. Explain complex anatomy in minutes with simple, high-impact videos.\n\nBodyWorks is not a game.  It is a powerful tool for educators, healthcare providers, and content creators.  Check-in frequently for new anatomy and feature updates!\n\n7 Day Free Trial!  Subscription required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.precisionostech.com/privacy-policy/", "developer_terms_of_service_url": "https://www.precisionostech.com/terms-of-use/", "publisher_name": "PrecisionOS Technology", "support_website_url": "https://support.precisionostech.com/knowledge", "website_url": "https://www.precisionostech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8452867098152480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.c
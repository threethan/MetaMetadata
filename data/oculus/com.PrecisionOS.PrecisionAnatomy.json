Q2A_cxLc-i9Chj7txvNFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfwX6gNKPsGBDZDRqdTEyw3ylw6tZmG0S6_MbWZkhgOQ&oe=69A2D3EA"}, {"file_name": "MetaScreen_0001_Layer-3.png", "id": "864200262333096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036657_864200265666429_6313634239333222300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6K2g9Eu3QAQ7kNvwGDkir_&_nc_oc=AdnD7um-XW9Xref7eWM_fV_vPFiwOj651B2PYWo3jUQaJjrU38vL75EiLDMAfqVT_BU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMHsd46qeW-Zs-2cLk2lejZLCvwTnvqcYJYbD9HsNsbA&oe=69A2FB64"}, {"file_name": "MetaScreen_0002_Layer-5.png", "id": "1190633428839444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031544_1190633432172777_526839017652229245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_9ReSLZeDsQ7kNvwFPej8Q&_nc_oc=Adkq7Xo2RKGqJpxDAftlMPsAOnvH85My5jTTKWd4GN9QBsOC4dBK_fk5OaTr7WsaGkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2hKKGn3ft_gD2vD9XOSqzmR-V7zR6jOyzhxE4ZkzebQ&oe=69A2FB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1480550985787828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031626_1480550989121161_7431607364599380139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK8Vdl-vL7MQ7kNvwFO7_JY&_nc_oc=Adl1hYrWwk9EIUv2CQy-iMK-7FUCwDRostQKN9HQ19Or3iqBlTSzVrGUwu7wuQOxFdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGiuhcFaHVuO5ZOUR0vO9uUdl8sSIzjYlrTikXokyGzw&oe=69A2D323"}, "display_name": "BodyWorks", "keywords": ["anatomy", "Body", "health", "medical", "education"], "long_description": "CREATE. EDUCATE. LEARN. SHARE - A virtual reality anatomy studio. \n\nDiscover a revolutionary virtual reality anatomy studio. Explain complex anatomy in minutes with simple, high-impact videos. \n\nBodyWorks is not a game.  It is a powerful tool for educators, healthcare providers, and content creators.\n\n- Learn faster\n- Simplify concepts for learners and patients\n- Visualize concepts and structures \n- Stand out in your class \n- Build confidence for the OR\n\n7 Day Free Trial!  Subscription required.\n\nDisclaimer: Body Works does not make health-related claims or provide content related to the diagnosis, mitigation, cure, or treatment of a disease or medical condition; additionally, Body Works is not a medical device, medical content, or software for medical devices.", "short_description": "CREATE. EDUCATE. LEARN. SHARE - A virtual reality anatomy studio. \n\nDiscover a revolutionary virtual reality anatomy studio. Explain complex anatomy in minutes with simple, high-impact videos.\n\nBodyWorks is not a game.  It is a powerful tool for educators, healthcare providers, and content creators.  Check-in frequently for new anatomy and feature updates!\n\n7 Day Free Trial!  Subscription required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.precisionostech.com/privacy-policy/", "developer_terms_of_service_url": "https://www.precisionostech.com/terms-of-use/", "publisher_name": "PrecisionOS Technology", "support_website_url": "https://support.precisionostech.com/knowledge", "website_url": "https://www.precisionostech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8452867098152480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.c
content-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67EZmJ0WEbVKX9HoeCo4tmmvk3NZ6EcZURWCWvoX0eug&oe=69FDD042"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7MqG_7l6BEQ7kNvwGNg4XQ&_nc_oc=AdqOkUEgyUj8cZ0np2tcPT0OKR6i-VXLC7AYOesD1lOSoREHc3ZtPlSK3rSeCFSmOB4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nVQ8-ocn4vZAu--DuagaMCl3_3RTfP4zQRNFPDWbiiA&oe=69FE057B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "HVAC Technician is a virtual reality training simulation designed to teach and reinforce essential HVAC troubleshooting and repair skills. Trainees can practice diagnosing and replacing critical components, including fuses, contactors, breakers, sequencers, high-pressure switches, and thermostats\u2014all in a realistic, immersive environment. This hands-on experience helps build technical confidence and job readiness for HVAC students, apprentices, and professionals preparing for certification or on-the-job performance.", "short_description": "HVAC Technician is a VR training app offering hands-on practice for diagnosing and replacing key HVAC components like fuses, contactors, breakers, sequencers, pressure switches, and thermostats. Build real-world skills in a safe, immersive environment ideal for technicians and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
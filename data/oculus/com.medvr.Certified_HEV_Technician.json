g3s5FgnVdbp2yJ3Nb4MPgz6CCp9j9q3v7QPz5cks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv72W-gnjbPd5CJNVErBR6A9EIJwrmQHA52b-kf9qvx6w&oe=69A81EC2"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6IWAnyXTp4Q7kNvwFUybel&_nc_oc=AdlSn0dQPzaOq3dgojQ93-eBm9HD-8wOf3VZc6_SoSVmGfoZNO1pLj9eaNL6VRaxGIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1UuNFbIcKide-oTTHNXbRaUmYD9wQPf-9pwGk7uABfQ&oe=69A81BBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing and replacing essential HVAC components, including fuses, breakers, thermostats, motors, sensors, and more. Access is restricted to enrolled students only.\n Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24110420408632286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819417_2781359222055675_8376988888959798153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxlLQ3E_KDkQ7kNvwHrkISX&_nc_oc=Adn__2GDG98pEu6BFUa56IsXx_BsxUoOTGsdY6t2M5kcW6DoaKCGwA-b7Y1ZDf5tOUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5oYMn0tiO1AMOQGewvczyISNkd9ixrBKU8uTu2OO8Hw&oe=69A82FAF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HVAC Technician", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1748703420, "lastRevision": {"nodes": [{"id": "9277146475719590", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277146442386260", "is_first_party": false, "enables_in_app_ads": fa
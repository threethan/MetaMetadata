XuOXnDmyYP8UhrLLC9MG4XQikjhbI6zjwZN1ecZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwp3ixRGRKercWlzVssUKjl6pwI64V8YD7ziWEZ1cPgaQ&oe=69AC1342"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpsL4Rnfjm8Q7kNvwGlFtX5&_nc_oc=AdmZm6KtZFxkXftBiORUdYb7ZnnIIWlZ7i-QHd0oLX41MsWqDtuvaJ_SLEjswVt8dP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzV4g-A7EDLBzIXLagQjPElQ0-2EGJCAlTWudZJ5H2ltw&oe=69AC103B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing and replacing essential HVAC components, including fuses, breakers, thermostats, motors, sensors, and more. Access is restricted to enrolled students only.\n Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24110420408632286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_2781359222055675_8376988888959798153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYqMZN7BELgQ7kNvwHXi_i2&_nc_oc=AdmH6SA9KllbMha-mW6IEqTWqxbg3GAqDbD9ZFIGKn1SFcP5l2cx6LpysT-u8a0yKsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMXx12z_fJneRK5qGrTcN13fE9HToRavP-mSnuxTZrTg&oe=69AC242F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HVAC Technician", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1748703420, "lastRevision": {"nodes": [{"id": "9277146475719590", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9277146442386260", "is_first_party": false, "enables_in_app_ads": fa
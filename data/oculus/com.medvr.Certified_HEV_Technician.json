=Ado9HUrhCIwiikajp4V81Hrssp4ZyeerUhbV4rWX1tbrj5icThF6UTFm3G-MgU0w1o8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_wO3BX2fNvmMKJEfN4yfagPOn88BIp5lUNzSdFXLzZQ&oe=69D39D3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "HVAC Technician is a virtual reality training simulation designed to teach and reinforce essential HVAC troubleshooting and repair skills. Trainees can practice diagnosing and replacing critical components, including fuses, contactors, breakers, sequencers, high-pressure switches, and thermostats\u2014all in a realistic, immersive environment. This hands-on experience helps build technical confidence and job readiness for HVAC students, apprentices, and professionals preparing for certification or on-the-job performance.", "short_description": "HVAC Technician is a VR training app offering hands-on practice for diagnosing and replacing key HVAC components like fuses, contactors, breakers, sequencers, pressure switches, and thermostats. Build real-world skills in a safe, immersive environment ideal for technicians and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
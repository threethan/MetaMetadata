aepW6Og&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K5gu8GbmdcQXxkNzArSNih021f-wgDUii1J7UXl-lGA&oe=6A36B8E6"}, {"file_name": "com.oculus.vrshell-20250529-225251.png", "id": "738243568542532", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499624567_738243571875865_5678206044118997276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbynimCdgxgQ7kNvwGyZsyP&_nc_oc=AdoRgC4m9fawbVmGpop1cvt_TlTWBc6As5YnJP4Zq_mZxSYEmNnWT1Ikwh0wqMjlZw0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PSbJaOdmIx7zCtR1As3uftPrhynQD7W1ENR0rH9QVMw&oe=6A36B902"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWMBM7g4D3AQ7kNvwHIHTcA&_nc_oc=AdrtVOZ8xbrQK33yYge7OwioqRvb22kfXcY8SlIT_WDmfOsRpLcJXlUq2fRDBaYVros&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5NEbBai5_YvT-zGkL-e3hTY82BzxCk6_tfGdDdVjpqQ&oe=6A36B5FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Tec
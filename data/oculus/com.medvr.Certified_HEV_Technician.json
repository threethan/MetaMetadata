}, {"file_name": "com.oculus.vrshell-20250529-225251.png", "id": "738243568542532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624567_738243571875865_5678206044118997276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9AC46UQuUoQ7kNvwG3Net_&_nc_oc=Adrw23J2SvD0RwqXNdN1ssQcDfvGBlA_EaM3_DBMTabt2nmnpkn8Sm3VLPz4LuCOFR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RHZ9bGsEPLi3rFwI2jnAK1b0VW5BnnB8LtQ36Uf-EWg&oe=6A298A02"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48K-6eCAYEEQ7kNvwGvtW-w&_nc_oc=AdqsoKSnRDaJsTN0r0DXrIAigxd5lkLtH_mhSvSfSzsymf9XF99LjAxcT8x1SZLTV3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MqtXy-ZUnVnfrGwaJfk5HyhTNTyBk3NoZMGNDWnh5Yw&oe=6A2986FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on pra
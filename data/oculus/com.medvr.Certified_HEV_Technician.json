dTh3lhBUFVZY6EXJfaJQwPg&oe=6A43ED16"}, {"file_name": "com.oculus.vrshell-20250529-225443.png", "id": "1196512365114561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499352405_1196512368447894_1558833391287011545_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVCSsa4H0EAQ7kNvwHLUdla&_nc_oc=AdqikWgbxGucX-MEKfWDdfN7oEbPICG0msfm0yciOlrAU-qBHQrUmRjh6fGxvh7DKhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87H-AIPl2Hond_mP0p__f220t7326D-9-BNY5wpc0pBg&oe=6A43E7E6"}, {"file_name": "com.oculus.vrshell-20250529-225251.png", "id": "738243568542532", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499624567_738243571875865_5678206044118997276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMp7bt5dYHcQ7kNvwHxn3xL&_nc_oc=AdqwEQvOsZz--oe498b06CarALv6GmKhxi91HdzRNvn-ntv1S6KbHLlGlfG22bi2a90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zYHXkLAIK3FTy_wi94PQkbo5LNrLgYANGWUif44qULA&oe=6A43E802"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrJtCELtOMEQ7kNvwHRYSdb&_nc_oc=Adp6qu5ygfYePbXzg7L5-uPZcGIe3uOOf9gDXbWEkxmjRinfoLwYT1ptFQMH517tqXs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wbulx58jMLAroEwqs6GLE70fgScCaF6lbUUT9j0rt9A&oe=6A43E4FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing and replacing essential HVAC components, including fuses, breakers, thermostats, motors, sensors, and more. Access is restricted to enrolled students only.\n Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24110420408632286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_2781359222055675_8376988888959798153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0
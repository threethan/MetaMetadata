raining app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24110420408632286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819417_2781359222055675_8376988888959798153_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhO2TpR9D6AQ7kNvwEHzNpJ&_nc_oc=Adqc31aJCMOBS721f5A9mL0pSxbX2Rmr9NwcS5si9R1_6oNzYJZtdhZ1XahbMJUOXcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsIXXPYFYYwLZju84t7htbL_NJ9JfXgGE1_AEvwzjXvA&oe=6B0473EF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HVAC Technician", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1748703420, "lastRevision": {"nodes": [{"id": "9277146475719590", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata"
5_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRWLKvBnVN4Q7kNvwE60VFJ&_nc_oc=Ado8DiQdxXS4HY4J4EVluebCk104SH0syL1fg9-OBWdjWeg4TsraEYwXnLxzukZZMFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wt0C9QlCworyy5GaD4SybM0m2B3FOAi-8aSip4ssgkQ&oe=6A0B3766"}, {"file_name": "com.oculus.vrshell-20250529-225251.png", "id": "738243568542532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624567_738243571875865_5678206044118997276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd5vjS96yiEQ7kNvwHFXcvX&_nc_oc=AdrXHMaHfgORxRdgvmiFUex9Yx5wMxu24eBLgiTUgbH_hGPgSJlf3KUx8RaJHQ77Rpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e-pgiKaAUkuOb3sEg1lKN4Ntu9GopGYxhqQKc8mp1iw&oe=6A0B3782"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsVtD0LZv5AQ7kNvwGAa_Km&_nc_oc=AdqANirfiu3Kbh2c7gz-tFJ3Y30-4hWqgjFyQFxeEWOBnmZ3lfVwmoYbNS5cm480cg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MOboueFeG8xcOui8EFJT2BXRjoKqA6PT8oug8tnvT5g&oe=6A0B347B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "HVAC Technician is a virtual reality training simulation designed to teach and reinforce essential HVAC troubleshooting and repair skills. Trainees can practice diagnosing and replacing critical components, including fuses, contactors, breakers, sequencers, high-pressure switches, and thermostats\u2014all in a realistic, immersive environment. This hands-on experience helps build technical confidence and job readiness for HVAC students, apprentices, and professionals preparing for certification or on-the-job performance.", "short_description": "HVAC Technician is a VR training app offering hands-on practice for diagnosing and replacing key HVAC components like fuses, contactors, breakers, sequencers, pressure switches, and thermostats. Build real-world skills in a safe, immersive environment ideal for technicians and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9303546633079574"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1229535071369702"}, {"status": "PUBLISHED", "id": "1743611439698561"}]}, "baseline_offer": {"id": "1229535071369702"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749022980, "status": "PUBLISHED", "id": "1229535071369702"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26048209914853316", "version": "1.99"}, "id": "744154478058501", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9277146442386260", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
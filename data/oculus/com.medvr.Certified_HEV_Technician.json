ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499352405_1196512368447894_1558833391287011545_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWCLup-4BUwQ7kNvwHXys5z&_nc_oc=Adp9m2VVHa6TwnbeHDzA7XqS5hD8zBOoVQDC967rvvUmnntWNtfzJGs4zJENo5oY0hM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QqiOenODUQBrs5ZZc2WzDk0DhQ2G6AveFK938YceT1Q&oe=69FDD026"}, {"file_name": "com.oculus.vrshell-20250529-225251.png", "id": "738243568542532", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499624567_738243571875865_5678206044118997276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrescyF73qYQ7kNvwGcK9AQ&_nc_oc=Adr_S7vCeXM7lA8_MwprnZ2vWIfaC1ODE9y9PzoHea_qD_Nc1r8AvJATyy2kDQEDYfM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67EZmJ0WEbVKX9HoeCo4tmmvk3NZ6EcZURWCWvoX0eug&oe=69FDD042"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7MqG_7l6BEQ7kNvwGNg4XQ&_nc_oc=AdqOkUEgyUj8cZ0np2tcPT0OKR6i-VXLC7AYOesD1lOSoREHc3ZtPlSK3rSeCFSmOB4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nVQ8-ocn4vZAu--DuagaMCl3_3RTfP4zQRNFPDWbiiA&oe=69FE057B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing and replacing essential HVAC components, including fuses, breakers, thermostats, motors, sensors, and more. Access is restricted to enrolled students only.\n Certified HVAC Technician is a VR training app designed for students enrolled in the Immerse Learn HVAC Certification Program. It provides hands-on practice for diagnosing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24110420408632286"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819417_2781359222055675_8376988888959798153_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zglz_NxQAkYQ7kNvwGfU9oH&_nc_oc=AdojxGKOMJzK3OnnbNsebzP7PS-aak58ANKIO-7jLfbYZR8v-nkP3Nw1d6oxgJjYyik&_nc_zt=3&_nc_ht=sconten
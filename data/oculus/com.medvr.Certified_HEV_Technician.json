Dt2aGSE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nTD1Ul27Ptoyvgf_a7VZdiZQiwK6NA19xDlohwpcOGg&oe=6A395BE6"}, {"file_name": "com.oculus.vrshell-20250529-225251.png", "id": "738243568542532", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499624567_738243571875865_5678206044118997276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiEAZyyn2T4Q7kNvwFCXFaf&_nc_oc=AdqG6drHb5o8r0qZUOR4J8eApYntbmyZr3JYHS-XObNZSz7PIWHRTSIUTpZL88NcCRc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M4ZNBn69ZOnEvpbLaw8-w2khzBpx9CJAj-zFlk-sp7w&oe=6A395C02"}, {"file_name": "com.oculus.vrshell-20250529-225425.png", "id": "4046287728973254", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499354747_4046287732306587_7014708358063117885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBdhYvT3iF8Q7kNvwHuU6jI&_nc_oc=AdrGnnK_PqXq8c8nBBYnZBLTM0TzHT3pjfnOliNaRPc0LNs31qdks076GoTW3m9febM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UJBHCO9KiwsGFWpolNB87JXOv6oaxIOCZ141DJilEiQ&oe=6A3958FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Technician", "keywords": ["HVAC", "VR", "Immerselearn", "Training"], "long_description": "Certified HVAC Technician is part of the Immerse Learn HVAC Certification Program and is available exclusively to enrolled students. This VR simulation app offers an interactive, hands-on training experience to build practical skills in diagnosing and replacing a wide range of HVAC components. Modules include Fuses, Contactors, Breakers, Sequencers, High Pressure Switches, Thermostats, Transformers, Motors, Resistance Heaters, Limit Switches, Draft Pressure Switches, Ignitors, Flame Sensors, Thermocouples, Thermopiles, Float Switches, Condenser Fan Blades, and more. The app provides a realistic environment for learners to practice troubleshooting and repair tasks, preparing them for real-world HVAC service scenarios.", "short_description": "Certified HVAC Tec
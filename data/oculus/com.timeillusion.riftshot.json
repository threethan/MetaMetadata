&_nc_ss=7f30f&oh=00_AQXWb63hVNhycF8rBZfamXkDUf5BZFZDLCejNyfs4E-Shw&oe=6B0F0B7A"}]}, "id": "1117266324229814", "locale": "en_US", "screenshots": [{"file_name": "shot_2.png", "id": "1502205921841456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1502205925174789_5779352797440946280_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjqhbEP4SNkQ7kNvwF7ipFa&_nc_oc=AdpFSuLQJnrqydbtZNytkl0Qo0b8pQpQowk0MoTWYEz8YXWwscjx2P5WB5BXDdnNd6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWt9R4d34u0uzbIz7OuJjC-A8KhIRs0ujG1oDXV0ku9Pw&oe=6B0F0118"}, {"file_name": "shot_3.png", "id": "1572967414515817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1572967417849150_1328688291387534385_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzdlUv4VU50Q7kNvwFL_gbj&_nc_oc=AdpNiZ5qc9tY9FQb-UWMNkg6XSEQ91nGr6YmBTcwgQCO2HQ3Hd-qAyuHgLjuvr6v7Jg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUbdMgOaaiQ6GPGloCTV1MzE1qpbxPWzSJEHbnIl1XpvA&oe=6B0F1C11"}, {"file_name": "shot_4.png", "id": "2022296705878050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_2022296709211383_8311981220328807935_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQpJkMArjKcQ7kNvwF1v7Rm&_nc_oc=AdqzgS9a8nq_fOeQAqRtD0xNo51KrT5TJpTXO36S9Bx1hKVXykuLnww6qmGOc4hoGOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXy5LD-qOUrtPIzZ-lj5dBskAL_enApp-vkW-vkrafCXg&oe=6B0F11ED"}, {"file_name": "shot_1.png", "id": "1831546831518931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_1831546838185597_6345081192886035020_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDEFvbQOu0IQ7kNvwGyzlFI&_nc_oc=AdqeLN0RrYOPf4RcYSFNgYf6QwlYYKM0a7RvODhL4yyIrmPuPa9v665Nb_TI36jt3RA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8gOM7rnnNdGadxT8WedeYpnRjYQfyn0aePBvS1zft0A&oe=6B0EF49E"}, {"file_name": "shot_5.png", "id": "2872486226468092", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2872486229801425_5062905619682728723_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgBuNR_S9s4Q7kNvwFYp2c-&_nc_oc=AdrKXS72CLBt4mUKlkzuRZKo9ayemnzmZWpFxtDEVWi_mT-rVpnnD1WPd8_6wP7JFMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUC_ing3a8rmaKYIdX8PPspp_iTnFbtFrhWbbFbprhRvg&oe=6B0F09BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1826008305390272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824700_1826008312056938_2288912346460090581_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cpg4DwJCPYQ7kNvwGH5xDH&_nc_oc=Adoo0GXtS6bVvvLiwjEsdwg2ecI6HuGC7Ram1bomZ9eiP53FICJefv9sbZ52VfHcs-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeDAhdCST7OYbWivQ-PBFzfASzVUwW9jQkVYTEJWgAqA&oe=6B0EF66F"}, "display_name": "Riftshot: Room Zero", "keywords": ["aliens", "MR", "shooter", "defense", "robot"], "long_description": "In 2028 the Hollow begin tearing rifts into our world, and the first breach opens in your room: Room Zero.\n\nKIBO, an alien intelligence, arrives to stop them. Its directive is to protect, and it can never strike. So it arms you. Aim your Phase Blaster through the rifts in your real walls and ceiling and take down the Hollow while KIBO shields your walls.\n\nKIBO arrives damaged: its shield works from the start, its scanner returns in 2029 and its repair arms in 2030. Then a rift under fire is a threat to shoot, and a clear rift is a repair job. Lose that balance and the breach spreads until reality in your room is overwritten.\n\nFEATURES\n- Rifts open on the real walls and ceiling you scanned in Space Setup.\n- 120 levels across a ten-year calendar campaign. Each level has 3 to 7 waves, and every December ends with the Maw.\n- Eight kinds of Hollow, from Gnawers that chew your walls to Snipers, Carriers that split, armored Shellbacks and stomping Brutes.\n- KIBO at your side: it shields, scans, repairs and warns.\n- Upgrade cards between waves and a Combat Tree of permanent upgrades, all earned in play.\n- Replay levels to earn Scrap for cosmetic bullets, effects and kill coins.\n- One price. No loot boxes and no in-app purchases.\n\nFor Meta Quest 3 and 3S with Touch controllers. Played standing, in a room set up with Space Setup. No room scan? PLAY WITHOUT ROOM uses fallback walls.", "short_description": "The Hollow are tearing rifts into your real walls. Shoot back through them with your Phase Blaster while KIBO, an alien AI that protects but never strikes, shields your walls and wins back its scan and repair powers. Mixed-reality defense for Meta Quest 3 and 3S: 120 levels, and the Maw every December."}]}, "developer_name": "Time Illusion", "developer_privacy_policy_url": "https://timeillusion.com/riftshot/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "REMNANT DREAM S.R.L.", "support_website_url": "https://timeillusion.com/riftshot/#support", "website_url": "https://timeillusion.com/riftshot/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1544006604424073"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oc
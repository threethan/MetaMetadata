v2XQK8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxb3IlwWdvLhTZsKMNaVMs7RTsQcV-8I_4ngGTR93zlg&oe=6B0B1D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project(11).png", "id": "438332997967172", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974680_438333001300505_2135762183612817066_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb8GEryP5GsQ7kNvwEZAIkh&_nc_oc=AdoTcgpZ4uj32ajJHhH2a4guzNOaKOJddfbEQGM4_3U5B4brmZRTpri5CVgrN-oPJoM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTP2_me2lIv766SREMSG3tX2x179Rp7IKcc9OljHiYtHQ&oe=6B0B3270"}, "display_name": "AirRacer", "keywords": [], "long_description": "Don't you hate that feeling when you really want to play VR, but just don't have the space to do so?\n\nKAMPAI proudly presents you AirRacer, a VR racing game that you can play anywhere!\n\nControllers?\nWe don't do that here.\nYou can control the whole game with just your head.\n\nAirRacer is an early access VR racing game, where you control a hovering speeder on its way to collect those little weird cubes you saw in the trailer.  \nNow join us and FEEL THE SPEED.\n", "short_description": "Don't you hate that feeling when you really want to play VR, but just don't have the space to do so?\n\nKAMPAI proudly presents you AirRacer, a VR racing game that you can play anywhere!\n\nControllers?\nWe don't do that here.\nYou can control the whole game with just your head.\n\nAirRacer is an early access VR racing game, where you control a hovering speeder on its way to collect those little weird cubes you saw in the trailer.  \nNow join us and FEEL THE SPEED.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/18U9dkZprQwlr5dKsiwtILlZAO0B90zpISU5q9O9IuSk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "KAMPAI", "support_website_url": null, "website_url": "https://fansi.itch.io/airracer", "catego
B"}, {"file_name": "1.png", "id": "1256917471545691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036604_1256917474879024_8471275993110596211_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDTNZ_Hg_XgQ7kNvwGeuzcd&_nc_oc=AdqR4Y3HCqfg2UXjTtgprU0OdAd4iCl3-cpMX-Bm20IBruXIzrkk6KIdMKLlyEyqOeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuANv2GxLzQ7HDhdWAMYV3AaoiYv6MMh9E244sz_KptA&oe=6B0087E1"}, {"file_name": "5.png", "id": "1159229465013406", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001672_1159229468346739_8561399955473108273_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LGjb-WgBPAQ7kNvwH3K33r&_nc_oc=AdoOOM9QOzyZss-6TFJ8NI5w37rZlIP_KqNDv5R8XCeYP4a5PFrGAhW-4TkW97WvVvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSoCDP8lpWZqLZujtFkuG1UVVT4tyzzDU7isCYzZoUHw&oe=6B005481"}, {"file_name": "AirRacer Screenshotcorrected.png", "id": "496218565600636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_496218568933969_2791169427386295551_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZvp2mwPUbIQ7kNvwG2dbEW&_nc_oc=AdoPAeON-GkKuaKbzLkllDc7bXyXswQv1l00d-J7jdC_Up5Q8voRnouA9JOgnGv0mZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCsljzu1FLheetytzUljdPczf-6itOzTPKwPxw1E5l-Q&oe=6B00791D"}, {"file_name": "2.png", "id": "816639916247503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_816639919580836_2533233039716652649_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8NOlmkvHLMQ7kNvwHb1b1Y&_nc_oc=Adp77O26Fz9nXlhfyhq457cQcx7YQMXCQBi1uAZMK_RYdxDnkQZLWakJafwLj2OmJbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6LhglpwwSY1EhB5KBWTSHQbnB0Pz8IMWXZY5aeAfwFQ&oe=6B0057F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirRacer Cover Landscape.png", "id": "5216473148458722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036665_5216473151792055_450716066658966462_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPgUIUE3X2AQ7kNvwGcVkdm&_nc_oc=AdoFkz1jfb7vBEVpJ-xjAXZU9v-V5YLIQRf9pgmxyc5kwR4aB60O1blLYrGjuslNEoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLHUbcL-zaYt4wCWJFCcPP9XMJtm0-VJrXneeYpqpYOw&oe=6B006DEE"}, "display_name": "AirRacer", "keywords": [], "long_description": "Do you have what it takes to pilot a hovercraft going at top speed? Then the high-risk sport of Air Racing is for you!\n\nCompete in interplanetary races, collect new ships as you advance your career, and claim your place on the leaderboard! \n\nAirRacer is a VR racing game that you can play anywhere. Just tilt your head to control the vehicle, no controllers needed!\n\nFEATURES:\n\ud83e\ude90 Planet pack containing 5 different race tracks with varying environments, and many surprises along the road!\n\n\ud83d\ude80Unlock new speeder ships as you progress!\n\n\u2714\ufe0fFirst map is always free to play!\n\n\ud83c\udfc1 Gameplay with high speed and action-filled competitions!\n\n\ud83d\udee0 Further development and planet packs planned to be released!\n\n\ud83d\udde8 Make sure to join our discord in order to talk to devs, compete with other players, and be notified of upcoming official competitions with the chance to win prizes!\n\nOur first planet pack has now been released!\nStart your campaign on the desert planet of Ankeros. Make your way across this arid planet competing on 5 different race tracks. \nGo head to head with other players, climb the leaderboard and earn the title of Top AirRacer!", "short_description": "Make your way across the alien planet of Ankeros, competing on 5 different race tracks. \nGo head to head with other players, climb the leaderboard and earn the title of Top AirRacer!"}]}, "developer_name": "Kampai Raptor", "developer_privacy_policy_url": "https://docs.google.com/document/d/18U9dkZprQwlr5dKsiwtI
B"}, {"file_name": "1.png", "id": "1256917471545691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036604_1256917474879024_8471275993110596211_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYxymp99WSsQ7kNvwH4KU9t&_nc_oc=AdqUh8mCeyJwzP3gBSv6ZLqU3Vxenbfh5cRKHzxnPzPRAg0RvBIxqhtJmoJxLldNsYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWC5qWgRueTWsstXovA-E8abCgfcn1yLsfGJDugBU0gA&oe=6B1059E1"}, {"file_name": "5.png", "id": "1159229465013406", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001672_1159229468346739_8561399955473108273_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byyNrJbocngQ7kNvwFcAWvb&_nc_oc=AdrlqR87r7LL38sVzUSUiaUMRMNllfBZ6h9JTEEo0SoeC8dtkBD4jdSwpEr4Kl8esRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNQ0KiP1AvNQfJT5urUqmlJCSiTRIH6rwgRiqNOzBuBw&oe=6B105EC1"}, {"file_name": "AirRacer Screenshotcorrected.png", "id": "496218565600636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974455_496218568933969_2791169427386295551_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgxs5texvBAQ7kNvwHF2G9G&_nc_oc=AdrxtMgbItpYHQykeSsbaO2ZaBYs4hIPVA_xULvGYgWz64QYZE8pEHwrQuJcokQXS00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUMTuVCgz-pdSeiV4WjG48xfP3qs6wETED55F0njgoOQ&oe=6B104B1D"}, {"file_name": "2.png", "id": "816639916247503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031500_816639919580836_2533233039716652649_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hjqGyWkTSoQ7kNvwElI1Yo&_nc_oc=Adrxu-v0M5ujQLCVifORi-XFJV71CRBMuRq3I6hdQ6R0iYc-dkwGuAzf-QVIOvarPpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpI77ttSHspPiiChCsD2wzddkBZJgxaLILPRFPKm9mow&oe=6B106230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AirRacer Cover Landscape.png", "id": "5216473148458722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036665_5216473151792055_450716066658966462_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtdD-4RIDeIQ7kNvwEt9vXx&_nc_oc=AdoRt1qfmEdyDSXG9JRkIXr3hlghPckSBY7C_k12h671AgEXxTQytX2klSV-NuZ0gNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXP1kgEYpNCKPC7X4KTY4gkT8Y65lPQrQmYxn_fHvsGAg&oe=6B103FEE"}, "display_name": "AirRacer", "keywords": [], "long_description": "Do you have what it takes to pilot a hovercraft going at top speed? Then the high-risk sport of Air Racing is for you!\n\nCompete in interplanetary races, collect new ships as you advance your career, and claim your place on the leaderboard! \n\nAirRacer is a VR racing game that you can play anywhere. Just tilt your head to control the vehicle, no controllers needed!\n\nFEATURES:\n\ud83e\ude90 Planet pack containing 5 different race tracks with varying environments, and many surprises along the road!\n\n\ud83d\ude80Unlock new speeder ships as you progress!\n\n\u2714\ufe0fFirst map is always free to play!\n\n\ud83c\udfc1 Gameplay with high speed and action-filled competitions!\n\n\ud83d\udee0 Further development and planet packs planned to be released!\n\n\ud83d\udde8 Make sure to join our discord in order to talk to devs, compete with other players, and be notified of upcoming official competitions with the chance to win prizes!\n\nOur first planet pack has now been released!\nStart your campaign on the desert planet of Ankeros. Make your way across this arid planet competing on 5 different race tracks. \nGo head to head with other players, climb the leaderboard and earn the title of Top AirRacer!", "short_description": "Make your way across the alien planet of Ankeros, competing on 5 different race tracks. \nGo head to head with other players, climb the leaderboard and earn the title of Top AirRacer!"}]}, "developer_name": "Kampai Raptor", "developer_privacy_policy_url": "https://docs.google.com/document/d/18U9dkZprQwlr5dKsiwtI
2338_2341607616608563_4313517096200148758_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbLH9gQYbbMQ7kNvwE8ToNX&_nc_oc=AdoQ5JYp0Ex2BEbTZJt9l7FLXo87UR-chRt4CWxAeMFfLBj3yTxL0JOn3qFN7fvvyLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThdXOPNBWQqsRaqZH2mdXeFQWMmjECwOoq_ZPpoKwB0A&oe=6B0DAF65"}, {"file_name": "screenshot_1.png", "id": "2377962612736456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312231_2377962616069789_6883244022754203427_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlNw1faA2YIQ7kNvwFogLqW&_nc_oc=AdpFYBVBnGqDf4AI98SkRX8V6KeVJ2ITE6bHvit_mzOHT5mB6HYEDS3Y8d2SSN6hfGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR48AOSk_pzNETU90qFyoOkjjK4d-Uiu3qTqJbtTgTplg&oe=6B0DCDBF"}, {"file_name": "screenshot_4.png", "id": "1122931390177977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312306_1122931393511310_4495213665778793870_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcl7nPABfCEQ7kNvwH_yQgR&_nc_oc=AdpgrDNKiLiFk8RVpN7Z7fN2Xb65d7hHGni43Ot3lE4PXXtzpXzoDekvKfqtzkIDvlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKxxTKdIc5TD4aB4di1w2SCmBTXBdprgodwcI61P26Ow&oe=6B0DA3F0"}, {"file_name": "screenshot_3.png", "id": "1090147647188974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307444_1090147650522307_962034871194008732_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1AxhXBVcfUQ7kNvwE5DzzH&_nc_oc=AdpJP4o7mXLFatGKa9NUt4UsgPVBHluKxdyRdqHQrcE5VlcA1eyKSZzfvpBS9aVzwoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4POz50-4tu2-Cs0bpqdXixFQH3AHoD91gYBWdfqG88w&oe=6B0DCA8C"}, {"file_name": "screenshot_5.png", "id": "1795226235144168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303707_1795226238477501_5947210259104418463_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK54i8VRRs0Q7kNvwGpvKRZ&_nc_oc=AdrXijBOs06YgiXS8OUn8nol4CC6NWNHAODnUksaQEj1L4U6Jo54R8ynxDwdZcngah0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwywg_jA-u6d92jjNRjDHOpqICMtS7UHu8O3MEKziz3A&oe=6B0DB2A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28490828993950249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312468_28490828997283582_8444761202272835395_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTNdEVbycMoQ7kNvwGHPb7D&_nc_oc=AdrX7u7pepEYZz_NrqvtKnyfBAEJ-O7bV17FR-FZH_lPAOo159ml6BYn2aauvJpsrj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmYGTpo6-CweafziFSPS91CmSkUunu3W-IHo8zfGVvYA&oe=6B0DADA4"}, "display_name": "Graffiti Gothenburg", "keywords": ["graffiti", "gothenburg", "painting", "art", "sandbox"], "long_description": "Graffiti Gothenburg takes your spray cans to the walls of Sweden's west-coast city.\n\nFOUR GOTHENBURG PLACES\n- R\u00d6DA STEN: the old red-brick boiler house under the great suspension bridge at the river mouth, the city's hall of fame, on a crisp autumn afternoon with the big white ferry heading out to sea.\n- HAGA: a cobbled square at a December blue hour. Snow falling, advent stars in the windows, a lit Christmas fir and market stalls, Skansen Kronan floodlit on its hill and the blue tram sliding by.\n- ERIKSBERG: the old shipyard quay at dawn. Mist on the river, a ship's hull block and a giant steel door to paint, the gantry crane over the dry dock and the city waking up across the water.\n- SK\u00c4RG\u00c5RDEN: a fishing harbour in the archipelago on midsummer evening. Falu-red boathouses on pink granite, a midsummer pole on the meadow and the sun going down into the sea.\n\nTHE CITY IS ALIVE\nPeople stroll the quays, browse the market and stop to look at your work. Ferries, sailboats, the tram and a lighthouse beam keep Gothenburg moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of brick, concrete, steel and timber. Take a photo of your piece and switch places from the menu.\n\nSVENSKA\nEvery menu in English and Swedish. A Swedish headset starts in Swedish; one button switches.", "short_description": "Spray paint the walls of Gothenburg. Bomb the hall of fame at R\u00f6da Sten under the great bridge, a snowy Haga square at Christmas, the Eriksberg shipyard at dawn and Falu-red boathouses in the archipelago at midsummer. Four real places, alive with people. English and Swedish."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitigothenburg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitigothenburg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387179057811963"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1387248751138327", "version": "1.0.1"}, "id": "4579991255613462", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
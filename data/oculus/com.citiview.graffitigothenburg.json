7kNvwGDD_QW&_nc_oc=AdpQ1mfOwC2Mi16VUkck82Ua2I1ijbhwZKZsyXvtjvtZhbYod6N5bSkQHg1Faw6XdrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtYiMh1b6NPQWJU97im3gnbJQfhb4C5_ROB6He2AyuYQ&oe=6AFC8F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28490828993950249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312468_28490828997283582_8444761202272835395_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izcpzjO9kWAQ7kNvwH8ciDn&_nc_oc=AdosM4Z4-_p2oKXa5yF84xlHsYe7vJeq2AcHo0NKRGyJGpTSsSEaDs2_PTRS1xXlmgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpQei5oa0VDe4WHGH9F3S_SYVPcTo7OWwWg0YE2cHvnw&oe=6AFC8A24"}, "display_name": "Graffiti Gothenburg", "keywords": ["graffiti", "gothenburg", "painting", "art", "sandbox"], "long_description": "Graffiti Gothenburg takes your spray cans to the walls of Sweden's west-coast city.\n\nFOUR GOTHENBURG PLACES\n- R\u00d6DA STEN: the old red-brick boiler house under the great suspension bridge at the river mouth, the city's hall of fame, on a crisp autumn afternoon with the big white ferry heading out to sea.\n- HAGA: a cobbled square at a December blue hour. Snow falling, advent stars in the windows, a lit Christmas fir and market stalls, Skansen Kronan floodlit on its hill and the blue tram sliding by.\n- ERIKSBERG: the old shipyard quay at dawn. Mist on the river, a ship's hull block and a giant steel door to paint, the gantry crane over the dry dock and the city waking up across the water.\n- SK\u00c4RG\u00c5RDEN: a fishing harbour in the archipelago on midsummer evening. Falu-red boathouses on pink granite, a midsummer pole on the meadow and the sun going down into the sea.\n\nTHE CITY IS ALIVE\nPeople stroll the quays, browse the market and stop to look at your work. Ferries, sailboats, the tram and a lighthouse beam keep Gothenburg moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of brick, concrete, steel and timber. Take a photo of your piece and switch places from the menu.\n\nSVENSKA\nEvery menu in English and Swedish. A Swedish headset starts in Swedish; one button switches.", "short_description": "Spray paint the walls of Gothenburg. Bomb the hall of fame at R\u00f6da Sten under the great bridge, a snowy Haga square at Christmas, the Eriksberg shipyard at dawn and Falu-red boathouses in the archipelago at midsummer. Four real places, alive with people. English and Swedish."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitigothenburg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitigothenburg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387179057811963"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1807708457027560"}]}, "baseline_offer": {"id": "1807708457027560"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792016940, "status": "PUBLISHED", "id": "1807708457027560"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
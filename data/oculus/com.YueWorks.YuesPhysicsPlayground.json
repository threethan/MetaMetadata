1_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KkzUEYmSZoQ7kNvwH8Z8j1&_nc_oc=Adk53EoF_HGJXDk49MnwyNphTiJfI4NJQIuYQ44IGN61LhmQrQaxZQgM63NABzOUWtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXjFi1wjH7YfHZpgDKIZjLGjnbJcAhWLo1fUjwyrJxrg&oe=69A044EA"}, "display_name": "Yue's Physics Playground", "keywords": [], "long_description": "This is a work in progress, dedicated to explore the possiblities of Virtual Reality.\n\nAvailable Features:\nPaperplanes\nRC Drone\nRC Flacon9 Rocket\nBalloon Gun\nRegular Gun\nPaper Plane Gun\nWhiteboard with Pen\nA Basket Ball\nDarts\nSpawnable and Custumizable Gravity Balls\nSpawnable Connection Cubes\n\nAnd more to come! \nThis is application is specifically build for the Meta Quest.", "short_description": "\nPhysics Playground to explore the possibilities of Virtual Reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yue-beifong.jimdosite.com/privacy-policy-yues-physics-playground/", "developer_terms_of_service_url": null, "publisher_name": "YueBeifong", "support_website_url": null, "website_url": "https://yue-beifong.jimdosite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "387879953185391"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974824_958000418230282_2527192748447350386_n.png?stp=
AdrykZ5DrtdOZ7R9D3xO8mQsZtR-4MIkM3AefKBUrJX2L-qzRJOJxcISbLYqnbgMtm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmxjLPUuf1WXBWAZd5a17oHWilAJH8My5VdRKAQMHA1w&oe=6A95AEA6"}, {"file_name": "Sceeny3.png", "id": "2052183282059857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_2052183295393189_4335591365522650145_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bx11qAWSW0Q7kNvwGUuQSg&_nc_oc=AdpKWnA-cYsLsqdQ2CLab_q8ZgzEscS9p4DFtsyedGNWcC9gf5Ta8Alw_57Vji1lBYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdauq4RErFiyGzL42wAj4mkDaz_HNfbAklMd88U3CQ-w&oe=6A95B4B7"}, {"file_name": "Sceeny5.png", "id": "1267464442201023", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1267464445534356_2164339322169361523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Czb4hCxwhzwQ7kNvwFd9ES8&_nc_oc=AdpCmejAaOHoqPCbjBUTaZWJsGMQNgOixB4q-EUiQDOQ21oMxhAPoilTKpCc5LfcgMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvPcvflfsLDeKzJ4SYWRurG_SDfsue5iiP2mQ8DIcs1w&oe=6A95CFD3"}, {"file_name": "Sceeny4.png", "id": "2100103154105740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820433_2100103160772406_716423615788459326_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQwdybigV-MQ7kNvwGIwq8g&_nc_oc=Ado2VaabpQA67vGo0IOYScghE5IMJ66kjy37G6sbpgtgd5vvQ8KulVMZAR8w3WteVQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHktreZysZzP4ALSlb5V0Us6xKoPJs4FPPKUu1g5SoyFg&oe=6A95BE8B"}, {"file_name": "Sceeny2.png", "id": "1623853012228855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585720338_1623853015562188_3069567292380904881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5vsNpkwMPAQ7kNvwGlfXsv&_nc_oc=Adrdw96xTq4I7wy4fNxLF9LoCE1HjWs655-ZwaLNbakzNI_-5cNNhoJkSZQyXk8r8Os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ79FvxWkxYf3IoHJxj33KAIpmfbtYu6rRDhMZDum9Ow&oe=6A95C8FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lunar Lander", "keywords": ["Arcade", "Space", "Simulation", "Lunar", "Mars"], "long_description": "\ud83d\ude80 LUNAR LANDER\n\nDescend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR.\n\n\ud83c\udfae Precision Landing Gameplay\n\nTake full control of your descent using thrusters and careful timing.\nEvery movement matters \u2014 too fast and you crash, too slow and you drift off course.\n\nMaster:\n\nThrust control and momentum\nFuel management under pressure\nSafe landing speeds and angles\nControlled descents from high altitude\n\ud83c\udf11 High-Risk, High-Reward\n\nNo two landings feel the same.\n\nPush your limits:\n\nAttempt perfect landings with minimal velocity\nConserve fuel for efficiency bonuses\nRecover from unstable descents\nTake risks\u2026 or play it safe\n\ud83e\udde0 Easy to Learn, Hard to Master\n\nSimple controls make it easy to start.\nTrue mastery takes precision, timing, and nerve.\n\nInstant restart gameplay loop\nSkill-based progression\nIncreasing challenge as you improve\n\ud83d\udd79\ufe0f Retro Arcade, Rebuilt for VR\n\nInspired by the classic Lunar Lander experience, now fully immersive.\n\nClean, readable HUD (ALT, FUEL, VEL)\nHigh-contrast visuals designed for VR clarity\nSmooth, responsive controls\nFocused, distraction-free gameplay\n\ud83c\udfc6 Challenge Yourself\n\nCan you:\n\nLand perfectly?\nSave fuel?\nRecover from the edge of disaster?\n\nOr will gravity win?\n\n\ud83c\udf0c Built for VR\n\nDesigned specifically for standalone VR:\n\nComfortable seated gameplay\nClear visual feedback\nFast sessions, perfect for repeat runs\n{2030666394147829}", "short_description": "Descend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR."}]}, "developer_name": "Sax Compute Ltd", "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26548559674777111"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1024403117082564"}, {"status": "PENDING", "id": "1374679384135492"}, {"status": "PUBLISHED", "id": "4311888369034071"}, {"status": "PUBLISHED", "id": "26665596133141679"}, {"status": "PUBLISHED", "id": "1068649692781693"}, {"status": "PUBLISHED", "id": "1440845530583172"}, {"status": "PENDING", "id": "2765820520477728"}]}, "baseline_offer": {"id": "4311888369034071"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1024403117082564"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28133652366267826", "version": "1.7.0"}, "id": "1513324836881754", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28133652366267826"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": "Built up terrain around yellow pads", "created_date": 1787509158, "id": "28133652366267826", "version": "1.7.0", "version_code": 2000, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28133652366267826"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": "# Lunar Lander VR \u2014 Release 1.6.0\n\n## What's New\n\n### Bonus Landing Runs\n- Successful landings no longer end the game. The result message now shows points earned, the running total, and **Bonus \u2014 Go Again!** before starting another attempt.\n- The shuttle respawns at a random safe location above the lunar terrain, away from the map edges.\n- Remaining fuel carries into each bonus attempt, turning fuel into the limiting factor for an extended run.\n- A successfully claimed landing pad is removed for the rest of the run, encouraging players to explore and hunt for unused targets.\n- Crashes still end the run and return to the menu, now showing the accumulated session score.\n\n### Difficulty and Scoring Clarity\n- Fixed difficulty selection so it now controls the real maximum safe total impact speed:\n  - **Easy:** up to 3 m/s\n  - **Medium:** up to 2 m/s\n  - **Hard:** up to 1 m/s\n- Expanded the right menu panel with colour-matched level limits, pad rewards, fuel-bonus details, and separate-leaderboard information.\n- Easy, Medium, and Hard use the same green, amber, and red language as their corresponding pad rewards.\n\n### Music, Thrusters, and Volume Controls\n- Added persistent looping menu music that continues into gameplay when enabled.\n- Added Music and SFX volume sliders; values and toggle states persist between scenes and sessions.\n- Restored throttle-responsive looping thruster audio with configurable clip, maximum volume, and fade time.\n- Thruster volume now respects the menu SFX setting.\n\n### VR Comfort and Camera Controls\n- Added automatic headset recentering when both the menu and game scenes start, including an application-origin fallback for Meta/OpenXR runtimes that ignore a standard recenter request.\n- Adjusted the cockpit viewpoint upward and rearward for a more natural seated position inside the shuttle.\n- The **X button** now toggles between cockpit and spectator views; the spectator camera automatically shares the shuttle input-action asset.\n- Added X and Y button descriptions to the controls panel. Y returns to the menu.\n\n### Menu Presentation\n- Added a matching dark background to the right instructions panel.\n- Expanded and resized the instructions layout to accommodate controls, difficulty rules, and scoring information.\n- Unified project-owned logging through `LLVRLog` for consistent filtered diagnostics on Quest.\n\n### Quest Build Version\n- Updated the Meta Quest application version to **v1.6.0** with Android version code **160**.\n\n---", "created_date": 1783846718, "id": "27630249193274815", "version": "1.6.0", "version_code": 160, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28133652366267826"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": null, "created_date": 1783360529, "id": "27571785269121208", "version": "1.5.0", "version_code": 150, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28133652366267826"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": null, "created_date": 1780224323, "id": "27128439223455817", "version": "1.4.3", "version_code": 143, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28133652366267826"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": null, "created_date": 1779038862, "id": "26957769337189474", "version": "1.4.2", "version_code": 142, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewe
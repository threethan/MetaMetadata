8EW_u7CkXPrw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gac9TiIJnWJ8Nj1XX4Si8CNTyptnuwE4TNDOoLXpLyg&oe=6A244DA6"}, {"file_name": "Sceeny3.png", "id": "2052183282059857", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821704_2052183295393189_4335591365522650145_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmL3AJxpmgYQ7kNvwFyPejC&_nc_oc=Adpv3b6d2S_Rgo4Z4xo9tDmDjQCvMezymPdPeSl-IS8IwDAqfEQ1N8-NPyDLA6kRqnY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JI9UwuD1zYid-ZH1nP5e_nceia9oocgtGHLJmpUK8iA&oe=6A241B77"}, {"file_name": "Sceeny5.png", "id": "1267464442201023", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820887_1267464445534356_2164339322169361523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPf3E132C6kQ7kNvwGD1ZPS&_nc_oc=AdqBBL6RdOQXJke7lT4oX069UlVUh3wcnkZYrsPJA7Z6kymVrDfps7sQO35A5p6Poh4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EELK4p-PUCEhPEUOTEmcNXuO6jdfS6luD4m5KuXa-pw&oe=6A243693"}, {"file_name": "Sceeny4.png", "id": "2100103154105740", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820433_2100103160772406_716423615788459326_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fpxup5E2F_kQ7kNvwH5fW_x&_nc_oc=AdpD_sIf84cVE22LTrj16EJZXFJqVsW1KVMssd2jWMPkAj79qfo2sSUpdnsGu7l7HpY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98uc7gScrFxWpw3oxn6tOS-cV3w6QealEQSDXZhLliTA&oe=6A24254B"}, {"file_name": "Sceeny2.png", "id": "1623853012228855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/585720338_1623853015562188_3069567292380904881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7OOXm1ENH0Q7kNvwGBitx9&_nc_oc=Adq-EHMXqvUkjlnS6HFUQdLlhiy4oRoHScs64KFOOxHcTNfFVonTWt256NKqgc6HQsM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9reNnczDRQAM2JNj8F9WFlp9qtZCW6ui89nnVXfs1jQ&oe=6A242FBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lunar Lander", "keywords": ["Arcade", "Space", "Simulation", "Lunar", "Mars"], "long_description": "\ud83d\ude80 LUNAR LANDER\nEarly Release: To come, challanges and Scoring System.\n\nDescend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR.\n\n\ud83c\udfae Precision Landing Gameplay\nTake full control of your descent using thrusters and careful timing.\nEvery movement matters \u2014 too fast and you crash, too slow and you drift off course.\n\nMaster:\n\nThrust control and momentum\nFuel management under pressure\nSafe landing speeds and angles\nControlled descents from high altitude\n\n\ud83c\udf11 High-Risk, High-Reward\nNo two landings feel the same.\n\nPush your limits:\n\nAttempt perfect landings with minimal velocity\nConserve fuel for efficiency bonuses\nRecover from unstable descents\nTake risks\u2026 or play it safe\n\n\ud83e\udde0 Easy to Learn, Hard to Master\nSimple controls make it easy to start.\nTrue mastery takes precision, timing, and nerve.\n\nInstant restart gameplay loop\nSkill-based progression\nIncreasing challenge as you improve\n\ud83d\udd79\ufe0f Retro Arcade, Rebuilt for VR\n\nInspired by the classic Lunar Lander experience, now fully immersive.\n\nClean, readable HUD (ALT, FUEL, VEL)\nHigh-contrast visuals designed for VR clarity\nSmooth, responsive controls\nFocused, distraction-free gameplay\n\n\ud83c\udfc6 Challenge Yourself\nCan you:\n\nLand perfectly?\nSave fuel?\nRecover from the edge of disaster?\n\nOr will gravity win?\n\n\ud83c\udf0c Built for VR\nDesigned specifically for standalone VR:\nComfortable seated gameplay\nClear visual feedback\n\n{2030666394147829}", "short_description": "Early Release: To come, challanges and Scoring System.\n\nDescend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR."}]}, "developer_name": "Sax Compute Ltd", "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26917439424555799"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823812_1696671415114695_8753001765033341184_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR4yyTDZjOcQ7kNvwHcC3BQ&_nc_oc=Adp5CRLo99A70UejHauR8zY4yt5hq3frxlIMzaS8IHQF7HWaM0XHmIceEqQEB-GefLM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93XQDT9-Mth5W8gWfvyBO9djClVBvGw7vciwsrgrF05g&oe=6A243951"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lunar Lander", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1777194600, "lastRevision": {"nodes": [{"id": "26548559744777104", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26548559618110450", "is_
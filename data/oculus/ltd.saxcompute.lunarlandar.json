trZhomVB4zgYN7HUHdZHagUyXjnuodTW36u_VIap_swvkKU8TEdBftAMVeY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rKZgYJ_7gBKZ2eUl1kbGA5Dl07UE1SbzItb7zEWAA9g&oe=6A243A26"}]}, "id": "1764156267893562", "locale": "en_US", "screenshots": [{"file_name": "Sceeny1.png", "id": "960741680225467", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825305_960741686892133_881300046156752593_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fNyfLpsZqEQ7kNvwEeN8i3&_nc_oc=AdqKNBpi4P3_Hr3s9Z2u4h7e9yaT5G9FB73dija-svzWN19u81exl8p8EW_u7CkXPrw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gac9TiIJnWJ8Nj1XX4Si8CNTyptnuwE4TNDOoLXpLyg&oe=6A244DA6"}, {"file_name": "Sceeny3.png", "id": "2052183282059857", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821704_2052183295393189_4335591365522650145_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmL3AJxpmgYQ7kNvwFyPejC&_nc_oc=Adpv3b6d2S_Rgo4Z4xo9tDmDjQCvMezymPdPeSl-IS8IwDAqfEQ1N8-NPyDLA6kRqnY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JI9UwuD1zYid-ZH1nP5e_nceia9oocgtGHLJmpUK8iA&oe=6A241B77"}, {"file_name": "Sceeny5.png", "id": "1267464442201023", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820887_1267464445534356_2164339322169361523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPf3E132C6kQ7kNvwGD1ZPS&_nc_oc=AdqBBL6RdOQXJke7lT4oX069UlVUh3wcnkZYrsPJA7Z6kymVrDfps7sQO35A5p6Poh4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EELK4p-PUCEhPEUOTEmcNXuO6jdfS6luD4m5KuXa-pw&oe=6A243693"}, {"file_name": "Sceeny4.png", "id": "2100103154105740", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820433_2100103160772406_716423615788459326_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fpxup5E2F_kQ7kNvwH5fW_x&_nc_oc=AdpD_sIf84cVE22LTrj16EJZXFJqVsW1KVMssd2jWMPkAj79qfo2sSUpdnsGu7l7HpY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98uc7gScrFxWpw3oxn6tOS-cV3w6QealEQSDXZhLliTA&oe=6A24254B"}, {"file_name": "Sceeny2.png", "id": "1623853012228855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/585720338_1623853015562188_3069567292380904881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7OOXm1ENH0Q7kNvwGBitx9&_nc_oc=Adq-EHMXqvUkjlnS6HFUQdLlhiy4oRoHScs64KFOOxHcTNfFVonTWt256NKqgc6HQsM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9reNnczDRQAM2JNj8F9WFlp9qtZCW6ui89nnVXfs1jQ&oe=6A242FBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lunar Lander", "keywords": ["Arcade", "Space", "Simulation", "Lunar", "Mars"], "long_description": "\ud83d\ude80 LUNAR LANDER\n\nDescend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR.\n\n\ud83c\udfae Precision Landing Gameplay\n\nTake full control of your descent using thrusters and careful timing.\nEvery movement matters \u2014 too fast and you crash, too slow and you drift off course.\n\nMaster:\n\nThrust control and momentum\nFuel management under pressure\nSafe landing speeds and angles\nControlled descents from high altitude\n\ud83c\udf11 High-Risk, High-Reward\n\nNo two landings feel the same.\n\nPush your limits:\n\nAttempt perfect landings with minimal velocity\nConserve fuel for efficiency bonuses\nRecover from unstable descents\nTake risks\u2026 or play it safe\n\ud83e\udde0 Easy to Learn, Hard to Master\n\nSimple controls make it easy to start.\nTrue mastery takes precision, timing, and nerve.\n\nInstant restart gameplay loop\nSkill-based progression\nIncreasing challenge as you improve\n\ud83d\udd79\ufe0f Retro Arcade, Rebuilt for VR\n\nInspired by the classic Lunar Lander experience, now fully immersive.\n\nClean, readable HUD (ALT, FUEL, VEL)\nHigh-contrast visuals designed for VR clarity\nSmooth, responsive controls\nFocused, distraction-free gameplay\n\ud83c\udfc6 Challenge Yourself\n\nCan you:\n\nLand perfectly?\nSave fuel?\nRecover from the edge of disaster?\n\nOr will gravity win?\n\n\ud83c\udf0c Built for VR\n\nDesigned specifically for standalone VR:\n\nComfortable seated gameplay\nClear visual feedback\nFast sessions, perfect for repeat runs\n{2030666394147829}", "short_description": "Descend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR."}]}, "developer_name": "Sax Compute Ltd", "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26548559674777111"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1440845530583172"}, {"status": "PENDING", "id": "2765820520477728"}]}, "baseline_offer": {"id": "1440845530583172"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777194600, "status": "PUBLISHED", "id": "1440845530583172"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27128439223455817", "version": "1.4.3"}, "id": "1513324836881754", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27128439223455817"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": null, "created_date": 1780224323, "id": "27128439223455817", "version": "1.4.3", "version_code": 143, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27128439223455817"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": null, "created_date": 1779038862, "id": "26957769337189474", "version": "1.4.2", "version_code": 142, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27128439223455817"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": null, "created_date": 1778996122, "id": "26951279904505084", "version": "1.4.1", "version_code": 141, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27128439223455817"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": "# Lunar Lander VR \u2014 Release 1.3\n\n## What's New\n\n### Difficulty-Tuned Landing Speeds\n- Safe landing speed limits are now **per-difficulty** and checked independently on each axis:\n  - **Easy**: 3 m/s on Climb, Forward, and Lateral\n  - **Medium**: 2 m/s on all axes\n  - **Hard**: 1 m/s on all axes \u2014 precision required\n- Previously a single multiplier was applied to a base speed; now each difficulty has a fixed absolute limit.\n\n### HAG \u2014 Height Above Ground\n- The **ALT** cell on the Flight HUD is renamed to **HAG** (Height Above Ground), correctly describing what was always measured: a downward raycast to the nearest terrain surface, not barometric altitude.\n\n### Landing Pad System\n- New **LandingPad** script for scene-placed coloured landing zones.\n- Each pad has a configurable **Difficulty** and **Pad Color** (applied via `MaterialPropertyBlock` \u2014 no extra material instances).\n- Pad collision mirrors the difficulty-speed check; shows a labelled message on safe touchdown.\n", "created_date": 1777961173, "id": "26800117629621313", "version": "1.3.0", "version_code": 130, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26548559618110450", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27128439223455817"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1513324836881754"}]}, "change_log": "# Lunar Lander VR \u2014 Release 1.2\n\n## What's New\n\n### Flight Model Overhaul\n- Replaced stick damping with **RC-style rates and expo curves** (Betaflight-inspired).\n  - Separate `pitchRate`, `rollRate`, and `yawRate` caps give fine control over maximum rotation speed.\n  - Per-axis expo curves (`pitchExpo`, `rollExpo`, `yawExpo`, `throttleExpo`) soften the stick centre for smoother micro-corrections without sacrificing full-deflection authority.\n- Re-tuned torque and angular drag values for a more realistic, floaty lunar feel.\n\n### In-Cockpit HUD\n- New world-space **Flight HUD** displays live telemetry locked to the player's view:\n  - Fuel %, Altitude, Climb rate, Forward and lateral speed\n  - Pitch, Roll, Yaw angles and angular rates\n- New **Message HUD** shows timed in-flight notifications (low fuel warnings, landing results, etc.).\n\n### Audio\n- **Thruster sound effects** \u2014 engine pitch and volume scale with throttle input; configurable fade time prevents jarring cuts.\n- **Background music** with adjustable volume via inspector.\n\n### Online Leaderboards (PlayFab)\n- Score and best-landing-time leaderboards for each map size (**small / medium / large**).\n- Scores submitted automatically after each successful landing; play offline and they queue for later submission.\n- Session tracking records total play time per session.\n\n### Menu Improvements\n- Rebuilt main menu with cleaner layout (`LunarLanderMenuUI`).\n- New **Controls instructions screen** accessible from the menu.\n\n### Under the Hood\n- `LLVRSettings` \u2014 central runtime settings object.\n- `LLVRVersion` \u2014 version string sourced from Unity Player Settings.\n- Submission queue with retry logic for unreliable network conditions.\n\n---\n\n## Known Limitations\n- Leaderboard display UI (in-game top-10 view) is planned for v1.3.\n- Audio mixer integration pending \u2014 volume sliders affect source volume directly for now.\n\n---\n\n## Social Post Draft\n\n> \ud83d\ude80 **Lunar Lander VR v1.2 is live on Meta Quest!**\n>\n> This is a big one. Completely reworked flight model with RC-style expo curves \u2014 the lander actually _feels_ like it has mass now. Plus:\n>\n> \ud83d\udda5\ufe0f Live flight HUD (fuel, altitude, pitch/roll/yaw, climb rate)  \n> \ud83d\udd0a Thruster SFX + background music  \n> \ud83c\udfc6 Online leaderboards \u2014 best landing time & high score on three map sizes  \n>\n> Drop a landing score and see where you rank. Link in bio.\n>\n> #MetaQuest #VRGaming #IndieVR #LunarLanderVR #GameDev #UnityVR\n", "created_date": 1777809649, "id": "26781430421490034", "version": "1.2.0", "version_code": 120, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
.com&_nc_ss=7f20f&oh=00_AQAPVg_K0LXLbp91ki4ZHxYJa4x8uX20JGB1Z67RGOMALA&oe=6A56302A"}, {"file_name": "lunar_lander_hero_3000x900.png", "id": "1318051560191387", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819281_1318051566858053_2803803622026118693_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsRGtNPY594Q7kNvwEVMElU&_nc_oc=AdpHEDegRYAyZXU5xDAnm1tFzr_MqYrTJ99ovMSTFsdjmU-FLAClA6FyTK1n640LSPg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJh7HReB7tZPvVAxdcWzPmE9vSlVh6JPQT8oH0fAoXAQ&oe=6A5655A6"}, {"file_name": "lunar_lander_portrait_1008x1440.png", "id": "1285290830460395", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820496_1285290833793728_9075054792038147865_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPO5y8MaUE4Q7kNvwFO71KS&_nc_oc=AdpEnAqlWX-G8WiWUiLMlqCrwbER7gDAMSLACowKdUge3azRlcr1_FTR6xw0iIxrbVM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcnox-tZHTR2HcU_TxuUKSLFa4sqvWFIgip0YD_NyGJw&oe=6A565326"}]}, "id": "1764156267893562", "locale": "en_US", "screenshots": [{"file_name": "Sceeny1.png", "id": "960741680225467", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825305_960741686892133_881300046156752593_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhvghlOhXicQ7kNvwFSLS1q&_nc_oc=AdpdYchOv_c8Qa_985soKGLTVL1WL51TL5oPqyZwt3uLntTDU7-xTYZkRkmD46GlXls&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5pOrkeCXU3Bq4SEgGNnCcevI4jt75rVjm-YkpSDEvQg&oe=6A562E66"}, {"file_name": "Sceeny3.png", "id": "2052183282059857", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821704_2052183295393189_4335591365522650145_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKa2rTGYmbAQ7kNvwHrZdTy&_nc_oc=AdqoY97LPu-QMiC5X2_-C6UmOr-2BvjNG1rw1HanPhocAMSzcZLVVuW1uGFoC2utJ18&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBims3-bi_ZrGCKnLUEbv-nT1pmJfTIWtr8deokicskUw&oe=6A563477"}, {"file_name": "Sceeny5.png", "id": "1267464442201023", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820887_1267464445534356_2164339322169361523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLGLjwetMmcQ7kNvwGLChRE&_nc_oc=Adpd2dribZpT3R06qwQ_mQbAAyNxU_C5VfjHArY_zKKIJjmHbJyzpQskaldc6SLkq_A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNvFmKWP9leNEGV1GV-mfWwt20O5-TMl4SE-sC7-cd_Q&oe=6A564F93"}, {"file_name": "Sceeny4.png", "id": "2100103154105740", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820433_2100103160772406_716423615788459326_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bamn3Ecaw1gQ7kNvwH2c3ff&_nc_oc=Adp7PKpy_7RUKQTUNSiT5bTtWZH5ZPPYDaipODQIRET2ni_NdsDIfd0NmDmxami4o0s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzF98f4rVUUF2Jr1Zzvw0U0JIxsMe2uuOh4L-3KTrC7Q&oe=6A563E4B"}, {"file_name": "Sceeny2.png", "id": "1623853012228855", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/585720338_1623853015562188_3069567292380904881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVF_68DIxwYQ7kNvwErsFRM&_nc_oc=AdrRqIKSwLyeF1jg2CVgrWg-JsTsAVabp_IEaH_nVXUDYs8MNoNusNgmSbVBBhovOQw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfFMdrI0dfTfYuUtZlofFymHi8ZJBd8r4vITFViaKdCg&oe=6A5648BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lunar Lander", "keywords": ["Arcade", "Space", "Simulation", "Lunar", "Mars"], "long_description": "\ud83d\ude80 LUNAR LANDER\n\nDescend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR.\n\n\ud83c\udfae Precision Landing Gameplay\n\nTake full control of your descent using thrusters and careful timing.\nEvery movement matters \u2014 too fast and you crash, too slow and you drift off course.\n\nMaster:\n\nThrust control and momentum\nFuel management under pressure\nSafe landing speeds and angles\nControlled descents from high altitude\n\ud83c\udf11 High-Risk, High-Reward\n\nNo two landings feel the same.\n\nPush your limits:\n\nAttempt perfect landings with minimal velocity\nConserve fuel for efficiency bonuses\nRecover from unstable descents\nTake risks\u2026 or play it safe\n\ud83e\udde0 Easy to Learn, Hard to Master\n\nSimple controls make it easy to start.\nTrue mastery takes precision, timing, and nerve.\n\nInstant restart gameplay loop\nSkill-based progression\nIncreasing challenge as you improve\n\ud83d\udd79\ufe0f Retro Arcade, Rebuilt for VR\n\nInspired by the classic Lunar Lander experience, now fully immersive.\n\nClean, readable HUD (ALT, FUEL, VEL)\nHigh-contrast visuals designed for VR clarity\nSmooth, responsive controls\nFocused, distraction-free gameplay\n\ud83c\udfc6 Challenge Yourself\n\nCan you:\n\nLand perfectly?\nSave fuel?\nRecover from the edge of disaster?\n\nOr will gravity win?\n\n\ud83c\udf0c Built for VR\n\nDesigned specifically for standalone VR:\n\nComfortable seated gameplay\nClear visual feedback\nFast sessions, perfect for repeat runs\n{2030666394147829}", "short_description": "Descend from orbit and attempt a controlled landing on the Moon. Balance thrust, fuel, and velocity as you guide your lander through a tense, high-risk descent. Inspired by classic arcade gameplay, rebuilt for immersive VR."}]}, "developer_name": "Sax Compute Ltd", "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYasdCFtouU_ZJbmnlefgy_YNNhTqZWnz9WQtZyGhl7w&oe=6B0B3E0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "207998409939484", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504788_207998413272817_7116371913068249088_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNWTu7cDBocQ7kNvwHIo7FF&_nc_oc=AdoFjeom2JT0inr_ME5DG5-O-5IVEObv3hEbqsGLq5v0D4LQ1HHsuZY5kYL74AN2CA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWrhzKRpAgXGZmisI_mOROnHAW8pIg-cOj0enK-XOzGw&oe=6B0B1897"}, "display_name": "MasterWorks: Journey Through History", "keywords": ["heritage", "history", "archaeology", "cyark", "preserving"], "long_description": "Travel to three continents and visit some of the world's most amazing places that span over 3000 years of human history. Discover the fate of the ancient capital of Thailand, the mysteries of a pre-Incan temple in the Peruvian Andes, the astonishing Native American cliff dwellings of Colorado, and the monumental stone carvings of Mt Rushmore in South Dakota. The MasterWorks Museum transports you to four fully explorable environments where you can collect artifacts and learn from archaeologists and scientists as you unravel the mysteries of who built these amazing places and learn about the challenges they face today in a rapidly changing climate.", "short_description": "Travel to three continents and visit some of the world's most amazing places that span over 3000 years of human history. Discover the fate of the ancient capital of Thailand, the mysteries of a pre-Incan temple in the Peruvian Andes, the astonishing Native American cliff dwellings of Colorado, and the monumental stone carvings of Mt Rushmore in South Dakota. Collect artifacts and learn from experts as you unravel the mysteries of these places and learn about the challenges they face today."}]}, "developer_name": "FarBridge", "de
=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbTfZSQ5GQSRQOlnWvnjztccqRn3WM-gBi2-mOJyHvrQ&oe=6B046E4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Landscape.png", "id": "207998409939484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504788_207998413272817_7116371913068249088_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n1-f3quorMQ7kNvwFhN5K3&_nc_oc=AdpRzMPRC06G86qwxiG04GbrkOyULUztk8bC2TTqL4-vA98AnyewMfP-aF9aWK7jyTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbO5EquRusaBLHXauYROHH7Cc8npWjzXRt9ieXhR3eZw&oe=6B048117"}, "display_name": "MasterWorks: Journey Through History", "keywords": ["heritage", "history", "archaeology", "cyark", "preserving"], "long_description": "Travel to three continents and visit some of the world's most amazing places that span over 3000 years of human history. Discover the fate of the ancient capital of Thailand, the mysteries of a pre-Incan temple in the Peruvian Andes, the astonishing Native American cliff dwellings of Colorado, and the monumental stone carvings of Mt Rushmore in South Dakota. The MasterWorks Museum transports you to four fully explorable environments where you can collect artifacts and learn from archaeologists and scientists as you unravel the mysteries of who built these amazing places and learn about the challenges they face today in a rapidly changing climate.", "short_description": "Travel to three continents and visit some of the world's most amazing places that span over 3000 years of human history. Discover the fate of the ancient capital of Thailand, the mysteries of a pre-Incan temple in the Peruvian Andes, the astonishing Native American cliff dwellings of Colorado, and the monumental stone carvings of Mt Rushmore in South Dakota. Collect artifacts and learn from experts as you unravel the mysteries of these places and learn about the challenges they face today."}]}, "developer_name": "FarBridge", "de
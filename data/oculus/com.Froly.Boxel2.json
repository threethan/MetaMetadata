e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVQnWDJIwfcQ7kNvwHV3mfZ&_nc_oc=AdqGbHDmGZf4z8pJiiAUWZlBOIQqUdJEnjhZC4ynX6Riy411gC0GtIcatgR4FlcXUIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiu6dxhvn-3o0ZJEc0ggN9wnj9as_NZbhkT4UPBwpmOw&oe=6A7B2CF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfEiQj7bR3oQ7kNvwG5MhJ9&_nc_oc=AdrFW5WVtffboUx0L9_hMGfCxv3bwlTydB9OsqqJJ6KaZYgj4P0r9U-KfwFPDmyZ6pQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjXjuoK7LejB-yDWfIrS8mYyXYAHbIcuhsB4oTU0BdHg&oe=6A7B2C46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w7erbsrc3wQ7kNvwHkCoUs&_nc_oc=AdpNtc_NmTLIBP61yFz09Ylp_WQobKRTi0-GPFnEmVnFv-50hPEKBnBBHa-IRchlvPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErslEbmq00VBrS9GPiIEnjU1UgpCJiEaRrmhrKKcGYeA&oe=6A7B08AF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M3tfBwLVcwQ7kNvwHgvnWR&_nc_oc=AdpQT1TP2i-Hu4pTNxJ1x15RHx-1md2Cax_BtrdBi0-RWZZV3Vn6zVYfrGUH6dDkPfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwxJubyX9H4n0GPxmZdMij61dV4igOsQxgjULU73FvkQ&oe=6A7B1E95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpVjJHmFzncQ7kNvwHZAT-c&_nc_oc=Ador8L_QiqLhb7HucQWuJ3r55WvoU5-34zwGhVN_7wpqVZ7dLypydd29gZ7hp0tSyF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaAZfaHv9n5WUmZG1r27_spnjRtfPEpckh9lnNr4OjPg&oe=6A7B0764"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3ytx4tEv9gQ7kNvwHWLt54&_nc_oc=Adq-uPzPIrUp2MJaIUg1G4mtnDb0KMh_Xspddsx6aRANs1jfkC9rswW93V3iEe1HE_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF4x_JomeclGA_oUmU_Vk7Z-vC0g-m8q1VZt306HKg6g&oe=6A7B20BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-N9NQGRDfwQ7kNvwHaSOcI&_nc_oc=AdpjIcMFD14Nlz71aiBJH591RmKTxoxUQn9Pt7m9CTZkepL_e2SxQqeSXQFubfhP6n0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXeVanCdzIS1Z1ROfQYviBmk5XZLEuXjiYCtvEvOsD8w&oe=6A7B14CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlL4qGmxCDUQ7kNvwFTAWkv&_nc_oc=AdpxO3rrEh0zGr2s807KIwdvt5LAag8eC_x8WDxUBAA2foPdimtpkzXsuX_xZcqrIgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f945WKL-6kQ7kNvwHD_7jj&_nc_oc=AdpncZJyjr6LWoseKIED_DpCkuJ6O9rDQ5ifoUzjeJmX7eKLpUc3y49LRSIaU9oGjqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToaTDQP1W6ozkVDvryKC1NBZyBmgKiVBU-nSdW9_srHQ&oe=6AF08270"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URMCumVQvOIQ7kNvwEujbaa&_nc_oc=Adpqzu3ZJh4823s8D8-tfI1TYBzRlewGLcLyPe_7IPzB0cZt00GDmw47UdZ4bXTDR7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV_uKgjIFoR_Xky8paJZuOi9J4X3LVcfuOGemLEtTGuQ&oe=6AF081C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7MUJkjpQVMQ7kNvwES4MB2&_nc_oc=AdoKvrN1mBwtza8JbPVt5fyEHG71bu-ahXUf_qtuJk8FpeVFp-dZ2SXx4RNjubJftY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7SQFVD9KYK7vPLU461AiNwBGZ7sUKYcnz3MX_mda0-Q&oe=6AF0966F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUNJXIXfujYQ7kNvwHKBdro&_nc_oc=AdoacajBq5YOVOOwUH1dGaWnMXjsGsOwHN6tTBmR2l_bcl7XzaYidJhST4LLSzP7MTQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7uWPOaw4wMDfCSaTx_xq7l3Key1TW8pxCdSTZs6pvFQ&oe=6AF0AC55"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDjC27eBfqEQ7kNvwEpqk5C&_nc_oc=Adqt2dtRT93RoHogdw7nKfRaR_o6_WNZaP_CNGIORbe8H_aCQwzoMf2Ya2DvFbBIceU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsRSgFZXXzueB8taLwmz8-_t7KfUGyEGSX88Vi4ySdkw&oe=6AF09524"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJwklmSK0mEQ7kNvwHY3TL3&_nc_oc=Adpk7ada5b3yPV9uviMIwxrzIt1GQce3SltXb-gFwUM2E0ZiYLK_jZB6cUQjEgd5FdY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8NwrK3HI2yeHEilCcrcoxvhVE2oQ9gXngZwPdX3hE6w&oe=6AF0AE7B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_18JLLvrVEQ7kNvwFlxiQG&_nc_oc=Adq_55PdiEFSJkCYpx9l6T_FTabM2zPrWFKy5HdQ8ZcVa_un9QWTQ1xxOMRf9YkH5kw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdKgRJi42l-Sd6HO4JLDX2RYGAHI0DCPbGOUAFtZCtYw&oe=6AF0A28D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvVvI8YdbskQ7kNvwFn9sDq&_nc_oc=AdqSqx0_pzihJ2ZkNi38tCAkJ2bJJ_EnY-U9vl2hGjVo35b_vVA0DBPqpouQ31LH4Rg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f
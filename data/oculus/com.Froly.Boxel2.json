e_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keCsmiGVB-gQ7kNvwENAXLu&_nc_oc=Ado5k2II7x7s6L2SODleV6oHSmB_yArjBf7emg6i8TujU72m4NEsj8omKaR4Djs1G5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gCe6HNxfufu9T9GEBsGxZsYTEMavUCzp1y7oEoTG4iw&oe=6A16FAF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfzyvXIfKVwQ7kNvwG67zLE&_nc_oc=AdraVu2xHfuRAdisKgK8WHI9ncWWERA26llhxP_gc1KFLgzOiYkygAXdevNmI9P2-Sc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sy7EeSBrTgePwj44eOV3S6MxUOfujx72_wTvvCLxC_g&oe=6A16FA46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOqqhIZaS64Q7kNvwEIZbSV&_nc_oc=AdoZX36DG2hSMCq4FrTPxLI7IFTfmApZeOD8cNz0O3tNH_AAIJ03wc0W2lJHyj8ttM8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Ys3ADNyH_VlmC59n-t_7Bm3QxCeqW9KckEvXdrPzaw&oe=6A170EEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY4_JJuHXRsQ7kNvwEgGLNZ&_nc_oc=Adqtfee3UY7PpRBdNHW1jnY1sYeRJRjRIcTaF6Bc8xcCDjJyZrW2KiVbCcj_Z8fQcGk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74PF1JFrS9Xru9a-nN9jAJ2uGeXnzT1xRILQRw443rzQ&oe=6A16EC95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsFdk85q7j8Q7kNvwGSdUrp&_nc_oc=AdpO8L-aztST6sExPm1Xf5DBKxbpZatyLVSE_a6hiawnj5fKE9Re60n2Z-fT1ld95e0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aewi5JMt_DybNRq7HSI3OBEoCBZmGTct5H8yKBUf7pA&oe=6A170DA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbIGF_NNo6AQ7kNvwGF7HRl&_nc_oc=AdpL8v5EMDt_JOcbqo0BDa-icl5yf7e8q19KgS0ebuFyGsMSZ2jDaYFdRy4yUfg70pE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q_reyIgncUFlBeusRBADoq82LVmTfTf64e__b6rx_Ag&oe=6A16EEBB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl2TRtJ1HHgQ7kNvwGAUM55&_nc_oc=AdoU29gvOu5yFdIcx9hLf_XEBegt-sj8DCU5YbQBTNHRX_cnFGE71dq4xGq19MyLgGM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nXhwMEp1wNE6ffv8nOch4MI4KlwiQdZXPhNlxVxwzng&oe=6A16E2CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5OEwUEYgrYQ7kNvwEeolck&_nc_oc=Adrh4FGYuLu4tpfOeyO-whqQYU1lnXVyO_-6EPDrpv18PuEVbcWXuQGlhFkbqDknHDU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f
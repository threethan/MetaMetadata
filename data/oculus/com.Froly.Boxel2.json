e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVRUGw9ARCgQ7kNvwFcvJIR&_nc_oc=AdrdaFTdYaT_Aby7wTGOMVUx-Wjcp-EE3Zq8S8SRByOMR3CC_2Z8iZuJZtlamrz-Ui0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf3wVf8Yvt3UQOxkoem9XZflF6RjJEcdPRVzPI9Ry21Q&oe=6AF719F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLI9XcSRXQ8Q7kNvwGe3Ng_&_nc_oc=Ado7fXzjhxKEwDYsQ7mYIQF_S1LkdhmH8OexhEKgFsQEOvzMwLR3B0h9p2kh2c1Ibyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHPouJBSZAFzXcgNsSbqfQPgPB4Ayz-xT_u3KnwYqIlQ&oe=6AF71946"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ztvw13QFQMUQ7kNvwHe6v-g&_nc_oc=AdrSM0pNwjVq0cTq9u65f3xzV2VYyDjOPmWTc2vWpMtpjKkXHB7Au6OZVSklNFMSswE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlxcPkVzQOgrqMtJk68tvfD-CeeOkQuQlrLUFTFty5aw&oe=6AF72DEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEpDujmJZfQQ7kNvwHl9vHl&_nc_oc=AdrSqpiaayBa-hVC1sJLWZmcCQn3RlRGfR45Xq8COdyATYTv1JAXyDVUwJ4x-xpaHys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQESmgFPtQP73r1SHYzIVpDeBsErxZD_Vf1YrRz1w-g5g&oe=6AF743D5"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA8OwjvaUA0Q7kNvwF--ir2&_nc_oc=AdpHuhsVX2wwpjZ3-9ScZG9Xk82HSSiJJv54E2G8VV6sw1yUkEDiJ3ROdy8R9wpF-eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiBHaQdeDYBnx-32LyZK5xU2GQgHGa-VQTYmj1_WZGqw&oe=6AF72CA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tybPNUOFe4sQ7kNvwH4s1Py&_nc_oc=AdqDw-RCes_eCS1f9vlXFXBMsSxAxJGVueGLem7rJJnBQ8Heem-4db-A4hiLGMaQvTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFU-ixK-a-1_uQOio8BRSs3rowk68wjOB_2NGJBftJ8A&oe=6AF745FB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c1e717lEgUQ7kNvwFNPO8o&_nc_oc=AdqWUo9vdL5evy94La9_8w75dc3GlQqAMombkZijzZ97mK_VW5_mm4LpPihc4mXZ1PY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo25MqGZiQhsaTZTrZAE_fL5xOD7XExpHKaUYYPXwRQA&oe=6AF73A0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acyhqC6onE4Q7kNvwEU5b3x&_nc_oc=AdqS0qkEXEu_I9RN71XSOnU4h8dlByIw8EeQJejIr4q3K2vgF4OUgsfAUupeqHltdoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
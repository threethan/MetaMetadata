e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0r3k_yiDtsQ7kNvwHvhyLw&_nc_oc=AdobxAt_vPkWnW3o-s-EL-m4lAaTbsSBLq-T0Ty9COjKsOKOEfXzy5SaA-RUsY-3-hM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uOmaljsFzoDsgARHDy2QG5iAavO9H_6bTHjMF20z8KA&oe=6A43CDF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=morVuZLR39kQ7kNvwEqvfUv&_nc_oc=Adrr_mvJioeS32c7kMRkq50I-Tg51CgrMnqtRleAOFWS4v5vfUBQQI8T79R4HBVwPLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9br7w04Rog1xJ0TVKjeK3DMdtbglJuavXU_wGHly_u4g&oe=6A43CD46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC1YxVXXZDsQ7kNvwFYrnto&_nc_oc=AdpuQafsaKsbIInE_dZKfgkrKL7YtlKRrExMNwkf2QKecjofCymjIholOJy0R2sfM_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hWjPHRMa4Ky7trVJ-WSEeR7B07AjQyL9NaDru-GSW4Q&oe=6A43E1EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROvsXBrfFQEQ7kNvwFq_8Gv&_nc_oc=AdoPJb_3h9G2xRueIeM3nZwkHR4rSfI_13PId_KbCzP1H2_-LsOwkfjOl1_n-TiwVGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4RXFNmWUrRM_VFOP4EO43JMTVg6XiUXZcNv0xzdiexw&oe=6A43BF95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shSGmYrx048Q7kNvwFVn1I5&_nc_oc=AdotLRJXqC7ep9tn5hHIB6624yT57akM4UUmvKuoLguxiKseVC0Lm9cvK-AKzKHfy68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89ws7j9XNsEZlUM2R5IWQDAiUcDudYgWN97SQzvgHcVA&oe=6A43E0A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2Kg7FTOHbMQ7kNvwGWkuRh&_nc_oc=Adru1H2yU0dVp67k6ubhjDZlX-Sr7VECBpNOPIbBWmng76NJntAgSuJdDoXtR5amUFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A17mglJxXHr7KBth9tCkXGS_I-V8JLIIelOOkAHzEkw&oe=6A43C1BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVTasKswkawQ7kNvwH9Lt2D&_nc_oc=AdoqlY7xK5JTVasr0g67-J6EbQt66XyVwf-kG57r5_674f4bcccAT8rv_QK7pWvmf8k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97zme2AFEh5Yzv5EQcfA8g8WeUF6FJWzsqFxevI11PDg&oe=6A43B5CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3zld0gZoLkQ7kNvwG6tG31&_nc_oc=AdpAOjDYtMEKafzfJUYyAGW3KXy1VOgYfPsJt1I6l59RVh3QDhVzf5e93KoYZgHpdCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
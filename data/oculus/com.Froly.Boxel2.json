e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9yzr5joUY4Q7kNvwF0qSTR&_nc_oc=Adp6OgNkPHGOoCLCVZQRR1BaJ4VxtdcagJnXJmLp6fZmd8j_ARnOnInLfa1d_uZRKmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pETmv7sSf45D1oN0Amvb5whJLolzCaLUOwnK21PvucA&oe=6A087A70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9ndhyxUo5gQ7kNvwF5wrDU&_nc_oc=Adotz6JCVtkd2ykbnoagBKW3mBGALpvn2A1LiC1qyP6tW0dRrkDF6_lwsv3sCABjMn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fNJZAkbfwP4tVk2zOT3c8sHjFBSQ7ta8PoH7HChPktQ&oe=6A0879C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO7WN2jWmA4Q7kNvwG4QWnz&_nc_oc=AdqacXRsRxUV02bcCh1f06a4xCa0o2ZiArdOaoyRXa8GuGSv1oCbcHxS2-nuiBfqHtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y2I3jvjkzQCLz76lKcouD1Za0QUVgiPeP3XKiH4VHsQ&oe=6A088E6F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIWjBLqn4cEQ7kNvwFfJ8V3&_nc_oc=Adp8yPpx2y-CVeKmugxtZraTy0iB71tMMqTQreIaE8tFyXSBqxyAE0OcYRxBm9_dKzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kDl0SpHhzTiRe7BOrtalGUCj975Doij61Ir4WPbsIIQ&oe=6A086C15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqwhYLiV42EQ7kNvwGvZXvE&_nc_oc=Adp6ev4yqF3_vK4JnKjnx_dm6IVfjOg2T1ISGJe90wNPWHGGlbdEYJkTKoykJODLOz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q8tlw-taw9uI7CL7ny7yF3Utq4HVvCHoWH-786HQYZA&oe=6A088D24"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDVUPY7hmQEQ7kNvwGBwmzm&_nc_oc=Adp2OyogyiKJUYFkaX4WVagIBHiL7JQw7mCMHIAKPmNmGhSbFq3TcQNCmAvk5r3Txxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x7JheFIxLwdmLm1kVpu8bRnoAcakUIvApoGIIKKO25A&oe=6A086E3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MJ-lumTy48Q7kNvwHq7Upq&_nc_oc=Ado6IANRKnnV4NXdFwZpT8raCYE8roC_K9VTkCdpaSiG-LiL8j54PnG2Iaz_LG_d54E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40JUc11ItNwao4x_R9VzjT6itZ84jW1ANzM9m-W1H-Aw&oe=6A08624D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcJDVZv8e6gQ7kNvwHEfgvV&_nc_oc=AdrUEkxnICFFY6o0dQ9XLGUx0MawRwnVwA2fMWyFYOrJ3cbV_6Nhkn9sf0_s57iGFaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD1AEy-n16cQ7kNvwFqxOIf&_nc_oc=AdqL3B1ZWRRT9oR7oiYDbq5SEQb4JcGz1NF7HcQg2tI-lZsJxXRgqROGbWg_i5qhtRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eMIARo03_O2sM3ZHjf5HzSzMar_fmt9Y_gva-hFNiKA&oe=6A1EE3F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDNwZC3wUCkQ7kNvwGfELDR&_nc_oc=AdpQDQRyPdQwEYf4TkFclhoR7suy7JkNcxnQI3cfZey_ZXGwHyLL84YtysbhsS6ZWl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XhP847GlEfYsbykUmu5YCJaAh-jVj7tsTYePXEHTUZA&oe=6A1EE346"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8BXpxlAXEIQ7kNvwFqtQx7&_nc_oc=AdqI49jP4hlOBHqlaI7jGHGOC6MkpeAVK5_egOfu_sk-fFCbhPP56uOxUGsNxJjfXeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o9q01zcmSGqo3roDIqzCqlhwapQHgKTqMJibD7DwBhQ&oe=6A1EF7EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVNL6U0d-a0Q7kNvwF3WQA6&_nc_oc=AdpZGczURvZ4Uhfmq0kqAVOWSRsoK9tx_9MNC5ZGtr3V-IiuMPI1QGrdu7VvQMwh0kQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EffERNqQj1waam4zDRRdBcahqkDVXcbSJd7za11ewBQ&oe=6A1ED595"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jELFYIjRhWcQ7kNvwGU3wZS&_nc_oc=AdrGhSlVoWoQxOY-JE4evAmm5p846Dqvf7Rb2A1PxTBHkuAVBhmZgu9f6bIkwTxz9Ug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QyxVqG1JT4ZCH9H2wm9gbbA3JxcAq5UifyfupKly3Bg&oe=6A1EF6A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx6IuJedxBAQ7kNvwHimfuB&_nc_oc=Adqn4_foZNurAFvWSTmnPUgDE5RVbbe_o3McE_DZzmtUIuHWOpILujBHloOY8q_eOz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XHw37r9Ozxz0iOJRr9oSVYYvaf1dKUZ1R6MoNVKWjzw&oe=6A1ED7BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRCxHAugzicQ7kNvwEII1Ek&_nc_oc=AdooGVOem7WM2BM7D0XyZ9FXrAXSw27hIVUr2oJ5m0HbFOZqom_nD4xx46eLcVN4RTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wIWwD6mPki5_h7afKtk6r-ErahqvKg8hZKqEC6CzQEA&oe=6A1ECBCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iFPeVBQpdUQ7kNvwGZY3lR&_nc_oc=AdqdXj2aTtxNgCUG7zfCeKwHgZlmVRlQSWJiv_JFc10BE6au0Pr7NptGqtAVpURilsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
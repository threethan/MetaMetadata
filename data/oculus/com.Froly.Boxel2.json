e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyjz57fycRQQ7kNvwH1GVNy&_nc_oc=AdrMGgDBpJ98YHKE1R8ArVo8nQvfrwB3gAjSyA_AybYi8rgiZAWhZCQBAn-nid9_LCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTYI1epupSWZ07iZAXnX43_6ewimjVbCUEnZixup6Mjw&oe=6AE9EAF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7zuoovpdBAQ7kNvwGkqOia&_nc_oc=AdqT5wLYFnY2EHR0X1_c9DkEhkFFxwn1i57MP3mLDKN-hcREEIF_nu2DAVo3w31JgW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2oObVIPgyb9HupujtQUcgdR_nf15Wnom-d8z24iF7JQ&oe=6AE9EA46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAVNmyiJ4QcQ7kNvwE1caZW&_nc_oc=Ado-zERHSH3Fs8XKRsTEStQoFXIoSBwnoxRfcsbrYdOe9fGt_24IJ0OJzAa9HP4ITE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT31MTRSjeEe_DHKyw2smSw4J1yQe_Ffj1t6x296eIBXA&oe=6AE9FEEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUj0LwVjwtwQ7kNvwGn1QtZ&_nc_oc=AdrXYWOa3kuI0OI1E9ZkxSPb3E4cu0RhoJhrYjSV3BHwXX7zAnpvB_DEbMjyLhCYzSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSknwAZt4E077RJsPD1HBVQJg3DmcbskAJD_EXH9jonnA&oe=6AE9DC95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkRgN3vO2hsQ7kNvwHCXG4G&_nc_oc=Adp9-rjsN0mAsby9Bb0K1Ve0s9uIv5SNhMBu6q_xa22e2VCNFGV_xok_TGL4Lr0gE6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFIkk2xJqTkihxxJQnVEM9Ye4c8hEz5yzowUVzjHBnlA&oe=6AE9FDA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ3tieRyasUQ7kNvwGGLywz&_nc_oc=Adqfp-tif68UfPC_elg0cS6heCy9R2CeL-mWreJT4y8LuDhTsm4PuTn3QustwAr_gFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3kW-3tajqVS_4QGudcyP1WT9OkwgfN2sIdzSeQxyh2Q&oe=6AE9DEBB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IxXTTiksb8Q7kNvwGl9ThY&_nc_oc=AdogQyVAKBF6ohcW-qQacVkoGmz9fG-dSSSCml12NL1UlWatHC57VtGiNAJgJ0mp3aA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgwWWgcCi0DzJvggFKISVCn7IRFCy5BO-J6LKX7l1rhw&oe=6AEA0B0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC1COOfBGKwQ7kNvwFZtz1w&_nc_oc=AdoqBcG5y1_K26R6CEYzbOax3xQVoxfFv_DbkpuutevAWLJ1YKRCujUD93MV7O46bMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
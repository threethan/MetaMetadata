e_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXT-YWRHodkQ7kNvwH7E_X0&_nc_oc=AdpVhZghrPkRBec9rZI02aj3ScBcx0rzYe8DKu85dzpD91yS7bssyTCwtxCDRKYf0ak&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwW0xHde4kDYpBaGHkIXislYnDHB0AwhjzA4rhv35ZXw&oe=6A58E5F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM8-vhQi8PEQ7kNvwGmHB_j&_nc_oc=AdrYaqQh4WOQec_dpusUx1raGJDsoDfwEyC_AXq2IrxXAiWU7Kmqfe1Mfbn8L1GIpD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6zKjrexnRe3it-5l4hkkA-RLu1T1rR1ANw8vk1vCUsA&oe=6A58E546"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW0JkXXRrSEQ7kNvwHjeh46&_nc_oc=AdrNnIN47nL_xrj5Co9GsJLXvzvFDwxAXFHGYKbVc13h92UXMft5YiwjeCh6PdOkAfA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUZ0l27K06ITtN2wcSqNUl3z0d7O_BJawSr7eE2OwuoA&oe=6A58F9EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIo6CNxJWUgQ7kNvwHzpPY1&_nc_oc=AdrQh10AVZX1z5DtmdH6GFR-YMNQXqkri_urk-tY2AxCpa_4DFgxEd52OGRcK0b4ZSo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXHZSTJ3Gm9SyzAU8pnDNiBrEkQjfhpPX7GNU62inQUw&oe=6A58D795"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rEI6sPBqtQQ7kNvwEvLi-_&_nc_oc=AdoRBSGKVBgvHtODYV7vYX9pCb3kcChIFXPnswhJcVNtEugHkSHj7_lv_-E1yjScjqI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsnZctRm91aTg9vPQc6F9b3xwTSRrWqd6VXwduqWB5Jw&oe=6A58F8A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ar_HTsQ5p4Q7kNvwGy8ymB&_nc_oc=Adr3cLgTpjr0shtoiSG5NxfI9izrFAsWnuOErKdplsAIXwAPIMhTlIJyR2wN3_A7tOY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQGiaWz45hB0f3yVPorlSivM4l6JBVw-yxD-Ws_rX_zw&oe=6A58D9BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQJA8gDRCfgQ7kNvwHrteqY&_nc_oc=AdrY8tvC7hZz0XGvfXXrkGu20WEj7trtyjxiuBuK-SpcMnpNMnVXtEJYGcsdbNF25xg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH4Nz9iRohUtzWUF5euGHrJZWljOIfR48Z1KGwQ_i_Dw&oe=6A58CDCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLgdz0eQ0dMQ7kNvwGZppOE&_nc_oc=Ado3mt7glPF7I58p0Om9fBogzAF1qF1TlUPLD0RIUNkEMCygMMr4HRAZzuVmR1-MzWs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f
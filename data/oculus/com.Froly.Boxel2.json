e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daiv-2DWuF8Q7kNvwE4_HDg&_nc_oc=AdpNRswdWblcNu1PHAcO_YldLZrCcKssKuAqVmMORWCfUPegtuL3BopuwaDQWcKRoAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQrFNKarWApk3QIbcwG3CbRatpr9qEmJ4kxQf0AOYXkQ&oe=6A676670"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3ZY7XRTlZYQ7kNvwFAp80o&_nc_oc=AdqLOIwzF3RNtJgNNwi0IvnvxhrXsmmfwaf23QKCo8wt1HeXi_wMxzQHFfu1BmZaCss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA84m6axac-sHTnkhFcaKtyhIXUFWvv014g1F3AQVISQA&oe=6A6765C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbHcUlqVB2QQ7kNvwGNVSgk&_nc_oc=AdqqO3VTKhHefBnv9eaaVrzyGWolTzjfnFVzGmXOuLaQR6RhzuM9i7NNun57E88ETaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4vAZA1Y44hY2dVGpcmln3jAvdaJyafiZUkeKcupiPoQ&oe=6A677A6F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leoWp1thZuwQ7kNvwEQmz5I&_nc_oc=Ado5XCPWavjNRJ9qYgCHyd_io47MG2GgbzJI2XK8fPkVwXQzA05RjlcUiiN1jiceITM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAenHlc5KtcVJ3ovv9C5eNP2AFJgk5_8tUiDXhZOjiPHQ&oe=6A675815"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBsYk3lVT1EQ7kNvwH_uy4Y&_nc_oc=Adp0wL1MxBAiZPH3jHi-Ad1KqLARWyxZrN3b_IszNpSzmw4CuZ_UGohw-lsAZixUorA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPVEUZL0nDUMHzbdKPJbDu5dZ1yZEKQjohrodvp-H-nw&oe=6A677924"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ4zPs4WyZkQ7kNvwEOxFw3&_nc_oc=AdoyASCTmdWC0VxUZ697RtN6SsV5CT9Hnjx_lvNBTx9GIonJ-W0A9B4iH40xxv9Z12E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPDDBMp4Cexu-ABHmE_4uRhwmQfjL5EL5yuYHoOu12BQ&oe=6A675A3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRxFfw_wIa4Q7kNvwG44_G6&_nc_oc=AdrkYoXGt7vvagh9Sk9oUX5uzccrX8mV5-QK6YUSvjjtwpYUtAaFSMrikzPRGoCLqXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt0iATOYVMQQCesz4-rwGeIghybtoRWVQ2xHhGR0vjUQ&oe=6A674E4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZZsortaqd4Q7kNvwHTqhuK&_nc_oc=Adp06u2MjFzPQgXDAeMfdnPttDKvf-iPenrxwmwbuaHZh1B_96yrMdzCBr6CRVPT7dQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPJ7d2FUVtwQ7kNvwFkeg52&_nc_oc=Ado31TlhdC8ZfFsFEL7FBlNZgbLYJvjZJ4VjZLb11C4rFpgXECJ7P6Y5AfoKuQoAKW0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELIknKHrw6Zdh6eYyoUfCp_l1Wwxkb0DkGr_TuAvhnYA&oe=6A81C470"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnmwvrU-eaQQ7kNvwFQgDMm&_nc_oc=AdqKly5sWOLKauO-3JRXw_uQsf5dU0_ufV3rkpLUY6lbR055xHMZBSLhJRdYIYxdp48&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-Pw03GbXnbSWU6_pn_8g6sRZB29CC4wk0X0kf1bukSg&oe=6A81C3C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFemd4Y1BT4Q7kNvwHhzL8Z&_nc_oc=Adpps64orprn02FWFDypJqFxfPTQ3YvNOgn_sUwqdmnTpfQE07DHWf_iJIRYGoYLXeE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa_0rCoGBnvubGp0YQpkMq8e-TJqBejs3w15Lw9SsNnw&oe=6A81A02F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeiUhASEcOEQ7kNvwEj8Xr3&_nc_oc=AdpaJQEGPvnZXEc8Jl3hOX34ExWanEGO-B67JWenUuNaSyiw2cKSEh1j0VF0hohLxMs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZqxvWqmCbxL-T2KNAYj21VBl-nSmpeP6x-elxB0lbUw&oe=6A81B615"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz3RNO7Pq4kQ7kNvwH69kjY&_nc_oc=Ado4SO1N3yPa9UTEv0wBmDZyD5ehEwOSR-wOHuKh4TMXd9ROmAtpB5tu-VJ-Qvb40e4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJZYU4faj7QNihhHO3COiIsd9feQcnbWjAIPVEac4H3A&oe=6A819EE4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-zzM_51xDwQ7kNvwFUJwDF&_nc_oc=AdpxpHP16l9wOD8p27vy5tj7B82JNwT3B0xMwG4ctAwduKuEfnAgEXhk7XWNzKRz9Tc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTb7i3Vww1SbXwDUp2LVIsECcZEk_VYin6QGK2f2XOHQ&oe=6A81B83B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-hgtZ6UfJgQ7kNvwFw9JO3&_nc_oc=AdoCyTropSFLuhyituX2E3XbQq8eQVd6-hbdfwfrtQNDxxSB0zcuMkqKyMsZfbncZLU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfU9o9vvDqpalQz529B3v4s4L0LU_SuFwhwsH-tzLKIw&oe=6A81AC4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8Dfj8mBpwQQ7kNvwEoybMe&_nc_oc=AdqEjj7BvntaQYQ4vXTHNhpqBH8ko5KdxHHi7fR26RXRZYm5mRQwpigPWa5z6D4uK_g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_tHhWeTHO8Q7kNvwFJ1EBz&_nc_oc=AdrLG_kJ4b3c51ipTElF5LpaTdfA94IWG9qGGgavz1_K-4yFFNnl7NphUCPeo4NrKsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQft7WjWD8c4tBxgkow1WpLtZF7m__5Sze_AgWe1qB2GA&oe=6AF32570"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84ippZQA4BUQ7kNvwEO6nVE&_nc_oc=AdrY32nyRmeWreJQB2uFCX6y3nil5a64nKZzNPzs32k-qa9cREVKTTMY8pgtsJvGn70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8UrzQcIIkw1AkH5kMLST1D3tu-WNfSoAc5pS2XYKD_w&oe=6AF324C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKTeBbNRAesQ7kNvwHKJzcc&_nc_oc=Adoqsmtl7syJPG3SKlXvwXGZ9L9kE0BwpVpTQ0_pNT0bCIRGofRozCU2DDYq3TlOphw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXboD4k9E2Xu5X9OrBk-a7xclEMjWiWnzgryLnCSYFwQ&oe=6AF3396F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn0OiFiLeicQ7kNvwH58lBw&_nc_oc=Adpyq8ZG1xtgIs8ibMJtdw8TDILq72GK7IAqeAn85FccTF-dnpyznQdtiTV-rG2NZ_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmYNrtKK5XKgnaPFPkqS9rCw3UhMlxWg3urTxoSKHsQA&oe=6AF34F55"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNvfFlcPKtAQ7kNvwEsuhXO&_nc_oc=AdqTEjTurfgHtHFte0e_8tAc14vcSRHB5q5Hs2JfrEZNssd4_eQKWvu79XQj1DH_Td8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiDuHkZQq-la8SlWEGzZEnz8oth-pDlaw9Io0i8fHFlA&oe=6AF33824"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nsc4nJwLVncQ7kNvwGYNReh&_nc_oc=AdpGYhY5l_s6GG66hUhMaXXBc57TRmTDB__SqbHTd5y1uTbc1psvfFljnZ6JYXSNVXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShPfMkdX8womH1B7rMqGg_kD4dLkAI6rEHLPL6YkmGmg&oe=6AF3517B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUEf3zbeay8Q7kNvwFlONWi&_nc_oc=AdpqZW0cWKqgoHuuDW3Oi7lhP5uTBgTFzFtO9JAtnrkm_FX2GOoiIqtbXwvDTePFZnk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB1gPrP2tZwxeohBljcyNK_rvgqYJKAnzo76Z-TT6slg&oe=6AF3458D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRJFq675FBAQ7kNvwHhAYG_&_nc_oc=Adqqd7yrWlU7C5DNKD5c6aQSJyfu3yfieN4Ru6s4CETVnJCSj5N4e8Mge5-yZN6lTew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f
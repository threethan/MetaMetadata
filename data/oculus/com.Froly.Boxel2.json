e_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnhUsZMlzyAQ7kNvwGPhoIn&_nc_oc=AdoIhBUYZq54frP5qQO45Nefb9A_y2ad91MzL6Kz2F_Vs23u-itx7YnLt8-MprAwMpU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NhWDQWsn_P7-NQJ8AGDMMORiIYdLYh7jXtLb2TI5MEw&oe=6A32AA70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAouot_wWdcQ7kNvwEYmsvm&_nc_oc=AdooETHvdN19Uovhc0-UOcZ3KQBLNESFZ2iCiM2wAems2UWP6EST5FI6DJc8Aj8QU6k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xQqgf4qymhNj1Sujaz3ia73KQ7WUhr6zTqUk-16U7GQ&oe=6A32A9C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGEWiZPQakoQ7kNvwGEylmF&_nc_oc=AdrV0R9fNyZwvh7OukryHRD0GtSxsWVFoEbEF8_3oH9BpyfVAWkRhluTBdUb6UBj0pg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tpTo_oZ_GDBe4f8L9tCb9dd3k4DzYlXYtscCoWg2elw&oe=6A32BE6F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdnKxTU7dpYQ7kNvwEsMQGK&_nc_oc=AdoldsnIIqpIXcQfTRm-JT2J5Yl-v7J1bqhpe416iLN6QhGXATi0p_q5BhUG3AZGRvg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yE05FOyNJXXTNDT81h1cvYXQ0NbVhzy42DGq5yU3kAQ&oe=6A329C15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg8GJ4zhWFwQ7kNvwHIL8Jn&_nc_oc=Adqu-cQeBZI3cdIPPVsz-kVHR8x4K73nj6elu8a7LpaKc73bkgJ8rknaJvNulJh-K2g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kYnKlgnUU17QEXGJfgCeqH5sGqErgBtXGTlkkam6F2g&oe=6A32BD24"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WuZs2HxCDcQ7kNvwHIJz0r&_nc_oc=Adp84LxQPMKRABKWhNoQY0ObvASzmaYuMLz94r4SQ7E02jDuXf1UF-kAxsU7WvwbWBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af838E4dh7Pf9KRHm8l2A9Pz51jB4scjapxZI0yNWXHbdw&oe=6A329E3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpxLuh3mGh4Q7kNvwHnSg2F&_nc_oc=AdpiQGp-bhHmHaH0cs_5MI-rkNI6mPw1ZdIsAI_aLvDGX2dbz0d_6arnnE0oJ_TikGQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XXEVOwTDTm5yFX46htFj5CrCCxi38-bY9N3R20qjMcA&oe=6A32924D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjyet19GG9gQ7kNvwES9TQS&_nc_oc=AdoRkMu_BZ2JmeZ1DKp4AOPlXBZfECHULOBmYtZYlYV9agq2G97E_-gI4skUH4WTuww&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f
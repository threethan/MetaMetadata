e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PgelN98z1wQ7kNvwHDAFIy&_nc_oc=Adq_qC9Xy-2iHBqxubdCcsjrvlG8aVWIgFLY_okFTiXL9fs5ArUGecOKd81yWqB1mCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W_6eOB6dxUcE6sWCSA4DUxeGl70Y5SekbyNAOPZbITQ&oe=6A47C270"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvVrdRuo1DwQ7kNvwGSAfou&_nc_oc=AdqJm_jEM4uzEcATruIQzFYIsj3gCV97doPa8MMcteGTErXbk5KFu9eBL87ceNczDso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87uwxRaTh6qJqe655UWrYuPKgIXrVMuLQ3llBduJMsoQ&oe=6A47C1C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoXtlcZN_TkQ7kNvwHmHRDU&_nc_oc=Ado6sOEm2r8WUq0WspIPc3t_WDlfmkIbCGs2EpBs-aBTsIRNEJ-6nw-FwOQOWneEho4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83j2wO1LSDXZeQhXEJFFyQMye_FtHxAfaQ_x2fP-mT_w&oe=6A47D66F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5zNDvjb58MQ7kNvwE_nAc_&_nc_oc=AdqijWlk09RiR9diWD57jE_JB34xlZzhQ0L-Wfrl-6DKsVA2-8reetKz7jV5FrzJ4GY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gNeKCoaiIVCmHunkkvHMKHUcxaqaC9JLmo75s3HrpXA&oe=6A47B415"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0CxvXb42dgQ7kNvwG9zGHG&_nc_oc=Adp8Dtg-I_jZvmECVNLj8-VXVfopxY9wuzRD9JX7Cjy7f7wV0QYhDBDov7jB--KH0FA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_USXtCSnxjodowSoircErPsr1vGUU_k8S4NpoQCJoTbQ&oe=6A47D524"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR8BPvk3fg4Q7kNvwFBgZhE&_nc_oc=AdoJGYFgREdGIPKHtj_pMWIQCAx1QhMQ6tm9BzooIg5moFx-ko5DUYPFiUrUM2sC2rI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5D2KddacvDXH30paJDLERZ5l2T1F8dh2-tBQgd6_7-Q&oe=6A47B63B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiFfjNr8Y5kQ7kNvwFCdy9T&_nc_oc=AdoImUAyZRYUG8mSzXZI_a62ch3PCKwxLydbWx-WrTEwStBOuveK-XtIqw5hZTSUkwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hCi4VBQZvH2DpUovU_1SCsV5RGPzegtxVcTVFjSe47g&oe=6A47AA4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYt1FX4PRK4Q7kNvwFR1psb&_nc_oc=Adq6T1XVFrL53AuOSNLSm12Ygitdp2Tgvs8WNbm7rLNfoQfflUVQbvAzP3M4L_k4zwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
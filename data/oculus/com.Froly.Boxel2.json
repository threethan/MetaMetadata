e_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14coqOOlA0kQ7kNvwHhaKlM&_nc_oc=AdpRJJT7HYq80_VovE5Iv7lTd_bqp5MnfdrMuJfwVVqPkkdehR36SuBR-gdU2bPfURE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATyTXI8sLlvee3dD36AfMeSp_kB7YFlWJiJWARPmvZmA&oe=6A54F170"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q9bo28gQCEQ7kNvwGlzHCl&_nc_oc=AdqALYfi_6QxZsB9_UMfhwcGmiNokTCaejq8-SUKhie2ixrezd4g7bXfk-qwDH9M5vY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMD6D6eYRL2_5XyDUgFKbkVj9NWKMOhz4XzxfbdXdEag&oe=6A54F0C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o73Wl4u5XHwQ7kNvwEHyVAj&_nc_oc=AdpfAs_8dxo-aEoyYA9Y7B-A5FGRZOWjnslo9lhPdFHjYWnGq0Pf5iqRH_duRHMKTlA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaieRI72pvLdPsE52l_GW8GKaXGHzzd_MKHA5S3GiWlQ&oe=6A55056F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaoJqJlhz5wQ7kNvwF2ck5V&_nc_oc=AdobbF9kNMWv5LCmZ99qWAmrxya0SlynxDXZvcgrHBmpkl8Cskt8hXVof01iHRuNDRM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFz9xK6Q8iM2GJOvHusggjBsu0H-a-FDtO0u-sM45png&oe=6A54E315"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rEI6sPBqtQQ7kNvwHhsM9i&_nc_oc=Adp8i9gw3ov56_H8ZOnR1_k1SsTfSZnhBa7MCxpi2cTxgKSeoE5lqkVi2dRm5toayYs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD90t8CQWWHAIS2cfKITDrZfFrpxGno7vU7sDMg7FsrXw&oe=6A550424"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0JW-FPtkA0Q7kNvwGDrXtc&_nc_oc=AdpxqSdrt0UemUxVO9eo_QR1eoVlrDCfeoqFzm515E-dJsDIJHxwU0laQjo45ddveyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6kMJfR15OZJEUxH5OX_v2_3oyBn_eOgLlosLETvaF4Q&oe=6A54E53B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcczJ3QDjs0Q7kNvwHK6rWq&_nc_oc=AdraZypvbFy5WMlvfV8vcf0L1X8Xrny6Jb6vefEzbI6885PkC1qxIayq13fmFz845Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAaOuDrkWs3qckm6utBOHDFz2z1uKk9A9oBv3Lv5OCvQ&oe=6A54D94D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vflSOLCYlrsQ7kNvwEYHheY&_nc_oc=AdpA48YH-LCQZd0SjBTg_4fx2RSpePgGN68wPW330lPI9xP4VDHLhn9E0HqIPGmA71w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f
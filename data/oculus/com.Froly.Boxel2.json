e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEpP7yYlGSUQ7kNvwG-Gcit&_nc_oc=AdrdcFW4TqWn99jRRdD4uIpS57_YLMbXOg6F-MODrMT7PdP15Ak0jvfhJeuhPpUM3XA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn48CNp8RwhKMdLoLhvVkCnpwHTWDHpFPDBWtSy5h--g&oe=6ACA46F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IShYK4XzV5AQ7kNvwEcl0Rl&_nc_oc=AdqpSFgr69YFCcTlL5g_kvD_J7-g0le5mHqAw7KMIF9QtOO5Gc16K0HXvlsh2otFevI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrXbCDcqfDdOnS3xTktgiOrr1KKEdI9cH3LtpMYa5EGw&oe=6ACA4646"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDOJnQlCXBwQ7kNvwEoFJqG&_nc_oc=AdoJ-GD3kMuYVVSzDTOY6rdWia9VYEldiroZh3zo853ygt0IURbTzqKyYGxyZxnMU0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiQ3CDM0OEWTyu0gtXnCp05MGGn3j-MlJcfEJTCWUMAg&oe=6ACA5AEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzKCgtYBcTAQ7kNvwGq3Hl1&_nc_oc=Adr7TT8THCNhiwb_cFZ1BGpRHrkXBEvoWUsum0Qhyu9GtH5GXj_bWX_SlIbcigfIBYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1s3oy0ZQMYRpvuyq7LvQkw3ODmfZXDZp-0vbGbhSm6w&oe=6ACA70D5"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pXBsIzj3r4Q7kNvwGmf6ny&_nc_oc=AdqTsnxQpqXHkvEab4uq8zM63QyxKtal1RXGyXArIhzy6I0e6JXWucGuid7Qj6CKr5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6hOX2myKWbYmkxuK2eAC9rc747OB8rdFxCowt7kpRdg&oe=6ACA59A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AFDWd51_0EQ7kNvwFDNy9w&_nc_oc=AdqPboi8wSHD10Ebrq7xOMyVfoV-qzBJDU_EH7FzWBLwOpPCn_TXodm6Vxoezfj84Ug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKE7cISlKuYdUuEqc2z3fReew77TGX7LOSf4LbKchvmQ&oe=6ACA72FB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YENDz-CHS8YQ7kNvwGf-E6p&_nc_oc=Adof9sA28neseJDdm2g8Q95yTCXs9YkQZ6ml3dfuBO68YmKiH0gBzzDuDuy8Vibx9yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPotrRE8yQ-4_9b9VLx6TN5PX4js6Xf3M4Oc9gwdrOqZA&oe=6ACA670D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_i3k6lGkSoQ7kNvwH1Ht6h&_nc_oc=AdrLTO_qPIZG1y21OCPOb3oBuTOtgz7ZRYmatc5EI9eDeSHsbWTet1TGAHm9aR8aCNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULO7LgKBm4cQ7kNvwELsF2a&_nc_oc=AdodPEn33qn71T9bXxnUr4Y26ZVXudbBUffbdZ6CGsXn_iAb8_jDe6uesiTU4mTFlP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX3Dpd-Iq4tnkF8NydxpM0tjix_rdB6ampINUWRm2DPA&oe=6AEDDF70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URMCumVQvOIQ7kNvwFmmQqj&_nc_oc=Adr7QGOfFupt9LN08yhnwIGMnYMyPlSpooqXGkEPHnXSUbQUylMuLwp-Sh3H--nwNjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThiRLwHfEtLu7RRUREqhp9kwF_b5pKsEh3QvcK6OJB6Q&oe=6AEDDEC6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7MUJkjpQVMQ7kNvwE6VOKk&_nc_oc=Ado9LtScTRPvyHEE5Z1dPHWhf12GH4GVhjDtB8Paj3vhDiM3yfr6nQ1EDzHEh6bRHnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtY6C1QoShbL2EHZSDn5kLagL6IviyUMnuK6alZwfiOQ&oe=6AEDF36F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNqF7kYBASYQ7kNvwHZvZek&_nc_oc=AdoFq4kj9B6_JPvZvR4MWNcXgBDMQw1cybCI5XYxkBk5_Hv-w0ZxsRHa9UHPmov6SoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4A-xaxulcIpMrPkao-_ZYs72y6huN2DnL0KlfY5Q_xA&oe=6AEE0955"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOYW1C4dc5gQ7kNvwG8xpHC&_nc_oc=AdplC9s1rDUHruvpt8_zVyRE4h8qa12sVAhYEgLakMjJ-q7J99CZwUSfkAIwX80vQNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-6ynANC1_PoI0ffNIK3W6DkGlVxE2E3CLorPpmrGa0Q&oe=6AEDF224"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kno_kd1iL84Q7kNvwGajlBO&_nc_oc=Adoic8Jawl90Yc-QrL7numHSbuA4Dt6VWaVvaU9tKLR1i5TEcja1sOZ5oTBSsGmMWlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPA3WtXoBWwxxY5xt_j8xCzIB9oZL0_GFybCZXaEEkig&oe=6AEE0B7B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_18JLLvrVEQ7kNvwEDGvwO&_nc_oc=AdrpAnS3JdBCePOnQ-dZv9B10hKFyPv3mhBCLvESrP5g4Yc-FfRynWK-kgvvIemvS04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg9Zto01WprqPv8z3YJd4RUZIGUk0GRQ8P0wKBYyIosw&oe=6AEDFF8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdCyaReCgbIQ7kNvwEQkW09&_nc_oc=Adoczfm3OSdbPZ5Tsq6yguiyjJXLZ1VUdcZ-ogthvot2RoPxSuavgY16w73z82wYBr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
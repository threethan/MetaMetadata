e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbY60q5X4RoQ7kNvwHxHbMJ&_nc_oc=AdrGb1aAQYm_J5UeVvYxAVoqPJF9upIPOupmn-NLs17mNoH7DQO6Qs59hxKHPQtqwsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9k334p2QFo56PLXxomYH1u8QcfI67HOOSpgfR713a4Q&oe=6A75E6F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2BfOt7G9TwQ7kNvwGU4E7t&_nc_oc=AdrM5uCxzihBhDzM1qsA6iK9Y-PYHM8X67y8habSB8rZ4HYB5MbAxbtUogFcXvuYb4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt83csAGpe783PM4Jflr7LkE7tFzJMtvfOKvJE4BbHHQ&oe=6A75E646"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIyBfmXTHHQQ7kNvwElIj4w&_nc_oc=AdrYTXAxXDLF1tB_YI0XmPg3CRL71h54ONH8WGpMW8Q2yOTUv97b6v6-BKzLhEhrk58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-sZHJZJNZfW7B_9NP2x7MC8YhSbVRWJSEzlRtSK5VzA&oe=6A75FAEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF7rzVpHMyoQ7kNvwGQKROh&_nc_oc=AdpEarqNkFq5Jfd-d3xOxHkheuxn8dOjNKxY8lcEo8osgQfyf9FJ63VNpNaHD6adgXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2NcgdmFtFZMI_tyOnYKB9rXGy0-6WBg_fcAn-RFBuTA&oe=6A75D895"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-Sm6M0BQuwQ7kNvwHW3WbS&_nc_oc=AdrUwUKh6ZdY2CXdH-6Lnh8ECK776GjQlQfrYs0W5w9Lt2uTobXmHiDU-t1u4iBBlZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZF_Y4g0JQ4WWg9A-OKeKIXFjAVYBQXBPhaoG8d7yb5A&oe=6A75F9A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDYmupfqu0gQ7kNvwF-3Rqi&_nc_oc=AdqNdC6kPQs46UDnwwAhgNUOXQi9gMmmOhA73rgZV8sezZigvQn5AqGAG-pyQJr1pZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdMT-Qw6AdYxXcW0fvKrGthGxCRPpfCcGhQnleg1bl1g&oe=6A75DABB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EDGwR1ZWxYQ7kNvwGqmgJX&_nc_oc=AdpLmAfTR4yO8Ru9DBUl46zib8vWYNUjfPq3n0tyFgQsWvqV4R39BKxKshKAetoFKNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPftayFbpr8NpGPumjp2sSepl0GZXwft5vrcmUT-oTbw&oe=6A75CECD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSlHuy8HKKcQ7kNvwH532_C&_nc_oc=AdrzV13qq-AvyPrldWCV-aNfKyMSxoqo4ROoP1DGJjiWGmuJtzE_CjOPna5G27S0Gsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
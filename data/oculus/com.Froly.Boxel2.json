.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsvwGoKs2lcQ7kNvwHT5sT3&_nc_oc=AdpebxZnQadYI1Sk2i5PS0ycoJd8oKWfqKjlje3NPzSwOoJfaLL8Es_7nL9_qPIBdlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNExnSKuno9QOEo6JMvuKtR-hNT1o6_9s0r-8qzj8zQ7g&oe=6AE214A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6kSVY4fCwAQ7kNvwFegaLJ&_nc_oc=AdrlqROX_IieVL5QkR6mjdMB8XCiuqHyLGpG1GilE6Wgy5c3fMYchUjImJfTQaXc_wE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-JYRcjVvydp87sQy5OuTrNvjH7gqsgZ5jXkWOptwV1Q&oe=6AE1F5BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=comLSfyvBw4Q7kNvwG0tBk5&_nc_oc=AdqQE2Qe8JXELT2nuPTJE2exscqxKMboK3okyuDryYHKaDLYrYAE6aBIr5nrRqUqHxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQueeDlx1nCDYr2yUw9aOkuzqOCuO-B-utgxdiGeKvtA&oe=6AE1E9CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deBQnHrHG2EQ7kNvwEbFDxY&_nc_oc=Adr1FP5DxTXEBhBzN4Z6uDpWM4VqE_z1VFIO2hm7HkEVhSw8xcXt5SIwSsbuQ7Lu2u4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f
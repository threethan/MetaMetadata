e_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvP6YVUp94wQ7kNvwGTgGej&_nc_oc=Adp3ev3RtALF8QI4d2KrhNL09vWG_sQ51W98Je90T6UUd0NPTXBMOQONR5iNa6oD75E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57WBd19nliw6DIanH2LP_8yKusvm-2mvzeOmy_PExjdA&oe=69FF3FF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuasF9MrsUcQ7kNvwEFx3c6&_nc_oc=AdrtCyF_eGuvQQwFGJMwxbVkmTjGb-eFE59TwTVUeTdE2rTtbJR4QPuno3OQDJIs5Mg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DssfJLGgTekkQzN5YtcYXc4S60ch0Zs5xT_GjMJJa7A&oe=69FF3F46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y5rsE6e7-0Q7kNvwH5-NOH&_nc_oc=AdqUXBtjBwvSB1GoOLuqLVPZr14d7_PhcnN9I79rzn0GnmEp03NrmlQ0c7KFH2wBpeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64An8YJTmWiGHPLrG9EmEXYrE_BPa5B35BhcnreZCzsw&oe=69FF1BAF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndbq9WFu5zoQ7kNvwE3OWfK&_nc_oc=AdpiWXpPxwFklzY0SOQc4oH4RzlTjEvCzBrbPdkZev3qTlYRFqnpLukNj6pQFQMu71M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Ex8QTr9vQpqVaXHLOoHaG86AkdOjN4_CafKGf8TPkQ&oe=69FF3195"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CCqbMvWnq0Q7kNvwGDyIeV&_nc_oc=Adpywjuyu_K6oaLp2V2l7zMf5zTEO8qZpLVTpgdfrQCzJ0gG9NZ7CYagVd5hZ9mvnfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DdCE6ZqbuKtrr_e0zTMFdaRd6469iGKn72vLC5jdLoA&oe=69FF52A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-JY_CgoJvYQ7kNvwF_cFq-&_nc_oc=AdqlXH6Z0P7ZMVgRXqL3bx7ard9kACqKd_he1eKX7fOOzkSuruKg0g7VYzqZwiZ34CU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rXO204Y98L07uvTj-10YDvllUu_1lHSUNXHtrFZ3QRA&oe=69FF33BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HrJnKIj9pAQ7kNvwFfqm-N&_nc_oc=Ado8JiPsCPA4y0JstOmP9Nrf8GzX5ihM0H1yikVkBJPRopm6LSTxQbBlE81nGD7DBrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E-rbDQlCXqcuZLGZcgW491A1hAmXw6GsseV05tLwURw&oe=69FF27CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTk7aNWe2ecQ7kNvwEo81Kc&_nc_oc=Adrxios0LyYDUjk-T2o0waYyZysB5sET5x4tKStGDsC4ajPwcG_rKXAG7CFYKfi0CTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f
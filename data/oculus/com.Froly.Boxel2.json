e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAs5TLOZXfIQ7kNvwEuqsqX&_nc_oc=AdpNvJw3FAgx7mjelKok60S7J3AvVpbWS2xA6KWeZJ8tiELvXgF4-ingNYAdiYmkRks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMivm3sSIPgEhcVp5rwb27-k_fiKCsFpQdaf08wCi4cQ&oe=6A4913F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvVrdRuo1DwQ7kNvwEp9JhV&_nc_oc=AdqccPXQHtDnB6W0Y0RmAx09kdlBgA8DBpjTEFMPCa6MUUkf_lcv2BzbbN403q_oDBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Z9aF-H4d9SAV9uzzsIpESb3ZfdsFtS1ixCDtEH2ytw&oe=6A491346"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoXtlcZN_TkQ7kNvwFTRv2D&_nc_oc=Ado-wH9fKodm4Fw895NBgvM_a9pNKw2lq2fizjUcBbW-0Fq2lUVTU85wn_olwN5rjXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTKbGgq1vS31Mkzu2OM8q_asrwsKECmk0brfmoBl0yMw&oe=6A4927EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTIKDhFNuikQ7kNvwHO-mgW&_nc_oc=AdoQCjuEN6fsbwpAZE8rDBRk8vQnLYzpMK2YTDigTMB0lh-g9DPK4JxyQr30Yy0C8mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDmCahsoXUydqJ7N47mDVi4bocCy9tT62a9MvTDy2r-w&oe=6A490595"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTDsAH7OtuMQ7kNvwFUK3fY&_nc_oc=AdrnCDWT4bmDEjU_jQMy-9lRjJBiXVW0qrqoqBt7G7t0tEGSU3pymqVveT8rX_atKTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN2cQtBZd9CxI741ctBzC86YesQL_jZxgfc36Lj-NnUg&oe=6A4926A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqHWQyErhKEQ7kNvwFalzbF&_nc_oc=Adrw8H1EyGQEtD5vo3tWeWbw9jKQrGHyxCUO-HOAIW0gpnBcBis7UnwkrLKBGmHkGVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYm7cHVHhiwjbkNiVfpCMrmfVnhFk_O4fQpVybrDm2SA&oe=6A4907BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiFfjNr8Y5kQ7kNvwFyJZiV&_nc_oc=AdpsT-BpZVDRK7RVRiYJeuJ5dT7D5Rq6H8wgxwoVSBGlWwWgPXczduXhVda7tY5EBIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASnaWS8b-eMNCvcNOVLZ386osyIaPkUfr1yQ7KbWjgdA&oe=6A49340D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plgZ0Bp8s2IQ7kNvwHXZMab&_nc_oc=Ado1V6RvhBVGAa9rolaZENa8li6jlb4td-tulgruoYEiORBoLc7I4yqQqUDmTsBg8sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
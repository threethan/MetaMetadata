e_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYcws8Kaq1MQ7kNvwEEusLh&_nc_oc=AdrYxPYJttMemRrdrbqLc5AGdAu7AYFlmXO_ds0DX184N6V3eR7Fcgrtvu1_EZovD3E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoqaemTV-Z0Klopqz1djQaDLsYETSsw3oyOvK0FnexAw&oe=6A6F4F70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxHgXSQtpsAQ7kNvwEPP-0K&_nc_oc=AdqMBy2dvzUpSxz_JytErsGe4oRuR55phIcLWO_QQ8ZK9IDpU1-fHO0y1pTn9BHoE3E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmaG18fwfQdHjCsG29bYh04eytoxf_MJz48yxv7Dv-5Q&oe=6A6F4EC6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9eXKhbwFKkQ7kNvwFeTHcU&_nc_oc=AdplLUmrqWfSZ2e6nkkJ344YDqUygIDuujb4uw1a_eKjfMkSJ7_yuA4obsTyNwXPOQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFat2cMMXbzgDKD6i_LyZGsN5EqzbTgzQ7VFtZemapxQ&oe=6A6F2B2F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcrCLjGVEHMQ7kNvwFv9nM3&_nc_oc=AdoMOJxtB8HacHCCSWb2hv8AGpMQy2bITBImjI-G5Fks4Sb6Yl6L83apZtU0VMUYgVw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnOAif2uZLEhdXO0-U0IVB54pfT_IbJQE5qZvE9UzCvQ&oe=6A6F4115"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBMxnU7vkNsQ7kNvwEXlKz4&_nc_oc=AdoptFqJfectLfEl9odKo2D8e6GqEXxyOcvwsa9_KBG44oPGwxJBIT0UpV-is2LlU3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcbEAwABhZeYip-Q69SnpoqrEl5kOjC2uamKo8MpPFeg&oe=6A6F29E4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kZXpYWkQ-kQ7kNvwEj21Wb&_nc_oc=AdoJTfRO_wzKY1kmpciZV4NHb2H_iJzugFDy6BNnh_DpXUDNrxOsudsCRDUBtqNBFX0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5Sjdd79eV-JHVyE7p_N-SG4bH1u7LyIdXDW_5JPgttA&oe=6A6F433B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFRgmuGaF9AQ7kNvwGbEjom&_nc_oc=AdqtixCfOtK8c7gg8knms_RxVTAQL8mLRoqAI12w2MsCind2kvBFQeVjLhO1Zg36MTs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZArc_irTvCMcEmYokHLWQRFN7SStQsrCX5QQYoUSylg&oe=6A6F374D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw1dqJ-gr7cQ7kNvwExH07J&_nc_oc=AdqiN6IvzIDlBDHKIHBejAXkJL522yPT9PmUyiSP3vq47AZYvLGTEfejfbHccd-UXFg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f
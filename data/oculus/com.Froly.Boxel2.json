e_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULO7LgKBm4cQ7kNvwHZsAMe&_nc_oc=AdqXcL0ZPZIE731K9SOwjI1D1z84QDEPRtdoi2XazIi3_W19nnJf_du85nkLA-rtqhI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2QCA1dFd7j6QI4Y1mtveUcHKZokkh293iXmlcAKHY6w&oe=6AEC8DF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7zuoovpdBAQ7kNvwGwCgdp&_nc_oc=AdrtCxUrVT_PhvnDhIZ4xi7CS5dhqyg_9kn2qSqM4Op6zuLonK9_BYAfRduRPJAFkho&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEqsnpWl89pHVjSVCpaI0LfmNmBTVRgfM94g_cAqByfg&oe=6AEC8D46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAVNmyiJ4QcQ7kNvwEWxqen&_nc_oc=AdpjV45Au8CTDFs1lCr8L_Tqzz_Lud1Z4tizPrUNYnJJNFFqZ1-iltxSAmFM5fpXRuA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQych2PvRdHie1DHEJQkCRfo8RGj0ptKjTUnFEGsvnRNw&oe=6AECA1EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNqF7kYBASYQ7kNvwGW0khE&_nc_oc=AdrqHhIaHzAV4r6sCa_6_CtFhIbVE2wU_Syp9tLq0eoRyMkvpO0UAJmMH3iyqbOAack&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8pcKXf6EpGSXwe2DwnimBijQ7BWfIR_2fr_pGp6ApoQ&oe=6AECB7D5"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOYW1C4dc5gQ7kNvwHqMqSE&_nc_oc=AdpA3BODTM02q7-RMY4lq59H1sBHJyC_HecpBNNJOrCllRjAiEN7i_jj_pAZGlmVsMc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVfBwWPf5n0kFcaS9xoFR-FJFYF0qk1avTIgqUms15uQ&oe=6AECA0A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kno_kd1iL84Q7kNvwGmW414&_nc_oc=Adpkmu-gRLBKbYKqpLK9AkuLx1flQQkpLYD1qBHzITTvBSfUUG0Pj4ebeE5X_Z5TTIU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPPjUcIN9ac1wZIkab42rvPcC02xPBGHTOO7Xs2s77ug&oe=6AECB9FB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IxXTTiksb8Q7kNvwEM5cuc&_nc_oc=AdqEcwgvELjBTyNVddNV8Y0VswpcfQ52OdHOYAeMJCLfqT8g6ZinvKvXuRv5hslEb14&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbU4RKJLN8U1fiGJvu2F9MrFKdCtxiOT18yFDJI704wQ&oe=6AECAE0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdCyaReCgbIQ7kNvwG0-wRw&_nc_oc=AdrGbUyKY_2JDpbcPQavlOhTvVGOsR7mmjzh8PGO6ZnlOqQAmDKGZMY7D2CSuU4oF08&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f
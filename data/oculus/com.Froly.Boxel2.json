.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSLRpWYG0cYQ7kNvwGBDoDo&_nc_oc=Adpkb0TovqVfUjOk42bjS1NtsbViEWDGFtwXAWzM6vUQz7tiPKJYRfg1ZG5JCh2I0os&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C55IGfUH3wi94BdKiEHH7-kRn94pzkY0qPb9puIXbjA&oe=69FE0124"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-JY_CgoJvYQ7kNvwHw3A2D&_nc_oc=AdqO2k51rkiKgS43oz2C1mH1VkZO7mpEe11B9eIHV9kAKb3zpY7TeCvEDDNZAgn_xF0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68tWnRKNqkybK-2mzWej5p7UrEcrfI_Lpe56X5MlFb-A&oe=69FDE23B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HrJnKIj9pAQ7kNvwHhPWSl&_nc_oc=Adqn_00ubPi8v-YIc5bcYZQSTqB5hc_7jyGKB6jUkhf-UIvoNt6pwN6Wh8Xyu26KNV8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s8EpvUeXImiLObC6KIDjRCP3dIckGu0E2FHDNxDNtKA&oe=69FDD64D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTk7aNWe2ecQ7kNvwGfDWeg&_nc_oc=AdoYkwcDtn7B0kY4K405fRMoYclwA16CTcuunSdz7ub90P4g9VBOocf83x8gEr_Ryhs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f
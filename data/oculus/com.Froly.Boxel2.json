e_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyKaTcsIVQAQ7kNvwGSElMh&_nc_oc=AdoClA1URWt6iiTHA17OYOY_RdDJAzmtv6wxXvjj1h_KIfonujcI9jLO37sXeXRnoDo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS1B6Uq4m8pW7tSFxTntfIBXT5FbeumEIWAK3Zf1HjeA&oe=6AAD45F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5cc_koOlLUQ7kNvwEGYHDZ&_nc_oc=Adr4ACl0KaUCrXcEBwXXbrhGRr4Tn-vu9Y7aNsKh2e6swE9mu_JHtKxtZjk4ZXKs5H0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIngoIwTRJRIVY4-t_Lh8E1DHhqrLBgpes_B9zwugYwDg&oe=6AAD4546"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3ErUMycGc8Q7kNvwHahuhE&_nc_oc=AdozJDDUsLKTLhW0k8eepvaVCYUFd-HWgJ5nsH3BktMmlrg9EzZxfIb1s2SBilMG2KA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuHyf4NnYM10DyLskVuXx-mj-6ykx3w2XK11JAQqo64w&oe=6AAD59EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwzVD82AhGoQ7kNvwE6x_Tr&_nc_oc=AdrDjImnewLujjbxEs0hZXHJdkr_JfxK7CyadTXZinbkTXHRsXg8FwATtcl1c2fxGt8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUwGnNOa0j7SzZxWZ0buARuLktpzgYGhvUdnsRCCNtOg&oe=6AAD3795"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4eAh3KzG3sQ7kNvwGgpCGh&_nc_oc=AdpZfGs8W2GGLk-z2fOGU9STT_MVOPPEtw-AdGAK1wgJDO8sONEeqA4g7GbxA3mddxw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWtGfmiNPPvBSRfyZugKbHdODjGpIdyDbKIBogoLbjog&oe=6AAD58A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YyBb1IQ-TsQ7kNvwGr0G46&_nc_oc=Adp2oF9fkJ9wNbkxQTxiXJDQUrP3q7pHA_tL-BvevHVLSTndYbgjuqSE5FkbR_7Yq9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeOZ6PMhVqGsAFEm9Y-jp44ZC_AZBCFfWN6WruYoLSfg&oe=6AAD39BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8MDbsrVgd4Q7kNvwF00Rmz&_nc_oc=Adp4O14_r64cRboBHCkLZCKXC1Vt5Z8LVPk2B_qGYmsTJ7xLZa5d0LQG6HuaOtgL6pU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzL3Up0wtU_KcDXnrr_IybgZS6ESPaB9GG84r8mE1SKg&oe=6AAD2DCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s1gQlmmaB8Q7kNvwG6r3ZR&_nc_oc=Adppq3plyZl7li_EMGSwOVaxIbBf8-Gq5ShcyElHHYI6O1snpTQw-UAmGC5B54zaiFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f
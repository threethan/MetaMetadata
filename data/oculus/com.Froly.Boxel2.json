e_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2OugiDlZm0Q7kNvwFBe7Po&_nc_oc=AdpGahxG5je-vF18p9caO9juvNKWEuYeQfVr0bnt_wrWWPP95PRgpvy72-4vDOX-fPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oRceTqEfB9Atwa1N4La92KtdjeMTmBCvjF4G78iz8Xw&oe=69F8A870"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoljlXZ5JccQ7kNvwF0IVKB&_nc_oc=AdrJIo5EzMOS9Ld_POFoABLnYAgBuleykvxXVkYoQY6-ZkayBAHk3EixOu2Boe65KrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35Ja10DoAyw8o8emk2tnAdfLNc6eYKddIUJ1wzgXUcKA&oe=69F8A7C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rRinMqBXx8Q7kNvwEU9CuX&_nc_oc=AdqDZYv76IqkkPfjLdz02gKVUlyWvIaYdJrpiYavZDIFnEJebjI5wQebZpqIdxEKYfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xoAYHEKgtvUX9mBRQcX8bEc72GqvkeEi10OZOXgtC5g&oe=69F8BC6F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7lEId3XlqAQ7kNvwHEdP6T&_nc_oc=AdqZXtBR8gv97PSpqh19-6pmM7hKOvbU0ESD1I7s0_68k1mR8MSei-_MCKeK1gQ26Jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iaKE_kg9WUFkUQrt187qN9YJXQqoXknqDjRNq39g_pA&oe=69F89A15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6OXOJGqME8Q7kNvwH2onL0&_nc_oc=AdrzP6hepfBx0-MXngUzL3RayNh1O8Z-fyss3o1INXRdmksgJE4AWlQhfObWhbP1EVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Y8PChp8YMpBzRIrtZNVCfZB6K9Wfzqx75dMaPIYcmvg&oe=69F8BB24"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyKusg-giC8Q7kNvwHne-g1&_nc_oc=AdowqIZnDgs9jp525Ky7DNDYz5dtVOG6hHK3RGZnowZvXAA4oi7cduyUEZluo8acjCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AFVHPNh65S06UH4U3LUrZrDNSn1--BjVkSHqT3f4kBA&oe=69F89C3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItUlDluJ42cQ7kNvwF-vD8I&_nc_oc=AdqMbx8Fmg3gnDAqu_cio5BbF1gp1FdovWeE01lcU30Vr8SS8ESPNcLroApupxgPDhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0r8wJ6jCLZA5gyzHxHicx_Ht3w4w0pLs5XBsD1DxqzHA&oe=69F8904D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3mf57MXCigQ7kNvwGCjkWK&_nc_oc=Ado7tanrRqP6hLDMuzgplukZMAugcuPhAs7V5vYG79qKQnz0j9zTNeeQtfvC3e2KwXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f
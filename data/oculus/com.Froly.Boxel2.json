.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrebQLSskL0Q7kNvwHLtVl1&_nc_oc=Adr4-AbMEVJXhp5rL8VymiPpdkJBgz1DvbdDdazkUXLDwBtijElqenOsPRaUm5dHr1Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFekdakAad_Vqyuqdd2-YsXCbt05HXZcGaCOqADoz1Mzg&oe=6A86E4E4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeegAtRN3k4Q7kNvwEib8sL&_nc_oc=Ado_Fdr8PeRuTcW7EkA4tQMov0duHmplXCPsvR_LPvZUJBnciUcD0i57XTQMf9eCfRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3Fq_yZazqU_QciXNe0UwUC2rAtes8crv-rUrE7cO1SA&oe=6A86FE3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yky_4hAJQ70Q7kNvwEXMm60&_nc_oc=AdpKirBCf_0A3lEdAs5KuAR6hSxvhNpgowQcqucZMbFB-JawE5EaSsYfYc8O93uXe1M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdqRwxtik-o9c8b6uZoMFlcX7AfVuY5gDUrTIIE9ZFWQ&oe=6A86F24D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HltALDu9V5AQ7kNvwGoBSbT&_nc_oc=AdodzgDUsG9J80n0ROFQV-qPVprZHYFFBPPixV1hzhcmNZBLqYd6zieeLkgUcuNGjpk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f
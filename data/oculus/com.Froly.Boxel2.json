e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoJtgdqK8EIQ7kNvwFgmaPA&_nc_oc=AdoahpNcTxKtbBo4WROA59zsG0RSKzR_7exWk46KO-wbUJlPRAf9ZUR0lvJxSDqkZjo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmZGUQXuG0MKoQ8jqstYkPFdofouCCWMaYhWNJYaOZVg&oe=6A7F2170"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnmwvrU-eaQQ7kNvwFxh0bp&_nc_oc=AdrknlfEOpiFyO_8miDakE4c2xCmprldg2WSzzdnENhL9Li320T2dFO1l2dD6wbtVZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVyn-d40Q29ZwzHk8swqgtHqPc1sO0L2KedmI4UXQcTQ&oe=6A7F20C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFemd4Y1BT4Q7kNvwEJCMp6&_nc_oc=Adr2uDXTIGnaSe_e3GYEJNM4-mB7IkF_1DXo4Tlbm4wBKOoTO5xLKb845ym8jLPHOJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwv-Gs2d5iakGx6Zt8X2C_Id2CmJnGhBAu8hYkajb9ag&oe=6A7EFD2F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVmbjF89ToMQ7kNvwG0lDB3&_nc_oc=AdoztMiSThUu6QBG2RlQ2igFMONbSuvDaNXW6Vy-bQmABonue_ZpzxD-aXnR2xxA2oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6XzjpDxAigS0_DblZ8ENtpagIVrlZNcdJ4xLjIsryCA&oe=6A7F1315"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_1tABaITI8Q7kNvwErrQ1e&_nc_oc=AdrG4U_SrQpXTpL52Ntn9ZiPToTQS3W_AiWFgOJYCk74_fW_72HxuItWMcz9Nk3FoW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxovcM8f4v8H19vY079VF0Q_O7lDuDYq0ETCcJ1Ap6nw&oe=6A7EFBE4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pkLxjzmkuMQ7kNvwH1zhXs&_nc_oc=AdrBixxRMx2B0yzLHJVE5VP6B4vBr19xq_3UyX7oQC66pvrmJ21wUOhfcSueKbRrrK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHUX09adoQL-5k89YuIQb4H_tbKgE4gYY9Flm6AepU9Q&oe=6A7F153B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-hgtZ6UfJgQ7kNvwHksieH&_nc_oc=Adq8LTWM3ZnvuvW8Fo5ba1p_udDuwoxoNNZHvkdo_qK-v-3c8wB0jTXYHo1izXTxbwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBnARwySvWfUYe9t1X8lznJUOd2ZM2N1xzMwtQmrvYMw&oe=6A7F094D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3HfcnW9Y40Q7kNvwFX7aTO&_nc_oc=AdrbfDH9jbpLsB11E5tR5mDjjWTjrnnmPshhter_9zRSP9Tq-396jPCw-ytWgStWax4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8huu9lsa_kQ7kNvwEJ_e8q&_nc_oc=AdpOSqnugQo51ztRz_YsQiff_eJPykkVKU8hkIKwrsnFPIFqFw-shmF9XQvSSidtKBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74NbfMtvXqpwi-QZe-WGAYA754SsH8ryZNj4I9Pd0gaA&oe=6A033470"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV-mGygDlHgQ7kNvwF3jetI&_nc_oc=AdpC84kBFZXfo3ZO31HuOnjG_Gz8Xyjb20UpmIweD3tZ65B910XutFlO_0kCrCQoQCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52Fdh4sMaE1KmLS0hprMJdRnahE783KL-_QCDHTANvVQ&oe=6A0333C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jab9CNDKbWkQ7kNvwH8yyR_&_nc_oc=AdpwD8pyLHJ5zmu3zk67NFTMCeBERlsPreMPFbgl6wZM07sYY_aJNhKPQsXYQe28laI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qFOr9mL0RO_ZontLMeMi1DQQNl1fgDZ7QqohFToTkKQ&oe=6A03486F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UysCHcMne6IQ7kNvwHkhKTz&_nc_oc=AdqhfAaKQxA1IZlg2okE8DAnOqHBKZng4vMxZ4-ko2iQ0mfFar5DDJosnJpvLrsc5rA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c1lboUooVNqW3ESukwQ-9cZsfLCoYCYBn04g-TeAKow&oe=6A032615"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SoT1vojjbkQ7kNvwHpenXA&_nc_oc=Adqn2N86c16WOySI1u181YN6KIf4khdEUl3RZhA0w6b0rsSY7Lm7pgtxw6JCPS0fH9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AZE87v0ds1TrtwRwzA5VsBCTl0zR1x4eo2GsEF8wW9g&oe=6A034724"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KizZuP0mrc8Q7kNvwHNszU9&_nc_oc=AdpntG0mefu2xffgXk2K10_m-BEpcZDtK4OL91PJ3woWToK1pi3sMPyHH7rE2PVa5Qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xRZyHPxb4-NSQBilcVzrqb3zFd9lfgh8z1vywrHma8Q&oe=6A03283B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J097U871y_wQ7kNvwHuQlVw&_nc_oc=AdrMGLJixMVFiKgXwuy-Lwjrus7zSuHCW2jTpM5HkQ9wETuOhAgoZRq4dhqajjNzJM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y91knvuPSUaNifg8YUqafBgVMn5KWTewhpzb5EIvS7w&oe=6A031C4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzMj_o9UOIoQ7kNvwG4oUfL&_nc_oc=AdrG0P9n7EOGHpHcU_JuR105C78WxUzVpPLtVJA8P-FxlorDOAGCLTv-1DIe1WyxRVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awtITnnnf38Q7kNvwF5B8x6&_nc_oc=Adr4AEs0cCLP_xTk3ybr8HqkUV5AsFfgF6f-MhaGUE996T2u8HM0J1RtbShgbUfSEHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_wEYbzEsp7-FOZ6DBW6AUbXNZIT_C_HtTTxKxsE9A5A&oe=69FB4B70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoljlXZ5JccQ7kNvwFbeGsy&_nc_oc=AdqNh0vhDjlskLPkbbzSMwKZ3zE7NWMWbEWrpX2R-tVrFAI6yAQR_9iHSTcXWAjnVog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i8zOS4A0OcxOvp497clHFzRfQO-kbBs1d78KbYeYZwg&oe=69FB4AC6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rRinMqBXx8Q7kNvwFBTztp&_nc_oc=AdoVS8rXSLqC-Xr49zeSPnzwW7sJ4YWMxprzUULcdqDbhfBcf2UbBh8RQm0k4Mw-J7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ulNVoUj_GN2IWhJPmfMC9aucQr2BCMFjiOymLGoJmcw&oe=69FB272F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77wcE-3QMK8Q7kNvwE3xFh8&_nc_oc=AdoKdYTOKeV97X-f8NhBZD6MA5GmqQjHACVQYMxBYZanYM8AW-2ug2RHlw_KH0hyV7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ay7HpEpjuSkse2Q3hbcn6XQeh7Bv2LhsAIPuG52Fxzg&oe=69FB3D15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSLRpWYG0cYQ7kNvwFY4WXX&_nc_oc=Adp0PcXnToGWJ7xeuBr-n5dLLdLOxw5J-7D1onl436iuAIp2zMnixDYS3kHswn7r_pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c2t1iXcZC5AKM-OOu86ysdygyQQcmoHCPb0OZFVzknw&oe=69FB25E4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDarxIXi_8UQ7kNvwGH-Qnt&_nc_oc=AdqiHZvRO6tXEWdAcbyq4B7FeiDHVnORMpFA97W_mJSYybOmki6UVhwDXZHRFe1qgvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qFMxCRGqVAku8cBIaKFWx-EfDBqI0duuH7-wbTmM9VA&oe=69FB3F3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItUlDluJ42cQ7kNvwE3bHBU&_nc_oc=AdpNewBGuLKtOZfIyajyo1JM5iTlxBuSLI5RIZPhgZPp1Fg6YOTrFu_w7hmev2kQUfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78wkBHdux5ALh_NwuLem-ZUaiHqBqIeU7sYOo_d4060Q&oe=69FB334D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qHsmjNDkKAQ7kNvwEWvxTS&_nc_oc=Adr-J3hPucyO9Yyl6_zG7iHo_vFGr2NHVPK9XU7Ex4aJGOUAXFv_nFwZksZ6KnA3lj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f
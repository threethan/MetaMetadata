e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNbLmsqq-QAQ7kNvwFRJkn4&_nc_oc=AdoYVdFU37ng-e9BRYIVIP7gvnnywmKAEBeY8Rf45giMQai1h9LK9PNFpPL3qO6FICs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpfVmkfCRlvWN9cpHq-PU3qvfOj4w3GMrMsfmgUOP9EA&oe=6ABBC670"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8Xfjs9Yh6YQ7kNvwEEne9b&_nc_oc=AdpyBnVBmkzUYCbsxo0g5UjzLOoSnXVPiKh9bQbx-ptP9JRe2qgWbO7miQWODlOzVKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm394m5BMMvpN2up4geowo4QAI__bvC4EJu6VQSBbXjA&oe=6ABBC5C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v69JlPuw2z8Q7kNvwGSjPfV&_nc_oc=AdpGTr2zD_S-RAbFAQjLCC_M0LTVaUCvlN1lnz-JKGeLQXQVm-ai2PX7pv0xvVUk1cY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnwW3O3Rz3I5BIE4P8SgWD3F0o2k__ZgL4oDL3QwzfUA&oe=6ABBDA6F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGEyoHgtTxwQ7kNvwFXhezj&_nc_oc=AdqqlJ9mLFaboOTo2tFPcaKxcb472pHQNsdQPRAdnhWRi3FGy_QleiTfqq0MmJumcLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYJ9OX4OUVLmbStUtlZj6ILAJce5RKt5keJs7p2vaPPA&oe=6ABBB815"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI6eLMZip8cQ7kNvwGdeBnE&_nc_oc=Ado4hiMKFZy9dU6UsjPV-UwRPlKR9Enye21KKIrV9RswWpZlYJiVggGIldHA7tIP350&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN8Pld8vf6YH6RltV5ln9n5WgG_3dOoFiHP9A5ggRcMA&oe=6ABBD924"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ7xkYZuDfUQ7kNvwEPJQUA&_nc_oc=AdpydCLu4tgpJOGJK25PcINRbcBBHuX_1CtirMk3DuTmpa5vwgQ81yxwpap-7W785N0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqBZkk2uQ8gyZ5dya-CW1EkCiI0lFp7zk4xULR0ScA9g&oe=6ABBBA3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs5iHxF5g_kQ7kNvwHvZ-Rp&_nc_oc=Adqr3oPEZwiMhg3nNpfTdOqHSVvQyH0hr1IYAH-naWE96gI-WsBUI1Q5X5L7CHu2B5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu-4_uv6z9evKKlU4QY-g9BGo-SW85ciatVhy4M5BH3w&oe=6ABBAE4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9GIO4tDSLMQ7kNvwF1OIWJ&_nc_oc=AdphuQ3WEH7DOXPL74uipC4V3oP2OOWZWjC0_R8bsn5KaeeoUwoIlLbZxA7QayXzDDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k4IgGoyHb4Q7kNvwFIbyWd&_nc_oc=Adr-LEqcehcF-eTAJgTctaq0OhlVCNvy0f-dU98LhkXvzEO7N7jZ_paQbV42ln0kF90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4FbOIVs5Oizhgl7n9ya7SYYcngnFHAi7sz1hOvHwfYg&oe=6A3E87F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmspy0XfUp0Q7kNvwF5JwIE&_nc_oc=AdqOwksBZFUcUL0V--pNIckQYHig2OFaOMDNEbTtW26Diabg0iqNjis7CP6qKVoqcYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kOs5L-DqvFhs77-ppJvrn3sXA3xb6Poqsi3SLajXMzw&oe=6A3E8746"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt6tLWGmR04Q7kNvwHsW2Og&_nc_oc=AdoD1OzgDYp_PyDmagMaU9c2zWJUJPBYqlh2hkLqm4Nv4rg2i-xw31FwKeyWLRkB7oE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vp1jd3glwKPrBDqLTNbWy1JQJssCiR6fkueHg3b3nQQ&oe=6A3E9BEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xh5H3MptVEMQ7kNvwEXudBG&_nc_oc=AdqvDOAlMCsbl1NfI3wnWiJRCTvzdhE25_VcUnUhgqpxo_o12v9ABVCNE41keMY4v00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ziYCd5LWxDGBAFO-6lWTwz62l4bEbIexT-jIOfMm9AQ&oe=6A3E7995"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORnOFofFZnYQ7kNvwHStD6g&_nc_oc=AdrJ-1DWAZ239v1dXL5oZRkjzAGuoOygSuMl-k17v-SAXWl1H2jC8jdCX6TMqRJQg_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_37WGrQMKyurPtOr3c4Lu1deEvEYWAfx8mwxP70twkxg&oe=6A3E9AA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0cbdHq3bSIQ7kNvwFh-Cor&_nc_oc=AdoZdT4xinaw3Uvzb89szLMVAf1gX1m08vHXnqK3EbNiNtXbtLLYQvRuX5Tk77cGF0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af995LrmXNwttZaRFBFEnTcMYDujsdH9o6QEzJPog9F3dg&oe=6A3E7BBB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHZ1QDt5NmUQ7kNvwF1Dcu3&_nc_oc=Ado3j6QhHmMiFvqBDRQEpYHObF5o-UapZcJrP20PgRtulR2Q-p40fDt_iMfi9POReJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yun6M6kXgOwqQ05-p60cAWgiofvAopiyhFhCyNknfpQ&oe=6A3EA80D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8LU-aT83oQ7kNvwFEZdmo&_nc_oc=AdqKnXiKWpiFsa313d9in-U5e5HWBY_2VieKXUyk2iqEpgcLw3wqKaRfcwgI-4D9aEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f
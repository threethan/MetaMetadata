.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0zv_vdosNwQ7kNvwHTOwpy&_nc_oc=AdnhTKJQFpoM5O-V-4TDfF5SXxQo3pspIaB42XxtqKreGQBjFTXGABEeOZiQy6inzjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1oewJ0o6Fl5NiS49bHnRzyTdm1YC7V7nchdGJtcd_mA&oe=6999BC70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-1yxMleuWAQ7kNvwFEAbph&_nc_oc=AdnWbAs9ToMo2HijO0Bs3JbBqtOm6k2Wi8Bwj4dQqju_DKf6YcmWCfKVlAulbw_FriY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-KWMwCD72k3vqGsUOW3ysUfw90gBINvdKSmlEbjfO6w&oe=6999BBC6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHJpGp3hQQsQ7kNvwGtGseP&_nc_oc=Adm2yr2UGJqbYN3fhjPe85fBAXI8PDlhNTaUcCkkf3XkYajipCDCJkLHeHxkLNlE0ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMij6mNv4aDNNyqT7S2SN5AM0-x_jJb9TK5Jh8xoeRTg&oe=6999982F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmplZ_0y0lIQ7kNvwFRXyh6&_nc_oc=AdmFHDJcBfrYgb30h9C8Xhw_3NFCZ7IRfEL76MtB1kYCq08cS1uyjrq02YDlCq83KG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxxovX9HGKs9m7n9ZFC0Fxqu1ZgjtMKDbuxo0Ma_E1kw&oe=6999AE15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0kwtx3u2rEQ7kNvwGiAlAm&_nc_oc=Adn8sVRmtqDpD2lF_ahekMom4p4WBi5kEP9JfbHUlQ9nk8YOtkIHQY9Sl9DdYPeuqjg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNH5vf0fDDW_5zinGvDS9WUzCsUhMheZbulQhEpO3DNA&oe=699996E4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XzBTVWKX68Q7kNvwFrMKQm&_nc_oc=AdmJ0BylNEaCkH-2im-OI5m7winA--nX2urF-J6B2ksHsQ6-q5VKAONvGwEpG8OxxYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4lkzXUwZhK9x8CdUMSj_mRrBk1LQQprvoq-m5oZ6QfA&oe=6999B03B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nm7AqeWqO2wQ7kNvwEUNF_c&_nc_oc=Adk4ukyFPMRQkij_Rlrg8aBcz6chkAPHFnOz4WsaDq7jruYdf-yYncux6NqKdFfH4T0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftU7yxwIGg9U_JyZahlV1OO3puQr5yI-LEWMDGUxjMlvg&oe=6999A44D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVdp_DfFyUgQ7kNvwEcph4n&_nc_oc=AdnNuPQSlcPv8gdqyPicIFFS6ZgEnm3b3htXWwrHsg0MLnzPBsPLl0MR2n3vHtaowVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNxrP5vPZi8b4JWdwRxfDLzzn3MmLPUXoXl4zE-tG40w&oe=6999B744"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BoxelXR", "
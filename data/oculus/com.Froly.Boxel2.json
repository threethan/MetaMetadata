e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYbc3PonaQoQ7kNvwFVDTaB&_nc_oc=Adp2F44eubVtiKZrnLQCxBlcqS20WzBJtwZQQ5z1eyu58OO71-o278SQA0eJnpWSxp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45E032b7U6MSfI1bTetjBisTamGXBJO9-NewBboOrQrQ&oe=6A199DF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9c86ehCQcEsQ7kNvwFlQV52&_nc_oc=AdpatolPAOR9CQy_X7A-CuIBfCg_zFUA1IN_IRVuU3Rx1N5sENSuizTeKHrg51TRKX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47MyRsTrFdHwcfMIPY7xRmRXSSGrc-h3ztN5xIb0oJnA&oe=6A199D46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gi1SdsI1ekQ7kNvwEsJD2E&_nc_oc=AdpNQ9y7GiHxOcJpO-9TgT2GYsTN-bboO315UJyWzxiSxpGkmtwP2_ogaPEGt-5yntE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o_R_XxH5HTISDPG35bbrzpdIkuao_XPspba3F2vr2jg&oe=6A19B1EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6eiedXrGRAQ7kNvwH9KeWF&_nc_oc=AdqGYKOB6VgkBEebfhtgxCKEzzfiKM38yxUlWKIHhbNLbZn5sHYseFZHafaAjlpxU0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60lREZRFuwONYHPikBivT1nMA2FZV_4L0IRhavMPWF3Q&oe=6A198F95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0_4B9PI9h4Q7kNvwHZtH_1&_nc_oc=AdpLAf7Vx4Ryjw2-1FwFLsUz50VTw6sIeZEwDVqekRs_7yekcJSlschY00qUAXOs4fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79_G_5A4bJDpc3TZtTkRIyxN9N4wvUdI2IqQpfCDhb9A&oe=6A19B0A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtVX10B5t04Q7kNvwFEybu6&_nc_oc=AdqMNWh8Kba2WPD887jnr2zd3VDOOHBg5Z4tRACHUMZvGjA1UaYj0HtnDqEPSoCAg18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nYYzw43BSbonA-XQUFyApGwqRCsxPke3QOdSpEkfzaQ&oe=6A1991BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZh4b0JNyb0Q7kNvwEN4CcB&_nc_oc=AdqAtjCF0XBHNaxzABuoHhPsE_aVRJwhylZ75aBgCsM5wFaG9TGQzm6w-voTUeQkzmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PvYDrULFZaRN_jEXSYAZNoQ_aFBxBq-B2o9BKk6HIaQ&oe=6A19BE0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjlXGEZCh6cQ7kNvwExFBNO&_nc_oc=AdrzNDbZdqgrArU2ACqFYLQci96n60Pot2O83OQRNufgkEm6NEdkhnBf8cgba4SKeKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gpLHci52f8Q7kNvwH_hWxN&_nc_oc=Ado6nWx1qch1RNn9AhfvRPI6BijXuDKWX39cziexuXrpRZXmXr1w0tqoSKRmR7lLzJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt-nhMwJo2_Qri8JzU27IwcbNCz1cdQerSH7s3tor2bQ&oe=6A5CDA70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF85TahxP_IQ7kNvwGuV-7t&_nc_oc=Adp4vYSYYArRWoYhrLMC9ubRbWslM3A62gxBCTKLDIPcGTYIO8PMwDYrAm5U6P7BRbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkjkjDj38AvUDDhSZ0v0diCiRzZrN6X2pQstDVjUCYGg&oe=6A5CD9C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnddfHr22rYQ7kNvwE7BR2P&_nc_oc=Adr7ehbkTTpKM0YHVzSLynb22mrNdsJRAE0meAS9f8GX0-O3AItcbmzYE9ni9ErqD4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv9umYQkxjg-uIWrbEy4lUQIMBj4byFttAmz54d6FnLw&oe=6A5CB62F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BEizLfZQXAQ7kNvwE6Pr5N&_nc_oc=Adod9Dns6uREnsDQJQfIDVfPjx-FpviCd9A28FTGfX_qAveiWIflR7uJD_wf-Tepx4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKVNUQgT0VjeNUonNl941myftLex5t9-KydLtBMSfOVw&oe=6A5CCC15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDkq9yVCo9MQ7kNvwG7JR50&_nc_oc=AdomWjZqPREm7AuWKe_tfjw1CEsUtnewqLMROyZvxL-yOQ1RiKx25QsJl_Jzkn2b1L4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf9OPoV3Lhzb-5y-5FL4Yc1mbOUSBlkm4ntcpaBbOakQ&oe=6A5CB4E4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBUWIzxhcmoQ7kNvwFlmuMg&_nc_oc=AdpzbCzKSf8kZl1eo8ldymPdEEY-rG-2n5x-VsM5cRsko1xAIDYXqW9VsTX7Bz--5Fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe238BolFXvCC6bOurAMiiCDwMy_CeTtcwDl2Te5T6Sg&oe=6A5CCE3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3_C50A-EKMQ7kNvwGffKp6&_nc_oc=AdrqlJQKaw0VnFVTkfk2pUfzy12Xx10o47fyR7KtfS13kPESoJKWpqkX3u5JV8ZQkG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACkn1boxWtOFrISK8JeE7TIrCjG6wo6tfqizGlIlwmyg&oe=6A5CC24D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW1ITMwVT30Q7kNvwEuRTjZ&_nc_oc=AdpO6ayJ_Bz7J_OTSQxP4YkAUyYbRSOTVbalyhudSJd-qe1hzSk8jVCnv4sYlJgGVqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f
IwUEt-hIgEUGoR9llATRsBizIPDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1-akl3Pdhx7WYe5v23ORtSXd74yWfyKjJVhDDJcqxL8A&oe=69F0D224"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r99559IzPB4Q7kNvwGApCM_&_nc_oc=Adq22tkUhbUKzI1daFfJgokUsL0mrnCy09zRXKvRP_VCg3ctFrazIBjeJYE4zlMAoLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af22a5RFi2umH3SUzoR31T2dC3I0OkeQF4KF4GfCvTiDCw&oe=69F0B33B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9zKc_Ria1MQ7kNvwEfpl4x&_nc_oc=AdrWx3mjb2dAjUSA5zrn4k5ouxBU3JW6zXFLWRH8XML14DkRVEW6Wwx2A74YTOtWcpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2ovzn5ZEIpj183DqueYFa-7L0sqfmYCSDIPKu9jmFEIg&oe=69F0A74D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6AKIbnzTkAQ7kNvwEsiCBn&_nc_oc=AdrawOF8Zt1uar9M3tOLdTxpnaMAhEhNtywdl_1iMAX4jZugjTkuYlqheayu92ivwBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2ZyM5jaa7ydZVGWrDCIcf9OAHyrL9LhFqQMggMZs8Ktg&oe=69F0BA44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BoxelXR", "
e_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0r3k_yiDtsQ7kNvwEA31yZ&_nc_oc=AdoEdNoYFRYVlhdg6AsVpPPzXlBwcxUwZCzdN8WP56zjjCUG_T9X_2iMmYeTNvzBN1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fz5suifQ-3m9QQ6BeGC-ckuwCPhGk2tlzxHPsPA9Bbg&oe=6A412AF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyrORzvfFDkQ7kNvwFElk3U&_nc_oc=AdoDiXO0ewAP-MnAVd68dv-WEhYvpZVeGswQx1RZMgW76OUsJPa7a3Qg0iMVYKXFwYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vmMg58BeSnyYlKWMMhicRohu9karWKYJW7O5ueNyToQ&oe=6A412A46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hhBaIWuvqgQ7kNvwHW4l1c&_nc_oc=AdpADvuPdiE1d5hqZbZMio0J0O96R3FAEmJ7MX0g2vlvOOYYP7go6Qq0VjQltsiM17s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8niaoT1ZhSkRn7cVcJ5586vKKUxCC0lsKE50_Z1rMicw&oe=6A413EEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROvsXBrfFQEQ7kNvwGgZ0pW&_nc_oc=AdooDjd3Lr-eqnJq4sTAVj1rmUng6R809GAQ5RSzWQxiFO_BHRgC9OtAmBSwZxamzds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hqvPeW0hxQ3bI2WCI6BKWh60lu8Zw_bBwOaU9XWecsg&oe=6A411C95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shSGmYrx048Q7kNvwEZM6uu&_nc_oc=AdrWbf6APswDfuFTIC-QbA5kGSJJcr4hqpjAt4WADm4iE6Gnf6jqqkKdTOVamc71kbs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tqSex8f4qmhKkla7V2zqi-R8_um0hCOX_imTMp_POEQ&oe=6A413DA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2Kg7FTOHbMQ7kNvwH9MdGn&_nc_oc=AdrOIal8RbsinRymKysTBbcIdUrPp0sGcRht9O97KNhDqVw6K2JeTu3vYD71uQ5xfiE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mta9-OZLcCY6x6xzml82lycWUO01CrxEL0C7RjEZ0gg&oe=6A411EBB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6aO34YLhV4Q7kNvwH9GDib&_nc_oc=AdoUgYMurf0_Wu0HFd-x3KTSGBDUC_LqJtGEsX1xcj3LKTc66fYa-b7yHYVJ7AVQ47g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zGVakBEYAM2Y9_F81CK7tG450G_8IQ87XWduRU-s5hQ&oe=6A4112CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3zld0gZoLkQ7kNvwGCCVyp&_nc_oc=AdqHb7jdfrSo4Bos7Hk7qgrL7FixpnWojjL4ugazZBYjr8x-u974zkC0nUlomTRS5bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnhUsZMlzyAQ7kNvwEBJYnk&_nc_oc=AdqlS56NyWhONT94aopzNPqmHM1aRs62RYNRJsWkmgX-RLMq8JiT6-r8ubnEPwsMHKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LNuzzAZwdhmLU6oQfhVgBNAmUx86BUe-dV6RLRAz9Pw&oe=6A3158F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAouot_wWdcQ7kNvwG8iOkB&_nc_oc=Adpur3USKqUDRM-x-cebh5FAY-OkDXJsISMoyJIh4RXN8X2prOe8pnXdH36uMhQw_Qc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xgacNa1G2WwLFuXJbduaxx1ntG72N0lYLlzrOvY52XQ&oe=6A315846"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGEWiZPQakoQ7kNvwEz_NNw&_nc_oc=Adq7tzzZLku9WsKhy8eU2_ic_q6EX_WPQmcMiz15X_NCOC60BkjVKHgkXLPCLJF_W9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xHGV5YatAkKyMTZMpyv-0s3MP_msh-67JLDQt8MCc5g&oe=6A316CEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdnKxTU7dpYQ7kNvwFq0Cbh&_nc_oc=AdprX4pJLBL50m9QxCtD-giH4G59j8gVNS7jQMYvLbRX8PPaLrQeUNsPCSUuymzN32A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mXf9WLMfG3sDf46866RHYzl243IF9Y6yXw1-vlXvaoQ&oe=6A314A95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg8GJ4zhWFwQ7kNvwGr6gIT&_nc_oc=AdrQ17t5cA-jv3upqBIw40g-5QsyM_3uQ70MNgyn-ee_Jx_sN1OPcfmG17OQawfQjsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bpn1DaNPhH_FK4xgFSuCIWVLQQRY891fd1NPj3OgoCA&oe=6A316BA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WuZs2HxCDcQ7kNvwGolxQu&_nc_oc=AdrRfOYFu7cgrPq_PJuQtQLX-LGA1czvtHknS9pjEq_lM8Telp5IRtkh3FmwgbObAtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99h6B8YlnhNySdRHbZdIry8G00881Lk5r2odljOZusyg&oe=6A314CBB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpxLuh3mGh4Q7kNvwEhMj7d&_nc_oc=AdqbZvov_qvUwHMB-Q3vGbI4dSKqQ0HXUamAy8KHspDLTVflXbfqIWFfjXjSwuVFXk8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tOpDFi-QUjyzvv5vlxE1VoU1ndplS_rpYZWuXiBVNvw&oe=6A31790D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjyet19GG9gQ7kNvwErU5jx&_nc_oc=Adq-yZhYp6fCtdGBuMSV658d0W4S9DtXPyLSeg0kSDZ1yxIGgr4W_c10xbXEFaSb_fY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f
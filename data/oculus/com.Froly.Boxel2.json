e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD1AEy-n16cQ7kNvwF25Vwn&_nc_oc=AdokpN6MCjNuh8xau3XkpKAQO8aQuyg6ZF8pZOAjppJb4JHa3SNbZFZx3cQ6BgasDnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56ybnOHUwwbFHb99jaNKbUgfVqnXGGNEVAd-jyzyuOgg&oe=6A1D9270"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDNwZC3wUCkQ7kNvwHcdHjE&_nc_oc=Adoh7s4rzxKgMjL7xGPEpl_h5o4ligX_g-LrTRL9DGTHwrvZ8yJtSIjsyv2vFpsN_Yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kYCVgVJy8sbFClpgC0LLK4XE5Ok-5k4_VwvKtcvsDkQ&oe=6A1D91C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8BXpxlAXEIQ7kNvwHd5_9u&_nc_oc=AdoJvAD71t5SJ-B_cl-rjHKDtlv_u7gHZ5kbK_BdXzFYdBalnsrsf8h3DBzrwe7XAJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hiCfTbsSVEVMyqE7e_DfmJfL565wOu9HUmpWeMXjfqQ&oe=6A1DA66F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVNL6U0d-a0Q7kNvwHnU58i&_nc_oc=AdpEeFQ8IrP0GWB1ORmm2mjHpMnFXQTarCHQjfUdkwzAMQ67wkmkPAeHNr2hgE4DG1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Id36uW1RwzEoM606v-HpEx84h84Ulgh2BxZB4cJV2hw&oe=6A1D8415"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jELFYIjRhWcQ7kNvwHB1qF_&_nc_oc=AdpaPeBVsc1V27uWj2_vFKctYCKRJx5xdLSQ_frzHxfp-KxMJE6bWiVyhm2Uw5S2lDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HcHx91D6JvqNl01EGIWepcdPVY790N3sy-TpuUNHOqQ&oe=6A1DA524"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx6IuJedxBAQ7kNvwHCNb4l&_nc_oc=Ado8g5X5ibjuNSBRBXraF61UuMDtYmUIwnzuw3mpe2s5tyDEUVVBjoN6MyOJ6PPN3GM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s6SSZPibyN-rshdRd4JhZiA4RQob0hNHmLnyofY_wOg&oe=6A1D863B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRCxHAugzicQ7kNvwHiAlJk&_nc_oc=AdqASV5KYA-KjSr8EYZFIeAgbvKciNIJjhN90H89EFiEnHCW64wtIOiZXnWWwXH-s5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UGLrIqm6YlHN5momIWUZ5lUjcDOh86OJaNJE10XwQLA&oe=6A1D7A4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iFPeVBQpdUQ7kNvwFrpika&_nc_oc=AdpHFZf0iYDt4Hhdh6jPM8q-XJnW4_nr7SVUDjH30kR5WBGfZ974EUFMy0ShzRrg0u4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f
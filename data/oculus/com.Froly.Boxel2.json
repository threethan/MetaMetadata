e_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr3fHeU__p4Q7kNvwH25X_b&_nc_oc=Adrk5V7Y8STk4fVieF83pxTEmVP1gA-6H5vhrqEbzurJVs7NfptKSiJyDSrj-51ZaW0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YUBg1JL9L08OKH2-oeWMsF0exY5nnzGA44QMOZ3cRDg&oe=6A09CBF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9ndhyxUo5gQ7kNvwEIe4X-&_nc_oc=AdplJpkN9M_t8HkIuACcwx0dJnD1SNBN-Tw0Y3pes_8jU1Dnl4CgCRuRA9mWbDHIrHY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44OOcYgFVxMoahPkMBQWHTTAQnIfmpdiWTcjDIvZksuw&oe=6A09CB46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO7WN2jWmA4Q7kNvwEsUz1_&_nc_oc=AdpBBDUccdnhK8trpoRIxAdFaDTgO351rz2iKWa7JaAe2Hk9rFCld1tqgV6ZV7Ossmc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6946uVl5M7TjS5NgFbtMsbvcgXtBDZbwtWBdXXrUHNww&oe=6A09DFEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr8ouZY8BYQQ7kNvwEB54BY&_nc_oc=AdoPowZ7h2q54XT5BE4Z7ByMp6vJ1_sEwqAX_QvEPN6Enm78Rs2ijexlzFd_QCXtVww&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oweJRksWorW7Ktk6PVosQ-xKKif_cmSWIOTT1efJf3Q&oe=6A09BD95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC7_7IjMtpQQ7kNvwG2RdK0&_nc_oc=AdpZbEhcJQ64toSkOD9UgFbycnPYxTqmnoBGdzcWAdRvA7zxn0rdvrtoI9XUNmiivek&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xJAuRKOTTjvUxQ3xZsa7amx8U8cjPtROPrRwDCHnpwA&oe=6A09DEA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=183G55IGCaoQ7kNvwFAzxNm&_nc_oc=Adr44nptvP7W5hulafx9zDkw1CNg2IvTFKWcfJwtm4BwdEGbbUpMreOIK6FqtuEz9Dc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_scZX8tl-QWdcM0AJoL7a2wEjnQyUbkPzoXljEk-XCw&oe=6A09BFBB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MJ-lumTy48Q7kNvwF9uZs_&_nc_oc=AdrlemMP57BvGYWe-rLycoIcJusNXPcZJzfSe91AReWmO8oGQli24NlDLpj8VIrKb0Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-WPwOxYC3dfoa5sDfEboLI2Ra-rERaTQKCFSdYaZp5Q&oe=6A09B3CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP19Qxr8T60Q7kNvwGMibfg&_nc_oc=AdoMPT0bWK9kbWR092xh_hP9mezYvkefCEFbyi_LjYkENNyKaBlGG9GM6dW5hsrx7Uo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f
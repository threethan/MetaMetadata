e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N776zCC2BksQ7kNvwFJb6DI&_nc_oc=AdqhYh4O1q-ZNo0XnZ5GvdYjNibUJq-NWL0hIwhawFvfmamKobu9bGFr9x_jpBuiCkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaf9Nfsqhfa8_8nofIoTmoInc2dneeYcyzJ6OZwCxY2Q&oe=6AE4A4F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tdeattm368Q7kNvwHrczX6&_nc_oc=AdrpQ_1AuioCewrO4VlSjUi7kqYl0Q060w5X45KVqfI_HfxdPnDDeyOUdXdJz_gOE_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOFAWpEdeCi4p18t05SoeGHN72SpaSw2Mh_5y3HWhRpQ&oe=6AE4A446"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP26ru1g7nkQ7kNvwHQHFhb&_nc_oc=AdqUmhoxCwzU5WXnsSnxqLwmpoM3mCyN6LCDd4JAzr9_3x-rr9LmhD6oA89D0dwyXaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1M_0Soqw2XfasE515vdMeqCMyqD6aT_zdy-Tu50T97w&oe=6AE4B8EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfRJ8MRyP7MQ7kNvwGxonpe&_nc_oc=AdrE2ujkZBjlReUfYcII-jzQhH3I6189YFwrFIRFaTLNqqnDy_BqkQzxvK4p6usc8Sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfWYBgctbxzAS4Dy5LdZWIUz6rJLRzHaBBcpPdZ6bxcQ&oe=6AE49695"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_aLA5CuiWsQ7kNvwE8Dwxa&_nc_oc=AdqtkPGUmdoZAYe8BRZsQLOHPYQni3rurhHA2DMM-QUsgswo_gNuy-eGSm6uD3rZpeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-jeVdNk0c6g1NYYg52iCSgqy1nWVMlWMtcdfsm8gj4g&oe=6AE4B7A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-EWxCIC8IcQ7kNvwFGCuY-&_nc_oc=AdrP5kw5_C0NXvAcG13IQJlsi0jF71u9QL6nwes7QMFwMgDAnP-6IFqlXgnvGtbnzr0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM09pHCduzY1Y7zij7vOY7k2pywB1HBXk8P7wdTVOQpQ&oe=6AE498BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=comLSfyvBw4Q7kNvwHuOeyH&_nc_oc=AdqLRIOAN56Qr5Lmepe-gVUdaVDkS8hn73hZ6paeRKw8DOxonqr31zMV9lnUCXaa5TU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIeHY4x9WbVQFN8DfaGQEFwD0czJ2d7xv_8KuYWDgzIQ&oe=6AE48CCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG6MEn9l-z4Q7kNvwGwTwkB&_nc_oc=AdoK3mcX_0saUg5BAAhqzGQl-nTAmJrxEkKFl0ZXdSk97E-D888fcjUNb34tCCOjTf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
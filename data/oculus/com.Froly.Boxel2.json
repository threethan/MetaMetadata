e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy2HlJ9leJMQ7kNvwECLhih&_nc_oc=AdoFBR-8GyGjMp_TG-ppgp6LQe0o8Lii_NPCJ9Ifu052kK9P_O_RIGUelfM4N9SfNxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx0F5mFCdAyemh6Y6cTb5LsWUtLFz_HAHEt9lGeH3RFw&oe=6A986630"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxXAFmRjmt0Q7kNvwGAKeWL&_nc_oc=AdrxRKRHTYmHphkv9Yv3Cn_8_-CQmUOiO7buse9JAzp6-FE7-BDE-JoeUAuuCAkbeIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIOkt9Cbg803XIW_Ov5-cCV1hrwOdMT8BqZEHxa3WPoA&oe=6A986586"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDSutM8WERUQ7kNvwGY0o2J&_nc_oc=AdqqDPwVBRzau3YW0XdRYZGoQ3c-6q53ieZnLOVaUxbsmKvuqKoUB6Ls8atv5sJw-s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKej7qw9zlGKq9NinskHwTJRCHNcNJiNADifxw5l2CfuA&oe=6A9841EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O8pBVTSqL0Q7kNvwFtKMPW&_nc_oc=AdrOqv365VR0S_DWoMIuuuGLVCvb0_xM0eahJduk76yiunkjZ5J4f1f1X_ng-MD5MUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWPtyU0O4RIOAV2hmlIYwC0rmvubI-EgUNCUJd_9sHrA&oe=6A9857D5"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeCRk6QRaQUQ7kNvwFB7Ybq&_nc_oc=AdrZuCOGrEUDpx2UGUXH2uA_34vUJ8F17r6wzMd6ZwngUblrI-SQxORV_M3uulQn2nk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjCour4eofD_cKGnQ7mjURCxtq59JsS5erW8T8sH9uAw&oe=6A9840A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaLLOl3vpYwQ7kNvwG9X-_P&_nc_oc=AdpVWMgVL8MfX4ZnZSuhAkh-0DHPQoursGbjXnItzZTbraVvF_Nqv6Zvt8YcODI7mDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzTirFjMqFPu27PnY5ZD6nyPj68IOLxGECVmnhql2f8Q&oe=6A9859FB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMeOcRQALlcQ7kNvwE6aDBd&_nc_oc=AdoETjC2tX6BT-RrQ2TVlusqY8KoWH9JoOeb7AYcYlGQZJ1VfiAOw3vPb6hn4gr_Mhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyDFSkvsQqmieuAf8uCTV2DRgMM_bme6pVTwfuPeakow&oe=6A984E0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pErOWL8MrzIQ7kNvwEIjTC1&_nc_oc=Adpa-5UpdtzMTSbThzFvJVoo1z2pvIeFOtK_Kf3Aa9U0lKmfnKbXT5tCG03_vG8Omek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
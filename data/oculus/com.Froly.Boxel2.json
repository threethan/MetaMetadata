e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RID8qhdXbMQ7kNvwEngU7X&_nc_oc=AdqtIDCuSmaZRrZEawOopNmhLWqcrS8BAT31A_Td6nZiEHc3w4ly8qvQ6tOaoFffvdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL56c6jNh4BZlrtt1W_Ua5Yky8tmB11Nd7gO8zZ0v9SIg&oe=6A9EC570"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq8kgCtZ2uEQ7kNvwHxhNLQ&_nc_oc=Adr0Xf-4uLNIzOeBbC3X_-oDSfD7CL26gxnXR10RPSOwY1fYTyNg8DQaJn5kuPlIpHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyhEEekS3bmhEb278duOz5JGCI-z4oRWiZ1qgYZzFYdw&oe=6A9EC4C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDuNW5Cs1E0Q7kNvwGzB7BC&_nc_oc=AdqfPc-7Na7VVIYMOprabOmOlQchBN28tXBDJKckzF5NUbsF0cz8pkeIK0fmoJRmW5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHIvN8OVG1CSx3a5liMrOTnuUri0cpfUWIcIjyYcO9mw&oe=6A9ED96F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTDTLjO3MSgQ7kNvwGcTpXn&_nc_oc=AdphFlOeXTNTepIyLjZIILesHpOP2XadqIyfuGofrb26SfJgVhpOuYRpnKbo83rCb_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7n78tHMbPY1MwYPYJg1gYLJTvtc80IEkXvTQcv-d_vg&oe=6A9EB715"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS1J3YgNiOsQ7kNvwHwBNtk&_nc_oc=AdpdvZ9EmT3AaA3eruGRNzTmeCWUAZuE-PEoCW69Ek2KmMr98xDW8VEc-IagjoN8o-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL80Estou1E693nc3DcIYuLT8dNnzVw-ZVw-RlvBFI9Pw&oe=6A9ED824"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzezEbbs9u4Q7kNvwE-_NKT&_nc_oc=AdoCAq8v7vPXoR0y9CmtSRcl3XS9XN2GxV7emMvOuhs-aWvgisOxHYYpR62aGmqk4LY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsE6s3YkdgHE3ZWInun9FVrOtZxXJEx-a-xq5IIG2GBw&oe=6A9EB93B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NZiKTUnTzIQ7kNvwFvcMW8&_nc_oc=AdrwUgKgXqqZjo7q9pERLTPlAy3jefmDkAyIdJHIn8eHkR_pRqWUwebF40x3LYDzCVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcXrf5CQEgSux_Hxmy6Y7lAJvvyqc51JVig_6myjiUcg&oe=6A9EAD4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1j19JA7SlUQ7kNvwGLmnTO&_nc_oc=Adq_kiBBHGcScCJees3370pZVTMzLWG7VhN9OOK5LxW_obUV91FS94CqYgcy2ianeGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
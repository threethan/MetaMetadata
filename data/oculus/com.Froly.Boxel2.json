60", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1552171468638252", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035351_1552171471971585_9218499982641323855_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvhmiICAqkoQ7kNvwGC5SNJ&_nc_oc=Adqbv92M4Qo3es4YbAY38V0t5ghlp9AZcXK3Ayf6Oitc0bgCpaaL3fFJcQZRMulAB0Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12dbBh5p-r0DOPSE9FbBJp5qX6eHTiH4yRipLErrQ98w&oe=69F20E89"}, {"file_name": "Convinient Color Picker.png", "id": "765756565059734", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003270_765756568393067_5251158242814471582_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCP5xaG-0ssQ7kNvwEOLrRJ&_nc_oc=Ado1dcSCJ7RmbQYtJP6Ns6LUX9h8tguAsCt6LIhuqv9zkKtUs50yQiCXOV9jvsNhL4A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af060pRoTJEZCZTCdkdAfoxzoG6UnW-iVTpeYf-OM6cJWQ&oe=69F1F8D5"}, {"file_name": "Export.png", "id": "1279911102936750", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974506_1279911106270083_8213594034827019564_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0Lo9LBmMlYQ7kNvwEj3qgJ&_nc_oc=AdpNo_DFdtlUnI-Vqc-XHe1B_zWk4H_9O06JvcuTa4qe7gvX8kxK1usjU0mkan2qovs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2yHDJMTHKk60LxJd0Xcy5fPIFLsXKPnUBN0kILShY36g&oe=69F1F06D"}, {"file_name": "Library.png", "id": "618371103156012", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035323_618371106489345_2407252291020037414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1grsARzGIRYQ7kNvwHuVUeK&_nc_oc=AdqPuN8-22TG7n_CRVBXnIxrQUmi8EIedMQhf92kv8Z6Hi9S-IOC_VU6oMqgAfeTFd0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Gv1v3Ax1zHMJ7QabOgpMmS6fVY6vKdSfIw_xMNpGSKw&oe=69F1EE5A"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9zKc_Ria1MQ7kNvwH1XnRI&_nc_oc=AdqEEEgaXpAkYUm9MxvYwddNc7zS5MEpdrsIP3uVAlywN0O5rGtSn0kxG7Qw81D6n40&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Sco1p_z10zQRmX6zML2ftpJk03PKIBfIB_w1VUMAlyA&oe=69F1F8CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "576947624415345"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "949937969361382"}]}, "baseline_offer": {"id": "949937969361382"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1682010568, "status": "PUBLISHED", "id": "949937969361382"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8080720335337260", "version": "0.11.1"}, "id": "714801896907994", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5815420721867244", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8080720335337260"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "714801896907994"}]}, "change_log": null, "created_date": 1724709129, "id": "8080720335337260", "version": "0.11.1", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary
e_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJBOUoVLROgQ7kNvwFt1jkV&_nc_oc=AdqVG56z494qtnzqDmW_U-MC6OHxWBhxoOvTN5utMSqk9y-IJ-kaxZx2uaMvosNJpVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xtbDmq4ph6Udp1DG7LkTYecpJdYuhW2Mw68Hq6_MDLg&oe=6A354D70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXDoUpMIBvoQ7kNvwErzYg7&_nc_oc=AdrI0mraEyvI9vA32DUSO_w-bNFg-uQeF3dqZEwHTypIPGC8dDCAmO2FQlkBJZCw7J0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IhUqd3Zm8NcE4RqgAn9stusDrOycMgOPHwnkvtH2HKg&oe=6A354CC6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug5AlfESoDkQ7kNvwEx445w&_nc_oc=AdqWg1QSNx2kLLOV22_3gDN65NWp7zkOiWwxD_04NXBXLdxle4Ya-Jt2ubLIPXq0EX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NcjSItXersVHtKUlrhbu5-wRJ224p7G5xNo75hY2M0w&oe=6A35616F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OnRQt8m7bEQ7kNvwEKxHMW&_nc_oc=AdrGzxLWdk414cY3INgyqpGfbQRA_GSo-Y-208t6udzgPSSmzJff_YQ-ig9Cg2g8SfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Uua2FZbBC4TfgUqHnSbJJQ6bttkFU0py-hk8vmV-jMQ&oe=6A353F15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MEZDqu6ElUQ7kNvwGA-Aot&_nc_oc=AdpR7hctDxblpsitjzpj5W-hfZlunCM7A513ilEcUgHpOmiFRZvkl_jOnEdrv2nJ-zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lNIC2ocTWkBROVAFJa-TzI6uR6-D5_FgsydVzTq9rgA&oe=6A356024"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BteP0M_ujPEQ7kNvwGPEIfC&_nc_oc=Ado3wrG5c9J7Trbgv2Z30sdB2w9J5Y7-GzPzQTztlPlZaq4bzBttKZRP5MS0_smBslc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MvT4zP9x3w1gu3oKI4PwoEehiyvLRSph-kCBbZ3oGBQ&oe=6A35413B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9rsQof3yR8Q7kNvwF-Zada&_nc_oc=AdpL8wcxYOIsJhoPttXkelEqR6AxhTz_7kht7CgLSq1CyPUlWmQN7B5oMHPcL-vGb3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--zZT1i3gaAFp_g4xpnEPrPCqBBZRNhFp32fcCMaknbg&oe=6A356D8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9d4K45cHmcQ7kNvwESgZgP&_nc_oc=AdqZIeFz4AB2H6POVKex_xpDegWiCHvnM9af7BiMj5Wkl6zCY8GyB5leJPY6XmQu-0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f
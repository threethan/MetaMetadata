e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEL6gz1Mk8MQ7kNvwEgDWbB&_nc_oc=AdrCOYcs6fXq7ua4CIuU_NkzpVDGrHVXUHjFnUX9IcVpeyuPObwpu_QmlMzPoQCQ0_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICXAA2Q2DROAQYdZHL5-F2_IRA4I1TDF2yqmRW4bGTcg&oe=6AB3DD70"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6H8z-4fe3QQ7kNvwHokBGX&_nc_oc=Ado-OWHtwZjbVuW5G6qKXiPhOnItnOB5pp5CU425MAY4h6tyPqaIqRtE-3lxU3P6pkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJhvYEWZxbO_fetXwcL84UIetFc6oBYJQhcawUxwhaCw&oe=6AB3DCC6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL-0SEL22GUQ7kNvwFValGU&_nc_oc=Adrlwvm6q4SLsiK1tR36RpNHjMBRGvSOyt3MnsCBGycs7LRjo19S6OLVwM-MicA5rxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2-BynfPE9bE5U_vM5PlFlBpla3ROw4mn7c1MQxpsL0w&oe=6AB3F16F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pHLzZlPB_UQ7kNvwFwImBA&_nc_oc=AdoYEq08DqhYb_YXhG_YZn1CE2UhIXVjjDJAH6xy_UwPyM6QRB1Uobg6tC8qLMs6WLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtwX5PiIuBGzHZ3IdZCLHLq4EXeYJwKBh2tokJsEXFUQ&oe=6AB3CF15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODWRuJAVLBgQ7kNvwEUM6_c&_nc_oc=Adq2nLtSEYGfYcYcD02g3meMBKbnITEx9OatQTznSGdleT6qlFGiKKnzGWFFCypomY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvn5RuNnlXC784XVNUYJ9yDh2UMkcRvbaD5ylzVOuAsA&oe=6AB3F024"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxYFieArNOkQ7kNvwHJbsj6&_nc_oc=Adp8OVr9Lmltth6Tc2rd1evbnmXHnA71Eal9oOM6POEypLrS25wET_4VdwmMxOK3gp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7wCD5E7wPmg83YlYKXWnKqHjIhsbubSrAqe2K-92uWw&oe=6AB3D13B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7reUEBheQ3sQ7kNvwEEc0Rt&_nc_oc=AdpcrgcqHH0cj2yKCWRF_H9e-Z1ixAMqNaBBYw8AhvnFMI692O6eaLOMJ3rPrn-E3O0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUoxx0NzB7wOQmQ_ShSqSvHqjsMjRERydyWe-jgajZOw&oe=6AB3C54D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiB-ggHFeEwQ7kNvwFBSY-s&_nc_oc=AdqEmYs2Zy8zqypQDRvoVD7ZWOT0YOzPBbVntk0JzBY9l2EwY42001gw8gan_auTsiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
15_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyrR_z4wh7MQ7kNvwHpfF8L&_nc_oc=AdqcPlPH2uFclrtjavYNfesgoNQfVrMdKffbaOr5amXkFs5XCpD2qQVy3O8KLyMssRA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvLp4PKIFMnltQZDV8IoXncsKSHvWjv0FbsmgE5YJ28A&oe=6AA96424"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaVarRLUlxUQ7kNvwHTMcCt&_nc_oc=AdpWgYBJQKHHS5Q1CIMZM8M_1_76am6xWDhgrCXBGpDd44JfU64Jo1eo8CLIyYJPMc4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV7unXHeXkKIXt7XM7Ywd7VL9_ZFiO4z6HuSNlI4Hbvg&oe=6AA9453B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQwe06qZKK0Q7kNvwFeScAO&_nc_oc=AdqsvHNugHt_Khd7dyiLc7ZUHV1hcoYcgacueN3oY6D9x94ac_WHR0-uEq-z32OVV1k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuidsROjXUOlwjRhZJq3QWdfCNmSrZAjfcVIIwhdEd2w&oe=6AA9394D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_VCjo2y_4AQ7kNvwGI_DBM&_nc_oc=AdpSn-OnNDocjqdMrgrfjGE4CLqoL6c1hmeBqoXS6-sVgVjxqEMZU-eg9XcMdoBB2mQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_s
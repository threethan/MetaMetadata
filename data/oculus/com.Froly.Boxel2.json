e_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjKoumlGS-0Q7kNvwEje_-W&_nc_oc=AdpmC-hbPV_Oo55WKs8lGSE9KrxeRhl-xu-F-HvC-JUqXZDlbLbfUyj3XDUuBDKhctU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC4M7w27rpYGlb-iQdl48X6ykxD9B9E8bMMuEqjDRp5g&oe=6AA55CF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RdElNcOUEcQ7kNvwFACNe4&_nc_oc=AdoPHti7nR0O5REM8kNtQoprU61ct_3xrulwNZgMpSUQtJ0nBPMjTXBCnJ7TD8dVx9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIXh87KYcJOEVdgWWJVqpcFCeZ_7LKn_73_WkCDIxbhQ&oe=6AA55C46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp_qf9aghk8Q7kNvwErGeSJ&_nc_oc=AdoyLlSUb88om70kDtp0Er-hNu_4aYBirkluLFuhk2a8QTddiBsFP4P9MuFzNCqNRFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8WDV_DRlE3BlVaP6Tbb8tyN1p9RbXcfKcYVy5sN2M-g&oe=6AA570EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgNCfxGhi78Q7kNvwECTCuY&_nc_oc=AdqjHFhwCJ91Y2R4RQZG9z4vM60kZH5X8f48FGhQCbVmGRXNZIis3jtRv4dU8h0As-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0TbDi-P_UF9XxFoJirFKkkRewQkRmYcSeaGW7EMHrig&oe=6AA54E95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbKJX9tjgmQQ7kNvwHCouhf&_nc_oc=AdrZhMNEuadSefKs57FmaI8DAoS-z_FNiGQ1ybHbCiZzTqwYfW0PjfR9acVmAZCvLq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy-SwDy8l4diZrspRlybOZmyPs3pfDG-SyqKWw0cWdug&oe=6AA56FA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUE19utvX8QQ7kNvwGRcGto&_nc_oc=AdoUcwiVv3PGYOBBAyWHnibqb8SlYTqwJ5cNWnKRJ7tC8sCxAX-AjXgEhxPsM1UtEvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbMgcYyep9Low2httWZDWLv8lMSmpQwn0fCD-YqxiRFw&oe=6AA550BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySZjd0rtnjcQ7kNvwHF1IeT&_nc_oc=Adov05IxPgdKfFfkoPzlTaRL0dziQl_KOjftkne1UK3rl-JWjtnonFv_4vpqdq9Itcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_YWFiYERkzYyjXFCrEPWZg1HQfF5fp9_Zkmp9OwsXOw&oe=6AA544CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUZ-a5CZgFsQ7kNvwF49UmN&_nc_oc=Adp7fhIq6TaX9u1UjVwHrpNNulojR1v6300TXet5cKdM4A_9jOpQbcevHH1qJzNBISQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f
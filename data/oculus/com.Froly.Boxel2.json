e_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSlWPwhMGlsQ7kNvwGVx2GD&_nc_oc=AdqD2vW0VmlgxUOGTqrbNUY7BtySGNsXelmx8_JfFh7D8nMQn1-jhNiqCq-Ifb3WSo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhxeCO8qFvbnA2c3ybLPIIIiecSsCvWCcIUiHnaDvEnw&oe=6AB7D1F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2-G-Vv7I7YQ7kNvwHePHoD&_nc_oc=AdqeSXuBDhjIgFgSrT98OiPnIf8d_UW0yIEnNsV6OemH4IcVYaA3mT48lZRrYZ1hb1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXOXiunB0VzwAi6uO7j-iCJjAkGu5tnRjxey6xLmT50A&oe=6AB7D146"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaceNq6o3DMQ7kNvwFWb3FJ&_nc_oc=Ado0h5KQH7PxeatpA3i9MF14Y14VKSUmO6GCDQ_Eusl_pbu0MJJ5CNjrCU8Z--82k58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzTFgsyKj8mloOKj5gAfGZXmr3iwHr6qoQjmXWZrCFRQ&oe=6AB7E5EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvK5v8AshHIQ7kNvwE0vvKP&_nc_oc=Ado7ctVu5w6A9c3FYQWgEKiWSIfV1gISVLRHL6d3XstPRTl1dwGnErd9Thu7D9IblkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMRTf_r3bOma-DphgmokUsVLPSQscGfOcl0qhIo3E8hA&oe=6AB7C395"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNWP-x5OES0Q7kNvwHmPQ58&_nc_oc=AdrIaECczK2kFR8Nt4_9SluaKMzzjbDIxmuLuboPpueqaztvoyC2uw1JNnTTzuZFXQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1DI5FlpOSSKLvP1czmbzP70YPKCY6jev17l8rD-1TDA&oe=6AB7E4A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddKtlEvBLCwQ7kNvwF0yvhw&_nc_oc=Adq4pxns8xru-z9Al0ItZwDfsUYKqtG6oBEi2S67KFr1M-pNgK2TumaWtw85cViX1h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlmi7uX5GRFdGqBNBott-yusZ3FbJi1jXvL7PLFn5VNA&oe=6AB7C5BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSmLhHWyNBAQ7kNvwEtD23h&_nc_oc=AdrQAKjYjBSUUOc3gHjX_9oZ71dO3jAOxkt0LDs8hUiFlwo6XmtRW2MzcKpVTz-MyYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqQH97BGlN_h2N4mbZ7Xtb61wcYidyYghW6J-32g9Ovg&oe=6AB7B9CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7akq6O4v7lcQ7kNvwF5NKM0&_nc_oc=AdruCBGMR-6CSJsLT3qqZv52FSKrpSta_Lw1E9JPlelxrHJUWHFKIUGojDxQLDA5XeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f
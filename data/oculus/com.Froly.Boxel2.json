e_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cona-7sXkkkQ7kNvwEgQVNS&_nc_oc=AdobMIfGHa_tkexlqtcc-v9ISKj6G43_mw65takrGoGGu1MT0E8tM0jF80l4W473ve0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSU9pUrFCVe2nzzzGLb_nDgcZ-6_omxBPYzQqr4Qo_mg&oe=6A50FCF0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leoZhhSPLxQQ7kNvwHfXEQ4&_nc_oc=AdoQ4UOZ25ikoxxu0h_KpF4XAZZ-42m08FPKxL6FzM8t5Cvkvrs-aA0XCXIoy_4psZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4V25gn_FNlZQdjHLIZh4aQ_KF0xI53AmnpSxwzCjjwQ&oe=6A50FC46"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZBF4CsRP98Q7kNvwGuNO_G&_nc_oc=Adqht9BRlArHuuI9eX5TGJFVDPNSjHUgJ8cyFRfRb6ElD7pecZWOhyqc_IEEfCs3ezM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqwoAxw5SKvGKJeChakKc4P73tOvGhX42T82_foySgBQ&oe=6A5110EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cniVhACyLB8Q7kNvwHJhFV5&_nc_oc=Adom4hrqSQqGE7MqFICCMHDA7M7FU679AyxqyzCSQIyrfXnfnYWWWvdr6zm0jggY2tU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDZjkVdf9lF2VTp33Rj1Doe2tc9ZEyusv2VGPvjQVIzA&oe=6A50EE95"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlDxKGPB4JwQ7kNvwEZSsub&_nc_oc=AdppJfpgynboH6tvDUPqhUssCnjGY3f_Z7ezDKUoS-O3mq3ytiA69G2zh-hHyJqmhjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKMXdRRpzdgi0abzr__WBjY9Dd0ruR2Iy8xg6_6Uvuew&oe=6A510FA4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHpA6JfI7PsQ7kNvwGdJyXS&_nc_oc=AdoHD3Gyp3bmmeyEcMmBl2ji1svS2UMmPPtJhEmqAShWldk-mu81CSAWMrXRQT0jUU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA474-c-7dzOwhZbYjoEkJgFb3W9r6x-l28PZs05yTx2g&oe=6A50F0BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAshbWyhcW0Q7kNvwHzrkyC&_nc_oc=AdocoJJ-GSF_vOJ1lR0RajQ_DjppaS46Uob2z1CCr_hZX25BdV-1UHRlNkjcW0AK9D8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQSm1QZJm51N-WTdvyEOpH7H67iHM7J0ASvkbkARMjeQ&oe=6A50E4CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bldo8F4NAkQ7kNvwHwlPhP&_nc_oc=AdoTZQDUd-oIudQcIvzsNpqhxD8q0_FTOTHsTyuhVLkxmIhZegtU2W3CmBN3LHeDL0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f
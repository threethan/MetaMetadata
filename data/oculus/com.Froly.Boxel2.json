e_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2OugiDlZm0Q7kNvwHiZFJ1&_nc_oc=AdoosAInSsbpnPl1Lza-pngGoW--N3BSUkDmo64oqLA2FscJYWyxxwUWCpCuSfmwUMA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DAZ4GslKovyJ2l9mp4Btn_m47UL8rURggp9c2Sb7Cow&oe=69F60570"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAaqFV7HSywQ7kNvwHrBxnD&_nc_oc=AdqBlRYSk-y3h6bTciRosU6-EeA41PqLs7-SKSzYX98UtTcbQu16kiMjiuKewyQTKlw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jaa2oubYlh7NSQTycDPe9wi6LkicSF15ujcIpld3rAw&oe=69F604C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd3OW4lrKn4Q7kNvwHDnApR&_nc_oc=AdqUe0YNCzQMfpG8hdH5UfrkRUai95QHO7jww-syEbekmy9eCDc_wnK0mOp25P9KVJc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Wj1ckD96UeGozBCWbVaPt1pNaaw9TPVY50RbhYoTEqw&oe=69F6196F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7lEId3XlqAQ7kNvwHFPwTO&_nc_oc=AdpvPYze6VGHnPDDdJLiHkzrwVXgEnz_lm6f1mDIh4j30IZ3ah752Vctiyq-Jr9auFo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1P8Z8prB8EYoK-YmytjaYvohUtVgwEc1eyHlPHBrbssQ&oe=69F5F715"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6OXOJGqME8Q7kNvwH_GwKJ&_nc_oc=AdraEA-cMM4LFuXcYOv396r7C8CHVdctADmyQddChSJDs63YoaJto1gDO6EymgAXzTg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zO1hWdE5RprcugzjgpAA5XtPhEegtnTXsrET7UZOfEA&oe=69F61824"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyKusg-giC8Q7kNvwEPZ72a&_nc_oc=AdrlTxOFw4HY5-EckUrDPyhhZbb72pmm_BfmUcQjdNwQJHLlZfViYwLcEnGvLBB3DIA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3amDpc7mBxns5WHs3nx2U4YkRgu6tBMtmyfrcTXSCs5A&oe=69F5F93B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiYV87BeRF0Q7kNvwGX0xto&_nc_oc=AdqKH2GkTgg3Cj1jqvDd544I0XPR_vkLjj-I8cX518VuGSd_KOv93Sh7lAkEnQa3q7Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ilhh6YaH0zjb6ANVJ1Vw-xpTO4FCJcJhzwuFvsdGdzw&oe=69F5ED4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3mf57MXCigQ7kNvwETY8Fy&_nc_oc=AdpftF9ZVXtpPKXKi3gr0gSUaEET5RIlzBSN_qlOrKEH0KgJsvyqOmqDaAcGFWicbRg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I30lzoI8Yq8Q7kNvwFx32K3&_nc_oc=AdrGpntGVXlJoPI7T9284zz-C--bCBW_jCnKMVfq58iQRqRVROaJ9A-q3uoxkEpGuaM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cQ-frNch3LqO3xhac2MtnALB-Cm3o5wH2OBgx0wrQBw&oe=6A106370"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dPNBvj5NpEQ7kNvwGll9B8&_nc_oc=AdpAU76SQbQvuqrK7wtHDm7T-fnyVszBP58W4Qp1r7K7tI22jF-__N001MWtK4vggaE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af517tWt1MaXjCZWCDUPRMcId2qKMga_SSIxjuF6yhlaiQ&oe=6A1062C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Re8KRSgCVYQ7kNvwESh5B8&_nc_oc=Adrn8nMwW-SYBLQHslT2PQxDT2wa2Ti0MYtqZnUnXXLOgT9WXwMMs_CNTC1bQ4z74qE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dyuz8U2qhC8nic7tiYXm6KACHNurhdTXh2Eu6a1Rd0Q&oe=6A10776F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6MTzn945pkQ7kNvwGIsrIT&_nc_oc=Adq1SR5UWWenbgRAVHZF8I7L2jL3_PozkgTr0FP6gzYnp38c928AP2sZzq4HxD9lch0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LvMFjPkAnHIMtT5HM5zJtY5BMGoYosTRvcDnv3_GSrQ&oe=6A105515"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i81zjk_9dacQ7kNvwEqr67_&_nc_oc=AdoTobgh8fZn45csBE91ME4PZbtcYaS2U5xYJ8yrlQdn2T2NXawwscnAUrUclsAFAwY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vg6gTD-pAL1VPQ30qjug4AVpQaIyTMOMBoBvBsIaIvA&oe=6A107624"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzOelejyzLsQ7kNvwE6lLew&_nc_oc=AdqhpbdAyhK0QyE1wIkqk0zND2hf8t490BwQVr-ioQ54TLD19Z5cvz7hhkCAOzzxEBI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IGhQNmDxA4Q8gtA7yr-eHc5XLGPTy6OtYdIDFM33HPQ&oe=6A10573B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z4PK1zxctAQ7kNvwH9dRxb&_nc_oc=AdoYFLqLrMWoOWKPaHPpPC6Qnv7TvLvLqvIHhOp_HWPz5MJY9qdb5GI28Ii2KMtcA3Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KwlXCpVI46viODwCVzmjgcDfB-Y-5E_F4cXv7GuBC0g&oe=6A104B4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVthBWZ7lWwQ7kNvwEuklOM&_nc_oc=AdrVqy4i4GkwAkZHj3z6qr-t2Zkh026576H6gyQcOQSaFYIh0zrSQ7gbxVtEkW6aLwo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f
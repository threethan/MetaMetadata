e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_tHhWeTHO8Q7kNvwGwRpIa&_nc_oc=AdqMADJbwCiXJJ23hPX_0qTM_ejq_UakYiyNNzee7FY026J_0ysBOaL80Qnfq5N3TVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRInWaHPwwyGg3ldRcW-CQ5r9s3wj5osVIHjVHeyh_O-Q&oe=6AF476F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84ippZQA4BUQ7kNvwHa-MVM&_nc_oc=AdoSnoGsXJte4j1Z_mhVNuaPO8Q1HVeVXE90p-tr_eGcCiPHfeMNLYyCBTXsbYw8c-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStBgAi0FW0cqY5gWjP-Cu7KWJqk45Uyv94nyLmM4ap2A&oe=6AF47646"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKTeBbNRAesQ7kNvwFxtVAu&_nc_oc=AdrSNVNpza7W7B4rwuNo-EAVJBR2SjWnm-qXJnjR96UOAN4NC6g2XW1LYUnPcpg-LE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY8mk_6uz-GKs-pKjvrPRa6qHWxGekGALEX_AEednCZw&oe=6AF48AEF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn0OiFiLeicQ7kNvwGj3gZa&_nc_oc=Adpn43iBR8GktDpUzmPPm6P1fgt8SfQjvGZg4ns14z45ITsmc2Ss8dGKWwB0dvb0ljY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEb1OPzeTKXAIGlc1J3OSLv0Hx1AGSld1tbKAIasUgVw&oe=6AF4A0D5"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNvfFlcPKtAQ7kNvwH8oBgT&_nc_oc=AdoQNj_qdP3AQFO-I5uTR6EUJ85eczKiYU42POZaVaCNhm1iYGGioPGNVYGIy51pghk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlEuju5r7LI_p_Os-84KtEt5k8ta4snA3C6l2_dHyReA&oe=6AF489A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nsc4nJwLVncQ7kNvwHSWcO9&_nc_oc=AdpC4oQvaBTf0lqZ2PXxa2crVrKwgQrKxfDFTZXA5-d4x6qactiGgUEdooJyFDDseHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsygGn0iJfpFm1jALGqGzfY6XFW9suXiLJIJiwopHxJA&oe=6AF4A2FB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUEf3zbeay8Q7kNvwHgNYZO&_nc_oc=AdrqHOSVrBZGIMRwjJ61JznMV9HPOSkc_q51SiN6vEyrt3Wiw_Og-hKHNrqV2Fx-pS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI6nn6q8pbhSM6XpTkrzKu3W9nEngF10kE8Mdkzufqbw&oe=6AF4970D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRJFq675FBAQ7kNvwGkH5j4&_nc_oc=AdqjfIxQQiq3UjPLJim2VZWaWRY4T8xAaHgepJczM1d_QM4TB9ckfAGejJu8dhEFUqg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
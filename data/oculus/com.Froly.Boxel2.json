e_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyjz57fycRQQ7kNvwHbE-wC&_nc_oc=AdrGifgWxi16c_krSV6KeSKW5OeDXDWeoC1BL10fFy5DyY9skjhc6rHEQFEOblEu5g8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ-aIEWOES-3gjxYheTVaNDiW5Ak8-LpRDtem5dtb4-g&oe=6AE89970"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIZj_mg7YqsQ7kNvwGAkuod&_nc_oc=AdpJJ5wt79UwNSZQltAfX2u1KWkAoxo_Ox3D3yHu_fzIgu5i_fgvb7klLaFhcC8aQas&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjPRcpmesmaZ4xdrK933YkLD2dfdHCIVd-72z1B7Z81A&oe=6AE898C6"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88fMuLDadY0Q7kNvwF5gJ_C&_nc_oc=AdoCOFzOev3mQQ7JDnqGNmNG0c2qtojnfBc8xEV5_i1iWhKmmkgGhnx5neRgEc9Smeo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVx28BG9SoJT5phpo9bkWpHCEHaZfHkR3WkSv87IEZbQ&oe=6AE8AD6F"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUj0LwVjwtwQ7kNvwG8zMw7&_nc_oc=AdqCZzKsZbOVD2ORryTJLKDuD1M5iHO3BjkLyBvqwWSGntrvXrWEpA-UXVW1qR3tEuQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFD718nhS4cHYXpEiPOWufJFAXjURE-rzUgXiH9-3uzQ&oe=6AE88B15"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkRgN3vO2hsQ7kNvwHluKb5&_nc_oc=AdoR4jnDouqRVzJyQhg9HjB8Cli2y-iUQ1X6d6e6DcCeKZRXkZKRyfZkmqInSnWCTuo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNDiph91OBAJbvoOZxbJ_WM2snpe-8iNQtCMDaYuJrCQ&oe=6AE8AC24"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ3tieRyasUQ7kNvwEaQvUW&_nc_oc=AdoALA_agQcB4cGk8sKT5HccNNY3KzTvRcJcN7oJqYPe9nZoQVW4HcP0ZD8DqxK2Ga0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_AJQss6_owfARYXPoUClcHHX_aW_uLJu7thXlMaBA3g&oe=6AE88D3B"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AHm5nmPY78Q7kNvwGtXXQq&_nc_oc=AdpUdSFv9Mw0ucYc83ZK8oPQ_D5wLSXRQn9TvWLEuy4AyFGryvJyDCiRldQ7jxLtmQ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUNq2zd4nZuAFPPO3zn6505qfeukvxFysdT-osIjUOvA&oe=6AE8B98D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC1COOfBGKwQ7kNvwH_9oxv&_nc_oc=AdotPGGbcOcYDKdmxomFqKoCOn--pyI2bqsLJDkzwABQPpCn1E3YFDZ6hVfCKNqZ5Hw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f
e_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_539262128384341_3554237161850955177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cWH-QSrNk8Q7kNvwHihr1m&_nc_oc=AdqXnGvEYK34L_d7UtqqL-9A7yRACgqRJ7M_9v1FUgEOo81NKcRA1uk156JjyMKjoiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI3FNvNaGkodFuVg2hML7jpCzdJnypzFLgmehhRGn-OQ&oe=6AAAA2F0"}, {"file_name": "2560x1440.png", "id": "188794360676899", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_188794364010232_2707317430732963338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5cc_koOlLUQ7kNvwH6gmpQ&_nc_oc=AdomZtXp0WkJqZ_--qrUl8cfxcejTUu5BlktbG7jE-aSRZVSrlF8lESPK3BYkOD4q6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVWrd1e6_ncYYnx4CH-WBsHyA1lKg7As6uSqnAkXG4aQ&oe=6AAAA246"}]}, "id": "1695210321247300", "locale": "en_US", "screenshots": [{"file_name": "Intuitive Creation Tools.png", "id": "1029036718423061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_1029036721756394_4992156078514638711_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3ErUMycGc8Q7kNvwHT9CCE&_nc_oc=Adp_47jEGXhpvK_WRcC_4szC93KiO0U9V7UNgPvHy8O3Lxh5lyuMq7BL0jC6hRgbNkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvW7bghMMvF5jBK6hu7AUGmcNt1ifPaghQdpOxdpLVzQ&oe=6AAAB6EF"}, {"file_name": "Convinient menu.png", "id": "1197336851496888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001658_1197336854830221_4401009542626981889_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikRMSOhSUsYQ7kNvwHVTTPl&_nc_oc=AdoKLU3zttYm37x1cKPoqKRmuqkxglrCS_wnhkOeznkBqewiT5pV9JkTkDdJl0svrao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVNvG6FGp_skoDtwBBoFZ2Yrx6nRsSNXFId09VCRPH6Q&oe=6AAA9495"}, {"file_name": "Export.png", "id": "487812637284692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570298_487812640618025_339995972252666015_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyrR_z4wh7MQ7kNvwHrPfFn&_nc_oc=AdrE0NJKIJBzHTJQRqcdjoX5kYvnUgGdIQmWdj8vPbcxheYuencZlPvpqvLe-wtbiHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZr8MheKcCgiUbJxklsoVqxGY80SSzSYq6NVQemnRzEA&oe=6AAAB5A4"}, {"file_name": "Library.png", "id": "828416116104754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_828416119438087_1951046805749587116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaVarRLUlxUQ7kNvwHFlOwG&_nc_oc=AdoJmXkC3G2tVIjeJlH5Tbvo0z_x5gddaGgndIh4VxHQp59w5_VJqA7yPWKJHuWCF-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRS2kE65gzvryi5NYpir-nRvwHH19ZqnjO_Ioy-WmMrg&oe=6AAA96BB"}, {"file_name": "Convinient menu.png", "id": "773918394382701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003236_773918397716034_2302815709020033590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8MDbsrVgd4Q7kNvwHd8hTD&_nc_oc=AdoUHVMRGSuqk3LGYbdis7bvGzjf7kO6ewttO_t99JNCp4XiO7oJFwyCf2ZkcGaJeng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm6Jt4xEPMwzZb8FCShPBs6QQCJTVguTJ1YFVSwhDTRg&oe=6AAA8ACD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxelXR", "keywords": [], "long_description": "BoxelXR is a simple voxel editor designed specifically for virtual reality (VR) platforms. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nVoxel-based modeling is an approach to 3D design, which allows users to work with blocks or \"voxels\" rather than traditional polygons. This approach is particularly well-suited to VR, as it allows for a more immersive and intuitive design experience.\n\nBoxelXR makes voxel modelling accessible to everyone, whether you're an experienced 3D artist or a beginner. Its simple, intuitive interface lets you start quickly, with no complex menus or confusing navigation options.\n\nBoxelXR is an impressive tool for anyone interested in VR-based 3D modeling. Its intuitive interface, powerful tools make it a must-have app for anyone serious about virtual reality design.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favourite 3D editor.", "short_description": "BoxelXR is a simple voxel editor designed specifically for Mixed Reality. With its intuitive interface and easy-to-use tools, BoxelXR allows users to create stunning 3D voxel models easily.\n\nBoxelXR makes voxel modeling accessible to everyone, whether you're an experienced 3D artist or a beginner.\n\nOnce you have created a model in BoxelXR, then you can export it as an OBJ file to your favorite 3D editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxelxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Froly", "support_website_url": null, "website_url": "https://boxelxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8086895788053048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75469632_3589473471285345_3979787984636405068_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_VCjo2y_4AQ7kNvwHDYaCY&_nc_oc=AdqHruLPmnerOQspa_-WPCPTw_cLPZ_oaStKe64cUX_AV_ni7cJ8-igCTRWRnCwfxWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f
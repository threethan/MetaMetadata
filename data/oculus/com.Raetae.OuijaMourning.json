c=AdqJOhF88Sc3vLrKufPzDkzffPK2tSflseTA6iTrC7aIKoHjaWYcYrTwC3EqOsfxW3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwUbw_kte4-udXpTYzipnb68GXusaDC7pBo9nwW5x64A&oe=6B0EF3E4"}, {"file_name": "HighresScreenshot00014.png", "id": "27000821686231501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982521_27000821692898167_6607588105269289425_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc8WUpFi9EwQ7kNvwHb921z&_nc_oc=AdrF7HAf_rwij0lP7TxWAf3Z9OApP8dehO6C8X2VSy3MZ-CrH33_2YPXjP17qlLeG2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhDf2sQT1sEMioVT1kesOvF_O5JO46WcbRSwO2aT_ZSQ&oe=6B0F0A39"}, {"file_name": "HighresScreenshot00019.png", "id": "1570281420253217", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974902_1570281423586550_6579590704803980615_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDqC9xKyZIsQ7kNvwF5Z5wG&_nc_oc=AdpsgvxFnWmpCXmEh6cprlpwEM37GABH1a21esbXrwwb_Rzu7TUk7Y4ru2bB4XRXLUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPmfcBMLJ6WRYsfsSehk7dhVfRX9a2Oy-T3ZblD_F3OQ&oe=6B0F2063"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ouija Mourning", "keywords": [], "long_description": "Ouija Mourning is an encounter with the unknown. In the dark corners of the mansion, the spirits are waiting, listening to every question you dare to ask. The Ouija board is your link, but also your curse. Each time you reach out, they respond. Each time you listen, you invite them closer.\n\nPrepare for a journey where fear is your only guide. The spirits will toy with you, revealing whispers of a past steeped in tragedy. But remember\u2014some answers are not meant to be found. The further you push, the deeper you fall into their grasp. The air thickens with dread as you realize you are no longer in control. You\u2019ve opened a door, and now the spirits refuse to let you close it.\n\nIn Ouija Mourning, it\u2019s not just about solving a mystery\u2014it\u2019s about surviving the terror that follows you with every question. The board is watching, the spirits are restless, and the darkness is relentless. Will you have the courage to face what\u2019s coming, or will the spirits claim you as their own?\n\nEnter if you must\u2014but know that once the board moves, nothing will ever be the same.", "short_description": "Ouija Mourning is a terrifying VR experience where every question to the Ouija draws you closer to the restless spirits of a haunted mansion. The more you seek answers, the more they bind you to their world. Once the board moves, there\u2019s no turning back."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/ouija-mourning-privacy-policy/c8af7c57-ca88-4871-b39e-1cfca62b95f9/privacy", "developer_terms_of_service_url": null, "publisher_name": "Raetae Studios", "support_website_url": null, "website_url": "https://ouijamourning.rf.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8828931250465076"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1218155473085698"}, {"status": "CANCELLED", "id": "669899645689045"}, {"status": "PUBLISHED", "id": "577638728766017"}, {"status": "PUBLISHED", "id": "1884812398718211"}, {"status": "PUBLISHED", "id": "952271896806042"}, {"status": "PUBLISHED"
t-ord5-3.oculuscdn.com/v/t64.5771-25/473393846_1775135623309195_8942055283819634574_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnwhXOvzXhkQ7kNvwFv20xs&_nc_oc=AdpB27gVmfAtEikonGoRoW_6z2q5_hfE_mVn0VtDVrcYrob_mMNDzipIWkT8gJblqaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2egWeLz5Bmk6fGC5bpivsa3LvOTgrVFg0dvVkUdFD2IA&oe=69DCF6B7"}, {"file_name": "\u062f\u0631\u0648\u0628 \u0627\u0644\u0645\u062c\u062f_Screenshots copy-10.png", "id": "1155933759573182", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391893_1155933762906515_9023979199040906290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdTChEV6DU0Q7kNvwGw7LIo&_nc_oc=Adprhi2uRjGaLKiXQbYbYTRoY_-TCquhO4Uh58vcjRDVMGdXdVw-iPg8zjxGOzbjgLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2prJBu2FuOD7DdvmYSzwtyxFvWarSqe3xAt9wCElKCOw&oe=69DCF209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u062f\u0631\u0648\u0628 \u0627\u0644\u0645\u062c\u062f_Trailer Cover Image.png", "id": "1369519544413655", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391998_1369519547746988_4716867379981044691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky3LkmAtSu4Q7kNvwGW8APc&_nc_oc=Adqi9LfoWOoZ1qPMDtL3Ohoq4HtRsOzJivUkqR_81X895UnCIxcq2HDGH_454lH9-Sk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09M_b67sD9jYp2SDXs0ocFg4yCaYzuWAqp4T31olQ2Tw&oe=69DCDD8A"}, "display_name": "\u062f\u0631\u0648\u0628 \u0627\u0644\u0645\u062c\u062f (Duroob Al-Majd)", "keywords": ["EndlessRunner", "SaudiArabia", "RMG", "Culture", "Adventure"], "long_description": "\ud83d\udd39 \u062f\u0631\u0648\u0628 \u0627\u0644\u0645\u062c\u062f \u0647\u064a \u062a\u062c\u0631\u0628\u0629 \u0648\u0627\u0642\u0639 \u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0645\u0644\u062d\u0645\u064a\u0629 \u0645\u0633\u062a\u0648\u062d\u0627\u0629 \u0645\u0646 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u062d\u064a\u062b \u064a\u0646\u0637\u0644\u0642 \u0627\u0644\u0644\u0627\u0639\u0628 \u0641\u064a \u0633\u0628\u0627\u0642 \u0644\u0627 \u0646\u0647\u0627\u0626\u064a \u0639\u0628\u0631 \u0628\u064a\u0626\u0627\u062a \u0645\u062a\u0646\u0648\u0639\u0629 \u062a\u0634\u0645\u0644 \u0627\u0644\u0635\u062d\u0627\u0631\u064a \u0627\u0644\u062e\u0644\u0627\u0628\u0629\u060c \u0648\u0627\u0644\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629\u060c \u0648\u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u062d\u062f\u064a\u062b\u0629. \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062c\u0631\u064a\u060c \u0633\u062a\u0648\u0627\u062c\u0647 \u0623\u0633\u0626\u0644\u0629 \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u062a\u062e\u062a\u0628\u0631 \u0645\u0639\u0631\u0641\u062a\u0643 \u0628\u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0648\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644 \u0643\u0644 \u062c\u0648\u0644\u0629 \u0645\u063a\u0627\u0645\u0631\u0629 \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0648\u0645\u0645\u062a\u0639\u0629!\n\n\ud83d\udca0 \u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0644\u0639\u0628\u0629:\n\u2705 \u0628\u064a\u0626\u0627\u062a \u0633\u0639\u0648\u062f\u064a\u0629 \u062a\u0642\u0644\u064a\u062f\u064a\u0629 \u0628\u0623\u0632\u064a\u0627\u0621 \u0648\u062a\u0631\u0627\u062b \u0623\u0635\u064a\u0644\n\u2705 \u0633\u0628\u0627\u0642 \u0628\u0644\u0627 \u0646\u0647\u0627\u064a\u0629 \u0628\u0633\u0631\u0639\u0627\u062a \u0645\u062a\u0632\u0627\u064a\u062f\u0629 \u0648\u062a\u062d\u062f\u064a\u0627\u062a \u0645\u062a\u062c\u062f\u062f\u0629\n\u2705 \u0623\u0633\u0626\u0644\u0629 \u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0627\u0633\u062a\u0637\u0644\u0627\u0639\u0627\u062a \u0631\u0623\u064a \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0644\u0639\u0628\n\u2705 \u062a\u062c\u0631\u0628\u0629 \u0648\u0627\u0642\u0639 \u0627\u0641\u062a\u0631\u0627\u0636\u064a \u063a\u0627\u0645\u0631\u0629 \u062a\u062f\u0639\u0645 \u0623\u062c\u0647\u0632\u0629 Meta Quest\n\u2705 \u062a\u0646\u0627\u0641\u0633 \u0645\u0639 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621 \u0639\u0628\u0631 \u0644\u0648\u0627\u0626\u062d \u0627\u0644\u0645\u062a\u0635\u062f\u0631\u064a\u0646 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629\n\n\u0647\u0644 \u0644\u062f\u064a\u0643 \u0645\u0627 \u064a\u0644\u0632\u0645 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062c\u062f\u061f \ud83c\udfc6\ud83d\udca8\n\n\ud83d\udd39 Duroob Al-Majd is an epic VR experience inspired by Saudi culture, where players race through stunning environments, from breathtaking deserts and traditional souks to modern cityscapes. While running, you'll encounter interactive questions that test your knowledge of Saudi history and culture, turning every session into an exciting and educational adventure!\n\n\ud83d\udca0 Game Features:\n\u2705 Authentic Saudi environments with traditional clothing & heritage\n\u2705 Endless running with increasing speed & evolving challenges\n\u2705 Cultural trivia and interactive surveys during gameplay\n\u2705 Immersive VR experience optimized for Meta Quest devices\n\u2705 Compete with friends on global leaderboards\n\nDo you have what it takes to reach glory? \ud83c\udfc6\ud83d\udca8", "short_description": "\u2728 \u0627\u0646\u0637\u0644\u0642 \u0641\u064a \u0633\u0628\u0627\u0642 \u0644\u0627 \u0646\u0647\u0627\u0626\u064a \u0639\u0628\u0631 \u062f\u0631\u0648\u0628 \u0627\u0644\u0645\u062c\u062f! \u0627\u0633\u062a\u0643\u0634\u0641 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u063a\u0627\u0645\u0631\u0629 \u0633\u0631\u064a\u0639\u0629 \u0648\u0645\u0644\u064a\u0626\u0629 \u0628\u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0641\u064a \u0627\u0644\u0648\u0627\u0642\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u060c \u062d\u064a\u062b \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0631\u0643\u0636!\n\n\u2728 Race through the endless paths of glory! Explore Saudi culture in this fast-paced VR adventure, where you answer interactive questions while running!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/aecd909b-d71b-4d71-b742-ed5fab02ed41", "developer_terms_of_service_url": "https://www.freeprivacypolicy.com/live/16291b84-809e-4c1e-9234-50368582e929", "publisher_name": "RMG", "support_website_url": null, "website_url": "https://www.rmg-sa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9097137076987968"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_515876644642770_6739070368530647431_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypdEMrRqJ-oQ7kNvwE0AexP&_nc_oc=AdoVjg9MdQtlidWtU2Se7UDzphZDzlhawHC1vCIcsJZSSLKFdJL8yu_HsjK9SrTlpMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jKpDGt76mlVtetqyjnTVuv6YkqfAlJGnCX6Frry6Avw&oe=69DCE4DF"}, "
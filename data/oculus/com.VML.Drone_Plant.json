-22 165011.png", "id": "1525723112677408", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_1525723119344074_1758043080950966259_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2Qw4uFLEtIQ7kNvwEuc8Nj&_nc_oc=Adodlb6WeUmAKVDOBL-6tV-dmTjlAOXkAuss0TgMnIjmy6ur6yo86VJEL7pVGQvz0l8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVFhhwwAoI4VTtCItS3c4f3vxftduXDz-hCWkP5fyHyg&oe=6B09C639"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Assembly Plant", "keywords": ["drone", "factory", "automation", "engineering"], "long_description": "Experience the power of modern industrial automation in this immersive VR simulation. Witness the precise, step-by-step assembly of an advanced VTOL (Vertical Take-Off and Landing) drone on a fully automated, moving production line. Designed for robotics enthusiasts, engineers, and tech tech-heads, this experience puts you front and center of a next-generation manufacturing ecosystem.\n\nWith a simple start/stop interface, you can control the line and closely observe how complex machinery coordinates to build high-performance aerial tech from the ground up.\n\nKey Features:\nAdvanced Robotics Ecosystem: Observe high-fidelity UR10 collaborative arms and rapid SCARA robots working in perfect synchronization to handle, position, and secure components.\n\nSmart Factory Automation: Track the flow of a modern, moving assembly line optimized for maximum manufacturing efficiency.\n\nDetailed VTOL Assembly: Watch the intricate mechanical layout of a drone come together, from structural framing to internal components.\n\nEngineering Perspective: Get a close-up, unrestricted look at industrial robotics in action\u2014an ideal simulation for anyone fascinated by automation, kinematics, and smart manufacturing.\n\nControl the line and see the future of automated drone manufacturing today.", "short_description": "A relaxing VR simulation of automated VTOL drone assembly and robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vmlafrica.org/docs/Virtual%20Mechatronics%20Lab.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Mechatronic Lab", "support_website_url": null, "website_url": "https://vmlafrica.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1892497271439757"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2072515620332613"}]}, "baseline_offer": {"id": "2072515620332613"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786447620, "status": "PUBLISHED", "id": "2072515620332613"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2009528176403332", "version": "1.1.0"}, "id": "1656931028923593", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1892497268106424", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2009528176403332"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1656931028923593"}]}, "change_log": null, "created_date": 1791812882, "id": "2009
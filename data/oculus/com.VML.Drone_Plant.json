culuscdn.com/v/t64.5771-25/491823949_1290807213115357_2404491380366031415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQdoP1_sh-MQ7kNvwGxWjXN&_nc_oc=Adp2rMBcF7Cf9cEF1hx2qPVayRrvAZNmw4jmN9134BymStyJNuX9b4uAcWef9U9FrOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7P-UW_ZFulxQ6gK0BwqgzCWx4dsyqA_H3q8MIXz9M3g&oe=6A9C3A54"}, {"file_name": "Screenshot 2026-05-22 164816.png", "id": "808880655427064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823349_808880662093730_6622407357502511178_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BVBdTdpMo8Q7kNvwFGm-M-&_nc_oc=AdpYtjdmtNOiNycKmL7Z9dSNy0Y1x_92VJ5t7CbgSxFJzjDf5Dv6oBtNWRZiLIx533I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwzUGxRyScsgqfMhfSuwYwb3PKyq2tFz25ZfDSBK8_GQ&oe=6A9C24E0"}, {"file_name": "Screenshot 2026-05-22 165011.png", "id": "1525723112677408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823790_1525723119344074_1758043080950966259_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBMSkiswCxIQ7kNvwEB1CUI&_nc_oc=Adp2dNwt1h--n6khWajVoSmYma-QejfTZisGZN9XXsmBqFskRsFp6YXMM3JLLX-Vpqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-kn_Fv6UFtibixpDPi6nCnMfCx1u_dAvNfvkObV6ZYg&oe=6A9C2179"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Assembly Plant", "keywords": ["drone", "factory", "automation", "engineering"], "long_description": "Experience the power of modern industrial automation in this immersive VR simulation. Witness the precise, step-by-step assembly of an advanced VTOL (Vertical Take-Off and Landing) drone on a fully automated, moving production line. Designed for robotics enthusiasts, engineers, and tech tech-heads, this experience puts you front and center of a next-generation manufacturing ecosystem.\n\nWith a simple start/stop interface, you can control the line and closely observe how complex machinery coordinates to build high-performance aerial tech from the ground up.\n\nKey Features:\nAdvanced Robotics Ecosystem: Observe high-fidelity UR10 collaborative arms and rapid SCARA robots working in perfect synchronization to handle, position, and secure components.\n\nSmart Factory Automation: Track the flow of a modern, moving assembly line optimized for maximum manufacturing efficiency.\n\nDetailed VTOL Assembly: Watch the intricate mechanical layout of a drone come together, from structural framing to internal components.\n\nEngineering Perspective: Get a close-up, unrestricted look at industrial robotics in action\u2014an ideal simulation for anyone fascinated by automation, kinematics, and smart manufacturing.\n\nControl the line and see the future of automated drone manufacturing today.", "short_description": "A relaxing VR simulation of automated VTOL drone assembly and robotics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vmlafrica.org/docs/Virtual%20Mechatronics%20Lab.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Mechatronic Lab", "support_website_url": null, "website_url": "https://vmlafrica.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1892497271439757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623601_993945236924671_7855792165502063147_n.png?stp=dst-png_s360x3
xeNQo&_nc_oc=AdoKucwn0DkRyhZsLP-MCMQ4DvMP4fqrRTeF_juC75D7cK8LvDufmvo-i2dNFtyxmd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoIixdH-qQs-8VlexRLm8C9-PFvCqZb8R8T9ppivsUIg&oe=6B0F1058"}, "display_name": "CoDo Fit", "keywords": [], "long_description": "Welcome to CoDo, the science-based social wellness app for families and friends to stay fit, no matter the distance! Walk, talk and be together with mindfulness, brain fitness, and exercise features\u2014all in one place. CoDo offers effective low-impact workouts in beautiful destinations, motivating you with positive physical and emotional benefits. Enhance both body and brain health with science-based cognitive games. Round out your wellness routine with mindful breathing and meditation in a tranquil spa environment. Step into a world where physical wellness meets social connection. Get CoDo to connect, engage, and thrive!", "short_description": "Welcome to CoDo, the science-based wellness app for families and friends where physical wellness meets social connection. Stay fit together, regardless of distance, with features like mindfulness, brain fitness, and exercise. Enjoy fun, effective movement in beautiful destinations, improving both physical and emotional well-being. Boost body and brain health with cognitive games. Enhance your routine with mindful breathing and meditation in serene settings. Get CoDo - connect, engage and thrive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://matialabs.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Matia Labs, Inc.", "support_website_url": "https://codo.fit/help", "website_url": "https://codo.fit/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
s67DWJln1O7SKUujksNozu41yeXQZNQWqfaYLv3Skdw&oe=6A974FE2"}, {"file_name": "Screenshot 3.png", "id": "829476353454084", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819281_829476356787417_5469302779585163515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS4OG6e69bsQ7kNvwFRs5kU&_nc_oc=AdpGXLuahsFBU1Ec3I9p1WKUxapUw5spLvmX_6T7DS2QHKaXQv_lUmuim2YCGG7DFcc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5rs9x1fiCij4auiK4IPaptdwIeS1w1I3BE0-g49WlNA&oe=6A972590"}, {"file_name": "Screenshot 1.png", "id": "727998087037068", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820428_727998090370401_7583362106089638061_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5rGup0v1OYQ7kNvwGNUcBJ&_nc_oc=Adq7Vkxsv3ihxwf23PgbD3NkMRSxj9BanV_Ibj9RsjvoSEHaBSguNSDFD2y7tDmKwZw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy8g_jOh3bQWPWPCGoKyKinZn40TbL04JResScDyuqww&oe=6A974C95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERR11.png", "id": "2110231679780336", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823271_2110231686447002_8383976339808798453_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hspyrqVMGHYQ7kNvwFo73JL&_nc_oc=AdrfiFI0kH-IUVlOGeiy_UrQaQjtVRX9PJ5NnccovSeEs8ujawrHbhqIyJjVuj7pQK0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuVK-0H7hTLDK97F2IqPEOFJk-xglBqxXHPzENMcYQhA&oe=6A97403F"}, "display_name": "Cake Or Fake ?", "keywords": ["CAKE", "FAKE", "COOKING", "KITCHEN"], "long_description": "Step into the most hyper-realistic bakery ever built in virtual reality. In Cake or Fake, your mission is simple but mind-bending: create cakes that look so fake, then put them to the ultimate challenge.\n{738003039364771}\nMaster the Art of Deception\nForget standard round cakes. Use our advanced sculpting tools to mold, frost, and paint cakes that look like sneakers, succulent plants, power tools, \n{1398223695174123}\n\nand more. If it exists in the real world, you can bake it\u2014and fake it.\n{893375953183877}\n\nFeatures That Blur Reality\nUltra-Realistic Physics: Experience a cutting-edge physics engine where batter pours, fondant drapes, and knives slice with satisfying, true-to-life resistance.\n\nStunning Visual Effects (VFX): High-fidelity textures and lighting make your glazes shimmer and your crumbs look good enough to eat.\n\nImmersive Spatial Audio: From the tactile crunch of a hard chocolate shell to the soft poof of powdered sugar, every sound is engineered for total immersion.\n\nThe \"Final Cut\" Moment: Take your creation to the judging table. Watch in high-tension slow motion as the knife descends. Will the judges be fooled, or will your cover be blown?\n\n\n", "short_description": "Cake or Fake? The Ultimate VR Deception Challenge\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cake-or-fake-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 OWL STUDIO", "support_website_url": null, "website_url": "https://sites.google.com/view/cake-or-fake-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25321858817516187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824303_3102732559932695_3694308097903725178_n.png?stp=dst-png_s360x360&_nc_cat=
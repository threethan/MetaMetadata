/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1aBxKlqDikQ7kNvwF47H1O&_nc_oc=Adqo5NRnu0QqXIS4GiMhvfIx3Gob6oNWRhboOio3HmLweY0gbe6zIHHa10izb19Po5g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn_2N7D24G31zJRel31yUQvjGersJ7BVojehXmQ7x8vQ&oe=6AE8BA67"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzgxQwptAQoQ7kNvwEdC2t2&_nc_oc=Adr7NiDojWv7KIGplbqCbt65gnuAz4qRQsxZi7-GWRdTFiQzoD_a7CRXlcBXIgdR1O4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt-EOd0hc3CZ3jWoEt_rhlFF5FFUgp9ya44X1L-I9Yfg&oe=6AE8A41D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX2MD7Uz9gsQ7kNvwEcdMgE&_nc_oc=AdrnhnisbEb2420XNNRdCl8nv0rLQg7vsE08GxbcsWVEArWbjI0aUH3ibS0cV__FbrE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeMhhEx0JVN14Fa4Mic35eFAOzGjL_aqqihCNpbSIpGA&oe=6AE8B79F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMJwsriO3-oQ7kNvwFjMr1i&_nc_oc=Adrg8366rRyMva0yXUjDGz2qxukJN-QksZOO3DOhxIZtuWLMT3CZH73R9dwZxZmf0dc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSmWyBftefc0ItPjqRj29KT_5RwqjglmiA99pEXTpm_w&oe=6AE89104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQgYFN2kX9kQ7kNvwGKkA8H&_nc_oc=AdrTuLf_hLLIj_3tGJACEls_8Xaz8AHaJvZB_IjSIXmRDS7sVTEIaM_cfE4TYXzccio&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqq5EfeleKQwrfYkd0GAqMLSHsHhSKF6sC4yGog4WSzw&oe=6AE8938B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
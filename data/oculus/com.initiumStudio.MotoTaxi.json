/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWdvpqWERCQQ7kNvwEIzVTF&_nc_oc=AdrCbxLN_Sc1Fhxa2PDK6BAMizpqyiW1vZeFyX2Bs010GqU9MBO22L2MwaDa87YSHY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzP78JMBYF_ehh1OLCZzaJfUBIwc58iVWqMuIYKwKvzA&oe=6AF497E7"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTkgbo74HRsQ7kNvwHRIllo&_nc_oc=Adp7jfWgNXVOyCGZwHzg6LsBxCCAxcbFR9Aj1eUBhH9XZZOtlhuIj1I81_8SThIhVL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEJpwrV5GcQLCgKUyy7f8cfx6GMp-mo5jV0zAQ76cDIQ&oe=6AF4819D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXuqN83eA1QQ7kNvwEo51xN&_nc_oc=Adpou75awwjrsG8bfkub7kKl6HDwmlam2M2zy9-JffqUVuUtwVLFvNGxDrgzHJijeFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMRTvg623l3UWoR9J7Sc2BHJSg8BuNDnTLuicSCgbXFg&oe=6AF4951F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH6T541dquUQ7kNvwEBc6kC&_nc_oc=AdqutQQ0UHggsvfNy6h-M0-EA1Jsg4AxyOaPhWWqaYco2fEvCDeqMGkN2CLaOo9b864&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwppxOja5H55wXLqdTLnOdROx3NnmvAuBLz_Bl9saoug&oe=6AF46E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpAhqKSHkx0Q7kNvwE9oMYD&_nc_oc=AdrSvn8C4mrf9_1X63JctvGRyAiiCaJMl_yXA349ZoIPwYMhpgFWLt6I8Ymm5HlvrN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxr0kFsKY-QOwmuSl7VpY-_fnRJfRwxvpYZbmmdCKjTw&oe=6AF4710B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
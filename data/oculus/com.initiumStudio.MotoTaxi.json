/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4BzRAkHTqIQ7kNvwHLfJmP&_nc_oc=AdrfwCA8mXrT-I-QU0D78DGHFu8vaCRCcKJghhTkwMeI-2DfXmCsSWHfxprYFK1TAyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR68Dhf024H4kkHBOn_GGABMwjMLxQxAVr6KfiFJFq7tA&oe=6AEE0067"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdx3x1LRGaEQ7kNvwG14-T1&_nc_oc=Adp4lf6DpYm75H-ph69wM2mP83UaevrG51IdiUfLT24sWxWy4ah7UGDEVWXM5pd-6vU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkAQTbNToA9-K5TDvtBozMWnrteUXljvKKwloRhazHjg&oe=6AEDEA1D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmLCR1W060QQ7kNvwEGci2P&_nc_oc=Adp0i47bxXBKu2gxVKXgoO9m15WuohH45f5G4EQpNrVK7rXbT_XKzWVYZ4w5kEX2tKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm36ChRqMsQe6JlsDR7Ns_UZE4p-OPz0_2ZvM5xsaEDw&oe=6AEDFD9F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnmBcXQDO-YQ7kNvwHttc5p&_nc_oc=AdpiA_jf7Itwgis1aA3eG3tt-gUcRZevSPfoopvssown_lGAVAGVCW4vmXfWEuVwBVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHcaPTDJVxDA-v2wWUuJKdvy4wNCd5h9Q48Adgq5gWyw&oe=6AEDD704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xuoEiAQ1msQ7kNvwGGQKIt&_nc_oc=AdoiI6-eN6W8bYfCvM66HOzBkfwqm3lSzAs2ior8GCmXVwxPJ3t5qMwYb5xWhSgTm1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSHi8LAGqPceOTRsDYbQ1eJBSNR59SHaqkP3Du_HEvTQ&oe=6AEDD98B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
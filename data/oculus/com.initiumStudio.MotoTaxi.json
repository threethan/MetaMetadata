/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4BzRAkHTqIQ7kNvwFJQX07&_nc_oc=AdpYCEAYwIW_63UYt2xAmRU8S8A4_FHAbu-w5LODTYhtZiFeKAu5rNcavHvQRMqjq-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROQ3x-bSi0aRP00ErTqAAC7rnsPim0m8Vt3eL_SBKnJQ&oe=6AECAEE7"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orgZG0SPRvQQ7kNvwHJQrw6&_nc_oc=AdqjYMkEzaKZYS6qfq7ZtO0ek7dlTi8UEsa0rPNuHi9OIhC4nEbIaashcSkjOjUMK-0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfT3GDC2wDlxw9l630mzTfoAkHx3as0DheDnPPgiIVsw&oe=6AEC989D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyaGdItozB8Q7kNvwEPNpdT&_nc_oc=AdpX22u545sTiKQ-FxNNH3eypwTFEEA0SJFunLu_PoLEEqN4wS1Y_ffkVxI-s0nsOlc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKpMzZPFzwx_pExyBWLkDOCsOo47tU6Z9pFnjYCMRhrA&oe=6AECAC1F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVlZwSCrZO8Q7kNvwHwDJsg&_nc_oc=AdpVcL1AS-GNZT2D_kKXM3avPcrq3l8qqiOOvPsDcpDumzOUmQ0lQUv5aw7RCCpCC4w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5tkKgOHnHzqf5Q9n-RcNMm7eTJdjIUf2DPuf-sRHeEw&oe=6AEC8584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDpgEpv7owsQ7kNvwHscIEj&_nc_oc=AdohAFP_XbSX2n85_l55B_FWaBS6O8dNf1OwFuX2NRWaP25sNzBRQcj2qr87JaH3To4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROX0YXZruRNa59y0SJwnVdtPKycjwZWcX23U34vHu3Vg&oe=6AEC880B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
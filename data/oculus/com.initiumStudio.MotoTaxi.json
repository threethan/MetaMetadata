/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku0Zdq6QrRIQ7kNvwGneFYn&_nc_oc=Adp8MWJ0WG8VBksDSyhFJjN9zfDoo0lD6iY8wVHQamyVISrwNkiuvznxKA-4qIrns34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYid4Ag2i1jNLpZUG8pCCf2WFoH5DcusCWB6SNmbleQg&oe=6AF1F4E7"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTkgbo74HRsQ7kNvwHpmNnV&_nc_oc=Adr5NgHWes3WrDzkXQz_ZodvWePR6zn7WDMLGyPT6FpbzbtiFortC5A79KPYcR9PiFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8YBUE5Fq_saNpG81YtKJsWsv322duLg0WPQzHQerbGw&oe=6AF1DE9D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXuqN83eA1QQ7kNvwGZuT3r&_nc_oc=AdofKGoL5Dk3Bk1Qve9I0xaK1udPGxcC_AxuE3bHc_rTFYKXmXiWwJ4_go2mkKtwHyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLqnWT9h70ztb9igpsGA1u9wyQxyyZCXBNtrHBieP6CQ&oe=6AF1F21F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH6T541dquUQ7kNvwGG5tAS&_nc_oc=AdoBtQQe89gnk8VQxm0f82ktloQud_S4p2U_Bv96-iw-NQ5AQOtGlR5BQRQbfeTif8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeLkBUZEUk4hnjbsxH1rV1glr57eoeFfQOaqsepQ_acQ&oe=6AF203C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpAhqKSHkx0Q7kNvwHjvolc&_nc_oc=Ado2ZQwC3P1K2Qp9BMUc5MnR0s-VfjStOfEyX4fbVICnAbS-eRDMbQupDFcI4i3NCfI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcNP-JNtKGm5vT3LrAV42IHioyWRZ8N1PUERuRp6XQsw&oe=6AF2064B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku0Zdq6QrRIQ7kNvwGLPw4O&_nc_oc=AdoQJ4OJyeFbsds4h0bUN_w3zvAxdqQaW6UgYIbCIsyP-eyEI5RR_Ra2Cr4mDXBOb2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReLnVu8m_2amRns4MGujmJDQcZqdDQK_MO71T9K-YWOA&oe=6AF0A367"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdx3x1LRGaEQ7kNvwGzWRik&_nc_oc=AdqLbx-kIv1cGs4GnAzUHWflEGBPiVTG-uqFBKtvx9FJQNo1JzlGclEja0XeaHVMmR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_NfueXQXd8W1x_7dKnaZZkvdp_PJAjhobhnmoHRYPIQ&oe=6AF08D1D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmLCR1W060QQ7kNvwErv4iu&_nc_oc=AdoTxHLZlIcpDZoul0iAPAt-XGcw2Zkl_cIP81FRz-BstBtQdDAklrg3W7Q1NMfOAC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHOitAnADJaayGHpP-o9TXnPRAY6wAkH7xpZCE1UVwNA&oe=6AF0A09F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnmBcXQDO-YQ7kNvwF7bTwf&_nc_oc=AdrjsyJAxTX2fKs-Vh-Gm2KB8ejdJvdeGPg9WaYAyGDibVc3QzGClvyGG_d4WTDlh90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiXc7jOqlwWwK-K-mFQIDZczquVcZm_YijUVmYoMOr8w&oe=6AF0B244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xuoEiAQ1msQ7kNvwEFvy7n&_nc_oc=AdoPN8itBPHpBnaPqVL2OZCbXAZItM2rGHmQbJcdEiV4e9UzQ1LtxfgzmiE9llFoA_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxOb60lUQ5CPikRdEQ2COQRAerBw1w97SM4fyOxZtasw&oe=6AF07C8B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
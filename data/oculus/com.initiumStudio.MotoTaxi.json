/38974875_827402682625227_1084740394031096118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWdvpqWERCQQ7kNvwEQC8BZ&_nc_oc=AdpOhK7wZ3L1YaG9_-Sl4zZrTu6Yue8AekRPiKCbyq3qaugOlxMpLnwmlB1qWW2tLvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0IT_f4M9jMlV7DlBVOd_sQcw5Ba_iOuR0Ib99h54Ylw&oe=6AF5E967"}, {"file_name": "4.png", "id": "1394347621959142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542956_1394347625292475_6899015252017173603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cLTlSE7H0QQ7kNvwE0xw1C&_nc_oc=Ado7wVPpHYfO8It1obPy8QRtwwiN442HEh28ctKj7kSafwoAIa4CGUF7iT3N4Ja9vrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN3vWmdO-2Cp72IdF1v7cOKUmJJiJUkSzwx-fYDLGWhQ&oe=6AF5D31D"}, {"file_name": "1.png", "id": "1332902114768125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75356792_1332902118101458_2708771965368097196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu1p_9em5GQQ7kNvwGd4UM1&_nc_oc=AdoexakqokTpiT6rLXJ1fPwRVOWGRf-vmBunS3ywow4hMifwTxwGtIC-AgGRAWyJbWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkPt_zlERJri9hVAc-DAn-in4ULJGBOUdNuc_i8k6ejA&oe=6AF5E69F"}, {"file_name": "2.png", "id": "1403391847029913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974508_1403391850363246_4792441136444686796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZk3gAJr2C8Q7kNvwH-iqMp&_nc_oc=AdphFGT6apW66E8mWCCc2sHrz-gzyGK3vLHLg5PpFE1uXEyglo0K3wmAZUwoLOE-cQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_4RaeOVy6nOoT9s9lMItzYq7dAiBXNQhnc0JqVyYFw&oe=6AF5C004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Logo.png", "id": "1648180182681629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_1648180189348295_892454689671109805_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42gbR_18wFIQ7kNvwERMpVq&_nc_oc=AdqDZYGmOSI7qXk94qZUyr0lK4Pje5R92jmNd9fgr1IEDLS6ILZDMTxCrn-SB4bJqZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR5ymKUdZn6HfnU9wQjqKI0paVxMFVXouoefPTh_XX3A&oe=6AF5C28B"}, "display_name": "Moto Taxi", "keywords": [], "long_description": "Get ready for an exhilarating ride like no other with VR Moto Taxi! Immerse yourself in the bustling city streets where you take on the role of a fearless moto taxi driver. Your mission? To navigate through heavy traffic, make sharp turns, and deliver your passengers to their destinations on time, all while enjoying the thrill of the ride.\n\nKey Features:\n\nRealistic City Environment: Explore a vibrant and dynamic city with stunning graphics that bring every street, alley, and landmark to life.\nImmersive VR Experience: Feel the rush of the ride with VR technology that puts you right in the driver's seat. The city feels more alive than ever as you weave through traffic and take in the sights.\nbHaptics Support: Enhance your experience with bHaptics feedback, feeling every turn, bump, and acceleration as if you were truly on the road.\nChallenging Missions: Take on various missions that test your driving skills and speed. From urgent deliveries to VIP passengers, every ride is a new challenge.\nCustomization Options: Personalize your moto taxi with different skins and upgrades to make it truly your own. Stand out in the city and show off your style.\nLeaderboards and Achievements: Compete with other players worldwide. Climb the leaderboards and unlock achievements to prove you're the best moto taxi driver around.\n", "short_description": "Moto Taxi: Thrilling Rides Through the City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
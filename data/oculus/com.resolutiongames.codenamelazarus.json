sg1sImz5sJjOtqlw1fB4haxqrqEQqRF-ykfHIqPwkHFJqfg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkSnAOvmREyOoHigzjEtFx7JoSwR_qIf-v4CQKYRkQnw&oe=69BAA57B"}, {"file_name": "migrated_image.png", "id": "248487796188598", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974581_473432590085084_8394294961901666304_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiI3KahCV5IQ7kNvwG_XFVJ&_nc_oc=AdkTMHVHokBBYEY9cHtXSpBhM8x_NUe8VLeQ0psBd7LPBUygM7ycoRVqFgMS6VHYos8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwzu89pUn0Khk9Mv4HAptUd9skgtUnPF9jq8LR6t4d6Sg&oe=69BAB124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/nM8jzl", "id": "381910475864229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974898_381910479197562_5048183703633657856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGh_w2YMC1sQ7kNvwFFOjrg&_nc_oc=Adk6n0wWMcQ0rKM5fNRR0B1-hGDRj8CGFSe1MCtHwWnKPqbAH-sKg1SMImRGFrZFJtU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIrjA9aNNO05-JEAQsnQXPw1EF9ijFLqv60-iW_dSEhA&oe=69BAAC72"}, "display_name": "Acron: Attack of the Squirrels!", "keywords": ["acorn", "party", "multiplayer", "tree", "squirrel"], "long_description": "WARNING: This is a highly addictive VR game and must be played with at least two other people who join the game on mobile devices.\n \nDo you have what it takes to protect the seeds of life in this new multiplayer party game, or are you feeling a little squirrely?\n \nThe seeds of life are under attack! It\u2019s up to you and your friends to protect them or steal them - depending if you take on the role of an extraordinarily protective tree or as one of several crafty yet thieving squirrels - in the new cross-platform party game, \u201cAcron: Attack of the Squirrels!\u201d, from Resolution Games.\n \nIn this hilariously fun experience that\u2019s at its best when played as a couch party game together with a group of friends, \u201cAcron: Attack of the Squirrels!\u201d is both competitive and cooperative in nature for players across VR and mobile devices.", "short_description": "WARNING: This is a highly addictive VR game & must be played with at least 2 other people who join the game on mobile devices.\n\nThe seeds of life are under attack! Do you have what it takes to protect them in this new multiplayer party game from Resolution Games, or are you feeling a little squirrely?"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/acron", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "952062042083705"}}]}, "scheduled_offers": {"count": 51, "nodes": [{"status": "PUBLISHED", "id": "1171514844968265"}, {"status": "PUBLISHED", "id": "1147145173862322"}, {"status": "PUBLISHED", "id": "824118776816101"}, {"status": "PUBLISHED", "id": "788436430570971"}, {"status": "PUBLISHED", "id": "1090485966306013"}, {"status": "PUBLISHED", "id": "656438297358138"}, {"status": "PUBLISHED", "id": "922639703391998"}, {"status": "PUBLISHED", "id": "3958588004467691"}, {"status":
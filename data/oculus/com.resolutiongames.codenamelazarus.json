!\u201d is both competitive and cooperative in nature for players across VR and mobile devices.", "short_description": "WARNING: This is a highly addictive VR game & must be played with at least 2 other people who join the game on mobile devices.\n\nThe seeds of life are under attack! Do you have what it takes to protect them in this new multiplayer party game from Resolution Games, or are you feeling a little squirrely?"}]}, "developer_name": "Resolution Games", "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "https://www.resolutiongames.com/terms-of-use", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "https://www.resolutiongames.com/acron", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "952062042083705"}}]}, "scheduled_offers": {"count": 51, "nodes": [{"status": "PUBLISHED", "id": "1171514844968265"}, {"status": "PUBLISHED", "id": "1147145173862322"}, {"status": "PUBLISHED", "id": "824118776816101"}, {"status": "PUBLISHED", "id": "788436430570971"}, {"status": "PUBLISHED", "id": "1090485966306013"}, {"status": "PUBLISHED", "id": "656438297358138"}, {"status": "PUBLISHED", "id": "922639703391998"}, {"status": "PUBLISHED", "id": "3958588004467691"}, {"status":
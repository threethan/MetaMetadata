SC4dYRkv3ZHXlTvARFMy87-Xl-eS5b6kA&oe=6B03190E"}, {"file_name": "\u622a\u5c4f2025-11-29 21.05.35.png", "id": "2086368022164368", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619145_2086368025497701_6300157310693889274_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ztga-r-x-UQ7kNvwEStuXs&_nc_oc=AdpoEF5bBhmMXogyNV-gR9oPRnUOKIHd239cMlQOomJFYudcgR3uSzN-nhxT31D1t2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3jefUkZqTFeUAvtnLXcl16092DK3mEhn-sX2jydsv8Q&oe=6B03288A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "marble-2560,1440-32bit-png.png", "id": "1403360490665794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821045_1403360493999127_3701989709887143448_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prbldUJv47kQ7kNvwErnu3Q&_nc_oc=Adpke1677yMG1s6HMWLtuT0_UXtfSGAxJLkjnvwVBxzwh9IrcH4SNnqmFC-dD347xZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Zgq6LPnZr3672a5fIzP2c7NnRKUjWOPnwrqc-WGi6g&oe=6B03100E"}, "display_name": "Marblecraft:Mixed Reality Marble Sandbox", "keywords": ["sandbox", "simulator", "building", "physics", "puzzle"], "long_description": "Welcome to the ultimate marble fantasy world of Marblecraft! Explore and try out every possibility related to marbles!\n\n- In the mixed reality environment, build your own marble heaven in your living room or backyard! There are over a hundred diverse building modules, tracks, obstacles, themed decorations and preset systems! With easy-to-learn but powerful editor, you'll have a joyful building experience.\n{1225658812412604}\n\n- Solve 60+ unique puzzles as you level up your building skills! From forests to deserts, medieval villages to space hubs, tackle mind-bending challenges by building and routing with limited modules!\n{4123996227877718}\n\n- Build marble F1 tracks and watch them race! Create marble music with a piano and watch them dance the waltz! You can even craft your own pinball machine and play it right in your living room\u2014imagination is your only limit! Share your top-tier creations and explore a global library of creative builds!\n{568442852478380}\n\nJoin us to create marble masterpiece together!", "short_description": "Welcome to Marblecraft, the ultimate marble fantasy world! Dive into endless marble - related possibilities. Build your own marble world with diverse modules, race on thrilling tracks, and solve unique marble puzzles. Collaborate with global marble crafters, share creations, and capture amazing marble moments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "ja", "fr_BE", "fr_CA", "fr", "de", "de_CH", "gsw", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "ru", "ru_UA", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25226733940323116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823471_1902813877192180_23
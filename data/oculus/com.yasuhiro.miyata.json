5/39031593_793809198161501_8882290858132469857_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF_HTtO9MbsQ7kNvwFEwIwr&_nc_oc=AdpHGGlUPj_HSdgmPWMAhL0DIP5L29AP9Q3eY4b6KVwv1C7qmVsojkTfEcdeug2qBJI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bB8QFzSkxzUnLNkS-tl1rTfDdy4vNRW5wThBHES2Qnw&oe=69D7BB0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc16_9_2560x1440.png", "id": "234262505131588", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974786_234262508464921_5852878355023226383_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISypeC_0zd0Q7kNvwG0JbsD&_nc_oc=Adp0IAwVsS3UMtON0jk1oFYvtIzc-PQfpEvBWPmz2VCKobV2PqP5PN0T49JFyJ1MPMg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PSGwKRdiKNwtb52KQKVPp_aECVsXsfDIDOiTg0GkHNw&oe=69D7B71C"}, "display_name": "FANFUN VR(Prototype)", "keywords": [], "long_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? ", "short_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? "}]}, "developer_name": null, "devel
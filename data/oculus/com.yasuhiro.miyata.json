-1.oculuscdn.com/v/t64.5771-25/39031593_793809198161501_8882290858132469857_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QPwQsfk_jgQ7kNvwEDpP_w&_nc_oc=AdpP0lC-YHSBeehr0CsstuFfT77cDlWsaXZLvWJxPhVO3EleKTtTQhmS9QjTuIlpgBY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA_A5WNysndNIFT_ee_9W-7h82RQynv3HMA-i-BaxEEA&oe=6A8D71CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc16_9_2560x1440.png", "id": "234262505131588", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974786_234262508464921_5852878355023226383_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY_JQLxNIC0Q7kNvwEL4iOJ&_nc_oc=Adprr6DqsI8nc-pk3aFNRdlxDbCDKdF17Ku8PPfiAGQ58zgLxAlrXp5UOxC3r-9kS00&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgaVZT1L4nfHSCaNz7jmQ4wcT6EOvz_ot9LSjMT-zP-g&oe=6A8D6DDC"}, "display_name": "FANFUN VR(Prototype)", "keywords": [], "long_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? ", "short_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? "}]}
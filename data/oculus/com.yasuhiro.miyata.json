5/39031593_793809198161501_8882290858132469857_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFbSybGrzO0Q7kNvwHZ-I3J&_nc_oc=AdoiXNsyaAQ8jKpmPrK3zAeDLCMabY3MuWPs0YaeNsPfLSozTGen0MboO2MzCPDflpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyYcGZloCR2d6GVt0N-k7fnLNDZIijHgdxkv9kAe4K9A&oe=6AC65A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc16_9_2560x1440.png", "id": "234262505131588", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974786_234262508464921_5852878355023226383_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP6K0TW4eQQQ7kNvwFuAGrA&_nc_oc=AdqI_T_tBtwH2wxKYYkShcjGb7-zZt5WR5aheMAH76GA6xHrKJKz-wZl2vSJHMSf_rA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtjF86sVxk1AK1JPSJgLTrG8e8794ssVu5qt81MDtoMA&oe=6AC6569C"}, "display_name": "FANFUN VR(Prototype)", "keywords": [], "long_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? ", "short_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? "}]}, "developer_name": null, "devel
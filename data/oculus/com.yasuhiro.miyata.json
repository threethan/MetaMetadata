5/39031593_793809198161501_8882290858132469857_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCczoGDoNsQQ7kNvwF6TUA6&_nc_oc=Adru9yjqAb7w7NdpXWt0fPr8FvApiINYiWfz-eqOQDR-_akOH4uE5ViVdYRh_g5mEOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nLye6sP3kAMtC2_wUzKwuFZGrMz3QHHJUHjMoaunLiQ&oe=6A43D60C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc16_9_2560x1440.png", "id": "234262505131588", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974786_234262508464921_5852878355023226383_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdKDjy3_OzUQ7kNvwGdFcTo&_nc_oc=AdoUHoBCYluDNGb65ozrUQm6JiB6pch89nGwvW9HJ4eDqYVCigY0EN_roi41GnyzKM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c54I4Uo-Ykpc-WjtRdzuND5Xowcrg7GM2tYCkPzgSEg&oe=6A43D21C"}, "display_name": "FANFUN VR(Prototype)", "keywords": [], "long_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? ", "short_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? "}]}, "developer_name": null, "devel
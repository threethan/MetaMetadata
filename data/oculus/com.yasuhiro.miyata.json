5/39031593_793809198161501_8882290858132469857_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUAZg0bXTTgQ7kNvwGl65J7&_nc_oc=Adofi1t85pFCIJ6F20WKygd9w1htxjh4PRxH33SH7xAI5omgXdT1z5SvI4V2BIfKV8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIae920azQj73Jjr8YthbYwHkYEF2pJKMVMwRTvMUkExg&oe=6AAFF10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc16_9_2560x1440.png", "id": "234262505131588", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974786_234262508464921_5852878355023226383_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O0FK47Po-MQ7kNvwGjonJj&_nc_oc=AdqAeSHcXnCzMwPi0j33cg2XFW5m919s8AO6q_MH0daohe8I7bsDNE4RYP0sjoPzZ6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaYA3KEp2yPPnrntO6QEHFzNImzFTGNE5WlDlEd72Kxg&oe=6AAFED1C"}, "display_name": "FANFUN VR(Prototype)", "keywords": [], "long_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? ", "short_description": "FANFUN VR is a unique action game in which you control the balloons that appear one after another with the \"wind\" and carry them to the goal.\n\nYou can use the controller at hand to generate \"wind\" and not only control the fluffy floating balloons, but also sometimes fire propellers to hit the balloons.\n\nThere are 5 stages (room, trick, character, landscape, anxiety and anxiety) in the game, and there are various ways to play from healing to action.\n\nHow many balloons can you carry to the goal? "}]}, "developer_name": null, "devel
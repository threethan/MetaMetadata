23_6MSvuNRdDmrogaEZLF38ahjGtA&oe=6ABA8A0E"}, {"file_name": "HW_Screenshot_09.png", "id": "985281033099199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_985281036432532_6579235136098209892_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VT3cE13TzngQ7kNvwFTHf6w&_nc_oc=Adr5MqbHT9bKzSj-OdoxUBC-Xx9_KbOBZuEk3qPEcI2JOZspKva4IYJt-eD2v0ipdf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQItI8m0cpZFE4_mF4m6lmJK42jxg-odL9mpqbK2v-aA&oe=6ABA5DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HW_CoverArt (1).png", "id": "830819871711954", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031602_830819875045287_4431717934812663169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf54bTuhtlgQ7kNvwFrlw5O&_nc_oc=AdpOyCji-NeTbeQ0XVUPuQWEGGws_v2ucss19xyDT8S1LSCVm_FMglHTeVmzJJT6aW4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0byYFUA6f34m9g0rLX2E0DxQFRu_eszJfcnTsvcfdGQ&oe=6ABA5A05"}, "display_name": "Human Within", "keywords": ["VR", "Interactive", "Fiction", "Drama", "Thriller"], "long_description": "Cyber Engineer, Nyla, and her sister, Linh, developed a way to harness the immense processing power of the human brain to create the ultimate supercomputer. Employed by Forward Industries, they managed to transfer human consciousness to the digital space. But after trying to back out of the project, things took an unexpected turn. Held against their will, Nyla is finds herself in a situation that forces her to use the technology in the very way she feared it would be.\n\nFrom the beginning until one of five possible endings, you experience the entire story from the perspective of Linh's consciousness in the digital world. As Nyla's sister, you participate in the events as they unfold, enabling and enhancing the system's capabilities from within.\n\nThe selfish vs compassionate choices you make along the way will define your past while shaping your future. During various 360\u00b0 flashbacks, you determine the events of the past by gazing at specific details. How it all ends and the fate of the technology is entirely up to you.\n\nWorking alongside Nyla, you resolve incomplete code sequences from within the system, scour the city to identify someone who can help you escape - even if it means exploiting their personal information to get them to comply - and discover solutions to the challenge of sneaking them into the building and hopefully to you, undetected.", "short_description": "Cyber Engineer, Nyla, and her sister, Linh, developed a way to harness the immense processing power of the human brain to create the ultimate supercomputer. Employed by Forward Industries, they managed to transfer human consciousness to the digital space. But after trying to back out of the project, things took an unexpected turn. Held against their will, Nyla is finds herself in a situation that forces her to use the technology in the very way she feared it would be."}]}, "developer_name": null, "developer_privacy_policy_url": "https://signalspacelab.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Signal Space Lab", "support_website_url": null, "website_url": "https://signalspacelab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8492913964132952"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED"
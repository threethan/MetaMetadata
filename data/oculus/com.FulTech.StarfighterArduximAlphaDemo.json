_image.png", "id": "1000054860391510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386359_1669862490001252_1971072064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zloFoR84z4oQ7kNvwGiSmZe&_nc_oc=AdmPsFoevVLR4N7ZDyzOHp-7u3Cy-k1eEnUtlVdigNzMlaPONnGDZptSwn2yMumJ8o4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJLW0Zan4zGT2up7fdUSyNWlop9m41km3w9ak_nbSm_A&oe=69A6EF06"}, {"file_name": "migrated_image.png", "id": "915733085512970", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386203_614724538705568_531391858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9niPsDGwq2MQ7kNvwEyxHKl&_nc_oc=AdktQUMoHXPrf0jEYMe3XICmcUO1oC5tDnz2dMryqgTHT1k0UaLm8Hlj1hcnl8Zo5Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_1ovc09bPrlPlKyF2Uhu4_04eEhw9HOPK8qhwNHqJug&oe=69A6E04D"}, {"file_name": "migrated_image.png", "id": "624490161665773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522273_1010934792335946_558211058_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZqfG1G1b64Q7kNvwGFVweE&_nc_oc=Adkje-9iTBHEsEm95HfH_u_P7hrnNaLOUUexCRff4niJcjkLYleiaNUEqmiDdxQFHG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwUcgPSUbEik_Rd9hlaWaV5bljtJ9ALWCVORqJtGJdSQ&oe=69A6CD17"}, {"file_name": "migrated_image.png", "id": "208207037081575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331143_576903365826023_1325273270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb1TUb2zPWkQ7kNvwGAFRs6&_nc_oc=AdkQidkBcA178eN3SL7xEVbxBGoaSMfZ7U3G0IA6EMt6K6RshfWYP_oA0knWZCBQKLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv7mYr46siLIXPtlrTUAW_x-BvQWe6rtWAGEy2uwjKK2w&oe=69A6C0B8"}, {"file_name": "migrated_image.png", "id": "146241263349814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162705_1783656541846212_1882704698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeqKWFbVwf8Q7kNvwFJbAt-&_nc_oc=AdkwNiyob5zM9uAcmjq7n3mZigCrUwzdESStMnuhjKq3rifzEguE2pT2UrDUXK6XOgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCB571mhA_N6d5HY5IiabMF3avkWgpdY6UeiPs5RRmMg&oe=69A6C76F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starfighter Arduxim Demo", "keywords": ["Starfighter", "Arduxim", "gamepad", "shooter", "space"], "long_description": "Strap into the cockpit of your Arduxim and take on enemy starships in this first-person tactical space shooter. Warp to areas of conflict within the system, take hyper gates to other systems to investigate disappearances, take on enormous capital ships and more.\n\nThis demo contains the first two missions of the campaign, tutorial and practice mode. It also includes the online multiplayer.\n\nThe full game contains a twelve mission campaign, unlocked ship and weapon choices in multiplayer, survival/horde mode, more types of enemies, more environments and more weapons.\n\nStarfighter Arduxim requires a gamepad, joystick or HOTAS. Controls are fully customisable.", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on AI enemies and other players in this first-person tactical space shooter.\n\nThe demo includes the first two missions of the single player campaign and provides access to online multiplayer.\n\nRequires a gamepad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/arduxim.com/privacy.txt", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name": "Fulby Technologies", "support_website_url": null, "website_url": "http://arduxim.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SIMULATION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAM
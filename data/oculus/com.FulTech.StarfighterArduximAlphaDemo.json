m&_nc_ss=7f30f&oh=00_AQR3ECLNq7yN1iBUK1CIVPNDe7xgG71e5vAy_K-YSzEGhw&oe=6B0B2638"}, {"file_name": "migrated_image.png", "id": "146241263349814", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162705_1783656541846212_1882704698_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTY7RBIMOtMQ7kNvwGXnlMG&_nc_oc=AdpA4_NR9XMEVwKg4gmc-bN1lDispqjATTXpVCNXMOdoCyJ-ZKkb7X33ajLCMooUNvU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQO56i8KXP0mjOl9jcLzBGWHSSRDYlnMAoZ75SxVPPs8w&oe=6B0B2CEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starfighter Arduxim Demo", "keywords": ["Starfighter", "Arduxim", "gamepad", "shooter", "space"], "long_description": "Strap into the cockpit of your Arduxim and take on enemy starships in this first-person tactical space shooter. Warp to areas of conflict within the system, take hyper gates to other systems to investigate disappearances, take on enormous capital ships and more.\n\nThis demo contains the first two missions of the campaign, tutorial and practice mode. It also includes the online multiplayer.\n\nThe full game contains a twelve mission campaign, unlocked ship and weapon choices in multiplayer, survival/horde mode, more types of enemies, more environments and more weapons.\n\nStarfighter Arduxim requires a gamepad, joystick or HOTAS. Controls are fully customisable.", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on AI enemies and other players in this first-person tactical space shooter.\n\nThe demo includes the first two missions of the single player campaign and provides access to online multiplayer.\n\nRequires a gamepad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/arduxim.com/privacy.txt", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name": "Fulby Technologies", "support_website_url": null, "website_url": "http://ardu
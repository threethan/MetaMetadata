ohc=epRP7tf5tOUQ7kNvwE2gnYP&_nc_oc=AdrEQpoiThWE44Yk9d8JWf9eAa-JK5pTFX_XXuRQFUVEOE9wE0neTW0XRoh0zZP_rXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MjdqpSTyDUyNCpnOJ_G5vvBIi1COs03cOnmnB9li_DA&oe=6A301BAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starfighter Arduxim Demo", "keywords": ["Starfighter", "Arduxim", "gamepad", "shooter", "space"], "long_description": "Strap into the cockpit of your Arduxim and take on enemy starships in this first-person tactical space shooter. Warp to areas of conflict within the system, take hyper gates to other systems to investigate disappearances, take on enormous capital ships and more.\n\nThis demo contains the first two missions of the campaign, tutorial and practice mode. It also includes the online multiplayer.\n\nThe full game contains a twelve mission campaign, unlocked ship and weapon choices in multiplayer, survival/horde mode, more types of enemies, more environments and more weapons.\n\nStarfighter Arduxim requires a gamepad, joystick or HOTAS. Controls are fully customisable.", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on AI enemies and other players in this first-person tactical space shooter.\n\nThe demo includes the first two missions of the single player campaign and provides access to online multiplayer.\n\nRequires a gamepad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/arduxim.com/privacy.txt", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name": "Fulby Technologies", "support_website_url": null, "website_url": "http://arduxim.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SIMULATION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recom
m&_nc_ss=7f20f&oh=00_AQRvo2wrYpBXX-ghLkl35_9u5djlJSUlPyOA88SwWtxJEQ&oe=6AFB1BF8"}, {"file_name": "migrated_image.png", "id": "146241263349814", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162705_1783656541846212_1882704698_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGfoxb63gV4Q7kNvwGyPdAa&_nc_oc=Adp5lXo0B_3VlF_xIZxZyIkcFzVIb6rLjjFv9eTOysdEvL6aq7gb7zsx0zCG-aJRfDo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQZyeh7SrSG28KSAvFAbj2hww72Ko_nynDP5pS15X2og&oe=6AFB22AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starfighter Arduxim Demo", "keywords": ["Starfighter", "Arduxim", "gamepad", "shooter", "space"], "long_description": "Strap into the cockpit of your Arduxim and take on enemy starships in this first-person tactical space shooter. Warp to areas of conflict within the system, take hyper gates to other systems to investigate disappearances, take on enormous capital ships and more.\n\nThis demo contains the first two missions of the campaign, tutorial and practice mode. It also includes the online multiplayer.\n\nThe full game contains a twelve mission campaign, unlocked ship and weapon choices in multiplayer, survival/horde mode, more types of enemies, more environments and more weapons.\n\nStarfighter Arduxim requires a gamepad, joystick or HOTAS. Controls are fully customisable.", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on AI enemies and other players in this first-person tactical space shooter.\n\nThe demo includes the first two missions of the single player campaign and provides access to online multiplayer.\n\nRequires a gamepad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/arduxim.com/privacy.txt", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name": "Fulby Technologies", "support_website_url": null, "website_url": "http://ardu
_image.png", "id": "1000054860391510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386359_1669862490001252_1971072064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3eZo04t_bEQ7kNvwHMPgDC&_nc_oc=AdqqMrYtacnG_yk2SWlLpF5KdyrRM8eI-g04ccmi9iWSQ4GkltlxMi0zClloOZX-YLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1gs_65KLxzTrZ8iJbgExDpBQkUHCubGa6dAhmNCxrM7Q&oe=69F0C306"}, {"file_name": "migrated_image.png", "id": "915733085512970", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386203_614724538705568_531391858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaacGs3XDI8Q7kNvwFo7CF3&_nc_oc=AdpBQeq2lGdykA28npu5xavCh5WEzBuOpI1qiuxUmQDEXHmoVDiTiLVxwkyvQDqGM-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2ey-l6Z1GUvlo53khiCiOWfDDU0I-EBoqu2qr78RGTLg&oe=69F0B44D"}, {"file_name": "migrated_image.png", "id": "624490161665773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522273_1010934792335946_558211058_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtYiClQQBL4Q7kNvwEkjcSD&_nc_oc=Adr4On3cumwZNmeffKWPLI2TOPKjcPzx2e2hpi3u87qjUF1ZtlFHa1wi7UH49E8PnR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0KTGZSnd51so1p5DQXeKQ0wD4HGX0q4Dsf3VpI-tlpag&oe=69F0A117"}, {"file_name": "migrated_image.png", "id": "208207037081575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331143_576903365826023_1325273270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWsdqewnsVkQ7kNvwHlxOWs&_nc_oc=AdrXJg7E6eZxyFmbo0tGu8D5MeF4JuyGfMcNOcLUTUFOPi6roeAojyohFnbbku-OkxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1F4Hx3QzUxx-RvqOIWo5Q8MdtYBymVhqC3bRzVPJWqRw&oe=69F0CCF8"}, {"file_name": "migrated_image.png", "id": "146241263349814", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162705_1783656541846212_1882704698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp1mZxA45MEQ7kNvwHvA_7h&_nc_oc=AdpoOf7BwSSw9XipnPpu0kgVIu9-6AvHCji12TBQb_j36OWLmJme5Pc8iPSIIMAmnZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3sGxAz6JHhWygkhAKHVbqNTAw2-XQFtPdmDfyJzfqNeg&oe=69F0D3AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starfighter Arduxim Demo", "keywords": ["Starfighter", "Arduxim", "gamepad", "shooter", "space"], "long_description": "Strap into the cockpit of your Arduxim and take on enemy starships in this first-person tactical space shooter. Warp to areas of conflict within the system, take hyper gates to other systems to investigate disappearances, take on enormous capital ships and more.\n\nThis demo contains the first two missions of the campaign, tutorial and practice mode. It also includes the online multiplayer.\n\nThe full game contains a twelve mission campaign, unlocked ship and weapon choices in multiplayer, survival/horde mode, more types of enemies, more environments and more weapons.\n\nStarfighter Arduxim requires a gamepad, joystick or HOTAS. Controls are fully customisable.", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on AI enemies and other players in this first-person tactical space shooter.\n\nThe demo includes the first two missions of the single player campaign and provides access to online multiplayer.\n\nRequires a gamepad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/arduxim.com/privacy.txt", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name": "Fulby Technologies", "support_website_url": null, "website_url": "http://arduxim.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SIMULATION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAM
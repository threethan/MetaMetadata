eAoygiuESmeBYVqQ&oe=69E8CE8F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1Mbf-J5VXYQ7kNvwHTUfLc&_nc_oc=Adr_17SsLWJ-t-S-AlM57rBdGNkGwZnLLgn-7XiLRzdbs8_5qfc8ajvJUmnxsveEeqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WEAsC1vCJyY-_FnwTxqvCDQguBWLkc2OxgHjFocduyQ&oe=69E8ADA2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auw3aHw5Sf4Q7kNvwFQ4xuE&_nc_oc=Adqcx5YMnpDYKbX6_wQSzozj3POb8mK-wVNXh6fS-WuNUV4NIliOpD1JQjb0zh3TkcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YRcnAogKo4VfW0Kw0DMCDkdMgdqY-9al2LHniZqbRqQ&oe=69E8C4A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Egg_2N_OnAQ7kNvwEx-9Tl&_nc_oc=AdrhIaxfybQexoH4i709wnoN2djx1pUUqBeb81WYnYz05lC52TdnoHQz-8Pmj1ihAMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af234-LAJOUCcg51KqqDHnjqrOAMzBhxrZrVC83wHllvLA&oe=69E8D040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvr-5lBa1_4Q7kNvwGz5BY9&_nc_oc=AdrABhuaf0V-JSqzuVghZojpSfbFsqiTzsST4hOLTgqtcR-bZby_kr_a3vUGsHfNbwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qz5R7lp-dT7kKXSSj7Jwzt7_lT3uie3gSrBGloOnBbQ&oe=69E8C25E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hxJaWt76HMQ7kNvwGSLRTk&_nc_oc=AdqRFlhKRdX9vLTxW_X-xY4d4ZABM6ZSTKhmUtAEaEcV_QrgfoiVmzW7o7OM25mRnZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_n
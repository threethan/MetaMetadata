53JkP-HMvMGFugcA&oe=6A2C0B0F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjlSaq0yhukQ7kNvwFz858M&_nc_oc=AdoVkI0ppxD3z8Llje2AsoBNVDm6EFdXRr0xI4ANvpnRhhjTtwmkjmIN5T-U6k18zQ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-motRNh2dgAEdf7-Svr4i7A0q0U9EfZw2FlwVe2oi9BA&oe=6A2C2262"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aKHvNhaeaoQ7kNvwHmB0cA&_nc_oc=AdrE5AdqWmsXOc8aOVn8Wqfpia1Lv4p1o8xCjyJnXlHRaj05rR4ZBL5fpwaUXBlXooE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8goAqfePpNkhp7IeUqDDOZPMsgeXMGWhWpjFWILNgokg&oe=6A2C0124"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLKhzMh8UdwQ7kNvwHLTf9e&_nc_oc=AdqNDGG1ZwmcByv6t2dsp9Y9Z1gSi_pkCmpO8NePA5lWilTWf8UjUqHaUVzl_QKnarg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tHcKF1ETwvB1a8vLXt14iIPOloQyWnN74SNwnuoGg-Q&oe=6A2C0CC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5uhe8KzPO0Q7kNvwGmYG9t&_nc_oc=AdrHkZTMabGQQAL901OmwQM5OmP8ey_OqYuYuYrFhfoOmgKF_axo2UkeHSwlO9A4gTQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WV14eVs8VciAe85LMx14_CFyhl-t206uDlNm5kPNkuQ&oe=6A2BFEDE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8CqUPcIK08Q7kNvwEEgcX3&_nc_oc=AdqkOjXnd7YQ3-rnIo5Oya8YGzygwS0knFyZguBqo14hcpTzqixzsHkCzC7OKZBHK8g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_n
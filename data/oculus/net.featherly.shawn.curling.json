CCg2Ais0zov8spsw&oe=6A60C70F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmNLTB5juoMQ7kNvwE0K2Pm&_nc_oc=Adpp2MwNcGaoeLBxaiTm1ADGnn7j1PZbW1gOZsWIYLKcl7h9wd9R1VK0ON0w5gbmMck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEnGadYWBTyhlyScDrlwMBIrk9K9QuT5kqEEezdwB5_Q&oe=6A60A622"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxd-FK8LPUQQ7kNvwFOQGMb&_nc_oc=AdryabOt4Md1pyz7s5tUaCFwQktnrgWyvKXfFC8k6t7EHxs1lV5Y0bb955o_6pLCf4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf65Hlx54av0V1G1-O81HOzW9DMnENgURYaaEybmn1PA&oe=6A60BD24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXLXArhO9pQQ7kNvwHId7ZA&_nc_oc=AdrXa7riOdLg7RJxiNYoRS0iCJKpFuD1jnqyU9FeMItEZXnOOBj0P1wbZTWUZ-Xz3TA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWksmWPvKih7jnXa4Fa394XQ3Us2yQx9SF3jrOvOTxpQ&oe=6A60C8C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMMWuEg3in0Q7kNvwFyihMt&_nc_oc=AdrDf_S3PCPIfyZiY8Dx7M3jTrsMa24Ngpi9Cl7vG-VksyENFxk-OKiZjeFHIAIB3NI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPV5uOKAUGBGmY_dYIhPEnIJc4D2Xl6FJcwejUjXROJA&oe=6A60BADE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8Q7gndjR4MQ7kNvwFMyS8Y&_nc_oc=AdrEj-5iE1gdG0BmtRBWDtEdvqh8kTHxNi9Y69W785XAOVx52VJOGTfHm2ZXT3oXv20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_n
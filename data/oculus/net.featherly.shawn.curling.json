FoIZV2CHy0UyVEKw&oe=6A53980F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SuC6RqbIJ0Q7kNvwEGmnjk&_nc_oc=AdrOp_jFjkq9mCqY4WsEsOLLyPcpzCXuEPY1IZB880Ip_hj3BrCkelAL8oxz7dGY-Rw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIUJ0X3Lczb2oCawAX5B-qgSvWB5tdeyzCD1b6z63Kzw&oe=6A53AF62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aarxunNZ_XQQ7kNvwH_B0HO&_nc_oc=AdrXzh8NSlxrmUxLAZUgkj8un7AgJoJ2FwX9Qwb7lD_CdzTedcRG0Fmxu0YYxLWX32w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlhuoNRVUTLkdw86lXXqTIMsjPoh5Ayy7tpLM8ZagyGQ&oe=6A538E24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVc1qlDZyqEQ7kNvwF8wmAz&_nc_oc=Adr_TH5Km_tbfiWjneaxs_1fyIlsMQga3zzIayHkec1tnUUnKJnEnKyeTkaiYPX63zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0pmbd7jj3qCyITKr0oK1wuMfaNlPC_DOBGda6BmSHWw&oe=6A5399C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD7pFSE0CBoQ7kNvwEtXNka&_nc_oc=AdplQuUE5euxCoKt8Zc1zhqlS2M_GrsTsoet6il0LihOECMk6p8Sk68K4ypzKVPAEnE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBVhXs5st8eqkdCR0pFwl4cZB59Us8QkIDPpwzO5oyQw&oe=6A538BDE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjQJT6N7mz8Q7kNvwExjWIZ&_nc_oc=Adq-Bsoo8PT9qpn6SdvPYGbGV9C2ggV9ZmYF8AEvWHKWlQ7Ga5ce4Tmv2m3BQVMcm2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_n
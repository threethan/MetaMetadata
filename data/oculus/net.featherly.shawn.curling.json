AIJVjfxASJ5gm8VQ&oe=6A01DB0F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P4YLXyHOR4Q7kNvwEi2kjk&_nc_oc=Adp6c_1xMH43kJI051NT3m2hD6bXPZpBcAN6diEfN611EuM7WgY67GB5mMWPe4JRm-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NdO1T139VUMq19JWTIcYI9ASUcQBxFyUUboWyVNyMZg&oe=6A01F262"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSE0bhlXBn4Q7kNvwEMtpzG&_nc_oc=Adqsf5H3Lo6ScMmHzD5L_oHQ9jZc9hqV7CkImK7Hbx5OGmErsi7iWmptdxBT7twFdKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yX8iodYHavKuNm3vd_GpDHCc5uRAqn0wqzedoa9Zokg&oe=6A01D124"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZewF7evm6B8Q7kNvwHMGCsK&_nc_oc=AdrfQ499lY96f1qBmRcxWfsPQt5Cp_rEd0xrHZJgJsrtx7gi692lF8aFCOjmT2_IY5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y-o1BSdJ6T02by4ZGb9-xCpVhV9R7w2IAT_tmuAUkjg&oe=6A01DCC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsRV57M1uYsQ7kNvwFyof9W&_nc_oc=Adon7pNzStH5DyCKbAJ4joJjOkJKcBi53kWQVApb8EDF58O1L2G7u61HFi9F1XiGDzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VJo-7W8zKJ7PsiYWBCv9FOtq8kn7X98ys79FDxHXfnw&oe=6A01CEDE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22yX9VQotZUQ7kNvwFJ9utt&_nc_oc=AdqDVwuHOVFi1qpCDSQhK7TMcm2GI-KddHayER4svkN7BQHsAn9GQLQf0v-xAZU9zIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_n
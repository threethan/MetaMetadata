CFuM4gz3nzlFtjtA&oe=6AF2044F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c4gNYLfZVMQ7kNvwHaSmS6&_nc_oc=AdpZP_wKIyMu2XXqDuGRsj2lybKImEZntHESgoOHT-EBJsh4Qa_wdaFqRD4YBVnIJyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1H7PIl5l_8eVW9_OfgiCnBufF1zfNQSF6lvNMAGM72w&oe=6AF1E362"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFsmSp7tbWgQ7kNvwGFwLuI&_nc_oc=AdqdChd8HzM5JE9jyrgwL-Ie5o-SUpyCyWZkCD_Ea878ssQ8wU6i1qAAn8PEoUfF2Uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLBCeKVYxyvJL2x5Y0JkyqNa550q9_JBcmJuAawoMPfQ&oe=6AF1FA64"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuahkICn_oIQ7kNvwEVWMsv&_nc_oc=AdrFt2g9ZgW8QkKbRvnE-ilAsOsjd49HL_6RL7j0r73WJJ4RoVD1Ek9Rz3xbnOPK2Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIsF7pwNyCE2O6NO7-_Ij4g304Oc0KuzOzG6j0T7jbvA&oe=6AF20600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9JwKHlz0pIQ7kNvwFxDFkw&_nc_oc=Ado9I4YJZYZgqCQ3kdxYosIA-wpRK9JCXmcpCUtAidl7-BF8pJSkxck8b_5Cz23HiAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBb8cYIPCZgXWHiLMwkstqmyOTupcxcA0jDItfHGaRjA&oe=6AF1F81E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVcMh42e_6gQ7kNvwFz5cY5&_nc_oc=Adq3Ly1fX-HL5i8E9nVtdzMDDoy2x_dlbdnVM8dRmtAbR0uQ4rFPb7Yeo1r4eSjPEE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
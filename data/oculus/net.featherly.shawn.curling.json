DtQhhXTsUp7k_18w&oe=6A8C488F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQaGvJjZRgkQ7kNvwG_G9lE&_nc_oc=AdoRrwccsKPsn5X2qtEo4dqshvppYMcKDY8CEBk_1q0InStjqlfK_QnmSR1yCqiTPE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3SyyE6KFf-oAbYxHLlu2VnJzQqbZ3cS4zUJT6sGmBWQ&oe=6A8C27A2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf2_or7Qq0cQ7kNvwEr4lBH&_nc_oc=AdoDlkPlj-p3hCQvp9nK6ATWGkrk2K6rsor_byWccOA80Gp5ab4V_YdSyogh2EGVV5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZOrYPqoNE7jAduMu-YB48mlAGcKQH213LFTuudeL3PA&oe=6A8C3EA4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73v3YtEebFwQ7kNvwErZkY9&_nc_oc=Adq-A4J3CxXIOvVU49OqJsEgb-cP5cvFeG9baOkBJr6GLTd7sG2jqbjV1JJSPDJpOfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAAQ38WRnHRNPPMw801yjWFBX-f4VYJJgzZnakpEtiFg&oe=6A8C1200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsA-9GYIv3AQ7kNvwEUeXBR&_nc_oc=AdpaYVoz_dSkaNiFDDLB2linP51C29rwAoNKpxljIaNgmjXYFEJ_Bd2pqfhQI54cDA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK4TYW_00kX3bXvDF5_X2F2iC741RZ4dU2JWHX7YNn2g&oe=6A8C3C5E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYfPDWCCyykQ7kNvwERw9Wc&_nc_oc=AdpmtdwB0Qfy-NJAcIAl3GRUTVoaHZRKkKO-4P0edDZmdT7b3xTMnIG3hReLT6gOyd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
_p6-reLKCbu3qbrQ&oe=6A903D0F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQIz10XdNDYQ7kNvwHgnR5J&_nc_oc=Adp1khzIjjkg2kCgBpiSiFWjqXLY9XcOq4PkssTjEYcZswYFc6pWE6onSrSa2Ib3reY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa3SgsL0XsT2n3i2hkHdQ-itd3OnSgFwjX9XjEnwoJPA&oe=6A901C22"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EB6oM86bIwQ7kNvwF4Oi7P&_nc_oc=Adp-nctbWLpv8BTEs5elaNedmVNiGfGjFvxpNnQWPsdYGU7XhTzbWbRvSCJ7x_19Pik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi2BMEu7S5Z-1OcsXurTuHdTCRiiUQXLIaLxZwLzjJDA&oe=6A903324"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBa8hTXYn-UQ7kNvwHFzmxt&_nc_oc=AdqhKyG4mr7VBG_f0l5X8kQccGcJy_I_wv_L4zZ1jrDNAP2dNOwqbiU8bfeg7j-JAVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH10sszx42ux9SG4iWR9Z4YG4k5qWVEv_9GKITV-qH6g&oe=6A903EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHV3EUC__HsQ7kNvwFQhOEy&_nc_oc=AdqoKdp2MuecsWCSZAEAi5KRWyRFN0v8V9Q-v1EV62rEUnx3wjdX7kzxu8DuIhePXMg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHNLUbXx62dVx0630Vhv5Hc7TA7x8jhBXqRLzrPIFZSA&oe=6A9030DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itPFeNq6F9gQ7kNvwEkvsa8&_nc_oc=AdoygxEy8whKxlMSvpVMOgskjdn-JzS5jVXaezM3L0WyR131LUGwz81NKicRWd4MjKM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_n
Lc9OEm8oeHK90UVA&oe=6A95BB4F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b_9KE2itN8Q7kNvwGTaejT&_nc_oc=Adrw9HiyfI3ebj54ariVJamFGgrWX6DE8Toy9Nr9zd_lTZz0C3gmDviaEvVuqiQZ9Sk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcj64nYSI-Ux-4SPz5Kj71KMVC8h1CucHF7nIii_SQWw&oe=6A95D2A2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt2kSdX4gLQQ7kNvwF57QP3&_nc_oc=AdqiE8AsIYMiJKQxo8D-kzUvBVJQrxJLpzHN7ZiNVro5p5Rv2nCHfSIHtXSAgA1E4Es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr2JReGoUa-tiboDSZWRfqB7G9yY9tRJmflIGcQvlD5A&oe=6A95B164"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaZNB2PjQNAQ7kNvwHpeQ3m&_nc_oc=AdqmmT-mZ1lOlTm2u0V8-7rcGsiTxIyVp-4fvtf5GcO1b0WLFJs97_axigWdsHtm6zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPWnGK557gatEIeRcXc0hxk7AI8_Zv_CPrO4WTh8pGtQ&oe=6A95BD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltfe7lY92LQQ7kNvwFeHz__&_nc_oc=AdovJijeWCBDp0SA3907ZThQQJmL9lPFQiQJdX8kwHpq7vC5VIxnm1bOVxNKFVvaKs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7ESyrRqYp0zDeSMBPiTn6Eft19rrcsTRR-4PX_Ov5DA&oe=6A95AF1E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yxvLqwVrJ0Q7kNvwHhHnBu&_nc_oc=Adqz45tZq9WzvzzLJSmAz7kxmHQTJNspLA12z9Bv2zS026Ci24hRJopqM3EfIvuln2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
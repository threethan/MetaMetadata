IAIoSd5w3TFptDfw&oe=69E77D0F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzioTyUk_5sQ7kNvwFvi2HA&_nc_oc=AdoowtOj8UNWJ3rGQarxK9qwmCEoFp_RBjQAJ4nW5167Eidy4X7CJPkxZFFOCXrgzWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fUsqC2FcIc7uruJTMZOVUa-_6T349upVr4d91KLmITQ&oe=69E75C22"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auw3aHw5Sf4Q7kNvwEnoXh8&_nc_oc=AdpwHXAQvibVhvE8FXtnIAZNTSv2znpMwpto6q7y7ILpUmfASnQJOrvbXDLljwuqxDk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17sZ9ucO56Mh5GlSjh4HRXGMi0QPSddf-hNk4YdsoeRw&oe=69E77324"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XZ9qPKMvK4Q7kNvwHfuqEz&_nc_oc=Adr9UQDphwQ4SLaB39pHq4jv5oqkgOcEB4sN5q1l-OLVtPCVEBOJIIX9YvZr6DYCBo8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XvKqmj2LCs58IBNIWs47lgMLL-aNij3BJswvgzgpiHw&oe=69E77EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiQ1xizZXdAQ7kNvwE_yKI8&_nc_oc=AdqWEceXJ30t0Q31wy7trU-alxkMS5_NNoZQ_wL2y-MF-O9_1imCtQ3EB6ZCr8_tHlk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1scrBN0ASIz8SqqxRzW7hTsfxtCVqrmJr9qFNW6wwjTw&oe=69E770DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlUkfrqmsGcQ7kNvwFH-4mu&_nc_oc=AdqjAJDUnskP3j-0Zwq45zJub7x7UVvNdOk7m3HfK-YST2D4f-UDi2DQTGMUSCsLqk8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_n
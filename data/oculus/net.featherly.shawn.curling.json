LkWIWbAiUwmOyWww&oe=6A032C8F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P4YLXyHOR4Q7kNvwHkCsGk&_nc_oc=AdqLxqTkXrniSQvk5CYQXs90lg7Zw36k37nCz8myYjd61TYErmgbRWyG6_S0JA1YtPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uwb-VxV7xCVNSc2-WsfXWA2u3rprHay668J3ceMuD-Q&oe=6A0343E2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X3Ru1gLJegQ7kNvwHN0io6&_nc_oc=AdrDC4tme-6k-WlZu6XlWKISyVK4kCkwSenWcifhOwLDE0R5beukf5Bw_wvgtqo0G90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-qaPwJOJiYZIerJs7WPGoKSzvdHPbzjnmFm0MLOI5kA&oe=6A0322A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZewF7evm6B8Q7kNvwE9l1S0&_nc_oc=Adqvu3nNdolDW-eOMUi_hnlE5ZHE-Hz6TF4d5HKLRtBb39kDNAC2gYaMmvoCMmAF3QM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kwk97PzHJwJMKc1y0bD_Cs-AJUcC8k-jmf20zAFbNOw&oe=6A032E40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsRV57M1uYsQ7kNvwHf59V-&_nc_oc=Adq2gtOgotwfNdmPP8Yryu40MLOMzTkSDogKiI0e1r7KTNG6H3E0fsBNz34HY2j9YWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7apgMKKk95JXNrPrV6pqLdqwGuJtZ-wVtx3OlauuX28g&oe=6A03205E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22yX9VQotZUQ7kNvwEfWDE3&_nc_oc=Adrup9rcz8Enfqv3vF9v9K_YW_tycl__OxXLxF8do-ByZ5PjUDIU2l9_xO6MFOI_McM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_n
7YlwN-HBmL_1P7EA&oe=6A6B530F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pH4B65biWMQ7kNvwGwQ-we&_nc_oc=Ado7GtNO8gclDp8jeRpo4HgfVauwNcrzBAUT8Lo81NbLXCydmLCQUg_3P7Toqbrwbds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA21Arm8nxxtfsUUA_9sR7ZynbL029PeUG7xsZfSnrXRA&oe=6A6B6A62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amj0CybJ2oIQ7kNvwHPJXts&_nc_oc=Ado4HfIO-I30rjXgw-Q3eRJY9mhychlIxh7pyPj5Yn83ppaeCtENrvj-FWfL-Sr53OM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAngiHzuNixXszjcGeg-jncwebIzD2MF9WEiIsTw-YAcQ&oe=6A6B4924"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ39q2FdsSwQ7kNvwFQydzg&_nc_oc=Adr-ktavLTR0Nz4UE52LAfeK8G2oxfKeo2HcMrnxvp5gMBScAEEgupuVVluWD24jBIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc2BUQj8IY6rkTVWCxsRUnr1vzwQUMYKOk6rjRlf_0rQ&oe=6A6B54C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql9VvHMvWCcQ7kNvwE6LxA4&_nc_oc=AdoAKYuU1iQoFZ_6gN6ygfl6IMu-1YgkSEMDyxAv3FIRnG_g0jrPJZ6d2n0WBuTjITg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWYD561gmqnQuzRypK7ZwKCMxsf9U0NpC4L9tTMZO93w&oe=6A6B46DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmH3qWdE9pEQ7kNvwEq_Krn&_nc_oc=AdoG_nlsDxHu3Kfmvi-zU2KfapyaavNoVsUuJd7ieKqd0c-iD8ysWY-Pl2WQ6EZ-Z78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
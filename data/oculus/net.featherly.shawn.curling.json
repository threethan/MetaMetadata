j7CZvopsyPNsS4TA&oe=6A5E240F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iX7kLX4AZ30Q7kNvwEFy4Rx&_nc_oc=AdqDWXEL8_vG43mJrGQLSlMKI8PjCNkU1EVsEmta7AeC2wJSe-svV8qc-_3XRWkXHlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeqeVqnznm8xCZZj9TNWS7sXza_DmKyuYAk2Nffxg11Q&oe=6A5E0322"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxd-FK8LPUQQ7kNvwGuoJdw&_nc_oc=AdpdoQnDlodtZgGRWSqkuqXMPwBF7lOsmOcT40GtgterKx6ufdVzTGMY3r1swIRSPns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNfsbi1m3Znze1uUgCa-qBJ2TTv5FemOSq6nDfLo-YWw&oe=6A5E1A24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ARkV0UYvngQ7kNvwGSZyYH&_nc_oc=AdqkBDr_PW1YZqXj3OWUzf2X_PX9x1xoXMUQbo1OLy7oUKNjgAP-lmxOA0nBiJz1dL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5y5DlaCocM8JS_zUj3DR7V5X7gOxEo2TVag79JkL4YQ&oe=6A5E25C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqY9zL06QwEQ7kNvwGTJlmH&_nc_oc=AdqtQPLvBT2gSZUvjc_lLGeMU-Z-5j8ROqBUiUVW75G9afmkuFZT9dxbGJEwEicdoWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGxIijn27vxOq1LsFEjbF4pGDwOPQ-h77I785JShEdNQ&oe=6A5E17DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIrKsqzwImIQ7kNvwGLWEZ6&_nc_oc=AdruhuAWXfoWkW6nIWZ0hRFuYZ6lFjU_i-DFjmIhqY5Z6t_b8C9IX_4bT16ghC2AJnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
Geox4ZTIhawfl4DQ&oe=6A2EAE0F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjlSaq0yhukQ7kNvwEGKZMW&_nc_oc=AdryDBKSrx5vAHMzQTz_OlmpzszuEBcAeqvdi7DRpqrPNu_vXEpHptIi0UvslKliaLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cqPJZkjB_KfjmgRcSH0SihUhHb_0SuRpNDt4F9_HM3w&oe=6A2EC562"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh8AybUyKXcQ7kNvwEn6una&_nc_oc=Adok1ybcKhqfUZiAeKd8ZpTEkpOsGJWK-YtFnUNcYhj0_b5h0SLYNkM0q5YQqNvZb-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ux-VpJT9K537z3wCbYUEu69OIaxMkhTO4phdl6f3PxQ&oe=6A2EA424"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLKhzMh8UdwQ7kNvwFBSdUi&_nc_oc=AdpHqPSXTC1Ua0iDJn3y8wtfnMzJTbk7ECUsaUOI-f9oc9lVkp4zxNCAJ-6QCWMUG1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TO2Y2KqhY-VP2rAwt-h77pi_NuwbSd8a7E3E3c7ZYyg&oe=6A2EAFC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5uhe8KzPO0Q7kNvwEIWnzq&_nc_oc=AdoOMLLuhSKHr4dECmQEUZUkEHGSPk0SsHPwIAkPoeUqODbUQBlqCZ14h6312z1Nxj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OcB6kWMF1AmnG-DXkDknsoBq4R-86zQbV6fKeJz973A&oe=6A2EA1DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8CqUPcIK08Q7kNvwHTkztM&_nc_oc=AdrEvXeDNrq-Izm2fnxlse2g_DGmN1pprmRJWKyLo2g_T9eB-yL8A-OBjCZNwo2ChBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
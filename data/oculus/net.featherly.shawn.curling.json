EUhp8nNaAG3L22tg&oe=69EF660F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0rzvExiwFcQ7kNvwEWKS1L&_nc_oc=AdqQr_LTIumcFqvFsiOowOxxdqbO6YvVtReUxV3vxRLURBXX8Po1PVJbKkkIoGjGtCM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0o-SMjJYhnlDI8_OBycGYg3tS8e-Xipgsy6gFmA3OcAw&oe=69EF7D62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II0ESEvT7ZMQ7kNvwHcso4Z&_nc_oc=AdoPIQMMVysUQN4NFxFK_4s9elqqk26yJffB2yuF4p95q6JjgOFfIaQQj4U0kBs3nrI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rjS1fAtcI9k7-0VCEdQsrxvQP44KF9Az392CwDqT4fQ&oe=69EF5C24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13rGKjvqlu0Q7kNvwGw5VDB&_nc_oc=AdrYGQX5bTuTm1zNPERLIiDbR3HtFskgWlr0xN2DMALyZLAVjSqhP4zqncaaxuD7LAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n-okMB6UelN2HHBlnDaVfJQd6BE9So1G7EAgYzhQrLA&oe=69EF67C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gOOEZyBbScQ7kNvwH7im3G&_nc_oc=Adp3_ptHak2PW-w19wNb_-A3hqp8Sx9AO0z83dk23YZcCqOVDy8BO1EkNto5s6Hae5E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17kf5-SK2-JZJOL877ieEeMG5Re3auzHMtpDuRvf3syw&oe=69EF59DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OulamB6uZwQ7kNvwEdG61-&_nc_oc=AdoPAwIo8X4TmkaIMUTClFkDtSsHHUYpj9y7F5SjDy1-n4KdPet4u8oOlElKoLyeYU8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
q7iwPyj1s5KfMjbQ&oe=69D8FC8F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfDAm1DuboAQ7kNvwFTbsdb&_nc_oc=Adp8TTzWNFmekwfjdiLbVfilywo_AIa8OHwCraPnPJYddsRwqkFMoed5iA6X4Sww8Rk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LperlElHLzc_w-dbrxaPgoay9zEHNKhyV3ggKsfFAyw&oe=69D8DBA2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOukLYCWjksQ7kNvwFFgt61&_nc_oc=AdqX202KrZ_kuhdPjwrUj0kANR3CQqn9Tu7nseyFVsPqOyVIY1lA6zNy1eKKAN5uVx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DmHbbA8ISAjD1rHbnY21bMBpIMCE_mlVaG8HZARy5Vw&oe=69D8F2A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oxdPcWDO-wQ7kNvwG5uVu2&_nc_oc=AdqQyMGq_uX_O2f_M-0TUTn8UeLWQA-DZaL5ouaUKc7kvcR-1ErTUfLPguTZ3qtIJBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kWiALeGt1nI0eM0H-6NM2p_Qc1q26aVs7KxmV63YS3g&oe=69D8FE40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVvJkwadEVYQ7kNvwE8Ejw1&_nc_oc=AdoDFXMTdXQyrppDz1Zq4Laxxlz4UJ7J3tf6rQZ-tpcZg7KCml_ia66qrpaTZYARiOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x4_vyxleJSsXlKtM5fveaBEPHg7uMZRhfD0mDfa-ZpQ&oe=69D8F05E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVrYIum94zYQ7kNvwF7U1l6&_nc_oc=AdpGwT7YrcsNySKamFMzC3S3fUR3u_q7pd3NIN071LHyL-G8yrlz2KtjrleNUdZ3hCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_n
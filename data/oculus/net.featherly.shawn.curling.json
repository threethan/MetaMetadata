AOhbBDtUMq-wUCsw&oe=6A7F198F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T52lHMhH_F0Q7kNvwH1A16c&_nc_oc=AdoO_65cl9AwJcKYsgqWEBlDy7BqNJHaTUT-OwYDdVQrWk8OEnOOm-_36Ci112LgXGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWP_kUascHl1jxMlxvMYj8O0g9DbdoMbuoneEAh73vpQ&oe=6A7EF8A2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpE28NeH7rwQ7kNvwG2NVbN&_nc_oc=AdrGiqM6m0w0bmM72BSEgmPwfFEfdJLR7ZBN9AMZONWYjNYjzSeQc99NMtivE3wHMls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRPoNM7bkY2bFg9o7dZt4lAacIXPf6F-Bp9aDii-HTPg&oe=6A7F0FA4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap4n1xvBVD4Q7kNvwG4buS_&_nc_oc=AdpaSr4FaKkpdmdarbKp76wSI8-CnjPjeH1SBoTCeGg9H7pnJ-d61cyBIhIHU-vZVWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHlHb2msaLK8D-pAb-GF8Y03vtxhOnxWSJ1vCo2QRqBQ&oe=6A7F1B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0UXId7rmpkQ7kNvwFFcMEl&_nc_oc=Adr2H65fTDnpaztxeD3k1uH-Yo8dK_WslwHLve9vsb5A23dxUzrknCHZ33o4fC5I5aY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNFzQ54KjDsKp1oLfZmhs-k8E0zrGeZeNmdNrbuiZcLQ&oe=6A7F0D5E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv3GWbZ8l1gQ7kNvwFeU-ep&_nc_oc=AdomzP002S6U4PzJEGr1MMbwvGzIY4Y0Fp0kbzhVFIZcyFlAdo4fA5iOyyz9BxHDnmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
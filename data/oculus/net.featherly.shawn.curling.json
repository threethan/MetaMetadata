dZIZvRyROdlh8LDw&oe=69E2370F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2auAacsKU4Q7kNvwEVHR6h&_nc_oc=AdqiGY8-CwM8p6y9RL2VVetS5GwoYJRvOKrXKG4XYfIbRkCy7oOPH8dAO8dXWIYtvrA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19qwBeKmqdyCEbRKgCRjWJ5kbAzCFjOGF1Dju11sOtLw&oe=69E24E62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r5DKRGkc1QQ7kNvwGqAOsA&_nc_oc=AdqMOAZvtsyf4KjCThKBAZgw2NOQ07ksgT93bnLy4ivR5zOWz-00FcL3_CZxnG8l-_E&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MTpg3vCeLHa9IKlsfl9bxdT5E_C0b6_m6_ow0P7CL-w&oe=69E22D24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHJdxp_vnjgQ7kNvwHx0Z9k&_nc_oc=Adpk5Y3T-SCIMyhjmBNupI9_UnWmXa0yJoT_Y9_5w1CSu1VxCn-gEFYZK4ya6wVk43U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vk-Zu4WcW0MndytWVbwWIMsgB7Q9PvxH7WiN0HCGayA&oe=69E238C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqhuK2d6HvIQ7kNvwFB0hFC&_nc_oc=AdpKrd72CoIrLljleXGAMD4dGrv9U-VgZyry-M5EA7weZeOQU3isafoN-IytYioBSeo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GiChDHqY8jSPWuUjU34gxxAmhp2L59sMw2eKltbQnzA&oe=69E22ADE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LokT9ZJLuFIQ7kNvwGdka8W&_nc_oc=Adq-zunpipJW0dGtbGu6nc99ZtQ3X-J5aVuIZFv5SKLy0IfhzDEZquz_v5IaLCka8vY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_n
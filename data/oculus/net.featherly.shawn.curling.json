H_nThe5dpBjdLoIA&oe=6A87028F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ82QGO_6rwQ7kNvwFpzqSt&_nc_oc=AdpTLQbQ7wIN2AblyA5YGval99wo0jc3Qll2QfWXa4xDni5lenDZ9H8NbQCBGp478P8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9_K2CVNXlt4cAZqrPm1B2k8pjby5-eNu3Myy3ao2KrQ&oe=6A86E1A2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRZPZu2IVsoQ7kNvwHt30KC&_nc_oc=AdoHWFwir6LiDgY3DpR5UJGGHGPm1bBUmvZRyW-vKXDDhDmoZJH5vj0YnEDZlQf7yQI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlsSiH9C73mmMcuUO2Wo_NA2V7f52sWH0bqpR2hYOBvg&oe=6A86F8A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLW62Z8CJHUQ7kNvwFbvd-x&_nc_oc=AdqRcVLJr865rWI7DyK-qARfU0K0tYTELuDTC2jdJ9-m3N4KfK0nZzlP45zmT1cjqNg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3gNmMLQQg-zbpNJf0xhhOXaGbeGlij0fevp5rVLSudg&oe=6A86CC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWvjv_gDyB0Q7kNvwHRN0pO&_nc_oc=Adr8NEp1BWRLkLb20tisgTtIxIaNl0SnIwf8qnA9LQCaGwf6uicPBFOdfUvJ5UTFLTo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwS4EWOeu34-OTj8c7T6Xi3_VlxeDmdrumNTfqmR_2PQ&oe=6A86F65E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEvviUJ37GcQ7kNvwFOPrZc&_nc_oc=Adpsnph8nSciVZWYelFdlJYdPdzeoySsAoxtlIrAuehjs4s_AEuANOK07stmCis9Jps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_n
6nDDCOGDnRv2QM4g&oe=69FC950F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHtWpP2BX78Q7kNvwGOEdyT&_nc_oc=AdqKbglxiBs2w63q3cuYVaY-HntdwSzYSBu5hX7stOxebHS0yvEJYBNj3It4CXpjuOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70PZPdRd9iJMm-rdCELY-pVOEUPSzIrURqlEPnlMrxpA&oe=69FCAC62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IvzYyMkBSQQ7kNvwE3fB5d&_nc_oc=AdoVzERpAjnKeCDQvGZrO15LZFPRSPcswI0byZG8plyXfU9BHorxqWVpw2gDBpqZe3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Lx-hctWViTOG87QIdGAf8pZfsZag0Ff0xs0jWKP-JEA&oe=69FC8B24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQg7up1SoGsQ7kNvwF47IO3&_nc_oc=AdqEfWbhpj6kK0vh3Wv_GKLpLUS9rnZRBi00UldbTgfszklXEkPhd3haXOBa224ZJQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wbVFC2lR8FFNh9kSO9X8wbgIKig2zcy8Yvjm3l-z1kg&oe=69FC96C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v33PG-UMcP0Q7kNvwFsOxs7&_nc_oc=AdoVGsw0RhBwuLZB5JUEpo01GF5eTeBxImAnGGxeMmoXXdz0NTpHSVJf58RpuQ78pos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_gwzIO86dJvubaE5D5x8OdT0Q8ouPUJhENlK9jrBCGQ&oe=69FC88DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwD2mZTvnj4Q7kNvwH3mZQr&_nc_oc=AdprOEMuevq6I4OsqpERNTS5dD8wjFTyHwka0wf7Y52V2tIg0akqibBNm0-IcUejljM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
8ecC-ngy2EVBt6Jg&oe=6A4E520F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi2CmtWwDH0Q7kNvwEIY55l&_nc_oc=Adr4LcfPmzVi40XMX7mrxUmr6OeumsEckRSd8rwCF6CnwPrHTDEkoe0kJ3BzlU7E_Jk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGS8OVjykxLe-RMdzWyW_aza6kyxa3x969ChAhm5uzsg&oe=6A4E6962"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NqtT1pHslsQ7kNvwHjL615&_nc_oc=AdqtqrJf242aIlztk_tB6_Z3F2BpdopEQF4_nxgc-yuhxPwRaZHmlm4bL75K_XyK-2M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgW4Cf8clVXPAcWWNStAxhS3f-k6MWXFFgPFYKRa9y_g&oe=6A4E4824"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0Db5IRfOdUQ7kNvwHao_Db&_nc_oc=AdrydOn8L1Le9aNTlG1x1H5q0n-o-6hFsl9xOiWeUZNOgMrgP3fvCZk72cywIPh28VI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWiBG8AhpoVp6L-S4SkTvpJzd3KkAM3GvWEao8K_Uvdw&oe=6A4E53C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Wfn13v98OYQ7kNvwH8-vTA&_nc_oc=AdrOXj1ihvdQXAgnf3ySWP1Ed7qaTd_Oyi3GQkL4sLm4MuPNVVDndBpY1M8RKr4bLwI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHRL0lRwZWQ58lXgC6IhzR9ctWHJ76-UaV-9jGVoMIqg&oe=6A4E45DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJr4GMh_2j8Q7kNvwEBUMZh&_nc_oc=AdqQrWAqwETM-LiICVWdhxMJau2ykMZVAHx1z8wg-at14SvlmWMkNnKw6KclkhYBOBs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_n
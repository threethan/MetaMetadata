w7bA0xfv3XW6vgPQ&oe=6A5F758F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmNLTB5juoMQ7kNvwGrfXti&_nc_oc=AdqX2Q0A-2qv9sWnOqU13TjF9UTSEG9jYGrFxz1FXycIxv6CG_nZWlmc5IQ3RTB0Xrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhoQYT-uLk4YGP4HNU4NRgxGEpqVAhilqY31n5WvzsHw&oe=6A5F8CE2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxd-FK8LPUQQ7kNvwHJlnvE&_nc_oc=AdrhjFoTrrbLYwcfuWkkfQ0NtA_eFmkOTdDo6ttfIw_YIhqXVOnvFgr0lbhDhHSmOpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf6mgYEf8Nf5k25supDSYNG8E8wO0FFoRhE0dS2NbRwA&oe=6A5F6BA4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXLXArhO9pQQ7kNvwGRXzAn&_nc_oc=AdpiAE3XH5IRz7GwIGDbdjA694jbeUkTwEG7yIg4Maec6lD6ybQUXGJstmAOC9XeplE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUTwuoAF_TtlwUBHnleY7BbT2iugUAdp-2pniVKqYH0A&oe=6A5F7740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMMWuEg3in0Q7kNvwH76OMq&_nc_oc=Adr_FhJBDw5A5DESNb6KojMR0e2Juq4ra0Da_fCJNKmR1E-4ss_mquj62J5nNsbHzp8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOXgYCEjG6Qrlig4H2wWdeygwx3YT8RB756Tnlq5L7CA&oe=6A5F695E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8Q7gndjR4MQ7kNvwE_-r8g&_nc_oc=Ado8YxpfOXxqbK3z6rONtODBIJ1BHJBv9R18LNXnsrzcG24yV0uRlPxSwDcfjMctUk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_n
tx3Kwa8r8G3G9KIA&oe=6A41230F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1oiQmVAT-8Q7kNvwHTZbBI&_nc_oc=Adp_IODXoi3bRSOLQ8V7V1eQHkja6X8eMahBUrg51tWrN3j3mlkBXssDmMgeiVnPfbo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NdFXahCC8FH1mN_AiOGFnBSJdNoPUJFI9pU3h_vxRpQ&oe=6A413A62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX0hazHMMbgQ7kNvwEjZeWt&_nc_oc=Adovoo4KLcBRLlLy5tGRSNkFwq6G-unN2wMA4b_4ZBZwMrDA8EPjB5GZXo6DOijvmjE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88LzpDIEuYyAhHJvA5P1Ez8XnGDOfJ4Uq53OXu1y3sHw&oe=6A411924"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvw-K6F_LvwQ7kNvwGdWrSi&_nc_oc=AdoGIs-zlLHIFpVWw-xOGXfy4-NA9x8RjsHCenh0_21ntLU-0nR3qn3OyOR3xa32rlg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RNIRAhAIgdC02OjFz2QvfB8sDvJPW1iZFtnDw_GaCBQ&oe=6A4124C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7vxjN-x0sAQ7kNvwGt1LQd&_nc_oc=AdpVLB_O6quyNHSgbiMyceGF0YvBXe4rRGCEwl6nnQ31KO4rJbhBDrXIhoZbyyXeEYE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OzKmJtmSlCW-5eGa_fxd0H7k0zdc8u37u8a8TPOKNBg&oe=6A4116DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKd91mNT2EYQ7kNvwEgCng6&_nc_oc=AdrQjYQStSJTjyvnTOIWBD3hSEJhUb6Kj9BCeEDF1pZc3rg_jS23noiiWd_P5yuy0S0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_n
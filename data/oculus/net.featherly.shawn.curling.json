p4jWo3yTl814u21w&oe=6A94318F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b_9KE2itN8Q7kNvwHf6XfL&_nc_oc=AdqFxNnQJbfzc-veAbqD3lbjJns4NA4CuE8xvI4EbOJds6g1BisYP_CtQkwqnkIBk-s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELvIu8RROa73QlCsZ_6vlwNkK8TCZc0oqw4UAG7cQeJQ&oe=6A9410A2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bwrzOdMxAcQ7kNvwGcLl2L&_nc_oc=AdqLEUt5pgy6RGy8Wd7x8HomlInElpHYY54_ipoxd3nJIWwqCQCxFdDu4JbUF5QohRo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcF2AbuMTT3X2y5u_V0ZKLb7G60FdQ5vLKp38SSu55tA&oe=6A9427A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaZNB2PjQNAQ7kNvwFN88lC&_nc_oc=AdpBKzefjbglkO51Y0CPl4hEE9WGdSrrhP1yzPSFRaEFMlxet1MK00SLzJcYZDYizE8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb94q4na50JsCVpkd2qHgP5qQjNM0PvmCaaT_e51sg5g&oe=6A943340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltfe7lY92LQQ7kNvwGLK-vL&_nc_oc=AdrZrSbPoQO7mBEXtgHG0M1mgR1KoyeuobMqXlyX92YaT0WhLebsag-QXtAsYsiXidU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIpoicIBGW9W2r8DIZbIVsgeAb5j-TWHmyNhsD7nXajA&oe=6A94255E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yxvLqwVrJ0Q7kNvwEki7Km&_nc_oc=AdrX6yo652TOW5kkkohKJdcR4bTQTBqLW9nSdtTr0uv_YljDR3g7ujJj6rxG-89YXg0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_n
XiO7IU1cHtZQ85WA&oe=69D6598F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y12pWTKl2mcQ7kNvwFEEJJx&_nc_oc=AdraaRAVmOarWSA-zlTOO_SgEm1o4PgvUA6Fhhll693dywsoGC3cHgvqk587TVV3wzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fAiwLpBRLbYGmNvH4ATLC-m_saIjUbTidiwS4n1_uuQ&oe=69D638A2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ_J89P-qbkQ7kNvwEbi8lG&_nc_oc=AdoVg2R11v_iqr_r2N19lDFzl6wv0AaTkQ5R231e-zJombAjl0q4Tmj9e4b5DTm8j_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XZMiFdt8GHAn7AjJ2EiJyEP8ehbprfd8QLN435Ajj0g&oe=69D64FA4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaEFfYVKDu8Q7kNvwF_naJ-&_nc_oc=AdodrNw4CiBJlim5fSIWXd4q-YVTPi3wLdz1_EqeZWt02Ow4JXQG5xbeap52t4epbh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jYVpMhkctkyET02ftXZPLzjrn0NVeZsrObjik9aoZjA&oe=69D65B40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR3CYz8xNzwQ7kNvwHfDghr&_nc_oc=Adru5UZbJRU5PeD0a-ACN10dEyntWmlJxAgy3kQ739fl158iSUSsYKMZVYC9XWKzhKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KivigSHxRcPye6ijPSynBm0_N9gu3iVRZKU050PTJeA&oe=69D64D5E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJfjXwypgJsQ7kNvwENG5El&_nc_oc=Adr6AJQeODoWjILgy8-6Fl6WTuuwcLWjybTJbiGsIL3Gt0iVnY7vezrCd5qojatp0FI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
hR_eJZxZ14KeQe9g&oe=6AF9ED4F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-4zg6aQchIQ7kNvwG10MMW&_nc_oc=Adr579PLioyfk3cqMrszdAKtVIz6i_0LMc0xA4k6bDkPOhov0UVIbkpOzTmb4_0O2RI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAa8ZunCzAjhZhvTSJnKmZoY1jWXNKGhjoKLB8AcH31Q&oe=6AF9CC62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myo4AJApuX4Q7kNvwF7roy0&_nc_oc=AdoDQKLnd6BkqplvHp1OYmrU-yH8qsdrYz0sb7gdnREuAx0bECl9ovcY3R5SlUQoheQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW1IWuoQPTbd3buYfBw91SMfb26JDDpOk6q7A3bVq9Wg&oe=6AF9E364"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbjnEHOXaL8Q7kNvwHjSWtr&_nc_oc=Ado2NamAJjFDUH6vudfgXOapMuV_kNC2_Wjz3xXMaEXMOGi-LwBuOtj0SpyIPXdE9rc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBDvVxXZedpY1mEbBELPW7gL1k5COxqmq-NNMlHFf47A&oe=6AF9B6C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwCVUfViVuEQ7kNvwG4VP2U&_nc_oc=AdreC_w7XYHEq_y5_EcE37W-d4PWSjTJRuJbO0WFoWUUKeLnaxZjQ2oEPugnek9XGLU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR65KNgSSWnwOs2ygA-zNynUmjOlUZpoA6OQmb4J1F6rw&oe=6AF9E11E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ufQVZdVXKMQ7kNvwGIJZnO&_nc_oc=AdriKJINpiIUqFFJbDtQWV3OZDh62TkrgYvZUWXZ1uilQSV5dKq1JDwcjzttmn8rwF0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
W5sJpA8qxjngeEfw&oe=6AD3B1CF"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A38Dc7qIt9oQ7kNvwHOP3Az&_nc_oc=Adrr_jCjWXJK9aSsVrOci_3gsW5-Q5XktsLgUJ4OEero0wdwVx7OF4Fmv9HRehneFpE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMedG8UDNhF0ov8Gv2TsqsKxeKoT94-gN6aeVwNeE6opg&oe=6AD390E2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmtzrJS8A7MQ7kNvwFglK5q&_nc_oc=AdpCNqDcSA2BfeF2B2DhrkG1hHk0iMDnCFZf6PLtad9sIPpMEI0y02eK8EL3P3XpAkE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYdu9GkISzUWX29NI4AehCBtIH-92OydjZ2CYIfDcN_w&oe=6AD3A7E4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0_wpElXZq4Q7kNvwEv5OTT&_nc_oc=Adq-LVwnP_CZDxKW1_eO6wHxciyL6d9l87Z8gBfhYqCD5hag_5181bRBbDPxsmbQWn8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYYp1oG5mEuAxNG7mZQmcSxNyyk0LFFRt4D96BtGZCXQ&oe=6AD3B380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bz5rlLhDGgQ7kNvwEAZ62z&_nc_oc=Adq5luDlMiZ3vkI3hIzX2bMr7rBmPtOho5ulGWZwWVVgqHuf2XovzgmueZXmJPxf6no&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoTBK3A7lcz0vJjA6rZVa_3ZHaFXIhFg76H_b8GJuvHw&oe=6AD3A59E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syJhmt_1_qAQ7kNvwFQbjLl&_nc_oc=AdonixqrpPTzbP6PM4_t4RAKrHVdYMWFD6zrY3DnR0UPj0Ot2DUciDAeR5rDFYxxf6A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
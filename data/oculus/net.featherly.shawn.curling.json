ylfSgxbSIx9-9IRQ&oe=6A25738F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiDqyuDqiE0Q7kNvwFuiTCL&_nc_oc=Adr8b-mfcrDcF3JLDTiBEwU-mkN9YybcYI2VtopbwSqwquKwPNyimPpnlZtTfL78kaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gC6KzZvOaq4TLvRqrI2vJky1zZLdFBghVcGYOBQ8e6A&oe=6A258AE2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IGdi8Kv3s0Q7kNvwGhWENV&_nc_oc=AdqWaUhJg3srmoBCznQ0BWp5Py_f7k6k05rEZPpXaTtGKNFG3UdbRHGZTIj-dBUyPkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YzvT5Sp6fBplobjGDERpAUFQlZyKjlSFIGKQJar2jZQ&oe=6A2569A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08mROdE0NVUQ7kNvwE8ckN_&_nc_oc=AdpuW5gH0GDW-yxn7j_OcEhdJ3b9gzvN6kgMRX561Tl3zVGpjkc2CQAP_1yzGWSO5Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mUb77diO7GScIRivfsz7r7uDE48oSI7mkcrWggJj1Yg&oe=6A257540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aonzItVvWgQ7kNvwFmXCbE&_nc_oc=AdoHDhLqA-xqkg5sIphz3Y9_mekIDgFnFs2LzVZn57Tgnh_TOXfmPbs6hr6nv1J6S9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BXFHV4lLszEbvXN7EgDTsGtc8dX7xy1tcl0M7Acodxg&oe=6A259F9E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEPWgQVLxYEQ7kNvwE7uBqD&_nc_oc=AdrHQaFgniy2Zq78lT_VUV0yjQVATTdnIQPaMcq5hLjUOx4T3x-5BM9QfPGWLq3B8g0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
suWHat9kBrQFxTeQ&oe=6A26C50F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiDqyuDqiE0Q7kNvwGGCVBT&_nc_oc=Adr9ECLcDToU2hfnS8JqpwEOxmB7fwNl9ut48wIvXdOIhNp83I1OeNr4JvD-83HZXBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yb39NhqvLXDhthG8c82fgiu2d5mBKPIjXGHEzjp-ilA&oe=6A26DC62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3GtUFx2fr8Q7kNvwE4e6BZ&_nc_oc=Adoe7vwqM9j2XR2-1UJNS2M1UsC5MOofDgUS00u4EAdT_x8kdSVSPCEGmpTkvhW4yoI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H9_YBwpA34k7dXYVfr2rY4-Ft1KvkNvDOgHJ_DV1l2Q&oe=6A26BB24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08mROdE0NVUQ7kNvwFsDYOy&_nc_oc=AdrPoHrUld_Evpl0J8L--1bdIhID1AWFcddIWBTp39sFTcnTaCvpd8rJ9Wcj0CbBDD4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KDNS92XCwhgHzyWzQXkPRKxt0CfOZC4VlFO0VKlcK3g&oe=6A26C6C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aonzItVvWgQ7kNvwF-8ki1&_nc_oc=AdrVIOmVxj_pb9YQMVw3pY1ww0H71z8fHMsF-KODil1Lxty6x-FjMKiqNKrO3Gz6Suo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-ef1_u-Osa_7YKnmPeQLZQ1z7JHpvCQ-4fyqFmtvsWQ&oe=6A26B8DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEPWgQVLxYEQ7kNvwHlySq8&_nc_oc=Adp3a2pND_y5kVQ1YN_o891VyFia8qJVjvIhRstogFbuwqDMw-zuS6g17OPeDXTXCf0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
hHwUgBxGgo3VPzEw&oe=69D2650F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvIhxFpap0gQ7kNvwGp-_BX&_nc_oc=AdoKmQFJBHlFHzE85VNwi1Y1DD3C0U0Qk_ZzAkjd4Fwm1jd5pAb2XsB1nxls75DUMJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z1Ac7_GhvW_PSl09wBNKaA2yGsudNBYugEoH_lc3MNg&oe=69D27C62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3TR8U3HDFAQ7kNvwEsMlTh&_nc_oc=Adpbb4nQqgXUo425KN-bZ3YO_9nA3iCkHP7I2o7Vk3SazWArdYXSS3Vkt0fCqavrqFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HEoSwfBkFtSbIVLRMb993QTgtULdYbmOoniqc24GtdQ&oe=69D25B24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch6QzK_lFb4Q7kNvwFOVVJr&_nc_oc=Adq3h6oWRVR3OqUH3dkGrwcT0PPMUzfSIIzTtJ3pv_ZRE-0QIWru0HRrvjPC0UiehNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26ye7pqJXEFMrTZdBFLugo8JvM1oNWKaHLWzDtaNiH8w&oe=69D266C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj12kg0xLtEQ7kNvwEh2NLb&_nc_oc=Adrlw6dnYatBOqWnfvOQT1roGz2wZasiz2aE8y2jo42Q2uu1vOooX4DqHrCPjQmxpnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZNN-JdkgmG3wHBCgocrBv59L4SyRwvsXdM_9KzfRaTw&oe=69D258DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AYMhIMvgzoQ7kNvwHtetBR&_nc_oc=AdrnALLs4MiTUPZmtaBZO8ZhKfYIl0XQkAgSKM_BTCHYujlubaF6uZojZgjImr-Gb8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_n
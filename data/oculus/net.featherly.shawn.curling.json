Wb5-hoKtU0U9DwQg&oe=6AB6788F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y-EYKpUursQ7kNvwE13M3l&_nc_oc=AdobZEpZrU6BKu3H-2uFaQ952rHo1RHN2TLcfYJxLsprMkiexx73ewthYvYdRmHm4n4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1GvANkNS__LAuJmYk2UP5nK9TujmI_fy9KgUMreYqaA&oe=6AB68FE2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzT-NbxBafoQ7kNvwFGRU8j&_nc_oc=AdoO5Lia88O4YzahKFos_6zxNYw8IKUI5yII5Qieuw4YlPpuA78dSobvqySG2Qly7gY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPRekLQ1Kb143P9FhbyQrMGpXDRm5hLKpH9Zpn6g22Uw&oe=6AB66EA4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OubMha_mksQ7kNvwGMb-3o&_nc_oc=AdqAqpgDTeHK8CnGZG1s23Crq_yxsHkVG7a1P2lFp1h4DEdgaLLPkZyreakbQWijv5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDExDMECL4DZZ6A_IPPqmNPpaJbX81_eebBXQhsFZbTA&oe=6AB67A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e68TgEREbzcQ7kNvwEkcM1I&_nc_oc=AdrlWmS6_wiwkRbPt0ZnL4GUNEOjWES2EPYDFs2PiPmdUbb8tadMBQNnNQ3hMb_S8qs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjyQFVVjaNBRVVUWMA_knV_SdNYAoTwQjPpITClhf6Rg&oe=6AB66C5E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vo3EJh32jAQ7kNvwH8djHI&_nc_oc=AdoRolwT_hw6A6zLwTgvqK1mdc5t8ACrNbzG-LU8G_5J5k-ZTBetWeR8kqe0O1Gd_Yw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_n
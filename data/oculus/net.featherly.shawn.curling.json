4jtKpXgIzviaO-uA&oe=6A2AB98F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFM7M-Co0V4Q7kNvwGfVdcn&_nc_oc=Adqvg457Y5XMliw8fRulrpTpNyX6MxiEfjeprZmFkgJux3yv2h5GSmV43UrCvDP_OwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WxiiE8-dDBleJ5YrKRbeb-MZngJkjfsuK7ZoSdZ_cqw&oe=6A2AD0E2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aKHvNhaeaoQ7kNvwGf5TXt&_nc_oc=AdrXbmolVkG_Wu_PiG39qxYQFz1Pkkemod4ld803HRHiBz2GhsYzmxxPRo1vsfeWdHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oxLaloIF0DskUvP-H496fKbCuq6rnPsu_30Nza_FZAQ&oe=6A2AAFA4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4YRBYdyZagQ7kNvwEd1dUS&_nc_oc=AdqRMRP4LOTKm0aSPEjy2VOuwBj_pek9nd_rbGm74iG33WsoEgUeVB3TUZ4LGSRX3-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8091ZfXYXdlkF-zHMCI6BE5_y5fJDVgBoU4l5k5RSSKg&oe=6A2ABB40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPbOzsSWgLQQ7kNvwHj71r7&_nc_oc=AdoNFtxzJ6ZSVMRXNk_0Low3SjlsR2tBIXq55CgVZwk5vSCtKoEvWzRUwCEe9zw21iI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FN_f5HRJ1_aKEK_T0TXNm36e1YHXxptVHYEt1mIhBXQ&oe=6A2AAD5E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfWebvhfC6EQ7kNvwGBzlMt&_nc_oc=Adof_VSTO-CRhWFu3DsHcHb8hX3u7EumaG6N_QcCptyduz66mIEHq5cl0rYQpzqW5J4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_n
bLSo-aHGeB1dYj_A&oe=6AE5EE8F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNT2vg71XaoQ7kNvwEHK8qE&_nc_oc=AdpCRdVTYaQm-V5xu4zRH-X3Hzz3ICb_zlE8pYa6mVcIJ9t2r-pQ3jZTqneaD0QB_fE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvxwAsW5tFNDN87qn0G2_pkNI_pMze0jZLSRKacb_MUQ&oe=6AE605E2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLYlNn39shkQ7kNvwEeDa3x&_nc_oc=Ado6KmiK6gvE-tSqImEd0iKpUuOYJg_yyqKvtRm7IcyontxFlCj-gMs1mtvETearI5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNavEj91hze1UmLXY7xAkMeguDTkH_5k_91-l79XyUp1A&oe=6AE5E4A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBogPXhu_LcQ7kNvwGYa0nk&_nc_oc=AdppLOb4R2vhMC343d9oXCuSfdZGjOneCpz4eaFJtrvhpjOAXmbfJOGevPfBQcaUVsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNKElURTb2huAXekIXAowifvXVOlMYd0pKGSZk6LqmEw&oe=6AE5F040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpMICt49m1EQ7kNvwGYX54w&_nc_oc=AdokspXsPUJaM743uu_y5FJAArkfm6bN3FuDddYO3VKB0L1Oc8QvbZ_0LRDzfKjp1l4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVOUbHncJR3duWCoM3559suAPQesDaetdAF7RCLJHlXw&oe=6AE5E25E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDLBhkYpW_kQ7kNvwH_UbTX&_nc_oc=AdpNO42PjvtTpKGhAVGLWfwHdlukGsTjR_n7kwFrNMKRkcMvsx27aCf_MYW-ZsQrrnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
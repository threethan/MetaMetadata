yFPJCiYtXnTxHlAg&oe=6A05CF8F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqyYoKg_afEQ7kNvwEDmhrw&_nc_oc=AdrdQVjLidSPxPxOh7bdseo8GAyjJ6nq2O5LWTMZa80tHGZw5Nt4P80m-ts3Zh5R8FA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o-bysQ-ghVIBjJZfn0WDC4OaOEoAkVnFvxiYmzm8Kgg&oe=6A05E6E2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X3Ru1gLJegQ7kNvwFNZs1i&_nc_oc=Adq5WJKRWmpCMFXenOKWMu2MQO8gO1mm3b-hVIUkzsya3HRaM6cl05i81Axof5lZeHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IzmT3aaP5Zw-XokoJVdOyyPaCDtbZ7KX5bFuua9d3iQ&oe=6A05C5A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd5kugh8Ui8Q7kNvwHuN925&_nc_oc=Adr3nfXa4YizsYrOIC248ENnO3twSAd6qzQKnha2C7PJ4p4sxXktmMSj2cE4u7ostQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51gtsbwPMHM3qiWXOo04Gnxlilc6XQLBW7016uCr1CZA&oe=6A05D140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2u8C3a_D5F8Q7kNvwE_cPrT&_nc_oc=AdoGKzDwu9shwaFrcW9gCcYCCL8giFret_Srb1BpjuTz3tJZoaVa7EM8iwmr5acFOLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77wg9c1x1bA98ZsaL8aCVnyta2VZzqL5TGfdR3quZDjQ&oe=6A05C35E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxuFWtu4zI4Q7kNvwHLSczV&_nc_oc=AdoPD0LN-Uz2aX3O_6njot5FSO16hsP0MUT9d6gwrkef2ADgmXt1qMM0CrYEkA5pP1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
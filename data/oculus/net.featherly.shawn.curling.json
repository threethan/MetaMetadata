wwXkJ7sx5blLGK4Q&oe=6A1C390F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL0MpRHWTYUQ7kNvwF2tq42&_nc_oc=AdpzDpyuEBllin5zIU5AKPcZMFdVYxY5BYdov7Cd5B4o6x0q1vA0hw6FxL--iv6hrzM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y5YN4jTLwA-WE1ndcB732CMrRzBf5TWWQQWwnSUx_dg&oe=6A1C5062"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtYmNSp-nYYQ7kNvwGTZhXM&_nc_oc=Adpg0WpExWn3oUQvK2YAbnjbHbAchdzCiLwAwLNasmUb6BWccrR0Z91e0gWFseVZVdk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fsuFeiEP7VjJlrM-gjPD_kZuSZr4OGDBJOY1nwzvd1g&oe=6A1C2F24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFTinHxjZbgQ7kNvwHbZ6n2&_nc_oc=AdoFybjiGQVDwc0pK4hYbb4gTnDblO9wXUaXSC0CUu2AfPZdazsW4uOMUPar8kTeUbw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iPLV3ZbwSrF4-elnEaeY1HjZ5wblViUUJzCbNiRX8aA&oe=6A1C3AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1OEW8n88uIQ7kNvwH2Ok5P&_nc_oc=Ado-FCVyxNGLEycSASSKr-8gKvRMFW6ySyI0RfKroIsK7gzHBwntt3vdjIDm_nb-F-w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n0501ktkGbhE1t2CCXuXqnnNnYr2Nq-ZEJQ3-96IGFQ&oe=6A1C2CDE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYU9uUZGuNsQ7kNvwF9NY_r&_nc_oc=Ado9qvhYS5H8eGFE-auT-fgL1agCbDJbujZ6dfyUBZi_yvkyR_SVRiYWpNQyN4Muulg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_n
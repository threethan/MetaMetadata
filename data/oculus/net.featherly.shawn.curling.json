8nhzAuQjk-NTdwEA&oe=6AEC860F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSJa8mtW60MQ7kNvwE1ivez&_nc_oc=Adq1jeybhBrgqQSEDOrdsjoEJL7lZwM9FQFN_JQm4_7qEQrUGftKEP1kucKf_gI75eo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSModDkskdZcG-A4Vb4fLd1a7jPBMslXUyTiXg_CR2EMA&oe=6AEC9D62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0-LCGw_Nv8Q7kNvwE451LZ&_nc_oc=Adoobv9UUhAM1IChEkfPjkbJete-MQ2AyfGlaKWAdRDiAahl4FDfwwg6tvMGfZ48bNY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST0wFNv8BbrIs88gV0ZjRFKqrb8i9GRKBEHpyMq1toEw&oe=6AECB464"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAMlMqPKkQMQ7kNvwEXif-V&_nc_oc=AdoXiXcKCTpyAg8zz3hlpPUxgnvJ2CmreVQl5C0k_gJkohj1Rqj-cQWCMXVgMxNQIho&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx03VPZ8-AUeVqenntO-01r7xP-zzO-lUeI_vy81uFHg&oe=6AEC87C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsWE-RaE96IQ7kNvwGABVm1&_nc_oc=AdpEGVeQ9EFW4ne-Eg4IzDpRplzr9rALQ6me4HxAk4ke6yAEqZs37EnXRMbR67EUo4E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOCQ6AnnLSheGxbO8R2ojz5tCNYx4kiMbu8ANwAoxF8A&oe=6AECB21E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeHpPkgYHEIQ7kNvwGLQ6FW&_nc_oc=AdpH8liCqhZmu0a7J8Ay2QVHvU6G9S1xMep_ySCFtRrMl7hIDYEtliB1kBRHQzJtgdI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_n
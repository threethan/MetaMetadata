BwiD1sJ0F3H92cQg&oe=6AE34B8F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARfaHN1Xy_gQ7kNvwHhyWcU&_nc_oc=AdpEKUhodOHd5nTzr2AX9RBHZb7QrppbXfkJixnMm2CB6PudTnlZ8VlEqxPd0eyS5Uw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5zdgeGGDX68rsbBiVhK-cwM-5HjCAeUxplg-5UgFNyQ&oe=6AE362E2"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdMmQL2XRUsQ7kNvwESdWWP&_nc_oc=AdppYVvREUwjRxa6FMK4_LyXAjZGe89yH7c5riU0Aqusy-3QsMxXkY_Kd7lmMG_NuQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC_c1tnoi-fts-dqVHE6WPn3DHk2OSyGlhuAF6ptRNdQ&oe=6AE341A4"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJRlU0631XIQ7kNvwGye-hD&_nc_oc=AdpbStorSXL15NA1E-359rfoKUW87WSq9LY2E9eEDkoEK6Em1bFJPAqegnstEJstDDY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODEwNjlgsrW45VRsf7oNhu3TvDjEZ7z3RlLVgJi2-RcA&oe=6AE34D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG_RzJEGRCcQ7kNvwGjEbMD&_nc_oc=AdoZI0MS4ZVFeYrJD-ff1UjZd2PKKl72DskNavFCGnN8qZqHF_ashnegvJ1VBlaBlyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5Y1HqFbwvdD7vZB6LfygWfxlJ9eX5Tz1PuGdLbNcr8g&oe=6AE33F5E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9XoXN8_0SwQ7kNvwEZQSWH&_nc_oc=AdqbdLJAWXBnsXK7QD9khq5tJHetyo6iRfrxwKfEHiB9MF2nfhnXB4oRIZFqyE4NKMQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_n
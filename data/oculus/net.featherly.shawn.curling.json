AuHORmrVIQMX4vUw&oe=6A92E00F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b_9KE2itN8Q7kNvwF7Q2hd&_nc_oc=Adqtd-3Z6Ka0hTFgMu8bqsP6_eiNc-nO8SwFuZTaPFd5YRDRuXE21x3ezo_lvtHH8L8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyJTvsFSSXG3oYP1o5Hj1sGEVmHCjw0q3z6WCLRufPCA&oe=6A92BF22"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bwrzOdMxAcQ7kNvwE3Yvkd&_nc_oc=AdqiyatbtGubz5mLiaWK8cBqB7YIe9pVgm9VeL-oxeyLgbOLgwqFz3osN-byJCeRevM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzdKPpXNDZ8saDO2GOot3QTllB0GLLMbBnGEwtw278Xg&oe=6A92D624"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaZNB2PjQNAQ7kNvwGzLkSr&_nc_oc=AdoJHHyfmeDJh6a2iPdWpBVlakm8iZ_io4oNAQssheXrzI12oJKTeNKDVpHeRIlv5S8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSeNfZjPi-M2OiGVjrf_rplFp3rOgNjmME6hSWmfBSIw&oe=6A92E1C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltfe7lY92LQQ7kNvwFMtqbn&_nc_oc=AdpSrqBSS3SMLsrZayZh50tDXve8yazM4-74_U3b3wbayGMhkYq8Rd19pk2w9d3nlK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH277LpD5N6fX1HB2nzg2f49OyKmmX5sVj-u8KQp6DEdQ&oe=6A92D3DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yxvLqwVrJ0Q7kNvwHTNcBN&_nc_oc=AdrYrvoAxDNReKa5pHI0iIwkGVn4Jsx3U61gxGiuy3EH5rzNHfd_P4LLeI6yWBIGhuc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_n
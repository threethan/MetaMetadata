WMv6Pq8BxrsVahnA&oe=6A43C60F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luw-DZOPaYoQ7kNvwEL6o7Y&_nc_oc=Adq7OMhc8i5Y025561xs3BhSQYqKc88SuIjVgnVO5LLp4nDoPlmt21mu06CJq5oAmFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6QEflcnCWFyBj_347Ehsv5GJFxYZfWMvHmi6HcpSMhA&oe=6A43DD62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v-K2yk4FaEQ7kNvwGgbWdD&_nc_oc=Adp2IWcDh7vXTQ0bI_Yxon2RNJBnuMWg4nty0OfAkGwVmDon1fXFIjvDJqUxpLv8apM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V_WHYUnrma9wvdXOnUiN-nzbCWdO4iMr42ny-npFakg&oe=6A43BC24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eheuE4E_nF0Q7kNvwF9ESe0&_nc_oc=AdrH35o0etIPTuCrgzSdlN68rmmP942ro_OIxZASOxrr8jQMFwe5JcmhApwf4pUIaiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8DwTEECCZBjPWgr5RPFbWoWJTGh3uTo-5SIJNkKcxMg&oe=6A43C7C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88o1u1lWyrMQ7kNvwG55gFs&_nc_oc=AdpDAS2PBviHKl8JJ6HPAb8e_-0g4cgkPZFep4A-oXKIs7xZuxj3dhhZOU6dJ0lvRts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a4JmZIDMkq-ja7a586jLRRPgmJheAqoBCwAaQMLigyw&oe=6A43B9DE"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YXbsEnKsoEQ7kNvwGYs9Fr&_nc_oc=Adr9Ao9SKjjZaR9xcnGsIIf2EYOaLxs8O7GxF6wV_d3jCBvzfUlyzeLGTtCsSwmFKks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_n
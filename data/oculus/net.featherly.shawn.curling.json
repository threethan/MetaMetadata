Ats51uTasA7eWjnw&oe=6A33F40F"}, {"file_name": "SsVideoShot.png", "id": "452616173058296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974572_452616176391629_3121816784293444095_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rszbjybgU78Q7kNvwGspJzE&_nc_oc=AdpZUwkqMGSb903m8dhJgVpVj-bU2UOHYkakDxNRSy8pcU4bmRl8gQN7u3lu_nuI7ng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NZMfKqnx0YTmW93xsFFwAokB5QVGCc7LA9Ix1p7uJCw&oe=6A340B62"}, {"file_name": "SsCurlingInstructions.png", "id": "624102728715547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974638_624102732048880_8844365968088764764_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfognuUmRHoQ7kNvwEdXd79&_nc_oc=Adq27V2OACsnmmBEEnI72ZVoh_skphWCceCwI1jXnn24dMzi530LJoMubYJQ3Pm7YAc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AoVURu25OP_SxKEfM6jU2t62mYTy_ypIWqVO6EoWqcw&oe=6A33EA24"}, {"file_name": "SsYellow2Shots.png", "id": "863257161021333", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031401_863257164354666_4380011148288309843_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vo013iFE4SEQ7kNvwEDlnka&_nc_oc=Adrq0-aBdjxNhLploaOL2MolqR91bPDv5d6T26feHedeUUpdn35ubScsm2yy9HiKDlg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IPgxr1R10IOE0p--ztdUK_J7D09-kT5YESdBWz5tGMw&oe=6A33F5C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CurlingCoverArt2560.16by9.png", "id": "3078238962456385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031518_3078238965789718_1994122252147675703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpdLpmfH-CkQ7kNvwF7fV9k&_nc_oc=AdqN9lP3-waG5RgQ8iWX6NBP8dQNyEn97z-SFW5T8ScuunahS23mwX_1VqOhZTpkoxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uUH3kl-OuKHdvVwBl4LjA7JYN1n7HHblTAtpfAQ9LjA&oe=6A34201E"}, "display_name": "Curling", "keywords": [], "long_description": "Play the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nCurling is fundamentally a social game. So is this VR game! The social aspect is similar to \"Keep Talking & Nobody Explodes\". Everyone needs to be in the same room. Sweepers for your team don't use the HMD, they use only the Touch controllers. Opposing teams play hot-seat style. Handing off a single Quest HMD to a member on the other team.\n\nComputer controlled AI curlers are not yet implemented.\n\nDemo is also available! https://www.oculus.com/experiences/quest/4387676764681800/", "short_description": "Play the sport of curling. A Winter Olympics party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7938729246164091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_417501693258994_6557272125450107768_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tekWZUOkwkQQ7kNvwHqnWKf&_nc_oc=AdrFfbuaOLdSX5C8rymUViHKhRotWf5B-0bwpSyJ_LRaKK9XILoHCpxknehSZ7zLa9k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_n
nc_oc=Adr_TEnPNMei8mfKOBrhAO0JEB4bbnbA5v3_FyBo0SCbSfGTgO0SIYGeR1FZbF_jZZU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-wJH5az0YcwtYpqOBdnXC63cmPOdeZEF_WaquHVtzkg&oe=69C3CAD3"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MvaidaLgL4Q7kNvwEC9Bbx&_nc_oc=AdorMxrbiLrnUfIOqoZ1b1VS7z9HIKmEOWzIfpS0a9HW6-GyLRfvW6PctGp4YNiuFmo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwde6_CbPdJ3ZU4j9ZlDhvOXAY2J0bTKUWlZMhmZp8Qrg&oe=69C3CA25"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHfh4hKkeREQ7kNvwHTtI7I&_nc_oc=AdruVWW-tzfW7SjomFpOp2eQTSuQXdVUfjMy3A0qYeGku1xS5c4mJ2qD9NtKCHZm7yA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrmxNdY0fH3wRoVzMj4Ijg0qFeqegxyxy6Gm6lLIB_IA&oe=69C3DD76"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peOe6TIfE2AQ7kNvwGaLWzQ&_nc_oc=Adp5__edHHKl-G0Dh96nq4cYck8S5moMgtB6mflG_vFsvmRs5CzdvaHMi1b-Ey2loGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLJ5lmy7dszzyfL_V6IiqCwGXZNJw5OHgHwImfVRqoOA&oe=69C3D371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy3eQ-e7PZ4Q7kNvwFZpv8W&_nc_oc=AdqLrKPiPq2pQ_0x2OYWU4kVHPF7Qq4VTqsYmaSdES2bGcU_Ws5vpJ-3cU7P1qwZD-U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFInt-U4_zyNGocfS1zjlgILVTB4BhzeSGmwi_UHBYQQ&oe=69C3D87C"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
qQFCtYKKsNEYAu5dWhd-VuGWomtipHqLGs-bOQ9Zc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCSGqO3XfTo7-yVea0PmS8Lc3GsPOpsPipMSTUZkAmZQ&oe=69B93ED3"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HDS5MBYNhMQ7kNvwE0S9cQ&_nc_oc=Admq47p0YBGjwO5A-mlzInILd5VQiBKNnxbvXEMEFCOLTwq6WKwN6k4aj290OwG1ekY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzsIbignX1xXitkcy2WbIo_Yu-Do-bp_jweQ6XPOg_-_g&oe=69B93E25"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C5h5KsQvDAQ7kNvwG9hhwr&_nc_oc=Adl5bJAOb24_gA8fBKJfKVo_6tfV__m5kppjnZ-TrDpD9xP9b2xPUboc-URlA0yT64I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIXS-I0gIw8nSckxtRpQ-WbYP76zRZ7aOiYRLSqDZnpA&oe=69B95176"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOFtXZj5khcQ7kNvwHlTD7G&_nc_oc=AdkKw3aZi8IL0YsShvosEvx3Qf__KP_toCyWHZBHgE07CPJC01rFTZLGVB8rM4JoOFo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTRvf6HzAgaKx6vaAzFaUvIhlLuN_NpSYicBua5ofIrQ&oe=69B94771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7LchwVZBvUQ7kNvwEz2HLk&_nc_oc=Adk0trBiKka-7c29Ku9KFcKYRsy2A0dtPks4XOd4ZLlPj6EA5EESyJQrR1panE9we9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRxR0-P1wCvUgfTgHNNxHubeKwOZliebdtjX-fKvWJ7w&oe=69B94C7C"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25989119974068196"}, "review_messages": []}]}, "cover_s
vqHDnCcsNI9zZ58uC5etDsxElAtrHcwK3EDAWYqd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu8vHPsby45vhciLWw8jXV0PO1OT79hhzlr-Gmj1eEVQg&oe=69A96CD3"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q82dpm5Sx2EQ7kNvwHYsy95&_nc_oc=AdnVZFzR_IXQRRUZIo0Wp58Yf7AO-HVSmGkCuAi4UMnCZRRnqXI5zTgV00FYuC9VLdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft1gYq-2IUsOwOiBvY22A0BK2upaQljNI6MyfgzMBuryQ&oe=69A96C25"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTcY929G6pMQ7kNvwFwyP3f&_nc_oc=AdkPxTJFX7I2tzCuzdXsd11HXaJqiSAx2_gALEjMKUN0dffRc5r4GySgxHEN7AaYWVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsqEDI2Dn6xNSWuuvZ7SISWqOgcraxIuAifUlP7KX1D2A&oe=69A97F76"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v26Ia2kcirMQ7kNvwEB2Eqn&_nc_oc=AdlgjvjZ3W7rsJJpPVeppkb-9nb0C8f1qcnTCb_ej56rRgYEhH3rLsLmI-1jzFyNCSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftySsI5qBFLByikxgg8y2-BQ65QStk3Xubcz6O8AmL1QQ&oe=69A97571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOUoorcECBsQ7kNvwG7dcfK&_nc_oc=AdniZiJH7I7du1XBb2ylYakQq3ttL2-me3itH_5nmCrOTXOuVExle6mSsJIzSOYWInE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuIR9kRok4EOczuApj6Rg_2d33rYrEwbIgLHzBkJ2hiBw&oe=69A97A7C"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25989119974068196"}, "review_messages": []}]}, "cover_s
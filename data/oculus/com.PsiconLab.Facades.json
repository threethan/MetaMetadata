nc_oc=AdrHVt9fFZwaslKiSI4W8s5BOCeyY-rCalUHMFPYv8MM_y95mAYPImCj0Q0H8__-GnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0reD9enf5T2hjv15Tx8OolqGJmK7xwq6JxxWiTEhAm9Q&oe=69EDFAD3"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZeIqGvUJ64Q7kNvwGoEQCz&_nc_oc=AdqR-uYXx50u1-fdOiN43MDNQjfy3_OvTUrDlYvYaN8VGiZl96YmFIg5e8B57uC45kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GqScy5a8Vox00ZwQvKlG1-YvekWKbfNX7r7Jj2G82ew&oe=69EDFA25"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa3nua4xI9oQ7kNvwGhfPSP&_nc_oc=AdoXj3mIqA-sAReqJQQBfIuANAq9bOgoUIWaHU9L8DKg76qrxcwPeebwJWzJ-5Ot9_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UjBWZRj1ksVBJ-WoAVZaWF3mk4xCEe0B4FkdL-lvwXw&oe=69EE0D76"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S_1lM1DM9oQ7kNvwHLY3Kb&_nc_oc=AdrStD6_P3YA794TIo95P0ch2wu4vtmIukqjijusSH_HA4gAy46j2RIBDuhic2BquzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bSXyYCdb1P7wQMxlbo5H_PQou2JY8oO58_zgDstUe3g&oe=69EE0371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35UIloo2YvMQ7kNvwEX6g8F&_nc_oc=AdoDo1-iVQmI4JGf-3Vw3KL7DULyusjYq5eSVUI4foVjavth66vKy1VmbHs0JUTHPlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VUOOJGcvIjMCHJOlnTb8U_ezmRL9QaGNBrTB9Tummgw&oe=69EE087C"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
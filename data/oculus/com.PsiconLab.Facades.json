nc_oc=Adp9KZ2pBtUY9sVwgd6DtAH1v8_93p0w64BNTeRpN_OBUZV8w3qQjLRl_2hTxwmrz6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr0AuaJ7d9RcSHMYadZBDSzTpK-ROEKFAPA3oud48OFw&oe=6AB7E893"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ToryCK7ZlgQ7kNvwGPcJ1O&_nc_oc=Adr89KarrAQAsKrmE8Ij_L-DrooxH3CRQCu2b9QlG7-uSdEed05YB7k-2z5kjWKntok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlr46vsHbc8GrUGnMH5VDli4UCD7t_ToCaPx3sdeJGBg&oe=6AB7E7E5"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z26ZJ2ldf8gQ7kNvwGWj8Kk&_nc_oc=AdpRL3p5gAPT_mAsqrdRTDLs0Qy1bdKz9dNGVerTC9bp3w9gBeG7DErOhEShdC26Jow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRqO80dUO9X5YtTnmwCCD1qBKKGNJ6D46SW_Vx1yrqLA&oe=6AB7C2F6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TywhA-uj6oQ7kNvwEoFPra&_nc_oc=AdpXgTTrcKxMGIp5TumqJMwV11hlUpdeozVjnwoRyixTjhvnWOaT0MXVmK6IR-Lq1Yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWp2j7HHa3rxQBpsy6igGvcyvL9ltPN6-FCLExMwAEiw&oe=6AB7B8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH-bB1hAMWQQ7kNvwFLihhy&_nc_oc=Adolhtna5XU1QYZI8ZwHD-N_eCnxgdZjF0RNho15HCY_xYXchegkZz49wzIaBGQcDbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKEZCuEBabf2Mk0EH1vSHG5aRQacyoFQ5tZo4G9wM0kw&oe=6AB7BDFC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
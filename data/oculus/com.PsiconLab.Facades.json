nc_oc=Adph5O9zLCGJiY9cQyVrI95ypmH_WfXN_zzhxYo4gUzl5NYJL3Q57J8h6og1w3NGfNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7ZcSsAD2EcjSd3kTZ-2q65XxHR8OJ1Uctxl3y1ojcjQ&oe=6ACE5213"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdNH2_I4oe4Q7kNvwEFBksm&_nc_oc=AdovOWyUVv8lM8HJKXzga0Y1bU_W4iC7BU21XE-Ybh78IOZm6ieuljWKpR2dEWWrXxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO9vVXecuYm8q6ErKEdezjvGx00NrawD1z2pVjZA4ykg&oe=6ACE5165"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHeqKJr-wD8Q7kNvwFdbO2_&_nc_oc=Adqa9Ou81258Bzn1vw9X7OP-Rv2lzYJum63FpOzHhmClrxvWbfxua0CAl7QJorHLdxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0EbOJFfgdMGF3s8Ry1KdQj46dFyIrpF-p6h3tDU2cHQ&oe=6ACE64B6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEUzzfZxdCEQ7kNvwE_rTG4&_nc_oc=AdqmLdw3QuG1og1_ykxMW9NmUvm0gKv48pZw5G96oTHMcRQcGVjkbOUM1TCgYkLja4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYYxEhRlMC9vVGQoMEiGG5JstU3QdC_AmPVWupFfdDfw&oe=6ACE5AB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPkw8kZlujMQ7kNvwE-b_4E&_nc_oc=AdrqtxA1UqWYxnJ9siaxZG-JrmHOq25N6AyALjYrtihAWu-_YkOOwyz6qCAwmUtXTW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6Xqim2sASSYTt18KIWXlQH0J3BtL9Y-YjQ6GBHLEU2w&oe=6ACE5FBC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
nc_oc=AdrvzHVoAMLHpS_xEtbfyk2SVUMdXIYi3QUZDuLtc0LVzn_qDusNd88WovmH6tYDsQQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iHfsWIqNLEQXdM8DswLeGttuYT6kRwtYcc5IaYiC9vg&oe=69E64A13"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dznQqKoWT14Q7kNvwHEUrm6&_nc_oc=Adq-_DO3ZowwkDMFBl_VyCXJwAjNsRiIUFUQfXECX6LaJFo_7Oxs7Rjj5qLr3Jf-Za0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AL5AzmbvqSgnSWmGlp93nEI3p13YqF993nNePUF59Jg&oe=69E64965"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7PRdh6-LYcQ7kNvwFlsnKY&_nc_oc=AdpE-d_CKuHOZse7ayvKoopWH-tofo50PO-TRTpLc72oIYiuLsA6c8c8cPS3Vthc6hM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aUxIfIr2yLJP4A5Op4k_f-Sshi9jLYGfs0gZCKeBkzg&oe=69E62476"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JL0LTGoTGsQ7kNvwG0fIkW&_nc_oc=AdqUgxjPkydyiR5CY3p1Eg3eHQZ-CxjkM01CKOMRN3dAg25Te-FhZotQmrcQZlzbEMo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PANL6_2_6fhG8y_mBiVwO9JJrKBSUNXgRnnUAf-jTWA&oe=69E61A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S8vnXOd27MQ7kNvwFEejLh&_nc_oc=AdqLBJt5XHnznEJRY-zUsZNvCN7S5GezOsztHTkTC1aBHcBhCD-xcTDpp_XZ-R57oso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sy4UEb0KfNTQlyfnR3K3ck3xcngVZ3SuPdnRMR0NB-w&oe=69E61F7C"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
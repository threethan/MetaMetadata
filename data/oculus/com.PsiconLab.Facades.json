Yg4P1WGSfAjMOvqOcG7re1S-WwcBIngL5ok4Cd3Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvzwLaevGK8r2wh3cGikJLs3ILUtP0l7V-FE3IS0xEIQ&oe=69BE84D3"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXMcHmeIOtYQ7kNvwGMqWyc&_nc_oc=AdmABd0iY7YrW8AKcJ8GDO4AAhMF9CM9BLyXAWzzxp2T0ET6zJdJ1nHOdeTJuqy4ODM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDEgfhrD17H3jf4bnc0F8xbip9NJJOR8--LP9pPXIFYg&oe=69BE8425"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4x5lrLS11MQ7kNvwEATMTe&_nc_oc=AdnyHtt_u-NVZLCzMLeXqrAeWt-1gUrswW8VINcneyaiSIKXKi7N5OxFSUv0NiH5ncU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzPv1lsNwzVcts3jVIgRlejQM23I6g--FMlOoH287_rw&oe=69BE9776"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t9URimycTcQ7kNvwE4ZgS3&_nc_oc=Admin4wY9FdWwq4RC-ROtfh8gmavAXTMkaNTbsajZGJaDphQt3ToiXNEGF3F6yZxpYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmLosjQWMvUF42iuNVdol35Wu73RSOmisK1CMYzl9wPw&oe=69BE8D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59dZ89P86UMQ7kNvwF-U_0h&_nc_oc=AdnEL__s2wyrx3l5D_HZqRcYxUxSwooBP0K7WD8dEAcLlar5-FFNxjoQfoIsgg9VXL4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwrk3-o0afLxNafcui-n2LjRUm_xK3riY2y_4ASRkZPNQ&oe=69BE927C"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25989119974068196"}, "review_messages": []}]}, "cover_s
30291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGVmJghKIlEQ7kNvwGAM6B3&_nc_oc=AdqRmL-28_itAZPz99TD89tGntm84TLIB85Ux5ix80J6f69SNplLUhxj7UKk_5qbcyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Hup0C-5sICyNaSRPaB_C2lRUQWqFxYddJ5bTRwxmTIg&oe=69F201F6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKebl3dFxqwQ7kNvwG5YwJu&_nc_oc=AdpsaEz-5U2S_viMBK1IHhX3jazwaGlhm4GCC8XmP5a7JTMkfdVkqBW9RMMEnjnJC74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05nAJ8Un_VtT_o8Ezv2ffffeRvH_AH3Dkx0vWY_Ye7LQ&oe=69F1F7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcvCLwGbGSgQ7kNvwHYzX31&_nc_oc=Adqm1S49vhl3twca42Bu-N1K5eq_8Dt5CEod9MBL-CwI9f5eG26O7OZxqIQuiMJzxUE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2cRFk8DV-P58tU47ulVU8Q6-8l4ygFSbs3KzwKNdUbPQ&oe=69F1FCFC"}, "display_name": "Facades", "keywords": [], "long_description": "Put on your VR headset and embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the 
nc_oc=AdpXkL8sShfvvVlbgazkVYidcxmyvETN7GzQjJ5l2fR7H_62gAsH8_CTGVsSxww3pXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh1hff9yT8vu_smLJSe8zxHaj4Rvx9ET_jG_FakLbSTA&oe=69C51C53"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MvaidaLgL4Q7kNvwH27q0d&_nc_oc=AdriAbifVMw-eglMeNjYfB4p_1u8k53yrYiQcWATl7tuQiB5gwspYUWDcNOeCB0y3g8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHoeVaNh9qVpBRfeVJ6vI4e3kooScFB4lzm8Ihasv8Gw&oe=69C51BA5"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sltQ0XkGaikQ7kNvwHZWiEf&_nc_oc=Ado_x6bOnHFDb3pykvc-e5JTuM57iMu-X58zTUDBC3FjEm8YE9AMR5vTORK0LwUN17I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbPOlzT_krxcUUf998KxomYinrxZ6C8s723IQoZcHfyA&oe=69C52EF6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peOe6TIfE2AQ7kNvwEyBXa4&_nc_oc=AdoYPQ3BbANnVXF6bfgEim19vvqokScUPjcPAuoBrkL-6K9Ak3tLcW3x-_fcCGrlCHs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1iEs8gSD_DcbCGx7ubQ4vIYuTfrAX0e2neoOQ7EKnfw&oe=69C524F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy3eQ-e7PZ4Q7kNvwFGC7wA&_nc_oc=Adrsy7kOafwuLGwoU55nvsODVWTG9lZSqY6qKcAbXfNUZBGaDPLQM00ZeOL7Vw0gdbw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHASo_rXVXUygnpko-NwNppEFbjyqJEQjmi6j6K7ijfw&oe=69C529FC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
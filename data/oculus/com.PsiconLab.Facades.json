nc_oc=AdqE0QuBdzD4O-f1uWy97zJy0AteUO7DKgxIPlnLDs2c8nHVPMLqxpWpj9f5pXIV3Hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXDCHhR1I3svK0iQ0Ub3Id-hxWoZ659ttVyR7M82WRtQ&oe=6AAFFF93"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puEPD0j6a3MQ7kNvwExQhce&_nc_oc=AdrJ7L8PkKEX4qE9Aw5F28fQ3lNy5cKilIod8EZIMDYnzU4qRCTDgJ6mVY-yeU5q-us&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiACvZqh0mNVPFqvOKdW14DfxU5tukh441-08oUz3lyA&oe=6AAFFEE5"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WdAnZ4ZySsQ7kNvwFg4A1V&_nc_oc=Adq9VH3RBHNcBdcoiLzGPEe-DEyaiNSB5eRj_8gROsUjvuOzJ6Hiv5cUJE8lta1-l6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLswXLrrqHXiajSSCccDsPddpzT-3-wjrnuKgoLJZ6u1Q&oe=6AAFD9F6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1n8TujMx_4Q7kNvwFRsdou&_nc_oc=AdqTXyxdFHue-wtIzmlNZ-2uN39hqOxc2LchVEvFuEMFvEwYWHBFjUaULlMWngailao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLZA_MalQiceyd5fq5eyJOMnVU4NK17xsPPioIVso-Ag&oe=6AAFCFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmSdvwcskIkQ7kNvwGbbD9X&_nc_oc=AdpRt7m-9wSb6IEbkdqzxS1plsqZw3fPZKroSlfXhK6aZUCG74MJ0V_jrVS1G14VCnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv0B7FRq5XTqC4-T_TYKrGoHZ2Wfp9W1OoPjnvTZtAuA&oe=6AAFD4FC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259
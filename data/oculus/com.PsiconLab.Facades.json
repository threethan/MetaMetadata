rgh8opOffle7ukOt3Jxu_ywPQGkd0f5lXvDwaBDjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_M8qU2-ZpcF2DJgj5HD_Sl-YqPP6gT935KVpr5qWe_Q&oe=69B54A53"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec3X74CSleQQ7kNvwHv9RtZ&_nc_oc=Adm7D0jHmeT_SYbi3PYIeARW9IVTZyffr0Z4BlDCX4WynyYgPjOPfnoDz-SUzkuGQwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9SUMEwKUsHMOxIy-Tfv0Qq9ReuOyq0aULCp6yWa1gCQ&oe=69B549A5"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9e-p68Wu_QQ7kNvwEsI8Z2&_nc_oc=AdmebUsRabcQAYZpqtCkuwZbVSPjWiOWcW-F109IteZgxH3_Ft-slypK9t5Jl160wMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPfOmx_B5xZgnQNIeMCyK0GzDaE1ljnouPBFlWuWCWRg&oe=69B55CF6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZs4YNdCczsQ7kNvwGffgT3&_nc_oc=AdnYUcO1kJAV9X01y8BhKCOmQ5WuZx24YLhTAAdXiH9SH4NAVu8HCSxpg9kyoEksiiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxdvu92U1GDP0fscspJYpMSZauNnfSRn7PI9_TjTkFPCA&oe=69B552F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6MbW7ERH_IQ7kNvwHZvbzU&_nc_oc=AdkWXqVOm73ra3-jIYLVq8Hg2jT7ZlS1XQwpUi0Gx6xPh9Man7QcL-Jpk2I8Nrv97fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwrgxWBaz9ahcskhh67SQOhCO_FmMO5CWzCywk5vPWGQ&oe=69B557FC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25989119974068196"}, "review_messages": []}]}, "cover_s
YJDYFoGc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1tBzEFU_0C9ic7g-0BwkpThpHFsg3zvzmcbDSjlNhY5Q&oe=69F1EF53"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bV_EnugdOgQ7kNvwFrlmRI&_nc_oc=Ado3aA5qO4zdxrgRQPCcSlbVLRnaPasqC2-32B93kYMx6zUI8hmiyIBoa8_BM-hEAuk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1lKjR9mlx7W0zCEA6w4upxd_1uJWBLPuuQS2bLsHWhHg&oe=69F1EEA5"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGVmJghKIlEQ7kNvwGAM6B3&_nc_oc=AdqRmL-28_itAZPz99TD89tGntm84TLIB85Ux5ix80J6f69SNplLUhxj7UKk_5qbcyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Hup0C-5sICyNaSRPaB_C2lRUQWqFxYddJ5bTRwxmTIg&oe=69F201F6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKebl3dFxqwQ7kNvwG5YwJu&_nc_oc=AdpsaEz-5U2S_viMBK1IHhX3jazwaGlhm4GCC8XmP5a7JTMkfdVkqBW9RMMEnjnJC74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05nAJ8Un_VtT_o8Ezv2ffffeRvH_AH3Dkx0vWY_Ye7LQ&oe=69F1F7F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcvCLwGbGSgQ7kNvwHYzX31&_nc_oc=Adqm1S49vhl3twca42Bu-N1K5eq_8Dt5CEod9MBL-CwI9f5eG26O7OZxqIQuiMJzxUE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2cRFk8DV-P58tU47ulVU8Q6-8l4ygFSbs3KzwKNdUbPQ&oe=69F1FCFC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25989119974068196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t6
y1uYq92d7mDIobqzICt_tLu6dXeiivtmtHmmqD7XOqw&oe=69C66D25"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sltQ0XkGaikQ7kNvwEwhbbX&_nc_oc=AdrVo9ty_C5Y-uZ_zG_IT0Wnr7PyYkgL5H-RHt3-DlTx-c8aw1B2qT48qc13H9vqMhM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUPCz8MLw4Ivpdozt89Orasbi7uhXw3Pyfq5jDGDWluQ&oe=69C68076"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peOe6TIfE2AQ7kNvwHLgfZi&_nc_oc=Adr669pSy5bKrOmmU4bmYjqIlkXLGfo4n-D48OxJVyCx9PvL7v3pU6ttkX_KYiJ-y1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQikVM4HxncmW81RhNDZeqU1VReeTknQHaUyBM2uUQEQ&oe=69C67671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5F_CdVh_RsQ7kNvwFjeg_Z&_nc_oc=Ado6du0tTZ2aD27jJfCntQERvzH_iXrxUgLSOdwgvTfEWDIIByd0Ebd5TQEngrrXYfE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2eqSR8e2xkKHJ-W5Mexe-qcn-O91WuetksJEfCKVQjQ&oe=69C67B7C"}, "display_name": "Facades", "keywords": [], "long_description": "Put on your VR headset and embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": null, "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.psiconlab.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "557741413008585"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "937523944254337"}]}, "baseline_offer": {"id": "937523944254337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681943760, "status": "PUBLISHED", "id": "937523944254337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24011151018531778", "version": "0.1"}, "id": "979670249666573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__ty
, "id": "1019329239047290", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982460_1019329242380623_5958976957878575768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhuyyfye4WAQ7kNvwGq0KgV&_nc_oc=AdrT26wqdPAgF0k7MrTmS-RqPP7y9X7TpBjn2zrzLRg386-tAM23lMxnUaftXPte7TY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmsLvJrdKIRspYEkCqspQhBCJX83xppu6N0hS2RGndHA&oe=6AFB2513"}, {"file_name": "AppLabFacadesScreenshot_160.png", "id": "979857080064018", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982613_979857083397351_7399400865433566977_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ROWvCMFCbQQ7kNvwGhzvsf&_nc_oc=AdrtwCIRCXgI020PDNotikazWwYGzFuYBIyrQ1z7qy_7JjX9L2Uh-7vPM96hnGxnguo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy0kdBgnrXLTS1hxdShjZy7Rn1GPDtENsa4zxAHxs8_Q&oe=6AFB2465"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bir3dSH5FXIQ7kNvwEKJY30&_nc_oc=Ado41L1oeU-RUz6IKJpqIiiet2SE9iDErtaQNfkK7CZ8BolF_rFcrsaQmrnhXyYE7Bk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQki092J_sBlN_WXLioodVUM6eEMTP5QjdwnFWTXUelbQ&oe=6AFB37B6"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYrt8rxbRVwQ7kNvwGHFNbl&_nc_oc=Adp2fu-OileXVIRCBSSKE0Kzq7tVFsrgbl8bpY39bL7A4kh2QdwkpG9RTBaInqqauCc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE9-7O5XuSK0fNPV6deF-cpnlQxaRsEieINmYfQW8RpA&oe=6AFB2DB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHnCOHcIgGUQ7kNvwEpqyEM&_nc_oc=AdqqBF66N5D1y5ApC5jySdhl3fkVWzTQZjygshHT-w3Sb5fuWHQ1fmkRwiNbZyQ2HTY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQZ6Q8SJrun6Wy_s5ADehh8VJq1azaIbKJWSd0lA0XtA&oe=6AFB32BC"}, "display_name": "Facades", "keywords": [], "long_description": "Embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale, dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": "Studio Displace", "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.displace.org.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
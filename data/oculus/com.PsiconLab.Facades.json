cdn.com&_nc_ss=7f20f&oh=00_AQEvQtoLV2w0gMSPvsu8rLF8lXv3upmeUNGuyCVoY8iWVw&oe=6A8ED125"}, {"file_name": "AppLabFacadesScreenshot_205.png", "id": "1288830288652909", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974585_1288830291986242_563469852083736719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98OvpPzCkvAQ7kNvwETa3Cr&_nc_oc=AdrPlHGhjw0y7yAdXcsOjbq1QZkVU3OlEsEvtMqLo0mg2RCIT5NhzGTFNjGlPjzigfY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELXR7pYdpx_L6TwsM_gchSkdndMYtiqSRx_jCIcKUubA&oe=6A8EE476"}, {"file_name": "AppLabFacadesScreenshot_217.png", "id": "174590965496366", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974835_174590968829699_6713083573689280771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCxRGr9KHR8Q7kNvwFZuFa-&_nc_oc=AdqHDovnDKXDiQwGl7hdmHVWJHB30OgayYCnMFItmfOF0YxO057WvuA_vtPkPQTqb0o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdVTXene37VoGOZRGcX0J6O3w8_GzVVg165P1ZV_zE4w&oe=6A8EDA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLabFacadesTrailerCoverImage.png", "id": "607798381272697", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974452_607798384606030_8598782288650203419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_CZfdZ3X4IQ7kNvwGZrxTv&_nc_oc=Adp2OLjDY6L1AzXcOrDwm05WERnkaLmlcP4I32cUEWg7I5QMMlTKAiCcitRwInaCtAw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZbMu3_EcjSSwYZW1-tISNuND25nDVJLE1c5og64_Qlw&oe=6A8EDF7C"}, "display_name": "Facades", "keywords": [], "long_description": "Put on your VR headset and embark on a unique choreographic journey, walking the line between reality and illusion\u2026\n\nFacades is a room-scale dance-theatre virtual reality (VR) experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal.\n\nInspired by iconic film scenes including Rear Window, The Wizard of Oz, and The Mirror, Facades uses the architectural features of mirrors, windows and doors as metaphors for duality, reflection and portals. \n\nThis surreal \u2018VR noir\u2019 presents hauntingly beautiful choreography from unique perspectives to expose themes of vulnerability, trust, disembodiment and isolation, inviting the viewer to step into the frame, move beyond the veneer and take a closer look...", "short_description": "Facades is a room-scale dance-theatre virtual reality experience by Displace Studio, created by Digital Dance Artist Kerryn Wise and Creative Technologist Ben Neal."}]}, "developer_name": null, "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.psiconlab.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "557741413008585"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "937523944254337"}]}, "baseline_offer": {"id": "937523944254337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681943760, "status": "PUBLISHED", "id": "937523944254337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24011151018531778", "version": "0.1"}, "id": "979670249666573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
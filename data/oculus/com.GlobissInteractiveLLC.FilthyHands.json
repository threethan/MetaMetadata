AAFLUmw0HW_4pcFc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUxzcrlazI7QMuh4fwKsrUGImjPhPInuWrmspRCZ9WGQ&oe=6AE35F86"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkqSL8x40VkQ7kNvwEaqjWR&_nc_oc=AdoZdmf36ZbvX7wdynqv7tEbJmLbKj0wf8yHZ_nDzNh48h-7D3JcimKm2nA74-tGh10&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP0L1JeflQr_HcJVu0ld-jJkF7zSv7_ajZaZgNPLa8yQ&oe=6AE35734"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7aJ4EoP3b0Q7kNvwHKBQ6M&_nc_oc=Adp4RflrD2bawtONgF-umG9Yq3-4jt0PAF8rZwpdYQBa4npr9p-6FhzSWUU-pl0vxSg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZyPRmx6h_Kr9n9WzmFoqU-LipMFhPp-lGqM4OQG8qrQ&oe=6AE354BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMCqkT5C9xEQ7kNvwEGVYFm&_nc_oc=Adpez3jIV9uLBvjNeDhNVtsnZ76XiG6rgAoxHMiJtVE0N551wmi9Wpia9MgxLkL21_M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP-1nIzewIhpINmtQO8MyRJTdYCwFk5sUE8hGgzrqJYg&oe=6AE3566F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2_5jOx2ypIQ7kNvwGO1fXY&_nc_oc=Ado1doN93cJwURmCsqWgPfuzgng_49YHO195fPMA0mecJVe_TdCguxy2F-OODbo26c0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDKnJ4V8sEHHF18aHr6dykI5TxyEDasLH-fQbzPxfIOg&oe=6AE34259"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
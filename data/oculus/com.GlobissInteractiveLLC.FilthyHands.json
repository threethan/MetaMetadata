n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcjSiqNijV8Q7kNvwEB9jS9&_nc_oc=AdnRnYGyprER-sP_N-JV4bO-7u5SiF_pu_FRnGVIT9XpbFF4MSpFWkF4uPmZweq7cOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAP3ndotXFhHUzF-XoV3MvV8kOdfnEg0m7DEmj-Spz5w&oe=69AD56C6"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya1jCQB2RW0Q7kNvwHzOZd7&_nc_oc=AdmdP4DSQaDng_QbEPBXE2TrgAEjg_sABVtSjMKIjnvip2kb0Ss2Wm64wPApF-CDT0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyVnIcamZZmiD7H7bEWL2Nu-uptPItEBA_7VSsx74woQ&oe=69AD86B4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTbKJCcefuEQ7kNvwG6_pJ-&_nc_oc=AdnIbDNeFzpRKQI_rkYfWbQj5bQM2o83-sUnlbTwj6ZWshByhTNqaqAVBr18qOsacMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPDrunPX96VpOcIk0uAjjyt92UMzILxq1zPQNZt3LbVA&oe=69AD843F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A2JOmVnl08Q7kNvwHimRYt&_nc_oc=Adl1o4BoV3jlhFUglr8tFZKAy84GNi7QivD1k-cwApOhFaW_0PwA19h2FFovM4glRBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYm7_t0qtcVJGzHSsuLtzABqG5GmW4f3yBObMRr03yxQ&oe=69AD85EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXTLS7_Re5AQ7kNvwGmAI1Z&_nc_oc=Adl3V-_3bvKhEdiMnpJp2XWkljV9Ab35SrVllnDPm2MeyjZ0tGTORp9zykRNZlpmRIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykGmMcFcu7e5INEcA7XtvdIPGQeH6No0bPSezdEsTVCA&oe=69AD71D9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
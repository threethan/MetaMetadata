n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XizOftIbDwQ7kNvwFTwKko&_nc_oc=AdmiDg54khawHSTe4aNxg76GNQOFG7IqE6KSqGuKdXiPEA8rsZFA2WeTAkjiPhg0F5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbqwMZwQGzJNyqLg2N6pPUCQbEXXvEiNjuh8uuU09QTg&oe=69BE7A46"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IfclMxNNiIQ7kNvwFjptjT&_nc_oc=AdlVC968bqPOLACziAxqA2HD5vVQXj6kr1VfOv4D8JN9xrJH8WK3KzIS4wUrrJ9tmjE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRidPcs10eZ7SXeyEkZQYBEBkisJ_ds3oL2XGRKMQW_Q&oe=69BEAA34"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9I0CJLAAq8Q7kNvwEmwhXB&_nc_oc=AdljELd49AC_1yhCiHmfQTGCYCiDvEq1JILiU8Fo3xcUbAap8MLhmkYmqEaSasG0PH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-iQnW_sFQ7CrCLw2CyLR6ktcZwTF17o7sbhYT3K3hdA&oe=69BEA7BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mpFm_UUio8Q7kNvwGiFz9n&_nc_oc=AdlEySz5HCUkKUSnwfwkE67pWI8NGQaXmpUCnoX8ANMUW_pxu-C6K-ZcRIrdiTxO004&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8H9c2O3S-e8G4hgBq_6F0r2EXm5cWoEy-rDDvbEL4qA&oe=69BEA96F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFBc1nvyWjYQ7kNvwF1CInz&_nc_oc=AdmpIQ4adtYvQ-haAA77FdK-h21fCMP6q_3egcgUc-8iNhwz732kMpc7UU7GtnToBDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyA92dIQZMmxDlKlJWRH3287QDJMNQaFJ62bBTGekgwHw&oe=69BE9559"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
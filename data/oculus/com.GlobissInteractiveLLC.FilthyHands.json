n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJctREWr5HQQ7kNvwFy51uK&_nc_oc=Adk2dvWcPlnDogfrHVgnHdJ22m1eadQazeJ5BXFwSS5d2kY5Y4760q8yCAwhQWlfg9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7c95Se0zrGgpNt_BDn4FSDz90a4tOPmRQdxrBzWcUIA&oe=69BC0F86"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldR4W7oTUoYQ7kNvwGRsGDa&_nc_oc=AdkdOjyEad80MFgK2esufqu1N_KWDQZkzVPXQxLtj9FU6ft6zb8WxUL1MUTE_jeL-Fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzravKpTFR2MP2EMVnXWqBKweldRWdBb4HYS6kxJkLq8A&oe=69BC0734"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9I0CJLAAq8Q7kNvwGP_Ekj&_nc_oc=Adk_jObrgx5vUKxZ84FHKEcYZtGGyUO53sj0pvcySiG7QbvKWWcbwRdtkHjPQt3RjL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLVrcbW49dQbfuLZOcpePO5WXjJq_jPrBMpAOOpPW5-A&oe=69BC04BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mpFm_UUio8Q7kNvwFZceFM&_nc_oc=Admfc3u1hMPBHjoCinnpxj9PX8hKnNo_SVbIYiJo9l0Q42jsGbLMRfaj9USon-PnChE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzw7aKK8X2YZPfL11Rl-QY9nO9ihjmBsO0LsjXtlyMqHQ&oe=69BC066F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GaBNawf9KAQ7kNvwH4WhHB&_nc_oc=AdlURLN_aabFug0uQfjG3Ln-2hSFiFFsvhdA2AaaIUKmW96MeHqeM0oZWEHOFcRYsxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKclGAncouqno1iuqxEBDDP1KV1C39jP3aKjar6XNRZw&oe=69BBF259"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
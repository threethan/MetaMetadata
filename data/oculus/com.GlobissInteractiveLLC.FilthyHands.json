n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-VJk8QQebIQ7kNvwG-I_bl&_nc_oc=AdnfYijs8plF1IGpbIbBEp-a9GNrLqXD04r9eV0tFd3vzyf79KrFMT2ZWzOvukdIpAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0ban0-QGh3Ln0z-pOswJs43Hx2qLLM2YtjAMpDVEjlg&oe=69B53FC6"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P7EuXjYF_EQ7kNvwEedL93&_nc_oc=Adm9Hu7mTW7c6mdTO5mBBmZcdoZBb81eQ5Lea5Q--YuZy2DTXXXRkgW4rQ-eb8FOvw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNiHCSuprsS0O5vVSsEMjiJpF0kaMsabMAMwAzyybVxA&oe=69B56FB4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tWjdQ-RBugQ7kNvwEYgcOV&_nc_oc=Adlpu3P-Hh11qjCt1gGz03fmF0R2y0M4TDORkLPpmKQ78jzjvQ5FClbqBRHSCTnFnSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBZDoOmIi6ZUD9cjI4F3nIcadIczqwBWybxhfjEFa9FA&oe=69B56D3F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=319Fli-iyJ4Q7kNvwE7irEr&_nc_oc=AdlYw4g80eaa6EpzwJ6QfX_VnxPGlTOijomwR9kX_YmfROdNJU7vJgi1NoEPU4Rb0Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFu43JZrLdU6e1Y_SeUp4K5z6mF9mZLyJEx3UButVUyA&oe=69B56EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDvtglj13IkQ7kNvwE9j0d5&_nc_oc=AdmTAcXy0C5io1YrrsHULRND0HvWtb-w8vI7DZuRGg4pJ3lD0vmvLDb059Lajixpn94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjKE0wMEFjsq8germEQy3yE2LIsoqvVwj1fJKVlVsAJg&oe=69B55AD9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
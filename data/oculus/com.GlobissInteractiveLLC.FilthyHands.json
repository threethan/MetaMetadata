vPu1MMF1cjTm3dBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgLgj1UkSCr21lHdIlXc8V6UvXBHG8Mchj-f2Dg5P-fA&oe=6A74A186"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHUmybFFk6sQ7kNvwE0dGrF&_nc_oc=AdoM6uXdrULuPwHmkVX__L9oGxgumCrWJd_6TXPrll9LTG6E0esvea1AkaZkbifpWJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV0WLWR6ow5hY5LTg7QTO1ZlAp1JxWtOxHiEgQxn37ig&oe=6A749934"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7cXajXJjXIQ7kNvwEk4TUt&_nc_oc=Adp47xVPoSOH40CSxmgZYarbav1Pqhk-igSG5IH2p6eDtzfj2-hWPRZ7ogNvLCGgzLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX_Fx8dmt9SJje3kMJpLzooRn98-BzeOFYj5v8B0_Ojw&oe=6A7496BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY4ijsvdzuQQ7kNvwEnt6RA&_nc_oc=AdqNwJ74AiFKYFzFUUIvcy66Weuqg2ni5G1W-yKELq3PMehxUvBVlgebgPGLWRz2dc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7zkbSy0peLJUrbxYwrMSCIqM_8A3HV8STlMov6uzTfg&oe=6A74986F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfAE_CkzA2cQ7kNvwG5e4_y&_nc_oc=Adrcl6y66Y2ObadTT_lzBiL6nouu7qiE6BIAsq9abmyJb4_rbTv6mGd79jgQnYhyrF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUVds_KA6iIRk8HmgwFmpXTCf55WhOIbEv3gRCiMeE4g&oe=6A748459"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
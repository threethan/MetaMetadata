7RjcdVp5zlEEmfRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwqqy6S9dJjnFRad9n4sxrjLNQX5MA7CHT-Vk5rdBQrw&oe=6AA2C606"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBu1IP6LRuIQ7kNvwHQbSB7&_nc_oc=AdpUx-oDLM9Dtk7NYHJ7caWQE5AoRI3Qa2EGMIW35DuzQSYGUCykm2CAdyw7lFByhHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnVP_R-91q8KaUK_BPPRMlsLHcd9aZSRgOqxYz3HI2sA&oe=6AA2BDB4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEF6b6oztfUQ7kNvwGGRK_1&_nc_oc=AdroGOlb7NZ6az0brkEsVjCFRAaA7dDl8rGvfUmq3uPhdf0Hp1yPOxjp_n9kkKPrzes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJps_oZJozjQ_vWMA_X-7QlN5GsH3I_djCorSVb8rK0Ow&oe=6AA2BB3F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQB2i8bBmwsQ7kNvwEpaJ2j&_nc_oc=AdpmafKjn65IuA0TckE2eUsCKcoj7gVAWBFXYZvQQB_ZGQNCHWFd-PABRoQi-OzdycM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6RjmdFC80xeru6Vv8x639cfoM3dvhPafXHTtbdBLIIQ&oe=6AA2BCEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuymZJ81wDEQ7kNvwHh8DdD&_nc_oc=AdoVuzCxYMXiBmrlZW_kHz8huELEXFLSbAlKca0fcsF1m36BIDA73Iy8g9rzfI0CrL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh7EfZUQVtY8mUD0_SMuE2sfyQH949dDfbM2wz9zdcUg&oe=6AA2A8D9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
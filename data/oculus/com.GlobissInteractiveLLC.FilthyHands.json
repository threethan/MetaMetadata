https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH3IimthZV0Q7kNvwEV7wYS&_nc_oc=AdpDHt80ZGuGLp53aBP15wQgjgT8Eqlg_MK-_0wubm7kbIljOr0WPzfYkqu-ulErEsE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV9ZNimAR-CVZ0RSFF8afyDpYqMMkr_Mo7ALVv3egQcA&oe=69C7B4C6"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sezkW2qhjuQQ7kNvwEhHpc3&_nc_oc=AdpmjmORvT_NsoC7_iqcUkGIjxdRhyC-rwprzEThLXwDQUtKcboxcrKbyHpgbEdF32g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjzJ_bCuRtiK6EE35iiw36kT8mZJrVSug-mdcgdPD8Ow&oe=69C7E4B4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_x8-FQWOd4Q7kNvwF-g1Rn&_nc_oc=AdozvQpe9uGJTAh9sZuyxqeepxDrap0s_Xm7AC1ogcDZKyCqTb0RcOLG_kPdLncIuqw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOn3OkfGnbImJ-KasN0F1M4adHmWHfcZcFrIFeIiB_vQ&oe=69C7E23F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BklRZOPGovYQ7kNvwHPD7xO&_nc_oc=AdqU6v5d0ql-jAtgU-pp3mzcoYE2-oNKbWEUcZDegN5--7qwd8LCmyhRLs59oXVFDx4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-P_PTH3Bn1mptWHLkKa8BEb-f17LLUvepX6Yib1s5IQ&oe=69C7E3EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8x0BPLtnp4Q7kNvwF3rUiE&_nc_oc=AdrGo1njaR2R_A3sGxfIPvHW8NDocyCqVeabrg5rKOwLemQ4byIzJv3CTTVOeLJ8FC8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK76rF5jpDaTNtvsdxPdeOm_NbFaY6cO_RYs1CKkNIfg&oe=69C7CFD9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
_R0po0jAx1i-_tks&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fa6xuE1fcCSsJZfCga1GUhvxEKyd33imrQqYhj-qL8w&oe=6A243606"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXJPb6C8NGcQ7kNvwFAIgmv&_nc_oc=AdoKExH4vUVhLNSR2qrHjwthhVBwiEr7r4GJC5_XAAQkFfja0n5Ymcbv92iqtwWZdQk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y3T8lC7lJ_bMDFMBKYH_nk-7g7hk1P7mtDT2FA3sh-Q&oe=6A242DB4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WytHrGpM-0kQ7kNvwGVT3kU&_nc_oc=AdpWg1KSePUWpvmOYNWC2blsAOaLM0qYd9GgOW9u56F1A3_kUMvDDeEctTP53kBlvKQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gL7GlammOzAoLQRAp2rpBCnNjavMcsTyxNKNwW7YG_g&oe=6A242B3F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHxX0Mro4ZEQ7kNvwHcEuyj&_nc_oc=AdpuD4vC38_ItK-TzGr30rBCLWKBf1ASUsy06-eedRy_OzOZhNuiZBI9BuCWlLXhfIQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80TOhvxF2ehzaMP5CNZUZEpzvSqvtwoPiZVRsyjbzrsg&oe=6A242CEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYy6EisZbJYQ7kNvwGYADCl&_nc_oc=Ado1x5q4XrmbIlMnolm4x8jle9D-kJMBMGEtUH8bQPMqTMhZl83kv7SsKCaQ3Ckn9LE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LtQcVA-V0W5hfZ0VvRe_LypQhQlaLS-961h0oIhjTAw&oe=6A2418D9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJctREWr5HQQ7kNvwGiLW__&_nc_oc=Adlq0oOt39dVHpG6mzKXmOFungqBlIXiOH6WhsAjr58zDYBSxcm800aHY_erwo-qYHI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPPwdpWqYtT7EaxWiUFGdden4EA8_Aw5XWGEr9g1jlWQ&oe=69BA85C6"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldR4W7oTUoYQ7kNvwE3aXEG&_nc_oc=Admjv7IcM7HMZu3svcMuwfMgjFl-9u-k13V8EvHv_F6knMP-SQgCZ5tD8grPRulF3V0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6Fgeo14vPAAQSfWvjDclRZqXeqgp9_GsWIv_N12xXUQ&oe=69BAB5B4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS0RXyviED4Q7kNvwHJP-mS&_nc_oc=Adl0fG6Z6IstKeC9mZrYqNtMv8U1j7L3XPB-6w9NuQu4VKZpfvX97TYbMx15_maUVAk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwt1hEeeNK0KmkqffsFkHOMnpnToOn7UDNQg9PnqOauQQ&oe=69BAB33F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fre74uyxOxgQ7kNvwGglRr2&_nc_oc=AdnRxRhL5AG8ZjLi4efMcpIWyhKciyTnftFXM14J9PYCjqTaQ1_o4NzDhd_QkX-pVvY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6dtruIrJBAeM4WaHxDtsha7v6DGtr6dHib1SS-f_54w&oe=69BAB4EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GaBNawf9KAQ7kNvwFvSWPF&_nc_oc=AdkNT0ddF67LmjO6GYfbJ1Tk8dj-5p7QK-_4E-XZZYyoh-cHeU0UU5-Fp0bD5VYWtkw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiRPQ5AhFZzbFcp6aVgTczb-n8_QekrlHEXFiABje94g&oe=69BAA0D9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
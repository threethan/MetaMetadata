_Des0ZTZahd9e9vY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjABWHbmRbrKfi7Z3zBBkzk2d7qD5phLJ4A71yCdGLGw&oe=6A7EF546"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGA7hOYaAFIQ7kNvwGBLEy-&_nc_oc=Adoz2WUJHIo36x6IEGOg6R5fimmc3e3JeS68GpyQH5dMRnEJ0S8i_tWqcr95EzxPvJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCVxCoB48_0qTzZXVTl_z3ZikTVMOTcmRUMIwznV3_Yg&oe=6A7EECF4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86fY5qNs4sQ7kNvwF79wl_&_nc_oc=AdpFhMMnrHDHsiMhJy8CkSjFu3Z27KOnDWKL_YZ8LlF3-MvuAq2KtSTfEvT3MGZOL5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE79U7alGNgGXcqclwBmEnIqTNlG1RHj2a3MqNYkUH7eQ&oe=6A7F22BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybDCxL_Rlc4Q7kNvwEdd8M3&_nc_oc=AdqDDIXdIO9GqLWdIsX2395rtIKPrc8NtRwXmDZ4K1-muGgyn2EvBJpisl0wDF46Llg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnHhXgTYkD6-FAzmWGSW4Nm5AYimg6kCIj2HnmgjCtoA&oe=6A7F246F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F92rXefRJIQ7kNvwEg2UlO&_nc_oc=AdrI0Tdi8gDMjh4o96HxuGPy10fNrP18goyFOOQ0082mSC3Miy1tvDLsPOuV82FM7zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlFM4AuQp8TYl6Fm-CGpyFqWJjFQPuKrfdaZYXuyIY-g&oe=6A7F1059"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
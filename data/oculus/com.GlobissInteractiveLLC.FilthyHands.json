53nqfm-2MlcyXHOU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jH5V5QhO07KXGVfqkB9edPWvDnpNuUR-17WaYjm1w8w&oe=6A09D806"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSj40x9504gQ7kNvwHOBMQ2&_nc_oc=AdqC2t5ajQRqGN3qcf2Gx_ti92se6mu8ASM_3jUl-UJ4W1weQ9TKuZCZc5UqIADI5yk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uw9qScu968U-XqHGO4_oJjK2HrBUk9acS0eTjdCU7gA&oe=6A09CFB4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvT1AXLdU4AQ7kNvwEwGdo5&_nc_oc=AdqMHm6hXV1XlMQCCb67teCXohx0BZ-ibVkq-45FgZbm9CBQg7V2OGWl6XzX3Vmm7QM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w-kWUBWZqp743eFFx2fvviIzgVOUINe-3YjwhR0n8wQ&oe=6A09CD3F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHAg3Xj5SWwQ7kNvwFkkGR4&_nc_oc=Adp5rnAlJJaahpIyl8ygRu_rANT5lgSuVn1XBkGOI8jzILIw2V9_egcT4XyGjOX1bHI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZyHPpBvV1YiC1Vw72KwmaNInm_MPWjIb3vk7exgnxtg&oe=6A09CEEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZuXhvNBzjUQ7kNvwG0Meek&_nc_oc=AdoiSCbUXIo8SSAzuFQWwa4Dz4EMmJDD1CWbY7lNPH_fvw7v60Yr8X0oh2jSQ4QFqAM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gxgc4_ccvGJtGv30ZcliV5sMHPVEp4awUzvthzvBoog&oe=6A09BAD9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
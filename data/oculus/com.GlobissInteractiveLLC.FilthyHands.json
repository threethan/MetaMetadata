https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SH3IimthZV0Q7kNvwGUMXpa&_nc_oc=Adr528vVaDhdohQytcRG4yrzmNgBeOv_AX2nsUhwcxElGpYIO4i4IFeqd6p6Yw8DqBY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhZD50fxcjrS685AhrTfJ0XP0JSstSD1m8g9C5UjwZaQ&oe=69C66346"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sezkW2qhjuQQ7kNvwFNlNG-&_nc_oc=AdoFyG1SeiI16embTeOL9n07gYbusCuaTNubcH4QzTts3bHe7y7qynZuLUMXIt_1V-M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHj6YWNqo5WaiObhQFRAORx6_rIT1aq5uzN-yAadYJDw&oe=69C69334"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaNsIv0N5V4Q7kNvwF2ViWa&_nc_oc=Adqk1hIu-shN7lC34WoAAFwejrrW2aCTivVfJTWJ10HpxwApL20osbr_5CEQszjkjU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH6Kyy4TuV9bOI2jve9L6u-3LaXR040eIzFd9xWcFSxw&oe=69C690BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXdTmCoTwqgQ7kNvwEK-Z0v&_nc_oc=AdpOh12K7bwi2kpU4BCyxOi7TuYGEIdiExY8HJxW1Vl-18cWiqkym9c9CkF6KHMBZIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5LGUWXibtvCFXKdf0j7iSWlkLtkSic0n8M0JHUYf03g&oe=69C6926F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8x0BPLtnp4Q7kNvwHl4tyz&_nc_oc=AdrnYdc8oxmg3wIfLWJD3eHaKSntreXZw9wMDCKXe0npTNP3qCVn3XNDsSRkRRKyzvs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7RjNOQcF-5xOz91USmFZ049gsYDOgw82RuLoq-3bB3A&oe=69C67E59"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
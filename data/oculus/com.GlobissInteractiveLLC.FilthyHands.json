creen2.png", "id": "3338092952991832", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZhIAaIjWQ4Q7kNvwHPh6dN&_nc_oc=AdrGj4Phvcqt_kPZlWgYVZ6Yo-kl8iPCSMV_NZwDKQ94Q_gA1YRGIJFUP2NFSNTOLOI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af33oZMnVuNJDP-nXW5K2xfaYXyDpZOqkkQEq07YmXCWMQ&oe=69F1E4C6"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSNlHBK4L-gQ7kNvwEhORR9&_nc_oc=Adppusy5_vRoyznb5v8B5StLSP9zl27s1uo2V6H2BD_Z9zzOTeUPBRQNbFHDkJYfJCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ekYWLVdvTpiGdO5qu8efHQdKfUXJuKLXsFybVlvDhhw&oe=69F214B4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKCzaT4ZRKoQ7kNvwGLP8VU&_nc_oc=AdoaQAWDTQPLXLAcjTGmKzWsIa4yM4IKFPgbs35-qGY-bk5XumnhHdnnjYWDNz_1vXg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2SPWYY-USh-0I_9LufwX_5PmRy8giWLuc35iE-FoiOtQ&oe=69F2123F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b28ypacrrtkQ7kNvwG6IkZw&_nc_oc=AdqatKWOvaBNkU0h5VBxUsrWgV__Nn-rgdQSKSFpNX2ouRGgcQG48rBA2dMtDWr2o3U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JvZXEYeEOyfccU3vjG7c3IIhNwQxIwGVEkJ92IYPGag&oe=69F213EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uhIQKuDBGQQ7kNvwEgwajc&_nc_oc=AdqBk-1VXXV00vTRngOh14RooTq8weyxY0_iId02yNGNvX--k1t2oN_0MXpmgsIRAYE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3p6dxhvjjhQ1pWutFazVnNg49qwfece6hhgfULfZlpdQ&oe=69F1FFD9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
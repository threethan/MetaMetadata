n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-VJk8QQebIQ7kNvwFvZKoj&_nc_oc=AdnH8unfLVZ-QlvEEMASc28h_b7hkH1amRGrjmVz0J3-RpOpgHGpIAvagpKYiOfmsPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZZpHVQFA6nFZ5_Lfh0gZBkQ4AI-D8rzWSkzjbSFoEAA&oe=69B7E2C6"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P7EuXjYF_EQ7kNvwF5wlax&_nc_oc=Adn_xY2cPb2r6NErjYV2SsjayN-Wv3M6mqg6-GDzgwAzVEHG2VQyDRtjXxsTTPnhSkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0fYE50-YZFuuipslIfyV4fx44c0HchkAjwV17NQWY_g&oe=69B812B4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS0RXyviED4Q7kNvwEgRmMe&_nc_oc=AdmBYZXPh3FG-Meoaa80otGyLwCVVcXUXr0qxXaZYwDs1dQ6H69hxTfy07VmhXE6itM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzr3t1TlGnEiShrT3vUzUQzzkh0oXtaYGClsKtPuVvExw&oe=69B8103F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fre74uyxOxgQ7kNvwGSf0cg&_nc_oc=Adn53mcHrFO38tZB77_T-zFlnrYaUtu7O-hRAdBvob7oJ4-cfnFOcvpSq8QoHpmdgyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRSz5lBB-bwKc5ARE5ueqOjb0zlTHwZhqDR2K5M5JgGg&oe=69B811EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDvtglj13IkQ7kNvwEL4Q2I&_nc_oc=AdmrC61hb6tOSEnvRvSJQxkmtwhKZslfRUVuQ3V5Mc9r_6gZNvPYhk4ZACiOHJ2f94w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMI2a0HaxJDYu6b1Jde7yOYvApr5wMbTLncC-alJqLeA&oe=69B7FDD9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
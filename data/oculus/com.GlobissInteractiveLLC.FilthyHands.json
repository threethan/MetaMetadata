n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJctREWr5HQQ7kNvwFQNIuf&_nc_oc=AdkhV_Mx7w8uY9sBb93MzBdd6YxeDbfqTTdra4YLvwO0Qf3NmAN1noNueetEwW1fsyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwefvXDYSKNGl_-wiDsDoL_qi05GcQBs9g3cy7xby58NA&oe=69B93446"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldR4W7oTUoYQ7kNvwEF0xFr&_nc_oc=AdndY1iHsfQUfKL87WidmZvhDPXapmfJt6IuhAqRi3cWbWx5PCPJgihQN7bYlZNZppY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyX52SdW5aYUQYxsaHh3XtShCHpYUicIS3F5yP01-Y9Lg&oe=69B96434"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS0RXyviED4Q7kNvwGvwh2D&_nc_oc=AdmFM3LuwxRlYy7YC-YP4v6NFl48l9jSkZYSA9UzvKmKqJxlZgDbp1fULxKBiAmQsg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywOgEhdO_a39IzR0am4WIe8OJCtr6j97aiqbw7sL6yhQ&oe=69B961BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fre74uyxOxgQ7kNvwGv3LVn&_nc_oc=Adm62m8SyCgXFfLDc_OyMsxNSTrp8uOYQ0SwHHqycH_OCT1gcMwAtU7mhUtBEIuDG20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeAn272ZVEEu8buZ1YARWE9uFyrTydY0xoPuJkEiwiug&oe=69B9636F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GaBNawf9KAQ7kNvwFeFKHq&_nc_oc=AdlP6Y1YPXpdhbOm7qfX44HlOtH34KlsMHQk4aro-W1Y1XWfEMq05PjaxJEyHC8ze9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3yji6YPahs0lY0zNIWkpO_D78M6f8YX7qnAJY2Z4pCw&oe=69B94F59"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
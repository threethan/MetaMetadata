n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XizOftIbDwQ7kNvwE3pP7J&_nc_oc=AdlWWzsgZWApkNANUtdR-4Lfrd707eoQw3QFoWL99b_V2nEADVEjU53-uQz3Tg0OsaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm73zm_P4xt_bP88IXxHyJBKNELlxcwTztPyaPytDuhA&oe=69C00406"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IfclMxNNiIQ7kNvwGEAQni&_nc_oc=AdkmvGsor5xdm-HgM2qGraX4xIxo-cGG_ENhcdVFSlcqI0aciAsQ5xAuiseX6GqvMnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXiGOhkCflzBAN4jjPgybNIUaRS07dpx3kYLHuABVy7Q&oe=69BFFBB4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lsA-jlxSs4Q7kNvwHGsd1l&_nc_oc=AdmBKHR7APHIr6xJ3HEVa7-1-7_6O5JCTNw2cQ427cRyEe5hdcPT8tVw-dwgih-EBHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9MrWW2oqFRxs4nCBAjPUtZknFxxnNrKlbRGbrYjxOMQ&oe=69BFF93F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsaBAOxEMzMQ7kNvwFRUOPM&_nc_oc=Adl2_-YDWIuS2BR7I2Z9zRhUOaOscG3WDZkSz_FQkArap6ToGR6t87BGD1201MZmBj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLW3XHi40bXpUmr_c8UHJwBI3zlAVJ_5VQZBjXBWgrBw&oe=69BFFAEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFBc1nvyWjYQ7kNvwGNrVxb&_nc_oc=Adlt6i6TafDp55X-Wz8UaPs8ZjAwtgbLLjrhiW9chkCS7sdysoIjWOSxk9vHzyvEkkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxoGeekNatf3BUH_YzfNxrYYO645C7JT0o7yqaLmm51rQ&oe=69BFE6D9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
lXFERCW_wmIkn-3AosRDKTNLwYlPzS2HI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdpzCU6B2I3n-2bxnqaF39nBSGf4J8CCwwhbsIxxpZxg&oe=69A2FAB4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwd5iUfEXNEQ7kNvwG5rqzy&_nc_oc=AdnrdAF28fnWo9xltrf4dyrs0Dg8xRo0qVjDPRd3RQblODMeOrRkCZ7fIHktpfsdSqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumvbZgvVWWqkuyfR4DgOrsgSF5dQ3sfs7ujTVNbLCkgQ&oe=69A2F83F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZJyYpeEVm4Q7kNvwEixaPD&_nc_oc=AdkiImcFH44Y3JCaOVmBaR_lTnScmOt4qyTiGzIFptV86yFr-Ym7V6DrQI58NqbUqSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_VctwdmPvX6vfwYNyFTUxAP8L1nVZk7KUyXuc_cTz3A&oe=69A2F9EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0oyXdtaH-oQ7kNvwHyn_7v&_nc_oc=AdlvM_vrCO3OeaeAYZU-M6BFA5Eg3HAtTY0o3L0oFHCu16WRJRYBSEc_AP2Ne55TN-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsnNvgpG-UZXWR385Krr4GLTMHpy0J8HyavDzoPC7gydg&oe=69A2E5D9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8477537699018049"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "4397880487106971"}, {"status": "PUBLISHED", "id": "2686165158399223"}, {"status": "PUBLISHED", "id": "4146959762235592"}, {"status": "PUBLISHED", "id": "1087551703581781"}, {"status": "PUBLISHED", "id": "7011
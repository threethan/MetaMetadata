L1vAT9ORIUba37zU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ4HiguJUFE3p4W_Xyw1qCuspyTipGdmIHkojWReLiKA&oe=6AE8A586"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0rIcElCZlgQ7kNvwHn5-sn&_nc_oc=AdpkjvlaOlV7eIX1wVjZZAMwaX9-bNTw_lb4RB81CKeefng-l5xd8g0GUMBGH_h0lik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMZ_yl0jz1Ki8Hhyem4mlwUWG2wwMWYwOSjk3GSIlz4A&oe=6AE89D34"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIwe7PACdSwQ7kNvwEBSS2c&_nc_oc=AdrYLA6NPiSjJqioQvRGUQ9FpLTFzrZgnpbPXixfU-rPq2z4_uPn4emv5b0dhdFz-uo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHgAP3F-9zlVgfpkfpYxSTvo2lFsSWN_WmUp3IM-oRaw&oe=6AE89ABF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNk526IZ4LUQ7kNvwHa9Dro&_nc_oc=AdoTdDZ1oP9q9GRpxyBHFF4IeT87VrOCr3DtPXEiRy1V86vgIuOO4P82ydfqgQh0ZCw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJKP_VMoHpHnjhcg363FvZQB3QKvCBuf3Q13nWdSFzRA&oe=6AE89C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWm3kUoIFjEQ7kNvwECkoBq&_nc_oc=Adqs1i_ddty-xB4PieYANMv9AJeFb5Pfph-MPB2uR4UX0RaMNdonqKUsugs5Zi5Vhcg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWX-9gm0afq0EMoYnCPqvm-7jFU5c6MJ3FlYiC0hp-lQ&oe=6AE8C099"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
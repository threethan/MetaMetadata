n.com/v/t64.5771-25/39031633_3338092956325165_8833940461187095006_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UFFUSCKWEIQ7kNvwEudCw9&_nc_oc=AdmiECLUh6mxSn4y2z8aHFFicLI8jExzmaPuKFoT4DZjAl5tV7Obgp2SYXsoHpoaU4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwsBUqXGJd6AskEWZW_82OsrP0MWir76YMt-n8zUOzqRw&oe=69AC0546"}, {"file_name": "editedscreen5.png", "id": "8580835592044164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334051_8580835595377497_123244354962188206_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_mkHaIg9iAQ7kNvwF2bCr5&_nc_oc=Adnp4bRLsgIvYQCI3el4HyTlgBpC8yeQARRY5okhKr6rR-wYIrf3_5WBX-ETIq3kP20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyF4Z2I4xzKaHz4eoh821J_JQFWI1_HgoGrDb0hDJAxkw&oe=69AC3534"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTbKJCcefuEQ7kNvwHEJkg7&_nc_oc=AdmNMOuJ-y9C2RAOyGS_RQw8_goEGX6zj-fZmItI3YklXywR26Z8pxbBjvqSN2nid5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvWdYA6-sPhN0Qw3bgk5bRTt83p0SgBtkdlb6xDPQwFg&oe=69AC32BF"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A2JOmVnl08Q7kNvwFc_a2i&_nc_oc=Adn3PuTHuWTucZYP3HNhFHM-C2QUiTtvjYw7N1dXHrDKH5j4MGUg_QJ8C6YvHbLuNko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwgC3l3XGwez9JN1VXhaoaKDuHjNUpFtDciGOcNIFrRSQ&oe=69AC346F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcj4Yd5PPfwQ7kNvwFsFpqw&_nc_oc=AdnuNxKzIr4h-vdSNTh2V-1zY8RUlzUxLNl-AuWeairaFs8h37VR_smqgh7rrJK12ps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKNPrEWBF6XmlNpVx2qJlzMonslkJyarpylyoW8fUdfQ&oe=69AC2059"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
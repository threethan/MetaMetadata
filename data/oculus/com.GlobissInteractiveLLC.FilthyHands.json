ivlH2HddkzPQ6Twq1cb-3Q4CDbkwQERMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLvdF2Ribg5mGHleRQBbO4o3j_sldpqYn8NPRNJgfyWw&oe=699DB4B4"}, {"file_name": "editedscreen4.png", "id": "1144026337086767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_1144026340420100_3966410821812626157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXNzPpke0EcQ7kNvwEDlh6Z&_nc_oc=AdlsnnGvC1Gn4vQQSIF403iey5nVTvUBVQN_wTGDuZ6KVRVVFDZ94AVdxlHLCIxxvfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmTWQ1BNxAh-512S402S7P6GmH78iSy3agM4Gcoq5QDw&oe=699DB23F"}, {"file_name": "editedscreen3.png", "id": "2381948788830207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_2381948792163540_2691250907803019311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHnYW0KOO18Q7kNvwHhWPn4&_nc_oc=AdlTrtp0PxO6GFD4dJG-v80OsufDlk3hgSmpamVLVNpP86YcgoKfO2dIrW6bFXYVMhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs0BgfP2QZ0U1N8E7O4NJGT1I586KPsMiiSnAdI6bNVig&oe=699DB3EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "THUMBNAIL.png", "id": "1722608201633827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_1722608204967160_14764787276794601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bF-58VbgmUQ7kNvwHah28I&_nc_oc=AdnmdhfmkCOWS67TMIZOuOF1J7zDyTdA165jn-MDvU8_Lh4pnRc8LS8MVWQathf3Prw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDjF6uTH4I2_kCAN_IMMVrJcwUW3OELZeXBV87_lbe3g&oe=699D9FD9"}, "display_name": "Filthy Hands VR", "keywords": [], "long_description": "INTENSE MULTIPLAYER HOME INVASION GAMEPLAY\nFilthy Hands VR throws you into a high-stakes home invasion scenario, where you can play as the lone intruder or the family of three trying to protect their home & safe. As the intruder, your goal is to steal a safe while avoiding or overpowering the family, who are armed with everyday household items turned weapons. Fight back with frying pans, baseball bats, BB guns, firecrackers, and much more, using creative tactics to gain the upper hand in this intense, fast-paced experience.\n\nCONSTANTLY EVOLVING EXPERIENCE\nFilthy Hands VR offers a fresh take on the home invasion genre with a growing variety of action-packed maps. Over time, new maps and weapons will be introduced to keep gameplay exciting and unpredictable. Experience home invasion action inside maps ranging from a suburban home to a luxury yacht.", "short_description": "Play as a family of three or as a home-invader in this high-stakes multiplayer home invasion experience. Use household items like pots, pans, baseball bats, and BB guns to fight back, and use tactical strategy to get the best of your opponents!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/fhvrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8477537699018049"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "4397880487106971"}, {"status": "PUBLISHED", "id": "2686165158399223"}, {"status": "PUBLISHED", "id": "4146959762235592"}, {"status": "PUBLISHED", "id": "1087551703581781"}, {"status": "PUBLISHED", "id": "7011
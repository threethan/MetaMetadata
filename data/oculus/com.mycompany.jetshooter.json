xgDVGm5VMBglaC4NBtz5R2F4gspk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4VQGy50HncKIYTL3eFmbArYFTuEN9yBqkIkckeBde3A&oe=6AFB297E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewFeature.png", "id": "2181355198997783", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618484_2181355202331116_7699501028512745588_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3iHanDacicQ7kNvwH7FCul&_nc_oc=Ado6ZPzxywoG8iJxKA1Aw9elQIJbZJCdwm79ZAdaaAR4TcCEjb0D4FWNtfJuokCEFBE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNWj0QjnULNLx5WatVTSALMfF8vMUem3Gyz85dNcB9Mg&oe=6AFB4528"}, "display_name": "Jet Shooter - 2D Dogfight Battle", "keywords": ["Jet", "Dogfight", "2D", "Fighter", "Battle"], "long_description": "A new type of 2.5D jet fighter dogfight shooting game!\n Brilliant omnidirectional scrolling side view type!\n You can play offline, free, easy and full of fun!\n Wipe out the ferocious waves of attacks and conquer the stage!\n\n\u2605How to play\u2605 \nDestroy all enemies to clear the stage. In all 24 stages, the enemy's attack power will increase from the second week onwards.\n\nTouch the central controller to control your own fighter.\n\nYour fighter will not take damage if it collides with an enemy, but it will take damage if the altitude is below 0m.\n\nOn the title screen, you can select from cleared laps and stages. Red letters are laps and stages that will continue. If you select a lap and stage other than continuation, the score will be reset to 0 and remaining lives will be reset to 3.\n\n\u2605Story\u2605 \nIn the year 202X AD, a lone professional fighter pilot was fighting to defeat a rebel force. People call him \"Jet Shooter\". They continue to use their high-performance fighter planes to engage in battles that governments around the world cannot openly engage in...\n\nMusic: Maoudamashii\n\nCopyright 2022\uff70Nam Creations", "short_description": "Exhilarating feeling MAX ! Immerse you in unlimited flight and tense dogfight !\n\nA new type of 2D jet fighter dogfight shooting game! Brilliant omnidirectional scrolling side view type! You can play offline, free, easy and full of fun! Wipe out the ferocious waves of attacks and conquer the stage!"}, {"images": {"nodes": [{"file_name": "JetShooter1440xx1440.png", "id": "2491549577893675", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619646_2491549591227007_110337742670039065_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTWHTmTkfnoQ7kNvwGwVnTy&_nc_oc=Adpw22A7WwwsemG6zNnAiPE1bvnDck7KLeus2_t4h18tYxs65XDfqd7FDuUyoOUDHYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaRCdRMp2z88CC-dhhLicY50TK-ewSB0c6X4ECFTQy1Q&oe=6AFB315F"}, {"file_name": "JetShooter3000x900.png", "id": "1785791228979726", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618435_1785791248979724_4950775338412694800_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgQ6HkgvgnYQ7kNvwGNI2jd&_nc_oc=AdqVz4ZpERmlCvMn77pcMIQvahg-iVZ1CSq9S3NlmyfVtd1TmL2mw0v3nmfC2zdNwtM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpGk5oZg1QxVHP4MdnRqQQ7wB5rZqOGhvsEEVlUOcMCQ&oe=6AFB47E0"}, {"file_name": "JetShooter1008x1440.png", "id": "1253774186476988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618247_1253774189810321_2969128373446661181_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0JYdJM40O0Q7kNvwFfOx6y&_nc_oc=AdpuC5fHBTtt3V-RHrXqiwCz9CNpV-7vX2lV5MSkXYkwoyiJ-8xy4mSLoZZUmPaNPaI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2N-LIpVaYcxkpJZ0uVotd6b3f3ZdO-hyiiZVWOzUHxg&oe=6AFB24E3"}, {"file_name": "JetShooter2560x1440.png", "id": "1126529592636468", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/
0\u308a\u629c\u3051\u3001\u6ce2\u72b6\u653b\u6483\u3092\u4e00\u6383\u3057\u3001\u30b9\u30c6\u30fc\u30b8\u3092\u5236\u8987\u305b\u3088\uff01\n\n\u2605\u904a\u3073\u65b9\u2605\n\u5168\u3066\u306e\u6575\u3092\u7834\u58ca\u3059\u308b\u3068\u3001\u30b9\u30c6\u30fc\u30b8\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002\n\u516824\u30b9\u30c6\u30fc\u30b8\u3067\u3001\uff12\u9031\u76ee\u4ee5\u964d\u3001\u6575\u306e\u653b\u6483\u529b\u304c\u30a2\u30c3\u30d7\u3057\u307e\u3059\u3002\n\n\u4e2d\u592e\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u3092\u30bf\u30c3\u30c1\u3057\u3066\u3001\u81ea\u6226\u95d8\u6a5f\u3092\u64cd\u4f5c\u3057\u307e\u3059\u3002\n\n\u81ea\u6226\u95d8\u6a5f\u306f\u3001\u6575\u3068\u885d\u7a81\u3057\u3066\u3082\u30c0\u30e1\u30fc\u30b8\u306f\u53d7\u3051\u307e\u305b\u3093\u304c\u3001\u9ad8\u5ea60m\u4ee5\u4e0b\u306b\u306a\u308b\u3068\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u307e\u3059\u3002\n\n\u203b\n\u30bf\u30a4\u30c8\u30eb\u753b\u9762\u3067\u3001\u30af\u30ea\u30a2\u6e08\u307f\u306e\u5468\u56de\u3068\u30b9\u30c6\u30fc\u30b8\u304b\u3089\u9078\u629e\u53ef\u80fd\u3067\u3059\u3002\n\u8d64\u5b57\u306f\u3001\u7d99\u7d9a\u3068\u306a\u308b\u5468\u56de\u3068\u30b9\u30c6\u30fc\u30b8\u3067\u3059\u3002\n\u7d99\u7d9a\u4ee5\u5916\u306e\u5468\u56de\u3068\u30b9\u30c6\u30fc\u30b8\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u306f0\u3001\u6b8b\u6a5f\u306f3\u306b\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u307e\u3059\u3002\n\n\u2605\u30b9\u30c8\u30fc\u30ea\u30fc\u2605\n\u897f\u66a6202X\u5e74\u3001\u4e00\u4eba\u306e\u30d7\u30ed\u6226\u95d8\u6a5f\u4e57\u308a\u304c\u3001\u53cd\u4e71\u52e2\u529b\u3092\u5012\u3059\u305f\u3081\u306b\u6226\u3063\u3066\u3044\u305f\u3002\n\u4eba\u306f\u5f7c\u3092\u3001\u201d\u30b8\u30a7\u30c3\u30c8\u30b7\u30e5\u30fc\u30bf\u30fc\u201d\u3068\u547c\u3093\u3067\u3044\u308b\u3002\n\u5404\u56fd\u653f\u5e9c\u304c\u8868\u7acb\u3063\u3066\u51fa\u6765\u306a\u3044\u6226\u3044\u3092\u3001\u9ad8\u6027\u80fd\u6226\u95d8\u6a5f\u3092\u99c6\u4f7f\u3057\u3066\u7d9a\u3051\u3
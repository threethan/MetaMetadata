Yot5Tv2UqqOItrFLWttHwEPDW5Aao7HOrCIyTqaFw&oe=6AF72BE8"}, {"file_name": "FBS-screenshot-lvl1-10.png", "id": "3105910369587539", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikrmJxPFia8Q7kNvwFXWeaW&_nc_oc=Ado0LKpQPdT2yo8SSg3HrHqRtxr5UZeDus-5fCePBtcV7fDGQrZUCUGc4q2xWwSAeFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCWXrjiC4WupW_NgANseMNl8yB5ZpjwMVCXcy-lL7Hug&oe=6AF713A0"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI4xCnk7Wr4Q7kNvwEZ92cG&_nc_oc=AdpdTYdw5_wm8wbbJ5uT2KDjLXRWNW2-iDfSwhm_dhsby7NfwEWqDwfupKZtFHmiwqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2D5tV4u1FCvMj75u5ueTR2Zvf8SLooWJG_9JeJ3eN4Q&oe=6AF739A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNhwam6Yib8Q7kNvwHmhu4e&_nc_oc=AdrRptcQZuZacKkOwIP0hNoI_lccaTn1Yqt7fDjwcLP1BM-sztRLrNQ2J8McUYdfA98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhpvPguE3yJ8OQV7saHeSanldA7_WvAwwT3sLskvRC0Q&oe=6AF73DAC"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSrNm4P_jxgQ7kNvwEXkWJz&_nc_oc=AdrGlhV5PgOKRsFdgePtL0Mmcz7QmNJy4uuBy2tr3Es8bizrBUI-Sf9KpwmqK2aw7hQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_
9587539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4SKL3ne45MQ7kNvwGLSYeT&_nc_oc=AdkjFcoqnVc0VQvy36L6q-PYwyoKPnby9MXM5liWmz1Wf8t_1j3Uajhmr5TP16zRAy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6kD8_aRLjQRgh3YS3PM60NzOuLl0BnKUSHzf-iH5UrA&oe=699DAAA0"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ-QKB-JpNsQ7kNvwEZ7KRu&_nc_oc=Adne8TPyQW7m2e91vh9Z-qbHrVCZ6-IdK2uY4sWkl6CPqpLUyY2GBtVWKS0sc0hN57c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUyMB8fKf7XbgHt0eh50FVU47iV2FJTYpW52SfT0b8PQ&oe=699D9867"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRMUmeQGNn0Q7kNvwF7mq1B&_nc_oc=AdnQ4uQZrMHbuQ65k8vLPxWp8cNyLunplRmpYJquMqkS9P-hbvrorF2YS1OyJc9SqOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-eACOmPzB2mPPyoM4-b4VQq101vPLY5JlB0Wsk5biiA&oe=699D9C6C"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afViVQAaFrgQ7kNvwGDPRgw&_nc_oc=AdnWXie6zlWFoLUFcs1dA8inSq0jvM7uKxlgmyp1qm_BIQ59EmyBvIMJy9s2veRCwgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtZqEL8gjndgB_ftCHr40jFqAEbJTh-h98DJh227jWvA&oe=699D915B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flowb
9587539", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kWdPOnitjwQ7kNvwFR8L3C&_nc_oc=AdmugCEUj4_Y6V09L4kBCijS_JSihL61LDYRf8GcjPk6wbQGb1sCa0IYpQb41iWRhro&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afubvwh5-Wr7K6Jw-__Ekoq70y2VjwK27lC2d-H0WlXvew&oe=69A19F20"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiLSvED53HsQ7kNvwHAeqoc&_nc_oc=Adl_GYWjkTtlsNs8XgRPGrBxIdSU9wGnIonfCgc9CuwxUuhz2iHS0m8JWFW5RxA1Un0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuPMyDYolxcabAW9cP07ojSYMwvMzGvvTYMALReeWWzTQ&oe=69A18CE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DzYcL5CoQAQ7kNvwGtWFs0&_nc_oc=AdlgnxrJU1bU9iEGkHZB8GbAsIJ5OjYEXKEYmFf4xbAcurqS6a08RuOCgSNGuO5IxlM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvAuiUFlgbfhuH-yU5WqYPGOetnpP827cD-TDXXqGCkUw&oe=69A190EC"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK_y2s6_xxYQ7kNvwG7zUnG&_nc_oc=AdkrcwNLBx01gPI5FX6CgI9blmH5ZWilFDfSmtv2tAl_9vSUEheu1DotdQE-83o8_lU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsUYPn5X0cK-B1XKqL16I1zpvZ37n51088OrmIkY_wp1g&oe=69A185DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flowb
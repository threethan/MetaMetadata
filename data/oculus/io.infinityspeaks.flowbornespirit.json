9587539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4SKL3ne45MQ7kNvwHg_0DG&_nc_oc=AdnOnlphQsGCxmHMuFcQ_aOyiAJPGpd0LDCEAEyUZGPVjbf64Vme--jLZ2rCoo0jg7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfugMWj-XzOvSe765Sp4ZsUO0XD1Hf3yzBlMkpntciRD9A&oe=699EFC20"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiLSvED53HsQ7kNvwGJgS9i&_nc_oc=AdnTefeMVmCediZxJYs33XyTwK8744EPGtoX0coKO4cNLZrA0TyrVba9gizd9brOATI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftgYkltV_8ynJDQGmqt_DOVqOVVPZYniCG0R_-66XsREg&oe=699EE9E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRMUmeQGNn0Q7kNvwHyYqYk&_nc_oc=Admk4bEYhtp3_Ry1BEO1OMdiMPQcHQR_KbG3QFz1TzHFGrxY-xjGycQ1yblzoOsLOEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft2_iCuEVguZIdoxs5CEhlMWqeYwSMeWb0mT39irqcrkA&oe=699EEDEC"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afViVQAaFrgQ7kNvwE5Mi30&_nc_oc=Adm874Tk7rVGsAE3geJWNs7-x2q-7YZXHoqsVKaSspFd340Zksx0VbyRCpY1V4l2TNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCXTotRILp7De-6l4EiotCw0XgoFLCZREZTkSpsYfMLg&oe=699EE2DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flowb
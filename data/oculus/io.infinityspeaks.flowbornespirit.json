oY0zWF-Kq7hwqOli4t3SWTB0FBvTtgAjyTscAKPUA&oe=69EF7FE8"}, {"file_name": "FBS-screenshot-lvl1-10.png", "id": "3105910369587539", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReUTa9MBWWAQ7kNvwHPf4rF&_nc_oc=AdqnGKuNfjI0sevN7l7XYmjSViFbb4LaI6r_lqNab5EmVr8qtlZfWL79XG81ArUk_0U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GPqFlemj0n-D7l2WA7Erqlk6JvgzrMN5_BxJXfyZw0A&oe=69EF67A0"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdnRv--j-T8Q7kNvwHvCkxA&_nc_oc=AdpYdQDE5g5Bcjm8Pd58nSvLBeJFxEG12FnUBPAMrNBbR05FHLdweLnde1p9_UQXvQg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DoO3amxlgKmDPNi9Pwq6D29FURBLRTd4h9RPmk3d89Q&oe=69EF5567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9geOhutxYcQ7kNvwELz6Cm&_nc_oc=AdokDbM-bmS2v2r_-xlhixWnP-2iXV7JtXKWdb6upHe2d-QJ8gOnvN3y0JkgHWstgBk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1A8ZTZCOb8kS3vt_xu_vZbINejF8VE4cAVcdI078Odig&oe=69EF596C"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIGb5UwYDwYQ7kNvwH47C2w&_nc_oc=Ado5djyacuBb2tohfUWTprNGio9ToI2HQ8PNpt6GSk2pSqzX0ecnZULH4y-6XHaKB-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_
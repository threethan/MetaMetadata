9587539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIADNv99rlQQ7kNvwExGMQu&_nc_oc=Adm_fCZIB1_EIO3QMYcmQsMM8B-6hIMYdnKwnvo5GrWXqDXTz536EKLJG_LVsgpYLGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1yA18OBX2Dz-xHrirkwMZdtB12dcekhZG0hpyWa5rsg&oe=6999B620"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnkywzMqI-gQ7kNvwHNgPtx&_nc_oc=AdmKBeYQeBxZGC3x4v8ccfeal2wQZ4yHgy9JkS52xLY14ls9YK3O1eBBIvZIHt1hbGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmJCNTlY2Wd7rMJPOGn7mngTVBM8pz2Uw9qgK-s-D4Mg&oe=6999A3E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVFhOpOhHCoQ7kNvwGcAjnh&_nc_oc=AdnPSXEAzdWGTuSbcyr_oX7Mci7XLpK1gxemtNhquJcnL_mQKtfRih4fjyz1-oitkSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_uKsG9o73bNVlaRnqTcxuKTDZkye5dwL0WVq9ZLTrnQ&oe=6999A7EC"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZWqRK0jztkQ7kNvwEWqXMf&_nc_oc=Adm7prbyQhjYlFPJqqTEhSeJu1RBJjSLUWYoqKG-Ahsl-RZtOHutsdcS3LmnsVDa2o8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKoSrQOw2Ihv3tVg-MUJ_SRDdzDAwGvkB2SEjjmJeiMQ&oe=69999CDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flowb
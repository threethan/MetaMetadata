cdn.com/v/t64.5771-25/491818937_3550171591779685_7881522788041052344_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyRij6CWIeEQ7kNvwHT0M-4&_nc_oc=AdobyoSu4zozt_hTAsJYuuVF61qO-DcvLpLClMD_sSN7_lfk89XwBSntDHhr-i_opfM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK43urD3Le8C-9CSdyJfjrqCj363ECm56n1aGW2L7RvA&oe=6AFB2745"}, {"file_name": "FlowborneSpirit-Screenshot05.png", "id": "1018847150389352", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393145_1018847153722685_578882208557288989_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0S2osPw7TkQ7kNvwF9VdOI&_nc_oc=Adof8_CuXFhO2CwWiJu4fTFy4oqEEcDDLdbiJRApStiI0ntcss640cMiMQ1zFDnKwi0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr2qWjxTEfl0gWrqq6TViE2WUWQuL5M69lu6fYRYBeZQ&oe=6AFB2068"}, {"file_name": "FlowborneSpirit-Screenshot03.png", "id": "1413544086342790", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393669_1413544089676123_9055682207992326893_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4--RT2KMLcQ7kNvwEB-hBC&_nc_oc=AdozYvUX6eIoBmYF5dxFuKYyJN25nFdeLC-N0-Y-RYcmlyMr7cDD1-MoPH3ET5wZtlE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_--sJTUU8MixMCsLEqX_CwEhXDUPGpk06NdLzSdsk7g&oe=6AFB3C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YO-KfLT19QQ7kNvwGompX6&_nc_oc=Adryf9jVBkuKHi2z9NGfPq3vpM9kd2t61QJQ1FYfPJD3D-7RHqYKUI0AX8Y08_tUJNQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLcW_8_T02ebHJk2RyFGvmEOFR8pTOfhheATdmHQJGxQ&oe=6AFB322C"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2770
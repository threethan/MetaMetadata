9587539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpR2nrKYhrgQ7kNvwGTMPJQ&_nc_oc=AdnV2RnOHA5XI_3dgxm9nnyUt2fXX3wRXjxSZrEhexc3cKcKuyDMI6NjaG7_9zPj5x4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvC2z9C7ZarBh08HNUQJ2pS4A2wb_gx61-rvCF2hdaIg&oe=69A6E520"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcTTLfj6UMcQ7kNvwFB8fS3&_nc_oc=AdnHGrpdsUM4IcUtOadReh8YVuwiBcqmNvXms46Iz6rwk5jtatZaEBn9PCMFIAie-9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLKmV2O3x3JDc8lsNp8jdstHKl9fIFpGpXNbuImfFp2Q&oe=69A6D2E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u81Odmi8MQEQ7kNvwFqtSdW&_nc_oc=AdkZL-OMklO4PuMeDnKClv3J1X1tzsIaVhZTnRy9o2XqKQlBD_ctyGSV3KBBv8YYOC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshFcpvMkkKIUbWsoC9tPw6XM9bQ2jOkYLAYK4EdgggtA&oe=69A6D6EC"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiKnBshoPEsQ7kNvwGa8kCp&_nc_oc=AdkECpMUcU7B8lsyl7J9KfuLkMd2qxAuQsbl7OMMcgWs7cNByYSzd09c-rnXlcDqDpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteWJ0bu0L7Pq_5RaYFG102G0JXuPiZolt1m8hqx7_dcA&oe=69A6CBDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flowb
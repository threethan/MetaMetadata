9587539", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827646_3105910372920872_670765471316312444_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpR2nrKYhrgQ7kNvwH249gr&_nc_oc=Adl8h_mS6ZqEqH4ZKvt2F2v7StGGcNGlmvRZwnyexJF-BZCfnBeEKY2Cbm2iALu1zj4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsohdZlBovGaRAqN_-KYBkejXI3qp9zc-bE0nzh3kzupg&oe=69A593A0"}, {"file_name": "FBS-screenshot-lvl8-02.png", "id": "756868760705034", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823812_756868767371700_3200279980307804016_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_MzTjhCWe4Q7kNvwFuflhR&_nc_oc=AdkhTgFH3iVSGAz9CBJhwq_wEJRVNWUADBu37vIqsIq4GUW2PjVKBDUjlPA791Cv3B8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvAN3L78YJbP1rPqbzuGMmGJiUOrDp5p0oKMaPBuh5Q1w&oe=69A58167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u81Odmi8MQEQ7kNvwGhs74_&_nc_oc=AdnPjP214Rk-EIPeGiVbA4HRi0VH1OgaStCEaapT5mbS8pxW92sXNpI1_66aJZ8Bzr4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftqXu9GNkrE_CxAEP7K1v-vm4Ztu1MRcMGzvwHHRURAdg&oe=69A5856C"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": "Infinity Speaks", "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32199313489682953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312421_1375593307101277_5905839795838840696_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiKnBshoPEsQ7kNvwHmj9-a&_nc_oc=AdkA2AXQqqa-n3rzYoKL5m6OAI4rkfDd5Nmm-uNa3dvN7P4MXyzr65S8CBiB7i5uio4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afva2VN7TKoUSJR8LDLS-6mOZ1WdPELbPtuZQLu8gvJyRA&oe=69A57A5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flowb
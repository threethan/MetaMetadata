hc=kjKAT5Q7ExYQ7kNvwE87jtP&_nc_oc=AdprE4Vdxyyzt2AKPaadj2ZSIlRLcQl633FkVBSQfIFBBAEcmWhCplDPonU4LbrRiD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDycgOwGF_KE5osMCKbx-uDVKOpsg3So0spR6SU99b-Zw&oe=6A5B62A8"}, {"file_name": "FlowborneSpirit-Screenshot03.png", "id": "1413544086342790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393669_1413544089676123_9055682207992326893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vRMrt9Hi0IQ7kNvwEy93Ij&_nc_oc=AdolSG5rO0wLL28Doo9Vvs749L7isSOSUzEKunixNwOz3GTRy6VL8i_rOqmecuBJWwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfSzglrq3Rp2mA4uotayitzRkWA47cdikhCa8gDek05w&oe=6A5B7EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FBS-trailer-thumbnail1-2560x1440.png", "id": "1232779808447697", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1232779815114363_4772852270191059811_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOTXkiYc-cIQ7kNvwGAxj3U&_nc_oc=AdqcF279sOjyEpctWj42H1RkXO8uDLBhAq0LENkjLctOvG3OvgCtpyrBCtaESev3EoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0YexTX6ajymjfVFzRbGbzMvmccygoOthyAtFMVj3amA&oe=6A5B746C"}, "display_name": "Flowborne Spirit", "keywords": ["Breathing", "Meditation", "Mindfulness", "Relaxation", "Calm"], "long_description": "**Flowborne Spirit** is a meditative VR game which transports you to a distant world. Travel through enchanted tribal landscapes while you playfully train your deep breathing skills.\n\nRest your controller against your belly and breathe to move through immersive landscapes which respond to the rhythm of your breath.\n\nDesigned by psychologists, meditators, and artists, Flowborne Spirit blends the science of relaxation with exquisite visuals and tranquil soundscapes. The result is a peaceful, engaging journey which supports stress relief and serenity.\n\n* Explore a vibrant world of magical tribes\n* Breathe your way forward\n* Experience soothing music and calming visuals\n\nFlowborne Spirit is available on **Meta Quest 2**, **Quest 3**, **Quest 3s**, and **Quest Pro**. No prior meditation experience required. Just breathe, explore and enjoy!", "short_description": "Explore a magical VR world where your breath powers your journey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.flowbornespirit.com/privacy-policy/", "developer_terms_of_service_url": "https://www.flowbornespirit.com/terms-and-conditions/", "publisher_name": "Infinity Speaks", "support_website_url": "https://www.flowbornespirit.com/support-faq/", "website_url": "https://www.flowbornespirit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27702844829329864"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1380470360624382"}, {"status": "PUBLISHED", "id": "3575344389285485"}, {"status": "PUBLISHED", "id": "2049680908899467"}, {"status": "PUBLISHED", "id": "1070350255085483"}, {"status": "PUBLISHED", "id": "1892389864932751"}]}, "baseline_offer": {"id": "2049680908899467"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1380470360624382"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30985585694389078", "version": "1.1"}, "id": "87994231
3044", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEJZt09J83EQ7kNvwGXtbYh&_nc_oc=Adpxk7z0L3Tq0v5N3yqWfpELyt77hypmYTUFdmzCtn9qfx6-0BvwC4W4cAEE5dEeWLY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMHoY5nWYeMjzALCM1DXK4Yc-iSPEkTrq5PPhMKNnAgw&oe=69C7C438"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e5VszpNXSoQ7kNvwEkOXG6&_nc_oc=Adr_fOiFTxbZR_DhuYcqiPTQUJUMqh4TS-HIV5YmJUcdus4Ff_foYVaIPP1FmHOhIg4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOAd7c-B_-yxKgXP_5jMRHr8YaoSwhcHYi-ZNFXR-jyA&oe=69C7E161"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr2mlFTn82oQ7kNvwE0CNW0&_nc_oc=AdqQTl2FL7dFNIryFd6FPISe-cEUXWjy45WfLGdEG4PF2mGNUj029VoBAfwRU_GdB_g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP06X7KkJ2oiZK36dJ5K6CTk22IA82-1oPkggwgtftdA&oe=69C7C67D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv-b8sNwCvUQ7kNvwHyO_ox&_nc_oc=AdpW9a8RpN5kPP0tQOjniK6h_LDs2wG5AvGw25c0ss1aq-iTpRErVIjnIu4jcC9QEBU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWSixv0alsrF1SY_sgsfUc0WEOLzZCB4UMR0LIxkdhBQ&oe=69C7DBB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ckvYx0OWjkQ7kNvwEMTRI5&_nc_oc=AdrEC8UeMOmLOJHv9IcCQ_GOuq2NTwoV8ppzisknIPetUIZyyhE6bwV_VAL95-FjSMM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzuB4XTJkusEUNQO7bjqF5V4GZFFDPr3vdO4nUl9Fyyg&oe=69C7DB26"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1GQy30GFJYQ7kNvwEXeP4K&_nc_oc=AdqeGiqVFGlFgT0oLQ--YQB0dlPyA2hkwxwVxOTVd0KapSH9D6PYzjv_OMbXlp5XtUM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEBT9JxTzVSU_2OsAvfkBwMprRGOXe8GgvFIaqVvrkgA&oe=69C7E4DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "admi
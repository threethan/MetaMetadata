 Haven-landscape.png", "id": "874069931919110", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820983_874069935252443_7646614196594824319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhb8XlERExAQ7kNvwFAFGQc&_nc_oc=AdmKyfHYxmhPMdfBZeRUHhiWY6xCFCMMdMPwYPbdpM6IzeZ9TOos7U5iUS3P-2RWEg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOQx3bgO2wAfOagShjtx3HB8aR3ecAajEczX9E5wBnsQ&oe=69BFD989"}, {"file_name": "banner.png", "id": "870716542612374", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300678_870716545945707_9097875441724533603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DohPWyGjKgIQ7kNvwHcY5K3&_nc_oc=AdlwhRxiV4kzwTGDtwX_bbj7gSJdOUBiUCmlrYbwceZPpPh8Gdr__Z9TnfkyDuMiiZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOjyBs__tsTLc7JZSc67w_z_OI49Sn0PQDh5AodVmxwA&oe=69BFD274"}, {"file_name": "garden-have-logo-trimmed.png", "id": "609240728345673", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_609240731679006_4971190258306691206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_bhIbKRLOQQ7kNvwGAHI9K&_nc_oc=AdkaFaO_64wOs2BThLBcGWDA5kW4tqUAbPyy2BVHHltCr1VqRcB-_pRPYOCTn4dPlZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxq5SvDAVZQdim5LjWThG3xwnCWq10UbsaOxde8iUyiHA&oe=69BFF4E9"}]}, "id": "1406217814303748", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "592438033275872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_592438036609205_780839224006761966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tm96JvPDURYQ7kNvwHcrexZ&_nc_oc=Adni-TdjUTw508C0B0Scr5ilXlerz1oiAhqic9DPSqBhqcVFCD0n8EuSc7GB9uWtD8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpAVodVi3PSRg_IJyVJ6A-aQF1MZ4xze7pMAVQHVWxeA&oe=69BFD473"}, {"file_name": "02.png", "id": "764477502543044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6P5Xn71PSUQ7kNvwEyKzZO&_nc_oc=AdltD3rFC-ke9Goz2nUrvorM4j2Jb3x3lSiC6Ip_uotv8_qxRd2pEHCucLnze7ya184&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQ_npmIrBjxNDjKvglTagv5LUCjMkwOn7e-b_0B-veRg&oe=69BFDB38"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ_32hGaUZcQ7kNvwGuimVm&_nc_oc=AdmGUk2Z8qy9Kd9lTLC4tqauuua-M1WLQSleCIVpIbC45eWs32ilWzEMsYrP0mASt0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTTbmqCYpX1QssRMUG94pC13GzzIlbkz4Y0eraoMmZFw&oe=69BFF861"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9KvyPLYiyEQ7kNvwElFsxM&_nc_oc=AdlAicfyh2ftnclUUXBeRCl18ykc6w-rMTVWFvExtFuuGkifRYIykbp8N1oLlz3HFm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7P5EmM_qvF7I5Qrp6trgVHYh1WC7k-w0sORgT8aZuNA&oe=69BFDD7D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DT9VYvyvYMQ7kNvwH3XLNL&_nc_oc=AdnAh-glJe1-DNiXNqXAm7t_uZPc04uq5qwwkfe-gXFcpnfDOBFvhN9Eo_Nr6DxL-OM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcyUbTWdtIAyKZxRumZhE2lDtwxU6mRSZsZNo1SESsAQ&oe=69BFF2B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dkeljsbMbkQ7kNvwEtT2jw&_nc_oc=AdkMSw9hgKCpb7OnJKs0T10QfRFJenNwpS9fvAx5y0jtjDgoiGmYj-GXIOenwwM9nXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6n_6nThj7KvunUThvpWuAiXOhpNOZNEWdmBUTGKFQXQ&oe=69BFF226"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lo2UoW-CPhQQ7kNvwFSDl8D&_nc_oc=AdmZiA3uv7Rlj4YM-m6dufY_bgLhmKncP20eBI01rozb9K0T8-wD3MPQSMGbo6bAVGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-1dH6SxqeU5xgYDS18Fv1qLBF_LaL6BAz7dye1L0LAg&oe=69BFFBDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
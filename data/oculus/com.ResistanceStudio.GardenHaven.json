h=00_Af3UkDA3fEv23jODQ4u7-2tjsnJgcHzrS-eyi-TKwQ_xSg&oe=69D26D61"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paMX1m5pKEIQ7kNvwFDKMaV&_nc_oc=Adq3aMMrpT_jTv160tQbRMWyIeBItBxcQKj7MORYx9a_32l9sBKTSo71y9G3gvsvT0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ACGQuPlZDJ_haeQnuR-zNlVjnlOxsbHI4TXOaxNWqKQ&oe=69D2527D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xe_RzK3Z10Q7kNvwGWHmtv&_nc_oc=AdpmTpbegH138m7t5Jw9AD3SFEQvt1c5APb5NFr0PvW2EPYGgXEhdrfxA3TMNLBDB3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dcviNwsWsfXbEg4D555pLbfetVXt07I2hzzEj3lyPZg&oe=69D267B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR-_vK_jkZoQ7kNvwEi0kPu&_nc_oc=AdoWgwCV9Vaof1IzRzdCb89x1B70we0NsysSnX1hdODSuuzBX_0iMm-8zS7QPPDAnOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tl4fqB8eFNaXwsSrCyUsXYbLiGnohikTXmTnL6thwxw&oe=69D26726"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "\n**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n{1259229111805940}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\nStep into your garden each day to nurture your plants\u2014water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces\u2014colorful blooms, juicy fruits, or seeds\u2014and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life\u2014right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommend
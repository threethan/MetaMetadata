3044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ye4QXy4c10Q7kNvwFf0yh6&_nc_oc=Adowu-jeSFWqIxA-Hr1yUvlZmNt_EJg6UjD5aHfYEGXfXnpfrLnBzAzEAW_4SaTP0qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZna3uC1bh2CZP-h-693XTsY0ZX-i90vt0XL7nlfay3Q&oe=69CE5BB8"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wcf1GhOc7ZwQ7kNvwE9Yg-k&_nc_oc=AdoWu6dOtl_P6h6Vt0-hNs5C11TZpAlYk9VOxFXR-UZIvNyFHXJUCtzAlIBCU6FTcXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrZUCyEeYmbpUTWtYvFj9oQ5rC6FYylTKJh1y65G2B9g&oe=69CE78E1"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hJvheuhj3wQ7kNvwG2WlQO&_nc_oc=AdrftaP6fYh9GfvuBP8n4He3GKcqJj0hnocWjWls33tcZqLCAa6e4q0Qlhk63TpeS30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhoJSA6FZH5vdytwKvgN-RqNYeRsQzDHoERrjX4cwpbA&oe=69CE5DFD"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv6oIhyh1SoQ7kNvwFbFf85&_nc_oc=Adpugf65ysv1UahbGD0SAHT3sEN5w-d0_rXayc6FErQ1aSsvVzSmxP6QC6Y1B2TMfws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaieM4SskoHAk7mxG8gcLd8Jq-tJQp3QWU6zNv7zJktw&oe=69CE7338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAVNHQV9b9wQ7kNvwGGVbTo&_nc_oc=AdoNkWi5ogeJEyH6sEYwQAfaQ2r2u_KVIEDAhjTyyapEY-v1C7iEqmPms3rD7OuPL3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHdmX98fKUOEoroI2ZEHzhCcLs56p3FWJYLXNrMqclHw&oe=69CE72A6"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppJzGE6s_UAQ7kNvwEN1V6S&_nc_oc=AdobNv1bGciXCTWzCna6PVkQi4lqSar5FR2ifx8R4sqRjh3hZjLRwH7xwoIhcnysuCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxvu7Ab6TuRUGvtBgzPYmulHroQszRgS79tLPMmyGMSAQ&oe=69CE7C5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "admi
id=6e7a0a&_nc_ohc=drhLfDBQp-wQ7kNvwFSWtxP&_nc_oc=Adl_en0HiVrMLO0BPWDmIZeuvETkmFFFuLWAHNnxRxKtrwOU6EJcrO5MoXuvY3IfUQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvE3Iqq-mANrIHrsc1MAnU41loYfyxeQzV7XiU128nt1g&oe=69984E38"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUas1A4r8poQ7kNvwETeYm9&_nc_oc=AdmDwZZobK9Ayk1ayhrK7i-q9Ydh7Q3021kLZGjCK5IcXqPnZD3_2UiR2tQ2cfrpR1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfttzcLAL0hwr0ZTaF9dgUjLoW48FiLyyqP0Yxu1Bztqqw&oe=69986B61"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuQFFrcOOrIQ7kNvwGGVqlc&_nc_oc=Adlk8955O3GmjyVQED18MARnbRGvXu2OfQhRxjIlrtlfqqOYW9x-Gzexdi3tc8tyUjs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftZ6av4vLnHXeV-nVUNoEOLPJdVjaFPt4RiZOs8kTpkJg&oe=6998507D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgZtZ7UlOkwQ7kNvwGyjBIp&_nc_oc=AdleNlk8g2HPFtSL5JasQ57MkIxx4nhbldxfVSuOC0byCRB2dEqWiQGr7EmqTbv_sgU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv0woYzcCV_cwUdjloTZ3KEqlDTRr0XvR4NWZ4hqkvVOA&oe=699865B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0keR35bkVAQ7kNvwG7wvFY&_nc_oc=AdkqtS5T7iWi5bvYz-DyTf5GKOe6frmA-iLPjR1fwMC1zdU5RhqgeV4M42zUf85Huw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuyHOiM9cMS6AfkR_C1IIO9qynKcxrcyxqcNTKi10hILA&oe=69986526"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvg52yvfdqgQ7kNvwE7gN-J&_nc_oc=AdksQN1zZwgjTXk7uviKPUjDsaXlAvqFajMa2O-qzUimJSRhLvWVQtrw06S11ZIfak8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu9mo0d6K0rFtiT2GcQqnq9UsJDuFdBrb1AiOhf7S_eZQ&oe=69986EDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27842597281997786", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}
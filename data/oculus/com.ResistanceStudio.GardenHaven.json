id=6e7a0a&_nc_ohc=IGtKkti28GEQ7kNvwFl5JUh&_nc_oc=AdnkV4thy_ug9nh7TNfPJ4uH7ForY7d06nEHtSr3uy-qQOdfXs8a3j7Va0424r2AT20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvuOKiX_nU0nm6U7z2zlrWHF_ODIis2IwWkbCMWHt5q6A&oe=69A42BB8"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjp7eMINiToQ7kNvwGen82Q&_nc_oc=AdmtQDGf3r_lLDQ6-5AtK9tE3QxQbgk_XA6jPDerlvGo1qqZ0tO-bsB9YDm4Kt8suvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvl8381OIDbGNg5CARELCCQRSe6uBmA7nWuSUI26Rmxnw&oe=69A448E1"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93A_jOyCEiEQ7kNvwGMaZKL&_nc_oc=AdkxXB9IN5upgBX560-wLKm719JrT8TisZjKkkrlMgCtb41FZkqBjOt7pL824AwKrh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu34HFGcq7DVvggKi7V7SyHlQV2YVMuoDapBp_UKBSYmA&oe=69A42DFD"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9RaHG7TdzkQ7kNvwE9__wu&_nc_oc=Adl5Q05vqj-GQPkLD3DUNZAvdvOEPVvIjqzL6Ra3NGes4LOY99cVM9jPKKnU5tC4aks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs46ynYlH5F95FgsN9eSnyji6TUK0tOt9s3TE6_aM8LNg&oe=69A44338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyUpstGbovEQ7kNvwEmZtrt&_nc_oc=AdnySDvasjjdWgZW0J2gLNyRr_0GbeUs72lqBdfm5qdvzhQ51aN90lrlnHTONQQhI1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-UgEJZp0K0F14eA7VpcjGQ-U3BtXVeRvdmQioPTfvlg&oe=69A442A6"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAJJntZyirAQ7kNvwFekuOx&_nc_oc=AdnVme6m9-4EDOMTBCwoS1wQvFsqIqJoS8mlIecV0A-vBtg0yyII7CNB_43pAB87MpI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftnHtVPJ_Ig5Oy1teDhjpEGkrKmkyQcgAecfjK1a76USA&oe=69A44C5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27842597281997786", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}
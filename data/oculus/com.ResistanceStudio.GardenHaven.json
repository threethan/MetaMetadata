 Haven-landscape.png", "id": "874069931919110", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820983_874069935252443_7646614196594824319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr-cItfeCuIQ7kNvwFJ9zDh&_nc_oc=AdkY8Aq5HtBvulMurNLIvW0zW37cdzVGmAGIJ8h3AeO9udxq-mFWviZ_N61ksbRAQ-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBZ0FwPqo6cJNlC3Hmu255d26s1KXBWbdqFTYMs6bJfA&oe=69B2AA89"}, {"file_name": "banner.png", "id": "870716542612374", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300678_870716545945707_9097875441724533603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwq7DHrjlD0Q7kNvwH7SiPU&_nc_oc=Adn601kto4_0wAz78hkbco-_aI5X0wgfveKsKR1H5sXDq48URxiv0MHYkl8YmFWl7oY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9tojyjEN6YR9-Ht3snlSeXQ9K3PIbeFk2fHTjNqhwhw&oe=69B2A374"}, {"file_name": "garden-have-logo-trimmed.png", "id": "609240728345673", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_609240731679006_4971190258306691206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIKMvsxDl6UQ7kNvwGa4TPD&_nc_oc=Adlad_v3C1DoYIVQvZhBT8dVmxq7NV2irdLKE8Cb4he3iV3-6r-vlWKL0bblov2S4J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLv1Fb1CAQeyeBb0MmP9LxijWJQnsuZYnZjcY_bpFJhg&oe=69B2C5E9"}]}, "id": "1406217814303748", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "592438033275872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035426_592438036609205_780839224006761966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTiWet8DdG8Q7kNvwEwCzXH&_nc_oc=Adm6-4WLQu29JXTvANc50P3Q2RWmfRX-kiA-HmWffDQ7OG1syvHUHG-tZ6_ayCfIe9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfylPFcEJ1qmSyNII5DTDzTR2trOnPXzJ0sOH5DG3rsQ_w&oe=69B2A573"}, {"file_name": "02.png", "id": "764477502543044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vft0ecAcKoYQ7kNvwHOYIwC&_nc_oc=AdmpniMCLrKI-4CIgF-hUTBFUwz_Q2yxMJpuGg_N7m5X_Q-x88EtVElM7Rxxf7QkmD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyovecouSi0tXcn8wMqYc4sFfZj6a09tc0mI4ddFYahAg&oe=69B2AC38"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R11r-p2iBQAQ7kNvwEC9inj&_nc_oc=Adn0nRIcjKDbQPgJGGxwI08do_D9_QrvYfnBhWu2es21CwV4LkUp6ErrMpdFQjt2gmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4lsp5xnss3Zj-Fpfe2LDcHJoHNhSvToTrhhAHBEow4A&oe=69B2C961"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caYJmcQ8-kIQ7kNvwH9wm4H&_nc_oc=AdmqNmBZCkkr7OfXJCOPnP_6q5H-0wo3rj378SpMcFqZ-nzkFRO5ZAWUMr7gU0iRdIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCA3jbD67W6IZUW1yMqmfwAH3Bz1J6Pbv5IhcLsls4_Q&oe=69B2AE7D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHIVjHtOoS4Q7kNvwFT_rOp&_nc_oc=Adm6tRVnHM0mWZ7BTU00JVW6-ppQg1SkXLtxJsrWaPOa0TpkvdZDH7AKVN2oWN2LD0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztM8Wknl8SsEwVVHSkSIIp_2rHGlkUtuD7z6B1L2tVHw&oe=69B2C3B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jN54JAgkccQ7kNvwGoTjS5&_nc_oc=Adn2fJ_uH4OhUyDcrK0dTKmP6r60gKFfKSH-1quvE2Gcj6A1xoyFa15VD-feY2SWMdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgDXFcFOpIJgI0ye87V2LztDHn-NVbXdG-nn7Y7aBlEA&oe=69B2C326"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mqxlaJMxaAQ7kNvwEbpeaK&_nc_oc=Adkg5AqkpPYS2VbHpDtls9ZlnIvjSAoCMqQfe_iD0bkjv43yaG0L6cfn3UW-Adg57SY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAb69VH964LqVb8IYCoXCgZQrv3tfuNVvPIMuFcHstMg&oe=69B2CCDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
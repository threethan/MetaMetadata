 Haven-landscape.png", "id": "874069931919110", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820983_874069935252443_7646614196594824319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWHLVlcLhOIQ7kNvwGfaRf0&_nc_oc=AdkB1EBu_J4WxvA_UAUufLpOSv5vIRB61AC_gtKlIkVOnJ4K1IvfB30e0LdmAW3tAyo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcpDZNAOAKZFauNSDJUFZVH947IS0-Pw1cAg8UxfTvaw&oe=69BA9389"}, {"file_name": "banner.png", "id": "870716542612374", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300678_870716545945707_9097875441724533603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM_UEa-hYl4Q7kNvwH8dOBO&_nc_oc=AdmxKOZRQUv-fY8H7sv0N91gFgauHdsVagnJb4gKnS4wNTu2EkpN2WbUgjbw-130-QU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhAolXJOOrQhMUHUrZ0ffN2VNgsjKjTyOcmGgnJx-Uww&oe=69BA8C74"}, {"file_name": "garden-have-logo-trimmed.png", "id": "609240728345673", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818890_609240731679006_4971190258306691206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXIyM3IFE68Q7kNvwFqZf-5&_nc_oc=AdmNMEQ8ntJoju-gj0OX8u1kdWf16ju6qmr1UVMBE27qQPebabGzM7AOPPWQEilfwiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPs4E_pnQZDFumar0_Isf8ZhYeprz-lI2hQNWwSFhKGA&oe=69BAAEE9"}]}, "id": "1406217814303748", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "592438033275872", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035426_592438036609205_780839224006761966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv7oQ1qtqGUQ7kNvwGUSuoR&_nc_oc=AdkLScW4TtxMtPmsbThQMmfOzh9sOTc51oADRVVKG_7NqjSBIBT5WUhfT4dUBEE1D_U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHGa8FCnnKLc8VFbHqZdn0kRW1GU4DSRTpeP3DXKsLeg&oe=69BA8E73"}, {"file_name": "02.png", "id": "764477502543044", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P9A5kv6m94Q7kNvwF6LZr6&_nc_oc=AdkOkEObl70gHOMUZLWFa_HoaoKftwH3Y9_NoNpqzxKlCYzGVctMkM6V3ZxfG2tKBqI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTXXoV-cZJaJc9iUrYBXwT5h73KCmDysfChO2Jte94EQ&oe=69BA9538"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LN7W2VNLdhIQ7kNvwHVh02S&_nc_oc=AdkzgCkf4uE_14KILThrEfRHcFknabUcNxAqDp41E4cha321BvtFNyHRg-vk8MpJvgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz91W_JlqRld3M4GgshcLRwzSfFQnOg82mEJx52mPPkaQ&oe=69BAB261"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6XjLDb6P8YQ7kNvwHpA4wc&_nc_oc=Adn6UYh6FewcR4ERQHxhCDKRqWHPS34xlJNzafqKgEa7lTgfCMRt7IKJXnxKrynoezI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJDhngCraEQ7OjR_qCCZYpi8vP4cDwEJ2afTr2ugP7-Q&oe=69BA977D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1sk9_xwW4YQ7kNvwE6gMNG&_nc_oc=AdkEJ0ZpPA-Kpec-5YVquoxP7V04BqDN6AAC8Yx7TzyTUiSLDW5N3JjAuR3dAu2sq-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaMtnrB9qXOK0C8iuHqtT6yqLnDnutKr5HvjXOV4mDnQ&oe=69BAACB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqzmlFFpHxAQ7kNvwH0M61w&_nc_oc=AdmlbrUs7LeNVhMhtxDyFoeyCGPzpZrXmv7RDkCPJteYOBUgV2AHQOJwB8eq2O0fBwQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSbVTQvM6ba3nCdPw9dP8LqycVoDCP4gii9ZEM-sMQcg&oe=69BAAC26"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLEMQFuLJW0Q7kNvwG4E0Mb&_nc_oc=Adnpxxowtkd68TCXiWQbkJuYsWesOx64bhqEg6kaEbYXo4R9hL_h2z73GYmgzRBA1EE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzubTAQdyb7VOOdpMFDSkA_PDICq6vydN7sRVyfpFYwA&oe=69BAB5DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
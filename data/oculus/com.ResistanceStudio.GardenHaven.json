 Haven-landscape.png", "id": "874069931919110", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_874069935252443_7646614196594824319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPaU496bzNoQ7kNvwFtrSC2&_nc_oc=AdmIiW9AtbEk7_-zPZWP09N0lxtXt327SpSsMiDRJXb1DF0Z5aVD_q9w79OMAegGzm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC0RA3cgf9B3c2OXOFhy7scTFkdKVdp8jMs4-OrK-BKQ&oe=69AEB609"}, {"file_name": "banner.png", "id": "870716542612374", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300678_870716545945707_9097875441724533603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ed5nYoc78wQ7kNvwGfEZFR&_nc_oc=Adkk1z5ck7RCLVBnQS7E5uFtqbUUzP6xdUrUxCpJrje8Qe3qcd8fBEmwD_XitUaLnuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHsP3XJr8SKlOWRrbrurdlWcewni6N9As8dsqiXRQoYg&oe=69AEAEF4"}, {"file_name": "garden-have-logo-trimmed.png", "id": "609240728345673", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_609240731679006_4971190258306691206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJIxlTpmzRIQ7kNvwEL331m&_nc_oc=AdkI1uCCXOSrjCafZ4F7CK4paccJ_UrnvFepTZ0ySKImeMEUs0ui75f4uQ6tS0TCv0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxz8J4KNylhnlzuhI37IenzrkQDDqMjwNCnvHGYJMuzw&oe=69AED169"}]}, "id": "1406217814303748", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "592438033275872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035426_592438036609205_780839224006761966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9OtjtN6AzoQ7kNvwEg1tuy&_nc_oc=Adnl9MbaqEZGRR3tuD2MNZcXYXTkIROcgoO3Cb_m_E6AonkDp-3WRhKi_J4X9wtFRdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5alLL2M7sQPp9b1vAcoJk4FerAjhP15cznCwPNLqEcA&oe=69AEB0F3"}, {"file_name": "02.png", "id": "764477502543044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45V7S0JunFAQ7kNvwGM0EyL&_nc_oc=AdkezRD7EoyaFKQSJXyH6_aw2BPwfOx77ZQuGRcLyzrX-KX_S1g9pfMHYwU0qFegfk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSpOnPw0A_g12HPMEMzbceqpKeGuKvm25N2Ii6JWwXpA&oe=69AEB7B8"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy2f-cSqCmYQ7kNvwF5zZ2G&_nc_oc=Adkl34VW5EWYbjFbxi11aJ9-kYfOhv4wfOpoCJsUAQoWcMrqBWMPMkbj683JJbVXeVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzJRVq6gZgXJP2-YhX6-T-x6Rh61QPYbsOb7839WYYSQ&oe=69AED4E1"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cYffAyNMKQQ7kNvwE59Xeb&_nc_oc=AdmDVS9Y31IFC9zV0f7LEiTVQ1OV63QFCz-jCm9ePcKgdk5Wzll_f1zIsTx3uDUDVmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw22p8w31Wl4tqPYAzAw4LmCLkbvBlMm_keMc6OctO5bA&oe=69AEB9FD"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJHhnm8eLF8Q7kNvwEtBFbT&_nc_oc=Adncq8vhiMoqwcy4gAXIarnav008vwte8lBE9NxqU0AiJ8bl7GFN15D2U16KM64WxbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPCcD1O1YgZWTV900gRxGVdKxn4RELi573_Fwy_vhQXA&oe=69AECF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqi54CZSgJMQ7kNvwH0pIl3&_nc_oc=AdmISTnN-Lnnod2ey092xnJRih8wFPkEiQcomQSitY1eLF5J-bqg1FCGTfRqLOjcmrQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz31IhGqlwneqOztIA3if_mUX86p7UMBDSYTeu3pRBqaw&oe=69AECEA6"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlL1GXM5VXgQ7kNvwGLhdg2&_nc_oc=AdkYplTAlsTxA9i6fAe3x-X4C8zbOafNX1QfI39bRQyWq_zeOBSMDQ-F2QeySE30Ie8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6XIB4zltLJG7xJXewKnx7MMZ5rnxPVXxveLJ9BkleYQ&oe=69AED85B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
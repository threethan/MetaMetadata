VC2Y4aB2uJw0JlPVlEVeZ2NJ_3TO_y7KI43NzOY6khfQ14cXhdMU_EyeAI3R8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2pFsr7a7kG9xc9D_h4VuXXKTSl8utLKa3A6Hc26WYCvQ&oe=69F0A2B8"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J_EJ-a-8agQ7kNvwFyszaa&_nc_oc=AdrGMnfiRt78x1-a949tZMjkLLEnqrL7Ph63d7k7FpbDD9_lcApZKnwQ9oKONlzTZNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af02-5oYgmueWbGPGCnRvIZTjbkHvUV4yBkbxItj0jpGrg&oe=69F0BFE1"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gea1d7onpyAQ7kNvwF_GY_5&_nc_oc=AdptZBXfWe89FVM_pqr7siHEwsG8eGYgiji2UBHIUlwbpqtLQ2OdGBU89iGezikVu_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1nORyG0rdJSiTdPltvX9siHhuK4-x4BrVH697TDwkIOQ&oe=69F0A4FD"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyErdkfESsQQ7kNvwHSobVG&_nc_oc=AdqhISo9J2duhp1QR5uMXlZK_5vwxQHADlY3fOZ9PFwEsd9gLpS8ugvYEFkmst6WIXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1ni3LazR1Jrb1i5BXfvpesVmwbKe0kAzJ00jI4mf7OiQ&oe=69F0BA38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fqYGc3Y65IQ7kNvwGgjJdF&_nc_oc=AdrAGO0Z08hAD2yqrLUyW28Vq0m8Ptzt67yU3Ih0eMtPEkVmknraYHd1Q11hq1E4bVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Ej0znQGysfMCvgzdR5n5tRM8geMq7gU5U0fb1g7F7Iw&oe=69F0B9A6"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "\n**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n{1259229111805940}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\nStep into your garden each day to nurture your plants\u2014water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces\u2014colorful blooms, juicy fruits, or seeds\u2014and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life\u2014right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30929431859980964"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1388695013048703"}]}, "baseline_offer": {"id": "1388695013048703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1388695013048703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35683900194534083", "version": "0.6.3.7"}, "id": "1921117345046847", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27842597281997786", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35683900194534083"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1921117345046847"}]}, "change_log": "Updated library and runtime. Fixed all issues with room detection and hands/controller handling", "created_date": 1775486123, "id": "35683900194534083", "version": "0.6.3.7", "version_code": 27, "release_status": "RELEASED", "
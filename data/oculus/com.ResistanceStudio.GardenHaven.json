 Haven-landscape.png", "id": "874069931919110", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_874069935252443_7646614196594824319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPaU496bzNoQ7kNvwF7dCoO&_nc_oc=Adm5UQa6DWgcasCG95PWeOZMgv9BAYQOtfSS0rN0YhA47TZGZD8FnkbWGOxeQNtzgVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxldjVd3eWC9N75qEW0qhJ9ENnbkBS-dS_WtJ4jkvuaGQ&oe=69B00789"}, {"file_name": "banner.png", "id": "870716542612374", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300678_870716545945707_9097875441724533603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ed5nYoc78wQ7kNvwFoAlT9&_nc_oc=AdnQ_COwDcjefHnn7gvJed_55FywEX7ClaTFclmv9TXOa2aG66Kte8StBoav3McwR0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxj1oDUMb_xQhQagfQo6tpejTjlEmCmhUhoD7rNKE_Hwg&oe=69B00074"}, {"file_name": "garden-have-logo-trimmed.png", "id": "609240728345673", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_609240731679006_4971190258306691206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJIxlTpmzRIQ7kNvwGrol7I&_nc_oc=AdmENmaOrvnw-4Zx6hTwEMASGocCNLjz8WOq5myCtZCzPoTB5YR8mcLrnziLcBG4GUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUiUZJ2MAgyG4-NzMY7u3eMxidZ9kb2SA89x57VhKkCA&oe=69B022E9"}]}, "id": "1406217814303748", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "592438033275872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035426_592438036609205_780839224006761966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9OtjtN6AzoQ7kNvwFKhmwW&_nc_oc=Adk712faVIc8Y7zww1NIKVYjKSlKbQ4wWgjv2y4t_JJqQCvgpVnoRJluAnx7MkJ-oYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwgoR_IwgOjaTrjC5ebDnm6PwlhG3yo9su3H80P2XkQQ&oe=69B00273"}, {"file_name": "02.png", "id": "764477502543044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vft0ecAcKoYQ7kNvwHaIxeu&_nc_oc=AdlMV2PXVNaxU2aUeQEYtkg1kre0NXJsszRo-Sxn8-pl4i2KYEja1s7wq-urnb8_DOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsaEBmjkA6KnwmYIa65ZHwo5l7U-3lCTjRLZJQEMm0kA&oe=69B00938"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R11r-p2iBQAQ7kNvwEJl1tP&_nc_oc=Adkze57KN3oP0JQ298u6t0KkQE7AseSYgwNS0SMkIqdbqgtd7HUOfgsJKgSQgd2GrUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiIis2-y7EhZYCoOoetVo2AJ_ZGfPBBqdU3zDzxWMsWg&oe=69B02661"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cYffAyNMKQQ7kNvwFrQ6Ja&_nc_oc=Adk60i3CVYCmZCTT9K1M7LZGX-aZ9NtO0BpV1ckdnghxnx5u6gVO0C1889sHYSBYPUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqRvkFvbxSnLM_7Pua38tDpcdTY5u2tGaoZkKKtqQgFg&oe=69B00B7D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHIVjHtOoS4Q7kNvwGksYid&_nc_oc=AdkekS_GadqV3SQzkk17Zt4UbaZjaCzttvf5R3ZNKTUNX0g1vnBEIhfSRCCd3YKMS1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-UvWkwjGXtctY7Xy7zKgPBo4ri6z15yd_IVbtTmWawg&oe=69B020B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqi54CZSgJMQ7kNvwGQ7XqM&_nc_oc=AdnsOu9UgQpMPchvGLqVNSE_VvfDoX69Ly704R2h3ZTxLjG-ci5ffU8A4CJxLF3bpfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJHgiv6pOnCFAiq-pZGQ5gqBvlDp7ZZZ0WTBNrtkwiJQ&oe=69B02026"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlL1GXM5VXgQ7kNvwFVHUhG&_nc_oc=Adk1_B7fEmxBev5hrgZpX5zcfLEnfZaScFeNC9pyPkzOLUq40ZRfLBzZtjxYKOoa64A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOFUqKzI5njiOj7vdlD_qqORvzLcwd7wWXK4iRbK5L9g&oe=69B029DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
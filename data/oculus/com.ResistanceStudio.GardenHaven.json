 Haven-landscape.png", "id": "874069931919110", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820983_874069935252443_7646614196594824319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_uv4qs9UEsQ7kNvwFjvohV&_nc_oc=AdlLwW8qYagQzmI4h7mS0XRckmOGc_RhSLgbqQtC9NnOT05ztHCzF-5Gelza0OzFlY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-p-wDxwhIKqn-1Ba4zvJKDM0ZxYuV_sk19h2KrVvhfQ&oe=69B54D89"}, {"file_name": "banner.png", "id": "870716542612374", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300678_870716545945707_9097875441724533603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwq7DHrjlD0Q7kNvwG5kfzs&_nc_oc=Adm6tNG1tGdbMCb1MJHtIOqxnlZby-vTfu9B5qti64Plren4A9DT5LLjxNgyCkj1R6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYYmTR8pZNLJN6DPLv9sYDG6hhcwBJK61_z5FuPJC1Mw&oe=69B54674"}, {"file_name": "garden-have-logo-trimmed.png", "id": "609240728345673", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_609240731679006_4971190258306691206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIKMvsxDl6UQ7kNvwGQJj8h&_nc_oc=AdmNjHjCvmpZQry6K4agimo6tyKRJ877vXyDvi_RGI5C2_0iloKAsMOSzvb-DJQTzDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjtPTmPDc2JlYTvDUOE8MwLhVcqgKx_CEwuOGeXypAZA&oe=69B568E9"}]}, "id": "1406217814303748", "locale": "en_US", "screenshots": [{"file_name": "01.png", "id": "592438033275872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035426_592438036609205_780839224006761966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luIZB8qynEwQ7kNvwFntt0E&_nc_oc=AdlYg5SZDTISdV8ve-9X87um9sxq7pq9-HqUQQv35yNnUq4rEvqcbBj-g8WJz0Aof40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKoUw_sF8O-7gvFBzRYaAAAnXh20FGMqwJ7VgzLzG2WQ&oe=69B54873"}, {"file_name": "02.png", "id": "764477502543044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982533_764477505876377_1220416549536098185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUnka8Qfu_oQ7kNvwGJ9Ici&_nc_oc=AdkomSZr2TQMcWRZ9GEs8RENGbUMmF1RNMR6jPVEHhyKVxmRlnQ-WPx2935zLCnD8bY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyeUQEukMhUKdxneU9HE3TH326YtS3Hkha3JkrU3QaGhw&oe=69B54F38"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E81Drp3lQsQ7kNvwFjian_&_nc_oc=AdlnSNgeyx8tFPciekuHY-_ghnFDB2MBB6TRctxySB93JN6dsw6CYHAI3rLkcsY4c5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtQkVOM5D6eOLX71CgL_g5qb-VvGf55qQXMvzp9kJrYg&oe=69B56C61"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZXdhQvj5TcQ7kNvwFNmuGo&_nc_oc=AdnBmO_-FFrqa8L6IhaqRFwJwzwxGcYP8OnSONhfseo-47GVTwW50aPtV1Rnw34p8uU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA7M7c8KCP0I9PTDK1a74Z3fdLOPQcdUoSQlhDst81mA&oe=69B5517D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Rx4rFnUwp8Q7kNvwFDZRmq&_nc_oc=AdkSOWC6KklZsygAlPrXw02bZUpVXi3TTPFST97ZCX-88GC3vG7r_v1pPfxR7DKpCE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9Si75Y37E8dwg0yOsNg1lREDQld60mOuDt5wlzC7dEg&oe=69B566B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jN54JAgkccQ7kNvwE3eeM4&_nc_oc=Admpv8Sl8twHnRlwTMcxiwg5r-rdTR8uHz_mYTTtHxyn57-3TxZ-vlHMmk7IHrsC3Yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ3Ue3Vu1Q--bJ_cJOybzmCZrFItSeINb3tXahlWHFmg&oe=69B56626"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n\n{1229918152427342}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\n\n{4320172124868707}\n\nStep into your garden each day to nurture your plants: water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces: colorful blooms, juicy fruits, or seeds, and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\n{1370905078050598}\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34274247658832684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1267136301914077_125871435891026289_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mqxlaJMxaAQ7kNvwF0euy9&_nc_oc=AdluCYPLbX2_oMp1vFk7CCkh1DY71kkmlIIs6pKZGBtB9DPP6Ldmb0qxlihXbGPf4Io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWKQmFGCfvI6xx45Bo14fjSUCfU5Px-Ctw_i1OCPeEIA&oe=69B56FDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Haven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770314400, "lastRevision": {"nodes": [{"id": "27842597381997776", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
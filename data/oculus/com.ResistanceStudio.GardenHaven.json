=1-7&_nc_sid=6e7a0a&_nc_ohc=DDfPWNxP3JYQ7kNvwErQ4nK&_nc_oc=AdoEQ8j10zaChXo2-OrUdSS8OPm4XNdkkCwn2E2vb5EAGTZhBrJXEKWOhjrzSW58KF8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1px9Ov6C9NRZ6oyjk87XDB_JfU10nknWw9DC-vLNmmYQ&oe=69F1F438"}, {"file_name": "03.png", "id": "1125470385856495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035354_1125470389189828_7184784666572306900_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J_EJ-a-8agQ7kNvwHatsn5&_nc_oc=AdqPW24tCJCgmXNZdoG-7aueMn9KbZLtQlvFdrXnUFzNsoVuRBIK-b3Y3N4QuLgtJaE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af08bXTB0OLoyEU4yo5MwJ7qc8JvaP6H2c5pJHpDowVNBw&oe=69F21161"}, {"file_name": "04.png", "id": "3981216505487924", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982689_3981216512154590_4189994664470531211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gea1d7onpyAQ7kNvwFcxq59&_nc_oc=AdrfpsmeXZAzShTCwjdGIYkUM5yvZVcosjpaiAYb256MYFW3cek-FjeLz-6Y7RHmDAk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UU66EMxNAgZZDhGt3wJrzsTNlszg00YKhSyQPRk14gA&oe=69F1F67D"}, {"file_name": "05.png", "id": "3788946934685427", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982526_3788946941352093_2852083901156275729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyErdkfESsQQ7kNvwG9vllm&_nc_oc=AdriLeDrhU6vCK3FyfG7FpeorLIx8bKIhXHxgXGAhrXii0ponngj5iXCEe04UWApVxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1s1FyuIddAn3wkGSz9zR_um0lRMrpwdjcTCFD2jNHM4w&oe=69F20BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2560x1440.png", "id": "1967784354025475", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820923_1967784357358808_6227872389427305062_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9D_40-9PLMQ7kNvwGA01vt&_nc_oc=AdqIXlaTy2SY_tpTtLGxmnVDNnMdio3qUztAbTe0hcNy-66LheuOGZBHVTSe0ilEwJk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1K7AKVFK6D8xpygiRQq70SzsGTG7TQ6d8J87QCKOvhjw&oe=69F20B26"}, "display_name": "Garden Haven", "keywords": ["cozy", "cute", "flower", "garden", "mr"], "long_description": "\n**This is an early access game**. It is still in development and may have bugs! It may increase the price once there is more content in it. Your feedback will help us make it better. Thank you!\n\n\n\n\n\n{1259229111805940}\n\nWelcome to **Garden Haven**, a cozy Mixed Reality experience where your room becomes a lush garden ready to bloom. Transform everyday surfaces like tables, beds, and shelves into planting areas, creating a haven filled with vibrant flowers, fresh vegetables, and thriving greenery.\n\nStep into your garden each day to nurture your plants\u2014water, trim, and fertilize them with care. Alongside you is the gentle **Garden Spirit**, an adorable guide who teaches you the secrets of gardening. Feed her with what your garden produces\u2014colorful blooms, juicy fruits, or seeds\u2014and she will grow, evolving into a beautiful fairy who rewards your dedication.\n\nBut remember, a garden requires love and attention. Neglect it, and your plants will wither, leaving the Garden Spirit no choice but to say goodbye.\n\nGarden Haven is a peaceful, family-friendly escape that blends learning, relaxation, and magic. It\u2019s the perfect place to chill, grow, and discover the joy of bringing nature to life\u2014right in your own room.\n\n**How will your garden grow?**\n", "short_description": "Garden Haven transforms your room into a lush Mixed Reality garden on Meta Quest 3 and 3s. Use your hands\u2014no controllers needed\u2014to plant, water, and nurture flowers and vegetables on real-world surfaces like tables and beds. With help from the adorable Garden Spirit, learn to care for your plants and watch her evolve into a magical fairy. Relax, grow, and bring nature to life in this cozy, family-friendly escape. \nHow will your garden grow?"}]}, "developer_name": "Resistance Studio", "developer_privacy_policy_url": "https://resistancestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Resistance Studio", "support_website_url": null, "website_url": "https://www.resistancestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30929431859980964"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1388695013048703"}]}, "baseline_offer": {"id": "1388695013048703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770314400, "status": "PUBLISHED", "id": "1388695013048703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35683900194534083", "version": "0.6.3.7"}, "id": "1921117345046847", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27842597281997786", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35683900194534083"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1921117345046847"}]}, "change_log": "Updated library and runtime. Fixed all issues with room detection and hands/controller handling", "created_date": 1775486123, "id": "35
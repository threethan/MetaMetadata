nc_ohc=ORWe7CAKu_AQ7kNvwEz5KBB&_nc_oc=AdpDLZCQ97qddnMgmMGZLWpH7JCJeNu4RCwJKu0sQ8Jitp8slLD5NX5hJQUryj9JWR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-El07MopT39BdpcmW6jGREL5YJ4Eq3XWQW7A4J5woygw&oe=6A43C363"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5l-ojqDnp8Q7kNvwGPyv8-&_nc_oc=AdoZCaEwJQmqyFAIvA-dsz2xP5jMcwehFATLYXpD00Ud4aKsYscVOUZNMF-FzGEptxc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4FHD5U5xlJSKC8K6JK8Xv_kS7RMfsXp1DrZ0HSgy48g&oe=6A43D8FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMGMoHbzfHIQ7kNvwHifEph&_nc_oc=AdrnaPbBJQGtfUugn8_7yGiHaSCvH0BTa5dlt9EOchkpafA2S39FWdd8tghxsTr-20Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yweYoMWCWpK9dikga3f6U7_OI4vCPl8PORlE-MrCPuQ&oe=6A43B717"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPxGP23sYhcQ7kNvwHOTGFd&_nc_oc=AdpILwt44f9YM3H9ihXaiHG4kWuGj2kPMgweH7-mSFn23nRYApAk2ZiKx4ymcIaCPbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--gcvc5daPXIWZEet-hfcAvMwSEVs0tPwJEnk6jSLi6Q&oe=6A43E26A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKBga5REDZ4Q7kNvwHWR4wX&_nc_oc=AdpJ6k6F8j_la5lIhKCGMBQbZw_EBXRMS7x-0zA1svSB4nvBuqU5BGUvHHXvaLQq6qQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u2eygKINWbJZIf-AJoiKDLOIR8pVSZPTeW5KEzPCBLg&oe=6A43E07D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=4I4_RxKIinMQ7kNvwFJ5A9w&_nc_oc=AdohD96VsPUUgw3Izy-9FNvKHuIY7-2Bfot85SDrya92ytpjR2hHg6axnwkVTmN1lMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCZzjtYT6D0hUa75y7foVwmBZp8Xlf9-GtDY4N5mPCDg&oe=6A7B2263"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HRRNuvMxNwQ7kNvwHuT0cI&_nc_oc=AdoNXYVUrIWuwMIP2KN4hKF83BoI7-YT0YMbcw2Ue_Cw79mkMI-ba66pTUVUBbDogTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTZHnNTs6ptPYeQ3nU6_IRJZif6O9reMFRGUw3bcvCJw&oe=6A7B37FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viSb7-6U_ZQQ7kNvwGrEJ-f&_nc_oc=AdrjaInEhQpPT5q1EAj1j4711jImJIAgWQwd5heyDCOGp-LF8EJuwru1r5H6c2eDk6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqr_X3OeqPdgjW3_FufWbJx4Zi4y7NSUMt-xV80xnuMQ&oe=6A7B1617"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZzbnDC8oQUQ7kNvwGqix8s&_nc_oc=AdppuMbKTTQ9R-AHQjPRKAXdTnehpFFh2rM60S07CHW6cRRdc35cyNL6igOi_6JDlBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFGtgJmij0iDR0bt6xXfpYb3UAEdR1gp5MV9Cy79D3OA&oe=6A7B092A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAQtCAYp5qEQ7kNvwFgFjBI&_nc_oc=AdposGfH8ALIxXd5fUwMbxV8cJT27g76Y9YCqpJ5LkXDqzRfDU6letEwEsz9GsLHMZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0paJlOj3wyBJWl7d99z3TQ0zxdF_icH-_veWddsK7aQ&oe=6A7B073D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
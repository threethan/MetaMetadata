nc_ohc=dJLLgvCrhrgQ7kNvwHcPSuK&_nc_oc=AdpIgYITerbuegRwGZRkjVt30sVI5DtxJjM-4B29Z-gFLX-o1Ww6L_S4cofD4FiZC94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRemJzQNOX5z31v6bvvnYL2s5gLm5wbNP6CX61S6q43Ow&oe=6AF0B023"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jFxdEjKzn4Q7kNvwE8Bgai&_nc_oc=AdqWO9mHCDZ-L3oKTe8_pmA_IBtCqvxWiUqkExzlVSiFjoZ7kf6EOZ89b1UslCKomAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpdKj7H0oJEUjgvPbh6I9UPUxSqVEifb21z8dK3fDf7w&oe=6AF08D7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2ebPCO13VAQ7kNvwERA-n2&_nc_oc=Adpg1rApZPR3IMqeN2SathLd-1FBApL8zho2aEA9SvoiFPudKzi_6tJ7gon7_eO7O7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUDGQR0SDwKssGs5haBEqmODebrM7ZaW4yYzohvi9NRw&oe=6AF0A3D7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQQTOlKGC8Q7kNvwFOHvSb&_nc_oc=Adpvs4sbRamnvJKDCrxypsEjA0Mf4V1dBMqDa3keZhoVZ0_1bmdZ2Gz_zrvCzCbIsPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMHvuSiwvp_CvllLHCSdJofaRonZHPxizizBNwQEk2og&oe=6AF096EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcfOEI8uV7oQ7kNvwEYQ7J3&_nc_oc=AdqxuYDl_pRASXs4Bxk9zMoJyvMK7APpvTer1D4guvej8nXJTiPnEJ5c0iWLWF4rHvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnvHyE9Qq76USOyWQGFs7ahtK8K5fj1XWKhr8HN3Vzjg&oe=6AF094FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
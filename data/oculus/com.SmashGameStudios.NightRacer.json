nc_ohc=3bqjw1PUBl4Q7kNvwEN4I91&_nc_oc=Ado4Po_uXjZuLgN-N0_8QhpQ5wf_2N9T88YDKKZlySoDCn3IpaHMzorWBwx4vFnCN4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz01ea-8E0OlakzUgx7ceE25YWM0i7L7My4EX4mf3AkTg&oe=69D110E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ws11NykUb0Q7kNvwHgCrik&_nc_oc=Adr1CyrOOLFdPCXI7tvSuDgBd3D1SS0FEpoC40EGSktiniiAWj7RQDLH-uqHJ15T7D8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwuqhybgpbXk9Gqi92xHAxzaJUeU23ZV00JTRO6TC1Uw&oe=69D0EE3D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRNn4CsNFhwQ7kNvwEpYvfx&_nc_oc=AdpHFGIN7ADZdtKk0CHhDQYmA4ved9ieIAX8zs7_Q6qvRVwZBIPupo4j8tAVw_twvVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk2F3Y5UnkXokYOAoA51EN_fiJPc0LtXeT7OZY747eSA&oe=69D10497"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDYgz7Hed4UQ7kNvwGMfHif&_nc_oc=AdrSBuzI_TsCPm2QyLtGB5fGh_Q419OQApmCoINVuYXCf4ZVpl5MFUjAmcZqNpWZmSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV9wYJQqRI-lvSkc06xM27mtL6a7yPW6yqZKPfvMafVQ&oe=69D0F7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7e78Chrex8Q7kNvwFp0e5d&_nc_oc=AdoxEIAIItE4oyXTOMyLdSTocxoRWCHhxDAauMHxHAVvR-NQTMBIeE2wTxdrJwjclPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_TeBA2GQsvLbvaYTVubShCVIhGiqjLP83HM6bUHjQ2Q&oe=69D0F5BD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=ORWe7CAKu_AQ7kNvwFCmTSG&_nc_oc=AdoDFgscM_qhkRHKyA8xTX6RMSY9rKt8C8MkqdSKn2imWEhU_7CHqre1E9o5WcD7e5Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e0YG5rrwZGyXDXPneGGTCF7sylgflalAqw8FKuOLgvg&oe=6A4514E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-yusHJA1JgQ7kNvwGnFTHF&_nc_oc=AdqbWXeahlJ9B1rsWynzXteAbUnfZ9Elo2MxBuBpX-6d00pWdKoToq0rQWALpgbOnHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eIYZzzlYDBu3yKoQi2CRxtI19iMJSs7BUQMmD2L4OLg&oe=6A452A7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMGMoHbzfHIQ7kNvwHKa083&_nc_oc=Adr8Vw7OhdJa8X3p8s9VeVZU2D-t-tQi69LDd4WIlMY9GUbgAqpgnm-nPPmNEJ6cUhY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kb0hE0LP_GibGRuP2HWGhZ_9oe6GET_mJRhfiAYdz4g&oe=6A450897"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPxGP23sYhcQ7kNvwGyFg9S&_nc_oc=Adr7bkW3oNpnBauH1_mYv1_NV7tQk3AQf7xHWMrfHqBkisA-6mc46UBT6FKf5sLhAcM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KJ4Xm-r4nTnYT84iql6ClBZk5y3-2DHww2k0F1xRSGg&oe=6A4533EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKBga5REDZ4Q7kNvwEdRy0Z&_nc_oc=AdqvalWiY-HzNsGNsPiACva_pEGgnEwhYA4tn_JM0BBJEnAHPTqIUjRy2dLwoepQJVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6iEpid4EF_3aisC_fkNOCXqrxUkwvZHDM4aESS_RafA&oe=6A4531FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
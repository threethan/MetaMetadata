nc_ohc=BZBfWoPK9Y0Q7kNvwFFRCAZ&_nc_oc=AdpCwhCFjRcoZ1P3jrLB8uZ5gEBAWzD7D7eapjN4ryC5dCwG1Xp90xkvQuqwY1zXSlc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg67LVp9LR81Syi3jpdxudCcIF2URD-7Ug6bbXibtOZQ&oe=6AAD3B63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV9Ama6hjuYQ7kNvwFovZ9P&_nc_oc=AdqP54qmigWSRp5gmjUCSwr9EAs0wNFWluKqqlZTKAB0Sxs5lJSUCw12gPcWhuKdrhU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTXGzetB1moKmKszBn5kCDKHg5Qm9uUXdqMQgV7oL8ZQ&oe=6AAD50FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ_QSny7lSwQ7kNvwF3OBbc&_nc_oc=AdpBh85SJo993ZchyH4FTnTqvM1gMebyYT3L8YXf4gdW3l0jAkw2wUuI86uRHfQV4ic&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKt9YOzLHWFsNx-E_TyLngw3_mVNR4bKWoixxJ89gOHw&oe=6AAD2F17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV7Dlo7HMO8Q7kNvwFN-Rg6&_nc_oc=AdoUEVUzkhu9rk1cMsX3AUMGeTKIfLfI5xwY_eMyms1LHfaGfTqY-CS8L1YiMaCsnYk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9x4OIh9QyheoKhdcj10U8hPfQbbx82OgO0bjvL6GHyg&oe=6AAD5A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv-v7--XinsQ7kNvwGFcVhA&_nc_oc=AdqDOXIa4EF860H3exzsQq67F8hwejCnn3ztOmMDZ7kjukE3-8oVqU7yxpX0W5OlLgU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1s8Kp1smTQzCkEpib-4dlIh665JDVOgSCRNIlzmhQBQ&oe=6AAD587D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
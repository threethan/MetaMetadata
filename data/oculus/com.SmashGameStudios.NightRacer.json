nc_ohc=0FUB6RY2bX8Q7kNvwGFEWhk&_nc_oc=AdqGk1eVHdoumk8PPwTNAB42mrEBMo5ep65u5s7NHR1Sy5aPjDNFnCKTJLiePlqrhbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TY-bS3zIJ69U2-h7HJz0P9azR1oHUydKxaWnGc1HQjw&oe=69DE3FE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLVDq08yogoQ7kNvwE3vqHK&_nc_oc=AdoVFxW6c9v0LV79EPNCE62tsbhSqRAMk0tRbNJPKuqfiBnRSnjUTR0fKShmLYxSJZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k1QiH5ezNoOzApTpTNb0-zvdCgqI2-O84I0qu8rR2sg&oe=69DE557D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YE45iEe2_NkQ7kNvwE52XTj&_nc_oc=Ado4icKwGPD-FgGP00VQHMStiC4q0utqiiSTbGhXuLIQ3YdIMt-nItgWFa-d1b8AXGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SAFi8_TANJKfxxJ4axLspct2PAOQrV5oxfy_tqpvl4g&oe=69DE3397"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oipaI087Qq0Q7kNvwGTD1qx&_nc_oc=Adrza1tpu4wrHm_fOIHHrIAhpnyskDICpC1X5MXmbU166pbJJFlVahEVi41sj1kbIKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ePgthTLbmhYZek1iaO_I6YNcsrRES8pPnz2zYlzZHDw&oe=69DE26AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiriQHNNSaoQ7kNvwFr5w7N&_nc_oc=Adowu_2K7tPSo4RMhSpFHd-ga58sZ9iqaSVRgBH1QIEza3pTHXpVXFh9U_sjTQOTeR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17WMxFVvcSpeVyq7lQq2ETR4QeOuMZcW7wlFCcXaoLMg&oe=69DE24BD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
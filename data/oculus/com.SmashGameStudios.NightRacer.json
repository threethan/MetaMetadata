nc_ohc=9q8UG-eMUloQ7kNvwHgoGEu&_nc_oc=Adr9dH-WtA2QzdMVpYN_LgdIKavfPNVeDMe2jAFvfsz9mQjsDz4SKgIP4WoM-Nv5O4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9l2sFye2jVTc4rfcDltUyW8S-7za_k7_zIWcB4kcBIw&oe=6AB12FE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNjNp184bmYQ7kNvwFvgO0z&_nc_oc=AdoYEBlVKam9jpxJCh2zCCRJHiJ71yEesJL7M_rGWSP371k6lQxYcXX9QQ7iHWrV9t0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJozjQrG5ivkN3bYuUgCRJwouKumQdpWfxDi786EaSmBA&oe=6AB1457D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIAC4KhHf8MQ7kNvwFlTL7i&_nc_oc=AdpWX7072EJDzrCXiIDzO9PIKZhi2IMXQI2oDAAmknVc8QIG1yfi3Vjk87KagWJqP1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp2oU2fYXLO_SZFBhejFeq7VvNGwbko538BYAP8i8C-A&oe=6AB12397"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImlkGb87GosQ7kNvwG24kFB&_nc_oc=AdpQQJ3c0zn9MMqj0YjR0SjK632GpkDMCeoIzKayL-vBj4GQGOUkcHQMkPfK4LiyBe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbKTkHgaU0LXlbO4nHzWYGpUGzEb5ccr_ME-TIZREJKQ&oe=6AB14EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7DkkZ0VanAQ7kNvwHDQL-q&_nc_oc=Ado0Qp4O4aBXumgprUqvQN3iOrr-lHyqgGX2vheNJ5B5I08APLaQtVhXPztRyOURVRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0X-FA-ZGPop3RdkW2dxHKzUU3Ix6vouJi8BX1x35MWQ&oe=6AB14CFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
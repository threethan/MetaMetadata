nc_ohc=uXqgNyuaFCcQ7kNvwF_DcNE&_nc_oc=Adp9rPV-sGAmbBOFHZqE4acae9fd09zMypN_e04LQQknEfokSo8Z1KLcViCsHNAjtzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQMsQaBddudEH1vJjk4rXvcULIrvtbfYLw5xgyOtkU3g&oe=6A748AE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g48Q2Gg17I0Q7kNvwHGYA6_&_nc_oc=AdqOa2fqyaVGxiEasrt74vOUJQQESIfPoqWVrUP6jTHZk3rQnQ7azNeRy-ZEHaheiII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG17NG66R3pTAU4aQNoXrBLYq9yLvj861F2QL3MGNyPzA&oe=6A74A07D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbdPvFwsWCkQ7kNvwEtqgBI&_nc_oc=Adp9nURbU9Ysdx0HPvwPD51XGTeHZmaN1WSjMWwLki3x-GKrReOpesDFKIJiKqkxy5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0f6LJmP-mVmH9Yp4TFI6CLEbZsovACmLi-ETt6CKGYA&oe=6A747E97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtPFhxCSnZ8Q7kNvwG-IGMy&_nc_oc=AdpbT5uhWlE_jyYjGWU6ABxBDLnOVJtwgijIF6MXGKJV-kYV-WrUfKh1dPLfI1A17jY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzPuJoeRrDPpOZr6vvZ2aGM725S50BZAbOWeRKPsdVCg&oe=6A74A9EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGkAg3SB3BAQ7kNvwEdFgA_&_nc_oc=Adrnysf49DBS8dJ7H85uXW4nl3Fj_uQLPKsOUZsLfVuFH78SGI1u0KkzO7FJ20p0GGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZQrWMdNxKWrhzkObVTkdX4Mhn6JIIIMyg43pKgba2jA&oe=6A74A7FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
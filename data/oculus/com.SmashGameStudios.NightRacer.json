nc_ohc=tiwpLPEwDFwQ7kNvwEt5Xyt&_nc_oc=AdokdErOG02b5GbkvymZJ47oRliyKz7XqOKmGyYgJZ3FYZbUUCqHVzZwFAGKwBHQOps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWGEHDlfR6CHwkvJtPqPgPPNH977hQadKMNRMl_UwsKA&oe=6A985BA3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78CGz0biVI0Q7kNvwFVoSAu&_nc_oc=AdrO0ijrH8DmhvyN2zSDWK6WhCgLd8Smh5ex8GfY9nv8SLY2En37J32ecVbkp6sbGqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbNy4a73wj0ugdK1063s-hEXn-D3LZAhosCzelMX8kcg&oe=6A9838FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gaxchLrC7EQ7kNvwEIiK_i&_nc_oc=AdoOZ5ULK4QPx3XQP5XiIDn5e7pfpk0AdhFRDqz4P8MFsEFmKa-_CFXln1-oXFTdokU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSU9M9rCMUNgR-QtW5a952o9E2Fu58qO0oamhlw9ibwQ&oe=6A984F57"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crerLlfUv08Q7kNvwG5jQBE&_nc_oc=Adp4TIFrA-wNOiF6heGDTOLwmgyyFyYORPAQMmieLRePerit5H5eebZSgjB7dWC9k0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyygME7fQ1G72W38CV7DmVmHQQZAqHPTl7cJIUyjqOXA&oe=6A98426A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYyxLadwXs0Q7kNvwEPYHCd&_nc_oc=AdqIeISMGgMUMy2o4JDGD9WnZkhg0zjzUlhleFqkQ1zBSY_zc2zucQOH9VCHOYUFnQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaBDSP_7aXDfOZZ4ZJaN5s5evrlhZJjzwzdBkoQl2m4w&oe=6A98407D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
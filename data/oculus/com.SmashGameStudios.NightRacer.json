nc_ohc=iIHsPPeeijQQ7kNvwGuOUXV&_nc_oc=AdoRh4K9XYG3Z8n6pYfpjCvJeBoJPowvRap9p9G5NlQMPJ_RqG5cXUn6H6He2PFvM7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIYL_JTEkCcaaRLOIhrzA_HTj0P9-dnIJHNfN1G9p3wg&oe=6A5E2163"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCpVHs5qybUQ7kNvwHJCFsK&_nc_oc=Ado8MO5MzKSLIuz89M_3hAe-MOYKaPRV23-zpcELFcBXf44RCNTfmAuRm6B5xc3_ZsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFxksSs8gZY-ntuqzXkdDfvBflcePDLMrni6Yf6j3ukw&oe=6A5E36FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6y967YGxJ0Q7kNvwE4w-Yw&_nc_oc=AdrWWQZ9FLO5LzEpsIjnXNDLtV5YN23n_XKalt_hoJX1dQGAg5WK5YLta9HTRqlOfkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDaC59lBZaYvpO0ZCUjVVxQiaOFcz1rIgwwZhYlEssDg&oe=6A5E1517"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EcdEUWyPlUQ7kNvwEi54FQ&_nc_oc=AdpAwU43q2wpwFy5SDHkGKHMSvZruGhacQlEuWPQfgBPsXIoZU9wERXL7vv5Msln8vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABRF03awruH7UiQzsWEbDoCDqbwdZWLZrc2Zo1WR27jw&oe=6A5E082A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3weI_Av2_QQ7kNvwH_7E1E&_nc_oc=AdrrcYnFWr-dAXseNwxeQPVZKxHnO7e_MBSB5jaoJkHn6-qQBEYF_b6B1STBbmCS1Xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLJ7B7yIow3c1-A31Z3AKQ_LrrJ8jladoGWjVsEPYzPQ&oe=6A5E063D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=MajxDCB_pycQ7kNvwH6SVfB&_nc_oc=AdqCCAijqONkbAEADdSlABH8-N-R7Gbby7HGCL4ynUPGhTRHXBRp4uAxE9xeJKvp88c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSG0tq63WoYSnPjYAfMzuACz50tyHYBR0JxpKXnTn5Jg&oe=6A71E7E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBlVUZnW_7AQ7kNvwHdLVWv&_nc_oc=Adrxhe8KQxnpb-F5bOWiH6b7CuqPGet_ihlEDBW86EFDJNWC0rQbMld7pUj8ICtfUy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwHAi_Db2yBWLcMvDV66PK2GLQXIFSUU4Mm9FM2bI7uQ&oe=6A71FD7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6sAhWJRg34Q7kNvwHt53FK&_nc_oc=AdoQRKhIJSBXAgrC498i14GfDbzNUAEIGmGvK_oH6GD6tfirL6VyhVQtpiM5SKJUb1o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEojXhP-SESIApAfpO0XlcFMYtbjST97fCp-eAjYHf8pA&oe=6A71DB97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtPFhxCSnZ8Q7kNvwEuUU_o&_nc_oc=Adp0bGv5ClrbKv-ykhURON9QMvfoaU883b-4TSZrpwPPxvz-z9JcuDLxOjXWke1vzIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHfU4DoLk5jTddv4AgwaHVfmWBkeuySREU58FXB1DcAA&oe=6A71CEAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGkAg3SB3BAQ7kNvwEY591I&_nc_oc=Adr7Ftfv0ZWm16izdE2jAISfJNlABXzoILHrbsJw8sakYvmWU6xGgMlt4uiHV2YPJic&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ3ZgfUh2ONv6ZdSObW-cqYNehcwknceEyVcx30Fuatw&oe=6A7204FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
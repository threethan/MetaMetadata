nc_ohc=c9D46rAshL0Q7kNvwGWMws8&_nc_oc=AdqZEtMwQZpH7Wr9PaxgJIWFS2txoeAERywciu1cGXg8HWfZGgb0mjB0MP2CDcyGPhY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDFfeRqiJZ9kQIWwJaJbOLmV794EdSSgwUC84dL0j3ZQ&oe=6A8AF463"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZ5-Wm49nS8Q7kNvwFM7DKq&_nc_oc=AdqgqnMsvmwX1ChqVkPElqeY0pcFLWieYr-aig4FeB2qHE7p56leFzH0yLv6UOf3PLo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGex88uYXGkzJ4rP160_YBoiOfKxCGVNSUW5hVFbEfNbA&oe=6A8AD1BD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpAGnBD8DOUQ7kNvwHi0afj&_nc_oc=Adp3vhbg30D7USyO-gzBF46AdvgQGLbq5Jc-j3BI6tjAdHhR_Le00Be4Mt2_hdyfilM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDavfis_T1f5EtMAIzAu30VncbKxBPDf-OgHAiHHcfFA&oe=6A8AE817"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFIAj--D2PIQ7kNvwEZej0s&_nc_oc=AdpVRKygThgEPFJ0gk6Sk-5EJcuV8Sixq9WIn5oI0I6FbovaBFpM_ebnwZRV4JRJvjQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB0Skfn4Bey2ESAu1dts4upR8uQIvQrvc7WvWLTSc5yQ&oe=6A8ADB2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXxPJbNVPHYQ7kNvwErYF5B&_nc_oc=AdpYfoE5PQHV3o6ose2lQ_CDbs6o01pTg1IRvH0mV2upb234ldiE7wv2uqroTOscHME&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA8HsA8DcvQBR5ABBi2AF5HLnkB1pUTBDVFGviYDXh1g&oe=6A8AD93D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=lNfBWn9r-hIQ7kNvwGpR9YX&_nc_oc=Adp1K6tB4nQIwg_5kEMfFiXSYxTC-PHRKbRsZg9S68F7bpH3iWHelfVjhY067F2oHrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4bp1nNOV69LqLY1P261UnCRluY24x8pS0B5AfYZoxcw&oe=6AEB31E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYGfgj44uacQ7kNvwGiXkKa&_nc_oc=Adr5WtjAZDSZBhbu-PMJC-aUFan6PcGTFufVzoIWB0S-w9-OC1EU892BxV9UoFc4vfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoobFu1ObEEtDUcj7HVSgRhKvT_hnxLwFFuxcIdfPbrw&oe=6AEB477D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeJhwLwppo0Q7kNvwHe3t72&_nc_oc=AdrlU6ViY13ODgr46TEprVfGtnW_obe1KMRhOvSbxYYrZvg8g5P6XGxC9e0GTS2ad70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyNmaDsg4tkb83YnNLXZRzpyuN9c1dKbkTxELBCDfoFw&oe=6AEB5DD7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za6j3FRmbjYQ7kNvwGxVrcI&_nc_oc=AdrTYPLg7cb64cHnSctRWD8taQzSGoNjouhNBAg-jhraZrlRkeRGPaLOX895eABL0DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUcxe6_AEqmv15NXySTqKyH-gGB7llwVWB0Uv4PPWikg&oe=6AEB50EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w8DjSWGLHkQ7kNvwG9wEWy&_nc_oc=Ado-qHGvOUXng-YwtBFoxXm45eUWFdS1zpHVPnA7A6ABawY6w1XWPdM1XnWPlVl9f1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpq0-3BPC1YqPqp1rWvpfsVgE4b2ioS3FUADjzib0snw&oe=6AEB4EFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
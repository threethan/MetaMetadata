nc_ohc=WtJOzAPOcjIQ7kNvwFcIw9e&_nc_oc=AdoH0fC45yMVEuXAL1shygeWCmvsRfTpJ4Dz7Mpu9FUFtuaS64hBOF66AoyQDRhktWw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwJIOod19VhwmjzYPA_cWLjBcb-EeCAUHa1X1JKxOVIw&oe=6A563863"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKOSMPqOSYAQ7kNvwEaPdIP&_nc_oc=Adp5JgwUAAAI6R2F3JoMwctjF8N2X3eFuS3_NNp33fwY5MKeEjVmN0G8K7DkUPVwVv4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfOSVd-1mcG-tUKynGXWDXAjLy2m__13w8zz375-4IhA&oe=6A564DFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWKyQn1S9lUQ7kNvwEtYKrI&_nc_oc=AdoIbulBCNkhzR9IUj0WRwdrL0AWbr2FC6tJbJC7eqePhsFGkgRYFj5SMGLxf03RK2Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb2y8FdDETftyazhQ0UYLNJVAJnHVMBYDw78_A1g_1lA&oe=6A562C17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv-WGtQQankQ7kNvwFsRTKg&_nc_oc=AdrqZq8HXYpkkJsFbKIUCGOzgSVUpbW7hPKf4O3KbYtZTp2fYe3nrc11giCnFPlljQ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiCIY2NbUOx02K2vt4tt1r_FisYqaCPFfjBcII8MwlVg&oe=6A56576A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKmLhkNrtk0Q7kNvwHDHfgr&_nc_oc=AdpK9HjAM9DPvQ9EUE7LysuWad1314BHTgy3L-zcuI6btIQMhEBLICcArojR_QnaZVg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4Kb2ZYpN-tg-4rm48u-o9TqWcf4jAHfxz7T58_IT3ag&oe=6A56557D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
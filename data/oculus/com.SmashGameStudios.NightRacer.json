nc_ohc=_Kkr9j6uRfAQ7kNvwE1_7jo&_nc_oc=AdrHWOpCJ4-kofscDAZ4dd0vH2YFiNrHhNISWp9BswIP-cd7uJEz8W016Y0RcbHf8HI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34YDxhRtVaoDl_W-_DxYy8tcVzZ2cJylO_4IPUoP20Hw&oe=69F4A963"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mmKDPYp7LQQ7kNvwEcAhjg&_nc_oc=AdqkyuYtL7xaUMOUWHNDHlTAwjt6mKn4S2bv6vusPHj3RW1JZDoT7rtODMgIPaAxO7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1alDb2lRcFQOfJ8FhDW1-y6bl053LktiBm34NL4Y8nEA&oe=69F4BEFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdfqvjU_q2EQ7kNvwEFARkp&_nc_oc=AdoG6KIgq_a4uhCS0TYh5Ko_06x_1wQa8FdyuVVdVqwoucbSpgbbfpKGsrfc8g8NRRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07LNZktHDT4oDOvvw7dtlOxHSL_2gycrTY9HivMa1ltQ&oe=69F49D17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLCaWYRf6SEQ7kNvwG7GUbL&_nc_oc=AdqhRrQIs0GWtnko6C0ONCHBXd0tvJmUOz4NngVA8GA-GXfbGdyNkWTLeblk79QxC5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11vGxknt_nf2OBj2ia3RpWwMoMrQLzNKWYlW_wqY5nCA&oe=69F4C86A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cVFclM3z4QQ7kNvwFgqT6X&_nc_oc=AdrcssNq1eOZxqsEC4GRXIpDGPXbPZKxDm4rb8RM4maiO32oU6BMlR5yTbMwGtc4tvE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2i04S4q99jBSa4aalQvET0LLhf4B4f6SEA8ektCsUIVA&oe=69F4C67D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
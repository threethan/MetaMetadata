nc_ohc=0FUB6RY2bX8Q7kNvwE-tfBZ&_nc_oc=AdrdUb_tyQU9FowAYhk3U2StVqY_g5WsXtfMYlWPyr-mp0fWQsWKsZoAj15RUoYeW2I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hi2A2YMvvd2Co4Yuf_CUCMLXmQaTjt2d65x1PV0xlww&oe=69DCEE63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-lzBwzjfvYQ7kNvwHDut-_&_nc_oc=AdpvY7Eh1uo4oNwz8tKL7FT6uuj6WfttgZ4f-S5a7cu5NNhmYvIE6UntVFBAOVl57Ds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lyzx9aEXlgB7-lH5dKTLByfRC1xNuhyFP6KEA5sKfhw&oe=69DCCBBD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YE45iEe2_NkQ7kNvwGtgAmY&_nc_oc=AdrO2ETAt9wiZ2q2o5rnPG8xzIXQuT5s8uMkkNsXk073r2XavFe2Adit1uTTfgxuVRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hSgmQoBXuciKV1I5YRRMLhPCf6mncUk25N-Ca_d0Xvg&oe=69DCE217"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oipaI087Qq0Q7kNvwGhsxb9&_nc_oc=AdrP5dYBvNk7KBXJMOl08viCVgDfT1CQZiiBaxMCes8pBb9ifyoOeR1W9LRvoohYvO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JPr0tNsGtSqaLUT-5hLTjlIiUGOk6vg_ekqa9bERShg&oe=69DCD52A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiriQHNNSaoQ7kNvwHzZsgn&_nc_oc=AdoHbCL5PwQ-bx3gszYOArxLyfPszHXnc5PgRr4W_mmffKc9kQe1EOJERalcyca2LEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35tnNKorjR23PvHvqFtoUMH8p6hSlLOWzlCEeNfzR9tQ&oe=69DCD33D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
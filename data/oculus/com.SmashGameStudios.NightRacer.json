nc_ohc=8hd7mg09ne4Q7kNvwFknuUf&_nc_oc=Adp5ZgmipKNO9GoYf_q_IU4ZR0lgHfSBuJv_PyIBPgV6i553-eoJ0YSK7ZuDNDFKHAY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86OsnvV4y86rrw3_dOhiKlsiANkr-sEs4w9UHqOPBlkQ&oe=6A241F63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IxI1QpjWDgQ7kNvwFe5GJT&_nc_oc=Adp4d6yoUzPtundpwWGo4Q_eXtXGkumUqdjfmua3xcDxIMTJBXAgMfJ7HcY9_Fb8huA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qHLaKjtoSSdSfkrRYuVDsBodflu58yBgm3_eMPPcZzA&oe=6A2434FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oa37RGxqfgQ7kNvwEMMEfW&_nc_oc=AdpiW_GdM-_ajO5tbdLYx0dBY8AzDKl3vtNlwNhRFnvsU7piMjLKSZPJ2GPmHqvGjHo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T3MdwVuEoCUV920_LUZPRdTcoQVxWNMy4FCD-sY_ZGw&oe=6A244B57"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c5Xzo8E-OEQ7kNvwHjapgW&_nc_oc=AdqwjlRFsmtAOUZQeOVcoj4rbb11SPCR8XNg_YTgnAltsT9p1dcMnx_Nwvd26xctkAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mCSMwLD1qddulQ5A_fSgw3MoCqVkjxqR3dADfEEChYQ&oe=6A243E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nwNPVI_QpMQ7kNvwHPtGEs&_nc_oc=AdqeG1jSpyxyuIVobvg1pjCUXkx4RXM0PnAGy4IOFVE_bmSqyGGOScAsAt7yPTpjH2w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kfmrm2jXc2e00LVtkgQxHs_JuBJRZyrvPh0yfuErzkA&oe=6A243C7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=FquFm25kCbMQ7kNvwGXk2-1&_nc_oc=AdrzDIvQGkrnslnYFrHFNQmrIzOEJLKIDCElteczir17PkshK4DIaq8RRs4l0MSa7CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmMD5ZwKXPqWmsm5ptsEp_eFCV166SPHVRtJC2iWBesw&oe=6A60C463"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMcbQPoH-wMQ7kNvwGpdLVw&_nc_oc=AdrPG21BeEaMLJN2lV8MGYVHnGNcRXLlj4egzcAvB7iwckPTZmN6PHIlRIVJwrmFeTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABMITsqXyKAHvA7wRZn6b5HLa9urPj0kTqmvFPjFHcsg&oe=6A60D9FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qH9cFJ7sOk0Q7kNvwH5VCvn&_nc_oc=AdowZg6CNV9BeZ-GyeMxtT2fJFFp4lnkPLu9y8wwNJTyVo8EQvkDJWkh2D7olWx_72w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtccBrXs5xtzvnPp_t_H0hM20RP9f2jSZZJnfjWRNQEg&oe=6A60B817"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EcdEUWyPlUQ7kNvwFh7SGF&_nc_oc=AdpvOwX1XeC08Iz0dWxWuZkpiVI6-n3F8c-4VzXiDF-HEKfWr3mcwIZEqtsWsLMIK88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQrfQzMxoBGvc262eck0OkfwiKol4Nl8cSrKe-VSwgSg&oe=6A60AB2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3weI_Av2_QQ7kNvwFN__H-&_nc_oc=AdqgEM4vKCBkPjEPpePc_F-6qPN6TmA6egrezPJCaMTvetz5hhSgWejSYO16akvH69U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSG-JwdVYPXz9Y8lzVoOz0S-mKQWiRcQjhZStGE9Ba9g&oe=6A60A93D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=yY3NLXKjfhcQ7kNvwFXjMM2&_nc_oc=AdquMM-gsmslKv0QzU-j5gew3vy3D5imR4H2QlIyS6Kif9KRWz8A5vsqzEIDWpjxink&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XN0rk4-VeMDFBFYN8vf4mkeLv7PO6v0fU4uPKdexiXA&oe=6A199363"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5dEhhYjSGsQ7kNvwFgbMW9&_nc_oc=Adrvpmb8NEAVuqIa4Tig6HN6Yz49aqfmnqzwVGXvIPRn4h1ExQYxT8l-bP4C4CSDvDw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6erwypmwT6bPSwC1Mlc_MdQuIOVgMfFh8s39S6CvlegQ&oe=6A19A8FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSVNA9iOoIQQ7kNvwE-IQvM&_nc_oc=Adp0cVGbUVwf2N5MFJkeuBVO25AvXCvZietQABEIRWaE1N1YiUHpmxNi5bY5cxq3WFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sEsbPso65kp8avO9LRGPij77Xs7EaBeTp1yTW9ZLMOw&oe=6A19BF57"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrmsePx7wTcQ7kNvwGTx8fc&_nc_oc=Adqi8XImdbTJW7jC2Wn9t069PxCDOO5j2MeCWoYXVHS12vYaWiUwAR7VZ2-a3SLqktw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XACh8Nc5Y-23VO_JLlUU-dXlCwZY9ohK_SWfn979cnQ&oe=6A19B26A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6OiCC9kTUgQ7kNvwH4zC8I&_nc_oc=Ado4Omqi93rCkVmbKlLcg7JJ2I7yxd5hXKaqV0v3VoryOu101NrlpqmASX5h2UN-F5A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af587eq_WC5xceMnzyuhUiub_50933Ar2P3NkSPuO0eCDw&oe=6A19B07D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
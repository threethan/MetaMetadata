nc_ohc=u7510WQyOpIQ7kNvwFxRsXs&_nc_oc=AdrKU9W5868R0wbstTX6x7WXdnXmdjwC4TVWAFuuLcGDLT8AYt2_bTCR3LPdxyJsJws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TGGqht9ERuU0BzK4Q9p8HBAbfhEctGTu1sGbZrcetYw&oe=6A1D87E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc1Jw_JRgpEQ7kNvwEUDjea&_nc_oc=AdrwfyGGiGBMwVwZP296iK7o2htuz9kR75LCPL-STEu_gfajaItE5lJQeh3OV3Xtr-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oGjteYultKlkUJtKLm9UKpg9dXMqO-ptOGHniSEHkWw&oe=6A1D9D7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWbhPjuAWsAQ7kNvwHS5i1P&_nc_oc=AdpArqNi81O48Rol1PoAirv1V1HQ-Jc6G8vTnwPHSnho6RnpvcvLMQQVQubaSyQdK3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70DkMYH2wU8pV1dt3gJNpTb0xzi9aE9tYFHTFv-eLNeg&oe=6A1D7B97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-T_y_GuL94Q7kNvwGF9Mmf&_nc_oc=Adp25f2mvKxAiOfyDbQtwkbC8gvPYrQazYZ97FVkF5mu9HbgU16QMi_kgGlFIjUAHao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BF5mOczlhJ1bSCaaFGrbrHjU5zJdsRMszXoGoAzdJeQ&oe=6A1DA6EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQQ13gVGKmgQ7kNvwEWtWdt&_nc_oc=AdqgDcspDppXmyJ0d9vqNGBOYQ-2kxGsSZMNyn5R-dEWkL8hiL2N-8g7w09ytAuL8kc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52qubG1XZUimGlbQRLAmZ8eQNvFrmstmLG4-fK15RRDg&oe=6A1DA4FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
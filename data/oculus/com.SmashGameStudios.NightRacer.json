nc_ohc=9q8UG-eMUloQ7kNvwH3V9tg&_nc_oc=AdreS_Uv3O79Hd3fGGLfMebahkwRmGdr0xfA_34oq311Wcoctt8E5AWB6RMtegLROe8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpHi41UiTC9vkWh-atkqDUjS_tzpfn-u-PNsCZXrsnVg&oe=6AAFDE63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNjNp184bmYQ7kNvwGonmKk&_nc_oc=Adps3S2VvKEEXqMhaLP6RmelmoF1W2tbvXfj8KRmsClx-kPRj-broqOhcFDsuTqllWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkihTeXM3hWgY7UDJ2UyVxRiBSLfQTA02pSCEc_Qhn_A&oe=6AAFF3FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIAC4KhHf8MQ7kNvwFYqwJP&_nc_oc=AdqWV7QesCx29GNcHhHpUO6D-7d-w5qWmkwdetZWdU4GQatOAnnOJRPgWOPn-GZmw1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLirjN7KMq4jlS-ZgLuXtl966qvZOtSrGG1b-cUCHoQ4w&oe=6AAFD217"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV7Dlo7HMO8Q7kNvwEs7fu8&_nc_oc=AdpA39LZMPK6WEj2Fci1nKROxIgK2ZsYxJ0EPLXpmpajNvyJCVbrD73KcyUfeKPB3HY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwmSjLRxvyXz62u-U1hubPRehhuhup5Zu9CEcEW7Y_vA&oe=6AAFFD6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv-v7--XinsQ7kNvwGmUbvZ&_nc_oc=AdqFb-_oAVoUMaLzWtLewBiPEMkYi1r9g5leUSbprPM-UmSLLk998BMIieB1hOZy-NU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJuh0COimZ5SqHdBfAVcr-55tmrtjzk77rCrmfhXlFmA&oe=6AAFFB7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
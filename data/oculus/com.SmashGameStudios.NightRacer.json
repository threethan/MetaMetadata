nc_ohc=yY3NLXKjfhcQ7kNvwHBf5Xv&_nc_oc=AdqClloXsLLjFB6aacbRcIX-4HVQdRBOU2SWXTwM1TqIz9eIvE91KRa-iSXXOg-Vkf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yTci-1g2OP2oZkMpGy7VXbOMmOVjHdr3TOhtZZ45I0g&oe=6A1841E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00pp9AR5ykUQ7kNvwEmj9Cs&_nc_oc=Adr2Raa-k4niUWE6SN1Lh5f8X_l4BZ2Q1-1-xUYp7BrvwLG1ggkp_HrzNZ4VJFIt9Qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69TNcRyXjIjDc80T1syza7vtCAPRFDxe2nk9-juaQP2A&oe=6A18577D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSVNA9iOoIQQ7kNvwEXXXNE&_nc_oc=AdqpXX1zsjs-9AgRRKnpBvGHwUrRDs8TH3ZZVldLFHrl0qScShjrX8QN19BzMb9mH64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43LNYxg0zTNpWusMDZTgviR2W6sJKZITLPAELB2kxXbw&oe=6A183597"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrmsePx7wTcQ7kNvwG7P0F8&_nc_oc=Ado6LXNiUkp7-KSsKZo31C9kd6qjhFTbFlFKicFNPTqxY8yN3IXJTYGTGT6T6X8KRfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af521w4R8u1qGfxllOiBemHjNMPCIPYhsY2pjphzXiCBTQ&oe=6A1860EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6OiCC9kTUgQ7kNvwGIg9tE&_nc_oc=AdoJtzwJVfPtkHK_mwCR_l39V72tcUG69zdySbN1FyqetxBYCRAgT1rs0JqGSgQdfsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fou2OzRf7EASFILwg7JHc22RAUF3z0tdUcu8VJlNMbg&oe=6A185EFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
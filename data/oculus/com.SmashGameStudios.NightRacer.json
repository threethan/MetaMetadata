nc_ohc=gmDV8r8TeukQ7kNvwH9QUaH&_nc_oc=AdquuDtrvgcnRrQAt-XZgCFDlKN3JVUeg1J0hDJ8Wf_vzLgODjtb0LgebOH2FXMnNDM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ABUNVEd5TI4OfbvI81KqgBpWtmwsvK07ZstjtKXhscQ&oe=6A2C0863"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHikO83dTyIQ7kNvwHDoW0T&_nc_oc=Adqpfc9He-szTxF5D74w7Xl-fwCH5xwtVxtqRzUZum30brBooLkYrs8n-qFMblKmBu4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XQpaLYrICCJ9H64mea2nVCzq2VJGwfMF3wIJuGL_0Tg&oe=6A2C1DFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fju3Etj42PwQ7kNvwE6hoSl&_nc_oc=AdqDnwR-fqW2oj-lO1Q-YvsUzrf09ynttyEc4u6_B8P-2P3YTq7_1OrguuQoJ5cb1Cg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FwI0uBpmqMaOF_fNlKjlzpif-PV0Euj1li5kbM1-bEg&oe=6A2C3457"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDGxXmpFydQQ7kNvwFx6XOs&_nc_oc=AdqIHz8yN9a6IHqHn6QfpDoexSMQcqlf96MpF2OJ1-V0Q7PZwwrkL4YWGtNW6-3tKIw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Idu-KA1GlkUF4A9bVISCl_GX20UEui5XpWvoEQaPvrA&oe=6A2C276A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElFn-cJ08toQ7kNvwH5rYd-&_nc_oc=AdrkPJIXW7yeS3vSo7RWUXKFl6AN4C4JlJ55rnjolFBSuky8mbGlK9eR1NuKQxoreuA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80rH69bqRGVrW5p4YFS9ERhOm-mEk_omt6No65TrTCQw&oe=6A2C257D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=II-UUNj1HqYQ7kNvwETcS54&_nc_oc=AdquFBs-Pq5M0DbUsjR1qyQxZFCMmMCKGE1TecNfKkexHfqKzS6OtRY7kjKjb73dr20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87AUUt-3CsjDihKILxb5A-9uqlASmjMUE8-Lu1N8s4hQ&oe=6A314E63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX0oyNvvGRYQ7kNvwEyLZ66&_nc_oc=AdoUUqZBjuoQKVgfc-4IG5jbS_rudn1UZjpJc0ICdEOLM5G82PWlXWT3g2yCiZ2G-og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--5Lr-2nybAmkV099p0wzymljYtlB5ZnEnYw8g7OelXg&oe=6A3163FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z55RawNQUQQ7kNvwFz2GrG&_nc_oc=AdoFzTYzQmG9QrfZHrmsG0ixghAj3sFjvRZ6ONrYeZtcZUFerHpcTy19WBkzUMe6HU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EYXJu8oNPHFxjr6WqC7ax9r7nJ2_LtEDWXGe-dtc6DA&oe=6A314217"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vISDKxWF8jUQ7kNvwGvY4wr&_nc_oc=AdpU2i6AGnrIhEnhlZkla4sXZ3oduFekObYYh-FQyfnRAEiBsUgs9A5lHBTXCPW1uK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k6Qf9DHSLDbTdsI1vG3c8UqSI3wShH_Sm5TKsnIPMXg&oe=6A316D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J840NDtIqsQ7kNvwGjbdHt&_nc_oc=AdpNHw0M-x_Fscqv7vi78qrqqFs61J3M6ejhoHQq1v-dB4C43eSxcKxiGzP1lxqMMhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AVUiWNfrOjQbUP-8V9jbr0TSsZgN_ferv2nJIMElErA&oe=6A316B7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
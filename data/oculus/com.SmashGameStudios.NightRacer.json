nc_ohc=0x86NClK57IQ7kNvwHEaNs4&_nc_oc=AdpEc7f8IKgK9hnd6xfTWQPeNHSEVWSDNsz1aslJH6bhZmcpogBUK8dWMh0SaJ8vm08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK17je8O2xKUCBG6SxRoHy89c_7mMzu0-nWm44JS5HNTA&oe=6ABE5EE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jed826CvzLoQ7kNvwGUztfM&_nc_oc=AdpFPvGrAnXfAWGPneUIIAGxVfE0ANAKvZecU74tHrYMVsGtwQh_zF6aBBlOzkafqy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI28VYX18n8af_LvXeiJr3HPcz2FyNqupQw1WVJzoRSoQ&oe=6ABE747D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrZM5bdHL-gQ7kNvwFOuQkg&_nc_oc=Adr86xuJqU0dUgXaIO058bk6A2AcqovVbkh_A2zel2Y0x4NAjxhUan9_mXbUVOVgHfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhrLrUiFZH5Ugxm9effs4GE-6n3A467HB4cRvET2MHaA&oe=6ABE8AD7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu7xaZ1beQgQ7kNvwGzkqdT&_nc_oc=AdrIIRQb2aybA02tIbohJeeCRQmXI8osf5zcKhkjCDEdhSy94psmRgaUbhyUhUEdO4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlC71sZcWs2zmipDRuROF5aK2Ss3TnpotrN7vEE-JGKQ&oe=6ABE7DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isTxbfZZMQQQ7kNvwF8I9XM&_nc_oc=AdqRYOc7jeyo3QRsdYDIYEqENI9rjNPovdTjBMmg1URCa-cDszGwB_7i4Wooi0lpVO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJWvI7hsOzWPr5DIbdOMq8_kAuzxhY1xu3uSvFR__ItA&oe=6ABE7BFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
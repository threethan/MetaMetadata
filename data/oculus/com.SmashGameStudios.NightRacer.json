nc_ohc=S_ytvGDPkygQ7kNvwHegILV&_nc_oc=Ado-shn88FyEB_4Y3vSASAz2_w9k7T-BO6ceTmwzmv6bQWFekmdTm7anmRRE8ySNGk0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRrjYifv4NUK38s7yRcDnVBoPKeZMx9oDUZ-p-C6KZrA&oe=69C684E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JTpuy0hsOYQ7kNvwHbsa09&_nc_oc=AdqWPrLbN63yQQcAlU1TScIARc3nYttrZyVc3Kc89BbgmjiKWICOXVh-cMZK75HDdwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_r34LZQN_sy0H0xsarXY0F5b85aw50EhgJhVXi4nC0Q&oe=69C6623D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Izjlg2ZNAlcQ7kNvwHPjwdE&_nc_oc=Adr-7f4dwmHVpek66UaFvR1ISm_Mucn-zeYj9cbWhwPLwaNZOJpzCEo6mGUrspVq8FU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYY84B3UL_qpc1Q20ba_7Z-MPt0ryT3e0xEc0pi-9GUg&oe=69C67897"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMb_-OIw-K0Q7kNvwElb4EP&_nc_oc=Ado_QS9MVKbncHJGseGe4vUEp9rasfc4C0f02elvUPLi4vWQ1L__dPlxR6MM8wk3wx4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHET1WNM0nx9x4DCDquUnCK-__eFqC7LRYJ64dSuVY2A&oe=69C66BAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Det_-V6REAQ7kNvwGXUr9n&_nc_oc=AdqPVDSprfykZoli-zgWhBZgV1Xyq6lcVsGtW0femRIVSc4hbThB_JTv1WUy8Sb2-4Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx80fEcaYuUlUtIeQ6vRpKlVQtPUOdQeYmk1TTP8nONRw&oe=69C669BD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
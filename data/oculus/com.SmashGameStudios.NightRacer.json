a&_nc_ohc=iRBgGqqkHa0Q7kNvwH82jw0&_nc_oc=Adp6MAxVhKfXNLvKCuhJKS5hKIsFk7cPKH7t3hIzimcQ-opQmrD0KqWtR3CHF8uHeSQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cqzfeyd90e1sExYSfl_7uYpDhjMPMfk9sSnyhD9MReQ&oe=6A369463"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoh2SHsuM-QQ7kNvwGHAcEV&_nc_oc=Adqc9nPqXB1vZHoh7ClUfIiM2APJPrnEOwlyIZgP0B-ueH1w_5lrt5ZReJ-TiIJ8s4Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UDpMuHLcDwgBSGleR1I_0jhl8y62YKoVwn-LavBeXfQ&oe=6A36A9FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7r9N16R1vwQ7kNvwFLVHkU&_nc_oc=AdpGgdp_xWWCWkNRcjoOgq0gVd2A-kKxMXQzJWC5JNEHxyjcFAeN1oxcl0P8kTq7Mk0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85CJoYCcB9dvcUZUIJuD-JIVOClXL1HyHuZGzPmKkUQA&oe=6A36C057"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTgy-LJEql8Q7kNvwEHfDkf&_nc_oc=AdrgNKcrxg3r-2DDc3J6QZVath5_YnqR5qsGnJ8VWwcmesxfdnSb0TU3IMUM091amV0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QLI-YyE9R4FA3voe58Qba-3V82-sBMZk47Sqb8QarxQ&oe=6A36B36A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN2JnU4k448Q7kNvwHDLioP&_nc_oc=AdrlDanR4aYlMqiRcM7_gVi7E1CvKFvmlM7UP9eB_tZz7SXA9eWRE6hMlUP59GuPf1Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gHqYfztl2J3Bz8FrKcKWBwXPoxznxocDX3HwQC39Uhw&oe=6A36B17D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "exte
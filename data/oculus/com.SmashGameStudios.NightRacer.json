r&_nc_oc=AdkE_8_ED8Vsr8q3OeVYyHaW4yZuPFzN2shzteFoaiMEJB_touasDfM22fNsw8hAzKI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMed9Z49O_amMv-SrVDOZD6xnhje4RZTM5UhZR4jepwQ&oe=69AAD563"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNFXitJmEEkQ7kNvwEyHOoP&_nc_oc=AdnUREAZon82kBMZHDcd5HZlaaKr5rSFeoRW2BWwtIU4gTLlwjPND74UCzH69RoNar8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzKNQfdOW5h5OMpG9kmztE686N6ir1ij8bqq9J3pRSlg&oe=69AAB2BD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbTWEAwrb4YQ7kNvwHsuDaW&_nc_oc=AdkScFtAGgY6cPQMGEzbuiOEuSv1iKabXhvO7DHxEHO3xC8Ae_BOmkkqV4EWtCPd5v4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfOyDtcO0wp38iz7icKLx_MO3T2EHGhZ0IoxA9nhdz5g&oe=69AAC917"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tKSziYF0OQQ7kNvwGQJzlY&_nc_oc=AdnntPiUffSZnBBOGXegsJhiqmGRZI2wqph2sjRR274oaJs2LsmNJzwuUt-daINFEBo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHTXrp2EIoAAirqX3O9xLHlwpgt0Z95vkWDMKbMZATQA&oe=69AABC2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RvjXDOmzy4Q7kNvwHx-hNj&_nc_oc=Adl31d0XTz7Cb-nEgxioTN1mgvn6f9RspI42hYUHWRY1MM4hrq1uPx3t7ucQK1cOP8c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSrRXV0RkbqORELA1GnHzd4VSZGi_f-PrFZ0chQg4muw&oe=69AABA3D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
nc_ohc=II-UUNj1HqYQ7kNvwEPpP-X&_nc_oc=Adr0VwQ0X-Jqs7kP6vsranD4YSK-8PGs1t71g6SiXZlC4Im77Swf3O7BUBjOXu3DDRw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I0rijeAHAIOzwsriiQemaJRXeyW2sJBbisDlfiStdog&oe=6A329FE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX0oyNvvGRYQ7kNvwGyrC8B&_nc_oc=AdoLqv7VFT8YxLOe8-MXVQgUMUEeXGGG8vsVFJ8YJUzKY_maQ0wV_flR5dSbe-hNgDo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xyOAyTBlG8QlOpb5PxdrQtgwS6EaBhi_YfsXGHaWeog&oe=6A32B57D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z55RawNQUQQ7kNvwGmn6yz&_nc_oc=Adrp9TfpC3L3RorD4mYCY8TPrllYPlVrfnVzIPBUCCuq4nT_KsrqC-F70NJRz3NbNCs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hNKIqmNYyqETqX0KXHSA0PqRE0hiJXhTZwqpqyhbEkg&oe=6A329397"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWuTVezrvX4Q7kNvwGjJdpX&_nc_oc=AdpnK3XBfpkWRPOdx2lvSvZEEIDeiqfswgZq2Tb0LTmVTKWjrKEZ1zRULoZBSkf3Gzg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IC4Tmz67Enhg7OCOCIkeLFs0G_gFWxv-xEG4VQMEreg&oe=6A32BEEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8r74bIcDhYQ7kNvwHwm5JO&_nc_oc=Adrho2M1WV6Vs55R4bZg7dvdsul92zx6Nmag4j4Og4FPF7eDslLt3pAZiHzi7Vtdv4U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gLyWkKtaKaB_EBHjgk1RDOu14xm9K4naCopKdc00ntQ&oe=6A32BCFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
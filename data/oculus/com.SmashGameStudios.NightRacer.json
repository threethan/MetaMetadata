nc_ohc=BZBfWoPK9Y0Q7kNvwGsq9x6&_nc_oc=AdoMEiJQt0gqb_sg2_9WyilehyHKj1IAmxS9nW9qU2dyILfxXNMNzuSwM3d4oQD6DoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt2WX5pJSHFJZ3GsYkSnRfrAYMUjvEkHxzM52B2fvmZA&oe=6AAA9863"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFUDUjPpH7oQ7kNvwGgJCgg&_nc_oc=AdrrbyHVXFmt07gIBLd7AsbCW1WMSg_Y-u7A77PaH_RvcpOZV0Od_MoGjIJTzk7r1rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqSO5zkeYzVILogNGlB0eccS8mVmUKnMLTa8gTblg0dQ&oe=6AAAADFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ_QSny7lSwQ7kNvwFICJcz&_nc_oc=AdoGfNSUxfUnhbw8MAKYW6YZ2etOkIPg870GVNT0DV3CCh0MfuGwp0mgOqrpTQf3s_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsyMd8rAG-2Z2Ifwt7VEhTWtrYEPQhv39gh4FkI9TQtg&oe=6AAA8C17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTUAZAVxr6gQ7kNvwEBKosN&_nc_oc=AdoJ-BRua5pdpu378g6Ccnm4OY4heBNEXPqp8BW-gl-021Gh9L482YUwnLxQiXETDH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwOixy-ilTk-xRr6Qoip14kPMq7DwA4SDxHGarBcG6hg&oe=6AAAB76A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeHwLiRI4bQQ7kNvwFF1WDQ&_nc_oc=AdqLLF6ad4dmaEBucZGK4UbmWZnqdOa-2zvSsw1hxD_OoKdCf8UmZuIGeuj8bQTPAng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1i38APcyqqdZsg9iz0EeQcRuHI3aNhByzLkmLKJ-Peg&oe=6AAAB57D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
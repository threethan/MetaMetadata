nc_ohc=m-EfNG0hfFAQ7kNvwGizTf4&_nc_oc=Ado8vxg4KTYsz3jR0CQqZsY47x4Q5k8ZE9Huk0lmEl8LNgv_O8Qenn8cWQeoxtEnybY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-_fnW-lG_STPb9TIvYIm2DIAtcttkQNy7DVWhb06-6g&oe=6A9C17E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKmLJXMvJ9EQ7kNvwGLI7--&_nc_oc=AdoPiHz3UygTy0z_uNZrl25ZyzT90EDfCsOUFkqHixQUSGm_Vt1TkcW38GxwEHEv_p8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkeIhX-tBIwp7lrIK_82WPbv5SylmGdQuddNYsIBIMTA&oe=6A9C2D7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s70x05gb4vcQ7kNvwGWYGCh&_nc_oc=AdqD8J_m4JSPQxVQBZ0qZbSQDOVkpsjxJ_PM01TQKl3_vBKa2yCocHu3jbf_8GbiWak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJOkji_3ysQaiEglX_s5CGjlATPIZkBtK9vDbEn7KnTw&oe=6A9C43D7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lGDl2BFukYQ7kNvwFx-rt8&_nc_oc=AdortQERFJcDylK0Ue-9SZDPRaHiL77mNA-7lCd4bdX_zTPzULZBybBDIwqNBHE_99g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcFBREx99776U-abDqFSrY1E-SOvmJjbLRuizbqy57Ag&oe=6A9C36EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIgAFDLx8OkQ7kNvwHURw_T&_nc_oc=AdrUq8uxnNyQPv9_gT2Mnr5zZK2M7u1zkkAA0GrEWeoAeYKiAOG4ZzXtzsk8klDrEQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuWSWZQW-5zZA1sO_bip8CJwl3hgqPRoonK0JqXXlo0w&oe=6A9C34FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=yiONeN_ZFS8Q7kNvwHRxGb8&_nc_oc=AdrxmAec_lAPkXLiBM7v1LOuS7mJipyfhBn9_STuEj1FQ3M28D2qp4Zz-I-DSKWc9fI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDJri_4_LucylAfjzaDuf1S-e11B3H8HD-10fVPf5lOw&oe=6A9EBAE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKmLJXMvJ9EQ7kNvwFDwlsx&_nc_oc=Adrt820hiD8AqCoWmP4l8wCUh_XChoor3zkdl9dPhaqAqY5IfDBZ3VpFuBmEEwOgi_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO0jqnd4d5mgViiC0zWJtsysSRreGCrIJd562RT8ou8w&oe=6A9ED07D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDPvVXj9Mi0Q7kNvwEJ8PPl&_nc_oc=Adq673ScdcLTFe04gccUNCLbQ17Detz-_Y2DK6Qk3CygBLk_Px8JS5gTL5f6dgp5KFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzdWdebyVNjSaadXBCQn4XrQIlg_5zbk9R-MZ_TnKoGw&oe=6A9EAE97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zQx63KPvpcQ7kNvwEwpmQJ&_nc_oc=AdoY-36D37X4vu6NGc6vut2Qto709FAjjEgh-T6etXMlNcsbZ51HtQgnfkyyUVl28Cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz7EAxbQcur0vq7_eCuQrSvoz0neuFU1W5refuqnkgSA&oe=6A9ED9EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFA1HDawYVwQ7kNvwHgyfwf&_nc_oc=AdolqJaGlNWolnd77-1pmbkJMWQ-NEqMD1ey15gZOTcbBXmrb32te6wX1qq7_eUzZx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOyctRc3l4PZZjRJR9DVFGFo_kb_jYabSoiQg-svkRng&oe=6A9ED7FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=0x86NClK57IQ7kNvwHmAW2a&_nc_oc=AdrNQ-8UqM8PRtZ_l119JnONcb7R3kQZZM5mAM3hMeLFOnpixggQC6f1ZkWohuXTcB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPI2qGv8FhRKeDr0wVW6BfPBpKE94UC6IQj3aB19vzvA&oe=6AC101E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-RM2mPuSRYQ7kNvwEv_tnS&_nc_oc=Adr1Re839_zlKz1lfY1ddh6w073HD_txiOrdEBOFBiWIGo3NcCqhOLCxLv8jp9qq1Qs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsi_7ggeSY_kvYm-XkO2nEUbLAg6BGtdUtl1wvjnAKRg&oe=6AC1177D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrZM5bdHL-gQ7kNvwHZIKGR&_nc_oc=Adr64UlttsD0x8fuNZhRI14rWeGhAMqJycWdG2T8l2KRFNnpYQjzcSxsR4h-D4yZrt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhBijBKkNRgqiX6mkJbpoNkmGta7ZZA_ovKTPU3Vchrw&oe=6AC12DD7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvI18B5RXVAQ7kNvwEhnSgf&_nc_oc=Ado3aQmSd2LWhksd91zXOodifwyl3DpOwBTn53C5EXZyjWgUVBltCoBfYQ9OsYQC8JA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQQxCh4cNYYlMoZBC7odV_DHvXoV5y9Akn9bKI26MRVg&oe=6AC120EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVrEdT2bqa8Q7kNvwFw2xKE&_nc_oc=AdqVcSHrZo3rgEwdKb-vLDgNtu8tvPtcekFbAFQU2RloQuTIoHFWvOyhPKCn-1_Sra0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWAOGBiUm9NDqyD6Eh_z7QPGKGCVuHp3mrrm8vUvRbeQ&oe=6AC11EFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
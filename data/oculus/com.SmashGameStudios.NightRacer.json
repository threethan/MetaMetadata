nc_ohc=UEzx7Yr0VPgQ7kNvwEXaFSs&_nc_oc=Adpiyp1o6zTT--pnJbS_aVGefd8lUHoFIYvjJbNDIO8hfCV4C7I3-elFqLZlp3rKYEs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jCF9cT3ovcLHw1kQJp67QxoTSj7oCPeXnb6dNt62otg&oe=69D7A863"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMs0YfkeAIgQ7kNvwEoJJik&_nc_oc=AdposY185HQS_PNm4g9RV07UI2yt7yUoS9gV1BJjrr0iCOqtJUSMRq2sz2f0_EiCKkU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gXBHrT_tsQf-wmMHef93HXBwFv9_PqGXl-h6_rQteFg&oe=69D7BDFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJh8hzLn9YMQ7kNvwGPZzC5&_nc_oc=Adquzy_Ay-RCLAwuGoe8AfrYsSvKlIc-uJUznimCtiUcMT18b_WxujcQFY5Ubd1TyXg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T-KnIP8Q8xx22w5L27I6yGZEEz2Bx3aLu1_HE7hGdFA&oe=69D79C17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RsdGC3sl44Q7kNvwEwSQxR&_nc_oc=Adr43Bsi4U6XN6_tDOQBb9PAeirykfzMDaKG4GZVYcqgELaTsST4wGmytcur2gAhIMs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LczMlDqMCp7HZC6A2_Lu2oWNCG_-Rxew2PbrHQfKKlw&oe=69D78F2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aa-HQqRxBKgQ7kNvwHByHM-&_nc_oc=AdpstJL9LKS5Z3iHofQUEY9b894i2qBOPnyjKODttr69wXGhT3hmgV8-00Pbe-yhpIU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hiVq3VQ-eZpCl51WY0Si0W9KN_HwKNCYAVSqwHSQnig&oe=69D78D3D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
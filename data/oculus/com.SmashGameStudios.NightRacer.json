nc_ohc=q9QaHs5pZRYQ7kNvwGjnw-L&_nc_oc=AdrHBX9FQ8CZCBd9e2DmXGyGFMYP4G6xm0Be3mi6SME2JOUeuK66nPcUJreJQQ_j2wY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DSt_Kq7bOqU8BNQ9EmcnFvG565blfc_XqcPnHAr1zAg&oe=69EB6EE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPUEW1614woQ7kNvwGbwskE&_nc_oc=Adr6F8nGJTY7embk0_GlAuMdRx4CtCnISai4gaUtTOnODtgSoeOHJ1P2Wj7enxZFl98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Si9VsbjycDgU6CZE96IpRNukcUcZ2YCXOAmvElul-oQ&oe=69EB847D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l49eqju-QWIQ7kNvwEMmP0-&_nc_oc=Adq1EdGvabk6smL2mxaRcgTcV7vnz82Y3d8LmLmU12ge3qfkkj7fQhjd707Nm_5KPOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19ma2JGpzZMC6ApGwH58BNCQ22yOAPKyW5caSxiYJkmw&oe=69EB6297"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dC8yFG78BUQ7kNvwHPoQS8&_nc_oc=AdqX3JfNDJ5KBdutcnbAZMyxVSZR-7HFpdg1aZ4OqoWomATXIZ0RTk6PLmU0-TvRn_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aA97FDWBi6rkPLbs4WVKWBEqvAdcPj0xoBh32WpMS2g&oe=69EB55AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6AjFiJBxcAQ7kNvwEzoZbp&_nc_oc=Adr02MKNNSMA1g_9FzvMFXqblcQKiFlI6JkkWIP_JnYBvr-uVbv3lfqhBNWE7-3IntY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OIbxp3ODA3tF4nTm7O3rRqZMbZFBTUiGhhHOVhWT2gQ&oe=69EB8BFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
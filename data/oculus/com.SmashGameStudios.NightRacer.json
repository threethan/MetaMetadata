nc_ohc=TxbQQRo4DjEQ7kNvwGQZEbP&_nc_oc=AdpduH0uK42SPulCK9PNBvvP1TyTY0_BEcINhs44WqM2Tl_2X6BD8kIzCnjy58ygow0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XgeI0wigzGNXV04TqdjiFxK_c-3bX2huSqy4EEev-AQ&oe=6A202AE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc1Jw_JRgpEQ7kNvwEjx0gw&_nc_oc=AdpQvjuJ1V17Y50pw7Jkxhn_z5j7VkQCvE8hmi5VdukjCyHckZPs4bRXwaHjuXvkMy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-0Ay7NKZRWA7U3Q8MYZk_6vZTINn5pEYWGwlW65u35A&oe=6A20407D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXwDt9ZyMvcQ7kNvwEb75TK&_nc_oc=Ado5HVqtQ-ScUlUylh1Vi51tw1ixe4ZW4tecRyS27V3UX5FuAbG_dDk237JkRL0pM9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49JNFOLBxtNqac5I2oUU0yrUsOz4dfgwa5wdcPAIS-cg&oe=6A201E97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZrnnZbddZ0Q7kNvwEfQG7W&_nc_oc=AdrB8MmECmWFp3u5MXf7b3hoOjzrRhOjwSCU2vIFXWN4vbt4OYC4IuADtfTqkXfv7qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y6FNgZ09OrUGuOTz7q0sbH7UAmKSu0jQnmu1KDj1MRQ&oe=6A2049EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqOxExZyQxIQ7kNvwHrdqqE&_nc_oc=AdrOiV5mT-yKxD_05mjUSlREHdga0l4Zf03LHbrItQRWiws2BFXbCIABMtGvED8dfrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JyRk1PyBwT5pUjO_CqVHESiVRZs47kldVfqilwAckKA&oe=6A2047FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
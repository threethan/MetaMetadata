nc_ohc=b6VfBrb-rhUQ7kNvwHGWyj_&_nc_oc=Ado2kV8PcZ0lazWxzfrmfuwmBHdezWPYBUzFYTZsKafx8n15pmqLl8jFoI8eO-Yq2Lw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0F11XyoMe-nu7jjM5edwghudCe__YrjGBYecFzxjYyDA&oe=69E23463"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm7eqRHRfeEQ7kNvwE00yvg&_nc_oc=AdqsL_slI7cIuGFDVR4TKIeUXvFOoCiqRo4BGBwirJd_v9q1IyM7_TrfVtkLErTd4-c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H9elZs0wN1M172ucJEadFiVvHGgOT7_EBDHAoJXCFHA&oe=69E249FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REONfbjUetMQ7kNvwEcXnkf&_nc_oc=AdqwnPMa1itHxc1niRnKu0o78OEp2rPbqup90_LKjrsnzpmsEao9KRxnzQ2FFbi355U&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jJsMS6VQQmRZI-LOWEZ7dONU8D91bawYtmc6OGo1eIQ&oe=69E22817"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1umd3sAs5sQ7kNvwFgonsh&_nc_oc=AdriAj3nr0SWPEFScQwFfW_64fupJBh-eVT-ab0jQf-_c56cGSnc--UPgNyZmD3aqao&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oDRMCwQRRNJiA3XmRZQV6Mxl7F5K91SnvoUC6Cd0HDw&oe=69E21B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw8XHt0hDRsQ7kNvwGrJwh6&_nc_oc=AdpT-QFV1mNLnpvK8NIKkEQCABhknfDZ3GAAK7fB1GuVVonT-EM2wWxMhLKOtK5x4SQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TzfXgXiWumqj5fyOXfiCD-sRnJRbaQGhtriO8XrSPgw&oe=69E2193D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
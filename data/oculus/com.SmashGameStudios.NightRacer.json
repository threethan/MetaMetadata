nc_ohc=gmDV8r8TeukQ7kNvwFKRHx-&_nc_oc=AdqVNgw7ZxvjIabytnhdeUdKR_CYy5l5qrSWXS9mLW4CdlDwJFFFwGzhkXpoErlpc1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ERbSjEB_hrfj5uuTJCUBPzi_Itgw3PN2ofU6PaYFoxw&oe=6A2EAB63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9oxMkOF70EQ7kNvwG2MLOD&_nc_oc=Adr2miPV7krnEJENhPmQy0ijAF-nWA6mYt18YdZnaNnXpImr2U6lok_X8fC3IreqoG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UmvsBVmoGhQ_kLPfbkCFinEClncZX3uRLRNlFqqNEqg&oe=6A2EC0FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fju3Etj42PwQ7kNvwErnLKa&_nc_oc=AdoPCEyP9Id0bHf0sret-KN83Em_L7PhoA8wDwHkh-VkO3dJmwH7Qunxo2TpI8Qt2MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lsaZnZooMNRD0UGheA_8NS-4u4vatRkWda9YrMz-7NA&oe=6A2E9F17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vISDKxWF8jUQ7kNvwFHz1Gp&_nc_oc=AdqiPYKwa8moWeFXkbD3miu0xWQ_c_39Gy4fOkl8fnuqRKC5_7BIfLNXIt8Oc4r6f0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tPFQmQiWaO8BtjyBkZcMt88lkK6nhR-y8e9XuVJguAw&oe=6A2ECA6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J840NDtIqsQ7kNvwEjmMqV&_nc_oc=AdoJ3sXmmrVjqkNCufy4itMWITPYC4kxibwJ6Mwxtof2IwWKWbxw7cZIwcAkd0gwD6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xxxGnk1Ibh9gbtSCY9ogJLbxd0RojQhIhvv0_DtCabg&oe=6A2EC87D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
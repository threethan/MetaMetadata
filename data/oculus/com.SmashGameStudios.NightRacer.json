nc_ohc=QGqk2BA0DVoQ7kNvwEKHDWo&_nc_oc=AdqHYAzkwOPxfeF6VfOw8N8BFUZjzvrJWDPkfCGoZIwWDbVTp-E8E0zflqmUFRZscHI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRExyHBBYotbhtwY2RS-HyLt1qSy64rv5pbufiVJ_DBw&oe=69C29063"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChlfFM4Iq7IQ7kNvwEQHugJ&_nc_oc=AdpgHIonT2FHnUAaAV8hy3AEb18rqjhLWB2Yus2rcCKCZOU07ag9DWN06QBvV4FoGfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUCmJkJ9rgTAn2zLJ75V2ONj_KItXXKgTxX1cjHaBlHQ&oe=69C26DBD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAy_OZg-J6kQ7kNvwEkl8oC&_nc_oc=AdoZWz2-WKeIrA8NmXJretD7QBa4Fm5DhnLYWVTJbxZIPpdgQdeueb_fRX0yfL1VGsA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8_YiqCnX4iGZyV2wuXkdsB9L80xnrzmnzsJ8ga-SwzQ&oe=69C28417"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3xi_9yR7_MQ7kNvwGbDeLu&_nc_oc=AdphxWc2jTP0ihZEAxb6rQJmi7aWRPyui_vL_I2kXESsVKZqyjUVKqcPCIdzAqq14f8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIWBwY0ckOkbDwzAXXRk7w1Iw1_pPnjrM4QzhocVI-dQ&oe=69C2772A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mBMkwF3llEQ7kNvwGYuiKo&_nc_oc=AdqQ8NgEGyMw9o5sdOoB9XWQeUZYmryKIPLjosBb0mdDrW-UEGlyO--IIXUHO1ndons&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVyK7RkzuUnltnFLTnrlGP-6KSU6pBBP7dSqGVpkwLmA&oe=69C2753D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
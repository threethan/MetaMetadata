nc_ohc=9tBFqYRLYygQ7kNvwHgHHR8&_nc_oc=AdoGZ8jX4NMSZc7mXopikvakUGVomVAdF4ZmjEDgA2Nl35lJ2lopq8eHDslr92O--Sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyqx-oLHxnld8uyuRGcp3d8xV1VZ-YW8N9TrsJIQDnuQ&oe=6A4FA0E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp1JpVVtSmYQ7kNvwFt3oc8&_nc_oc=AdrgmXbsqHItJquJMaCPhFKslCJ4X1-zNvbXLP2MUVrR1Exs5Vzbl8NwHk7KtaaNqWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC28xHBHu3kgbYv-1UCclfZPRuPa0TV8QbV5lUwnZocIQ&oe=6A4FB67D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3U-f-fg-ucQ7kNvwFVeWb5&_nc_oc=AdpD2NPJ4fIKHYkEXXacjnTon3UGXZUgdlE4bAtjOpfmJd91nOJmyBBGy4tapERG59c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnhy6HQxm2DQc68N9ig3jQagDilBbalrIAhYGfh0PtIA&oe=6A4F9497"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7-a4B7f22gQ7kNvwH9Wq17&_nc_oc=AdqRf1rQHMId3NsITBAfgTND-TYpE8Ntvxq2Qp_XavAGyWE4PZ5g21kdo08zBg3obaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFLsLcUl_3-0sn_Dg0uUEGvoUvpODkeYsnr6WUBsboCQ&oe=6A4FBFEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlWIiZUmmMAQ7kNvwG8nO0Y&_nc_oc=Adrrk2A2kVTdgSQMuRaJDNAxdfZEDqMEGARPBUQP_Y06siK4w4zQE5WNZFdgXQ0BWrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq0-XgITAD2LZKJRuKuLpxJrZROQSa4CwfxpyEh62E9A&oe=6A4FBDFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
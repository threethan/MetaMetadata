nc_ohc=s7xk8CzofdwQ7kNvwEhPr0Z&_nc_oc=AdqhyuyLaD1hU5mVpNU4WiFPttqXdA8ZbEm8w6GcA9d5GZvWuuLHC3s5Ux0R6Ac1InM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99RQ58aQwkvfOdM58bsng-sl3R9BGUgQW6JngRmZjMZg&oe=6A3D2BE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6w4QU_BFDMQ7kNvwFZlnUu&_nc_oc=AdrluJqaOzYdA-zXk2EtiLdhiaRNqixNfqhaEemtiyVfMpsSLfjtPAE26WCC0lfaWBg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86exNwGIigRisBLdrr9XqsafPzpLdW7-23tUhPNVCHsw&oe=6A3D417D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjtHqfaBx8wQ7kNvwHCkjZD&_nc_oc=AdpjVdEpmjKdoAFPEqHh2pnAt3U9BYkkAY7nxg9mgexJ_ef3yn1oJR-h1vcZulYRkew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y77AS98K8eCvajKW273flCYCvQnE36F6EuF2JHni2uw&oe=6A3D57D7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TosRvfBHozMQ7kNvwFTWmuF&_nc_oc=Adpa8rGX6FJlY7TmPI5JsU-b9inqcxKJWCbR9PZdccxWVktoNOBNS-OO7m0d6qPGDlg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n7mK_9vJq_lKgy5Iq4QazR5eBoQ77njAPZ0NaCDKaiw&oe=6A3D4AEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhZEq4eFndUQ7kNvwH5FPq2&_nc_oc=AdrWh1eiMnmTgLVKF03uRzNoIuDfxj9wB8xCmjCo3NB1dKRACPOTr5HYMTncJy0Y_j4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AC6LY3-5Vheg94ljyIR7JqtIIDo-cuz0MT04jyCLxCg&oe=6A3D48FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
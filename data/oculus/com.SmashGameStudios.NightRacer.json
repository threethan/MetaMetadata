a&_nc_ohc=QC0Dft_9J0YQ7kNvwFXkMxx&_nc_oc=AdobeVktBcA4vxXCop7gVzqtmBAdKIo6vWyOFl2E9CdWxW-aYDuH5NKUSBxdNWcI6c4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lMTSFiuf4PIMV4mPqDd8qnZzcyvxBCQY7UK47tITi2A&oe=6A11AA63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgJxCzgwFNAQ7kNvwF0wBMh&_nc_oc=AdoHwLcOXG5mdqKlzDPtQ9cBaxepKXIGpI8gZwoG7P2pqLaSSPQy4sD8Rfk7J4e7yLA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qhyXaXMpuebFH55ncPW6y00Jp63bzxsOQWh78sOS1qA&oe=6A11BFFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfIR0ltEmpsQ7kNvwEBvrcg&_nc_oc=Adq8It0VJ28r2VYB5pfD5hYQFSaf6VVAu81IrAHR3r5Uocrnq6qR_8H2T-Y2dEhrEP0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74ayGOouTF5sQmkiOYqgChE-nAlYI8BzrfqIvkAeCKsA&oe=6A119E17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hijLD16D9oMQ7kNvwEQkXdl&_nc_oc=AdobH-vHpWEyMDSvcJsXYjESvFVgHEBvlzGJQ2_3dUjmxPlMaybrfwfO57dejag4D6c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cjMRjAVF3NYrZ_IvYbagVlxMHPjNFYxukftNvYDmUXA&oe=6A11C96A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXQvn_u11HoQ7kNvwHJzQrQ&_nc_oc=Adowhc46UKBgCwt7LCb0jpD8hyIdhoLyBFzY6RkmIxdQedWmu-cg3x1GZqv7Lgfe3cw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61SLW7wZO4jRCMTv7uEM5_nRhRp4nEk1Wy-uqbwYKR7A&oe=6A11C77D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "exte
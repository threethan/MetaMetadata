nc_ohc=yRDurfLiDpoQ7kNvwHst8gm&_nc_oc=AdrMnjp0aRUGxdkC1w6QJZDx7wXe536rtJZ6mur79RuFRwWYpEqoC1Fp_cb0cB9cWLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI7s4TlIF641vT5a7cdgqpE6wKdG6HPIaxT_FGcBeMwg&oe=6ABD0D63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jed826CvzLoQ7kNvwGwEefu&_nc_oc=AdoQLYK8PdC_Sy3AW4-wDhRuWazzMAIYKyn2z2HUheF-6uwUEb8aLsbEaWOdFtHNtpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-xr4gubZ3yOyQPrLqdRsvusxD9rcLjy98Y08tLtXQ8A&oe=6ABD22FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8ZxTrBiOrwQ7kNvwHPtJWp&_nc_oc=AdrGo2pIfv9-F_uXNn3ATUktRy4tKbYcaiVN7YGuPlPSFGwBYLSnmF4_mJXrWTR-W0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD0LKO9Av-lJdr5DYLgYaHeF_aKUp_mgN_DIYN0feSNA&oe=6ABD0117"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu7xaZ1beQgQ7kNvwFUjVXW&_nc_oc=AdpnRhmFP2h5I_yHOPcJlsi9nc898lw_JUMop9qCqizKB1Nzr13CtZr9Fmv7KiNt5jQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoW5WBx_A1WXVtpcZyAbGaiMwvQR9eNmNxR-dPpUHx8w&oe=6ABD2C6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isTxbfZZMQQQ7kNvwENhck8&_nc_oc=AdrqyEGjvBhF8urKoTitapIz6UbqvtDbpcCbZr6jiAVAI5itbnjrd_ll6uTIh9I6h1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpfMJ0ySL-csn2U_d0iLy1XrFwbznyGUoBnHxhNYrYVQ&oe=6ABD2A7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
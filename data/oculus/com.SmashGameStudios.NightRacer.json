nc_ohc=lNfBWn9r-hIQ7kNvwFBdKoY&_nc_oc=Adp0Gvb1IM8gv0ln5r1_mk0rIs2YHx94BFTHyU_TKzSBfLjS7hr4sSENyZLA3D_Pf_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkgYnqtl5AVUxLKkO64oaiiUU7GiNcwbCBiM-tfNKfDw&oe=6AE9E063"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPCc54k5PBoQ7kNvwGnpPxu&_nc_oc=AdrSgnGLtPl8Y6VbDHURa0ru7g4ELg5Lh7VCRcfMGiSEPBNMRg8RUJt4EnbyeilX5LQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgxugx3sYYlJkprQCgGxZBi2fNhoZ4Rm8LjJ-6biamZQ&oe=6AE9F5FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeJhwLwppo0Q7kNvwGlfr4V&_nc_oc=AdqiIT3i-TvOzuTVp8rXE-nEhTKb_jueRGENqIP_brZr6C4BmXpzM0l5FhKykKnZ21o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkab9pKTseq7CgMUxWVJy4na_v-MSAAeoZE8aA1lxyPA&oe=6AEA0C57"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za6j3FRmbjYQ7kNvwE8Gocq&_nc_oc=AdrTvpXYyTZ9RWdEriYZub-KDaRrA0YWLxznvdpkw317p8UJVxt-NS7CFFeUGz1j80I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZY5ceJCP0e2SlVd47rqHRNleXB9PxIZOUNA6FKwHm2A&oe=6AE9FF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w8DjSWGLHkQ7kNvwHoI1b9&_nc_oc=AdrkkYOJCNvHWb18pRZDZzfmgpxt_G-pk1xs7p3F5SnkknCFJlHp2sDj0T5NKrgCmbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd_6KuoL09e47o6VCwVFKRYf8lPD3Si8WMDNE8j6G_pw&oe=6AE9FD7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
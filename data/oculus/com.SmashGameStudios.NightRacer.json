nc_ohc=5zrCXMwswCkQ7kNvwH4t4UU&_nc_oc=AdomszK6zHgO7kyUbPulTSKPgBqA4OJqB6koPll2v_ClA5XnvaLr_ErkFgXTn4j0GfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JOYbmq1zPRcxdmDge6Myxpza5BmciLQjw0El4PfIRDA&oe=69E4D763"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm7eqRHRfeEQ7kNvwFYIqPV&_nc_oc=Adrz9ZsfOEAVgvlPKL_8KpRqaCDs9Wp__UB73bM5tcYb_1qWdy3vnJJgrd3XqMFAAPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IDWFKD2uNbEvuj91ZM2ZMnLsTcaJBYXf3rnhqxmeLeA&oe=69E4ECFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPOdsylnm1IQ7kNvwEgqqBO&_nc_oc=Ado9EG3mGzbVET8PqUwQZfLwNHsqTUJ0Qq7eyeA0LTaCHsARZrdRvx3_Gu2VaE0K-8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ovp9jb7A3OKQjtbxa6aT0EqJRrsy3jo7mY2R-OwM9sA&oe=69E4CB17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMpUufTQWo8Q7kNvwGJ2b1x&_nc_oc=AdplxHlJ_lksUKC3PZmpKBPISvGNvT6a-dgQN2ROtoGsLqYJZrv0xT3zpBOGLbXvm48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26BRwCRHEWPujb_JG8M-6-NRVaQ4NuzMzrzY4jlTCoqg&oe=69E4BE2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSN_MsiziYoQ7kNvwHRYkOQ&_nc_oc=AdoH16PDOUtnm-CBYLWqvAx1ep_jDOVHJkOs5D-5Wgfuwifu89fVrdbyscoXG4Vzp1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fT69nJ79_8s8w_f8qxj4SlEQUg9eHazc5EVxa6kNvEw&oe=69E4BC3D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
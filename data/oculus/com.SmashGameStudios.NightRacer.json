nc_ohc=dXbcPQaqMJsQ7kNvwGiqhaz&_nc_oc=AdpHcLFbX-SZrz4DCTSTQlWqiBCEx0Fyn2HJH89hZQr99XykLfLj_S0PG65H4HkB5xA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lOg_M4PWJxhlrC6jr7TmaIiqYibhL9sdotZvC9ZN-fA&oe=69F89DE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQGXUSfY0zEQ7kNvwFslRfC&_nc_oc=AdoodWNF2ruVf9IJGr-CHGOqd3f4ZT9it9XkF0DMTYZXZVAUMwgQkStX24AO9SrrV5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VqjgJM4-PLn_KWAFR83Atl_k2Zt-V4WYnnV-dqCu7Rw&oe=69F8B37D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGS5U0fIFWEQ7kNvwH1PxZC&_nc_oc=Adr8_h8Ntpz-PZcp47NrzPbfoZHtvcwnMyjWCN9vPUi9rYY2mfoMGCYHxt96BroLW3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QQ5iNDEqrPUtBHAvGGt7qOzxU18l-eVY-glxYAasooQ&oe=69F89197"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyRAocSTmD0Q7kNvwFD_fed&_nc_oc=AdoiSTXmTiUDUiqIoin0B65lMzyrwOxpwuxACqLprDdASg77iRTiF9CpUgslU_N0X-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bcrFU9TlKWuQmbsvyH886w-UhXNgcIJlwl1XvwlX8fg&oe=69F8BCEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q6CcaijDQEQ7kNvwEtNoEU&_nc_oc=AdpACYQpmaRMLiUAM7Sfizx6X4jFl2QHfSSNZ9MHmz7XjB2yP4wu9r2DWdsVLM2Ds_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lV3Z1EgZnRA3QauEAQckmaCrCJ3HKb9dOlBR9QVgnzA&oe=69F8BAFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
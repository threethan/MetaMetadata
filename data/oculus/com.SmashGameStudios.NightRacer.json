nc_ohc=Hrha2OSr0yMQ7kNvwHzduPT&_nc_oc=AdoZO4sXTdqWqtlvvGZaPh_JVckzQumWLx3FllRD3_YvemSldVNtE4fLHcFk-IQx4VU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TSvj4VlIltz6BE6bukdQMl3VGa3BMZLSf0SfhJpa2nQ&oe=6A0DB5E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvqvqb_Js8gQ7kNvwG8fvr9&_nc_oc=Ado85H1w5qPc96rmW_x_N_MNbkXbA65oGBXT4Z_s6FlDLm_4BdAXiqWkkODCQAQtcvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_tiOhSkDVakht3Uq258vSEwhNcWYPULAaJtuybPqn3w&oe=6A0DCB7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Yyp90wv4xgQ7kNvwE4BiKs&_nc_oc=AdqHqwhfdUEwJAZ3NUofj5qJYYsHH2hhOTBe7tSWKZ9ZuVDsMulgexpgckzDRrJJ0LE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R6Pg5_LGA-Q8Zy9456VBPfy_yVDltMpoeU6Wp6uSaYg&oe=6A0DA997"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2cpYHwoZiQQ7kNvwFJATTq&_nc_oc=Ado2kWjXZd9WAHzF1PSarS_qj7xnYsXP7-sR74Y55FeWVdHk6USOuFtaPi_TGSvAbn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qDUGUKRzv6kDzlDtomz3Qv0O4tw1vEkKq1tq7bw52Bg&oe=6A0DD4EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5b9ePU7SEoQ7kNvwESZQoT&_nc_oc=AdpES2gjOTV2OLWtxHIEwGvtzfwyZjLCTremFH3nG4rey_f3WAr5NM_ZWB20OaaXa2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_bkCbEk3eGY_ndHep9ba7f-TVuOSXgLLIjWc8Cnr8-g&oe=6A0DD2FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
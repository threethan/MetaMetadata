nc_ohc=s7xk8CzofdwQ7kNvwE4EMXO&_nc_oc=AdqN57TdBIFTXN6QhTamZns6iRGMKq-2a7cHO_RiSVqpZerPmOW6aXNhzq54LNZmJro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86PMus9vGCYlkGIYN7gSh3uh2AvaUKTrRCGq0qj9Im8Q&oe=6A3BDA63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlZ4Vwt0hNsQ7kNvwGCcFSs&_nc_oc=AdoZosypqAQNco0HtlMw5IYFJ4fTqkiWQVtRm4dSTvrEOTUfOIfEPT57TWgtWL5VMbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m6Kyyq5brpuMOAok5uidHYM-Mno0fFwbL3n5KlGtreQ&oe=6A3BEFFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjtHqfaBx8wQ7kNvwFUtFIN&_nc_oc=AdqmQHFcSb2cK1AZczh1CMkx05BCONnSS6y4Sl_UzBEM239fScduOD9dTRim_ChxU70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SIqusMzfipg6xhuBZ6_0L3is6tPqqbaRApz3k_mOzRQ&oe=6A3BCE17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TosRvfBHozMQ7kNvwElxCq6&_nc_oc=AdrDq7YZQAO3pEwAuh-0f7oWecxU2yaY3OZzuMsS-GQxzNNh-96fILsrN4ZqIR5H9aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91_IUqUjATaZV1QJvbJsDvoq-3y9HIYUA6YIsA4CdoaA&oe=6A3BF96A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhZEq4eFndUQ7kNvwGJAu9A&_nc_oc=Adr9PkO6GZ5R_AAB-wLuF0ntIgy-L2EsJJ4DblVFg4bxGYO1qgfR79vPuQHlX8_dbaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XyifUCT6MHeRO16TUF9j8d8AHkHRnZAohHVEXajPDWw&oe=6A3BF77D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
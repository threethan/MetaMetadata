nc_ohc=tiwpLPEwDFwQ7kNvwEXkfmN&_nc_oc=AdrsgGu3PoVLLOjeuH-8ofV6qjyjSHuAt9PjKxyasue8f7DH4RhwyE2RQq-Ywihzk80&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvDu0BaJWDX3t2H6OQmrYHPq-l2y4BdzILulHnYL-5Pg&oe=6A974263"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNe-FK7SQl0Q7kNvwHvW3Xd&_nc_oc=AdqoHhKbbl_HpEFgrWBXCBSCACBuxKVUMtz0BcmOGcCV7TZk992gLQEF-I86h7LyLL0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_MUaU_bpzSUXRNZJwpOwgZ0QKblBbLTOZ2iMEB03qEA&oe=6A971FBD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gaxchLrC7EQ7kNvwGY-sfO&_nc_oc=AdqgskuGcGaoYWqk6pI6HcwqNLmbp6PeIu7ML_Iwuu1Vq-8vprFXlEHZi3Yz2E33PnA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVclAfD94aldN9aopHp_nVS9Tmm7ErN-k-EkoVAmIqyQ&oe=6A973617"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crerLlfUv08Q7kNvwHVL7Ng&_nc_oc=Adon9JPrcihMdyc-svr0XDFPRnoDogiUZsM-iUr1qnNydTXA3xaSgWUbKQw8gsaYcbI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo5YgTdXrQH6_4O7whzJXaXc2uiXbhZ5HA-FzmNZIQVA&oe=6A97292A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYyxLadwXs0Q7kNvwF3p1k8&_nc_oc=Adrc6whWhC0YRpcyXK75cp2LOAB2wFVFl-a_Xj6DIPHxoP7DFBZKisKBAi1zjr2imV4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF06C-mnyV7pEcntOEeu9_HbKBa8Ww3lz_0VWf1AQUG9A&oe=6A97273D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
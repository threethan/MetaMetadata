nc_ohc=Ap9pBiF6gn4Q7kNvwGSmsBl&_nc_oc=AdqOPdyxCAQT6EUJZ0by5Ksi10RUSzr7ZbG73RiJ4EVpcHSXsHJwxT3wKUkFVx0yh2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZWav_sZAE-63R_i0qJ0tJKaUCeMuWr1hs9IpcBFFBPQ&oe=69C927E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JTpuy0hsOYQ7kNvwGnryPD&_nc_oc=Adq1eP7d_LAAnR0PydSGkhtZmdsjPjxlA-Jnt53UdWXShc05Wlk3ZVBXuhg5vLpJRHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKTby7ai58CWBoCOWd94-k0omFGwL-lw4Mz4CyiUcybw&oe=69C9053D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SSzmMuyDHAQ7kNvwFe87sE&_nc_oc=AdoyLAuBJ6BAhOaa9sCzTeS2Dzpx6WTIBVVUjvQp1rPeXdZuR4xShXSSGMIZl-jAWfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYizCMuMWyNZ1TuDYtSZ9ExmNWaQxDGvZsshE9hnx2dg&oe=69C91B97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdocJnaW6DoQ7kNvwE_8i0y&_nc_oc=Adq6GQMVqTgW2ftgJ_i1BcVU3cPRnBhCE7vEwUnc29jI4o4TvRCAOIfKeZ3y8xw2BYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq-WT-K9v9ayOPJbR7YzmT0Qp8a2c6EdKl6vON6z_f4A&oe=69C90EAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDD4CSQTQQYQ7kNvwGCqauY&_nc_oc=AdqOhIt5RxY5kkkvXGGueJOtLEpUD8r8NeYixuSb8VBQz43nO58yTfxcFxubbOstaX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1tWayqeHcQIZvaREGHPODryh_O5o3LhJtzcdVe6YzAw&oe=69C90CBD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=UEzx7Yr0VPgQ7kNvwGRIVyJ&_nc_oc=AdoPG4cY02_0JDf1BgKEh-Cff4LLKZ90nhi8hDdrLU9XeoOQsVCZtqIXFgERz9toldg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wc3CBjJcKjQ7Jkrjwdta7mchJZU_Qty15O1-Clqi5lg&oe=69D656E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMs0YfkeAIgQ7kNvwHYlcSk&_nc_oc=AdqXWAjMW-jl6tCMc6HYKdW1s01bkzNICfCZcWVZ8EvnF3AKj8UOsSltbHKfKjkCP7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c4K6Kd_xNeaFBpcsoFvASRi-YRYpMASwMU3HPgq976w&oe=69D6343D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJh8hzLn9YMQ7kNvwG95_k9&_nc_oc=AdoKKEEn9wji3rPon1r59aPHW1NyL0wofR4_1e4yXgOU-VJ6CWGeHsdl3m0PmX3I0Rw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vml5C3zxDtzqEmQcBoSjZm8l_8WoIMSkY444OL_pXzg&oe=69D64A97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiWxiTC7rFMQ7kNvwE8mwBu&_nc_oc=AdqujutXAuroBFeBNfUpKfGgEXyuKnp-AIXo9F_hEvOjPza_t2yn14Grq7sIAc2ImgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af252UENWhQS_CCqQTX4GmmTIB42fBTNJwKLZXRMWUu0VQ&oe=69D63DAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qRLcCwaRUcQ7kNvwFIPm1N&_nc_oc=Adrrjca4S2NoVTvrTWC3WxPgl6xuSehGpKJMwDGVgJHBRmiwip__bL2b7wBEFckd9eY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fKW7uyPVJKDgWnnMR9eN7n7MueE1Cx2Nx5eZR6XniyQ&oe=69D63BBD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
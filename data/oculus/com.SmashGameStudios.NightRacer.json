nc_ohc=yY3NLXKjfhcQ7kNvwFSoc5f&_nc_oc=AdqPC-02vxTBHljbmBtBVhdFVrUPlzW7Egd1y2DTD2gov35BDfmA6YdMVls8m799uo0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VS_IeUFyC72yBPP8pshLa1AOycoUK2m1iEmKEiLBzEQ&oe=6A1AE4E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5dEhhYjSGsQ7kNvwFZovH8&_nc_oc=AdpjZZCGh4EXVa1XGo0vilphAwc9IUizlBFuou8u513BoG0gifNonvEbe3DDYwlE6Ec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vsDVQisByt3DpZaLB5kw5dtxkKFr9ivfVC1SwpfreMg&oe=6A1AFA7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSVNA9iOoIQQ7kNvwHXyGWY&_nc_oc=AdpbWPtex6sDIy7lpT_EfY6ygu1GFHSEs5Qi3t9wa3RXXTbYivEhVz5yLlwM7pVxOsA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lPEj7kp5CmLNXLwWL07G7no8Y20YvrdrhSdY4vpSw0w&oe=6A1AD897"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-T_y_GuL94Q7kNvwGqkrla&_nc_oc=AdozOi01iiC2CsXKvNr8eGkN2ccJKrZhvyfHN6D9hmqH_KZ2VeYjvUO8p8uqew-OdHc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kdDRNwXiNb_PVgPsC2BqgcW38JlZaCPugBknSpPCT-Q&oe=6A1B03EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQQ13gVGKmgQ7kNvwEVnHhe&_nc_oc=AdoWmStuBXXVTV6GPIu-FjptHzsALW0H4oQpHiLSmpIwzOgocOy92nOAImsCYCf94xI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af613dYpEk_nZuV5JWGA1kauRzUbDScGrOaYcGH2I-IBQA&oe=6A1B01FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=1HOxm27GjU0Q7kNvwFiU2wr&_nc_oc=AdoqEPmoH9WJwsdCDI82vttwKxqWJOOUq9ny127ufyXBIB-MDZLuyVLHPpRV5hCwb2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X5D3S0AZBHbtkVh9puOQZLzVLr--NkkNCmgGE7S867w&oe=69ECC063"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPUEW1614woQ7kNvwGl85uz&_nc_oc=AdpNLwQJ4Vci6PYe7-XkER0XpDBKQyId1vEuL4yLJK9atF15kWObYB1qfUwUso-gjj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ts2Ll79cVK9v5vltmfj1hkxGwyiBc2QFRPaHg_19kaA&oe=69ECD5FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDYv-nlIbOkQ7kNvwFHXhij&_nc_oc=AdqoNGMRibDB1UZnyW_rUazGdQ5hWQTU6gHLttBrqGe_26iyoL8flWiDpF1H-Q6-sDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E5A_NYlg_AQyu6v0fM1JHjEKInEns-Z0oxo4r-L8Qng&oe=69ECB417"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dC8yFG78BUQ7kNvwGxYnbk&_nc_oc=AdqL_7tIL2_F7vDBtuxBr9dYoxRLyndFanx9G7SKceOZrzJJtdh8kwpSaL2IJBYkoJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nYkmVcKV5O7W5opXvSrtuFQ66osZWuVw2_dvtGCH2hA&oe=69ECA72A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6AjFiJBxcAQ7kNvwHbTZRR&_nc_oc=AdqYPjQCfjsCQpnDbYLipsR-jTT4Wk697CToPU8UU6-oIQUgoHssaqQqBVS_opBQo58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GrNibWAAe39EMODWyBKa90E7abou1d2lRVFucWJTAQA&oe=69ECA53D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=JUZbfpblFDwQ7kNvwHAv5Zs&_nc_oc=AdrEWMwjEFhQo93A6rGsKaJYyJ_QaNcSxBXs1thsSGdFP5JNP_1AZhJVmt8GIeTA6yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mbyoK3ERJiGlBEkudsF3TtbW5X97O1Q7MIyOOhixOHw&oe=6A144D63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgJxCzgwFNAQ7kNvwF-KJlZ&_nc_oc=Adr4pvZTjEkaa0YgE6fzRh1HYAf857wq-A0HPK_m3h0DOoVCGodfLCIzOwXvOSnJhmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tiNmFCa97nv5LufnbSE63ZbOwHY51tW8Il5Expkf2AA&oe=6A1462FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZWJu45Wx_sQ7kNvwF8STuT&_nc_oc=AdrYmIx7RUjJjM5rrhJqCz3BPHIQuolYqSp30LdiCPKSgj45kjxJ02MzNS9nqkkYy8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RJ1_ErDl7G9O5bo3WJfBr4ALgpczL4Pu2sZ9Cr2ys-w&oe=6A147957"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcZKSaI3jocQ7kNvwF794_w&_nc_oc=AdoxW-0qCYuZ2eCsFAudrbH1FT-g_6iJ2IEZas_vEn_KJ8AG5UJkqToDGtXbk-zS_TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Opws6IK0bTMkFLXIx64qtO8oPALghZ6TARf-MKRxnhQ&oe=6A146C6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzIQybq2sa0Q7kNvwG8G3e2&_nc_oc=Adpkc5xe7QIZwkm6bztkT0up8qDWVs6bfCJcctXx60d8xzbQ3dbXu_USXO_DErVX5wU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WrZdmiWEupmLr5LlcujDFo1NOKINmjKcyYxMoMSrGIw&oe=6A146A7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=F0prNnGvq9kQ7kNvwGcT2_Q&_nc_oc=Adoo2XwkzRPrJe5Y1mpEmckuFn4s0yFYfFWoygPtybeCRbbKkiPnvSpMSeJZ7iP4qAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTf-y562dZV0DokB2x2DMgRhp0mQgqtKItV209iDVXVg&oe=6A95B8A3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNe-FK7SQl0Q7kNvwEgfSyh&_nc_oc=AdpYv0qjSkiI9nOkjdS4JlsiHS_y_dTRNDIYf5bH9214CjPUI_R7NhiF0OVK75GdKeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOKPH8756gpFqYgWxf26Z5SNvUjGw6fmvX8dYrgwnx-g&oe=6A95CE3D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gaxchLrC7EQ7kNvwGRLwDN&_nc_oc=AdqnTV3LZ3Cnh0XsAl4hdjPEtJnV9g_t009LnK_NBXAS5Apn0zSfpEtlfJCLNeNbztY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1fsC5XFvQt2ELuPGndJ_emWK80NOnP8j1wTNpV5ejbg&oe=6A95E497"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crerLlfUv08Q7kNvwGHXWCR&_nc_oc=AdqXtRMbHkOIwApKEmR2O8o9vJot-bfK_9748gxi56d9wSCiNhnEGEJyOywwATF8m7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHFiVVRC-lDNlytAZngQ3_H_gY9jzhrtBX-F93iM9GJQ&oe=6A95D7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYyxLadwXs0Q7kNvwGHymEZ&_nc_oc=AdobkuMl_S7ysArOV1rjfc5y_yZggSo2OPHhtKK6wtMWpe_bJfMrC_6L1wsLTsNGNho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe_Qacp0s-e1uInDiHKUy8txLOOZqjaOLFzmTJW4nw1Q&oe=6A95D5BD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
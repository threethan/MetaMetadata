nc_ohc=LN1irDvqmrsQ7kNvwF_rgXU&_nc_oc=AdqNlEliLxiL5yarNtO7al5CuWM3KVHqj4se-rU0C0ooPwbHt3ZDQa49CVPj-pX3h-Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeNOBv2F8mMJ35JMcMF6LVZWPg8uIdjgPq6yrA3uTo-A&oe=6A5A2CE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdueVjnewGgQ7kNvwFHdTYT&_nc_oc=AdopwQe0UJ8ifuByeh0G5_BudsR_RgVovbW_UuWKIBfdbqkBhOTfpljLaJK7MLMdcXI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlaPteMXIAYGAuY6w8wENb2ZBtpDXTi682egvDkigcww&oe=6A5A427D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5adlb9ZUkNIQ7kNvwEAhTbK&_nc_oc=AdpkDCzyEohSMT-d4DF-7T1gJVqH7Qp2D0LEoPj38TqRWn33UiYMAqLqECgEIUNCtN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALnVxpUgT9Jk0P4k09q0Lp3PgfgO79HV00UaoLXVB8pA&oe=6A5A2097"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfiZR0t9tY8Q7kNvwE1V_Cz&_nc_oc=Adq2Nou2CUgb9qXJ5_G8rf0WejOibw26WU8nC3k_6OQe1HRNfGP8pBImQyrP9u0KEjo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-eCJ-0iEK4pw78cUkJc3m51H7FD5cGhOIbYlsE92V4Q&oe=6A5A13AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIBvEOHYiY4Q7kNvwGsphkh&_nc_oc=Adr3uUw5IClWGfTB4QetJ9cM3Xsc0MtTLn1W1xuerKRAWUKVO-CyWyFdNbxIgGPAbDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVrsZKk56feP90YhPeB2BE5J3kLyKK-IKwa9sS3xWwXg&oe=6A5A49FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
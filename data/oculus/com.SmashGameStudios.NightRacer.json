nc_ohc=IMsgMHG3fXYQ7kNvwG44XJq&_nc_oc=AdpfPbZa-nC2BYU7v7JebSEQ9Sj3P6mU2Hvt_fVQYR0jDKdTOSEKweN_pUb_jmg5Tnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIREOHCtbx2LwuZZYm1mi-_selIXz05nHS4ud2lOkgAgw&oe=6AA55263"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2xdzqvb9LoQ7kNvwEGnn0e&_nc_oc=Adpse3t7C6WoZo3v5VJTi8KbVuozuACwbqcLknpv3fj2H5rhSo2AQ8HKTfTi8SojKVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9KaBqZ9B04adgq4hqWVbOWkaFouDEhQhqyd6k-gD8Zw&oe=6AA567FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XR81JcTbpD8Q7kNvwF52G_O&_nc_oc=Adp_V-gF9iGx7cdJ30LSjBFAmjPbUPknWdOTDqq5By9at8tWqtYoFSUXsj7d8uPYolA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxEPSflvGiRPVIsWQ9bOFYMzyKrszi7JsK-ySCSNuVxg&oe=6AA54617"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rz6mFjVkoEQ7kNvwHeSh9n&_nc_oc=AdoxmKx1XK_MetuGgbXsrxWeEk7r1-DnEbOzIqHxuUG5-7Tw4e4-B6pL2Rz05FvjjeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUg5B0PhLzedmfwTYxneVURM1x5Yuis0t81vOFosUeYQ&oe=6AA5716A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ8O4OWnvT8Q7kNvwFSmC3-&_nc_oc=AdoSC9aEkrAU_zYVeGr3yBZY1ct9-y7sQl8UhxxYhlIa8LZUvGCP3a8KDXY-UHZRubw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJMz-Is2NpY3jGyWdGnELvIoWyEDzoY_e5QrJSr6RLYA&oe=6AA56F7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
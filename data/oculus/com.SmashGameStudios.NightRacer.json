nc_ohc=le92Ry7zP0sQ7kNvwEEIwYZ&_nc_oc=Adp694PRQBlF9NIfPaSJmhOvEIeFHW85P8xyfT4Ja3KVTg1wxkxUAj_oPCOm6WicBHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VkQsnjA1VnrPdIY7n6b8HNm2HmVc7AUI7KrwNAA2Rcg&oe=6A05CCE3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2A7cl1GTdYQ7kNvwHyQAcn&_nc_oc=AdrxZa08WkpnyGdvd-MYOHbF18dP6sSWeBSD9cdz3aCiSdLdpD-7YzluJvqW55TXveM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GDVdfLPRWH8ifKgCqWg2cCA5Is7veKx0F0oCZdzosqg&oe=6A05E27D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAEXTHqswJ0Q7kNvwHR8j1w&_nc_oc=Adq_f1_axbkavJORhw0-wcNa7S_9woZ3mkHFdyfSFKrr748_kADZfEFw5mGL4kxe79w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VtYvtWiqqsHn6hhLymouFWHXDk0y2MQ_1_fhrNEIziQ&oe=6A05C097"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDFj0WXjhpAQ7kNvwHS3uQg&_nc_oc=Adper9L8kznGnPIkgzRZLCSh25fmD1lyxJdCLGuzhBG2_x1k3oJhOS0501QUrZb-D4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GoM8vki_RGKL3Z0TEBJ1bf8uNQOXtBsMDRoj982FVog&oe=6A05EBEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFBw9H8t90EQ7kNvwGftW2h&_nc_oc=Adp7o5ikNz1ZMxbdaloXdYqD5mR4aPGmv48drfl3kPAssAJaE8PhYc_W7677_gDiAW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DbnYbbl4vGQ7x8dzVMXwHo34lLGijxrgtlk6a8oYpiQ&oe=6A05E9FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
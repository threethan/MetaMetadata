nc_ohc=3bqjw1PUBl4Q7kNvwF5BzgD&_nc_oc=AdrtdXxLJwcnIqUvUbs1GptR_9GyMgSyvNl3j_NiVM-TiM_YjVGMCY6iX9oeQ-aNfc0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m0KnJD0zbTDG-K6WWXDqv3BImuq0nohwoKJffRaX3iw&oe=69D26263"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faFEOZOOQIIQ7kNvwFS3CKO&_nc_oc=Adrg-euHP5-4LE3G2kfUno8IgW0tG_UTZpZ9h42V3Zl1yi8L2v7ASf9wDWakBvCLmwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UwLhnHxQj21MI83IR-4z_Quj-NafJYIDf8_KyfAoqGg&oe=69D277FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRNn4CsNFhwQ7kNvwGaWSYo&_nc_oc=Adqvye_REVkowY1l-X_TRLSEe6U3FZSStAQYpEt_iWuXmmGeZwHwTAWp9Vnb2TxZ5bE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VjNpUN_HsqezK6KYQ45yhbqNCUZQ65xadHq58rZqD5g&oe=69D25617"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDYgz7Hed4UQ7kNvwH_3NHY&_nc_oc=AdrucbgujdfXzWRbuXurXGs2dCNaRzX--F30fl4dzc0Pd1ZNOB0r-YsXZLd6J1jbZUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tRidW7d1O9aRWXdSMMDc-euKt7nkXe476HuuCe0vfMw&oe=69D2492A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7e78Chrex8Q7kNvwGw68Ud&_nc_oc=AdriMuSOlSpLPHwCo7LC_0g539xPaGsgSfCh9dF6FcBSakf9PKP3JzJPfZIBH5Rth9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WNOPZWsV4gB0m0OGHsE4OV0bTGJeuzxqchThsRiZKUw&oe=69D2473D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
nc_ohc=MajxDCB_pycQ7kNvwGb2Nmx&_nc_oc=Ado1ADbWakGnOzNHAcdG5Uh6q43eAkvfXNaBJTWIumekDPeiqFEsbH_eT5lHCjzF4JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi3X46zYD9zh_JutX8jCQY4CaESu6ysyef1FUVhfvLSQ&oe=6A709663"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBlVUZnW_7AQ7kNvwEi_j3K&_nc_oc=AdqowFXQSYcndehLCz3f0jNB-9ak8dUO5VBmD0vTVzaavV8-SEDPTjE9SAsMMdufD68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIcHRvdqBHc9M5xJOGWBjjTM7bPpvFC9gXQjacDz2RNg&oe=6A7073BD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6sAhWJRg34Q7kNvwF5DWhx&_nc_oc=AdroAnJ-jTx40UHFUf9zdoQrX9ZgkuAaMTNL6Q5lu3myaUepuPH12UMDNf-0cmgAR0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM9M7NjeHRp_yRIifcl29L0pZXNz6s0NSUdzZLL6TZ0w&oe=6A708A17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OYFfHKmxgUQ7kNvwGbJU1O&_nc_oc=Adq3Mv9bEqd-EztXtpu11b8Yr9mLhuNkphMPflLGMgWEisO6ko53UmzMdEOtTUnyyX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRr4R-l3KHWGF1d4tYzBehVag5LekH141Dkslz_X2h_Q&oe=6A707D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYIgowCtpysQ7kNvwEplEBa&_nc_oc=Adpj2hMzqF5MNWAAFwCYkqvi7rPy5KLoZe3r31bwN3pCNJO-btpikVuSH0sl42uP_MI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0LCTAk-V88aSzZDQPeK0XdhzEBkymy99VFbg3-qMLOw&oe=6A707B3D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
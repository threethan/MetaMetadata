a&_nc_ohc=DC7WutRgJPoQ7kNvwFbDk8r&_nc_oc=AdpYQksDXiTKN0sZFl_0bc7swwT3gOzDoJl7NXu0OJFCxj3pxeEsLEa0bIcFr1NXukw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U2kq4So115Ko8StIK7aCoUWo6u7jNPwkrlkCEIxphFA&oe=6A393763"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlZ4Vwt0hNsQ7kNvwHGn_Oc&_nc_oc=Ado-F2LgcO5L1Fe6vIS0Gs1tyKd086KUhJ44IbN1_Fsq7Mty3BMguPL59XKvJkuIWkw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4uMxvbjUpP3E0I9eD77KByBMACyfZK6p9wKaY-JL_Qg&oe=6A394CFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvF6A5in0rwQ7kNvwFGckwT&_nc_oc=AdrVAutYwAE59pLVVvtV2vlMY2pGVydEThL_BMgLO0N7gA9HAk062Wx6Mh1HApN7ZAU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97ciVp8QV1jVRKUd7osLB9BiMwGGQMrHiPHLC63YYRoA&oe=6A396357"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTgy-LJEql8Q7kNvwFCA7iG&_nc_oc=AdoGpk2LdkU2Bt8sqTAHfLxwROBkF--Thz8UPoUIrye-DgJkHNqf--JKunqCZaFoGmc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87otsVFyix2lhGvm8eE8PfUeGviShY1MC3pC7ErcSbJw&oe=6A39566A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN2JnU4k448Q7kNvwGVXccn&_nc_oc=AdqEeCTVTkFHSnulzYfr17sgZxBKrtKkf69pVlL9S9P-D6aV7_7O0Sm7rJ2bL1QoLG4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82BkGIhaWrUbGZI7ibg5iyMsudTzYJl7FyGsS0-byrgw&oe=6A39547D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "exte
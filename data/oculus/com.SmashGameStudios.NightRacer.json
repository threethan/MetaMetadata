nc_ohc=jdMZDvfL0sQQ7kNvwGWfB56&_nc_oc=AdqJuH62pLogr-v-jR_jNODcGt37mgPCrhQJQF1Y-DwHDBQZGMshYt1Yz2Q06IxosXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRstryH9kbqRjxBn9USnivvcdefVSpQAJJlOZh3IfIo6w&oe=6AF5F623"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv-twZNWYfEQ7kNvwF61Az0&_nc_oc=AdodhZvUvb9ff6rWcKSKAugVN1EmWZqFVsfAOFcIIyjvyZJ3V7vwTEB8rMuCbxz2-6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe0hW5O_NoscfLjaHTGzAhVfbHt-o9ZjEMkyt7ibFycg&oe=6AF5D37D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggPKcKMbHGcQ7kNvwHGMS7Z&_nc_oc=AdonJw-3w3x6D5EtpSNo6rShZMDKyHiI4VI_ZB6CA9dLDVFMxvozy5WgqSMxXdQbDtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUoMK5Ce-NaDSvjFSD39mlLBbbthKNo0N8sf3e-eiecA&oe=6AF5E9D7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8FzpD4jmxEQ7kNvwFdbXZW&_nc_oc=AdqHjCkjrw5QSBntl9aplMixkboYbDL1P6cPF5Boq_cv_pKD3VRKECj4jkUzEFUPQU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3vezRyZsOrMu5QppBpm6X2v8lybCNOLfaIyEOsw_JSg&oe=6AF5DCEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enXh1KLILKUQ7kNvwG7Rgop&_nc_oc=AdpAq8hEDeaOAlYGVQN8TM1-ijjnXb6KmSuIwh61yPxSBCGPiRIATo4MW8SyEyJHXH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlLkEIk6eRpT6E-SvRTOxMiCsCJD6SkK7OUNwLfOUdwQ&oe=6AF5DAFD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
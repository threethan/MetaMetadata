nc_ohc=0FUB6RY2bX8Q7kNvwHPN0fR&_nc_oc=AdrCw2Hm1Q9YKBuLu75XmJlXBKLoR-6xU_nrRnOPeDUNFoBPQVT3MUBNW7NejRu6t94&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JNEhLnUQjD6k6AfPnVJ2WzXULxvqxuJlxjZqnfiIdtg&oe=69DF9163"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLVDq08yogoQ7kNvwFPpCKb&_nc_oc=AdpHGJhzd9-4O20NcLeVVXko68u-c3Ja3pyltRwYZulIy1VhZ2yz96Co4RuGhs99AP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EElvrcHii98AT4Lpx3915VUWVgBljHkTctu_v_N0vug&oe=69DF6EBD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YE45iEe2_NkQ7kNvwFb4S_M&_nc_oc=AdrcCUr47pw8dRwh8F6mgj2kBmdcrZyKwNx3rUa1TLO3kO2uJADgrdeLgfvTNrgbp6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XH2RZki0mzqif-WkO5NBBRq16YJSGSAWMse5ePEeraA&oe=69DF8517"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1umd3sAs5sQ7kNvwFNJg3p&_nc_oc=Adqdlc3xrwtkMRuMJAOVWEiHKcd-i9RYigHhv-yOm0qwR-4VdGdxU_LGAecPbtJUXgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MXs2N22lL6KTlhDwFNIaEk2qFElbXn5x1w74Jo1-xbw&oe=69DF782A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw8XHt0hDRsQ7kNvwFymmAQ&_nc_oc=AdpxYP_3mhR0B1fGIOTQCz7cwbCqzaN54f3pzuJ6VcQ2Gd-msdhoLdU-fYTCsZ9TFY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sZGCQZDrfFCmRQwK1Y-G-zkAV7sBhX7x0p9a3pzhYWw&oe=69DF763D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
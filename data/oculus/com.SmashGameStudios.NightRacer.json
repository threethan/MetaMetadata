a&_nc_ohc=vGeuQELj7PkQ7kNvwEl9Hqb&_nc_oc=AdoR4Ogsx9K562i8dLY1e7YkNp5UIL9vMJHXTKQYskraRfRvs3PRjhC_Vb-64IR5X24&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd67-BGPOtBEW8l9-ownKaWwfnEXVV2TPFlYB3lCLYiA&oe=6AA946E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFUDUjPpH7oQ7kNvwG1AlLK&_nc_oc=AdoXLfNyBzEW7vBoF6ui5YFbs0s8Fj9JayeJ8Gd-VxnWOczm3eU3hcm_beBTMRIe4hE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuhCnJ1vvjDEK1BBR5JIHkcl4M8oI5xh7IZzSZigLofQ&oe=6AA95C7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mdrTmmUws8Q7kNvwHEPR1b&_nc_oc=AdrUI0BHjvjNeiiWQ0UkGy2h5l7-skTtHCW5EZtoh0eHeMRR8n7DiAeIE0Y8RjTBSNQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL28_M_Zd0OgY8K7I_lQSsHudcnAlEwVn47wv35mB9utA&oe=6AA93A97"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTUAZAVxr6gQ7kNvwE8d5Mz&_nc_oc=AdoL7Ax9z_gKdxXRvFUJrcQH8kxeJa2Jhog5qMF9xtDaNYhW_8FYC3g5P3cW76kJ6Jo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDFDtB58RhNHLG1z8I16EpH2XopQN5wH5dusuXcw58XA&oe=6AA965EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeHwLiRI4bQQ7kNvwGnc4f7&_nc_oc=AdoI13iTZxhnLKVE_Ejk7pjbR5S6m47R9djVA0VJIsjdfcg30bRPaVqS3IAXmAv3Evs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk5uJQqiy7Bh4DNwMvKhCmTqTV3agwI_tBbNRQKgXKxw&oe=6AA963FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "exte
nc_ohc=smhnezgUShcQ7kNvwH20KDh&_nc_oc=AdpCAkBBVwBvAZyqNJOsZz94qCZoyUtqJF5eEPsgHjkk2WTYPdZggC8Qv0A0XGbCN5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIlDhYezzmzObNyOWLbYh_Y0J1Ydq4BA5b8kI1tcs5vg&oe=6A636763"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMcbQPoH-wMQ7kNvwHxHtsL&_nc_oc=AdoltIzsxsfn-pcw-CHSSg6422KGW2M6-QRSXVgeyo-_bnL5PIY_OcZIjMEzxBJzmNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_nDMlVh0Lm37mvgwrxn1cerBxvB3tq45hVdCmqERXHw&oe=6A637CFD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JdOlC-mT7gQ7kNvwFmG8yl&_nc_oc=AdrR1bf_0cT08Qz40iLas-gSZ09zsq2_9KQ8k24cER710qjDxWcJtrODJ10OS11kq4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7LeOI5T72FsMAyZ2R59hnh3ESELoHdgAXTrSJ2Z9BVQ&oe=6A635B17"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7CV0Rf4KYQQ7kNvwHY-lEf&_nc_oc=AdoLKIBdDXRbgCym47F6fbzbKwaweTBsyjJDIu8W72_mP2rHF_lhVOpgH99D-XIV8bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBWdw-ZHSu6iaCbU81K1bilNVmd87SNTD5NxSZZDNWJA&oe=6A63866A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_irFZavSR8Q7kNvwEeQ0YR&_nc_oc=AdpozziIXmKyA0yTsr67vLifHpx-ea6RD_r44-NS1fTfCsg_dkvx1nJxLIfk1pcJhOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdZXNi_6KoberDazRzwpAPjxMfLceEg6M0qOpMcE0atA&oe=6A63847D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
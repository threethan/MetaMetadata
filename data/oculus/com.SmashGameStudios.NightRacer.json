nc_ohc=vfOi_3USb08Q7kNvwFXsn5i&_nc_oc=AdrL-dW5ziLEzdxuBbN6bGkhwAnULroSxIxyRTa98fmYBZzgNUbn4FfB2HlO5n79OLQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67Meexsk1psP4B2-UyiRg4tV5pMP6CaShyiEekNvkhuQ&oe=69FDE3E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGYCP-amXx4Q7kNvwFJRbbb&_nc_oc=Adqc9fdWv5eyls9FC4xGArrXJZizn1aG638qDUPu3Tm22YGOF6UfczB-yvd-6Bzuoqo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QKP2MExtG6dg3bHH1f_4yF-m5JI-ZUnbI4NDOs7OY1w&oe=69FDF97D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKejh3fOv6gQ7kNvwHtObwW&_nc_oc=Ado_SK6LLY7IGWIPP0HIMo97lXhTPy3kl32Hu0WR3f6_v6MXnuEOQF5csHGB8cqI2mE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PFWig7CG4cUlttw0onyqywvk51NaPdfqLbDEEfjA4iA&oe=69FDD797"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEGarH9qjhoQ7kNvwFoYl18&_nc_oc=AdrogWwJK4BxT-k8r9_mAg8lg9wrKfsx5BJagnGy1V3HPLO6BSoF-lncPPcLHQRdefA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kt7stLPK-7z_8eNoxv3bq-C5ocdZHBAqsHNEe2b4jig&oe=69FE02EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZ5GcKyAgWYQ7kNvwG4Yhfc&_nc_oc=Adr6cPREQxn7_1jJ4lnw0LZKRte0VXv6GzHZCpug00721coEJLFJmzcUdVZlQLHUcbo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WN7_QdDBoCFJ4KN86stWKbwF-UWfnHvhPHyPigaB39g&oe=69FE00FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
a&_nc_ohc=4I4_RxKIinMQ7kNvwE1zA2j&_nc_oc=AdoqhYm4IAaOF7OTvdfk31RwQMVQ3SbDT9454cAdxGf2Sj9LF-Vgv0FKL-6P7D9DuBY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG11WZ1k29r0Ues-hZpD-9NFAbUrfYkK2sMfLgHkOHsZg&oe=6A7DC563"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LQG6-EsmJAQ7kNvwGhl3yI&_nc_oc=Adqb1KWXExucLi9gtQB0h5SCgQSBKnJ4kIf5ZYmlIwlr-sa2KnDzNhBjRKm_g8tC1A8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm47v-tYA1Wp84mal_P4EgaaHba87QOUguthSGuVlhHA&oe=6A7DA2BD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viSb7-6U_ZQQ7kNvwG_kRLU&_nc_oc=AdrsI8xmTgXny-V4-C5dUUVzVoPKJrkWhEXXE7duO9Ak0WHCAZQ9QqgCe6eDzq3pq9Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiPGpb3lAEwkeq2Vt4z1EhQXxl5SGYWSkXPWspzKM8bA&oe=6A7DB917"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMAnHY0-rP0Q7kNvwEMrTci&_nc_oc=AdqggSGrVKjKJKP_CCmATa7ZPXIkj8CCS0tFWAcai1ei9JrloT7BT5aTzp0zB1SuQVQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8JRUfhwky92r5sOgbqw1gdPAb6gTdMUbnkJ6uZ_s7Hw&oe=6A7DAC2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37-9w7_FrVYQ7kNvwFa1YQB&_nc_oc=AdpuLGG1LHjJlV286YXNFxR5DrKD3GsotKfMg40idf9kYKtZT9fFH-qvt6a4Hf3gFB8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAo1Ja2puZKNua8OsRoGFZjXEunHVdyrtwBeLZsrVHIQ&oe=6A7DAA3D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "exte
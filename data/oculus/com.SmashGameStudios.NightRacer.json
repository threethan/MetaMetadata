nc_ohc=DC7WutRgJPoQ7kNvwEDUP98&_nc_oc=AdpPlZ-xIEG4VRlDNLtNpTeo93YojtmYEbayCydrXdb-mW9_Yh8l4Cy4BGwkwWrO-Z0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tUOlq4XSOwLXCES7-BdE8On2NrOFp9myLZXmSkQzxPg&oe=6A3A88E3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlZ4Vwt0hNsQ7kNvwF6oTyA&_nc_oc=AdpL-V0EVQQbTDuMhnlhMjBisiwD0pXkd32hG5ANjHG1FZTTziN6fk2aAh4tyy7p6Nc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8cv9yNnIeXU4ki3vZTwYogIznoYTqGGMI5ykPqgta7g&oe=6A3A9E7D"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvF6A5in0rwQ7kNvwEiAL3o&_nc_oc=AdoRyIbvQ7anroX9uq11kDyRDg33HEmtCN6YsgZW9h45ypThRGx16Im8kf3OwqbeNak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ainOMKwiyTtASyyuhE9TjmcILezAQJcp-sxaBMvsTmQ&oe=6A3AB4D7"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TosRvfBHozMQ7kNvwEkv6ie&_nc_oc=Adpk8eFavAYfS-03fxSnXwiro8Q5gsvb65EazCgWtxPf_i6yfu0rnoZRMkzhkPEwB9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pEoZTmOLq9blXOFTbGtZFJ_ou1-fIboXes-dfui8G-g&oe=6A3AA7EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhZEq4eFndUQ7kNvwFrUWTp&_nc_oc=AdrvRjALRi5SXyR7Mglyo6hVGCmdqygenuo1H4so9Ha4t7xqJZ_FWpEDN4PG28ixMXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dxomq3uE5XN9GcDJoZWQAeRZFIWc8nu-_xDogMD2S-w&oe=6A3AA5FD"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
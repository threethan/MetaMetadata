nc_ohc=-tibYd9VD-AQ7kNvwEsbhvx&_nc_oc=Adr9YzkUgEQ7iWPUj-SokufTfnVLEKPngHWI9NoVFtuo48gzKiqDvBhb96EOkpHkjUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy_cv-tl6yG4EI_C4FGMC3lCBukmSdIEBiXJ8liXZBBQ&oe=6ACD17A3"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQc4CSUGu9YQ7kNvwF67FcU&_nc_oc=AdoO9Hzxj5GJmT_XbAt048N9iJcyH9xZPFzzGhRAhCZnZBjx4-V6-1Az4uSQ-YQ5iYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn-IvOMr-sxFI7dojmArsnLFlv-B5ZYGli7D888vqILA&oe=6ACCF4FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq3m03Q_tHQQ7kNvwGxfPL5&_nc_oc=Adq3POQkJW6ZAYeSXPhbStreB06HJGZyfelf4m2wGokQ0WtxPT85lXD-_WS2itgn-A4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX2j1jiKcQQpapXfoZr299S02ZutB4zZ6lpBZgLiBHdw&oe=6ACD0B57"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5ITO-j1Qu0Q7kNvwHM7Oci&_nc_oc=Adpyim63LeylDNdGiBaPi5DpN-D77dBeG8DcarwHYI51SJ04j19d-BEtMf38uLCOVhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP3Wdh729-9q__3pq2tUAs3kLfccwZcGLRe4WpiUkuYQ&oe=6ACCFE6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONCG6BldHY0Q7kNvwHItT9H&_nc_oc=AdqBlYV58KkS4L01h32paFdtFdxF0GuWNpcbacYbupwyQWt1w7QLgrwroIDAZoVuFUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV6ihZjF5ZIrnaJ1RVMfoD5oGlxaKyVqkHAwj5H5R_4A&oe=6ACCFC7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
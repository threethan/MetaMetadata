nc_ohc=mYvW6J3BQpcQ7kNvwEe1xOH&_nc_oc=Adru6hFlyfmmhZmOCsWdly9QIb1jmHquvjb1fiCXwmy4bIQim8ho4VtzBS5g28hNiTo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNnv8yqeCjeIR2hgG2hJZW6ogz-ePRnhzoiy5PM1lxsQ&oe=69CFBF63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ws11NykUb0Q7kNvwHkdGiB&_nc_oc=AdooSQkrHXEXFgAJ5MPVfgs6YcTGM1YkibIWQmZ6ojZyb0BxeAYDgZ0RK4oo1IUkl_k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw85zJ9adtlpk9UumsFyWz3F_LFPEBk888Ce0l9X_3-fg&oe=69CFD4FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDTF5hprNIEQ7kNvwGh8vB1&_nc_oc=Adpu-au8w_438ZoxAmlLL_9USZMlFYoPeR6-LWAsKzmqdmi8tonuQsoAqw7w5BCWThg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxu2i9jHTHwbHQ5B_Yemshn6emvCxhk89iLA2xeH3WDKQ&oe=69CFB317"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDYgz7Hed4UQ7kNvwH_-vd0&_nc_oc=Adoss75nvJUH3ifWlLuKCoW8I_pfdnkR3QqCNkRVfRg8i8TnC2ssKirwjHiOSjMlBaE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVNN3MHAVTbYZcsZoKDekE0bsB93boneH4iFE151Rd5A&oe=69CFA62A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7e78Chrex8Q7kNvwH2mKnd&_nc_oc=AdpaPn3Lp7Tndr7axICGIuYdaFLNePqu0s6xA2Yc-2mGabZ0oOZTLKcOzGyKf5fMRkY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdOahFHbhJMZfp2a4zwd5CwiugJduKbsOsml6PY5X3BA&oe=69CFA43D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
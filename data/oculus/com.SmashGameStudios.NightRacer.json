nc_ohc=dXbcPQaqMJsQ7kNvwH6Z-rp&_nc_oc=AdoBxXwXGlcE4mHiOWIuGvhTU0sv42aNDHrwjAhjOMxhRJUh5bzPCLf8lYtgPpVL1Bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AgxwTencfB77qfI66uJT9ksZRGyM4AzmR103i_ApOew&oe=69F9EF63"}, {"file_name": "Screenshot 4.png", "id": "5369956859786559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031418_5369956866453225_433731044856409693_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT8HDfOC76gQ7kNvwH9cElA&_nc_oc=AdpAZwYyDU_0YipLA7xeQRkfpkmEI6uDPkqxHVjf5uV5yWz1jdZDWZ-5LLMRdo9yxNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DDTcWPLGRfvZmj4zDfqaegiLiIVwpobRF4B9xGmCtlg&oe=69FA04FD"}, {"file_name": "Screenshot 2.png", "id": "1090908811631072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_1090908814964405_4645079029140565405_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGS5U0fIFWEQ7kNvwFcg9Ea&_nc_oc=AdqKWBQKKg_oKVXc1KS-_or9C7acoXnIOD4p7zRCC-Vb-atadkG7bRk7Eq4gDIK7Avo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nUsslpwOWlmZLyqX_vqL6N6BMjcdOGG2k6xh3He7cAQ&oe=69F9E317"}, {"file_name": "VRPromo.png", "id": "736358658086485", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003254_736358661419818_6032289725854561818_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyRAocSTmD0Q7kNvwG-Hwj0&_nc_oc=Ado7Ki3B6zU5QuIsI66edp6cjZXN4757DX65ov1ULO4uVlmoi45TJAOx0C08eOtvHYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NnLQJA_EIe1OB6Zla3KcTjsKcA1wpHe-xvTyYSn-6Yg&oe=69FA0E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "198906059487578", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974798_198906062820911_7585224394214376800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q6CcaijDQEQ7kNvwEqMeSn&_nc_oc=AdrQ88Sk8vyEEitePSpkOj9WLZd3zG_2JQP8X9HQr_TcBG97jrwcgD3rxYbBIixC4Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53F4TvTmfzPjrgODEJ4pO4YMeiw1_cP2QCZ0nrsiH9Fg&oe=69FA0C7D"}, "display_name": "Night Racer VR", "keywords": [], "long_description": "Get ready to experience racing like never before. Use your epic driving skills and use all the powerups to cross first in the finish line.\n\nFeature List\n- Compete in 4 different game modes\n- Multiplayer, Championship, Arcade and Time Trial.\n- Cross-Platform Multiplayer Support\n- Car Washing Mini-Game\n- Compete against others on the Leaderboards\n- Over 13 different cars to choose from, ranging from Sports cars to Vintage cars.\n- Customize your cars with new Skins, Toppers and Boosters.\n- Collect coins to upgrade your cars to be the best they can be.\n- 9 different tracks, each have their own sets of obstacles and \nchallenges for you to overcome and emerge victorious.\n- 8 Different Championships to play through\n- Play through all the levels in arcade mode and time trial\n- While you're racing watch out for the opponents who like to go rogue and push you off the edges of the track.\n\nInternet Connectivity only required to play the online game mode. Rest of it can be played offline.\n\nABOUT US\nSmash Game Studios is an Indie Game company focused on creating compelling experience for Mobile, PC and Emerging Platforms", "short_description": "Enjoy this Indie racing game featuring cross-platform multiplayer, many levels, championships, Car Washing mini-game, cars, skins, boosts, toppers and more"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.smashgamestudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.smashgamestudios.com/terms-of-services", "publisher_name": "Smash Game Studios LLP", "support_website_url": "https://www.smashgamestudios.com/contact-us", "website_url": "https://smashgamestudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_sub
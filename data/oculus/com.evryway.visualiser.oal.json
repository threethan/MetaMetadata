privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Evryway", "support_website_url": null, "website_url": "https://www.evryway.com/apps/evrywayvisualiser/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "414450040445503"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1086621649774085"}, {"status": "PUBLISHED", "id": "479120933150156"}]}, "baseline_offer": {"id": "1086621649774085"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733247900, "status": "PUBLISHED", "id": "1086621649774085"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27286455711056444", "version": "2.1.3"}, "id": "3884256074957968", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3485430611585621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27286455711056444"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3884256074957968"}]}, "change_log": "# 2.1.3 (20260723)\n\nImproved playback response for MP3 and Ogg tracks (playback should start much faster).\nLots of fixes and improvements to the UI for track browsing.\nThumbs-up gesture detection fixes.\nLots of other bug fixes!\nUpdated to Unity 6.3.20f1.", "created_date": 1784812386, "id": "27286455711056444", "version": "2.1.3", "version_code": 2103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3485430611585621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27286455711056444"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3884256074957968"}]}, "change_log": "# 2.1.2 (20260620\n\nBug fixes:\nFixed various network issues, more error messages displayed and lockups fixed.\nFixed device permissions issue that stopped reading Quest3 local audio files\n(thanks to Seung Won Baek for the report).\nFixed various startup flow issues that caused hand detection instability.\nFixed invalid audio from network providers from locking up playback.\nUpdate to Unity 6.3.16f1.", "created_date": 1781990533, "id": "26928398013528884", "version": "2.1.2", "version_code": 2102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3485430611585621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27286455711056444"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3884256074957968"}]}, "change_log": "# 2.1.1 (20260515)\n\nPassthrough mode now available in the device settings menu.\nUpdate to Unity 6.3.15f1.\nBug fixes: various!", "created_date": 1778867164, "id": "26477995768569113", "version": "2.1.1", "version_code": 2101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3485430611585621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27286455711056444"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3884256074957968"}]}, "change_log": "2.0.4 (20260304)\n\nUpdate to Unity 6.3.8f1. Fixed bug where FFT note buckets were higher than FFT available top frequency. This caused many visual effects to stop tracking audio correctly in Unity6.", "created_date": 1772641105, "id": "25706420672393297", "version": "2.0.4", "version_code": 2004, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3485430611585621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27286455711056444"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3884256074957968"}]}, "change_log": "# 2.0.2 (20251206)\n\nFixed device tracking offset for OpenXR relative mode, and adjusted various assets to match.\n\n# 2.0.1 (20251206)\n\nSecurity update for Unity.\n\nBug fixes: Lots of things ...\nMaintenance: Unity 2022.3.62f2\n", "created_date": 1765051207, "id": "24952925571076148", "version": "2.0.2", "version_code": 2002, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
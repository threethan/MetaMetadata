910120_687691866201929879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lB6W06g2xIQ7kNvwGLHSnL&_nc_oc=Adr2dOIExFsQT5wVltyfgNuCu4kZtGTmS-wVvr1T2RbDgMnF147yS3iFX5brKlbArX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2UOhfEJMImpncgJKCuV9MwBgS6dNfeMISSaHhK0uRnA&oe=69C683C1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff12.png", "id": "709905531595570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623317_709905534928903_2789642385169689973_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gffpIKlnvIQ7kNvwHmcYBE&_nc_oc=Adpxo4_qyaM0SBmFwKGdL4GZiK675UpHZseCXYAjzPUhLy_dRvwv1gKj4Chc-1kCVEU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyL7rMr3_cRGchBD7oxm9-PljK2T3v72uve5iPHA7YCtg&oe=69C6962B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff11.png", "id": "24100766776176291", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617847_24100766782842957_1349639373367713285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3jCKiymUv8Q7kNvwFwvvon&_nc_oc=AdrhS5TdyObfoikcpmSfpDmuefOf_3C1L0Wn1AMPukq5xYEww5OamM2RYabM1pHmxRE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUo3F8pCABmPk8TqEie_20il5YV8j6btAV3yrLiqfUpg&oe=69C674C0"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "1436198820891333", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622326_1436198824224666_4202366728418444507_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4xweX62KWIQ7kNvwG0Uw27&_nc_oc=AdpRICzMsUsBxTWmjUxtE2xs9BO7H62trT6y7G03XeEKLJxb168OaZqYrmgjLnRhKl4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgTqIcQ-zhoglz_UkiQLP6Z2hVmOek_oPvciyv-F1HJQ&oe=69C66A86"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "1276692963972530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294620_1276692967305863_8908373396184317250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSEG_Xb-MzYQ7kNvwE8jRYw&_nc_oc=AdqzLhcow2UzCi7821snmti6sZpJ2iXRN9GkbatRyex5xVGLwI0gNwNL56qb0AZhjno&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkW0zgKwYSY1N0qFfGLLVvMiBvapyUP77ltWB4RGCo2g&oe=69C66108"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}, {"images": {"nodes": []}, "id": "633376636423986", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "Holostructio
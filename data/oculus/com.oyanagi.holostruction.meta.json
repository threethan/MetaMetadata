910120_687691866201929879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODm9gBdYKn0Q7kNvwGGgdlj&_nc_oc=AdpCO3K7D8Jew5-Qw9wjsFIp2BsXK9rwW_9MorvWAO0CeK3_dXN4WESs_gJDFEfc_PE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6V8MDFVaQVc144t4yKgaOvi0ArWmFo3NDf1fxmLSJ1A&oe=6ACBC501"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff12.png", "id": "709905531595570", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623317_709905534928903_2789642385169689973_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6USyWK1YIwQ7kNvwGseODh&_nc_oc=Ado7yxqSDKYerW7TbD8L3x01sCzwnBY9ri3wZDdYKeXJDDCC2rPvDv9U9KSsRWuBOFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG3JbmqD4Lf910UoSvsqj1rpz7Fr_DbroKVyTW30vx_A&oe=6ACB9F2B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff11.png", "id": "24100766776176291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_24100766782842957_1349639373367713285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRi2GbewzRwQ7kNvwFRhKES&_nc_oc=AdovhaGGoDY-Z6nheYoXXVvW_TtB_C9LSrUwRL2_6TvtMghidKB2RboVUdk_QsxGRRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2iG4YNbx6aPX-dni1RY9E7QTlQYdJjaaiEREo-8jHbA&oe=6ACBB600"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "1436198820891333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622326_1436198824224666_4202366728418444507_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3Dz7swBsrkQ7kNvwFBW6hd&_nc_oc=AdoCxYU4cKSh4DnWJsIpybjmbL8Jv6PWuL9CC-AXO4OWssPlmQjMErTOhB_bIfpkI-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjwZXgoEceYay37KwggXvG6w9T9AK38zE2PVHHhrkP8Q&oe=6ACBABC6"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "1276692963972530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294620_1276692967305863_8908373396184317250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDAqaoINeTsQ7kNvwEbqBj9&_nc_oc=AdrIfPC4LJFmrgERu98qSUMlljP-qqYCXG91gzzV6SFfd6njIshKcMzX_tEcYR2GVf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiVyvBEJ3CsaeDibfHj8o4Ss0E26lU0GAD0Z-3oapGyQ&oe=6ACBA248"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}, {"images": {"nodes": []}, "id": "633376636423986", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "Holostructio
V1N3dqUoZQ9A-o7BhVrYkQT5TUOhRb7GZoQ&oe=6B085B00"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "1436198820891333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622326_1436198824224666_4202366728418444507_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIIaad9xlaIQ7kNvwH_2hpm&_nc_oc=Ado2M0CxFu_0YprmdgqdtUlh8iI9bq-XN6y-a4MoQaYdzlhPct1PcypzGI1sa5k1zVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZMInBnBx2m-ke4OfYjrazjF2BI8PTSGoaTF6nUf7vvw&oe=6B0850C6"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "1276692963972530", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294620_1276692967305863_8908373396184317250_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGNUnhKdGGUQ7kNvwFK8IRv&_nc_oc=Adrwe37E87mDOkDP-YJqgYrDeRurQiBy0OPy7X_PEb8EEGTOk3dMy2DOFaqCBHK7_nY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnmiER5ldEdIaHUA_tMZlXA4_ZDirLWzTJSxF_aAW0_g&oe=6B084748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://n-oyanagi.com/privacy-policy-holostruction/", "developer_terms_of_service_url": null, "publisher_name": "https://n-oyanagi.com/holostruction/", "support_website_url": null, "website_url": "https://n-oyanagi.com/holostruction/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9952129504851412"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "731032859587755"}]}, "baseline_offer": {"id": "731032859587755"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748646000, "status": "PUBLISHED", "id": "731032859587755"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id"
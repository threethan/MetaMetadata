910120_687691866201929879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdBIcYRMQQUQ7kNvwFuTKPQ&_nc_oc=AdrDjCyI0baUMg_LOSiGTsW6ajb9rvlAygrN18NpPWAphev7K5F_wG7i1BpLIhbfK_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oUBgrJO3BKqvvdOBhsTV1Kuen-WzGe-TI19c1mXvaOw&oe=6A0DB4C1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff12.png", "id": "709905531595570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623317_709905534928903_2789642385169689973_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J52PKOHqV70Q7kNvwF_d-wi&_nc_oc=Adr1mYTkn84d9CmfAdOeHGkAn1eYvE1zrjZKRAYhhls_mfD0Y7SdxV8ulzgvl7v4dPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PVXTErJE4jyi3IDmkvtq6gZTwu7liPUDrK2jo45ZHog&oe=6A0DC72B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff11.png", "id": "24100766776176291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_24100766782842957_1349639373367713285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9EcOPdjftkQ7kNvwGTrHTn&_nc_oc=AdrTOUQt_oR1KRJwnBv4Czr0FvOeNBRkcvRrUlu7q7MBNuatA5_8dh9GnDNY5woUEGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af494abugY8_DShf81LVU0wiqiw0-j-k18f6UKIB6Tc7sg&oe=6A0DA5C0"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "1436198820891333", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622326_1436198824224666_4202366728418444507_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgOmoaOq1zwQ7kNvwFmAHjp&_nc_oc=AdrxtMPekTyPFOQmoZ4egQPIqXoXtOa7f4b_6v6uWTwb-5dsbNxTjNZPxiAAAAB62Sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5or31zTNUgH-0XfQJSgwa2kHNq-qarFzw2oexy3W3gnw&oe=6A0DD3C6"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "1276692963972530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294620_1276692967305863_8908373396184317250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqfGhUkSGEkQ7kNvwGyW8DA&_nc_oc=AdpBDRxwEZsfTjfXaO_l18vTEXbSdCYp81iuCxD-NL_Jlh9H7jUdeO7bknwYUgJ881E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pL14ZJyoOZG-iedDnYoOhb-QF1QnSiAdpp1QQN0oPVQ&oe=6A0DCA48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}, {"images": {"nodes": []}, "id": "633376636423986", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "Holostructio
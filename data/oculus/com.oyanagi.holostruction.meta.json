910120_687691866201929879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekPVpfcnyAQQ7kNvwF_hcYe&_nc_oc=AdoFABeYQMJ-8MykYG8y9bm9wDa8C511F1uTIGKek9WBt6dVqIyMuXZH-KzmVBcc4QY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LsDrH0-Y04k0NphOLx9HTAytvimTlDmqWwRDobjabYQ&oe=69F89CC1"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff12.png", "id": "709905531595570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623317_709905534928903_2789642385169689973_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4a4Yp2_M8kQ7kNvwG3rY_H&_nc_oc=AdoqV6pi1AiDQaa3YubTXnUQoKl1dIpSDivYsHhWmPAp0V7UwyvM-TPCFCZI7lwZH5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31cUJUUsjYSS9Q2MlC2vVN2PFO_XMJIUYfvbhxw5bLKQ&oe=69F8AF2B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff11.png", "id": "24100766776176291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617847_24100766782842957_1349639373367713285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6AKPmBL1aYQ7kNvwFcELWq&_nc_oc=AdqJR1h_Svk577od3WkOajXcoAfDY-dxLBv4ENDvz17-3LqdmoodaaInsfRdhAHLDNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rs1LE7HzI4BVigAdzBWw_FkdxeIyBVXTKZo26vRd19w&oe=69F88DC0"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "1436198820891333", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622326_1436198824224666_4202366728418444507_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDB2LK2cQMQQ7kNvwEKLuBe&_nc_oc=Adp4Aq0XRc-faihm4KY2-cyfDbcXsLjqVv-ftFdsDi5ZKYjyKWejxh3XRvkD36jxQ8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WgN4Wp-vDzA2RIaoZ8ksP4JKnZydSyGovFq9Y1CjtXw&oe=69F8BBC6"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "1276692963972530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499294620_1276692967305863_8908373396184317250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48A-3cOYJzMQ7kNvwH4WL-I&_nc_oc=AdpU-l5ZA0K7muKzqjqmoGnvqaxCQVpHRhEkNp6l3de6zmt87JZbukGjS6EgqACMD_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ABJ-7Nxp3DQz04JJOf_wFIljkzYWOIIgbTBq4gmBbiQ&oe=69F8B248"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}, {"images": {"nodes": []}, "id": "633376636423986", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction", "keywords": [], "long_description": "Holostructio
.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCny04JSTjYQ7kNvwHs2Obf&_nc_oc=AdqZr3fP-fFVW5HKbBHQmVhgVcd2sx_7lLZnxfKgdvj3aDLK9VvgopIHj5UxnVE3o9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ-jhfqCIlM3nUTBRE5jJUHo4-Qt32a5xuaRGMvZPTcg&oe=6B0700E9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO1DTKY2bn0Q7kNvwHwcB0t&_nc_oc=AdqalvA3gtWYVo4mL6U6bWYeZit7MnHyAYR3m2pp3Ss20T2VJOGapoY6cUzDb4u_CeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpSkrEGYdvz2o7QJ5nRPkaSh7U4YqqeFyoyIPk_mi_lA&oe=6B06FEC0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS55I9EB-pQQ7kNvwGnd1Gy&_nc_oc=Adrv8fHP7C0hti9ejoZ-t9krPT81_GYBTAYh4PWDkekR7yzPOs_SLB5DuZ20q-hwdXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj9xD3WJWm9pRv-URAo0lpxyHY8GlDt_7KrFd3DwnjRA&oe=6B06F49E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh7npm2KZ4gQ7kNvwGZGiwE&_nc_oc=AdonW98YmNJkPwCiiCzkC7JfbAHO17ol2TEp-z51dKszO7207MKRPhAgnzLhj0C9Zok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbCtlkbYwJsgsTxI6WvfvjDEKFepV5NjKbGhkz9eHbcQ&oe=6B071C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jvLFUpIWAQ7kNvwFK6MXv&_nc_oc=AdoCmmCM7jgImhZvydDK97ty3ughSY_0CAbzaUiDoytPyeFNSnNw0cL-Ii3NR-DmxR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-AO7YvJMzzK2saCkhbxHJJsNuW9Tome2zr2CpZAIAKw&oe=6B071146"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
Kp6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpHR0TcDc0oaAEdSeq_bGkrrwgtDI8OHrBFpemGG16Kg&oe=69CE5529"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8xbfroXPL8Q7kNvwHOqVkn&_nc_oc=Ado3KQ5yQfFR_zKIeRCiG4u7j5IjiEeoy1fTzmX3HbvYleDnNTneyMGNrlHf3ChXSCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAzcJfw4Qb94mXgGwBEauooo4wTgSwzeHuMLm-O7dDWg&oe=69CE5300"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EwB5Pv09AsQ7kNvwEQTVTt&_nc_oc=AdpibUjXAnAfDC7hMGUZ4LrbrQgpSPQ0O8wYnDnos8Vgkms-Zb0cjpxSOSp8yU_feLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqrUTUuJdcyGWBdNUpuazdFm8TcBtXROO318POC2KGiA&oe=69CE811E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LM10sqggj8Q7kNvwFeG31A&_nc_oc=Adr9E-DqAWHC9c5lNqa7sdQR0dRpYuPBWJysJVvsuDLWap38939BDqva0IUhIOTAcf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWGdToaVaNKMbQhHg9GAukVdTPCe4bIeR2Qv5cUXvyEw&oe=69CE70C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibPsBToLSUoQ7kNvwEZziQh&_nc_oc=AdpU6ubUglD5pc4Dn0dyJM2eF7IIYiP0D4nkbfhhWfzvRhpif-VHmrhXvIJCiIWlCos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwherCUsQGNwHVzbZ6BzFjk0osYWGdtVTyL05pcxCQjHQ&oe=69CE6586"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscr
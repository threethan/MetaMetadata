w5-2.oculuscdn.com&_nc_ss=8&oh=00_Afysim7w0frH3lqVBiEjoQ4zigDm3Z7TqZ4ki3OFq4hbPQ&oe=69BD31A9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--CKFYMc1kwQ7kNvwE-W9U3&_nc_oc=AdnbUcml6r6vnR4bCezNJdbmlQYopa3WmHsOkhF3-eBSlS06cQ37JNGgYI9-_IPlzpE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzzf3pjsD8FUZH5C9DYzqmTGXPltnTPJ0EpakLrbLP2Gw&oe=69BD2F80"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb5H8fuEwTgQ7kNvwGG6nLi&_nc_oc=AdkWY3aEIgjGURpMfXCkOO6CmozqfoL6EFxwAR0bSvP5aOA6h1mWRsSA3UAo0mR5x6o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcaDqmKbapl67Bc9GKR3t3grsReKMqYtAmpvrX7QmvnA&oe=69BD5D9E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkSDprzXOH0Q7kNvwHh6DNW&_nc_oc=AdnOzz6wvEmJfaEf0ccua9bGmwH9hmUwHuhGKifteRGggZ6aFFfaOvJ4w3qy0EKlrFE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvWvWntsgbPRDCNAjZ40tf4NRmmRD_bXHjwFQVOWSW9w&oe=69BD4D47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voCbeCLETR4Q7kNvwHjCvtO&_nc_oc=Adl4RYjwgH4_bodSot-SS1dxFwh9Vp9C2q6p5j2MNVQKlsTud1DOF6iFvFNdqTwr0fs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQtWPH2yBV0UYMrOPvbaM2Cn2ReBhKJAk1-qqIKBxIFA&oe=69BD4206"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "
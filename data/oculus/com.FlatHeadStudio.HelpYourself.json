.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbzW8WExC8oQ7kNvwF2O3EE&_nc_oc=AdrxNuxtdTUcGgbPKLPzuxb1ycJq_UNMAzpwyL2UBUfGnV-tuk1hqGy6pgnoAhLH0ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4cw-BwXXMyuUrDNx9dcZ-M00oKYSIcqNi-bdS0ePJvg&oe=6B103B69"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88KSW4fP3PcQ7kNvwFW2eNw&_nc_oc=Ado0ZmRJu916X73amtZGfPL-RxM3yTjjg944cF92hJ103B1oPxA5r3WB3zfi3s7Q4CI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrkvwM8zTpLDP-J16DkXMuiB8JsZeGWVckRv0ReraViA&oe=6B103940"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2LmrzWoelEQ7kNvwF_nnSu&_nc_oc=AdqzwOD8Vx6PT-WxGFbyrX8tBIN4_MbgGBK2EGT5SH1w0YDbZssuPKRRWYw-Lz-jXjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7z9_1o3NMLM7bTPLlOymF2sOuF01_7mFQ8SyfKjGZmQ&oe=6B10675E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KczUNTgWQfkQ7kNvwEj4VJ9&_nc_oc=AdpzBRUaOStfJ8eY175qvRRrpGIFMsTs1TjShpUMhbxRsgGUHAFDLX7yIrmjO5JhiS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoWITZcTCaoVXamFjVJAdvj67IBnXGoIJUM7x_-0zVAQ&oe=6B105707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDMAf80RD_IQ7kNvwFe--f0&_nc_oc=Ado8VoOAlQYGY0MZp1sdLdkKH7YZ19H49eKbf_W3egURftUwwDVUEMCddDN_EWV5ukc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxcMX6bVWyPUIM5HOaXVa8wZKIkKxbjgf08d9sm4lv2w&oe=6B104BC6"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkexSrV4gXQQ7kNvwFUOiXM&_nc_oc=AdrOiLFkXfZwVZQYXJvlnZP6PU_yhyVxIiGNcP86Bh31aMQKmiBUskKSQO2nECZFtJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIzebYowwQghFt7yqGnT-LbG4aYKfWt08g8UwcVBLOtw&oe=6B085269"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO1DTKY2bn0Q7kNvwGhE23x&_nc_oc=Adpc2V37HNYU2_K0YZEnpm8yGT0lZXJ1l0SGazZV6hyLmuMLnxbMC-qZgb-xLHuy9WY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT80VSqaNgtI8f_4f3gJ2-Ib_J2rP9Oo61amZlO2uFT2A&oe=6B085040"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS55I9EB-pQQ7kNvwF2sDKU&_nc_oc=AdrqvNo1W0Gju0DOPH3twvW1R9yKJs0Zys62QpR-a4NW4tegQczS-gXOB3OEjuu6zU4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7M--6cGwhTEhNEQV8ChIlWkwPZAySoWDGZaXZRbbkNQ&oe=6B08461E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU2qfbQeSh4Q7kNvwGMb6LT&_nc_oc=AdoDeemtg8UHceq7WkwqLO2RY33CcW0dP3xFHF8dSyZqkXanKemexFU1mP6mkPjn6tM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuoE-JPdNyovVbYabSKzdksOSt6-byiqts57PJZrMUPA&oe=6B086E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCppjuReREgQ7kNvwHKXATU&_nc_oc=Adr2INfisIFxMA5AG6txJO-eWqtJJsxI28nqLKeoF8y-nfXoXYrRq0UtDP3lTQ_beRI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfVT0W3PRANT8XaBsmeAZVFp5TcUZKQsOMFBkaKjXR8A&oe=6B0862C6"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkexSrV4gXQQ7kNvwHuiTpd&_nc_oc=Adqsf0bFE2S_iOq9fJ3RHqHueLwuyONBg_HS5QpO5xctytR2qcRE7OH3j3A3875A7ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScGzdkMMJn4FHbsW_lrDtAbd-hvwt02dKkQM0DgmXMqA&oe=6B09A3E9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FcySxAa75MQ7kNvwHU35nj&_nc_oc=AdpnCFJXDGiRHIPIjvA5dxLCe7Bs5uasOVIBDxiTY76SOdV1HUqvmZhyZlzjdVV4GAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgSBJ1o2ngNrFtO8hykqI8Ac-pd4j2L0fbfWw4QL3g3Q&oe=6B09A1C0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS55I9EB-pQQ7kNvwGh9xYx&_nc_oc=AdrXOw7X5BkTbP7eWxP5NQ0xPKSKnUDiYe-4EqLdCqyThAc5-GLPcKfOka7Kd-ECqpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1jmOhSACz7n6cVs_ouln8csmN92D5d7-DDGXU6QjcIg&oe=6B09CFDE"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU2qfbQeSh4Q7kNvwG7dq4B&_nc_oc=Adrqd29CbgvMIVMmDMrMpAKLaAQkBXO_a6ulDtELh_pg1s56qfnxnV5Q1Kmk7FRnZuc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7XqRmOJ48BW6i7mWoONbVKLyo31PV8Nn9yLCrBkbTrQ&oe=6B09BF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCppjuReREgQ7kNvwFDH1Gu&_nc_oc=Adp5kQ-rXoVNdqppWxR4lT8gUWh_foTSadhqhtV5vez7QIQHUyiSHh8mcKOOr4cOGpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlCAWj2YYw82_tx4ip4bnYAPvykHMzYAIOfn46NUXdPg&oe=6B09B446"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
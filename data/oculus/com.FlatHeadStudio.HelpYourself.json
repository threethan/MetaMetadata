.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBAk6ZE2MhAQ7kNvwHb5sa1&_nc_oc=AdoScaVy1NJgm9miTgD1VkHInO0DZGBuAR1JUxqeVJ9DD7rD1WjL9v-ucFd_hGcA8Z4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJa5Vnd20Em-nX9vgDrMrKXMcaZbAnubZ29kApL4Egzw&oe=6B01BAE9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nanq1rjGKG8Q7kNvwFzAfar&_nc_oc=Adp3bD0em1SO_qfMXu_8OtIr5QD9kysDefasOyg46HbmkjJuZ_IhNCeQLEjrcHSkgPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2SUas6QZA3GKiMfTpMeA__ivWweRdN3rHj5BWwx_SJA&oe=6B01B8C0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4YgqItOFTEQ7kNvwE7YyEa&_nc_oc=AdpG1YiwhcmctigvxHFem9KkRJhe6J7LXaF6MjMnZ8Per4l0hJbcNFuK4WMsEbl3OgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHwP4M3EEDl4arq_o895Xfo2tqtXSH9GnWC2HgzSKb0Q&oe=6B01E6DE"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkfvZchVCcQQ7kNvwEs0iGN&_nc_oc=AdoZvn9VINYyga1Bl_wJOjxN-R0M0tZE7OPJGIiag9xbDRKas9ZFqU9KyIvAi-NHqx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-GbxieKxqOoxF3yDWp9rP5pkwrNZpLeL9mxLWIqK1fw&oe=6B01D687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0_zHy10mjcQ7kNvwG-RemF&_nc_oc=Adpa3YQnudZuiXllIQngO5OHPlzV8oGEt5vkeqpuCEyapseNQL6_YMb27g5BTU33E8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdXr7yxO_Mgd-E3jsdMw9F1a-UEyEcVJ-p1xD89v1-2A&oe=6B01CB46"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
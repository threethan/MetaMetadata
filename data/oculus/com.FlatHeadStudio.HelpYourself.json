.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guLjZsMKkyAQ7kNvwFeW5fX&_nc_oc=Adpa2LZe8rPKqlKWlrB3gPh49dNcFskQ1UsTsn1925AnQ47FPJG31owG4N_54SoKj8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvafBpRYUsW3JtbzOWAZ9iH1uiAVUEa03q9VPHOXZn1Q&oe=6B0C7F29"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FcySxAa75MQ7kNvwEnyUNF&_nc_oc=AdrPLJoAKYbbFAafjSah3wqAqsjeNsXo58JmVYzuRdV3coOTcOROdbIS-yOAE3jw4oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTesgFN6bdkMNOdUu_6XvRtibOglOzDcA7g3Syguc9Qsw&oe=6B0C7D00"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvKAJSJJuYAQ7kNvwHsVeIt&_nc_oc=AdreO13JfxHg-S0m5Pf2DrpxBHGWVLdOP9Uqnlk6jn4e50A9gM41AlWhNZr_KODQ-Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRM14MsGxwc6q3Qclx2M_Jj2GLV_UamzYrCBiLYlxjHBw&oe=6B0C72DE"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JmC7tmzTPkQ7kNvwFjWmpR&_nc_oc=Adp9WcBq0zkWM3xVdwaoFhj6yCUkzQ205f1kmo7FE6JeBlTyXgDDE0DqwKabYu6q14Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7qOCLnoVFMqIo-4isTuix_ER4n61i0G8adQ4tLzezGQ&oe=6B0C6287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw7XO-q2ibYQ7kNvwFTyIXT&_nc_oc=AdqrkLGbaOT2j29wI4ZDCOon6QZvVNguaD-hY-y6WcZ5BRpN2Ti1CJJ3JpINb_zajjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR01L_EGiX57hDUCrtyLDfObHEFKFoRC_tuor2al2xhoQ&oe=6B0C5746"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
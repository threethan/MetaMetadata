ent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27aIk4pzWOALIPdBpbmx75iVDHq0u1vvnk49TWxCu_VA&oe=69F1EDA9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Avl8Zu5jCM4Q7kNvwFiEtw4&_nc_oc=Adqpe5ATDTSH7C0ucK2JaFdAm6IxIY8JZ6YbjJjoqjFIQdr3jaoqrj8BJOIXeDZ64Vw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3N3D6IWrSp6OMRHUZHN8kMMgCoZYmAtcdbxXXH3sxeAg&oe=69F1EB80"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7bxCioOUIEQ7kNvwGsv82q&_nc_oc=AdqtxdnD-YNAI2SWhuwvRmrmbZFoD6vH4oj0rMIM6zyliCMVIQMc7BQH_ANLOk_6oHM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0nnZvDTXQI1peY9rf81XWHudABSnVveNw-vJEczxw6lA&oe=69F2199E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vpF4K-PiV8Q7kNvwEzsRv1&_nc_oc=AdpJ6Aedm-vk5cWac3htpcvORAjmM5FqQfC7sqzCSvfBzWT19huy9TshnwLJrO_cR9k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0RT6_MJ1A5PzFK3DVZ0acg1fEwtnM4229tIoihZIACRA&oe=69F20947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUdsDdFENsIQ7kNvwFbrDGB&_nc_oc=AdrxpXFWCy5HxY9Y-uZONIiGnQwJgbMPT2mLrgq3X6RFnZnDdx5b1RMNr3NklRiB3Fw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3Qfn5P_RKVLLlhxlQaPj3EtUxU5ucOkyu2ooyFdJFTXw&oe=69F1FE06"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SHOOTER"], "has_in_app_ads
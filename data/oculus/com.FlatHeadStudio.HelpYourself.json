d5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0M5rf0WY73RNPX1LoKFa2k7trRm53Ot04b8tWFQDkrA&oe=69BBE029"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--CKFYMc1kwQ7kNvwFbOi2U&_nc_oc=AdkIUBJx5Z5yfDir7OV9ym2iqrkEM__APciTOhyelQ-Vjb6KW_boXELTm3ziqe8CXXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMuFk8Ekbk_yp0sq-vnooZMM5GHb8Z0YHAHmifdQx4uA&oe=69BBDE00"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb5H8fuEwTgQ7kNvwHwYSXw&_nc_oc=AdlP_BaLN06DS3rvPWsqY8JJervky72DIVMFEqds6izTUu2dgMxG1Ds6CRwxMowIFpU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzpw3kplSdsXdRfYPOMK8aGwXHvIUnsPTnrhdxZzg3yaA&oe=69BC0C1E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkSDprzXOH0Q7kNvwGC7rSV&_nc_oc=Adn9MuOOlsTHJQsYP6wYEyDE3PdZAP8_bVSt37TjB9xqkV3rBnSbe1JlCWlHOtqFNp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMb65GY4PpXxCI9-DbUCYmY9BvVmabNlvG7qbQuGimBQ&oe=69BBFBC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voCbeCLETR4Q7kNvwHCX9Gn&_nc_oc=Adn3cKfwqSff9KC59ajtN5sx6owNjatv3Uen2Cxvx4gfXgPBf0qYmXe3uCqHoUWW_vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnEx6uYAviS1XqU0cnU1O1degqC9g2RmNfE76BiMORKQ&oe=69BBF086"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7469973833055484"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982563_275327581940050_743548203180570251_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHweoUbhiFIQ7kNvwFtKpXR&_nc_oc=AdkDhXVO5x8AgrYAaIhWlcCg6gw95mB-NkPALfskI7SKsuGebY5iVEe5KF_EPnlx9ec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDpk6WFj0wNBDdVe9HSoIv5jU9aGlJU8AzhijgHHJLsQ&oe=69BBD956"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "We Are One Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1619501977, "lastRevision": {"nodes": [{"id": "487072399130285", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4089073041145597", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "199732451948040"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "help_yourself_coverart_miniLandscape_1080x360.png", "id": "3239887886113821", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_3239887892780487_5483405845286176226_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IIuxb9scWIQ7kNvwFLaFuv&_nc_oc=AdnP5UY6hShp_Bk6uymWqiIQv_HQR-X9qMq_zziFYbakwNB2JCAgpjy6hd3FVFOaUG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzx8hCt2_etj2tyw9uElfQBHWbATOnV
EJ6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUuEaeMOnUVSARUc6Cj8j2Dt2HIt8zjlI6vHxL2wYYFA&oe=6A898A29"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrSEcn7H_C0Q7kNvwF6Deyd&_nc_oc=AdqsaowGDwqbL0iLb1nIJln0NgPejl6FEjlf5mXGvjKpV0OqDGXyflfPlgxwbP9E1OQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGPA4sgCJWhHuu4eL3QKqt4Q2rH5UOEAwCdNfKvGrDEw&oe=6A898800"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSy8kD9YK_YQ7kNvwGaEQm1&_nc_oc=Adp99Mgvq_rXxQBip8LkZvADVtJeUUe_hqdqeyxtBPVNOLVZLMS7fsF7J7ok8EvLOzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgJ2HuJxEDoxEK-V0jGrBon3S0GijEkdSZ5pldvPU0pQ&oe=6A897DDE"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlpIl2wdbbcQ7kNvwFi8LsB&_nc_oc=AdqS_tWM1imWuZ3SghLs5nql3YIib5m7QnI3k3WiFjSJmArLbEAu8EmyyG0l1dk4lJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI5cYM-nBqQ_71S3kcJN8CU0KkYnhpdlgLHWeQEQHs1w&oe=6A896D87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjrCXCAabC4Q7kNvwGIT0_g&_nc_oc=Adq3y_w3cSDqVsH1yBIkYKJD-HP03sG2PBy6riKp0xP9VVwv8psHQYqwBIOQQ8Egods&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKIYIW9ehTyM9eXk9FCwY9plxlZbjBoSP55PQYf4ApKg&oe=6A899A86"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscr
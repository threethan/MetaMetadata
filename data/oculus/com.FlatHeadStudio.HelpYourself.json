.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFvOhYwXdnEQ7kNvwFBuRj3&_nc_oc=AdpA9tTsJN40iom6_ygMyoPW170VQsiGYouvQ3VMHdOgYXDRvv9iPlUJVElOgvMn3yU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjB7xvdd18yLgZvEMMGVYUHexX5ZneHdwGYCQPaeTGmA&oe=6AFDC669"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqFrdAg_9-YQ7kNvwEKFx4I&_nc_oc=Adqlv8r2F0lU-SrNw0iNp-HZ3Hu0WGcMm9S0DdTopkK4O-O6sdGUL2Ia3qoatRBpvZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6MYi5gaykiAU4JOZl70vaOhbya-rnI00yMF99HIvF2Q&oe=6AFDC440"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CxrIcYgF7gQ7kNvwHpH-xb&_nc_oc=AdrIqsTJ9u9ElKtJ22w6EmwJ7sxQsLTWtL5XG3Q3KuVkU_CPH9XYqJkgw-Wl1os3SMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNPKpx8b8SQuISf7m3pc6w-Br_rGbqClGA6Vq0m8Ol4A&oe=6AFDBA1E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTOD4GKTA0gQ7kNvwG2ysGh&_nc_oc=AdpjGJKRroKfZvT68bzN7wFxMUpTsqWxiJShRFoRv-87iB2s12GsCwh9mEXuU27F2S8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNc4Yi5jRtXVKU8rYvfv4Zyz_I5ST8qKP5O5hirQ0VvA&oe=6AFDE207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPqa0mu2jukQ7kNvwGA-noy&_nc_oc=AdroSslXgC6yX7IZQ3sa-D2vTdisxow-sLdbTYKjlkariL8VDjNdJ9xGh804dDc77gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlaemZvpJJI7erOTe0HsiLNxYQYmRkKQyrYC8T_ImW4w&oe=6AFDD6C6"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
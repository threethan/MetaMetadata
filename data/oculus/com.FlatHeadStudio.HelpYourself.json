.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFvOhYwXdnEQ7kNvwHFqflB&_nc_oc=Adp-PX6TjC0FoVuYMnGlMDn4QFOLVlR6eQJrDZeBX4rWMKDvQ2yYzrEMvOXD5YKz4l8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQbfCNoGDbJxS6NZPFQQvZdurt5qWMNxIGLsBP8cy7OA&oe=6AFC74E9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFDatvIiIu0Q7kNvwEx4WOy&_nc_oc=AdrZjUdMfDusjQwYJ3ZEeXyvYszNzCCkzmj_W8rUzCKhF6WxOMuy-1rwCaNRQxocVmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpQcFYd-gG0_dh8st_CNOlPOyMe96KQI3EUjeekKGZ0Q&oe=6AFC72C0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CxrIcYgF7gQ7kNvwEpMlyK&_nc_oc=AdrTgYHZT9AsVRE-g7If8UZAYfaMaQUJ05-josyNiSozO1nISQTzWi69q999KlUdx58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMPMq1i1K29Z0d6x7ryxwHd-BDH2GV6VezL4AKxmkcIg&oe=6AFC689E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTOD4GKTA0gQ7kNvwHZQ76M&_nc_oc=AdrOwLvllirsp5UaxLQv_Tap0iPhbDXNKQM7ecAURlHFegQo8R8To2J1o147IYXcJOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQResCYXZh1g7-nJKz-TxT7oLfI6r3XmgJRwFjuSNCB5-Q&oe=6AFC9087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPqa0mu2jukQ7kNvwF-1ebJ&_nc_oc=AdrU8bZlbV1KF53MtPXahe-Fg0_0okc_z3_kMQwNV0Dtb1VIMhe2zTk5ey4EQ30vnmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXUd8gto0WPDAEIWfRLjtayHwvVjg_JLEl5sh7fauxTg&oe=6AFC8546"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
ov4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjFQ6bewLQm2qYCR2gkt96oKli3_ECtWiMQ2Z4VnM3lw&oe=6AE75CE9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkJDbLNNdW8Q7kNvwHzUzF-&_nc_oc=AdoPcBMDzXsJi68lmzVAau-VwQZd7RRG16MNYWMJvOOB7NlRLDNV4YMg85FaZQ8qdSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDD6foqB2La0C8uVVziPzB8JipgPkgHZQeNZBtPZxb8A&oe=6AE75AC0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psvoj75Vj74Q7kNvwFp4g-Q&_nc_oc=Adqpd9P6g7FLlwzN13Norq3kZ0P04hRj59PvoSu9AXKdb_SHjRD951s_-mVSRqACuxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr51ldrWTjoY-QCF9WuVpnaD5lvQ6rCuF3ksq61vdcJQ&oe=6AE7509E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYYvb9Nh08Q7kNvwEvUoLD&_nc_oc=Adqq4P55e42t4gPN-0s8azRmlkyLUzcMd-a5ObGly5DuakbMnnscXWJ79a_xnN7WMfI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQlZCAYpzzoH7ZWEIGJRyfv4NQUJQiCjbdfrm71GPk1w&oe=6AE74047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvfb2EfyerUQ7kNvwFtTCD1&_nc_oc=AdpPoiMQfTcBMadSpV77uvcQZBhg8Eji8VIS33LNSgcqlqaFxQMyAg3OlIBYzSxtB3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsBt6fUsAOfOJ-btmbEtpf2I7v9tU9E_U0H33bsiXYEw&oe=6AE76D46"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscr
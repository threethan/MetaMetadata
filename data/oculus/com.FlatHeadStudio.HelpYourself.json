.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkexSrV4gXQQ7kNvwH_DXFF&_nc_oc=AdrZr_zaUGDCd5WGJ8HmBpMhrNLA3q0NwzDo_oI8ChAeOSkdYgcWesWLwiVvi6jVABQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMBVqWMxqRQQgj9zwXfRs03YOx_4bgnRAyYVJklhbzNA&oe=6B0B2DA9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FcySxAa75MQ7kNvwF3z4OH&_nc_oc=AdramYbpmYHQuqqsAMDaTpHKjT9EXinph6AJzC1Xmi28fqpy2sD85lP709qletaqpUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpwmeFVPJK8kV_ErE0rJc6bYB8FAUgsE0dD7mlyZhM_A&oe=6B0B2B80"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvKAJSJJuYAQ7kNvwGfPcBj&_nc_oc=AdoPLHjyUs0aAdCjX4Gu4lG3Yqxaag7sHvH-FydlT0FdDJftdTv86we6-3uALHuegJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbbhuVrHwDCeMNY4HctIWgon4D_FpUHmxhDbRETLW63Q&oe=6B0B215E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU2qfbQeSh4Q7kNvwEmqa46&_nc_oc=AdrMjn_DXwo6pLiIif4wkWosYYPH03SFgEzyG8EBadrObXHma1o2xIQbVx5PEPGJihw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSc2yITnfLkMGxES3Ck6X-wqtMKCQlQgqk3qRlqwZzmfg&oe=6B0B1107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCppjuReREgQ7kNvwF1FdSZ&_nc_oc=AdokDRvVGnLHgYg7wcqaJ1-l9W9aYt5sDi8ZMN-jkbwT8kTOsQNQsoREL-mz6C2-4dA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-CPOn7om2q1OZ1AdxFunQ4AMIkPFPhATJ4JK_SzGu1Q&oe=6B0B3E06"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
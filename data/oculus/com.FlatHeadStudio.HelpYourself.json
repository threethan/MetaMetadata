.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBAk6ZE2MhAQ7kNvwFpWfn6&_nc_oc=Adp48GPcXdf60mWorMWP5ovlkcPuCrd1_Wu-Jsx0W9OyTwxlSSyI3nS39vhbsFoBD_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIzEXgrjwlrkJmulCcoaHYOneuwlWN_5po_-4w3YRUqg&oe=6B030C69"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nanq1rjGKG8Q7kNvwHAcDt3&_nc_oc=AdrBd7qsBCbE1RxNXzHklZ2ohWXDhlHdi5V81WBqEGi0GM2I6DCmelbKWeFjsB_5buM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjXSAKXGvITvzfCblQHKItnJFJQRDuuGqTFRuNJh1WYg&oe=6B030A40"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naRSTz10FZoQ7kNvwGBvO3Y&_nc_oc=Adq_nRMc7_Ah0pZwQYog9WQ0ANm5nYV3bO8ylJhN1Kn_Z4oKrvkMYjMnDlykTuAuyH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3TFVylNJYTNjlogG9XBrTk41lvmhdpYIT4qHrJJqhqA&oe=6B03385E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkfvZchVCcQQ7kNvwGUBbDj&_nc_oc=AdoZIv7mE3Amthxc71byjMoIRkI0MfFZ2EcgYtA2zjBCjim-Az90AOWzxbYpUXq8XAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvCYRmL0fc3ITaWDKqUM-B2h-e6vop6vHWxT1pLWS0UQ&oe=6B032807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0_zHy10mjcQ7kNvwHd7dWL&_nc_oc=AdqCC375nGn9k0u3Vk976l_NNbzE5V3Lnqh7ld6Fijw2pfioDlo0K__TXrHl19dD_6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE3fkAYvpuS878z5y3LsadLgNsH2HSUoYQnh9HYHEuQw&oe=6B031CC6"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
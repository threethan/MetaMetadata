1pss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCisoEOa9WXkKrMK8fRPlimwTDJzKHqoxG1GS5XeXwvQ&oe=6A537CA9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbvhoVO7SCwQ7kNvwELTWxT&_nc_oc=AdoU6CAozvtI8w61SmiSoWwJPMaLnMPTsBFOH2c_7BMtkPMgi4JhnmyMFx1pq-NLUfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRJs33OM2ta5OjmH_Qck5iw6hYeL0qLgi-yoj4VCUA4w&oe=6A537A80"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPsOpMh6YXoQ7kNvwGH5Ykq&_nc_oc=AdovP6pPJwwRMxz8bkAFhusHcpn-GRSFvIzUIxMhCPojPl2XU1ckVjBrsSZd0W-pSWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw1EaLqHzwLTUp8neJmTJM_xxJc9QUgd1rQoVMICC-cg&oe=6A53A89E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWv9KfD__iMQ7kNvwG_9IB5&_nc_oc=AdpHwlnAYwOk-UUA62XjCLWpeh1GoD-r6UI_4k5IDql2z9j-Wtive1grjiZXEAuk1pk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5LssVe1CfbwlBnOWunC5KKo9-w4X8MOfgH_ojQicwig&oe=6A539847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yGxTZZ5X6QQ7kNvwEHQJAK&_nc_oc=AdprkPQ6M9nkLOAKqKmAdrs5AclaAleRDxWfDNfiaVuPGf-B2uaJpIA4MKe7AktNXss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdBO5zm_EKSIfxwG0zCgdk9ZeQsjPgAWcBvQ2QIA6tgQ&oe=6A538D06"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://aondw.github.io/HelpYourselfReleases/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://weareonevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscr
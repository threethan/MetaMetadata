.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCny04JSTjYQ7kNvwFiBzUg&_nc_oc=AdqJUoiNy6qARlQ2Ztf3E-mkaozVhvT_0ySjl22OcbRzvkF8QFBbr8yVg2Y6GeF3cv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz9Cv54O8EEeHbE_y3DdLfb4B8gNMKAH-VfbAddzaqYw&oe=6B05AF69"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mO1DTKY2bn0Q7kNvwFhmsMi&_nc_oc=Adoc46IBnz8--YTVQp1t5HCqt_9Xe1ue1WkBIyFK4j8wfB_3HMOMcds7kmwssJKty-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGp9n5FpWwIBU9u8jTiHpeP0qG6rZJDLBBljjW8KkJ9Q&oe=6B05AD40"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naRSTz10FZoQ7kNvwEm1GI2&_nc_oc=AdpEmCUhdyU94HaofyYER3SEQ-sIpI2UM3AkIYbFU1OCaeP0wiwUxVPNDqRpW9kLfRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLDhjjotY7nXsZZek4AqHoOkxdMfXag-XiuMDyaafbdw&oe=6B05A31E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh7npm2KZ4gQ7kNvwEvVbKx&_nc_oc=AdocSIesSxaUAniWv-vMeVhWydFZkUwhIuvPGgh_J-swdzUH_zk9KcbZB0_ky3d-Voc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZF68rxyKnKeveGCtX1JQuRpefyYxyYIiFAh7T6yoEyg&oe=6B05CB07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jvLFUpIWAQ7kNvwGhVUvf&_nc_oc=AdrdvwJYt9pfmlZ82PgMM6JtRAG3HjTzbUWbgYLC-ySofixWoeXYUhZpB7d6_HCyCms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8gQArvQw8p1pOybmoWBB9NLp4vKom1OupXYRkCs5mCg&oe=6B05BFC6"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
.com/v/t64.5771-25/38982464_1194598917953297_1096984925968634508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFvOhYwXdnEQ7kNvwGb_LNF&_nc_oc=Adop9oEcWERzm_2K9u5xv6tH1bDIVURbpxm4sHujQ5TdeRLs9E-Fy16y_uo7ATznIbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzOAsUE24R6k5Ah7TVjMqWJokEWZW_CvhLkXxSg4X1dg&oe=6AFF17E9"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1304391083384216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572935_1304391086717549_398295404207043655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqFrdAg_9-YQ7kNvwEJURs7&_nc_oc=AdqO5hM19yVn9FTLVH4Pb21uLmSoXNbVuGCjHYsTL3IUETfCqLGga3zY12okKEoye6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3sknKu8gflp1Mylgep-Eji_ve9RuP8YcOqDEz_Fn2yQ&oe=6AFF15C0"}, {"file_name": "screenshot_2560x1440_02.png", "id": "268391312129137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_268391315462470_2783615826099174799_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CxrIcYgF7gQ7kNvwG-szfJ&_nc_oc=AdpCH3qKRcB1iGKhX_Q3tbqohrQTmy8iUyotWCwQrHKzsjdPZ_pNwsb5nrxTM_KBAF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOYGo4F5FnAJniXYlzyxsuVcbzLhJQInnylc3s9GNXOA&oe=6AFF0B9E"}, {"file_name": "screenshot_2560x1440_01.png", "id": "430714338804638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_430714345471304_6285378269397378907_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTOD4GKTA0gQ7kNvwE-4NOa&_nc_oc=AdoKlGDwLzxiBlKfhmJrf3wwZHg42cRDFNgP9MPSC2UwBsJZ4EJwO6Nbyk1qZatPiII&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9V4A3QUQoUMgCFo-vHi4tNtlwl0Za9JOXcb22cFjBEw&oe=6AFF3387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_querformat_2560x1440_05_demo.png", "id": "570128914623354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982457_570128917956687_8897948775151170479_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPqa0mu2jukQ7kNvwGvYKa-&_nc_oc=AdqcrU4xsI0BRRpO1g9AqLuhemAzJTxsdVtW4V5zaofuZsSvmJxKEyQ6VzV0U0LkZMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5k-UQH37buYPQ1L_gllBCY68U9TK2fFiIayFJ3h-Sqw&oe=6AFF2846"}, "display_name": "We Are One Demo", "keywords": [], "long_description": "\u201cA refreshingly original and innovative puzzler that rewards creativity\u201d- UploadVR\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. \n\nTEAM UP WITH YOURSELF\nBecome a real one-man army in a game perfect for VR veterans and first-time users. Record actions to create clones of yourself that work in tandem. Find the best angle to take an enemy down and then pass your weapon along to the next clone, dodging lethal projectiles. Careful planning and precise timing are essential to victory!\n\nGORGEOUS WATERCOLOR WORLD\nAn industrial robot army threatens to destroy the tranquility of nature. Fight back to defend a watercolor-inspired world of vibrant, lush forests before discovering a much harsher wasteland. The world of We Are One doesn\u2019t look like anything you\u2019ve ever seen - make sure it survives!\n\n\n", "short_description": "\"A refreshingly original and innovative puzzler that rewards creativity\u201d - UploadVR.\n\nWe Are One is a brain-bending VR puzzle-shooter with an unforgettable twist. Record and clone your actions, make time loops and bring the fight to the evils of industrialization. Pass weapons between clones, dodge incoming attacks and find the perfect vantage point as you lead the charge for Mother Nature. "}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url
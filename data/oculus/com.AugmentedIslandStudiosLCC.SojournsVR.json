01&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMyHJ_HggMAQ7kNvwEmhlOi&_nc_oc=AdoFkjw318ZaHi4SOMWZcgiD3m6xDv2pYBKDrJD20epxuJXFrKQC4icU_ZKwSpooqbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg131j8RukVwnsgNubfwOI6PQEWdKmMTfPCOcin9qhZw&oe=6A999770"}, {"file_name": "Provence_Day_4K_08.02.png", "id": "916107236718338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031529_916107240051671_9178672613812254110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSCm-N6iboQQ7kNvwG1NnTP&_nc_oc=AdonzdxMV4u8qffH6mRUNg9qXWOaLOB0AAQwP1GGoHPlf7plI5XmGfEthVl9KM8C9w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8r6N4aPFEPjQIo5HC1SX1ZFk5kG2GO79qRki5iD3o2w&oe=6A999502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SojournsLandscape.png", "id": "1775457712975068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974631_1775457716308401_1536189248167635739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okVabQLjDlcQ7kNvwHbA-38&_nc_oc=AdpnNTvbKXu5xC0Fx6Rgh_9rwULUQHp9uWGgGl2YuU7UvUgmJwarOyHIPmoCa_IViYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRH1p3VXv65PRG3lxygP4lPsdpZgTbERMldabM4uzt-A&oe=6A999D2A"}, "display_name": "Sojourns Wellness", "keywords": [], "long_description": "Immerse yourself in a sanctuary for the mind with Sojourns Wellness app. Explore serene landscapes that promote relaxation and wellness, each meticulously crafted to provide a soothing backdrop for your journey. \n\nThe app allows you to interact with these tranquil environments in various ways, personalizing your space for a truly immersive experience. This is more than just a virtual reality experience; it\u2019s a haven of calm in the virtual world. Dive into tranquility and experience the transformative power of wellness today.", "short_description": "Experience tranquility with Sojourns and immerse yourself in serene landscapes and outstanding architecturally beautiful structures. Engage in relaxation while enjoying small tranquil activities and enjoying the company of friends from the animal world. Select dawn, afternoon, or evening for your escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmentedislandstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Augmented Island Studios", "support_website_url": null, "website_url": "https://augmentedislandstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35728771593376471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974525_950137652741332_9199325567333538269_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oVQ6tAupX0Q7kNvwH_wPLh&_nc_oc=AdrO5T-r5Ajq14ay5WPD5ISuakhzia1ZNGfwK4J1Xz9I2KdN5Ixwnqyse05CdC6eL_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbbQR1TNiUhjKGdY6MnJOyLQFW85JZZ_qnRcMHmJj80A&oe=6A998EB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sojourns Wellness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1708968900, "lastRevision": {"nodes": [{"id": "24528302676756808", "release_type": "SCHEDULED", "administration_status": "A
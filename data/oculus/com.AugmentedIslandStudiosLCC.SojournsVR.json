0hjDzlSeJ2dL5DU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0mPlltVeOJ5ESJHapU2aVZ-p-TVC9NPt__C6tx5f8h1Q&oe=69F09F30"}, {"file_name": "Provence_Day_4K_08.02.png", "id": "916107236718338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_916107240051671_9178672613812254110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTXTJTOh3e4Q7kNvwHjtVvI&_nc_oc=AdrsQrdSEiwYmjTBHRH-Cp6coelI6FK6KMrdprcqKVJBOAA2vS1mAz6XUVslwfR1vZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3FTc4s_1wf7fa4NT4pGQu5nDoA0EkrHgbUFAKOZ8pIOw&oe=69F09CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SojournsLandscape.png", "id": "1775457712975068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_1775457716308401_1536189248167635739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0rnG9H-HLkQ7kNvwHKmIHE&_nc_oc=AdoAwp87xFBaBF1acuLjQdlbV4Ph2GbYtlu9CEuCz8K_Y4YF5P70NeHVl5ZBZ3jYKKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3P5thth55FgYRcbYI9K2_gsUagvToKfK-UhRLX0OV6wQ&oe=69F0A4EA"}, "display_name": "Sojourns Wellness", "keywords": [], "long_description": "Immerse yourself in a sanctuary for the mind with Sojourns Wellness app. Explore serene landscapes that promote relaxation and wellness, each meticulously crafted to provide a soothing backdrop for your journey. \n\nThe app allows you to interact with these tranquil environments in various ways, personalizing your space for a truly immersive experience. This is more than just a virtual reality experience; it\u2019s a haven of calm in the virtual world. Dive into tranquility and experience the transformative power of wellness today.", "short_description": "Experience tranquility with Sojourns and immerse yourself in serene landscapes and outstanding architecturally beautiful structures. Engage in relaxation while enjoying small tranquil activities and enjoying the company of friends from the animal world. Select dawn, afternoon, or evening for your escapes."}]}, "de
01&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v85SUN9XWYgQ7kNvwH1b_df&_nc_oc=AdqqZoQLZd8Z83MlTOdrDC8-XEOJGseb7-zm7j5eT8fT7tTqt80jfvvk-_uMKOZB2bA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgEPhpWyV0aaUlJFTHJqKQcER16Lj7ej0fdSiuS6T0Uw&oe=6A65F4B0"}, {"file_name": "Provence_Day_4K_08.02.png", "id": "916107236718338", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031529_916107240051671_9178672613812254110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n6MbI4Dx6EQ7kNvwEFH_et&_nc_oc=AdpDKASAHBo1sZCihILQu0v1qaS0Y0zqyb72FANa8RSGnGEmJCFlk_12qxTJsqV2u5E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfx1n_yHQfIWQo4XP_ze86nFEGJ_I9Yr4n5mZ0cprYbA&oe=6A65F242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SojournsLandscape.png", "id": "1775457712975068", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974631_1775457716308401_1536189248167635739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=223Q3YqnjokQ7kNvwEOI2Nx&_nc_oc=Ado7Wx0BkeJG1gfanXD3rcWY_gSrNdO9f1hkIHzdYEZ67hEUTW4OMG3FoOXgyiX-3RA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAfHuU3pKDvdZkJfLp3958mi-IpOsxtn8w9WCfVuiyzg&oe=6A65FA6A"}, "display_name": "Sojourns Wellness", "keywords": [], "long_description": "Immerse yourself in a sanctuary for the mind with Sojourns Wellness app. Explore serene landscapes that promote relaxation and wellness, each meticulously crafted to provide a soothing backdrop for your journey. \n\nThe app allows you to interact with these tranquil environments in various ways, personalizing your space for a truly immersive experience. This is more than just a virtual reality experience; it\u2019s a haven of calm in the virtual world. Dive into tranquility and experience the transformative power of wellness today.", "short_description": "Experience tranquility with Sojourns and immerse yourself in serene landscapes and outstanding architecturally beautiful structures. Engage in relaxation while enjoying small tranquil activities and enjoying the company of friends from the animal world. Select dawn, afternoon, or evening for your escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmentedislandstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Augmented Island Studios", "support_website_url": null, "website_url": "https://augmentedislandstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35728771593376471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974525_950137652741332_9199325567333538269_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy4VIEZzodAQ7kNvwGW6aEJ&_nc_oc=AdqBiXAIBltFb7JqxdBF-36HQF0BAfuMDc14nbrHx7P9PcSLvxRIpdD4w_A0XAeRn8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqnGodh1lNnQmbusGXLhjyUZ_bZp5oNRrKjzmiGED2oA&oe=6A65EBF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sojourns Wellness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1708968900, "lastRevision": {"nodes": [{"id": "24528302676756808", "release_type": "SCHEDULED", "administration_status": "A
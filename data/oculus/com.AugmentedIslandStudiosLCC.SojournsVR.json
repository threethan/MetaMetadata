_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe3ILU1FRt4Q7kNvwHIXrP-&_nc_oc=Adr_1fibrS2Lbai9RC5sP0ldcIWHxvRQ8kGcwzNmvTpPuyzhhy-ggn5nxVt6RcA3wuE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkeJJxmvm9hq7P_xtW2nEoS7x_4r-o4JEhd_q8VS4EAA&oe=6A8598B0"}, {"file_name": "Provence_Day_4K_08.02.png", "id": "916107236718338", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031529_916107240051671_9178672613812254110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNzYaRIlDZsQ7kNvwEksKXk&_nc_oc=AdojR5aw9uCuuHixXJvDhL04Ljhdcmg_-6hx7A0xYjR6o4SkeOL3lep4aRxLOtkrq_E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG--tYrr4inJU1CJgudR_LtwtnxBTLDgkowG8ZQFmj4fQ&oe=6A859642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SojournsLandscape.png", "id": "1775457712975068", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974631_1775457716308401_1536189248167635739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cax2YXYvKj8Q7kNvwGWj6tc&_nc_oc=AdpV7CAIMSowzZaCTjat17FwDPkd6xIetFUe0ounD7whmEG6aictROKV_9ik4J5GxCg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMYs4HBJsIVazuCUmAceSxMVbhzrG2dwgLXb63W7ctUA&oe=6A859E6A"}, "display_name": "Sojourns Wellness", "keywords": [], "long_description": "Immerse yourself in a sanctuary for the mind with Sojourns Wellness app. Explore serene landscapes that promote relaxation and wellness, each meticulously crafted to provide a soothing backdrop for your journey. \n\nThe app allows you to interact with these tranquil environments in various ways, personalizing your space for a truly immersive experience. This is more than just a virtual reality experience; it\u2019s a haven of calm in the virtual world. Dive into tranquility and experience the transformative power of wellness today.", "short_description": "Experience tranquility with Sojourns and immerse yourself in serene landscapes and outstanding architecturally beautiful structures. Engage in relaxation while enjoying small tranquil activities and enjoying the company of friends from the animal world. Select dawn, afternoon, or evening for your escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmentedislandstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Augmented Island Studios", "support_website_url": null, "website_url": "https://augmentedislandstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35728771593376471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974525_950137652741332_9199325567333538269_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qM0XYY1NF8Q7kNvwGz-Yng&_nc_oc=Adpjz6MMwTzsm_uyYi5TiIqiAz6RinH0uYJ5jdUWs-KY4T8dCpMOdPSao5pVOFP4I10&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH75uuJLFbutghikvCGgwBv7RMAwcPAeCsxbgpK9kVb_w&oe=6A858FF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sojourns Wellness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1708968900, "lastRevision": {"nodes": [{"id": "24528302676756808", "release_type": "SCHEDULED", "administration_s
01&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfiOOvlIUDgQ7kNvwFgiEpm&_nc_oc=Ado0ulx3uxxfDK8ZeQ75j8KT1F1W7hmEdgW6Ade6Ix_8NChKbc4_Wco3lyMoXzuFzrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hkwwtF8sl1zbsA2hEMp2p8DzXyM_WgxPnYb6VFAnNHg&oe=6A0465B0"}, {"file_name": "Provence_Day_4K_08.02.png", "id": "916107236718338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_916107240051671_9178672613812254110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otFXpqb-xYEQ7kNvwHYJ9-Y&_nc_oc=AdpDzLbTo65HiJf_VLLdH8vljyXAXjaEyooREqjO6OQdYJuS8WOxfvjYudQ_8sZ-YnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NMmUzSmmZM1mx28YqK-MeYYhZt-wgj7qEjzfL19-Yyw&oe=6A046342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SojournsLandscape.png", "id": "1775457712975068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_1775457716308401_1536189248167635739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxfg10ZxJmAQ7kNvwHCN-fa&_nc_oc=AdqqRcYw-39IiA8CUAIKhi0LJHaOJHAjuNEj8eOzZGEYq-0trsG2oXJLd4PDC54c47g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Eu0wdusHWG8ULnrRENJKtPxjYw8B9RJvl8H3GqSjJpA&oe=6A046B6A"}, "display_name": "Sojourns Wellness", "keywords": [], "long_description": "Immerse yourself in a sanctuary for the mind with Sojourns Wellness app. Explore serene landscapes that promote relaxation and wellness, each meticulously crafted to provide a soothing backdrop for your journey. \n\nThe app allows you to interact with these tranquil environments in various ways, personalizing your space for a truly immersive experience. This is more than just a virtual reality experience; it\u2019s a haven of calm in the virtual world. Dive into tranquility and experience the transformative power of wellness today.", "short_description": "Experience tranquility with Sojourns and immerse yourself in serene landscapes and outstanding architecturally beautiful structures. Engage in relaxation while enjoying small tranquil activities and enjoying the company of friends from the animal world. Select dawn, afternoon, or evening for your escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmentedislandstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Augmented Island Studios", "support_website_url": null, "website_url": "https://augmentedislandstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35728771593376471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974525_950137652741332_9199325567333538269_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apBesgiko6oQ7kNvwFu3PaN&_nc_oc=AdqElEtqWi19FFNyO2wa69TVs5KVW1l5xLSWO8ik7zq4Yae8RmBvZVbJi_IZmh34GyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qyjTt4gAVuhzVkTANs5Ew2cIaE98pw0VcqsCPahP6AA&oe=6A049537"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sojourns Wellness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1708968900, "lastRevision": {"nodes": [{"id": "24528302676756808", "release_type": "SCHEDULED", "administration_status": "A
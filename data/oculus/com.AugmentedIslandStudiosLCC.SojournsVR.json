g?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vJahbauN50Q7kNvwEr20SA&_nc_oc=AdoQtf1iHk0LKCk7QqEtL6Z8puZNeSCfVN7V8h1sk9-DrTHZDVjJ4crWevT8KzEjS04&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKOBE9OneFeVhYs1qH5jE1KdHl7RH6krORvqDQwATUCg&oe=6AA96970"}, {"file_name": "Provence_Day_4K_08.02.png", "id": "916107236718338", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031529_916107240051671_9178672613812254110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQT4xhGfqBIQ7kNvwH150Sd&_nc_oc=AdrAfWcRlfRJqDpP3EqTOPT-tjOCzEH7aLmnZ4a2e0nwmWUKl8CuT2njfUmNSQHJe8w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyYleJCIzdW1EJBlkt0ONY1_lOk2wEMzGXhZ4mk6ij0g&oe=6AA96702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SojournsLandscape.png", "id": "1775457712975068", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974631_1775457716308401_1536189248167635739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb3SRiQnK8IQ7kNvwH9aD4E&_nc_oc=AdqN0caPMYGl6sQBkiYOa3R4aHe48J4gEZ1IOjejvJ4P9oHz3kaCYpJfwsRro1HxDg4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuxhgdmb2zBou2k-tEPYvdqgB5bMmruRo_0wW23ZkxEQ&oe=6AA936EA"}, "display_name": "Sojourns Wellness", "keywords": [], "long_description": "Immerse yourself in a sanctuary for the mind with Sojourns Wellness app. Explore serene landscapes that promote relaxation and wellness, each meticulously crafted to provide a soothing backdrop for your journey. \n\nThe app allows you to interact with these tranquil environments in various ways, personalizing your space for a truly immersive experience. This is more than just a virtual reality experience; it\u2019s a haven of calm in the virtual world. Dive into tranquility and experience the transformative power of wellness today.", "short_description": "Experience tranquility with Sojourns and immerse yourself in serene landscapes and outstanding architecturally beautiful structures. Engage in relaxation while enjoying small tranquil activities and enjoying the company of friends from the animal world. Select dawn, afternoon, or evening for your escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://augmentedislandstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Augmented Island Studios", "support_website_url": null, "website_url": "https://augmentedislandstudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35728771593376471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974525_950137652741332_9199325567333538269_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72fqMRfo-_AQ7kNvwGP-k8L&_nc_oc=AdrvhYRpXkGISGC6srNxixWlyGBwTN7Y2nA-tVdf77VifZv43Hc17b0Z3M43hYXYGrk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ0CB5e2dBRn6fHinEkjo801Ud5WyRBJV_Bq9zXJj8xA&oe=6AA960B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sojourns Wellness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1708968900, "lastRevision": {"nodes": [{"id": "24528302676756808", "release_type": "SCHEDULED", "administrati
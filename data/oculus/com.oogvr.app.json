835983_8500083055257234923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_39I_W3emwQ7kNvwHIBfFp&_nc_oc=AdrEKkALGtAiZ39jI9MrszTnWMWMUg7zvVG8Z6qtQwpg9NWCx1ijOZQY1XoO_7V2PEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW99Zhbem8p45zQTj7VLGLV-w9scyzyJLhgFUsXLl0DWw&oe=6B104DD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OOGVR", "keywords": ["eye", "gym", "orthoptics", "exercice"], "long_description": "EN - An eye gym in VR, by a lake at dusk. Short exercises inspired by orthoptics:\n- Visual check-up: questionnaire and tests, then a profile and a matching plan\n- Personalized daily program, adaptive difficulty, progress tracking\n- 6 exercises: convergence, fusion, depth, smooth pursuit, saccades, Brock string\n- Auto-pause if your head moves: only your eyes work\n- No account, no ads, no data collection. 6 languages.\nWellness tool, not a medical device: does not replace an eye care professional. Stop if you feel discomfort.", "short_description": "Train your eyes in VR by a peaceful lake. Take a visual check-up, follow a personalized daily program or pick free exercises: convergence, fusion, depth, smooth pursuit, saccades and Brock string.\n\n"}, {"images": {"nodes": []}, "id": "1129233846526526", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OOGVR", "keywords": ["yeux", "gym", "exercices", "orthoptie"], "long_description": "FR - Une gym des yeux en VR, au bord d'un lac au cr\u00e9puscule. Exercices courts inspir\u00e9s de l'orthoptie :\n- Bilan visuel : questionnaire et tests, puis profil et plan adapt\u00e9\n- Programme du jour personnalis\u00e9, difficult\u00e9 adaptative, suivi des progr\u00e8s\n- 6 exercices : convergence, fusion, relief, poursuite, saccades, cordon de Brock\n- Pause automatique si la t\u00eate bouge : seuls les yeux travaillent\n- Aucun compte, aucune pub, aucune donn\u00e9e collect\u00e9e. 6 langues.\nOutil de bien-\u00eatre, pas un dispositif m\u00e9dical : ne remplace pas un professionnel de la vue. Arr\u00eatez en cas d'inconfort.\n", "short_description": "Entra\u00eenez vos yeux en VR, au calme au bord d'un lac. Faites un bilan visuel, suivez un programme quotidien personnalis\u00e9 ou choisissez vos exercices : convergence, fusion, relief, poursuite, saccades et cordon de Brock."}]}, "developer_name": "Coza Le Fran\u00e7ais", "developer_privacy_policy_url": "https://oogvr.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Coza Le Fran\u00e7ais", "support_website_url": null, "website_url": "https://oogvr.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "en_US", "fr", "fr_CA", "fr_BE", "de_CH", "es", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1502951099557172"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1462333518565472"}]}, "baseline_offer": {"id": "1462333518565472"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795561800, "status": "PUBLISHED", "id": "1462333518565472"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1522125787639703", "version": "1.0"}, "id": "1435746141493114", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary
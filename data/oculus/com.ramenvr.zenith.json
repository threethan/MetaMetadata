A185EB"}, {"file_name": "Zenith_IR_Envirronments_05.png", "id": "297290993370687", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974829_297290996704020_2578907393445681887_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZKWX96fkWEQ7kNvwELGUmt&_nc_oc=AdkmR3TEam-8zQE03mJH1MuxPErD0t9QHj5uS4un6WEkHun9TxPNQvReAA_UlWm6gDw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuBp8STpB9zlsKjppaV82LBsfqLy9QIg4rSJYiD_E5cVw&oe=69A18B8E"}, {"file_name": "zenith_screenshot4.png", "id": "891288088789128", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031521_891288092122461_7961490759442283195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlLWd4uD_68Q7kNvwE9wcN1&_nc_oc=Adnp41Ggoo0OSLj6rvmPHKNzor9qXdWV-1j_SG7QA9yY6VXV-4nkQ0CN0vSkSaYpIaE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvOpp34elttPLTaEVejxo7OvnV3sHYszrUzMPwlZ6RZ3g&oe=69A17BCC"}, {"file_name": "ZenithTheLastCity_Screenshot_01.png", "id": "439053681040969", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982596_439053684374302_1112108776765823666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0BhsrifQIEQ7kNvwGoDi1t&_nc_oc=AdmMYaAzfxp-ekUeCxtj-qmrOTofFwjwPQN2xwZK-r_VOhm8ljheFYZpIVYR0D2C5No&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aft6u4aeOrKcbrVh9oRvO_ffnJlqToS9oUUHAGKhq59nOA&oe=69A1905A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZenithIRTrailerThumbnail 2560px.png", "id": "711772474140500", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982569_711772477473833_2942796963051377578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cexHg8A3-WEQ7kNvwHKPn3e&_nc_oc=AdngWiT62Q2iaHLDdBS0xS4co9XjoZs4NQ65xqUh4ApOMGO1Qzv08bA8D9LqUSwOIqY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftFacBRTVyn67T9bmnH2hKOJSuqDrQ3UDJ7efSTaD00QA&oe=69A178BB"}, "display_name": "Zenith: Nexus", "keywords": ["action", "adventure", "multiplayer", "social", "rpg"], "long_description": "Unleash your inner warrior, rise up as an agent of Zenith!\n\nZenith: Nexus has two action-packed game modes:\n\nInfinite Realms (Free to Play)\nParty up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations.\n\nThe Last City (DLC)\nPlay the most popular VR MMO, with hundreds of hours of content including epic boss battles and sick loot + 3 amazing classes to play. Team up with friends to tackle perilous dungeons, compete in PVP, or just explore a gorgeous anime world together.", "short_description": "Party up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skywave.zenithmmo.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ramen VR", "support_website_url": "https://zenithmmo.happyfox.com/", "website_url": "https://www.zenithmmo.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MU
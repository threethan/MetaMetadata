9D916B"}, {"file_name": "Zenith_IR_Envirronments_05.png", "id": "297290993370687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974829_297290996704020_2578907393445681887_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MiU0_2rpYgQ7kNvwH_0OEr&_nc_oc=AdlDP8ZZZtpIQwhpo_ZyjKGDhKhma-36tbCh9Gu0WHvFmWQq4NdZnG7zRCCynyCLPco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3m1Ln1D5aLqEGrIIaNclB9er9wzr3UmH0BENl0of8fw&oe=699D970E"}, {"file_name": "zenith_screenshot4.png", "id": "891288088789128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031521_891288092122461_7961490759442283195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWv77DY0yyUQ7kNvwEg8aIU&_nc_oc=Adk6mvPcAdg7LWbbOsiNakbJbgPnOx48aGYqD30UqbYdfEkzA4HORcRcCU_T-UkeWBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftd8vwgm8nH0qdl1wDZ4MHfch06-_67C18Kj_0q0IKhBw&oe=699D874C"}, {"file_name": "ZenithTheLastCity_Screenshot_01.png", "id": "439053681040969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982596_439053684374302_1112108776765823666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbMBc9v5W-wQ7kNvwG5BWAX&_nc_oc=Adk2Blm-ohkIKTR2cJiWKqlc5s0ivVZUEhskKi9WlzZcN3AQ8bDR_fIfekj8hc1LVR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2Qe3H2HieYSNfsIYtSUFzgSk3V4-2fT1QfiVEFkF2pw&oe=699D9BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZenithIRTrailerThumbnail 2560px.png", "id": "711772474140500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982569_711772477473833_2942796963051377578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDTXqy_SvagQ7kNvwFggsrT&_nc_oc=AdmAtVukeivVSPXDfaHMS2U4oliua8Ts0hQhfb5uc91_gbFhFx1FSJPqxpLNPxF7ZCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7E2NXHpapfNV3CwLf_Us4VQFXji1fQahE8xoBcdg4vw&oe=699D843B"}, "display_name": "Zenith: Nexus", "keywords": ["action", "adventure", "multiplayer", "social", "rpg"], "long_description": "Unleash your inner warrior, rise up as an agent of Zenith!\n\nZenith: Nexus has two action-packed game modes:\n\nInfinite Realms (Free to Play)\nParty up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations.\n\nThe Last City (DLC)\nPlay the most popular VR MMO, with hundreds of hours of content including epic boss battles and sick loot + 3 amazing classes to play. Team up with friends to tackle perilous dungeons, compete in PVP, or just explore a gorgeous anime world together.", "short_description": "Party up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skywave.zenithmmo.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ramen VR", "support_website_url": "https://zenithmmo.happyfox.com/", "website_url": "https://www.zenithmmo.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MU
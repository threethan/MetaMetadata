A57A6B"}, {"file_name": "Zenith_IR_Envirronments_05.png", "id": "297290993370687", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974829_297290996704020_2578907393445681887_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8lXHjwJvQ4Q7kNvwEE5Tpy&_nc_oc=AdnPv4bZom5RSgbJ8zU8Os8fjg_tFcibBRAa4Z_5LajjdfGTkSBUCJ2hXwMmLcCwbyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftJ7kdq6ZvoZi25Uysuk1zb6kNTkPvfxfJZnlvQMVIK8Q&oe=69A5800E"}, {"file_name": "zenith_screenshot4.png", "id": "891288088789128", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031521_891288092122461_7961490759442283195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9-vpPKFpqQQ7kNvwHaYgvt&_nc_oc=AdlZJPt8nlGHRYun7xPBqXM6JZb_vwnzTg4NQmwqdH8yne3xkxFnucD47oudVHs8q7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsuzRPGogTFO9hDTQj8iyrO5yvnz-a3EL7zAFbgXdDimg&oe=69A5704C"}, {"file_name": "ZenithTheLastCity_Screenshot_01.png", "id": "439053681040969", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982596_439053684374302_1112108776765823666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CjAvnoL8TYQ7kNvwHm_BCW&_nc_oc=AdlXjiUhPIZhVLk8lwS2R6genxI20NsEo6DMU-kFV_b1T6VhcVo9LV0Nv98btvuReFo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv3CEhZRCLcIy6yisA-OKl1ekJBGLShct1SGugonz6W2Q&oe=69A584DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZenithIRTrailerThumbnail 2560px.png", "id": "711772474140500", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982569_711772477473833_2942796963051377578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YB_J2HMHSXkQ7kNvwFvRRZa&_nc_oc=Adn5Dr4S-l7MxV61djgXi7Rcd5uq6W1q-Kb0RWsr2VxVQ1iaOJu8SfB2ainQscoIZes&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft7yD40yEE8r_ig300k_uLSZ962mobwuV0o29wm97g8ow&oe=69A56D3B"}, "display_name": "Zenith: Nexus", "keywords": ["action", "adventure", "multiplayer", "social", "rpg"], "long_description": "Unleash your inner warrior, rise up as an agent of Zenith!\n\nZenith: Nexus has two action-packed game modes:\n\nInfinite Realms (Free to Play)\nParty up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations.\n\nThe Last City (DLC)\nPlay the most popular VR MMO, with hundreds of hours of content including epic boss battles and sick loot + 3 amazing classes to play. Team up with friends to tackle perilous dungeons, compete in PVP, or just explore a gorgeous anime world together.", "short_description": "Party up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skywave.zenithmmo.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ramen VR", "support_website_url": "https://zenithmmo.happyfox.com/", "website_url": "https://www.zenithmmo.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MU
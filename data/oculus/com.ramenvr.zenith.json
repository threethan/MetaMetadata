9EE2EB"}, {"file_name": "Zenith_IR_Envirronments_05.png", "id": "297290993370687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974829_297290996704020_2578907393445681887_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MiU0_2rpYgQ7kNvwG8b9EL&_nc_oc=AdkRrq2-hdNTUMM4ytrE5aiPsWAb3vUci8macpjSF1HwKDfAuDaOz7HAPlxianUq1mc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQtlisie5RI1TfZgH2rYTzowOc8Ri6pF7LX3ZV-XwFIg&oe=699EE88E"}, {"file_name": "zenith_screenshot4.png", "id": "891288088789128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031521_891288092122461_7961490759442283195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWv77DY0yyUQ7kNvwEC8yvP&_nc_oc=AdnhU9P9hBT6QKkDqjYe-DrD92lnQKZDU4SeGA_nkekhPOuEhv8kuA77AD4Z-pg29K4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvpw1i3o2ah1HnS7fI2R8hlVFQmVht85Q7tFRc_goAZzA&oe=699ED8CC"}, {"file_name": "ZenithTheLastCity_Screenshot_01.png", "id": "439053681040969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982596_439053684374302_1112108776765823666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbMBc9v5W-wQ7kNvwFrxX9Y&_nc_oc=Adkd1pKit3QNJExB-iPCPTmi9wKzqhucf7qRzlNEnrb_I6dFWfKNnvRAbrDObg3Vr9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsVctH16xnxl5_q3tX2viMU6kLOaXeWWwHdoUtqKoT1Uw&oe=699EED5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZenithIRTrailerThumbnail 2560px.png", "id": "711772474140500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_711772477473833_2942796963051377578_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDTXqy_SvagQ7kNvwFqO56U&_nc_oc=AdllGr9Lf0nVy1Uo2J-g0WEYxeAMLcz3G-cL87mJkBHFrh-dm7Pw3WwJTv4cUH8R-BA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afstt8pugnuQmfMzkLY7Yw-HPj776S7iSTq56PlDBfzXpw&oe=699ED5BB"}, "display_name": "Zenith: Nexus", "keywords": ["action", "adventure", "multiplayer", "social", "rpg"], "long_description": "Unleash your inner warrior, rise up as an agent of Zenith!\n\nZenith: Nexus has two action-packed game modes:\n\nInfinite Realms (Free to Play)\nParty up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations.\n\nThe Last City (DLC)\nPlay the most popular VR MMO, with hundreds of hours of content including epic boss battles and sick loot + 3 amazing classes to play. Team up with friends to tackle perilous dungeons, compete in PVP, or just explore a gorgeous anime world together.", "short_description": "Party up with friends in a free online action-adventure RPG! Slash mobs with magic and race across parkour challenges in quick session-based runs. Meet up with other players in the city to upgrade your gear or just hangout and shoot hoops before your next run. Sessions stays fresh with daily and weekly content rotations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skywave.zenithmmo.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ramen VR", "support_website_url": "https://zenithmmo.happyfox.com/", "website_url": "https://www.zenithmmo.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MU
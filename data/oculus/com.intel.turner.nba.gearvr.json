tent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEcF3CjovaEPYadCzHEwOCJxpoCwar6a8gHU_UAiRJwQ&oe=6B0F1EED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NBA on TNT VR", "keywords": ["sports", "basketball", "NBA", "livestream", "free"], "long_description": "Watch NBA on TNT games in immersive virtual reality. Be transported to the Inside the NBA studio where you can stream select games and events, including 2020 NBA All-Star and the NBA Playoffs. \nAuthenticate with your cable provider to be fully immersed into the NBA on TNT virtual world and access live games and full-game replays.\nFeatures:\n- Live VR Cast of the top match-ups\n- Choose your camera angle to experience the game from different vantage points\n- Exclusive play-by-play and analysis by NBA on TNT personalities \n- Game highlights available for free\n- Behind the scenes at 2020 NBA All-Star\n- Select games from the 2020 NBA Playoffs\nSupported Devices:\n- Samsung Gear VR Galaxy \n- Samsung S9\n- Samsung S9+\n- Samsung S8\n- Samsung S8+\n- Samsung Note8 \n- S7\n- S7+ \n- S7 edge \n- Oculus Go", "short_description": "Watch NBA on TNT games in virtual reality. Be transported to the Inside the NBA studio where you can stream select games and events, including 2020 NBA All-Star and the NBA Playoffs.\n\nAuthenticate with your cable provider to be fully immersed into the NBA on TNT virtual world and access live games and full-game replays."}]}, "developer_name": "Turner", "developer_privacy_policy_url": "http://www.nba.com/news/privacy_policy.html#/", "developer_terms_of_service_url": "http://www.nba.com/news/termsofuse", "publisher_name": "Turner", "support_website_url": null, "website_url": "http://leaguepasssupport.nba.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MOVIE", "MUSIC_VIDEO", "SPORTS"], "has_in_app_a
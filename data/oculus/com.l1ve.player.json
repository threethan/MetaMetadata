XsCjNqD-g&oe=69AC006C"}, {"file_name": "Screenshot4-Celebration.png", "id": "1423750335541044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819881_1423750338874377_4615313826685218949_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e6Vm5BpXhYQ7kNvwEQ0eWB&_nc_oc=AdkFWHMgh3Qkam8QPGs8YmG2-neopLoNdvMwGWxwqGtGbR9G8YTdjXfbqrMWKP0K6pY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy674Q0G0FU5oXMWNM63uw6tQRt5q-6hXEkncXafzt2dA&oe=69AC2ADB"}, {"file_name": "Screenshot5-Tennis.png", "id": "1281344840099744", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823328_1281344846766410_778289026127426260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOcUbylCzjoQ7kNvwHmhv-l&_nc_oc=Adk0xjYbAMW8f8zP17YPIXfJJm_3hfVHMNMPkRFSoK-RmOEhTewadJ6q4ieCr6RrMO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBP792wc97NVXht75cteLkGJpMydpJEsJtgB-co1WaFQ&oe=69AC16DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "L1VE", "keywords": ["sports", "football", "concert", "event", "live"], "long_description": "L1VE puts you at the heart of the action. \n\nWith L1VE, you stream sports, music and culture live in 360\u00b0 and 3D - straight to your Meta Quest headset. You're not watching from your couch - you're in the stadium. \n\nFrom football to car races, from tennis to sold-out concerts - L1VE delivers that irreplaceable live experience. \n\nKey features: \n360\u00b0 live streams in 3D \u2013 feel like you\u2019re really there \nChoose your viewing angle anytime \n\nMajor events in real time: Bundesliga, Supercup, concerts & more \nVoice and hand tracking for full immersion \n  \nExclusive to Meta Quest headsets. \nBE THERE NOW. ", "short_description": "Sports & concerts in 360\u00b0 \u2013 be there now "}]}, "developer_name": null, "developer_privacy_policy_url": "https://prod.l1ve.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "L1VE GmbH", "support_website_url": null, "websi
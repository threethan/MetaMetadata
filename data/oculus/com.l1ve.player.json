dn.com/v/t64.5771-25/491819881_1423750338874377_4615313826685218949_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OACrPPUmnfAQ7kNvwHoVth2&_nc_oc=AdmVh6a7zmkSDLOPGCKrSnUWHCHBLOjybLff2CRQj7oum_OqQvzSmQeZyaUURi9VAeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuik5QawPklJVX3Hbxi4vTukFGRxlU-0BPV0UwgOjVPqw&oe=699EFBDB"}, {"file_name": "Screenshot5-Tennis.png", "id": "1281344840099744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823328_1281344846766410_778289026127426260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqfiFFV8_q4Q7kNvwGBOJf6&_nc_oc=Admj0BYjxILiuQAUSQXaOekVyzG1LhyuWj9wm-XVXD32x8XGMFid3-hS80OOBoInh6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsJcS-c9joZk56KsHNFGo_WQcqIiPe2dMoFDc9mvUjX-g&oe=699EE7DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "L1VE", "keywords": ["sports", "football", "concert", "event", "live"], "long_description": "L1VE puts you at the heart of the action. \n\nWith L1VE, you stream sports, music and culture live in 360\u00b0 and 3D - straight to your Meta Quest headset. You're not watching from your couch - you're in the stadium. \n\nFrom football to car races, from tennis to sold-out concerts - L1VE delivers that irreplaceable live experience. \n\nKey features: \n360\u00b0 live streams in 3D \u2013 feel like you\u2019re really there \nChoose your viewing angle anytime \n\nMajor events in real time: Bundesliga, Supercup, concerts & more \nVoice and hand tracking for full immersion \n  \nExclusive to Meta Quest headsets. \nBE THERE NOW. ", "short_description": "Sports & concerts in 360\u00b0 \u2013 be there now "}]}, "developer_name": null, "developer_privacy_policy_url": "https://prod.l1ve.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "L1VE GmbH", "support_website_url": null, "website_url": "https://www.l1ve.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221144
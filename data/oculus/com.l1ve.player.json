eRMy7mUug&oe=69BAB92C"}, {"file_name": "Screenshot4-Celebration.png", "id": "1423750335541044", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819881_1423750338874377_4615313826685218949_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rP0XQXKLS5cQ7kNvwEmjdA6&_nc_oc=AdmbG972EBpiDb9Eyg0Qoz7xAIZ7pWgaxyvVuwdTTl1pQ_5odsu_dtlrTtP2C6X8d-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy35CCTwPsG0l-z50EnZO9vPPPf1ciT14ccoFeKC2HMng&oe=69BAAB5B"}, {"file_name": "Screenshot5-Tennis.png", "id": "1281344840099744", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823328_1281344846766410_778289026127426260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cs1AQwMQxmAQ7kNvwFzr8Fm&_nc_oc=Adn1dgg-rQSw9VnsLYrcp2KMDqMQ2Ju5gVTUF_a5Q4I_1e88PzUKMfHvOby5VGs6BgA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfznQ0R5M7A8zugcsczTw8z3E928eSv3mSQ0aQQek-BUbA&oe=69BA975F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "L1VE", "keywords": ["sports", "football", "concert", "event", "live"], "long_description": "L1VE puts you at the heart of the action. \n\nWith L1VE, you stream sports, music and culture live in 360\u00b0 and 3D - straight to your Meta Quest headset. You're not watching from your couch - you're in the stadium. \n\nFrom football to car races, from tennis to sold-out concerts - L1VE delivers that irreplaceable live experience. \n\nKey features: \n360\u00b0 live streams in 3D \u2013 feel like you\u2019re really there \nChoose your viewing angle anytime \n\nMajor events in real time: Bundesliga, Supercup, concerts & more \nVoice and hand tracking for full immersion \n  \nExclusive to Meta Quest headsets. \nBE THERE NOW. ", "short_description": "Sports & concerts in 360\u00b0 \u2013 be there now "}]}, "developer_name": null, "developer_privacy_policy_url": "https://prod.l1ve.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "L1VE GmbH", "support_website_url": null, "websi
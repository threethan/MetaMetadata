1_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9MG9je68uYQ7kNvwFM8caR&_nc_oc=Adpr16tlnKa5gwHd8m3v2bj_7j-_YGDViku178RgD77Hr4iYku609WFfe31YZ7GIh6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg-ffMu5SWiShXKHsE5J5ygJLG1J525flDtvHtWIJ3Jg&oe=6AF88F86"}, {"file_name": "12_desert_front.png", "id": "1080673038067758", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593919959_1080673041401091_411225404705761650_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edZDTPnjfj8Q7kNvwGZ8JGY&_nc_oc=AdqDHb3dSusLPN-fpjQaZQFtNa5KSSfBtv_zsVXWsgnuy6hhxhRSN7-eWV15I-Q5TAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkM2XyOCfjP6HuMq9VsTlu42AB69sv-92RpsNS6NpkAw&oe=6AF88C6D"}, {"file_name": "04_snow_nitro.png", "id": "1586769356827650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619382_1586769360160983_7275583543105206237_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZUT0yfPE64Q7kNvwG5zE-3&_nc_oc=Adq64bD_Szfff2Q8AQcvrinM4hdagGhwfVU1EQ8vGBVGlssiLtRK9mN8nNDz35fm7yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyPx4doSyDQZ7UMTFnVvMr7d8U1yz3l8W3jv_o-gGc5g&oe=6AF87FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2188725408719460", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298248_2188725415386126_2746572359640374569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BBw1yWtnwoQ7kNvwEzfJPd&_nc_oc=AdqUjaZ4JbNdfGxNtxbANG48kQHzPqHrB9JsNlWrqHQusEUtOGWpCG6_TbNT_gYVHdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq8bA5lrwmyUbSXAxrAvmHZjPtVh3-M2V-xC51ru3gEQ&oe=6AF89C8A"}, "display_name": "Crazy Traffic VR", "keywords": ["racing", "highway", "ambulance"], "long_description": "Full throttle. No brakes.\n\nClimb into the driver's seat of a speeding ambulance and take on an endless three-lane highway packed with traffic. Crazy Traffic VR puts you inside the cabin: reach out, grab the steering wheel with one or both hands and swerve between cars at full speed.\n\nDRIVE YOUR WAY \u2022 Grab a real 3D steering wheel with your hands, or steer with the left thumbstick. Both work at any time. \u2022 Hold the right trigger to fire the nitro and feel the speed. \u2022 Arcade steering for maximum comfort, or Realistic steering for full control.\n\nWRECK THE TRAFFIC \u2022 Ram regular cars off the road to earn coins. \u2022 Never touch a truck or a bus: one hit and your run is over. \u2022 Watch your health, your nitro and your distance on the dashboard instrument cluster.\n\nTHREE HIGHWAYS, THREE CHALLENGES \u2022 Desert, Jungle and Snow, each with its own distance record. \u2022 Easy: no damage, relaxed driving. \u2022 Normal: crashes hurt, 2x coins. \u2022 Hard: crashes hurt and the clock is ticking, 3x coins.\n\nUPGRADE YOUR AMBULANCE \u2022 Two ambulances: start with one and unlock the second with the coins you earn. \u2022 Ten levels each of Speed, Health and Nitro upgrades.\n\n", "short_description": "Grab the wheel of a speeding ambulance and weave through crazy highway traffic in VR. Hit the nitro, wreck cars, dodge trucks and upgrade your ride!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/6VdqwM7iX4rvaXyE8BJaow", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/6VdqwM7iX4rvaXyE8BJaow", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
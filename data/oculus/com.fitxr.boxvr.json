name": "migrated_image.png", "id": "610775142806089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974501_444896586081961_7025688832573964288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv9vClCIKSwQ7kNvwEx67qX&_nc_oc=AdqMdviiP1YTpmxUiVzO0BjZpD3ZGg2gNP6JhqadRN1jCt5C4W7Q06qvGF3GngJKM_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j8nu6NKGWMEDSaY9o-loAapizBA2bC0DgMmyy6JgsYA&oe=69FA0500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/cKnxwW", "id": "452154672212602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003278_452154675545935_1677441104275832832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aidraUpc8YQ7kNvwH7X2Tc&_nc_oc=AdotGV_6hM0S4gc1hBVQJiD3UjmZ6s1xmbugsNV0d4ZCxkgYhBxg0Q9oF8PkrzuQFSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5esPEmfhaoVmoQlE_qDkLmFFZ3lmIb2kDc2t6GKjx9Vg&oe=69FA12B7"}, "display_name": "BOXVR", "keywords": ["sports", "boxing", "exercise", "rhythm", "dance"], "long_description": "\u201cBest VR Fitness Game of the Year\u201d - VR Fitness Insider\n\n\u201cA game for everyone that wants to get ripped\u201d - Discovery Channel\n\nBOXVR brings music enhanced, boxing inspired workouts to Virtual Reality.\n\nWorkout Classes by fitness experts\nLeading fitness instructors help us produce a variety of boxing workouts, specifically designed to destroy calories in the most entertaining way ever devised! From short 3 minute warm ups to 60+ minute endurance workouts, we\u2019ve got everything you need to give you a fantastic cardio workout!\n\nTrack your progress\nEvery workout is recorded so you can see how many calories you've burned. Set your own goals and see your progress day by day to stay motivated.\n\nWorkout Music Variety\nFrom Rock to Pop, Dance to Hip Hop, we\u2019ve got the music that will get you boxing to your favourite beat!\n\nMake your own playlists!\nWith over 100 different music tracks you can create your own workouts with varying levels of intensity.", "short_description": "BOXVR brings music enhanced, boxing inspired workouts to Virtual Reality gaming.\n\nWorkout Classes by fitness experts\nBeginner to Expert Classes\nEffective cardio exercise\nSet goals and track your progress\nOver 100 different music tracks\nMake your own Workouts"}]}, "developer_name": "FitXR", "developer_privacy_policy_url": "https://fitxr.com/privacy", "developer_terms_of_service_url": "https://fitxr.com/eula", "publisher_name": "FitXR", "support_website_url": "https://fitxr.zendesk.com/hc/en-gb", "website_url": "http://www.fitxr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "fr", "de", "es", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "340453477940532"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "837163412804718"}, {"status": "PUBLISHED", "id": "3375088092587224"}, {"status": "PUBLISHED", "id": "388866692188796"}, {"status": "PUBLISHED", "id": "4503703136310792"}, {"status": "PUBLISHED", "id": "187884909561513"}, {"status": "PUBLISHED", "id": "775608432956013"}, {"status": "CANCELLED", "id": "2342860946021294"}, {"status": "PUBLISHED", "id": "1096296984677424"}, {"status": "PUBLISHED", "id": "159484348833108"}, {"status": "PENDING", "id": "679571393686580"}, {"status": "PUBLISHED", "id": "2154370708187653"}]}, "baseline_offer": {"id": "83716341280471
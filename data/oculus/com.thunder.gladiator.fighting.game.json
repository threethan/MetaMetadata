uluscdn.com&_nc_ss=8&oh=00_AfxmHg7yk5Gq9awG1BIPVhl9epda9nJ901UI8bLW2-xmSQ&oe=69AAB8FA"}, {"file_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0OE2u4_I8cQ7kNvwFZ98Xp&_nc_oc=Adnqbi4gcFACSk9PBnc91alX-6k-6xNPONHyi5g8AtcNBvC_McToX2LZ8ZXOBlcu6kI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-QIHAzrRIBjUAj4lj2eYVYDDijgzI7NXnXP3UurWFLA&oe=69AAB65E"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7KSUN5sCXwQ7kNvwFLfnwW&_nc_oc=AdmUanozdSbB7tvnxjjubk01RQEXjLKSj7PTduF5WK9JzFcm2BCA4v4p7u9jkjKhE98&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdrQ6bK7qsZx_4yxqVAi3dcHKPKIC4Ih8goNmmjzxfIg&oe=69AABBC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nazadYmgCbQQ7kNvwEkTD4T&_nc_oc=Adn6W3G6fCRz-5tWlUeUE5krkF4wp-AdU2ChUtTv37RuO2Mu02nHHmVr8If8rxKEFAM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfztbDKqfw9C40Rvm3nll6nH8KsNfoOkM09vWPAYT2lPyg&oe=69AAE757"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWxAkbtzaF8Q7kNvwFM3orO&_nc_oc=AdlFlg-C7K8T23AsPrfH_4IvVuBI_dXhi9MsDJB7fv1x0jrezTSLs_5BQa2pUKn2GVQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQoi1eHc0iGtLZpN82OGU8cXmFPYN6JCkzGDVY8zYi6Q&oe=69AAC817"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"conte
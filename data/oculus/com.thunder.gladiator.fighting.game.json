e_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuOeT19gQuAQ7kNvwH6Dnvw&_nc_oc=AdmXkDHPXXYjsMlhu8aja8pbnr55RqcgxcH8pFZjgCyA-ZrpQhDw_zL-qN32BRvTMkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftOV_pvf6vcSBt8YYUJAxYto10_xCUJeuk9q0d7MKm74g&oe=69A41EDE"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfqoQ65Ddw0Q7kNvwE3n_6r&_nc_oc=Adn2vehAPYIO6faT0O0v3Dp9yMLt5VfPWQDG5jniG2K1z6-p6flzvpUUoXltvoFcLss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6atBA8Vs31R3GVua-Tf69TAnpVGAPO3-Yp4cr7htPHw&oe=69A42445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX3fUTEOylMQ7kNvwH0PjRH&_nc_oc=AdnjIGVGxRftPQX46new2k7La0ecVQEkcai1D9KzA5qjHKxPOggUbrl_KeVuq8FYXFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afud9oC99lquq_sLy1p7C_fqgKamzCUCNb4cP_yad2V_YQ&oe=69A44FD7"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTpB3TXif6MQ7kNvwGExdyY&_nc_oc=AdkMQX62-6ck8S358mw1LHT9XG0ze8DBdbe7gvkBotjmMGMv-4Y7CQmM7rtbb_j0mO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsW5mYBsqBTUQwtJHQ9fiU_plrZIh2MrlM6jcRL_Vx_2w&oe=69A43097"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_n
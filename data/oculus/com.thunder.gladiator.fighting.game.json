e_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPKpCuAI4eQQ7kNvwENXRai&_nc_oc=AdnWYkyzCIM1HK4u8Qq6miKnT9yU4xHy7Ni8sQeQcBkwbNuJ91vbpV8z-pU82bg4i00&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afuc766dl92EKfgyElBCJq1GDxU4TNg03i_4AbJbjq6DMA&oe=69A17BDE"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfqoQ65Ddw0Q7kNvwGWtqq0&_nc_oc=AdmX4kWJWVIhQZBFZvvRFOLeAcEvtnZGBE8GF_X4s92GEgVJL7_7qfOrS00yNx-hYCc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuVNen7jionhMYk_hcdP2dg2iFjPoARSYfP1Ue8ajGqqQ&oe=69A18145"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX3fUTEOylMQ7kNvwGzXKo9&_nc_oc=AdlHS_YD8kElWjKg7iOVzzhFAl_zWGzdMhtfgrwscffLMKlx4d9wlodfg7S9yt2ME4o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afue9kbFpRxHkJ2RHI0Vgi2JFwgW-WwoWj3Lj8RVK8hLeQ&oe=69A1ACD7"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-79t_-STG8Q7kNvwEOcROA&_nc_oc=AdnPeE5Vb1hSF4J31oGyJ_N1b_d0GeU0fb3jW48CwxXZl2RuqNTyJ23QR3S5hB2XKxc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftnKcm0Qg84UgD1A735RIHcIuC6TeP3vamSfsy5PEd2rA&oe=69A18D97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_n
Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vjZNWchqerUFLCrifxza_xwuX0OtzfgCGwEUsna_PUw&oe=6A11C63A"}, {"file_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxPe-yOVkRoQ7kNvwFOnZVl&_nc_oc=AdromANleK9aN93ReBEvppod0lEZPe6c85J-r-4mSPqTFDM94Fvpzlb3ipe5fhW6Y7g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qtqk_USM-NraBSiz2ci4K8mZBkt9AlPUDcbOH6XNa6A&oe=6A11C39E"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBVa0YRyrpYQ7kNvwFZskKg&_nc_oc=Ado_N3hE1FGrAmUnH4CfL4ZXy8RZbqxXEEkZrtTgP500t-GYG4JSd3qhlBwRQ5qKsOg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75wPyVEXzcdsARc7HRudgUF34fgW5IkRz3glnJ6n9h5w&oe=6A11C905"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcUDO0-6zqkQ7kNvwH9Y91E&_nc_oc=Adoc0Ig1_iKyDkdogiRKs89akER22njXh-Ve9shvUuuhNGlCfzRBSzb1wl5k0HHEBww&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wr6RsA2fCUxb-F90qGNVUWXPrtvV_1iNV0T7e9ERgMw&oe=6A11BC57"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R2gqS5bo1sQ7kNvwFrY5dM&_nc_oc=AdqdKWX1gmFwTXMfAwKxa4dVXxPdIDlOMjPGHWnmqlIYbsyxbRSq-jIKDAAWYzu9_G0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GKJVvz_6N0LyfjGaeNUfQrnMB4MV-yaQbTQILTFJMWw&oe=6A119D17"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game",
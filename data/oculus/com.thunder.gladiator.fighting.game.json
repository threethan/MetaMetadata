cdn.com&_nc_ss=8&oh=00_AfxOfpwWZct6wY-X5Qd5BvBaVcRNCUFhhHjM6VIpGv6nsA&oe=69B6967A"}, {"file_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rybHKqyPf08Q7kNvwFGtX7A&_nc_oc=Adm02pOWiN2fu5jKXD6OXewe28v3abOvnbo85E6t056im-agCnVlFvxIQSE7GEglcho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxarlO-19U0GwU_fJmtXphVDMSi8q0EBWCqRj2r5ApKw&oe=69B693DE"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K1bLxHP9oIQ7kNvwF1pi4p&_nc_oc=Adng7gH3Xw58EcYswATSzqR-vIrR15ctcBJPHhx0ei6LYlMddTK7BmLX1YQEN4A5ptc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWm-GGLnwSfIylt5mQyO-irooB4MzQz1-eAfJY1r9S8g&oe=69B69945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgGU1dYBHZQQ7kNvwGV4a2t&_nc_oc=Adl4YX5Mj4FbLb2f7TlagrBJeQpdBisrIqmfNqQzuN2iItyScv2dyWTAk4MAlYRs6A4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxs9R9rfFvemHM7vjOwpQfDFXTUYRpDd-yOopA7-PqHVQ&oe=69B6C4D7"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0q8ofdYTK4Q7kNvwGEp0pJ&_nc_oc=AdkvvpP1EfeUxacVlf7MXoHF28f4qJxEIrlJEwAqXCdOha2JSWbWsJj5XafvN-drkXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSiFUwVqwKhE8yHb1dPRhdxoW1bU8uc5_UEkOoyedfAg&oe=69B6A597"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"context_cat
cdn.com&_nc_ss=8&oh=00_AftX0NfioVo2qGQmYV-WAKOe3HBZztZqiPu2IuR7Ue-qNw&oe=69A815FA"}, {"file_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0OE2u4_I8cQ7kNvwFykDPc&_nc_oc=AdmTv3FG9c-PcEzW2OtHur-HRuwjRsA2G6dYQuqw8WumdCkQeIE_XWLull4zpiAaqHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuNMBsHMLkUNwlZbocsXdhiVJZAUhn5Zxg83wxeIr2w7w&oe=69A8135E"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlUkVqgNgE8Q7kNvwGXCepM&_nc_oc=AdmRoLjumqlJZdeg2cgVaTMTkRDaNisPV1j_mHuEnKtk_aLzDoVldesSCkJb2erpZfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5Ir_CKSvxXbw8XuE8tuQSZIO1eFhVhyg2b5hQ8PoX1g&oe=69A818C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP6RQGamMs4Q7kNvwHDD6TU&_nc_oc=AdmNo04kGfWhJE9P5DnoNcv1DWkK7NTPKo9kZ7KbXKNeh1eCK3zncHyCOemX4fmuZKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftgYT0Cg8X4o1btjj3XO2oxlO88b9l8C3ht1acjy6v2fg&oe=69A80C17"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWxAkbtzaF8Q7kNvwHkGrka&_nc_oc=AdnmadC7WqZfE61r4UeUzdcU9TyqdYWU96FVjGr4aF_qKDPRHTXgGG0rU-_yia8MEZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIggSPuK2v909JfDLDTk8xjqBbeAyedWp3ZPVLMOwyAA&oe=69A82517"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"context_cat
1pLRisWWxq-1HucrnpewSRg98ASwyfQ&oe=69F1E9FA"}, {"file_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yhsZcaye8sQ7kNvwF7wdEE&_nc_oc=Adq4_UkCItaSb6XWcpt1CKMnxR52znQcuL44VvoJzQgVobURv7qnTHXblRLbfEsVk44&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af000FJ17tyd9k1gflOmL6Hd9BeYpvYdmvkZ5Xn6OK8Dfg&oe=69F1E75E"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53Zn69D5MbAQ7kNvwGttNaj&_nc_oc=AdqjZcmyC_x6pn4qgkEhl1UwsEc98EsEunAKZ0qQkALB3xqS9GnahycmqfTwra113ac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af28c5QpKm5LiEKbqTzjX_gqFJQl0FCqYPfoqiRr5GIMUQ&oe=69F1ECC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMk5XysiYEoQ7kNvwGuAGqm&_nc_oc=AdofNbBu47iVKJes0It2SFYUvzdwtaJhja5gcVpDAkCzY9HOdgm0f4gJ7XRSO1BPpEs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0SJ4usr4eFKKh3eDtNIyx10RbcY8OJ6AD4Qx9r2nnPMA&oe=69F21857"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyPErSEWyEkQ7kNvwEBWXiI&_nc_oc=AdqOTaWt_wq6XTVAOzzgLF402oZOTM6-mil_YzFUZ6z3Bow8gDHXcngpnHG0WFrRDsE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FH6X-DoMXxKVLVnNETmf6UhcY89T7YdE_biBwSYCmvQ&oe=69F1F917"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "con
cdn.com&_nc_ss=8&oh=00_AfxyAAY1CjAhsrYD2gdA-xfl5qxNSwa5i6UyXw9u_sX8HQ&oe=69B7E7FA"}, {"file_name": "2.png", "id": "1050493172698463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974508_1050493179365129_2688386042649854639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2OsAyfSY7sQ7kNvwHSpy0t&_nc_oc=AdmPX6cuXuc3jBZ5RV5EpcnJGI3K9iwAkn_COjO1_exwWOYos4bOAFoE7rXyyfYM7ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw389KA4mxAhf25wUEBPKgglKu8u2gwpB4bbSF0z1Mf5w&oe=69B7E55E"}, {"file_name": "1.png", "id": "893186809331037", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439594_893186812664370_3406911142599199308_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K1bLxHP9oIQ7kNvwHcyTUz&_nc_oc=AdlRpvHpXiVvx7QSlvlm5hUUOSd1NpHCPre7Cb7fCywETlZccQ9ro89R9ak9SjiJ464&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8fCkr8uyT4hT4TMPnMRr8gua5H699mgF1Ovzi_RfTSQ&oe=69B7EAC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "1842190333274057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_1842190336607390_5863826604000137757_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgGU1dYBHZQQ7kNvwGsFi4r&_nc_oc=AdkDd77k7F3gvKjW_RJ5NAb_2IR1SEApT_foYLn8eDNvByJIGrjd3lFGkarpz8AdpW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMGuWEpgboWgdoafxlLZqATt_U1t3x_iB9qAmZcDkaIQ&oe=69B7DE17"}, "display_name": "Thunder Gladiator - Sword Fighting Game", "keywords": ["sword", "fighting", "gladiator", "action", "horror"], "long_description": "You can practice with different weapons like Bow/Arrow, Spear, Sword and Shield etc. Once you are ready to fight, take a direct one vs one challenge to fight a gladiator or enter the Arena where you fight a wave of different kind of fighters.\n\nThe game is still in development and we are continuously improving the fighting AI and graphics. So stay in touch and look for our frequent updates.\n\nThe story mode in the games lets you find your way in an underground tunnel to find and rescue the king and while fighting the enemies, lead the king back to his throne.\n\n", "short_description": "Fight one to one by a Sword and a shield or take the challenge to defend yourself in an Arena or save the king in story mode with different weapons and types of enemy."}]}, "developer_name": "XZ Solutions", "developer_privacy_policy_url": "https://skippyapps.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Skippy Apps PTY LTD.", "support_website_url": null, "website_url": "https://skippyapps.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28519978430983841"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_3064764707007259_2744837324681832296_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD9iy11QEQUQ7kNvwFmmQju&_nc_oc=AdnNZQXVq8QYB1Fe0dA3QMeS62FtYikfOoJXDkC0GDIC9BNsFmmp1ibLh8cqdRUmIbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz27o2J6GXZrfQSsIn1pKl9OchJLQqcq6c3coSCx3lSDA&oe=69B7F717"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thunder Gladiator - Sword Fighting Game", "platform": "ANDROID_6DOF", "context_category": {"context_cat
NvwFxqsj9&_nc_oc=AdotKxj5XQVqwd9bxbLWAqN16pHCJy4aNdqjWyChNk_cznzZcG5ScW8arHEPgagP9_g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Bj6gaJNRYItiA-xKe1GXqpBcrwua6blF0C4q1pZfVw&oe=6A32B195"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc20dF0ClFwQ7kNvwGrtWtu&_nc_oc=Adr52thW5elAysIonGwWes-jQR66rluZO3VxIPk2aWgBRMxJIkEYe26Qxacpg9Kjrv0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82nlLMmkeiUoPJa3EQeO0cMhMq9SOYd7jD30KImmWdeA&oe=6A32B736"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nZzR00AEgIQ7kNvwFpZafr&_nc_oc=Adrki6x2NsLVczirq_coeeFjsPa1WoGaTtiWf2I0-lxKT-A-Ke_GIa8UMDnccttRgaE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EO8nVgQYqv5fYaQR_uiU1VL1TrPyEy8_AFFri6G8VfA&oe=6A32BCAF"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL-vTWJPy6sQ7kNvwG-hjZe&_nc_oc=AdrV5vr1szkkeN5TGuOLeKLoK4bjlgxrGRbDtcT7tE_e6pTTfK-epYZvvf1G-1o_EGo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F_i4JZ38YhmIL3dFZIZT512NLG73ViVlaDM2-y3dSjw&oe=6A3290F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-
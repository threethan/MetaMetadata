ntent-iad3-1.oculuscdn.com&oh=00_Af2-zdeTNc5iIgJzayJarj4it1EOBfAhJx8JXjUIKZWHjQ&oe=69F0C695"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6B6tthN13wQ7kNvwGuVwPQ&_nc_oc=Adovgnd4TM80DDog2qEjRmF6THuxBMX9rYEc4zEuNNZk-AEnEJIBfZfqHOv91xhFkhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3l1rjAh_O4582Fi_lLItP5tge9UQyN18j-P_RjWwztBw&oe=69F0CC36"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOxVBegRhNIQ7kNvwEqpO8l&_nc_oc=AdpjqTVbUNY6y5GUQ0AtKM0EFOom8aeqo-ssBCJAWglr3rSGxBuEqmbPCgBi8ZW-ZAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Cnp1C2AUFegzt0p9zlBl9J4C6j1MXNdfxF7a_OTJEOw&oe=69F0996F"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD44YykkNYEQ7kNvwGFEQNw&_nc_oc=AdqvtcfWGmP7lE2F_3j2HmiLoqMI-zBXJZ1xzbTJg3mYb0kDZYYKkfwV3yrDJXBtRDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1hHfP8vSsZYYlXXptSpwS9cezZBYYwJk8JSPBkqWqmHw&oe=69F0A5F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162791_980468362104808_4409566476680298496_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LipFPJYAov0
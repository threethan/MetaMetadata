NvwGwUW_I&_nc_oc=Adph0BP_sGlOtfa0uUwvFHE0J85x8DU37d44KMILdBBIBo7BuFH4WPZ1Ms3YSTSs20w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0UlzPzeAkcX80zKKJqJNIWZ0oZPoYEA4uHdFwkQo4-Q&oe=6AC65995"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxwtysqE17kQ7kNvwGNNf4a&_nc_oc=Adq6ryYaGe2jVYsb1sACOzfC7eMtOPIvVVKdtKe5r81xDqk1YmEcyP3Xq23ZOafm6kA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOhlWAFHcYwq42FfiPM1XUfADZHxeqn3gcdVrTnQCXcw&oe=6AC65F36"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBQFqVLKHmAQ7kNvwFKYLBK&_nc_oc=Adpprtirset1SeCVQVPHKcj0Ak8wKs2HawtaMBa1hiYY4v4ZWwScoYkSrn0vf1u7sBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA1j2HMU0ejZaTnr03sEBcbXeW7gem19VmmCuaxIXgBA&oe=6AC664AF"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU8Vcrxi7XEQ7kNvwFGnbYX&_nc_oc=AdoZDRJ7ZuzPZlKzBoqK6BS03FOnWZ_g0qne_uCnQEagyzc0CXiy1AYsYfwp9SJSGQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7jEeIrc3PVgYDh6Q-zFi0HDM_1cH5Zm6Jm6U42Wc3FA&oe=6AC67134"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-
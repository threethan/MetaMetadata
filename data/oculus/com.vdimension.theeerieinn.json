NvwF7G7oL&_nc_oc=AdoOar7GSABsi8GYZcoBcUa9CHwzDkEkbh6d3ikfcKgEPTeKH2XfzBB7ylxDvRGnrVQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ksZvN2KdMNkXYWVMosk-L9z-eJ2unxGnt0OwfROkDNw&oe=6A3D3D95"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w98g4qnwMz8Q7kNvwE4DcP0&_nc_oc=AdoDQ1FSaMFf7uklbRrxo-PhABbR8CFO-jFVEQD9ne14TCOEj87a1oVh4Z998v522EU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PpONo6YntAyDfzy5UKYK561-X2yfi8WiVpsBF6axzEA&oe=6A3D4336"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJgwMgli5MMQ7kNvwEAv2L7&_nc_oc=AdrjYW_5hqUJxa_J4z4jMnkMVgScxMJoQ-YObYidwujmPXy_L6Z5NnrDBUinLbPngCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rzsQVdIPm6IpmlfLZuDCSCnEp1MUETSQEZH4z_xO4Jg&oe=6A3D48AF"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kW5furnOzQQ7kNvwExNUA_&_nc_oc=Adq7zztL6xQMWY3oyDV9chcpns29GxI-8SRIUAIX8dt6caZV3j1bsYJdp3tdv_ygZdU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hqsx6DWr6TI0RgKf3ESSqc4A7Ip5w1IoHocsQm9Ig1Q&oe=6A3D5534"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-
NvwHf7EqV&_nc_oc=AdpQ7mY4my5UE6cqcY61O5iW3h2qEFY1_InztWlzo2Ely5skN9dRbIC6ZK92BwBRGY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPs14dOTS2ubidHHgJniTXmyOWjqAgM6XGSi_4tU5kJQ&oe=6A773F95"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlhBg8vWkXUQ7kNvwHz_Enu&_nc_oc=AdoVrG61_X9b8KlMwd5xbYTjofKYvFZw42_w8awC6kL_ncfwtT9XaNTd6rOOJxXY-Aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2oHdnE2cgClEBw7UlBfaroprbqbXapAaAEffsXM5nYQ&oe=6A770CF6"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wvjDJgxntkQ7kNvwE86xVj&_nc_oc=Adomqfgk9Xbie6RjA7DeqJCH0g0Z_q6xOuRB5EQ7TlIJSbPdkmiwyX77t4b6y02vXZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKbJte1jeYaDxKuxUeRwFsS8VL68jXmy5D7JAuikTnUw&oe=6A77126F"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C129WobGUl4Q7kNvwGk53zI&_nc_oc=Ado2QJmoLp0E6XVk1BMOD-g22DfoCwzi4B2iK5R5aLNSUc6WTX2iNkBxg7-KSaxAhK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdyQ7AK-xt8s96eVlItAbm9qHp2xJtDpB6VATcVQd_mA&oe=6A771EF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-
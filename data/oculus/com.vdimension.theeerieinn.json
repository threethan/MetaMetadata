NvwHZGaF8&_nc_oc=AdoVliI5GuAr4kF-aOwO49QEoXBxFvsZ9X80u-8uyTsIiPaeydUWY2A9-Ri7lvCS6xY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNSPwG7cpUemuxDQW6VyUh8A3TfWvrRk3eFKPHy_dEeA&oe=6A734B15"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKJzfjBbYFYQ7kNvwFBdMs9&_nc_oc=Ado_bc7xQMIpJPC28J9w8jbl9ZKHZr4VVhg71hsLa-bLpqcrWXTJRu1RbCYn1A4_uMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHET2msLviTSyKsGKhlPzIj81rfRfcuvE5bWk9qiRzEAw&oe=6A7350B6"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vItVnHPu65AQ7kNvwGbFBPg&_nc_oc=Adri1572OVRakWEhREusyUvWZDrkpjylyc3iaKx_0C5I63b_494LFymJvx9StlDsYnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMrifqlW7NC2bu3nBDwiJihUKlwHNaBIJovDHR1XqQ-w&oe=6A73562F"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sosh82rXD3gQ7kNvwEydX3g&_nc_oc=Adrj59T54_tDDBPEgpLYKn9RBVKkkQHa2jM3vLtpezqSYGpgKNixLONwiW0Vl9WlkRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRITAqgIvZMEl-15Ge1UjyL3nyLi7pAqLN0XKNxpuCWQ&oe=6A732A74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-
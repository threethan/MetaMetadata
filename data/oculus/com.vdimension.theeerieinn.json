NvwFTVr7_&_nc_oc=Adqte74fWQ1yBUIMjoWALfXwCEQRN38xghJTe8kioe8k2f0mrpCb8r1pgm5N60vSkYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyl54NCHqpB1ZUCVrH2D9P8dmqrN900CjGOe-oqP1X-vA&oe=69D12295"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ax5fa4RAj0Q7kNvwGFIP1a&_nc_oc=Ado8ErWrKMQJ1c9gLcOfiSKalIeQa-ysyEo7N885-eNKoNWtKxPa5UjkZHedln84rNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzYnVVx-4B2cH9NafbEswc367F4i6sLA0g6WNO1U_7lg&oe=69D0EFF6"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J12PNdWHsA8Q7kNvwH7Rm3N&_nc_oc=AdruCFqLLZnwDEeWhEVbESV-m9aYiybQSWWmb1qz4N-gwShEQAWzef-pfg5xSsG0aDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0ge4BPIgAKLuCKgW3ptnkFBXWmRMZhP--m5RU_KaL2g&oe=69D0F56F"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGCCDPKUMvIQ7kNvwF2PWrR&_nc_oc=Adq3PCELD3ZROQMqX2zX-K0WJP3btCw2ZTapWmcydKbGCkqNyEHGFx-N7yJf0T8TuxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSUcnP5O3N1nIWvo0XZ5pclWhPJQZAHFLCn9Kp7noMPw&oe=69D101F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-
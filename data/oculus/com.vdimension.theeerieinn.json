rYItP1NakxSZ60PbaxiaR-HwcrJsaA0_CHMDl-XLiRAvCqfr9VALw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9lu_pSXj7c6HqEDDUuInnefmh9Ccdsyq6MZZmvKTAkQ&oe=69CBBBF4"}, {"file_name": "migrated_image.png", "id": "229606238160754", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139031_151079165581757_1107752076584157184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCkaXu6NorkQ7kNvwHwmUKq&_nc_oc=Adq7gLMCfqOw5fbBvJztVmz3fHSIj5yD0nPVaD8ZERmdmKeAH4UqE5gDdeuKVzHqOF0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzt8_S6tE6kWPnnJ2U12xROukIsIeIuvUCrSjf2QHIxdA&oe=69CBC46F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterB.png", "id": "152611698750236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410280_152611702083569_7716457352026652672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7snYOlZUrAQ7kNvwFSbVeo&_nc_oc=Adoyb3JRFWRa6fplziSP-3sbF8v5r27eGRyEfZfoTQBd3_XPOtawjESbkCuN2pFA0WA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWfVqrKToMOaOGrfuewO5-Z1s4Jhe5ATkN1UE287FvZg&oe=69CBCF36"}, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "The Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "ADVENTURE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "319912993374325"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "499187150479361"}, {"status": "CANCELLED", "id": "441334972957416"}, {"status": "PUBLISHED", "id": "327009568067624"}, {"status": "PUBLISHED", "id": "367956433955618"}, {"status": "CANCELLED", "id": "173175706727277"}, {"status": "PUBLISHED", "id": "1318523868326573"}, {"status": "PUBLISHED", "id": "304896083441077"}, {"status": "PUBLISHED", "id": "2684783311579863"}, {"status": "PUBLISHED", "id": "211923796063367"}, {"status": "PUBLISHED", "id": "234809397278357"}, {"status": "PUBLISHED", "id": "441387443099115"}, {"status": "CANCELLED", "id": "263041257601566"}, {"status": "PUBLISHED", "id": "221032895347114"}, {"status": "PUBLISHED", "id": "117991512818001"}, {"status": "PUBLISHED", "id": "191792761746316"}, {"status": "PUBLISHED", "id": "1274749889343833"}, {"status": "PUBLISHED", "id": "239212413744711"}, {"status": "PUBLISHED", "id": "1354627557972870"}, {"status": "PUBLISHED"
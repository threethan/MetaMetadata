cdn.com&_nc_ss=8&oh=00_AfwUpGBFkzbMzuWmaq9M7I1EQCaknNSdPewCEftwn5GSPw&oe=69BA9874"}, {"file_name": "migrated_image.png", "id": "229606238160754", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139031_151079165581757_1107752076584157184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kCQo68GMSEQ7kNvwEBM1XO&_nc_oc=AdnK0RzPFLHKO8eirCX_eXpq09r-Ro74xRMk3Xlnnewf2-wojW8l3H5DxcrIcrZ-P7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyTGBRz1q_V64UQF28ZKpjA-ENumrulya0R5S9ps8k6rw&oe=69BAA0EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PosterB.png", "id": "152611698750236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410280_152611702083569_7716457352026652672_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNgeCZYYDmgQ7kNvwGnxqA1&_nc_oc=Adlj-A3Y2vnVmfkX98i5e8R5RC3lhXFAF1dDNajG-XpZ1h7fTZw69RDhFmfF_wLZuL4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2rh6M_1r5DS0QvRXfqZibQo2hfu05Q3jgS9b8RHG54w&oe=69BAABB6"}, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "The Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "
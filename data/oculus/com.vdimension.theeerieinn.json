NvwFatNBz&_nc_oc=AdorLfDR43AIjkz3Pw0sGq__L0K3LaePTcW2jASgC5gjCWLPW7QWeqPd3F2lSXJ6KcI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6T1LJhK9aZKrpoWCdLraS-xurmuXP46kBp-WAbPmTqQ&oe=6AE35A95"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu3lajxVjhQQ7kNvwG01oVk&_nc_oc=Adp1wTsiOouAM91fKfgKnhQfJurcmb3Kv1V9f0-MFfULI30cOakoqZi9B_BL1aIymO8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTMQvzgNUMSuR-_52TJMxqv2srr1V_PDZN-EHOtQN9Sg&oe=6AE36036"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niMSwNBLh8Q7kNvwGoXU5n&_nc_oc=AdrdU8bjU00staR-SEImfeSqoXQZYSA7R55TgevlzVXKgdgS38OwRaJK5t5_WH1oMDw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2o19lmjO_la0mq85jgzPMUOARFL9T_bx97AJ76YqZOA&oe=6AE365AF"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG-7nTLaGcQQ7kNvwEMevuP&_nc_oc=AdoP2JGzI6SDrKMfDxEr0tathwDpMI_qMv-SUhIC4_eQoUvdHzPWmQZE26VKS-x_7hU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzQDaZFs9p5N8x0dkRgqS-V_T6r9XDhBHDC019CjR-0g&oe=6AE339F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-
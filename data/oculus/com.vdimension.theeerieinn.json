NvwGmB295&_nc_oc=Adqzk2maVQA0k2Qu5Ide8w20PM8xRKp0LHcmY1k7roApvMajPAJR33COeYM0S5-ZPXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxC430V5FyKFS3eDXQyZ2lLl7w8FE1MM6NGxdZynWWHw&oe=6A637915"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP3ueOzXbtUQ7kNvwHm9Qbu&_nc_oc=AdpI-b2YGvR3g8bXReSXhBeC7t7Tg6KOHI2-OgX2iRKQXYBgKOGBiNTHdNG_isEmUDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrech3CnrEN7SamTeR6vQTcPjUGfLJJq2AA_3vZBl3KA&oe=6A637EB6"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AP64b3MABQQ7kNvwFC4rk1&_nc_oc=Adr7xC6GosiISWcMpDiLO1mWscpq5mQbhDRNWCmRQRmJ_YTJESPt5zK-Vas4AY_PnF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4nbzhoPcEpu6s-DB6maI4C6j_kvCW1iLPBHds9Kdkiw&oe=6A63842F"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhb9Yjs-QqMQ7kNvwErnC1F&_nc_oc=AdoIHXwiNLjZQY16qenktah0YdWQzKJHoF6wQLHGTwRQjvH00ge-8JVWJ6vSCocVcnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtDpKKS9mPZyj8zOm7a9GhZjxl1X8nH4Y_FI8dYO5kFg&oe=6A635874"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-
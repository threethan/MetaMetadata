NvwHxgyyA&_nc_oc=AdoZoMwi-xt9fXLR9_m-7uMwAT5riAUTMEljub0kDm5eOmf1Tdw9h7MauK0jjkX5g1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89q4HoCgVoaSyCUPnxgji2N2WsXSbR0MOY5AYdvGK6Ig&oe=6A3FE095"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w98g4qnwMz8Q7kNvwGVv5Rb&_nc_oc=Adr9baGnbJWWn8y22MfwZ2NsCkmkrWUo2tvirb2xo1MKxyvvT5KQvRqreiSMAKWpoag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_346VCPZgfFIKDPETDY3-CAQbDD_0H4VpxnCPkyWHhZg&oe=6A3FE636"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BoMoX_6FX0Q7kNvwFqsebE&_nc_oc=AdrXqA2g5Pg7dG7mQCFLRpf4DY-3Sg-lYJFBT9vLA0gwYdVnIZx-1TISUjvji1HlR80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-PX5qyE8GURO51A_3-QNa0TsMv6PVCBxQc_EZOV8yCQ&oe=6A3FEBAF"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kW5furnOzQQ7kNvwHmbNxU&_nc_oc=AdrM6ZpkZfIXxz65sx-Eyl0QDzjmj9GaBobR4hDfYY354oy0aD5tzC9XvwJVU6-Hki8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s5X8gEDOifrh-CUzGM2LZsF9T4_CU9qy6SiSezyITwA&oe=6A3FBFF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-
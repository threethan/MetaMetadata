NvwGNYAzf&_nc_oc=Adqq1yRHI0bTZ_9KrpKcYWBOd6Ow7FXJ5qoMrmhJLggwXkN0HXmw3A-R6iqR0PHF-Qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d34f7Hx2AqdFhN8jq991ybNF_Em9Hi-vEwnlpPEMHpQ&oe=6A2EBD15"}, {"file_name": "migrated_image.png", "id": "530426267858758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410355_1975264732543541_2411392388858642432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP-TnsJ3BJIQ7kNvwH3hEIs&_nc_oc=AdooD83aapU3BLpNwmc-ihC2OsK49SHx9lQ2LSylhqpvtZk-DKzo05CRUe8kZJFh-Dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dDA5N_K51HcWVgaFYcj1E8COuA_oviY_wvgYNZcyCoA&oe=6A2EC2B6"}, {"file_name": "migrated_image.png", "id": "342347980056149", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410407_210733672999429_1638985964267241472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSZ7agsVeokQ7kNvwFTLNqe&_nc_oc=AdoVIP7I9BfFS1GYxuL60bNyWOs5zvO11oBQlhez3oVHIDy42-x_pfnKHAPpdRol8N0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84PAps2ui9S2NE3UCGhU1BXM8cXpBJQLupg_pIBOHIpg&oe=6A2EC82F"}, {"file_name": "migrated_image.png", "id": "324494808507688", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331258_1032368623569077_357585658371375104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9itUdDSGG0gQ7kNvwFzWB5W&_nc_oc=AdoNatlhN4-jnbeLxrPxSsbhm7Kbkwwf32SpRbHrZU1bTmb3hcySJKGQj7kzM6fQQbU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85PNwp-oWraLWPkrP__FrFE99Hu7-qWhJh4AeVDvDUqQ&oe=6A2ED4B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Eerie Inn", "keywords": ["horror", "scary", "ghost", "puzzle", "mystery"], "long_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house...\n\nThe Eerie Inn is a mystery, puzzle-solving horror game. You play as one of the girls and your mission is to find out the truth behind the mysterious things happening inside the guest house.\n\nDetailed graphics coupled with great suspenseful music creates an intense horror VR experience unlike any other. \n\nWe strongly recommend standing up while playing and having your headphones on for greater immersion.", "short_description": "Tired after a long day of hiking, two best friends Kendra and Jen are on a lookout for a place to stay for the night. On the advice of a passing driver, the girls end up in a cosy looking guest house located deep in the woods. It's not long after they had settled in their room that strange, unexplainable events begin to happen. The girls soon realize that a dark secret was hidden deep within the walls of the house..."}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3264698233812282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-
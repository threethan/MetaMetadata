om/v/t64.5771-25/491824700_971191605693021_3631191210866594662_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqiJb-FQgFMQ7kNvwERM-_8&_nc_oc=AdraH-2VPA-3YeoKrENZRrsdbghDeuHgNgomNUy-mFXAmmYE25-uiUITmpUqT3iEWhI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs7A3si6dUSb2GUA8NqJGWAi8HKhJD9JSKuX0VczJ27g&oe=6A94212A"}, {"file_name": "Screenshot 2026-05-29 at 02.02.19.png", "id": "1350416536962893", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491825415_1350416540296226_5243969835936086699_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGuK2Y50WDkQ7kNvwEz5kJ3&_nc_oc=AdoDJmTVn55LXCpJIh2MA3Zd5NrX-GiGOQFAuZf_tD3dSf0DhbmgH3X_TVrp8BxUzUk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5QsZ-8fdq4FOaezgUH6_lE5onS0HBUPlsIrmfUf3kKw&oe=6A94201F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Heart Sutra VR", "keywords": ["meditation", "zen", "buddhism", "heartsutra", "mindfulness"], "long_description": "Zen Heart Sutra VR brings the ancient Heart Sutra (Hannya Shingyo) to life in\n  an immersive virtual reality experience. Sit in a traditional Japanese zen\n  room, surrounded by tatami floors, shoji screens, and seasonal garden views.\n\n  # Features\n\n  - **Full Heart Sutra** in brush calligraphy with furigana, modern Japanese\n  translation, Romaji, and English translation\n  - **Interactive instruments** \u2014 mokugyo (wooden fish drum) and orin (singing\n  bowl) with realistic 3D spatial audio\n  - **Six spatial presets** \u2014 Zen Room, Dark Meditation, Mosaic Mandala, Cloud\n  Sky, Flower Field, and Real Mandala\n  - **Mixed Reality mode** \u2014 meditate in your own room using device passthrough\n  - **Seasonal gardens** \u2014 Spring cherry blossoms, Summer green, Autumn foliage,\n   Winter snow\n  - **Time-of-day lighting** \u2014 Morning, Day, Evening, Night\n  - **Adjustable playback speed** and ambient BGM\n  - **Freely reposition** all canvases in 3D space\n\n  Perfect for daily meditation, mindfulness practice, or experiencing the beauty\n   of Japanese Buddhist tradition in VR.", "short_description": "Experience the Heart Sutra in a serene Japanese zen room. Meditate with calligraphy, mokugyo, singing bowl, and six immersive spatial presets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tomocreateinc.com/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tomocreate, Inc.", "support_website_url": null, "website_url": "https://www.tomocreateinc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1072321129306035"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499627034_1643938260017800_6978885543454812768_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL2GQB_Wny8Q7kNvwEAxqON&_nc_oc=AdrJ8-WvnltWcOOrUhdJL_RIROC0x76cIgIyVO-MuU_HI_FXX1tbk_DNiHtvrkzq8gI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWcHI4vDcNeEzwgNDORBK4rhNcCHCxfc-S_S8AyD8SmA&oe=6A941210"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Heart Sutra VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1780348980, "lastRevision": 
 "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556792_1119216316163656_2042213341237326713_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8V8CcPoSbgQ7kNvwE_RyBg&_nc_oc=AdpnsKfH5xlwyS4ByXMAfG0fUy1lnBVHigNW9EP9qkM8VVw2YxoFnq8iFeYUfkURXn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8yLyovLpQI2wb1hsDJwoUWehel2U3KQYgTiRuhHEsTQ&oe=6A57792B"}, {"file_name": "75222942_3352535634788958_3406873242936279040_n.png", "id": "1832236563789950", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974813_1832236567123283_5045216323281058666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRs8NpCe0FwQ7kNvwG-I2h2&_nc_oc=Adr6U7SzjqCLzS5g98OOsfpmsP4aTbyFA0kPyvi3KzmaB2f-3cPhThIzGkl102BXC9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiqwvt_PXGLZM1t5S1wD4FM9uZbDRFtvYcONxlVy9Xnw&oe=6A579A14"}, {"file_name": "london.png", "id": "268711699583705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982687_268711702917038_6715306634678464001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IixcWGKy0wgQ7kNvwHPMrpD&_nc_oc=AdoZY9fmMKGTr0_01fjA68p42z-LsFRa9yRPh-1T2ozy9G-zijhA1R06ISt8eZcYeXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClpHoustf5hagZieoT-bE3j-QZHa_IiL_kunZbG7Lf6g&oe=6A579C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover landscape Dynamic Languages.png", "id": "775951773505876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001681_775951776839209_9084072416654271782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jJlGGGk-ZUQ7kNvwHLzPAi&_nc_oc=Adqh7qz2sPgMIwFlfCyRw88w0aZJZDZWR4pTeDqDUWYxAiAHxSN8179YXVsWXWZ_dCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw2LV_cwWqpceZJso6DiC3IobJxd3VzO6cJEary2cR9Q&oe=6A5774BF"}, "display_name": "Dynamic Languages | Travel Learn Explore", "keywords": ["language", "spanish", "travel", "japanese", "learn"], "long_description": "# Travel the World, Learn Languages and Explore Cultures with Dynamic Languages\n\nSpeak English, French, German, Italian, Spanish and Japanese in VR Lessons, Conversations & Trips\n\n**VR Language Learning**\n\nWe use immersive media, speech recognition, and AI features to get you speaking your target language in authentic environments.\n\n{940274188002028}\n\n# TRIPS\n\nTravel the world, **repeating keywords and answering questions** while you\u2019re immersed in the language, history and culture of the country. \n\nIt\u2019s the **most immersive and culturally enriching** way to learn a language.\n\n{2035478786929292}\n\n# LESSONS\n\nGo from zero language to having confident conversations in Japanese and Spanish with on-demand, immersive, 360 video lessons.\n\nUse your new language skills and speech recognition to have fun and interact with your teachers and classmates in our beginner Japanese and Spanish lessons.\n\n# CONVERSATIONS\nConversations are our newest addition. Speak with real people and practice communicating in realistic scenarios.\n\nAvailable in English, Japanese and Spanish.\n\n{2723267598062079}\n\n**LIVE**\n- 150+ Trips in English, French, German, Italian, Spanish (A2-C2) and Japanese (N5-N2)\n- 40 Japanese Lessons & Conversations (N5)\n- 5 Spanish Lessons\n- Spanish Conversations (A1-B1)\n- English ESOL Conversations\n\n**COMING SOON**\n- French, German, Italian Conversations\n- More Trips\n- 2 New Languages\n- New AI Features\n\n**OUTSIDE OF VR:**\n- Worksheets & Transcripts\n- \u201cHow to Learn\u201d Video Series\n- Discord Community\n\nSubscription app with demo.\n\nSuitable for individuals and groups (schools, colleges, universities, etc).", "short_description": "Travel the World, Learn Languages and Explore Cultures with Dynamic Languages.\n\nSpeak English, French, German, Italian, Spanish and Japanese in 360 video Trips, Conversations and Lessons using speech recognition.\n\nTake guided VR Trips, repeating keywords and answering comprehension questions while immersed in the language, culture and history of the country.\n\nSpeak with real people and practice communicating in realistic scenarios.\n\nSubscription with free demo.\n\nSuitable for individuals & groups"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dynamiclanguages.org/privacy-policy/", "developer_terms_of_service_url": "https://www.dynamiclanguages.org/vr-app-terms/", "publisher_name": "Morning Calm Productions", "support_website_url": null, "website_url": "https://www.dynamiclanguages.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25680834538243795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_464879349019939_8212375786746065589_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBBuz9mMw3oQ7kNvwHw59q0&_nc_oc=AdrT_vnDC-Dj-y2jB5mY4H-0PUQQviHe_3WJ5h2qgpctMqltfkqAjZGvCjT9mOtDIz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_VCqvxP5QoB5JjOn9uuK7vGHkRz1U2R3mpsptk0XL1g&oe=6A57905C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dynamic Languages | Travel Learn Explore", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3626922114428
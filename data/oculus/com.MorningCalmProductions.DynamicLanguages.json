&_nc_ss=7f20f&oh=00_AQCIKeLLzrdcMD5RSOCBlCrrnER-Z8ZnDkCb9oGFTI_Kyw&oe=6A579C0C"}, {"file_name": "2020-07-22_15h48_10.png", "id": "492027596113388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974676_492027599446721_6289552645526637796_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0X7ni3TNL0Q7kNvwE7PMyo&_nc_oc=AdrMslzQido6JC0JcYjaHrUFcNS6lMUIBqsBw19nUP6f0h9hVuXARvvG_Ze42fsrEMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvq1dXTK8yjw6MEswwVGi0OdovYKRJ2Z4vtgkeKmFdYA&oe=6A578010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover landscape Dynamic Languages.png", "id": "775951773505876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001681_775951776839209_9084072416654271782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jJlGGGk-ZUQ7kNvwHLzPAi&_nc_oc=Adqh7qz2sPgMIwFlfCyRw88w0aZJZDZWR4pTeDqDUWYxAiAHxSN8179YXVsWXWZ_dCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw2LV_cwWqpceZJso6DiC3IobJxd3VzO6cJEary2cR9Q&oe=6A5774BF"}, "display_name": "Dynamic Languages", "keywords": [], "long_description": "Start speaking languages right now in Virtual Reality!\n\nConquer your fear of speaking through simulated interactions with virtual amigos in 360 video encounters.\n\nBuild your speaking confidence in realistic scenarios, which simulate the emotions and nerves of speaking a foreign language.\n\nDiscover the culture, history, and language in immersive, interactive videos in Trips around the UK, Spain, and Asia (coming soon).\n\nExplore 40+ Trips and feel like you\u2019re on holiday, soaking up the sights and sounds of the UK and Spain.\n\nImmerse yourself in guided tours around breathtaking sites.\n\nSUITABLE FOR BEGINNERS AND ABOVE", "short_description": "Start speaking languages right now in Virtual Reality!\n\nConquer your fear of speaking through simulated interactions with virtual amigos in 360 video encounters.\n\nBuild your speaking confidence in realistic scenarios, which simulate the emotions and nerves of speaking a foreign language.\n\nDiscover the culture, history, and language in immersive, interactive videos in Trips around the UK, Spain, and Asia (Q3 2023).\n\nCurrent languages: Spanish, English (Q1 2023), Japanese (Q1 2023)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dynamiclanguages.org/p/privacy", "developer_terms_of_service_url": "https://www.dynamiclanguages.org/p/touvrapp", "publisher_name": "Morning Calm Productions", "support_website_url": null, "website_url": "https://www.dynamiclanguages.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "293623352838973"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1379970486503818"}, {"status": "PUBLISHED", "id": "615344750322152"}]}, "baseline_offer": {"id": "1379970486503818"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738623780, "status": "PUBLISHED", "id": "1379970486503818"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26961207333539836", "version": "5.4.1"}, "id": "467360971769182", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4890053391081880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26961207333539836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "467360971769182"}]}, "change_log": "Fixed a bug where content completed by new users were not being marked as completed", "created_date": 1780208217, "id": "26961207333539836", "version": "5.4.1", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4890053391081880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26961207333539836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "467360971769182"}]}, "change_log": "# App Update V5.4 - Speech Recognition Improvements, Session Data, Major Bug Fixes\n\nThis app update dramatically improves your experience with Dynamic Languages. It fixes countless bugs and little annoyances that have accumulated over years of updates and new features. It also paves the way for the next major features, as we begin organising session data more effectively.\n\nThis update includes:\n\n- Speech Recognition Improvements in Lessons and Trips. You will see far fewer empty utterances and better output from the speech recognition engines. We've fixed countless bugs, applied updates, improved the UI, and run extensive testing to create a much smoother experience.\n\n- Trip Questions, Keywords, and Recall Quizzes - Much improved UI with countless issues resolved that were causing timeouts and freezes. You'll now also see the % score for each response. The acceptance threshold is adjustable from the settings menu (recommended default = 75%).\n\n- Subtitles on Trips - Fixed a bug where the initial subtitle on scene startup was incorrect. Also, Trips in English to destinations outside of Britain (e.g. France, Japan, Spain, etc) now have English subtitles.\n\n- Trips Audio Playback Speed - Slider now operates from 0.7x to 3x Speed in increments of 0.1x. We have improved the pitch handling at higher speeds, which is something I (Co-Founder Dave) love to use when watching Trips in English.\n\n- Added \"Downloaded\" category for multi-headset fleets. Students can now filter by \"Downloaded\" in the category dropdown to see which Trips are downloaded on the headset and avoid buffering issues.\n\n- Session Data - We've restructured how session data is organised on the backend. This is a necessary step toward better display of user progress and unlocks several features coming in subsequent app updates.\n\n- Fixed a bug where consenting new sign-ups were not being enrolled in our newsletter and sent a 10% coupon.\n\nWe're a bootstrapped start-up on a journey to be the best VR language learning app in the known metaverse. We want to provide immersive engaging content for students to learn language, understand culture, and go on exciting virtual travel experiences.\n\nPlease report any bugs you find or any other issues on Discord or by using the report bug icon during a Lesson/Trip. We rely on our lovely community to tell us what to improve.\n", "created_date": 1779261029, "id": "26826881260305778", "version": "5.4.0(9)", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4890053391081880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26961207333539836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "467360971769182"}]}, "change_log": "V5.3 App Update\n\nAnother app update on our quest to be the best VR language learning app in the known metaverse. This update includes:\n\n- Multi-headset download functionality is LIVE! Now educators can queue 360 experiences to download onto VR headsets using the webapp. Select and add the content from the library. Content is then downloaded to all linked headsets. No more buffering when streaming, no more wired transfers - just add to download queue before your next session. Video tutorial coming soon.\n- Optional Two-Factor Authentication added to accounts. Manage your account more securely with 2FA. Turn on from your account page: https://webapp.dynamiclanguages.org/account\n- Speech Rec improvements - handling spaces and longer sentences with much fewer errors & faster scene change after correct answer.\nBackend improvements incl. folder path update & new CDN for thumbnails.\nJapanese subtitles added for Trips.\nPlease report any bugs you find or any other issues on Discord or by using the report bug icon during a Lesson/Trip. We rely on our lovely community telling us what to improve.", "created_date": 1774404025, "id": "26189497900710787", "version": "5.3.0", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4890053391081880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26961207333539836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "467360971769182"}]}, "change_log": "Fixes a bug in Account creation that was causing issues with users subscribing, following our new Accounts system in V5.2.", "created_date": 1771399114, "id": "25858270937166820", "version": "5.2.1", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4890053391081880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26961207333539836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "467360971769182"}]}, "change_log": null, "created_date": 1769526872, "id": "25660427140284535", "version": "5.2.0", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
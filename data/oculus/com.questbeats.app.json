nt-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMZ2tuEWaPfSTH4dxw-dZ62C5HaWYVy8j7iV4P3bACCQ&oe=6AB7E6E4"}, {"file_name": "2.png", "id": "1273159691369306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585720338_1273159694702639_404141029068854424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmVjiPHyEmYQ7kNvwEs0Zg_&_nc_oc=AdqFdZkkJAOllsHF9YhoNxPToFhqikqU320lR_WEnEm-IybaV5KPzmLX0MlCVq1q8Qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGAUKxGDUCZP_pbkUszu5DRRPYgntLTTq0U7bZuMsOMg&oe=6AB7BA6C"}, {"file_name": "3.png", "id": "1536231880846006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1536231884179339_2618165617522009052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPPwo1oAd50Q7kNvwGEAaj6&_nc_oc=Adq14nQpOSczJeVNLGbCJQZqDiMgVZ3CzPd8YLhJMIDB2xsmtORjYnv_WwCeNK830Lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFZwHY6EgbI7Htj8DRq3hL4EQFQWD8qLXyCOEVGCs1jA&oe=6AB7BE5C"}, {"file_name": "4.png", "id": "1001201795857448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827987_1001201799190781_7374232112589748580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBsYGszmmo0Q7kNvwEunnKB&_nc_oc=AdqGskw4Yguz9ELSd0sRZRdHvYZSKlR8BGV-yVc4O8kbsWgQFLnCFiNuDzLi2Q314Ng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ81t7bDYY2b-ghPThoza2M0cZKKClzWzZvoImhYGUQjQ&oe=6AB7EC70"}, {"file_name": "5.png", "id": "1495177118594950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1495177121928283_6512099545258046337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu1iU8G9p1AQ7kNvwFCw5z0&_nc_oc=Adr7Z-0IVWjBBLmZ81qZr1RRben7M-JUojPvhx_E1QdWxsc_Ggp369c0VpjKbnoLW8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ99FuaZzVV5ginB-ClSCB28GI__lq39kQCvhLS2nB5KA&oe=6AB7F064"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuestBeats VR Music Player", "keywords": ["audio", "songs", "music", "player", "mp3"], "long_description": "QuestBeats is a standalone music player built for Meta Quest \u2014 your library, your headset, no phone required.\n\nPLAY THE MUSIC YOU ALREADY OWN\nQuestBeats finds and plays audio straight from the headset's storage, a plugged-in USB-OTG drive, or shared folders on your home network over SMB. Supported formats include MP3, WAV, FLAC, AAC/M4A and OGG/Opus.\n\nKNOW WHAT YOU'RE HEARING\nFor the track that's playing, QuestBeats looks up album art, release year and lyrics from public sources and shows them beside the player \u2014 and steps aside cleanly when you're offline.\n\nMAKE IT YOURS\nStar tracks into three separate playlists, drag to reorder them, shuffle, and choose repeat-one or repeat-all.\n\nKEEP LISTENING\nBackground playback means the music doesn't stop when you launch a game or another app, with transport controls in a media notification.\n\nBUILT FOR VR\nLarge, easy-to-point buttons designed for controller aiming, plus Quest controller shortcuts: play/pause, next/previous, seek, shuffle and repeat all mapped to the buttons.\n\nNo ads. No account. No subscription. Just your music, in your headset.", "short_description": "QuestBeats turns your Quest into a dedicated music player. Play your own audio from the headset, a USB-OTG drive, or your home network (SMB) \u2014 no phone, no streaming subscription. It pulls album art, release year and lyrics for the track you're playing, keeps three playlists, and keeps the music going in the background when you jump into a game. Big, easy-to-hit controls built for VR, full controller support, no ads, no account. Just your music, in your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/questbeats/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/questbeats/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {
nt-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVMijtlHux6WELNr0yy4iiV9Xn7txWmaacvMV9GcLOEg&oe=6AB543E4"}, {"file_name": "2.png", "id": "1273159691369306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585720338_1273159694702639_404141029068854424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmVjiPHyEmYQ7kNvwGAw8dC&_nc_oc=AdonyCHeoIIgJxwEbRx4n36iRCehHGv60riSmMiDUEdmXBQyo6UYwrSb004x-wS5dzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUifvyneiBr3FBqAyoxJ94975pBrGm4Q6gLWfp9qZnwQ&oe=6AB5176C"}, {"file_name": "3.png", "id": "1536231880846006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1536231884179339_2618165617522009052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgv3qbTgYWAQ7kNvwGnmi1m&_nc_oc=AdpL5wE_O7tUjtN_yjIg_BO1vDp0cFY6myRNp4JOlsGGjwUyqJIlGGuCfHeYPraFbVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJPpWBm3kurNnvCyozjV1fpgv3wW7GD-SAKpBtEJSxnw&oe=6AB51B5C"}, {"file_name": "4.png", "id": "1001201795857448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827987_1001201799190781_7374232112589748580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBsYGszmmo0Q7kNvwF_QhRi&_nc_oc=AdruwMAD66yxd26JBVjs5iY4Cis-4uDAx1NOWji6mftxSWHk-ATic0p82Vc5EZjkQmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQY0VC4YCCEYxEof0feNNSm7GTJmn6f5OZY6ypNkc2qA&oe=6AB54970"}, {"file_name": "5.png", "id": "1495177118594950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1495177121928283_6512099545258046337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0q1_Ezbl-gQ7kNvwGPV8ou&_nc_oc=AdqF8mIXwBH-jQ-2a0r5l8lDiwL597-gKMzzhT_lwcvtMKtHJVPRDYv3QgGJbx3LnYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL19L-3zQEnpey476AGTiu6SZaZscTKJlHWpqi23m_6FQ&oe=6AB51524"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuestBeats VR Music Player", "keywords": ["audio", "songs", "music", "player", "mp3"], "long_description": "QuestBeats is a standalone music player built for Meta Quest \u2014 your library, your headset, no phone required.\n\nPLAY THE MUSIC YOU ALREADY OWN\nQuestBeats finds and plays audio straight from the headset's storage, a plugged-in USB-OTG drive, or shared folders on your home network over SMB. Supported formats include MP3, WAV, FLAC, AAC/M4A and OGG/Opus.\n\nKNOW WHAT YOU'RE HEARING\nFor the track that's playing, QuestBeats looks up album art, release year and lyrics from public sources and shows them beside the player \u2014 and steps aside cleanly when you're offline.\n\nMAKE IT YOURS\nStar tracks into three separate playlists, drag to reorder them, shuffle, and choose repeat-one or repeat-all.\n\nKEEP LISTENING\nBackground playback means the music doesn't stop when you launch a game or another app, with transport controls in a media notification.\n\nBUILT FOR VR\nLarge, easy-to-point buttons designed for controller aiming, plus Quest controller shortcuts: play/pause, next/previous, seek, shuffle and repeat all mapped to the buttons.\n\nNo ads. No account. No subscription. Just your music, in your headset.", "short_description": "QuestBeats turns your Quest into a dedicated music player. Play your own audio from the headset, a USB-OTG drive, or your home network (SMB) \u2014 no phone, no streaming subscription. It pulls album art, release year and lyrics for the track you're playing, keeps three playlists, and keeps the music going in the background when you jump into a game. Big, easy-to-hit controls built for VR, full controller support, no ads, no account. Just your music, in your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/questbeats/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/questbeats/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {
kcLIJQDjsV6CJh-i8ulo0X9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzCJpUYA1ydGUfLRkQyrVO7Lvj44o6sukAKXyRgiY3QA&oe=6AF715E7"}, {"file_name": "03_library_device.png", "id": "1821077779067023", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_1821077782400356_4910053560048375488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt8s5X8wOZUQ7kNvwErAhuN&_nc_oc=Adrya8C_yGQFKJitskHZ4MdECsGWH6oLB7ZG7yuYGegqoUFHakEgWFVOn7J5yijAfmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtykdkTJGfBQl7JnDUp3G2kFmxn-8RYBZPtOM16VSduQ&oe=6AF722E3"}, {"file_name": "04_library_usb.png", "id": "1723567265406583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_1723567268739916_2631265818302299956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD6LQ6I4VgkQ7kNvwHCXFGx&_nc_oc=Adrptz6voAt2MlyrpmtVab2n_bvp0g8V8lwqKp4dXjMnZtynb5PEdWIjt4v3dURrtw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmOo_JuIsxoRWRrGdAInXAHLBwVoFmfqzpxSPRaFTpaA&oe=6AF73E05"}, {"file_name": "05_library_network.png", "id": "1631939691844970", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1631939695178303_1013615883449466221_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8XIlu2WL68Q7kNvwF2msgi&_nc_oc=Adq8TEJ9PskL_dbARJuMzp63GaHAZjwoHoCo9Igql26TPZnDsG4EFLyKqkJLgFoK_L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnOu7k0oGyMJihbv_P6BpQvQ2ez9mhnq0UeCBmUvmSWg&oe=6AF7263A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuestBeats VR Music Player", "keywords": ["audio", "music", "mp3", "lyrics", "usb"], "long_description": "QuestBeats is a standalone music player built for Meta Quest \u2014 your library, your headset, no phone required.\n\nPLAY THE MUSIC YOU ALREADY OWN\nQuestBeats finds and plays audio straight from the headset's storage, a plugged-in USB-OTG drive, or shared folders on your home network over SMB. Supported formats include MP3, WAV, FLAC, AAC/M4A and OGG/Opus.\n\nKNOW WHAT YOU'RE HEARING\nFor the track that's playing, QuestBeats looks up album art, release year and lyrics from public sources and shows them beside the player \u2014 and steps aside cleanly when you're offline.\n\nMAKE IT YOURS\nStar tracks into three separate playlists, drag to reorder them, shuffle, and choose repeat-one or repeat-all.\n\nKEEP LISTENING\nBackground playback means the music doesn't stop when you launch a game or another app, with transport controls in a media notification.\n\nBUILT FOR VR\nLarge, easy-to-point buttons designed for controller aiming, plus Quest controller shortcuts: play/pause, next/previous, seek, shuffle and repeat all mapped to the buttons.\n\nNo ads. No account. No subscription. Just your music, in your headset.", "short_description": "QuestBeats turns your Quest into a dedicated music player. Play your own audio from the headset, a USB-OTG drive, or your home network (SMB) \u2014 no phone, no streaming subscription. It pulls album art, release year and lyrics for the track you're playing, keeps three playlists, and keeps the music going in the background when you jump into a game. Big, easy-to-hit controls built for VR, full controller support, no ads, no account. Just your music, in your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/questbeats/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/questbeats/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
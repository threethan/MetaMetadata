nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfOTALMl_IBbAd27-Cf2e48K0WMLc3bU_zQgcpJBw4dQ&oe=6AC12164"}, {"file_name": "2.png", "id": "1273159691369306", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585720338_1273159694702639_404141029068854424_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJJ9Ys3wECgQ7kNvwFbzq7A&_nc_oc=AdprttiSimJMedwewH3ihlF8ClSLQlbjabpyHJWhUmpTV456wzdBwvJw5xPXxzDlu50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnZ-jHZctJWHSKlFj_EtZSAFkp_o-A20xxcmma3_3rhg&oe=6AC12D2C"}, {"file_name": "3.png", "id": "1536231880846006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1536231884179339_2618165617522009052_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJTb4ZvWxR4Q7kNvwEk3N5J&_nc_oc=AdpLUOOHMrsFYEhawYhHOaIBLIieQ4AZGBlixNYm1_EnerzOXEyIsoW8eQ1mcz5Nyts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE2s_LMHHfPdV49btuhcwZ_XzDhP_aIvsR73eMdLYmXw&oe=6AC1311C"}, {"file_name": "4.png", "id": "1001201795857448", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1001201799190781_7374232112589748580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrNyNB3L144Q7kNvwHYpHKj&_nc_oc=AdqLv8LHPXyttHEHN8ReSDAVDE90aK82Q4iKTL5D63wkSRjnStahn4VYCIeHIQHidUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaXAGlffAQ__p1sq-M8dH6qauQIu0v7Kz6spmbc_vgtw&oe=6AC126F0"}, {"file_name": "5.png", "id": "1495177118594950", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1495177121928283_6512099545258046337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_IF2PnGAT0Q7kNvwGD1FlW&_nc_oc=AdphOl7pPFLl3w3rh8loEFRlr3x8ZPznbIpcDVXRsmQ7lKFwmSIadr7vhJojs3wq308&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8q3YWzGAK2FJDcE2iNd9j7JIjFBtUL9U090e4-ipETg&oe=6AC12AE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QuestBeats VR Music Player", "keywords": ["audio", "songs", "music", "player", "mp3"], "long_description": "QuestBeats is a standalone music player built for Meta Quest \u2014 your library, your headset, no phone required.\n\nPLAY THE MUSIC YOU ALREADY OWN\nQuestBeats finds and plays audio straight from the headset's storage, a plugged-in USB-OTG drive, or shared folders on your home network over SMB. Supported formats include MP3, WAV, FLAC, AAC/M4A and OGG/Opus.\n\nKNOW WHAT YOU'RE HEARING\nFor the track that's playing, QuestBeats looks up album art, release year and lyrics from public sources and shows them beside the player \u2014 and steps aside cleanly when you're offline.\n\nMAKE IT YOURS\nStar tracks into three separate playlists, drag to reorder them, shuffle, and choose repeat-one or repeat-all.\n\nKEEP LISTENING\nBackground playback means the music doesn't stop when you launch a game or another app, with transport controls in a media notification.\n\nBUILT FOR VR\nLarge, easy-to-point buttons designed for controller aiming, plus Quest controller shortcuts: play/pause, next/previous, seek, shuffle and repeat all mapped to the buttons.\n\nNo ads. No account. No subscription. Just your music, in your headset.", "short_description": "QuestBeats turns your Quest into a dedicated music player. Play your own audio from the headset, a USB-OTG drive, or your home network (SMB) \u2014 no phone, no streaming subscription. It pulls album art, release year and lyrics for the track you're playing, keeps three playlists, and keeps the music going in the background when you jump into a game. Big, easy-to-hit controls built for VR, full controller support, no ads, no account. Just your music, in your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/questbeats/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ANWAR", "support_website_url": null, "website_url": "https://f1tt0n.github.io/questbeats/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {
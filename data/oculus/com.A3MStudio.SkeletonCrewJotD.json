": "metaStoreSquareLargerText512x512.png", "id": "986135270707423", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821796_986135274040756_3915007937124932998_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAbipzt1k0EQ7kNvwH1swBo&_nc_oc=AdoLn-i7dAxeq1OmX0Bg1vo0zZ26-BbPwjXW9D6IRPzsS7F_yfNfzrr2cITNDZIB_t0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm-eRTOqrVpula_1U_u_E2wf7aIY-LDCeo4EiZnKKNjQ&oe=6AC90AF6"}]}, "id": "2436156186872951", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_203.8406.png", "id": "1067650985749487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823310_1067650989082820_2161266663931890917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_SU4ggN1VsQ7kNvwH1m_49&_nc_oc=AdqsQwXgswa_3MuViKaUUMfUUbuvykF9Stzu9drKREIv5vTmlp02GyT5YZHWisilAxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk_CcQ79Vmz3ZtVkIMdpjHO9WKSzykJlX7ghIA1EGgxg&oe=6AC916C8"}, {"file_name": "Screenshot_505.5043.png", "id": "1031680712819395", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_1031680716152728_9202673037550474330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_AwnmKE6fkQ7kNvwGoR5MD&_nc_oc=Adqdy74vpgnI4PGJ41BPQj9vAVJH_1lfxAsTpOjLeoi4IfeNFBfE2Y2Vzavf6zlZD7A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA8ocxDERk6QMt3-kIHbBYxI1RwduGBtM_lioWb6bOuA&oe=6AC8EA9F"}, {"file_name": "Screenshot_710.4069.png", "id": "4427817360697995", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299789_4427817364031328_1699717112305613941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViVg2AOs8e4Q7kNvwFZrsVf&_nc_oc=AdqG6ZPLyiU5gWSRWyXVgYnDX8BfnR3RJKS6PtsSo3mkcS6uZawwcuZVqKse07cU69s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt_o6SkOPeZJGeUJqA0OwOSEeMQ5vR376EDqHWWeDwgw&oe=6AC8E9F4"}, {"file_name": "Screenshot_657.3754.png", "id": "1269145801808666", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828104_1269145805141999_6806663179800013165_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPQ9jiQtTJEQ7kNvwHGX8_C&_nc_oc=Adp0bKeVpw-_dwt6hkcSGP5shYVzSEmkGun6gMZ0S1JmToINrRvZiM1CsutEuQV3DEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPits4eTfkJrsEe-imUlZ0Wrptw5yOSSINMuS8xjM70vQ&oe=6AC8FA29"}, {"file_name": "Screenshot_1045.827.png", "id": "2190659728364238", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_2190659731697571_4401213528649163009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL1W36bdlkwQ7kNvwH26CaR&_nc_oc=Adryxv_9v-c6MPIKEPD_x2dkNhR8plCy-XdRB_s_kZRrZbqe4lfDX9t_wbD-s4QKqbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTbQ0X_L-PIdHuJZn_rSc-XOjgVCsk2Ezv8BMOng9VJQ&oe=6AC8F648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyartMockup.png", "id": "1783290622703550", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295279_1783290626036883_8195766526813755969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZeEIDyR_zwQ7kNvwFUlWqy&_nc_oc=AdpOjg32LfmDPPZP-88-v4ttEJM-TQ-eeXk_K-k00pbkHuKJtLsU1vhzKWd9WqnPe2U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMobSdw7eACNnvOEvN65v-kJXfcrJt7o62PC1GpKO8R0g&oe=6AC91AEA"}, "display_name": "Skeleton Crew", "keywords": ["physics", "pirate", "coop", "adventure", "multiplayer"], "long_description": "You lost your ship, your crew and your life. You are offered a contract to fight and rob the Evil Trade Empire for a chance at redemption. \n\nNow you must prove yourself worthy in Pirate Purgatory. Skeleton Crew is a solo or two-player co-op game of pirate heists. \n\nComplete daring missions with your own crew of skeletons \u2014 and a friend, if you want to bring one. Fill your hoard with the Trophies you recover.\n\n**Full-Body Physicality & Improvised Combat** Your pirate is a physical body in the world \u2014 climb, swing, and feel the recoil of every shot. Out of bullets? Smash your enemies with the butt of your pistol \u2013 until it breaks.\n{2408760339651555}\n\n**Two-Player Online Co-Op** Go in solo or drag your best friend into the afterlife with you. Two players by invite only.\n{1677780870093590}\n\n**A Crew of Your Own** Your gun crew is a pack of skeletons. Put them on the cannons, line up the shot yourself, and give the word.\n{983255471184069}\n\n**A Target, No Fixed Route** Some missions want treasure. Some want a ship caught at sea. How you get there is your problem.\n{1537345094921057}\n\n**Ready to fill your Hoard?**\n\n**Early Access \u2014 What You're Signing Up For**\n\nLaunching with the tutorial, the home base Hoard, 3 full missions and a bonus level \u2014 with full online two player co-op from day one. More missions, weapons, and chaos are on the way.\n\nInvite only, no public lobbies. Just you, a bunch of brainless skeletons and maybe your friend.\n\nHit a bug or something feels off? Come tell us on Discord [https://discord.gg/u9p8CsHRec] \u2014 we're a small crew but we read every report\n", "short_description": "You lost your ship, your crew and your life. You are offered a contract to fight and rob the Evil Trade Empire for a chance at redemption. \n\nNow you must prove yourself worthy in Pirate Purgatory. Skeleton Crew is a solo or two-player co-op game of pirate heists. \n\nComplete daring missions with your own crew of skeletons \u2014 and a friend, if you want to bring one. Fill your hoard with the Trophies you recover."}, {"images": {"nodes": []}, "id": "982055020960465", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Skeleton Crew", "keywords": ["Piraten", "Physik", "Abenteuer", "Mehrspieler", "Koop"], "long_description": "Du hast dein Schiff, deine Crew und dein Leben verloren. Man bietet dir einen Vertrag an: Bek\u00e4mpfe und pl\u00fcndere das Evil Trade Empire f\u00fcr eine Chance auf Erl\u00f6sung.\n\nErweise dich w\u00fcrdig im Piraten-Jenseits! Skeleton Crew ist ein Solo- oder Zweispieler-Koop-Spiel voller Piratenscharm\u00fctzel.\n\nErf\u00fclle gewagte Missionen mit deiner eigenen Crew aus Skeletten \u2013 und falls du willst mit einem Freund. F\u00fclle dein Versteck mit den erbeuteten Troph\u00e4en.\n\n**Physikbasierter & Improvisierter Kampf** Dein Charakter ist ein K\u00f6rper mitten im Geschehen \u2013 klettere, schwinge und sp\u00fcre den R\u00fccksto\u00df jedes Schusses. Keine Kugeln mehr? Zieh deinen Feinden den Pistolenkolben \u00fcber die R\u00fcbe \u2013 bis er zerbricht.\n{1668307601428422}\n\n**Online-Koop f\u00fcr zwei Spieler** \u2013 Zieh allein los oder bring deinen besten Freund mit. 2 Spieler nur auf Einladung.\n{1035087582678927}\n\n**Deine eigene Crew** Deine Kanonencrew besteht aus einem Haufen Skelette. Stell sie an die Kanonen, ziel selbst und gib das Kommando.\n{881223501592874}\n\n**Ein Ziel, kein fester Weg** Manche Missionen wollen Sch\u00e4tze. Andere wollen Schiffe versenkt oder gepl\u00fcndert. Wie du es machst, ist dein Problem.\n{1608579720659683}\n\n**Bereit f\u00fcr Ruhm und Reichtum?**\n\n**Was hei\u00dft Early Access?**\n\nZum Start gibt's das Tutorial, das Versteck als Heimatbasis, 3 vollst\u00e4ndige Missionen und ein Bonuslevel \u2013 mit vollem 2-Spieler-Koop von Anfang an. Weitere Missionen, Waffen und Chaos sind unterwegs.\n\nNur auf Einladung, keine \u00f6ffentlichen Lobbys. Nur du, ein Haufen hirnloser Skelette und vielleicht dein Freund.\n\nEinen Bug gefunden oder f\u00fchlt sich etwas komisch an? Dann sag uns Bescheid.", "short_description": "Du hast dein Schiff, deine Crew und dein Leben verloren. Man bietet dir einen Vertrag an: Bek\u00e4mpfe und pl\u00fcndere das Evil Trade Empire f\u00fcr eine Chance auf Erl\u00f6sung.\nErweise dich w\u00fcrdig im Piraten-Jenseits! Skeleton Crew ist ein Solo- oder Zweispieler-Koop-Spiel voller Piratenscharm\u00fctzel.\nErf\u00fclle gewagte Missionen mit deiner eigenen Crew aus Skeletten \u2013 und falls du willst mit einem Freund. F\u00fclle dein Versteck mit den Troph\u00e4en, die du erbeutest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://1a3m-studio.com/privacyPolicySkeletonCrew.html", "developer_terms_of_service_url": null, "publisher_name": "1A3M Studio", "support_website_url": null, "website_url": "https://1a3m-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FIGHTING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "28853972234208666"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823802_1730241791593551_4503580307978688466_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8CSEk1iwLIQ7kNvwGc4dpN&_nc_oc=AdrcPoPDUo2zImg95b-bnwHAjZLyJaZXJETyEVn93j8IEoZoIcGqdGg60rWdsj8QQeQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbfs40Pjlp9z3R02RzwByFRZIHSBN_svvKQTNakbt1mQ&oe=6AC90163"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skeleton Crew", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "45978150496
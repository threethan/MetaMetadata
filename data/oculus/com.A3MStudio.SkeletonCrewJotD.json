_6806663179800013165_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idNEc6Rj0KoQ7kNvwHcq0_Y&_nc_oc=Adpt8CtE6bhE3dIXn-HWBPQdzN7vYFMRHIBmKR9ruqrn6DEBXj8h0xug3Mfry7tBDz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH93H6z6DGiZxrUlHoOOU9ZHgLj-1CQlIbvyUFLNij_w&oe=6A9C2729"}, {"file_name": "Screenshot_1045.827.png", "id": "2190659728364238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_2190659731697571_4401213528649163009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WYJApyDDN8Q7kNvwEB--OR&_nc_oc=Adp9wA3RHzwjqEwxid2-G-uUcDuNQcH6uf_YFxPhrVYM6Sx5_DFiDrO20MdsUBRxu3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9gx7OAiTEmajuqdR3XRA3LyDsa6ohnoEUonmLfLDL2A&oe=6A9C2348"}, {"file_name": "Screenshot_1213.355.png", "id": "1237380711698292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827626_1237380718364958_2048857314387146139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvy7aD3Iv7sQ7kNvwGjUcbH&_nc_oc=Adrr9tLUZoHaUYAi1NDGVhqSPS0TNQ9KF4vGJuPibDEEIHgwhrFy50U-ETuP0Ze-QFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCGjDuOKdY0q29bG8bVOHSKQn0nwhGB_6GGhSvp23JgQ&oe=6A9C3DA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyartMockup.png", "id": "1008204208849358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_1008204212182691_4667162396279293635_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2KKQpFKKyIQ7kNvwGj551r&_nc_oc=Ado0xBJ8rkPDkbdlRuWXfRVZQgnav_CNpeVJZ2PBb7F548p3dAqCnyUjPCFcO5Iw_gs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-mPVAVNEI-Ro9wd4lAZf3x-xpXfGtXAiIR7ZutlCM-g&oe=6A9C377E"}, "display_name": "Skeleton Crew", "keywords": ["physics", "pirate", "coop", "multiplayer", "adventure"], "long_description": "Slash, steal and battle your way through Pirate Purgatory \u2014 alone or with your best friend. Skeleton Crew is a light-hearted, action-adventure VR pirate game. Pick a target from the safety of your home base, then chart your approach through open levels built for mischief. Use pistols, swords and freshly severed skulls to fight anything that stands between you and the trophies destined to shine in your Hoard.\n\n**Early Access \u2014 What You're Signing Up For**\n\nLaunching with the tutorial, the home base Hoard, 2 full heists and a bonus level \u2014 with full online co-op from day one. More levels, weapons, and chaos are on the way.\n\n**Hit a bug or something feels off? [Come tell us on Discord \u2192 https://discord.gg/QxPEN66WSG] \u2014 we're a small crew but we read every report.**\n\n**Two-Player Online Co-Op** Sail solo or drag your best friend into the afterlife with you.\n{1677780870093590}\n\n**Immersive Naval Combat** Brave the waves, stand at the helm, steer the ship, command your crew, and light the occasional fuse yourself.\n{983255471184069}\n\n**Full-Body Physicality & Improvised Combat** Your pirate is a physical body in the world \u2014 climb, swing, and feel the recoil of every shot. Out of bullets? Smash your enemies with the butt of your pistol \u2013 until it breaks.\n{1841577746821412}\n\n**Sandbox Levels, Open Approach** Sneak in, blast through the front door, or sail around back \u2014 no two heists play quite the same.\n{1499742161910149}\n\n**Earn Your Afterlife** After every heist, earn a new trophy for your Hoard. Spend the gold, flaunt the trophies \u2014 death's never looked this good.\n{1521058515522486}\n\n**Ready to fill your Hoard?**\n", "short_description": "Slash, steal and battle your way through Pirate Purgatory \u2014 alone or with your best friend. Skeleton Crew is a light-hearted, action-adventure VR pirate game. Pick a target from the safety of your home base, then chart your approach through open levels built for mischief. Use pistols, swords and freshly severed skulls to fight anything that stands between you and the trophies destined to shine in your Hoard."}]}, "developer_name": null, "developer_pr
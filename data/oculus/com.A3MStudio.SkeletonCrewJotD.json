uluscdn.com/v/t64.5771-25/491821704_2190659731697571_4401213528649163009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WYJApyDDN8Q7kNvwEB--OR&_nc_oc=Adp9wA3RHzwjqEwxid2-G-uUcDuNQcH6uf_YFxPhrVYM6Sx5_DFiDrO20MdsUBRxu3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9gx7OAiTEmajuqdR3XRA3LyDsa6ohnoEUonmLfLDL2A&oe=6A9C2348"}, {"file_name": "Screenshot_1213.355.png", "id": "1237380711698292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827626_1237380718364958_2048857314387146139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvy7aD3Iv7sQ7kNvwGjUcbH&_nc_oc=Adrr9tLUZoHaUYAi1NDGVhqSPS0TNQ9KF4vGJuPibDEEIHgwhrFy50U-ETuP0Ze-QFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCGjDuOKdY0q29bG8bVOHSKQn0nwhGB_6GGhSvp23JgQ&oe=6A9C3DA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyartMockup.png", "id": "1008204208849358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_1008204212182691_4667162396279293635_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2KKQpFKKyIQ7kNvwGj551r&_nc_oc=Ado0xBJ8rkPDkbdlRuWXfRVZQgnav_CNpeVJZ2PBb7F548p3dAqCnyUjPCFcO5Iw_gs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-mPVAVNEI-Ro9wd4lAZf3x-xpXfGtXAiIR7ZutlCM-g&oe=6A9C377E"}, "display_name": "Skeleton Crew", "keywords": ["physics", "pirate", "coop", "adventure", "multiplayer"], "long_description": "You lost your ship, your crew and your life. You are offered a contract to fight and rob the Evil Trade Empire for a chance at redemption. \n\nNow you must prove yourself worthy in Pirate Purgatory. Skeleton Crew is a solo or two-player co-op game of pirate heists. \n\nComplete daring missions with your own crew of skeletons \u2014 and a friend, if you want to bring one. Fill your hoard with the Trophies you recover.\n\n**A Crew of Your Own** Your gun crew is a pack of skeletons. Put them on the cannons, line up the shot yourself, and give the word.\n{983255471184069}\n\n**Two-Player Online Co-Op** Go in solo or drag your best friend into the afterlife with you. Two players by invite only.\n{1677780870093590}\n\n**Full-Body Physicality & Improvised Combat** Your pirate is a physical body in the world \u2014 climb, swing, and feel the recoil of every shot. Out of bullets? Smash your enemies with the butt of your pistol \u2013 until it breaks.\n{1841577746821412}\n\n**A Target, No Fixed Route** Some missions want treasure. Some want a ship caught at sea. How you get there is your problem.\n{1537345094921057}\n\n**Ready to fill your Hoard?**\n\n**Early Access \u2014 What You're Signing Up For**\n\nLaunching with the tutorial, the home base Hoard, 2 full heists and a bonus level \u2014 with full online two player co-op from day one. More missions, weapons, and chaos are on the way.\n\nInvite only, no public lobbies. Just you, a bunch of brainless skeletons and maybe your friend.\n\nHit a bug or something feels off? Come tell us on Discord [https://discord.gg/u9p8CsHRec] \u2014 we're a small crew but we read every report", "short_description": "You lost your ship, your crew and your life. You are offered a contract to fight and rob the Evil Trade Empire for a chance at redemption. \n\nNow you must prove yourself worthy in Pirate Purgatory. Skeleton Crew is a solo or two-player co-op game of pirate heists. \n\nComplete daring missions with your own crew of skeletons \u2014 and a friend, if you want to bring one. Fill your hoard with the Trophies you recover."}]}, "developer_name": null, "developer_privacy_policy_url": "https://1a3m-studio.com/privacyPolicySkeletonCrew.html", "developer_terms_of_service_url": null, "publisher_name": "1A3M Studio", "support_website_url": null, "website_url": "https://1a3m-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"
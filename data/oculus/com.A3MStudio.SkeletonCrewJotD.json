t_710.4069.png", "id": "4427817360697995", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299789_4427817364031328_1699717112305613941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViVg2AOs8e4Q7kNvwFZrsVf&_nc_oc=AdqG6ZPLyiU5gWSRWyXVgYnDX8BfnR3RJKS6PtsSo3mkcS6uZawwcuZVqKse07cU69s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt_o6SkOPeZJGeUJqA0OwOSEeMQ5vR376EDqHWWeDwgw&oe=6AC8E9F4"}, {"file_name": "Screenshot_657.3754.png", "id": "1269145801808666", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828104_1269145805141999_6806663179800013165_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPQ9jiQtTJEQ7kNvwHGX8_C&_nc_oc=Adp0bKeVpw-_dwt6hkcSGP5shYVzSEmkGun6gMZ0S1JmToINrRvZiM1CsutEuQV3DEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPits4eTfkJrsEe-imUlZ0Wrptw5yOSSINMuS8xjM70vQ&oe=6AC8FA29"}, {"file_name": "Screenshot_1045.827.png", "id": "2190659728364238", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_2190659731697571_4401213528649163009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL1W36bdlkwQ7kNvwH26CaR&_nc_oc=Adryxv_9v-c6MPIKEPD_x2dkNhR8plCy-XdRB_s_kZRrZbqe4lfDX9t_wbD-s4QKqbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTbQ0X_L-PIdHuJZn_rSc-XOjgVCsk2Ezv8BMOng9VJQ&oe=6AC8F648"}, {"file_name": "Screenshot_1213.355.png", "id": "1237380711698292", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_1237380718364958_2048857314387146139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igeD-wXgzY8Q7kNvwGkL3Y1&_nc_oc=Adr_zuUq0P2_sqGOLHDcbDZ1GDJgdCF9zJ34eN01OdLawwNXGmr__RAz0cY2zAcCLh4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSk07UXQ_jfJ4h0bE8eESAYwC5w4g5TvcfkXJKERXzGA&oe=6AC910A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyartMockup.png", "id": "1008204208849358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_1008204212182691_4667162396279293635_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ffYZAggEn4Q7kNvwGSRjCE&_nc_oc=AdrbQrlHHHBHvLqLGzl6KhzAHept3fr0fBCxH2EyZ2ZgaD3xUvq_9W9unCh_P-GTKio&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5le_1-LND1FhLSHaFLOxmiV1RvK6-bGj1S5EneZyRrQ&oe=6AC90A7E"}, "display_name": "Skeleton Crew", "keywords": ["physics", "pirate", "coop", "multiplayer", "adventure"], "long_description": "Slash, steal and battle your way through Pirate Purgatory \u2014 alone or with your best friend. Skeleton Crew is a light-hearted, action-adventure VR pirate game. Pick a target from the safety of your home base, then chart your approach through open levels built for mischief. Use pistols, swords and freshly severed skulls to fight anything that stands between you and the trophies destined to shine in your Hoard.\n\n**Early Access \u2014 What You're Signing Up For**\n\nLaunching with the tutorial, the home base Hoard, 2 full heists and a bonus level \u2014 with full online co-op from day one. More levels, weapons, and chaos are on the way.\n\n**Hit a bug or something feels off? [Come tell us on Discord \u2192 https://discord.gg/QxPEN66WSG] \u2014 we're a small crew but we read every report.**\n\n**Two-Player Online Co-Op** Sail solo or drag your best friend into the afterlife with you.\n{1677780870093590}\n\n**Immersive Naval Combat** Brave the waves, stand at the helm, steer the ship, command your crew, and light the occasional fuse yourself.\n{983255471184069}\n\n**Full-Body Physicality & Improvised Combat** Your pirate is a physical body in the world \u2014 climb, swing, and feel the recoil of every shot. Out of bullets? Smash your enemies with the butt of your pistol \u2013 until it breaks.\n{1841577746821412}\n\n**Sandbox Levels, Open Approach** Sneak in, blast through the front door, or sail around back \u2014 no two heists play quite the same.\n{1499742161910149}\n\n**Earn Your Afterlife** After every heist, earn a new trophy for your Hoard. Spend the gold, flaunt the trophies \u2014 death's never looked this good.\n{1521058515522486}\n\n**Ready to fill your Hoard?**\n", "short_description": "Slash, steal and battle your way through Pirate Purgatory \u2014 alone or with your best friend. Skeleton Crew is a light-hearted, action-adventure VR pirate game. Pick a target from the safety of your home base, then chart your approach through open levels built for mischief. Use pistols, swords and freshly severed skulls to fight anything that stands between you and the trophies destined to shine in your Hoard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://1a3m-studio.com/privacyPolicySkeletonCrew.html", "developer_terms_of_service_url": null, "publisher_name": "1A3M Studio", "support_website_url": null, "website_url": "https://1a3m-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "FIGHTING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "27888890037383562"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1417070247193963"}, {"status": "PUBLISHED", "id": "1374682544504621"}]}, "baseline_offer": {"id": "1374682544504621"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1417070247193963"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
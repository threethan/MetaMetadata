: [{"id": "25330246106588143"}]}, "id": "2328996530945580"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25204161362579442"}]}, "id": "1361773115406160"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25023103323975673"}]}, "id": "4433106203585247"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24525939670323355"}]}, "id": "1369813697458487"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9121280154639969"}]}, "id": "998360712410610"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9121280154639969", "release_date": 1749798780, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27441072325567473"}, "id": "1380007559794381"}]}}, "binary": null, "live_binary": null, "created_date": 1792146471, "id": "27946728701668497", "is_initial_release": false, "name_with_fallback": "v23", "pdp_metadata_with_fallback": {"version": 11, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "27946772128330821"}, "release_status": "RELEASED", "id": "9121280154639969"}, "id": "27946772128330821", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9121280154639969", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1355532599034291"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2548825242296694", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Worst Food Truck - Cooking game", "keywords": ["pizza", "cuisine", "cook", "recettes", "simulateur"], "long_description": "# \ud83d\udd25 BIENVENUE DANS LE FOOD TRUCK LE PLUS CHAOTIQUE DU MONDE \ud83d\udd25\n\nTu crois pouvoir g\u00e9rer la pression ? Ou tu pr\u00e9f\u00e8res balancer du fromage sur les murs et mixer un rat pour le fun ? Franchement\u2026 on te juge pas.\n\n# \ud83d\udc68\u200d\ud83c\udf73 DEVIENS LE PIRE CUISINIER DE LA PLAN\u00c8TE \ud83d\udc69\u200d\ud83c\udf73\n\nOuvre ton propre food truck catastrophe et pr\u00e9pare les pizzas les plus immondes jamais servies. L\u2019hygi\u00e8ne ? Connais pas. Avec des ingr\u00e9dients cinq \u00e9toiles comme des cafards, du fromage moisi et des crottes de rat (miam ?).\n\n{1965012287617755}\n\n# \ud83c\udf55 DES PIZZAS D\u00c9GO\u00dbTANTES, CR\u00c9ATIVES ET TOTALEMENT BARR\u00c9ES \ud83c\udf55\n\n\u00c9crase la p\u00e2te au marteau, tranche tes ingr\u00e9dients au katana, et envoie un rat dans le mixeur \u2014 c\u2019est TA cuisine, TES r\u00e8gles. Juste\u2026 \u00e9vite les gerbes des clients. PAS DE RETOUR SI CA LEUR PLAIT PAS!\n\n{512737515226586}\n\n# \ud83c\udfae UN MAX DE POSSIBILIT\u00c9S + DES MISES \u00c0 JOUR A VENIR\ud83c\udfae\n\nR\u00e9invente ton propre Ratatouille version cauchemar, \u00e9clate-toi avec le pistolet \u00e0 tomate ou filme tes chefs-d\u2019\u0153uvre r\u00e9pugnants avec la cam\u00e9ra int\u00e9gr\u00e9e. Dans Worst Food Truck, c\u2019est toi le chef \u2014 et le chaos ne fait que commencer.", "short_description": "\ud83d\udc68\u200d\ud83c\udf73 DEVIENS LE PIRE CUISINIER DE LA PLAN\u00c8TE \ud83d\udc69\u200d\ud83c\udf73\nOuvre ton propre food truck catastrophe et pr\u00e9pare les pizzas les plus immondes jamais servies. L\u2019hygi\u00e8ne ? Connais pas. Avec des ingr\u00e9dients cinq \u00e9toiles comme des cafards, du fromage moisi et des crottes de rat (miam ?), tu sers le pire de l\u2019Italie \u2014 et un petit peu plus."}, {"images": {"nodes": [{"file_name": "WFT ai keyart square.png", "id": "2218477585393722", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_2218477588727055_7760659847738153363_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYzy1u6CsKIQ7kNvwEi6KyG&_nc_oc=AdqZWEKOa5PNF4G9-7MZ9NKlaQNQSVbU8GleBQ3We9eTXrLv5V0SnGGNA7yLaz1H-G4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8q9WermuLTz7j9iw0o0xOPci3wXAAsAC4SNdbbdPZ-w&oe=6AE7401D"}, {"file_name": "Le pire food truck en pleine folie.png", "id": "1627014509076691", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1627014515743357_7571690906083536768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zYyGNqOa4IQ7kNvwEHzF4L&_nc_oc=Adr1UTuVPSbgyIRCv_agDEWQQ5kdGYl7SMOBS0vTae0ImswveF48s1OOxOxqQOhb2Og&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBIlYWtFZnwwk50ZzXal9FC6hF4hWGrel8N_Uc40swvQ&oe=6AE7642E"}, {"file_name": "Le pire food truck du festival.png", "id": "1534806308676798", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_1534806315343464_8388619696003930341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcmFW459i1UQ7kNvwFnRv6D&_nc_oc=AdorbHKUKGwTPH6BZG12gOMY3-USKHmJnWC3TGd-4JVbMaOig3W37WxzYNhMNvf8uYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUgXgA7BZ3mrtWFlrXqTyl7hde_2l_5BkInyxneGAa0Q&oe=6AE753BB"}, {"file_name": "keyart wft 2 final xdlol g menti.png", "id": "1472585081382888", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1472585084716221_1653118300412835971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x0-I-baB34Q7kNvwGWOSZN&_nc_oc=Adq90IPLQE-7CEhGOsYHjDVDiGaZmkyDRDR4tiGo38cYzEz2SyR-7T8FIcWHTNeTfkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsQSr1hBQ9ntk0QZ8w0NP9VJKxrJ7OitKPNfyvmfsLag&oe=6AE7573E"}, {"file_name": "T\u00eate de cartoon hilare et d\u00e9jant\u00e9e.png", "id": "1384575446
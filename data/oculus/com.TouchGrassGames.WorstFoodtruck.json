uscdn.com/v/t64.5771-25/499311579_1369141001043871_4438579240671471530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NElIt9QDRkgQ7kNvwFcgqGX&_nc_oc=AdrJQ3BtR8cDg7d0NQ2r-ShX4PLaEFjoT32NaVRTCVtv_gG5yMZHW5LKPJ6w5EqUuD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Q0FFscX82fbWaCm-2vRH3NADWKcTtQgJKJO1HVjddA&oe=6AE7606D"}, {"file_name": "Screenshot 5.png", "id": "667640066231226", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303196_667640069564559_5394353660829567675_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxzSpYskijEQ7kNvwF0QKez&_nc_oc=AdpwGlnZBOXmdwM_CWs0jgABdIbxMC9SZH2Kv-s1frbpy7mboH5nBAKuIKjmbhqMuZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx0eknoU9AcRaagJf1P1TYBnabfpwNuD9MiJU4O0jcWA&oe=6AE7593C"}, {"file_name": "Screenshot 3.png", "id": "1135222265031271", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307409_1135222268364604_8681561586006500142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQUzw-BUtTUQ7kNvwEl5rys&_nc_oc=AdprVQotL_9ApzFJ5nQkHR1RFifYm9qXrcMbgWN26t_a_ZfeBii5QQN6iVaWdRju98M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROIEfI344OdQRyzeaLcROD0WgquxS5K3hj_jsj7W08rA&oe=6AE76F3F"}, {"file_name": "Screenshot 1.png", "id": "24355488117368142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300636_24355488124034808_7897665950874052837_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Fi06_hm_AQ7kNvwHck69o&_nc_oc=AdqxRBWaxIXltGsoxQw0J2WpfxmSAYwLY2xc9Et-soXWvs9WnNXSnXX09XtuDIH8cYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpFVvoT-sGX3jb5gvhVSQkOF-TNsKm_P3txPiA71SfSg&oe=6AE750C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_WithLogo.png", "id": "2934139416768329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831273_2934139423434995_3113146807621686271_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xdfgvv7_x2MQ7kNvwHgpCOF&_nc_oc=AdpCB-ZykJXP6oCSdcw-O8Rvystb26DkqIjYchO_IT4-jl4Zx6TsxdTxN_Q7pGhbvxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm4Tp9vA2qn9kf7qvK3BmM-Rtt2GNSbIPBY6O7uhkMCw&oe=6AE76EBD"}, "display_name": "Worst Food Truck - Cooking game", "keywords": ["pizza", "cook", "service", "simulator", "job"], "long_description": "# \ud83d\ude9a Welcome to the worst Food Truck in the world, the new sandbox cooking game!\n\n\n# \ud83c\udf55 Everything can be an ingredient!\n**In Worst Food Truck, create pizzas using the ingredients around you, like literally all the ingredients around you.**\n{1221291612411697}\n\n# \ud83c\udf55 Clean Your Food Truck\n**Mess up your kitchen by spilling or exploding foods, then clean them up using all the tools available.**\n{1295650918753511}\n\n# \ud83c\udf55 Interact with Your Customers\n**Customers react directly to your pizzas; they can sometimes get a bit annoyed, calm them down to see.**\n{1264512452046231}\n\n# \ud83c\udf55 Let Your Creativity Flow.\n**Discover all possible recipes, even the most original ones, and observe customers' reactions!**\n{1085153970174868}\n\n# \ud83c\udf55 Cook Your Way\n**Try all the tools and find your own way of cooking pizzas.**\n{1028455472824215}\n\n# \ud83d\ude9a The Food Truck is Yours! \ud83c\udf55", "short_description": "\ud83c\udf55 In Worst Food Truck, you make pizzas using the ingredients around you\u2014literally anything you can get your hands on. But watch out for how the customers react if they figure out you didn\u2019t serve them what they ordered.\n\nTry out all kinds of crazy recipes with whatever you can find nearby.\n\nEvery single kitchen tool is fair game, so go ahead\u2014craft the pizza of your dreams\u2026 or your nightmares.\n\n\ud83d\ude9aThe food truck is all yours! \ud83c\udf55"}, {"images": {"nodes": []}, "id": "1225344775936522", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Worst Food Truck - Cooking game", "keywords": ["pizza", "cuisine", "cook", "recettes", "simulateur"], "long_description": "# \ud83d\ude9a Bienvenue dans le pire Food Truck du monde, le nouveau jeu de cuisine, bac \u00e0 sable !\n\n\n# \ud83c\udf55 Tout peut servir d'ingr\u00e9dient !\n**Dans Worst Food Truck, cr\u00e9er les pizzas avec les ingr\u00e9dients qui t'entourent, genre vraiment tous les ingr\u00e9dients qui t'entourent.**\n{1388863382368724}\n\n# \ud83c\udf55 Nettoie ton Food Truck\n**Salie ta cuisine en renversant ou en explosant les aliments puis nettoie-les avec tous les outils \u00e0 disposition.**\n{2105489179856485}\n\n# \ud83c\udf55 Interagie avec tes clients\n**Les clients r\u00e9agissent directement \u00e0 tes pizzas, ils peuvent \u00eatre parfois un peu \u00e9nerv\u00e9, calme les pour voir.**\n{1887501215366494}\n\n# \ud83c\udf55 **Laisse libre cours \u00e0 ta cr\u00e9ativit\u00e9.**\n**D\u00e9couvre toutes les recettes possibles m\u00eame les plus originales et observe la r\u00e9action des clients !**\n{1352165449422055}\n\n# \ud83c\udf55 Cuisine \u00e0 ta mani\u00e8re\n**Essaye tous les outils et trouve ta propre mani\u00e8re de cuisiner tes pizzas.**\n{1056513949252733}\n\n# \ud83d\ude9a Le Food Truck est \u00e0 toi ! \ud83c\udf55", "short_description": "\ud83c\udf55 Dans Worst Food Truck, cr\u00e9er les pizzas avec les ingr\u00e9dients qui t'entourent, genre vraiment tous les ingr\u00e9dients qui t'entourent. Mais attention \u00e0 la r\u00e9action des clients s'ils se rendent compte que tu ne leur as pas servi la bonne commande.\nD\u00e9couvres toutes les recettes possibles avec tous les ingr\u00e9dients que tu trouves autour de toi.\n\nTous les ustensiles sont utilisables pour te permettre de cr\u00e9er la pizza de tes r\u00eaves ou de tes cauchemars !\n\n\ud83d\ude9a Le Food Truck est \u00e0 toi ! \ud83c\udf55"}]}, "developer_name": "Touch Grass Games", "developer_privacy_policy_url": "https://www.arianestudios.com/worst-food-truck-privacy-policy", "developer_terms_of_service_url": null, 
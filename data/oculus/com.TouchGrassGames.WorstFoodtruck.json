t=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbIoTcL1qgYQ7kNvwFhVH7t&_nc_oc=Adp44B-mX0FmYNfNBJPst2kkBettHWXaxYQneLiEheCFU-hKgCQOsOKhw6oqmoWLV9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvj0tffm0OC5msA1rr89SMQHcAk9EegIUbmNKr8evJtw&oe=6AE75B95"}, {"file_name": "sc 1.png", "id": "2254108922105346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827585_2254108925438679_4149048224041209442_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsI_SROMpKIQ7kNvwF0igu5&_nc_oc=Adps8lSkIuRIKQWyNP2cb4eAc3Tn7-xy1E_IpXXLZcSoM568fsd9NxUjkbqRPQ4XtX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKjfH4wrGvs_wJWFAej7UEYIG1z5_2qTNwlhH6gi6kig&oe=6AE74ECA"}, {"file_name": "sc 5.png", "id": "2204686966780451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_2204686973447117_6661700346337897658_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZS-K9m-PErUQ7kNvwGaHtdF&_nc_oc=AdpQSACebCroBqD-NC42jsCXfUEHhkM1OTyYM6ozOvj_G2GdHh5GhqFevpN405QH8cI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSKif7_FSZzek6uderoFvuzuj_UuYQAkcnQrWbQfJkvg&oe=6AE73C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyart wft 2 final xdlol g menti.png", "id": "1416672866707990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829120_1416672873374656_5027069488139846593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L_pYubZn-oQ7kNvwGdbat0&_nc_oc=Adovg318DCnjTYWuSScvH0qfw3X-iJuY5lI5H5SNd3No97hBf9TbO3tzdAHSutvIc7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLuDOWAR0cYxZhrQmCaqexVlQ7LMq753sUwvv65INO-A&oe=6AE7537D"}, "display_name": "Worst Food Truck - Cooking game", "keywords": ["pizza", "cook", "service", "simulator", "job"], "long_description": "# \ud83c\udf55 WELCOME TO THE WORST FOOD TRUCK EVER! \ud83d\udc00\nYour food truck is a mess. Your customers are questionable. Your recipes are\u2026 technically food. But if you can follow their orders, serve the right dishes, and make some money, you might just turn this filthy truck into a thriving business!\n\n{2013348526141584}\n\n# \ud83d\udc68\u200d\ud83c\udf73 SERVE. EARN. UPGRADE.\n\nFollow the rat\u2019s instructions through a brand-new onboarding and learn how to run your chaotic food truck. Carefully prepare what your customers ask for, serve them before they lose patience, and earn money with every successful order.\n\n\n{1826060328813791}\n\n# \ud83d\udcb0 BUILD YOUR FOOD TRUCK EMPIRE\n\nSpend your hard-earned cash at the shop behind you! Unlock upgrades, improve your setup, and find new ways to make more money. The better you serve, the more you can unlock.\n\n{2180386972862319}\n\n# \ud83c\udf2d MORE THAN JUST PIZZA\nUnlock new machines and expand your menu with sides and drinks:\n\n- Hot Dog Machine\n- Slushie Machine\n- Drinks Fridge\n\nGive your customers exactly what they ordered and make a little extra cash with every sale.\n\n\ud83d\udd2a UNLOCK CHAOTIC TOOLS\n\nGet more than 12 crazy tools from the shop, including weapons and familiar items from our other games. Spot the references, experiment with them, and let the chaos begin.\nWant to deal with a difficult customer? There are\u2026 creative ways to handle that.\n\n\ud83d\udc40 MEET YOUR CUSTOMERS\n\nThe customers have never looked this expressive! With a brand-new character art direction, they\u2019re more expressive, reactive, and ready to cause trouble than ever.\n\n\ud83c\udf55 COOK. SERVE. UPGRADE. CAUSE CHAOS!!\n\n", "short_description": "RUN THE WORST FOOD TRUCK EVER! \ud83c\udf55\ud83d\udc00\nServe rotten, uh, delicious, food, follow bizarre orders, make money, and upgrade your filthy food truck. Unlock crazy tools, new machines, and sides to become the ultimate pizza disaster!"}]}, "developer_name": "Kalank Games", "developer_privacy_policy_url": "https://www.arianestudios.com/worst-food-truck-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_websit
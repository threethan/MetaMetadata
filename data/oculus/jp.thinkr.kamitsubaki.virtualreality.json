23398_1758210398167957_1377281464552346421_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfkt9d7HP8YQ7kNvwGDhQ87&_nc_oc=AdpHAv6kHHDxqiQqLgW5lwu7RgyN-_8XHA5vUtMAkAIyY1PNf87meKhkbofhj0bzcv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2rKOSoLkLnRZBaKc_EswG0CV66eHHYANRk0Opx76DGg&oe=6AFF2A3F"}, {"file_name": "\u30b3\u30ec\u3066\u3099\u3044\u3044\u3066\u3099\u3059\u304b\uff1f.png", "id": "25228815560142855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618938_25228815563476188_4189752536297991814_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-cgLe7EbTMQ7kNvwEvn88D&_nc_oc=Adrj45PYhZDUxUO1tNkAvM8Rfrayrct8pwNgQIN3dnDjOauPAN5hieRWqmAFY2QrEuw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZvgyB-qGU6DPFBAMELN36zer0WP0MGHHBBifuUUGP0A&oe=6AFF08AE"}, {"file_name": "\u4e0d\u53ef\u89e3\u7a7a\u9593\u306e\u6a21\u69d8\u304b\u3099\u8db3\u3092\u8cab\u901a\u3057\u307e\u3059.png", "id": "1986218398879270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_1986218402212603_7404903089876685744_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVGIWii92k0Q7kNvwFvZiC1&_nc_oc=Adq-BlAaw1kzTfxOYC0_wM13kxdBStzLQEa7f0DygrLAbs-I6u7z1BBQdclYz9l8rTQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUD9VP9D7y4e-FaPM0ioCVVAW-VT0y5JWIp6_-yRbtyw&oe=6AFF216B"}, {"file_name": "\u30bf\u30fc\u30b1\u3099\u30c3\u30c8\u30de\u30fc\u30ab\u30fc\u304b\u3099\u51fa\u3066\u3044\u308b\u304b\u3099\u7121\u6575\u3063\u307b\u309a\u3044.png", "id": "2626750001023860", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619808_2626750004357193_6345986329395521024_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4WXaKFr5rYQ7kNvwEV2a9v&_nc_oc=AdrvqFK9X3uZNYxoSSadXlqJBRw9bycBeHT5AB7ZQdkAGGWm0s96CJA0Cwwb7Ak9SII&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgY3kxeCZIRujhGOYfpC4k9k7q_rqLRLBwct4H189m7g&oe=6AFF19F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV_3D_\u30e8\u30b3_RGB\u7248_\u30ed\u30b3\u3099A_en.png", "id": "2887998328074239", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_2887998334740905_1656892667159644384_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydL3LPYUpx4Q7kNvwG_j2lq&_nc_oc=Adot7a6fbZoTr9UvFnnCCyFsBN4tIHLCxxCfOpVPvTsZU0e4C-DiFLnHSilK-Ktc20c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgH6sZNFKIYkl_T6ATf8d0R18d-1_IjZTCKyUFyXHskw&oe=6AFF320B"}, "display_name": "KAMITSUBAKI CITY VIRTUAL REALITY", "keywords": ["VTuber", "VSinger", "Anime", "CIEL", "Albemuth"], "long_description": "# Features\n\"KAMITSUBAKI CITY VIRTUAL REALITY\" is a dark-fantasy science fiction VR adventure game taking place in \"Kamitsubaki City.\"\nIts fully-voiced characters are brought to life alongside the world with their own unique 3D models.\nThe game features numerous popular songs from Kamitsubaki's vocal artists that link to the plot, granting the player an ever greater level of immersion with the world around them.\n\n\nThe player's choices weave the story in vastly different directions.\nDive into the world of Kamitsubaki City and take part in the most extensive story in the series that cuts straight to the heart of Kamitsubaki City.\n\n\n## This game and \"KAMITSUBAKI CITY REGENERATE\" share the same basic story. Furthermore, the story is standalone, meaning those unfamiliar with the series can play these games with no worries.\n\n# What is the \"Kamitsubaki City Under Construction.\" series?\nKAMITSUBAKI An original IP project by KAMITSUBAKI STUDIO in development since 2019.\nOne of multiple story projects whose lore is linked to the studio's vocal artists, starting with tales centered around the parallel world of Kamitsubaki City.\n\n# Cast\n* Kafu Morisak i: KAF\n* Rime Tanioki : RIM\n* Haru Asanushi : Harusaruhi\n* Sekai Yorukawa : Isekaijoucho\n* Koko Rinne : KOKO\n\n{1341815630745990}", "short_description": "In a world parallel to our own resides the city of Kamitsubaki.\nOne day, the player, an \"Observer,\" is summoned to this ill-fated world.\nThere, they meet a girl named Kafu, and set out on a quest with her to save the world from its impending doom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://srd.kamitsubaki.jp/game/virtual_reality/#information_261", "developer_terms_of_service_url": null, "publisher_name": "KAMITSUBAKI STUDIO", "support_website_url": null, "website_url": "https://srd.kamitsubaki.jp/game/virtual_reality/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29115588424720836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821886_1879239009672739_2670719720389219736_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS74uMJGjF0Q7kNvwHNSFYz&_nc_oc=AdoLj5I1DurHLYmavj9tf0G9PaEVx7CQKSQ77ik4OrtzwPIJHQF2mts-8t7K7I1HisY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGrrETLxYV1EABoCRZTJae0qWpOVhcK2dRzWFlHlnT5A&oe=6AFF1F14"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "KAMITSUBAKI CITY VIRTUAL REALITY", "platform": "ANDROID_6DOF", 
99618938_25228815563476188_4189752536297991814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v26SCpAp0vcQ7kNvwGT_PYM&_nc_oc=Adq8hzzIkaU9x4cUXM0CfQldPHQYujArWCwizp1phM6eyTVsebNHp84icL0dPz9Tb-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTQZKXZPmNN6gP1bWjo4ZB4sBuLys66zkpxInaHbmVkQ&oe=6AE74DAE"}, {"file_name": "\u4e0d\u53ef\u89e3\u7a7a\u9593\u306e\u6a21\u69d8\u304b\u3099\u8db3\u3092\u8cab\u901a\u3057\u307e\u3059.png", "id": "1986218398879270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_1986218402212603_7404903089876685744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE7wNOQqx_8Q7kNvwGUPFRJ&_nc_oc=Adpeo3pzBEdHEEE0wIBPzj2BtVJcmoSbRdbTjUaM-6tS9YQV--hDcUER0HFeir8veiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtrx-Kakp1dbDD3KTvG8axzzXr7Z5keuIfRIchNVN_-A&oe=6AE7666B"}, {"file_name": "\u30bf\u30fc\u30b1\u3099\u30c3\u30c8\u30de\u30fc\u30ab\u30fc\u304b\u3099\u51fa\u3066\u3044\u308b\u304b\u3099\u7121\u6575\u3063\u307b\u309a\u3044.png", "id": "2626750001023860", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2626750004357193_6345986329395521024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFo2qfMqe2oQ7kNvwEXkOwr&_nc_oc=AdrCfbnxCaC7ClxRPFavkbDzPxoKsE9OYY4znIEE5cYEPuklKeaZO2jK3PlDe0BsudI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSygNxeGGHfttkNysSyuWzZgizGU_-SJGikCln12LVH8w&oe=6AE75EF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV_3D_\u30e8\u30b3_RGB\u7248_\u30ed\u30b3\u3099A_en.png", "id": "2887998328074239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_2887998334740905_1656892667159644384_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txzGsq0VRwQQ7kNvwGyKTRE&_nc_oc=AdraKthQruxhT5P06GSExGCiwzfaCaU_Rlvx4qHAjaW9mziVTRppXjg9ukudyJRqwu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Qq3yV5ULPRo1iNNYgZgbfBkd8-HDVft6OjxwXu77yg&oe=6AE73ECB"}, "display_name": "KAMITSUBAKI CITY VIRTUAL REALITY", "keywords": ["VTuber", "VSinger", "Anime", "CIEL", "Albemuth"], "long_description": "# Features\n\"KAMITSUBAKI CITY VIRTUAL REALITY\" is a dark-fantasy science fiction VR adventure game taking place in \"Kamitsubaki City.\"\nIts fully-voiced characters are brought to life alongside the world with their own unique 3D models.\nThe game features numerous popular songs from Kamitsubaki's vocal artists that link to the plot, granting the player an ever greater level of immersion with the world around them.\n\n\nThe player's choices weave the story in vastly different directions.\nDive into the world of Kamitsubaki City and take part in the most extensive story in the series that cuts straight to the heart of Kamitsubaki City.\n\n\n## This game and \"KAMITSUBAKI CITY REGENERATE\" share the same basic story. Furthermore, the story is standalone, meaning those unfamiliar with the series can play these games with no worries.\n\n# What is the \"Kamitsubaki City Under Construction.\" series?\nKAMITSUBAKI An original IP project by KAMITSUBAKI STUDIO in development since 2019.\nOne of multiple story projects whose lore is linked to the studio's vocal artists, starting with tales centered around the parallel world of Kamitsubaki City.\n\n# Cast\n* Kafu Morisak i: KAF\n* Rime Tanioki : RIM\n* Haru Asanushi : Harusaruhi\n* Sekai Yorukawa : Isekaijoucho\n* Koko Rinne : KOKO\n\n{1341815630745990}", "short_description": "In a world parallel to our own resides the city of Kamitsubaki.\nOne day, the player, an \"Observer,\" is summoned to this ill-fated world.\nThere, they meet a girl named Kafu, and set out on a quest with her to save the world from its impending doom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://srd.kamitsubaki.jp/game/virtual_reality/#information_261", "developer_terms_of_service_url": null, "publisher_name": "KAMITSUBAKI STUDIO", "support_website_url": null, "website_url": "https://srd.kamitsubaki.jp/game/virtual_reality/", "cate
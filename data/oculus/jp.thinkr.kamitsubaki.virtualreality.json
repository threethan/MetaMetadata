23398_1758210398167957_1377281464552346421_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BimRFtG11GsQ7kNvwH9Rxhb&_nc_oc=Ado6WP1-APTYfOVQ9Zm-xcfhKauV6dAScE0fD9n2XeWX305MO1IleCK5qRIkmm5jPNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBN9jdHdQGESuCWuPPoVDRfCtSh7bRx6P74lth2PhZCQ&oe=6B04703F"}, {"file_name": "\u30b3\u30ec\u3066\u3099\u3044\u3044\u3066\u3099\u3059\u304b\uff1f.png", "id": "25228815560142855", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618938_25228815563476188_4189752536297991814_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2lPYYC1v54Q7kNvwHsdWE-&_nc_oc=AdoQvwN3YLIFjzW8WiOVsvQm9AgCTNfeTvPn2Y9KM8_Oijncq-CcmmSLmGfcsXT2sRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-gqaGGoGkXkJu6KneJYOiIK_eDnK6-Pzmr9Or9O7Ztw&oe=6B0486EE"}, {"file_name": "\u4e0d\u53ef\u89e3\u7a7a\u9593\u306e\u6a21\u69d8\u304b\u3099\u8db3\u3092\u8cab\u901a\u3057\u307e\u3059.png", "id": "1986218398879270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_1986218402212603_7404903089876685744_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeUYmRpGSfIQ7kNvwEcxGAp&_nc_oc=AdphQmZpWfSgnZq7AF8UM-OmIF3-I04fVDJOr6KdwBTiopaNQc7ZqkjVetg40EeRswE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqoEYzFxH_wGJA3H0BZcKkYl47xMqOzoGp2_XtOnaTbQ&oe=6B04676B"}, {"file_name": "\u30bf\u30fc\u30b1\u3099\u30c3\u30c8\u30de\u30fc\u30ab\u30fc\u304b\u3099\u51fa\u3066\u3044\u308b\u304b\u3099\u7121\u6575\u3063\u307b\u309a\u3044.png", "id": "2626750001023860", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_2626750004357193_6345986329395521024_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PW9WQgAbgQwQ7kNvwFnomZK&_nc_oc=AdovH6vPhVmwJ7rCkN1TvfwzrpIFUce02INwhU01T3mWAQXpHRyilIIyhfHpw9-0GYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjQqb2HL26ESaUqVi3Vb714NxmXvJTx1cLCoGgA8Rqcg&oe=6B045FF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV_3D_\u30e8\u30b3_RGB\u7248_\u30ed\u30b3\u3099A_en.png", "id": "2887998328074239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_2887998334740905_1656892667159644384_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sTVqsdUmNcQ7kNvwFH9E8-&_nc_oc=AdolPk_ZOjBCcubekfOquiVj6RpOycC8W6rJFeaxJlOKlGwK9JEpnkO8skq4AzKdUig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR96hgac8OK3BjRnV7SrRyc75qjQzVaMw52O7L4NVCdHw&oe=6B04780B"}, "display_name": "KAMITSUBAKI CITY VIRTUAL REALITY", "keywords": ["VTuber", "VSinger", "Anime", "CIEL", "Albemuth"], "long_description": "# Features\n\"KAMITSUBAKI CITY VIRTUAL REALITY\" is a dark-fantasy science fiction VR adventure game taking place in \"Kamitsubaki City.\"\nIts fully-voiced characters are brought to life alongside the world with their own unique 3D models.\nThe game features numerous popular songs from Kamitsubaki's vocal artists that link to the plot, granting the player an ever greater level of immersion with the world around them.\n\n\nThe player's choices weave the story in vastly different directions.\nDive into the world of Kamitsubaki City and take part in the most extensive story in the series that cuts straight to the heart of Kamitsubaki City.\n\n\n## This game and \"KAMITSUBAKI CITY REGENERATE\" share the same basic story. Furthermore, the story is standalone, meaning those unfamiliar with the series can play these games with no worries.\n\n# What is the \"Kamitsubaki City Under Construction.\" series?\nKAMITSUBAKI An original IP project by KAMITSUBAKI STUDIO in development since 2019.\nOne of multiple story projects whose lore is linked to the studio's vocal artists, starting with tales centered around the parallel world of Kamitsubaki City.\n\n# Cast\n* Kafu Morisak i: KAF\n* Rime Tanioki : RIM\n* Haru Asanushi : Harusaruhi\n* Sekai Yorukawa : Isekaijoucho\n* Koko Rinne : KOKO\n\n{1341815630745990}", "short_description": "In a world parallel to our own resides the city of Kamitsubaki.\nOne day, the player, an \"Observer,\" is summoned to this ill-fated world.\nThere, they meet a girl named Kafu, and set out on a quest with her to save the world from its impending doom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://srd.kamitsubaki.jp/game/virtual_reality/#information_261", "developer_terms_of_service_url": null, "publisher_name": "KAMITSUBAKI STUDIO", "support_website_url": null, "website_url": "https://srd.kamitsubaki.jp/game/virtual_reality/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29115588424720836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821886_1879239009672739_2670719720389219736_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y5nSik8OswQ7kNvwEXpVL6&_nc_oc=Adot5eF35Te3vQXxjXdBL6OexIurVApmFjL-j9F5ZMOqtWt9_otI_WK4S2R_P4p2_e4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5lyP7WE0cbdqkeR67DMClqhVtOJ79gXcTUQUAelaezA&oe=6B046514"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "KAMITSUBAKI CITY VIRTUAL REALITY", "platform": "ANDROID_6DOF", 
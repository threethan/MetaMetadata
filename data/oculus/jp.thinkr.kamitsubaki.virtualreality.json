s://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823398_1758210398167957_1377281464552346421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCWFsfisX_4Q7kNvwGWbRbC&_nc_oc=AdqGBYCwJwcch8bosKFDjZCq-fNfIqfdl8I6oqU7rvTSCDVXDASFexitB_w5obb2Il4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ-OyNIg-7XTvXyT3OGTI1a5GWQHSa7VqfDCRGPL0pGw&oe=6AEA123F"}, {"file_name": "\u30b3\u30ec\u3066\u3099\u3044\u3044\u3066\u3099\u3059\u304b\uff1f.png", "id": "25228815560142855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618938_25228815563476188_4189752536297991814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afs6YHv_fNcQ7kNvwHFS7RP&_nc_oc=Adr0YY-JH-qV9egdVf81ragW5C1kvQ5cFRXRhQLhrK2DC7ICjhvUM092rF8qc7PVGHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOC_rDnu-aigSjeLwUcN88K4pJgArJY-FlNrrkrr3FuQ&oe=6AE9F0AE"}, {"file_name": "\u4e0d\u53ef\u89e3\u7a7a\u9593\u306e\u6a21\u69d8\u304b\u3099\u8db3\u3092\u8cab\u901a\u3057\u307e\u3059.png", "id": "1986218398879270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_1986218402212603_7404903089876685744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNRb3MWCqsQQ7kNvwFqwXGA&_nc_oc=AdqwTwdTqXPgBp9lIbUTZ7oDdt-biUPcKD6FYPVGdUNHkK7dwrq_9CISaPqS4-adIBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6EI1eo9GaDy9wv4uex3QY3HXVCX6PPNoA616fhN77EQ&oe=6AEA096B"}, {"file_name": "\u30bf\u30fc\u30b1\u3099\u30c3\u30c8\u30de\u30fc\u30ab\u30fc\u304b\u3099\u51fa\u3066\u3044\u308b\u304b\u3099\u7121\u6575\u3063\u307b\u309a\u3044.png", "id": "2626750001023860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_2626750004357193_6345986329395521024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM4VVOcEiEgQ7kNvwEpf5Q8&_nc_oc=AdroHK7ew1XhrP25IpzWP72f573GTlYvtOCmGqCebdVm1IMb31lIw8OuqxtjCWGjJio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZJqS1PVFZbCIp0jLRpf9SOxxW6GmxByeMFFGDxzY3yg&oe=6AEA01F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KAMITSUBAKI CITY VIRTUAL REALITY", "keywords": ["VTuber", "VSinger", "Anime", "CIEL", "Albemuth"], "long_description": "# Features\n\"KAMITSUBAKI CITY VIRTUAL REALITY\" is a dark-fantasy science fiction VR adventure game taking place in \"Kamitsubaki City.\"\nIts fully-voiced characters are brought to life alongside the world with their own unique 3D models.\nThe game features numerous popular songs from Kamitsubaki's vocal artists that link to the plot, granting the player an ever greater level of immersion with the world around them.\n\n\nThe player's choices weave the story in vastly different directions.\nDive into the world of Kamitsubaki City and take part in the most extensive story in the series that cuts straight to the heart of Kamitsubaki City.\n\n\n## This game and \"KAMITSUBAKI CITY REGENERATE\" share the same basic story. Furthermore, the story is standalone, meaning those unfamiliar with the series can play these games with no worries.\n\n# What is the \"Kamitsubaki City Under Construction.\" series?\nKAMITSUBAKI An original IP project by KAMITSUBAKI STUDIO in development since 2019.\nOne of multiple story projects whose lore is linked to the studio's vocal artists, starting with tales centered around the parallel world of Kamitsubaki City.\n\n# Cast\n* Kafu Morisaki: KAF\n* Rime Tanioki: RIM\n* Haru Asanushi: Harusaruhi\n* Sekai Yorukawa: Isekaijoucho\n* Koko Rinne: KOKO\n\n{1341815630745990}", "short_description": "In a world parallel to our own resides the city of Kamitsubaki.\nOne day, the player, an \"Observer,\" is summoned to this ill-fated world.\nThere, they meet a girl named Kafu, and set out on a quest with her to save the world from its impending doom."}, {"images": {"nodes": [{"file_name": "KV_3D_\u30e8\u30b3_RGB\u7248_\u30ed\u30b3\u3099A.png", "id": "1270113868201451", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_127011387486
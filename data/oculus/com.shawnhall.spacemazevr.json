zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBVxj3xUoE1Vnjxa_7FAUGxJ70jSFS5mdKSmozFfyrOg&oe=6AB146B4"}, {"file_name": "aMaze5.png", "id": "1009690468537016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623384_1009690471870349_3538799942980070735_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESbMB1fUXBsQ7kNvwFdcGQJ&_nc_oc=Ado8Uz2RER79kUA5XksRnhdKd6YOd5Kb5FFtwaODA7JKhqjS1sdxzA8xDtJMdpbN04A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwNWZmZ8R6rMVkP-u3h-VljKyOr8amiWaRV4fUK1VzBQ&oe=6AB156B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Art.png", "id": "1068601749018516", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623400_1068601752351849_1034351198903300444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIaS2BvsNi0Q7kNvwH6DJy8&_nc_oc=AdqShgVKVsPUqH3VXUGQfuVYEBPLJ2Zq-jBAlJVvcZbetmWbGnJPG7soACn4DHZjmOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRUKCEs5GUZnKgx9u5-EuMQeRVwppapdiCItElE6s1gg&oe=6AB13865"}, "display_name": "Space Maze VR", "keywords": ["SciFi", "Space", "Adventure", "Ship", "Collectible"], "long_description": "Your journey spans 30 distinct, increasingly challenging levels. But simply finding the exit is only the beginning. Every maze is packed with hidden items, secret pathways, and hard-to-reach collectibles that will test your spatial awareness and keep you coming back to master every sector.\n\nProgress your way through 10 easy levels to get used to maneuvering your spaceship and collecting cubes. 10 normal levels to test your ability to navigate and exit a maze and finally 10 hard levels to truly test your endurance and skills in navigating out of the maze. Increase the challenge by seeking all of the Cosmic Cubes in the maze.", "short_description": "Embark on a space adventure where you navigate mind-bending cosmic mazes. Collect cubes, dodge hazards, and find your way out."}]}, "developer_name": null, "developer_
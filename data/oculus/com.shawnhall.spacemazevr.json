661_7888663612561129494_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgG_dGGQ8agQ7kNvwG2C_vB&_nc_oc=AdrLJvW9Jhhh5pvAWSEZUcTSZR1ILTtNTUrReaefhWZpJzT__cic2GXZWocsKSWJi_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH7Sa1fxWlxafEq7iL-wwWuWOXVn3BqTpPeFvdAohDvg&oe=6AC3C183"}, {"file_name": "aMaze4.png", "id": "1526004355890220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305114_1526004359223553_4091207873828025138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3aOVhI5IDQQ7kNvwHfaDnH&_nc_oc=AdpBY965lDqkU_eMB97oBXMbIR_FSGEZOQiWkzAQ5XMCfK8ioQdYs8wD00K7qB6qnJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOORkKHFjeQt77WmUVU_Guy8ymMMMDTkvIzxDyRbBp5lQ&oe=6AC3BBB4"}, {"file_name": "aMaze5.png", "id": "1009690468537016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623384_1009690471870349_3538799942980070735_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2gZ4wZ8S9IQ7kNvwF0VYin&_nc_oc=AdrFLvDn-5K9YhrDsXVX_gA2C25qrGe8rfuuQEXr5bFIGOf7kUF5Z2kaP4dAQlG8bB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEQABdEh5OqgWMkL-BLE5_k0Nj54UM7T6PN2zZdWrfOQ&oe=6AC3CBB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Art.png", "id": "1068601749018516", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623400_1068601752351849_1034351198903300444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ3dFGWtxkMQ7kNvwF7eXwf&_nc_oc=AdrVoSlFeRPQbr1qo9vWwm6dozyhniDmtQGf6C5ZNqYdc_qXhG5VmFzVQ6IeZUCoViM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi2P8fZatGqrVSKqCrNld1QOgA9_6A8au9HQwvbOQSNA&oe=6AC3AD65"}, "display_name": "Space Maze VR", "keywords": ["SciFi", "Space", "Adventure", "Ship", "Collectible"], "long_description": "Your journey spans 30 distinct, increasingly challenging levels. But simply finding the exit is only the beginning. Every maze is packed with hidden items, secret pathways, and hard-to-reach collectibles that will test your spatial awareness and keep you coming back to master every sector.\n\nProgress your way through 10 easy levels to get used to maneuvering your spaceship and collecting cubes. 10 normal levels to test your ability to navigate and exit a maze and finally 10 hard levels to truly test your endurance and skills in navigating out of the maze. Increase the challenge by seeking all of the Cosmic Cubes in the maze.", "short_description": "Embark on a space adventure where you navigate mind-bending cosmic mazes. Collect cubes, dodge hazards, and find your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spacemazevr/home", "developer_terms_of_service_url": null, "publisher_name": "Shashawnee Hall", "support_website_url": null, "website_url": "https://sites.google.com/view/spacemazevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1238225602704374"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1381449788374729"}, {"status": "PUBLISHED", "id": "1918298146241975"}, {"status": "PUBLISHED", "id": "1370913981207707"}, {"status": "PUBLISHED", "id": "1008075632128436"}]}, "baseline_offer": {"id": "1381449788374729"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789750260, "status": "PUBLISHED", 
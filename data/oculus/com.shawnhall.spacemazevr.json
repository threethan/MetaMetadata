661_7888663612561129494_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giEY9EMIJOIQ7kNvwHi_mjF&_nc_oc=AdqjY0rq5m_rQn0Xhzb0n9_HWkbjpNE0PCfcPnoP9Kk2O-VB_XhYIEP1QBROkvA1uoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISqBNQaXRya8JOfXmYrgA6Ee73JiShlmakg7_PPgyVsw&oe=6ABBD883"}, {"file_name": "aMaze4.png", "id": "1526004355890220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305114_1526004359223553_4091207873828025138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiQImpVDS-IQ7kNvwGmgjLq&_nc_oc=AdplIMDAHQ-yOyACN8bXrZGAdYNorsl4tzkWGiUsQ66APXI7_CTirTu49XHBU-UxzHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZJD5_ECmK_FJV2cj4QNzG1Zs-CDVmMoYQWXpUE7Q71Q&oe=6ABBD2B4"}, {"file_name": "aMaze5.png", "id": "1009690468537016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_1009690471870349_3538799942980070735_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlRsFM-M2WcQ7kNvwHP8j_D&_nc_oc=Ado2JeiJ3D9NMvThDdE0mmmiN3b_W8srrqm1eDRy9CoYZN1RHh_K5bQ1eZrWxT5sIGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDMdWm5ozg2YZjHmRCMkgoFJGZc0lmC2XMNWp2vTyOsA&oe=6ABBE2B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Art.png", "id": "1068601749018516", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623400_1068601752351849_1034351198903300444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXTAMAhA65MQ7kNvwEDse6v&_nc_oc=AdobNg2uxZHywnILYBE9975D0vToUEwyISC_TjKVgMXBZbqX2w958kfhkOgPfOC-_-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUMOCD0wsf6b8s71a2euMJhoG8M_0mLWaTG2e09xxNMQ&oe=6ABBC465"}, "display_name": "Space Maze VR", "keywords": ["SciFi", "Space", "Adventure", "Ship", "Collectible"], "long_description": "Your journey spans 30 distinct, increasingly challenging levels. But simply finding the exit is only the beginning. Every maze is packed with hidden items, secret pathways, and hard-to-reach collectibles that will test your spatial awareness and keep you coming back to master every sector.\n\nProgress your way through 10 easy levels to get used to maneuvering your spaceship and collecting cubes. 10 normal levels to test your ability to navigate and exit a maze and finally 10 hard levels to truly test your endurance and skills in navigating out of the maze. Increase the challenge by seeking all of the Cosmic Cubes in the maze.", "short_description": "Embark on a space adventure where you navigate mind-bending cosmic mazes. Collect cubes, dodge hazards, and find your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spacemazevr/home", "developer_terms_of_service_url": null, "publisher_name": "Shashawnee Hall", "support_website_url": null, "website_url": "https://sites.google.com/view/spacemazevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1238225602704374"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1381449788374729"}, {"status": "PUBLISHED", "id": "1918298146241975"}, {"status": "PUBLISHED", "id": "1370913981207707"}, {"status": "PUBLISHED", "id": "1008075632128436"}]}, "baseline_offer": {"id": "1381449788374729"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789750260, "status": "PUBLISHED", 
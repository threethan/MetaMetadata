le_name": "migrated_image.png", "id": "203616130913498", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449036_1685302351763207_3664735348446986240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgC6u03-RaMQ7kNvwEgbM6C&_nc_oc=AdlDeVbqH3cYj_7OHyqLhi29sLXtfbK44ShqfUFWJqT-Bx6VkxzqRUmZs72Tfd6b0SY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft5-B5OfzOwKRnjDFg5o3HisoaLF9rOHjHUGTLjMTpf5Q&oe=69A56E70"}, {"file_name": "migrated_image.png", "id": "201832817759062", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522311_1819529011706215_8244640747777687552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovIs1XmUgx0Q7kNvwHBvt-5&_nc_oc=AdkH_ysNB7UeTtwWHTHkh62MDL41i2F-G1LYrMP-ewuzYu3l4Ueqeo6NZ65e5Ck1UNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvnHB2O26PMuDeYRXKW7bswdMTwP_h9KObkrFxm2_gTTw&oe=69A56CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots-16-9-2650x1440.png", "id": "282671518873603", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162741_282671522206936_9178621131920244736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfSZ_UhptxIQ7kNvwGgavH9&_nc_oc=AdlRKBzjR3irow85M008kouH87Its7T0G9xseEISbwwmKoxbpFuIsfA8VdfJWrzgd5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvv9UeuWDzwD3vFDfccjD4QkSE0LJhsaNdxtr3kDJu6sg&oe=69A56EA9"}, "display_name": "Jetman VR", "keywords": [], "long_description": "Trapped in the confines of a Space Laboratory experiment gone awry, you are the only survivor and have to escape the threats that your team failed to overcome. Dangers await you at every corridor, and you only have your trusty jetpack to help you survive the perils that await you at every turn. \n\n-> Randomly generated hallways that intelligently adapt to the player\u2019s skill level. \n-> A Jetpack with realistic physics to ensure only the best space cadets can master the flight. \n-> Immersive and detailed environments will have you looking all over your surroundings for constant dangers. \n-> Challenging obstacles which will take time and patience to learn and survive against. \n-> Survive deadly encounters with a menacing boss to keep your run going. \n-> Compete against players from all over with a real-time leaderboard. How long can you hold the top spot or take the crown from the king? ", "short_description": "In space, no one can save you. It\u2019s only you, corridors of death, and a jetpack. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://bigimmersive.com/legal/", "developer_terms_of_service_url": "http://bigimmersive.com/legal/", "publisher_name": "Big Immersive", "support_website_url": null, "website_url": "http://bigimmersive.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1578708742497415"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "CANCELLED", "id": "251570042024805"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1500483600, "status": "CANCELLED", "id": "251570042024805"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "988423411260765", "version": "1.0.4"}, "id": "183644072128316", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "900336226736151", "is_concept": false, "lates
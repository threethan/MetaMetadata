iler": null, "video_trailer_thumbnail": {"file_name": "Screenshots-16-9-2650x1440.png", "id": "282671518873603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_282671522206936_9178621131920244736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4QP_miE2pMQ7kNvwEiCLXt&_nc_oc=Adn_9BajLct5FY6ifeWnG03UYr1pvsY-bZsckLovpW1tNsdZbTZB-MfQmEptlofalAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsZqa9edXD0zlgUaGIOjdtVHKYoZHf7ual7Q16jpDsFA&oe=69B29DA9"}, "display_name": "Jetman VR", "keywords": [], "long_description": "Trapped in the confines of a Space Laboratory experiment gone awry, you are the only survivor and have to escape the threats that your team failed to overcome. Dangers await you at every corridor, and you only have your trusty jetpack to help you survive the perils that await you at every turn. \n\n-> Randomly generated hallways that intelligently adapt to the player\u2019s skill level. \n-> A Jetpack with realistic physics to ensure only the best space cadets can master the flight. \n-> Immersive and detailed environments will have you looking all over your surroundings for constant dangers. \n-> Challenging obstacles which will take time and patience to learn and survive against. \n-> Survive deadly encounters with a menacing boss to keep your run going. \n-> Compete against players from all over with a real-time leaderboard. How long can you hold the top spot or take the crown from the king? ", "short_description": "In space, no one can save you. It\u2019s only you, corridors of death, and a jetpack. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://bigimmersive.com/legal/", "developer_terms_of_service_url": "http://bigimmersive.com/legal/", "publisher_name": "Big Immersive", "support_website_url": null, "website_url": "http://bigimmersive.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null,
5/12522311_1819529011706215_8244640747777687552_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G62ZDfRkQ5MQ7kNvwHP4Phb&_nc_oc=AdoOcN0K_ierspyHs4BwgEP4Mm0GVgjMwhtuiDSucT7x8M67_rqd9bskMp8rhdBsWGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE3XMeb6pR13EOxvf4RB03Y2ExYTzGly4PLWDHJalOOw&oe=6B084893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots-16-9-2650x1440.png", "id": "282671518873603", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162741_282671522206936_9178621131920244736_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFqbJF8sQp4Q7kNvwHbBwq_&_nc_oc=AdopYG6GbZPgah-7aq-C4Fg42M5HR8WCm1BZHEUqyMvya8IEZtD6RZCDZFSM34MSxPE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiDtmssurcQK8Je63q9K5XhlmgZuLKwRSzZDyGSISgtA&oe=6B084A69"}, "display_name": "Jetman VR", "keywords": [], "long_description": "Trapped in the confines of a Space Laboratory experiment gone awry, you are the only survivor and have to escape the threats that your team failed to overcome. Dangers await you at every corridor, and you only have your trusty jetpack to help you survive the perils that await you at every turn. \n\n-> Randomly generated hallways that intelligently adapt to the player\u2019s skill level. \n-> A Jetpack with realistic physics to ensure only the best space cadets can master the flight. \n-> Immersive and detailed environments will have you looking all over your surroundings for constant dangers. \n-> Challenging obstacles which will take time and patience to learn and survive against. \n-> Survive deadly encounters with a menacing boss to keep your run going. \n-> Compete against players from all over with a real-time leaderboard. How long can you hold the top spot or take the crown from the king? ", "short_description": "In space, no one can save you. It\u2019s only you, corridors of death, and a jetpack. "}]}, "developer_name": null, "devel
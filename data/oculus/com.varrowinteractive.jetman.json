5/12522311_1819529011706215_8244640747777687552_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOPaXvVYpAsQ7kNvwHN4bIb&_nc_oc=AdpLSPVDdLcr5er_NNNCA19ryNYhlqpTn6ssitWbp_AccbDIK5JUEJolao8Y9kc8_2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRePzIP0FpzGgBf1KvTbEMS1NLDvcRzJTxxebgPPKdjMQ&oe=6AFDBC93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots-16-9-2650x1440.png", "id": "282671518873603", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162741_282671522206936_9178621131920244736_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2dhn88O5zEQ7kNvwE8Tyvc&_nc_oc=AdqoH4QT1pqqFXiLe_V_-YKEim7Dtyd1gTF40lM--bkfJUA6EWBBi_yu9lwiGXI53VY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgnCTglNfsmDtA7rdz9BCSzrQ-3-0A2SBjg5mrUeTB-g&oe=6AFDBE69"}, "display_name": "Jetman VR", "keywords": [], "long_description": "Trapped in the confines of a Space Laboratory experiment gone awry, you are the only survivor and have to escape the threats that your team failed to overcome. Dangers await you at every corridor, and you only have your trusty jetpack to help you survive the perils that await you at every turn. \n\n-> Randomly generated hallways that intelligently adapt to the player\u2019s skill level. \n-> A Jetpack with realistic physics to ensure only the best space cadets can master the flight. \n-> Immersive and detailed environments will have you looking all over your surroundings for constant dangers. \n-> Challenging obstacles which will take time and patience to learn and survive against. \n-> Survive deadly encounters with a menacing boss to keep your run going. \n-> Compete against players from all over with a real-time leaderboard. How long can you hold the top spot or take the crown from the king? ", "short_description": "In space, no one can save you. It\u2019s only you, corridors of death, and a jetpack. "}]}, "developer_name": null, "devel
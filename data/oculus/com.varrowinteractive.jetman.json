oQ7kNvwGDoo8Y&_nc_oc=AdrmyJUNC8VZzTfiOzgoZ-Rb9nP8pDRPwZFae0aBBxLjnCtzkZJxFStjrczFLQywQTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9OyU-goYbaQDzDIr2jSF-JZpsreZ_qN6ud8_7Tl-JgQ&oe=69C142FB"}, {"file_name": "migrated_image.png", "id": "203616130913498", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12449036_1685302351763207_3664735348446986240_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYl5UlXJxmwQ7kNvwG1prHs&_nc_oc=Adq2-b7T_dnMeP_0XSifeLnh-ux3hXfAzuNUgdKWLWOIXZ0NLPGsjKkRBM03puDWGb4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyu-63PNIYo7CliwtgdaxRWuja5fcNKfSTOxeKdgK8spA&oe=69C11DF0"}, {"file_name": "migrated_image.png", "id": "201832817759062", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522311_1819529011706215_8244640747777687552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biRE9ra4Qj4Q7kNvwFUGCpM&_nc_oc=Adp6JgtPqykYVygpmWcjpeOWKciDxbTpZd21yLY_Oe_mWaZpJAP5xw5_nixuujvk1zY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-_yFDEtG87K7QkZllMTpfyUww8OSjXCUUymdAifL6yA&oe=69C11C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshots-16-9-2650x1440.png", "id": "282671518873603", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162741_282671522206936_9178621131920244736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fx09SiPlr-oQ7kNvwGu7TVW&_nc_oc=AdqQnYuTguSvBmeYUYp1-LN1Q3k9k0TVjTVX9oJwsHhw4d39DZJFgDcK4msyLOUm3vQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxaVCI02sHiwZv4zOWfIwr0b7mwIxXH4B_Ovad3WWTew&oe=69C11E29"}, "display_name": "Jetman VR", "keywords": [], "long_description": "Trapped in the confines of a Space Laboratory experiment gone awry, you are the only survivor and have to escape the threats that your team failed to overcome. Dangers await you at every corridor, and you only have your trusty jetpack to help you survive the perils that await you at every turn. \n\n-> Randomly generated hallways that intelligently adapt to the player\u2019s skill level. \n-> A Jetpack with realistic physics to ensure only the best space cadets can master the flight. \n-> Immersive and detailed environments will have you looking all over your surroundings for constant dangers. \n-> Challenging obstacles which will take time and patience to learn and survive against. \n-> Survive deadly encounters with a menacing boss to keep your run going. \n-> Compete against players from all over with a real-time leaderboard. How long can you hold the top spot or take the crown from the king? ", "short_description": "In space, no one can save you. It\u2019s only you, corridors of death, and a jetpack. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://bigimmersive.com/legal/", "developer_terms_of_service_url": "http://bigimmersive.com/legal/", "publisher_name": "Big Immersive", "support_website_url": null, "website_url": "http://bigimmersive.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1578708742497415"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "CANCELLED", "id": "251570042024805"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1500483600, "status": "CANCELLED", "id": "251570042024805"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "988423411260765", "version": "1.0.4"}, "id": "183644072128316", "channel_name": "LI
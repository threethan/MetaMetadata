5199708135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYbz11cBzRgQ7kNvwHNEdFr&_nc_oc=AdrORVuzZkCE1f-25IfVKqnSlhBaWy2-gFHZ9Jbg9BRGQtWf3PJ9mmuCuacSpE5b1U4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QZgXU-Ui2AOY4HCVxtd0x9OhuezfWOwODhDu7_ZsTyw&oe=69D279EC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxhfE_tz6fwQ7kNvwHLNiHq&_nc_oc=Adoylr50Bp_nhQ9Gp-TeTNp3Jeh7t3sMMV1d-Nbovynt3GIcmrRxfHoGzxom5mjvmr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FG1ErpgmtuM-qjdIDKkOhSiHqn3wwdQ4lsetbYOPjEA&oe=69D24D0C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmRAJMRnvWQQ7kNvwEQXeaX&_nc_oc=AdqXZnYe0yIGtfSTMhhwncCzlvQcG4CtA98i9L3GfNqEr6BNyf4FMSwYUUUat2merfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dwQ-rymR7lUSHBIHOWbqhR3nhlwRMG5_nHT0X4KSQhw&oe=69D265B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQIxiyR9WtcQ7kNvwHDM1Jn&_nc_oc=Adr443UhAG8YtnNUCd7t4hbmg39d_p2Zh6N6iml-i5BZ1Rb5kOpeGFnDoi-xFpI7H3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bxsc0IkccHK6bAwzdGDVo15NJBA4m7n-KI2ufliA-rg&oe=69D269CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCjzHkmDlQkQ7kNvwHDFZYD&_nc_oc=AdppUCwpikvFb-e4gnUFkGqOOGfmZUO5RwMUc4Q_vTe9Ei3KIQOlUw4tWpxTNe21M-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o3XJPC5m_1aL_hDRrV3h9JFp2
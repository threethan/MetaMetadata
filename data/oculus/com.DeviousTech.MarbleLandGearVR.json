_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRWTkCqOljwQ7kNvwGrsSdN&_nc_oc=AdkKx1XQnp4JCf1as0eZ_515I3BlJ9NIySz8Ys2vXvueadevJVwSVt2qOYAaakv72cU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1-bnkVmNsvjZA5d0KBdyJ8W9hqU3tYGiGbcSnT0Klpw&oe=699D85AC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeTz4ZmSp9wQ7kNvwEtzO5J&_nc_oc=AdlHUX3nB1ylp448JqNP5n4OxMv-r_0FiHrPqbv69FN-dHkTOM6d9ns2qSLuwziaekI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZ7jmdFKDXVQm4K0D29FGxurldL7mqRH1K01-aoNKNXA&oe=699D910C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_NxlUv62_EQ7kNvwFHSW6r&_nc_oc=AdnM63gU8Pp4Gk5MkvrkZRNsoO8_0DpcRbTftI5C2evQNglfEPwn48me7YRWaQwc8c8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftC5RLF9x6V1qI-tM3FJ8AkszpufAQ0GPWdyMR_5CpRyA&oe=699DA9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAXFKD_GGakQ7kNvwEFmmJ8&_nc_oc=Adl1s20TCqZKG0_9DlgXaAyslkFhK_q-NNmravS4cUSc6enCpeE3FeRO05jAzvzfYsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsf54Qjve0gSZEC0T5uJq7EUAOT-VJHO0LG4Y2Djwa3DQ&oe=699DADCF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZzEMjlcxRgQ7kNvwETl-RB&_nc_oc=AdlytZQP07dYapZgSb08gMIsHX3zb5h9WImCy5ugHG6zKUDxt3enl_-63_40qEV7snY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftswGUgXQZufpRUxFZB6k-XWEW4XioE0pqHHntBTCQM7Q&oe=699DA1D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null
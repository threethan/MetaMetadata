5199708135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg3NJ3Dm7Z0Q7kNvwFaUHgi&_nc_oc=Adq06YZ89Cfi-jOiIhleXOI52raOZkKm0rYFgnBPVI0szauozaKjw4moHVhn9yE0iV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nTgDaeqozjU5BKzOWqic6VYaIVeT7WcEjRxiTwOWmXQ&oe=69DE1F2C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp7sSnrGUdkQ7kNvwFsy0vQ&_nc_oc=Ado4MvelGbSwJ4HZaHZyJYstfhK29HuMvonTKoXvyZYbAmXFWbJz5Xciu2G8CFtws1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zyJnXWRsBx5DwM9-tTNKPIsz013dCb0WVgP4aP-Lmqg&oe=69DE2A8C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8AkOsyC54AQ7kNvwEmPsjA&_nc_oc=AdojV--6MX1Yfnodav8pg3AJWCSC_ZJ7vUdz87bzyjgHBXiMiOtUPdX9WYhGIrxb4lI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04r_1q7ATH0mDU418vol1O_ae2PamMw2AH0H4gOg6FEA&oe=69DE4332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TJvuzMYd7oQ7kNvwHUHHoi&_nc_oc=Ado_eQspLGpa4vgpeJgUTZi9XkJXJeWMhIxDwFPrziTWik_2s_mlphK3XMwKIGz-W8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HX5ebwbWk4-WT9s2hjtkp3_HIWG27XTEcmeafi9-wlA&oe=69DE474F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqafYnyINO0Q7kNvwG3c90w&_nc_oc=AdoSS14nlf-LvkCEKpgDwhHtigXdxRksdVqmbeve-RNqR1AsxtFX8CfMuR7FLjK6rxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1r3XefwKU6T89St3OhOHTdN6ns
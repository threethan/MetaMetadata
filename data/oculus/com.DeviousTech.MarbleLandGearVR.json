5199708135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg3NJ3Dm7Z0Q7kNvwFPtlW8&_nc_oc=Adq_uAHCcacZnUaNun1HkmyIX_jGafghyCNV8kahVdaYZKobwbm3hc2-ImFAVHriSfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G2ocRV5UM8H5Z7lpY17cUbw3vlyr_EGl70C7G8TfzKg&oe=69DCCDAC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4TStB17lUAQ7kNvwEAdvPW&_nc_oc=AdpS84dMctMJj6-oAKxPEWnCrnzJK2trgbFpY5oN6aNnF3NIzHciI-9ABrKK3v18xjk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WWJKpbJbyUmDm6O7dIQiD4RIuGHQ7i9guviXTOp2Eqg&oe=69DCD90C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8AkOsyC54AQ7kNvwGztJlp&_nc_oc=Adqp9DNHiU6Os_rEAgLauLibLcRCzm4nsGx0qGCIH-g9a2im3aNUq4K3hrlcLGriMQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2exhUspfyhyZvF8Eo8ugra-B7s52MWS3sm21ZBSSBV7Q&oe=69DCF1B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxtvFkqn834Q7kNvwGJz65n&_nc_oc=AdoK7E3yeqIhv3kUB3N4PmMZxbytlyjarnVq4AGSM1hc2rGXykrIwZxS5XugCB9kvQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uiWQ1GnUQ51Lu0vWig55_5gKrJEYe53zEbp4mJ8C5gQ&oe=69DCF5CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk_KJcoTiHEQ7kNvwFjHOq3&_nc_oc=Adom9XEYYdnHThtr1b2qehYrJcLoy_Ppd3hORTkDBbo9LyIeYTo9geGXUA79YgmBjDc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XHBBxZFVwPipVUOc_SPXu8ect
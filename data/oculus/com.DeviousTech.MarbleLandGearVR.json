5199708135", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGa_MkwB1_4Q7kNvwG6v0Te&_nc_oc=AdqLHq7gNFHI-l7CSvzSeRWUYu0pgud0QcZlT9SDzw7O7KHuMexd47TKFn19Vz_JpCI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DSDTM5ezCpsXroGKoYuRXPN3LWBk2tqnxL4AypnbOdg&oe=6A0C7BEC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSX-i-nAOJYQ7kNvwGBGEBY&_nc_oc=AdqCJMNOypRFEbWMEQIN5BLvTqCialwVgjYeWVsSa72-knzauCWryhgPnE-SeoYwuEc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LbgTQJp6OYaaYFHc_KKG34mYs5t7OfPIHgEJOp9XNOg&oe=6A0C874C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eH2tNb14QeYQ7kNvwF8MnPG&_nc_oc=AdpE75xtWHPFNDnHy4Lj97vTrL__xHpj3Cjb2f2j4xSAQVPE90y5OJEabYkxx6eJips&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EDb3NfeePlAvXhDlpmj38a3JcWYRUDrZC0EsXh0rBQw&oe=6A0C67B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu-DobPZkOYQ7kNvwHBBz66&_nc_oc=AdpK7PgSZ0vi67nFoUhKX_TBdOUE3W5HGv15VOGKagClMDTDUbNFYKuVtCISrpOntMI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vH2ZDTxttUv_481lnrjsZszQdD_acJUXPmioYyrM-uA&oe=6A0C6BCF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHvAEEAKCFwQ7kNvwGOVRhO&_nc_oc=AdoZZ4GAQyO8lX-e0olt5IGRyQDE87ZGGTpZ9wf1Uw_KWHWqaLy1zqfG4h663lGus3o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qXDnbEoxBHl-Kr7NF4jmPHrCw
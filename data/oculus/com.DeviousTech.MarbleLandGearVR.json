5199708135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB6Oaj3UaAoQ7kNvwERYkw9&_nc_oc=Adp8V1ORU2p3gcnmhKOwt-fqTaGfLs9zeP-J4OsZ1D6Qv6uLAPkudIvTCyhm2Xj05w4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1zFqZuqqodHv1srD891OqPxXf4caKYEJDRtfLqMJ6tw&oe=69C9072C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXljNduxqYgQ7kNvwG-Z19i&_nc_oc=Adoe5iFdItUVXWMOaoRh1S17AeFivia5asOvB5WwHwdJA-8YHsxX1aNlwKHkM_Uz108&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkfgzwJ0lNhu7SUhLOVU55ZkNzKQo9do6Qn6XKi8ZYbQ&oe=69C9128C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OUr4NMHnTsQ7kNvwFqtGMY&_nc_oc=AdrmBdkTew9IFyqy-EDxUuesJwoN64Tj2x1_Eb9e-rxkhmpOrNk9AtRkHaidFTpCFUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afys9iUOUkpObEXTppTZkc5tF_pD0xob5hza-l5abdKodA&oe=69C92B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0PZVV-wxpQQ7kNvwGKpS0m&_nc_oc=AdqaxJT1-6v238eJbt1n2NgNg5Zz3bxr2Mn7Bu-QW4lyMIxYjOUYzcAXoVD-_HrvIgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk54oPiyvFza4eXPtBaQyEjyuflSRx6CHXWWA1FkkRyA&oe=69C92F4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeRyTwuXwCMQ7kNvwHovdq-&_nc_oc=AdrWI0Dh1qooKGwZMqiKQLBSbvxSBvKqq3t-wQdRldCuxFLvrNPqqioOeg6lA83Jy44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfLO2gXJYIUgLEK9C-V3YYYbB0
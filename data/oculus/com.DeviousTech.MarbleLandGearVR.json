5199708135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daCXHCDsDJIQ7kNvwGWpSDh&_nc_oc=AdqrJQbg5MibjVIHCXcOAa2IccpY-OOk32zVnWGrANjaV9qGpS4MoFTl0UJfpvdnRzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyL4gWSz45IDBxMmzJropFX0NoyS6q_Y1MjKHmqVCNPWQ&oe=69CE4D2C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eotnh3Tf2W4Q7kNvwEB6-iH&_nc_oc=AdpcFUZ0CCj1-Nxhem2vDP6G_LS4xgA0dU1uJwsAYIYopuRdaFBxmEMh3bo0RV8KdIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9SeeHA2-FaLZcSN_L9rj4-v10HASp6fVjjlX_D3Ac9w&oe=69CE588C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40clu89_KeQQ7kNvwHjCOSP&_nc_oc=AdrVHgTWh02bZXmLs6XkHKw7vnj_deZbw7Q5KD4odYMmGuOHcuVVDTQnzA4eJUdetEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlK4z4LDqIJvEANpSzOlrrZ1SfzFPBZ1bcBsuxV2OyGQ&oe=69CE7132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6liMoPr1nmIQ7kNvwFXrcX9&_nc_oc=Ado9Ok84bpiicPXrn4eZwMP58udznJA3s-0bmax9ivdAliUMrSbgljeDJv4oqfVkYoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIOAy7R_viELkFsbwqcIjz3lOqzJd8HE8JYzuNiRgEfQ&oe=69CE754F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABzQ9eohyTEQ7kNvwFtX1j6&_nc_oc=Adr2-hH7tWU7342vCv05hnqcfDqoABTroMpasdWSZnHumPbRGCSgu5Mef-vbu8uK-OY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpW02GacA9vkzhZxCPwPbR528I
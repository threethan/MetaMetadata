5199708135", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_Xlwezn_NEQ7kNvwFsmTBl&_nc_oc=Adq2eIfd6O_HoxSrldckiRAfgdXKinBgxjegh2Y_OH6plHw1S-msVlQE5Qs2sfBtAhI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NzzmmPCgvAMQUF9JR7wb6MbCFOak_3yJ1Q6GyiuEkdw&oe=69F4C0EC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iz_k18fz-cYQ7kNvwH1yGDY&_nc_oc=Adr1caIbYj1pu8H9VGT6CgPi57QHFD3PdFeBgObb0_AhAmRYOf78h33TJXI09ZUxZVU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3I_DB4g7VINl8fShSGIXSijwehT7-43v6zyGiibPhqKA&oe=69F4940C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6nJsqN1lzcQ7kNvwEq-upQ&_nc_oc=Ado-umiucVXOlOxjIRx17bpetkr9T7m-WOhXGAx8ybFt8IuRGLBo6BU54lUefAxyljo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KNMUc_rwCc7IHQ0xUUWWFY1J0pzmphaqyVGK4kcZaUw&oe=69F4ACB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI720uG9x6kQ7kNvwEkcej1&_nc_oc=AdoWn74hVUUbw8mq7mjinjbTGmmbNIKDrLp2noICfF3RPQOevDxvbJ2qVhomxcyoC3Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1p8tinPzdTDctAXEzvdoBng4WILvk61-Jcj3QmRQxGgg&oe=69F4B0CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sePPRuAOWUQ7kNvwFuhZlF&_nc_oc=AdqTbKwggMC5YAXz5KkT5cbyRrNGZNU2_99BtBgymD9i1qbphSv95HEvGignN3Gix0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37rWZ1q326UEpJEp30QyLirQVg
5199708135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRm_FJkQ8KcQ7kNvwGsUOz5&_nc_oc=AdoZl0s89hoPc46GroPzQjaHiDfm_jLCyJskBiTazcr5j3WKY5KP7EDn1lV9mgz9_0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ch8zPwdVOe0nksRdqEWVIkRvEVKoNLb0DpFvuONbafQ&oe=6A08876C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D-p51MhFtgQ7kNvwHsvS9k&_nc_oc=AdonBM6ELposQsgLIodIRsdhRlpU6E6gNPfLI9J-afU6k13rTuS5qFKZBmOOMII3VP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hxPfqA4KUHzrYLK8Z27k5PX1d1KzfJvGgUnysrOXChA&oe=6A0892CC"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2tJFhG096UQ7kNvwFdxi1x&_nc_oc=Adpba8GfzLuK4GNv--7VcU39V4kFX_3HBqyE12BDb1xhyRm3ei4aKpgxIVpiTzB6pFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EmVyXUWZPh5z_I_DEh7zKjBt5pA9xkE_vQE6jHum3IQ&oe=6A087332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48sP7EVvB28Q7kNvwHb2cJg&_nc_oc=AdpeSLQlKjkxIV35PIaKdn65oNBX09TiuFJIGVQTz123t1W1oVRNeUu89Ki95zhul9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GOZv_AKMzH_visgNvW-yaBb3bWdaxP9nWwCSzj8dyWQ&oe=6A08774F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvJG2xefVpUQ7kNvwGwOGKW&_nc_oc=AdoT_6o5s6g4nSQQXln-GEPBvDXLB4euWW9MYuAxu3YmA11Dnq0zHOQpmKXL-FLyRYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XAtZ1FGgwg64Gl2izLcQYs_md
5199708135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2iMviWwr1AQ7kNvwFsefGH&_nc_oc=Ado5OXOTCqjRCJS--dXii1o0WdsEd6pyDPPYebdyHXc0LKqj-V7rzzDQJdlLLoLimjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCAvou6fO69bZgJVvGoGR3EjOH8t8KGUWmKcH9ks52XQ&oe=69C26FAC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxY2lbpdGg8Q7kNvwH9Cl84&_nc_oc=AdpEMXriejBzKVxuYervFmeYTxNohkpMyCqbVPRc1Ifu3S6LYU5bvX-KrZ9KJlx1MOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi_X5rUCVvtbrWuN4BNIpIHw5F-SV-GXRTcMYk_Gzlgg&oe=69C27B0C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QS3rxiLFrgQ7kNvwELO7gz&_nc_oc=AdoVY-Dygt3yPTQwubLWr-9PqWvbJMJn1p4SQah9MIsya9mFdjRk9Pa0Og8OPNfQxic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9JSdazWhI2As_4SrzxtF79CI4E10pVC0mG0jMD7RRDQ&oe=69C293B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GKMoWRzny4Q7kNvwHwtIuV&_nc_oc=AdpjsFzp4_N-5tc_lKaOJAAPx49nqxZqxqBPUWrxUze8I4_E9PsgjxfE1uBicO45-4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJnZ-ni6zj3IcvpVc29wV-G7ITqw5zA1mvwZ03cB20ww&oe=69C297CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4mZ1rg3PQYQ7kNvwGpnLZW&_nc_oc=AdoWP6z_4H7RCKrG2RZP483vGv8QNdbC4VE16tUdcKzLckOxXnhmncC6h0-ler3SJAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-AogCRwVN1ju2ce015aHvzHZ_
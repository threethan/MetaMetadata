5199708135", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRm_FJkQ8KcQ7kNvwH0FlqH&_nc_oc=AdqoTdrvzbQBETYoWrTyiMzZswJ9Vl8dAWYQ0i7MWwM6IP1Y1SM5jV_dJZ5J08aTeAw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HSbWTEN0bZ05a4YuoK1qa-EHmiFqTLRq-HKfdY819KQ&oe=6A09D8EC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSX-i-nAOJYQ7kNvwFkJUQ1&_nc_oc=Adp8EMdkf6NxFukgdrg-mel_GvSQgkfJYCht_FMngEuZ7bl6zg0loLUVcSAp6efUlP8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PyR4ZW9uugRm8ECWO7hYnu9Zu8JZoRzUrQkLkqJt3VA&oe=6A09E44C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2tJFhG096UQ7kNvwFh47HF&_nc_oc=Adqw60-InwD1RJnfCdhFYY_lFpoAwRSTWmh1nP5aQnACWoRVQspTKOlzabtzLPXn9Ds&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nUTl7Dv6HI64pFf2cadqUZzURpuiH9FIgWaRmr2fCWw&oe=6A09C4B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48sP7EVvB28Q7kNvwGyCb7G&_nc_oc=Adrav2RHv4_H1J06_QQqKeupyz-wqUXUZ7BndTJNsAmCYqwyhNE69_76PsU7L-LjBsY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z_TMxCnA6T-ZtHVV3ts6SZPSny6-dyDkrXBLJKncpJg&oe=6A09C8CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHvAEEAKCFwQ7kNvwH9oAPD&_nc_oc=AdqM7qdY6TilAaiMeKXgeH3zAD4jpkuLeUZqFppW54j58kbbnQ3K0eJH3zcsQuCP0y0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47nQ9tv9ygErRv2MbRqSI287T2
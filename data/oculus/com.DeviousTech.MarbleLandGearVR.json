_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRWTkCqOljwQ7kNvwEdFH6b&_nc_oc=Adm-raStJU4VyhfxL1Oe8AlN17YQMnqOzBYawdihqjn0fwH2C1l0qcITw_7GAUs1mHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCyk3DQAD2yNv6YxbMa-GYO08gYg1v7vQ1FQ-ajx6eyg&oe=699ED72C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKAC-eaEgqgQ7kNvwHeao3W&_nc_oc=Adm0ivNlYpnNcHHR0_td3DXIbE_5h-7PIRVElREgxgUfoxOdCPZ4Uo6-hp475z0lBKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvsWGZe7qnSd98Oo6KSj7hHPyVDBD40_BqWDS3DJkpS7w&oe=699EE28C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_NxlUv62_EQ7kNvwE1JnFJ&_nc_oc=AdlOvwe5tabkXXdSv8FxzUCfKJLr6b9n_0QgMBznr930nX9JBWofE3E0WLI3kGN5M2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsYG-AplF7J8eM6dCJclQNomSfk7MKaD7vyIBq4O7gOnw&oe=699EFB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmc1XAqEk3kQ7kNvwFxTcgQ&_nc_oc=Adk_I3u7vAMrvhrXTmQ9p0WZ_aEtWTEbmJZLcwMHmyynaqaMlNgeV8RnUWsgk_fIXNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftyI4wn2F-xlVU-hL22ElNb0n1U69rLVHDNKyWr10rI6g&oe=699EFF4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWYe7OQlrfwQ7kNvwGlZo5H&_nc_oc=AdlrGFYh6Plvyzd11nFa98c3xnWz6GRZi4gn6Oq0Wo-x42x7tBX8OVg7CjZiScZJlsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvnuE-A5pelftJ-Av-NINwDxwOPSp0Monz9rq9edVz31A&oe=699EF355"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null
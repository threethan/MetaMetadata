5199708135", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB6Oaj3UaAoQ7kNvwGIhx_Z&_nc_oc=AdowU6G8K079PU0Wj4s5WYOyrRroDDYsWcfaxKl31mvdy1k4HsOUHCAdIC9xp6jkO8w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZCULmp0ayvEG2CSu3dcOQhWYKr2quIcE8cx_7O3LhCg&oe=69C7B5AC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXljNduxqYgQ7kNvwHajN0f&_nc_oc=AdrTlpi-4GcCKet9cOpHQO_8pGLn-qMV6TKD-COr0I3r7SmUKf8fkvz3HwWpR8AC1Mc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ1UR3NFLtasM2ToWaV5leNjkiAl0yYybhnlp-_g59IQ&oe=69C7C10C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9cDkSvEV_UQ7kNvwFQwxZn&_nc_oc=AdpV5KTkMxXcIN-7KrcCmWdylIsWCmkl2TYbpHZMf9zRl2xU6R9GAW6HFP22xec9fd8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSIH65verk41j9LJ04BwSZfUd3Lt2sS05B1vBqhGR3Eg&oe=69C7D9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0PZVV-wxpQQ7kNvwGvtU57&_nc_oc=AdrMTIxz0pT_ryA5RoJwlc9soy0Y7PYqIyPEDCDU8aK2ni5HHSx72jAKrcIpoHorFvs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwb7_ak6LvM_YXNE8eSItpD19TEApaurCdWO1JhEbAxDA&oe=69C7DDCF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeRyTwuXwCMQ7kNvwEAaem4&_nc_oc=AdrNbfSWo7u1nzo7loMllONl_uwD9PnNDNHXZJPU460RymSojTlBKYARFccjMkuVvkE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAsdDhJVsTRl-Sps4kYF-KXxL0
5199708135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_BhB2wBuvUQ7kNvwEfM5uO&_nc_oc=AdoLSYWJ7o1cDPNsSiCJHMu5HTwuOo2SR2YHIX5U7meqwGtGTaV4cLW6eOlEQdrzrRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af491gwnNB8eeSOrPzN5VT-0tA1AuY7uFZTtQf9diV8BIA&oe=6A01EFEC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEOPGqNo4MoQ7kNvwH_umoV&_nc_oc=AdpZCuDaO9BVf53nBJHY-CqwB4l8gkoXZ09jhKePEhpi9mdGgJ7k050DrK1M6MaaY04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sj3QLnkrAX7RxKO8uqxuZ5YJ8gXOtiCuaFD8loTeRlw&oe=6A01C30C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGghhgpRs44Q7kNvwGXOk8O&_nc_oc=AdrWPb3WITiMr92KHym9zYsceAL6-Y3I4eGlwewfR_lW7vqqSznsm0tndy8atdgNVwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v02cNU_7ngCrCKq48z2Ej7OltUdca2lLADdCtMFshNA&oe=6A01DBB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdLOpCJNCjMQ7kNvwEyddKK&_nc_oc=Ado3er7CqL_3T9--TYyvr7eZyTeLDucdrga1CUv2lTl32GkZQN37Zq_ux-zwRGtvwTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UEELKI-m9QV0891QiuMewrIWbEZUEXd5-si7mic0rHw&oe=6A01DFCF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jODW9g34l3gQ7kNvwG8fdv-&_nc_oc=Adq8hVFYeOqjBZCVYf0jzZbSGW_WLH94k3YqWfrjfgE-f2-NmfxjWVWApeoyu8PwqwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af635YVKwqpX5eyC-ky65eX75rEn
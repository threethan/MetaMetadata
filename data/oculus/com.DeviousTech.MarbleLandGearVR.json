j6SFicuTRmgRPfdM35Xnq-NatrAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYnY8eE3efeE_0ZtGia8n7ZJ4tQTyR6qFIRqdEof3-0g&oe=6AFC9208"}, {"file_name": "migrated_image.png", "id": "555595021974180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386200_522067164819877_4845161359760949248_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxQRQNlKc5sQ7kNvwH1-pQ0&_nc_oc=Adrew_hh82-F2TcIRpW9sKkgRHT3oQyiT3ShH0GIsPlWSBc3F38IzFPQSqw1KOyfpQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlWf-o6b-hDEOvKtPUyYTYOGIptM_Vz8oIcmt2XyrMHA&oe=6AFC74FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_top
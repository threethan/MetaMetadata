5199708135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_BhB2wBuvUQ7kNvwHpf_hA&_nc_oc=AdpC4OOpQjmKkyHdaQKX5ZTIQFAmvJdLG_xshz5WUehlVdgGov6pEzt_3kypdichLQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rUAZo-bxBi77jv2ht2mJACW3jwoWXr2qI14Oz2FEumQ&oe=69FF4CEC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWImzy3ix4QQ7kNvwHIHw0o&_nc_oc=AdrZTwMjXaIs5NZxBQZPbMQdYKUSA6DqFGSdlUhevkhaCpdgjTMVvMNr6FQQUBaVIpI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AyFuli7o5lHJ7dR27d_R1f4vbqPVqt7CFdXE5HOH2Iw&oe=69FF200C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIHbZJ_X-30Q7kNvwFXFO88&_nc_oc=Adqb47PvkXopDV3t-c4QueTR31yCr8_Qbtjq19JmiTtv6czAvbNQy5wzlz8AlEs7Gxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NymfbjWIrrh2A9WjvLeI3qrmwqK8QjL_SgJExIi51hg&oe=69FF38B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aPK1lKieZIQ7kNvwHD1dXm&_nc_oc=AdphEv45jVUph8v8xnVnS3cy5u3vq5rFdT_xGfZQOJQNFNNtsXCqSJuEtpDJhxYfaDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dECZFT8gGiF-10pXkXnO8e71RlAXRrGK60Zw-iWwlKA&oe=69FF3CCF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL8JCBmVVPsQ7kNvwG1EEhv&_nc_oc=AdqJmfyJuPMU0GYHHkjhyFTSRbhTeSj69GPxmjNt-npRz-GCenr6euZGLDgL1YlE3Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mLakFCdWT-Et0deG0ZF2wG3sZ
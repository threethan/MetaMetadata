CuQTwWnBjcTMdGY8yh7BLtIiqkyBOJ9j9B621C0D8aQ&oe=6A1AFC6C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD4NvkOcgqoQ7kNvwHvst9C&_nc_oc=AdpTqwBYfnj-J4DDarwIIE-6Md9kHNlZ-5BjtXBLu6HdGHozYn6faruHK01nphXkf7o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zgwRYqI4eNJla_d6TdyDHorcVPMdBseFopcn2ZrekZw&oe=6A1B07CC"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpqdnrsT7-8Q7kNvwHZzRI2&_nc_oc=AdpfiN7Qd3SmyM7UT_q-A8RnTKd6yZyLqJ5ArQ1mlvu-7Kbcs9GVYrRXgT0X4qzjtWs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XB9wDiUeMOUgZNSux0tgxkZhNc2Sbp_pIAN3CaYRI0g&oe=6A1AE832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pPVDXud1mEQ7kNvwHoF6Un&_nc_oc=AdoO_02cGMsHXO-4eUT-lHTCZlE-68SQJ2eUQB_fA-LRBwyZ62ZIvJ7IUtjIxNP7lO4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oxhs6dHpMG15Vud5p861MmkcW76k6cIoGO0X4Pzftjg&oe=6A1AEC4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG40t2BF6JwQ7kNvwEbTtut&_nc_oc=AdqdlkZExyM_c1e_eEqtHwebSYN6o_-HOat6c6RQ9yHjozrNrWEDzXvvJM53BNWGOQQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IZ0LMJFXbecY1MYtnJ-WyNZN8Fwebms21OZwMXX3dzA&oe=6A1AE055"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1548873000, "lastRevision": {"nodes": [{"id": "1387707548016095", "release_type": "SCHEDULED", "administration_s
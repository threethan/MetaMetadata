_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRWTkCqOljwQ7kNvwGj096m&_nc_oc=Adna6oqjAkC2aHWgN6DX3gftV4TP4o_s9UXi-txhC3PKVSXFNOHR5iHQMENFopmnvuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuCtsjLMHeK2n05atmDuZId5SuzB7rgWSi_WpB59_1upw&oe=699C342C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeTz4ZmSp9wQ7kNvwHW5a5K&_nc_oc=AdngeVkBx3Rz8RvJUSJVf_kWb-dZn_ufqh6cE1n60496H6cN2IiP9eoK_JLzQTfqo_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuK8mvYjJ97gvP5rgmO0sBvoh4cblxJIMM6AyH3fgLMww&oe=699C3F8C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ynrCfHlpFgQ7kNvwFDPZuo&_nc_oc=AdkH2-vVfUjXdrholH24r9qzJvNaHxS4rCdIn2NnP219KeMQ9NQXydsiSmj4QUOumxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu4tZYliPD0QG7gbWJN45FvHd2gMqriYO47p7B02yf3cw&oe=699C5832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAXFKD_GGakQ7kNvwEwepeu&_nc_oc=AdnHifrsMUtSoYhXpg0SXPXE6W13hBdMxqEopITphMH9uRGvav1k4u8Czh1ObnQD4vM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsj7QbFSf8C4y9xqCGXjAK559WWtQ9rjIjpIklLa18CKg&oe=699C5C4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZzEMjlcxRgQ7kNvwFr765T&_nc_oc=AdkTHR3fNVNG5-igr20_AmDxoXmS901vdx3aq8ardqsdcVqinizCrhBHCR9Jp9ed2wg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsgg6o0B2mQuiFdsnjLt1pTfOWrHujdqXfknWoejsYvUQ&oe=699C5055"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null
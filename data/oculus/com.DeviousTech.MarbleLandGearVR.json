_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eUMDai4QK0Q7kNvwE9zMLt&_nc_oc=Adr4bm-8zIWPHn1INwQJfZQr29sm3aFnK4Kq018H9Y1ZqH83Z8q8TwsqCjYjDIB5tYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0COYAxIPDpmKSus3JZ-nYGFS2_l0cUnJjhGwyDG7NMsA&oe=69F0CC6C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoQRBUQjXCIQ7kNvwFfznSs&_nc_oc=AdoWLnLF-g2RNg6V11Ls-LriSJD0JVzMMCJDS8X0v5nFrzHZ1gkh8nRTG5yUDEBEPuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2SX01EDwYMQQr4uulaDZF7K2bwg8ML3rR1QZZ4RAQhlQ&oe=69F09F8C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orlWZ0S9WbYQ7kNvwHzkFZv&_nc_oc=Adp8eHVck_UQhFckBVbpBLk3enVIyizOZ93XBpaxWb_Kl-thV3I8jmonVHDskDj8LxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3MM3puAnc2FwOqlrG3_zmvb9tv_eDEH4fIqw0QOiXQrw&oe=69F0B832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJY0XHylc0kQ7kNvwFm4E09&_nc_oc=Adr91g-ZpzAdrxbLReyaGxQBzMlAnweWKpMqEIGvlHQo9TC13Cbz7tFo288sqnAIS8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1J7dX1yFQN45OuZVgWV9xHSV54zzVmiRk4Ef93Fb-gqA&oe=69F0BC4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_oPw1aHQosQ7kNvwHKSDfp&_nc_oc=AdoQarY7qfOMnE1D_Dwzhr4MQmwuLHMPfdK1Fb2cNlWFmgh8ULt4uQf4RU_6NSZMPzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0koIq2tQrtezthp_If1zlQhDM3kwhqDnjLSrh_sPbQfQ&oe=69F0B055"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null
5199708135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpKOs10CeJEQ7kNvwH9EHgV&_nc_oc=Adoh92_fpbtsPrvOT7A9N4v-zPKCHrDD07dHNmRGOQYHHOgpehA7Vi6M_LZt1A_xUww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LYHMxWae32Nhg8ngfvJsuvtnM6BzughUeN9avtuMFVw&oe=69DA2AAC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4TStB17lUAQ7kNvwFqCSgG&_nc_oc=Adpn-EnTeS6ftkJB46Z14jd-069SsXsgcRaB6IDi-OMue84VZSmaXZuhJ6id46fLrYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w3NVfHDqMYleMo5D_3CuVrhUU60paMlTpslHz7cTfzw&oe=69DA360C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_3zR5hO51wQ7kNvwH-kzKt&_nc_oc=AdqLm9oM2uAXoAnNzvwY7gKlTItPPKQuUT05XbYK8gAVb1dJzwEpBXMmzTa4DFP81bQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ni9gUoqT9MqVWP8M3qk925ArIdmc2e9Swb9YXgYLrYg&oe=69DA4EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxtvFkqn834Q7kNvwFXVImy&_nc_oc=Adpky2MOI842NTMEeYw6_Pcz1FC1HLWGuhYq5uqwbsEZ7u9ePWvioPvtxklD1QA6vvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g2kpERd-AfcyY3YBt2k3RhPwBHdveUQu4a_HBi0fdkA&oe=69DA52CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk_KJcoTiHEQ7kNvwEUSRHP&_nc_oc=AdpL7JmOhWdTPqTgEXgh78wKYox9NQbmv7CcbwLvBrC4x2wskp2S-vzph8gQOq3bRMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qzsRafeyMESViBTqpV-RV0xHD
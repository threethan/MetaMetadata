t-sjc3-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g44EBY1Cu3IQ7kNvwFdojr8&_nc_oc=Adkk_mvCKcHlEubrEnB5IMZXnkKUieW2KCm83eCRjT71Mxh217CoeHegul2n3AgJs5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCoa8AAIL-OGHTnq_f-bZX8PHWjBb1PRErsf5-tqjSTg&oe=69BE7B2C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IX6F4kzBNi8Q7kNvwG-B0E_&_nc_oc=AdkFmFrTBE19K5fQIP3uMg0Bq1kt_2YXUfLdycoZ8GFJBnjEaAKSO9tsMYcvI2VshqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDW5pdZ6AfHiWRNdQwHuoeSjFyKGtItRPayi7hz5jH1A&oe=69BE868C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxmQKDxeEbQQ7kNvwHd7IRO&_nc_oc=Adm75CixxWprJhuoXbSbWKXsiX3zSoE22VMT4Wp_ig0veyg1-rbsFD5DgiW-L4fOi00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgJ5c96MQKTSU2jgX1ez2CGWB1TGYrCqpwU32kf2H4vA&oe=69BE9F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWjhkigrIpwQ7kNvwFyCU56&_nc_oc=Adn_pZ972gfL3VWQd5tVB8TfoxdTDMK95c8707Qrd_ce60wiEcykl4YGPkih7kfZEy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKB1yTH5UsVsF4Jz1lS-O48Ify3lw8VMPm7iAqrVThcA&oe=69BEA34F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7LYAtlQNngQ7kNvwFQbtZ0&_nc_oc=AdksI1A63kn6xcvIu3fo_232UjgIFWzRL1pseGRef2guvVquNRpEYOGWihaMauhf1A4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyYlIP7W79x0jgf6cnbfLkbbmz66bBZhxEz7gW3kS5Qw&oe=69BE9755"}, "is_concept": false, "
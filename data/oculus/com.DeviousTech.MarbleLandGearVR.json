5199708135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnAQanwGzUAQ7kNvwGsV3Oc&_nc_oc=AdosWrwlZIpUMko5_ABH66H8N3A4nAiCw6NxNJGoR7YU1Qde5G7yZ-tih_s3o_eh3xQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MQuQk36IRs7dfaIONbUhZsFlNpg-g2JAAF8dc1QrJTg&oe=69D4E4AC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxhfE_tz6fwQ7kNvwFCuSU4&_nc_oc=AdpAMSr3l6FwmzHXMf7L3Cc0G3O7rPQQyb7zL8jXnf5ze5B0DOeJnzjHseX_2IweO30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ua99iky_kYYSMOScS64o6KpEgxn-SW1yUgfpLAT2fAQ&oe=69D4F00C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U796w_3k6bgQ7kNvwGE0mAm&_nc_oc=Adr1JRdJAPogu9-6KIf9TATerDFpg9iYPehqRToKOeel1AqKaWjPWZGVUMNTqcNtv24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YcOd4OOzsnW22MyTEB67JcAJQgcZwcwpTSIa4wnkDSg&oe=69D508B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQIxiyR9WtcQ7kNvwGkLffX&_nc_oc=Ado__pnmuEbtt5pFWbNkr2sVTm_i3yFK5ty40E-sy9cQwlyIklvNF1qspDGLkrFVRGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fZV4cVkMknUrXokaqLN8tPF0hINrQJZ5pzJ25rWVoPg&oe=69D50CCF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCjzHkmDlQkQ7kNvwEJi2yB&_nc_oc=Ado0yvOhm8o5TaSL77HS8jusEezJPBwHvOt8BTDZY800IUvwkGEbQDWyOLZReG_TYMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36_v6P6CESKJGJW_5QTUpYnWOq
c_BbBSSAPwo9ESSZTJGvTmx3SDsVnV_1IBI7AH0HIJA&oe=6A71FF6C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2x2vAW-dCYQ7kNvwFDiInQ&_nc_oc=AdqlGqOuPMtz4DBzFhFB8iDEAXAPYmjysd4uMpgUF0B7FcPEcCZxdStFkLmsFAYvwDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUTaLxNW7bLfe8x0jACRkY9YidHK8iJTbo_jG8LlsVEA&oe=6A71D28C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1xTPwCrao4Q7kNvwFyHAwm&_nc_oc=Adqviv8CzBJ5JMk6L-5aYZyIaMmNapKgJSOh0RLclyOfah8f2YIqRQ6iZ8bE0_NZPT4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTbf7bEoSI37rzvG-fDCBvB8cpU2bQcMp-uJy3-7inLg&oe=6A71EB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bUE3LveIjEQ7kNvwEpwVaX&_nc_oc=Adrh4WBUIlx4lGwdLtJeO1Z5wENhWKn9KXhJfkmr6cn_dCmt8yTRJwC0x0igUAwlFHM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3oQUQrIUDiZVCdjEOarhphLR_d2xUWStIPO-rSDts_w&oe=6A71EF4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg3TgO0jT_EQ7kNvwG3xGyK&_nc_oc=Adp9-76p6lZDx1D4uk5QwDNTZaSCub2d5AQx9IKyB61emLaNO6ig-LM4MD-ZmwZAZHs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3zA-QtF46lvEZYZYgnM3ND9loWRaTo6Lj6mDXFW0DWw&oe=6A71E355"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1548873000, "lastRevision": {"nodes": [{"id": "1387707548016095", "release_type": "SCHEDULED", "administration_s
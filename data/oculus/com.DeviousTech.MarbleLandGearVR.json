QIxmh5wUvxsj4OVHNizqKZXmxsju59S1QZby9tMgmn0Bg&oe=6AAEA46C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loCGsUHA6FgQ7kNvwERS1uG&_nc_oc=Adqsy9BeN4RoAONfs7VZeAPWDqxIRYBAHohpzvX2plsz3WoR6O1vNtrStt95zGcMhdk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrtxPBNJf9EIigSkO3vqdLeOoyXnv9GRCMl5ef2ZlLuQ&oe=6AAEAFCC"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAuE8uNvhn0Q7kNvwGoE-fv&_nc_oc=Adpg-y-QdhdTo4S3_Ywd60nhZX1y5WPgmfcoG_XBqr8oi12GQYtvrE_HwM0WaG46r_0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeInMr9w31TOjBkGIZO7h06wPe0wwS3FRpmE9ZGCmN9g&oe=6AAE9032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egPOnlFMx-8Q7kNvwEf24BV&_nc_oc=AdqWZIdTiQl3v9Rm8XOoc6K4aRiaFPnjGZGUiXOdGkqtk1P1DMWfHGFOFinknpbusJ0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5o6hxHKivlQ7MBCoHSDBmcziQBZ-622lQoReEPakfMw&oe=6AAE944F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyJAaUEnZQcQ7kNvwG9bqHe&_nc_oc=AdrsIUzbzYbYBykucteyqVARx1BQr-wnAKerhSAwxRXvGrCJZLUfu_IG7kybL7lnZwo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILSPnnHE-yPI2OavSYSQSTvT04NnLnXysuww3rfK0tng&oe=6AAE8855"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1548873000, "lastRevision": {"nodes": [{"id": "1387707548016095", "release_type": "SCHEDULED", "administration
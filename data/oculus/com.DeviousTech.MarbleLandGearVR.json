5199708135", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va_RRP25TJsQ7kNvwF5VNq7&_nc_oc=Adp05xEb4TGzK9iuM0zO8T8zZaIp-JllovvSeKEb-QQrRNGVMPUE8qWiCRxOE1_DNwU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af289tm108FpmU5kJZ5_VLSNAa3Y11e16yXSTtYIHLPeDg&oe=69E6406C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyunta7DB5gQ7kNvwF6Xdjn&_nc_oc=Adq0pMUUdWAAOATf_HLVZLvGt3MKUDrVah-VVMqAaUiwqXqxdgTkaNqdtF3znxcajY0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uSQQvVhH__RcK5vkHHHaxfJ_GJP3NSl8-ApwMVfG-PQ&oe=69E6138C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPd4YPmTWWEQ7kNvwHKMymv&_nc_oc=AdpqA3LWyJ5mGlqAogSbIYk3mJP_5TlpE-MnGFdFZtYnDwI-EJ15xKB8ozQfNGkjoY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2awnbNzVWg-TYOmRWt45mRXn78HiTPXEQol78kooqbgg&oe=69E62C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkqylG1YSN8Q7kNvwGWSkH_&_nc_oc=AdqDvSjKrCdumx7FVbkwMQWgXOjWhqUMituVriXhe6s2Zk5xg-LOpClC_1PnQm-PGwk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fPfhixwoenNtZwU4OpNBgcuWsaF0uYFU2OH-K--rSxQ&oe=69E6304F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAqkXYhQma4Q7kNvwF_7vBB&_nc_oc=AdqCXVU_57L4NipNWPBVpU-SA-VQMSNPF-1YkRNuElgwRBFfHAI7CWtabKohX5XV4Fo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qoe5LGHH-2uIL5RnrfKzfTr9m
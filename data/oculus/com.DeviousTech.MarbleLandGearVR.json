pEg8yBMIaxMenYRWsCOyfzqrYT4D_euY9eiSAw8umOg&oe=6A15B66C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf6NaZ93_vUQ7kNvwHu_yIH&_nc_oc=AdouC_m-rHfKz5PHvJNxUFsP5o1I_Oh97UCngFM-p9W-qwNlu4xVXSH4WjVsoPGHTKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lAL8CfGJf_oJXINq7o_f-5OhVapzH9Lt-wGHPANDLEw&oe=6A15C1CC"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmhMOZWj9BsQ7kNvwEA1kKQ&_nc_oc=AdrYhqIA0cKtu3xXrTNUUOzn_Bld9LG43L0K-EYy9kTLf117TDDDdwkFRYfEDqDo4Pw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47tZpKBhMwVB20FKPtbKBSuCjq_PiXz7gYpa8NOYytdw&oe=6A15A232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7uc_ILWVWMQ7kNvwFcl3aJ&_nc_oc=Ado-uscO-YR2qBYs4i0DZImzUg4yg9qxf3noZ4Q9Fr1Y1MMuQtmnKiLMhgU-0-b4KD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pPoVuxdsrBPXV1q9xmmR8GfWExdFPpvzG78DfLni3jw&oe=6A15A64F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5HGF-dMJdMQ7kNvwG0ltC0&_nc_oc=AdpeO7DSkFYg1s__S-DR-l6i9IjgESqrcVDglkyDaT7EN-w2uU8osHAUNEyS7w0_YxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JuhappxlWm4noCJLr4He8UuglHRRVELwnEmtvkMgQzA&oe=6A159A55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1548873000, "lastRevision": {"nodes": [{"id": "1387707548016095", "release_type": "SCHEDULED", "administration_s
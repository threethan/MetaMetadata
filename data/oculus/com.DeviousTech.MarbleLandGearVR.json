Fr1qwX7oAHSe0WdTw5o7Je6iNpydJ619jdVhv1-I3WA&oe=6A26D9EC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OEI7sHIDagQ7kNvwEnt8TI&_nc_oc=AdrKqG5LYPfdkPs97Mbo7ff5GaD4tViMijiFi4ehcT8mjE5EoOVTX9EIhb5Qr5uBrVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88GrYA4EFk4VgI91l5ZLAOelgZc0hYruUgHvyluT1guQ&oe=6A26E54C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kE362jZQ3MQ7kNvwEhN0D6&_nc_oc=Adqst67wsUiqBUpJKJKTojxmK7LeT7MSDLS1QtfenxyVHZ8o07RBBzVPFpTtxs96org&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aDuOrPpUCBDESR1TxUm-Rm76DeSnraGP4ss6PAoPXgA&oe=6A26C5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mqykdZycH0Q7kNvwFA3JPq&_nc_oc=AdpSSI5Xk8uYBfEZpnio4ogg59RG5JHlZ_G9UyH4C6My52BG7ejg5PK6Lzg5-we0w8E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xuVBG3fgaGbYsfNqQ-zwoU09IS8WoEctBKzvHH_nKqw&oe=6A26C9CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjDH75SKU6MQ7kNvwEialha&_nc_oc=AdpSMqzhZP8EMFBbgOHPgYZdTgRLDxfZXP4mCCaMj5w_VCg-gXBWhZXTVRZjiRanDm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Wz41eB0L0K4vhA-AeFIMESYjamhqrQaup1vxsvMEw9Q&oe=6A26BDD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1548873000, "lastRevision": {"nodes": [{"id": "1387707548016095", "release_type": "SCHEDULED", "administration_s
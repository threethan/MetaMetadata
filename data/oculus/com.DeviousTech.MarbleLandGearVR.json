_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oR5j1d3VaqwQ7kNvwHO4gDz&_nc_oc=AdkEytWShc0hZIHOpb07fzTUhimaxejYW0tSR897aj1epB0upDzUl8Gez1VBmesU9fk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuYGBZqNNokZ4JtVPzXdg-98gZuTm4Q_l5j-I_7dvUPjw&oe=69983FAC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZti6P8XrO8Q7kNvwESBgaq&_nc_oc=AdlflrPu1WgVu1qeHxmNB0oF-627K_oKJTojEaGFq33jyS_IqGeMON923Nw_ilhbhUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfthJ1AjdtfZ-248z_VdZSTG1uwywvxCxZ7YrsS_zfnvLQ&oe=69984B0C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7fTeqpJr1oQ7kNvwHX3NEM&_nc_oc=AdnH7TfdPFWWGmHib4hwlSSTSOD9MastQHOm3dloGuqyOjCe9Avm079l25frUMPWMWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuf8dFIWfqsipy1U7troTMoNGF7F1cFEO-8Op39PBD8tQ&oe=699863B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0Pmg1O80tMQ7kNvwFWHudy&_nc_oc=AdkUnplEnTOUIsDwdJRmc6shF0UgCdILHEIgucMqLICsEhz0jyjYElf48bQnH4xQW0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuX1pMSY7ad_WfKMBeExs47vtTO5-eTVojqizKeyNlZBg&oe=699867CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdAOHMXq5b0Q7kNvwEkacbM&_nc_oc=AdnNk3c5pyUj2_yAHW-zNND6LxNp21dL72Uz1T-LZRAJvAChsLvrzxQwKzLpzlDzh30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsgRSrTZQs8fP-1k3nuMq-a6nBtfyAzhzboRv682miU4g&oe=69985BD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null
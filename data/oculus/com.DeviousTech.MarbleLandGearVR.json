5199708135", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExyB65hjg0AQ7kNvwHXB9Ue&_nc_oc=Adp36_xUaAEBM7TtEPdSaexGf7oLCOhoCTcWbhD3lKveLgH3qnhcg32M-9NhC9nTaAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t3AuJmkuAlqZVYt9kL0yOVq-gWlEkGTABbC2Gcmj21A&oe=69FDFB6C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWImzy3ix4QQ7kNvwHBjqAk&_nc_oc=AdrB5P-5W4Fdcbza0Yz5T2XeLzAbTXB6cPnsUziglvuyQDeaqHiL0gay4aVqijL9eXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49nmJSUYvteRCaFQ7GlWrpFpXJO7wClvq_disRdoTOWQ&oe=69FDCE8C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIHbZJ_X-30Q7kNvwHqY0XP&_nc_oc=AdrEeshe_rZGFf9VZXr71ol2VXEQDE8nVKDnT8MN9EzZ1HGithVQZznnUzPmLreo0Os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66_fF2jQL2GlQoqfQfsUw9rX0bzVx2tnBAy3J6bCTaHw&oe=69FDE732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aPK1lKieZIQ7kNvwFjEQmJ&_nc_oc=AdpTToviFUum_nhdzRO5RuU00xR8tZdJTdf6LtYOnX65Gwu0WA06wuICOSe3g-TSVOY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yhKXIWWnYJ08q7VzwtMwCf_AK4ffKagPUcRQ3Ne0sCQ&oe=69FDEB4F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL8JCBmVVPsQ7kNvwGNq4U3&_nc_oc=Ado7yg9veq1hcMrwpaf0aXAjtbA4nXIgutZAC_By3y2-F5g59sxprhcGwWXbQX07VlE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yxXwjWAq2Gi04lVwsYTLksfKF
5199708135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYbz11cBzRgQ7kNvwFyBeHS&_nc_oc=AdrDY4ec3ZDNA_j7W69QdqM_d5Ji25xhyb1Tw1NJ7CNMJTqrNiBfzhoaY_AGvZbk2CQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ8j086IRubNOnAetA40_s22US7ObOxSp-itSTenXrfw&oe=69CF9EAC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eotnh3Tf2W4Q7kNvwHZrAFH&_nc_oc=AdrmmCVhm4RnNe-XJCmSXizNpgHTu0xDLI8OA2wiAmo1reVXdMiZZrFcDR2Jxpe00PQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwYlVYF-GlQB7MLZvQX8whF90Ekx8f3ZEqRNl6zX5sKw&oe=69CFAA0C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40clu89_KeQQ7kNvwHubwfa&_nc_oc=AdoJUZ4F8Rk47h0ftj-ldwQoA2zLvQvyuPg_cPwJPel6UbOzXPK7aHW_L1FLOkiXx3A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxl4h8KbKMQBrwjPm9h2egGQvxC5jsL-gGjoBVz3UlKgw&oe=69CFC2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6liMoPr1nmIQ7kNvwG0KYFl&_nc_oc=AdqE1XgffaugsQuyJO6GGhSXyHLgeJwc8NU8JxQ_O7YNV4q_qCZd4v-N3fP0zTmxmMU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQuxnptWUqD8NW_prqzeH7Yu-dHqLTL3xwW_4AIkfM6w&oe=69CFC6CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABzQ9eohyTEQ7kNvwFPcaxf&_nc_oc=AdoJBh2Oydv4dYR1j2zwldwT0zWAHUbGVFl7TuORULXyj8-X_wSmybIX1dTQiO4kN2A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhGt3pfExVoiNQl5sN-0aAmA1l
QLtTsd_8jQnrMje_-6awy0ZP7BmmvgOIKW0K7HwqpjQIQ&oe=6AA4186C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-O0zTCOF4UQ7kNvwF1ppme&_nc_oc=AdqJWgH0aB7yKfC6PscsItMsUajsOvYy7iATwI87aeQbDtVo3s-KnZPgn271spr_NsM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW9lRjWYLeb-6Bc-KkmXCkOR8oqVfETIgU7uT7HyE_vw&oe=6AA423CC"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtlxuM5EM7kQ7kNvwEBf4sx&_nc_oc=AdoASAWw__ALHWE5hnhDrUenTYH4Vg-7yVsGjCCr_K97QD01zvmfbmBo__U9fGxxOdc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII-Pjxs3Aj7JerAZLUOMNhTqwe0drh1F9CMebCzu4ZYA&oe=6AA40432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FT2lIkU9KW0Q7kNvwFH0toA&_nc_oc=AdryFbXPt87tYgM3rlWl_6kRrXC_cQeRGkmbLlOoArDhaGd-a2ul34J2_A5gfi7xjVk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSJvH0FuQW-edjoU9Fw8yiS0moYODvp-1WRn7M7mDyTA&oe=6AA4084F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6263qrG0eawQ7kNvwHIY8p3&_nc_oc=Adqm1LLqvoBf8T4z0o5COKA0_CmvQcnCAxtJltojTADg-l85HPao6LNC-CYpzhTDtmQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfoRew1-ZeEvdxkzAgbd54ElMov_lIIm8C8h_qeI3KeA&oe=6AA3FC55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marble Land", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1548873000, "lastRevision": {"nodes": [{"id": "1387707548016095", "release_type": "SCHEDULED", "administration
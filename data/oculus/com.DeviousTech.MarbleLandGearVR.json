5199708135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEkBk_RC-KsQ7kNvwFqEA0b&_nc_oc=AdpM56eiQdBtLyWsewLz2czywhyYqWbu_vVqYdwjegEGoYtuH2sr7CbdHMBTN2S_OQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25sReGpM7qisL8jJVkbPAyOGpxJ2saEpzMtrNnXjNE7A&oe=69F8B56C"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPpTNWyTgfsQ7kNvwHAxwch&_nc_oc=AdoQ9u7u0g_Jhu-auMm4ID1eZ9a3le94dPBbeUZo-6-AWSAbZNtr1CgN2y27XNipYnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ffjploSGYLfljgAqr1N_i9yJSHwm6oVnzThjmL-b0Zw&oe=69F8C0CC"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CcyezC4Z1cQ7kNvwGZAFtB&_nc_oc=AdpWBZQS-WEjckCLqTnUMy4KhTk-Uqb1l0hLrdi6q1E2g-XfmHDhftaLtyjcFtux0Ns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1g8qdh2h8P00YwzRDIBM7S8GlP1qdPu9vdeVAIvhKIJg&oe=69F8A132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ScdWnw0hQMQ7kNvwHn4fe2&_nc_oc=Adpjoy0YXbG7Q_5RpYHrpNOBYT9-9K0FwepI8Crag1JF0gg09nCWAxLPLSNWrTxcEbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RcRa4VqNZt7XaKi33zgAhZKjj-DcOx-RPfx4mj6R8YQ&oe=69F8A54F"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VwCHBj60sMQ7kNvwGupDDj&_nc_oc=Adp7R1ErwDy5aQk94x011FJpjrRefZTeNwRvk0vFmrhu-ticwzfC6C9oQKU8YCc2OVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-uOx3bSypPHVaGFmwm618wnBF
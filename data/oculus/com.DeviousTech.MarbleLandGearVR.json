5199708135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974576_233518667533022_7420821928270626816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmpg87Zxl6IQ7kNvwFlt5xI&_nc_oc=AdpM9IB2cJ_Ei7glzhOQorDooqYclFthJW_xPUICVHUFYmFnxs8xJNzFUXru4k9BoHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WemY_Ul1c0f-9P_HAmQCf0yzi44NmgrgsbrdaAUWhMQ&oe=69EC9FAC"}, {"file_name": "migrated_image.png", "id": "498007037741388", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974811_230735844546921_522544528893149184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMaItSksZRcQ7kNvwF4qDfv&_nc_oc=AdrKLgOVTyo-o8RKnsRmzxYRl8EZsy67dwvyPBVt650OzaOpEBTf_yt17bOAUIWtsVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XvbK8McP9sWBLEEg-YiaFv_xYeBCaUSCxPG3p4seL9g&oe=69ECAB0C"}, {"file_name": "migrated_image.png", "id": "1053300288375358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974466_545791089248181_5154468179816218624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKnjERz69pYQ7kNvwH1QdSC&_nc_oc=Adori43MOQysQRHYjOODnPU4HDdAuN1_nfZLjzZ0CukrVnseWDHfhyKBKkZ-6Urla04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rUvRKZhDcLRKmL5T3XDf_AVgkDJF_udYRFiZiQBQrQA&oe=69ECC3B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/wbrxIT", "id": "302917347084383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_302917350417716_8523960999525482496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h48WcO43uY0Q7kNvwGYkvES&_nc_oc=Adq_UpTbwyXXXsJF1YL861UZKnI2JBQXBI9jCoXmAkbCYh92Q8NWYlK0FJ7sVbaS1N0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d_wIixXjhI52S-T8EcJrCFgeK4JUa8SKRjt3dEYLngQ&oe=69ECC7CF"}, "display_name": "Marble Land", "keywords": ["puzzle", "physics", "casual"], "long_description": "Marble Land is a physics-based puzzle game that was designed primarily for VR. The purpose of the game is to guide a rolling marble on the correct path to its target destination by changing the configuration of the elements in the level. The game contains 45 levels of increasing difficulty, split across three different environments: the desert, the cave and the mountain. There is no time limit on the puzzles and you can try as many different approaches as you like in order to find the solution. Marble Land offers an immersive and comfortable experience that doesn\u2019t induce any VR motion sickness.", "short_description": "Marble Land is a physics-based VR puzzle game. The objective is to guide a marble into a designated target area by using various contraptions scattered across the level."}]}, "developer_name": "Devious Technologies", "developer_privacy_policy_url": "http://devioustech.com/privacy.html", "developer_terms_of_service_url": "http://devioustech.com/tos.html", "publisher_name": "Devious Technologies", "support_website_url": null, "website_url": "http://devioustech.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477935917077986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162737_183079075575742_4322977354717593600_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xsAJHA-6fYQ7kNvwHPE5pJ&_nc_oc=AdqpFQOdrMiIl-D79qM3EijbUEy4vPH39rkodP-WIRcC04SzSXmPi1POtBz1GWOqDkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gtrbkJKme1vbwH3otuvlfNjl0
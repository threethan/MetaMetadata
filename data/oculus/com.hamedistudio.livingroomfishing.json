c_ss=7f20f&oh=00_AQQ82PcXf7eUxr_LnHk861-EnJ4JsooAYbxJr-q2hiDOOQ&oe=6B09CA64"}, {"file_name": "screenshot (4).png", "id": "1354237783458977", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_1354237786792310_6691763375231912149_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZyUEP1n9ugQ7kNvwGIMmny&_nc_oc=AdqQ7UmgO8sZQ4BCwDYMM-DGQ-GUdGAfbU2mUVj-8EUrG8ZzWicC7k32lK6K3fYEFZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShmYHtDT96itjMsO9d5Hq5h3ws34fdyXYaKoenmfuJ4A&oe=6B09A973"}, {"file_name": "screenshot (3).png", "id": "1050951681327768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_1050951684661101_5139761057853529681_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f1Aw0L6MGkQ7kNvwGbDMGD&_nc_oc=AdpYhUfWmUZFtF7yYsCCNRhRrmgPqB4KMjJ1-g8wJuVYFOKH7f_FXomGxZqTyQOB98k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW4V01IUwq5v9PrMySiM179vQ4gI5hNEF4jyEG4IH43Q&oe=6B09B90B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Living Room Fishing", "keywords": ["fishing", "mixedreality", "cozy", "sport"], "long_description": "Your living room just froze over.\n\nLook down \u2014 the floor of your real room is now a sheet of ice. Grab a rock, smash a hole through it, drop your line, and pull up your catch, all without leaving your couch. This is ice fishing brought into your actual home through mixed reality.\n\nUnlike fishing games that sit you on a distant lake, here the lake comes to you. Your real furniture, your real walls, your real fireplace glowing on the TV \u2014 and a frozen fishing hole cracked open in the middle of it all.\n\nWhat you'll do:\n\nBreak through the ice on your own floor to open a fishing hole\nFeel every bite, tug, and reel as fish fight your line\nWatch fish swim beneath the ice before they strike\nPull up different species and build your catch\nRoast your catch over a cozy fire, right in your living room\n\nMade for Mixed Reality on Meta Quest 3 and Quest 3S. Your room is the game. No teleporting to a lake \u2014 just look down and cast.\n\nCozy, calming, and unlike anything else on Quest. Grab your rod. The ice is waiting.", "short_description": "Ice-fish through your own living room floor. A cozy mixed reality fishing game where your real room freezes over."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1084711267273622"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1010299482117707"}, {"status": "PUBLISHED", "id": "2892841707781140"}, {"status": "PUBLISHED", "id": "1132449482683668"}]}, "baseline_offer": {"id": "1010299482117707"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794835080, "status": "PUBLISHED", "id": "1010299482117707"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1105453821866033", "version": "1.0.2"}, "id": "2289024291895643", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
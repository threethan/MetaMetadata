.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ4da0ExqsgQ7kNvwGKE6n1&_nc_oc=AdpOqzPg2NkxBiHvKngYXC70FXpKBbkzrT6yh6u2nscXZbi6nErqG1_3Y59qnwH2ZyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jSSB7sSckN42bsxj7jfAW2JmSin5YiLWfElhHm02nOA&oe=69DA383B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfl3h6TiEhkQ7kNvwGWIuuM&_nc_oc=Adr4NfUJnS0WRQLU_HP56I-Xd7WGbX7x9Q6tZ5fcx7NL4x3HTjwyhMmGiLHjJSS2KPI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IYyyc-q3gggn8WVdYa0QimB2icplAR0l91A-wDLun1w&oe=69DA447E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R-3wV1CTgMQ7kNvwGXOlfI&_nc_oc=AdpWHSrVCr96hhLZXMhMDrPbJJbRpFLYsGLmaqI048kyTAtGrXwMlASN2fTEYwFMuN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_E9RJWxG-XjmgA9UF5tzwUV2Lvntl_zaDvNwrG7YYlQ&oe=69DA3ED2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDsirCXefGMQ7kNvwELV3Sz&_nc_oc=Adppgc2vcs4z-nNBk2Aq0PW4FalAeNcNqDtzdOLzSF6NzaA8FZmaOH4dh6XuroZYNj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zgBo0aUaJlSmUrhHppaMH4b04AGwpjhOY0pmOWCrIeQ&oe=69DA595B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPr1Xc6yXXgQ7kNvwHV2b60&_nc_oc=AdpMN6DhuX7uqtNcbPc1pzmn0SeD9JtXRRFclSlhA6aEMjTL_KqBtkgUIIa2dq
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAM7NAjCk0MQ7kNvwEIymaR&_nc_oc=Adpw_FDhOTTwg5u3TqRgfcCdni3cbH8FsZyIPzDD5istK4SxTRU-tow0VsWDo5JvS_Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwz2SRZf-uxl_O3lsdKwEX5zxDmS8_4FXxe5ukngV02wA&oe=69C5203B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBjKgPNoI-UQ7kNvwGTGlH-&_nc_oc=AdpOg3cWE4gAgLyEK25xUenIC3fl7FeL2u-WiFopRN_vg4SYuDBW1b3yX4BH4zHCXMI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWr3xSMlUHwl1DV8_WjzCRuUmNXr3-LnJ2hW7A1z17ZQ&oe=69C52C7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BijYXow8_4Q7kNvwHvpSiR&_nc_oc=Adpprpd15dUf7qadsj9GDQ546OE8i4xzW4b_PD8YasqVsXt8IfOUoi1VBAXXmIO6atA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuZM_ewkqDM8IagV-IcgJ4WJFT4k2OQtjmz9dZk1-frw&oe=69C526D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtNyFuzg4FkQ7kNvwGEH4KI&_nc_oc=AdoZoaMzdWR6YtLeZ9wyuCtwd28b5d6pInMIGMvA2-bdmAz3Ep2Ylr5VZGkqBt6QKhg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ9DEOjM6072FuThwNlsC0NEJKOTlvQm4yPBVtvYwhZw&oe=69C5415B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_nRX1eIIIUQ7kNvwEwvkU8&_nc_oc=AdpLZKbSBWqNF8BWy_fen6TzPHD7oS2-EgRII--z1LfNbCZs2hsjfHlnqTTkTo
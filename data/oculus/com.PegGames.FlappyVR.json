.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpuCN4r1llMQ7kNvwG0rOgF&_nc_oc=AdoOUCOnVlcB3eMkooeQWGWQl3Dxjfv0hLgps1OQyN-NglhkoDOEOHO9sXi_FYIDcA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f8zR5nyN5hcyUZp3EmC_3L9QcO8oe-DI6jyXDZb33ag&oe=6A3AADFB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--IeaDce1skQ7kNvwGnl2SK&_nc_oc=AdrJHhRdwF9Qzr4oE1-PpjlPc1Knmozg4dG0G2F5yYPVgB8vbMM8jrP0LdcMGIUllOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aEkKn4u2dA9osDS4TM4MLkwQ5owKhe4zL14_HlR4rKw&oe=6A3ABA3E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWPB7-gWC6wQ7kNvwEbjZQU&_nc_oc=AdobpGmWM7ZRHhcRVDO44G8NrvfW5CAHHm7kjiqMPHFC1yDmxkueYBL4EhidVmM0y4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MSRpE5DrT3SUqlJhoQzwgEnMEoCi3NmlPko7hKRogGw&oe=6A3AB492"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey1-LcukQiYQ7kNvwE6Ba5C&_nc_oc=AdoT9_BZesCepl7E-0AzzGIwPkB1Gc9fqPXAqmbNgmHsilbBRulsg2KQEC3ab-scsQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bni9jVK9gVfBMulosOFgFR0vNwfE7vtzMRSnplLVm_Q&oe=6A3A96DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XOQruxwZ6kQ7kNvwGoIhYz&_nc_oc=AdqVtzDi0xSoKnfnqk2B5am0PPRKtzGBu61y9DUyNtzbIjlv8PTc3IPGt_x-yE
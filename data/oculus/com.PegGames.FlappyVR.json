.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otgAjtL5OEMQ7kNvwFQwaWm&_nc_oc=AdrgL2PDSfZGppaKtIsSQSq5SiIYXd1Uhh4EnWanYg5F0VXqvTOvhxUHev2dcrvU-Ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbBNJ7-i5qRaANh82wf2nfHJdnWSr-HGQFig9aCprKEg&oe=6AB7EC7B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzv3bGntSaMQ7kNvwGi7XEG&_nc_oc=AdrN-y5pKafVKDQPSahDTnmQY7W5lHm0NKhuioFmtLzppiP9HHgIjIT8E1qFgPK_918&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdDejO70A5qOyI3mRXAraZky-LydalvEIkvAbZV9sT8w&oe=6AB7C07E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A48cL1uPiIQ7kNvwEBUH2T&_nc_oc=Adot6LhGeFlp0dRMU7g9Vdc0BWmqTqkKmQijOUtTOGp-pyMHWFs4gm0Ysk_wd6osJOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIhEc5eVhc2UcKVR5DIm6uj_5O63st2zf3xW5-5fj1Pw&oe=6AB7BAD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj7GuhOtcoYQ7kNvwGeNmiC&_nc_oc=AdoA7-5uTZC94W_X5yoLKEwuTGIgACo4qxKcdIcN8dzUiCj0X7-oEuvQd2udQOMjB3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVnPH_YGBwNM0n1SM3JYgnwKDg83WeSuuHsrfaCY1B3w&oe=6AB7D55B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM5mFzzh2j0Q7kNvwE-fNu0&_nc_oc=AdpNgGIi1u-Qyw__X37u7VzdnJ9owe2d87OtIy588qOXywPN67fSJ1gJK-m0kw
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TyiMnRdnjoQ7kNvwFxQauQ&_nc_oc=AdofW9CXSmFnrzhYibl3wub8CAyEky8UZ_0CYQIL7gohooCOzxY77hZHyFDUqDopOMM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fxIxEjpsGuh_wm5K-8eA0NBJ3KS0dsvp6B_ufm3jcwQ&oe=6A2C2D7B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQUNHctn1WYQ7kNvwHK5TAK&_nc_oc=AdpM0QbCSwl5Ku_CUX_swB1XN1gOKRRmQGdYal2iLuPtpFPEqewi3EzPP95SiOQTEK8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-5QI0DzknBbiloUZE14Dn_xYIFiSDieGXGdif1vMFew&oe=6A2C017E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCsgbxtNjZ8Q7kNvwFAI4O7&_nc_oc=AdqKdW1bK9jkvuPMv8xibdjas78xoPaHmc-YBztO-TTfVTCvjgYHPtZYK9p9lWWL8zw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bbkQE85OklCJA4-tff_zSlp9NxfwhVILQxaJCVZ5YzA&oe=6A2C3412"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNHc4JIBg64Q7kNvwGicdDQ&_nc_oc=Adp8ecP37Kk6rnZ9ShZguLhaJuB1nA8IJChZZJnAEaw2umdVw3aoWMPQ2kCaTyPr5OA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_cjBJw5wr6bXtN3czXyTMy9ixjS7wVzS2JGHdb6C5RQ&oe=6A2C165B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHg3VFNS67AQ7kNvwEX3wW-&_nc_oc=AdrCg4ibMFm_grQ4XmCxJVmB2oDPUvcHFPRKSAKHabimWjJaObRNxySdFce7uN
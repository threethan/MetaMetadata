.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff9Hp4Sj8wUQ7kNvwEB3wpW&_nc_oc=AdpfCb013bDmIyBopB3wrxr8PIwIsXJmx5H39rer5SxBMi4fQIJkfLQe2z0ZOWIIkE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vRyBlzwrZggOPu2T6Ez1pI5DiPEf-WpMcP89ksclpaQ&oe=6A21A17B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrmctDgDNHgQ7kNvwHKZppp&_nc_oc=AdoTmb8GeH1BXK9Q3FAMPBWVoHvPxTJDFa6vTEW8bn9n-l-3-EMMjiDojVbqHGtVhzo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MLG6sfwMsb5buy2ryygwjRbwTKw8YyJ0NZWdbVxbpFw&oe=6A21757E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5GnYYN-IAUQ7kNvwFX1JFc&_nc_oc=Ado-ckL8RspWk-XtqvoovPR-qp4-sN4t3rM7KWYo7P6DGjPnEwRC9_1wa9Nt5V3JeYY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NpGAcpp8nGmX8pVxoiir7gubkMAEtDMc7e24BgUi5Sg&oe=6A216FD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEBVe7g-RTsQ7kNvwGfLFh1&_nc_oc=AdoSa8HaHyuvjrF4seUhfFeIHLLf3POUHh7JP-6HaDrxWDDK31ZFdhVgPRgwEkQerHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af919wE1pPtMtDjXt-Ss7jLs85zFKge9BERWfEITvb3PKg&oe=6A218A5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rd1Wi4crRYQ7kNvwGKVKf9&_nc_oc=Adpmhk1O0jZnBo2T06UI_nnO7yZyqpoKLfQO6QRTQsKi_uDX9XvNUxB2rsVGyB
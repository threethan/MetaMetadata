62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRrrfew7BhYQ7kNvwGBBC7j&_nc_oc=AdkTAaUSyNxSkN7IhMJpWqPMluyowJ2NG0c4KHg_zJwhTTfhR417JA60c9-rrQi6Leo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWhygHOnwyo-5We8igWqQOGilbo4uY5ONCiS2UwRmYcA&oe=69B0083B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k75C0zF5K6cQ7kNvwFXBsWd&_nc_oc=AdnJTU92qBLM4DMtFY4Dxkjnqt4WQvz3qRUl82eI3Eh3ysWuA_YwpLzZb5oc6IS8UAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDeKFY61denxRSb6HEPou7sA8fhPXL4kaFBbX_oAdBMg&oe=69B0147E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNNGeJGPgKEQ7kNvwHN8dVh&_nc_oc=AdlVKQQZsV_Jzjge4D989hk0n9o_PVDJgHCU_Nosne9-nPFTy1Wgd8Ztix2hQ2t29cU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYRRnA6s8r_MjpAKtHRPcWXx-b1SuYUheFJSakBjuFow&oe=69B00ED2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro89QxnR0ewQ7kNvwEiLuUJ&_nc_oc=AdlmpTqpbYDBc-HOrV1zVTC2F9zRt-hybeuIQcq2QVPpSl3iBNDSZXKfhAvJ2xZ5fiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2Ew9ac5z19jGBc957FbGMGUGRt9g2wFmOimRhQ2erPA&oe=69B0295B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9Lm24EIbXEQ7kNvwESA0fe&_nc_oc=Adk-2OVHiw0q-N-Cb8Y7eyDw8QzkLru3PiX1rdAbSqxjSXtgHbwL3ZN3hMJVoen48_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.
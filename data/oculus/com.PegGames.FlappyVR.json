62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5dxleYFEwYQ7kNvwEFiJMC&_nc_oc=AdmEpa_BdVBeOdomaxMp5-DNp_Q23y5ojemJWzE74XYnePZCMRlkgz8TGmVP5dj4ppM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyS_50dDFlicj6DgymcSWGfM3U9yfcFq3KuFV9AKqKftg&oe=69BA943B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8xA6t3UcYYQ7kNvwH3rJAm&_nc_oc=Adl6qTMSCJknkgwT2qSzSudH5Twlf-uEge0po2TDWZrJ_qLrhmjKNgorKCThat4Gp_A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlkTctURDloYJTjr1o99ndOVuNWxa4GN7LNC7qV9myMQ&oe=69BAA07E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFuh8CzMwEUQ7kNvwGXKIik&_nc_oc=Adk_sfImZPTbGJWizTRbgURB7veB0g_6yk7ouW481-82m3yqgcs9GzJtH3BXt0_uWH0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyzfrn0klk2DKlW7dt9OCblfTXBUSmj-oyC6uM4_LXKxw&oe=69BA9AD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BkhcHjJu4wQ7kNvwHtUTO3&_nc_oc=AdkJJBS2q0R1sDVU0doq75xFH7cxqWlZoJducqIa4owMz9gdyZ55QeCeWKL3ddYeYu0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzENnwPuUVorBQmdvg8QvIbs6MFJMQNgjqpWbJN8AHSpg&oe=69BAB55B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MByCMTfH3U4Q7kNvwGi26jt&_nc_oc=Adlge-h9qYINxT_OBESLa3eOwkYsopw1gYRaw38XwrFj9or2zUokmJe1deQn9YfpiVY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.
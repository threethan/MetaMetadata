.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSi_5wcacTAQ7kNvwEGXR5a&_nc_oc=Adr5ADogLPThMAlLr5nuEKSpC6jsTt0-nACW4j_Pdab3tl8DsSqpSq6rma6HMK90ii0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBondian1Hnovut-blKHaNFFNWJ6s3Wx1tUcrqC_x4EKw&oe=6A65F73B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrI7u9ovWUMQ7kNvwGYtnaH&_nc_oc=AdqpTRqhmZkkggRALddqckd1T4G0G8ym5pqAYEvQjz4u_IaaPfh2gBfUQ_qsRvU89wg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANaap7olF5St2ObhPLQXuyc26svgWOizYgto52Nh10tg&oe=6A66037E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lD2ksp-hoQ7kNvwF6ISQA&_nc_oc=Adpyc3JS5QX2J1JB4MR8AaOJ1uZ_0g2sIUhYMl5CE7iSo7yaQoMKKKN3xNST0npT8S8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWw1KkFJx6tD6Y6havvg6-Z94uySQ9AwRdWMbpKUPDPw&oe=6A65FDD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57heZQ97JGEQ7kNvwH-Kz1n&_nc_oc=AdrfPdFBTp11AZ-R1Te86wSVfnsmDucLYGqF7RsKOzrQUa-KJFtv6h6rQkxOKibIsK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjTfvvRtE30PcI76j-Woh_BIRYXRdgmHHo53KfsESy5A&oe=6A66185B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPk_GgehZGsQ7kNvwHd2eXX&_nc_oc=Ado73PpF6B3AvzX3Vi6GdAiQWSx4Azu-AWxzuech_baVY9mQQgsPd4_dVg5Cs9
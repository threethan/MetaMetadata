.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdk8F57-bl0Q7kNvwEisijv&_nc_oc=AdrOkn08hhcbQIVoSYwjoU3uv7xAmKITTmn3gH-aKwmUyT6ggz-0UU0-7fdTNpHZib8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT7I3jvtpANHTGHK6zzX6OLLhzuSvZr5AVPCHDJ_5gmg&oe=6ABFD57B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTo7qAKHfzwQ7kNvwHsLlL4&_nc_oc=Adoj2i8VwhbINMrh4KmvKSvAiljRaMUVrEFcNLTHpAEOP3eeqRl-5qlje7rbVgHvDNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHnt48Up3ZiKrVA13TU7YJ7MH39KEpnW8mI_bqObNtug&oe=6ABFA97E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVZvRl4_vkcQ7kNvwH60W0V&_nc_oc=AdqziK6TdQRt3JWLn3q2w9IFVqQgtK3K7d6efXU_mX24B6yRuVumqnm7ha7ejibkoUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAHJwKh0_Dx0WxkVh0V2piexoli9o7Pu9QEI3fBz4cpw&oe=6ABFDC12"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybWsznqdGMwQ7kNvwFgKjV7&_nc_oc=AdoGMF_QisPoVQLdnANckbD6--XvDvC1d3p4V27yNtzvqI-1jkr1NoGXe-7Lceoorlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBqFvJVfwClkUCbKCSYza8xSpgzjMLWXHep21XL1n3Ag&oe=6ABFBE5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgbVj-62crUQ7kNvwFNZVPk&_nc_oc=Adrb6gOazH9CkNGSh-CAXYEnjPx6aF1_OYo637JAubr2hdlnxqv2jLwohitHYg
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzeAj4Aav0QQ7kNvwFYPuJP&_nc_oc=Adr7Mz5LVCf8DAdHV2E0rzZAEBiN54ekhfutyi5P1fe4d44uDtphAUMVA97fhGkzckQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh0ROGFxwrs7Gt4YjshA354U9U6Sg2H0Vwa9ioXQkl-Q&oe=6A6202BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDBoDCrlSHUQ7kNvwFkltZc&_nc_oc=AdpWrAd6boAfRpxJdkA_eW4rR08dB1rxOJk5PE4NEJtlWZw2hfbXWEj1Qk1UtUu1b-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFP2Dk42nWoajoECy6ebZXdFCsYhFyoDp5Am5niMmzBg&oe=6A620EFE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFOJim3uorEQ7kNvwEFUuWb&_nc_oc=AdpiX61wiS6L8U0I1fDJMdmSv-zbBDJRe8k3IRpcmr6RotuQu3AxVi0xvmqt-L8Eq94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBES6LkXhwEYr-WkV704DuqCTsonnIpjeUrM0ACpPrxg&oe=6A620952"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1w-F74QCAIQ7kNvwHGe8VA&_nc_oc=AdpuC3xB140CnwhWPU-L73gJ7MTLVxLCKxpc4XoMpniRbwJwBe-6w4qV21fM3N_iZVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZsRDq9Wet6byff4Ak0XpMlaFOMFtEdcF_X2pxIStmMA&oe=6A6223DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWsaN5zRJX4Q7kNvwE12fgN&_nc_oc=AdrxR72jfXrVmTADq_FvSxP8fxX8jZryRUhliWt6XBts4umjGq7Fqj8w71P1wU
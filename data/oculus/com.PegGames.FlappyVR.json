.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWAEa4S5bOEQ7kNvwHQ9GYb&_nc_oc=AdownikRA6SmNT2nmRXpZn5iixTv8xlkMOeRdI9lymmy38WH3yf64WK10AR7m5LlCag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y1ndXJWJvhT7X2d3PCxxPY0rBOx4ZtWuEo_4p_qdKNg&oe=6A15C3FB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj_yxpYMYygQ7kNvwElKh75&_nc_oc=Adr8lT9kBOFbM0T1Hk6KkYliAYTSSRyYsl3N02r40OQfzBqhHYLjTXJERDJswG2WA5g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gvwU_WaTwJILzKzugwxLv7RqOQGgPXKq1hRQVS3K_gw&oe=6A1597FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWz4Yt7voVoQ7kNvwGMNbFp&_nc_oc=AdobHNfz77AYVbsA_ytHSBOSwII0aD9ch1C5WXuK8ObkNn4_N5eS-4LKeiYDXJIimGw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sXc4AnEqFF9NFwQSoK_ikWoQotWklrMlVUtpLPsL4JA&oe=6A159252"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRlwKuypzEwQ7kNvwHu2rbY&_nc_oc=AdoOSNUk3VPu-S2qx0Zo4ID895hSnNZ8oue08eOmi-lqD-8XuT-yCk07jwRPP0C5bdY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65QlV7jC1Zam-YM9uPO4pu2f3iZo2QaS1S8JyGSZdX-g&oe=6A15ACDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3LT5slM558Q7kNvwFmmWzz&_nc_oc=Adr1IXPOpz27HZilwZqjdMlbIrCm6k0xL7Xwg5hfCm2xglgax7SInFEYkXvBLS
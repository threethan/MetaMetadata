.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRy69ARI1MMQ7kNvwH1GPhH&_nc_oc=AdqCIWWhpBu8rEqEmNrxBQv1ifr_UVt6h2lBGZqZUtjPeC_QIyNAqT_Iuip96UcvzB8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgZoep-JFT8vOk-r2FBvnMtY3J3Kj6wFtnKpkrt9UYcw&oe=6A883E3B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldNQJ4YKTPEQ7kNvwH1bmVE&_nc_oc=Adr_aGhjD0SPdLst0TIXlUeSztwtcEp86_oRN0OdwKdanEGCfPCYXxscpH5ekHFA3aM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3RoP30Mxzdwy6sjWt3po-CMnFhB5VypE4LGvBdVT3Tw&oe=6A884A7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-si8649feY0Q7kNvwETdFkO&_nc_oc=AdpXD6zrqp9ufaUDwyx6GbwP6NjCD1JHmXKTXiuHCKoyFH0rnMX07xGyDeX-wL5Su2E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7kCYo-JxMpk-SOTPnMvUxeQhNITHOS2yg1EEe0u_juQ&oe=6A8844D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9VosLxB5BQQ7kNvwF2tM6y&_nc_oc=AdodUOhkd4wsJ6BWhSWvQiIrW86a2nhj-xs0qwbY0it5pPpFI16wRoSot3_tEjrgnz0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBM8bnfWcQs2BYoCOeZsRYmcMyfidla8B4FZr3lo8yjg&oe=6A88271B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6tKLYoV3NwQ7kNvwETHb7T&_nc_oc=AdoUDAITba0kJW5PnmsCmSK_lE7q8kLSVxDlsPHKB935ULTaMhLA0TqC58XvJE
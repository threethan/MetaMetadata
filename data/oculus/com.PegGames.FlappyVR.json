.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZipCEXi2Bx4Q7kNvwGdxwmz&_nc_oc=Adow-U6pwL_4ylYYQB-mjzcLLTVNadEmwBeYoOvN4ppxovCEfRzrrWMyxNv7c_jqcxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jz5vngWyyzh4BkIjq9ZUksI0y7ZJe3LmlrYfaxiBN2Q&oe=69D4F23B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfnlrSpEFOkQ7kNvwESkJM5&_nc_oc=Adpwo5Ff3HowaBWvrVgp8zEtfycTrdaQFRVsjOrzkYBBEUrAze7lzj_RqWpro9bQTGs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wB52_osDShqOePrIkGlkUrfScV_QD3JUcXySpKl4ppA&oe=69D4FE7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk9InD8Q1Q0Q7kNvwGUF1Gt&_nc_oc=Adrz7izCyVrBMVVUnhh0n-81NjNns8EY7grbSHmV7glA2JTbhZoV0Lgn4qHULOK9TeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x_b2J8f7BGMZdGftJE0ojurMfFwlU_NCp3KLCBGTldg&oe=69D4F8D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhLoBe6N_u4Q7kNvwFDgjyc&_nc_oc=AdoBY0K0q5cz9nnoEa8vH9QhcQofLhNCPfs5gCOJENT6irbD0MiuM69r7p9JgUbHJF4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H4ZMC_hKWkubRxAAmpUIXCWwyLn28kOH2AsnDPNfd2Q&oe=69D5135B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg80WVlgx78Q7kNvwExDM6c&_nc_oc=AdpSe9UQUIkJFQV2TWVj4KCgzkmwXrMU0j_TfOLVazHoNRLAF8mwCaujIL8OCz
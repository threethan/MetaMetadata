.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NehKy1AleJUQ7kNvwGdsIcC&_nc_oc=AdpYO2IyqsKtpt_iClOZRbAke7YFsBftsX55XfwPbH4xz-EUedHt-k5JTQYT2M4PcLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDtyCsA86sr7T-0zHaruoUTRhMbnIKMKjk-4-W1z8zLw&oe=6A9999FB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd-281PPLQ0Q7kNvwHmKfXq&_nc_oc=AdoErdxmFYhBZsnRy274EudmpVMbtxqkRsNkrtHIqRfAW8RNAij0rG3o1AZDJLnm3mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRi_p0kCKLNrZvRxiU54yIDvI9CKFR38oWIAVorY263g&oe=6A996DFE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV0A7VklwtUQ7kNvwH-FYcw&_nc_oc=Adq3BRFr1mDAwQjitEvhbKe82hjszsfFnTGaSYuf0wID7OkVl9Z3eUoZznKgHqpegZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0GIC3lyTU8wairy-Gw-TsZy_ERVeDcAmQ8_CdAUQhjA&oe=6A99A092"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTEv5UEYF_4Q7kNvwGxtrvu&_nc_oc=AdqRyI9wOBv8jlkXFWBBdmoN-HZ1eHKpTxZ64WZgExH1dnSuJwQy7C8T7XEyOo1bLoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5q6xWv21uMsU6Lls9u008YdClNwv-5pbZkSr8ZOlkiQ&oe=6A9982DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z25IR7MCLocQ7kNvwFLHi4U&_nc_oc=Adrc-JymQ6LeYrTSNlXqgktMO61zmzM2GfG1TjEorNe3feTnDk_ruKM9YzPdiL
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDxbFQ9UPP0Q7kNvwHQqFdD&_nc_oc=Adr6wnHjSUmMPAq9WXQIKA4dm1VunTv2q7E_3wwoSdHo2VOfGC_LBhItQk3f2Axb-o0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwGHie2CgB3n3RABB2M611A2-gP9rT1YbVRXgV-we9jA&oe=6A92CA3B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNVCYaarxQ8Q7kNvwEibX9t&_nc_oc=Adr5-9otP4O2zR6tr61VT9V8UB6k5obw6tonUZruOdJlsXU3TwjbRBeeDhunbVKfYH0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8Xse3Oxx_k9qsPi015UTyHDVMTHtDr222m74-o0sLbQ&oe=6A92D67E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gh-iyl5s_YQ7kNvwFCbAyE&_nc_oc=AdqUkH8U1wk-CYz6uW-NGwzVXit3KrSOLTLrnK8r063w8pZBy2ki3GuJFAdq4wnedOA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHykyJfQHo5t_w7TE3sBYPSIRvnurNDoQZ7KR0uD-gxLQ&oe=6A92D0D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTQhdWwYtq4Q7kNvwH1ERjZ&_nc_oc=AdpclYOZdnkRtai1jJne1dGML3c_QVtq6zvWBAJLTLYIhnY-NOLbySD6Rnra5LLtKbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlBHu9Ox_yesUJdspp8h9RSBunM0-hIlXVGtPKJMJiJg&oe=6A92B31B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQgT6N1sbKEQ7kNvwFF4a13&_nc_oc=Adq2WsLUpX0a7-kNAKOD1uHkP7bFQVVGn26b2Rfgf2QzIH4Zph2VlTL6ftLoCo
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pXwWJk8h7EQ7kNvwHFOxVD&_nc_oc=AdrolnryrGbZYRPvJLNqyPK8660yxKleV1SyOwW-gaKQoEqjbS143n_ab3Ie2isK8ls&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmdTeDp2ZQtk_u0bNB_hJxSUIVm4TbYooHlSoosxNLcA&oe=6AE8B3FB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HzRFJKQKYwQ7kNvwEhdhhs&_nc_oc=AdrJ4u-aMn2eMroKOiKiGbR5i54stQVIe8EKRl0-BtV4u82KdMiuyBOcgNJHMAPrJpA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhcgFjBI5B0L74eEng6SjEKUfJ_R05QUOjRV1UY1HaKA&oe=6AE8C03E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FM_42sGVyMQ7kNvwGu3WCM&_nc_oc=AdrQPF-4NZ3jkY6XKJUYHmBbHg0GbYLX6BKsdaQXF1A9rlv5BjJxr_bR0hDIEgYe3Og&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKMxWid5BTUhqWurb5SbzXFP1WAj3cse84yR9qIBHkXQ&oe=6AE8BA92"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1XRA18tJI4Q7kNvwFwna61&_nc_oc=AdoaymzXxWhKdp_cTa2L7j9wyznoHXZr-hStdx8qspbwlM9nXyC0bSC2XSKkn4UCc1Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTO1WUIJGdB5VKbZk7DvTWPkhhsAl0yscQJ2Og-RACEw&oe=6AE89CDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVyrQx3IIo4Q7kNvwH4aolu&_nc_oc=Adrk9K342WIqewOwo9dNJeIFinHWwcroYubRU4h-o266sxqZL5NCwP4mRyuYja
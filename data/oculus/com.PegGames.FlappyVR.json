.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INoQInYJc8gQ7kNvwGLzdCE&_nc_oc=AdqKUB6ImZfvpRVTAb0BtZKWRwZdbPMgRCuMXfmPQ_JwOr6PtvIiJSSdcyHttuk32V4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzR6i9MkzLJaCxSUlrDD5c-qn_H4AA8WvQbbsgu5O15zA&oe=69CA663B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJqzA77q0h4Q7kNvwEZhDid&_nc_oc=Adq_zPvS9rYOEQshV342T17aEVsKb49uwuxIRnqq_k5f84dyrPpSi7YAd77S9tnjFgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afztd-Noe3yKrFMKOscxrLQaxWsEGacSSLbgm_xc0Nvwqw&oe=69CA727E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv7RTilot5IQ7kNvwGpJVhg&_nc_oc=AdqMH88WLNEbBAZAYX3VYiX0YI26jdB_Z24lK8Se69srlT6ZiXGQBx7vhHUNov5gps8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRhUp1cqinDj9Lw_X5X1rEk_KDoUta9HgJBIJinKBdWA&oe=69CA6CD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea8C-4Jm9Y4Q7kNvwFKIZs5&_nc_oc=AdrOZau7r7LKS6xgSyvcUI2gXupmt6bI0oHRx3VukyexUe9Afi10wyGuUaRAThPGjgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCZ83uR7a3HU51nzKWMxQZxURLTXPlXinucT9QRlPoGQ&oe=69CA875B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETAnnPJ2ceUQ7kNvwEaJiU5&_nc_oc=Adqu94Rm4ZLB37rs-FZK2xYQbGtZAIXIrnSm-bF-tadVsOBrc8nImrKe_RsGh2
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRy69ARI1MMQ7kNvwEXFddG&_nc_oc=AdpUG32CIZdGoLEyf65DfQTRja61q_AICKAqiYoyFN480rSdga8myUx7lAaHpqkByeE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGedqWD_cJ2PDJdciskdQx7lRcn8qf8XP_AOglUvBM2zA&oe=6A8AE13B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7WuIxB3YJ8Q7kNvwHjsSfh&_nc_oc=AdqscFDDsYXo2MeYaublgs-R0co2gUQ2X3r9r9fxlGukHS_GJkLsBEIKDXPiAsNsut4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCAnJAddg1U4qVJm3c-ACGpyeNdlz4ZO4yLDUjvRmVFQ&oe=6A8AED7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-si8649feY0Q7kNvwGI2iWe&_nc_oc=Ado7ynUn_vdY8hptiJMjnOe2pmWzuleO8Q8y_FWYB5ZW5bQRgUb9Cm2aY0gK_US44rg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl8EAM4-GGL7LLC8bCR6JmenKhcJNbs6c_zYmrW2R-Jw&oe=6A8AE7D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq0VT7QFnrAQ7kNvwG_8cR5&_nc_oc=AdrdYJuTcTJrFHrasjGmBxBgGKkSHlk5TazZqy5baF4Vk5LOAypQZR5mHeo-JHwjA3c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKnlwDYDzaOnxVjfGI7q68yOdoPdqnoZApprQRmnI-pg&oe=6A8ACA1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axtwM1MgTiIQ7kNvwEjKPJ8&_nc_oc=AdpkfXn_1HbjFngBunPPxX7kybs2OgvFs2aaUkUqdS9j_8S1oasiZsAGSj46FR
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z5mk1F7C9cQ7kNvwHeY6BC&_nc_oc=AdoFz-5oIJ6Y4ruB4OscXCqTYDQa49ehqyA9PZJB6fhjQ6Zwso4BJPb02Brwx3WGF40&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tS7yfoqTQzBtY6HqQkKJMfPwNeS8O0D2cR4DYb9sFrA&oe=69E615BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdZLHH_42gAQ7kNvwHsH8HK&_nc_oc=AdoBcleX7VtVbwOFXo1F4D0HXivvGs8a9RRSXWkUU0ZjtPPQ0OG7wh8_RHWZV_zgPSk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iu29FMqEF6adNLTFFFGcTenJHLXFW-bxmCGFEMUjYvw&oe=69E621FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGHC8jaCXIYQ7kNvwHT4xIh&_nc_oc=AdoZ-GHMEG1X-o_GW3NQkw8HnKVZ7jxDEoMxVVMe0sBkyofji3tyGAZtWU7bkcQ8aXI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af356NbYpWhXDHWKVSuceJ-m2r_j4VWv7UV4F55VZDVGAw&oe=69E61C52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgTRQHPHc_AQ7kNvwGwExln&_nc_oc=AdryNstPRlAIm2qZkKcOUbp4f3mo8tUYMv1aGsFtvGcLygdG5tAz69qdb8g4vw3ErLU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Uc2KYQXH4zp5mqzVJ2rhPAVPX-Bx8Bv_X_wWtA_MGWA&oe=69E636DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DE4Xd7ECwpEQ7kNvwGe7_cn&_nc_oc=AdqPgc9Vxxssav1fZHPR1_OU_IUU_5AX1UDBtszM1cHpWpwEdHvWn-X-gkkoZ2
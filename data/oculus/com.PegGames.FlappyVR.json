.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ecle87VNGhYQ7kNvwH5ytz2&_nc_oc=AdofcHvI1vLD37j8qlP_pO3FfHdl-Anndg6Av2oTxv8nDf-T5ia4yr67zzPr2s3rQpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd_PLAxIOJw4hUnfNlTmz8RmFFm2j1uND0Z6U__URwSA&oe=6A5776BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2-2nuEAfA8Q7kNvwEJuJyw&_nc_oc=AdpDEJZx4rDts9vlNrYQdAkLHKNAsvwwTSuxv_CHOKW2WCN913NPy5uxpvWNEohTquo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmbAdc4X0-9V0N8hH2fvz1lTYvxt9Ao2FFh_3xsa2Wpg&oe=6A5782FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9_KI27I3SwQ7kNvwG3lrfx&_nc_oc=AdoJ0nUgEgRnXwFxuPf6E1EBW7WXOD-nCGoLdmaVk2qmSNW0eIx-LxpMM9ovQy_s7c4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCETJ-pUmz4rLzcaL5CMtDiCzfHtkxN-eb1UjSbFyWz_A&oe=6A577D52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K90sdSl1ERoQ7kNvwH2DYXm&_nc_oc=Adrjgi7pOf-3e85gMLVi4NAuRiJymcANlhywNRvOMbZ6J7AoqqZfv3xPXyPe8ZOr5Ng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBykZqqqX72lQtmzXNAsmq2jGumKB9_QVedW5mb9KTq5g&oe=6A5797DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfS5RDD73ekQ7kNvwHquNdG&_nc_oc=Adr8-0ystqzUAv_qUxhudqrkdHp6Rl0rjH2YCpXKOmgVbUpsSenQTf1R9ELAeE
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dwNjeUtRnAQ7kNvwGx_aF8&_nc_oc=Ado_MJPTdzNiHTn29b83piD0X3LtTaYnAx8BNkLPNIauTmIz4UTwE17pmIzLen5PcDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwPlyiE67SEbxxVoNpmmaHMCOl9jq-W8EKj3xoVYGqkQ&oe=6ACD047B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKA9kjR7k6EQ7kNvwHpIxvF&_nc_oc=AdpiNmVcnX841I6RgNpVK1dEwJLv1je44Ts9l-OQgpj7uzG-tcG_IFZBX_txugPfICA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSDr0ekMWpoJT8DB1XJjMApwiVEV8oSmJi-5EbH11kTA&oe=6ACD10BE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YiYVkWVZe0Q7kNvwEs7UZn&_nc_oc=AdptytWoZAG_ozNLaHh43fmK9S4YXvrogYrDQPUjr3kxDFTT5RashV0VqCYQg3TreBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyQ2ZwFDreAko-8SuzG_aktZ7MOv6OEtPTOjEn6ghPbQ&oe=6ACD0B12"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju5nH2WfU-IQ7kNvwFV19eX&_nc_oc=AdrcQ95Yld5KdDws88Z9dRwDZdb7hM1yrzcm729J41V8XX7TC40kZ1fXTfIh1zaobBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLKB8Dx8MQIAHmJXLlmCTCTcyhVUiyIT5nHlnaz-Tznw&oe=6ACCED5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FemDQ2Myvh8Q7kNvwHGPApG&_nc_oc=AdqMGEt6YYe7H_P309NwquVw9MgHfKeeZYz8DJdBBuFnlamy-C6nFVS6WBWlm2
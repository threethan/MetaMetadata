.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5S5fsYmu3UQ7kNvwHC69Ky&_nc_oc=Adotys1sGnROoV6_HLly1wEJ9vu7sF9GyTSs0BBtRNjD4Y4TRGJJSoWvDpzFJNGuWsM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Fj8zxH6l_Qc-R-AMoeV2OkynuMOFbBpTzV12RusgYQ&oe=6A26E77B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqBIoXTsPiwQ7kNvwEv5H6g&_nc_oc=AdpPlwzxwGuGE10TDC-QfbyXB9qFV7GzUWduJ7Si9AjKNq5MrnnvKaVqMr-UHxQrYnE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Si2uhAsBVtD5d30Enj1LoYdVzkkLtgeNVY8NyqvFd7w&oe=6A26BB7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRHCDV6_e58Q7kNvwHJmFd4&_nc_oc=AdrzUbmptExX5_eEpynNsA22VbM2KzvonOl0ENeRS-ImKSe3XQqVHoccO88-hz_Mq3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U2dqgW5XwDa3WN3ZmLu1k4HPMZ9L_jDWaHtEFx-Lr_g&oe=6A26EE12"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWdF0tpaZIoQ7kNvwFD2SKH&_nc_oc=AdrMdqeettrybvV0UzLTopUpLdNN94bxAH2MkdgQpImdNGJ1D7HvbQTiD6aEaE3bc6E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A-lzyayvtTnqRMs_NsG07com6KTegOd5qgQCr9M5jbQ&oe=6A26D05B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lmMsz89zX8Q7kNvwGIzuUM&_nc_oc=AdpFve-I9ZPmu_5FQI--dji59-B7x5IZEorG2hmUzcyXdXowfzPK8IQ29QNygM
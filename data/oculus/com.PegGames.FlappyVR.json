.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtaLS_uBaD0Q7kNvwH4mzdw&_nc_oc=AdqrOJGKY5TgFuZwuvhqbAN2a7yN7bsYcnb7Z96QbxSIX6IG818nOiOysZKnQkwqafM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2H8dAXLwveBARXXkCEr2xAeR1vzfCW7bwnX_GrggzbZg&oe=69F4963B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dbcwf4buLNAQ7kNvwE935w6&_nc_oc=AdrvEBHKeDN3vMdRlU5gjxMFN3jbG2veTmeyoEfz2dDnGApdGqPYD1UQWfMKVDonKdY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_XL5VRSr-JD9j1UDlXeJRR7o7pvhE10X9clmGezZJxQ&oe=69F4A27E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nt1vhsm9AoQ7kNvwFkW2pB&_nc_oc=AdqUTQuycCK4HpbwJDNpFlOPG7hmhutqFoxY6OX76YOWSgD1_KXoPSj_ym0FhvacquE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2z2zlmKdfXQ1jksLcjYig5gJtYJCVclHTpWdzi8ysW5g&oe=69F49CD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXaZa4xkc68Q7kNvwFXndUJ&_nc_oc=AdrkPsPhhSR1Whwn5OLcE3_9YnpCwhZ942czktiASaBP7JEp3GfzHSEU1jDhQmugCOw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0d7CUh7CZG5rk4oJDdP8IRJAUdFuvjLE4TM02rZZeiZw&oe=69F4B75B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxJHfH3JGU0Q7kNvwHqdelu&_nc_oc=AdotnExDuf78KGEkVXaYbJrAhLoLyUTWwKCDoLJMInpYOR_koeWi_-WzZq3ijP
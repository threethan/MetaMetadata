62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npM41ZmmCAkQ7kNvwEOjsTX&_nc_oc=Adl1E1lhYIJ5QoqB9UL4MVKEMoLz5l_ekjMQlfjP1bErXnTDwwdeEPNGhWjMJhurBsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyVO-TpUTZUk-H098W0ZVFwjzR9VBQ-LJozNuFWk_CzkQ&oe=69AC13BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtoa6mw-SS8Q7kNvwFGhBJn&_nc_oc=Admu_BZOvyTiKoVWDPCvdisCbqxNHlm55aeKFf7Ktau_tZAxpwDH1pnvYQIW8Sc8Osc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyab6BPsuT5L73SZZ_cGhMYK5plDa1-XSOVDGnxq20CCg&oe=69AC1FFE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHj5ELJ7jPkQ7kNvwGWA11l&_nc_oc=AdlYG-F9Br2y49MgicAHn8rZMzL4gyb5pp14qdFPn28asJNuPdB4AnrGgcLR5vq9P4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1LlS0yhmQFRmZA03P4u4im--FEAnUVElP5lMQEQzknw&oe=69AC1A52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id5dkWb4ALIQ7kNvwFdCTK2&_nc_oc=AdlKZHGuSrDfEQTZcWiBd1o4Qz94rxzBQfZ5cR9ro-JgrIQMBIKRZ_-0Fxe4ahCQfYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwB-28OSqjiiqGjq1sPttbMvQhJhs-9IG7ZsqXo84_cxA&oe=69AC34DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0Yu05o2ZocQ7kNvwECk6QR&_nc_oc=AdngX1g_G9ktQlsdWUZYjyl70zlSdXr33UJOrBWPGxyJvEScRP2rAPLNFVjAgdtN7xE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSi_5wcacTAQ7kNvwGBQ-qm&_nc_oc=AdqKHI_Bjdl6zjAN1NFQQdO8kRy6AFHvEIvYFqsi7UEhBX59c-Ud8g41MrWxpN8Odjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTNrfATkm_Pfgvv_di2oAmXygxGUqKApm0IM2BVhRKsQ&oe=6A64A5BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDBoDCrlSHUQ7kNvwH6svaH&_nc_oc=Adrt59UO6pFqIAr851Igqu3LVBQlJsArlwolDLuM5yfMTySwJo79x6EF2do87NEDfQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRa67xYR1PTpoOdWX3hl6EJq60g-Dz5lfu0MDBi9H6zw&oe=6A64B1FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lD2ksp-hoQ7kNvwFaQblu&_nc_oc=AdpOAEE7IAn0FYKRa8oUOnBtj46Fe5k69_5rFqOhP4E1djOp0mo6zmuwQXmjdI9pJT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOPQQ6UEfBwn4Ckv4TGtHmVIW_uHHYf_EVpgjYMKNVUA&oe=6A64AC52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57heZQ97JGEQ7kNvwEvHTGC&_nc_oc=Adqpvdpg6SQF986ENFdKKlbZDi9wUdHgLzbvCi1ufeQXdWdsjnxTs2Zf5sO64V6WKJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfeIuGktksTWr1nItWYS5WcZrn6f1dwH3wPPXMEYivhQ&oe=6A64C6DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWsaN5zRJX4Q7kNvwE8oWqJ&_nc_oc=AdoMEiV5fA_qgEximjdLE-Sfx6Ob-weGmUHHQWyUL41IoDZwlAPWmQKHmbY-T6
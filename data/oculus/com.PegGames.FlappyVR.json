62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIPJm1ZHXMMQ7kNvwHlchYQ&_nc_oc=AdnJNPjRM78Qp2r1GwAQAX5Je8S2qnxYAR1SpY2YOBQuDjTQm7Dj7MTUB1omuHDEJXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd2rL2byyewbOpr2ONk4zkjeb9rOx9ZGLmvW1uYW_LGg&oe=69B54E3B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj-0GDVTDp8Q7kNvwHS0fCT&_nc_oc=Adk1FcmT0tMwklcNPdgnomfS3jUnhL0UNq3SSEy-zr2BG8PbL5dEXY3Woaj7p2wtarc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfypjQN3gvqn_Hwo5bG4drZIhqrrw892N1J95UQnDR9N6g&oe=69B55A7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTRxrShggxMQ7kNvwHiss0x&_nc_oc=Adnl8kFHjjp_talMAkOhwDr0gPPkPmetJunpNW-GdCstH3YlKupvavPnXzkJmXinp4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8M8Pr_pB9UqbTQLnpQPdmds2jmpSBwExgukESfR4QjQ&oe=69B554D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo8qiQQPNGgQ7kNvwFSt54e&_nc_oc=Adnw4kWd47_f0ndOZwiEutdth-yaVFfMJ6Rrye06fNdZohq8qrpLicO6adxwTTSWmTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB_1mDzJE2Q2kClQeKBR84qIy15kRrszA1VhLNKY80QQ&oe=69B56F5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdxwy5SymuoQ7kNvwEFhbC0&_nc_oc=AdmrU9xR14XfMZq2Z1_619kIY2M6FN0cAGdppmVWDRV3F-s7ootnWvKHhHl5PgFdU9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.
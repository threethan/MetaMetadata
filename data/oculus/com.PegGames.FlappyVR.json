.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZS_kQf90jVMQ7kNvwEmCI1x&_nc_oc=Adrso7QhuTownda1wgvp7tLOtWOD4ANIzhu-ZXL8mQ6AvtkQIbE1UOKSl3SDTXBkFIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21ZEQX8-8zUwCD8tNWVggPmOYBZSpZRb7BLn-7zyi2fw&oe=69DF7E3B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JME0I56VFAQ7kNvwHEx2uG&_nc_oc=AdoCanxen2Mmzoa2UctDXyITzDMuOtve5-rz1kG-4Iax0FjXci1wXwvs3MUbobzY-ys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JuphkIAldNJgJHYG_oim2nx9B0YcJEem1Vb_EfA7HDQ&oe=69DF8A7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh50Qd0LjQQQ7kNvwE3MQXi&_nc_oc=AdrrRb6WHDGwHlvl1H_PY9AUGU4TyC6cGlqTCAPxN_zezlre8PW9bSKsDo8y_caxVI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OTxmGaVdJFYONOKwxZfDoF_T23SAZmd94al9XvR05Hg&oe=69DF84D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06uQVX1QYa0Q7kNvwHErMFO&_nc_oc=AdoqDeTbhp19LZm78pPDKMuaBVLyNI7sixmwn5UQRCytFJSxw5S2hbK7hQ5Y6sDDeQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D_RxqDGU0AzaIAOFXV54yzZhL2UyJuIdmA_QXgbg74w&oe=69DF9F5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUcqEF4rf6cQ7kNvwEuZqIF&_nc_oc=AdphaZ_LLY-9kYgs3NENViHc_nyD9Ow3vlnitF_Sq0niq5vywA_Yp1qNlDDZmm
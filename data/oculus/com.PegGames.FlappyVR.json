.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ecle87VNGhYQ7kNvwH5j5_2&_nc_oc=AdpOY4MYt5DlNiq0Xw4CpwAjuXtaPsX4M_2foTwOm7qTQVVzI_2cVXCt5G-EKPxd4B8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAaQ-07zoyBEF3Yw1JwzPl6f4p7t6DDYluhWuCt-57lg&oe=6A56253B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2-2nuEAfA8Q7kNvwF_pe3d&_nc_oc=AdqHuoW-vlmvjJ1i6jgHNy6GXrut990fslC54ffwOA1mMhgC0iCW35PN3BKpoH9Kvwg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJjUMTCvcHxTcVYMHlwMq06D8pi1t-JTxjf2eCJOb5cA&oe=6A56317E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9_KI27I3SwQ7kNvwF1I4kG&_nc_oc=AdrQK0DIvu-_mNBi5uqCSkC0YpS8YMZfTVtdZX2cMjLmXJfCRVdBgXJmgO22EaSgthQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDByk7uK5n-l79HfrIm4k0fRfN1sosv_-CQiMiCF0uz4g&oe=6A562BD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-6tkPKbjEQQ7kNvwHQQcP0&_nc_oc=AdruKUMBWNnG6D0CHFjYOESRjoarB61cCXHEd4Jgt60OtheaF9C8HB1bh7cfeFFXzdQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_n0FjjWz0TpyzhT8vtG-SPyjiJMabNdbZJo8IiRjJ-g&oe=6A56465B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfS5RDD73ekQ7kNvwHn5KI8&_nc_oc=Ado9hUvoeZnIpvs4UJrgi6an9USw2QDyhsHYzQFgO8jOvwco6jdHbA1tEedHtY
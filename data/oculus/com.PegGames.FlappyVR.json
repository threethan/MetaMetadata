.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed1-7jeA7IoQ7kNvwFoMgX2&_nc_oc=AdrQjhs7xEYx6vI8_y9Ev8bpRiKcgXyOLlVqtOvBxGSt71-Sa4NOQG6E5YHBV5nz6gg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPloCUosmd_SJEZk7W53EJwToHhj9Ls-V7yixb0huSsRw&oe=6AC7BE7B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtAVCAK6a1MQ7kNvwEPZmfQ&_nc_oc=AdoqrZkYo5qpVlXz6R8i8YQk4TtNFwpQCFEigWShXlqqRqkDkZ9B4C0EbZ5Nlkk3IWk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBJy-4s5ldw9zO75Gom1pCS8PdKuavieJzGW_tIHDy3Q&oe=6AC7CABE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ualR2MfcynQQ7kNvwHIETJ9&_nc_oc=AdrFBydQ-BdfyUD7k-YP3sq5VdQ_MMjJ6R2BflRfEMfVzDXN5qd4PDUr7eVy-1Doltc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9tdqVGPlCtdY1v0VCfYhh7pTgrIBq_OFoiq27X2eRuw&oe=6AC7C512"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_vF_Y0h8xoQ7kNvwFPUa67&_nc_oc=Adru2NmkC6d1UwVRWTeNUvSS_wmmIfgEVHMm-x-a7qZK2cPGgboUWrAV46BK3didYec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Km_-BzulaOaYluymjoqaCE7J_D7xysoS57s-nbW65g&oe=6AC7A75B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUaf2qcUvBsQ7kNvwGxqH1m&_nc_oc=Adp2i3xyml573LIjqZa1L98oGv21UB12qWfvy6Jbj6k-p7glDqX_XBECP4B_VR
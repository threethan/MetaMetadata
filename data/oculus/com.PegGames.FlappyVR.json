.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNy0DY2TO4kQ7kNvwHZvi3b&_nc_oc=AdrY2j5dpNyE8QMS6g-iqJLJ2agDWhyvUsXrBEg7NBjJewH5oHkZs5kbgC5qVyUQdpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E0a8D1fK8PBeDofU-Ve8fJh8cix3uNm-9bsPb2dkFqg&oe=6A2D7EFB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQUNHctn1WYQ7kNvwFx6ogl&_nc_oc=Adp23-8Yi3moPPQWF2Ff7oIi4goVLR30ZdStJ9IPH3ZIYElmv7hwhuVBn0TQcSscfFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q0X71NUOOTarnZmMU4CZly9lJBFfF1dZX_sxAPiMlng&oe=6A2D52FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxYQ65_tSRUQ7kNvwF6LCsR&_nc_oc=AdoWXMjo9gwAxGHCyqg_j-lEdRpa3KCrEEN3_QSbuviyrl0n0VjhoTiw1TGksidrTn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hpwfy1OniNYmfMOxTivO7Ax2XQyWzXSpFqgCoBMJlvA&oe=6A2D4D52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNHc4JIBg64Q7kNvwHa9krr&_nc_oc=AdomuGHSL5dgBbTe3S9Q_yMS-Wmv_3_F5g4iD6-LFMCI0Q_jcZIx-FQneCmTUdW5u5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yqS7UdBxRXn94ym6NVZtRYuVVCaWjpx1_SxPVuZEALQ&oe=6A2D67DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHg3VFNS67AQ7kNvwH0kzUF&_nc_oc=Adr4533Himin6C5q4oNQIjix-WDuufbQv1gmvh1vGN0EUob3PIeM726t_As8wP
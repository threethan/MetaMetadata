.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0juDkR9WigQ7kNvwHV8E2b&_nc_oc=AdoG0sUXgrqoyi70HrR4eEf_IUneTeDwfO4p0rs4MY0-OqFoaVvutbgd-f9Q4mExE90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zD88DMNfOu87hOhPdbj-z-ndttn4LFoJVuNl-6bdw9A&oe=69D8E6BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfl3h6TiEhkQ7kNvwEeux-4&_nc_oc=AdoetNzynLRyBrUOS13GbB9UwFIbb0tgQ7bECRJNl5kCkSE2dWHb-rwmTnQjRGORiEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dsj_YA47oheYWctj6hGFmtTb4CZBxGsT09PvnuIxyOg&oe=69D8F2FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UfcOstW6OUQ7kNvwFsoxHV&_nc_oc=AdoKY-7iJEqAGlOXdopKXsPnrKIetv5bN9zFpzNbZdUCYjf1NCKwFGWJk34cGd87jUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eCt3lWd8t_FzAfCJV1-8z7JCuYBN5mPUgyMIQKci7Zw&oe=69D8ED52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDsirCXefGMQ7kNvwE34VPy&_nc_oc=AdpKdYcR_ufINMlV1RMm_iSyST6WxvEj4dprKRs6np14C9GUva9hxgN0rqgSIhE4TVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AooRSbAZ0ol2N-wMxo2hbLallQjPRnBsqygvwklrMTg&oe=69D907DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPr1Xc6yXXgQ7kNvwGzcMt0&_nc_oc=Ado2d-D3Q4j1CQoEI12qopkLqGTkBmKaCqQjmTGWTId6wLTUpAEamN5wlP2Bl_
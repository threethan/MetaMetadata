.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-VsznXmG6YQ7kNvwGler5V&_nc_oc=AdqRTBQH9oJrjmm8JtoyTyO1DB0yodH0KFuoJAfP5chNiopfZbIZH4dV2U6vKCRFyFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91OhmNw_dqt9BrFWoJ1_ARKHdagmuWOHsQ-KCjyGmkhw&oe=6A47DCFB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaC5ytbMI80Q7kNvwEsi7Ge&_nc_oc=Adp5rL0y9IvAerhuomRhP7AvXT5pXgnwRZSzBmuDQKWTCBUuk106wyG0zBfEJTHFQiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0J8BFKs-SUznWB1qWQvaHCHu8GApOt5buIv-J8xKCgA&oe=6A47B0FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek2XXMVLZXoQ7kNvwEniLzf&_nc_oc=AdqPB82tjSYeJX6mw2nKMJUFoW3OMwUwTnMfcTQW3MtbQI-XfOVUKCwjClhdRy30YLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SBOngwa2Sj1FjtbXsnq3eRHqhHlcxuCoEvnddZZ3W5g&oe=6A47AB52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-AmQ9-D14EQ7kNvwEpTsbI&_nc_oc=AdqbW7u-jRLr_Q-jUT-pt8oHTvLJzDNxlKjzNkqNR8VUay5AhhU3yJyFZIRqKP3n9sw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nQ-Vy5QH7hhVsFrex2XWAbs75u6SbyywEF_TuQtHNYw&oe=6A47C5DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmOM9EEMNJcQ7kNvwH0GU_d&_nc_oc=Adq0NPjkaJWHYTTfbDiZ7zzCqnc2Ll3tNwl6FiOhbtYGtfMPxzxSxCgSCAlMvd
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RziXZth_Z5wQ7kNvwGW42Vz&_nc_oc=Adp9wUpTOTzZdoy-coOKJ514Mus3nzmtsRdYW4q6SJqAbIZSnSck9_5HJnJtrAMD2Xw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4cE9Z6odjtAZSRcz7jw0Veo4AI5vExqKhJQ84N7_wNQ&oe=6A53823B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsxkjLuarekQ7kNvwElYFyt&_nc_oc=AdqjtjMne8KqEUKKldF3vA9PDpFP6-kMhpPRk_fTq0FpMuD-CtV2NruT_Ora3EkFNMA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-2WF8aRSscrprgEUTUeMb5uSXVQMH-u5O83MovoOjeg&oe=6A538E7E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qco8t-HEffQQ7kNvwHau3Hk&_nc_oc=AdpVfOMemHp-L-kFYskIb3kj_xVzYcDZ7KDdgu5eYrKnCKBj34wdQxTM1qgZUZshLFo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL6mIRnsLoBM1KehwqYngLUaUFfYZ01bzhG07P0X-aoQ&oe=6A5388D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-6tkPKbjEQQ7kNvwEMmvmr&_nc_oc=Adriz-e2z1a1N_dAaSziUa6x3k_Gt8cREGv7D35triORT9Rimh6ay1f3R8_FiWapyJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbpHiQHgmPj-ZNHTC_7ZwAneW_KDfBhNAWB7IxE8ePOg&oe=6A53A35B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pddyYgEtwJkQ7kNvwH5-r-z&_nc_oc=AdocBnoQkEEbsAcb3ldm7RAv6Zvsf0avH_N0KryS1X2NsrkniniAOS7jW6SCzY
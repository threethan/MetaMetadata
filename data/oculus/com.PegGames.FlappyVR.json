62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_1XTb3IlvoQ7kNvwH9gVMl&_nc_oc=Adnn7bM_fh3ypG39Xf3R25qdveNpu46X_d_EFU_wmcvNK2ENrGe07FxLsCVYAPArdPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvl0T8sIvnKU3h4uPCycBhBt4rslU6SK6YWnZyPbp0SGA&oe=69A970BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIgGz0VItgIQ7kNvwHkjkIa&_nc_oc=Adlvao_Jxl_5xP2uyL5GWWKeqzPdr0yipqZoaU2oUQUAg6W4ide-p2BsBryGhdzPDXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftv7fkdXmCmpDYKG4fWIQNEvdKJAG-34QwlHGTD-9lZ8A&oe=69A97CFE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MclRM7gGJWgQ7kNvwH9pMLe&_nc_oc=AdlZv0zJM9pM1kWToCVVIElp0wlWg4iFrBx4rkZid1UbCdMVri0pCs7SsV4lOD24uC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvnR5CjSvHyNjIUv-Hsf7gTG9hT8JS7upKUvqVwHqrejg&oe=69A97752"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id5dkWb4ALIQ7kNvwEfzC3a&_nc_oc=Adkw8PNW0bIElqvBekEEyLRqHLl0B09yVTVwmylWzf5Bkj3hvANfYd7LrVLDgQuI7YI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBtCBC7qKGD3mECreCZblm4kREpCcSAVzGCGwcfGyrFg&oe=69A991DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIgYyjByhVoQ7kNvwHZFd20&_nc_oc=AdlkoDXqQFWJQxx7IGvv76RidoXwYcNTq2Xckvt6aRE5lyGiDhcEuig65IFwQGO9Cl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.
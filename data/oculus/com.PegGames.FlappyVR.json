ent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PsrwVVeSsQQ7kNvwH7ZgyW&_nc_oc=Adp6HIqJvIeXE7JQxmITuB38Yy5bONRfKDAEp5RXL2xrHwaHeTtsuV78G_fnwMVuvAw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8gvVzMFF2kZ7t-T-oenW8ptvy6TyHEf-Shw6aNXPlrA&oe=6A8ED5BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQdA6DN2sc8Q7kNvwFOu5Ld&_nc_oc=AdroGoFSN9IfH19LEnttTxhW60C7zK1A1Y43hBLKjOv7CNfkudBZECMubXhPXE43JY0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw52rY_hyRbV2AzzcdSiVCHBU0iMNFkuaLDvRcZM49Vw&oe=6A8EE1FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpM5V7q_mQkQ7kNvwGWnChf&_nc_oc=Ado2nAPeIC6MZA4bQMjm4Qd6qFKuVMlnU5GFdHCJdLadK2A2nIdZZqVy4KlIIalT4o4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU_2Jq-z945XduhXn2d43mkL5Y-AANqa4ZWuIAS4fYmw&oe=6A8EDC52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSYQf76cnO0Q7kNvwGAXb7k&_nc_oc=Ado2uZGjJr7-0CH6gViFZmwthxZSNzMOO8My8PFttPf_umGMeO4Mbj1CmRsUswl8MM4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxrEIBUtguxqWLxK_KEw2eRFmo2shsblfYPrXUfWLZ2g&oe=6A8EF6DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcO3krmSmusQ7kNvwFe57X2&_nc_oc=Adp2-PAYJh-8I5Dbw5eyD2U6Zyft-cXxIvQyOS5ql9r879
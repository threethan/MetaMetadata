62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRrrfew7BhYQ7kNvwG3uNnQ&_nc_oc=AdnjYjEOfMTg8RjHVAUBc0Hv6fOSJknDS61iVOnmiCg4GkLtM5KmzrfNMCoyfpdrUf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw879pO4uHFDJF-kHTYUrVeI_k18y7uyBLqq1CKSB9q7g&oe=69AEB6BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtoa6mw-SS8Q7kNvwHZoUzY&_nc_oc=AdnRf2a6duoGxtaJovYaQuMKVTrNQ6IKwQh9_HQFM5WN5ETDKgsdD_fVkADAoSKOHIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCBF_79XlXh1r6gdU0t1Hp0u5NCfpFBcSjayi7SBrWRg&oe=69AEC2FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNNGeJGPgKEQ7kNvwHV38x5&_nc_oc=AdkIQvFBPxAIJnGCflhKKdv5XaKpmenhXu6r3bUmPHZ1fUuNGvqiZSSmj1Y5gfLDDSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMwvUmlh1RHVDYL_NS93vwufQhGmf_a8q_QJdKM_HHQQ&oe=69AEBD52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro89QxnR0ewQ7kNvwG06zzm&_nc_oc=AdlEts1_otUE-T8J596wuVkHG7wRWkGAmuXghgvpbRVs8EuOyahtVAnoyWQVSn3cuxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxIS_TDyLMj1wU5WaMzDzRajRbjH0GRUO-8_67rm_btg&oe=69AED7DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0Yu05o2ZocQ7kNvwHY-oPK&_nc_oc=Adle4XRuH1_lxkmwCRkvEIfjtMry-doFxpxA8pQ050Vkgq9cL1II2dq_tZJG1bTPHKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.
62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npM41ZmmCAkQ7kNvwEnSojq&_nc_oc=Adn5wZKVmKQTPHGeSB3OtSjs_aQorOcrWRMMYfrOLfLjyOre5_NOphThjE0Hosp5aVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBre1tsOrLFyhzC0D5pOYIfRby0G0qElpO4eVfisMQHA&oe=69AD653B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtoa6mw-SS8Q7kNvwE47Q8O&_nc_oc=AdkyzKOrfnDhj6cuBXOqSfxao9PqxKW2NfPNxWVfmLxTo3nSYtYOvUgae94z_BpIwRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhqW-yHMIBwYkDJG53MH38q7-RrhmIrKlirV1iNygCyA&oe=69AD717E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHj5ELJ7jPkQ7kNvwHQSAK7&_nc_oc=AdlfxSYKU2uulb8_tmg83dz9-DhB4lQ3_iDqxUttE1iaRYtdvQfJrG_Kb96AzTEhkP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVmQAj8iIsc3XXcjqK1rIPXSZSBSA8cuNAoSScQRq1Tg&oe=69AD6BD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro89QxnR0ewQ7kNvwEfZfTz&_nc_oc=AdmDDYJXguRY5GbY8RAoj7w_wE7T6HXZB5eN_sIrC0lkSU6l0xgljvPIaP8BliXJflg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgG5m7cKOQ6rU38Iu9G93-FPcfCLNuKeq1iPdCHtWx1g&oe=69AD865B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0Yu05o2ZocQ7kNvwFRzeFL&_nc_oc=AdlkNP2vz5nRhDiCBxizN9gSY0KS2GBFhkJa33YxwG4samUf8tLvc1QbGKyLNkTGx3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.
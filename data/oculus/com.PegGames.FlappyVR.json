.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hg0bsRtmsQQ7kNvwEgVsmz&_nc_oc=AdquQhlOT2Nyr7_GlGz-uZN73OtBPHtXvIkt0HCjgnbQQ8luPmqzsnZzWP4Rg5Cyt78&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzQc8P4E2GTCyzdMKEMblYIPsG9kqe5r6XueWH0S5_ag&oe=6A86ECBB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldNQJ4YKTPEQ7kNvwHwKOCU&_nc_oc=Adpbi7Kkls7J3nrNroBeLxIDx46oY2nhZDB-zunUP9hUaru_pK7JWeSI7fvENPma58c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2G9cRMSwGLDXJAV65ucFOzLFnByPY3zJgkPWt3kRirw&oe=6A86F8FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbY2m6VydAAQ7kNvwFdzpdO&_nc_oc=Adp6YBQW34a-an-pOYGQ82ciSvLrNZx-Lv4n5_ME-L4xjE7EsuuM0LdQuaTXRaiR3Q0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHaRrt74AZnfi8gkZ2KxMr54iuqf8flACxBAPcP6LxCg&oe=6A86F352"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9VosLxB5BQQ7kNvwFRueva&_nc_oc=AdqYim6ttTW-dmQBy_FthJtz-RZhNdBe-CTStPoTV9F316tV86fKEZ5PCMFnEQ5_uhE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoNNanUcr96dcRi70LvPlJ0yxDwuRYj0Mn0VhiCPzf9Q&oe=6A86D59B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6tKLYoV3NwQ7kNvwFp36Wp&_nc_oc=AdoIDqFqtEmlipe7zBZWxW1TdPNA3KOQeOHN6lJHuxhDNDnGdZdNEhCpUH7vHZ
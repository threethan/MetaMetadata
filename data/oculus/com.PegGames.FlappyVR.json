.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=674-eXYwod8Q7kNvwEc15A4&_nc_oc=AdrLbLnqW0GRECEEm51u6sEzJZO4oGnEtm0n2fN6AJX98PAI67dgEq_4TVmUx5zFFd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo-kxSbZ6fUFCjZkdFOq62AUgc3ZQ-QB3uCCQy7n-_2g&oe=6A689A3B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrI7u9ovWUMQ7kNvwHV6WWx&_nc_oc=AdqqjIXAwPq3X1agGWZCkfVIU92OfazW9581FcFZ6vvl0FNdVNErgyBhFNIf1rewPbo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD87FHCfNSzOUVgD2K9BlD3AaWa8UjnWGf0-jBvlo754w&oe=6A68A67E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15bRsrW9ZFQQ7kNvwE9BbLs&_nc_oc=AdrmEp8KIwuLk4q3AXx3NIK3YuY5sdjqGv1Om3HpXJw9QREOXkdzVkctjtx0gsM5mrg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqsw0vxJlR_m6YYcYfEfVCcv6RPvsM2doPiFhsGZQTjw&oe=6A68A0D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlSLQ9IMbgwQ7kNvwEaCorG&_nc_oc=AdrbXkANSd_XuISTW1beiDxpX_6EG2NnmEEt0bOCYM1sDuaQU1XOz8macsJnS4tZO_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd5_gd9Gj2GvfXr6QHkW1u4xPSavlqhCXZH4gEDQSeuw&oe=6A68BB5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPk_GgehZGsQ7kNvwHDuFIQ&_nc_oc=Adr6MHYOTn5_jZ3XjnyovQVdXJCOwfdcOeprcyrfY6XwfJ2qGFh1upSVj6K-qw
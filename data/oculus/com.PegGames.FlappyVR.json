62682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZrNat4l8lUQ7kNvwFe_l8F&_nc_oc=AdmM1latkwK7tkbzFCdNVT0VQbKyPnTBvBbctoZUIFCGPlrKPqMiji3ge-olpu1bAIc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxodGPboAQjG7ZMPl4LAUh9qecV7PARUitrWMhancndmw&oe=69BE88BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e612F2PtmEQ7kNvwFVgZY9&_nc_oc=AdnYdmP00Q8UH8KuGpgs--vpXA_A3NIxnMLEaCoSDzi3KzjRZ-csxDo3Sd13ndqazII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz5CB52NPU8akIBVbBnWpxv0GZrPF5syuUECmf3e5imw&oe=69BE94FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCRdLSY-IWsQ7kNvwG8vZPo&_nc_oc=Adn2SrWrYOPZQYo2DBjIO_NxkhcEaAuQmhhzuZC3RA_4_ekG2ErNjuwRTHSi8OnWws0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwn5avgyj9ncW8dj5Nf0H8I5afkMNElWSTJWMS9b_ch-Q&oe=69BE8F52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kskyumCmvXsQ7kNvwE6TuJx&_nc_oc=AdlIuAJ-sbsq6TETgHNLCrAfFnKciA-V-0hgAtmBkJ_VAUO2BBS_snGw6aOLw8gdCBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySO956TZRy28qurO24f62MHx1WaLoLeHVALuNAhgTZdw&oe=69BEA9DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwRdGsevDIgQ7kNvwFDAr5h&_nc_oc=Adnm2tWxY-8wIp8OtJGKtYpL3jArHvLvjHqtB9HZZupR1oQ5IIBC6NQmjwPBEnOrmHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.
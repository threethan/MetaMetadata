.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otgAjtL5OEMQ7kNvwHPj-j_&_nc_oc=AdrEHtazCTnLuhsZyng-TJnlHMAH6OHFdwJSguOMAOBQuIlaLfpAx6I3NlThMzGuzGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLc_QFfPrh1MaD92tBhtaVLXsvZdS0yt3h3oicdwSY6Q&oe=6ABA8F7B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0HdoFOljKUQ7kNvwH88ky6&_nc_oc=AdpWwSi0ejaKcfrWq1Yc_1EYDR406AFx_DSAJJmd2Yqt7IU5ytlLDwB5th1T6LRLjwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4p3NP_fWEI8hEkH_3zVATymBbbo7VZ4pEAhrMlP9dYA&oe=6ABA637E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A48cL1uPiIQ7kNvwEbSm5w&_nc_oc=AdpYNI6kHcHi_syzZJkFxlKuzcZBm4E1Hua6FfVQsOgVJRR6GyeW-sX4D_IqkKRINX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVacEc1tuvmHIWMUse31q0DUnfcdkhoME_-1kMRZfEVg&oe=6ABA5DD2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9dEXuNmJgUQ7kNvwFj9miQ&_nc_oc=AdrHyznLXMK1bqXb_Bbt-tT9jch3I89jwrDIGRgINKBLcS_9kcWpNxWb-xBYTCq3Fec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILPJxFBfeYZhIP4lHq5E8DFOct8X4rxISvJ8noG3dD4A&oe=6ABA785B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2tAU1rCY8MQ7kNvwGrux5-&_nc_oc=AdpGZVItL5RST_fshuN1QgVj5lGWHQubr6xUxzQJp5LGZQjMFWLTh73QjwRP7_
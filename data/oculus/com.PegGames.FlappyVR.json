.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hg0bsRtmsQQ7kNvwGk1I0_&_nc_oc=AdqoItPbT572rcAzhMXj8Zr-6jpk981ekqTU7IxLMDgyvDJADVddnwqXMNG9k8MTgRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk4o6H05LGMIbhXV1GBb_2BadmFU4hbSgZSeRNkJtFSQ&oe=6A8449BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiNWil4q32gQ7kNvwFAan_7&_nc_oc=AdpfxYK2Tu03k1DyCSvRTfbJaEG4lYYZuiLap8amMR7R-ZvPQ2Aw6fr1mk7KfQpRmwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZplUOsngWvP1bei67ALMAdvXSr1OiCd7mqzFXJeu6nQ&oe=6A8455FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbY2m6VydAAQ7kNvwFqB4Ve&_nc_oc=AdrTWKTeNka1Vv5qEx6wILKXQ1zh15Mgy-sFeUrrR38UVRV-wngN8tmpP5dwbsrYmxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjfqmE6xX1vPCU7wBZ4Dd49KxsLwiHzXnT7An2f8wxLA&oe=6A845052"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRfikNFPEMIQ7kNvwHb8cxe&_nc_oc=AdoDh-7ddDvNas1LH13PhZimPqMwimuM0ktJTonrl1TwlB2suQNuZcgsV1ZE4pLyU6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvZYNG_zE4537naWXHvbtb_-k5HREX3EPcKLQbxsWv8A&oe=6A84329B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX_xJIqITiMQ7kNvwHrOZjd&_nc_oc=Adp1k65Z4JZ6AsdVBVGn2BMWUXNHPqBMCs8PgYe_t9PQBUe_TsPn-cT7m-aTON
.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-msNoKBBIuwQ7kNvwF32IiB&_nc_oc=Adqu7uJjl2mX1r1TqVUqK3j1SkPeR9bwaedMPy8zKbYvEF6nx35BtIddr3gkWhpg1Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58nQrb0xJpM2yL7-6S9qD-MGzELgka6SI8Qjgu7O7U0Q&oe=69FB2DBB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkiNNADAbpsQ7kNvwG4soJ5&_nc_oc=AdpWPIOyDSbTWkT4XR_FV0i1PaQEmMhpT1Km_7k0ZEJJRKoaCSEovMMz-rQ9dghvZ0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DIP35rJnFWisxullBxRnmF7kfPt-bbVE7mba8v5b9wg&oe=69FB39FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ehpS-PTl5IQ7kNvwH3Ob1V&_nc_oc=AdqEMuy_3BSCSoTB9DwCW841mz6YHDr9HqAQeXAYWONVlMbGy0F4pP6UMq00CkGaffs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qWDNCP0kNGr-PgUpvtfBJ_x6l_x_nWhRZ6NeSY9KHyQ&oe=69FB3452"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ckk79zcjw2QQ7kNvwHMHquI&_nc_oc=AdpvGTsVo5IlCIg5YjfpSeo09xh11C7fsYGVpnuS5sP5o0g531FKZwPrcFg8f2xoyyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zjhan35xtRwyMU3kdD3rtOafOFjPGc14C2OV_RTKr5w&oe=69FB4EDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zrY8hne0qYQ7kNvwGPwAWA&_nc_oc=Ado2y18AF9IOJRr-ADm9Wflql_u0F1ncOg8jxlcxVH4svka8XKF81DqY63GOz3
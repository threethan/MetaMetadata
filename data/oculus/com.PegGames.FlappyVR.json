.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZWtNhxE0GkQ7kNvwGwSDlP&_nc_oc=Ado-R_KXztmIFrS_6bIItqeWhv2OSOq5J6Ai1WeXX86VVRUQoFhj5LgiRflXDNOOWZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkKGX3cxQUBfr3LTrT0CZa-nt_BUjEoSPK2R2pajyp6g&oe=6AEF4B7B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMAM0oXqBoMQ7kNvwGTv2hR&_nc_oc=Adokzl9gdvoVfkdoiue9CzL89D0xYMnXDqtBHOAI4LW9ho8KkVQBPRfJVCYOpO8ftpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwLS1qhJ2leEZQoMSwwPT70y5vFwIwLWWSI1RZ_LB4Qg&oe=6AEF57BE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0looExZpB0Q7kNvwEh-QXb&_nc_oc=AdpdmBAxj-V7f3YeEXowZDHV9DeJSJQPrGYSL-m-gIBLllfD5VL8IQv_Batx6hXD3cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfn1FyWupvhxMl8uAqpSICRUob8ye4Pk3VEuQ0AdQajA&oe=6AEF5212"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58B60iaCqQoQ7kNvwE6SIh6&_nc_oc=Adrx_s4Y02ZCKStBjhJcHezMC8l6wJQwo5ExrCBHAB-ZOpM8zE5CKA-vU5XyuoP281s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBogO5oD4H6qlIt2sQ2iuCWm0OBmu4pYcEgR72_hFm8g&oe=6AEF345B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLDLE0GCOTAQ7kNvwE8Hh5d&_nc_oc=Adrra5VVrrKFM35YGwDdmVhiC8ATpCvrufjhr2nUDI1wnDlFHz89zV0LPAABDR
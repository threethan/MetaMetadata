.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN3QJL-fw-gQ7kNvwEi6wgk&_nc_oc=Adrp2gjjFiBjN1ZxU_4jM1OtEmp9645c0yPllfjNZdhVbQdWK5sjVIlPfdCginFvPtk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3brXUZLTu8KpxhVbzpIL_HaQBt9niq2xrq00a__hZQpQ&oe=69F5E7BB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dbcwf4buLNAQ7kNvwEr8Kr6&_nc_oc=Adr2oJedr20z23dXQk5-m2JEc_MYt-4NM_oQ1rn6F3VeA3DLUqORo1GpLkPd9dFjEME&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YKuEd8pju7M6C_lMGob9ilYAkmW1kvXIB4IO6xQQLeg&oe=69F5F3FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUvh14sCLPcQ7kNvwHDPLg9&_nc_oc=AdoXVjCmhPvagermOrE3yvnVqTFn1tCm-sevSOfjmr9STfch-jyg3L25VdIA2uVPDk0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mypCnT3vWu4J8Q9RbmjcIAzXRMp_n6pcpbXSewCge3A&oe=69F5EE52"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXaZa4xkc68Q7kNvwHU71Jq&_nc_oc=AdpklwcN1hAzefuHZLz7JKU8aeQamnTp8zEeKhlmPKqhcKDg7cQpqUsGXHPTCTtBQME&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZiTG6G4LHm_jCao7AXiR6k75pOTao-ArzvUwvX78qAQ&oe=69F608DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxJHfH3JGU0Q7kNvwF0WuNu&_nc_oc=AdpUV18QHPvjLKICV8C5CnM9A55N81kXjAlS0jD_mTbMDeYnBIVxgL-GVNwtKG
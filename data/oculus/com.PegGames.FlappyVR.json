.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpJOVf_ruYMQ7kNvwE1xDkJ&_nc_oc=AdrTrSCGdRqCm2jOjwxEkIw8ecY_ibbxYFIAyhQ8ShUtFpRn03wyBgEmf8CtwWmY-JY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dYL0Di4GIelA24O3ILF66PpxJUIH0hM6MdRwmuqhsRw&oe=6A32C4FB"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GMYEHIloh4Q7kNvwHHE7-5&_nc_oc=AdoqUJOgrl4U9cGc16rkFNFjJJwyxaP2nDe9vfDbOEejnIyun-4qZTcnXaJyqXJRsmw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sm4UCqSrYSO073zmvyXj-5229wJlJ_hOBv3PSKeAEwg&oe=6A3298FE"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZQu84oJanYQ7kNvwFNo73y&_nc_oc=Adq7f923v4BxqHeQJuDQ7jfmAhUvHbuFR2ZV9rN6Nl3qPHAnyfp1yyNUknpWez9x9Qs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RR-5gsGPZ9EKhTId8xsL8uHSubBJYqAhkRqvDK8Hp2w&oe=6A329352"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raClvT4EWC0Q7kNvwHWbDMi&_nc_oc=AdrDhcXKWCi4yVLl79GmYXr4ouhnVgQYV_zOIySIvykwpZMbow-kVnLweXaesdGhtSo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88I_NoqLPYmPZzd3RQDbgk8p6hWAE9RSof5Br6DR-Xug&oe=6A32ADDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfExHXjftE8Q7kNvwEQUh8S&_nc_oc=AdpGj0vFTKO23VqlDyLkjMKKs_AFUJqhQpR2pMgHpl0UTB8a6_o_xmsoJU2GhY
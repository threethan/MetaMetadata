.oculuscdn.com/v/t64.5771-25/11162682_131924804106058_6654063931134312448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWAEa4S5bOEQ7kNvwEZwA65&_nc_oc=AdpRjnVFPg4bQaGpNy7SVhj0EKhlC_Jtp8SZWqUqSCnYEhjcel82mXV0Pv8zSN4rUP8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Arks-L6aPvP6uD9QDP3GrkHMVu7CNzyKGDC68DJBIlA&oe=6A16DD3B"}, {"file_name": "migrated_image.png", "id": "201234884546606", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162748_483014395387837_868646874939129856_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IhZsLxBHvAQ7kNvwGu1iRJ&_nc_oc=AdpMJg-5AH_vUhzhGXsv-9DvES2L58mk7_vbLmh2FU1kwMMSj2szZOOBYBw3uEoo_8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48vXv9YAs31N3s33O-Emyn_YUvdJRb3EsjUKOK5kK7rw&oe=6A16E97E"}, {"file_name": "migrated_image.png", "id": "2540957389449122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162730_1910848052515468_5682976013101826048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWz4Yt7voVoQ7kNvwEgY6qx&_nc_oc=Adr7jp9NUn6HCyrUsabvncDDRnkmxvxxZQGphgvwyNXu7I32UiBM-gBcMNRpk1qumpU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cT7jZc3xx29lYNNS3BdCkh6roJ1GZ4n2WV0qHuaSBvw&oe=6A16E3D2"}, {"file_name": "migrated_image.png", "id": "231999381268586", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_176990779513771_706897530398441472_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRlwKuypzEwQ7kNvwGyeZPI&_nc_oc=Adq4YYIKahTnZO4ImAXJpg__2L2oJbjbWDi1zjL1O1e1_-gAzCSi1wx5NCC-yR4O69k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZWOQ_o-12hm9_UhswyFs1HmM-PLff3k2fcU4rkczH2w&oe=6A16FE5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - Arcade Game", "keywords": ["flappy", "bird", "arcade", "game", "minecraft"], "long_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird'. In Flappy VR, you get to play from the perspective of the bird in virtual reality. Earn points by passing through the pipes and unlock new pipes and maps by earning medals!  This new perspective truly brings back the initial excitement of 'Flappy Bird'. Ultimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!", "short_description": "Flappy VR puts a new spin on the original hit game 'Flappy Bird' with new features and a new perspective. In Flappy VR, you get to play from the perspective of the bird in virtual reality.\nEarn points and win medals, which you can use to unlock new maps and pipes!\nUltimately, if you enjoyed the original 'Flappy Bird', you will love Flappy VR. In fact, if you are currently reading this right now, you will love Flappy VR.\n\nHappy flapping!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beyondvr.ca/privacypolicy", "developer_terms_of_service_url": "https://www.beyondvr.ca/terms-and-conditions", "publisher_name": "Peg Games", "support_website_url": null, "website_url": "https://www.beyondvr.ca/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4740887269322056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162754_128519591111433_3348616315123269632_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad9nQqRPBykQ7kNvwEJzT0w&_nc_oc=Adp_lvoT03NXQ3g7OGi13G8ptxGPlAEdR9Rdn-FjL5tNGakcTIBPrb5FCriNkd
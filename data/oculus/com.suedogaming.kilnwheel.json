m/v/t64.5771-25/593723055_1945760463497810_2757969431771217709_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOqewD1-1M4Q7kNvwE9I6az&_nc_oc=Adp1VeIix45q1W0kHD_QiPsN2MY3MxdMIrAxSjsMErMlKzeoxXsiK0x8pgKXJYmVlfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXvwf9Y8C71EilmI3KIPjTvPDrYk1kKVaQR1r5bQUNAQ&oe=6B10660C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1705748194589179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620530_1705748197922512_646137067399636213_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJP2ydb4ndUQ7kNvwGsrTnY&_nc_oc=AdqUcU1xDXPYV0DlysGrBa12W1EfSMl7W4OdThEhnW3ZcZIR4Gitjxyc4nnmOBAI4B0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjyOC87ffu54YypUgl_oMV2h0ZrNDt8BM7g0OJoFZGEg&oe=6B1053B8"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1168961488895574", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_1168961492228907_483793803732099926_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s0R89oN3IAQ7kNvwEY-ACi&_nc_oc=AdqMkEaUBJFoS8m_Nhbujas8sP1GUzw626k61eR64kekbFRJTrtlLxuEAhzBj1VGEME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6wivaEQlQHylp-Pb_z7sAnOsXEqNMTbKvsP8McOsltg&oe=6B106383"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kiln and Wheel Studio", "keywords": ["pottery", "casual", "arcade", "relaxing"], "long_description": "Your little pottery studio is open and the customers are lining up. Each one shows you the shape they want: a cup, a bowl, a vase, a jar, an amphora and more, drawn as a dotted outline on the wheel. Hold the trigger to widen the clay as it rises, release to narrow it, and stay on the outline for golden perfect rows.\n\nThen comes the kiln: press the trigger when the shrinking ring meets the gold ring for a Flawless or Good firing. Earn up to three stars per pot and watch your customer smile, or frown. Four orders make a day. Later days bring lumps in the clay, splashes that hide the outline, slippery clay and faster wheels. Crack three pots and the studio closes.\n\nUnlock five glazes that recolour every pot you fire, and chase your best score and best day.\n\nHow to play: point at the game window and hold the trigger to widen the clay, let go to narrow it. Press the trigger at the kiln when the rings meet. One button, one hand, played seated or standing.\n\nA relaxed 2D game in a window: no locomotion, no fast camera motion. Free, no ads, no in-app purchases. An internet connection is required.", "short_description": "Throw the pot your animal customers ordered: hold the trigger to widen the spinning clay, release to narrow it, follow the outline, then fire it in the kiln at just the right moment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://suekadoyudai.github.io/kilnwheel/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Suedo Gaming", "support_website_url": null, "website_url": "https://suekadoyudai.github.io/kilnwheel/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1484339034756108"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623185_2227330124857525_7992810294678228146_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1
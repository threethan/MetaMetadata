act us for any comments or recommendation about this VR experience (contact@vryx.io).", "short_description": "WARNING\nThis experience contains strong images and scary scenes. Not appropriate for people with heart diseases.\n\nYou thought you were alone in the house? Apparently you're not...\n\nHaunted is a short horror experience that uses the 360 degree visuals and audio to let you experience terror like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vryx.io/", "developer_terms_of_service_url": "http://vryx.io/", "publisher_name": "Vryx", "support_website_url": null, "website_url": "http://vryx.io/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "ACTION", "SIMULATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "678491456489504"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138835_226482737724218_1105334828_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFQt7AFtLsAQ7kNvwETedGZ&_nc_oc=AdpGi0ft6J9ahVrGraXBo2sl5Nod-LMlGfHGmpZbtPuWNjKeg73D0_h2XjAAjlUg_X8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2kzPq9WjF9MhFqHkRN1i70eZiWvSx19CH8H-NRYsH3A&oe=69C3E562"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Haunted", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1464764400, "lastRevision": {"nodes": [{"id": "1060215437378182", "release_type": "SCHEDULED", "admini
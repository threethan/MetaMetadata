"video_trailer_thumbnail": null, "display_name": "KOON!", "keywords": ["Gorilla", "Fangame", "Tag", "Koon", "Monke"], "long_description": "Koon is a very fun hangout game that contains multiplayer and voice chat, it uses gorilla locomotion to move your hands around! There is also gamemodes like, Horror, Rising Lava, PVP, Zero Gravity, But there is also maps like, Jungle, Beach And Shop! This game is not done yet but it does get updates atleast every 2 weeks! We also have more upcoming gamemodes like, Tag, Only Up and much more!", "short_description": "Koon is a very fun hangout game that contains multiplayer and voice chat, it uses gorilla locomotion to move your hands around! There is also gamemodes like, Horror, Rising Lava (which is coming soon) There is also maps like, Jungle, Beach And Shop! This game is not done yet but it does get updates atleast every 2 weeks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/koonvr/home", "developer_terms_of_service_url": null, "publisher_name": "LucasOfficialVR", "support_website_url": null, "website_url": "https://sites.google.com/view/koonvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1488898407629100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_1699392531284266_384
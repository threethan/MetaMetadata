d": "460717770434001", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393594_460717773767334_5027107154871872297_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kskroF4dZYIQ7kNvwHtUPjO&_nc_oc=Adp4llJ3WMt8iLUF9VmDfUH0NrAo0U1RzfyseyN-uVLYeO582LlfpiqCCeKADDWTmE0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgMZL9ERKuhb7YDJQi1eUtWsbMwva4r8xKPrUwYz9hxg&oe=6AFB4B9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WinterOver", "keywords": ["Space", "Adventure"], "long_description": "The year is 2051, and you are NATALIE RAMIREZ, a member of a mission to Mars that\u2019s so fruitless, it\u2019s deemed as the end of space exploration. Shockingly, days before your scheduled return to Earth, you discover a reservoir of subsurface water that resurrects your mission. But when you tell your daughter you have to stay on Mars indefinitely, she goes into hiding, leaving a trail of alarming clues. With your dream and your family pulling you in opposite directions, which path will you choose?\n{662064726687358}\nEmbarking on a dangerous drilling expedition, which involves a series of high-octane, physical tasks, the player will unexpectedly receive urgent holographic calls from family members. The player\u2019s desire to complete the mission will inevitably conflict with her wish to save her daughter\u2026 leading to dramatically different results. Every dialogue choice made by the player is as consequential to the progression of the game as the adrenaline-fueled physical tasks and leads players onto different paths. Two critical themes emerge while playing WINTEROVER: on a societal scale, humanity\u2019s mission to survive as a species, and on a personal level, our impulse to place loved ones above all. In WINTEROVER, players may face the dilemma of choosing between saving humanity or their own family. \n{1352188652552634}", "short_description": "The year is 2051 and you are NATALIE RAMIREZ, a member of a mission to Mars that\u2019s so fruitless, it\u2019s deemed the end of space exploration. Shockingly, days before your scheduled return to Earth, you discover a reservoir of subsurface water that resurrects your mission. But when you tell your daughter you have to stay on Mars indefinitely, she goes into hiding, leaving a trail of alarming clues. With your dream and your family pulling you in opposite directions, which path will you choose?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "https://blimey.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31356059607343134"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1754364142470025"}, {"status": "PUBLISHED", "id": "1056738343660974"}]}, "baseline_offer": {"id": "1056738343660974"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791507600, "status": "PUBLISHED", "id": "1056738343660974"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38604101432538879", "version": "Version [360806] - 9/25/2026"}, "id": "2354791228026998", "channel_name": "
G-c0kQXxdws_F-66kATFIOiSxwB_3ES3jFvntOYxOG_ihShPLdwb00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOxs6af_zova9EpdLzwdmHDTOl03K-UNL4CBI7oaeqUQ&oe=6B03049D"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 145919.png", "id": "944767843853810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001661_944767847187143_7461031183513120923_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD9-M7-dtccQ7kNvwH2iIpN&_nc_oc=Adqr1FoYAri9_-mzNVtpKzsiFlTIuUkDNqjMA-tXslYqNYJLwnsvqyNaRU97GIr74ns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIO0-uK95lAb_kcoDIry9_3KrxeXf9rLqo-uB2-e-eVQ&oe=6B030C2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 151151 (5).png", "id": "1113843839890568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984465_1113843843223901_2623528631857933740_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaNHZ9Xm_gUQ7kNvwEIqx61&_nc_oc=AdpdL_13nsJWRVGsUn6bLsCC6vxeTsHKma6Q8VcKWNcUk2yr5btpgZPXMkdEZFZ9LI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU2SofbDGJFfxvr0y3uBioDVFXu02yvpI2V-Yl4TPbUA&oe=6B0316BB"}, "display_name": "CozyFluffyFit", "keywords": [], "long_description": "This VR app offers games set in a cozy and adorable space where you can engage in activities that involve moving your body. You can put sweets into boxes, catch falling cat plushies, and more. In the game where you put sweets into boxes, you can grab the sweets using the trigger button on the controller and toss them towards the boxes, making it a simple and enjoyable experience. Similarly, in the game where you catch falling cat plushies, you just need to touch the controller to the plushies to catch them, keeping the controls easy and intuitive.\n\nFurthermore, these games are designed to minimize VR motion sickness, providing a comfortable experience for users (although individual experiences may vary). We hope you'll enjoy playing these games and find them delightful! Why not try being soothed by these adorable games?", "short_description": "In this VR app, you can play games that involve moving your body in a cozy and adorable space. You can put sweets into boxes, catch falling cat plushies, and more. Perfect for those who need to get more exercise!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sparkleand.store/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sparkle and, Inc.", "support_website_url": null, "website_url": "https://www.sparkleand.store/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7390309804356850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404233_1111498230132224_2977581805684884324_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sur0NpyOuCIQ7kNvwH0kkUj&_nc_oc=AdqBfFkCBQLvMponxveEf_E7HV6otoUliyLIkLNBofy7XjdN1OYhBpK4HKan4ypm10k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQLQgGIjOanYf9UvIZrAYTNhNZPQ8topiG_d4NDyVlCg&oe=6B031A2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CozyFluffyFit", "platform": "ANDROID_6DOF", "context_category": {"context
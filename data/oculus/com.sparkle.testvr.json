-3.oculuscdn.com/v/t64.5771-25/39001661_944767847187143_7461031183513120923_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2fbWf2O3TcQ7kNvwEHqBVa&_nc_oc=Adq4c6PllVy0QvO7EW9RA7AWQFQwcWHUb4S1O9XAA5NFp-ieAXNLsJdJXJ9qJpSUtcI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwIyaNrYh6j-w8hHVc6_LFoBcJykZwzv4n1eZhkYYfRzg&oe=69C125EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 151151 (5).png", "id": "1113843839890568", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984465_1113843843223901_2623528631857933740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oxu7SP3heFsQ7kNvwFx4fLP&_nc_oc=AdqdTa7yMpPGchAAJ3aqjZyPfBGTYZzDZCvm4bQQd2YjKktxvyag0BlWr03GFoYPVfI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrJi9YP7dwI__o2_rdh9vgWO4UQ0V7nTEfn2ZN4S49Xw&oe=69C1307B"}, "display_name": "CozyFluffyFit", "keywords": [], "long_description": "This VR app offers games set in a cozy and adorable space where you can engage in activities that involve moving your body. You can put sweets into boxes, catch falling cat plushies, and more. In the game where you put sweets into boxes, you can grab the sweets using the trigger button on the controller and toss them towards the boxes, making it a simple and enjoyable experience. Similarly, in the game where you catch falling cat plushies, you just need to touch the controller to the plushies to catch them, keeping the controls easy and intuitive.\n\nFurthermore, these games are designed to minimize VR motion sickness, providing a comfortable experience for users (although individual experiences may vary). We hope you'll enjoy playing these games and find them delightful! Why not try being soothed by these adorable games?", "short_description": "In this VR app, you can play games that involve moving your body in a cozy and adorable space. You can put sweets into boxes, catch falling cat plushies, and more. Perfect f
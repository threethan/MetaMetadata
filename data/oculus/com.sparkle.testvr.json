-7&_nc_sid=6e7a0a&_nc_ohc=Lisjuetd1_EQ7kNvwEQaQKy&_nc_oc=AdmsSItujcTRE01aAPsGsCr6qv_lgdTFVnGyAbljJ_sT-zZ7gMHtRCWGDcA9N__H1_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuSbhduQzi6K2VTSa8aYqxAn1Y1NCiiM5D5Oekd3em3Cg&oe=699AEA6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 151151 (5).png", "id": "1113843839890568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984465_1113843843223901_2623528631857933740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFrDaE5u0i8Q7kNvwEFXef5&_nc_oc=Adm4SOoALOKz8Hh1NiQmyrjxQDtcFqCs7dMBLQxnuG3ODJpTPMrnUeW96MV5MN_joAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft5CO9hzcsNHbWH9vZYJMhIqE9O5q8nGqQspEzx5WQsRg&oe=699AF4FB"}, "display_name": "CozyFluffyFit", "keywords": [], "long_description": "This VR app offers games set in a cozy and adorable space where you can engage in activities that involve moving your body. You can put sweets into boxes, catch falling cat plushies, and more. In the game where you put sweets into boxes, you can grab the sweets using the trigger button on the controller and toss them towards the boxes, making it a simple and enjoyable experience. Similarly, in the game where you catch falling cat plushies, you just need to touch the controller to the plushies to catch them, keeping the controls easy and intuitive.\n\nFurthermore, these games are designed to minimize VR motion sickness, providing a comfortable experience for users (although individual experiences may vary). We hope you'll enjoy playing these games and find them delightful! Why not try being soothed by these adorable games?", "short_description": "In this VR app, you can play games that involve moving your body in a cozy and adorable space. You can put sweets into boxes, catch falling cat plushies, and more. Perfect for those who need to get more exercise!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spa
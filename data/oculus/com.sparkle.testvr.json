hc=DAvddd4RCrgQ7kNvwF3jwFS&_nc_oc=Adkwu-UmvTb9Ykr6G-Lw_N02I2vRSiLtuS0krFGrraMgRymyUbUB9DFSUlLW2GOTui8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4lNxGyPyxvG0FOXQpgyVZsJiMh0higxBV-vkC28fzBQ&oe=69A2D36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 151151 (5).png", "id": "1113843839890568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984465_1113843843223901_2623528631857933740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16QQ9mMXZW8Q7kNvwFAbRV4&_nc_oc=AdnmhGyZSy10MQ1ybBAV15byAR7pBr5f-duzk7WEjEUJ8bXnPu_50lKfsa6q91OTChg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrN4gtnXCrU9PwNnOeOK1ic7jKHlrxF5zdOLb_I3XWrg&oe=69A2DDFB"}, "display_name": "CozyFluffyFit", "keywords": [], "long_description": "This VR app offers games set in a cozy and adorable space where you can engage in activities that involve moving your body. You can put sweets into boxes, catch falling cat plushies, and more. In the game where you put sweets into boxes, you can grab the sweets using the trigger button on the controller and toss them towards the boxes, making it a simple and enjoyable experience. Similarly, in the game where you catch falling cat plushies, you just need to touch the controller to the plushies to catch them, keeping the controls easy and intuitive.\n\nFurthermore, these games are designed to minimize VR motion sickness, providing a comfortable experience for users (although individual experiences may vary). We hope you'll enjoy playing these games and find them delightful! Why not try being soothed by these adorable games?", "short_description": "In this VR app, you can play games that involve moving your body in a cozy and adorable space. You can put sweets into boxes, catch falling cat plushies, and more. Perfect for those who need to get more exercise!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sparkleand.store/vr-privac
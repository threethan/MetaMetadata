J1YFW0GA0a0UhRrH90p7tUsdzmYbIkwU2VpiDUS_fvF2Lrtuy1gKOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVvrwPRFs9WvG5OxiREceJ0FTYEsk5UyF00IoeSEwm5VQ&oe=6B106BDD"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 145919.png", "id": "944767843853810", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001661_944767847187143_7461031183513120923_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unpfegcjYKMQ7kNvwEBJkZy&_nc_oc=AdoSe-evtdKnn0XLXms9RcEQye3x9WVSRvt8y-3tDkTPrKM4z7tJjCwosHh4fIhowhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXoSjH5tiMWpiYKD33ZhXI78Kf_b436eFdXPpogogLcZg&oe=6B103B2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2024-05-02 151151 (5).png", "id": "1113843839890568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984465_1113843843223901_2623528631857933740_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT_3_lMx9s8Q7kNvwFeHv9g&_nc_oc=AdoHkH2jTop2Auz8_XHBvdQ9RgDnbmzlNhsjSca6tVOUQ0_sOx4qBYvqu3Tz6oPwKjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV21IAVV_dv88DBPcOaaqNZpr7de1udzubJ7lQKMMHHYA&oe=6B1045BB"}, "display_name": "CozyFluffyFit", "keywords": [], "long_description": "This VR app offers games set in a cozy and adorable space where you can engage in activities that involve moving your body. You can put sweets into boxes, catch falling cat plushies, and more. In the game where you put sweets into boxes, you can grab the sweets using the trigger button on the controller and toss them towards the boxes, making it a simple and enjoyable experience. Similarly, in the game where you catch falling cat plushies, you just need to touch the controller to the plushies to catch them, keeping the controls easy and intuitive.\n\nFurthermore, these games are designed to minimize VR motion sickness, providing a comfortable experience for users (although individual experiences may vary). We hope you'll enjoy playing these games and find them delightful! Why not try being soothed by these adorable games?", "short_description": "In this VR app, you can play games that involve moving your body in a cozy and adorable space. You can put sweets into boxes, catch falling cat plushies, and more. Perfect for those who need to get more exercise!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sparkleand.store/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sparkle and, Inc.", "support_website_url": null, "website_url": "https://www.sparkleand.store/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7390309804356850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404233_1111498230132224_2977581805684884324_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNxahjgbX6MQ7kNvwEuX826&_nc_oc=AdoyspxmAokg9vwVKGY-rf3cEDYdwgNVyW01icjg5KW9BC3y6uKCISNi-fVPeKZsnaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqz_w-ubmIf7FSvLgh3oCYAeMncJIBHcKSyYhyEK5C0A&oe=6B10492F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CozyFluffyFit", "platform": "ANDROID_6DOF", "context_category": {"context
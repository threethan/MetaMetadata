scdn.com&_nc_ss=8&oh=00_Afwt24w7i5TQ3DWv5zK9JFdQKx4G0RZh4sOmjXY0vJpk3g&oe=69BC093D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joy Way PlayTest Station", "keywords": ["Cat", "Catana", "Katana", "Ninja", "Arcade"], "long_description": "# \ud83d\udd3aNow Testing: Catana: Red Flowers\n\nStep into the paws of a nimble ninja cat! Dash through enemies, deflect bullets, and master the katana in fast, exhilarating VR combat.\n\nWishlist Now: https://www.meta.com/experiences/catana-red-flowers/8996571250452624/ \n\n# Early Access Vault\n\nInside this application, we share early versions of our in-development titles to gather feedback, test mechanics, and experiment with new ideas before the public release. \n\n# Please Note\nIf you've downloaded the app but can't access the content, the current test has ended. \n\nTo stay updated on future tests, announcements, and development news, follow Joy Way on social media and Discord.\n", "short_description": "Free app for testing upcoming Joy Way games and Prototypes. \n\nCurrently featuring Catana: Red Flowers.\n\nWishlist Now: https://www.meta.com/experiences/catana-red-flowers/8996571250452624/ "}]}, "developer_name": null, "developer_privacy_policy_url": "https://joyway.games/privacy-policy", "developer_terms_of_service_url": "https://joyway.games/terms-of-service", "publisher_name": "Joy Way", "support_website_url": null, "website_url": "https://joyway.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
CrEOQ&oe=6AFB3FF5"}, {"file_name": "zurag2.png", "id": "1526862375128224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623314_1526862378461557_3964965862456084251_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACq7Xr479HsQ7kNvwHGSG7G&_nc_oc=Adq1Z4whl-U2nWtTMyEFSDvu21ybEGV_tEzayYL9PiFd-Kne0ugstkWifHs2QOCZ038&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSMgvKIX-mj8FifrjCVFbPxaeAVzJBShwJbAmECHCJqQ&oe=6AFB4311"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w6Y4qtZe58Q7kNvwFbGHjh&_nc_oc=AdrKXoK-iDBKYelzE_QOQboi7sEn0K_Atd3UvKAEJhk-g-cAAzcMde0VjTjCPKEyUjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXVl-90Laef-dwt_w_4sMn-UyQBJx9UBRNCA8EqhUDLw&oe=6AFB4573"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrPQ5JAQTBQQ7kNvwEIZ3rW&_nc_oc=Adr9_HQp-NuXnEGrdOCLfKwkGtw4er_L0xZ_pkCYKmixEajX_p-kd-cENqWQhzhq2D4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdhXQ-V7VrmHsk_cIarRF5m7AdFql7lyuORmqtAAN3PA&oe=6AFB31E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbtEIwN-q_QQ7kNvwFXGg9v&_nc_oc=AdrGfzE1mxi-UCoWyDDbJi1hEENQr_32EH7SL038laA4SNZi3VZkVCiI_DUNCApRxAU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIp1MdLdjYEXx_d9y5uCV-hvM_GHVcEEfnH282m9TFoA&oe=6AFB311F"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
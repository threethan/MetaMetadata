RJuEQ&oe=6B1057F5"}, {"file_name": "zurag2.png", "id": "1526862375128224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1526862378461557_3964965862456084251_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXLFM5nCfW8Q7kNvwHDw4PO&_nc_oc=Adr33QbVj_u2iZeYVYrVusJI1sBNPG_0VaMm8dBJ77msjTn-XjtrSD4puFgXx-fdYe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpEEDJyPsy7XjXnj2u_jEjftIFiyrAVEOfmwb8tLNxOw&oe=6B105B11"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0iexx3lElsQ7kNvwFCeRTL&_nc_oc=AdrY_LhMxjBvUx0uif6Kb5nsRFEGyXI3GKcKDZgqg3UQDb27nriFqg-a7OuUM9OTUTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV8A6V2BR-9opsIGiiSGwnFNq5tFpoIuHC4O4ETTZddOw&oe=6B105D73"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_S_gnWuFc0Q7kNvwFuiFXQ&_nc_oc=Adps-Zqtfp58w-UhrC8X19-OCNzAvNBiBuhcAqMi6dCdx4Bcd4nlF5U9YYvGfV7zwBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX22vampmmFkNxbBpVQSZsYn4qq_75inDtR7F-lnTZLSQ&oe=6B1049E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trnK0TtStgYQ7kNvwHa-Hnz&_nc_oc=Adom1q5nCmSyOfN-rCeJX7Fewtp0C1VFEDOjPq51nLw7uWOQniUfIe4ZMN18ElBmnb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4TifE-eOvzUUGPJXhJqHDhcpq2vwsIE7aeiyaGEF1EQ&oe=6B10491F"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
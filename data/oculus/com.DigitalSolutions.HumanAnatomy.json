e8mLQ&oe=6B071D75"}, {"file_name": "zurag2.png", "id": "1526862375128224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1526862378461557_3964965862456084251_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U28BRHCFiFwQ7kNvwF4bDez&_nc_oc=Adr-E12E-U5HdUkjJxYdepQsDGxz428ge7IY0k4YiihhxNWoG3OJGuPRCaZZtTmWt8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2n4jhqw1DAYQ-pcOAXShr5-mNDO4wPiUnUoFbvESM4w&oe=6B072091"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-3LKgkBI8YQ7kNvwGGJr3b&_nc_oc=Adr4J72vyYMFYOA9iS1WpfwulRCgPer9_R5gmfntVyEangV2Yry4ZedxzhdfmmgJLHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Tkr0MxliXZfPqeSl5Ke4Olq2EGvjyrohqEAbBispfw&oe=6B0722F3"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I28XfqpQLdYQ7kNvwHm6Uty&_nc_oc=Adqzv4Wrf8AxTxhb4_jhGyCmcfhQEydktseCAudaGGdEHS2gY-Equ577gdkB_XmU0-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHS2M_DWzAK_mmwhvGmZJxavvVQ9ZdNSfPyjBDJr7B0Q&oe=6B070F63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyO_WOPo1AsQ7kNvwHiHBUB&_nc_oc=AdoDtRdHNRVt_EJyRbYA9_1BzrSHWWct7YJoteyWCEdtL2WsG-GhWuX2Ls21WS9X5pQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN62FU07tSiMhCN74G30OSiOpIjlsSDqzTQBDSqifNTg&oe=6B070E9F"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
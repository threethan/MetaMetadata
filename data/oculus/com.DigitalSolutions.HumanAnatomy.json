_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sFd0MzMefmqvMphgcubwkWPsTni_uzOA1LWyqbztnjA&oe=69FB47D1"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeP5bczonjsQ7kNvwGZWsA3&_nc_oc=Adrt6xgppCdFrpcTqocreCSFEwDutEc6i6eKjOAntus5akCpZm1l2WwRILWnPx0lGok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40DYZ_GflLzevwMdORHCijq381DuIjKHP6qfxTsXSI9A&oe=69FB4A33"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpsG-uVsy0UQ7kNvwGyfm4Y&_nc_oc=Adp3ecq4UxinF_-GnIHSoFZlD1gsY2NQ9s6jjEHdF3_kuiXgvsv4Osk-XXf2mOGY1IM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c8_uWbshNokWaX-FYkGWrOYP-e-zTSQvfpX6mfVRVsQ&oe=69FB36A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKED8G5XJN0Q7kNvwFl3_57&_nc_oc=AdodQW1NgNHa2F2H4gRz3oegexp7eiZSGysEs0XOGtNEL74fti48cjsa3Ts88ocqLoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NznNYxgj2NcEp8Ms8P1c25OGrkrdeWUDLs29s75Gf8Q&oe=69FB35DF"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25341441775488346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619681_1131110649185191_8956606916901921361_n.png?
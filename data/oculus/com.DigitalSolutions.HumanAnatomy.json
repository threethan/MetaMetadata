luscdn.com&_nc_ss=8&oh=00_AfzvjVdGbwSSGThI46qWOAdx0prmwi0zy-en3iRc62k3WA&oe=69B95CD1"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW3aJ1jhI9AQ7kNvwH_NYEJ&_nc_oc=AdnlIOw0qh-1r57hZeR5eEcIESDaGfiUXmnppmL02aReM_x_Mpt3vNoNaye99veG560&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysmeqnvJ4duyQKe06-66BTOPT_lp7c0S6vz2EZsjCSPA&oe=69B95F33"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3hHnuR2hq4Q7kNvwHn7sjf&_nc_oc=AdmKnZPqqs_mxP2o0bJp2wE7B48KKSk6JPYhCKfg-Fgj0sZFy_M6pny9q-WH_Xi2QaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQQkkOJ4w8CdqvgHm17LgiUZAnAf394knqe6aSuXiMew&oe=69B94BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5AzSg8UV7wQ7kNvwEuBfIv&_nc_oc=AdmjqvLHJbipPuTF33J92ecrdoYILlrgAkJ9NnM9SBEJ_xgpLDb40kmceQvqbUbV_tQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSSXwDI9tUsgMoWIYNgkbkDWGxdFgy1E1jMoU1kBG5bw&oe=69B94ADF"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25341441775488346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619681_1131110649185191_8956606916901921361_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid
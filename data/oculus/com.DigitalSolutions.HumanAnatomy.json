_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VwoCuUSPRk9QtJjhdvMvo--F-3rVo7S2RVOMRexps_w&oe=6A37ECD1"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGBQzKddBMcQ7kNvwEjc0bU&_nc_oc=Adrmf1HGjJeE7lFsX1hz77vg-R3sTLCZpaX9bEUDNqZNNd3z9a60ApSSXjzp3Wz8OIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p0nqLV5F1smZW2N-KawDNRLVK5yRKg52LuKD9YVqt4A&oe=6A37EF33"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBccB5pQ7u8Q7kNvwGP8Zlj&_nc_oc=Adq-P-SyAbblCvTwrVy9v9podwM_Stxvh6556wnl-S9EQpNxT1qhDzMTFaykTSh58M4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hGReRy9T8WSRECvRh5lyS1wgmo5HG46xnEKWjq19Deg&oe=6A3813E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZZHoJKuIs4Q7kNvwEUaT1F&_nc_oc=AdqtZxpIvN2iXTNxmc8X7PvOLO5InEp1y_L17ZovjyGcD2Xz_Uttaxz4mD_miR7bFFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_01nhXCu1IZ2wn6mE9PvTz7n7mGJNNzyZ6c0LWeABAGQ&oe=6A38131F"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25341441775488346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1131110649185191_8956606916901921361_n.png?
zveTQ&oe=6B09C075"}, {"file_name": "zurag2.png", "id": "1526862375128224", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623314_1526862378461557_3964965862456084251_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3I1yg-faisQ7kNvwErjm-v&_nc_oc=AdofQ4yfEp5Q9u9GNxsuP9pL-0UNQtjGRL4azpdmssDmA2AjkK5F2Nf1vBmPMp04__8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHDs_OQLxPetRIH6oEmrO6KU2mUBI3JazKn6S206PxOA&oe=6B09C391"}, {"file_name": "zurag.png", "id": "1860364201508860", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1860364204842193_199594303557961188_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tjxzq2WvocQ7kNvwHhoURX&_nc_oc=AdrOQjCYRXGHL6_vvGkForChbZCxpX3t4c2cG3Gj70R9nRQgy-kzj_75IGRTHCpTCsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzPnOye6bz9tKO1jJXKYDynj-ERrokxbM4ECiXPI4TaA&oe=6B09C5F3"}, {"file_name": "zurag4.png", "id": "1461436068282335", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618251_1461436071615668_2014661588460493998_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I28XfqpQLdYQ7kNvwGPXjFh&_nc_oc=AdruSqqE-Ez0ESazNoTqYpr_KLOn4k-GFN4u8fZA1wtMhXFy11OdmZYH895SIGNElvY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwh3zfwvvKZvORS35GVQFiKaeIqLqgNRMC8iX4KeVSdQ&oe=6B09B263"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human_Anatomy_Landscape_thumbnail_01.png", "id": "1553953865758697", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_1553953869092030_1424327906333990723_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyO_WOPo1AsQ7kNvwFGDO8d&_nc_oc=AdpS7NNG3IK_OsmhkIsBJI8k4BPzTU-JJIwizQAXKz1HM7y5N-nOkjQ4g0APUHmDK2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq3CixdOGY9QyOG3eHpZo4PD4-2xu8Mb5lSRLE3qlVrA&oe=6B09B19F"}, "display_name": "Human Anatomy", "keywords": [], "long_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy.\nExplore both male and female anatomical models in stunning 3D, complete with audio explanations that guide you through each system of the body. With intuitive controls, you can zoom in, rotate, and inspect organs and structures from every angle.\nChoose the system you want to study:\nCardiovascular System \u2013 See the heart, blood flow pathways, and major vessels.\nDigestive System \u2013 Explore how food is processed from start to finish.\nNervous System \u2013 Discover how the brain, spinal cord, and nerves control the body.\nAnd more body systems with high-quality anatomical detail.\nPerfect for classroom use, self-learning, medical training, and science education, this app brings complex anatomy concepts to life through immersive visuals and clear narration.\nWhether you\u2019re preparing for exams or simply want to understand how the body works, Human Anatomy VR makes learning engaging, accurate, and unforgettable.", "short_description": "Step inside the human body with an interactive educational VR experience designed for students, teachers, medical learners, and anyone curious about human anatomy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
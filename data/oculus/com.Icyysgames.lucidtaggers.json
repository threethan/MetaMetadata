ld \"Lucid Taggers\" and experience the thrill of monkeying around with friends and players from around the globe! Whether you prefer casual play or intense competition, there's something for everyone in this dynamic fangame.", "short_description": "A new interesting Gorilla Tag Fan-Game, Using Their Loco-Motion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16zcSU9yxL0lqhXiinhydmnyOjl4Md-JRBPxM7ifvDr4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Asteroid Inc.", "support_website_url": null, "website_url": "https://html.cafe/xca27cffc", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8901210873322433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391934_1132168681548917_6306508398279748905_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kuw9SbSw34Q7kNvwGa5Sos&_nc_oc=Adplo58Fy6Y_ky52WPybxkN6NtViqC22aJaf0pytv08KMVkwvbas0OuRBUP8Ef3vxa8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tm-TF2b98ze0jZOFub6pbIDeNUDr2F2yK0PE3LLAwJA&oe=6A22F198"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lucid Taggers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260359
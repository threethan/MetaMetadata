cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylJgrCAVFuEQ7kNvwG31v7G&_nc_oc=AdqBZXRwg-x9Ict2pG3zrP3jjMU4iq6yyE23MzLNB2YHNtVvzD2fbMG2vPl1wucjk9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST0Q_WLqo7UmliV9NPQlUNT3tpKa8YA-gmy2Wy8ShT7Q&oe=6AFDBBF5"}, {"file_name": "screen-01-molecular-lab-presentation-wall.png", "id": "1736254340810571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623558_1736254347477237_4824121626320452974_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EraK1pIg2vIQ7kNvwG11rQC&_nc_oc=Adr1aJjBdGn35DzsZARg8q-NerAlo_jI-Pwp9KPF5li3MnOh45KVu6kbHMazzqkVcDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNSNLcgAdhFmTz_6CEW6BDjIj0qubFDswP-8rxsHgNew&oe=6AFDE3BE"}, {"file_name": "screen-02-distance-measurement-ligand-inspector.png", "id": "1353813079989649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1353813083322982_5451792336212229058_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnsLMnJIamsQ7kNvwEFY8fc&_nc_oc=AdoByMbPhEAngZDdDS7OtzppVhX1E4QbRHV_Olo6u2b4Xc200J3gECLyLfBtDuiEz0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXP-JSuFixJjqoSP4c8aycOho2qo4dy8I8odhjm8JiAw&oe=6AFDB296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nexopeek-cover-landscape-2560x1440.png", "id": "1805820507353238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623876_1805820510686571_390451571666373928_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaFcaYfyHsEQ7kNvwGQ8qZy&_nc_oc=AdqwNwtjbek3RoI8UHgEctRR6RY9jB3EbLorQO2g2chSLx6OPG93CFag2ybIn22nITc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKOhA5Ija_0etrOEzbZfXlkoK37odZ72KEeCjZ2fDN2g&oe=6AFDC78E"}, "display_name": "NexoPeek", "keywords": ["biotech", "biology", "chemistry", "molecule", "drug"], "long_description": "From curious science enthusiasts to veteran drug discovery teams, NexoPeek empowers anyone to step inside and\n  interact with the 3D world of molecules in VR. Journey through guided tours across six pillars: biotechnology basics\n  that teach you to read molecules, the foundations of life with ATP and hemoglobin, pathways and interactions like\n  glycolysis and trypsin, medicines in action from aspirin and caffeine to penicillin, genetic technologies including\n  CRISPR and Yamanaka factors, and green biotech with plastic-eating enzymes. Then open the full PDB viewer: live\n  RCSB, UniProt and AlphaFold search with smart routing, six one-tap publication-quality scenes, chain and residue\n  isolation, AI pocket prediction, ligand inspection, atom-precise distance measurement and Foldseek structural\n  alignment. Grab, scale and walk around structures with bare hands or controllers, float molecules in your room with\n  passthrough, and follow the discovery loop from search to hypothesis. Whether you are a student meeting proteins for\n  the first time, an educator bringing lessons to life, or a researcher comparing pockets, every structure comes from\n  trusted open science. Learning sticks when you can touch it: watch glucose become ATP, aspirin jam its target, and\n  Cas9 cut DNA, staged in 3D with narration. NexoPeek bridges abstract biotechnology and immersive reality for\n  classrooms, labs and living rooms alike. ", "short_description": "From curious science enthusiasts to veteran drug discovery teams, NexoPeek empowers anyone to step inside and interact with 3D world of molecules in VR.  \nJourney through guided VR tours across six pillars, from biotechnology basics and the foundations of life to  medicines, genetics and green biotech, then open the full PDB viewer with live RCSB, UniProt and AlphaFold search,  one-tap scenes, pocket prediction and structural alignment.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nexopeek.com/legal/privacy/", "developer_terms_of_service_url": "https://www.nexopeek.com/legal/terms/", "publisher_name": "Seven Sportz", "support_website_url": "https://www.nexopeek.com/contact/", "website_url": "https://www.nexopeek.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453797564473679"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1803441351434073_5099192318887898662_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_0FLJ_1vIMQ7kNvwEVSWjk&_nc_oc=Adq4fJlMP_5AiFote7Xwpv9-jkn4X9ZpT8cfNs3S0KVELLxfadLdzt3HW2RFoeh8B0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMDiBUZUNQNBsqWZ5vL1HKF0C65qSZXOFLDhypKChf0w&oe=6AFDDA67"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NexoPeek", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1793157780, "lastRevision": {"nodes": [{"id": "1453797581140344", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1453797551140347", "is_first_party": false, "
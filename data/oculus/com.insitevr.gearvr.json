=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7oXmHEwHcW-EKMlg55s8dZIm-UxG5XFEmmdSBJnm-tA&oe=69B1598C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI91JSmFRLkQ7kNvwHjMIoN&_nc_oc=Admn6FhvteBY8y1Hg_b6-yZCOP1azFsqn8OS0t7-lnK39vD5NVpvO74B40hF3T7VUZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIl8c7W7_brh4ZLBXfMaw3regOiLqPuQ2LtcdlX0mO7w&oe=69B14A58"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7mZHIA4oZEQ7kNvwFrSANq&_nc_oc=AdkTiHKlVSU2EQelIgKNo-ALlsDHJDhUs6VFcTuVDfpyyBn1ax7dGapiQfO2ttWaeG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afylhhn5-Tvzue_3bmB3Wf2Gx5ENZ4KOEi-C8TByesqE1g&oe=69B172E6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhHGztgiVRYQ7kNvwHdOw1C&_nc_oc=AdnLx6MnJp50HDfi6O0mLyBHnJhSkY1fhwD3KaHIY3a389zbzh5S2J0o_7c7C78-Kwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHFBgFaMWdYcEzq9qKleB7Cn-qeo9rFRC6_9xX73AJfA&oe=69B1729B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPFBMEDce2cQ7kNvwGtJtix&_nc_oc=AdlxxLXMy7-PJnnIR-3rwOur4pYjSsZ4MbTp9VwM96fuZMHyooaTdfCSW6weYBqO3FQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPD6GEuH9mAzRTJYK2OaIa5JuqudsgwE_6I4K5-M5KTw&oe=69B179C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
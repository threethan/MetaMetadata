uscdn.com&_nc_ss=8&oh=00_AfzWHF4WjeGcfPbx7-C1atCjZEIkgWCON1LDxpKdfJrtKQ&oe=69B56766"}, {"file_name": "migrated_image.png", "id": "852804571811468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gZV6rKRckIQ7kNvwEfFKLt&_nc_oc=AdktG_6wZ-IktPqshn27_1G_tTLaoXuvdzO9vYZMFluNMJj-xWltuLK7qOCsI8ad8KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpX7p3BXjjwscaqcJ9pah_zleD_gBe6_0tEJtvAKXsTg&oe=69B56E48"}, {"file_name": "migrated_image.png", "id": "838181573351829", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162675_155896568313175_8952665191695253504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VaOlVFjticQ7kNvwEiPHcq&_nc_oc=AdnaLWUkkPVNy_nzxIj3WOtcXIIEOC2KFoniE7AyOc39_w9Nu24mBYu94qH25TDp21A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkF0u4_hpExWe7vscFzKIdH-N8x4XsiyRXhnLlcO6KDw&oe=69B544F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a leading VR presentation and meeting software for architects, engineers and contractors. Their online software converts 3D models and 360 images to be viewed on the GearVR, Oculus Rift and HTC Vive. Users can easily stream and control client walkthroughs in VR from their computer Users can control where someone is located, direct attention using a virtual laser pointer and leave text annotations in real time. Users can join in remotely from their GearVR, Oculus Rift, HTC Vive or Desktop and see their colleague's or client's avatars, talk to them through the app, and collaborate together on their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from InsiteVR.com.", "short_description": "InsiteVR is a leading VR presentation and meeting software for architects, engineers and contractors. Their online software converts 3D models and 360 images to be viewed on the GearVR, Oculus Rift and HTC Vive. Users can easily stream and control client walkthroughs in VR from their computer or join in with colleagues to review 3D models or images together."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "657212338758842"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2796727617060003", "version": "1.121"}, "id": "1147599245274789", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "975057459227037", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2796727617060003"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1147599245274789"}]}, "change_log": null, "created_date": 1583262237, "id": "
k_YHx1xC2aqWgxjxDrPz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSplkL3vD3H9_C77gW6obHX_XzG8vyCV7yAz3vNg2qIJg&oe=6AF33FCC"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LvdlldpqqAQ7kNvwHhTPfE&_nc_oc=AdqvZ1p_PhZ_LyHwd2v4M4hxuzmMQYrHKKFgeozW67KRiqUCL9aUsDVOnWnvp33i-Xg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmuQDjK2nb_YdFkNF7RVX2uX8N_fMtnh4RoTGw6FVPIQ&oe=6AF33098"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7B63S52-CsQ7kNvwG8087V&_nc_oc=AdpNQetCcgOYx2T8quhL6RifkrZhjI9ItBK6yfUIckBf2s4luy2J0gdugyDCa4ViJOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnrpoRauu7IzcEuwgQvlWb_5rgkS5hh98WfyBVobOr6A&oe=6AF35926"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh2_6mZbZHEQ7kNvwHxWuHR&_nc_oc=AdrB6UBrWnasmlXMjM-sexZCqozEzmwOyQGrKJUEkKannm84uqWPZoc8tJCBWyehOok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR15FOAEVcum8GTNxowEE7QpO_vSgnDLEDVrkmI0gCuUA&oe=6AF358DB"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayzdfSN8YLYQ7kNvwEZNEyv&_nc_oc=AdpGYQQYwOBXChbPVTCnQBGl3E0883wsKiEgbk46RXGziSM5l_n-RjDwWdE-Mvgpz6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAdbjv1NU8wPoq_zA8jdXYXDk6Ht-zihHVgqMSzi7eTg&oe=6AF327C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
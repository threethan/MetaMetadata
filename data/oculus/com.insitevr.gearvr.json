=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzE6KBWkxJK5ism-YxdhkekZOv0lYd9W7BHHpQGybE2Pg&oe=69BBE58C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBaSAjnnP1sQ7kNvwHIDyhQ&_nc_oc=Adm2VawCHg7TlBBdwT31rvF-oihehZKGllWr3XdtEDKL6YZYTIMvcavK2V3Zqs_Pvq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzjbYlOuRUaLWXjwViNdAhK2WYC_H9F04OHfFJWgNYabw&oe=69BC0E98"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy9jl_ViUuYQ7kNvwFNVIqA&_nc_oc=AdlKhLyAjREfM5Bik92W8xf4AgwRpo8UTiv-HNeMQ2VEbzkg2-5sToKSxts5oA1a24Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmEJ371zC1xUkRBH_29L8HOEqctA3yWIOi9ZIpYKVHjg&oe=69BBFEE6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwxxyFiDlVcQ7kNvwGJSPq_&_nc_oc=Adm24KUEXJEXYINIhreoYuisX1uRRYzUpDNGI-w_7AMJAmg5rUA9pM617JjLSK6TwJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwP45SkaAQGJOYS6xzA_i1d1NRdFo4-mIRTBPvUpxcxvQ&oe=69BBFE9B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB_z1kicIBsQ7kNvwFzeZX4&_nc_oc=Adn3Db1kE5nSh4Gim2smTrYMAsaRGjXQalOyG6PLwjLce_HyjYlrHB3UIZsnDNJSd1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyeViPLDWoOkRcANwXbpQ8Abv3W6Qg1pddWzegw-GKsqA&oe=69BC05C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
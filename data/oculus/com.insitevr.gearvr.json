-VKmpzEYEtBm8Bua-aq90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyx7kHMQMeB_oWCGggQbml1RZn4F9-m7EYbcFCIjjHKPw&oe=69D0FD8C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQF4DDZseH4Q7kNvwGcsr_l&_nc_oc=AdqCcxTKzeNUvGPzNLpd0Mh56JALlSknnJyaXxu3fMj_gC6C3sHImGmICn22tukcfwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMUHf-hCnyyfkF8-AHHA79TMaz1u4c2d1yGz2Dq_RlAw&oe=69D0EE58"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8z34pgJvBEQ7kNvwEjwXOs&_nc_oc=AdrtAbn67oJzYOnUAZABlRzxSP8xeymgdtA4aGZ13lCyBc8ziDCpO6KU-XMU7n_bHxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg72W6LGGTMrTU4pDJQ8kolaOkz9hfawZ4ja0sOo0mgg&oe=69D116E6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhhp1U-MWLoQ7kNvwGEQoZw&_nc_oc=AdolSMLBbtcHYT3eJzYVatwSj_6a679r-Mip8UCL4tO4Jv0x8Dym7mVGAL8kOqAflNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySGLUVZJqFwOIBN1ApX6XJkHSNr_hiVQJG1OmOVOpwZg&oe=69D1169B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcN-COKnwloQ7kNvwG6wSAC&_nc_oc=AdrM_nTTqo_iy4wTmPnOzer9lyjcv6OxMemWJS2DoRdIurbRGjke2SKlwa_u3MPDzlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzhxy0b8m77GCMTlSzQnqYb7bRGyo2x_ZFCO82iATpsWw&oe=69D11DC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
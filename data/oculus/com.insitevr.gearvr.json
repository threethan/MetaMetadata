=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOuee5-5H0xcCsY6EpfA-0V7vRUyBmKOaZYrt3M-GRKw&oe=69BD370C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBaSAjnnP1sQ7kNvwFQC5EJ&_nc_oc=AdnAmbuz2ILDUNUa8_6sAF-l0cPhVxuuYbgTskeJsM83SvPl2gZNhruEEUAnvgM3qcY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJNAD5xOjAToQO9sPMwCmxAEC13aBkK74SfVCtqvP2VA&oe=69BD27D8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J98LmiHsvP4Q7kNvwEBha0z&_nc_oc=AdlSSJ6pVY-beT9qBt47BmZezKqZNvzqFVFdlQWSlUBAOayAwaIKrmMS-UZv1n0yDE8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqM2YkJUVZehron9TtmY8R_No-WrAGpmc787I_NHjp6g&oe=69BD5066"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpoJMk-AC6UQ7kNvwHgJyxP&_nc_oc=AdnXld1EUUGRWH45SM1auQJoVEwAIyMBI71H8qZXVSKdJpuX5RyMoVX3zYtOdo5A3AM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTpBzzV4isUBXqJxL9cgsALqb19MPa_-XsfoRgWg9GGA&oe=69BD501B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB_z1kicIBsQ7kNvwFQrY5E&_nc_oc=AdmUWHy8Ow92DhdqqGC7LTFBOAMzixYPn1OQSm1KTy7mI1zLd8TW38LwU2mj13mT-Uk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5ndcUOh2qixer8E85vCI9caLVo19qn6xX1zjy7CvFLQ&oe=69BD5748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
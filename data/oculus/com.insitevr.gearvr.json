u_tXeikKbpo7MCEvIuNQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPtHb4-vQ4B4ZuO87SscopgTmAZB0-VJgDl4QOrf0UUA&oe=6AC66CCC"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JNpQYKSWaYQ7kNvwHKh_d4&_nc_oc=Adq20Ogx5pDmuk7O7ZU52U5DP0J-2g4mqT9iZaLULwPSPTSPSsoEjixOISl9uABDr3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPatjS7Qtt8hGzcHfo3DOspb1nhlnyXc8AaOw51HTGPsg&oe=6AC65D98"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT6s-U6XgrgQ7kNvwGA_mcc&_nc_oc=AdqHlHOsKSr1qZ2Z9g8fNAnDiSuxJ0C9kGhaxpVmZCGhrpCcLQJXt0ML9VLERBvk-Is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSBsUYzzfdRB6_GHKUf-opA6awMA99N93TxCAf0R_itQ&oe=6AC64DE6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B0bSd_eJwIQ7kNvwHwDvNS&_nc_oc=AdpXFXKzuWuuXSjVSSmmvPT5HHp1-fhQJE46TapmgUvfNXGwd1JDFxgR-RcSHBHMCO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBjd5-chfyRKA3yg50CGqhdwtptDFbR4ElhHiC1Su4Zw&oe=6AC64D9B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jyjD8aqbjIQ7kNvwHYX260&_nc_oc=Adpu57ZSrD7ziVD5o1qnhnNZcc7XZNsZOkC48fY19Bf0K_PPGq8GgPkeeDwiRmIZ3vY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwwMh6y7AxPhP3VFJ0YWQFKtfpC5DUTanKAO1Vus9ocg&oe=6AC654C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
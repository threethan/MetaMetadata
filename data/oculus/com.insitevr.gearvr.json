YQWi13MjSQ-noyoidfdrtx_r9k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHom7tD_ehEk2Vxk0XQcA_MSFcshA6uLXm_CVhm-IapDg&oe=6A859B0C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSVVA7TmjYsQ7kNvwGbEQGG&_nc_oc=AdqBceORIZAgWrSzRguCWaTrsDCW4yKvQWOV4NAVa6UIZtAA3W9tV9zzro2k3DG3FqM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdbBZIGeHfbc6ZwX2fZGd0WoRX_MSL5Hlz9Z38ZfrmXw&oe=6A858BD8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqtilxAkaIkQ7kNvwFZV45o&_nc_oc=AdpIMEK8m3FzaQAiWbRs42Z8Aqo3CZHcsk14G3R0_eCvODwy226ouyQ_Z9izUmUSfHU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO7AbdydIUrqmAiRu04lSAr6b4SeNZtz1P2eV1q42f8w&oe=6A857C26"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RpthguqYb4Q7kNvwHkEyYT&_nc_oc=AdqKu8abUJE7AmF-0zEhu7jhpXV5y769TUtCi680XEzPPmd-bE1QSOP39oNBzDDVNy0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqEs1j1nGlME7hsK6Mdke2rH-ZfHMZKlQnV19ES0-5zQ&oe=6A857BDB"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0uMvcqFKlsQ7kNvwFDUnkZ&_nc_oc=Adpmf2azlGYvOFK8J8LuzsmkA08MsfwpphqG_hRn6PVNXUBkHrpCx5SkHMC-jr4y0DI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgYZfB90vyen4HNo_Ei2VaektSqvZmysxpeFwE3pZtRA&oe=6A858308"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIR
=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxvfe6o6c30zC39KGeBnkglWXYomJRXhKDF4YFAC0jZiQ&oe=69AD650C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMKbR4mK3_MQ7kNvwHj1PJQ&_nc_oc=Adl1y6BBMH85-e-r8HNmTN-3obdq_wesiGCWRj4rpqWIAsj2CJm6ZQxv21jPvzYql6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywzVycPKlktF3sA8QbWkt1bzHF2J49YMZ0vJzqsutNBQ&oe=69AD55D8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i88Ilras__kQ7kNvwHxlcGK&_nc_oc=AdlEsjagn2yIPViHs_ZIJPoVJgh7V0SEplP0D3GJtmPTxD5QITRwjBb90bW3RELilIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6ZxYVYCKDdpG7IfOgaTg-m6-s3fi-PgZs4f7wk-yIrA&oe=69AD7E66"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-hfhsxEBsQ7kNvwFae6Gu&_nc_oc=AdlFMLwQG1zkEUBI83FLWe8Zwc874iEf9KGdmCZJCCJAsMwQbZFEPzjYD58XeKeiuao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpi6o3V1U0-rQEbE8DlVoV2Tok4EN2rKY351EB4n8HmA&oe=69AD7E1B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82Vv8lHO9FAQ7kNvwGODFgL&_nc_oc=AdmQauRKZjNJwGuQiVj_MW90BSe-xW6A3Sr2A1DzqacAn9DsEyE4BFYO1N5bSLW0UCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6HI3mRLt-IQKY1k9-mphoS_RhHEU7F6ndL0jHfZld2g&oe=69AD8548"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
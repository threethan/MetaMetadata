=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT8pgDquJHMAyCYO96XsuReMPnzfDvn7HLCnSr_5pboQ&oe=69B0080C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI91JSmFRLkQ7kNvwGWUNxW&_nc_oc=AdmyxkTwe5gllI3lKB9SVmp8G923nAQSUtiUiXJk2OWE9w0Hx0NGmYTXWmcdqeTy-rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTERUOz0aE5174I9PyOzCLaXjzEvfrZNsrrYNjqE_-Aw&oe=69AFF8D8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i88Ilras__kQ7kNvwGhAxx8&_nc_oc=AdlwuRKUVQkDnBGTDkH6S7WKd_w_iN7bO3cDf-AbHjMc7lmGCPsyEQEByZ67pVJy-dw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHu2Z1L9GjFDtuXYCx7vDx8Qr_VWJbtoB2QB8-rz3W9w&oe=69B02166"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-hfhsxEBsQ7kNvwEfUtTN&_nc_oc=Adm5FtU7XdA2ERKHdZFlWT_PTp3CUr86aWH6zGaJntJ6-twzZ5ouVHkv5dzKDLiGP-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5nyiGZtKzqLEbaUMUgmEb6_XwxbuSQdel_1WMNMInuA&oe=69B0211B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPFBMEDce2cQ7kNvwEUMuHy&_nc_oc=AdkBx7wzL07KQoQOBAne40Jp-CxbrCTwDVEITreEClGTbgHmJGHMAYuZBbdSQ43I_wk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhuXXjBfs6PxlHZ6JtYhvVQZvR6tsi1URFxJbLIZPu-A&oe=69B02848"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
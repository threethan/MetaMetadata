OgKeiZTxYr1gX13li2euU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ESnIzaYIE6UEyc3XLvqR_i0ADkmtL1ograspDMgOsaQ&oe=69EB5B8C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZohE7z5m_VkQ7kNvwGkmHEJ&_nc_oc=Adob-n2Jm3wBdFeCqY_aDzJUA7OQnp7-QuFi4zjnSbGf2A54hUWfZxmWnTTeAX6lpbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JXlTPJChaLhnygl8WupCUqr0DB9s_4knxhNTFQxuzrg&oe=69EB8498"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5JeWDJpT5YQ7kNvwG59bwQ&_nc_oc=Adq7cVDD_OhaTu55xW7k8HYOvSNPZGMB2QMx7o9hXqv0dn1iNwDd37O8oIVNSWQgp9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KCNuaJ5DpSIVMeh51RSsKYXOW8n5i24RU73c22cnXBQ&oe=69EB74E6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDSNfpY-8JAQ7kNvwEUgwgc&_nc_oc=Adp5KlRvUoQ5k5-UC2lm8dWccxi5Eo9VjCHdUbHgz2eTofMZ-NVCrePhwM36lOKS1IU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34gu_950_tGBS49G67mBR16lmV4ElzOoMqTnZbYM5vQw&oe=69EB749B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCOXE3u0PFQQ7kNvwFWUv8J&_nc_oc=AdpC2wU3ELAGSH_IB06e3gsWNfRlbEBUOIzRFPIeIUQiDSVzt-e7N98sRsqY_We9MHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GEulyUZQTepSPJOKXEXC9_yTUOdO4eGCtnCWCAtmf3w&oe=69EB7BC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
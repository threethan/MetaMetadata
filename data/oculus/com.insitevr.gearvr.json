G3Gq8mwU-C-AC8NZURlnY1vDwI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4QFewYHQyGuiVVNKn-I-YI7fvszjT4KBVD42L_2MfXA&oe=6A8ED58C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSIZVPWfjJAQ7kNvwEGeNmU&_nc_oc=AdpD41DFtfMI72crFJpeA13AkO_pLUwPdSNlvFNtBoAjKiKeoLqvCI0I2V4tcFcYwOU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzReWFuzfbW0sUj2o-82eLmlYGYYoT4T_B2bxcK2AKeQ&oe=6A8EC658"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5Uqr1leHRIQ7kNvwGt34Qz&_nc_oc=AdpY3iLOg1CzJhOfWL5Nfql4HIoB0sRCIvDHP7t3AgFEyQDk-5Yw-B9Eq3STZBi0dpo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj-uftWXlWJevz0pp_5pDBa_0TyIrFqHaYpHL2AQk9bw&oe=6A8EEEE6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0WXid6R5GIQ7kNvwF9DtxK&_nc_oc=Adpbj9fOSPEAqupp07D837N3AHW_WbO_3X1_mwlsiW4aapjNIbPPi4rVsudCspfmt5c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGRdAyHhoSFdjjbcqXE9CDM4mAbdCwkszmxRCWhNhoCg&oe=6A8EEE9B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WT0ozCkt3kQ7kNvwEVgbgd&_nc_oc=AdrQssG3Ct1G0fG5tIFmQPtusQs2Fkr_4djuxisykCD2sGQF4GXh7cOC7oxkJN9fBi4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVCKO9un6aekdt_S05buKsQGuNH1ZjfSs9uDV51As3Sg&oe=6A8EF5C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIR
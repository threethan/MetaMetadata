=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxGzSVGEeIjJfbiKxPTnpID6pwuJy_4wzINZ7LGXGasQ&oe=69B2AB0C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zhqlEGhSxsQ7kNvwFyWPq2&_nc_oc=Adlt-CVgx9TrXCwS9ySeeAmPPKmGM87jXleAjJZQu-PbNBH7Mvt-ZMcA5E6Z0G6EZT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhDQ4tx7CVVuwgh9PQuj0zJaS5q2dQ9pJSvU23VRRJ7Q&oe=69B29BD8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7mZHIA4oZEQ7kNvwEAVYpw&_nc_oc=AdnpikwTAguBZWolsFMV4dHM4tl3lG1du3ZhImGycYj2AvJXDT2i-e-CODo3tf2dP1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxr5CzEabmN9oxTstL6HXvDAcqEgD8NWdxQL_A9BkA1GQ&oe=69B2C466"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhHGztgiVRYQ7kNvwFHMO14&_nc_oc=AdnEEUv-bziRssZ-qyq_wzovWYI1Glray-hiJgJKNsgcT80Trs3JqSNgPxSv5G-oUE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1gVfxHGm6zQxWX9bf1x7531xt9uEND5W7raqKjVcFIQ&oe=69B2C41B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gZV6rKRckIQ7kNvwHa7UUs&_nc_oc=Adl1p6ge5oiA2yznthQ6SfxSU3jQGQWc8XC_XipJnADFbx6ZtQ6gvvPiB3ZS3iPAels&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAboSVB7Fh5JDyMLCHV7ZK-Y1a5UhdcRS8SvR6tNf2Tw&oe=69B2CB48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
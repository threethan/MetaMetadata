=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyg8nun1lpmK43GaIMk95zkQ-YQ_l0nvybCF_gdquGoiQ&oe=69BFDA0C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6pWna-nRzIQ7kNvwF-8ol2&_nc_oc=Adk5d8CkcxIHZK2nmyQtPyi9lzbXcAuKJYTKSgLZiKXVc3ftDlCAnmY5iIz3vqYK8tE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvB325JTjsDzt91SrqRfZfk0NV7actD3zEiJLSMgrJtw&oe=69C00318"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J98LmiHsvP4Q7kNvwHGgqyb&_nc_oc=Adnkfk9LbCneuHJP1b7AuWImxTxO3hYoPOK3wbWVMSO76vXjtWduqz5re-hJeCgFNpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkqeDwpAExDFW9WWvXBUnnSfb26sdWAtb3ZOzeS_PEbA&oe=69BFF366"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpoJMk-AC6UQ7kNvwED6FfW&_nc_oc=Adkuh_CqSWguMy1oaOwTYaFT1sF6XxeWimjTf8KFUuLsktkTr4W3WJ1l0Q41cO_9r7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUQQhEMRBuBvALi01JLJi55HGmlUHm2LxGoQ6DG6yQ7Q&oe=69BFF31B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH5nVVGiG3IQ7kNvwGqQknn&_nc_oc=Adnh1qOms5D-RSSj7dJw1kCfvVtTQmg32125Q6K-6ye2fc7Ex7jDOPYm2AJEu3IbO6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyepZwnpg3MECRcSe1j0-WFwLkgstNL-FYXvnshTQjUWA&oe=69BFFA48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
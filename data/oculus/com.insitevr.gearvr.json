WXX8-aCFaAw-dWBPs2Tg8VPjFqAIqDO98z6d8PA1Q5rT1Y7F0uw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdA-QeAwIf-pjJDD2sPoarU9l-VBdAKW4DL3PVmQpY1w&oe=6A5B8466"}, {"file_name": "migrated_image.png", "id": "852804571811468", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWPp2iRycF8Q7kNvwEM7aNK&_nc_oc=AdovkfNqo-RWww7v7SVHwyPVqaYA6qG9fL3DYU2-6WnRJrt0pEzh4rH7wv6qN5PiugU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb77ZY58FtQ5rEcKD86zW6EtRrnuJkA73MXRLi2Dvzgg&oe=6A5B8B48"}, {"file_name": "migrated_image.png", "id": "838181573351829", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162675_155896568313175_8952665191695253504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDHCAYlD7qUQ7kNvwEfuN_3&_nc_oc=AdrCOCLG3xYqyCLl3OJJMyf1vKBsHD3oRuElowWVRhsFaixYEwwruUZUAN3opW83ddc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs2n__Rs2G3VanxuWLqaIwJl7SrlTNBXzMq9ZbtEcclA&oe=6A5B61F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a leading VR presentation and meeting software for architects, engineers and contractors. Their online software converts 3D models and 360 images to be viewed on the GearVR, Oculus Rift and HTC Vive. Users can easily stream and control client walkthroughs in VR from their computer Users can control where someone is located, direct attention using a virtual laser pointer and leave text annotations in real time. Users can join in remotely from their GearVR, Oculus Rift, HTC Vive or Desktop and see their colleague's or client's avatars, talk to them through the app, and collaborate together on their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from InsiteVR.com.", "short_description": 
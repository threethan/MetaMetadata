=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGYqnvW_48TW0dJymPhuNddxZ4Au6jDTWaV0Bjuhu-LA&oe=69AEB68C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI91JSmFRLkQ7kNvwEGR0c4&_nc_oc=AdkgzvYVifvx_tJVfmME4DjM29XZR1Ni494aL5YYEYdEje2AIbU1Y1__0TomqoqVOIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwmj12OH1VfShoMBwn2QDZVLuE5n3jWEUz8pGBY6GbAOw&oe=69AEA758"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i88Ilras__kQ7kNvwEQqMLs&_nc_oc=AdkE65AzlA5krIsgIoqIyE020oQJNqgumAkuA_l_DdGbZMSPtCcSGHt_dq39tZKxOhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBK8Nz2ELRsAbhRPtfgcXzYIWblhgBDT20I6FcpGKU8g&oe=69AECFE6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-hfhsxEBsQ7kNvwG2SCoX&_nc_oc=AdmcDOCNXvjt5sieby93YfU9qlWMgZohqJcui79ElSFCPgJ5TJIxTGo1b-qQSahBepE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFlMkwbhoCKEkGhTn-vIar7xflarVWc9Cn56fmX08fPA&oe=69AECF9B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPFBMEDce2cQ7kNvwENSv85&_nc_oc=Adk3CEgWZwNe8S10i0BEhoFucse3OCAzLt_JLLTTdXQlY5ESrnbFR7_oCu6EoU-_9Rk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzmkwi4A8xEfOCdPWD50i9WbcLZSpY98cRpDzKAoQ6lCg&oe=69AED6C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
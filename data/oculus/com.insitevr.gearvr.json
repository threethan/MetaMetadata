wTjrq1acBOQMret-cwdVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpHA-vUDJzze8QrvUc9dnxWc1Xpbnp4me6BOCyVtF35A&oe=6AF4914C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LvdlldpqqAQ7kNvwHGkjSG&_nc_oc=AdqtMhi--tRPWOUxBlTLLeecVYR4NmozodELeUI0u56UavZK3XQv1k_6IZpHEmgsynw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsOgTnCcWkgD2Pt2TC-tDk31QTYefIFMtGu-07n7ajGQ&oe=6AF48218"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7B63S52-CsQ7kNvwFrma2i&_nc_oc=Adp8VHqJF_t7oidAlcsddDBQVBHlWlL8CPkGr7AXFSAKPJHzD8lTF4nmu-Ct2KjE7mI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp3MGCgjeajn33iV5MApwmb_XqeQK7AG1FQ9TMu8JAqg&oe=6AF47266"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh2_6mZbZHEQ7kNvwGlrEXq&_nc_oc=AdqRGUoE3J_fBiz2I373OiZ7OeH0FkSt1B0CYmSeJFwg2mKDLiKqsjiFxvob7d0PcJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuClJhVKePMsZjNtjQvFYN-239593-q5Z-Zp1eIkOyLg&oe=6AF4721B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayzdfSN8YLYQ7kNvwGxva75&_nc_oc=Ado-6cNphAoZ3FR_ZGY4azSO9vvmnG3lYCm_JS8e5nQS-Taib9JJsV1tINGfffiw2ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-sfFiZUoojS2WLU4az-0cYBNxhQKdtE3eMKy0ep4e7g&oe=6AF47948"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
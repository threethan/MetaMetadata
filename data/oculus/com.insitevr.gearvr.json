=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvjBbAO-MzR-SlRTrpAVEUTqleMrY11D_Q-zEFCLxOKw&oe=69B54E0C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zhqlEGhSxsQ7kNvwHUkF9J&_nc_oc=Adk85upKvUOHh70KDI_ABOUXW2r_suM9tG6iDK1VgTnrCfGqAuq5oZr8_K65yPG-U2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUXKG1uGUmVouGOEitRyXta1cF7qd044sxDUke9PXVqA&oe=69B53ED8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IryHD6ovf2AQ7kNvwErkXKo&_nc_oc=AdlCxNz2fVVdS37bePTk_KxSWhEdgOrfssgohQHk14FWIXBxs36AEG7S7gx5QGGnHwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWHF4WjeGcfPbx7-C1atCjZEIkgWCON1LDxpKdfJrtKQ&oe=69B56766"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IiR_lolrKYQ7kNvwH6xJVU&_nc_oc=AdkdLoZ81YJjV8LBLl9r-ZHv8k2epZ6xHWGL5Pc8LkVvIqFHjxlQJdbt3vDe5bQmwjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyFpPFIS9DjHRmF4g2LfgN5bUGIh9-EWgy7hUmf69YKQ&oe=69B5671B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gZV6rKRckIQ7kNvwEfFKLt&_nc_oc=AdktG_6wZ-IktPqshn27_1G_tTLaoXuvdzO9vYZMFluNMJj-xWltuLK7qOCsI8ad8KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpX7p3BXjjwscaqcJ9pah_zleD_gBe6_0tEJtvAKXsTg&oe=69B56E48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
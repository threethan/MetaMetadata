YynkzLekDqiac6VInD7Ko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U8dtQDlsTdvRsn-p-wMGtsPPzO-4sXcBZHOOZt9ngHg&oe=69DCDB0C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YB1kcmhQJ9UQ7kNvwGT8V17&_nc_oc=AdpQFat6JuO04EHPwoqvie1q_ZqDhckCJLbkkqpQBDDcudkJkiJgp9RO5lD9oMjDpL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iIPRRpYC2yZVAy9aDIraMi_wfD3fPiE08RGA16Omd0g&oe=69DCCBD8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoBuROJ3P3wQ7kNvwESb0W0&_nc_oc=AdoO9bJ7tg7TpGD_d1UPryiyTu4DyYBXz1kYqw8RTHfJ1_-ign6PkiQarOERtjt5fKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q1vXL_zB5728WYAr8OAIxVS7zInjvvXlUlYsYOw4UDg&oe=69DCF466"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z786yojVHjYQ7kNvwEtdCS2&_nc_oc=AdpmLapebTOMueHBmpelF7cP9U7dJKVg1KM11HMejkHJem2o9wRvsFDDOhEoK3Ng_UU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b-SeRF16fThYwI3CcrAg8qZxibufvKzUq5sCJwfBlXw&oe=69DCF41B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Vo6NjwT4iIQ7kNvwF-KSXX&_nc_oc=AdpfGeLSQqdNaMVX6gLk5DMFEEb6A8EuIG5uYRZvfu1Kknk8mhZjBtF2lU-boZtibrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aznI8liCM5Cv68R8zBxh1ovsyxxqJCR5oyObbJAUnkg&oe=69DCFB48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
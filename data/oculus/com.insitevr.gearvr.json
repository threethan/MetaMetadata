rIzO5kNkGbayhJx_U11Ih9QY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g8HlzR_3yvofu5WsS22wPzWqaEbFLTAdvgjS01ZrKMg&oe=6A468B4C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlpzDtv2BGEQ7kNvwFjcDpP&_nc_oc=Ado_MpyWEl5uIVMtIOAnGxwRHzITHcdGPxjrXEMVb_YaBfOyjgw5KCSmAyvcEBvV7xs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9R1BrEebYs40dRoPWAjPBqmEbQu01AHiwnLNcnB0L_g&oe=6A467C18"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdMr5X4l4JUQ7kNvwF8M9TT&_nc_oc=Adq1XDZ3kfCJuDI4WvZsqKi37bS7LgOWw55XNNDR5_iqdx5H3Np68ifiHz201fRA5gw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fm6IlXEqQwnBfcXyM2NC5QSUNGkyGu-rYSImYQpdXHg&oe=6A466C66"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uLESsZxZ3EQ7kNvwEYcCxK&_nc_oc=AdodRMoi1mxXTGFyWiKTO_GlHSxi8bRByYo4FdOTxbuyk2d_lmcupmH4bgxq6zUYZQU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QTotBVDZU5MiDABp81XpLrajiYuTWsHE1qoP02YF86w&oe=6A466C1B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=960c60RktpAQ7kNvwEWIIHQ&_nc_oc=Adog7vqhzpFEEgYoqjcmijTVql7IMIAO_Lqhw0xrgdujHybUQ96trfUqtlruLp8QuOo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y1GB-k4XA0_bb_KU49-i4CwYDoE-zsjktOyCAxvDMyQ&oe=6A467348"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
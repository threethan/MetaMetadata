=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxgie7LsVQSdzWL21eJLDNmRMsFVqzHDKamdtoopyoMeQ&oe=69AC138C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMKbR4mK3_MQ7kNvwHVrIg1&_nc_oc=AdkS1qXTEFGnFdfpmXGUmvs9M9bdDyXMsbSgXjKeg2wxilBW0wfgvymEw7YIcwR6d8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9zKhRe2pQGVIXPlNbAQx_tWNi8CDV5W5i23-ZhKFHBQ&oe=69AC0458"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btvMc6s5ZpsQ7kNvwEuzh5D&_nc_oc=Adn3ktyQHdYiBx-MBD8JOJL9OML8zQU75186WZK6u2j3ryncC2pSY8U9wwpTuo9T6y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBmkzmPqwWF8hcMe1n8w24DTMZlJn5KjTZuAMhxNHazw&oe=69AC2CE6"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4bFFWSHbskQ7kNvwFhekC-&_nc_oc=AdnLfBt3FlHQMCAMjT9wYekTQKktz3hjdscad3j2N9T_ESDXWLyiBrnDt4BAY8sEL5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUfnlmuW3bjO2WKbBzFhEYKfTzwy57glP9jAv3LNjbvg&oe=69AC2C9B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82Vv8lHO9FAQ7kNvwFd_kny&_nc_oc=AdknEXRqx0CPB98HuHjrrFQKjPkwkhG0_xSmwVei_fv4qq5wfMhkYTbrrRjzaQEwkzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSm6sVWaPalWWg_agQUB4dFBQLzlGB7W5vqR2GKvUZ2A&oe=69AC33C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphi
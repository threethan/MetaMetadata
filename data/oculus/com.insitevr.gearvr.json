7_oR8bVvPAsBFv9zbzCHw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj00lB8KCm2aEnjzT0P930hWVGkv1IzkZg1ThpTIBjvA&oe=6A883E0C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oO0fGAoXSIQ7kNvwEKqAVF&_nc_oc=Ado7Ktw7eGIsZ-temx9ApHJyvqYd_MRkCyZ-PH5cJ4Q4HbsJUk9uGet-V5YbsvgKwWU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtybTBfcWaz4ptK_nXxq3XKkaFiXPyprZ_KKd2GIauGQ&oe=6A882ED8"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mThYv9IvONcQ7kNvwGCx-iz&_nc_oc=AdrVMj10LnLUmlaMkU00Wbz3Utgx0WEnUH9H3zRs9-6m8r4Lp58BHH7ggR1kacWHkts&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt0ifixlZlWVD3KpadUOx2U7zBgKqEnPG7zvil6idByw&oe=6A881F26"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jH2PxLQJ-cQ7kNvwEeOgNt&_nc_oc=Ado8Z2zwOPSJ1MSLGHkB98D_9uYuQDO16ga-Nbzl0oK7GotnUIXgRyRQDDAZM_R0BXM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGchSjp1tipGDAwbGEwSEiL7iLqs4lCMje_nRuMVO9kmw&oe=6A881EDB"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-woBaMElaOwQ7kNvwF1KsUH&_nc_oc=AdqfplCkUQxHKZUbraSuk3fkiIlIHlxg9kSve0YVIrNuHqTfFQeW5FaYIoNxe2iguPk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxWPECZ0SmJh5dKCStXKOYqBNJJ_6Wf_GQLGI9ibY_WQ&oe=6A882608"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_D
IQgtQ_tsUwHnrTY7M8zjhKSw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LgjuZ6CiCBbaqyCBJ27RlHgLOXpdVYQ1swaR6cuI6BQ&oe=6A11CF4C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppnMkNG7wk0Q7kNvwES-4LE&_nc_oc=AdrKe72m_CTIojYD-OUo7qw6KOF4QX_wBdZcdSNdcxc2zBFFjCMamtNytgW1Ut6-Rkw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Om7zc5-ypQmkAERrJDGauGC9MU1Uwp93FgzU6x7lVog&oe=6A11C018"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUrA8HJPqtgQ7kNvwHKrj91&_nc_oc=AdrKnYYSnDQyKMAbB7hvs0tiKPy-WEEMt8JHQncJLAviNbLFc_1-FLOladg3bazvVyA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UuEN0ONFvDgj-V0BOKYMSce5tecUBMvOSLw3RyY2mTw&oe=6A11B066"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZLbGfA8D4YQ7kNvwHZbtNT&_nc_oc=AdpdxmghtwCLWLonZGZ-kZHEUHzg1EY2V8ozgm4M_ZUdQoJVjLsVd4EsTdy_L8IybqM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YaEr5ggaNFGREMfAWsxrqVpN4LWBEOMPw9vsiuAfJ0A&oe=6A11B01B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwoa0VoUlaAQ7kNvwGuKBk7&_nc_oc=AdpPyPMPyDYtNdL4rXH-OeCS56_6xdNqy8pb0wbtUEPGrvpMP-TCCGyOFZbQgucXYEM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xt-LCjjr4NcbRreZZZ_2DKXbOEIgFtBTIzv-yObCoUA&oe=6A11B748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
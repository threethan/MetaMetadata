dCiVDk8Got0QDdE2qM89YfFM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YCoSS8myvQTgeoLV1573C2jVpkOyhLwlmIOH7mchjOA&oe=6A36B94C"}, {"file_name": "migrated_image.png", "id": "600820777171237", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162693_1913356142264158_8785886075378728960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9313PbSCsoQ7kNvwHJfL7d&_nc_oc=AdphSdxBYUyxLuMz_CtC_NWy_tGs2W80-rceSNTcrdchN7Kguy4sX_1QwDHFqu7-OeY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wBO3aZZ_BmH7zsFQp5MYDmB-bLy2EQ39z_f8DwPCEmg&oe=6A36AA18"}, {"file_name": "migrated_image.png", "id": "580432652818374", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162688_156446138260597_7102173721850281984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsaNcd1xeC8Q7kNvwGSAn_2&_nc_oc=AdoUZ2A7YMcousrHoqnmSrXWOUT2l1ZL7nOCqNDPn63Ao-Fud_LnTAy81bmaM50DIOg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KJEWbCnT_l1_ubDe-qI2cbnR1rrbq0qvHFBoFRwtdKw&oe=6A369A66"}, {"file_name": "migrated_image.png", "id": "142607147121599", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162741_256625708159507_5236348527268855808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVSYb-JiurQQ7kNvwGmapcp&_nc_oc=AdpTEfQYoUY3h-5sw9PqXQkXr0PLwt0Kk2CJY8vvtf3qTr_-eROQuEBE_hRnRasBlmc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uvmdSTOkyCedr7FkZzToFtYmy4dpDFSLP_Beqr7OAyA&oe=6A369A1B"}, {"file_name": "migrated_image.png", "id": "3099383750126290", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162706_1478703215556507_6004364851038650368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aYCUCKek_IQ7kNvwFunUVg&_nc_oc=Adqai02JCTVZkRg60Zzue6pI-Oy21mzB7kDCQviqQigjuwIws7wItn_ICfIhtMVDED8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lEek9gTfbp8bdvcDq8Eykyi1XNtZmcCRAkUlnsRQhgw&oe=6A36A148"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InsiteVR", "keywords": ["Architecture", "Engineering", "Models", "Revit", "Sketchup"], "long_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms.\n\nMeeting hosts can gather everyone to them to discuss a particular issue, direct attention using a virtual laser pointer, and leave text annotations in real time. Users can join in remotely and see their colleague's avatars, talk to them through the app, and collaboratively review their Revit, Sketchup, FBX, and OBJ models or 360 Images. InsiteVR comes with a Revit plugin downloaded from www.insitevr.com/downloads.\n\nTo learn more about how firms around the world are using InsiteVR to review building designs and prevent costly design and construction mistakes from happening check out our blog: https://blog.insitevr.com/", "short_description": "InsiteVR is a cross-platform VR meeting software for architecture, engineering and construction. After uploading a CAD model, users can start virtual review meetings with colleagues from around the world. InsiteVR supports Revit and Sketchup models and 360 images to be reviewed across Oculus Go, GearVR, Oculus Rift, and VR devices on other platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.insitevr.com/privacy", "developer_terms_of_service_url": "https://www.insitevr.com/terms", "publisher_name": "InsiteVR", "support_website_url": null, "website_url": "https://www.insitevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
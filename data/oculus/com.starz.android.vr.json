s. Full downloads."}]}, "developer_name": "Starz Entertainment", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://assets.starz.com/PLAY/terms_privacy/new_terms_Oct242013.html", "publisher_name": "Starz Entertainment LLC", "support_website_url": null, "website_url": "http://www.Starz.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "295085239355763"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "757261658087384"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577383260, "status": "PUBLISHED", "id": "757261658087384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2840661372633306", "version": "3.2.1"}, "id": "489870218090243", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085468338152617", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2840661372633306"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "489870218090243"}]}, "change_log": null, "created_date": 1575571366, "id": "2840661372633306", "version": "3.2.1", "version_code": 7106, "release_status": "RELEASED", "status": "APPROVED", "binary_test
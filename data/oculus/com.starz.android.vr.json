t started? Here\u2019s what to do:\n1) Go to www.staz.com.\n2) Start your 7-day free trial. You can cancel at any time. \n3) Create your STARZ profile.\n\nFREE TRIAL OFFERS ARE AVAILABLE TO NEW CUSTOMERS ONLY FOR A LIMITED TIME AND MAY VARY BY PROVIDER.", "short_description": "Obsessable Original Series. Hit movies. Full downloads."}]}, "developer_name": "Starz Entertainment", "developer_privacy_policy_url": "https://www.starz.com/us/en/privacy", "developer_terms_of_service_url": "https://www.starz.com/us/en/termsofuse", "publisher_name": "Starz Entertainment LLC", "support_website_url": null, "website_url": "http://www.Starz.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2967963340122037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_298912394160892_6828851413406187520_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5m1v-wyS4oQ7kNvwHlRe-8&_nc_oc=AdlfZpaadHaKXqLQaeOmTaioi4w-85sKMtBezfqLr25v4IDWPntgaO66clXnsVEExYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs0GjbvLSTI4Sp007jcEZm5FjpdaBUEiToAOJdJNtKElQ&oe=69A6BE04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STARZ", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1577383245, "lastRevision": {"nodes": [{"id": "1804050563056214", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": 
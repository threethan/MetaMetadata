_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXuCq68N8vGq1SP2WLjzRNYIWv9CSjU6paI8Up1RKizw&oe=6AE893D3"}, {"file_name": "ScreenShot05.png", "id": "786517643846512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823485_786517647179845_5199774937024863243_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yoa_uvfxMQcQ7kNvwHFGyij&_nc_oc=Adr9kXpX1aZCoaZJgN9_qEQ0xiHwXBrToHgXyG88yM8jB4JmLITwomEQULOhy4oNkp0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFp5A_TnlO_amhDj2XQYfPzfHr0GacaIllcb1vT1cskA&oe=6AE8B293"}, {"file_name": "ScreenShot02.png", "id": "1037169681639315", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830032_1037169684972648_2573263878473393821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXzk-HHVCIIQ7kNvwH8ttVS&_nc_oc=AdpE_54jRDcC1PgftNVBV-4O7paYFXi5RacuBx_35hhmgpIO5TlDI5MnAWP0jzCOYn0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqxq4_YRThHj-hzQSxll9VulOfigRDgq87Mb2P21YUJQ&oe=6AE8C119"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "climbingcover.png", "id": "2517826791910999", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499305194_2517826798577665_6353908865809831431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0SZOTef_ycQ7kNvwFhmc_b&_nc_oc=AdqdvyH4TNG8CBZuzjPhCb-WVxAR0fvbez59jBGjyW7vnD41aYix4YmFiS017nbLK6I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeb7j3HOBa3S719RppUM-HdiXdEDgajtPYb3e73penOQ&oe=6AE8B41D"}, "display_name": "Infernal Climb", "keywords": ["climbing", "platformer", "rage", "hard", "climb"], "long_description": "**\u201cThe best, most intense climbing game currently available in VR.\u201d**\n\nClimb, fall, and repeat.\n\nInfernal Climb is not your typical climbing game.  You, as a lone robot, must climb over 4000 meters of vertical hell.  Navigate treacherous grips, unpredictable throws, and countless intense obstacles. To make things even harder, your grip only holds for so long. \n\nInfernal Climb will push your skills to the limit\u2014and beyond. You will discover your limits and then shatter them. The physics-based gameplay delivers a thrilling, chaotic, and sometimes rage-inducing experience.\n\nFor players seeking a more casual climb, multiple customizable difficulty settings are available. Just remember\u2014altered settings make any speedrunning records invalid.\n\nDo you have what it takes to crawl your way out of hell?", "short_description": "A Rage-Bait Climbing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24730712966553673"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "769957615882293"}, {"status": "PUBLISHED", "id": "751420334549023"}, {"status": "PUBLISHED", "id": "1357939622525641"}, {"status": "PUBLISHED", "id": "1263162712273894"}]}, "baseline_offer": {"id": "769957615882293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758659160, "status": "PUBLISHED", "id": "769957615882293"}]}, "liveChannel": {"nodes": [{"la
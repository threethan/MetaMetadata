7&_nc_sid=6e7a0a&_nc_ohc=swtPKEKk51wQ7kNvwFe5nHN&_nc_oc=AdqJT8FL9LgBA1Sox-gbOglL6JsMlpNW2n805N9qST8tJX760thQ6ywGWj_X4JOah2c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZWrk3Xuqj2CWQcUG75gThCqLjOlUzS7zlS2tK9sbQUw&oe=6A26BC59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "climbingcover.png", "id": "2517826791910999", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305194_2517826798577665_6353908865809831431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBOVPLGeO8kQ7kNvwEP5w-g&_nc_oc=AdqTIlOe8kdLBNqau8V9Woo9Vi-qKI5wLghPVmZ0fMElDkeb8AbF6Djqyy_zMxcmeKQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ODiP3E0IIY875-N-wFoMtJ4Hwqp3x7pCGpETJhwavcA&oe=6A26E79D"}, "display_name": "Infernal Climb", "keywords": ["climbing", "platformer", "rage", "hard", "climb"], "long_description": "**\u201cThe best, most intense climbing game currently available in VR.\u201d**\n\nClimb, fall, and repeat.\n\nInfernal Climb is not your typical climbing game.  You, as a lone robot, must climb over 4000 meters of vertical hell.  Navigate treacherous grips, unpredictable throws, and countless intense obstacles. To make things even harder, your grip only holds for so long. \n\nInfernal Climb will push your skills to the limit\u2014and beyond. You will discover your limits and then shatter them. The physics-based gameplay delivers a thrilling, chaotic, and sometimes rage-inducing experience.\n\nFor players seeking a more casual climb, multiple customizable difficulty settings are available. Just remember\u2014altered settings make any speedrunning records invalid.\n\nDo you have what it takes to crawl your way out of hell?", "short_description": "A Rage-Bait Climbing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://site
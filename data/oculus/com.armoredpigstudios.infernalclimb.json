1.oculuscdn.com/v/t64.5771-25/491827096_1126415616074324_5658894417357489891_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZrbBnkN_1UQ7kNvwE8vm8E&_nc_oc=AdrFMFbXCEFt1vGrYLm68YQfgSl8vSyevfMThTXsYJNZJSKOPJCwKxQ12dHrWHpEscM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe9lBf1xR7wYRVY3B7ohbUqn7rkKJK6sN6Gwxg8WUvAg&oe=6B087013"}, {"file_name": "ScreenShot05.png", "id": "786517643846512", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823485_786517647179845_5199774937024863243_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDb5iT4bHzcQ7kNvwFv7Cl8&_nc_oc=AdqzRpFMpMnq595IJ99SgdpZVdatBQ2lZETpwIRe4S4ZkSNcppLG4haPllFR4fOmg_Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4oqjXiKERBOjOj-Fe81jjmX-eFQxNR4qmh85V_vUnSw&oe=6B085693"}, {"file_name": "ScreenShot02.png", "id": "1037169681639315", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830032_1037169684972648_2573263878473393821_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxHH5IV9ttwQ7kNvwFCGYaQ&_nc_oc=Ado2MnNNYeW-18pleRHjJY8VUpffnWUz7k_bZ2CWk-XYct0FinNieOeP28w0E8_92BU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_6sbPGMmMwNIu-HGtfEGsbMYm7zRXuQevvFXwRglmpQ&oe=6B086519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "climbingcover.png", "id": "2517826791910999", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499305194_2517826798577665_6353908865809831431_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5w4XM9OSz0Q7kNvwFX82PL&_nc_oc=AdrOqNr5A5MJma3NrHHd0IthGABlf5Vs0COenwDXnf8AUGnlrAjz-T-6WQM-9pVFq7k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy1RcE69V6J9KnmsRGdNJxRDsnHNlB_RNEUj9ob2Q5og&oe=6B08581D"}, "display_name": "Infernal Climb", "keywords": ["climbing", "platformer", "rage", "hard", "climb"], "long_description": "**\u201cThe best, most intense climbing game currently available in VR.\u201d**\n\nClimb, fall, and repeat.\n\nInfernal Climb is not your typical climbing game.  You, as a lone robot, must climb over 4000 meters of vertical hell.  Navigate treacherous grips, unpredictable throws, and countless intense obstacles. To make things even harder, your grip only holds for so long. \n\nInfernal Climb will push your skills to the limit\u2014and beyond. You will discover your limits and then shatter them. The physics-based gameplay delivers a thrilling, chaotic, and sometimes rage-inducing experience.\n\nFor players seeking a more casual climb, multiple customizable difficulty settings are available. Just remember\u2014altered settings make any speedrunning records invalid.\n\nDo you have what it takes to crawl your way out of hell?", "short_description": "A Rage-Bait Climbing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24730712966553673"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "769957615882293"}, {"status": "PUB
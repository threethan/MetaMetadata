TgQTCDnjOsNDGSq926NfX9iGhUvradS4e2rhOKs0Lw&oe=6A674753"}, {"file_name": "ScreenShot02.png", "id": "1037169681639315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830032_1037169684972648_2573263878473393821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctgA0XxHKvwQ7kNvwHqARtS&_nc_oc=AdoDDDCZUEvk-EvABKUQLt173QR53BPEBNztPt55aky8JNMYVTGGPBo-tJR_S-TH5LU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR391humVsHytenT5gRDfhUF9L7l7nL5tAER6cmSINzg&oe=6A6755D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "climbingcover.png", "id": "2517826791910999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_2517826798577665_6353908865809831431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43vXU29rMTUQ7kNvwE7dR3E&_nc_oc=AdoQtsIlJGCHcV1OJxDdCAnaBLWYMKkQBrS4bKCB8O5P9___PL1TZ-aD5eojb8AjWL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwfBQvgQFPoB9Dce-ZJV4VTN86lvHCEy1tyiBo394c2w&oe=6A6748DD"}, "display_name": "Infernal Climb", "keywords": ["climbing", "platformer", "rage", "hard", "climb"], "long_description": "**\u201cThe best, most intense climbing game currently available in VR.\u201d**\n\nClimb, fall, and repeat.\n\nInfernal Climb is not your typical climbing game.  You, as a lone robot, must climb over 4000 meters of vertical hell.  Navigate treacherous grips, unpredictable throws, and countless intense obstacles. To make things even harder, your grip only holds for so long. \n\nInfernal Climb will push your skills to the limit\u2014and beyond. You will discover your limits and then shatter them. The physics-based gameplay delivers a thrilling, chaotic, and sometimes rage-inducing experience.\n\nFor players seeking a more casual climb, multiple customizable difficulty settings are available. Just remember\u2014altered settings make any speedrunning records invalid.\n\nDo you have what it takes to crawl your way out of hell?", "short_description": "A Rage-Bait Climbing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24730712966553673"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "769957615882293"}, {"status": "PUBLISHED", "id": "751420334549023"}, {"status": "PUBLISHED", "id": "1357939622525641"}, {"status": "PUBLISHED", "id": "1263162712273894"}]}, "baseline_offer": {"id": "769957615882293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758659160, "status": "PUBLISHED", "id": "769957615882293"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24758147163810253", "version": ".2"}, "id": "4133471316930181", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24595266140098357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "247581471638
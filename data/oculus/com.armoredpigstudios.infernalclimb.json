: {"file_name": "climbingcover.png", "id": "2517826791910999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_2517826798577665_6353908865809831431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRG-4i2fIf0Q7kNvwHh1beF&_nc_oc=AdkHo9g5WObQjsAP1J4jG45NXBA8tmyNihy2d9eb7bP_bmkmrm73zsROtc4FOEpIvsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwn5hyfIMhOd6o_pTKSXCkH3RNkvG_xI7OWNgVIT_rJ1w&oe=69B942DD"}, "display_name": "Infernal Climb", "keywords": ["climbing", "platformer", "rage", "hard", "climb"], "long_description": "**\u201cThe best, most intense climbing game currently available in VR.\u201d**\n\nClimb, fall, and repeat.\n\nInfernal Climb is not your typical climbing game.  You, as a lone robot, must climb over 4000 meters of vertical hell.  Navigate treacherous grips, unpredictable throws, and countless intense obstacles. To make things even harder, your grip only holds for so long. \n\nInfernal Climb will push your skills to the limit\u2014and beyond. You will discover your limits and then shatter them. The physics-based gameplay delivers a thrilling, chaotic, and sometimes rage-inducing experience.\n\nFor players seeking a more casual climb, multiple customizable difficulty settings are available. Just remember\u2014altered settings make any speedrunning records invalid.\n\nDo you have what it takes to crawl your way out of hell?", "short_description": "A Rage-Bait Climbing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": 
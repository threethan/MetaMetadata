"}, {"file_name": "icon.png", "id": "1094127428984798", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820219_1094127432318131_15320932650232155_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjcNIS1iooMQ7kNvwHRnEVK&_nc_oc=Adri7MUuZkQ0VTFm0UPzFxlyyPe-MtPoKU6Hrzv81u3Je6ulvdN0HBik0cioNmu3cD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPqgBZynAE5IPHSZrK1WTj-T97LbcDOmrDMU2Z73NUsw&oe=6ADE0BB6"}]}, "id": "800569072406933", "locale": "en_US", "screenshots": [{"file_name": "ScreenShot01.png", "id": "1333946248085321", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821955_1333946251418654_2832846533799119040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exjWKwRepTQQ7kNvwFslI6u&_nc_oc=AdqC9K3m886MaRZ0UJoCcylNXC7bMskNxKtWspv60saijugoVo7u5tGtUMuZivynfwI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-rMR_n2rniJWU5UuxsriTUGVmQlslaf5HylTTWl5VwQ&oe=6ADE1761"}, {"file_name": "ScreenShot03.png", "id": "24372223659099612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308103_24372223665766278_2588257053714524944_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6del5D4kDI0Q7kNvwF0DzXv&_nc_oc=AdpHEoL06SjO9k0G-K2FX0FnGlr_dcYV8MkQnOzlX02LcejpANRkb3ySFtLnxID53_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzkNj19EJhgrCf346c26qqWDcKczuc8VcRh4h97_GfzQ&oe=6ADE0925"}, {"file_name": "ScreenShot04.png", "id": "1126415612740991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827096_1126415616074324_5658894417357489891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOArMFuTx_4Q7kNvwFbGEqK&_nc_oc=AdpELOhftlHOcE7oZBDyyXxuegc21Ci_QBdCMjGXDmjcwVnD6hXPj0jfYNSngWJvZjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR4gyRENx0-JlMMrb2UfsAb46wxQ7EJIr0beowKvRwcw&oe=6ADE07D3"}, {"file_name": "ScreenShot05.png", "id": "786517643846512", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823485_786517647179845_5199774937024863243_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_l7GJJY96YQ7kNvwHtbNNh&_nc_oc=AdoEl3hasWrnde6j02dTGu4r_fZXUH3CmiYvCGEbqx5_JYZ7kbyaAb5p4_PR-3135RI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrhvZcB2C_X85bPdYY1cc3CUXHswrtYZ9gPj5A5c80nA&oe=6ADE2693"}, {"file_name": "ScreenShot02.png", "id": "1037169681639315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830032_1037169684972648_2573263878473393821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lennM_7cUFUQ7kNvwE-nPRQ&_nc_oc=AdrEv_is7phYn__UtpB23-KZbDArVdCGKgzNqh-RmQwZqeFP4iaITAAq8SIBrTJJPRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZdXEGng9-MB6Gy3gNA0nhMWbipm3CAeP8BBY3tLR-Gg&oe=6ADDFCD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "climbingcover.png", "id": "2517826791910999", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305194_2517826798577665_6353908865809831431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaES4C1LGR8Q7kNvwEp4DRn&_nc_oc=Adp_ptnqiWfb9MEWGiUAoSeV02S2jwJ7lFGWJ-s-7PXlM5_S0JNRfIAYVjctT8heq6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_dFwMjGIKTyzn_yQ_EuHLD-bfXHAfeTOl0GHkykyZRg&oe=6ADE281D"}, "display_name": "Infernal Climb", "keywords": ["climbing", "platformer", "rage", "hard", "climb"], "long_description": "**\u201cThe best, most intense climbing game currently available in VR.\u201d**\n\nClimb, fall, and repeat.\n\nInfernal Climb is not your typical climbing game.  You, as a lone robot, must climb over 4000 meters of vertical hell.  Navigate treacherous grips, unpredictable throws, and countless intense obstacles. To make things even harder, your grip only holds for so long. \n\nInfernal Climb will push your skills to the limit\u2014and beyond. You will discover your limits and then shatter them. The physics-based gameplay delivers a thrilling, chaotic, and sometimes rage-inducing experience.\n\nFor players seeking a more casual climb, multiple customizable difficulty settings are available. Just remember\u2014altered settings make any speedrunning records invalid.\n\nDo you have what it takes to crawl your way out of hell?", "short_description": "A Rage-Bait Climbing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24730712966553673"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "769957615882293"}, {"status": "PUBLISHED", "id": "751420334549023"}, {"status": "PUBLISHED", "id": "1357939622525641"}, {"status": "PUBLISHED", "id": "1263162712273894"}]}, "baseline_offer": {"id": "769957615882293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758659160, "status": "PUBLISHED", "id": "769957615882293"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24758147163810253", "version": ".2"}, "id": "4133471316930181", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"no
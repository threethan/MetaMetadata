nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC2d8ffWJ2EMzZM0v6bvDuE86AWRll9DIFI7uG-SISJA&oe=6AC4F71C"}, {"file_name": "DIGIMENTAL2.png", "id": "1060515260298270", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831964_1060515263631603_8698408771466165962_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU706vW2mjMQ7kNvwGkAW1f&_nc_oc=AdqCye8_jnesNju2dpK93M19sSJVTrQhPQIsnQgscEhYHMfFsr9iagiO6Cd9I2x5qso&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg4vkpNnzrBYIypAU-efq1ZQTCvxgavGdvDz2d1w1KMw&oe=6AC4F4BB"}, {"file_name": "DIGIMENTAL3.png", "id": "3607991252686309", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_3607991259352975_5622546035536239307_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9aotjPPKSoQ7kNvwG-K7ch&_nc_oc=AdqBJ4fYLKB82Ql9WH6aWabl0kxi66dZyMccz1YGLFSLRQG7vQ0C1nx8lX68RKa05tE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOj7mrndaDCx9J0vDzi5oE-hgdUW_Qzc4Vuy7_0PkzTg&oe=6AC511DD"}, {"file_name": "DIGIMENTAL4.png", "id": "1562948294849061", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831964_1562948298182394_2760138903829400454_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TacYDbEe8hsQ7kNvwFQldYp&_nc_oc=Adpm4H30T8tXqUgQ_F6UhsbtwzqrTlR50rHflwlB-QAJZ8768_O_2HBHAOUuLqznWD4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvRr90baYcYC5vh9giYDkvxETB3etQTQxizudx2Xeipg&oe=6AC4F78A"}, {"file_name": "DIGIMENTAL5.png", "id": "1755015525646627", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_1755015528979960_5422259829880149918_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssILgWMvCU0Q7kNvwG-1D5U&_nc_oc=AdokVSKgb6pugmgZUSEX1uefquHaCjRaktldhwjCAxOIRulxGmUyDb9DZgTL4HjCnTw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnEOOEJovJH5KxlR7Veja6p8s4FNNTbXrH3FVUaT8kQQ&oe=6AC506C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DIGI-MENTAL", "keywords": ["wellbeing", "education", "relaxation", "breathing", "mindfulness"], "long_description": "DIGI-MENTAL is an immersive application designed to promote wellbeing awareness among adolescents and young adults. Intended for youth workers and educators in educational and community settings, it introduces young people to the concepts of stress, anxiety and burnout inside a calming virtual SPA environment.\nParticipants are welcomed by an abstract avatar composed of thousands of luminous particles. Through three short educational speeches, on stress, anxiety and burnout, the avatar explains how these experiences can emerge in everyday life and why recognizing them is essential for wellbeing.\nAt the entrance, each participant indicates their perceived stress level. The SPA responds: weather conditions, sounds and visual cues change accordingly, making the connection between stress and emotional states easy to grasp.\nThree guided wellbeing activities are then available:\n- Breathing Experience: simple breathing techniques to promote relaxation.\n- Imagery Experience: guided visualization exercises aimed at activating positive internal resources.\n- Mindfulness Experience: immersive mindfulness practices that cultivate present-moment awareness and attentional focus.\nAll speeches and instructions are available in English, Icelandic, Spanish and Italian.\nDIGI-MENTAL is a wellbeing tool, designed to be facilitated by trained youth workers and educators with their students, developed within DIGI-MENTAL, an Erasmus+ project KA220 co-funded by the European Union.", "short_description": "DIGI-MENTAL is an immersive experience that promotes wellbeing awareness among adolescents and young adults. Guided by an avatar of luminous particles, participants explore stress, anxiety and burnout in a calming virtual SPA that reacts to their stress level, then choose a Breathing, Imagery or Mindfulness activity. An educational tool for youth workers and educators. Available in English, Icelandic, Spanish and Italian. Part of DIGI-MENTAL, an Erasmus+ project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.discoverbecome.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unreal", "support_website_url": null, "website_url": "https://www.discoverbecome.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "es", "is"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1773097633818603"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595119480_1735863207564989_1395722251889679078_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVuTebGasGsQ7kNvwG-x-7v&_nc_oc=Adq7WQ2aBFBD_qUgByd-86ANhqZ7NkQl3gRikhpLebNAM_FMRGIUxlk1PQ8rEbevK9U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJGerZLXkuuP9Wtv9q-XNfS0ZaLACgIVA_K51TgKjVuQ&oe=6AC51D27"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DIGI-MENTAL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1789384740, "lastRevision": {"nodes": [{"id": "1741129327015434", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1741129293682104", "is_first_party": false, "enables_in_app_ad
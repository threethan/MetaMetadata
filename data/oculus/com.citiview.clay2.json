ent-dfw5-1.oculuscdn.com/v/t64.5771-25/673780696_1759205155351971_6287609422330518280_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfiITMDdR4IQ7kNvwGmdQgT&_nc_oc=AdrRjaz4Uvife8X6fFjAMUTfx3lS7e-zcIgo9_dYJhGuHFP1m5saDExk1CbMxiykd-M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEbdZiJON_DShOeAlMlA9acow6aUSdPXmJPDHv6ceg_g&oe=6B08432B"}, {"file_name": "screenshot_3_2560x1440.png", "id": "2381488002703483", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595129854_2381488006036816_8367897073221500335_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b55TEd5lFFgQ7kNvwGozFZC&_nc_oc=Adr1i87vURbqhBn9LG6BJyzzpL86_yapOJi-SzZDcQreByzjDCmzaMby0yRCGEj4ilY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqBFDZUhSXd-6Sydsv7g9hmn-Z_jzqCUluXRPzuxPOVA&oe=6B0860B8"}, {"file_name": "screenshot_4_2560x1440.png", "id": "3399337173599362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_3399337180266028_7075943390701540157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oci__yFf5vkQ7kNvwEYIXrq&_nc_oc=AdrNVfSf55uO3EsOIVR1HBRfUZVxpLywN-HWwikO11KsxAo1WuNKWzEzpxVgitziEjA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1N8JcgrNurgpOXQ9J-CywNKVb8_KGr-qLJbcqBW2_BQ&oe=6B084D3C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1123159533606333", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596068480_1123159536939666_7511649016247633867_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee8ezy-UQ10Q7kNvwG7ng0V&_nc_oc=Adqrmbx0IQHisonFYjplbgpqJvWLqCCiKe98vgyJMfgrLU4F6orYOvAJLHvWGiVAbtw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkM3nMGgbE9WTIwR5mhqijjjwF1k7ZRkv9z4t475IwIg&oe=6B084237"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2563361987470792", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595119480_2563361990804125_868122690924657977_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkujRC3LnWIQ7kNvwHoKMyV&_nc_oc=AdquPIM2rdDsteObiOPWI3eyKiCmXvAxi3PsRQkDtueb89Pz0dh1JyRRcXLW1B9ZUjc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThBrPr7zAfWb81g86jM6FkiwQFtuQV1isS668AiVgoDA&oe=6B0860B4"}, "display_name": "CLAY 2", "keywords": ["pottery", "clay", "ceramics", "kids", "sculpting"], "long_description": "CLAY 2 is a relaxing VR pottery studio for Meta Quest, built for kids and families. Pastel walls, a rubber play-tile floor in every colour, a cloud ceiling, smiling stars and rainbows on the walls and balloons at the ceiling - and outside the glass door, rolling green hills, hot-air balloons, kites and a castle under a rainbow.\n\nSHAPE IT WITH YOUR HANDS\nHand tracking puts your real fingertip on the clay. Squeeze it tall, open a pot, pull the walls up, push out a belly or pinch in a neck - the clay keeps its volume, like the real thing. Controllers work too, with a little stylus finger.\n\nFIVE POTTER'S WHEELS\nTwo wheels by the big windows, two in the kiln room with the glaze buckets and drying racks, and one out on the balcony facing the cartoon world. Each wheel is its own colour and remembers the pot you left on it.\n\nSEVEN DRIPPING GLAZES\nFour clay bodies and seven glazes - celadon, cobalt, tenmoku, honey, speckled white, turquoise and sunset - shown on your pot straight away.\n\nKEEP YOUR FAVOURITES\nPress KEEP and your finished pot flies onto the My Pots shelf, fired and glazed, with a sparkle and a chime. Everything you make is saved on your headset.\n\nNO WRONG ANSWERS\nNo score, no timer, no losing. Walk up to a wheel and it starts spinning; walk away and it stops. Gentle sounds, relaxed music from the studio radio, and nothing that can go wrong.\n\nDeveloped and published by Citiview Group.", "short_description": "CLAY comes to a bright, candy-coloured studio made for kids. Shape real spinning clay on a potter's wheel with your own fingertips, glaze your pot in seven dripping colours and keep it on your My Pots shelf, in a rainbow room with a cartoon world of hills, hot-air balloons and a castle outside the window."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/clay2/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/clay2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1249265258279447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604375581_1079738261765427_3873790480406095952_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzQc4C2d3qoQ7kNvwHe2JrW&_nc_oc=AdoY48ChTeMha1nv64300D01px4dBghw29zFKPjH2R_DvOu9Itwuk4GcS7m6TkI3CBs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJsdXR0NfL0cxMZ6zMiBjXsWEXb4JtdyIamdV84WVdrg&oe=6B084A45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CLAY 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sa
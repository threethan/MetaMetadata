ent-lga3-2.oculuscdn.com/v/t64.5771-25/673780696_1759205155351971_6287609422330518280_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGg1pHrxwuYQ7kNvwGTKzpM&_nc_oc=Adpf2Yn1nbi6gArPZdrRw_uy-ScIykbkKLFxQ7aXEmNldBt4wZ_yKNgrXCA6Q5eqAKM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQefyc75J3hMBcWhP3zxFG53bxscFAoGYhs0vU_Qx9Kxg&oe=6AFB4C6B"}, {"file_name": "screenshot_3_2560x1440.png", "id": "2381488002703483", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_2381488006036816_8367897073221500335_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BWs-4HCfJ8Q7kNvwFTr_B8&_nc_oc=AdpCdtdXRRlTJ8l9oOuZpIntWXu4Yc29v1RyfX5G9MWWz8z93Rg-qFP8jPj7TeeYsO4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwGnI2hZzTTFtOa-k7B4rSUdd4LlkkdhVaG7_Se12oQA&oe=6AFB31B8"}, {"file_name": "screenshot_4_2560x1440.png", "id": "3399337173599362", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830904_3399337180266028_7075943390701540157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKxWPzKqKv4Q7kNvwH-sF1_&_nc_oc=AdqEMnmNxMk_7rRgG9yRH5IGXEoowZvnoKZe32al6VG8T8UeO0pNvEJKN4jZt3hxZM4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHdXGl97gufV5xQP5iGb-LV9ki9ME26EC8Kd8cxLK0Mg&oe=6AFB1E3C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1123159533606333", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/596068480_1123159536939666_7511649016247633867_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuNtZsjync8Q7kNvwEbnL_k&_nc_oc=AdqzSgkOGFCz9JzYb_fRCO1A61wPGzVNxFXEpy3Yhx9BHUBDsMOxcMVPcPycaMXnRNc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Ry3dprL6NPc5qbAafAdmLic5ugsx5JCb_y9uKz0khw&oe=6AFB4B77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2563361987470792", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595119480_2563361990804125_868122690924657977_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49CXXdOCUckQ7kNvwHmrMUY&_nc_oc=Adpoy2n06RYSywZHxr3KzczDMB3lup2NexxkYftqY3ogV0xLyYX8Rk_ng7OQbJE8Ik0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiubqIH7SMzFHu2rEk4DrVChgoysiNWAZv4CTMvszDmA&oe=6AFB31B4"}, "display_name": "CLAY 2", "keywords": ["pottery", "clay", "ceramics", "kids", "sculpting"], "long_description": "CLAY 2 is a relaxing VR pottery studio for Meta Quest, built for kids and families. Pastel walls, a rubber play-tile floor in every colour, a cloud ceiling, smiling stars and rainbows on the walls and balloons at the ceiling - and outside the glass door, rolling green hills, hot-air balloons, kites and a castle under a rainbow.\n\nSHAPE IT WITH YOUR HANDS\nHand tracking puts your real fingertip on the clay. Squeeze it tall, open a pot, pull the walls up, push out a belly or pinch in a neck - the clay keeps its volume, like the real thing. Controllers work too, with a little stylus finger.\n\nFIVE POTTER'S WHEELS\nTwo wheels by the big windows, two in the kiln room with the glaze buckets and drying racks, and one out on the balcony facing the cartoon world. Each wheel is its own colour and remembers the pot you left on it.\n\nSEVEN DRIPPING GLAZES\nFour clay bodies and seven glazes - celadon, cobalt, tenmoku, honey, speckled white, turquoise and sunset - shown on your pot straight away.\n\nKEEP YOUR FAVOURITES\nPress KEEP and your finished pot flies onto the My Pots shelf, fired and glazed, with a sparkle and a chime. Everything you make is saved on your headset.\n\nNO WRONG ANSWERS\nNo score, no timer, no losing. Walk up to a wheel and it starts spinning; walk away and it stops. Gentle sounds, relaxed music from the studio radio, and nothing that can go wrong.\n\nDeveloped and published by Citiview Group.", "short_description": "CLAY comes to a bright, candy-coloured studio made for kids. Shape real spinning clay on a potter's wheel with your own fingertips, glaze your pot in seven dripping colours and keep it on your My Pots shelf, in a rainbow room with a cartoon world of hills, hot-air balloons and a castle outside the window."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/clay2/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/clay2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1249265258279447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604375581_1079738261765427_3873790480406095952_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro2Y2kHOTJwQ7kNvwHrP9rT&_nc_oc=Adpet5-RR_UxhHNZd5gFvx8FBClKdtGcBYuCRHDcI1dH3HeqCu3V-usdxD-MEQwjQpw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR1gqs_UWVBSe005Urd-J7pbu336RjFlVUcCSUnGeTDg&oe=6AFB1B45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CLAY 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sa
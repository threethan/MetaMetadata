6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4j6lsKoN-QyeejvsuDwIz7ylPM9xQDSB1UVps_hexIA&oe=6A773F34"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86zcz0Z6rxQQ7kNvwF1XtlC&_nc_oc=Adrtr863U5TrTt5tSmw4TFFVf1Jrmuac2g6dNZjri7_D6wZCRb9DjyV8iSaA_1UgGeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYGaG2bMCVQ0ne2vDjg4MukRYldFRzqnc3OvPlRORE-g&oe=6A77267D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNDRoR6Vx2cQ7kNvwHrijjv&_nc_oc=AdqCSYZgfdU50LYoaJUUuVD4_nl22eu-i2icIgmQ54n4F52Ff2ebAGA9rZzn2KqlpmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1jeN-onGJ-062BIwxATupIsF2-5BYDTnDewWrKBPvMQ&oe=6A774596"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdYN9nedbIy3GfMkPT5wLjH87m5-Io9KAkd_dz-LG9Rg&oe=6A9164F4"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eANaqXG9rDEQ7kNvwEjfatf&_nc_oc=AdpP9CYwCra8hmFpAlvR_I2OHYQf8YDg3kSvJFqpxG2IHy5wzdrTXoQ67zNWLN49Gfw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgwgxHFrj9WM_84lCxIclYGVth3puU0FC6oB2TgrT4Ug&oe=6A91847D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvsohI-rIngQ7kNvwF42gDv&_nc_oc=Adr3b_FO-NiVqEu0SWFEAF9Igu4T5lblNAxKPXa0_kk6L5rs_pKQq65ne5v5ZbHrjvk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKgxl-VyztuRIc8o6ZVUWMKbgbYIueGyOT8Ab8NTSzOg&oe=6A916B56"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
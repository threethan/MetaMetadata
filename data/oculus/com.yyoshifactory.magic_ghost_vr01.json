3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXUWacYjvoi0glpqwKoWlycnA6UjpztFPR6ldD4EmuFQ&oe=6A971B74"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qIYqCV1G8kQ7kNvwHgQir4&_nc_oc=AdpRMMYLYg1BF9C70RtLAc4znpCTU-64J4Z3yo7DZxq0YQFglZgzfp2RIHOx6URoHFE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-Egsiri1HbbabvBPfhiGQ3fZLTapqopNbHBfUNK9Lag&oe=6A973AFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxyt02b0BXEQ7kNvwHUsrLT&_nc_oc=Adp_kcEci1Xk5vvpFocycrK4XyC3FKqSIwJonpEHB7CgGt9bJdqtNfROzqFY5BNkrMc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDUWjdazAG76PzusKUm0EVOwponV8qflrmTSxViUJ0gQ&oe=6A9721D6"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7mNN1MGNId81aG9SUlWZDIp6FQ6pME-bAhWrW9KaO5g&oe=6AA01DB4"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk74lNDDCoYQ7kNvwHknhET&_nc_oc=AdrD9RxqBqV65TASGWySMWpY9WiGPPOHi09af8KTKwf7mLCAiY8253s7OfFWyXIyEnM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQION1IhREZZ_Z0MYgOv2ZvE6QA7W_d6YECHqRFMAe_PVg&oe=6AA004FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlnNMuggMMIQ7kNvwHKcfMX&_nc_oc=Adp5pwPDJ5SYkf5sZmUPRXKuqHGO4XOwL1o_lOwPaYVBMKtT21fwF-CiBciD4VdYmtQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiPEZ8116hn3LUQ2WB6UEeWTiZvKTJcCynC3ozNhyZoA&oe=6AA02416"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-TluMi9eP--U1C2NX2KPtMWCX7Injcz7J6L6K23A-bg&oe=6A5CE134"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1SuXEaszhIQ7kNvwFhzTO1&_nc_oc=Adp9Ff77UpSCkCyMBrBgePM6KSMieUnN0DYeXzwj4gbPSyGeX5zGkETRyp4QMYyiUmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfPyxz1508eQn0IJdGuVoJKymKKuGDeqwWxH61f8X1Ug&oe=6A5CC87D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhyJce-Y1rIQ7kNvwFM1HU-&_nc_oc=AdrEBBwyapCDlI_z8vHEJ7Mf58IjVgW2kPIm0_ZZNSI3Y90wdz4Wd42ddNX83brTN10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI4XgCM1a_cWtwlhe4ZpSXxhG2dmMs-uTO70iMIUKK5Q&oe=6A5CAF56"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEbIjmdEnequbGC07CHwTUrX8NyvspnUCKEZQAk9mkJA&oe=6A7D9E74"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CF2pgYO5kUQ7kNvwEcvEPZ&_nc_oc=Adr_Al6PLHOIVrUT-Q2zA7DFuYjENz7vlw5_qghjpqx4BYmU89IFg5hvs_aTnD1ykQ4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5MfhIASBPGgnGf6XZ-4AhjS-nlT4Ozz7dMwXnbUIR5A&oe=6A7DBDFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=en8uUub3yckQ7kNvwHskPTL&_nc_oc=Adplif1K7LtC5rwxsiTZuB03AeZreiyKknQdEoMkQo5ysbE-Z3q_o3I-UcFHLJWYIQc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0dzc70TcEHG0cMlXg8TbZ7yzLxpveQJjbHJCLbkNl1w&oe=6A7DA4D6"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spookymagicforestprivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshiyoshi Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/spookymagicforestprivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1108624972343243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622334_4413080578962497_7959580406606905772_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ncq65gwN2QQ7kNvwH4hN0w&_nc_oc=AdqSnKahcRdviCTx7s-2WScpBlABSnaT15RuzFd6OCOhxVWlVBwyiLPCh1LzmOdLJqE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd3L-oYtVZkahjpUchali_HWQLKKmAiS-1l2mJJXnODQ&oe=6A7DB3F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spooky Magic Forest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1780264020, "lastRevision": {"nodes": [{"id": "1063629936842747", "release_typ
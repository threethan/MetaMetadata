c Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spookymagicforestprivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshiyoshi Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/spookymagicforestprivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1108624972343243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622334_4413080578962497_7959580406606905772_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FECbD9iSF80Q7kNvwFJnkLy&_nc_oc=AdqcXi42PK9Ov55Mh1hmEIUwhsQ_Xa8obhKZvfUZslASuiXhugCqyyzdNwChsF69Mns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRA7MsIuj-3ODU6fAWTQS_VIWIfTSfLirQVAXE29TWxg&oe=6AB3C173"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spooky Magic Forest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id"
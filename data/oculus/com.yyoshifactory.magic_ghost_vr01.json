6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLURNfUEbSwqvb_Fvx01WzD-87H2KKt2FUboyvbb3yfxw&oe=6A9D7AB4"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqkPmvvuLvUQ7kNvwHACXse&_nc_oc=AdpDj6s4G6lJrrmizpHKHpFSblHeLX1SpT99QM5LfekXtVpbsVO-tI65ZcvUGAx7a1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkPkmqETaY73vzA_RrfdL5Zwp262ZvTurGnZtYgyBGmg&oe=6A9D61FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dils4TQJBJMQ7kNvwG-jce-&_nc_oc=AdoGADHihEyOs9osH2qhg_CtSKeywuXVhZ0vC1RpvP3ib9zp718O9dJfnknrPiAkTKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItu3r4lHKkZMlRlAh3gVjaIcfH7DB4Aa6J4yWCODba1Q&oe=6A9D8116"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
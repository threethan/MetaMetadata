-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlqDGC7X09l01VjABk7XRaSSbBefeF5cfFckqzrc27zA&oe=6AAE9E34"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15TMEEiF_k8Q7kNvwGwPbWt&_nc_oc=AdpzcQ5ORRNF5m-ghgC8sfabR7rVm01espCfUoNabbBtW9ZCXWdWijrYEHhNwJrZ1T4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIID0oRyeaIlN6387enlp1SWdZf5nvHzPDqHUBm1F90Gw&oe=6AAE857D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZUlicKnTAsQ7kNvwE3M48q&_nc_oc=AdrEoNA9u5ikJRToUWZCIhMezJJBcB9aZFzjZzj1wW2xlBg5cUsdHEiNUfLgs1kBfSM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxEqmGJl12Opu2PRA621GrRWPaeZaGkjUo4jA89hN3SQ&oe=6AAEA496"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spookymagicforestprivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yoshiyoshi Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/spookymagicforestprivacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1108624972343243"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622334_4413080578962497_7959580406606905772_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tm9SZJcvdRkQ7kNvwEJ0cmh&_nc_oc=Adqy3AB_SDZdFgnPeiVZw000Gu4mLxA-zA2CP9pR25pJozqFopbp01cVOJ47QSw3354&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmNIYFcVKvMVpblgL0lm_nItXCaDTLSOMbLV2YP3tPxw&oe=6AAEB3B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spooky Magic Forest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1780264020, "lastRevision": {"nodes": [{"id": "1063629936842747", "release_typ
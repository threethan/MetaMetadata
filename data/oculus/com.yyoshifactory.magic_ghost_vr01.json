2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ0iIh3unn7moE2hF_8iVxPdFiHbzK--BPtJcz5j1MLA&oe=6A5103B4"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ciWdKU9NK4Q7kNvwF9nKKv&_nc_oc=Adq3F_E4l3k8NoWdQuSZ_9ZH0iIEJjygYuLKYuDZw2H6M30Ndq4peVH_WTvkjd5TVaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo41KlIqZ81vYZ5oSrI_EYpeTRGKi0-Nops2i3mRo26g&oe=6A50EAFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIj1Q354JygQ7kNvwEMAwmZ&_nc_oc=AdrppO-Q4P7EOzDOs834LLDWhr_DceRM2uE8fz-aQddjf3mcUJS4V_CVlz1m_FIWiEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2m5xCYTXPSGFfIiMcMWkeRkQMuJbKL3C_Vle2AUwOnw&oe=6A510A16"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
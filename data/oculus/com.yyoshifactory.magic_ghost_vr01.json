6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0ioTP-Edq66RRwj034-kbiPDvq7u5XZN7CbtuyU5yQw&oe=6A4FB234"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ciWdKU9NK4Q7kNvwH9A_pc&_nc_oc=AdrQTbixHZon-8q2OqtRZmrMIqSG3M1BvrXAgRvZcGN7PMJIGPUy1AuHCz2whIeT5Ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOgapHYWQLpo3VvLeC17rhwv-CfqOrQg_lO99yyzLCaQ&oe=6A4F997D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIj1Q354JygQ7kNvwF45pns&_nc_oc=Adq3_dwEL4MRnF5YAcW-D18fHRtxzRJ9nMf9L6QexjnuObRrlsUoueu917vSr8ZAQQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACzUjHLOqRXKrzN9adLYRyd-dkce-85hKXSGI56vydng&oe=6A4FB896"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
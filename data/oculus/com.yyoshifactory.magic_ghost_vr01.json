6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByYE4gniFN1cTcY65Ap5LRGDfi_0iRd6Jnl1-y2J4orw&oe=6A6CB334"}, {"file_name": "SnapShot109.png", "id": "1031558919267132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_1031558922600465_373861246923297698_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kufDoqwB_04Q7kNvwGqA0l0&_nc_oc=AdpjaQ55P0QalHUxlTbidFPBFzrDmzYQKU4368lyVaN5P9g3J2mG5PVUzfd8PMbVWZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxXVngTFpzP2sDJFUImBv6_goxEUeSoT3N_WvjbK5dMw&oe=6A6C9A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 2026\u5e745\u670824\u65e5 14_49_51.png", "id": "27048297871496603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620860_27048297878163269_7473008092361073219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIuMgZseBaEQ7kNvwH8KqLn&_nc_oc=AdqagrmM2QVUvQKvb34OjRTxJmzizooO5W8RUFSq0yZwiJu5QxGQeMe4ndE0i2eunFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1UAcYAAgrsam6I5dmM15108FHxgD5y4IyUUCjzcA7sw&oe=6A6CB996"}, "display_name": "Spooky Magic Forest", "keywords": [], "long_description": "Spooky Magic Forest is an immersive VR magic action game built for Meta Quest.\n\nStep into a haunted forest and become a powerful wizard. Use hand tracking and motion controls to cast devastating fire and ice spells, battle waves of supernatural enemies, and survive increasingly challenging encounters.\n\nFeatures:\n\n* Intuitive VR spell casting with hand tracking support\n* Master powerful fire and ice magic\n* Multiple game modes: Easy, Normal, Nightmare, and Endless\n* Face a variety of ghostly enemies with unique behaviors\n* Atmospheric dark fantasy forest environment\n* Designed for Meta Quest 3 and Quest 3S\n* Smooth performance and immersive VR gameplay\n\nCan you survive the endless horrors of the Spooky Magic Forest and become a true master of magic?\n", "short_description": "Fight ghosts using fire and ice magic in immersive VR."
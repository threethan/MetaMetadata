1gU-_QcYki1sP7ONPM7AUfjQTuUgvnstuMVjRKrlMHivi4IAiXD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeaGxxsbhpUO8XVpfKlLyKbNmN3NymxQvvDDt6rG3tRw&oe=6B09AE68"}, {"file_name": "ScreenShot4.png", "id": "925556246492886", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_925556249826219_3764526211021296050_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsBXphoXOdsQ7kNvwGiJggf&_nc_oc=Adq-m2VkZ7oeUMX3gPnI8IQVRhOw7is8heTK0U-dPH05rVC3j5tiaOItTIQ5HikrelU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgZohHHMC9V_q5pdqHODqZi5MpAFquVuMoDeK0JuX0hQ&oe=6B09B051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DK_WORLD_Trailer_Cover_Inferior_Izquierda_2560x1440_24bit.png", "id": "27285514311040693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_27285514321040692_5650775831170305547_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRtXQpZ-gYYQ7kNvwGkPX99&_nc_oc=Adoj6oLoGRiN02R_1LCcvZmFS_rAU_QdECyLp4iWF1cCzb2Mncn3r7L_z16K5L0SchE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHAdGf3agWTgY8Q1Vj_3waQV_Izuea2kLbJ8WrDvXMig&oe=6B09CDDC"}, "display_name": "DK World: Beyond Reality", "keywords": ["Puzzle", "Multiplayer", "Challenge", "Immersive", "Explore"], "long_description": "Step into DK WORLD, an immersive VR playground built for Meta Quest where every world feels like a new adventure.\n\nExplore unique environments, solve interactive puzzles, overcome challenges, and discover surprises hidden across different worlds. Each world is designed with its own atmosphere, objectives, and gameplay style, so every session feels fresh, exciting, and different.\n\nPlay solo or with friends in multiplayer experiences made for quick sessions, replayable fun, and easy VR onboarding. Whether you are exploring a mysterious house, racing through obstacle courses, unlocking secrets, or completing world-specific challenges, DK WORLD is made to keep you moving, thinking, and discovering.\n\nKey Features\n\u2022 Immersive VR worlds with different themes and challenges\n\u2022 Puzzle-solving and interactive objectives\n\u2022 Multiplayer support for shared adventures\n\u2022 Quick, replayable sessions built for Meta Quest\n\u2022 Expanding worlds, activities, and cosmetic content\n\u2022 Designed for players who enjoy exploration, challenges, and fun VR moments\n\nDK WORLD is more than one game mode. It is a growing collection of VR worlds where every destination brings something new to experience.", "short_description": "NEW UPDATE!!!! New map ! Step into DK WORLD, a VR adventure where every world feels different. Explore immersive environments, solve puzzles, overcome challenges, and discover new surprises as you move through unique multiplayer experiences built for Meta Quest."}]}, "developer_name": "DK World Studio", "developer_privacy_policy_url": "https://www.dkworldstudio.com/about", "developer_terms_of_service_url": null, "publisher_name": "DK World Studio", "support_website_url": null, "website_url": "https://dkworldstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27765353676430016"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300575_1931123927845551_1580599703229300096_n.p
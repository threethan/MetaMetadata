71-25/499307433_925556249826219_3764526211021296050_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX-3CaIjbaMQ7kNvwExfi9D&_nc_oc=AdqwbTMGOZlu39E739dO9w4XTU7kbtZHH6LJbFWmtu5SOOkkfaSQ5v0UM6N-6oboCWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tFRIfIvlWeF9xg3thMf0AWtWVhrR3WpBRvIMBWFNvCQ&oe=6A16E411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DK_WORLD_Trailer_Cover_Inferior_Izquierda_2560x1440_24bit.png", "id": "27285514311040693", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618499_27285514321040692_5650775831170305547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FctfUKkdjUQ7kNvwFaCntr&_nc_oc=Adq5eLZVVpX5gq5WfgHZFYWwQNZDFdz5DILE0dkySS5IO1B9q3Xq1cuubvzv1UNOGD0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K4geUB-94g6FhHMSbmITyc5InG_-GmVN70WbM4rnddg&oe=6A17019C"}, "display_name": "DK World: Beyond Reality", "keywords": ["Puzzle", "Multiplayer", "Challenge", "Immersive", "Explore"], "long_description": "Step into DK WORLD, an immersive VR playground built for Meta Quest where every world feels like a new adventure.\n\nExplore unique environments, solve interactive puzzles, overcome challenges, and discover surprises hidden across different worlds. Each world is designed with its own atmosphere, objectives, and gameplay style, so every session feels fresh, exciting, and different.\n\nPlay solo or with friends in multiplayer experiences made for quick sessions, replayable fun, and easy VR onboarding. Whether you are exploring a mysterious house, racing through obstacle courses, unlocking secrets, or completing world-specific challenges, DK WORLD is made to keep you moving, thinking, and discovering.\n\nKey Features\n\u2022 Immersive VR worlds with different themes and challenges\n\u2022 Puzzle-solving and interactive objectives\n\u2022 Multiplayer support for shared adventures\n\u2022 Quick, replayable sessions built for Meta Quest\n\u2022 Expanding worlds, activities, and cosmetic content\n\u2022 Designed for players who enjoy exploration, challenges, and fun VR moments\n\nDK WORLD is more than one game mode. It is a growing collection of VR worlds where every destination brings something new to experience.", "short_description": "Step into DK WORLD, a VR adventure where every world feels different. Explore immersive environments, solve puzzles, overcome challenges, and discover new surprises as you move through unique multiplayer experiences built for Meta Quest."}]}, "developer_name": "DK World Studio", "developer_privacy_policy_url": "https://www.dkworldstudio.com/about", "developer_terms_of_service_url": null, "publisher_name": "DK World Studio", "support_website_url": null, "website_url": "https://dkworldstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26901642922801100"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2525490051216674_7378230983649919976_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMXDTbL_w64Q7kNvwE_f_WQ&_nc_oc=AdrhPajlpzYvBp815kQV0UV2vfohTM24I9vAv82dNvxhi0iFjO9lltWvE1uyHY3j6Hw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mUzsC8ZZ3neQL8ffXWOHKbE_43nsB1c0_wyAfMWHkHA&oe=6A17013E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
cape2560.png", "id": "309691730140069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYZoEHmTcyUQ7kNvwGnoNkp&_nc_oc=AdrNOoTWEJMAx42LmTKg2AdcQtUsWua1MkYqQeBib0WW-pvsWMZcWD7WdlVjIvN7uSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzu21OpS69CGTxyoM1sn6zd15bag0ILeYPN8ET4232BQ&oe=6AFC84F9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7766842783406541"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86655521_337446714105889_4557733144832444877_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xph4U3ag0nkQ7kNvwF5e2wJ&_nc_oc=AdpHPs0n5qwnM0ZcLB2fAHCDU0znEBoj3UVGBEdJRYwCpIkP-rxtvIbKDQZtcEw6qCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC72xYb1ZZEpoeB-EMuYxyvdbVtxNlmUHRMPIKMCWASA&oe=6AFC8AE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "exVRience Golf Club", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1602176346, "lastRevision": {"nodes": [{"id": "3174048375971290", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3214857391938459", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "10
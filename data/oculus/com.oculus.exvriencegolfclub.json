9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqjC7csdD2cQ7kNvwHvcLOW&_nc_oc=AdqfGWYEf5L4lzb7JFB2aa0K0puyPyGtGFQiNIE3Br5lRMbI7Pb2L1fG8JdOzYy-pq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkse7P8ttJZ5OOp-WPTW3M7juE1F6Xk5SKGrrGstzkyw&oe=6A7C736A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9mSVzN8nzwQ7kNvwHLh13e&_nc_oc=Adpoz7UaWoe5U-HQytE8SAUAK3wf8k8ZgWzvYDDdqpm2PKJIqLsjAcqnHbOEhmXp_nI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGev87vyDk0KecSJRqHIl1Pac-tgQk4wdcZIdRCM5h_bA&oe=6A7C7B46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBqGbbcI6iwQ7kNvwGfsJzY&_nc_oc=Adp1hpb1LR1_r9acodu88WKTmxlZfA8NUnjspXoLJBD9afmIWwLhYLLxZuN2XbW98_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX9d17w30hrozIjU5gKZuvxk8JXfj92mJghddrmsExcw&oe=6A7C576D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osoyIzri1ZkQ7kNvwFSCrJ0&_nc_oc=AdosPfOdc9s8uCxAf1eWK4q68_7R30Ns8y2APC-kn_exNP3HSKnq4KyrlPnajBj_mFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkD_yShSSOiAcuIRDa-C9-VpdB5f7awY5dXHokOdm1bg&oe=6A7C7B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTVJp7_cmxgQ7kNvwGtb9WY&_nc_oc=Adr-V6Pdd8C9Xe5wnCIQ2ulKi6Xg8vVWGCPrXyjCurQhKjzV_2pM4CSYx1Lv4m_2t3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ybsCSZ59iDmyyFy_EmADAJZZ6RsQDRcCVHSLzkP0xQ&oe=6A7C6B39"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
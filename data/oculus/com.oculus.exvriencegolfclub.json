9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qeAtwZgvtQQ7kNvwFxx36W&_nc_oc=AdoR430y0R1cLcYBNy3rq48ZcBEYzQi8b7uVgYjDgFQui0Q1xd7EH3gEg_uc3daHVmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7--Sa9-eJNsmMQfYNynk_RQ95AYNbN4rGr7OWE4aq_4w&oe=6A1ED8EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTJ8B0_6RdgQ7kNvwHhKIIy&_nc_oc=AdqSwZTzCQ0Y2xHXvY9-DOvpwZVC1YH028kN3EyX8afFeFJAkym0O29aILnhQ-hyMAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AQyT9OL2I4YgQxh4OFe2iz1CFMUIyIwX9ECUr-oaljA&oe=6A1EE0C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLTkV2KmeqsQ7kNvwHalgue&_nc_oc=Adoy_xTmjyr2Lg3-soG2ho-IbT3UYRhQ2NT1ijpmBE2T72BG1Sc4g2ODTKgfhRP7eG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_D_yk5cqKL8BAVC_Js0c6hyDBVScurO3kqhaXXPYGlw&oe=6A1EF52D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhzcwSnnMMUQ7kNvwHK89VG&_nc_oc=AdrbWubVSAve1JHUi9Vkz8Bc5tsWDY_GPJeWG9-Aq6bAnK6-lmqa3LzfXSalEFosJvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-GDgFRRGR5QG-bWhKHRpW8vwUd2T9W8jxxVdQk-Mfjg&oe=6A1EE10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkImxIDgCAgQ7kNvwGszomW&_nc_oc=AdoD7fCKneJRBcJPmBTWB96a1hZw5hI1oTTYRH9aIAXNs3UbdXeNqOwLWdT0g9yxfaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OGLoL1GlM4mvrl-gIpVlYv7h0smqv8jDSy2fKYjnQHg&oe=6A1ED0B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
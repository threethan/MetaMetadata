9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsaMxygNIM4Q7kNvwGpheVq&_nc_oc=AdpdXQy8Fkw7hD_mOwA1lPG4kVesCuNnyrFJxvXFnuPX1Pz8MLxDyXSuDv1U2wWV4Oo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_6Z_MbUX_E3ZENMQpm7cIrv0IAf5pA_ybM8dzR2NPSQ&oe=6A411FEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaVqGr2ALegQ7kNvwHb9BEh&_nc_oc=Ado6uJvhpSx_AXPTsrCAGRcS3x9Z1-fyIPRdCxqSUlKwqQY71Nv2ER1WGYNUf52ynGI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eKU3DVO_Tkl07v5MdhVYOayj42O_NGEzmdrTSInPmUQ&oe=6A4127C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAHS9i9UJkkQ7kNvwGNHZvP&_nc_oc=Adq5dLErf85I5GyVO8KRLGgoIhJBwyCv6jyxjFcWYSyqsdmXJVEtqeymC4XobKt5Rzs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bnkPxVpNSVUOSIHukmIsUhuQIWu4t_lPz-hdQft86Sw&oe=6A413C2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuOpLEvsMmcQ7kNvwHErC_0&_nc_oc=Adqj4ex2aQz_O2btWjDiCwaXW7_XseJMel6ogXXMVv4E3ouL1Yu-flpFMZ1cZHPtISw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MuAe_nmzad4tzMCc5VYYMXzlQKdmQz-yCpUMG3vTk3Q&oe=6A41280C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWnee8Z1YZ4Q7kNvwGG2bR2&_nc_oc=Adpt8cxE9mgF2CHaJaLqNRZ8f_jbGF1-BrAIkyNVEZV3073RRZv7bql91VB32aI4ot0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B6zIlAe87a3z4f8fQb1YwTHg9BCY6OBdaiwPYoNtBzg&oe=6A4117B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
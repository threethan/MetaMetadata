9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpQOdWwUlRMQ7kNvwEhaf-K&_nc_oc=AdpgC5lNorQYSqGWuFm3H8ukm6_gjXTR6dnDeQD44E23LCoxf52x5FVyihupA2vNF30&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1s0lCkCxhC7QbGjkWOexJN2GyCPRK7rNfV_gZK6D7l3w&oe=69F5FA6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTK3VIC1i-QQ7kNvwHie0VA&_nc_oc=AdrtvHNqGgIcQOiy73cyEA1w2fIJpxb3o2kambCH211k6HNVXtt8ka7Ma-diXlinDzw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sLONwTXaV7HHFSQAQ0Q9sEGiPecQt2Vd4T2zM5pGj1Q&oe=69F60246"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wz7oKjVGMgQ7kNvwGyftSj&_nc_oc=Adp383854Oia1PLzdo63LixDfzEaTbfNIK_RzjbaZgHRy12eqhfa9bu2k5sGarJLPlE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37s6ROFNg6jYq-BMwrRtSNG9FPaTm06L4WfDENSHh9-A&oe=69F616AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV5sp3TehsYQ7kNvwH94tGb&_nc_oc=AdrpDtFDl_p46emalZ1dwgd3QxJ8hWmTEHyikZAMh-6RWkSzz5TAbv27GV3vRxE5y9w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cH2SciJWBvGPfPhEE4CDnyo-Qb9cl1N1m4Hidze1SyA&oe=69F6028C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLwshhM8NgEQ7kNvwH6v2eh&_nc_oc=Ado6kAkadUgwW0iFg1BULNDsz0_Bn5fehAdei1ZLRDN7agva4YCw9_TyR8Et25BvaXo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nk4frOfHojwDpCskhwH7bEK97gdloRbilj1iLspzX6g&oe=69F5F239"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
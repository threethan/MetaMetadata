9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jg5Tmiv8t8Q7kNvwESnLzT&_nc_oc=AdrXZa-QYu8iipGrLxBkFW8_yhX9WY4KXUbQ4oqytCWEAmiz3RX76hgqxq7Zx6S67oQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JlVLk_r_RvXaA3a4K7zfjeRFr2Qm_1j72gEhuxPCDwA&oe=69DA4AEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsTG9DXlJn4Q7kNvwFy1PwI&_nc_oc=AdqseEvdEosivDuM_OSW4-5LnigtPKKQpAZaVkVlghiLEAIaJVz6ePobOz0HFIQtz9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jSeiXv-dy7ot2e8momanxW4mBEcsYASoOZMPvvT8EBw&oe=69DA52C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK7iubHmNawQ7kNvwFXrv8F&_nc_oc=AdptaDfOCTAbMCf5ZIygINKzyyzCesahd93wZjdl7jA0TbRgfoQXiY8zz66FsD6ld8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37pUQCICa3uyzwIUzb2609w4QTdL_5OoKmt97b86Vkhg&oe=69DA2EED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWl8IUm5JNIQ7kNvwGfvjsN&_nc_oc=Ado5wybtV33mQHLhTQwFjrVux12MZ_muUIZWP5hRXAN0ZXX-okXVRJ79mLvtjWFXPWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GV423rb4dWWvjEuHxWDtY_QQTtbAdJy6yyvo9aZTiOQ&oe=69DA530C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUCruapEHPoQ7kNvwGXVuzX&_nc_oc=Adq4JRifc5HJkMjCOE0eFDxH-iimo0Q0aw-S6Cl_jdHCkhOyevtwGdF-iVAsSaOgSpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lnqmiOitn46QWKIaTBvvP8KhyNukdyu37YP2rY5n7og&oe=69DA42B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
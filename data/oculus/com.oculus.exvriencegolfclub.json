9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peEq7HsnwVEQ7kNvwHiLRRa&_nc_oc=AdoSgSA3l83U_tyJskt6crg6guvqW1fTgTWmLLdBUMGIXI7Zm5VKsGno7YK366f4rlQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KSlqS7oXuF0hXSm_c6pSNLVvvyqnnYndUfgg_YuprMA&oe=6A03296A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtesBmV19TMQ7kNvwEopVqx&_nc_oc=Adotw6bvl3EAwGT4J6fSdVRNohOUKcYMRqO28oVnc8zcrNMVuX-779Ysr8W5bxAhM04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sruKVpaCVipWZB9wEoPJl2DtEKSTF2VY04_Jf_ui-ew&oe=6A033146"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmZtcEFoOZgQ7kNvwFocBQK&_nc_oc=AdpZTkBtEI22sFomB345Qr4fhvws0tmozq2Mv6Aud2KCc27uuxLm6fruUPY-RNH-60k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hG2EIu0M2buxXP9AV2lvVeoE-RjPy7B5tS8i8VBooVw&oe=6A0345AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjMeH_oi8R8Q7kNvwFRV7r4&_nc_oc=Ado-tyXIhUO05ghDvRpVbAvQM2p3OjRR0FGrS6x8ren4WUAR6z0MG8zy6iAqObIUIkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P9EaHfhc77X2YZu_r8aORTLvxflNJqAs1ZWlqTU1tNw&oe=6A03318C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfdYnZ1yTrwQ7kNvwFGL7bN&_nc_oc=AdpBSErSmrqN-fbmp6S0VZEZ38usMPfY8llLAx93_N9cSh_Sv1q0R6ktuqUNaeroVZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GvS42hdunKYQrYWzxxUWnrKuidBqIiBvpBXBHMP183A&oe=6A032139"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
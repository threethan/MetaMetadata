9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1h8D-SkekUQ7kNvwFIY8-E&_nc_oc=AdqlUYjNEorCoz-aKOSXwaLg_5T2_7kEynAN0Fl_wlkLyQP1Oy5kA-45l8VO3r51qEw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeRP75s3tLOp5iro8c-ca3j-LAkJd5EL-Dgb_yPN0QZQ&oe=6A6366EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u09S8AtwaEsQ7kNvwGG5iYp&_nc_oc=Adpxoa-VPlqGSZQ0VcXSaULve4_NRaNCL2oTvu6ybbIvqs6-FSJMSoSFTwVsp8wBQoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF7m0oZ5ljj91mHGS3Fjb4ThEBmhCyNwvPG6L6fQvbgQ&oe=6A636EC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7oyh4BzHyoQ7kNvwGgsT-F&_nc_oc=Adqok3e7Lh4EnFmVxcPmCw3zdlVJWD4XDN1gUJ9gGsRQhXX5YXN4Qu9Y2DS4CQrJEyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAywUoi3jgomFRRHuGx8JH-UxB9sJSlyjXp8SItyt9u2g&oe=6A63832D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyXgsfJL2yMQ7kNvwHpP243&_nc_oc=AdoiOO5340PmHq3mC76HEd10Rborgsn1sKbaetIludQcXTl9VuYArghy_dNIsvg3-a8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIFLXYChq6ZYoQc3W20C9uE_HTEshcvx56xu8y6w3m5Q&oe=6A636F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F1td_PdfB0Q7kNvwFpFZqa&_nc_oc=Adqvn5e1M_4-59dqrAbvp2xw6maRLo2DM0mKrOsRe_JF6zMFd9Xosd42idJwnOpTOWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCeP0m_AnQl6YfR5Cl8pWgSGAbi64LV8Zn7SJju4hgVg&oe=6A635EB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
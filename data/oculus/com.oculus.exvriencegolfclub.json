9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuc_VJ4uA6oQ7kNvwES9xCA&_nc_oc=Adp7ZyaQw6hkXIdsJ9OtF5C8WvB4x7DYzTwM0HQZwIuC3cv6lLj5VroiMwxMZzqMtH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7rdltDyn-rpql7i2VDG428TTwv1_vnKqSPJq_qf7OrQ&oe=6A3BD9EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETsS2ee5ItYQ7kNvwH_trjT&_nc_oc=AdrNNn728pRXEElQEcHxh1U5UpHgAik8JWhD8BmIJXEB5P7jPzfP9QtvZ0kZ-naMl48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CIFtRvC0fgwwDZUscBtog_Pgs5sZUaz1oXE-y5dUWfA&oe=6A3BE1C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46BVmPMfGsYQ7kNvwEiwAt5&_nc_oc=AdrqIL8HmeQ-mALK-ykqurf1n7M_4cZWfu-6tmz2QE19B1HSaVNTG4Way_9plWDOH7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MDHRrhpJwe7JEP8G1yzw4I7QfybjLI2bZvPPvOqzu2A&oe=6A3BF62D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZl4_AuOoAwQ7kNvwFVI3gS&_nc_oc=AdrDt86aWXO7pixFeBtdyaqqAjnuhS5UEfIgFkv6cJKP4u3tnV2vcvdJ4mXGUcbpgIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P8_eamwdAxm-JN5WnUjpTiGNatlBEK1xUhNvO6TdIuw&oe=6A3BE20C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fec41BDtJlQQ7kNvwGJHxfP&_nc_oc=AdrVQQLV5eefiUBEjtMp_ALDAAftqZN48qkot-Inf_Gz3qJ3UtYxFd_zeyt5wY0fCEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aO2GaLgAevIR_pgZ9JWiBnDsJbyFclo-fyNsIJ0_aOQ&oe=6A3BD1B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqA5S9xQq7YQ7kNvwH8ilsb&_nc_oc=AdqKYlUnKnVRKqkUQeIIMmQz5xr8JMCjfymsnQwsL9bLB0JsUVzNc-IfDsLqc9wwXc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZORMgO2sv9nroEc4Y-2RJ4mGL1xPs_DBcewhZO7k40w&oe=6AF0AFAA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCBjjtrkZRIQ7kNvwG0ak2T&_nc_oc=AdoDcbkfYwD1_zTOxO5llrGa-v_Z7mCAusqZvlUUNi-2YYgt9Gmdtb9JdnGG2fTSUew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS21nkTWJWJUsWrtpsIeQOwHPF5JL5ia1FIixaDx30pNg&oe=6AF07F46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjZ2eELuxyUQ7kNvwGcz1hl&_nc_oc=AdpsaTMCEHwkXTYkXKY8Jz8F9D88DwX04lk6KATbjCwcKrdt1Zbpuou3vLC7VhHyp_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyh-Ymf_y2YRuB4MyhWLsbwPcN2Jql7I1VCF_GWKCWwg&oe=6AF093AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9bJqzIaPssQ7kNvwFvwYuO&_nc_oc=AdpsQJch70bWzkChr3PDVtH3czvCZsulmFB6wuxytMS_l18HoiL_rSkfqZuHK7dmJOY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxTBr2RsqQv5vTUdq7hxJPKRIAzmjakCuoOgJvwinmlA&oe=6AF07F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqxTh9_0KH4Q7kNvwFUDumj&_nc_oc=AdoBoyAERwtZuWYu5nfi1c3lYN3DUd_EskDGFL1VuwqgIBOTMPQUrIu5HN7oFT5t97w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTR4Dy6X2QDFfRp1v3QjD8VHHgr1P6cDSGTNxCbhqgmw&oe=6AF0A779"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
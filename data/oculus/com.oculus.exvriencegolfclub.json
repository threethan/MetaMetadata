9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xazKRfVCG20Q7kNvwEszAyG&_nc_oc=AdoSDCnwJ6ukaGMSmwwI2I1o14eU_YafDPxbGd2MeouOEL6sRpM0CgqXoKgZnlFRhMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0AeomafIfdJ7R2XQDJY7YPFSSco9Iw7Gux5HnzB2zKg&oe=6A50F1EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nr3f51hnEIQ7kNvwHN5g9u&_nc_oc=AdqY40jpaLciAZJUh7MOh0cW8tC_jO0qOUTgbSO9gLDA7k3-lTOsRLDpvDxoyplTCE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa-wVxvnYnn-Kv3A-9YWKoh_BPp8aiSlXyIfL8tk5R2w&oe=6A50F9C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L351uFCY6CkQ7kNvwEUTfZl&_nc_oc=AdoBxu6_je1xSTIB7E-ykkqcpzUWrr2INhtFoM-mIqG0swy7nrPDQICmRG0hJ_rbS8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-s-Cq-Q3jf4yXTllqGJ6kHvd2M3LCHaorkcxzgo-acQ&oe=6A510E2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPqUC-xyOcUQ7kNvwHwmDMr&_nc_oc=Adp9FXfBlDvmggQnwlj2ot0Y5t_DZRq8Jla6ALGXRTdLO4WCJfpmpc0y6-DeuTv-QSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS7GL5awnt0F5PKVPAIN-4tx5t-Axqj4t7lFWEh9rtWw&oe=6A50FA0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvqA5t1IjicQ7kNvwH25T1e&_nc_oc=AdqwWbrHERAwnY69Z6TfQR5Zve9iAHbhTB7GIFzSfq1DmF7_YGwaUh1YIU2Hcokn5NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3rTsHHMkhgLdRdOzhR9j2UsAiqm3nDl4xT8Wa658nTA&oe=6A50E9B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
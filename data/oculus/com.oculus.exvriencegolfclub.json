9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJDyfIsQrJUQ7kNvwHS9Tqo&_nc_oc=AdoeQTRKi03lLudVq980xjRm3nJBEJoyXGzFdodWOm_-JmSCW_dcA8qbfECiAOqj47k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vnYO4mopx1idXiR_z7O2LA3w5ko1nTPg21-LW-YU8ug&oe=69EF62EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOyPQJLiAj4Q7kNvwExJhEr&_nc_oc=AdoyNd5hZJeZbWHmBDTQA9dnqM_i_LNRhr6KpOmT31wx7-cM9cVaFYU0Pof6dqstpKU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cCk2LkMIjjsMQYKjxAgXATlA9BicCyV6rdmAsvanbmA&oe=69EF6AC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY9nrXe_hYAQ7kNvwFZdDum&_nc_oc=AdrFMe__dV-yUYGgQqWL7BEe0CejVImlPY9jTygue4i8I0ZWoBJmN_wujfz4uZF619o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1irU7B31i2W7BnbAA5j-eYT7IrSU7C-OGmscrOEEMlZA&oe=69EF7F2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_S-Lg82nQwQ7kNvwFRUT2J&_nc_oc=AdqLYas1xXru-aqIKHOdlyeHzEy-CyHNuecNZSio8JIWUvqviE9fBpxkvVlUUDa8tV8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af010evLZnSJP8d96X6bAae2xosqSitNCwSjv4KqEmsOAA&oe=69EF6B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPFQcaGlJWAQ7kNvwFZFdYS&_nc_oc=Adr03WAcWhHwyZOLUqoOV0n0JFtoxP_dqX5B9TUjuImUfm1tlzU2DnDnAfn75YjNlOo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21j_2h1GI-UnnPGoO_qkywmZMw-V3EkyX74ujXQutwiA&oe=69EF5AB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
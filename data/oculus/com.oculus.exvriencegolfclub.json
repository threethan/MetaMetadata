9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RAfEdnfF6cQ7kNvwHaPeGh&_nc_oc=Ado0uFkga_NIelMg3AQkFwAmF0qmuwiomigmxM_SGU2ZIe2Xq6bb1_FMaWKjQgLXuuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvCmttzJxE8vi9yzaCEcd8yYpFI3T57O50-x0XnIBiMw&oe=69CE6D6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjTeHBUeSugQ7kNvwEtpQ5l&_nc_oc=Adqk3POp-rqB7tdfJme091JQZhMtzgTqqCXsjULDmzGWvv0dzMFrZfaASTdJhVLHfiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwtrc1vcWdsveioTnmR8P_BVr7REui2OZm-65OM-y91WQ&oe=69CE7546"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avU9RD26oH4Q7kNvwHUqCWd&_nc_oc=Adq-vfR8JOoPAHUcMCWs3dKfVozV8OqlY1fMDYhzGOgAxrlWee4LA31MDkg8mx8SHHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCYqsn9d1uXqFHjX2u7eJ9VGhk_SUz5JYdZtIybqg9dQ&oe=69CE516D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89Vi0dMNMSEQ7kNvwHQhnSL&_nc_oc=AdqNOZwGuPbtR1c1_I4Ztp_p9g7Iwc_91HaHt9dN2pHsD0q8N0Gmbpig6C7lvqQBXWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCSQhDzCKQj2lzdN1l5k2jv8ckbnxZJB0l7DTbrXI1cQ&oe=69CE758C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUkBPtrgapQQ7kNvwEYGHS1&_nc_oc=Adqt6WI9-UaoCbcwi26DRePm1IxoJVZWlklM0MfLqIpTlVKq9C9JkD0Yk6AWBNsugyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1npeVWCwiIcopMqSKdBR_LX2U6dx6sswL_LlsbU-Lsg&oe=69CE6539"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtLsc1x-XHMQ7kNvwGZbYM4&_nc_oc=AdppWGysqsicuaPTs61CZFIrHgB3Of7cXldgWLzvVL9bzoX4m5Nnnj-CATYIpdrp3P0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CN-oRewUPaO2XPR1QDilLi6ZSwV6ECG7j2Cv7o1nfqA&oe=6A16EFEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhG0nawqBvgQ7kNvwHryTc6&_nc_oc=AdqYysbwRdv2hMowb4_BnbO7tsDhuC-MZbdUavHineOwdBooadUU8KmBfweImkmQJ9M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DRcvQaq1DVMapwBZNLvIHbHneGMebdCFxzgJd0YDI4A&oe=6A16F7C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKf-Okc1GZIQ7kNvwFN5dio&_nc_oc=Ado0BZgaapcEiAUkopZOIkG0TvRhGisi49fw77bx-hf_PSyd6uM5ZBHXkjjIYyu6H0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wg0-Utp5I_SnujthWvF9ImK1tHinTjb568PHwGhPvzw&oe=6A170C2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BDuUufuc0cQ7kNvwEl3l5N&_nc_oc=AdoyZjj_00dLVbJRtP48jinzFcgvXe5JpaqtmNtNdDUHAzWEK8-ht2n68S-KocggVf8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WyBA-nw6l_p-U-ZOJu8teHhHv4Ornz2yXb5xDGw_Ggg&oe=6A16F80C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kNTZ5Df5XQQ7kNvwG_bUgL&_nc_oc=AdpoX3ApowH0NVPCI4MdIcspHFLnW44pdXadeMT6U6gyfXWBB9HJC6dUrJifYyWeOCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cn1cy5nZtRdiU-WG-LVCUtNzMQUl9XqEtM10N8sjFMw&oe=6A16E7B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcIrl4IhsVMQ7kNvwGqFmy4&_nc_oc=AdqI8WRYJMvvB1PT9Ea-cUS2JX8etvgT96WnEGQEQfiBNvLZAti0vaOkYrxEp9LV6lE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YR6BCTj4pkK8W2V4k32KSoiJNzIUQvUbtlgJXtW_seA&oe=6A26C1EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNQeuG2vB3sQ7kNvwGHywG0&_nc_oc=Adp1dZX8ecx5JgLhjidVVrcTjWne97etku3PqXQ6VMSy_Bk0a_13kKFPhLeEv-Z9zzw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mKfTarb_G6VEdzNjj6yJoY3wkNyanD-DrGpBhmqOMUQ&oe=6A26C9C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teN50w_MRL0Q7kNvwGxv_z6&_nc_oc=AdrFTQtxNIw2rFOm7YsFI1rlY1V6aMy_UNU7qyrmOkYHy1FqOrAQFKRi8fzUGt7kSaw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s3CsBZBW6o8jX6Vt3gAKRivn9THhhw4B0biHVUkszLA&oe=6A26DE2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKtMCEjX3gkQ7kNvwFv-F4h&_nc_oc=AdrQJcPgI9q0HXUBYPjXtRD5cbmXqcQ0xvo8XFE1Gu_sjgZYmna0GNsLb80JcmjHw0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OXymRSbeoW2aG1NSJ3Eq6hepBCdKYVhNwn-R4PFd64w&oe=6A26CA0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4nZhtQzhHsQ7kNvwEgs6wK&_nc_oc=AdrdgyuJFCGJ15N-cPWfo6J4ttO_4O5xlzs5T0XK__heVJXXrs2ioTRkVKGo641faaI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jtsakxGuCnMN3MCXJPgOCJw6esnxuULlT67ivrOxUeQ&oe=6A26B9B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVRDbzClKJoQ7kNvwGFrXlN&_nc_oc=Adq-OE-JLYU9jTGZSzZxneCJgLMagILw9M3Nm5ycKjXJu9kPbRV5dGQeKrIgKA_7Dik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6sVm7r05wP3zhAyRjavb5nl7BStu69MHd5tqo2V510g&oe=6A9EBA6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elIDyO999zIQ7kNvwHpI1Zh&_nc_oc=AdoATgg4VLuKaP--kEqLQgAQKSP8iUmD_xBvX2VxECFGKl7S3IHsQTLyGdAJYSDeuYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYHbMRcq4PF2aY0muA5WrsOqDsEmrf3nCULR82Qjkeng&oe=6A9EC246"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GzoRS6CuP8Q7kNvwGfVXe8&_nc_oc=AdoKlRUbh-pmFvq1wS8x9JP019OKXKdGfb8c766GPbBOj4Rxww8nlxVbqB4XiJKazxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYFAHTjUxA1tVYmQytAEHBlEaCiM2yduWNmO_J1oqfsA&oe=6A9ED6AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQGQvRCRyqYQ7kNvwFMa895&_nc_oc=AdqgevMmYeQnddcJgN6g6q5j8Wdx8RSYfMOiXjygKhvMdqxk2k6I-Em7bH8TGOz_XTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM4OR1761kNER3yL1ekxhYEQ8bp1FK6cIdChTnLJ69bQ&oe=6A9EC28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMEeRUfJF70Q7kNvwFIizMV&_nc_oc=Adqv4tB_73KL7YCUYvdzND0W3BVAccSsmR1aRMU48FejG62DcMu4b2dC9jVmK38c2F8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPn0a1t4EF7Y4kwB5-ARnFeL84SBmk26HzCAjayX_huA&oe=6A9EB239"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
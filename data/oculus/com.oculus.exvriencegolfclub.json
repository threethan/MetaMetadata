9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_No711IbIoQ7kNvwHB87LD&_nc_oc=AdrGvjnxGPW_3zMSREYG9-WzU759AqydoLMTILTyia00pJPWipxJlSB_uu00fPMciD8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQUEb3jfCuu6e6hk9_7SAzo86sbeZSOcNELybZdEutLQ&oe=6A9741EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiTN6GzM-bwQ7kNvwHJ4u8S&_nc_oc=Adqfc6fOoPomRD5BrjoSlu6VQvkVASXox0Q7J8N2ATn40Nqhri62hZJZkd0gd7sX868&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIbQFYWmuuwcP1aSvk23eD-Cg__Fl2y6E6tD-RhbVBnA&oe=6A9749C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yix5v5bTLq0Q7kNvwFel3SP&_nc_oc=Adr2-MYz3A9P3l5eEKZ1t8F2_T_DIzh1e5fJGlV_hGoFGcpgMNuQYwdhhw8blzhAtJc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaW7Qe-qOyi_9-wsHCWYlclAgV_PUXtv2CMqzbFnwTdg&oe=6A9725ED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bz7P0sst2MQQ7kNvwGlkGzM&_nc_oc=AdpK7lvzdaI0TKFn36YiktgAIokeZgC5dPAO_ZAb1Jo666NQXJ6GjqRHaBoK4Xdpkg4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU3XxlA44t0ESCWuE595H1RxRg-2QjdguTsFfjO_s-hw&oe=6A974A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDRX4nNCb6cQ7kNvwF-Oqfz&_nc_oc=AdqOXZVTC5bYCEgD0avVTt7Ft4OyUGyb4yIm09HLCx4vqglVmmceUA7iiYRfAtN2UBg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUbQHqzFDpgvsQ9o5vj5ej7n68RdBhafs_xv5qwzFfkw&oe=6A9739B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAenT0KN-YMQ7kNvwGhTpmn&_nc_oc=Adpo9mE7ux4B8s60PkWWSjYaVXaH2DIn1re3axFWnyPxGMbTHAyAw3fXI_VT-MaGKyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZNI8srSE5QDCDwEiNMgWe7jkbPMoq9FEWlRnuKM4Dgg&oe=6A0B126A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40ygLYicNycQ7kNvwF25lrk&_nc_oc=AdoT87U401E3BERgvrl5E-OK1RfEyQr_G4hqC-m5arXH_fkZj8BrZW8AmV6h4PvZsBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H0oWoDjiqTCs0ulkj4TtlDcQkujy_CLN3tdlSTaHvyQ&oe=6A0B1A46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBUWl3mhNfMQ7kNvwH3H_-H&_nc_oc=AdoAHBWP17SFITtjRqU1QKB8ZzZAsNV6KWkIBEnenBoju-PnXKT0qlW1vr7lWkcGUAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jnXbgb67IIyLL7oV2W78QBx91V3jBdqJ_dZthQaDPBw&oe=6A0B2EAD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfNRVrOmPucQ7kNvwHdUZ6H&_nc_oc=AdqF6tUD3QibNe5DC7CRGjCcHLtT5xSkW-VcWF6NbHJeSM_O5i2ztm8QPGFpkGyIQ_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P_6ibqAVUdeSOIdkbod9nLBdblCoB5ZHkPk68AvhL6w&oe=6A0B1A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHe22eo2QsQ7kNvwHeoX4x&_nc_oc=Adr242yu9oWA5h3zfWLRy0bPXuIO0WftrZhxs8UMh54D1Azy2Zbz_nUu7fPaH1oybjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z-M3ctKszozpXJlyJfjoRIFDO-nSN9kUjlVYnGh647A&oe=6A0B0A39"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
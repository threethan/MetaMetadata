9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsaMxygNIM4Q7kNvwGUKs7G&_nc_oc=AdrE3a9H2KhF9NuhjHhSGuGyOsNw_gL2qRgCaGkrpoc_MsjQSt7bhyRoKOOLKX2po2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gBQvwNLiwspDaLZi2amg2KQ-gD0WpDD2uGzGUMI_yjQ&oe=6A3FCE6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaVqGr2ALegQ7kNvwHrPA_w&_nc_oc=Adpc_YJQid1ETNrX9q7AU8SUJAK4_xYysBCU6sw66ksGotSdEhVbQcRT-knEh7XZjZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-XErzdorRNIpUfHaWeWtDpupfY-YaIN_tJUe5H1eYwg&oe=6A3FD646"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGrlyY7nWxsQ7kNvwEpZsMY&_nc_oc=AdqDS7wDylErpu7nY1jBTHZvxZni95Psb7h5n41ZLlJ_itNz8qRelI2jqklfH7ZBkx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-14YhulY_LJ3Soo1J0tBVxaISJH1fGvOwD1z50dX4qFQ&oe=6A3FEAAD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPl5lXyD2NkQ7kNvwEBV1vC&_nc_oc=Ado7Uc5p2QrKPH9_WJdZH-yzsx7J33Q3nj7GsyahH3vJgwHOM8Cln-ik0YkLGwLky1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_plT_jvr7dQmRwOEKvDgLjsCz4dtMmjhVFiXI-5px9sA&oe=6A3FD68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZg67hoO61MQ7kNvwEWFkKr&_nc_oc=AdoVJctcVD7TZ5Cu-3QfsQEtoKKS090TIPhxL5qhGsFSAIUE05SGAkogZYkD8JOVrBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ka4tjQBkATU-I2Q7YKDqb_orqlloSn8mEiC4BWFYluA&oe=6A3FC639"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
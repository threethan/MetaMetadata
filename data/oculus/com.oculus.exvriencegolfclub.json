9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Up4xjKpsbwQ7kNvwH37Q_P&_nc_oc=Adrmh_IvWIC5kKgXJKwTvVhNt6WpqURbcxu83V-vmUOka5n6kjXEXIIVuZx0_leaGdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGz43CZ9fB7G6ENIFmK_VjfR30OpTR5lvMUoflg86oIw&oe=6A4908EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOzTF0a2rv4Q7kNvwGF3W4P&_nc_oc=AdoPrCFrgHX_88dtDVoOn3cBrXQNH0KB0JIL-jiRSWZbZH0ms4JT6jhJKPh_qk-hgZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLnPot6Wil28Z0YC5BZQ5nmiCCjBkZhbKhgmPsdIwuCw&oe=6A4910C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ria9z7fmAkUQ7kNvwEbfitl&_nc_oc=AdpHB4gRNztmPS2-HPcYIOt0jbbQZg54dqoRuyW1ZRK97F2xrvLC0ob88Pq7tZ40Inw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHKYOTxss4Xy0eI8_shqncbreyoaFhLqvubfgBMJmkmQ&oe=6A49252D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNvN_Nta2YYQ7kNvwFRfQqO&_nc_oc=Adr_dn_sqfDDnXKDnCnK9Ns3tcWvsZUxhGL_COhBjZuTzZKgFmKEvx7pLEixpWEWceo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-PGM5qsObgO9BqolM8YlhhMzB7jO-HLPsPKwgL7yp2Q&oe=6A49110C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWY_V734UPkQ7kNvwEjbcgb&_nc_oc=AdrNp2P-SeoJxvDxWUXR4ZGQfUQCb14sH6VuxVd9dCsKMFWMc-URpH2eBcM0vHvgJ30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgk7_8-w3VFlV924Fz29ikVgKqfAIN3er0Pwo_CbDwyA&oe=6A4900B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsO3if5OZWsQ7kNvwEZZoTG&_nc_oc=AdrztWy9WnyG5enF-x2NoM5gIZ6NmPwtf9Zz8fYeuoMKp9MqXYZY9N5aLNRYOA76aqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoXiBAQZ1_ZcRxvGHmZ2JBSMHOpVKn3mMVk2OFY-xuTA&oe=6AE9DFEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9e0AiOM5PQoQ7kNvwEX1GQY&_nc_oc=AdrPfmLDkPI3sih8a6coiYicJQ6GLL8A_6VrmTcRtm4SrayVw7Kk80lbpbxBTFLygLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj0RkrjMcxq0ZV9p0XYLyr01GCt9lSVdzxDehGTm0fcQ&oe=6AE9E7C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfg28UTebW4Q7kNvwHnluoW&_nc_oc=AdrqHta3oLSD9QeYAouiAHRA7U8DEymB9rNRopfDCMQZ3dUnyr01a1jo3f75g5kF-_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ89dJGsYsZdyzdIcsDct6Zr2H5FJFZ9WoD5dYcB4Rkyw&oe=6AE9FC2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3vSpjtDVM0Q7kNvwGZHdo4&_nc_oc=AdqA9-JXkh7XGOpWRq_5KJ2CFsNDM931lySqKkMuHUkR8pMmmxaTde1W6wo14gcNLco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz8LJHJQpZ3zDUC2spUq1qZb2EyEAQTxAFyVODItWGIQ&oe=6AE9E80C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCFk7KJyJ1cQ7kNvwEeMe8Q&_nc_oc=Adrvgnx9Py5iKHe3PlkMX8Uh_iDW7DH4DZVMnDdEjVn7mEV1v7MbhVakjxGJS97LnGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqBKqPb_9dOWMq3gtGRffkCFx2bBX65u7qWWGH6PpUcw&oe=6AEA0FF9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
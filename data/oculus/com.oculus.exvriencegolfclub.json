9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-g-97s2e6kQ7kNvwH8ZF44&_nc_oc=AdoN6fFIsmhiX2epu0-FHhc-ZJu9A_DFJ3y44Xsq4pPZfLAim9bOYpVP9FDWTOjKWO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Az25XQoqvby2b7F1Nca_nm92RRlMRtLnj9hqMVn54-g&oe=69FB406A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMiFly5Ct0QQ7kNvwFyxJ-1&_nc_oc=AdovlChsVpcFejIrh3yI-Jx8kE0pfhyW1NHS1rt6NXUCqQsRjNWNkShqRyOf3fshGE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78a9vPOtrifqHLXeys9hS-ubxpxN1g2zjNA2SBU1WCuA&oe=69FB4846"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb1R6Aj2N08Q7kNvwFrIBl-&_nc_oc=AdqMlSRd1IN_WFGchARCpI2UIjhGR_ktQs1Shb2esfaRn1YQZvCjMTicHmg3pyMOL3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Db6PwIAaaMq00WnfCcWbuWvMSigjEzB0YeZYus7f3Q&oe=69FB5CAD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQAeMFr7KSkQ7kNvwH89ksZ&_nc_oc=AdrqFI2aMLKMy-uQj7jq4T4azEJAqt6CmDuo0Knwdok95WstaxqrGFcxPqL0Pn4cT_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7300HdWWCHOG5-4P6iQhBWtpzVVaSv1VvVQNsK-UAmyw&oe=69FB488C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsIKk0X_qhQQ7kNvwGwgMMg&_nc_oc=AdowbvSUHFgu7XuL5ncbfoEcht7fBonZlKAnMF5sD9VDmUcUpik5ORyS8Lmmh5QeM-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nQIvWsnBjNwTi_6KgQQty5KoIOz0FnXmqsI1H-VgqdA&oe=69FB3839"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
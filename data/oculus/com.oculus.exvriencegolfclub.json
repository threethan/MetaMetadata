9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz7q-h1YUfsQ7kNvwH2TSlG&_nc_oc=AdqdnJXmTl6jGeRXPmBGAI44X83aUKIJTQJ3YYDEH2ySEXpbRSh8c2_b57cSPNM8fMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lDOmf80dkOlXbVEcq0HXajFRWErvmN2mF_W_Q5dY3EA&oe=69DB9C6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsTG9DXlJn4Q7kNvwGyKGjb&_nc_oc=Adrz0xT_CqAVuW5d3YpgWnIIlzbV4zY1zBa1qmZVlBDDKixq5TZQQy8sBrLtz2vxNzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EFpwhvpRS_zMGgEptt5TEpKzHlicNGhPMm__yoijxZg&oe=69DBA446"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK7iubHmNawQ7kNvwEcbIkK&_nc_oc=AdoisRZJ7HLcS7_voZ3ZEpSqnlwa2xdNp0f--nBPyO95CPkVcPTleP6Ka1Blitz_YKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iZtqU_IXU0Stis-QqysBn8pMkCJQFiy7lY89pcrUlnA&oe=69DB806D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWl8IUm5JNIQ7kNvwHCzakI&_nc_oc=AdoDBK3Wf3lkH-clr59FxTuzltt38Px1Md9w0MH0tU1zsjsfqB92NP6nQgHQHisLfmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af041sLqa_sSTKe9RIAYLjaQ3Yb4uTszyJyyZjDb5oCxWw&oe=69DBA48C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUCruapEHPoQ7kNvwG1M24h&_nc_oc=Ado_WXL3Qo6pf0LdVeDZFzHHQv3j-oFVUkpsWoda0z9JAVV2zDhvfeDxNGUSByQgT80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r0al2aDEWKJLi-vsowUFEFjwKmmRqSRmaRRfcPuLnIA&oe=69DB9439"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
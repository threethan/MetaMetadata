9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W2UDU8OP8cQ7kNvwFKJ8p3&_nc_oc=Ado2bAjtE3-XjUlQQG_xU-EzWGK52VYilcJEnmp2-nNK0WRvU7AZYf3Dd5Ubws8Sc80&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIckPEwBGOwpA87MtGLTr01HDJL8niRexQTDOtm-rHbw&oe=6A942E6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Elc-sIt87oQ7kNvwEXj8jt&_nc_oc=Adq3bQxBxZaJ8wfQ5v1nmV_vCPaYvGLHwLIPSlpiCJPXjvkhStm3P5A1P983zj-MPbg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYWq_0_s3M7HHGyT7EXYQo55m7FuXK-Z_sR5l-I_YR9w&oe=6A93FE06"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yix5v5bTLq0Q7kNvwE_PaoK&_nc_oc=Adq5kLOPaVrpYJEroAoGOR0_eo3bVYdnGN5WwOXv_R_HkFF_EdZs1kSiNUVfXdQvI-c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSn_tBK7v7vhZPYjtTyN-n2P9CtBT6t2IYxpmAZZ-VFw&oe=6A94126D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bz7P0sst2MQQ7kNvwFMrwbz&_nc_oc=Ado1bTLttdDbVuspu8M7_K3HybMHRNzOqQ2AhIrrveNgW1U9bQ1CUh9Ct2VBCHOrHaM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfS_Qe1jSawS7ELvNrDA99SR5FlB5tojwgtI9G7il8rA&oe=6A93FE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bc9B5eiCNioQ7kNvwFsonuc&_nc_oc=Adq6AX-YWqY0jyjn6jNh7H3vms-QK4--QgC_cHTiyfjsU_msYstO86b6OkKLra4aL1Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED77cb9xp5I-PkGuYzNeTyxe4GPOT78zTd2aS1D3Izzw&oe=6A942639"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
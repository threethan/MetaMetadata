9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlJEBF9HToMQ7kNvwF9V1o2&_nc_oc=AdpGqdLWeLqihL1WAN5l5SmC1qAbmi3ywF_SiWZXtF2dbbWNwjQUIFQdHfYLVbl7YaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNgveYTXQrQ6OdfZGNkPixq6gYFIIXtlMmVT0SHplh7w&oe=6ACD172A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBBT-AUQ6RAQ7kNvwE4KC8u&_nc_oc=Adr97FmeRNQ1I2l7z780mvoVS49O8ZNiReNc3RcrUTXCPwQ-hf22ASz0Qvjj6_4Nmp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDvgjdWSSVDUMBGUrWaEDgMPyTOz4VHc3KU23KeiYUmQ&oe=6ACCE6C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8tMIKFIP64Q7kNvwEjTXBA&_nc_oc=AdpsFBPkwa0ZkHUWCdtHIDtNVvN2cTm-0RdSbY1tXgV6D0F2LsOh4VeU-AEOHf44Azc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQqUGaNtkxqME8_lroLJk8o0Lwd4Tbu2xA7Vo8KnFwFA&oe=6ACCFB2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_6eByloH5EQ7kNvwFlZnrU&_nc_oc=AdoRcka0KbOXKvrTQQdw0G-Bi7jOkJ-bhnKyMVlfqE4YevS1LUgN7p4zRnVHnI6VtWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzUKcaOIZSewHRvwiKOho8K-IWbjwWo7HvtpKa3T5HCg&oe=6ACCE70C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bj_pFcrt7FgQ7kNvwE5T0vU&_nc_oc=Adq0wJ3Ak_6PzNO-B5iXD3kfRn2O3Q-cwP-Z_4zN9j-VgiXxiLle-VLKnXW5_uFy12c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuIcK-CPVyGK2m6usMYLF56gAnRq9xNaLPJmAAD52EQQ&oe=6ACD0EF9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
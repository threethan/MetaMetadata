, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaC0P8ak61UQ7kNvwFKOgTO&_nc_oc=AdqE-wLkS0Xf8rjN7r081mrAjSXtCct0Gd9d2xDsen6lw8vuroevesaG7z4ceFCYxuQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rUe8A-V448p8_LlFv9M3fRXMYj_0EsWygqcBxVuMv6w&oe=6A2C0FC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKjU3IKHf34Q7kNvwEejQ0i&_nc_oc=AdoZBHr0SGctiChJh75fYNqkczT-e-Yltc3MpeI7XD5osE3ziilw9KMU1OccHwdfy9k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ioSSK8YXqZPUF30UaMgC0_86Gqr1RF9-NjoI0JoxuFQ&oe=6A2C242D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3DkMhA73UIQ7kNvwH3wPgF&_nc_oc=Adr3xcRsfp55o4KSnwLl906oSHwPJZZyrDeq_fJfNYT-7f3iJ-ItIFWyLxdGrNSi5ns&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ghu-wko8b_68CS0SvJDQUimPFlfkOodUqseKPFsoJ4g&oe=6A2C100C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC6TenJXR4UQ7kNvwHkaJwg&_nc_oc=AdpwBNfe9GR5jnRwMn2skLwtRBLXq0EUtodKkaOm8dQZrRvfsZ3AlffQMhNaIPB7Rzs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2p-ADVmZqfk3j8tI0kjebbMpoTIYA8AKwxLZhNODRtw&oe=6A2BFFB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "R
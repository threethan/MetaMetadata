9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EGw3tGNvmsQ7kNvwENmQwi&_nc_oc=AdrenOgn6MTuNUEojqirZwKw6DimA5fZFn45Ws1BrIDEVqougKZCoPV_wBNQ2Q8rFGk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk_4pgb5IhY1dtnxx9WuVFDtpl8rv7A5iozbG7OZnNIg&oe=6AD0D36A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKbLasau77oQ7kNvwHcAEFQ&_nc_oc=AdprsppoGF8TGSkUvYAIfvGvw_yv2lCv4gaBmFzF5rA5btuD73MljUptQoHjp7fEro4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMda6u5dmBS3Y72_IppvzGyCr9TZde8X7LGQK71JL3rdA&oe=6AD0DB46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qh2Ykqevc_4Q7kNvwGPh2nR&_nc_oc=AdprorCXraIj7dTQVgYdxKckOo0iwqA92uH1ov_lsia9ea64glrR3p1lxIgj2qDRVKk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5G2XAUxZEqyfWbnmrQZMOckZisHQF4YU_DHA8Asv3-A&oe=6AD0EFAD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a96cdnh-lcQ7kNvwHEgTkm&_nc_oc=Ado9FviQkbyok-t51n73r6NuXB_4unyoPRHMHCq8TcgSGwwvb2qfjdHRFlvXfJqIijs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNreS0PAq6aDvlGbgG3k5_Mvz8ZAxbfIyG42epLxXV0JQ&oe=6AD0DB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4HUFYLm-RgQ7kNvwHxqAEj&_nc_oc=Adomg8oeEPkzIpVGOSTH_mIGwE7vJnyA-UQBNW9WaQltYmiIZVPaIO1ILAbV1xmnoKI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVY9MzoG-PthX6hXN8zYp9YXRooIAVGmyxe7IIGkYYSA&oe=6AD10379"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
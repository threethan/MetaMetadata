9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctR6Djn59bcQ7kNvwFDQXOi&_nc_oc=Adp75-aWyp6pSiQqIF3iOykC6LciNq2iUr2IhwDUi5Oxxeo1y9YTAzBQpDcZqoLy91M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-fyBmCFFeyE5bjvrnVW3jUs1IGdgzMvRlAvwZ7s24rQ&oe=6AE73CEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xu5XGTjIzsQ7kNvwEVjTfA&_nc_oc=AdrUaGvwdm_6PVL0CW3shdiLN2b3x0827eYxajti_1YYnMluM2MDE6lcR_nAjBt2-lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrh4AQA8Csi4mW5Pfxcrlgzc1GXp6xpdppZnvCeZkl-A&oe=6AE744C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfg28UTebW4Q7kNvwF3NqZy&_nc_oc=AdrK5b5j0Biy6OfSiUz20vXrBqMeqea40-7oqld1FloMlZOXb89jaFtanGCK5mlrrPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJjug7PQSZNDpsGO_0FvF0gDQV0_n8324H4Czy83MgDQ&oe=6AE7592D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3vSpjtDVM0Q7kNvwHp9ZHs&_nc_oc=AdoaQoj2ALS6pUIYth5vYoFzGRR9yda9o6pW5q0qO1rgpOLRhHqBtGWoc6rFglzSQk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-fcjCrZh6g0X-cUKYeU4BvwC11xTeC8bu4LrFDrwS-A&oe=6AE7450C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCFk7KJyJ1cQ7kNvwFfmjWE&_nc_oc=Adrz_9cgZY1Bp262qPYMgEATr47CbeKoxsq5_Sx7Kfv-RMs42aNipAhoAL1DI0VLnDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr6ELVO6xrIBQ9oG_neAFUsHE5TqksX003IgFJaR9bCg&oe=6AE76CF9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
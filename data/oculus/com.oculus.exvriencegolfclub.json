2427189_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx6WuBUiTGcQ7kNvwEPeGzI&_nc_oc=AdrstzMaZKkbns4IEMaH0LqmoW3tPm0TG2I9VzA9T1fUqC22kjNCuU4yklxvTFn_mOU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sMaS_JpMBU4_89wiwSIfJr40HFwD376DIriK8FaCm3Q&oe=6A22CD6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq2iT7jE8O8Q7kNvwHgjdYT&_nc_oc=Adofa34Ncq1zo4UwsAN74op7nj_kSLT6hHK_K4K5iKcwigsE3zV4aTjRH_sDVy9PTFI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pNTJ8C9qEQaPs6pQChEDftHSxiGXSk5YDDPjRQaSlrQ&oe=6A22D546"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvM_KQb51CUQ7kNvwEEQ0Cm&_nc_oc=AdoIcNB06ShDppLPQFvVZdr3y6mGI2dHbRzxxqbfYoWBSDLd4DZ0sS8PibdDCO1xKrM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b0dYMGbV7UVNcoreU_8k96N1oqZTmQS6M9W2Ek91M7Q&oe=6A22E9AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nd-r8U31sfYQ7kNvwEtJPhH&_nc_oc=AdrFgiVc707XODUAcKQtDFKEP-Vc6LdQoWyDm3f1N8Hih0Pk3TJAN0NoUm-Bc6lqHDQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hwdGOFsJaF_W0bbUdRMAQbCPudcQdd2CIO7OqPw_i7g&oe=6A22D58C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jIamC05L5IQ7kNvwEitKRA&_nc_oc=AdqOuoxHa8e6EAH6hrL45Bhwx2nlMQJTzRUC9TvWKLugzVYP77FhmgehOfTONwzSPk4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B3hF57b2C79axvE6xlTmMyx9QHvG60gOM3VPG0OEUQg&oe=6A22FD79"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website
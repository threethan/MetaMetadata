9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrZCokflkKkQ7kNvwFjACGw&_nc_oc=AdqFlw-0ccUv4aNhUfF5QDlWMlDhZNPB1VcDBE-isa0KYggY7olxW37Xe6YMsxt-jDc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1AxXH2S_c50iIiBaGIhPsS5M0I8GhHg2mf4fs4LEUwQ&oe=6AA15D6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elIDyO999zIQ7kNvwGDbNPX&_nc_oc=AdpDkQVCqgujCvidjr2cnUZaQifLUCfur16i_XNKUu1lkwYtsf5GOQZg9LREWHnCFmo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPy2ZfRDmr-KghDoVAlM5AcwwRyyHXXgTbj0QMsTsDeQ&oe=6AA16546"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2lGKDRlsRIQ7kNvwHBCPTD&_nc_oc=AdrPBD4sUcjNXS_x2dYr_2FgUNTbCzwV3-yV7jrOG5XUK-PiVasJ0YwnLN2MB--EPjE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2sqkzdm20KFyesw9A6n-nunwYOJwMAJPNHugwswOZBg&oe=6AA179AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nKCyjhUmwkQ7kNvwEJd-ih&_nc_oc=AdqpL7-0iAXF2B3WoXI_9DKTQgTCVJ6OIQWispU_kDdXSoniPHJn1R8HCkyp8DsRpQM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKATW7FWyNzUagwmOw8IG4caHFLzZKpYUCVsGrhkX--Bg&oe=6AA1658C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo9ikhZnjKgQ7kNvwHZTSTR&_nc_oc=Adp3N7IjKxhB87zg7lNbOBdEZRDSJBh32GkufA58BFdqax0-29LRxmJFMNZLwhYnYTU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTQdBG_25dtiplAlNJkzi5oxlSPM0Q1MDEctaomsspjw&oe=6AA15539"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
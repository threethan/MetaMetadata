9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjRQQC_RIWMQ7kNvwEuM1kv&_nc_oc=AdpksvdiWjx3a7b-HUJ_STpgJYx-giN0ma1KAm3LSOvfT0SWP6EKMRHMN9sz_z8Gy-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHU6AYUbqcjh5cZegUjI1MreEByKds8vYY4_OylgT9JA&oe=6AC798EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goPVNTDWVwEQ7kNvwGvmSj9&_nc_oc=Adptg7Ko-FC_8xFYMKxnt_TbOto1i11Goz254Fx6vaScEx5buY31xBoU3xKr7lnXKq4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNowCe56hf1asmBNlUcheGB3JqY-owlkv8S0g_GCKpsSQ&oe=6AC7A0C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeBsLd6pNtYQ7kNvwHt3v3M&_nc_oc=AdrlfnlDPuz_eUDbWKjuzetFavadsWLTMH9R1iU14E9i6f_P3Ch2GLSUoM1LrhGRJY8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0v78kvgw0an16A26gBk8xo5G1oCYaw084xVX6HwhzPg&oe=6AC7B52D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmQUGUUQ2UcQ7kNvwEG7UKd&_nc_oc=AdoNVccSbhLYqkdNw2mdiUXoGjZEyTePg9er8ahNhlHg6IjJCRt6NgdFCjNLrh8KTlg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_RZKl03unDUWmFI18tRr9iPzdIkLTl21_pfxMCiyfQA&oe=6AC7A10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CagElag_IwQ7kNvwGhrTdn&_nc_oc=AdqM7miTEhmCm7JwXF0s8IbIs1E_Yo_ldn0Cef-DBk3Kae9nOAR97IESOcBJjddR26k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYHS0lspCc3YFDtNH39o1Eun3EXObnNbR7k9iqusF-Hw&oe=6AC7C8F9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUDRzJA7yzYQ7kNvwFLOQ9n&_nc_oc=AdpRuKKNqx9FRaaPUisqkT5OZ7OFZQl9S5WJg74j3orPFwMf-sxY9xLULI-T5hUNDKc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAikSY0ns53PSOW4VgUFekireeESIqu9udfXV4rKUlLg&oe=69CFBEEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjTeHBUeSugQ7kNvwGLN997&_nc_oc=AdroEIzuIs3s2RKZjKcRWXu3ADZyfel_FbEUsJFQpkI2vpC-nOhQmNQOSK9S1xV_StI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXunZxVqj9ca3hZiH7Ci3WvOolJIDox0nGziPxXdtizA&oe=69CFC6C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avU9RD26oH4Q7kNvwFzhIdv&_nc_oc=AdrnTTajBkkzBW25Xrd1ikI5NvplDdVGuiGqqR41YFn8DD4M02UhB-byZirsTuQDMdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz99JiUwLrD9hHd95LCpVsQG1rd0aIcn5XZLxKvKzhN8A&oe=69CFA2ED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89Vi0dMNMSEQ7kNvwEtd3i8&_nc_oc=AdpO8CSkPf6415lkZIq-L9m9W9bA6Oe8HjCHN0Wb25_S0tYSG8Bubd5XnmUy--8ZUuU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7oQimgWY88oZUy3EX-HpLDCgEDB9LU2iKgviqfVFBsw&oe=69CFC70C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUkBPtrgapQQ7kNvwGhho7T&_nc_oc=AdrlgK0OYxsaazDzXXQHYEeLHkVOYroYfV8fdt1i_cv_bZSEKnvF5jW1D_Xra-nfGz4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7Z4S8So9D_YMgKIUha_dKNZJHh1kuLxRPOU2u1zpzaA&oe=69CFB6B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
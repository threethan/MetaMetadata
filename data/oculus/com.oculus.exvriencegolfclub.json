9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RAfEdnfF6cQ7kNvwFAXnlo&_nc_oc=AdpjFgGVy5GTKZoafmMpNIk4tdyb6NnzaaMCFHbe_-YuWE2XfEnPfWBPz27b6t5MyLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwfy-0zw1RCXDKyij7OycmukRRxvxgQQiIvYxJSZzn7mw&oe=69CBCA6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTfi21ZvY8oQ7kNvwHmKwoo&_nc_oc=AdrBaAYREDWtwIEB_97k7Koh7GwMwyNjpX1Wap6Sr34fU0vyfeGwsOU5cpkxvIQCLsU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN9LqJgfTOwEbAuMaynt42BCVCfCNev0M2vULk731gdA&oe=69CBD246"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0RtTE-BkQsQ7kNvwGZIxj2&_nc_oc=AdrNGgCR47Tp4RCIgyVGkG2AVCO6zBaiXj_MRWpgvpSRBxZGw7sm7l9A8umco9hAPVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcrr2mCXiaUgiaN4EBPuydpBJlMfJ307kmttHCIZQmhw&oe=69CBAE6D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNFw0-fVG9IQ7kNvwFwjR5n&_nc_oc=Adrf-IvF8wdVNQC7q2tYa6WDtQG5kRhac3Pq2KLpMwyeJ8SLvq7kgLbb9Q03S6LYnHU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX-yGYTbUoQQ6k6dPRmtmism1_N3p1N0P2aWKivYc3DQ&oe=69CBD28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQcXW57QhhsQ7kNvwH4Cflv&_nc_oc=AdoJsNxt0lh10cZmCFlo6JCi1snT9Qhu34HUi47OaRUvg70EMcpQuvOKc61wfDLicnk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4Kp70pctyJ6XVb8ogTPsDs_IH1-V0mhSK1lwnazF7ag&oe=69CBC239"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-R2mORoa4MQ7kNvwG6OMUn&_nc_oc=AdpO99B4X_msDtmx34w7xuNlnac0dRNR7IVy6Q87CFK4maalAANCpzBxyuGG4x1kyyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtdQKRXT6-e7yCJJKLLh8inK1RNMK5fMNPBJgsowz67A&oe=6ABA69EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3Vsb4M3XvwQ7kNvwFxXw0X&_nc_oc=AdoJQhpxWOBRIk5cJFYjpg3c1H1iPnmwLCqfqNhOCusSaMPMj5yaQu1AJpaZT5wcQdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6ZPFM4IT7io5U69yh1pFblIlwtgQOH97X8XNfIWiHCA&oe=6ABA71C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUyWWP6luMIQ7kNvwHDfbRs&_nc_oc=AdoTxpJqhRKQFZ7na0pMnVSvMis4ZhKs1bjUQvBy0fYShSvU_E3ywrY7o4J23cuOemw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIzUkS7yFalTm7OIqZckFyCGP6vvHRFd7nBmjOEBhC4g&oe=6ABA862D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PW9yxqUXkgQ7kNvwEsDv1t&_nc_oc=AdrC_bRyihDXeVvjh1sznOEFtFRJ2smEqaWB__JL0uFRUbXamGrnA6sTyIf6mgvvWug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbSWCjLnVhC5aF_5jcRVa_9cjrS4T7rLvPOrxfA14KoA&oe=6ABA720C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk6sVyHbt5kQ7kNvwHRQkse&_nc_oc=AdqFCc3SPHpquzz3eL2QU4nxxiT-GDRDdjzxFsGkrf1uPkkjGS20YxkBfd5ILqymHvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILGpYjbzaoidHP574Fp7EwrlLGiWPL_izHBoLORRDO2g&oe=6ABA61B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
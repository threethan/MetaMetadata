9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6WEpNXnI44Q7kNvwH1ggi1&_nc_oc=AdrfE5uz0TfI2K1cZZ_cv49GTJRgr2hR3YcARbB_eW3dv44c2jq2kGJ4Yl1o9LsaJvc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_zklf8Jdga83AQCnfus7SkyuiX2yzaqFIl4Kg8xRm-g&oe=6A10586A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXYKJrnPdvwQ7kNvwHbZD8s&_nc_oc=Adr9knlyYZ_4T_MFytAdxUTA35R3x4WIX6g4I30jSBnyQNLTnKkg2cU0jhKitwiFH_s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YzT986-33ukuEb9omGm1YJ2IpAF3Y0jKtJxUzSR8gdw&oe=6A106046"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9o1Ep7knjcQ7kNvwG3t36A&_nc_oc=AdqPusUBnAoCoHVgvpWzEld_WWUceqdtuBAdcnLkb03CKFxcPZdGVdYEHdVczQ1wX44&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47IMno6E-CY54NT3R_nY7UF1V0dAnjoABCSDZY1BDnMQ&oe=6A1074AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2kAJxeNfQQQ7kNvwHsqowK&_nc_oc=Adpt8rIezF2Tv4n2BoNpduFnD8DEjLFVQwp1x_HgC5WRAJDt-YskncNJCml3AnHGZ0g&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bz9qQSBS9Zp4t19jJEyMAe8duI9m0EBXVsPXxFdHSNg&oe=6A10608C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJj-i8Git2EQ7kNvwF1_tNG&_nc_oc=Adq6orCj99hU5WvjJYDiqeEOxN4lAOGSHFfdhd9LcchYxHb6lbZYotqTEF751ApOo0Q&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56hSCgPWh8en8xXSKK4knE0NTOZ3UthdUb4OhPyeqSiA&oe=6A105039"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
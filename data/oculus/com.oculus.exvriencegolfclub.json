9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwcgW7QDW34Q7kNvwFNaa-G&_nc_oc=AdrRAs7FcnQ24_CUYFkZ5b-8Xk49bUjvy_32zMeT2w37Db30BnFH91kVP8QSp7Dwz1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWfCNNw2zbtGDBVQJWV-ixCc1Q2uGH6B_eAG9ymT2rbw&oe=6AA6A36A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5sALUmS9zMQ7kNvwE9BXj1&_nc_oc=AdqY3_JhGJmouvMHS2uoeot1ZaqmtTEDgE6m5lRT6CHMyOzrvxGO3UjtsnOBCv6wBlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1RDKByb7nkL0rYfj51aDrn-xEWpv8ihcuuy0f3e9qvw&oe=6AA6AB46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVcN5SlvFKcQ7kNvwHl8LbL&_nc_oc=Adq-BttbqnI77xwkDCES0ZtVgMgZ8X-HIr2vFXqkHbmoqc6vqKvuD8XogUqs5xhxRbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRmOkT0suqtaFcpONXViIJF3PW0jPfKU3YKQ13TH7mdQ&oe=6AA6BFAD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oBKhX2hxGEQ7kNvwFAMWL0&_nc_oc=Adqaqkv9OILlarh7zbygwiBBkcb3QnUvdL_MrbfxPSvk_WYP2esh4rb2H1EswP2UG40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXAKO5HFqC9Hw4Zyeo1E90gzDcPhOvWeyawA01NhfJvQ&oe=6AA6AB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHmB-pWuC5wQ7kNvwE4vwKB&_nc_oc=AdpXXKOogggvNOLf4v2URlG2h_WKYJVdxtUP6-t-eqibbSl1I_miGRcFSyPZlrhLXz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI08IP8uhbikA1cel6PHwBA4ftIMvqPHjNM7NTpvqrd-A&oe=6AA69B39"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
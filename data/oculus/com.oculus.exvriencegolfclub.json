9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKG2BgS3ymUQ7kNvwGW3HWp&_nc_oc=Ado55GmJQb4rDYXGxAfoUg6UrzzlNJCro6k5AtJiD6ubj7EgrBHqVnn8kzvPC9IUF1Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pk2bGBpe_7Rv09Vbgocg3XidzSwQRb3J3iVaZMBTP-A&oe=6A1AE46A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MKUrkqjF44Q7kNvwGCIbAO&_nc_oc=AdpW2K-99ok_DWrhi6hoNX3p5MMZifvkPhRULJ-g7wFy_fmSlmmbk4gweh1apW_1J2Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u9Iz2ro2XLvFJduL8nRNgJVu9urc75HF-dyYvRV42EQ&oe=6A1AEC46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXL--TcyzgIQ7kNvwGqxReJ&_nc_oc=AdoRQ7NFh6GS5Jg5Xl0m63C9PCOzDA-9S_NlR9p4jgb0suxxl86Bf593vN8qMe3oPCY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KKUacFGfWpcMjSCa6oAuJ7CtwvklhgPeDCuO350b2CQ&oe=6A1B00AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzjshCCRFMoQ7kNvwGURRYA&_nc_oc=AdrZ9b1gCAdRFKvcb0QNlOOhYxUyJdDGOx7Z0MB3WzXbejGDQeUmORocHKpLarhYBy4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LIZYPBQFxFkfM4u7-Wn9YVHgLnSOANG87LBjKxgSnoA&oe=6A1AEC8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9Sf05IOCZ8Q7kNvwHKipXO&_nc_oc=Adp_ERZEJ5YE-EwqI10yQtFnye8rmyXBp0aHm2tRk927RU9GKpBGZgcmdKF5WVwPTro&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_MUsQU-MTKfI_onbcqc6S3J0rKXvB3IFBxkZCrOCMNA&oe=6A1ADC39"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRg1dZP6S_wQ7kNvwFHJXbq&_nc_oc=Adp6MDZXDwvDBoloSpolITL3MTqjqE7U2UIKYESEkMAPpDh6nH5a1f37NHP-b67B-ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hVYo7jG2m7nX1WEUE8IMUJmg431CAdq2WDAlEK_aWGA&oe=69F89D6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMiFly5Ct0QQ7kNvwHYBC7G&_nc_oc=Ado_ooaRrK5JME1gNy0jO8ImQbC7M49yxq9ms8kqqSwcD0VRUXCG6drxT5WN_C6KiXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3khlwtJXohxYwDjaEwSyQQJd7sbap0syk3_Wh8jURM0g&oe=69F8A546"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wz7oKjVGMgQ7kNvwF1Lg3H&_nc_oc=AdrW7n5515rLEfWoQRDiy5DXUyDU1vbBUwH3M9OuZXKJWVR5e_d6sCnyJ7P_fEiWmts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_CCiIX1qBWnBU5Ltg42FCnaRgGf_DqAm7m9Pk1OU1UQ&oe=69F8B9AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV5sp3TehsYQ7kNvwHKZBtQ&_nc_oc=AdpRacBBY_eXyDVACuYZamjKpQDPZz3ymNTlMKll1YYBmO242QrqAW6qrXD5mZYCs70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FVA4La3beeaClikrTsPHAVrOhldVZMQGCH91osVBTpg&oe=69F8A58C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLwshhM8NgEQ7kNvwHXj-03&_nc_oc=AdovmsS2XG6giKDy0u0vJjYniyd6Rvbk4mUDb4xkPAfd_8RHxBNascD6BWYSOWY1RfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1u2RFmzhUmOfjHzmpAGpppLN7eJndd9vmeVKmlTE8feA&oe=69F89539"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
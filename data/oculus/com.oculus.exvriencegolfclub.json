9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qeAtwZgvtQQ7kNvwFPHRwL&_nc_oc=AdrPOvrQWd-GM3yT70LVBZ9pLF3YJOJtBlitZm01ful7qbQBD5eDMGlWzwjbqXNWxD4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ez8kzkj0YjRZ0ozadOlbFoj6rJsPkM3k2AKWFa2dRIA&oe=6A217BEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTJ8B0_6RdgQ7kNvwGlV0AS&_nc_oc=AdoLB0hA1A7VnsMFn-pxtEqccfhDITOGd4CBPab9uhuK-iVO1ASiFq_f-WO0XAG8Uyg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tTka7cnRPBfFIUOXzOTutcUcQfXe8oE5vl16JbviSMA&oe=6A2183C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvM_KQb51CUQ7kNvwE5ISJC&_nc_oc=AdpUedFzMJbt6PdnT2Xs3blfazDtnXtBOGAQBqgSB_sLnP3OQiF20S-oy5tpUsudJFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ANtXKFwlPjFoRKaLUh1vZeivGpVeWUGJKJHkiEZjA7g&oe=6A21982D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nd-r8U31sfYQ7kNvwF8H1GR&_nc_oc=AdphHpfr0rzFCY2zQaMCI-E-_pT2UgKu-wrPIg5L2i9BvqavbVwyZ60njZ4fQHjZgy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Eo-KCL4cZX8PgpKo0RP5vylaVkRytX6kF5SYxmkAr8w&oe=6A21840C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jIamC05L5IQ7kNvwGqWggq&_nc_oc=AdpgF6Bar_3KrbMKVIlA8UrfVoKl28iHAa4HRw9_ztNknicg1OX3uBoaEhGDDP1Y-T4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v2VjGllyiMO-Sqk3j6f82APfEMuLv2lJ0xZHnHgPmTw&oe=6A2173B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCpSx2E2cFQQ7kNvwHcy2Ox&_nc_oc=AdocWErttZqrdpt3Mcbxo1TxweBZm_f6FOhbW1qtx6O3NRhfeh-JrP0G5ljyAccF2zw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af728cRDwvQytC8A7ETMXxJLZnX9ESTiJVhllwQBV9uoVg&oe=6A09C0EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40ygLYicNycQ7kNvwHwtBMq&_nc_oc=AdpRxgacDMU4-Qsm5m7LpJPpCxrmMj6iiMj3jmk5zj_a9Rb1D6nO5Mkyss7-7PoFNwk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64Nz6tRsADABoxFSiBBwqxsefrDvzeR7AVg07jkBuGmw&oe=6A09C8C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBUWl3mhNfMQ7kNvwF0T04p&_nc_oc=AdpA6IGqzMyS2FbDZzT01y_23ZqrJgRWU3gwewFn1vaIF529KgpGAjbpAPnxXhVepoA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nTylu6BF_58ULcRpKDSzFMocpBV5khy7DpTPAMLJ-2g&oe=6A09DD2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfNRVrOmPucQ7kNvwEf_iHd&_nc_oc=Adq--b9wtwP6DlT6CyxgTFJWK6j5I-WZBuODwAeRvZbUF9f6Akdqr2NRflZzleL-Sso&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lMyCj7lvGOlYCL6uzfYu60d3ZFmhjhIiqyKJAoriTWg&oe=6A09C90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHe22eo2QsQ7kNvwG8di45&_nc_oc=AdpQIoDabJzOYsnkRpyoI3M8WudIbRhIFnSxyTmcJExU6Ke5CMjsYcGAknPk3VGA1fI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44pj6olsjXwr8VXAvr5eAvtW5Umr0rORyY8t_04_qBnA&oe=6A09B8B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
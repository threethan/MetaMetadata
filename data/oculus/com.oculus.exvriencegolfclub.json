9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLkDGn2TzvAQ7kNvwHmb_Tu&_nc_oc=Adp1Zex5NDOfJE1ScuR4EUko0tyKb2Fi7PgC0Mma7kPqBnf4JTwXDIMsF9DWiVflz-w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxp8QmaDIselCOStfusrNT9QuxOchmrHsmHEDPn4kYWZQ&oe=69C7D5EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDD4LcBywZ4Q7kNvwFBNlIp&_nc_oc=Ado06-wYhbm8mOYhVBa-ntwadh1Y2pKUCC19Dnk9hkK3ozYhaXG691Lf95pZpMx3CVk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxe2PKXpya9V9Y19lrZTA9IJ_I8trD1HkX2tMHfplntUA&oe=69C7DDC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trO4T8s-5asQ7kNvwETf5UR&_nc_oc=AdokQG5S1li_JTsAhjFk7_kLEBY2HXxX8M2qintFP8lw-QpN-c1fVU9a0yzRfJFfb3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2hq7Ykfm2Z6tEzSvL2XbWE9Ao6YivwwcGPZGubCDnYA&oe=69C7B9ED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1gj5zvJRUcQ7kNvwH74gQg&_nc_oc=AdpfCxHhlU2Ro8aNqCpO48d7ELUzr3kHtHvUKjlGCVGRAf8Jc6iKxkgWyQ0zHmu21Oc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuFqBoNK5CgWmpdp8uU_FHwpo0_DaLS332YhUzYRHwfQ&oe=69C7DE0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Edl5WYMGcQ7kNvwEg2Bkw&_nc_oc=Adri0GYjPAYD9B8pBUS8zbU-Vfd1WefWtvd9hA8yF4bR0GpdSk1ujZ8xRZRROpEUavM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsMGDD5cheqM-uo4I-WPLCk3MZ9mAhN8EdXZmqV_C3Hw&oe=69C7CDB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
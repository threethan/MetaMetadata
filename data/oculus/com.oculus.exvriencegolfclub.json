9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4qCLybJ3MEQ7kNvwE33qsL&_nc_oc=AdoPq--KiOftlJi1uuUJTx9Yi9ZqHLqGMjU9WVowor2ADd4xjnVixrQH5QYbSD3B8Z0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEsheTsf4Jc-iWPa2RusBthbOqVyr5-FtCZl1POWSZgQ&oe=6ACB8D6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u35gi3RGsOMQ7kNvwFRF0z1&_nc_oc=AdoYHPsoa5KrFyu338a1VDcT_MrnP_YQ9BmqWXisuPT719R4BwnMdWOgt6QeEJwU2qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDNQbW6_w-4YOQjTMTh60fcsIESmBLrkbcRhe42h1zIw&oe=6ACB9546"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8tMIKFIP64Q7kNvwG2ac9a&_nc_oc=Adqg2c7Tn31X7I6Jd0fs4ak9oan9e-Z8B8eFssK1ORoe_wNkg8JF5UHwfTjzfPaAu9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfVYOx2Ai4CA-0jqNz5jNFIUZBMF2bvJ_KIv32Di1DJw&oe=6ACBA9AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_6eByloH5EQ7kNvwGlIPmI&_nc_oc=AdrzG6RWIBV1vNAfpO92D-Ms0cfhXVkTAZZ78Vh0Rz_j3HhzBty2Rq-MjzsEk2j3bJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXAZYp67KYgeC8H2LcTS3v9NKfv-kD5idK9HPDQKiUwg&oe=6ACB958C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bj_pFcrt7FgQ7kNvwHmeqfC&_nc_oc=AdpyAcNkYzt493jT49j8oVzpDCNm6Ow3MGGN7u1-9UJxm_RQGk59VQJlbMqh8Fgrby4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO6oQB621dkQOFYxyLWJ4sr3T1j86yq-Mk8Nu3dfsspg&oe=6ACBBD79"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
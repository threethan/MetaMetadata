9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWgAIQAdCaAQ7kNvwE5y96q&_nc_oc=AdquYT6IJY2yRd3dZ6NSvEZKOOsbiDu4Vv0v0wdQp2XtVCVNDZeqaIhquVcqExwg83A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHunG8GPnDSGG3kEhNmCayfxNLAs2l1t-ndqCl9KJxQxg&oe=6A81B96A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrMQd2G5xxoQ7kNvwHRz-sI&_nc_oc=AdoLVgbE3Fin8vxWXtr7P1bsc7RKL9FE10EXP_6fJ22Hdov1Ybrt-vKuBKpo4xaCXmg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe39-AaTSFVSVhG4CzTFpbstWxhSIkDXEdL1dyqroRTA&oe=6A81C146"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjQZx4e2Y-4Q7kNvwHd5KkN&_nc_oc=AdrEBHZhC4TUYJEgFNRA80-a-5wxDhhYumDDQz2G6vvKw9dOZa_wxyop1kVZwFbkFWM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO0gow3cIxP80htbeoJ3IxmF3-dzOcj2_wlSoR6TwPxw&oe=6A819D6D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jASpv383-9wQ7kNvwFCEt1b&_nc_oc=AdqXEdoNUb6jjYvYkVHAYYEN4zr7pL6Z1qPwvu_EOg0uKM1mysBGe5hlk38FZmOMgTA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4ib9kZIm3ae9bMXkF6ELa4D_fq6M5AE_eL-9v5iMJhA&oe=6A81C18C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSYTlsK8vrAQ7kNvwEyTGiZ&_nc_oc=AdrHIfUXLPA8UNyej5rgR8_1ynfzenn4-JyDNAzNF0BrSCxqUt3TzKmTR08yYMidPyg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfE__gZHOhQK4cdB4uGPIjrtqqc99J3FxD9v1hZcW99Q&oe=6A81B139"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAlVNSCcjhoQ7kNvwHT1YIx&_nc_oc=AdpZwZ2kRzn3smpcQ5f-pJr1mSiUIecHcd7iftzH8UU8MvrneHNn_uK95BaVFKtFi7w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYiyew4_eKuLEXC4U0VGAAMQt6XM6G4DYgORwvMio-dA&oe=6A68ACEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOVJEb2glHAQ7kNvwFANz4A&_nc_oc=AdrmvUBJjwOYKklKjarQSUbFFfP_le4Pb6yzdgtXHXuDl5b3B2ps5pOOdbsRVmayJik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb-CFtXn6orc2EXwXSwJUJ8q-9t_i4xItfz2Eh3N-LaA&oe=6A68B4C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Roo2HFpOD28Q7kNvwEO7L14&_nc_oc=Adp2E46zEohrv5WFXXi_AXG2BNlcOlMcmuu0x2bkVA_p-rx4gjv-7tfi_9SwCqohAFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAR3E7NJUx3bFHQiyYZ9kprvRxF73AVj35vWeuQIyb-A&oe=6A6890ED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb5tUOIwf4cQ7kNvwGKxjOW&_nc_oc=Adq0467o5I9nYKo3tRvuM2LcS5BfwqeQK-6kio1PG9-k6b8r5aaAIq4YpxXeSd7uRbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoJVL7_urBRg__wUh2_SSY7abnjq2cga45CY3dn0WBXQ&oe=6A68B50C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myiw5Puy7oYQ7kNvwH6Dp-d&_nc_oc=AdpNk7nkGLHUdBiuX3gPIXa6qco1plSs7wb1TW1PNz0M5JlDhOVxX-vhD8PrXTspn5o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh6csMdOEXt7brynMeeedBBWmkmkqDaTJJ5LNbDinLow&oe=6A68A4B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
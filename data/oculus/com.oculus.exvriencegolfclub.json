9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EGw3tGNvmsQ7kNvwFdq6k4&_nc_oc=AdqU4ZHjgg4behKTYn5PC4bGfIjUZFyWl3tUIZDF-XXOd84SjTjYp1uLHqAaKhjqO3s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL4meNB_lf2R4Is8tgX6HZFrE2-u3Ca_4R19WSva88wQ&oe=6AD3AEAA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKbLasau77oQ7kNvwGrVJZm&_nc_oc=AdqlebL_ApVma3Bcl6Deh5robAwUiMG1XLfxn07c1E_UjtyMw1JVxn7fypsionUoz3M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3eaHZEgpHHRmpGIULBAslcdZmFJT3brU9fDvfzsonPQ&oe=6AD3B686"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24xKPG7q-xcQ7kNvwGvPugS&_nc_oc=AdrIoBoluY4oA7KtLAJVNTG7ZCyvPBhWjXrdwKRorb77_3mutlwynEEO1WZyLgJnsWQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4lz1e_pI5Fkjmiw243Njb5te3cWRkbFmViEiQfsNhMw&oe=6AD392AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm7mTXzPH58Q7kNvwEQwxB5&_nc_oc=AdqieV65a8ra1hd_fhXvroWzm1PEG6KsDyybM1l0Abc2n0TIqVZBPrELPLf-rnuCic8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQA_8SfUE0F9G1aWzlbxulpLNlBLnP3L_ikhCHfHvhuA&oe=6AD3B6CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyji3G-EacwQ7kNvwHkmkmF&_nc_oc=AdoZYhk-eBD6xKUWxp1dOrNCgpK742fj9JEB7iX2SyQuuLBD2csdTK8Iw8wLwcElFy0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwLjXUa6gM2GNUh2FzfMAdp83njTmM-96-Iikv3oz9YQ&oe=6AD3A679"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
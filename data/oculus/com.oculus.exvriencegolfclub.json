9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6p_cThmRu4Q7kNvwHiTG0u&_nc_oc=Ado3hWzxnaFR3qtWEfSiL6AUn8PmVRcJyXX28a5sU4Optg8HiBGFo9jJ3kt-DFe8w1E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHYYuqZxdplDvJ31Jiv2gwFzm-mdoM7MWxNZ-XM6fzYA&oe=69C28FEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W845DgJ4xuQQ7kNvwHNDTNN&_nc_oc=AdqUmm_2yUX2qwmdm--dpzL8RUKp_eGT3Gv-_07ZOH2lruvui316_0cQy1l8ja1phfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVair8BfRI1qNMA1l9X5xXJzgAKgD49S1fJZPjiAWLkw&oe=69C297C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfUJumygXtAQ7kNvwGAh3ud&_nc_oc=AdqUVQ8D2laC9MWUnWEjTiaXBu4NQKp9R04mTBqdB81oJHc6AT9p8JTA_KB5fAJ39VE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMpu_-ZZd-Xh2powGqsXI9vVnyqoiL0FnQIkuBIvjuDw&oe=69C273ED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9qQ1DTZwl4Q7kNvwFTO0xJ&_nc_oc=Adpd9jLAdIvXE6MdUb3rwgNDcX5YOhBvKUsKPo3kOE7apSoZPNw6aQ8aRiZKjyXJzso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHp3IG1upnz3KSTQ3YYaKqkqkPy4nRcHrPsXaGLRQZEg&oe=69C2980C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53wbMPOGV4cQ7kNvwHT5OQ0&_nc_oc=Adqy36zk3JHtgcLEk8Fq2I4hOBNqelbc-Iq-K7xb_Y4z-3ygWGKvDiVryRXkwr69NY8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9oMoYtImbU4oiE2nfO5rdKxCWbXhYWBpVMovAh_QVHA&oe=69C287B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
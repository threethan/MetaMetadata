9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCRozZ0LkFIQ7kNvwFXECG6&_nc_oc=AdoBG8MYX5ne3nxoWHOh8QCpUYRJi3OHEUZWP5bWfLVnkhce8c6B7mqdykvzBdJ1ixE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xQxAcNgqS5wiawWstGc0Vr3mTZljxaAS5xND55wzjGg&oe=69E233EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zog7QnXQikMQ7kNvwEy5-yE&_nc_oc=AdrTwhN67BRnFeQoTqQSzE3rkJI6I0WgDiawU3XKIxLq9i1TrE7dFktmTKGjMVfqRA4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gVhYgfmjQaaA0Xlx2MKSXOx40O7-1SMoRemfAVtuEMw&oe=69E23BC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRpT1u8dM0oQ7kNvwHSc-td&_nc_oc=Adoaw_ak8f_71C2xcCmVzNxKQOOVcLrjvZEUk0pS8FrZ0hWN641HluPKj20OrdMN2hQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V-s4vnYwF1AD9ICMUNLi_3TuQaOd5a4UJYgYEaWSAbQ&oe=69E2502D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtOehbsGZG4Q7kNvwGvl-bv&_nc_oc=AdrZIbFhh1vw2eIFMRNvRMqEbWG_tnda-CZJtzw_Fl82NTSjV17BqxeUweSSGsPbouc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uVmL-c5f9Fc0f5CVEhFR-KGyzbv_Rcov4yxYFez1b2A&oe=69E23C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dE_e15U6o4Q7kNvwEYzlcn&_nc_oc=AdoBX0uXqhN0tA4hAEfFlKMWH9rUzuplcsYnPXLlwhyfJEuYRvbZ8AgjIJltWPMwyzE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af057X1JEXs13r2CBM_HFc7jP4XhL1qGefUzlbhmwt_nNw&oe=69E22BB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
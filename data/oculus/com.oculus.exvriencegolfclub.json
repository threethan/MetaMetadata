9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWgAIQAdCaAQ7kNvwFf1jCm&_nc_oc=Adq65MXA5NmMWg-3Ixokr7t1z4wxnFngV6M_N5juFhVpK6AVG6EtCVrSRAjmN0fcYfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB2TDfrCeujBRiPHd1VwcvriCcdB-DriU1d2pGenOtmA&oe=6A845C6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkJaPLb3zS0Q7kNvwFBG1ua&_nc_oc=AdrNwFxPyrxKZOJqCgFKX26hE2QfnORGbN2lXcIm9ZpR79pQf0Yz8-7bazcsrJLYC5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwR2lZgLyoPPODhpkxAOUFCjSBr_3DF6nvDkPtrG4mbg&oe=6A846446"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hTq6GvQle8Q7kNvwER1pky&_nc_oc=AdrO-T2XOUkM4yDF8JDMMaHccI59a3NqhGqMic55HxLL69c9PXVzWHfDO3EAJMFLKSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF-z5U2pau9DffCoua4doFNfdFEcBAtxLcG1l402DjLQ&oe=6A84406D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO507C4oqTIQ7kNvwF7LKTV&_nc_oc=Adp4Hl9k8W0sMXnndEMMTStu6-a16O4U2O0BES3LWRXI3YP0ikisT9JpfQXVfeovEHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh0aWLaVPFVKL15X9EzHl5jrIO57bO1ps9-NiSIx-cYg&oe=6A84648C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlWV8wVDcBoQ7kNvwFbe-_b&_nc_oc=AdrOc6GrCPzvZuQhGoIMfjJOMh4C-lueIm8PsGnx2xX4tZP1Q2xBEUz6Tn_as-Litlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkYAyYNxVl7dyTAem8BM_ZFGRwDYeye2L_6ceVJC14Ww&oe=6A845439"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
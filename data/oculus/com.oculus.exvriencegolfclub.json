9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0MZTf-c7vAQ7kNvwE0TULN&_nc_oc=Adrft0pKMF3APhs9x4D-jhUf8fGXfVWvTuT86Xz7H8DKfxDzrW-UuLGj4tyxfPmgzfA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtZLgWgj1T1XqGvqV7OKNsXNcWmDUNuFLmtRrOXvoi3g&oe=6AF9EA2A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89q_wwsBXloQ7kNvwEqMpyR&_nc_oc=Adq2RepUyTUEq25jrjPl6QCAvr_0a46FoZhUMV8RFcny1lhR0GOJfORoX7yNhDNAL4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMeL5pQUrAi-4PRggiiXhLi98r3vwi65DyXTdS4nTBqg&oe=6AF9B9C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75LOLhVLEPIQ7kNvwFqD9Hb&_nc_oc=AdpHa23kOR9oZ_dvQoHGK6DHUTBZoO2Ma5tJa9m3CtAGmKkRzUDHMW2m7lZI7MiORjs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-TcYj2yTVfEnNuaeTIwUolNeMIAz1NniRjfn-uGnSxQ&oe=6AF9CE2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_epbruatBF4Q7kNvwEaS0H9&_nc_oc=Adr8DXzg9dXaHza-W5n31nfBsZrYkzgI4oF95CFHOX4_zVIp23tr3SfttPV5NZiijOw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL5RrLTQGW9ux8IQBwyxQ-GqHTeyX0sAaoCpYrVWoerQ&oe=6AF9BA0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQc1sDag83IQ7kNvwFcXI-s&_nc_oc=AdoF7iz2qgk7U5Qq0NdMTjzi9fpZUbmYDbjT_9_HT53zYYxLgA5mUZpQo4XnvDlEYXk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRagwjOS_togOjmjgslbpN7VWSA7QXYCLc2azSsd2krlQ&oe=6AF9E1F9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
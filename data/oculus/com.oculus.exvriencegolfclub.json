9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqA5S9xQq7YQ7kNvwG6Sf1c&_nc_oc=AdoX612gw6UeT5xwuIiHIFHT2uAf6knOEnzqi-sEC8qLlVFIXEecTZvAqp2NmVhpFtc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZVJOM80PJiSuKiITS9Dom5mru97wI_PrGNWngV2GHVg&oe=6AF352AA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCBjjtrkZRIQ7kNvwH3d3Yk&_nc_oc=AdouF_34YcfKLL3MVkE22iTtpGC4tGMKQ8yuT6equyHf3Cb5QxhUlmYD_0OFQP7jDPM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi9TU_IPpDPxaQ3YlVjSimsLgQE1KRyU2jJW-NmuxcCw&oe=6AF35A86"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCTKTyBRGg4Q7kNvwGiPLn-&_nc_oc=AdrrjLzDI3SxIHaUqBMgHloYiSvdlWO45hWNV2bZ_9BbJIspuDXF1t6dF5cvGmLSuGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn5XgNj54yay5VSAuNmcthAtcKnMu1xb8Echz2iwaBAA&oe=6AF336AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbB3vtJuOa4Q7kNvwHDVeJV&_nc_oc=AdpEYDsuBNM0-PQCMJrOPgCLSx1crEUk56rwYsQUBI76CZwV8Ty4qy5sbWneuD7LqZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGJ6fmJR5mTRx2DMWUwpA7Y1wk7I6rKlE_5NXtSWTuYQ&oe=6AF35ACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkL7WB6QCXMQ7kNvwGBhnRs&_nc_oc=AdpyBjcv3SFXKWSR6GoEYtUKAmK2f15ecU3vt1kBKUAyJAYsjVPXSpvqwyZcUHC0SgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmHtsxV7iFF-qL3ujboapFLnx5dnABVNOAVpsJ7CXLLQ&oe=6AF34A79"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
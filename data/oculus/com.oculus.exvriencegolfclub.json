9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuc_VJ4uA6oQ7kNvwGD1l4m&_nc_oc=Ado28jH8EODX7rsVf50fucQnYCVW8Z9dtSx4ck-DwiQ5pOrDrRJwnX1PpiQUghG8WUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fZHypcXR57WoEslq2gzqiOHDMmSmCfwuYdqNdX70YXQ&oe=6A3D2B6A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETsS2ee5ItYQ7kNvwHKtxud&_nc_oc=AdpRpa72SCQOwPVeZLABjBe6oY83lczQMDPxIZykykg6TtyuTWPXk7eYmPkbFEgqi_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HOJotPA1LsnBEklmzJC8AMVXxDR69_2d7I1hrVpCP8w&oe=6A3D3346"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGrlyY7nWxsQ7kNvwE7T62z&_nc_oc=Adp6hkvfhA5hNLmjS19altYq4I3npvhBYgbCRpvy42vmFF_hIY-A44U5KJhqB2ZCMO0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BSJjzRUDx54xr2j4LIpCL4HKAmIK-74oH9Lgztjwxzg&oe=6A3D47AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPl5lXyD2NkQ7kNvwEyU1Vp&_nc_oc=AdpPdLoQTx84JxGMg0prR3F3QTWo82OmWVrwgdAkQiKRLJIb3_G-9uNsLqzoChau4wk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lZowZWfnwr3Yo2bS5r8pIOlBXliMY5kzh98WEf_M8xw&oe=6A3D338C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZg67hoO61MQ7kNvwFUF8SD&_nc_oc=AdrHwA1fCuZPJAyMLUorUgBuKs_y6IMetO6t6zuK6FsSl04sizmEr5p8BgnwBjqsfNQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lHpBh0V8u9xGHRjRuTJK_NI-HF5KLSToBrF4-NyhIQQ&oe=6A3D5B79"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
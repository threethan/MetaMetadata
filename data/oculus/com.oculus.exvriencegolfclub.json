9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzAMFWW8qLcQ7kNvwE6fWFD&_nc_oc=AdqsPLqfDXjvNp0kuVA5g6hr6V08SwVYthh07WQ2tZlMGPKeJ4yNjigHunL9CKd79Y0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJnIiH4cHLmQVj96sS-9z12sZJ-nCE6T7ajP6i82PNAA&oe=6A5394EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YVshzJ2YLEQ7kNvwF-lBy3&_nc_oc=Adq7TMdR6xS2yGgja4gS-HAjlX2aRc_gBxdhg8A_pxY6Rha6fOQQVXxf1RS5Zahsnpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNDNbjEIlQ9ODekIu8bvOEAI37MUf4n_pX0eu-1Z24hQ&oe=6A539CC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L351uFCY6CkQ7kNvwGIGt13&_nc_oc=Adoe9iyAEjEpLRvhEbQeBa_-P6UmBZ86tG8lW8E4bPH_T8x7cccKZbtKGnyHO6gs5-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHkjTOFCuklGYBzjGP5wCtCiztU-Xd2X_VZp7RbNbJKA&oe=6A53B12D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPqUC-xyOcUQ7kNvwEuiv-r&_nc_oc=AdoHqOXJyT4SHJqtePu20yuR898hyCpya4Qi4KyI-Z5BEaUgxcN0A9gqXioR5JnldJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHHprQ8lfnQtZ_D8ZMg1DlfIvJcagDL0clc3QHbszrHA&oe=6A539D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvqA5t1IjicQ7kNvwFo9oih&_nc_oc=AdoZqzvfSKT1nAJHOdebL1ym-xJL5TFck5V0TLcXgkMF4o537XYW2MTLNNgihm1YiDk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbBqZHaW4sfzMP-r_TrQrOrBcR-KtIVeS_T4e6v2OyfQ&oe=6A538CB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
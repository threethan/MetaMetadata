, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YVshzJ2YLEQ7kNvwGgeJnU&_nc_oc=AdrxjwBzBEsvu2pxsx_naRDeCiCl778LPsXOaI-hMVkuNHVCAcoA6tSRKmUkwaPW_Lw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNZErZDvz_v758j14SyBd5ih3w6jALaP57JrXDk4HgJQ&oe=6A563FC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVqSeTYs4lUQ7kNvwFhOo1a&_nc_oc=AdonmSbmbQSZE7H07woHRtSjqzulm-vGlXrRpN5tlZAczn4tMw8CZ-cKkY19QnmLwvs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB58bs9fGc_Owgg9vutYw56Rv2zrw8LTiZs9-qakGoa_w&oe=6A56542D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rt2sUuADUwQ7kNvwH51zsM&_nc_oc=AdppppP5iNiWWm2WjL1LdscyyKmVUc5WQA8QxsPMOh4_b2KumfpB4YfUMmK-cQfoslI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi8SHlHoe5fhQBrmQtFusiDR75w9ubUba0wXjtuDQzPg&oe=6A56400C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySLeOpjeLasQ7kNvwFOIXpf&_nc_oc=AdplE4zBXZiDFZr2vAEskbs-GA5rxUzzmmC2WtiQ_uGI3CPbsv1oNp5h9eDLYs2KZIY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZjxV7ycRUbTQViJlX_R7d8tZFNRtq3tSpCk0O3qZMgw&oe=6A562FB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "https://exvrience.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "R
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-vCjVKWLSwQ7kNvwHlEJlW&_nc_oc=AdoAIwgnsNi-0SB7uZ6N3TN5kL6_TEfTj93Dvez8lIwiJ6iVr8v-xLYV7fIM-ktpxCw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ruAGHBwjwFWW0VdWiD1Y4hq21v33FID6qj5qOQW4VNg&oe=69E6286A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWpQbMKP6CsQ7kNvwGBjq_2&_nc_oc=AdrnUW-9MM1sSRNPJZarVGpyB7QVTum7s2pC-aAiGvk2wwx6Px0IwqQjjIxsxPxXRb4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oZKhpe229LRluoxIsR4guVnz-KAoKisgy4E6WC6wGPQ&oe=69E63046"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x44EPtCrPM8Q7kNvwGnXSQZ&_nc_oc=AdpHMPZbceh9BNjz9OItS7US8h19rfhLPwvgeCzJwjV_frtscrYDDqRphyRsSzCAHh4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12EEMkK03xqQQUutsZDFdd8mK0_6XjRQjpAyEhLqN1xw&oe=69E644AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXLFGyroVdEQ7kNvwGRVyG0&_nc_oc=AdrsQveqXYSH9g3NPxuFgLFxbg7JwMU81yRkpbp9vIUtTG6wHPN3iugRAaO20BeyOrs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03-2yb3RLFPNvWIhSzmhsahOt46IfWpISWpQaWzo3bvg&oe=69E6308C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfUXAuwuRZIQ7kNvwHrrBtE&_nc_oc=AdpmFDpp-ZVk3pfKSXK3erwqn81EJDkVhAfR1Bq-AmwxYCOI-eeEG4M2xkDF7Ace9zo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-1jZccj1H5FCvi_S6B5ZkNf5aY3Y9fdtSyMykoU3o8w&oe=69E62039"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
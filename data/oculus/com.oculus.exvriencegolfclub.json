9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjRQQC_RIWMQ7kNvwEiDXEn&_nc_oc=AdqqjjYmd7R7CH7gghMrG1JI1GYnTolNF-G5ceiCpjg0nGXmffrfiERX_GSP0teueyw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWiiyRAXgtxP5392FKdvMtTfLOGyrCMPnAwMWMOt2S0Q&oe=6AC4F5EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goPVNTDWVwEQ7kNvwHQjpyP&_nc_oc=AdpoInP7_AmdeHVpUpe6Xgr0pNqYMUc6cYD-jjHJWX2so7JQVRnMDaM6-ozMCwRRpzg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwLhV4rOmJCtmAZK3sAJ_Ca3SmuJSL9HccYja2_He6TA&oe=6AC4FDC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLXgzJBwW_EQ7kNvwGjRAt4&_nc_oc=AdoNEUUisVAId4VkH0Ie3kdQQv3LenWECwDiltIVq1IIGIzpQIwqKXTpHgkNxheB7Go&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFrCpBWo491jgJjKLJpo8IAUNThMYGLX1LwgX8bPpGKw&oe=6AC5122D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lonjA4_h9rUQ7kNvwFA1dLZ&_nc_oc=AdpXAZSiuvOso-E4GGvbRUZLRQAFmkoNYA9RtcfjP3qbst6wmoi2nulRnn-KlQA31Lc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5RH_ZwOv7aodLjJYbYxe_iWWxSv5x1a9kLngKLoU1oA&oe=6AC4FE0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9hTDwIkF_cQ7kNvwGyzMMQ&_nc_oc=AdoddXZobYTgBhUo9UYqvltpmMq4uSL3FgumIJhZZ-uFwrOmlWeTYgT5Gt3-oeGz3RA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDmagICQEZQD_f5jA5s1PHW5mbVIZZKVhAI0RGUS-mUQ&oe=6AC525F9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKG2BgS3ymUQ7kNvwEwKJMT&_nc_oc=Adru2E6DiczAxl7p2dSG6uPti4sXiO7R51CZYCxK_sxD26_jOitiHvSY26ISTJSDci0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52sa7vE_hJL0F_YAdP0QzijMrGPiyheL4iThn5BuMotg&oe=6A1C35EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ9H4e_5k-EQ7kNvwFVHU0P&_nc_oc=AdonS6131HV1ZxGAOmWthoMWtgKJjCM5eAAERI8PiuOemZu-ia2GSGR0ahu2tjZVPHM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_X1iba4uvk51MZSWBt8JvuR3eqbhrCVMTsXMpSPQyOQ&oe=6A1C3DC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXL--TcyzgIQ7kNvwFaQcmy&_nc_oc=AdoPw1-gY0FMzebCtAEVdDPilPbUd1y--LsA01QBOQccd_TbUUW2SRs-9kKhc2YrZs8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rEuBTMzLfhgVCRqaKPfzOGETiWpOmTFxL3Ozy-kPvNQ&oe=6A1C522D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzjshCCRFMoQ7kNvwH-6RCM&_nc_oc=AdpC5ZQdYBaPukq5bb26xSA9p85_0odYkWY3U_xIs2EFB7AhZD4xnq-Ch2iBdeQU_Kc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iIb0AeBulJG0hVqU1AWVnR9xuNQYqn8YN_k28CRtQ-w&oe=6A1C3E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9Sf05IOCZ8Q7kNvwG5DRIC&_nc_oc=Ado1kSulU7OAwaokHGIWFXCLM6QXUSZN0HIEqrXnW7EAUSPM2JyiotTSpXnIfOQHecI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72cIvLjwoIAVBypY5gvKbms5uDzmEXftTM5SptVPifuw&oe=6A1C2DB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
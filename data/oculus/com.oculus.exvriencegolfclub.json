9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz7q-h1YUfsQ7kNvwER8d6b&_nc_oc=AdqROwuTG6Dn4auyFMlH2jj7rraHkko-dFnCrNM7S83J9QxLsyJpoDiq0NwYloxdR64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LHjUdAczu7MqFRNmaYUZchpqQXeg8GMt44FsOsZporw&oe=69DCEDEA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEbdvsyydCgQ7kNvwFIi5t2&_nc_oc=AdqGjcLyDHP0L8nz57D9LD54EuEvUhSeXzFvNxuak--bhA_ec5jvbQkxO1Ey0cSSklg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HrOeVER-_lLhhH0I2gjM82y-Qh6qLQqKwgvzRz-1auQ&oe=69DCF5C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK7iubHmNawQ7kNvwGZJe-Q&_nc_oc=Adqey4UEmnHeuxSeHZrWNKGdEVXgzZptMr2LZabRUa4hUBYy01gEj73TBK5pvxPfgnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mjdzilyLG3yjO3_lTaViLKaMlvI6mzebJGX_LoF1mSg&oe=69DCD1ED"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWl8IUm5JNIQ7kNvwFdU2OH&_nc_oc=Adp7sWLHLGB4q7m0s0wZZL58rfSxjvkNUoCn58rYmmi_r8bVFIr9LQrJt-N2cGOKSlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Slp63t8uqOEqBkRuGJQZxkyT6bxKGblaLt38xNYgunw&oe=69DCF60C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUCruapEHPoQ7kNvwExzHfT&_nc_oc=AdpFPUIMjJDcK_hBApFUANDPpyFjLuADvyAYKgavysijwEv1G9zYlGfLT4wMwXnUVK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n22YRb9jhZp87q6-0LzbyXsmUA-auRAnATtZWur5Ngg&oe=69DCE5B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqA5S9xQq7YQ7kNvwETCYWY&_nc_oc=AdqD098vPUPpH6BzivjewN-CoTiIn7mkznS6AfKEgUyHhkaoFx04z6fTC7Kp-FEhkkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl7X100aXjjz3l-HLfJv9G3IUcUQ_QB-g7KW4VvMArxg&oe=6AF2012A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCBjjtrkZRIQ7kNvwGk0n6I&_nc_oc=AdqiO-KnEA1saBmXc1iixF3l8pXMnDWicQ44IjDqI8vviHg9tbvaX7ctYHSkCwcL9no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMD3zq6n6X9cqyJtnHBAHd53WuBaTavBOSP_uve6_OKg&oe=6AF20906"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjZ2eELuxyUQ7kNvwF1AEHU&_nc_oc=Adohq7NH5jSF1iRa-cqrIYyLBOIqQYB9eW910Dv-B-9bjsTP8xksnmMGal2LDdBxOJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvImB6u74dkWzvZiTu63NPL7F4g8HexPEafAogW4Ipow&oe=6AF1E52D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9bJqzIaPssQ7kNvwFIKtbN&_nc_oc=AdqvFsZY5sL4CP5kdry3cKBiag2YWKOTbYerNkk76L2NrVcur_zo4I6_sraQ5_yBcS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTTaBFe1X7MnIyZEmrWRpBGXCELKcgsJeGowbeFcyyFg&oe=6AF2094C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqxTh9_0KH4Q7kNvwEMw5oT&_nc_oc=AdpDkSlzp-PohyTJdbEtbXRsjf5g2LNnTLfHG4kZdHDBEWAzBvBhm52P1E2iHQ9KLkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgDz5TKuYJuufjqnACkXmkYDbANuuwOEnQvs8bINPIqg&oe=6AF1F8F9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcIrl4IhsVMQ7kNvwFUa9qr&_nc_oc=Ado1khvtVoqmTiJERijoCV2ncru7gzO6TU5H8hW9BDm9h3zaUxKl_O5qP7K5fP-21p4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YhI9rW18Q_Dzq5b3TvXDR2fH_fRvgLJxHx6Dr-GVUoQ&oe=6A2964EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNQeuG2vB3sQ7kNvwEEZgHn&_nc_oc=AdpkXQaMBu3h6JyINJeaPDQ4JB8M-rK2UUD57bMo0wzs0oy5CMyJavrxs-67bZmtlsk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DP1c5P8irQd0Zmu8EhrHOm9l--agGL2J5McCWdWdsKQ&oe=6A296CC6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKjU3IKHf34Q7kNvwGOwBsj&_nc_oc=AdrA1ldl-8TgFdv8i5WV8t8JhBAC0EfwimtBxOkJM33k90KkTfWHmLDh0f_H_Rd6hTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gFE26P6KPCsBvBxfzSJIxRMYDeudBjcUbDGuePZIYuA&oe=6A29812D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3DkMhA73UIQ7kNvwGnlyX8&_nc_oc=AdpSaDEtwPe1cQWT3E0zr6PxLATFFRXhZnbep-vG2iZzDCuqD-fdgl-aci8lGz0qBEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-idAfykDkJN2hY6rq0uH5vI1y9SjYMt5aSzRxp1sYAsg&oe=6A296D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC6TenJXR4UQ7kNvwEQjaia&_nc_oc=AdqvznB0qf_SiJutPHOHPDm4x4ryw5-PHZdTkxhjWxFqfZX1AdkXKoiQpJovdHqv4Es&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yPLhrcqTwf1XBSrQhIplj9lelQf1xcXkD0PRUyJXdYg&oe=6A295CB9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
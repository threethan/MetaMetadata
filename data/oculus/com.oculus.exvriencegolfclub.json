9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1h8D-SkekUQ7kNvwE447X5&_nc_oc=AdqrgTwzrbBtAPKPlUlgnAEEovxKSNhOqzADtBOsyBADcZBOAXN0r_lY16aLk2p84Hk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeNqGHZrNFx_d4MDg2akMTCdzTRXr4SoS_zi_9dXKpag&oe=6A62156A"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAMBaALOH0QQ7kNvwF-qhsH&_nc_oc=AdqZj5Gs1FVejddm2alzkgETV9kk4YrbhTl9UG3sKCEgGK2IgHBBBCcqjDaOUWrEOgE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxhaO4Khr_kqycHtS1LftoBfMqGnjORlqP9TlK4-jUXA&oe=6A621D46"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7oyh4BzHyoQ7kNvwGLzcA6&_nc_oc=AdrvKfVaGMaHF3n52DPpdntG2lA9NFwJ0BJGhkUF4PRGtBeEesHxXZooVeMHa7FHs50&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaON4UN4gras242xAEAVUFPmaSZvJYlnXpx4HUgdUZEA&oe=6A6231AD"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyXgsfJL2yMQ7kNvwE8_uXn&_nc_oc=AdokQs40B5SFKkeE0FO4eqvDOXYjJk3b2wPLnSFV-PpgvgoQCUeoGqzibjNnAZkgDyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAgDe3qQRRlFQd4wur_BapAPyvGsqlykt66_BtfGsjRQ&oe=6A621D8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F1td_PdfB0Q7kNvwFtX_cx&_nc_oc=AdoEuEcf3JCAnrRDHm3tr25QXcj1f7EmITGK-s88OFaox644a6UJeaYj5MpGc0kYGrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzzApKYjyvqfVRqb2XiWQq2SFZVUMkWnBsLe6Tpj6wwA&oe=6A620D39"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
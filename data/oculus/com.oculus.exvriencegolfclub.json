9_1285596638906351076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUDRzJA7yzYQ7kNvwEvJ27t&_nc_oc=AdqiYLdDdHppjHic3wx1fi8e0Dk9GSsTAx2Z9om9FlgtObioATj-2wR_WmL64R2cd0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FbDL5a8AWP2En-qyDfRwvB4uCJ1KNHkLn8urhLkpP7A&oe=69D261EA"}, {"file_name": "ScreenShot3.png", "id": "718927742296508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001709_718927745629841_3259475026959460862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA3VhY0kISMQ7kNvwEYGZDW&_nc_oc=AdqNge1OrpteIizgUJyDDCHmdH91C4Lj2BJZIpJRXnc3nRdyaLZ2L2B-c7YzY5gvL48&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AozvUrzNvM7lleI1M7NcBczotjKnTMAu6XCQHOfstFw&oe=69D269C6"}, {"file_name": "ScreenShot4.png", "id": "3287946617957463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294237_3287946621290796_7657820203707583783_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwCxsN83FJUQ7kNvwFIXXws&_nc_oc=Adr4Tlbthq-H-uQKPHZdRFr7yy4Q7P-jfUT-cgrQHVk3fFOw4SnlNTasx16qKdimLUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34ef7lYd7gqzoar3NItfAbvITXWR4pcYnbS87IAKzaAA&oe=69D27E2D"}, {"file_name": "ScreenShot5.png", "id": "2773796246187904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931340_2773796249521237_3912312201985611244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jykoZQUDzn0Q7kNvwGs8CuV&_nc_oc=Adq_LPoZRhcTcCvhjS060FBFL2BDcUKYY7BMTaW2QQ27o2lvdqTagLfHwUmlepj4hsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C548A65p-XAM_2k6_OAcNEFJaxKxlArz4Ad5iezXOCw&oe=69D26A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GCLandScape2560.png", "id": "309691730140069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240106_309691733473402_7125015613705736290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m503kQvAKEQ7kNvwFPnu7H&_nc_oc=Adr4owSsRAWcHuU824SgpkKaDUh3_KHdOChltE8HA7YRiwxqJ4HF2Jnu2cA75ZysZm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CK1QmTUyGr4EqR8wKWoJmcK9lb3xQTrcDxFoo-iWRbQ&oe=69D259B9"}, "display_name": "exVRience Golf Club", "keywords": ["golf", "sport", "action"], "long_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon.\n\nFeatures\n\u2022\t18 Hole custom designed Golf Course with rivers, beaches and lakes\n\u2022\t9 Hole Moon Chip Challenge course\n\u2022\t6 Escapes including Beach, Space, Moon and Driving Range\n\u2022\tLeaderboards, Statistics, adjust green speed and club feel\n\u2022\tEnhanced golf mechanics with Draw, Fade and Backspin\n\u2022\tController Measurement System showing distance and club required\n\u2022\tExplore feature allowing the ability to fly anywhere on the course\n\u2022\tHelicopter Flyovers and Live Satellite views\n\u2022\tPractise Playground  - repeated bunker, putting and fairway practise\n\u2022\tSave current progress feature\n\u2022\tSupports two players on local headset", "short_description": "A brand new 18 hole Golf Course with a completely redesigned visual experience - improved water, trees, greens, menu system, clubhouse, mechanics and new features such as rivers, enhanced practise areas and a Golf Escapes feature.\n\nPractise, Play a round of Golf or just hit some balls on one of the \u2018Golf Escapes\u2019 \n\nPlay a 9 Hole \u2018Chip Challenge\u2019 course located on the Moon."}]}, "developer_name": "exvrience", "developer_privacy_policy_url": "https://exvrience.com/pages/privacy-policy", "developer_terms_of_service_url": "https://exvrience.com/", "publisher_name": "exvrience", "support_website_url": "https://exvrience.com/", "website_url": "ht
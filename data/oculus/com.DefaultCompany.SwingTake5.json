DBFhnuYNhL1bLpx99hP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdrU_at7EOTQcWzgcx3wbt3TBSnAeRX-SItQhWE1xLkA&oe=69999AF9"}, {"file_name": "image.png", "id": "1938519993543893", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627344_1938519996877226_905037114551942311_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slWmsQi248YQ7kNvwEzzB7F&_nc_oc=AdkKvZg_DT-8iqnE0jsJUaQWGiX7W9h6y-xpXP-FfPe9WVhQq241y7Azb_cmnLbP3wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDJrMcWk3D4zTKhk_lig1jePHMy8FEc6Lf5LH8aMpcFg&oe=6999BF2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swing!", "keywords": [], "long_description": "Welcome to the habitat of the Swings.\n\nHang out in the lobby, explore the forest, and check out the shop\u2014there's always something to do. Meet other Swings, play games, trade items, and enjoy a big open environment built for fun and connection. Climb trees, swing on ropes, and use your hands to run, and scale walls.\n\nMovement: Move with your hands\u2014climb, run, bounce off walls, and master your momentum. Outsmart other Swings with creative moves and fast reflexes.\n\nTrading: Got cool cosmetics? Trade with other players and grow your collection.\n\nModeration: Our active moderation team helps keep the game fun and friendly. Respect others and play fair.\n\nNow get out there and Swing like never before!", "short_description": "Welcome to the habitat of the Swings.\n\nHang out in the lobby, explore the forest, and check out the shop\u2014there's always something to do. Meet other Swings, play games, trade items, and enjoy a big open environment built for fun and connection. Climb trees, swing on ropes, and use your hands to run, and scale walls.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://swingstudios.co/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Swing Studios ", "support_website_url": null, "website_url": "https://swingstudios.co/",
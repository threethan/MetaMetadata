ocale": "en_US", "screenshots": [{"file_name": "3.png", "id": "881420578232690", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/585819904_881420581566023_4010703355535827493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dyHItyN6fcQ7kNvwFDMVxI&_nc_oc=AdpPAAEzpDPO3s35yb_DevkW6CLvLs1n8quA9RqHk2k2nyZJcwSV3KfZ_vI1HK78hDw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oaX_6C0O3B1x9RycBpZsqNE1N-K13Ku5A5kwTjcO7Kg&oe=69F49459"}, {"file_name": "5.png", "id": "2060000057890763", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819854_2060000061224096_382577299551034068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o161JE9XHcQ7kNvwGm8jPc&_nc_oc=Ado9tgU54e9yxdnkngjE7ytciNK6zTY_BZWadEDJDNIXV-B0UWkRfzM788eAlCV33P0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0gC_S6T1thNzmku0Splqs9gZjd8etpuXumXqvfmFMFYw&oe=69F4BB38"}, {"file_name": "1.png", "id": "2013603619589803", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825345_2013603622923136_6253737930871315743_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_82olSlhcVwQ7kNvwG1-uCC&_nc_oc=AdoTVe5EwJklzpixJpVZitknMudIhtmq83ywxzOv0oirfoL4cmiNoGqO5_b7vKEwr5E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ruLTjwomTiZByeTsQTgotxzbIKzoN-YwXbSC2JKpr6g&oe=69F4C8BF"}, {"file_name": "4.png", "id": "955264183505048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823279_955264186838381_6916663385988190947_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hd1Vat4zy0MQ7kNvwHUaLPX&_nc_oc=Adq47PVhitjlLh9869G-ZOPw5UCIGWegehndlKbgO0gbqyf5R6914Lx3O2ptGzQdk_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ESO_bZ4W6jX-c1W5JMg4xo-ceG4rBa3E3HFeG8TjE7Q&oe=69F4C6D7"}, {"file_name": "2.png", "id": "1515573376593955", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821081_1515573383260621_953135464728876003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVDOVGXEWyYQ7kNvwF9TpMD&_nc_oc=AdpDIo0ST8zXbLH1UmTFhjS1KaaSxWAnoeVoQ3kBiN-FcEHcRXedE-DapBvVY-4rLyA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WhysJtOPWxWSHErnb9lIrmoNdliJ_lwKC3X-JVQuXxQ&oe=69F49637"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing VR", "keywords": ["boxing", "fight", "wwe", "wrestling"], "long_description": "Step into the world of Boxing VR, where every punch, dodge, and move decides your fate. Face off against skilled opponents and prove your strength in immersive virtual reality boxing combat designed to test your reflexes and precision.\n\nExperience realistic boxing mechanics with accurate hand tracking, powerful punches, and strategic defense. Block incoming attacks, counter with speed, and land perfect hits to dominate your opponents in fast-paced matches.\n\nTrain your skills, improve your timing, and push your limits as each fight becomes more challenging. Every match delivers intense action, keeping you fully engaged and motivated to become the ultimate champion.\n\n**Features:**\n- Realistic boxing mechanics\n- Immersive VR gameplay\n- Skill-based combat\n- Intense fight matches\n- Smooth punch controls\n- Challenging opponents\n\nWhether you're a beginner or a pro fighter, Boxing VR delivers a thrilling and energetic experience. Get ready to fight, sweat, and win!", "short_description": "Step into the ring in Boxing VR and experience realistic boxing action! Throw powerful punches, dodge attacks, and become the ultimate champion. Enjoy immersive VR gameplay, intense matches, and skill-based combat in one of the most exciting boxing VR games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags":
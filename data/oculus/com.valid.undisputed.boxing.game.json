oN-YwXbSC2JKpr6g&oe=69F4C8BF"}, {"file_name": "4.png", "id": "955264183505048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823279_955264186838381_6916663385988190947_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hd1Vat4zy0MQ7kNvwHUaLPX&_nc_oc=Adq47PVhitjlLh9869G-ZOPw5UCIGWegehndlKbgO0gbqyf5R6914Lx3O2ptGzQdk_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ESO_bZ4W6jX-c1W5JMg4xo-ceG4rBa3E3HFeG8TjE7Q&oe=69F4C6D7"}, {"file_name": "2.png", "id": "1515573376593955", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821081_1515573383260621_953135464728876003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVDOVGXEWyYQ7kNvwF9TpMD&_nc_oc=AdpDIo0ST8zXbLH1UmTFhjS1KaaSxWAnoeVoQ3kBiN-FcEHcRXedE-DapBvVY-4rLyA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WhysJtOPWxWSHErnb9lIrmoNdliJ_lwKC3X-JVQuXxQ&oe=69F49637"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing VR", "keywords": ["boxing", "fight", "wwe", "wrestling"], "long_description": "Step into the world of Boxing VR, where every punch, dodge, and move decides your fate. Face off against skilled opponents and prove your strength in immersive virtual reality boxing combat designed to test your reflexes and precision.\n\nExperience realistic boxing mechanics with accurate hand tracking, powerful punches, and strategic defense. Block incoming attacks, counter with speed, and land perfect hits to dominate your opponents in fast-paced matches.\n\nTrain your skills, improve your timing, and push your limits as each fight becomes more challenging. Every match delivers intense action, keeping you fully engaged and motivated to become the ultimate champion.\n\n**Features:**\n- Realistic boxing mechanics\n- Immersive VR gameplay\n- Skill-based combat\n- Intense fight matches\n- Smooth punch controls\n- Challenging opponents\n\nWhether you're a beginner or a pro fighter, Boxing VR delivers a thrilling and energetic experience. Get ready to fight, sweat, and win!", "short_description": "Step into the ring in Boxing VR and experience realistic boxing action! Throw powerful punches, dodge attacks, and become the ultimate champion. Enjoy immersive VR gameplay, intense matches, and skill-based combat in one of the most exciting boxing VR games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26368096729521625"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1047944650892392"}, {"status": "PUBLISHED", "id": "2160829664703317"}]}, "baseline_offer": {"id": "2160829664703317"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1047944650892392"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26286840977647201", "version": "1.0.1"}, "id": "3922386318056828", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applica
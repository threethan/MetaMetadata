A7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RodentPeopleCover.png", "id": "245883636999278", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031428_245883640332611_3679024618240417657_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abaJC6JtjIkQ7kNvwGWnMch&_nc_oc=AdrMxKPItE8JMtEBiwDM5tK1ymV5UC0ORPW6O42qZqajD71q5IcpdafUrOPKPuGA4EQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz-JczxNJo960huqEqpFsQfKJYJWNdNEOL_YHtNFVETA&oe=6AFC644E"}, "display_name": "Rodent People: Origins", "keywords": [], "long_description": "Rodent People are rats with human level brain power and a body enhanced with bionic parts, who somehow found themselves locked up in a prison.\nAt the first glance, life inside the cell is not too bad. Rodents occupy themselves by working and earning money, which they can then spend on food and other things. However, the days quickly start blending together, and the Rodent People can't keep on living in a prison cell - they decide to break out and find out the mystery behind why they were incarcerated in the first place.\n\nWhile the game is best experienced with team, you are free to tackle the mission on your own. Choose any rodent and use your wits to escape the prison!", "short_description": "Rodent People: Origins is a multiplayer VR escape room, in which teams of up to 4 players use their wits and cooperation to solve innovative, story driven puzzles to try and break out of a prison cell playing as the incarcerated rats - the Rodent People."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ebcd8408-709b-4e98-bc3e-37bbdecacc76", "developer_terms_of_service_url": null, "publisher_name": "Zen Republic", "support_website_url": "Http://www.zenrepublic.space/contacthq", "website_url": "Http://www.zenrepublic.space/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326
Deq4bKIUyBObXa9KDLIobhWvMXmTfJTZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afti5h0RC_r_8NAuVp2GazVgW2ls73dmgtBV-Nu-bba7DA&oe=69984C0F"}, {"file_name": "cheese.png", "id": "1398591143828930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031331_1398591147162263_3047579642580583507_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEKCOm_aud0Q7kNvwFZhvgi&_nc_oc=AdnCG0BtPiBGu6YZK-Z4FJ_2we2l4cvbZW77rxTL8mMOW15yPtfbQFRNfYqgU0Sm0C0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsJtPclhCM58NzgvAhFMMmDoaFtvj5OaxfnrZ5JNNRJmQ&oe=69986469"}, {"file_name": "duckshoot.png", "id": "129990952313291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031331_129990955646624_1190158248008757430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDzWPZ8yT7QQ7kNvwH58ODt&_nc_oc=Adl5mArIhITZe-TbSNXilzBa_ea9WcgTvZneY0rqQEbcChi3JUA4NwMmwFZV710rZkU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvX3bH8VLRQ5d0xmHV9w29vF_nIwVnvL7GtmAqt64HeIw&oe=69983D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RodentPeopleCover.png", "id": "245883636999278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031428_245883640332611_3679024618240417657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oABIXNtVOMkQ7kNvwEUTnbo&_nc_oc=AdkKZHVedZFlXP87gfDksA7-ie5Ya75Z7QisdZGbOZx_5pT5eS_itRyBqB6r-WLGRyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftdiD5Oqq6IJUzWaJXsrWj6HXL5xX4Frh2EUt-GtsCmEw&oe=69986F4E"}, "display_name": "Rodent People: Origins", "keywords": [], "long_description": "Rodent People are rats with human level brain power and a body enhanced with bionic parts, who somehow found themselves locked up in a prison.\nAt the first glance, life inside the cell is not too bad. Rodents occupy themselves by working and earning money, which they can then spend on food and other things. However, the days quickly start blending together, and the Rodent People can't keep on living in a prison cell - they decide to break out and find out the mystery behind why they were incarcerated in the first place.\n\nWhile the game is best experienced with team, you are free to tackle the mission on your own. Choose any rodent and use your wits to escape the prison!", "short_description": "Rodent People: Origins is a multiplayer VR escape room, in which teams of up to 4 players use their wits and cooperation to solve innovative, story driven puzzles to try and break out of a prison cell playing as the incarcerated rats - the Rodent People."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ebcd8408-709b-4e98-bc3e-37bbdecacc76", "developer_terms_of_service_url": null, "publisher_name": "Zen Republic", "support_website_url": "Http://www.zenrepublic.space/contacthq", "website_url": "Http://www.zenrepublic.space/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER", "MULTI_USER"], "id": "643327726866528"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6558942254177010", "version": "v0.70"}, "id": "256960702660350", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"node
Z5Ov9K4Q7kNvwFSj3O9&_nc_oc=Ado0ER1RZ9R82hzdLEn9WvxAfLF5mJXgZlYzsGOVj7waF9FjqYb9__FZWwxD7ASd5L0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JejZj9mSJPYAXKhBOIxTxxqGj69Be1fsrEWh4tPJt-Q&oe=69EA0B70"}, {"file_name": "Elevators.png", "id": "3221335694694377", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821081_3221335698027710_9209531701171171212_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvviCMs1ISMQ7kNvwGNd5Lq&_nc_oc=AdrwKQnN4w2drrt9Eps9UaO5MIcWY7xOQFkAuMDCf8c8CAjYWExwFATvt78BnSHJ4JM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J2-IoAYpe9AfUFjK2pO-L2GHDaflU_2oUiKZIwxJSmQ&oe=69EA0F93"}, {"file_name": "Elevators2.png", "id": "1678340246846229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1678340250179562_473586535560273826_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR7qK0dW2-UQ7kNvwEBMglS&_nc_oc=AdrTIYojmLQ5oL0PgXbFfLAGuE4pVU0elCBznm6x0J2o0rkdBPRmLe3WdnzTzYUKY6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L87VV9znVfMGwov_WF-BYCRc0nHO6Ng6gjjLKYwN9LA&oe=69EA3743"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_2560x1440_MRI.png", "id": "1708318433869253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824671_1708318440535919_2844684184680066115_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPvVGn2vQ7AQ7kNvwFh5eFN&_nc_oc=AdqjnKOiU07PtpQ4UcT9bvVVwtMSbszs3r2zfF7URJ4sDRWREM92Rd0Dl5DJLtZWQck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T-chHSW9ZAUFFyrkuT-6ICidQuNPAVw77dzsKwEkRhg&oe=69EA0435"}, "display_name": "ClaustrOFF: Simulations", "keywords": [], "long_description": "Step into situations that once felt out of reach \u2014 and experience them differently.\n\nClaustrOFF: Simulations is an immersive virtual reality experience designed to help you gradually adapt to confined environments through realistic and controlled scenarios. Instead of avoiding uncomfortable situations, you can now explore them in a safe space where you stay in control.\n\nThe app recreates everyday environments that may feel challenging:\n\n- MRI examination\n- Elevator rides\n- Airplane cabin\n\nEach simulation is designed to be approachable and repeatable, allowing you to progress at your own pace. Start with lighter scenarios and gradually move toward more intensive experiences as your confidence grows.\n\nWhat makes it unique:\n\n- High-quality, realistic VR environments\n- Gradual progression system\n- Freedom to explore at your own pace\n- Designed with input from psychology and digital health experts\n- Suitable for independent use or guided sessions\n\nClaustrOFF: Simulations focuses on helping you build familiarity and a calmer response through repeated exposure in a controlled setting. Whether you're preparing for a real-life situation or simply want to feel more comfortable in confined spaces, this experience gives you a practical and accessible way to train.\n\nImportant:\nThis experience is intended for wellbeing and training purposes only and does not replace professional care.", "short_description": "Train your response in realistic confined-space simulations. Practice situations like MRI scans, elevators, and airplane cabins in a safe and controlled VR environment. Progress at your own pace with guided scenarios designed to help you build familiarity, reduce discomfort, and gain confidence in challenging spaces through repeated exposure and immersive training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/claustroff", "website_url": "https://www.gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34534988919480506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821081_972203348662419_1177448083796342810_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQyKYeWMLE8Q7kNvwFO6rgp&_nc_oc=Adpc2zpPYYVCSvImALsvKq4IB6vecLeH3I-JJDQBnMblsWUoKLLsyXZsvfxGvQzQ7NY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04nNWPTSSCGL_IwLYOIelhGrO3unmZyQck2ZHWQ13Vkg&oe=69EA38DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ClaustrOFF: Simulations", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1774299120, "lastRevision": {"nodes": [{"id": "32084762424503180", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "32084762327836523", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1320006846622030"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "META_2560x1440_MRI.png", "id": "2171632586980140", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821081_2171632590313473_6211585431137728645_n.png?
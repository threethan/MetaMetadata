nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHFhFsHGrBEQC7BC-BXo1jfA1gRQWTHnEdIyaLQSzWzw&oe=69AEA609"}, {"file_name": "peritonsillar abscess.mp4.00_10_50_17.Still001 1.png", "id": "1815896292292116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300873_1815896298958782_9174312480515372158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8gghHu4JmwQ7kNvwEuloj5&_nc_oc=Admy7pxwtdFrHPrkr_TmmONjnSikci_e9FSrROAbeWe2NO-GDCH1kSreoz3tcze_4Dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkxYVXtONr6eoseAId7-5L30NryPZHfETa8ICYfttF1A&oe=69AEBCC7"}, {"file_name": "peritonsillar abscess.mp4.00_11_16_10.Still001 1.png", "id": "721050550893280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293865_721050554226613_7173593546037057215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mIKVs9vYGoQ7kNvwGec0v9&_nc_oc=AdmAXkHBhMpPt0vthIG6VJLSU6JeSQgU8lAlbc-SdDZnf2ZfPtCzTlvrkUy-U9R_Mus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvrI5nXA1PvwxNMgQM_FoE8mkSl15a3poiRmirhEZh8w&oe=69AEC6D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peritonsillar Abscess Needle Aspiration", "keywords": ["Medvr", "medical", "abscess", "VR"], "long_description": "\"Peritonsillar Abscess Needle Aspiration\" is an interactive VR simulation designed to train healthcare professionals in managing one of the most common deep space infections of the head and neck. This module provides step-by-step guidance through the evaluation, preparation, and safe execution of the needle aspiration procedure. Users can practice identifying anatomical landmarks, selecting the correct tools, and aspirating pus with precision\u2014all in a realistic, risk-free environment. Ideal for medical students, residents, and emergency practitioners, this immersive experience enhances clinical competence and decision-making through active learning and repeated practice. Whether you're preparing for your first case or refining 
=6e7a0a&_nc_ohc=J5Q4q_RnGmQQ7kNvwGb4ZzX&_nc_oc=Ado_tfiUsEB1DFeEGz_VSCd8QAehSCE2JzCmwUWTuRAShB7Uo4b4NmI7ll3EfPwIU8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hfIE1W97OGrywjXPN56G64XeLWXu6jaEssYsnkZqjYA&oe=6A2FF9D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peritonsillar Abscess Needle Aspiration", "keywords": ["Medvr", "medical", "abscess", "VR"], "long_description": "\"Peritonsillar Abscess Needle Aspiration\" is an interactive VR simulation designed to train healthcare professionals in managing one of the most common deep space infections of the head and neck. This module provides step-by-step guidance through the evaluation, preparation, and safe execution of the needle aspiration procedure. Users can practice identifying anatomical landmarks, selecting the correct tools, and aspirating pus with precision\u2014all in a realistic, risk-free environment. Ideal for medical students, residents, and emergency practitioners, this immersive experience enhances clinical competence and decision-making through active learning and repeated practice. Whether you're preparing for your first case or refining your technique, this simulation offers a valuable tool for mastering peritonsillar abscess drainage.", "short_description": "Experience a realistic, hands-on VR training for performing needle aspiration of a peritonsillar abscess. Designed for medical students and professionals, this immersive simulation helps improve procedural confidence, accuracy, and clinical decision-making in a safe virtual environment.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_top
72185601297125_1502649307258826909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25TXsqDQFn0Q7kNvwECyCVG&_nc_oc=Adq2iBk2CtXFRG7kItiiZdv6z6zKlQLK4yUZLKvpq3wQuMGQlEeVZab6IjhKI4uOb3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_IaNpvn5MkThpEs2fgzlTavkA9tAIkdNSsA4AV_-Tjw&oe=69F74408"}, {"file_name": "peritonsillar abscess.mp4.00_15_42_28.Still001 1.png", "id": "1071576188399405", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300993_1071576191732738_1859588065012514072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3_POZHOyzgQ7kNvwE9XoNK&_nc_oc=AdpcVbbXvxkp2QpHWroKfYZasPcs8GAbt-juC5acwoKo0I5_mnlu1tjrzCDhpley0h0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fpatS7rh5FX3G40W-AnhNl0gzKKZtyDxFrSoNzRTDvg&oe=69F760C9"}, {"file_name": "peritonsillar abscess.mp4.00_10_50_17.Still001 1.png", "id": "1815896292292116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300873_1815896298958782_9174312480515372158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vMtIcDwchMQ7kNvwGkk9Ch&_nc_oc=AdpEYFqPo1L2FWYGV-Flq1PCdM6OUM830uTnOaki5x151Tq501p6r8V6ZCCtnMl0so8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WrvoI0yCr5VPGvnRa3AcvEK-5YT2laR9SrzXwlbtZxQ&oe=69F73F47"}, {"file_name": "peritonsillar abscess.mp4.00_11_16_10.Still001 1.png", "id": "721050550893280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293865_721050554226613_7173593546037057215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhwURICcdaIQ7kNvwFXAv0H&_nc_oc=Adq8lzVabehn9vW4cVIIGSxWbWwIp3uHpYhG5A0sk3t_LUPT-qJLOZ5Z_GtAvOHJtXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0knkIxBSYW2Al7YbJ9604LnVQQi4kBGdXPJ53UrlrjRQ&oe=69F74958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peritonsillar Abscess Needle Aspiration", "keywords": ["Medvr", "medical", "abscess", "VR"], "long_description": "\"Peritonsillar Abscess Needle Aspiration\" is an interactive VR simulation designed to train healthcare professionals in managing one of the most common deep space infections of the head and neck. This module provides step-by-step guidance through the evaluation, preparation, and safe execution of the needle aspiration procedure. Users can practice identifying anatomical landmarks, selecting the correct tools, and aspirating pus with precision\u2014all in a realistic, risk-free environment. Ideal for medical students, residents, and emergency practitioners, this immersive experience enhances clinical competence and decision-making through active learning and repeated practice. Whether you're preparing for your first case or refining your technique, this simulation offers a valuable tool for mastering peritonsillar abscess drainage.", "short_description": "Experience a realistic, hands-on VR training for performing needle aspiration of a peritonsillar abscess. Designed for medical students and professionals, this immersive simulation helps improve procedural confidence, accuracy, and clinical decision-making in a safe virtual environment.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], 
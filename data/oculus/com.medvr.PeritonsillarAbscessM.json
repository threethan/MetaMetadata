qelcP9x6EF0MZHM_UyA4D40Ug&oe=69A56B89"}, {"file_name": "peritonsillar abscess.mp4.00_10_50_17.Still001 1.png", "id": "1815896292292116", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300873_1815896298958782_9174312480515372158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd2a9rp0GBEQ7kNvwF_tm8d&_nc_oc=Adna_569NYPyYTXXSOQxl9ANVVqshv6SpIgRSCsfKgT-i7VMK-Z9RRjswWz_sshyZcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuYe86Z1U4IS-ryreYXilBtsGml4H1lcGAcp1TO1g5Kwg&oe=69A58247"}, {"file_name": "peritonsillar abscess.mp4.00_11_16_10.Still001 1.png", "id": "721050550893280", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499293865_721050554226613_7173593546037057215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xxy-W7SNpTcQ7kNvwHwMoF6&_nc_oc=Adm2tuseEj5BNEm5sYngVI9ARuJ9A-9jLSFVtI1-3OY24TbDTcWlKyTf_D9Ce4Or2Qs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftnLvT9RXO8OXjYBC8iNt4kvH9Xjrf4ckFeZr3-SKcZyw&oe=69A58C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peritonsillar Abscess Needle Aspiration", "keywords": ["Medvr", "medical", "abscess", "VR"], "long_description": "\"Peritonsillar Abscess Needle Aspiration\" is an interactive VR simulation designed to train healthcare professionals in managing one of the most common deep space infections of the head and neck. This module provides step-by-step guidance through the evaluation, preparation, and safe execution of the needle aspiration procedure. Users can practice identifying anatomical landmarks, selecting the correct tools, and aspirating pus with precision\u2014all in a realistic, risk-free environment. Ideal for medical students, residents, and emergency practitioners, this immersive experience enhances clinical competence and decision-making through active learning and repeated practice. Whether you're preparing for your first case or refining your technique, this simulation offers a valuable tool for mastering peritonsillar abscess drainage.", "short_description": "Experience a realistic, hands-on VR training for performing needle aspiration of a peritonsillar abscess. Designed for medical students and professionals, this immersive simulation helps improve procedural confidence, accuracy, and clinical decision-making in a safe virtual environment.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "23868117522883765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1453559128988621_7405683424065550732_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhpu-a7qR74Q7kNvwHTFl-V&_nc_oc=AdmNcFzVszwLB84yT4q5aHE0WxA7Gpjk1OXLz4BHqOxXnZlkR3tUXRPqHFpzOmZ-0CA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfthBUOOLVxzij4_kTDGskkwfhEP1QWma1wehD2qx-wWxg&oe=69A597CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Peritonsillar Abscess Needle Aspiration", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "r
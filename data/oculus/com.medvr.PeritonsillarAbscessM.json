-Obs46dKW7uyvMytkMaoLRGrnMjN48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iJy1lDdWBt1Xkwn2E_ekvfnViUiTRap0qdvFUbf8sQw&oe=69F1FE08"}, {"file_name": "peritonsillar abscess.mp4.00_15_42_28.Still001 1.png", "id": "1071576188399405", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300993_1071576191732738_1859588065012514072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8ejAda38JgQ7kNvwEVd4ig&_nc_oc=AdpYYMZPKij-Rj_i3tg-zZK2I7dwDlXjO6op6QxWKsEoc6Gpo-4SHEBFOuQyDhqwXAY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0aDWUu6rUldqhqpSn57_CVH3cphQUr7r28Fl1lzygbDQ&oe=69F21AC9"}, {"file_name": "peritonsillar abscess.mp4.00_10_50_17.Still001 1.png", "id": "1815896292292116", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300873_1815896298958782_9174312480515372158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy9BqIkLOJ0Q7kNvwH5b7Z0&_nc_oc=AdrMBWUoa6urbvFdKcOVra9VfcYrvFh0C1qShQya2TbkLflNUB_Yhz9xmQb4-iOGAL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2IcM2RbLb7fxAb7QgIHAC9oKUTAWka5Ef2l4ATNEZjSw&oe=69F1F947"}, {"file_name": "peritonsillar abscess.mp4.00_11_16_10.Still001 1.png", "id": "721050550893280", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499293865_721050554226613_7173593546037057215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feQ2I-wq-_YQ7kNvwEWW4jc&_nc_oc=Adr6FYkQFPqWQPFmloorkKwU8OHjpuck4dXk3XJ5zgVLsCMrNnsu7mB7vD4zp0YV-I4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0nOqwDaeu09oRTwxBpRwiqw7n7l82lftjt1rndxep4Tg&oe=69F20358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peritonsillar Abscess Needle Aspiration", "keywords": ["Medvr", "medical", "abscess", "VR"], "long_description": "\"Peritonsillar Abscess Needle Aspiration\" is an interactive VR simulation designed to train healthcare professionals in managing one of the most common deep space infections of the head and neck. This module provides step-by-step guidance through the evaluation, preparation, and safe execution of the needle aspiration procedure. Users can practice identifying anatomical landmarks, selecting the correct tools, and aspirating pus with precision\u2014all in a realistic, risk-free environment. Ideal for medical students, residents, and emergency practitioners, this immersive experience enhances clinical competence and decision-making through active learning and repeated practice. Whether you're preparing for your first case or refining your technique, this simulation offers a valuable tool for mastering peritonsillar abscess drainage.", "short_description": "Experience a realistic, hands-on VR training for performing needle aspiration of a peritonsillar abscess. Designed for medical students and professionals, this immersive simulation helps improve procedural confidence, accuracy, and clinical decision-making in a safe virtual environment.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "23868117522883765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819476_1453559128988621_7405683424065550732_n.png?s
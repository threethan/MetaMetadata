nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRDTPOCM4iQ7ptkTn9uLcllT5gf2baYYK30N_JUsgxvA&oe=69AD5489"}, {"file_name": "peritonsillar abscess.mp4.00_10_50_17.Still001 1.png", "id": "1815896292292116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300873_1815896298958782_9174312480515372158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8gghHu4JmwQ7kNvwFK0mqb&_nc_oc=AdmJEdBq2A7a3suVBLfAeWdIN7zjUu-v1wBgU6-VBGmfKnVyek2EoKZO0FczBmMrlK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD44cwd69L61MDDapOLGy89nx3flJowHEl2eK6eGSM4g&oe=69AD6B47"}, {"file_name": "peritonsillar abscess.mp4.00_11_16_10.Still001 1.png", "id": "721050550893280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293865_721050554226613_7173593546037057215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhUxJ5yFTokQ7kNvwFmTIiQ&_nc_oc=AdmrMkQP2_ofhUnLoRXNgFt1j15co2-TkE1tNF_aCzR6l8nW_GBXyKcfbuU33iMwpoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6w44C7WxyILEF_mbZs_JnIpcv5vjsFHkSdk5vXGn7aw&oe=69AD7558"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peritonsillar Abscess Needle Aspiration", "keywords": ["Medvr", "medical", "abscess", "VR"], "long_description": "\"Peritonsillar Abscess Needle Aspiration\" is an interactive VR simulation designed to train healthcare professionals in managing one of the most common deep space infections of the head and neck. This module provides step-by-step guidance through the evaluation, preparation, and safe execution of the needle aspiration procedure. Users can practice identifying anatomical landmarks, selecting the correct tools, and aspirating pus with precision\u2014all in a realistic, risk-free environment. Ideal for medical students, residents, and emergency practitioners, this immersive experience enhances clinical competence and decision-making through active learning and repeated practice. Whether you're preparing for your first case or refining 
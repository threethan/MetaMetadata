17118_6871409872430360320_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHNHcZa2aCIQ7kNvwG3q4h3&_nc_oc=Ado6BiD5E0p3JqsxiA1TrPhbZoj8W4mUManm9hg3Fgv5PL1IQj6hMHT1585dITl5LYQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdZOL6yoNSDSo8p9uo_W7YYFcDckKbO8dcTLlR2xEtwA&oe=6A81C246"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX_NgdmgV54Q7kNvwGMFngE&_nc_oc=AdoIWs7LjkX_BmbYsgWF_IKrAojSpiF_gExPjfoEUCMtJ_JDmNAmKYYvHIA4zcTRmyc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-sCJI1E7KHiPFKVYlQn4Cj9seks-Bb09ZSYzkjtTDAA&oe=6A81A6FC"}, {"file_name": "1.png", "id": "1601292821023464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619098_1601292824356797_2214700978411289039_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvhcyfaxjNwQ7kNvwEIs2XL&_nc_oc=AdpnmWG4wrZ7vWRQBfGu4ToNztFWz2oNYROCE0OV7eBE3CdNOq9S2tbUy8TIufFO13U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnbA0DvkhYFX45tvUsDY5FlCtYtn-DfmMvdWIdrJiyaw&oe=6A81B35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BB Cover Image FTP - Landscape.png", "id": "1923627959037848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620444_1923627962371181_4591929654322309400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-HS3Bj9wwgQ7kNvwESzvqJ&_nc_oc=AdqAIICLSyQFQTbeYKoSfWkGIuD_88Z26ydFeCJ3j4Pvz06C9K8ZTTfIuCbzH9muGkc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmDjtD4V5gzzgYFxixn65ja_tLlIrVRi_MGJjcCBPJyw&oe=6A81C351"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "Punch the Buddy, now in VR! Play with friends. Grab weapons, explosives, and physics toys to beat down your ragdoll Buddy \u2013 earn cash, level up, and unlock even crazier items.\n\n# 70+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic weapons, god powers, and vehicles. Every weapon hits harder than the last.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\n\nJump into packed public lobbies, or go private with your friends. Unleash havoc on the Buddies (or each other).\n{1597570284565220}\n\n# Helicopters, UFOs, and Superpowers\nRam Buddies with vehicles, fling them with superpowers, and rig booby traps across wild maps built for combos, trickshots, and carnage. Mix it up with different characters, each with unique buddy-crushing powers.\n\n{903639089201162}\n\n# Level Up, Upgrade, and Unlock\nEvery hit earns you XP and cash \u2013 unlock the most powerful weapons in the game and amplify their destruction with unique buffs.\n\n{1453827229412242}\n\n# A Major FREE Update Every Month \u2013 Vote on What's Next!\nNew weapons, characters, vehicles, and modes have shipped every month since launch \u2013 and we're not slowing down. Join our Discord to vote on updates, share your videos in our creator program, and get special access to releases and giveaways.\n\n**\ud83d\udd17 https://discord.gg/nY9hsQ7qjQ**\n\nFudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"\n\nLuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"", "short_description": "Punch the Buddy, now in VR!\n\nPunch the Buddy, now in VR! Play with friends. Beat down your ragdoll Buddy with weapons, god powers, and physics toys in packed 10-player lobbies. Earn cash, level up, and unlock 70+ weapons. Nonstop physics-driven chaos with a major free update every month!"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/privacy/buddy-beatdown", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": nu
ent-hkg1-2.oculuscdn.com&oh=00_Afu4ptAGaPTm10T2sKlzHRHPUnLnNYqJOPfuHvlwQmktYA&oe=69A191A2"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmc2ryikl8MQ7kNvwFl5WYo&_nc_oc=AdlomSlAadj6LLzCn4yA4Et_Y8Kg8mfzNG966MHTWc73M91T-XZtVa-_aUtF9c7LVBU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afszq2-4K_C0Dcm07oaYwP7rQtSgXjNTiGkpti-_cw1RVA&oe=69A187FC"}, {"file_name": "1.png", "id": "1474571520670016", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617847_1474571527336682_3815185306366428102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-mUsX3l6goQ7kNvwH8Sptz&_nc_oc=AdlxLyeH0WlB5vz-YJD7mR6IosTe2NfVyTLQZ-cSQgGHrhe_tLQRadJBNgsP-OdDOV8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftpnxSPNZn9C-QUaQAwqhPSQVXbHiEe-UjyR5rauNChRg&oe=69A18220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BB Cover Image FTP - Landscape.png", "id": "1923627959037848", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499620444_1923627962371181_4591929654322309400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXKzst-aJGIQ7kNvwFAA4ke&_nc_oc=AdmwJRkU-o1DfQO9BtDgpwYMV7eE4RmiQInO5_iiyYxqGj_gD4Kl65_jY7tuiRKL3K0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuLfSN-9K_HZd_EZxQ3zHPaVTapwtRS8zlThqmy-1X7ew&oe=69A1A451"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "# The Ultimate FREE Stress Relief Sandbox with Multiplayer! \n- Fudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"\n- LuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"\n\nYou and your friends can use light-hearted weapons, devices, superpowers, and more to beat up on your Buddy ragdoll, earn money, and unlock even more powerful weapons. Every moment is packed with absurd over-the-top destruction!\n\n# 50+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic items, physics toys, and boobytraps.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\nPublic and private lobbies to unleash a diabolical beatdown on the buddies (or each other).\n{1597570284565220}\n\n# Tons of Awesome Maps and Game Modes to Explore\nLet your imagination run wild in a playground of topsy-turvy maps and modes. Set up perfectly for combos, trickshots, and chaos!\n{1453827229412242}\n\n# Non-Stop Content Additions\nNew weapons, modes, maps, and more keep the surprises coming and fun constantly evolving.\n\n# Join Our Discord!\nFind others to play with, vote on new weapons, share your videos (creator programs), and get special access to new updates and giveaways (https://dsc.gg/buddybeatdown).\n{2306062236471770}", "short_description": "The Ultimate FREE Stress Relief Sandbox with Multiplayer! \n\nYou and your friends can use light-hearted weapons, devices, superpowers and more to beat up on your Buddy ragdoll, earn money, and unlock even more powerful weapons. Every moment is packed with absurd over-the-top destruction!\n\n"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/game-buddy-beatdown-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
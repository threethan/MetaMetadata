0_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lSZxe_zRbUQ7kNvwHZ_Wx7&_nc_oc=AdoetWWht-IvfteYbTh5TFVqxerOAwAF98CumPqn1EocQTjt5h_kCcgIoH7IPzyUMMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsMJMwijVruMYP9Q9wLbMkSkISqAUVxp87mTCsk4y8iw&oe=6AB52CC6"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d75eihCEAkQ7kNvwH9CFyz&_nc_oc=AdqxAIP0-Nc213vwec9I3n9vuGMrKFrcv06IDLIfuhkl4mFPBRSZhFvxUBRgWU5qQ7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0QWSdZE85gMvXmkaYxzaEBP5PQsJTxKKLADRJAMrQ8A&oe=6AB549BC"}, {"file_name": "1.png", "id": "1601292821023464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1601292824356797_2214700978411289039_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9eRyhdV5pAQ7kNvwEoRnBp&_nc_oc=AdqdAUr5HU2QaCbUrI0JTzopzZ1Yqm5RqFYcyHv3B3m54zv-PPfaEH2GvvT3XdwP6I0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIud-4-sGtMRGslssMfUPVVP5BX5T2jhQKnxshaZs_sw&oe=6AB51DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bb anime.png", "id": "2147479982852154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294644_2147479986185487_7581255106094158471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY4YI1gwwhgQ7kNvwEf134p&_nc_oc=Adq0AS_M0WvqcLXD2abLDjf_OcM4CzSrdmMwnJ49gbLGOPNRCRbIJl_V7fbY23hmOlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBSE614nJEO0MjjTHndXbMGIRdibNNO1wG5nV7L6J2lQ&oe=6AB547D0"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "Punch the Buddy, now in VR! Play with friends. Grab weapons, explosives, and physics toys to beat down your ragdoll Buddy. Earn cash, level up, and unlock even crazier items.\n\n# 70+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic weapons, god powers, and vehicles. Every weapon hits harder than the last.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\n\nJump into chaotic public lobbies, or go private with your friends. Unleash havoc on the Buddies (or each other).\n{1597570284565220}\n\n# Helicopters, UFOs, and Superpowers\nRam Buddies with vehicles, fling them with superpowers, and rig booby traps across wild maps built for combos, trickshots, and carnage. Mix it up with different characters, each with unique buddy-crushing powers.\n\n{903639089201162}\n\n# Level Up, Upgrade, and Unlock\nEvery hit earns you XP and cash \u2013 unlock the most powerful weapons in the game and amplify their destruction with unique buffs.\n\n{1453827229412242}\n\n# A Major FREE Update Every Month \u2013 Vote on What's Next!\nNew weapons, characters, vehicles, and modes have shipped every month since launch \u2013 and we're not slowing down. Join our Discord to vote on updates, share your videos in our creator program, and get special access to releases and giveaways.\n\n**\ud83d\udd17 https://discord.gg/nY9hsQ7qjQ**\n\nFudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"\n\nLuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"", "short_description": "Punch the Buddy, now in VR!\n\nPunch the Buddy, now in VR! Play with friends. Beat down your ragdoll Buddy with weapons, god powers, and physics toys in unhinged 10-player lobbies. Earn cash, level up, and unlock 70+ weapons. Nonstop physics-driven chaos with a major free update every month!"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/privacy/buddy-beatdown", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "co
HKGONbZEWgFcIOCGebp3FHMjV5Mf3n4k0HQZcCx8-p0pbrD_fo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uTuRn7QXvxK0WXvbSbInm0W9TtFEh1zbygegh5wsggg&oe=6A354B46"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns-_AIYCxFcQ7kNvwEuI-V-&_nc_oc=Adqb90G3X2NHeittETGPm4-Vqu95eG7xuB7P7nSWjSha1VhVgQrGEd-ma-LwGKy884o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bsy6dYm64nJInIPD00c9p2yfD6Ox9mNz8-SBTNAVWXw&oe=6A35683C"}, {"file_name": "1.png", "id": "1601292821023464", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1601292824356797_2214700978411289039_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmTRpt3cfewQ7kNvwG9Cus-&_nc_oc=AdrFY1PO_FbqJoWTooXR9XZS--y9cl4PBpBEfVTsjjfOpRjOzPDpfiWdNbxHPTFTOGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MA3QAVi6tbfLVamYrTNn9EKfeDB193-JqtjM4aHmFcw&oe=6A35749F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BB Cover Image FTP - Landscape.png", "id": "1923627959037848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620444_1923627962371181_4591929654322309400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HizplWBXTO8Q7kNvwEdaEGE&_nc_oc=AdqIU4Ypfs2u_SkkOr1Rvlwtld-qYbooYxBerszY-Yb7RLiWd0bu50rLjBLxIjQRR2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Of58kpAX778Uv4OIKlNSKu-KKFyoJ4MK0DdqiYsf49A&oe=6A354C51"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "# The Ultimate FREE Stress Relief Sandbox with Multiplayer! \n\nYou and your friends can use light-hearted weapons, devices, superpowers, and more to beat up on your Buddy ragdoll, earn money, and unlock even more powerful weapons. Every moment is packed with absurd over-the-top destruction!\n\n# 50+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic items, physics toys, and boobytraps.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\nWreak havoc with friends in public or private lobbies. Unleash a diabolical beatdown on the buddies (or each other).\n{1597570284565220}\n\n# Tons of Awesome Maps and Game Modes to Explore\nLet your imagination run wild in a playground of topsy-turvy maps and modes. Set up perfectly for combos, trickshots, and chaos!\n{1453827229412242}\n\n# Non-Stop Content Additions\nNew weapons, modes, maps, and more keep the surprises coming and fun constantly evolving!\n\n{903639089201162}\n\n# Join Our Discord!\nFind others to play with, vote on new updates, share your videos (creator programs), and get special access to future releases and giveaways.\n\n**\ud83d\udd17 discord.gg/kyvHv5fYvy**\n\n\nLuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"\n\nFudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"", "short_description": "The Ultimate FREE Stress Relief Sandbox with Multiplayer! \n\nYou and your friends can use light-hearted weapons, devices, superpowers and more to beat up on your Buddy ragdoll, earn money, and unlock even more powerful weapons. Every moment is packed with absurd over-the-top destruction!\n\n"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/privacy/buddy-beatdown", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subsc
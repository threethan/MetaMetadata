17118_6871409872430360320_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7tU3kG6WOQQ7kNvwFnW9iq&_nc_oc=AdrtaImQA8urdIoBz8SghWdEfSQ-VNWY_iUCn0-pr21-HRbBfwu_xxhWWvWeFN6V9zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-PXg9tB0hXUBzJt_OJkwYHT_Imuztr76ec8i0OszP4A&oe=6A6B58C6"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV-LMYx7xAgQ7kNvwEh2gV7&_nc_oc=AdqMgkuEMUl0ybSvEP8lhLfDO_RVcijlAXCNC6mQYxJx1hJNZAl3ue4e5VHg5Kpcd_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA911wz2-BXwb5BGtWii8SV6qpy8NH1giaduzbuaRe9tg&oe=6A6B3D7C"}, {"file_name": "1.png", "id": "1601292821023464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1601292824356797_2214700978411289039_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2nnSTq6ntYQ7kNvwFkpj3P&_nc_oc=Adq0DWkqmE5m2wx86D8daIO2jtgY0_xjFLx6uMn0izTqwoAYfgH2iuAvEHSzITdHHCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtj75f3EAU6WxHptzyipSOlXa2dUBuB3nHhzO0SiojKQ&oe=6A6B49DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BB Cover Image FTP - Landscape.png", "id": "1923627959037848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_1923627962371181_4591929654322309400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_dDwAJfw3kQ7kNvwHq4aDq&_nc_oc=AdoTTYBmmjz-b38i1yvPod5qFI_4vNILRq-MQQUyH5NrjWFhIrwWLAldm2Pt_29aRmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwT6BaNFF_7pzljDOVmQeBdT1dqlOGZcyYmOaTcXlqhw&oe=6A6B59D1"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "# The Ultimate FREE Multiplayer Destruction Sandbox!\n\nThe unhinged buddy-bashing you know and love, now in VR with friends. Grab weapons, explosives, and physics toys to beat down your ragdoll Buddy \u2013 earn cash, level up, and unlock even crazier gear.\n\n# 70+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic weapons, god powers, and vehicles. Every unlock hits harder than the last.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\n\nJump into packed public lobbies, or go private with your friends. Unleash havoc on the buddies (or each other).\n{1597570284565220}\n\n# Helicopters, UFOs, and Superpowers\nFly vehicles into buildings, fling Buddies with superpowers, and rig booby traps across wild maps built for combos, trickshots, and carnage.\n{903639089201162}\n\n# Level Up, Upgrade, and Unlock\nEvery hit earns you XP and cash \u2013 climb 50 levels, unlock the most powerful weapons in the game, then prestige to keep increasing your stats. 10 prestige ranks for those who can go the distance.\n{1453827229412242}\n\n# A Major FREE Update Every Month \u2013 Vote on What's Next!\nNew weapons, characters, vehicles, and modes have shipped every month since launch \u2013 and we're not slowing down. Join our Discord to vote on updates, share your videos in our creator program, and get special access to releases and giveaways.\n\n**\ud83d\udd17 https://discord.gg/nY9hsQ7qjQ**\n\nFudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"\n\nLuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"", "short_description": "The Ultimate FREE Multiplayer Destruction Sandbox!\n\nThe unhinged buddy-bashing you know and love, now in VR. Beat down your ragdoll Buddy with weapons, god powers, and physics toys in packed 10-player lobbies. Earn cash, level up, and unlock 70+ weapons. Nonstop physics-driven chaos with a major free update every month!"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/privacy/buddy-beatdown", "developer_terms_of_service_url": null, "publisher_name
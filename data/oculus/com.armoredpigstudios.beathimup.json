17118_6871409872430360320_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTMXdoB0z0UQ7kNvwHos-QM&_nc_oc=AdqYAEcFCvegfRLsiB1a09X1MXsdXQLnaTFTDMiEEeHnuwLoyJR4NCm_cOSP1yh7PUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxBpau2jvZb7dK86Lijlj2RveFbxpKpiPPtrzXfVe97g&oe=6A709EC6"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Klme7zhoZC8Q7kNvwF3gsqn&_nc_oc=AdrkeqfT_RYp8Cx5QcpOzoUZsGiGOZzEXWbqZdVj_gLndPmUfFUplep0SUCiAAXpEo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe8usDPnT4o9fbHVCbrqbNdZtJXwl3GP0Yvat7oKl3zA&oe=6A70837C"}, {"file_name": "1.png", "id": "1601292821023464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619098_1601292824356797_2214700978411289039_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQc4p1pUPG8Q7kNvwF7S2pk&_nc_oc=AdrVnQCLLFzKXg_YLUWuR53ZmsjaYO3sUhgG9H1nhIQbEhA7qmXykwr7Nmd1nojFk8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE932WsF-wqYLRxqGagduXWV6zbSNh3mgRFXukz-7seA&oe=6A708FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BB Cover Image FTP - Landscape.png", "id": "1923627959037848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_1923627962371181_4591929654322309400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwOOf-DcnIAQ7kNvwFIBTwn&_nc_oc=AdqHLYU_s8wisYFn4UYC5J9uI6iAYbPi04xHI-5gkxCXjW5i6K3EIFXpI9ZY8-7K-Nc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEau_OlADPXSaBU51d_GDJoi3U_4Hv_MSeQfxCWUC5PEQ&oe=6A709FD1"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "# The Ultimate FREE Multiplayer Destruction Sandbox!\n\nThe unhinged buddy-bashing you know and love, now in VR with friends. Grab weapons, explosives, and physics toys to beat down your ragdoll Buddy \u2013 earn cash, level up, and unlock even crazier gear.\n\n# 70+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic weapons, god powers, and vehicles. Every unlock hits harder than the last.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\n\nJump into packed public lobbies, or go private with your friends. Unleash havoc on the buddies (or each other).\n{1597570284565220}\n\n# Helicopters, UFOs, and Superpowers\nFly vehicles into buildings, fling Buddies with superpowers, and rig booby traps across wild maps built for combos, trickshots, and carnage.\n{903639089201162}\n\n# Level Up, Upgrade, and Unlock\nEvery hit earns you XP and cash \u2013 climb 50 levels, unlock the most powerful weapons in the game, then prestige to keep increasing your stats. 10 prestige ranks for those who can go the distance.\n{1453827229412242}\n\n# A Major FREE Update Every Month \u2013 Vote on What's Next!\nNew weapons, characters, vehicles, and modes have shipped every month since launch \u2013 and we're not slowing down. Join our Discord to vote on updates, share your videos in our creator program, and get special access to releases and giveaways.\n\n**\ud83d\udd17 https://discord.gg/nY9hsQ7qjQ**\n\nFudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"\n\nLuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"", "short_description": "The Ultimate FREE Multiplayer Destruction Sandbox!\n\nThe unhinged buddy-bashing you know and love, now in VR. Beat down your ragdoll Buddy with weapons, god powers, and physics toys in packed 10-player lobbies. Earn cash, level up, and unlock 70+ weapons. Nonstop physics-driven chaos with a major free update every month!"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/privacy/buddy-beatdown", "developer_terms_of_service_url": null, "publisher_name
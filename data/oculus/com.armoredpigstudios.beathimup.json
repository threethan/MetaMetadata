0_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lSZxe_zRbUQ7kNvwHSsH48&_nc_oc=Ado6hkp9rsTwNLuDbZ2nZyJXcOBRz7tdFClDolGmxlnHh8dhO6rvMVlLrgRSgNGLTvA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYCGEuHcbpVMxcGJQ9Z89699szDo3GgLaC3HGIbfHuyg&oe=6AB67E46"}, {"file_name": "com.armoredpigstudios.beathimup-20251203-164439-0.00_10_27_22.Still003.png", "id": "25260170983602879", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303198_25260170986936212_9048131888412453366_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZmeZo92ps0Q7kNvwGThZJG&_nc_oc=Adqiv9hggZ2AmK2mK1FATylzBgAMiLie1PUR6OLSk7VXB5Cih0KIaniqPNgoedGpt9s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDHlDWm1bjF2sdivGoDN2KoRV_b4qcygJ8yYLo6jagYA&oe=6AB69B3C"}, {"file_name": "1.png", "id": "1601292821023464", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619098_1601292824356797_2214700978411289039_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7uvUESrZoQ7kNvwFIfLlF&_nc_oc=AdptnE6PAc-689tQM6YYNqSLQ-gIIy-trcbZSGb6x98cxryRFzbec01J4m3QhVvwEDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8jH2YQSIvQ2FGk2cEmwggPjcVgg0GgjVDjdU6AzsU8g&oe=6AB66F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bb anime.png", "id": "2147479982852154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294644_2147479986185487_7581255106094158471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmDEhmdvbvIQ7kNvwHO9Vlt&_nc_oc=Adrn-F-N6N9zNGREP6LG4v6pJmWTWaMiccE4zh9PsRPcMND2vXEw2G4ppxu9Nrtljn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRxu-LjMDbwpENdqEhOV-K0IceSa1Xde9FwscCNbQnsQ&oe=6AB69950"}, "display_name": "Buddy Beatdown", "keywords": ["buddy", "free", "physics", "shooter", "sandbox"], "long_description": "Punch the Buddy, now in VR! Play with friends. Grab weapons, explosives, and physics toys to beat down your ragdoll Buddy. Earn cash, level up, and unlock even crazier items.\n\n# 70+ Weapons to Unlock\nEndlessly satisfying demolition with tons of epic weapons, god powers, and vehicles. Every weapon hits harder than the last.\n{1555781618784552}\n\n# Multiplayer Mayhem with Friends\n\nJump into chaotic public lobbies, or go private with your friends. Unleash havoc on the Buddies (or each other).\n{1597570284565220}\n\n# Helicopters, UFOs, and Superpowers\nRam Buddies with vehicles, fling them with superpowers, and rig booby traps across wild maps built for combos, trickshots, and carnage. Mix it up with different characters, each with unique buddy-crushing powers.\n\n{903639089201162}\n\n# Level Up, Upgrade, and Unlock\nEvery hit earns you XP and cash \u2013 unlock the most powerful weapons in the game and amplify their destruction with unique buffs.\n\n{1453827229412242}\n\n# A Major FREE Update Every Month \u2013 Vote on What's Next!\nNew weapons, characters, vehicles, and modes have shipped every month since launch \u2013 and we're not slowing down. Join our Discord to vote on updates, share your videos in our creator program, and get special access to releases and giveaways.\n\n**\ud83d\udd17 https://discord.gg/nY9hsQ7qjQ**\n\nFudgy \u2013 \"OH MY GOODNESS HIS HEAD ACTUALLY CAME OFF! THAT'S SO COOL!\"\n\nLuxoticVR \u2013 \"One of the best free multiplayer Quest games I've found in a while\"", "short_description": "Punch the Buddy, now in VR!\n\nPunch the Buddy, now in VR! Play with friends. Beat down your ragdoll Buddy with weapons, god powers, and physics toys in unhinged 10-player lobbies. Earn cash, level up, and unlock 70+ weapons. Nonstop physics-driven chaos with a major free update every month!"}]}, "developer_name": "2080 Games, Armored Pig Studios", "developer_privacy_policy_url": "https://www.2080.games/privacy/buddy-beatdown", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "co
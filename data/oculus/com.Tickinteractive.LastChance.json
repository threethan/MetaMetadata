fw5-2.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymjmW1u3ZcsQ7kNvwGtw-oh&_nc_oc=AdrEXN5vjxBOptd8SoioJ-y4mvGgLP0x7LAQxNYm2_MweAwMyHDtg60x6QU1vbp9tnk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzjxr4xUGEv4Tra-4phUGbO_AvIg9NfVK3OOtDCEZHb1g&oe=69C5256E"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_miBaqO-7GkQ7kNvwFCgScP&_nc_oc=AdqZPHgCkfHo2wFEWjLa87ZeWSbk8KlClvg9lHF_pdmDEQScVp_mTRoqevePfxIWUrg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5NITHX9iyLHD49C4qEUpzlRwXcIe5Lwf5UDhWUa-2OA&oe=69C5150D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErzEUb6xAT4Q7kNvwGgniWX&_nc_oc=AdonCO2lpDkEvxF4EQOw_S8yvtLczqqpchCE6pAZaQpWC1JCZlguSJEhEq6NWfv2StA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxa3rI_MtGNnCvXNweGeZJfuFFrQis1CnitsSupxNt2MA&oe=69C510A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLMfkLyBryoQ7kNvwEXvI-C&_nc_oc=Adq48cp5H-vna13kLcu35vntETsIVDW4pXp97ivL89Bzoz_0ytVHWHaRmF2RaD0pu0M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqI6nTo81i1EjJIDvida_M03gQybdb99QyZ9sipdMHbw&oe=69C52133"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632513700113366"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031629_1431890927606777_9015160482174066876_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNCXgq_s_BIQ7kNvwEEoX-5&_nc_oc=Adpk_6_2lRni8fZAaP1RqRHrDp7381nTW4bRVwSBasCKN8Y4lwtHnGUPtPuKbclmpT0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5UbIabtixbxa_FCM4qJU_AuZAmwigcxBl36q0XtZA1Q&oe=69C525CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Chance: The Survivor", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1706943600, "lastRevision": {"nodes": [{"id": "6988668544497888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6988668514497891", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "6970833956319381"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": 
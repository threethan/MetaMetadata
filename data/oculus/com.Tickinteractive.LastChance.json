tent-sin11-2.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M-0EiFnuMMQ7kNvwG8WJvE&_nc_oc=Adqotl3wZJTUwLTR9M42ordARgycVX_JvOk3gzLA4wLW6f9BIHW_R__xr_GBmVaP3oU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOOi7VbBqI6LEMbYbkyLKWoAuZKurWsqZoQ0eO4dULhw&oe=6A7DB76E"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyrjy0q_oAEQ7kNvwGB7uIM&_nc_oc=Adp8od6Ug6sXA9gdb8awAD3hNLpu16Gv2OV2UKk4qldzLqLs38unAF59QjMqWvIJqoI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYhkKmcoJVInGInyqUbfMh1CR1BWuAfyppIOco8NBLeg&oe=6A7DA70D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brPydNSUj7AQ7kNvwGksO3Z&_nc_oc=AdqOdfFhMVZeVDNKbXeH_MIhMT7uEyJr0H6owBu98SZXLZwy3b4BVC2xvsOMm686zRE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCbNXYYuwZV8OEqIGkpWXHOj8kiflMp-QS5KFHAO4U9w&oe=6A7DA2A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP0atQEWAQcQ7kNvwGMLOXO&_nc_oc=AdrjkZr3xgXv0hESivB_JTqByG80kSBYOqLxi6_tq9CkBkr1D_pZU0cA4Jo15HTQdg0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdjlQDlbPpG6aY8CJ1FWkQPlJ7UVeaSTnnltk6ZNNmlA&oe=6A7DB333"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED"
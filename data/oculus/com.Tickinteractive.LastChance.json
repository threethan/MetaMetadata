a0a&_nc_ohc=tYfRuuhbarwQ7kNvwF-EcvN&_nc_oc=Adne5CW11lt7Hcl_W8kiG5KnbrGbI-CnKHAkX2j2WF15tgHtsLq_i9eLt7CR2c4JJPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsLD8pvInpS_WzMNI0ezhiRbPzYeGjdXnt4rJ97JkzXTw&oe=69A03B6E"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVYU6Qp6ehUQ7kNvwG97bcK&_nc_oc=AdlOvoWq4wZrOPZT1rWZivx7H0oAYXF-8cXIx7S7QqlfQhg5fqeX0NHO0EJ2KlbQzKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuUfSv4y3ykxigI8y-ZSXvGl60BT5kKPzzMhAVJqmFtQg&oe=69A02B0D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeM_jqqqJVEQ7kNvwFdHPRB&_nc_oc=AdmiOuXY3o8ex4cXKX3vGSKk5_-2IZutpMzErdLffoJYTLwbrHDgW0YbPArcqWlp7Z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuyh85q7V0emlcmHlopYWY4Z2uW9jqPDByfh-DjOM_71Q&oe=69A026A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdO8uQIqkRYQ7kNvwGePkql&_nc_oc=Adl6H1ZQ9SryP9od6VPanDPng-zJLIqFafdo_cnybsNiJg59w5-ghAQSr-pI_C-jqEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs90UdVniZaK_NRqX6Idrq2z-fEylN_nQeoRLMCCxtcmw&oe=69A03733"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "
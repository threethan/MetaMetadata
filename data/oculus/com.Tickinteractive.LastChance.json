tent-sin11-2.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1crBw6rTfo0Q7kNvwFlWKuO&_nc_oc=Adow2QkRiULfStwfuNfga4rKiQmcDgWu5Q1oVHPaXhF3W6Jd2xB5dImSyKMc0hznKZk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cy9rNrFhH-nT9C6J-dbokX5_CC-4zSqqtASuGzZnfSQ&oe=6A3961AE"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjmcDxEKbUQQ7kNvwGxz7ly&_nc_oc=AdqkO03n1NKzmSrczq4FNHoVjfOtdRjJDGWu0UQz-hPzrtKCykTC3Mwf6qglB-1ti6o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WmGlakaquoj5nwlAKyG9HhZYzejEej05I4JAsf9uMVg&oe=6A39514D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtPxLHAE91AQ7kNvwGmh3En&_nc_oc=AdrpVXW5ilPuckaz2q8Dsc3G2rKHj_Cka0hF38yfi7P8TRXZH8vHdBD7SQiuUnjH2WM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fev991VZ7aGPW44fWyxx-0mq4Vbs7CVRX7H_eEB1x2Q&oe=6A394CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X6oSZ-LOV0Q7kNvwF3zMAJ&_nc_oc=AdoakHl9Vg4vDH-WBGe2LgMiPhmHC1PBC1mW3hVsNiPky3TlmMOU31s0WB1K2T7cN8s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bstxkuuwQB8uSYG9sKKuX85diuDiH1jJWIp94mCFlPw&oe=6A395D73"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED"
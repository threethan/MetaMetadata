tl3-3.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgwZpRI2fakQ7kNvwF1PCoh&_nc_oc=AdruSsc-EIBeQSlMSbopxHIpKGFeoktRB_H0Pnt3ng2zWict64PNvkatw7EqgX6twl8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gf-qaFSPyCVyn8nIGSXbv178jOS1-7Z37JnX75S83Mw&oe=6A30272E"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2IxoN3ZNQIQ7kNvwEkIqkc&_nc_oc=AdpdmISekILSaovfhA8OMUwHHYMNvG3sUIG0m2KtmIfPKY8AcMkiKUiUgzwQjovzQdc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4jpF03dzLU5klQ_n0EYBFjhv0aoU7lF-qBArUq905Ig&oe=6A3016CD"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B51dRrUzkX8Q7kNvwG5Ij3o&_nc_oc=Adp7vAq9HFlRT4V2LbWxRYciRA8XzCpOS52krTPH-OB6_T0v-9QD5UGaxWYrKHHIyN0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UxlK4FnnwwqM0LcOhc3IvVPrcTfDSygA9cgOS_yEG4A&oe=6A301268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4UcbFBDT1UQ7kNvwHAcccY&_nc_oc=AdryWPfSBKMjYPprG26zNg6NAzcg4od05FgnckuwYue9R2QKQ2P6RdnHHumAo9ZpHTs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3okI2jCLbeO6Tllg266AjvIzeEOg0WTH2tc--kHO51A&oe=6A3022F3"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632513700113366"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031629_1431890927606777_9015160482174066876_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8TaJXF2hBIQ7kNvwHGXRq0&_nc_oc=AdqS3EQbGWnAAZyCQFZ9PlN5u_zl_Sz4YAOF0wyFEoO5UhggOJ-WpdoPC_F8Szr0sAI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1hJCd0rWixCosTaRTEjvl3QM5zsC8nl4UpdL4tNFXhA&oe=6A30278D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Chance: The Survivor", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1706943600, "lastRevision": {"nodes": [{"id": "6988668544497888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6988668514497891", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "6970833956319381"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": 
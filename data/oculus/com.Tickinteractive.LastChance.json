4vZuHROEVPjiIgPkOTLfnkt7tVw3S40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTy_Gwi27d3MDCmOU7sSMYsHCfLJZ_KGkqFKZWqLeRuqw&oe=6B0DC204"}, {"file_name": "1.png", "id": "1083918432800277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYtYvpXo3bwQ7kNvwFHJtAY&_nc_oc=Adre8G4jKmYTITgdkACJp3DWEcdG6nuiIvCyGu_qfGOimlDmM8YqWwynE5xXSYW4XbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNiNqwJS2BP7pDZsYEOVVy52ecOQfCqQ1fF3iattc2Aw&oe=6B0DA32E"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euPaPrmYpxUQ7kNvwH-eGh8&_nc_oc=Adoc0saYYsPZ4J3l5ZZZ2w1fVwVqPrZ5UgR-8av7L0J9pty5RGM-ND5yq2qx_FHWb3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1d4NZ11oD8u4cw1nl6WozseGYE6HrcgLM8hSiCyCrbA&oe=6B0DCB0D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY300U5ZLvkQ7kNvwF4FBmj&_nc_oc=AdoufHI1ZyhaKwRimpdkyQWIKp6uKK2yRU7ag7-js6ZG8nTRxVpLsmIB-NRwxlX6NvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBf0bKYI33nuWsxCaCuVYSQOsFSE2u8SuMgQuIMvcDAA&oe=6B0DC6A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1OqVtcyGpwQ7kNvwGNwSip&_nc_oc=AdrAbAP00TbezjNyqd9WzzOgF5f4Z_RwHeL7fio60La84ykLoUp0NwKTGwvWyepKF4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3XGwAx607rosC_QYADx8uuHBpYV3_mAmueXMuDt6VVw&oe=6B0D9EF3"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632513700113366"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031629_1431890927606777_9015160482174066876_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27kZPEPGl0kQ7kNvwEGS8UK&_nc_oc=Ado5q43NyWIdIpO8UmUsNS51f2XuszsqdO1hOlOjlehkmM_jvhPO2VEOePKpBth3DlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLeG2T1uH4CvsFDiKda3NWjgLvIPhTaKJ3kTfOOJlfvQ&oe=6B0DA38D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last Chance: The Survivor", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1706943600, "lastRevision": {"nodes": [{"id": "6988668544497888", "release_type":
nt-lhr6-1.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBCGOrGcxXgQ7kNvwH1Jlzj&_nc_oc=AdptwMubMcn69vSIVaPw-ZhIHXvZ_EKiE1psUXqcSGGSwRTrLbYF2N_Fj7qG1kWOoSE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOFyX43oi806mWP-bwrkLHahC2DLj6u87EMBnq5pivaQ&oe=6A85A06E"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCzYHn3WGcwQ7kNvwF0QMbe&_nc_oc=Adqnoe77tV_xqJYNjijmIToydbyK-_sF_3v4FeQCCM34n-cN0iTG-MIf4aP_nNumdYs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb8RwK5Wm2S9dAaXLpHDkvWdu67uzxwTyI2mjLBOvA9g&oe=6A85900D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI9tdrsJv3YQ7kNvwF5cy_4&_nc_oc=Adr7zYDVW5ac4LSYl2l_ddcBuwX-PUBXEyNL48_dbLaasGn2c1U2c1yNIdtCk33KNvo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGijBevSYGd_IwUSNokZ02zD2U80XB9kxl-RTo1UvMwyw&oe=6A858BA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-iReXyH8iYQ7kNvwFvXn_j&_nc_oc=AdqQyaT47iUB-ikJTt9U6TVyPFdRcp5yqGylwLReizEhUgI0a30sg74yGmfxW3liAG4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp0IotjVN9TpeBpTmtHxs6iWFiwOzvAM1IhiSoNJd-lw&oe=6A859C33"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastchancevr.com/privacypolicy", "developer_terms_of_service_url": "https://www.lastchancevr.com/eula", "publisher_name": "Tickinteractive Technology", "support_website_url": null, "website_url": "https://www.lastchancevr.com/", "category": null, "comfort_rating": "NOT_RATED", "c
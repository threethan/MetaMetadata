ikkHOlax3jhmuw0jIBTCq3bkTfFJ0Kk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNohrTgtWeeA00HiXlgV-Jdnmwto9OcXu2mQ3GD2Nt9Q&oe=6B048784"}, {"file_name": "1.png", "id": "1083918432800277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210893_1083918439466943_4096975780482072563_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USxzjM9PDDwQ7kNvwHOyrXj&_nc_oc=AdqOa1msWDIYXj5sgAcVS8yBymHo46jnBc9NCv_bNVoKFi3rquRX162KKurmRyVm8mw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9vOmowSo5c7GvQg5Psak-ZINYZH9p33HBsoEGsUm1QA&oe=6B0468AE"}, {"file_name": "6.png", "id": "1441316176805782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003282_1441316180139115_660872075344180481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zLXc3GYtp4Q7kNvwFHbU6R&_nc_oc=Adrn1qm4mlWomCL5ljcEsw4EC5GCuO1GRh-MJ00_tyUYq-OkAxWTWWD2jN3coMthTX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR40U80w5hfw9acXQBPCbBastiFyZfXSfeqINSq8CSIZw&oe=6B04584D"}, {"file_name": "8.png", "id": "1052888042643074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001670_1052888055976406_3539002532750634157_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7PFMjNYEZgQ7kNvwGQQWnh&_nc_oc=AdqKWaZmfHEl4dRxg9YXHGaahsJKmiUXcHuGhvoR_e8cbegfPclyk3XVPTzviMiEAvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN40APIIsiB1wBIh_Kb60UeWP_wLh_qjECf3RI9gTisA&oe=6B0453E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "2276308399239936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2276308402573269_1803063043453586688_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCN4okeSXCAQ7kNvwHKDqL-&_nc_oc=AdqXkBScC0SNPQRlhjt3Q1abC2byH2rJSzLm_pgk1pOfG77Ftjw9-7VgVdet14_Po9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS000Z1SD2HOzka-bYQkvnZpS6vOmZa-iD1rJRP12N3Cg&oe=6B046473"}, "display_name": "Last Chance: The Survivor", "keywords": [], "long_description": "\"Last Chance: The Survivor\" is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles.\n\nFeatures:\n\nRealistic VR Experience:\nHigh-quality graphics and fluid VR mechanics for an immersive post-apocalyptic experience. Interact naturally with a world full of interactive objects and realistic physics.\n\nStrategic Combat:\nDiverse weapons for varied strategies. Defeat enemies using environmental tactics and smart resource management.\n\nDiverse Zombies:\nFace different types of zombies, each requiring unique combat approaches. From swift attackers to more formidable foes, adapt your strategy to survive.\n\nHighscore Mode:\nEndless action in Highscore Mode. Aim for high scores against increasing zombie waves. Tests shooting skills, quick thinking, and agility.\n\nVersions: \n1.0.3 - 'Highscore' and 'Training' modes are currently playable. New modes coming soon! Thanks for your feedback and support! ", "short_description": "Last Chance: The Survivor is a VR-based action-shooter game that chronicles the gripping journey of Gabriel, starting as a scientist in an army laboratory and continuing as a father searching for his daughter in a post-apocalyptic world. Following a devastating catastrophe that has ravaged the world, Gabriel focuses on one sole purpose in his ruined life: finding his lost daughter. During this journey, Gabriel faces the challenges of a broken world, enduring both physical and emotional battles."}]}, "developer_name": n
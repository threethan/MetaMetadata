play_name": "Moker", "keywords": [], "long_description": "\nThis is a fun multiplayer game made by the small youtuber ShruffVR.\n\nThis game is a gorilla tag fan game with a different locomotion system than other games, in order to move in this game you need to use your arms, like a monkey. \n\nIt has always been my dream to make a game, and i really love gorilla tag, so why not make a fan game. If there are any bugs in the game or if you think the game is bad, please don't give me any hate because games aren't that easy to make and I put a lot of work making this one.\n\nThank you for reading this", "short_description": "This is a fun multiplayer game made by the small youtuber ShruffVR.\n\nThis game is a gorilla tag fan game with a different locomotion system than other games, in order to move in this game you need to use your arms, like a monkey. "}]}, "developer_name": "ShruffVR", "developer_privacy_policy_url": "https://sites.google.com/view/officialmoker/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShruffVR", "support_website_url": null, "website_url": "https://sites.google.com/view/officialmoker/mokermainpage", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8232211690240982"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t6
_nc_sid=6e7a0a&_nc_ohc=VFYAkRv6yzAQ7kNvwF2vdUV&_nc_oc=AdrfPo_Iiu5cpEShLJfkJAZuQadr9Mm4OOmA6mDWHYoWS7FqD7YI_KY-WRpiDFX400Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YvyqQSnOOktIHzRXf_Xsu7oAv8DOGLkwnd5yrUg9wWA&oe=6A19B055"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Flammable", "keywords": ["Fun", "Fangame"], "long_description": "Flammable is a high\u2011intensity VR movement game built around pure momentum, fast decision\u2011making, and chaotic fun. Every part of the world is designed to be climbed, vaulted, launched from, or escaped through, giving players total freedom to move with speed and creativity. Whether you\u2019re racing across platforms, scaling towering structures, or weaving through tight spaces, Flammable turns physical skill into your greatest weapon.\n\nAt its core, Flammable is about the thrill of the chase. Matches erupt into explosive bursts of action as players sprint, leap, and improvise their way through reactive environments that reward quick thinking and bold movement. No two rounds ever feel the same\u2014routes shift, strategies evolve, and every escape or capture becomes a story of its own.", "short_description": "Project Flammable is a high\u2011energy VR movement game where players sprint, climb, and outmaneuver each other through fast, reactive environments. Built for pure momentum and chaotic fun, every match becomes a test of speed, skill, and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2gewbXnAQZ4UT1pnlK4vMHTRyH4REtmHAsOLDck8s4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Z2gewbXnAQZ4UT1pnlK4vMHTRyH4REtmHAsOLDck8s4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
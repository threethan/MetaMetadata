02&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ak5PwgaxNB4Q7kNvwHcwgKE&_nc_oc=Adp5ZJ5QsQucV-joPx7EEhEsn-YTmTLivbzSURAXOPnd1Dkr_uYnPhuZmdWBXYO4ZRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQdzpcCvhSYdV5ANYOiV2IstXN9qiZ0VlTGE9s4II5pQ&oe=6AFC8BB1"}, {"file_name": "GorillaTagSJR_Custom..._07.01.2026_17-15-42.png", "id": "1425558775571148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_1425558778904481_8595080047587830689_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oRoSKwgW0wQ7kNvwH5lCtt&_nc_oc=AdqMGEGPjrJf8k_3cEmjrUTTVsaAX51AeblqN188QJz_kYVXHXVX2jjNT9RznALR3vQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3fSJw7VfXUS9iwnt8_6uDtwb91oiJ4URxl-fDBDtSWA&oe=6AFC7255"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Flammable", "keywords": ["Fun", "Fangame"], "long_description": "Flammable is a high\u2011intensity VR movement game built around pure momentum, fast decision\u2011making, and chaotic fun. Every part of the world is designed to be climbed, vaulted, launched from, or escaped through, giving players total freedom to move with speed and creativity. Whether you\u2019re racing across platforms, scaling towering structures, or weaving through tight spaces, Flammable turns physical skill into your greatest weapon.\n\nAt its core, Flammable is about the thrill of the chase. Matches erupt into explosive bursts of action as players sprint, leap, and improvise their way through reactive environments that reward quick thinking and bold movement. No two rounds ever feel the same\u2014routes shift, strategies evolve, and every escape or capture becomes a story of its own.", "short_description": "Project Flammable is a high\u2011energy VR movement game where players sprint, climb, and outmaneuver each other through fast, reactive environments. Built for pure momentum and chaotic fun, every match becomes a test of speed, skill, and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2gewbXnAQZ4UT1pnlK4vMHTRyH4REtmHAsOLDck8s4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Z2gewbXnAQZ4UT1pnlK4vMHTRyH4REtmHAsOLDck8s4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26021002060851071"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26177282481889694", "version": "1.1.36"}, "id": "1555104125832793", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26002763519341592", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26177282481889694"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1555104125832793"}]}, "change_log": null, "created_date": 1769352252, "id": "26177282481889694", "version": "1.1.36", "version_code": 150, "re
YsW3s47Lhyb99CJdIhPvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afse69Bqrwh30csq-JR0WT5h0hjvEYJJdVsXrxD52394uw&oe=699B043F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Z2vgpj", "id": "571617800031789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_571617803365122_9114959576175738880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hMjdaTkzIIQ7kNvwHLLz6B&_nc_oc=AdkDI2Jr94bQ3Goy9reOS3pGHbVNtkrOSKua3U-WjjUdtX9K00g5O9dCR8Q7WstoHfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afufd3B7SvobwQYGhRYCMY-9yLqxHPZPaZSeMr8CDjAsOA&oe=699AEAAF"}, "display_name": "Cloudlands 2", "keywords": ["golf", "minigolf", "multiplayer", "editor", "ugc"], "long_description": "Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds.\n\n- 54-hole single player campaign takes you through the Green Glades, Magic Meadows, and Reaper Ruins.  Play 18 hole mixes of full sized golf and minigolf.\n\n- Level Editor with over 1000 pieces to build and make epic mini golf or full golf holes.  Create and upload your creations to allow other people to play.\n\n- Expect to find a nearly unlimited supply of amazing user created levels.  All existing Cloudlands 1 holes are available to play (2000+).\n\n- Online Multiplayer allows up to 4 players to play together.  Create a room, have your friends join, and off you go.\n\n- Local Multiplayer pass and play allows you and your friends to play together by passing one headset between you.\n\n- In-game voice chat and Oculus Avatars fully supported.", "short_description": "Award winning Cloudlands: VR Minigolf has an official sequel that's bigger and better than ever.  Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "360211942273265"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "592160194940356"}, {"status": "PUBLISHED", "id": "607189699868266"}, {"status": "PUBLISHED", "id": "699578283800201"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "PUBLISHED", "id": "592160194940356"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4662830647123163", "version": "1.31"}, "id": "333072210579044", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2337198749686376", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4662830647123163"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "333072210579044"}]}, "change_log": "-Fixed a bug where Quest 2 could not view custom holes or hole leaderbo
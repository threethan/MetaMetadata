s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmj-PE6jItYQ7kNvwFjX-Ym&_nc_oc=Adpa-NqJFBCoAUoQvbdvkWOxjIsLavSyiFwQY4loRSek1SWwFbAl_-Pkt-LlUlHsFPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcpU_0KPAdraHmG0x52inM4iefr5t5JVAwofnw50RZPA&oe=6B09A83D"}, {"file_name": "migrated_image.png", "id": "501955207115599", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031380_336476657298702_7984626640313384960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJpswx9en6oQ7kNvwG0Ctyh&_nc_oc=AdqPRWYOkRMfpAFgpF945oGTUaiFXZWajNU07BjrSPafVytiRpV84riFjjX3E3qy_ug&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa8xfvSKpDiy9FUj3HDMJLY3AMJPJy2HpoS1nFV2ID8Q&oe=6B09A0A3"}, {"file_name": "migrated_image.png", "id": "219421742757603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982502_390688614888078_7164405220988944384_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGG4cDnaDtoQ7kNvwE98KhR&_nc_oc=AdpCLDC4iG3QunysMxv5JJ3C4410bktmC_UsXRelJaJBYgiVh2eVysU30GPMAOt245g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdj9fso2wP1j3A5hzfkx_UsjaczILMLNtyXVhVNbt7iA&oe=6B09A0E4"}, {"file_name": "migrated_image.png", "id": "1479492935562794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974666_417503302181871_6637763800101552128_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg1YlbXS-5kQ7kNvwHj3x5G&_nc_oc=Ado3Hu5oZor-qzT4eQcdRGN0DehGJYJzY87wP19ZR1YGBYGj73iJ6wJ10NZR2WyBRCI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUKArVbRrCMp3fMX8mxgKSIZyHXC5hIW7_HOrs_ufIgg&oe=6B09BD7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cloudlands 2", "keywords": ["golf", "minigolf", "multiplayer", "editor", "ugc"], "long_description": "Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds.\n\n- 54-hole single player campaign takes you through the Green Glades, Magic Meadows, and Reaper Ruins.  Play 18 hole mixes of full sized golf and minigolf.\n\n- Level Editor with over 1000 pieces to build and make epic mini golf or full golf holes.  Create and upload your creations to allow other people to play.\n\n- Expect to find a nearly unlimited supply of amazing user created levels.  All existing Cloudlands 1 holes are available to play (2000+).\n\n- Online Multiplayer allows up to 4 players to play together.  Create a room, have your friends join, and off you go.\n\n- Local Multiplayer pass and play allows you and your friends to play together by passing one headset between you.\n\n- In-game voice chat and Oculus Avatars fully supported.", "short_description": "Award winning Cloudlands: VR Minigolf has an official sequel that's bigger and better than ever.  Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
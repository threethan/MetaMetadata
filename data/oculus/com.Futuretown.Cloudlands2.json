s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u96Kln3g-AQ7kNvwFFAhFG&_nc_oc=Ado6VzRrdtC4fsBIHDZYCE18sOqqPvcwRdluBscnSq2zNsZHbunkHGUK0g2ncYN18ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvDBQYkx27MbgkK87J1dK0fjTp7cST3VFGZxf3TAnPBQ&oe=6B0EEE3D"}, {"file_name": "migrated_image.png", "id": "501955207115599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031380_336476657298702_7984626640313384960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gxvgn-njpssQ7kNvwEeOj4q&_nc_oc=AdoiepDRBCNCG9HaHfoNcpQu9WAjK6Q-_mg6TlYz_UXvZ8T1PXptvEhMV8khadBUoqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVobXQmA_uq5uohBm91W1bwnVutABYoZibprqZGR_NQ1Q&oe=6B0F1EE3"}, {"file_name": "migrated_image.png", "id": "219421742757603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_390688614888078_7164405220988944384_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FT7-upR0nIQ7kNvwG_AkdG&_nc_oc=AdqVKszjTo9eE4f-FoDU5b8molMV6Dd5fKRkzBDZ6qDSruWy6uQ1v4YNMm6nla-K6bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0MPknOIx-lMKaq5OV0XKdyrwUCAqFTF8J0VyN0G5cZQ&oe=6B0F1F24"}, {"file_name": "migrated_image.png", "id": "1479492935562794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_417503302181871_6637763800101552128_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiEWuEw4PToQ7kNvwGOJ7l0&_nc_oc=Adrmca9n3j2d_jiTzLWVUGQsb824rNlcggHOCqIf9obNNC17pNAtfGMNtCoZLbfuK8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgwNTSQlF6SfvYe6U3Qf2ND5_j3YmEFIvsTCRW1yGlkQ&oe=6B0F037F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cloudlands 2", "keywords": ["golf", "minigolf", "multiplayer", "editor", "ugc"], "long_description": "Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds.\n\n- 54-hole single player campaign takes you through the Green Glades, Magic Meadows, and Reaper Ruins.  Play 18 hole mixes of full sized golf and minigolf.\n\n- Level Editor with over 1000 pieces to build and make epic mini golf or full golf holes.  Create and upload your creations to allow other people to play.\n\n- Expect to find a nearly unlimited supply of amazing user created levels.  All existing Cloudlands 1 holes are available to play (2000+).\n\n- Online Multiplayer allows up to 4 players to play together.  Create a room, have your friends join, and off you go.\n\n- Local Multiplayer pass and play allows you and your friends to play together by passing one headset between you.\n\n- In-game voice chat and Oculus Avatars fully supported.", "short_description": "Award winning Cloudlands: VR Minigolf has an official sequel that's bigger and better than ever.  Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
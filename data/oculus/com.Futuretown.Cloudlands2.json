.oculuscdn.com/v/t64.5771-25/39031380_336476657298702_7984626640313384960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jf4EeWL2AkQ7kNvwFQdGpY&_nc_oc=AdlG1OnPd1DnHLRJg_5GtF5-n62ZS2nXWpirMBSKXHfl4J33VsBdyE3pzuDjV2psa8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuyAkEKwRFi4mFPTyUZUdfDIGdvYbC0wHeMFV0wGDcBug&oe=699AE763"}, {"file_name": "migrated_image.png", "id": "219421742757603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982502_390688614888078_7164405220988944384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vcovdwebH4Q7kNvwGctAbc&_nc_oc=AdlMTYsXS6BSydGUUQXpaf8nrZeIRGVI7eqr8kujoFZOcHOLX0D82b2A_gMBgpcAmBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsyj4acMT496QSZREOCy32Uod-LfOGwmcSUfSESnT8c0A&oe=699AE7A4"}, {"file_name": "migrated_image.png", "id": "1479492935562794", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_417503302181871_6637763800101552128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mApbNGJJAsgQ7kNvwGJwj_4&_nc_oc=AdmJ_xJeuJaA3UYzjrDKzsywfe_o-9V83B9mmSJVXtUBxEYsW3s47Lhyb99CJdIhPvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afse69Bqrwh30csq-JR0WT5h0hjvEYJJdVsXrxD52394uw&oe=699B043F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cloudlands 2", "keywords": ["golf", "minigolf", "multiplayer", "editor", "ugc"], "long_description": "Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds.\n\n- 54-hole single player campaign takes you through the Green Glades, Magic Meadows, and Reaper Ruins.  Play 18 hole mixes of full sized golf and minigolf.\n\n- Level Editor with over 1000 pieces to build and make epic mini golf or full golf holes.  Create and upload your creations to allow other people to play.\n\n- Expect to find a nearly unlimited supply of amazing user created levels.  All existing Cloudlands 1 holes are available to play (2000+).\n\n- Online Multiplayer allows up to 4 players to play together.  Create a room, have your friends join, and off you go.\n\n- Local Multiplayer pass and play allows you and your friends to play together by passing one headset between you.\n\n- In-game voice chat and Oculus Avatars fully supported.", "short_description": "Award winning Cloudlands: VR Minigolf has an official sequel that's bigger and better than ever.  Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "713058809683742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974495_845330425829253_2455996096674004992_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv5O7Akg0t0Q7kNvwHP9oaB&_nc_oc=AdlltZzgUiKKsy4xz8nTbivD2el5mvbJAyPEk6oQPstmbrXVTjwQT6kkkwoKqry6Pmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsIRB0K3KvbRs54IBPgeVTEYeFyMl
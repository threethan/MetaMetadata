.oculuscdn.com/v/t64.5771-25/39031380_336476657298702_7984626640313384960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg5yp3qs_PsQ7kNvwHswr_g&_nc_oc=Adna9g4bKLGvsoEywkBEXMwrVDta7GOzkchl8FPSlTRK3E464xBPZ0ZQH1tgj7sqGhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqraodvgDkYsREsVXLQioOtRxG7OnTmYQ6ArtgN6up7w&oe=69A02D63"}, {"file_name": "migrated_image.png", "id": "219421742757603", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982502_390688614888078_7164405220988944384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMhvmuEaPH4Q7kNvwFg3_ZM&_nc_oc=Adm2gvMzJfOzDVlNk2mHtR_tnB09W_E8dnBgZc97YxO2sCkbZzXIKDqOHPFLHtIRVqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0-CmwI_rDtKYZV9on3lp88gP0bngwIfjB0PtqrFh6NQ&oe=69A02DA4"}, {"file_name": "migrated_image.png", "id": "1479492935562794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_417503302181871_6637763800101552128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FX-jYz3erysQ7kNvwFRaDIK&_nc_oc=AdmbLgsLJUGMRC94GlVCRrivvikbekN4x2hXpZXv-b7YKq36A1adj9Pxa6xgf3acWXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshkB8bh9jJS9yIfpy5kUInKwaC6NIMTk9NaQUDPoGFoQ&oe=69A04A3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cloudlands 2", "keywords": ["golf", "minigolf", "multiplayer", "editor", "ugc"], "long_description": "Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds.\n\n- 54-hole single player campaign takes you through the Green Glades, Magic Meadows, and Reaper Ruins.  Play 18 hole mixes of full sized golf and minigolf.\n\n- Level Editor with over 1000 pieces to build and make epic mini golf or full golf holes.  Create and upload your creations to allow other people to play.\n\n- Expect to find a nearly unlimited supply of amazing user created levels.  All existing Cloudlands 1 holes are available to play (2000+).\n\n- Online Multiplayer allows up to 4 players to play together.  Create a room, have your friends join, and off you go.\n\n- Local Multiplayer pass and play allows you and your friends to play together by passing one headset between you.\n\n- In-game voice chat and Oculus Avatars fully supported.", "short_description": "Award winning Cloudlands: VR Minigolf has an official sequel that's bigger and better than ever.  Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "713058809683742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974495_845330425829253_2455996096674004992_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLhzrHMR8YsQ7kNvwHb9PaF&_nc_oc=Adlr8WmfbSuJj0yBB4DbTGYLGloe_gbgKqOaa3JXWHXV-gycod5CUFcItczN5k2Tm70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEvohUA80pp0tIAtlEa_9mrk2sBU
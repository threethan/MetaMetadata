s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWfTHr4wOkMQ7kNvwF6Xt94&_nc_oc=AdrpeZdB9qCJ0UurAtN3AX6ICiJnWwugqBGHN8g0cTAYwjbz-ezyQXemlEJl36LavCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1sX6uqGME0ZHn9BQ3QUf93r2hEpBctIGpKxSWxwXuxw&oe=6AFB27BD"}, {"file_name": "migrated_image.png", "id": "501955207115599", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031380_336476657298702_7984626640313384960_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TP7Enas6t8Q7kNvwFqlyR_&_nc_oc=Adq3iTntSXffgIMeVICKFxsDGQL-ntsx1wbvUZyo6r4KekiEXk4NWyysuj71fRE1WIU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwa3OjhmR83k5Qvol84itYD3bBdvHyFTezGOU041VgaA&oe=6AFB2023"}, {"file_name": "migrated_image.png", "id": "219421742757603", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982502_390688614888078_7164405220988944384_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlPtxLEU-lgQ7kNvwEzlzUS&_nc_oc=Ado5w26YpCCcZv6F6VPKHzyO60pVt6dwYK-vcPHB1xqeNLUV0d5S7dFhBxpyzyGWhf0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBv1C1N5pFA1SCkityATjLClarLBE2qP2ualV2HcsBwA&oe=6AFB2064"}, {"file_name": "migrated_image.png", "id": "1479492935562794", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974666_417503302181871_6637763800101552128_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14MVKGih1-sQ7kNvwGs3Yth&_nc_oc=AdqkiIy_gh13k5ZFdVDEKiQtUYM2SiYj5UgEoWXifsyq9XPsJYc3NqMeWb3ufVjr1Aw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFMfOxS1_a0K6r5i_uSp3ZPLTmZDJWeYx3mfaEBT4Mow&oe=6AFB3CFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cloudlands 2", "keywords": ["golf", "minigolf", "multiplayer", "editor", "ugc"], "long_description": "Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds.\n\n- 54-hole single player campaign takes you through the Green Glades, Magic Meadows, and Reaper Ruins.  Play 18 hole mixes of full sized golf and minigolf.\n\n- Level Editor with over 1000 pieces to build and make epic mini golf or full golf holes.  Create and upload your creations to allow other people to play.\n\n- Expect to find a nearly unlimited supply of amazing user created levels.  All existing Cloudlands 1 holes are available to play (2000+).\n\n- Online Multiplayer allows up to 4 players to play together.  Create a room, have your friends join, and off you go.\n\n- Local Multiplayer pass and play allows you and your friends to play together by passing one headset between you.\n\n- In-game voice chat and Oculus Avatars fully supported.", "short_description": "Award winning Cloudlands: VR Minigolf has an official sequel that's bigger and better than ever.  Cloudlands 2 builds off of the fun of playing and building minigolf courses and adds the ability to play full sized golf courses.  Arm yourself with a putter, wedge, and driver and hit the links in the clouds."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
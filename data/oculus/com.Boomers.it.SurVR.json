-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC_mL7JHgFoQ7kNvwFOCUhU&_nc_oc=Adns3Xz0WnA0Iby7otjTQE6STqNHfD-1tXFdj_6n60ZpeS9_BCTpfDlQSSMaIJrazhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxk44ubA6Ftk8IdVXXeml-pgGnpKUjQqqoTadTh2OcUpg&oe=69B3EF6A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCatMWXl1PkQ7kNvwG8h8Py&_nc_oc=AdnpdhQVqBHmDjWrSTXqoOvzZoV_3zL43fukimowxFCZS6fwR936zQN-7l56a8v8a1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOnIHb9EJQ2t8w19SVouRJ-esNYchA8jPYyxsEVVxV0w&oe=69B42224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GJBb1by00QQ7kNvwFCVrC0&_nc_oc=Adnx8y7tgJi1EI9bYroFjKE1byLda0GqpOyFQLa-4HtN1p-Zdbq5392II7ueFZI6oEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxgkqE5DdWXrx3rf_Dt9xU2NGtp47CJ_u0tfp01TjPDA&oe=69B3F5D0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
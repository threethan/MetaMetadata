g", "id": "620189139060292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_620189142393625_9078006542582104755_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5ZqcLahc2kQ7kNvwHbbunr&_nc_oc=Adk5Q0wG6q4cNyKuEiCZFJiG9SyRppF3ycHPw2gSsgW75KbGeY15gEEADsCoRaTWplE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvU7NNfh5R_a6RLPLbHCte-uGbq3byXO5ACfWueWj5Cgw&oe=69A6EB5A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.24.05.15.png", "id": "218391997115625", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPQKisX6Iq4Q7kNvwGDXrM3&_nc_oc=AdkNMsP4pTIZh5B-8JSyQCDeTPCKMczcNNfE0d7p_vvCr0nemYD4eIS6Yo3GWMXRurw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4sni-puydY7Lke4rRYImt02xe_W0zyEU5yQ2zVeumjw&oe=69A6C06A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAuiQEfeWdAQ7kNvwEz2MKa&_nc_oc=AdldaMOQmOTaKb6RkEzgHwbjLP73kXr7951seTsgDXfgAoAzAd2Jzffa_6YgZEc61E0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPXasbuaSkWuPr0KtXyRDdHxDjh-YkIXDAhvndIk4mKQ&oe=69A6BAE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDv4anBPTBoQ7kNvwH8Q2Vu&_nc_oc=Admkp88lMRXJSogqz8zJ-IOjRFh5OtqUm10QR7g9m0OvqtGpwNnHVaw7ma2d1-h3puE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-1XCSd2xpX0r28X989Kjn0VEj1zQKjnleS_q2KZjDug&oe=69A6C6D0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "Virtual reality sandbox survival game allowing player to feel like a real man; cut a tree, build a house!\n\nUse multiple tools like: axe, pickaxe, hammers, saw. Defeat forces of nature (trees or stones) and claim a place in this world for yourself."}]}, "developer_name": "Boomers.IT", "developer_privacy_policy_url": "https://boomersitgame.com/survprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "BoomersIT", "support_website_url": null, "website_url": "https://boomersitgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7173976929353511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_339781210929969_9195525805319787546_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLqewDpVViYQ7kNvwEehh9B&_
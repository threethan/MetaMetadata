-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvDngSndioQ7kNvwGI6fPg&_nc_oc=AdkpLJ3BeNRW6S1RE38r1DSa3qa6LPIILyWTB_QXiTBI98Pd-NdNjc30qvXNYECbN5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPpb26Z7DY1ro-bM0N3rh3Bdv_PiObHMhfgxAI4Pgq6w&oe=69AD57EA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jj693tIY4Q7kNvwHrn0MO&_nc_oc=AdlrwANhDLOlHX0Db5_T12iB4w9xfxresej5HhkADf_qS36uEMavPnN5ukQIy6ZWCKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRaNamDZUemGRdicpJXLgodXE-dunwVSrNffYGh2iWnw&oe=69AD5264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fprLvcDz6wQ7kNvwFcPo6g&_nc_oc=Adn6HAbOncldp_bq8yhFptGAHYpfSasY-3FLeOAjRN9mbJAPJOls-DysqtnbIDWTnWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSxQo4nCkl5gw0eRooDjmdg2oNpEIb7lNSJYMR7V7pNg&oe=69AD5E50"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
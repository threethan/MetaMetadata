-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUE97UIxSTQQ7kNvwHUm4pM&_nc_oc=Admh0DV2dpzgIup5nZzvh7KdQPW4pIOh2c70qYEsim0cmN9jJ14vZw1jtlBeG6bUk1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8Z8cgnN_gbKUg_UrSPHUZIQtOSuBwpIx-4N01Pp92bg&oe=69BFCCEA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5z_tGjYy6TcQ7kNvwGzScem&_nc_oc=AdnvSXI1fXiQOz2ubN2igASoGMM1_TB6nDAIwFgmcQIBb0z3J3qVwUBtn7QYMYuyBO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyt9LMlr5b0Lt1i90DcQu9epCy_YKNgWqksmbHFWF_aRA&oe=69BFFFA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpYFlDnvdQMQ7kNvwHveR8P&_nc_oc=AdnErgQP8E2AhmC06kg96BIfPVTXDX9T0d2I8FI9vL1WCw5_brq2LOkT-9U_JjRZ5ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxzOaBthA7fjJjoxOVaMe4Pd4fqJRuhWus0Rdm-wn5ww&oe=69BFD350"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
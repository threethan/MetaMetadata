-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhdEN4dsqhgQ7kNvwExsNnZ&_nc_oc=AdnBgOI7SQoEz2_H6MQxJTh-U_tiQ1lOt8eL3JbuJOzyldlb9ykwHQa_Z9ceDhI3hEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq_m1Im3Ue8Xi8QqaWhBri5aEbT0REHvi-null-rTxVA&oe=69BE7B6A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwDPi7VenE8Q7kNvwE1jP1X&_nc_oc=AdnchTdc9zOyRgGz4H5FWEuiwPliny6npTNEbSBZL7y-xphjvbrPT2htxKmaan7wR8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLZiu_sO5UsaP0ax0eQ-0vxtZ554Q1Yn0ty4wfnHQbaw&oe=69BE75E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpYFlDnvdQMQ7kNvwFaz_tb&_nc_oc=AdkVzPpVrGTm272GmFF1pEWsFTUsyLR9fWkw3m1zftBcFZRnUsLTfKYoV9eT3jT8K-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpXQ_nXG6ouizEZqfsC8DH2pApnOPpqp5086jriQRPFA&oe=69BE81D0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b41GfU4bYTgQ7kNvwG-ylyP&_nc_oc=AdnMrWmVKurkgqQ1iAmpDRo0RaK73U0OuwgEeY97LUkw_XQXa2Q3qKK5AI0r-GCNmQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfynqUSRpt2jT-rRc--eTVM-O-cGYnSJttoNy55SMpGWdg&oe=69BA86EA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aSRKGJJugkQ7kNvwEAdwzm&_nc_oc=Adl0DKKHghc9l2Mj7Hqtp_9pjJ_-avYVfD9gWnKFoSGg4M7OylHbmHcjxQJfogyYb5M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwu2SbiQy7dJrH1tWcMS3bbpEwP31_hzPDtxFEZC8iy9A&oe=69BA8164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq9W-2uOa-oQ7kNvwG9JRiU&_nc_oc=AdkluRskcL9wcYyjo21Ui0nYQMLmk3noiwWd1trVCvvRy7CFKVf2hNhpLW-c8BW1FuA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC2GrOcS2Qk8hz_ddabbJxXznG_rRy7iLz5jG6Xg65IQ&oe=69BA8D50"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
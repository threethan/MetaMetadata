-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvDngSndioQ7kNvwEqyprh&_nc_oc=Admdsq9wVfHMx7cRHDEJWoFSlAvhxL0zLSqzSf1J4sQa-WigzsY4uFoZBVVuClmckKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3qlDTy46PN3qAmdU7Ks1uCxVuA4B7St9ToT2P0bsdnQ&oe=69AC066A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jj693tIY4Q7kNvwFqgx9Z&_nc_oc=AdkP0rMBME_Ka8Zoetfuv7X2SNpd-s05NoHRExSaW8SMaEA28qtlSf6Be37EwxtdefM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxw7YsD8ShWy00B3afqVs6AXY50DiYEGUsLeRU6zXeo9g&oe=69AC00E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pRBDNwNSaEQ7kNvwHI0CbX&_nc_oc=AdnFIBYBbJfC4m-zUe-7pRqa69jWkEby1maJQlryDS_BnsCvTR3i0Q0FVWEU2tdmzUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbAEZLtmxSxwjo9EkMPm_wu1CX6Tqo4O6puk8QomOtbA&oe=69AC0CD0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHf2M44DrEsQ7kNvwEv2Mz8&_nc_oc=AdmA1CQ3rc7wIGKTdxDAyAn_jCdwvkNNtkf-_w0BVk-YPVKtcPBqOS1koc50kg_ZJso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLa9EiCGkZdl81Hzy-rshzbugPDdji6kVRSAps1fIMiA&oe=69B14C6A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWazEo1QDOIQ7kNvwFWgmEc&_nc_oc=AdmMBEHQXXJm27fqS4ePgQtni4x6Ov_H5DtPHdif1_Qs0cwCnrYT0yatLLvC2BoBy7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJtOSfkUOULs4iguEVlm8joJZjaI0FN6chxRTB3dC5cA&oe=69B146E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GJBb1by00QQ7kNvwGBDP2w&_nc_oc=Admut4ZBRgAOP-zD-NHNYrusK-M-uu2lhBPQGFobGQ72wCh_mca1N4NkSYtkqWm5g94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM3VKlgo5K3foC3RNni5MwJAot5j-kILYw6ijmqTcDCw&oe=69B152D0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
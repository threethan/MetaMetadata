yTqwbiWB7qr7j0a9b0YjghVlWA&oe=69F73EA2"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.03.12.png", "id": "620189139060292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_620189142393625_9078006542582104755_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8ijrp8UkDcQ7kNvwFWoC73&_nc_oc=AdqesnwbXfT7f7ffihIvWw0pa-emBecveBW5Oirhh92UGFWs3_WVT9WulE4eM4SpGAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39HZdrkrDKGPqjZkZtlUg_8H6heMqlmXEMJBop5MCsMw&oe=69F756DA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.24.05.15.png", "id": "218391997115625", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OPL-PoR3esQ7kNvwG0W2_C&_nc_oc=Adrf2ZfjUdnUE3P2w3xNBROVA3qj-lI-2CJTKZ7NGsoMMdE1UvOiK2OVatY-ORt5Pe4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1S_-AnPlCGgpJrx1PvfgksS43Rq7JH3W8sJFVISgsWgw&oe=69F7642A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meWn9AoF2MMQ7kNvwEaaEjY&_nc_oc=Adp1yruTIOYvhqjadS4jv3Y3QUXHxytcB8a0RIo1SyEDXrxD5pAFzAxIXUwbhGk7FnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FvqUStIzPaEPNseXHrbTRt3J5cW6ZYsLSdkRdnVFPQA&oe=69F75EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cHdHssdIBoQ7kNvwHqgxRi&_nc_oc=AdrUQVMm6MUVUBlG9zAxZO04Q2Agk-uoMPzVe_5GHiWwgTkDjur9AEKlDs_2Sgr4-ak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19KsVZeUsO2_H2TFycN62e_XgquMTE3F8YEalgYzprdA&oe=69F76A90"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "Virtual reality sandbox survival game allowing player to feel like a real man; cut a tree, build a house!\n\nUse multiple tools like: axe, pickaxe, hammers, saw. Defeat forces of nature (trees or stones) and claim a place in this world for yourself."}]}, "developer_name": "Boomers.IT", "developer_privacy_policy_url": "https://boomersitgame.com/survprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "BoomersIT", "support_website_url": null, "website_url": "https://boomersitgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7173976929353511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscd
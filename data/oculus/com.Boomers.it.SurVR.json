-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhdEN4dsqhgQ7kNvwHK_M3y&_nc_oc=AdnUTpdzWPGla07PTKv72r02kr41JAmmVA2LT_W3pW4-jtpbpG4ED5CYB1Tzj3-qvLU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5ICGOkOnVKqQZTcEmRIVor_wxsozQ_zVDC7duCuAQmA&oe=69BD29EA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwDPi7VenE8Q7kNvwGb1bf9&_nc_oc=AdkHLF2a09OGsBZgjg92nMSzMlN1geUnYHGFmnduUTa1DMNo947vdNnOZH98Lmig5SQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxvi8cEOiXvVr4gMEzcMfw2WOvdGPeltH7gW8aRxtiCdQ&oe=69BD5CA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpYFlDnvdQMQ7kNvwHa2w28&_nc_oc=AdnUJicWkDLFfGwqrWhihyKPo2_sJ0Rfy-4aNlCTZxY-0a0IaXNF6A-ED_Elnnd5c4M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOwEe3NTEOIE-Soxg4_MUALLfZo5sPHZOE8k_g9dSiyg&oe=69BD3050"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
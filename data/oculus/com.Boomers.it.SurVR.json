-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC_mL7JHgFoQ7kNvwEOICHM&_nc_oc=AdmjPGmJTulbjC_T-GJztox48rQmEXagmkBA8adFW1wgD9NHGPuCBXQlsO4vPEWxuoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtZrLlPEpZlZptUkBC7OXSe2jdvu1Jv5Mb1zMlJMFd7w&oe=69B540EA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCatMWXl1PkQ7kNvwHoLb9R&_nc_oc=AdlvOrQf0MbZeBf251jMu8VlCCJzZzYWlqChNbrqcvGTZBZF22zmSkLOYYcjhXkkJuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOarBT9fM5SfWfcBiIKSDH1E6yNjlCAryYXz9uAkgDmQ&oe=69B53B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR4G86Q7_R0Q7kNvwEetT09&_nc_oc=AdlSxVwTs06ONxF1IPPTQyRtzsOHJfjD13LBUZQfqZtclunuuvWRd1_mDNioqEXOlpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw262QtyIF9mDMob08e_aiO8n5YyWh1oIb3THxZEOhOTw&oe=69B54750"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
22"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.03.12.png", "id": "620189139060292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_620189142393625_9078006542582104755_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8VwgF7pUbgQ7kNvwFN5m-H&_nc_oc=AdkWx5stt9-6oAwJnEtxcZ75BovZ2kz62u0lb-tswGg9a6uHZ9h0deQgQQDxqSgOFB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRsnY3pHDRdkRjSwvZgYdizYAbjrkmekzM8CjOEzsIGQ&oe=69AC315A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.24.05.15.png", "id": "218391997115625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvDngSndioQ7kNvwEqyprh&_nc_oc=Admdsq9wVfHMx7cRHDEJWoFSlAvhxL0zLSqzSf1J4sQa-WigzsY4uFoZBVVuClmckKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3qlDTy46PN3qAmdU7Ks1uCxVuA4B7St9ToT2P0bsdnQ&oe=69AC066A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jj693tIY4Q7kNvwFqgx9Z&_nc_oc=AdkP0rMBME_Ka8Zoetfuv7X2SNpd-s05NoHRExSaW8SMaEA28qtlSf6Be37EwxtdefM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxw7YsD8ShWy00B3afqVs6AXY50DiYEGUsLeRU6zXeo9g&oe=69AC00E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pRBDNwNSaEQ7kNvwHI0CbX&_nc_oc=AdnFIBYBbJfC4m-zUe-7pRqa69jWkEby1maJQlryDS_BnsCvTR3i0Q0FVWEU2tdmzUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbAEZLtmxSxwjo9EkMPm_wu1CX6Tqo4O6puk8QomOtbA&oe=69AC0CD0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "Virtual reality sandbox survival game allowing player to feel like a real man; cut a tree, build a house!\n\nUse multiple tools like: axe, pickaxe, hammers, saw. Defeat forces of nature (trees or stones) and claim a place in this world for yourself."}]}, "developer_name": "Boomers.IT", "developer_privacy_policy_url": "https://boomersitgame.com/survprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "BoomersIT", "support_website_url": null, "website_url": "https://boomersitgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7173976929353511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974680_339781210929969_9195525
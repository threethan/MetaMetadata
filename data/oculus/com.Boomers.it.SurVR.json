-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnzH6se2EZMQ7kNvwELctMj&_nc_oc=AdmPkwhX54yP1cV4nomOrYaa9zdpoi-OsTBtVkcb6yyZb_iowioSfziF2BhrKyEn-eI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvrsxNSGGsECOxk_oeE_bdxxEYlNQkcsyiVXgW1JOSNNg&oe=69A9636A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-tlmzn2MhQQ7kNvwGfqXhp&_nc_oc=Adnhksm7xFga7wUYNhU7VcS0l24ziw13_9Kc2sPt6HvFKM5CnI1T0bXA55fFiVJTCpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft4ct3NZZ7Ae6HgytvqaFEJhPauRS65ksbE95X1pwboHg&oe=69A99624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pRBDNwNSaEQ7kNvwGoE_rq&_nc_oc=AdmeMRx4oTAsvbqudaWG4K0tIAzFKCARlTdZ3w4HLjQyrJdmV1P67MI_6N3hWQc6ZHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfufGiMQ-lSrW7fJI-JykeRKBksMaq8_dKkDb5TgfwScFA&oe=69A969D0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
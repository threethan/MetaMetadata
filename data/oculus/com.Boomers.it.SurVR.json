-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvDngSndioQ7kNvwGq2gMO&_nc_oc=AdmQP2-AYwpQnPD-HuOrcYrYRy-6ZexaAeahmHp55bMOooZASgqaN2ejvwo9SalgsdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyL98unBUGxy2boYZV8TiFeYbV5n1bUvIIgEeVdhCEiGQ&oe=69AEA96A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jj693tIY4Q7kNvwH7g6zO&_nc_oc=AdmwZ4OSroBW4m1mFOlAa-I5pFoToB0OvG6rt9FZxMDutYLx9AybbEHhdUEYYGaKj3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFF3lib_TOowKOLNJTE34n6V0eAFIfIxgO0Jl2FCSDaw&oe=69AEA3E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fprLvcDz6wQ7kNvwF4GYkL&_nc_oc=Adn4OoE8QUQL0aFRrHlBHAvlhGlhAyTWVGZ_4l-Hb1PO1mBFm-j1UKlc14v0aSuW1fM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWujAM8wZMJP5zhyT_P_WDaEBj3-_dh6_SbndhD0wpdA&oe=69AEAFD0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
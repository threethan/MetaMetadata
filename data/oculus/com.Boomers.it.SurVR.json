-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC_mL7JHgFoQ7kNvwGj7ni6&_nc_oc=AdkBzw8p5H-XW6VU1UxRODZK-wmSPqNrL2cWImpYlQcviviVyLv3NPbcO03AEUIAmAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8NXQGNgAzUQ4la5saNDgxZDQBtyjV70iRu7uJf7fTEg&oe=69B6926A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCatMWXl1PkQ7kNvwG_Y2bO&_nc_oc=Adl4FjBsKMFqY_Li7GgJBVdrxA8ZiZy14fo8NxwFFRvNBrSTIxIjn64f4JewBQbJKgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqEqViBQlBK3cLDSio__fVzCYMh3C9QCvg1W0_gUxyYQ&oe=69B68CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR4G86Q7_R0Q7kNvwHzGN7t&_nc_oc=Adldoc8CxUSu2TIHdeG3KGHuishqc8Aroff7ifamoP2w3qNjEAJVCqpRILdiq8FxRf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUhJRfOd504LumFfvep7DZn3Z4iEzO1THl9I1n7ZuoMg&oe=69B698D0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnzH6se2EZMQ7kNvwEHMZHQ&_nc_oc=AdlQZIbRnIm_O_gfkq8NtqV82NyWrqdTYKb9cDsPw2sZr2r9HigUxTYx5Dgp_ECTIzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuOAgpOqOV1J7dqczH5KUqJrxNngE7AwJ4N2ULZ_cjXwQ&oe=69A811EA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-tlmzn2MhQQ7kNvwFhYbrA&_nc_oc=Adlc7JtpOlubsUIm5mCyPgnZ-NFgNX8LEBRPrIzlMOShZtTIls4plG1wpNMpcb0yiEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft37aAAkrrsrlVfrvhbp_BZb3lGQKQdKdPQZBGkBIjEqw&oe=69A80C64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDv4anBPTBoQ7kNvwGu7J_u&_nc_oc=AdkiXuQnvKKJQtGFcJ6L9HQqjBm20EKasyVBW7ctV5-cEJVY6SLgpMiqwxOTJnHm0D4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfueQ_elVka3odlOY0V8COuqaTfS17LIlFxL1tcOBx8C0Q&oe=69A81850"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
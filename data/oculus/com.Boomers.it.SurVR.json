-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhdEN4dsqhgQ7kNvwFUVq8A&_nc_oc=AdkEqC9MwjKdDerfbd3TIySlCJxxDeBdluGFTLlEzc9jJqUcfQFAY2JRh-3P7O919dU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4KjpERtnmvHXu9ASm_pyE1g9GcrBxA-yzzdEV-88qkA&oe=69BBD86A"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwDPi7VenE8Q7kNvwG98T_I&_nc_oc=Adkq8K3uzIrBPWblGNB3tlkydXJOSP4rJf_hyjwPxq9vg-ZCW0ellZEJW-tgMtqAceA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzao-Ok3KLYXOXXyDV8tI_96bieN8l4ano2spHIjll_7Q&oe=69BC0B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq9W-2uOa-oQ7kNvwEXn4p0&_nc_oc=AdnhTmvGJljuwMdNuejlsfkr8k8Z5DRK4VrXkAAXkj0pxT0UlYNmmXvr8bJKim52tPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJnPXaAfLt45VM12oOGh2woi_CLHnrt_hFkhx4EuiMsQ&oe=69BBDED0"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "
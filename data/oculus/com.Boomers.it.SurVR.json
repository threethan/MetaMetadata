A2"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.03.12.png", "id": "620189139060292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974472_620189142393625_9078006542582104755_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8VwgF7pUbgQ7kNvwF7nsZg&_nc_oc=AdlGfwx3ChhHX5lkvqtYrmeMLyuj3gpmznHZ6MPk3HLR6R1tdiK-uhQfBKD6wHSCiQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwanEEYElNhYlpSJ-_PTrojtfyFzONdbfS0E22D2p6ViQ&oe=69AD82DA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.24.05.15.png", "id": "218391997115625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_218392000448958_5221308147305671414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJvDngSndioQ7kNvwGI6fPg&_nc_oc=AdkpLJ3BeNRW6S1RE38r1DSa3qa6LPIILyWTB_QXiTBI98Pd-NdNjc30qvXNYECbN5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPpb26Z7DY1ro-bM0N3rh3Bdv_PiObHMhfgxAI4Pgq6w&oe=69AD57EA"}, {"file_name": "Survr Pc 0.1 Screenshot 2021.12.01 - 21.22.14.75.png", "id": "2228715863949843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_2228715867283176_7116284285201151182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6jj693tIY4Q7kNvwHrn0MO&_nc_oc=AdlrwANhDLOlHX0Db5_T12iB4w9xfxresej5HhkADf_qS36uEMavPnN5ukQIy6ZWCKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRaNamDZUemGRdicpJXLgodXE-dunwVSrNffYGh2iWnw&oe=69AD5264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Survival Vr Pc 0.7 Screenshot 2021.12.01 - 22.08.39.59.png", "id": "241985528008902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57574723_241985531342235_4127773330918326324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fprLvcDz6wQ7kNvwFcPo6g&_nc_oc=Adn6HAbOncldp_bq8yhFptGAHYpfSasY-3FLeOAjRN9mbJAPJOls-DysqtnbIDWTnWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSxQo4nCkl5gw0eRooDjmdg2oNpEIb7lNSJYMR7V7pNg&oe=69AD5E50"}, "display_name": "SurVR", "keywords": [], "long_description": "SurVR is an open world single player game which allow player to get resources by using multiple tools.  After collecting enough of them you can build your own house! Get feeling of real honest hard work.\n\nKey features:\n- Detailed tutorial that gonna help you enter to the SurVR world\n- Intuitive building system dedicated for VR game\n- innovative UI for player backpack\n- gathering resources by own hands\n\nFuture development plan:\n- adding more maps with different enviroments\n- crafting system\n- extending building system\n- player vs monster AI\n- basic human needs :)\n- weather", "short_description": "Virtual reality sandbox survival game allowing player to feel like a real man; cut a tree, build a house!\n\nUse multiple tools like: axe, pickaxe, hammers, saw. Defeat forces of nature (trees or stones) and claim a place in this world for yourself."}]}, "developer_name": "Boomers.IT", "developer_privacy_policy_url": "https://boomersitgame.com/survprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "BoomersIT", "support_website_url": null, "website_url": "https://boomersitgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7173976929353511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_339781210929969_9195525
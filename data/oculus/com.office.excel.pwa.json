iler_thumbnail": null, "display_name": "Microsoft Excel", "keywords": [], "long_description": "Microsoft Excel lets you easily create, view, edit, and share your spreadsheets. With Excel, the most powerful tools are right at your fingertips. Whether it be data analysis, accounting, or auditing, Excel allows you to work confidently with anyone, anywhere. \n\nReview spreadsheets and run analyses on the go,and customize them the way you want with robust formatting options and other amazing features. \n", "short_description": "Microsoft Excel lets you easily create, view, edit, and share your spreadsheets. With Excel, the most powerful tools are right at your fingertips. Whether it be data analysis, accounting, or auditing, Excel allows you to work confidently with anyone, anywhere. \n\nReview spreadsheets and run analyses on the go,and customize them the way you want with robust formatting options and other amazing features. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.microsoft.com/en-us/privacystatement", "developer_terms_of_service_url": "https://www.microsoft.com/en-us/servicesagreement", "publisher_name": "Microsoft", "support_website_url": "https://www.microsoft.com/en-us/microsoft-365/excel", "website_url": "https://www.office.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6420559008048926"}, "review_messages": []}]}
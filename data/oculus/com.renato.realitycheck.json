RYw_AqoyCikMZ3hhffEWjohopdwH8Zg&oe=6A281390"}, {"file_name": "2. Screenshot.png", "id": "1213676607337273", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507828589_1213676610670606_6385541150923808583_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEiLlLDMTjQQ7kNvwF_CTUq&_nc_oc=Adrp_ZrrfxmfTZSTuzpZ-aDwGaAmidPSl2fkeQaU6DNW-pg8FI0VUxqoNaBaFewC6Ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tlDU5JSZcELmcl011HBJC8Ck32SvuC9C-9jPZrHsCLQ&oe=6A281A65"}, {"file_name": "3. Screenshot.png", "id": "1678536143340900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1678536146674233_8209906897973240076_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btlKO9ijn-EQ7kNvwHBRcsO&_nc_oc=AdpkrNByjrSPQMqH9CCoDpud1GNmgrLQJVwQnMfdE1pLWlezyEQiHjHeesdL7eGrc3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0MuI_BASJAoZcZZwoTPQ4uobPohaXUD9XR0nmPU7AgQ&oe=6A281FE6"}, {"file_name": "4. Screenshot.png", "id": "2021522172053747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_2021522175387080_4080542241750503736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-vU4x_BgOMQ7kNvwGR-X7w&_nc_oc=AdrAsH60GmmdM-91rUYKgB7GhmQdrWiOQaf-O9pf3e-We3tCoH0zxP3tFxKTJZj5Qys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gUYBhEWvsfnBCILkmOPyh4smqRMt86gCF662zSCv5tw&oe=6A280631"}, {"file_name": "5. Screenshot.png", "id": "2272516459956713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_2272516463290046_3957965321713406092_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxLfRaNASDYQ7kNvwGYXk2P&_nc_oc=AdqcgYMfjtfbic4DlHYy_N65zGo4KVy7mNhK47-J0-HTGZ3sIoogeGwOyHj3tcII0P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EJbItEtPTNXADmohzyR-S36zZP6C-u1LhC507_tAtYw&oe=6A2816BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "1013746081218949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823279_1013746084552282_7525877004462317975_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy_KxYx_DVUQ7kNvwF-wl12&_nc_oc=AdrTa6huRKSE2IVvuGZYV5gUZEhtYVIhcKD20rYz4DVQAZMP-WMBvgZFnixD3FL6LlY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fplmu9CVKvje7YmHK3sZD_IcNUDe8xZQGy0n3OaU1OA&oe=6A283396"}, "display_name": "RealityCheck-Timer", "keywords": [], "long_description": "RealityCheck is a powerful and easy-to-use VR timer, interval timer, countdown timer, and stopwatch for focused work, training, and workouts \u2013 especially in immersive environments like virtual reality.\n\nIn VR, it is easy to lose track of time. RealityCheck works as your reliable clock, timer, and stopwatch, helping you stay in control of your sessions and reminding you exactly when it matters.\n\nRealityCheck includes a 7-day free trial. If you like the app, you can unlock the full version afterwards with a one-time in-app purchase.\n\nCreate custom intervals, use a flexible countdown, or run a precise stopwatch to structure your routines and stay in the flow without distractions. With saved plans, you can quickly access and reuse your training sessions anytime.\n\nWhether you are doing table tennis training, workouts, focus sessions, or productivity tasks in VR \u2013 RealityCheck is your all-in-one training timer and focus timer to stay consistent and efficient.\n\nFeatures:\n\u2022 Fully customizable interval timer\n\u2022 Adjustable countdown timer\n\u2022 Integrated stopwatch with optional tracking in statistics\n\u2022 Save and load training and time plans\n\u2022 Backup and restore for plans and statistics\n\u2022 Battery-aware notifications with precise alerts\n\u2022 Advanced statistics: weekly, monthly, and yearly overview\n\u2022 Multiple selectable alarm sounds\n\u2022 Clean dark mode design\n\u2022 Simple and intuitive interface\n\nTake control of your time with a powerful VR timer, stopwatch, and countdown tool \u2013 with RealityCheck.", "short_description": "Stay focused. Train smarter.\nRealityCheck is your VR timer, interval timer, countdown, and stopwatch for focused sessions in virtual reality. Create custom intervals, track time precisely, and stay in control of your training, workouts, or productivity flow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://renatolueth-ux.github.io/realitycheck-privacy", "developer_terms_of_service_url": null, "publisher_name": "Renato L\u00fcth", "support_website_url": null, "website_url": "https://renatolueth-ux.github.io/realitycheck-privacy/main.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_CA", "fr_BE", "de", "de_CH", "pt_BR", "pt", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "ru", "ru_UA"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27052338484408201"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_1598621617878563_6709002380498684624_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlP6rVE2uUMQ7kNvwF6hvJc&_nc_oc=AdpDdn7cpMHR_KjHqA78WFiel4OXbWl_oVAyKiHdvYTYE8q2StSi6KOyf2gcE8zIkV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hzADxNgDMxapdnKZLi9ZgCbUFWp9meo00eaBooux1eQ&oe=6A280C40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reali
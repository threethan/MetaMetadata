G8GR4lNIOIWw&oe=6A280E7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "1313857230620100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_1313857233953433_2822584547665312102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9YaCGnTkTwQ7kNvwFft_9X&_nc_oc=Ado7C0t6h7fL7mOH_j9N30dAspJgxtmbtdD6d8sx8TbOLZzRDrwmvmz7N-UA6i_0Zxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98bl8JDPPLpw3-dxZLwM_dUZtBGtb_1Fb-EMrLJVKqHQ&oe=6A28348A"}, "display_name": "RealityCheck", "keywords": [], "long_description": "RealityCheck ist ein leistungsstarker und einfach zu bedienender Intervall-Timer f\u00fcr fokussiertes Arbeiten, Training und Workouts \u2013 besonders in immersiven Umgebungen wie VR.\n\nIn VR verliert man schnell das Gef\u00fchl f\u00fcr Zeit \u2013 RealityCheck hilft dir, deine Sessions bewusst zu steuern und genau dann erinnert zu werden, wenn es darauf ankommt.\n\nErstelle individuelle Intervalle oder nutze flexible Countdown-Timer, strukturiere deine Abl\u00e4ufe und bleib ohne Ablenkung im Flow. Mit gespeicherten Pl\u00e4nen kannst du deine Routinen jederzeit wieder abrufen und effizient umsetzen.\n\nEgal ob Training mit Ballmaschine, Arbeiten in VR oder strukturierte Fokus-Sessions \u2013 RealityCheck unterst\u00fctzt dich dabei, konstant und produktiv zu bleiben.\n\nFunktionen:\n\u2022 Individuell konfigurierbare Intervalle\n\u2022 Einstellbarer Countdown-Timer\n\u2022 Speichern und Laden von Trainings- und Zeitpl\u00e4nen\n\u2022 5 ausw\u00e4hlbare Alarmt\u00f6ne\n\u2022 Pr\u00e4zise Alarme und Benachrichtigungen\n\u2022 Klares Design im Dark Mode\n\u2022 Einfache und intuitive Bedienung\n\u2022 Ideal f\u00fcr Training, Workouts und Fokus-Sessions\n\n\u00dcbernimm die Kontrolle \u00fcber deine Zeit \u2013 mit RealityCheck.", "short_description": "Bleib fokussiert. Trainiere smarter.\nIn VR verliert man schnell das Gef\u00fchl f\u00fcr Zeit \u2013 RealityCheck hilft dir, deine Sessions bewusst zu steuern. Erstelle individuelle Intervalle oder nutze Countdown-Timer, bleib im Flow und behalte jederzeit die Kontrolle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://renatolueth-ux.github.io/realitycheck-privacy", "developer_terms_of_service_url": null, "publisher_name": "Renato L\u00fcth", "support_website_url": null, "website_url": "https://renatolueth-ux.github.io/realitycheck-privacy/main.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_CA", "fr_BE", "de", "de_CH", "pt_BR", "pt", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "ru", "ru_UA"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26482939164681472"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1030043976120345"}, {"status": "PUBLISHED", "id": "1230139702528819"}, {"status": "PUBLISHED", "id": "935323892702191"}, {"status": "PUBLISHED", "id": "1675909363748973"}]}, "baseline_offer": {"id": "1030043976120345"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780595940, "status": "PUBLISHED", "id": "1030043976120345"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27066404089668307", "version": "1.1.0"}, "id": "1228914619313641", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prima
44048_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNqrDVX2MMYQ7kNvwEZkdJm&_nc_oc=Adr2HLuvTPNK4wVtwpDNIIIBQDDCfGfx0QmEanLNAWynaCDrmQOB7dZtGSzZZQ0tPVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-td_zv8Sw7Ngt34Y8544qYjfGpMIPHHNXt00N_pvK2sA&oe=6A30007C"}, {"file_name": "Statistik.png", "id": "2456558168142157", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314643_2456558171475490_8551384705505159412_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gv0JSUhjYpUQ7kNvwFy3p3t&_nc_oc=Adr-y38ns4Ydw-emuETvrhtFlLVnVZ-MbzcXCR_c6Dm5glrYvfhh70jqOpHzsetKqWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s-b9CjqSsDDP6SDltN5YhlaDAvliD3K5mBybwNr_9Pg&oe=6A300892"}, {"file_name": "Settings.png", "id": "2161699204646438", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_2161699221313103_8579231663648723399_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vR58-04dvEQ7kNvwFOf0Yy&_nc_oc=AdqqfbAdgmPdv9WDYhTleWoJRRI3OCG9pLwWW6BVKGKDzwv68K1H2emFdzlZZ7mHESg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af801P3mi7CLdiYxI0s3FDOPCbj07Vh0Y2kHkqpyk2fl6w&oe=6A301C98"}, {"file_name": "Main Timer ON.png", "id": "2195619611201528", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825497_2195619614534861_7405467464106470493_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzrCj-UIIvsQ7kNvwEqJtCU&_nc_oc=AdpYblCtscMxtn8MBqPUQmJSiZiwd4mICGodi2__HMVY_ugxd6SlCjDo2oCFQwRxMzY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xc6cAYfDZUgvY9cSr21nOWwziqvCBASnRnS0bme1q7A&oe=6A3010CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "1013746081218949", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823279_1013746084552282_7525877004462317975_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRFIH_LQxigQ7kNvwHg7rXG&_nc_oc=Adq04Ef4hJhdBzpGjOMwkz9WbVB6y7K_kMKU6ODM69aEsnnLkJ1f1IG-M7jTZ0j1ST8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NCbKgzs5yC_iS4ZDOXY48jCnj0Q59PE_vxV7uh29TEA&oe=6A301C96"}, "display_name": "RealityCheck-Timer", "keywords": [], "long_description": "RealityCheck is a powerful and easy-to-use interval timer for focused work, training, and workouts \u2013 especially in immersive environments like VR.\n\nIn VR, it\u2019s easy to lose track of time \u2013 RealityCheck helps you stay in control of your sessions and reminds you exactly when it matters.\n\nCreate custom intervals or use flexible countdown timers to structure your routines and stay in the flow without distractions. With saved plans, you can quickly access and reuse your routines anytime.\n\nWhether you're training with a ball machine, working in VR, or following structured focus sessions \u2013 RealityCheck helps you stay consistent and productive.\n\nFeatures:\n\u2022 Fully customizable intervals\n\u2022 Adjustable countdown timer\n\u2022 Save and load training and time plans\n\u2022 5 selectable alarm sounds\n\u2022 Precise alarms and notifications\n\u2022 Clean dark mode design\n\u2022 Simple and intuitive interface\n\u2022 Perfect for training, workouts, and focus sessions\n\nTake control of your time \u2013 with RealityCheck.", "short_description": "Stay focused. Train smarter.\nIn VR, it\u2019s easy to lose track of time \u2013 RealityCheck helps you stay in control of your sessions. Create custom intervals or use countdown timers, stay in the flow, and keep full control at all times."}, {"images": {"nodes": [{"file_name": "VR-Brille und Wecker Icon.png", "id": "26495954450055702", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_26495954456722368_8473209000390590714_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3c3IJf0uu8Q7kNvwFWOlx0&_nc_oc=AdpTAXwIRqbpu51jQ5ES8MHRdzFBWPefHff5qplqXFKecab76U5p6SEeUl7-3Xov9lM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xk_keAzdwYL1_Fxal1w1IdWzLREDwk8KkfkXw
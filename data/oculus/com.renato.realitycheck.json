US", "screenshots": [{"file_name": "1. Screenshot.png", "id": "1291510606506977", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823351_1291510609840310_9104565905046985500_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvsG49iSuVUQ7kNvwEaqxi3&_nc_oc=Adp2ESOvqpXg8o7oJYHK8_Ut0CvIZhYBcbQ-Gbb1sAvvWrF4zEyyFXxhAUHQL5Apj2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J9V24h0FOehL3S_NXKXt1P9DvGhs9cMeudALYbSmK2A&oe=6A26C210"}, {"file_name": "2. Screenshot.png", "id": "1213676607337273", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/507828589_1213676610670606_6385541150923808583_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEiLlLDMTjQQ7kNvwH2n1UD&_nc_oc=AdoWXwlTzhzX7J7DmZD_fsY5nlTPqbf-Do1STsiO_4AS2PI63sl2pAdvqCp-8r4hvXM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vMog3ifu5cnCx7hkIDJt8I4Vk45phFf02O7OI2KQJxg&oe=6A26C8E5"}, {"file_name": "3. Screenshot.png", "id": "1678536143340900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1678536146674233_8209906897973240076_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af9aZBy6OskQ7kNvwGgBwZT&_nc_oc=AdpYuUVhDLKPhceH3BzP-M9kKKeMOB8nrm2EPzR2Ga1YUoY6dxuNWBvvwPAuW4a4QsU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3l2cK-hwIPfia0v5wiDSuAmWtiuq23XGpZ1o0JOlkng&oe=6A26CE66"}, {"file_name": "4. Screenshot.png", "id": "2021522172053747", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822307_2021522175387080_4080542241750503736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-vU4x_BgOMQ7kNvwHtJ-7P&_nc_oc=AdrMhplUsmacykvJWanAy5H8cWErNLpPo1HvwsxgDrLSR7WXDm0AYV_K59LIjSpEr-M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97g0V4OutdtbDjPkMspmsU20Mf394m3k6rOz-G58OS4A&oe=6A26ECF1"}, {"file_name": "5. Screenshot.png", "id": "2272516459956713", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_2272516463290046_3957965321713406092_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxLfRaNASDYQ7kNvwHge6Ps&_nc_oc=AdoPJq3LhL8fgR1mA6MdX54cXF6lv-ts_DDOOx8O_qRZciydhhnNbitiNHnDOxHI8QA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8to0_IcfBzlH0Ib2RbN67Q_qIgfHj0sXwwtqglRZEm2w&oe=6A26C53B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "1013746081218949", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823279_1013746084552282_7525877004462317975_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy_KxYx_DVUQ7kNvwGjz2oi&_nc_oc=AdrORNQU3NnmZKzuNN3Hxja1bIl1_4RkjGKZxOBdTV1R0Q_1f19Fle-rbn-f3eZHDNA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o-oQ268yqmccUyqFbr9TJA9tk0WR6ygFmVaJseHTDKA&oe=6A26E216"}, "display_name": "RealityCheck-Timer", "keywords": [], "long_description": "RealityCheck is a powerful and easy-to-use VR timer, interval timer, and countdown timer for focused work, training, and workouts \u2013 especially in immersive environments like virtual reality.\nIn VR, it\u2019s easy to lose track of time. RealityCheck works as your reliable clock, timer, and stopwatch, helping you stay in control of your sessions and reminding you exactly when it matters.\nCreate custom intervals, use a flexible countdown, or run a precise stopwatch to structure your routines and stay in the flow without distractions. With saved plans, you can quickly access and reuse your training sessions anytime.\nWhether you're doing table tennis training, workouts, focus sessions, or productivity tasks in VR \u2013 RealityCheck is your all-in-one training timer and focus timer to stay consistent and efficient.\nFeatures:\n\u2022 Fully customizable interval timer\n\u2022 Adjustable countdown timer\n\u2022 Integrated stopwatch (optional tracking in statistics)\n\u2022 Save and load training and time plans\n\u2022 Battery-aware notifications with precise alerts\n\u2022 Advanced statistics: weekly, monthly, and yearly overview\n\u2022 Multiple selectable alarm sounds\n\u2022 Clean dark mode design\n\u2022 Simple and intuitive interface\nTake control of your time with a powerful VR timer, stopwatch, and countdown tool \u2013 with RealityCheck.", "short_description": "Stay focused. Train smarter.\nRealityCheck is your VR timer, interval timer, countdown, and stopwatch for focused sessions in virtual reality. Create custom intervals, track time precisely, and stay in control of your training, workouts, or productivity flow."}, {"images": {"nodes": [{"file_name": "VR-Brille und Wecker Icon.png", "id": "26495954450055702", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819356_26495954456722368_8473209000390590714_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3bN3j4iL0Q7kNvwF2MC5t&_nc_oc=AdqhiK45usAp3mw2-bcqV5AOQffwYM-l5__gkJdKDryJ0FGw3dxs1O-vxXCseaIPVKg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hytCAU1NPd-FuSEc-s4ROFoL3j2OMao1m5k-iCLf6hQ&oe=6A26CEF5"}, {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "2536256110105513", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823296_2536256113438846_6415001077888340977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEYVjcxZY7cQ7kNvwGICOK3&_nc_oc=AdqDXlvNw7CG5wl6mYTZhSQPE4q8Swy0FIlEPlpnzrhX1G6doKaNnOrxfQQq_qcSA6Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8icswD5SRkPD1KrPGFdr1aRUPruK_kwa1ei0AqYXGmHg&oe=6A26D3F6"}, {"file_name": "Main Quadrat.png", "id": "1601814411118822", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821702_1601814414452155_6552940619684931899_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHxS4SBBASkQ7kNvwGAijmg&_nc_oc=AdoGb2YwIBcGDCoM0l9DcHCYmdMo0JSdaXMlBy33H_CGXUIxI4Oig6ow4eSasZKCaqc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QdvoxYUTQ0tGdnUpn9UBi7W5gzWmnzrzlH1BasvCCKA&oe=6A26E69C"}, {"file_name": "Main Hochformat.png", "
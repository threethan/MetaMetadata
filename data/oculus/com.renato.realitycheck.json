3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_SH8FH8B14-ymau_sMzkVizrmI0uCNFw2O1-TapEk9w&oe=6A26C15B"}, {"file_name": "RealityCheck-Timer.png", "id": "1315652437098359", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593872736_1315652440431692_2299900867231117871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVziUkVui5kQ7kNvwH99QQI&_nc_oc=AdrFNDxdoHbl-VMZdI0b6wHAhQ7utb62jlX13dpUS7Fo2hwIHfUuc57LJSh6uJWE6-8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3Cdii7YPcc7GKZdERJ02a3w5gbq7OGBwEb2TnltauVQ&oe=6A26B938"}, {"file_name": "Settings.png", "id": "1258710256432517", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_1258710259765850_6847878779442468531_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inS9QCOwBLwQ7kNvwGkAjNZ&_nc_oc=Adq1W10YWg14RlIYhXeZ_BxBsJQNtNTAJfewMCGmyZvb7TM-HBQcTe1GYsr8F0h1V8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kQplbHuIz5SS1adTT6VAAnLhMkByour2qTxb1dxL7-w&oe=6A26D5EE"}, {"file_name": "Main Timer ON.png", "id": "1865699304141916", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_1865699310808582_2051810619655707877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMJIChoYhrYQ7kNvwEHJhvd&_nc_oc=AdqTgupqzM2_0BhIPcV_Hpdt56zmnlggmgJv1yszTefq7-aPtSkbjAyzuf8WzvoUIts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OP1akVMDkRmOS5qpYSwXc52sK-J1Bt03PjYpMDTxEVQ&oe=6A26BCFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "1313857230620100", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821081_1313857233953433_2822584547665312102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9YaCGnTkTwQ7kNvwHZm7-H&_nc_oc=AdqpEEhNGrbQbh0aQgUikHnj0RGBw_lX70Gy-uoC3zyLc5gwBLGuIFprQUg20FD-pHQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F7h-oik0CBoGNYKFc_k8zqKu5N5SefF8qj3NzDAHgsg&oe=6A26E30A"}, "display_name": "RealityCheck", "keywords": [], "long_description": "RealityCheck ist ein leistungsstarker und einfach zu bedienender Intervall-Timer f\u00fcr fokussiertes Arbeiten, Training und Workouts \u2013 besonders in immersiven Umgebungen wie VR.\n\nIn VR verliert man schnell das Gef\u00fchl f\u00fcr Zeit \u2013 RealityCheck hilft dir, deine Sessions bewusst zu steuern und genau dann erinnert zu werden, wenn es darauf ankommt.\n\nErstelle individuelle Intervalle oder nutze flexible Countdown-Timer, strukturiere deine Abl\u00e4ufe und bleib ohne Ablenkung im Flow. Mit gespeicherten Pl\u00e4nen kannst du deine Routinen jederzeit wieder abrufen und effizient umsetzen.\n\nEgal ob Training mit Ballmaschine, Arbeiten in VR oder strukturierte Fokus-Sessions \u2013 RealityCheck unterst\u00fctzt dich dabei, konstant und produktiv zu bleiben.\n\nFunktionen:\n\u2022 Individuell konfigurierbare Intervalle\n\u2022 Einstellbarer Countdown-Timer\n\u2022 Speichern und Laden von Trainings- und Zeitpl\u00e4nen\n\u2022 5 ausw\u00e4hlbare Alarmt\u00f6ne\n\u2022 Pr\u00e4zise Alarme und Benachrichtigungen\n\u2022 Klares Design im Dark Mode\n\u2022 Einfache und intuitive Bedienung\n\u2022 Ideal f\u00fcr Training, Workouts und Fokus-Sessions\n\n\u00dcbernimm die Kontrolle \u00fcber deine Zeit \u2013 mit RealityCheck.", "short_description": "Bleib fokussiert. Trainiere smarter.\nIn VR verliert man schnell das Gef\u00fchl f\u00fcr Zeit \u2013 RealityCheck hilft dir, deine Sessions bewusst zu steuern. Erstelle individuelle Intervalle oder nutze Countdown-Timer, bleib im Flow und behalte jederzeit die Kontrolle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://renatolueth-ux.github.io/realitycheck-privacy", "developer_terms_of_service_url": null, "publisher_name": "Renato L\u00fcth", "support_website_url": null, "website_url": "https://renatolueth-ux.github.io/realitycheck-privacy/main.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211
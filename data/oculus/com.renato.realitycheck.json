E", "screenshots": [{"file_name": "IntervallSettings.png", "id": "1798619074448687", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825257_1798619081115353_2300089906089794964_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krA0OMQ_Xa0Q7kNvwHjC6Sp&_nc_oc=Adr5euRVLt46a4Dn_NfGvoSYJuRRy3tYhzcIYaZWrggJqx9gdSaXvxTOjYt1BBMxi-A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m-s6noFZ1drn_noDqa7IOB6ip7OsoKv3aXCRDqiwfAw&oe=6A30193E"}, {"file_name": "Statistik.png", "id": "935528572435883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_935528575769216_683213013430490455_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY3bDBb_eoMQ7kNvwGr-vAM&_nc_oc=Adqn9V6QhjK3j4GhtXlWAr_H1wFIL-ukwqPqA11rk7WCddnNChuMEV2EjRelXe0RVk4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R_Q8QDYh4U0Z_ThFwBxWhn4Sv4BiVgnBux4kE711TbQ&oe=6A2FFBDB"}, {"file_name": "RealityCheck-Timer.png", "id": "1315652437098359", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593872736_1315652440431692_2299900867231117871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIShvw502q0Q7kNvwEldjgq&_nc_oc=Adr_fcSvGrtVECnhiywDi7AGgSOzO6sjOGmuhM4J5aHxfLDiU7Vgz8kJj0aNgiinmbU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OEmPEMolHfQ6MxMSIwuibqRaz5aija2P38ThqYi9BLw&oe=6A2FF3B8"}, {"file_name": "Settings.png", "id": "1258710256432517", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821115_1258710259765850_6847878779442468531_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3r6eeOaBToQ7kNvwFoqohK&_nc_oc=AdqjT5C0TXy3HAIK7yHy3lbaE9PHqscoX5O86GqGQHQqXIH1fy_XzQppR39UuXp2Shk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cXTRdyFn4dRpIFf-AYOkZrdHGAJdmlhR-VTtTfdyAcQ&oe=6A30106E"}, {"file_name": "Main Timer ON.png", "id": "1865699304141916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824318_1865699310808582_2051810619655707877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJE30Cr_YoIQ7kNvwHEU4MV&_nc_oc=AdpLecC3RO2nSAGN-J1MgTqQm6sFZUVSVjtgdoFedvdZkjzqZDhSFqCm62AHGT7EQMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DxhF-cPbpU9OaOQSK33sr-L54mvMvBg9OaiAaJ53LKg&oe=6A2FF77A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RealityCheck-Timer1400 hoch.png", "id": "1313857230620100", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821081_1313857233953433_2822584547665312102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfjebz4KWzMQ7kNvwHjds_N&_nc_oc=AdpoidYNtbKu42jDIGFZOAJzt1MDLVh7XHMZLmjGlYp3UaFm9Fw05ogMZm14gYgh1KE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__ijCEedZASzLXfCWin3xQki7JdJgpXjS62vFZYbQ53Q&oe=6A301D8A"}, "display_name": "RealityCheck", "keywords": [], "long_description": "RealityCheck ist ein leistungsstarker und einfach zu bedienender Intervall-Timer f\u00fcr fokussiertes Arbeiten, Training und Workouts \u2013 besonders in immersiven Umgebungen wie VR.\n\nIn VR verliert man schnell das Gef\u00fchl f\u00fcr Zeit \u2013 RealityCheck hilft dir, deine Sessions bewusst zu steuern und genau dann erinnert zu werden, wenn es darauf ankommt.\n\nErstelle individuelle Intervalle oder nutze flexible Countdown-Timer, strukturiere deine Abl\u00e4ufe und bleib ohne Ablenkung im Flow. Mit gespeicherten Pl\u00e4nen kannst du deine Routinen jederzeit wieder abrufen und effizient umsetzen.\n\nEgal ob Training mit Ballmaschine, Arbeiten in VR oder strukturierte Fokus-Sessions \u2013 RealityCheck unterst\u00fctzt dich dabei, konstant und produktiv zu bleiben.\n\nFunktionen:\n\u2022 Individuell konfigurierbare Intervalle\n\u2022 Einstellbarer Countdown-Timer\n\u2022 Speichern und Laden von Trainings- und Zeitpl\u00e4nen\n\u2022 5 ausw\u00e4hlbare Alarmt\u00f6ne\n\u2022 Pr\u00e4zise Alarme und Benachrichtigungen\n\u2022 Klares Design im Dark Mode\n\u2022 Einfache und intuitive Bedienung\n\u2022 Ideal f\u00fcr Training, Workouts und Fokus-Sessions\n\n\u00dcbernimm die Kontrolle \u00fcber deine Zeit \u2013 mit RealityCheck.", "short_description": "Bleib fokussiert. Trainiere smarter.\nIn VR verliert man schnell das Gef\u00fchl f\u00fcr Zeit \u2013 RealityCheck hilft dir, deine Sessions bewusst zu steuern. Erstelle individuelle Intervalle oder nutze Countdown-Timer, bleib im Flow und behalte jederzeit die Kontrolle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://renatolueth-ux.github.io/realitycheck-privacy", "developer_terms_of_service_url": null, "publisher_name": "Renato L\u00fcth", "support_website_url": null, "website_url": "https://renatolueth-ux.github.io/realitycheck-privacy/main.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_CA", "fr_BE", "de", "de_CH", "pt_BR", "pt", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "ru", "ru_UA"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26482939164681472"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1030043976120345"}, {"status": "PUBLISHED", "id": "1230139702528819"}, {"status": "PUBLISHED", "id": "935323892702191"}, {"status": "PUBLISHED", "id": "1675909363748973"}]}, "baseline_offer": {"id": "1030043976120345"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780595940, "status": "PUBLISHED", "id": "1030043976120345"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
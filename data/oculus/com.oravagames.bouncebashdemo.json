HTfIKQQ7kNvwEZmA64&_nc_oc=AdqetsgJ7TkVIKTDJbsDWVCANUwH0diptXZNRsNfIGte2AI6uZXX2bs4um9AHg9QP54&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAr0EXjI3wt9rmTx2Upw0IBvFIpWtN8oSEOBEajnbBVg&oe=6A58EF40"}, {"file_name": "21_7_2025_6_34_2.png", "id": "1050282047298920", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824012_1050282050632253_4393995557240154902_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8RlMt2VYtwQ7kNvwEacxyV&_nc_oc=AdpiN1wQgVhcrBdthlyFJaSwzd2eP4U20i0RHzcjsYxh20RjA6M9CKfhm7AuSYux3bs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoSWKJPyoDeUQRL4eksIRd1eTEiJtN4cfbxeap9wLeMQ&oe=6A58C592"}, {"file_name": "21_7_2025_6_37_9.png", "id": "601235509379593", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831393_601235512712926_5162906179744385697_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxh9ByXdmbMQ7kNvwGc2o4s&_nc_oc=AdqNRO9BinmmHkRkK9ShCnGiIpw8f1RwcoTc-ZaQgx4dGuwdNyf4OyMhC845Zvg4glM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkktBRlCG2c0qhEeNf_FId1Y92RiT04PIU4GMyJMrZRQ&oe=6A58EFC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover Art 16_9.png", "id": "2041723346235378", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821081_2041723349568711_4931447236180004515_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LUxlJK3YRIQ7kNvwEIKz2F&_nc_oc=AdrLgENax6SMopo-f-m4BuEwdUi3EzAp6r0NS3V_2JW_FSi84z40OSv5VtY9uC9g29Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJCWgdieUyi1pBpx0TVV5XOiEWGnEh8A0uV2HP1IXO8w&oe=6A58CA41"}, "display_name": "Bounce Bash Demo", "keywords": ["bounce", "bash", "ball", "pong"], "long_description": "Step into high-speed VR action with this immersive paddle-and-ball experience inspired by the arcade classic Danger Ball from PlayStation Worlds. In this free demo version, you\u2019ll test your reflexes and precision against a single enemy AI in intense 1v1 deathmatch mode.\n\nUse your head movement or controllers to guide your paddle\u2014whichever feels more natural to you. The game is fully playable whether you're sitting or standing, indoors or outdoors. It's all about giving you the freedom to play your way.\n\nThis demo is just a glimpse into what the full version will offer. The full release will feature over 20 unique enemy types, each with their own behavior, speed, and challenge level. You'll also get to compete in a variety of futuristic arenas, each adding new twists to the gameplay.\n\nWhether you're looking for a quick reflex workout or a competitive challenge, this demo delivers fast-paced fun that\u2019s easy to pick up but hard to master. Perfect for all playstyles and environments\u2014get ready to bounce into action!\n\nAre you ready to have fun ?", "short_description": "Fast-paced VR ball duel! Control your paddle using your head or controllers in this dynamic demo inspired by Danger Ball. Face off against a single AI enemy in thrilling deathmatch mode. Play standing, seated, indoors, or outdoors\u2014no matter how or where, you're in the game.\n\nAre you ready to have fun ?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bouncebashdemo/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jakub Ivani\u010d - Orava Games", "support_website_url": null, "website_url": "https://sites.google.com/view/bouncebashdemo", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30322871664025252"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823341_625891987198224_579876512005184831_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFtcQy2w5L4Q7kNvwGISW7g&_nc_oc=AdqfG9no5ga9Rm5waOXMWEITMt8P-u8oqoE0xaGHLdWqXN8k-tHm-L57boWg1IdOU1o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE67NauFLLJRzzFEjEgucilyXU8pGL8S-w9kjCkg2G8A&oe=6A58E831"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bounce Bash Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1753157460, "lastRevision": {"nodes": [{"id": "30322871760691909", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "30322871630691922", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1480309839998614"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "HeroImage.png", "id": "1385956115820077", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307435_1385956119153410_2465908460153071516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb8rCtvmMKEQ7kNvwG3vWSD&_nc_oc=AdpXJqf5y9eoOxH90zQL5e_OvF-S0J2XsMc6RhUfig65ZJFq_lfE9H9zV5dUCOp6sP0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZSLvMi9n6lBm7q-8JNYUbUVw9ElGPvMYkdqaEOB-mLA&oe=6A58ECF7"}, {"file_name": "Icon.png", "id": "1379174473157122", "image_type": "APP_IMG_ICON", "uri": "https://scontent-f
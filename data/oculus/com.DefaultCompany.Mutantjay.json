NvwF3OirS&_nc_oc=AdkPlIj4KWgvlq45X2ta3YxiXHk_acMYQg8gBi-zNzM0mAaguspzxxR7-mGTtCRmtjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsll-HU9Xb9_cZCWkiHrDf9mLqVpdUnTVwE-R-8aM09Mw&oe=69A984E1"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JoiTzxmy_YQ7kNvwFHRmWU&_nc_oc=AdlUa8xSz4EoaRz5Ft8_2llcZM9GBD_maFebYtsPl99Omnsg1i8D34di7xtfA1-Ct1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvklGz3jSCu__aBnlQec5nQxfctHMdYtkRmLbXiSwOPEg&oe=69A971D0"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ljJZXB-Y_0Q7kNvwE7usqx&_nc_oc=AdnaWk7vjrLKZtzhZrnFU1tTnErSkXvYGIi8M70hCKANf26GTefTnwL-v2hBFVGgfZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsaaQVTZQVuJblrUk3gqZgjSR5sgJ35CWTNXnlGrpG2eg&oe=69A97769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXqBhTwrK_gQ7kNvwEiJ5gg&_nc_oc=AdmHz0yU5yEomQ0mgJuy8Qo4g-8V0I0_9quB42fhDVV1CSjA9O7957Q63M1uG7V65jo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuMD1no-3O43o2QdZr4VppGgs-_sI3EZlaYdWtbym0yZA&oe=69A96332"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554566446227012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036703_1033281904203593_6904138589226292553_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YYPhZYk_uMQ7kNvwGb14Ud&_nc_oc=AdlHjkUjcuMxUvExjXseLkW70Xtn9Hzi8danj0ou3BsSJFI7VKH4fw_TGOxKJu2moY8&_nc_zt=3&_n
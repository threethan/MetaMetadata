NvwHoT3Y8&_nc_oc=AdlHzAYJZ9G5yflXqmHUPVOF_KHbvW3msk5aHcfRuVhjCD8dQRS3yMvGddYc81gB3S8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeaFOP9iRyPeHrsYKTogtraiJBYKP-IXD0Uo8ydMdLUw&oe=69B01C61"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3nxWWp7A-gQ7kNvwH0aDb8&_nc_oc=AdnnaVyQs4OR17LuDwFA7UTLu8SY925B5ppfl3LZKmwtZtTEKJNSg2PXd4jWMmzeyto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhzsloskudLdQlB7kU0pN3uSHJGSBuXklrojJjxAIZ-Q&oe=69B00950"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgi_tm5OWwYQ7kNvwG87LW-&_nc_oc=AdkLn7SAcRGy945YE8eh9AMHr_M4CL-zPwZ9FFYhRR29Lk-cKqfs6GCwAbNiS9yXNLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-ePR-_jMHv4uDTXe4CZGXIyAv-lyc4yvjMq4FjUt_zg&oe=69B00EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDKf5Z0BbNkQ7kNvwGF_DB0&_nc_oc=AdmJKEwF37msCIuvE1ZNyxhAglD6mfL0-5ctF_pPCne1LoRxdpIh-Utt4sNkOBGG4Cs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhGYT-An7JYRapaFZa6sYVmKqnZ0o8LjyM_OTmgFOfBA&oe=69AFFAB2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554566446227012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036703_1033281904203593_6904138589226292553_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdHRwQVe0ncQ7kNvwEQq0hR&_nc_oc=AdnKma1keZlLAxNLW0Bi8nZP-8UqiIFxBGOgAT6wgZEgauVLnnwrWf1CHs8eIEKr5MY&_nc_zt=3&_n
FEEIYLfLIM9qUMhT9Hz87akK81-yjoL6M9w&oe=6B0DBB83"}, {"file_name": "Bees.png", "id": "672974790484591", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982722_672974793817924_5779375570667020409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-apatnFy-cQ7kNvwGwMFIo&_nc_oc=AdoDXZluFeY2GqKxvZI2zC6lldRmeE55FXSBMw6HGs7oZNyxOGMJb6Srf5THkQcN5Ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRr0XzzjYDREdsNwqiwifAN3D1lJMDv5heoNqFcQwq6Xw&oe=6B0DB221"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPpuuWQCU_8Q7kNvwF9H6Tq&_nc_oc=Adpb_tRhbrUeHkXKYUfJelV3_FKwbuvrHx7faCaE0rjjFBzyoFc3T8rL9cBamHkYc9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwKGOLzRWl0PnOIMzNRp9v6Pd3vbMux1Ksv3G5t0eXgQ&oe=6B0D9F10"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVVZDk-iaQEQ7kNvwEXAkHT&_nc_oc=AdoyVT7GS-EQy0-qTiQ1urm9-a-yvGXNw1XjmEfzkIu9V0f_irWAZ_BgUpD7s1-E0qI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdFRGpcGAE0WnyrCWamLAIFor4RYIfnQKIeQFkuXhOGg&oe=6B0DA4A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYdT_fMGheEQ7kNvwE86zUf&_nc_oc=Adrvq_IlzwB-llebeTi-fuECuzqRZ4nLw-D2zeefmEPe4O7NCsS0GdwmRo26zIndMW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLFFc887odYXx2-FPcqqE0B0gu4uClKY5DIQ48YSHVTw&oe=6B0DC8B2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
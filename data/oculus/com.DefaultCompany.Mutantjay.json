Pok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvOvvEpaNPxI8zQuoARvi-PCyqQV8SHsxd8PHN3KrJeMQ&oe=699EF8E1"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeZvTyT0ZB4Q7kNvwF_6TlE&_nc_oc=Adk4hROx_koJ8r9iwZZ-3c4rnOFcuvBuzcL3whWk2tselvUv-Wurl7GfwqpODksmvb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsfVGZHI-7tCMhDtl-_XBSoUqp4hk3dBh5Ehd4_EhcZTQ&oe=699EE5D0"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukvs9G9jaCsQ7kNvwEqrm0n&_nc_oc=Admkk4pe1yp1ns3UlOo9Om9yiHTEpLQZCV0aB9NiWawCGPfiQl3rbNg36-Q1-N5bhPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftoBrxUhlu9NDHJFI4-47dryp2rDn3jrylx3KwiA7qZRQ&oe=699EEB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mdl9083CPnoQ7kNvwGWhWDI&_nc_oc=AdksR_z619QpyrkN-dStk5ha5EE2JgbDp8ophIh3p_5-ksV9zVxjg7LJd0LKgmnLEw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsttlYoHWNEnvH2koNpbQ1-rwUVElhiPZoVn7wagpTpVw&oe=699ED732"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554566446227012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036703_1033281904203593_6904138589226292553_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUMLC6boOHkQ7kNvwEN9MQi&_nc_oc=Adl2imr4me82fpYJ4tqy3_syyemoSHiOzdCXtL-P9jYT_eHR-u2vf8u61L7cTDMLApU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afse3qrXh4w1eMGH3DRluck_dX9imZqL5LQzN8Xg-QJ0CA&oe=699EDE12"}, "is_concept": 
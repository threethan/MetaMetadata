-431pBR8S2su1BaDxu457dD7NN7kEjyRZXA&oe=6B048103"}, {"file_name": "Bees.png", "id": "672974790484591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982722_672974793817924_5779375570667020409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHbTXDs59TMQ7kNvwEsdWKj&_nc_oc=AdowSSWwe8ayfwpl71zi5lomsXnDwXcgCsXeFenWYEqzktbVfTznMaoJJkZwhltKQdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP3YJeGhfo20EV20BHoDhOPrB_kRbhTeiEO5ljguuOZQ&oe=6B0477A1"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR_lpXUaThcQ7kNvwG4uc3t&_nc_oc=AdrmLmCNmBf8_15KSjdlJenww6pAElXTj3dOwtcHYU6GRdpzXzdMAKWouSwW6rBBtrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTxF6aEqK1ZMbgOoYHXNgMHAyEFEKABashTOA2YVq2HQ&oe=6B046490"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B579ztFEFBEQ7kNvwFPa0mF&_nc_oc=AdopZysWtMeBX0wEjJhAXt2YlsSAuqrIZ4IfBUawKjWzD6Q7AfjGhqVTOAcqaIjWjoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnuucCtFJ_vygvnLv9akR12QpDSq3RIGOgBTRaCCaLmw&oe=6B046A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNKN4qVNZhYQ7kNvwFFDBFB&_nc_oc=AdpEpOkXF3ZBmDLlBL98GwOUfio2_B42Z_rsnL-snPeGHm29DK8tvXEsnqrZEm0BUvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQDl6Jc9mF4tzEruvtTEDzgTYVUCcu4xvliAdWxpqF0g&oe=6B0455F2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
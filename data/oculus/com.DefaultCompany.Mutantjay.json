-7&_nc_sid=6e7a0a&_nc_ohc=h2TSOuIsntoQ7kNvwFXCT9X&_nc_oc=AdoMgAga4ADUOnBXKtf_jkbwdp5yybnnHrTRMvri68BjWeCL7iHrgit1XRv6rbRUd2M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEynXhcYHk13Kyu_CAPf9KwRtjcZ5Z2CqRmHxQHH15kFQ&oe=6A7DC661"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP6hT59hhIUQ7kNvwHNhI_n&_nc_oc=AdpUwaT82XVjZlL9t-EpCmyD1BVd842E5IA0jrT540N3cuEB5xFKNWV4WtMdPXwDOGE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjV0OoQGtjjW2gY4cfnUG0QnxHakiwxlHF6m1lkR_Kiw&oe=6A7DB350"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0w_YwbupzgQ7kNvwEklAuy&_nc_oc=AdrmjvcrZMtvFNxFeUJa0H9UsI4Akx6H11ECA1Q3TtkTpzYmPvDzM5p5DbQkPG6nXkg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVXzm3eFcsogfws81DhAf9wTYhGmO0RmhaR2PqBNqqJQ&oe=6A7DB8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD_W7CO2OmIQ7kNvwF7h2jf&_nc_oc=AdqaWrpwW2Io-YT0FT_kd0PQFbDpF3Udsq9uZgHxCDj2Wr1cz5Sx4-VT3PlCPipC2vE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY6phXvvkP0vNBi6rVUJ3nUJZt2ECoY6AtGeHe5z0_4g&oe=6A7DA4B2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554566446227012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036703_1033281904203593_6904138589226292553_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jThlnkyj-RIQ7kNvwGfOZFh&_nc_oc=AdqYQYiIJPlnFCr5AmlgD
oA2PWBjVkoZws8OkI-v2smiu68ranAwqi3g&oe=6B083D43"}, {"file_name": "Bees.png", "id": "672974790484591", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982722_672974793817924_5779375570667020409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HslVRYxYQS4Q7kNvwH13zfY&_nc_oc=AdqYynDxA0812MwKlEh4HkibKJIoV4FLei_BowS0_qFgzfDWOWhNKwXQOV_7lEPt_Os&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxI0CBE4fSqxE529uXwyyZF8APfEqsKW182kYOJ_QSGA&oe=6B086C21"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grpHn_Q1Gr8Q7kNvwEpy91N&_nc_oc=AdplP2Qzax1bc7C8aYDTCpfHgjLML_xZkkBS6rU4uWZCrm9jSUOuiovyGICbk-yvIK0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzmZa-2ze-5qXY1ku7KlVYnehhwv61W0MYkeH4U7stLw&oe=6B085910"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjNVn8pp7qgQ7kNvwGO5ReR&_nc_oc=AdoeVUZ0WYXqGzMJl-5Ll686aTS8sF8XXwngkv5cRzqJ9z4a-oiulbcinN-Qzf7sKJQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNHZIEak6S4oK9wFHK7PYRtjHQEirLgCEe4Jc996cSug&oe=6B085EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQBp5TBu7OEQ7kNvwFUnW7M&_nc_oc=AdoY7bFbvH_n75-EWpz3CnZMo2gS4tRbD8IIMv4q2-ZiP_jJmILmMlwvFDxXtdHCFxE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRooerVnkBajg6hppu0xIAZW0wEDs6uoPkZTc9iMwHnaw&oe=6B084A72"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
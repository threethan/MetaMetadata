l93OJvQ4VvDd16tOwoV0WFLIwKLpbi1hxZQ&oe=6B0F0D03"}, {"file_name": "Bees.png", "id": "672974790484591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982722_672974793817924_5779375570667020409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZOR9UwhKg0Q7kNvwGRZznu&_nc_oc=Adq4OYvML-8O2gK2SAh-IHp_WVqYYQBZBW1A1ur_82G__S_Ed7mzgYClNPzejp2Snes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdtbVMFjqDbNrKBA2mmBrC2MOkDmAXh5QF8H4TVb6RnA&oe=6B0F03A1"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EaQt6ZBzTAQ7kNvwEVtrhg&_nc_oc=AdpfWzzib74AItu8Pp0oscBKa0ScgI0uS1ioiyP914ZbbC1KqzhMNpMAiJPQT2ah51c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6gXy9HsVqWBfNHzmHKqSeZAhaTiUVS2Xn9jhwPPqPcA&oe=6B0EF090"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvF-qPP1TlIQ7kNvwG_Mn5k&_nc_oc=AdoutvWDOSWDQOCGwEFfGFB9Cwh7FasIM_zROP_wlPFbSKzQyKxdVaU_UqacfxQfkoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuGNHG0eGzjr5Gj-GYgyvayQW7WTkpcESSB-PDz5BiAA&oe=6B0EF629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYdT_fMGheEQ7kNvwGol8vY&_nc_oc=AdrczIMsXxfkyi_hh2a3EGyoKP9hrVekTbnuXrcG-lj0QxdD1Hjqx5BVfHSt8CyYxBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUacu6r3WijjCIUA4REppsq9tsP4Tyogy6ENRnYCo1Vzw&oe=6B0F1A32"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
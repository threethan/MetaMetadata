nby3dR5tWcIduRCpFYU_RgYZsLXgV5G-NSw&oe=6AFB4683"}, {"file_name": "Bees.png", "id": "672974790484591", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982722_672974793817924_5779375570667020409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0a9rhUoNJEQ7kNvwEwCZ89&_nc_oc=AdqifE-E468lqsTs1CKfqSkdo1Xefa_9kS3zQJXy9wk_cxVxNNb3kBlg0wkX2vlzXao&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuxMpo5aBk7nSBZ7Mtzp5R3uP6PxyFKqvRj8LNw0lHEQ&oe=6AFB3D21"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoTN-PRs20wQ7kNvwEPsYbb&_nc_oc=AdqFhw6v5rHpuokuvt4j-ND76v8b7eaFCPkUckurYFzouV0mykYWIHbvxVVV4om-bOY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQONIKSBPhy0HHRiQJ0aoyNpoSb0s3SWGx-_KLl4drOqw&oe=6AFB2A10"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWQ8yOyEwr4Q7kNvwHVLVSC&_nc_oc=AdpHPbj4y3cJsPhVn5gDmnPysw9o2KYlW6LY10iyzzD-KeHypSSNa20S7EICWEYlUpk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Jge0APi-uOYdVTjHp9zqfbnahLzGmVIVVgm7asbjOw&oe=6AFB2FA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-kj-oWYfhYQ7kNvwHIAphT&_nc_oc=AdomPiCy02KZMrqxM6hbAajLFyNk4b9RrkeRiAUGgY8tJ4G4NHt0Zb8C2D8B8ItTk88&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWNZ8BhddXeiZ73ijStrAjGtIhaC9coVZuu23h62LeOw&oe=6AFB1B72"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
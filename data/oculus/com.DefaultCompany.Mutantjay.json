NvwHunADI&_nc_oc=Adm9Z4-Wfnlrv6dLsBvCcYusP0qXN_Hs6530eIxpl9q7x4ZCzj89LEBdl5sL3RZ-drk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_OrCHRvLKgVyOV4GGpVnGM9ZUJyRiQiOAzeLgyxeujQ&oe=69BD4B61"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYOKqYP7UxUQ7kNvwGOnSCg&_nc_oc=AdmzgUAsmKkHnpAOn3BEN3fwV_qeDkZh7mQIZwjH2cWvIrKnXyb8CX7XIPZBkUb3S94&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBHq1t75OFEfJK9MnoproXfMWSR85ek2StrKO3TQWm0w&oe=69BD3850"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIHgvVCBqBIQ7kNvwEcYblv&_nc_oc=AdnwBEx3q-cQLH2u8XrmYEAhmNa4vKpYhkUUp1PsMHBrLsk_0f0anhHTnQxnk5QsziQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzkji7W7PFGFmrypP-U4I9qqNDnwWEkfcndhHg3jDfdJQ&oe=69BD3DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ff4SOQ8rrMQ7kNvwFlrbpW&_nc_oc=AdkFJX-7kNkMttmFLZZnWEcv7JhjA9SQHRE8s0WjJO7ELBDFX4dbRPtcWuv_Had1-RM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-Ff-meNLmnHz9KWwzPFS1ZiuJftdbB-x9fdqxEdO-GA&oe=69BD29B2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554566446227012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036703_1033281904203593_6904138589226292553_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZpYRQQ2KHwQ7kNvwH7oTuC&_nc_oc=AdnRdOlsRers2hSe4uKZxW-CbThuwoPtjIZ3mUiX80OMXXnOueSRIU8rIc8LvFJv0Eg&_nc_zt=3&_n
UwhwzAdpHk2Sg7kRPo_PUUP5Z5T8pV901Fg&oe=6AFC5FC3"}, {"file_name": "Bees.png", "id": "672974790484591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982722_672974793817924_5779375570667020409_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0a9rhUoNJEQ7kNvwEkYrdU&_nc_oc=AdrvUsCW5MlDp1E_GPmf7ksa9Pz3Z6lq6S_ieAsE5yaN9hgii148YpTQbTTAs6zFchg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx9e_0z5ZZBKdYo3Mzuf8DvgDxJ6KSGoAnToUte6L4MQ&oe=6AFC8EA1"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoTN-PRs20wQ7kNvwHkLxTa&_nc_oc=AdpxVLpRgOACAD7purQjTVEIsJ5VjHJajeBxzqelIYN0uqVT5S09eKEBPIvCvslahZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr15S47RobUCA7BWy9yM7AcNJi2kggJ51IR_PsoABoWA&oe=6AFC7B90"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWQ8yOyEwr4Q7kNvwEqbILq&_nc_oc=AdoivY4UwNzR6dPJBBEs1EDrcpGwEZ3sBV_oHcl8NCn9xSbPzJ5URk2OAOjQ9joCIJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbnvgcc7yFa5OfwT73OuNkyPRkCIOEtCNjkRPzJF-kgg&oe=6AFC8129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-kj-oWYfhYQ7kNvwF49VV2&_nc_oc=Adr300GdwWztSmyzgYiBXYS5MLZ0onUeOzozoKr09jg935xPrXg6byVo372jjVfYnCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3lzkVfmzRC25zh9hmRCTIHqJLPBGEZj-FjH-b0OUnvQ&oe=6AFC6CF2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interact
-7&_nc_sid=6e7a0a&_nc_ohc=QOc4cNEijLsQ7kNvwGTA_VH&_nc_oc=AdpEHaBwDPajaoWsyqF1T7Xy55wv7KRHMeFNbOWUT9Bkb2e97stxafmECHjoDZzeHhA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dGNDYxv01tgy4RqhJ50SsyEUDuH3NugxePnZhj2Mxkg&oe=6A466761"}, {"file_name": "Spider.png", "id": "696366178058419", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974453_696366181391752_7717882449020234492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE2MFW4zMaoQ7kNvwHhzbTX&_nc_oc=Adq_qCq3soWqiQ3Il0tnTNDU-VwECkK8LqDHBtwinEafdVpPchQxwzk7Hme36Z0w5xg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eBnPZQcmObYYN62bQHNVQHGXAk2WR6Iu8NX9xIwaCIA&oe=6A468C90"}, {"file_name": "Mug.png", "id": "5086111088118682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974862_5086111118118679_8378181263626806997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpUi2eh9X9QQ7kNvwFfUcgh&_nc_oc=AdoRaX7m9Gw2v1sy4uH52ENHV26cbC6Avf4-pjgiZ7WPhJ0_s4rcacyLoaWXjA-VFFw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95N2_aAgDUf0ZuJGMsgaXo9SIZdfxOFlXsgGCOrKp97w&oe=6A4659E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart.png", "id": "800582784233678", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035320_800582787567011_641578553084957380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liWh5PCoUaIQ7kNvwFEhvPZ&_nc_oc=AdqF_ERM-2sqra-HN_fa6czjHKrqLx95XgQWPE1Lfsrd1ZHtTxkQSh1B7D25Dg_AcVI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bAl2rSPpmuPUWb_iAbRuEop1X5OrM7-sxqgkywS1jTQ&oe=6A467DF2"}, "display_name": "Mutant-Jay", "keywords": [], "long_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits.\n\nYou play as a mutant bird with an insatiable hunger. In order to stay alive, you have to constant look for creatures to eat. \n\nControls are super simple. Player move by flapping its wings. Flapping is achieved by doing half squats or hopping on the spot. Once in the air, the player will glide in the direction it is facing.\n\nThis is a game that will provide the player with an intense aerobic workout. \n\nKey Features:\n\n- Exercise while gaming. Get an aerobic workout while playing the game.\n\n- Challenge yourself. Test your endurance and challenge your past records in terms of number of creatures eaten or how long you can stay alive.\n\n- Immersive experience. Experience mobility through the eyes of a bird in flight.", "short_description": "Mutant-Jay is an adrenaline pumping survival game that test your physical endurance to the limits. Get an immersive experience playing as a mutant bird with an insatiable hunger. Chase and eat creatures constantly just to stay alive.\n\nHow long can you last?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viablehire.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Viablehire", "support_website_url": null, "website_url": "https://viablehire.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554566446227012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036703_1033281904203593_6904138589226292553_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH69PSyddGAQ7kNvwHPsDr1&_nc_oc=AdoeH_vSal9rNRFoYRodb
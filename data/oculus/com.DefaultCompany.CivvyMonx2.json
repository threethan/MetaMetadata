792640378356_895757900169055663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1aCzcD-P8UQ7kNvwGj-iLS&_nc_oc=Ado_uKC8xSizxCLUC1PWv9f2-KMivvroiKZ66ljoKuANF8zq2GdiZNoXFp76tFdIO4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsGpsSJXZIQ4O3Q_Aiig0QYYAgTcGpEvdvDaEn0kzwYQ&oe=6A9EC628"}, {"file_name": "Untitled project (6).png", "id": "1571514647712424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507819003_1571514651045757_6369722255231652318_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-grFD8XOGMQ7kNvwGh8QkP&_nc_oc=AdozOE23YOT5ZCaXKq0AO8pWrMU_PEXJ25_Ici-FFE3K5xkK4PiRmnRE2x48lSte520&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL7vGVJVEeNUK0JobzInub20nDi8JET97yPIedcx73-A&oe=6A9EC745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Civvy Monx", "keywords": ["Gorillla", "sandbox", "free", "fangame", "gtagfangame"], "long_description": "Welcome to Civvy Monx, a VR sandbox adventure where creativity, exploration, and community come together!\n\nBuild your own world, grow your farm, explore unique locations, and create your own story. Start with a small piece of land and transform it into a thriving place filled with crops, animals, buildings, and custom creations. Whether you want to relax, explore, build, or compete, Civvy Monx gives you the freedom to play your way.\n\nGrow crops, take care of animals, collect resources, and earn Haybucks to expand your farm. Use your creativity to build structures, decorate your surroundings, and design a world that feels like your own.\n\nExplore different areas beyond the farm, including the Station, Playground, and other unique locations filled with activities, challenges, and secrets. Meet other players, work together, compete in events, and experience a constantly growing VR world.\n\nCivvy Monx combines the creativity of a building sandbox with the immersion of virtual reality. Every object you grab, every structure you build, and every adventure you take is experienced through your own hands.\n\nFeatures:\n\u2022 VR farming and sandbox gameplay\n\u2022 Build and customize your own world\n\u2022 Grow crops and manage your farm\n\u2022 Raise animals and collect resources\n\u2022 Explore multiple maps and activities\n\u2022 Play with friends and create your own adventures\n\u2022 Earn rewards and unlock new possibilities\n\nYour adventure is just beginning. Grab your headset, step into Civvy Monx, and start building your ", "short_description": "Welcome to Civvy Monx, a VR sandbox adventure where creativity, exploration, and community come together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/civvymonxprivacypolicy/inicio", "developer_terms_of_service_url": null, "publisher_name": "Dimsum_Doc, forfitpie", "support_website_url": null, "website_url": "https://sites.google.com/view/civvymonx/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1246583508536209"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312422_1350186340427065_7193237079355827284_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIAAcD70_c8Q7kNvwFCYM3q&_nc_oc=AdoAoJkVhvHtBIlXvuTP7jBirsEfvdoe5UfrmPG_6QERIaSm080AGYAoZ5otcYJxx5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculu
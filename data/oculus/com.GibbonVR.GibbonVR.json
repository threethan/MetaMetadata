.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SVKz9BQOYoQ7kNvwF-mkhS&_nc_oc=AdrJOsgV-LxNPdvWE22Kw5Q_YGDF6pb3j0uREN1YiKLlsFR8HVf-Y5Vn41oiNIMNp5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg9PqOi1cTM7UbormtGEPf2dts_tFhVluYsYr7cJhaEg&oe=6A74A4FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon VR", "keywords": ["gibbon", "vr", "gib"], "long_description": "Gibbon VR is a movement-focused virtual reality experience built around fluid, skill-based locomotion and immersive player interaction.\n\nNavigate detailed environments using responsive climbing and rope mechanics designed for precision and control. Explore a variety of maps, including a dedicated shop area with interactive systems and in-game features.\n\nPlay across multiple game modes that support both casual and competitive experiences. The game also includes a functional in-game computer, mod integration systems, and unlockable content that expands gameplay possibilities.\n\nEnhanced player immersion is supported through expressive features such as blinking and mouth movement, creating more natural social interactions in multiplayer environments.\n\nOngoing updates continue to improve performance, add new content, and refine the overall experience.", "short_description": "Experience fast-paced VR locomotion in Gibbon VR featuring climbing, rope traversal, custom maps, and immersive multiplayer gameplay."}]}, "developer_name": "Gibbon .VR .Official", "developer_privacy_policy_url": "https://sites.google.com/view/gibbonvrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "CyberNova", "support_website_url": null, "website_url": "https://sites.google.com/view/gibbonvrofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_
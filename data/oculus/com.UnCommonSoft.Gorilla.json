fe 2025-11-06 010549.png", "id": "1375267644087337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298281_1375267647420670_1581859334526632157_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3kZ8EhpmaMQ7kNvwFS_S6k&_nc_oc=AdrPXxl0I1uYCHY-gDlsfpOoWPn70ZGyn5xAYqQtQc-jVgFknQa9dAZGF6BJciD3M8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2-oVRmyOR7eyNOtG1ZOMhJyCWfzAja3QTWfKBGKw8fw&oe=6AC131F8"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2025-11-06 212843.png", "id": "1505005474062105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831968_1505005477395438_2237041103853671609_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fnjbIJbI9YQ7kNvwFAZLnx&_nc_oc=AdrzT_rrjfDnqSInn9GQd6jXJ10LV9gxRJpGgcV7jtsyxlCFKsfoxm8AiOaQK1Akq3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0_noCzRdNN_SPrieFPYAXUWEAHbvS1h30stIplVgxNw&oe=6AC10D57"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2025-11-16 155439.png", "id": "2102296126973510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821950_2102296130306843_7600894843229242117_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPgs50_CKnMQ7kNvwHnV643&_nc_oc=AdpVw1CJSz_jS6v4T_7tAlMVIrjwy33Zxc3NmFCE02KqwChSSH6q0QHyF10Xoxp85aQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4uVgaccLyuaQhacdE8t_vGeydHizc3sk5FvQpBm3D4A&oe=6AC122B0"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2025-11-06 022331.png", "id": "1747486352595310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299808_1747486355928643_8086625081787998359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TDGKCQjWBQQ7kNvwEW1E4d&_nc_oc=AdrgtfZiliT_VP1ecP7Q08_bJbhgcypXs4fkrWGONTR2f4WjBL4G8iuCnFyez6Rwluk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxpannEH9-yPuk6bQPluF7TQ0OGT23XwVh-NgjZfAMeQ&oe=6AC113CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla", "keywords": ["Gorilla", "Dragon", "magic", "movement", "animal"], "long_description": "Jump into the wild \u2014 you\u2019re a gorilla, and your hands are everything. Swing, grab, climb. with friend, across a swaying rope bridge, fling yourselves down a slide, scramble up sheer trunks. \ud83e\udd8d\u2728\n\nThis is a cooperative VR adventure about movement and momentum. Start when your troop unearths a glowing Magic Array and remembers a distant, frozen egg on a cliff. Together you\u2019ll trek across frozen valleys, fighting off beasts that try to stop you. Each successful clash makes your weapon feel heavier and meaner \u2014 your swings grow stronger as you do. No puzzles \u2014 just pure, physical play: push, pull.\ud83d\ude04\n\nWhen you place the dragon egg on the altar, something ancient stirs. An ally will awakens to help you march toward the source of the freezing curse. \nPick up your friends, grab the egg, and swing for the summit \u2014 go make a story worth yelling about! \ud83d\ude04\ud83c\udfd4\ufe0f", "short_description": "Jump into the wild \u2014 you\u2019re a gorilla, and your hands are everything. Swing, grab, climb. with friend, across a swaying rope bridge, fling yourselves down a slide, scramble up sheer trunks. \ud83e\udd8d\u2728\nThis is a cooperative VR adventure about movement and momentum. Start when your troop unearths a glowing Magic Array and remembers a distant, frozen egg on a cliff. \nPick up your friends, and swing for the summit \u2014 go make a story worth yelling about! \ud83d\ude04\ud83c\udfd4\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/c6605e3c-3355-4b3b-959f-b366d83feee5", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Gorilla", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890
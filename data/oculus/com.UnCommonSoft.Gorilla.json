c_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-18_M0CRBmej_waQK4remptBA6tDhzPu1lmXNfGLEpw&oe=69F8A957"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2025-11-16 155439.png", "id": "2102296126973510", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821950_2102296130306843_7600894843229242117_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vqt2LkG7Lw8Q7kNvwGlFbzu&_nc_oc=AdoqjxpJMQ0zfGC1UUY4vuTTDGSH0zup85k2lTLgxKmziwB6IlQL1BgweMdwgYUn8f8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M-d_pvzG3jDpkpK0ksiNJ-TErrjlcVHyEq5hjAiehuQ&oe=69F8BEB0"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2025-11-06 022331.png", "id": "1747486352595310", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299808_1747486355928643_8086625081787998359_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy_HgSpzkFYQ7kNvwFQMfP1&_nc_oc=Ado7kFwenEvbBItK0tAFb_XLQe5x5AFzzI684ivZtiO1l8ckpUVhU6QlnKTlRvZX28k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uLbgAhDhl1PkMzQlBeh27juWiUfHXCLAzeEmspEmPqQ&oe=69F8AFCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla", "keywords": ["Gorilla", "Dragon", "magic", "movement", "animal"], "long_description": "Jump into the wild \u2014 you\u2019re a gorilla, and your hands are everything. Swing, grab, climb. with friend, across a swaying rope bridge, fling yourselves down a slide, scramble up sheer trunks. \ud83e\udd8d\u2728\n\nThis is a cooperative VR adventure about movement and momentum. Start when your troop unearths a glowing Magic Array and remembers a distant, frozen egg on a cliff. Together you\u2019ll trek across frozen valleys, fighting off beasts that try to stop you. Each successful clash makes your weapon feel heavier and meaner \u2014 your swings grow stronger as you do. No puzzles \u2014 just pure, physical play: push, pull.\ud83d\ude04\n\nWhen you place the dragon egg on the altar, something ancient stirs. An ally will awakens to help you march toward the source of the freezing curse. \nPick up your friends, grab the egg, and swing for the summit \u2014 go make a story worth yelling about! \ud83d\ude04\ud83c\udfd4\ufe0f", "short_description": "Jump into the wild \u2014 you\u2019re a gorilla, and your hands are everything. Swing, grab, climb. with friend, across a swaying rope bridge, fling yourselves down a slide, scramble up sheer trunks. \ud83e\udd8d\u2728\nThis is a cooperative VR adventure about movement and momentum. Start when your troop unearths a glowing Magic Array and remembers a distant, frozen egg on a cliff. \nPick up your friends, and swing for the summit \u2014 go make a story worth yelling about! \ud83d\ude04\ud83c\udfd4\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/c6605e3c-3355-4b3b-959f-b366d83feee5", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/Gorilla", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25658258167164480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298451_788074701065951_2361594052738180789_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTb5sw3SdE0Q7kNvwEecHUR&_nc_oc=Ado
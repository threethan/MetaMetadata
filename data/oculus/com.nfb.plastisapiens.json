0f&oh=00_Af2o1b_Cksq4govfJrFCOAl5BIWgVY6_yPwZgScfUUQ9-Q&oe=69F49BF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92aUWeRlMZsQ7kNvwHFDUmU&_nc_oc=Adrw9Wok-lyyqN7kBdwh_s0xq17kZtNrb6nUUxhMJ6szEZJQLHF1deeOFze5jmoGbhM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18j9RsBYH3jfhL-dse73vRUVuYqNgEYQCxnOMlfuw4sw&oe=69F4BCC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P5A0odD6FgQ7kNvwFTuBhw&_nc_oc=AdoSGj9LdJZ2dHOGlu7IUWOUk5UjkLILvfHd1TnTO6pQCFz9d1Bl04ajqBMhLK8opQE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RER_65DtFOJiMtwi9_6NCLcfz0Nbmg-bU26ikmJRkyg&oe=69F4B93F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kqgw844_gWwQ7kNvwGtolDF&_nc_oc=Adr4k1JfNDzBF58_Xylsn7iVelYQsjE8kwvGP3WjWXccvIwajgase82SbtMg1Atw9po&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LyGRsQz7E8X1UwEFKf6LDKRCx41IYHm1YN6S744ZUhQ&oe=69F4B74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO6Bq-MP1ToQ7kNvwHAIN0_&_nc_oc=AdpsLxlmbTMvGCbCQ73TU6QBY4np7M30ugqRWOM8zbbnBllUUUdDEUVN8K2Zr1ht0EQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39fCRdW9p5sfBxW_c8eXzLGN8ECGYxpOQiJ38ETyCV6w&oe=69F4B44E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHGXn-yVs88Q7kNvwFL3Zlg&_nc_oc=AdqFRMVlSrckrLdRUnY2b8k9-klssjxdZwUT9D3KL0SRXTrXwp_5Lu4VmJTbdjvZw78&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DPXzVZ0-ju0I8bd2oxZYlayZBVS3atBwhatsUYhYdFg&oe=69F4AE3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
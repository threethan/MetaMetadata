6e7a0a&_nc_ohc=Qq3tc872gTYQ7kNvwEAia7L&_nc_oc=Adq3brb0y_Zw1eiG3AknnAD2A0KvcLmzUp8ba7Lwa6ESyZVy_wVMv2F9XUB-a5U6OQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bUievc2m84oztffn5NUHdp5vdVX4Zq76fYYWfOJgPxw&oe=6A1EECE6"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "722042755767293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982469_722042759100626_3406365413707921729_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Q-vj-2ussQ7kNvwF8H933&_nc_oc=AdqfzU1iL0gBbaN74CM8jtlx0QLM1Xaf0082xf9iUpS28oH9CK6cMGX0n1484zzM1II&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79cHUsYYJcDPReaI7FBt04dBe19fayl05-jdinMS8WaA&oe=6A1ECF93"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "425685199462033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_425685202795366_715112616556668169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BmsNHSoQoYQ7kNvwFiPPIx&_nc_oc=Adq2UxwqC-eUm2tXF3EC3ZgS32ebHzdkyTSgG74VWZICuxEiqUgzEI2N6JymuuCGzFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wpKXgOXtWT2QTU_PLJ2CrJ33D9Ppcf0yd7eVgOjdN_w&oe=6A1EDB14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "1585722755155375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974530_1585722758488708_2854031198634892394_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RN788u9B7wQ7kNvwEESSjc&_nc_oc=AdoC4q127HV8AA6jubV5u1tUjY2BkpJKTamOJcdreIrgjsZPlWuu7OqTR2mncVOT6So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rL_Y60sNhJxTqwojlUOiMVkBZRqe0ufn3rOoPwEvSVQ&oe=6A1EF69D"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Take a deep breath in. Out. In. Out. Now relax and contemplate a world where plastic is completely integrated with the environment. Plastisapiens is a meditative virtual reality experience that allows us to consider this world with curiosity, playfulness and even a sense of wonder. Rooted in modern scientific research, the narrative slowly gives way to a strangely beautiful and ironic speculative work of eco-fiction, a journey through time, evolution and imagined futures. By interacting with organisms around us, then watching as our virtual, organic selves merge with plastic, the experience creates a safe space to empathize with a material that binds us all. As we are gently guided through an awe-inspiring universe of hybrid bodies, we are ultimately left to ponder how the interchanging relationship between humans and the environment transforms our identity, right down to our DNA.", "short_description": "Plastisapiens is a virtual reality journey towards a speculative future where organic beings and plastic become one."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nfb.ca/important-notices/#privacy", "developer_terms_of_service_url": "https://help.nfb.ca/important-notices/", "publisher_name": "National Film Board of Canada", "support_website_url": "https://help.nfb.ca/", "website_url": "https://www.nfb.ca/plastisapiens", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "762980611327170"}}]}, "scheduled_offers
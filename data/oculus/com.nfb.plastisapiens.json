037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKcXmX7iTOIQ7kNvwGpBR6O&_nc_oc=AdphMmqKFOZ89Aaos1J_Sy2gu-2H-MdBe-uzQ7cOWgt_oYHQheLG1XbJxq0yyhJg6xY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_1ua7Doh7jSVx4Sujj8nPBR5OgXQB0zFC6fA2r7Md_A&oe=6A858984"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp6clfiKSscQ7kNvwGOJwzE&_nc_oc=AdpIUBjpaj2c45TXDbxfLu5H39WJM4FbsgZUfoULBIKKdPM1IH6YCVz4-TBcV_67VLk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERL2mv5xbHDawEKuMks6ogRca84wJ_-QeaANk0M9R27w&oe=6A8585FF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuVAl1u1m8oQ7kNvwF2eiGk&_nc_oc=AdoOkyNQ_OD-mtxb6_JflIr8hz1PymyQHvsZoVRWmeJvvhdThXXaPvfSKQL-794u-4M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDaONYyZpOj_sKGTdj-05P0nrtoRZ_pHUPiaXuKmKlfw&oe=6A85840F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0NBwZNp1nYQ7kNvwH29zqs&_nc_oc=AdrgTAi_2ooRKKX2Mn-vBEudfjk7H6NkmA4i04I5HPcfPI5aPFSkoynY8jsqd4DEBUA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC9yQYpOh1W8RNm-haaslebDR4e_vnyinBKVegVaItxQ&oe=6A85810E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyaZ64fyfyIQ7kNvwEIsyJy&_nc_oc=Adqa6Jb6p4LWHKAkBQ6Pyy7Iohhr3tlKnTlCqYnMe5m2fNl8joNRTJj4guB5ZXiYo9w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5v2s2Hir92mjBQAZsRE35Sgl7wH3jRgtxJBW3v3pYVA&oe=6A857AFA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08KYXFNl8Z0Q7kNvwEXWyzW&_nc_oc=Ado-JFwClJKq6_lqQQmEpfPUriD1WYWkGwvoGaxLZC
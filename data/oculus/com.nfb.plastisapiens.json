0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8O-aUbEu69oQ7kNvwHMr42p&_nc_oc=AdqiPCd73bayYIEghNu5xE_EdwRoBjKxHtDtrEkCYokwREe3_jcScS3qZyVxYH1jPx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3Q3KRugKz1qat5cIvovQYLo89KGfJdwfmScyvvXi5Jg&oe=6ACF95C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uaCkMgnBYQQ7kNvwGzn1up&_nc_oc=AdpsyhSwAob7ITjW8goz9DEkVFMxzbv2DqYrmWrq253RX9N9nb0cElOe4JG2eorqG5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd1xJXFLJ8GvYoFlvZaYWjlC8n4VwWgkGs9eoFCoMdsg&oe=6ACF923F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KplUDPoeHw4Q7kNvwFqfM65&_nc_oc=AdqTxFLeH3h0Y3wgq1vCSwadyF__i2Gv8dtX0SKQ76A9GYYA_B_6eCkqwa-HpjI4URc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHvecukxcTomud__XhLDqjGRcD663AKa87OMEwqylv5A&oe=6ACF904F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b0jf-fO3ucQ7kNvwHopSjr&_nc_oc=Adq4_2qe-G1l6ynNpfc9oe--RSiqWQjX_wh6omfida-70S70QuhxxQ_0Bseb73_hBGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmvO0bnSmBfsD_Gk16nO9WFxBF0FMmolQTAAPeKkxXug&oe=6ACF8D4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guCnFxCOZewQ7kNvwE59SG2&_nc_oc=AdpTFb_OOiN4YsORfhXtjWkct6JH780KCSCoB2mMQhiXdS77rb6GiLg4fJkyZbq6OMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRQN1AJYgF33cd8OUuepJiZIhJYPBGD5htnI2doc1oSA&oe=6ACF873A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xvasZ0IbwQQ7kNvwFUYhW-&_nc_oc=Adoqj94W9TPXNN0FnchSoib76E1sTpUDH8cw5qzXAaPD9RVM5K-N_z6fZge-BvHhh
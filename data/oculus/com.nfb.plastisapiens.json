0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFjWwkOZl-sQ7kNvwGprVGh&_nc_oc=Adp8xfT7OGcqWqPFQOG3ADyF50QdeRGmOPNM3PQ9C0nRzU7Bizz_Mk18R9j9Dgs9oug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIXh3K_RWfXLv-GwS8w9ul1sCFIv7Y0OR6g4svbS-rng&oe=6A749E44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz0J4v2lQpoQ7kNvwEh64Z9&_nc_oc=AdqQaHem4HQilZnFVypKzZi3CNqEZ-amoUMjWGa26-N7gGNokAmf9jVtxOYlA6CkQ14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwO-PQbAK3R_09cmq0glB9jzougsRy9AD5z1av_zUTbQ&oe=6A749ABF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU-x7noRxF8Q7kNvwHcbboj&_nc_oc=AdouI5VBng54OlzDBCfMFDk0igfVSqANVNgSfC2XFODzmU3av-q53w0BOiID2VAv9H4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl8cEF4LfHFN22lpxAQr8HOpa6-dGDevA6YGbfwCXf2w&oe=6A7498CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNXDwFnsdXIQ7kNvwEFsCWi&_nc_oc=Adp_MrRTg2w18b7Hm2KpRJaQKDQfWZut4WqTIe_VmOmfvDpL_nnGJfn6BR11j8awl-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuOdzZ8SUNb-kwGSm1mrkYj6HjJOExEWuepFGsQlQ0kw&oe=6A7495CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIcYRya4jgYQ7kNvwFIP9Tb&_nc_oc=AdpX2aewpOrR5Tpuzs5Iti9qg8NdgBuSHBisnUM1AqqIDlNr6GlSLb_RLu3OmP3-2j8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf6SRH3rvuYmZCteCPh21NbAcTOAsy_zKPIh4NOAK11g&oe=6A748FBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aEfacqdjQsQ7kNvwHgrDLz&_nc_oc=AdphKpLOS3V_B7bRRJbmImHhDb_HuNYYme3H1Y8XpFjiR5mB201cidQb1AIbqN2ij
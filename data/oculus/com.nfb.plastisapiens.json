0f&oh=00_AQD6pDYSPSXf7ncHw2-9zIHwi5_2D7dM3Aa5iUMxXVnkcQ&oe=6A5E13F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YIOPi2HZhsQ7kNvwEy22dc&_nc_oc=AdpC4f4MfIl_Ykk5hHBwJNOtnV-IY4I_Ti0_a2x4O5vsnK49s2qPg_Tsf2Ip59E69Yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyLfRq-1CvIGytH4aPzlXjpkGvZ5Kr3YzdzjT-5R6Ldw&oe=6A5E34C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6exUxKHDv-wQ7kNvwG2svoz&_nc_oc=Ador61ESOa8FK_McGY2KZ_rdIEdCWaix9gtKe-b89rJ_dDqjfn2omC9gKL6B6zWHahE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV1Y6E4XcWrUS4Grb8J8yEh13ZJumu2eqk3fp2cu2LpA&oe=6A5E313F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j381lR1SysQ7kNvwGS73Ul&_nc_oc=AdrMHcDNmhIcvNNHmCWIVfFC1Y3tZ98JmcqlIL6OIkn2dP8aeTGOTUfPSQtp8ym06EE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOO5kwCCw0FGUMOXVHxzD8Pnp9LCCUZIktWMyUHTKbyw&oe=6A5E2F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ToQRCW9XX4Q7kNvwEDtVtt&_nc_oc=AdoAciPThVzyPPq6D77Mn-_oAdc7i44vpdabMWjA0p50hEBHOuU1Cvb0Il-YGcaeetM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN071uHFQj4NAYZxkiZNT-xRB0O-atzzt_75XchBHE4g&oe=6A5E2C4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaN4pHnr9DsQ7kNvwF-WU9o&_nc_oc=Adr3Ooyx9UfOWo9e_RXEVDeaVJSKiH5VHvnRJPkDqxIpp7BwuZYi0yY0uJaYsv4DEVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4SdEPq4Yu23ob4oEdtNnbON63lvyDMXN3j_ZPxjC1WA&oe=6A5E263A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
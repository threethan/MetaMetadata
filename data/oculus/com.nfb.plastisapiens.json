0f&oh=00_Af_LCZeoDEEcf_snPgKGwfsiGMC-a6ZZpao3W2BUgbZAMA&oe=6A280679"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaHbdsZPuMQQ7kNvwE4xzKk&_nc_oc=AdrzQ70Izk8xKY-KxTA3Pqz3Z4WX21MyqwHRBmTbM6shQUgxK1aHjGTDRmHYWjGkB1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B9CWsNkJ0i904AMevPuUWsqkoqAtiFzM7umIXy8B8zA&oe=6A282744"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XES7cUx3xYQ7kNvwFfb0m6&_nc_oc=AdpNcBUyn4dhg4BHljtAJM9zY0rvCAN87eeWeg0DG70kscnJ0ZFBKBLIP3E2YH23yN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xcgN7IUFCLyGnEGma8o8nhsFB34Pg-cj00Gxkzo3H9A&oe=6A2823BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkfSJOzpwWEQ7kNvwEevt1b&_nc_oc=AdqKfH2gOY7WjMCVSV9h3XTzWCXl3ywKCpNtC8qj1ahZKIQJbkfLasBT66nKIt9dqCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ob0yP7FwzHF6uPoataCYSTHT5zmQihC0nGlz-uFdX-A&oe=6A2821CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j36Mh6l7svIQ7kNvwEPMLF0&_nc_oc=Adohsb2AvQqTq0V3MvuxJMMPghFZXd7KmzyZg1bcCv_71Fhldlaix3rcvbZIvfIk8UI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NEYjd9y56UG8sEp3Kr_Iel97vAhjYwQIMLf_33S-JLw&oe=6A281ECE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPmMsyfG278Q7kNvwH1-nN9&_nc_oc=AdrhQ0i2uJGC-Gx0KojMub1MFYF-UugqdxvNF8-umcF1VIpECewenFlLjpliRlaYoJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jQ7kmmaiGh8ViIGVv_wI5rqKlTOGu51cRo5-1ntyOFA&oe=6A2818BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLQxUa5bIlMQ7kNvwFf9Rn0&_nc_oc=AdrrlN9CzPDwDtNa4DcdAm6tKzTfFarP9IC7u9FPXUxWVW0Ha27NOnMMe8qkkahFWdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFFLo3Q0ENfhfHxqNIaECvsvuCPXQjbhQELA23NMLK6g&oe=6AC65B44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_9q9sTW55MQ7kNvwFYnw1g&_nc_oc=AdqUorCu8umgLFBetBMUQ6r-Ny4IJPz5ukTuQsv-D5lV99VrDPjPoTbJfml2bmgu5Uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLJCPr_sFvtDA7rPFCVPfNSVO28rtU0oFvGr-u625F-Q&oe=6AC657BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WESBicklnPwQ7kNvwFfus-V&_nc_oc=AdrfyB82zo6Tc6uyFIw7FrrQJVjGs4JaA7UCVJZIHjGmF2DolECSrrGNnMtW9MpFIsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM62ZBP7buf3xYjNLkDKqdB9K-tUXdeNqceOUO6VMqVKg&oe=6AC655CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7UfwgMROIcQ7kNvwE3PWcV&_nc_oc=AdpnCXvW5ndxqEvN2zP8Nhig22G7l3rWOexJcew5KtN0Xi0ukNG3jmACrU7iBKiyYaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKTltpL-23EDjqGtGw1q4DNXlJ6VXs6YAj2m-nzKZuSw&oe=6AC652CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6x_9zGwiREQ7kNvwHmxkoz&_nc_oc=Adp9OfmWmXTau_L9c1LQcyvYAOAHo3PmF0frACT8ZcHP0ffeSFYnWc3k4uMv5P8_eHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8_0ySYZPtuBQPfZxO5SA7qQat26x687N33WGgKfcrVQ&oe=6AC64CBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOCscvjng6QQ7kNvwEKMvmC&_nc_oc=AdrwHOImlZOw73H5wG_K7j5JGHK3xek7oif_cYc8BRwtiWHVFVYoAAwD_wiIb-NWw
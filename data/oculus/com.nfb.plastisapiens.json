m&_nc_ss=7f20f&oh=00_AQRm-10L8bLFKweVmkXNDgWdqHlYa5G7bkY5ZEJyxM8Vgw&oe=6B09AF39"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwx4X4HJbSgQ7kNvwG1eKmf&_nc_oc=AdpzOsmMsD4fYG4-QRFzrZouMjrVHkU1iHb5SY9AB3WCRE-knTetjYVXLPBMAQaP0BU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAaGUTdi9ORSv6ixpk7RdSLm__bU-NvvdFO7nvH16eEQ&oe=6B09D004"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi512sPyr9gQ7kNvwGHrM45&_nc_oc=Adopn4eT8kAkSTbGOkwA4tpqMj3Paxm5LowKRA6cAQWSFFXXL75P5DvaM5LHXUZb1KU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsZRZlpn52dUkFiYktN81JRaZIVyak1RBG7miOYhBLBw&oe=6B09CC7F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVuGrwH--vMQ7kNvwF0dbb8&_nc_oc=AdoOx7evVitwi21JHiyX84e1b8rjPTpa3sz632XXJPr1CIqeJ_6PAxYGzzUi_7qnvt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-0HJU0TWRdZ1Wt45blLSV21cg7VR3I8AdBwRw9NbjqA&oe=6B09CA8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2uZgc3eGz8Q7kNvwErxmCx&_nc_oc=AdpQA-TeMd9rBdytCLtxBkNQImKo40eb0dA_WS6kPShsJ79jKy-CIdMRtzQPy_fBgyk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDxwv4xgamWLbqFKvq2cjlPoWAxKQYzFVfXFF-u83l4w&oe=6B09C78E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbkAih4ABYMQ7kNvwFRLOv1&_nc_oc=AdoewI3LvyFRifEsXlPYUcOyg_W0I_69zmorr8fs-byziXfdc9KqqT5XKKXiB6somJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxCKweEzZsIehi_OMj92QrRhG6-yN3Rd
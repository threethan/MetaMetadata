0f&oh=00_Af1e0l8ucY_XVNVRv8J3VWQWPoPfWpyqZisC15cIzczxGA&oe=69D79AF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF3d136kP7oQ7kNvwFQ8nA9&_nc_oc=Adq1ZO6PtDGWWplQP8UJvbTAdXrkh2Sp257BctDxos6GZSVr4KrZlR5Uqoh2AM5j0FU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wV-fu7bhuuvp_gUOud5tb04TSSb-new6q3CbiBkG5sA&oe=69D7BBC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQQEp3h9ObsQ7kNvwEF_jaK&_nc_oc=AdoqophMsJ_sRJhL8Bumn-4v3nNEXl31HUS8-yCgnMRxhDPQdT6UgBLBlYs3YlzDXDU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h62zrp9sisbGb0wv4wl6mcEOu64k40MTmP7X4Av929g&oe=69D7B83F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaFe5-Mho_MQ7kNvwHkwYUg&_nc_oc=AdqT3I93cyjocpD5m9hlxQBx-XJ8f40eChj5JtMYbf_cdQ3Cs2Q-r8IGp7990LPN0nM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10XYmSDwuekjegztD9rk4bzzu04idJPCdjlWC4-gT4rA&oe=69D7B64F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyErlNi1V9MQ7kNvwF9W470&_nc_oc=Ado9wmGdirx1U-XmhuhwExJRFmJIG6pGBtGujSOhMSybzCCbEZA8jBqT_73DncKFrOQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vmi4Xancp-OOmXdg8xXB84kzyA4_TALSrICzNJFCg6A&oe=69D7B34E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2AcAssYbskQ7kNvwFbGb_S&_nc_oc=Adp22PzNODc5jOqNFuWW9cGnhoR7CsMaGQHbtMCL-zxCUJjYWee2jKH3VOE7uASE6i4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XeZlgbbFTyT9NCZU4Z3KDhpiSx0OMIOQHbI8iTxNFuQ&oe=69D7AD3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
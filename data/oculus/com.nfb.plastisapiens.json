0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyDmIptm8GAQ7kNvwG2KHse&_nc_oc=AdrWLsa0KIYkAJjAr0cRLjT0LclRQ9nrnVWHlaB7q0SQaGRz9YTNrv-y7XxJx_TX7tY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPWH_G9hsgpqOsunM_jfVuQ1nzovX_u072B4PQehACoA&oe=6A79E444"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL8bO6iopGYQ7kNvwGyYMZn&_nc_oc=AdpHnH3aBFtx51wZxacn6RQbgRJ4o2VPfnDhswYwBxc9PiGodeVr0ZdR034au4c43AA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjAXtAZgRlkrBoPEZsYL503UW2u5bAXQZcga-_S7xSGw&oe=6A79E0BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMu8hW0bQoYQ7kNvwFUk-BT&_nc_oc=AdoRajOo2Jqfxu-XSMEQz-gknxA89KV5VPW-gIMu69gZbEyECW-dAqXl0OpcfGvOS5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcLHQvlp4JnyDiIr72pGL9aZ580QklnNVAUnmwn_pGQQ&oe=6A79DECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H21uQlUYIMUQ7kNvwFjXkJ_&_nc_oc=Ador45eVCojPfZkgvIRXaJ1i48tDchHinBxUxxCBbG4kdgA-iKRaHZoaZ9VZIlwhiEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0vJyarPvhpfId97CSbpUMRP3J-uBL750lD-mdDmipNQ&oe=6A79DBCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsFY1cYfz1EQ7kNvwGDUmlu&_nc_oc=AdoOFbOSstSRNPCQFvbYVV1Kox5zfXMkdGvJvV3Q1FsJCiLTaTbLJhwdrrpeQ5fJqEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGodHlETmXeUvmp_NrA-a0tJUc43u7ixo8IP9XgLL2ueg&oe=6A79D5BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KjN75ED3BMQ7kNvwEXIjmR&_nc_oc=Ado7x51RkWUjF2V_6k7eYckLyRSnl8jZfZWYmf-wrr0DP5KFAkD-rMKu_7aXHgHQC
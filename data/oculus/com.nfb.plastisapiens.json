0f&oh=00_AfzejKMber0rQOSRVkIr-guVygE6T8Dm-VDRr6dt2NRs3w&oe=69CD0EF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZdiZ98VAvYQ7kNvwEeaCP3&_nc_oc=Adqdeq8bH-2QYRE2scDSnD9qT7IsOgbUr9O_cm9GV_jBQqqmKV3gq9hzXxFZlrymxvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmebmOCi-nDpIw1x9-SzZcDhwcfMYCKCn9pICHwaB38A&oe=69CCF784"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKdpCt38MkkQ7kNvwGz4Ri0&_nc_oc=AdoYJx3DLvZ1kU4MaWgrlnBoJykjbpu5uCHcgr3ep6vgl3zafFK1nVsD-3HgvoNvDeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkjj1rnoyJWVVtJtPHLVkvNKnp-mC_DzOJ0mFfV2szPw&oe=69CD2C3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgSMbxM4kqMQ7kNvwHlCtzV&_nc_oc=Adrp8rNfoqptMhW90n9n6evrfDPslNsjr6ZLmlZ7dhEyVf7OQDvXQnit4K9MvRMklgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk4vyj3ntvJ1N4UkGusSkxUvkroq0AVQHJhdvU6KLDig&oe=69CD2A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP8kB7vk6xAQ7kNvwH18K-V&_nc_oc=AdqzKWO0K2PYl_H4VyWbowaOc3n9Dvjwu9XuOgSlNvWGlsbB5w-6Gi6wmOWSJSf9-ww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylJcCD3x7y2Fb9SQZxSBRSjDaGSmAw5f_DtverOKDxHw&oe=69CD274E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emLUgGh3LZ8Q7kNvwHtv-vy&_nc_oc=AdqJtzWTrl6A2Cu00l2J6ogSIaO4yHk673_F4bxEo7aBQeFwu_pHclSOVkpxGc_jJVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmvfK43pBQgCuwUE4r-7slhTXQGk_QsKsgf7tiM2SLOQ&oe=69CD213A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
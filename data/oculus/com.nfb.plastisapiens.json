0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsWOXRy99uwQ7kNvwE3ZHTa&_nc_oc=AdrNIrGnqxjM9cap81UJ9UJ5xzdtps5a4GLPRTwYbVwHVM3F6tXpl-21iupXRHopw8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv-3V1Vt6uXMC1CPwumv_3_1XRKr7_uqMt-qeuSg-66A&oe=6AA6B744"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhbagirYR90Q7kNvwHXsIoq&_nc_oc=AdraQEfM0HrAG07hv8WyuzW416DLu27ddjbAIFn0GFx7DfInLHX55g3deRA_6_CVc2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIChwhpKCluaQ0N7Ebm5uGOJOo6b1_y7tKB9SWidY_pWg&oe=6AA6B3BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHWy_vDCsgwQ7kNvwFdq6qD&_nc_oc=Ados31ganxi40ffsieLQWT_CI-Cf8Y5OjXi31Mij8OUvVNmxw_m4JqIWrBIMr7pv3Pw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8tp1EgzEHMfziFEnT8Hjxl8An9Qbzcuth-pTpT-dXkw&oe=6AA6B1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmTlGWddlLEQ7kNvwFhvnyx&_nc_oc=Adqpn5Jh_Qwll5U3KlO7lYlOYqqxNpNkBUbGZTtsqbOTxFz9Su2rk91HYGeL7Ii-fto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsvbhYgTqBxtyKwyqikNGPG8VgG2wKfUaiEcRMN16AdA&oe=6AA6AECE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkF89XPSyvoQ7kNvwFDLYq1&_nc_oc=AdqZnLZ4IIGVG8YePukEYm_rR1-RWQJH-TTgF9S8R3W5pab7MSjRhoSTp0ThM57bDa4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcSMOaPtm7BtKLNwWYiYN_rj2nRUGuK4UrlspU-wH0Iw&oe=6AA6A8BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXY9Oc7VaQ0Q7kNvwHZf_Gz&_nc_oc=AdpFfKB3wSGRs4UfW12pwaaV9s7qY4xoWlG2gTiWhCLTPHgwAph6xMdb0074Tz7t1
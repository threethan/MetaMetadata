0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH1Tt21-SegQ7kNvwHu4lSu&_nc_oc=AdqdEbo2B1rh9wcvwp2TinYG2pOTNlTtpKnnE8fW2GYOYuw8_S7eP2CTshYB_ccV4WQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpRMkQZjvU-W_iJ4A00_931Sye6gzzkiGRU4n5SxcN9Q&oe=6AB537C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EHdChHwJDEQ7kNvwFNYpva&_nc_oc=AdpB7NgS0Ov4NjJL-eQvjkAJBAGt9igKHYFu4oExqfGmOMlY0ieCIJqlb2ssNJBs_qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9_boG2opM_z9y9XvDqf2KJFnB-_CJahLighLHcBCv7A&oe=6AB5343F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exz_-rJ_BXUQ7kNvwGKDMuV&_nc_oc=AdqBjZhgPUQr8-rABvCVgI11WQIjsvzauPip115pCKPKfobSOCUu2Pl8PkSJa3Djabc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoBFKeppOkXmt9WgYQqHPLybqZ9xjiMPG7ysODCItisA&oe=6AB5324F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rthE1COKdhcQ7kNvwEjJAjC&_nc_oc=AdqRUMPAwYttWqf3CVdrcHzFgsm5v255EsVITf68Dr0fPPWF1NVFP1LW2L1r1QWdpJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJBYBf_QC2B1SyJd_pI8HE-KXAii93CCfW5IJlCTJ3rg&oe=6AB52F4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4jWi6JaxFQQ7kNvwFnJ0MI&_nc_oc=Adq9wX6HSnWyOir11tsqmM92IaWKlPSozjbgKO18S5_oMz4H4Xl9N0QJi0jNMydFSMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYJckJHkRCsfY8KKXNIyzQ6eraEDLs5FKVfvU6vMv99g&oe=6AB5293A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zxtStIAhzYQ7kNvwFAdmDt&_nc_oc=AdpSnufz8UWktmZTqj33Iexu-c6URvedq6vZ13JDL4LRs8rfdOeUf0rKtEOc-0aTY
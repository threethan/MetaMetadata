0f&oh=00_Af-F2ePqrZeZs8xz8Vg3-VozSYNmbZrWXv-hZzn1nzVbDQ&oe=6A2E9DF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPpKxotDGScQ7kNvwEvp-Fa&_nc_oc=AdoRy9yX9dwZCK6YIb7enQ2PsBhZiye9lmZTu1m3YWsnZeUah7jkonvgypBWpBBu17o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RHrM9l_GweivrnnvAUw6o28OYy2-qHnL72_WvacwcgA&oe=6A2EBEC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxO9Y5kvM0QQ7kNvwFv893I&_nc_oc=AdrNSemCp9pxvZZ12pVGxIr21TV_5JoUEiASmoI6XM6raSsSVrkiVsEQ9khewzF0pOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90hix9fT-EzAZeG9ublomjCzJfoNzNG-cFQXh_kaXqnQ&oe=6A2EBB3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u50d5JiNWlwQ7kNvwFQ-MdH&_nc_oc=AdpyjfbEgJ8cjkZk6Hkr6BLnzEY6ZtF7MR9hVO4a4M7Kc5UN0E9oDMjYLz2NGGk_9uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ai5KRI1yR2EDgzmxaYPdVZF-CZSgNqeOBMZbs8ZYS9w&oe=6A2EB94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk--iWEs_eQQ7kNvwHM9Wm3&_nc_oc=AdrFMusDiPRNmWSqx22VkXinyEYf0Z8EWHLzFaQ9pytc1e3XZMTQLqepTOES9yyLfag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3ysHih7tPCSh1ORytu9xk7fHymRfVsqHUI3G0vkXkLA&oe=6A2EB64E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGyE6NeIi6YQ7kNvwEl7spK&_nc_oc=Adq26WxDVxxWAt_ly8S8XCkG3TVxSOk0GUNzog78m9Di1lPe5Y4S3eJYSXBFK1igb7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a1w6PXlZuSGTmRxjAlyOhrH0PhbU0tRH33WZ5csA8rQ&oe=6A2EB03A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYdDGu3fc9sQ7kNvwF1rfBV&_nc_oc=AdoMDfS408yTyoinoKsa2az7eMucD3TOmpxJy9703_LbPAMlR3z3gep9RxZ1Ngx5Kvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcEyLMbMEglNuPH22AtDftckwrAdNaYZ5aKAJRupA3ZQ&oe=6B0F10AA"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "975593479778827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_975593483112160_463106975616273024_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02XgB4ST-0sQ7kNvwGwaEHV&_nc_oc=AdqVgMAnILkyXkM4WZ2MZxcZRjs7HbP0M5GAvGsZj5OywAYrYCh1dCvScpb9W9kZYKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUs5EAJupL8baalVKOvGRspqFCYS-6kocQKnfWOYcqxwQ&oe=6B0F1626"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "722042755767293", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982469_722042759100626_3406365413707921729_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lqIUXGC9h0Q7kNvwEpZ_7u&_nc_oc=AdqU_HODuF5HvXZE5V9nh_HIZTDLL7P3sZoH1k2RVgOuqHodbkZtqc6nWjybBkC5X2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKu_-MR_KUVBGoeJNEsIBFtT_o46y5OW26P4y9IXAI6g&oe=6B0EF8D3"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "425685199462033", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_425685202795366_715112616556668169_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf76JirOYzQQ7kNvwF6eUk_&_nc_oc=AdpNLURRPfpGXpqp2_SSeTqalkDT1-zFRq08E38QAOkuQ3sh6O7RG3CpApyOofuIyds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5pIn0c6vq147yAKdvfXDBiFFJ0naSXFXXrfM3WS9jDg&oe=6B0F0454"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "1585722755155375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974530_1585722758488708_2854031198634892394_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a1zaI02tfYQ7kNvwGvPyxS&_nc_oc=AdqwG4igqjL2NYAM-iRPqEsppfzbGe9hkEh_N_cqPHAjLBoBH4YaOFqRXDAxImvDmG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqUKGVWcc0OWHGelS9j7AidbsooKsMGmUmW69RSvjmcQ&oe=6B0F1FDD"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Take a deep breath in. Out. In. Out. Now relax and contemplate a world where plastic is completely integrated with the environment. Plastisapiens is a meditative virtual reality experience that allows us to consider this world with curiosity, playfulness and even a sense of wonder. Rooted in modern scientific research, the narrative slowly gives way to a strangely beautiful and ironic speculative work of eco-fiction, a journey through time, evolution and imagined futures. By interacting with organisms around us, then watching as our virtual, organic selves merge with plastic, the experience creates a safe space to empathize with a material that binds us all. As we are gently guided through an awe-inspiring universe of hybrid bodies, we are ultimately left to ponder how the interchanging relationship between humans and the environment transforms our identity, right down to our DNA.", "short_description": "Plastisapiens is a virtual reality journey towards a speculative future where organic beings and plastic become one."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nfb.ca/important-notices/#privacy", "developer_terms_of_service_url": "https://help.nfb.ca/important-notices/", "publisher_name": "National Film Board of Canada", "support_website_url": "https://help.nfb.ca/", "website_url": "https://www.nfb.ca/plastisapiens", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIV
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekMsQTEiLHoQ7kNvwFPtz_g&_nc_oc=AdqyO69vujDMlD_VIuc95fL_o2WOoZ2b_vtn88Zw0TNyMPC3Ud4hVaKRtUtv4nn1YrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkYwmOrM79ehCayPc7GRggY2olDqR2jdpUk8yj2Kj1iA&oe=6A9D7CC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsA-6Xgd36oQ7kNvwGHFsHr&_nc_oc=AdpXSgkMAxxabAeSanXDFVtdd0jdHcmv2vvOB1gmC0_30B1rJrrkPHIlSPIUgdQ83ww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEz2C9ZstUgtDmIzibkKvkUYMZ2JMRXe38xmqZHNFsMg&oe=6A9D793F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dobbWNiJsw4Q7kNvwFkpK2C&_nc_oc=AdphvsAHr7QOWFwaU20APNDMGrIRC9ovlTleXX-UTCAJ_hlNa7tx7n22FXHbzUFiAm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNS5_7D2HyhkRN1POtTrPnt6Ysp3gnb2_SoPKeI9ndkQ&oe=6A9D774F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUB1mCsBgtUQ7kNvwEfiomB&_nc_oc=AdqlrgIc1ZhJrqT2R4sHg3AgDoooCcdm4P02Woeyf1048daw-9S7idFs4U3MS-m6hxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4KN6Ciwt-qeuxxOKlhP8pKRTy7aGjiBHHFWth7fWi9Q&oe=6A9D744E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjPNnqbW5aIQ7kNvwH2hdPO&_nc_oc=Adrg0ZBKbLDwxX1CUyJjhceNzv7iYxH4q8sUmwwgsAcWkz_Pvnq0Ns1Ry7ZCxQJGjx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOd6pte-8FXnvzC5JSjUAwg0kq9ZvcQ1R2kMENsCVgtA&oe=6A9D6E3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDbiJ5vUJkkQ7kNvwGxxBPA&_nc_oc=AdqN3OIZbOmy5poxiCaFsZJ6_qh0ZZR3je85eKJOOgrz7MwTx0bAcfnz542EqOTvF
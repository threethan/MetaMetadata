0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekMsQTEiLHoQ7kNvwHCLy7O&_nc_oc=AdpkUvViVUKaVSdBRHJ7mm4VfhWs-u6zNMU0_cZFJld_BlPSXdmQ1S5oJW2AwP5Rz5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITagxlCWuWwgFf-GyLOaRv88Gvgq9de9TcCsIA1rt0tA&oe=6A9ECE44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4viMVJN3Tz4Q7kNvwE0tYZJ&_nc_oc=Adrz8i36v5pnjcd5Tiwy6u317pbuOnhwkAIozIza1wuWBjEqjHppJuP7gpXuXo-C5kY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUObDcjeo6B5RWY9O5MvR4VBoYMTf0GuT_7JVh4MjtjA&oe=6A9ECABF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dobbWNiJsw4Q7kNvwGJTAfb&_nc_oc=AdophcRKA_AxBGcWox8OHwVDRBYRuneAgaXc3uWoNPIeSF9qnTbzneYQG-pFb3bSSDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi6PaQrbt4nLAbBnsXSoB5tBSgivOBV0m0CIPiolOsyA&oe=6A9EC8CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUB1mCsBgtUQ7kNvwE3XxVq&_nc_oc=AdrrKPMT_EQKPDSJQexne1bnon2ZUJpl5Hxoag9w-1S-9h0khI2enoGz5gT10xAMqnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNtRJMAeGavXA2Og0dHFGv9rqh3gvj_rucObAj8x07Ww&oe=6A9EC5CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhzmKM08YkgQ7kNvwH3zMbE&_nc_oc=Adr6sIn0spyjm8GEJyXaW6PcBCEkQriOc0gm6qBP32-Ilu4lZ0xwvljfxm1KzMxtDQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH8SqftYSWSeFKwrarXLhVzs7n4kktn1op0uEYw-n39Q&oe=6A9EBFBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDbiJ5vUJkkQ7kNvwFksrqD&_nc_oc=AdrHok4xnk9B2uaQK_lwCY1LD8xRExiWQt6X7LbUAnhg7_nDbqE_ziX74weEbiJC8
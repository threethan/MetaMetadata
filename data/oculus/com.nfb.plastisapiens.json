0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLQxUa5bIlMQ7kNvwEf3bLu&_nc_oc=AdoV4K7l6pva3MQxlcgFcqhXZENQFcehCmPBnAwsOvGUKZFlk6H_NdN-vRxnPogtZL4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNWFD9dmuc7B9ifeZ4S1OVw_RaBMGFLstBtQqOQFKurQ&oe=6AC7ACC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_9q9sTW55MQ7kNvwHyvSMJ&_nc_oc=AdrYo5Ivt3v-nlhAeE410I87-59quNYHYNu9vIgFGkVX3g0L_BMN7m-PE_3E68syG4c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMzEIpQbGjPtNCNvNE6IkCoaQ4JjcLPXXMF6VyCXCsUw&oe=6AC7A93F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GigwxW4lJpUQ7kNvwE3ekVb&_nc_oc=AdrqRZxei58ehAuT5aoAS2W2S_YDgfeL-JOd0kgok2v3ztYLL4vBQQRBQ66_mIATwN4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9iy31_W3_0FQciNR4PM2pZO6y0lJ1QeQRX2YcuNquNQ&oe=6AC7A74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhIEHGXW_74Q7kNvwECk5t8&_nc_oc=AdrXkfjWn8D1MENt9BIvf5ZUgmTBzPKAq3rCp9O76qeMQ-F0WDweV4IH00XNKObasQs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxPVFyd_CPZi0h7VilnuD3uwxOUVdweMCUIjPxmplWQg&oe=6AC7A44E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6x_9zGwiREQ7kNvwEVTS18&_nc_oc=AdoLqHN9JFCWBHh6csu2dgbypmLbkDhpU0ipfTwUNW6xNpyE-K13MrRBbuwdNPih6jg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOahM79tZc1BcQV6f8brtGvQX-GY6nCZbql9YJ3D9luA&oe=6AC79E3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTe-ANnT_r8Q7kNvwGdE3E2&_nc_oc=AdpxrkmO70zXv1YLBBnZOIVIARYzYtV7uCkhCAg8EQvsH5QeDsh6KeBE8EfKJHlak
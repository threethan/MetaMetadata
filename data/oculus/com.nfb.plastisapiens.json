0f&oh=00_Af3vwy9seWW7k_ArNNsYNoD-G7L_bZsXn6NFA5zCMwqEMg&oe=69EB6179"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFKxeJtH66YQ7kNvwGm3-pY&_nc_oc=AdoiLM9jOcwf4d-82qMTWfMkcXGoK79V1ucdqSGtdV3bWsX-98GVwDSJPB8ExVRIbXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ty75zKJ334S8IgiQ7YIPWzdP1PRr34Rrd9g5ocG2sKA&oe=69EB8244"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOpzpTyXNLUQ7kNvwFgehj8&_nc_oc=AdofdgghoRl2r7jp4ubSVbzN_SaYeLTbIyytcBa2NGP_-ARJWsefY7S1MuN66Hfh0L4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L8z8gWufjXXsdBAQ_Kmf1kTFfdt5sHciBEwVxKTXW4g&oe=69EB7EBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeAhJG4pzjoQ7kNvwHDdCNx&_nc_oc=Adq33lYYv63_fuavMafU2ROyg4YDkhl2jG_Rnwu8lxryQ0awsMT-NojVu6nHEwcnQqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kV8xhrXmbwQCzTTSmmOoIXSQWWD9b3nT9vcq32lZv5A&oe=69EB7CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngXUl1Ij3SwQ7kNvwHjGCwU&_nc_oc=AdqOmZbXnP_1gErjAabEBrm18W8XmRM5QnJFEBabWf7iSi2YTtLBMBH5CkTsTnWak3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MAxIC9C8fM-bFwIN6ThpjgREVO3Mq_E8KFfq16Yb2_g&oe=69EB79CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrjOozRAQ18Q7kNvwGvutwJ&_nc_oc=AdosPxKa5AroOkgYfZNhozWWERF1OzEb3oGDEIySBXIEHTB6hvNJlocLmjFryMHMLZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rkDCNn8cCu9PrIEYc9z7mZN6HvSnO9FfXiEmliTQ2ug&oe=69EB73BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
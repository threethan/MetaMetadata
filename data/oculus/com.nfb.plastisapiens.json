0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glu40RBRPxUQ7kNvwHrOn9b&_nc_oc=Adoqiw9gfPfn6WR4MXi4KvGS8_ea2GTM_PBWR2G-P0OkdFsbrPWB8qTdtDat83qNG-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6thl_g9ToT8-aZ7IEiaPnkieRUOG2SHTejV15GT94Sw&oe=6ABBCF44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOk8BcWMJWEQ7kNvwHnOZUI&_nc_oc=AdpBrofTX0vcClONg9UIxJFDpjklnQRhPKMAaByf-Ppu_2M7wYvgVfeTSJ9Mg3hG6RA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ5MH8UVEQIR1bXgsOLj4Eq_8DyzC5t4M-ihAIzZPUdw&oe=6ABBCBBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPZdyKT25R0Q7kNvwEfotfT&_nc_oc=Adoxbmgu_XZbO-NNnbS4HGANiLtA3susWZ4_Np3j2BwOnN-sOLOWStWMjrqFclRxpOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu7InAtsRbXdD57w0Wz6rMYijwI3ddjUud6ZNAn8vMAQ&oe=6ABBC9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GwZXKNxSlIQ7kNvwH1MFEh&_nc_oc=Adr5Jncs3PA4Ht1VyJB4xphRK3pHpaX57tbERD5ZQNDLksajUMu0V6nSPbS1mSMETw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDFSqEpxhp9G7tQx1RxVtofcnbQbbiGFY8rYR2Mlmm7A&oe=6ABBC6CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUCNCir3BKAQ7kNvwETCfYu&_nc_oc=AdoPPg4DC8uB4wMaB2rKsBIHxNSmu9MJ0f2liB2WKF-C1kZZNi-_eYPCy5OxWwvmP1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFdtyHDwciKtRduj4Agf96o9G9entjB8yMqZqmEF9HCw&oe=6ABBC0BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwgoSX5HTrQQ7kNvwFF2YmB&_nc_oc=AdoGojxVQxjfDA411Jxhw17jzFS_PxBuCORIOvdA0n1JA2Nkve6DRnL9kC-Tui6FB
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlko6hYCynkQ7kNvwEmGBt8&_nc_oc=AdpBhGm6g-GQstizlKGwVkVhFj08mxx77fhNXtOjAEBVWQMorv2Ui7NqtttUFpN7bUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJozg8pGr-x0EOejJuBQT-bocnYVPASSJ-qvBFG0ZYDaw&oe=6A9AD9C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsA-6Xgd36oQ7kNvwFK9kwh&_nc_oc=AdqHZ0cfKmMOt9nZdyJHjeLX08hOwufSfNSxo0L9hAWjSN-IvZZxx7V9PZcGGgzdyhs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0LsUV_FlIVTGGmW-phLbsjuF3U90XGcu9zbQCIsspXg&oe=6A9AD63F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ycEISv8dKsQ7kNvwEPXFSp&_nc_oc=Adq3jWg6Mtgk69IuPEnX2t62AQsuia87znxOEXVH-yfsKlanZJ5nfvMxCjVHSb4Uskg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMHVoFnASPpJf3LcG9nLNRkCzEynWgD8UFIpl_sYwqZA&oe=6A9AD44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUOc7s47gfoQ7kNvwFE0VMh&_nc_oc=Adrpq2RQH3KZCQ6osDo90-xG6Vbr0LZXLXACsUfzCNPtxmQLsMUZQxfV4InFGX62eTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1m-QpFQSALwLhkCi6u-gMWlz8x3Psfioaa2Spz9PAHw&oe=6A9AD14E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjPNnqbW5aIQ7kNvwGLL7pF&_nc_oc=Adr8RM9v4ZEb3nlv3mlzbwZ2JCzWcX9ukmFcMtniwM0illhTdqnwXy9w2-8OXjqpKw8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBZFvO7pDndtGq4SS8t3MVCW3U-nP7Ad5cEvCeLj8EIw&oe=6A9ACB3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J06IOOAae5sQ7kNvwFP5CyL&_nc_oc=AdoFSvc-eNTBwyN4bIkpVmkDLBg9VRmo9X3nThp8h79TLn3Zax_RrYrynJOuxKLcl
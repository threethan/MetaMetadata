0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1D61b53rWugQ7kNvwFfIm72&_nc_oc=Adon-KqB7cDhOeu-ybUmv9vmuzUETIqJAe4eDGS-ttCSKWHp8QwkCnMI6csz9d5QFxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr2zooOJy6MzdhRjxBmc0AOCyl94JDGEhbs4EJsQlAnQ&oe=6AC11544"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hgcStEeYd4Q7kNvwEFninz&_nc_oc=AdpN4Urdz-TyjoVuC-3XsfGswPswLAHf2eTf4UJNC5nEmcBj2BJGGjWEQ1gMRrtSuKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBBZK7boB9mA4esi5XvvbDbw394rw_kDuVwGYucmGaVA&oe=6AC111BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzkhApOQ6tMQ7kNvwH3xBoH&_nc_oc=Adoqh1013DXS6oIthEvyHOiBvJO5prCbwX6-pQg1VsDY8x3xngwCUnVpXvFBpY_GQ_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOnIyewievaXfZ3_1uSo3vWogg54-PgCJzvgtmiCWwUw&oe=6AC10FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5-enX8fyCEQ7kNvwFS9dOE&_nc_oc=AdqAJYPB24SpKIWvhxyRFa1qjqLebBB-ZARypR8l8vttFv_NUtBtyFnImOuhiU8hgxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRLesI_kEeUsrEU3VOhjoIt8xbLT4esuPVRr_uSO3H1w&oe=6AC10CCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw8Do_Ju4VMQ7kNvwFgkXKy&_nc_oc=Adr9w8GZ9cYA1pdv_YxQDkhotImE6gM4fyBYrGvQlxYSia4lPB-7b7qNYma0U9PLOLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlP8tQM0HZLlZ6HSE5HYuNH64cCLkvoTuPSuKA2NpeAQ&oe=6AC106BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xY6p3s9-U4Q7kNvwFHLEsh&_nc_oc=AdpO92-DrcPeowqZhoueC0cjotuj6JQ00pp7qxMr1QOH_vJxUyzLfxlKMWk0gkAjT
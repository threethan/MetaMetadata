0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyDmIptm8GAQ7kNvwFHx7pT&_nc_oc=AdqqL8HMgqTAYqmbIBYXTMRVwim8o4qqe87oq2bLqnhkG0B2FPyEDXk0xcBPkxv2BAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFST51bAsPu1UAblZygprzqBJvQifhgnnTYO7vPh4pr1g&oe=6A7C4F04"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5TZWE9y_XkQ7kNvwFfytp2&_nc_oc=AdqVP0IJvy_NbUOkLQW4XxoHUKKmOw-NOzwRyknjwB_tkQ6DxsAm9W6IR7_z_LJI8as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhKsLaZUXC2GjYeVOOtEYS4hJRXtBKBQkkgFIyg5x43g&oe=6A7C4B7F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfern8ExEOwQ7kNvwHStemq&_nc_oc=Adp049Sz1DJNtNJUJ4VmuRDqmk6cMGYgdHU6OQqRgOQ_qCti3POVsakZN1YW7cXc0yY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHkT_9O4cweVucAbCoMUTnsDIx_De93BtAvL8YOfw00A&oe=6A7C498F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9Qj13vYw0EQ7kNvwEsgFZ1&_nc_oc=Adom_m5TvXNcn4mw7qWbwNR8zGbDvtb-r6lEbjvCtivkCCXEQXiecXKowPjAglw6eyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRtzH1y2826Oq2Q23uI56yBJrvCuEQzVbBiCx97RnbWQ&oe=6A7C468E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTzCbL1c_IgQ7kNvwFT1l27&_nc_oc=AdqzF00Gj_9l_FnLETRtyoxH6S3gorTCZIzgkSzwW-rI-KYIjDQnasGLEvt6OYt31dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRli-ZqhPvpKBQht2HhhJu8BmS1hW2ZZeUHqi9hNse4w&oe=6A7C78BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1nGIuy9Sc8Q7kNvwEQJxig&_nc_oc=AdpYdmvPAu06KTVpmZ1ooxBn_c0LjxbldQwskupzwtB09FONLd9TmRCUnkYG0horu
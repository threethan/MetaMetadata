0f&oh=00_Af1pn5nOAotlSX1MEHEw5WYWQU9whL8-LENv22gj5p3NKQ&oe=69F5ED79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92aUWeRlMZsQ7kNvwEvTTGx&_nc_oc=AdpIuyjaWXGG38fKRtBooNY5pSChUOd1dGQOgAhDImQmYXJHeSvpX5NiBcA8dNeQU_c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RDFUblflTk1cJx6Dhub1b93fo9O5IDs9sEgGu6GuEFQ&oe=69F60E44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okcueL2i38sQ7kNvwFnkpPh&_nc_oc=AdqMfEOnHvCwpxPYenYT13Jx_Xs0dRSY2sLj1FWU9kqW-ym6REH3fHZnj7-Fr5C9_Nc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cft3ebVnrOFIbVL36Gs3ZgKrKceqZJYj_RkDFQLogkg&oe=69F60ABF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PFSvcplQLUQ7kNvwGqdiZI&_nc_oc=AdrQnl8rU_O7zyLDTBtiygX1__ifVaK-wrafC9FlGLSxsFFAiKN3CkAQO7W-8ZtS7Rw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3geNUi96uO6XEgl2T6mLYZU2r-EgCr5REYy2IHykd_jw&oe=69F608CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdEGoFsVKm4Q7kNvwGqxO20&_nc_oc=AdqcKzE3XnDMJ09mYMJ7KUAl-U9UfpW3FnaMk4pDvwTk5fznIlOWL54oa3u7GTLcCXs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FYAJm4V6NgjxNRKvv20Rq44pEhUsLK3UI1e59Nj7x6Q&oe=69F605CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHGXn-yVs88Q7kNvwFsbLL-&_nc_oc=AdoE-gBs8dsQ3_7q8nnNkYzeJQtCqTDKGzJf96_JK3uSsDUSXh0SPkX5AtEjr9l_wXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qusGkqT8NH88NiN0phTWF4HtUQ3_kALDOGDWZoEl3qA&oe=69F5FFBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
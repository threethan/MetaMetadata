0f&oh=00_AfyYOTFjlnhDLvEepZdBdy-2xe2Ps8-d63oCJtQEz_TAgA&oe=69CE6079"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZdiZ98VAvYQ7kNvwHLV2UZ&_nc_oc=AdrsrRBDmEC8XS9rt3xBiV3JyMkXYwxRmAG-WxP7se4tg5YiwJsqWs_6kKC-ag0GQXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1akZS_4Fa5xru7IbvC2UMb37u3IxdqwEcx4NANhaR0w&oe=69CE8144"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1shhuNYaOKsQ7kNvwEfezbD&_nc_oc=AdqTcWhBfUqv8gXwGAmYffgdVGNbiJEzPATQvBW6Q4BOq1XgPuUmuhAGIO-oYQR7Ts0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOzBdE6XUKGDN2Jq5BpgbKXBHGZIUF6vU296eAzQ6VEw&oe=69CE7DBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41VmYvzFvPUQ7kNvwF8kGZD&_nc_oc=AdqVxqHcwcWAkn7nOj2VC6pt2dpTUGAGfUFE-fJLOZpAjJhuQAcFUo1laXwjUxqpkwE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYz5eylVsKNB8X7hRuceMb1RsWIwVQUt8VHnqCtNUldQ&oe=69CE7BCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAOfBHSYUAwQ7kNvwEIndk0&_nc_oc=AdrR9BYt5ACymRf13PzuaLjhMxHcPKRDbIMzdh6QOSYdsWbIfUfWmlNJIG7tev9X03c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcvoLQecrOqmRjPxBxp5BUtt204LencCSbkT_i8kd9Hg&oe=69CE78CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emLUgGh3LZ8Q7kNvwEPzLRF&_nc_oc=AdqaM_ujbvZRor-ZlEwffvYyr0q3wBdCUVgXYpafR_9nmfTO7RHo_O2PyzSEDjacgnA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIvEYfrwSeq7l0CREmAfte_MCRkxADBLOfGRA7FaByrw&oe=69CE72BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
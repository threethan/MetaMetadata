0f&oh=00_Af_Y56niuh5YyaWOzJxH84vfgJS25E8vLbQncOTPI6V_fA&oe=6A450779"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiUPaSEHnGIQ7kNvwEx6Y25&_nc_oc=AdqhLslZwjyGTAnB2wKfgLGJWaLaJ-TGpTGrWUlwxwt0RR_YMZKGBiIwF36ZazgemXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LpcfcoCPEKSTqVzPtxdMirF_XR9idVIRxT19QU11MBA&oe=6A452844"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy0gj2SUzfYQ7kNvwEYUs4t&_nc_oc=AdoTOU7_Rh2sA9rzWa-NSdZrP0Ej1mj00gez-vW6qfZHHAUVbm0rUQw37Q7ZhcOxbBM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d5WwZDlxuAp2xwVeWZxUmV3t7Zl16uvDNU8VspqN85Q&oe=6A4524BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x3zgmLbE24Q7kNvwHTZQpC&_nc_oc=AdqwjTqMFGP1S1eSY0hx0flCNNHGt7pGr3NWauZCAzn593RqGLzT0paiMD1NV06YeZI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uRVxf9SAnmYJYTu17952ey_jbpB7P03lWNCg6pgkcmw&oe=6A4522CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2TeG5zPRsYQ7kNvwG-wp3p&_nc_oc=AdrOwyg7rSrD2Ivkg7A1gEbZ_f-u30TAGE4b9kCJMViym63DSUI1aDjJHhPmz0-kd9w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r20EbA-OkHpsWuOywT727W5WRI_PEzkaZ31d701MQmA&oe=6A451FCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZbjHSCYvtsQ7kNvwGyDT3l&_nc_oc=AdogKPSgZT6zWQKLa3fYCKRr8lsMhLUr3Lqjjqrw-0hQDw9tjml8eVqJkDJphtx5LnM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dpx3Usdh-rrt_61eRo9hc_YYTxJXf52pMNYJFySUc9w&oe=6A4519BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af-VUi-ff4AVkmgk0H1rrnBRP1ba5pWpSj_t10Q85KYf4Q&oe=6A2957F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaHbdsZPuMQQ7kNvwED5vYJ&_nc_oc=AdodrsSMP6Wtq2uRyFypZH2v_MD4uhslrKbIYBgxfFc15XJl8hGrCGGPlaQK1ciwMhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GfxaFZrPd9WJR6EEtom_Inr3RMhDsU1UwJTc8aBNs5Q&oe=6A2978C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XES7cUx3xYQ7kNvwH0Q0i2&_nc_oc=Adq3TFZl7R18khHoFc8O7kFcCcwni0zVu-DIF37IqbwKVWk5vP_DZ80k5Dxa6x3MlRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bYljoPpB9yZP4kokv8bcV-1Zicpum-icRER9gCqRTkQ&oe=6A29753F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmA-gGJcfaEQ7kNvwHWv5tT&_nc_oc=AdpQvxEt-TdGPJByg-LQTE8eaPrz9WBhjOuA1uityMPJOTwEhzmZm6Fot_q7LLB-sGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PYe0KHOoCCmkUlKXhk2nbi901TcmoCO53r4Jjmi0s1Q&oe=6A29734F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LDiqGUXlucQ7kNvwE4h2KF&_nc_oc=AdoUdOejtSbL44vb_O_8u9X2NiMkroUtZY8vZWKbw6YLg_V30bCKR9JtJ8XTX38FtxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b6eDgNHqdjG5TQeViHGzrpCbnQb5MwpgtdOX2trvENQ&oe=6A29704E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPmMsyfG278Q7kNvwGZ6zXz&_nc_oc=AdoPlblRs7dmYw6zXzKhmpJT5qwK8RURrq7SJiHz1JomigPJBeIk_Ys-TXOTUZDxhrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g48gwbZ5yR92j8dO4ctph3scoRFQQftI3diVZUrAgDw&oe=6A296A3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af1HuEVDiQvrWvS-6Pg0f_WvEphJe6fgIpnc_xxtiuKjdA&oe=69DF83F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV4graULJVsQ7kNvwHecoeG&_nc_oc=Adr1K_EUmWPYNzXsgnKfBoy6mgb-UKXUeE7uMhKPDj7droxkLDuYh_eM1jgEkaP89c4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TIeKtC7vrKW82aueWtDHqVsFRKOGKHgtLHUGpNHMXvA&oe=69DFA4C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6kPDmvsh9UQ7kNvwELOuvn&_nc_oc=AdoNwBi-Lr2UdMQcgd8z9h66MM3n3TJUKZ8uOalhUYBci2c6oaGeWlQi2AWOVELOqug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TNvE6lzZMHKtnPQJjD8EfvOlNGkUB4s4_9h2ku8t1Cw&oe=69DFA13F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K0V4UE3VnYQ7kNvwEFCeBC&_nc_oc=AdqnYMqZapixZqbFFRrOOtW7g8cK-g0D7XIBZ5LIaN-e7LNf3rpcMiqkAyKn8SvkATk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YyuYxrD2zq_2GmmXvLJoQ4nEsjnlB5Wjtipv6FhyXLw&oe=69DF9F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV6DAWrQ4WYQ7kNvwFrjooh&_nc_oc=Adr7aHAgnJoMTDVeGxAB7um3kpDbx1nDuu3soDNxYLCU1XfKWRiotKo5lswlUWqGEBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b5kdHn5CKk-DwOemV6SbiCX1W5FSgytKQfgF8q1OwJg&oe=69DF9C4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CFI2mOGNGYQ7kNvwE4E-uh&_nc_oc=AdprzbI3ump1wHyamZCnjuFn5yMTbLJVimBaavyr7aRca0TFN_6F9kBzuaNNjMG1r34&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CJWYDng2CNSP1bqh4LRBzO7rrKsz5fVhFqasMF0w65A&oe=69DF963A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
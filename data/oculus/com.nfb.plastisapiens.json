0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igysEnfXkOUQ7kNvwGz2bW2&_nc_oc=AdqsiDhPLmpBygOnpWNTEyqYwHVOghvUz_4Js1frngPCxx6tiqa3uG7hv_qe8Rbr_Co&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcres4z3dWHnUVVvneKEyxVKP0yFcwHrKiQSjyQLXmrA&oe=6AF9C5C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO6yGW0ylB8Q7kNvwFTl4QF&_nc_oc=AdqPDgAVtyuwLc8Dqe-MTgxUBjhSEFhvA11ZqAAuvDBSKhMO4oVfZFL9lJQDVAh-ry0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjamPf2KrOFQ5Pyuh7c5vgf0XpzKXKppLx0SfJ_ZSXPg&oe=6AF9C23F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtKw2fzOsMAQ7kNvwGkQzTI&_nc_oc=Adr3l1vDfrXecbPOvDjD1JNrTEo--J2irXR5E7CDtvKIsrv2H5nUEzcs0CnD0IY-eOo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrEBT5LG1AJDwPudxCJ3wyujwodECvLYn6y0HJc2MkPw&oe=6AF9C04F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cJ_dJkfNy8Q7kNvwHPTHFq&_nc_oc=AdrenUMMkF6ZxfwFqITUqwGBI4ul2TJcBNoWN98O9daP7SbGkOjtBAzPzi55FkiEj8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvd7ksBm0mj3y1crUYB6z8BF4rXGeIQf0ZxvLpobhJ9w&oe=6AF9BD4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGjGLgCpxssQ7kNvwFxqgUP&_nc_oc=AdqkwYZZpIZSiItOFGrQwguQZj0V0DEHgjlugEHob6XPl3pqvVXxdG_226qZs1-jjfo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQwDRSIUTaqvhR4aOj82S8maPRmj3zkPA6p8-2NgZD2g&oe=6AF9B73A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPJkBukvRRQQ7kNvwEZ3UoB&_nc_oc=Adrfyaz69AWP_a4Bnr1G7kk-gGy7MYdkUpC4DnnoP1h6L8jFPqgebUEhJT9Q3ZAds
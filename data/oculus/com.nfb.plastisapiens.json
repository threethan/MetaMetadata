0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsWOXRy99uwQ7kNvwFGLB6i&_nc_oc=AdrSuYq8rHmAFd26qsSvGoi1dJtUEQQyC1wTKSxIxGyr_wIhoPHjD3pJ-bmdaLyS-Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCm3fWab__PrNHDaS9s8VRBb1ueXh5cWWf0aZu-3uGOQ&oe=6AA808C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhbagirYR90Q7kNvwG2CLFZ&_nc_oc=Adr_eRiaPu2_VJYrcqIIDYV_HMkCVa9wNyJPR2EJlzRSnztkOQOs52ZxLuw_FFL_kWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeH4f27dEbm_7lY-L88M4UOu1JK2JrcJ56EcI2wkGE6A&oe=6AA8053F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGShWtppFa0Q7kNvwE5JrR1&_nc_oc=AdrG07AXke8LIWaQXg7sJAOuM-L0uSAIx1WOdJxvQbTtHpcad2olf2BoCVz8TsyL82w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVvS3LGxDBclL0nj1nUmiQgjGiic2UzBiPoq4D4RCD5g&oe=6AA8034F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y528XzYhASMQ7kNvwHhSehv&_nc_oc=AdoU1ijIXNJtpfDh1Zl7Ptw5tW5eDQ5HRB9-FpYxz0uxiwT4IYy0Rcn2LP15Fbit4BM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8-C97oMdoFyXjWw6metRRNAA07vgceyjquiR_BiBpzg&oe=6AA8004E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkF89XPSyvoQ7kNvwFtrvnv&_nc_oc=Adqy4Dj_J0awnpl2QF0yk0LJQDWBNnH5MH8lxG0wb9-iBUA9ZloLmsZq1hJ8WHZNb5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiScQuZEs7qXaS1wCJ8XC8oNeD0yE0EtwFRwbh0vE9tw&oe=6AA7FA3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIckMGkdKoQ7kNvwHLqTaK&_nc_oc=Adrw2CvMG5HPnEeo58x2mYLfMBne_ewlIVle_SpeA4ziZo3uk1TG5nOknRqCRrn9j
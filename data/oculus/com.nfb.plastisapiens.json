0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jm2IfVH94QQ7kNvwE7ITiG&_nc_oc=AdoY2r_lnYe-J7XJEh4ISmZC-xLfW4H8gnHOVFiXWZiPQYoNyqQt_uuO1-_vbXvGszI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlxyPUyH7G9LAkQKi5fXX0hHebNPXkmNiJoJu3byfyTw&oe=6ACA4FC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwh-7nZymoEQ7kNvwEOmAmq&_nc_oc=AdoNFjEbF2CLVadhhNgsXU86DxQzHfCt1v5naKAs3-pz0PgRCj7dS4ptV4iFKoMFJnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPao3LQcTFnTmDgMHT8WM-6kbFMVspnKQ8HLJMqCftETg&oe=6ACA4C3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GigwxW4lJpUQ7kNvwF6VYj9&_nc_oc=AdrhcpcRxAdQCUOUj1euZNuRBjCQ_6ybj6DIBlcPbI0PBciASYv4-itacMoq9ihwyMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXbM_tG0o8xbqODeqgdD-Pmf16faEyO31XjiIsiaLkIQ&oe=6ACA4A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhIEHGXW_74Q7kNvwFn0EWo&_nc_oc=AdotBpAB3oQwVn4MYOCG0Xt3oSUotHtRsNRVwQ6UHdIbVHq1D8GuWGs0hEwVScZY47c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoVAVui0op_90eiCPSlAFay3fgHxB4ceORCQSmFqAksA&oe=6ACA474E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQuaX2YnfAUQ7kNvwEdXEaM&_nc_oc=Adq3wpsHPPfUQyyXOxYjPKfOo0k2xLveQ82LYFrHZTCDgBGo09zr64tuaM0EZk1ml3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnxT0fBL4Xl09m_YVlDSecfLzRg9jIDap4zzOF22G3TQ&oe=6ACA797A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTe-ANnT_r8Q7kNvwE4twxK&_nc_oc=Ado5QyaUPEi6rHWZCuCStWIgTZ44lJlZ2FPdu9oMBpqHtLeJ46eAHBdBbxuuHHb-Y
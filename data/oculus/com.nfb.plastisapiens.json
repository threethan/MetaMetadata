0f&oh=00_Af7CX9qJGsupjIx4u4vfmhxTfDPU0fF9waKBf0EV9RmpTA&oe=6A0EF9F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL6ivB6yYuUQ7kNvwELg3yf&_nc_oc=AdoZXxvKVihXP_gVQIIT0j5HWfi8A0GZeGWL8xsLp4GMSvSl7awOLWbB9iC_dHrBbp0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M9hPM9BOlOpTpTg2GOTyvUI2bJpxmmYMOPBosByeMjQ&oe=6A0F1AC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbH9Y25eGZcQ7kNvwFHBXX_&_nc_oc=AdrZITrHNySK6egb5qjsUK9grXD68-uYxeijLPZd7tMqsRgJ-5WEv22lotV0HEyo5JE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V6nuhroMZk_gyJ1KBzEsrtjjdqnhg1SXFW-TCqk41YA&oe=6A0F173F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsetnBkI8iEQ7kNvwGr2aaj&_nc_oc=Adqpplr5eXKsmnMSBccsf9_Cqt79LjcvHBLwsSX4QIg38_T6-u-b-7E17Z2JlvsJ5kI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mnl0a5KaB4TcoqHoBKsUJnk4neZD69Ujwqo4tXCpcBw&oe=6A0F154F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niV8ktkt8mwQ7kNvwFf50Kg&_nc_oc=Adpa4PGmu6-X0TuGeoEdBJxIDPxAPOjJBskwdbXHE1Et8EzCKXLXDysI5lfNT3XnGZk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68wYYEFq7biJ7T3ljZRhO9af3YKd4W_j8c35x-Ij03sg&oe=6A0F124E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcTy6w-ibq8Q7kNvwEnMdDX&_nc_oc=AdqyOCem6cz7QRsHqaPwuMMhvFf03XwLlNmf9PnsIrxQ-NBouFsPLSHQ9CKNXya-ZIw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zMDEIEUO2mEB5cXy0O5IN8fE6BhP2pATeEHxbGBZuRw&oe=6A0F0C3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
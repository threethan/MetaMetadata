0f&oh=00_AQDr60kejn9HICGmLzemVWd7AHsD1NpWH4Qa2yio2Vu-3Q&oe=6A5F6579"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YIOPi2HZhsQ7kNvwFXfnDh&_nc_oc=AdqCoeuR2ChrPje3PvbiWNR9NpuBMTLo2C0JqdyaOesXVLSGpYcpsdJm7K1QjLKyp4Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQAiDvHlG64GB8hZpljAb-A3c4ju81DkMNRtrMakWUyw&oe=6A5F8644"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6exUxKHDv-wQ7kNvwHwJV_T&_nc_oc=AdrxLX0p87WWzF_it0QoYfKyfBRXjXX4AV6WnnU7xWFpiCDO6qZfIEwJu43Gvq_P3XE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgJWy_Cgmiui1fylk8up4dt71Vwt2YJG_V_Cd2Q715wQ&oe=6A5F82BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j381lR1SysQ7kNvwHvKa-h&_nc_oc=Ado4qgWjRXbizbGDLXG8Ra9XDFqNDKi3mbTXtFLdtbjUu5tcIsifwwrxiU876WC9v9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhvhqunnb9MBQpcpwrpJi83xY6F42_m16-7-KeLJ7M5w&oe=6A5F80CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ToQRCW9XX4Q7kNvwHyJuM5&_nc_oc=AdqakB2PL07bCnf5WO6Czc5pL_Vnid2tiF70A2QsZzcaTcXPWCX4SqiGVz7xQPpG6m8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpzFv9fjn12IuzZ-L2kdpHLDLrk3EWU_1x2iCFpLpE7g&oe=6A5F7DCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcna0DVAkBIQ7kNvwGhIDBp&_nc_oc=AdpPMKhMXXCuhIdmuqGDdkY_0kQShIdvQzD7D6oUCShx7j8-R_f3QbPriPuk0oN2F6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd1AOuWgp-_0emBWFuXWNdf2dZxFMMvyFN53WjfEEhtg&oe=6A5F77BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
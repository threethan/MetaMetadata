0f&oh=00_AQCDc5ywbw6lTPJoiZmUXV5Gv_vhDzPuwVt5B6ToYqkRAQ&oe=6A4A85B9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9_iqZYR9rcQ7kNvwGkIpdL&_nc_oc=Adrz4aXpYU1Sg8wBzEVPAH5T1p5vVrXwq9GZ8-EPL-r6I-4sUTaT6D59W72N4aj-J3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAz8_EuittLh1HbC_s7xznCqiLGez8AHYb7NruOChuTg&oe=6A4A6E44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pAfPwCQn7IQ7kNvwHuDcEl&_nc_oc=AdpVU8apUZagkjqpy_uY_6dFY8i_RQ5fvxUq9qENDZnOevMhwOjOgRzD9jquxCHGyms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd3gVgYCaAe_RLf5zPcFR7rwPD2drR1eW0l6__9Wg3UQ&oe=6A4A6ABF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyOcFtCngegQ7kNvwGPzKok&_nc_oc=AdoIpwvXs5cmmS3q4EcludZSiHaMJVzk3mk7ld3wyYw2t1MfODPZSe9a-zK733s6hfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzXOzFmXQOw8zCBKFZgHT9Y1-sdVH6-4DkFb54E1PtAw&oe=6A4A68CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK939WdJz5wQ7kNvwFJ79u2&_nc_oc=AdqeZwVYKSljvzVUgN2bC2pzUf-9R8JEumFJHnSGJeUNBGq62lBDya4_atmOnL3a-YY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWXpSJJFIdrGiRffQgpnD294NPGxpw7X6BsO1-rBEl9A&oe=6A4A65CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfXwWxgVK4oQ7kNvwF6R4Nx&_nc_oc=AdrHcEwwzLmPrmn1F9z4rvaJ32hIp9t8w5KfBUNaQxi9YKw1xMV4z96skpI1LgTebTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoCvneoqpgi1VIJPPDv57BpxItPn72a_EQT237neA6rQ&oe=6A4A5FBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
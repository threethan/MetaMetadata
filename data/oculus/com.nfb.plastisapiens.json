0f&oh=00_Af76X6ttKW1-Y3AuCBONds21Jku_GQ9tpsNQGwK-awRVbg&oe=6A1C6139"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0TgUHWkB50Q7kNvwEetQTy&_nc_oc=AdqgNxH9ZtklAQ5vg5aXjL6lK974_GGwL3QK1cfHInLnigmtBks0cNZcH-Ij9JY_k7U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56v3xWRoicHKYF2gW013MVMWr0aezt9Lyku_3s2XeiRg&oe=6A1C49C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9fdz9BJ9oQ7kNvwEd3Z4Z&_nc_oc=Ado-c4iN5YgoI0FJSittbR0wdzdS9J872OPy60_vi6Nn-9ZhnRDvBWrgFjb89lDpZ0w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aOq591DuFpwPBufBlqlq0UrXzQU-HZLxFQji5NepZPw&oe=6A1C463F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RgH6lUPsPUQ7kNvwHXvuP7&_nc_oc=AdoUQm98ObifQysC1U2PV3FfD9-dzqzQvdpSfDgG1R8w6rWVNm0Mhen1qYvLrWlQrvw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TneT6J-BSo1pE-9EPfzbZJ3AuK-Qnt8l7JVGgVyMv8Q&oe=6A1C444F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odx2-OqhTvsQ7kNvwGuQWWP&_nc_oc=AdqXlJumvx5IoD3moufX4YXvvG6QJoyoS1khKFP8J7zC9Ws0RuiAgJihuj5XDyy7V2Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yDG3CQ6cZ7ICKloC3nKBki2tpy2vgFwApPQFiyn1FjA&oe=6A1C414E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DODuL0KkyuMQ7kNvwEzumyA&_nc_oc=AdpgX2BKDEkPtRgSxYNQn2sDGkg6JOvianlKp_Ikrzk4lbX-1hVpuTqJsshZpJh9tGc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65mo2-7mYRJjiaMxGwblL3jUm9ZnOntOj3IzrwfL0c-w&oe=6A1C3B3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
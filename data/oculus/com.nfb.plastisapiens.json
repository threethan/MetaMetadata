m&_nc_ss=7f20f&oh=00_AQSAhFDHs8WWkF9LZcE3vb-lc1CfUPFz5Zv31Ie-nKIQSg&oe=6B0317B9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSO_eZRDt2cQ7kNvwG4yi4x&_nc_oc=AdoqBrypVKxupdq8E_iDqftvkgRV2Pt2guq5ka-C2o2-Pgrk9i9GlEzZyq5p_LfYMOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnqix0iSabdTkoopSQnz5jtMhuRpUgbUIj_BPdRIF9ZQ&oe=6B033884"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AG8gtgK8FoQ7kNvwGGReSv&_nc_oc=AdomezziiUD727_JSoWMqaBj2Lbpc1NWDXFkviKf3Y3Ji7t0BadrpSUcO10sHEsJ4t4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzFoxSAXjXab9tCKjRLXcm8Tywwvw4Ukdt4zuYwZC9nQ&oe=6B0334FF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ktVosQzhSAQ7kNvwETQjmg&_nc_oc=AdqW0hY6EWsTuIhmYbGKrpZc17BNEjX8g99ePRLy6cQQtnhfZ5YnDKZMxyhLIwYIh5c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST-cBPbvTBGr7CVAq33Wac8hcqsbqBKHOSzPIwwfOsTQ&oe=6B03330F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDYF0qx5PssQ7kNvwHDMqRX&_nc_oc=Ador9bAnMJSn9qMxbDoDD0zdIwlBopgEficXSQSDx9-c-RDv1hRWLHqao1UkhspcbME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS20YB_mJX8Mh_9fAO0eAVxs0ro9QGhnQr9WES7oi2lQ&oe=6B03300E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzoFc9wVUn0Q7kNvwG0g1kS&_nc_oc=Adq4i1PaQXCvhD7vASzdUUgS8VXNXfBelb5OHK-2lE6MLcQj5raYqdmYBVzQjGv2Dfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEpe86LHNOxHpxWSpPDFFDXompmZbKXD
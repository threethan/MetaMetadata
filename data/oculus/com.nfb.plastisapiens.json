0f&oh=00_AQDXtjJAhgvGzYoObsRgg5lvnTkTDwyJ3PivKA7MPY8Ipg&oe=6A5A1F79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzP4JtWTCzkQ7kNvwGlYto3&_nc_oc=Adp0UMVnwEywAL687zz1IOVD8eWBs5LhomRawee8_jXBb3_uEYQq7dPvnhro-8xVfKw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn5DNIHD-puiMw6Erv9hjDxkhsyG03K0Z62Ufi9aqTlw&oe=6A5A4044"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTdGBnj52DcQ7kNvwGco8wm&_nc_oc=AdqPod-D0i5xjmfo4CO3VmozgRib0Qvix5Ul1yITX0BxI_oZIhaR42ZGMU75xns8sQI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdmV7Mvn93V4hVqOIBh_PC6prsDANd08VgjsMMEfdA0w&oe=6A5A3CBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuQybU9NY-gQ7kNvwEttUbN&_nc_oc=AdpkXBYevUNgPOsyemG3niXTqL7CQHGMmwHeciOEMvIgDvxT_tWdr0vmzhxFuYt4zWk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgOb824zItfuXq4GyhK9kqyc0SNJa7WkRAebHXPa5EVw&oe=6A5A3ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjvEL2CCprwQ7kNvwF3rwoQ&_nc_oc=AdpYwYgmwUjllG8i0-6oenc8TrL8AQgQtKM8Zz_WjDqRJlzAGuhNiZ9wbQsnD03GOCY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7MYwUlzA4gV3t0RMVe1ziYzYxCiLJ3Uc7poVudjcgxA&oe=6A5A37CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2WwML0YMiYQ7kNvwGkFnxW&_nc_oc=AdrHSEuaaIV73JbTyn2gw_1wkmYHlGnt8ZN_pPU1Bwwl64r8NUKTemIBvQqwc_CtBLU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-_HTivGncBOG4qH8TK-0Am3FyGdczQ6P-g3TX6dqbxg&oe=6A5A31BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af8yC0AKWQVxRsRVW3Wa4XyUJQ1usvYFpvF9su-r2NSafw&oe=6A356DB9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2ndqAMJBAIQ7kNvwGgnNKd&_nc_oc=Adq0UAIoWrhOprDmlVWHwY1WVLjvQ43tSAvl_Tqv2Urb-geD-GVnqRm7IjuTcJkWra4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fs59GbmfDGHZSi06TVCUm4ZAXxeBnxJhnOB2yO82sZw&oe=6A355644"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO8niUxmkqIQ7kNvwGE2ApD&_nc_oc=AdqEsEsriPl9CgYLrcYGns5cDjwoeDouhzcIy90vdBWl7Ch_TI44eAi2bEWUwf8vz0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MOvZtnSt4hPfC1XtwbvUaHrmAZqjXnyJBtViF0fq4Ew&oe=6A3552BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9Qt96enBb0Q7kNvwGLWCYV&_nc_oc=Adoe0wMhdwNSUntbOlZpdX_fHC6f2iZ3yiwTq6lvcVanaG1dpGnw15AIqWVQ5h4c6Q0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jJBZ4Dl4s7Zm8KvT3-LGeB0mpsVMSmSl-ROaAWWwoRA&oe=6A3550CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBC0QDXXLb4Q7kNvwFrQWQs&_nc_oc=AdpRgK3zxfl7YnAKgWcoZuVlfKl3Mp3DbDPpvzhyHZbnq4mzIMEkuK_8P-KzQyFTOQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qgrG0C5_Cke3FWzE6QGFTpr-C_SI730QGlxleMQaoUw&oe=6A354DCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX0mnC6U5g0Q7kNvwEbix1W&_nc_oc=Adr8_eOKTPpPIoZnVR0ja7S2jedaCIFwWz59dbH1BT9iRr2BtJqIUxMEarl1y0RXkDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90rInBbVQqsnnVVYCRA2UwZj8ah4RrV81UFKyQTpqm7Q&oe=6A3547BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af1oB0Mur6qAXpcUaR8SRlHb6Y2AYpaJd26Qdf9zwbNVPw&oe=69D64979"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IewV_HHyUxgQ7kNvwEiFT6D&_nc_oc=AdolJhinjsr7WyGnf0DbkIJVLghwLdgI_1o_MipAMXKebUADtZqzIkMzS7Rsyztpp2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uiuNkOoX_H7VZ9qL6AKk6MzXDHpVrqweKZ0nwD8pwNw&oe=69D63204"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQQEp3h9ObsQ7kNvwF5ZvuJ&_nc_oc=AdrkrSZPIXcrX28lz4V2l2urjfDUx8kLAYRhmHYdBPHyFy0zgoG_VkPr81t1Z713dPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KadDRJumr7cD2RWhMRh7tGI9-Zy7osSfhFZ-Cc99eTg&oe=69D666BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaFe5-Mho_MQ7kNvwECwbxd&_nc_oc=AdqN2a_G9ZQm2ewsoixuWuPvhrcgOgXL0_txCdben08XN1Hxr7eFQn8hp0hNmgcCqus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jvGQ3CEW3jMdJMhHi03QuS7LoMZ5ajS_FgzuNWYzlvg&oe=69D664CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyErlNi1V9MQ7kNvwEnTzR9&_nc_oc=AdqTxZuAarcdLVDXO4rvb0n2NTj1AH83vRcXJbzhsx0IFGeTB3eJ8Nkpv1hRWMLyRkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tw4a7BB9beJwIGktbJ5dM5g0Kj6d1MH-j-pGRslRVCw&oe=69D661CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2AcAssYbskQ7kNvwGKhIpL&_nc_oc=AdrwifDFFpNzo8ClFtUfEHSfZln4pVrQ9AM4ZhXUB1Sb9ji8NlP-zbRUoUl7NO0KFac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jDzBGdyKoPAATuiajdWar8Td2dFblngprxYJ0b7z1lQ&oe=69D65BBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
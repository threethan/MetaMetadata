0f&oh=00_AQCZc2fBtQ25HsJUqNUUQqWS9shmJOwaIs3A_MqGnvUM1A&oe=6A54D979"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP9fe_eV4ZQQ7kNvwHtGkwz&_nc_oc=Adoo3bMMkUCpdZbbGublkKnLEmgPLPVyUOZ_vioklAZuAT_920tPOJSkAKXwTXCNhmI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD53EIjXPCBBqUNVkvHrXqjayejYhLJcQkRDj8UANWcBQ&oe=6A54FA44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kW5gG2RUCkQ7kNvwGg5erl&_nc_oc=AdpYyqytYiVS6B2nvqrpYhs0Pwo2zzKoWJIm4DHwyGK5h3CUPEMhl1c6pm1pzdRQURE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA47lxCUCcG85PtZData4LMT1P-PaNyBmllW61oROCcFw&oe=6A54F6BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTZmPyeXNCgQ7kNvwFkNhbQ&_nc_oc=AdpuOG1a6f85IqJLT2h6m8sJkthIRBhHEbgWPCN64dpHNSxAvH58Hf4QtFWl6Ateatk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2rb1BZ7OisZ7SSEfG5TpgAofz3ihYI8jMPhqc4LxHmQ&oe=6A54F4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBYhzaIw9QUQ7kNvwHrxEJ0&_nc_oc=AdqBnUjPkHroiiNdo8CDmBF-hVl8ZYq8lhpGDTPOzlW-loyEOBex3EJ7Pwc-9naechM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCueDTtX9JPJ6P1-iRsvp7BdJA9xK0KHExENlg0w9kOWg&oe=6A54F1CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hngPi-ajEPcQ7kNvwGy0f1Z&_nc_oc=AdpoKWhMCcA3ehURMBOQCe4qNm6uP5TYZpZs3CEv6sJX1cIWyqc_RvccYy1Ine-TgdQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCODHaANDZubAxEOPLv_5SrcmdL5TZW8KcXqgZmbvBv0g&oe=6A54EBBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
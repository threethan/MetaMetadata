0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8O-aUbEu69oQ7kNvwFhN_C4&_nc_oc=AdrOEynSrWXjSfqFGWFxiCF1wm_WHaNtbCDsH5vvgotpwpxA0VO5f_66ojOzDBEVeFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmmopiDISagajRgyAoGlgPW8hx0TKa6RMl2veq6rTHWw&oe=6ACE4444"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uaCkMgnBYQQ7kNvwEX0iDk&_nc_oc=AdpAWuKLKvq9myh05trf7Gb_ow5M5LHkAtTBI76eReGo5RNrVFxeU5xfOb4dcjS9WIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtBhfT7qah5rIrydz90afvj7C9Xh9Qr2yEKtqJCFGjTA&oe=6ACE40BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkXYlHAkFsUQ7kNvwEjP0jB&_nc_oc=AdpojtKgSyEel-I2XbXElQGOWlnNE-8rf9YHyIoDJnP6ozYT4FN7KuJVvw78sd7wjak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgmXJca2lKHRpXIBGZiFDoYMFxTGzShbl2W31QvN295A&oe=6ACE3ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDqUbbhki8cQ7kNvwFWlXyS&_nc_oc=AdqoTkA3Pqmx8lxck7Jq2urCikvEf6V3hThcrVK-r6pFJkrEl_FRBq9XLM7GPkRZuAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9XwITvr0I09_B_P0duKVRw2tF9TuvWPh6pqsTdFSpDw&oe=6ACE3BCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guCnFxCOZewQ7kNvwFjnN4J&_nc_oc=Adp-jnGHzC2WEDf6UlRpo_KiBQRGF6BM_p-Cw95gAP7PoEVZnCbdEYB8OpQmhUwBPeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtqfRLBOU0V4H8IIDgtYHZoiO6ooCn6HHVXVNoxyT-oA&oe=6ACE35BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGUMJ9RG9xkQ7kNvwGJx_yE&_nc_oc=AdpH_Df3N9Krj9YK4j26YbTXchF5dzcXqeOonrKhEaSqh7SpnQUjVXpk4fbQZE0KG
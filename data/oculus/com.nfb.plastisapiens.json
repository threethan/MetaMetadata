0f&oh=00_AQC4tITIp5oheVqqbYmMf8iWPjptjjMwNQo5FAL-6un4eA&oe=6A4F9379"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE8Pan-ghsYQ7kNvwHe0aVH&_nc_oc=AdoXsR1YJIRnxJRKar3Sp0FxUkfMJ-eucbV2KlnZQXHbzMKv75r-TuH_nmu2RVS4IKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcPBco25utLNBk33afWHFjYUVg31DR_2xi7TZc644oIQ&oe=6A4FB444"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nBi5W8tGKoQ7kNvwGmI5qk&_nc_oc=Adr-HZfSAEMizF981nHWz4S5mdzvK_dzHb8tfNv0Mk1hi59zM4D7NR1Hg_nCD5wXsoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZENTOfsHu89TDRrsHXDCDu9_oOxef4luGqnAu_vWIHA&oe=6A4FB0BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jC2TDiDN8MQ7kNvwHsvYSi&_nc_oc=AdoOsZM7LaRkx58UatyYglj2lGm129v-NocVjTyHcqaCBhgPNq2KvGwOrWTEwwsB6Wg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFyOtR-YsVGHygZXq2nK8ZZe7VuJMF0Qiog2lbN582dQ&oe=6A4FAECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c9KgQMKvXIQ7kNvwGHXD8b&_nc_oc=AdolInLe7sCxY1klM7iteggfqk2xJfpmjaPK-h1NYKZb9pqUAVa_x9R9TaO_RLmU-8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj2AiD4UPOGlfyboQu0LhBMzqveRv7Fo1Oq3kwKEixAQ&oe=6A4FABCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NESzGkovT9sQ7kNvwEcbpPk&_nc_oc=AdrzFQXuLKoUNBDRdpzzFaF4tKqpQqU0ukEavSjaMrFgKT1BBDqEC6g_KsSWaH3JdK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA26a-t_1bzbyLb9_1ZvZvWZjpMaH_RRwp2LZcE3dtlCQ&oe=6A4FA5BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDw0OWAXVDEQ7kNvwF6FtYn&_nc_oc=AdrtsukTF1UNCwC2J9D2mWPQHwlpI7YmKe1KGxeyUY4xnSHBKjaZBw7MFnfUpjb6kbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTA7w1i94BHSYA4uQcLsd7o-IayUoMqYinhiuJTKwiLWg&oe=6B0DBF2A"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "975593479778827", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974453_975593483112160_463106975616273024_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3msBdS_BL3wQ7kNvwGosuEj&_nc_oc=AdrNY9QdU6ON0JO8y8hwZS_GqBG4Y2ntpvd22vbwa03cEUzqFgKBg7xvZjDUwMFHPuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1cB3FwbyOmApW7l1fzsWjWT8SUdj4SI7YpRvgIxRpjg&oe=6B0DC4A6"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "722042755767293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982469_722042759100626_3406365413707921729_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lqIUXGC9h0Q7kNvwEnThup&_nc_oc=Adr_R_PipyT3ENm_uA-s1CXNrIixz_AKx3wvOWdSf4puIIRf47kLElmbO3HkhiBceOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZC1MhLdkMEpSV8yMWQeHGPfiw-_wYIs_-WdZpChJtEg&oe=6B0DA753"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "425685199462033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982441_425685202795366_715112616556668169_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf76JirOYzQQ7kNvwF5SRoi&_nc_oc=AdpMn45ughbjmrQDiAPrNA1N2RPXmmvoPjCBpin0XGA_idxluSrSGniVxKFKT-no_cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1deICz3eYsVu5Uw5OXiRnc3qgioBxxKtgAyI7c_-CEA&oe=6B0DB2D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "1585722755155375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_1585722758488708_2854031198634892394_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQajX83BZyIQ7kNvwEjFCt_&_nc_oc=AdpXh5LE2oSoR_Ivcj7lfPKU-AzJv-EFYZyXeH7GArqekOcAWq9nr2fOVoHNKHM5PX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsrNcVXfU2krxsgEYyvJw4pXA6-KnX7wGpl1cfOxwdow&oe=6B0DCE5D"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Take a deep breath in. Out. In. Out. Now relax and contemplate a world where plastic is completely integrated with the environment. Plastisapiens is a meditative virtual reality experience that allows us to consider this world with curiosity, playfulness and even a sense of wonder. Rooted in modern scientific research, the narrative slowly gives way to a strangely beautiful and ironic speculative work of eco-fiction, a journey through time, evolution and imagined futures. By interacting with organisms around us, then watching as our virtual, organic selves merge with plastic, the experience creates a safe space to empathize with a material that binds us all. As we are gently guided through an awe-inspiring universe of hybrid bodies, we are ultimately left to ponder how the interchanging relationship between humans and the environment transforms our identity, right down to our DNA.", "short_description": "Plastisapiens is a virtual reality journey towards a speculative future where organic beings and plastic become one."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nfb.ca/important-notices/#privacy", "developer_terms_of_service_url": "https://help.nfb.ca/important-notices/", "publisher_name": "National Film Board of Canada", "support_website_url": "https://help.nfb.ca/", "website_url": "https://www.nfb.ca/plastisapiens", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIV
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viDkQJMee_EQ7kNvwGCJsku&_nc_oc=Ado1rnZs9J8voZ9PgEFoQ4v4KZSc6NeMEUm4neMbNLqgz_5uMUK0egSm73e4XVDnlt4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBPNARSpgZQ4mNeb1npk_R5Gw7TkJNBx7kALOH02OhYw&oe=6AAD4EC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXCzS98d6rgQ7kNvwEymeEf&_nc_oc=Adr9fbxtBa6KKVr_ORYw2zNwW3OKRsyJL5IPF-wlpdvP57cBaUWC3ugypzcut3hbGYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_7DxsqR8jdwOD8Bsc1qW4QX4YqWGjFrcO3S3FY76yIA&oe=6AAD4B3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4QjR0geQlgQ7kNvwF8ExqJ&_nc_oc=AdqqRXIHlyTo6gIy1t38lyele4RrZUbJ7nL1YX_0dkBDMx1zp4HmL-sf-eBXkqIzjk8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKU5_hrHkaZ4mpxsn23l0qJTT1lh1FcBYVbjwCeG21-Q&oe=6AAD494F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF3dJIoby8kQ7kNvwHUBWVW&_nc_oc=Adq9_Dl2VnIFXSo6x0Ps7rCFE1ohgwCXbuEt8NsBFnygx9egjhuTzoinSIyJ57MuUHM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj43tFqlkfri5ebTwklKCyfmDAIQOu48R_xD3gBV2cFg&oe=6AAD464E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0uz8OoPdEcQ7kNvwHK8iee&_nc_oc=Adq-cEdeiJMrE68Cq9SrwHB83fG-L7GgVyi8IqIAVOxyNKHh2kPDSp8gdvd4Y7PSD6Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-dTiDmdaVI6pgvERAmqByzqZusJzAiiiahUyjoloS6A&oe=6AAD403A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMs_EseQhwgQ7kNvwF5eAYq&_nc_oc=AdobngToehfNUS2065PxCNhX5CcEfjkCI4U6DxEyEefCiTt8kj0QqUV4lunXfF2u0
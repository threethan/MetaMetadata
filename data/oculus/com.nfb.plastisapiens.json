0f&oh=00_Af5LCYCtPg2kRu8YPiW9a-MnI4gIidOG1VoJHN02BbzABg&oe=6A1D7A79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0TgUHWkB50Q7kNvwENQuMm&_nc_oc=AdoB-iTBEi3DimymCdFS05Z3A0nk-hH7cU3oFk9iMXqOPrqxfAl4Myu3pAdSdLRDo-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IKOIgWRt9hhn0Fut3NvNn-KB2Pq0Z2RpAzsvDR3AgLg&oe=6A1D9B44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9fdz9BJ9oQ7kNvwF9sYZ2&_nc_oc=Adp4eJtOOnDz8PxqjW5jo2eqjE-mJG2PvBQaRuweOY2SN2QmFL4l_hAJIX7qDBFZrlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wUSjWC6AxKv1rDhSBb5jweo-P5ZENhff6IIkQHUXljg&oe=6A1D97BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRAF4KDy4VgQ7kNvwE9pgfC&_nc_oc=AdrIbM0N27EXg6QdkFbSSM0SrIcRgr4AsVudHjTsX716fy4HHgC7uK4ZIO72tKbnmXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NNW-N2jC68ukIKe9X3Uw5IDUGbczUBLVCTZUT9WK90g&oe=6A1D95CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWXLeQEcEr4Q7kNvwGtX2Ui&_nc_oc=AdpUwXxHBjdBDax-jivg0gmiwnASrUD4K0gSfZY9LKIeGkdV4meUxhGsQKknmp0co4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cl5DHnSy5hQcdszEqqddxkYJwULHNcVyOQwtxMc7gJA&oe=6A1D92CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DODuL0KkyuMQ7kNvwHGSw46&_nc_oc=AdqhJ0o0UITljR2jugVq6au49bSy7vXWqRd585yI9YGyMDPfbv2KHPjf0Scwr2MWHDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZHyLVpK4PVMTvPQjUmQIDjEQoIvgwJXnwfnPpLWKrEw&oe=6A1D8CBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
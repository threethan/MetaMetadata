0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1do_H2EjB1cQ7kNvwEQH2Fa&_nc_oc=AdqZrrfAw7BdArQRv-8LxtqEUywPb18xQPSqFB0qy3ozmewt-snyWvycnfD6_EvpwTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7KHyMGT0tKv_-9aZ2UEgT4sCEVZul9g5DfMINhbMDtA&oe=6A707184"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a46ULZMTi0Q7kNvwGHEkaq&_nc_oc=Adoj1O7Gll27qgaiNTS3LjUmEQZq0F6ShyvDgjjRe_67NpGFoNBrMDnnljIS4NbUykQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDJxwJtIcWxJUfXyoKwk0Vs0C10MkKIzupo0vpaczrAw&oe=6A70A63F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzc0FEJnmp8Q7kNvwFsOK4F&_nc_oc=AdqawzfYGXBNSIKctqGxV_E9nQZYyvQbeWDcJOVVMDuMi1AYokvuhJtdTqQOG9Lu1Jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd-2FHqLI-BC0F97lO5p8svdhQKWBdvVJy8IXbU5D5hQ&oe=6A70A44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa4pixIldv8Q7kNvwEQ_d1w&_nc_oc=AdoZUE6JxS80VYuBToqlXpQoaDQl6UUS8FetpGtPNPIYNcomvKB0hCTHPjA42unibYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4YqYg1VAAJe6HeXWjKYGIqmP-hRpqHMkVKAmIs9pX8g&oe=6A70A14E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk__RSXQRrIQ7kNvwFy8he0&_nc_oc=Adpsex_bj-Ugrekivg9wWir0tmjnc2MXHrOeMhAQGtsRdJh9Y4QupWp_Mgz3S0go5_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmPZkcewIvGkwmsC6Eow7Jy07aXFT8DuKtlz6wCWgWhA&oe=6A709B3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68wgrLGA1gcQ7kNvwE4gML-&_nc_oc=AdoExeCE4XaH8htKp2XpxNZC6JMd1ijjabcT7U62UqQRsO_JEWq3pSrj8sr4qLY4n
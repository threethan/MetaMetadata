0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D3W0VjRkRQQ7kNvwFONo17&_nc_oc=Ado-soLs4aufOm7K0hKeMvJC2IV_RxMMxiEGM8viTr5Wvlv2OrLNEKCzGGwc0hultns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPLq3rVnf64QRRjMNV4Hjf9btmxYEmKICUPIdJNiJlDQ&oe=6AA17144"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4viMVJN3Tz4Q7kNvwHiU-R9&_nc_oc=AdoIBB6mDoL7MQFVUOC0HsaA_5d0fs6SydKibww4FF9gneb3DdCwAGFPloCPaRvsiJk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-4saOG0fFbc3Xe__qbpctXzNK-OvtyvaJm68cbOCr5g&oe=6AA16DBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNpoYF38aRwQ7kNvwGRbdBf&_nc_oc=AdqjM3hGDd5g31kTwmwxUuyTYEyS3Ki2w_Ue8rreGOrgSNAJDSf0_E1gt46QQa7kXMY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcRcTTGBuj-Z0NUD8PECAQ4rBH9KQPNUMy6pqrTrdqsw&oe=6AA16BCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3rk1192nusQ7kNvwGUvgso&_nc_oc=AdoH6FvbBvweJ3A7y5_k1eqosMkJFzT7jr67GIDiIMh1eulrl8GwYDS-YQdP7gKF0J4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLypZpxwcpYy305QhezHMAp5suAQEOVa_5-VbdzEI4akg&oe=6AA168CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhzmKM08YkgQ7kNvwEC1zKp&_nc_oc=Adq7OQl48_REb2RfXSQF6EnU4ckvfrI9NiYyF5ME0_l1mSXBy-GuuemgBxl-AzOcAmE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9xKUb9L5KDccF70z9Z-LuQ-fxY6VckSLIcv3uipVsvA&oe=6AA162BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOkrOM46NrUQ7kNvwHFMZf0&_nc_oc=AdorvVbTuWIJDcJbobXGmdqjRZMQZs7PcoN9xU0ScKXw4xGV46yl21VlAaQzd8FsP
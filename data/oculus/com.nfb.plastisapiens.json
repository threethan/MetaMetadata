0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1oAd_Cuz7sQ7kNvwGwfFTi&_nc_oc=Adq8zKhnSsQpm_oh49rItolLhY-y8XtFICfvnWW1Oaonu3Ym1njWdF-kaCxpQpL-328&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6tf_LXGsElo4ENbto5ETYgKMqaPaqjc6N3lRwMo2wnQ&oe=6A82E684"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVVUp5sv6ysQ7kNvwEEd9TE&_nc_oc=AdqULIWKOpWH8SgUkmq81JbcNyzhQHh_HdjybPYyCHihInvsuh-Em6MvPL56YjfqecY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyKP-EIv4gPEOt2aRpDZYDJvwnld_DYM2vxpOZfn5cYQ&oe=6A82E2FF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhcHMk2FlnAQ7kNvwGo3iFf&_nc_oc=AdqWoGNLYaErLGtGk0f1WWX-2I0lgJ-Yq5QTufbKLTuUK-Ko4mAlj9J_6FOrEoyOQNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5oTFiBhAoTzvrTmMODOI1HIIyMe8KYNQvWaN7SapzRg&oe=6A82E10F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y41W4ApV8FkQ7kNvwG9ko33&_nc_oc=AdohXlODX8PLJnDfxYVrOCyunwz7T26z5fjXooQ4_WNOv_-zbiNmJ7Lr84mdVBnohVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO2sTgPPMgV8gEnhS--Q8FUG18w5rr88fsgTwBE9idpQ&oe=6A83164E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyaZ64fyfyIQ7kNvwGC5uuC&_nc_oc=AdqDr-Ok8VTTYHB7GAmlfJ_J5eNTTaTNUVPF6XCeKMhK7mnq3O6WKqxOFL-3EK4KhpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1t6TTLSex-C1Qp_mIh38suS9-PPCHKsovtOVxAwvR3Q&oe=6A83103A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHyUiBCsdPgQ7kNvwFuTtl_&_nc_oc=AdowFY24dtBTrp-RYuxxoL8ro0C6HkOulWc5p6Lj6Wnl2NXQ6lwFM6HOyifMa7e34
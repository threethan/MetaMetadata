0f&oh=00_Af9U8QsKi47X8PKVxRPyiKFKLFnG32s3tZX7UMWVd2BLQg&oe=6A3BCCF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goDQCqt8d9IQ7kNvwF0t8Kf&_nc_oc=Adr-eJNxRlELf7pEh0A4WSliSgjMTfjnC4ZLtub-4TdU3uozRPoSRc4RLxKeuiYlmZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qLIdirlaD--NZiK_0Nsn3f4lOC96I9TSCL-vP5-0p0g&oe=6A3BEDC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek_JPjrJnSYQ7kNvwH59LQw&_nc_oc=Adp0csFFMBwYs8wAyPkoyOVZ6BguGnKhrJy6e46-fPGKtRIzeNhA9rkF87glH4x5r3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tJTxW3Sa1EX-tLiWCJ4pB-cL1okV7jW-kYWDl_MVsLQ&oe=6A3BEA3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaoOJOUd6ZYQ7kNvwHnSo6Y&_nc_oc=AdoR9UfuY8TAi0vZzJxOF0sCAy8H5VL8Ygbvc0cDw5rXlDIUbhWp2VizubAeNX72wVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P_owd7sYxdPVnp3ALy0qEKbwL5Fn3RGljMi6VOvUx-w&oe=6A3BE84F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDNSDZEWMNsQ7kNvwHN2EZU&_nc_oc=AdrUNirXC181ATDioOMbdnrIZSWeqzCB2GyNFzwopTituA-VJifkkyh0XjBRBBIfWxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ffV7c4BUJrGX-hy6-_-zLxcd0RO7R68EuCCPa4BGbag&oe=6A3BE54E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSLyGTLX2LEQ7kNvwE1iNNO&_nc_oc=AdoY33sEV4HaMnhDe6AaXO3l1tLNgnTZpGlIvtS1gZ0YJvt3Dk2nIuR3bFGI2cZGesU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aWM8_6WY_I-8oCiHV89U2E_ZY8IrVaTpt4LOoH0j-Hg&oe=6A3BDF3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
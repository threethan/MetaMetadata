0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuPAZ3IwlP0Q7kNvwFk0-P0&_nc_oc=Adp47M3mYy1jMyGUmyxGrPrM9CYqAGtzobvNeK4jN1pV4DHnoPElkaCzDKHjFGpceSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQgUdyTIpAJvV6tPEoG0Q3rxU9QMi7T_wt_1F-uR40hw&oe=6AF722C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjZz54wQVQMQ7kNvwEKRlwV&_nc_oc=Adr-4OyhTBIjV9oCxCbuRQpcLd_NTH_MRRNFmnxopUC_vOLlTOiwUkcMyZaGEYiAHl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfMFnJ39RhnMpF33MhXd7R4rrxHHKJ1ZNsm1PXXct46w&oe=6AF71F3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtKw2fzOsMAQ7kNvwE_pYOn&_nc_oc=Adp8dw4D1x1Azyc8fDfIKaD0qpawuW8d0a8I8b4t_XKAr5YR8kkOAyCkYHbnjp9ALIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnC288IUIgxJzkHQrSFEKC-712pjBV8bANlQIzSQMXNg&oe=6AF71D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cJ_dJkfNy8Q7kNvwEOqelx&_nc_oc=Adrj-r46PEiLg-gNUtExtPwmesgO8A3ua82VkVE7sbGAWh3BpyatDotjWbofrm6tNt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK8ARwHPTG-YwjpCIVroZScS0s5aK725Bvo09wB4oi-w&oe=6AF71A4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba5AxciJm80Q7kNvwElCAMf&_nc_oc=Adq62hIuXR3-4dx6itoWj51ZaYsmmQpVLKQMZTG4mhYCsyVl5UfztN-Dwu4YyY_Ongo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgaBJUA--pqdkRd-1zmKrU4bqU3_AnyQpDM0khcF7w7g&oe=6AF7143A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPJkBukvRRQQ7kNvwHls75Z&_nc_oc=AdrUUxjNlyNRAniJXbK-Ju0NnOhvBPzX09muqqCJoIb-WfK_hL3ELodN4kR0EDssZ
0f&oh=00_Af0r76cZjaH0La3SX0m9GXq8BDwe95Aq5H_nB99Fm1waJw&oe=69E226F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV4graULJVsQ7kNvwF-kwyH&_nc_oc=AdqWYeKo6WzHKpZDE_e3NKza3ESU6we0iNAfeDrZiI_FQDtOcMcT6w5sH3hTTG3nAVs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J3DnGwuqwrAX4yTyjeJsHTpRTI1QUuyCXZ6feZOh2iQ&oe=69E247C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcC95LLjvDYQ7kNvwHpS_ME&_nc_oc=AdoxT9AEOg7JPx47EWuARlSkrkfCYwohbQozlf8QBefHXsbD-rsn-A6Lt8I5EMpZJwg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lGMddvUNLxVQvsTammVIWOEcN_jcPGGwyjsKGVa2eXg&oe=69E2443F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubTTpZEsNXUQ7kNvwG8CjTa&_nc_oc=AdrLTxWNMRONZSeNt7xZnhzny_RhHljUw0eBZ9uOl9U4nfiLmKHgBr3Ls_5lt37bsDc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u8MOrtP5JjcWa3i8uWrrMvyLvkPLQ3IdXdyKIuNNqQw&oe=69E2424F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ5vOikwf4UQ7kNvwGNQd3G&_nc_oc=Adov6mRuRcLAnSy51CeOU_YwfOPet5NE9Ob7dOS-xrxJ1F3WPpDPpmhky-cEjC7AkIM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m7Z9KV5AgupyAms_YKwhtOFLPXL2lb2l3_XDbkHW0sw&oe=69E23F4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jra0CebvO1YQ7kNvwHNAcqS&_nc_oc=Adr_54HDm6BYE2EJmwqyGyQFt3f6RAmQbb8LlVadouYQYyjOkVknU_73XzBipnR3azY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XJ7nLESqeQAed1li-5YYc8X9p3Vu5cr9UQ3y0CaOhtg&oe=69E2393A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
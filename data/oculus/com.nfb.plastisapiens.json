0f&oh=00_Afx8-7ju9sNlMSmepsvwGR1xjyIUEkQ_l8eQZJy6ATsv1Q&oe=69C525F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4DLdaY0cIUQ7kNvwGaIxry&_nc_oc=Ado_k9ud5419BdUEuP4rnhuX_cHOUezaPQDhxaRHCXLz69PRYZ7dsvCrFV1JT91OLjQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOfHL9K4mmJU_tFrvNoEyAwvtaeifFX9_3Q_MI6CVz7Q&oe=69C546C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V2wF6i6VhQQ7kNvwEr1Xt6&_nc_oc=AdrIO_Zh91TWIl1SCDB6e3HxgqmQzE8QcrPmv6gC1tJiCBHg81usIoh7jCIuMhk4hWk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ23I5HDUdn7rU-x4Cqd897TMKPU9f9VDseDw40iYxqw&oe=69C5433F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMXH4Ix5aTQQ7kNvwGTLCIE&_nc_oc=AdrKjJG_H58S8Eg57GUza4oqsSG81XAZBoiiDEtVVo23Kh90uT8BihgBsV86t4GzMDU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySztg4bwGs8MFhk0NOh3McaJ-AgNLqNQ67gAMOPWYmlg&oe=69C5414F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJPultAwmnEQ7kNvwFvgT5R&_nc_oc=AdrzoFHgeUf9mDBLjrHV9MLsN9HFtyAG9_KoGr-pxnZodndC4VFVq3jMnAZ0fu5XX9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxloF93KsOviHReoCtpq_tsGTn5jxoZhk2Xc8Y5gWPiAA&oe=69C53E4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmgJASy-LfQQ7kNvwG3jUo7&_nc_oc=Adq7Yp_jruAc7zaHFrLa8sjTix9AGXyYDDDBf3DcROvaF0YeGcScXm5-ImvVyolBwlQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJqiU9_e_VkOWhVTrojl8xFEzNInzI7lLq2cS1SkBuwg&oe=69C5383A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af--rzI1PxCzPUBWmi3zs3h6w3eTqfHRd31s2WE0pROd4g&oe=6A3D56B9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goDQCqt8d9IQ7kNvwFExnIp&_nc_oc=AdpqrGfELZigv03PesKpUbFXJQ99stNbzdtTwQdf7ZUgkYOO-ZwDpCazSm1vu2SuKfk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zY145vWX5YvQ1LAE7hqpspx8GPQqXJ6J0tgUzo1ULrw&oe=6A3D3F44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek_JPjrJnSYQ7kNvwFTSrUk&_nc_oc=AdqPqgPTxGW1h_-oQkO6xZ62BhyXIfvBKr6-UBdCHB5g8kvbGccP9j9wyPA3woyxACg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RGslqeBUHrB6wyPbNxnfngyi_6G00kfKzD3wZU5qRtw&oe=6A3D3BBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gKQSOF6lW8Q7kNvwFGFIhq&_nc_oc=Adqm7tpCQuEjlbb-jtH9Oc4_JnLW3msKER4f7BGYt9aSUoIwg7I9jOT21H7RPk4J4nA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eYIeTCJvJ2v_TNxETxRWtYWndFPNznIDsBop_-An0Pg&oe=6A3D39CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns1c2nwL9Q0Q7kNvwGkFDDs&_nc_oc=AdrTaAaovy2MXCDxoycMFlNjwDo_YxY390cJroo2UzP74XotAwDKtBbr3WcjMo_sTsk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eF4zpk73Vyyfg972B1Ze3b_Uv2Yu7SDk79my2wBaumQ&oe=6A3D36CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSLyGTLX2LEQ7kNvwGHNjdd&_nc_oc=AdoekB83xZ6LH4RhH07Zk8Ksikg7PW_xJc0suXAPplz1i22rpUYLDno0V5sJ7b3NqRs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89wHKOnnGEMJFyWBnKdjZL7pTryIVwLvS2F-LWzgmMjA&oe=6A3D30BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af3NbuBdV2Ug2hIrRznuokl-b8Z1B9x4DZ9rGO1RQBtUuQ&oe=69F73EF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pssUrF1i9EAQ7kNvwGRkiVr&_nc_oc=Ado3tyhdi8JLa1_A6Ihmvaw_mSdTerlvPElEwXbYwfTxZK2Nb8QTXHu-25IYyxnn-JM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xzgpgtPt1I8YebmZzKTSOsjf0BxuHxuKi5Dl7ZMHs0A&oe=69F75FC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okcueL2i38sQ7kNvwHT7xfY&_nc_oc=Adr_L4LW9M3GmdsLCW3lCiO4tnCQ-yjgCTrXtGOqWptTh562-GBFVJd0GQgsubV6BPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Wj03qI-jtTZDerlgYVO2GLgpT8PhP7E839mNOoM91eA&oe=69F75C3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PFSvcplQLUQ7kNvwGo8zvT&_nc_oc=Adqm_dxRcfXjkLG6d6yP34gmT2yy2fhgywvptt71NXaZHBYzNqH2vQ-3SZexWti2O3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TW6En2P3ttO97BO8lhoV4QNeC6JtXTPHkW6Q6b_J2EA&oe=69F75A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdEGoFsVKm4Q7kNvwGRvyhC&_nc_oc=Adrc_Rv68hKGqkzS9bvv_S8QT7xfHuSIFQCDGuS0GmN4DLCYPx0Z-i3b0Vd73RQz3O4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BaGu-qK930dR2AVvi2vMu_GvarCg5Of-MkLHGhj1QwA&oe=69F7574E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHGXn-yVs88Q7kNvwEYa-kr&_nc_oc=Adq8CHoEYhqAVch3M69saYNWlVYNDOBoToN16UQC-gd_3h8rxxlXvF4BgN13Je4WaVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iKnYGCt1JmJWKe_Hl5APlaSmYuurcNKltZ7QHLCQ5jA&oe=69F7513A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
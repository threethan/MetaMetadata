0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glu40RBRPxUQ7kNvwFyU1jl&_nc_oc=AdrSif-d_-pCc4-B7CSGxTgOunTewSGgGINJyc7IHCLi9CYrAWq16kv6ZzYUqkL3d_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI68LPbYlj_0k1QhBdxuUdsuuq2XGYIO3GBcAV2rZxBOw&oe=6ABA7DC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOk8BcWMJWEQ7kNvwFLbpqe&_nc_oc=AdrRx990SkVxOmfaHeK_FBRS5GXceWJQO1aOCu-asErKGgKfwiGkR7ZGFVQbIBdIg2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTC9RldTn4BkxcBSekj8e1bGM15BI2FVMtonEiOROhjA&oe=6ABA7A3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX3BbIimpHAQ7kNvwHsXDm4&_nc_oc=AdpvrU8z8b15QD62KPST5Kz65NVovax3SpnVwc1hCTz0pm1ZLB6OOa3pW5jjLWNmOu0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHhE-RGbPj_IKTbn16clwUvAmifUaamDKKkCC4IWWgGQ&oe=6ABA784F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igIrWH2-PIgQ7kNvwHLXNWw&_nc_oc=Adp-RRPjyQPZlXOyvE4Zsd9k5ee0dYLWNT1USOKVDZUq9XiheZb8boLMjj1aynpDyGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXpA_3ErIl8D9HxDw7xZLoAl668v1Y8bX7CZHkSnql3A&oe=6ABA754E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUCNCir3BKAQ7kNvwHK4DLv&_nc_oc=Adq1_WosPivvzjVcDnoS7u66sjRkfFMLcSRV1sSdYlP6ywaQYo7y4cuz2Y_6fMSzKQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfZrToLchNq4YcturxhhL7mN7f0xy1Elg7ycFHZe7eBg&oe=6ABA6F3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMxalOaoRTMQ7kNvwEx7qY9&_nc_oc=AdpTitDSlj1zPGQwVAH8KipWQXISR_4OnApEeNPpRaPOL4G89Zs-IiLRe27iFYjIi
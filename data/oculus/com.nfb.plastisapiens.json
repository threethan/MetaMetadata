0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNKDiELLSBQQ7kNvwE9o0Q4&_nc_oc=AdoxBx0rqB3Wx9fIWBrN2zqSWJ-h8_hSjKOEyzTtIY3dbMSmiegNgZW26LixLp6dKs8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM0aB-aKIcoDIU37Q4dsqqL6hkvuW5dVQPVVo83ZrfJg&oe=6A916704"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG263FV40Z8Q7kNvwH_1elF&_nc_oc=Adr6adHDqmejKBraOSYuCFfmpOByl7iIvHZcAf8HhKSrPkg19iqMG2Ey6OoKFa-ABmE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUYz1UeVghDOvc77juUaB-rEblRLTNT57hHWl7ShmHJw&oe=6A91637F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVKeNYUvPoEQ7kNvwEizvSe&_nc_oc=AdqWLLP_FwCQGe-tQk10cV2lYSKRuRXiAmRDR2m6FxfJacfVoZNhCj73cMlHFopZX8k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED2lBJ1L9YnhHm4Wm4zyrdC8zVpVIdBQtCL5TkOoO-vQ&oe=6A91618F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-F-PtYVDU4Q7kNvwGqNFRN&_nc_oc=AdploYgqb75F4U3fWcxQ5iI_EMU2e9bupwclbKS2zMtxpfo5KcZhUJ8MfKjzVoC6qAM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTFPln-ERm9EREEaj6ypj9PkbtvNKlHme-oqYdQycTWw&oe=6A915E8E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcbHQbt7dnAQ7kNvwFpg0k4&_nc_oc=AdoCTUMcJ-dVkEv2mRvd_gX0_jRGFKYZcl21aCOjYIyn3FcpJwxG-4Ta410atoF5jFA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTPqaPSnvw6cpIVtxcs6b99BoHoLwyM44bn2HxvGlYQg&oe=6A9190BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2ZvNl63XxwQ7kNvwHp3y6U&_nc_oc=Adp9SBn2c2ALIBVYom6qj60kHfaYYOoE5M6nA10_-1UM-BPALk68R-kmBfF5ooiXG
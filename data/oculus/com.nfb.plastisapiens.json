0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuPAZ3IwlP0Q7kNvwGHRmus&_nc_oc=AdrpOdH954-dxU2AZ0LixxD_Z-lV1Z6QFROzJEzZ0ual3WZVZ2xR_C9R_dCqo9DEX9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8T8unJ-OV-BuFurUNQ7E7qCtS5DJcylg8xrcGOl8wqw&oe=6AF5D144"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjZz54wQVQMQ7kNvwFP7HbQ&_nc_oc=AdpXoP68TVDrHbWRb34dNRqYvZ5nqIPNITSDf2SGc_Mpo41RRToXI3PRY5tP8hRmEOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNu7bDnxfcxf_3gtHW_kpwfb_oxlfyvela76WPBdQYGQ&oe=6AF5CDBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1VaOzdnfS0Q7kNvwGL8b2U&_nc_oc=AdqpvCQIQEHxtRpNaFK7Vx-cdsmktw0-f8ajY-v_NTTupjvCw5ro4Ydod0bduQpg_qU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdLg9z1t3stxJk0un8VVoZlFDpv57YWOpOSrxoaK5VIg&oe=6AF5CBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u4XS3KgwCMQ7kNvwHUkiDs&_nc_oc=Adp0O_UCgAKXAGNTlNSJkUNkIQTSM2KiDUXMZWT1eaY_yMydXPrHXhNBfzuLn1_9QpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEl8p-Wy5y7zjDAicMfI7dCEuWB-1BIkC_9n0hAPQoAA&oe=6AF5C8CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba5AxciJm80Q7kNvwEhLUyC&_nc_oc=AdpBuiCHBj-pZFgo7_w1U1D3o6MSyl8rkSAsJB_gAtwKqg3Gq6SS7n6MmaUCvLnkHHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTakQoDLox7Txq--NjEFEkhJlacCaM-wryfvtGB8oX8gg&oe=6AF5C2BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFaFj0gIF8oQ7kNvwF31sKr&_nc_oc=AdqmtYJ9TImTB7NSHtAuYXr1AgD5T3ZxvD7KrGrBVvyo7DfFPTMQv3x59HzyCfp67
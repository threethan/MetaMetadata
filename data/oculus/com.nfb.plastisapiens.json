0f&oh=00_Af6N5vvkok30ioUMxSH0GpyZho3iTQMWyvRA-nMBS073hQ&oe=6A0710F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d-d7lSEFusQ7kNvwHLu5ow&_nc_oc=AdrDAr8yvn8Pz_IRREyjf7sHoqO9JpYDJKimjBqLyt8cPDKTgkqOGGeM3kaLLAp6VZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wt4cmO_al2K66tqZSzt5wQprLtYpsAREZxA5nPjRoXw&oe=6A0731C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqGNJhHUgrsQ7kNvwEdkIqD&_nc_oc=AdrUj82XxOiUsHhlrM2gnFXdQ5ZIrHLnSmh8izlMsFupSxmtOm7CICbmuMOnaKNYLdc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47F_8nn1hM-7RPzoS8SbpmXchBPBsF680n_vxpNdR_Zg&oe=6A072E3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeDaPlKuBB4Q7kNvwE5WYfM&_nc_oc=Ado_5araQ51LkGUGZVBaEzwQWtISOUKJ8LR4JiWKJGjLzwqyrcq9GqihkKAD61w1dX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nRL5DcXC5hSrfTwxx-exxXhc4Wt2PRRqlwncvn1kjNg&oe=6A072C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4-y9gPvBxwQ7kNvwEZPEQD&_nc_oc=AdqlvLQ3Bjvu7AQqVxrcTfPDFFuplYChOmR4Y-rI_CGeepGdmRlw-tOoDEmgUnRjHG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k4G1jLrVMf5eTbCmS6UowcQLVZxcdCb2doQ_Qz3UzqA&oe=6A07294E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_KuvaXOFBQQ7kNvwHTpFWF&_nc_oc=Adqh5vP5NJQLUWO1YvS8qQ_dJTxGXybagt_keXQWQlBWMVO0gfrgjTtT4zJ0G_Sgh2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XQcFgXAjPclTsDFiejDcVBOhkhoQiWAX1ZPDWeUcGdQ&oe=6A07233A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
3", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982469_722042759100626_3406365413707921729_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7pSSDKARaUQ7kNvwFbowBf&_nc_oc=Adn58_-IQ330Y4WmpDZFKHfkxM_qQMgsT35aIciXSr2f4zrIwABt7mJwHeo-prizodc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsakI0JVO06kuKxxgmOJWuEpbIXZHLHM3M-5T7CH2Q5LQ&oe=69A58593"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "425685199462033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982441_425685202795366_715112616556668169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAKNjLRMZ9MQ7kNvwHBDxTU&_nc_oc=Adlw5t7hsEu5T3G72xRTCFGdrRBCXBHtdbFfGwdwW1aza0roMDvP1NMkX07j_4B4TNs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuW_l3LEAVypy-5DK5dM8e8azED4m1eV8GWm9NeuE6kVw&oe=69A59114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "1585722755155375", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974530_1585722758488708_2854031198634892394_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTqjVRbMOfgQ7kNvwGV0C3V&_nc_oc=AdlmAi3omOKAibbo5gtjB7DaHw4EqMYvccGmLiMWtSrHw493wwq6CLok7Wh3cUqQF_c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuaAAsTtVx6jOeaFSwvtyMD7OY9HAoDkjGRgBl_oVQypg&oe=69A5745D"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Take a deep breath in. Out. In. Out. Now relax and contemplate a world where plastic is completely integrated with the environment. Plastisapiens is a meditative virtual reality experience that allows us to consider this world with curiosity, playfulness and even a sense of wonder. Rooted in modern scientific research, the narrative slowly gives way to a strangely beautiful and ironic speculative work of eco-fiction, a journey through time, evolution and imagined futures. By interacting with organisms around us, then watching as our virtual, organic selves merge with plastic, the experience creates a safe space to empathize with a material that binds us all. As we are gently guided through an awe-inspiring universe of hybrid bodies, we are ultimately left to ponder how the interchanging relationship between humans and the environment transforms our identity, right down to our DNA.", "short_description": "Plastisapiens is a virtual reality journey towards a speculative future where organic beings and plastic become one."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nfb.ca/important-notices/#privacy", "developer_terms_of_service_url": "https://help.nfb.ca/important-notices/", "publisher_name": "National Film Board of Canada", "support_website_url": "https://help.nfb.ca/", "website_url": "https://www.nfb.ca/plastisapiens", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_AU", "fr", "en_GB", "fr_CA", "en_US", "en_CA", "fr_BE", "en_ZA"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "762980611327170"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "673047812174643"}, {"status": "PUBLISHED", "id": "801039819132040"}, {"status": "PUBLISHED", "id": "979405690949375"}, {"status": "PUBLISHED", "id": "831113062515624"}, {"status": "PUBLISHED", "id": "394596900211292"}, {"status": "PENDING", "id": "2182499345252683"}]}, "baseline_offer": {"id":
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt3J4WpPPLIQ7kNvwFu2yj1&_nc_oc=AdqAEFXIDktf6bXvS1viFvWPJhaTP2o4V8wqaZL0yWo2scvRo7S_zWvDKTWMpblhf7I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlrKcXxcDFrclvzu_COuGZFh4CQFk36fOmoOW18oMoKQ&oe=6AE8A244"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGt1uAIpBb8Q7kNvwF_iFb4&_nc_oc=AdpzWjP8jZ9RO9YLlFHa7S1dk95fjzzStKWhtBWnH2p7h4UfSxTR6BwvJTTuYj_2AR8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL38jmjiZGWU2x-lILoKIIy3TA9kfhYnAYRvtNdZcvEQ&oe=6AE89EBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78faR_8s4eMQ7kNvwF19ykA&_nc_oc=Adrz33Q4zv3DuO5tR9RW6YrlM4P_T-uJgRArGK0LwrzBwtMzN6Cwmu4cD9tKRO_zdW8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThHYqrA9Mw4yMOXsO0euu9w3zIf2KWv9Ps3EEEX3sjVw&oe=6AE89CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwuvwFtfw2MQ7kNvwERBMtD&_nc_oc=Adp6vG0zjpouEBJOUTqLMbMCLkW9VvIC7pEx3s0VuksL0fTDVmDu8W5jh4d1StGYp40&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo8Qg0CbkVZ1ytyJh8Fjq_MmdWy5T6xNsgAcY1dqIGEg&oe=6AE899CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx39DjEy9vcQ7kNvwF3KuP2&_nc_oc=AdrNPLYxbiwHQZfw8Im4M-MQV48FztuQDVvDpb6ftbIi7KgZQ2NyRR4JT8CQnPzuBUk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdE7-uvt5piSvHzD81tDeOdvOrRawBRUi0ZxrqQwI4PQ&oe=6AE893BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW7T0Awn0IIQ7kNvwGn6I8P&_nc_oc=AdobWFzbhhbsve9mPNKXZNX_R6Ck93Ei4eR6oSPSw8l4FItSvMO43WKEw0QVHzFcX
0f&oh=00_Af3AGYODKlZ4j4_fDwF7Hkz--JcbH6V1_GUSFdrNh2FWtA&oe=69E76CF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfXrVLhIDX4Q7kNvwH0V9A8&_nc_oc=AdrMv95plgCCWLxAwJNNeGUmwgRcOGmdImgWn3SDMeof80UqRegD3rH-YD4pY5yWV3s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vaBoWuIHoxGTU6zGBOyYdkDdTW6jwmyBUMS_xCHycgg&oe=69E78DC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by2fjDmq5rcQ7kNvwEc_PKZ&_nc_oc=AdoRk9R9Lm_Bs_JQ4PfZnkfOtvHH2L847d8UyZuxqYhqX8AZc5gKuXhmzUW7wuov9NY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hVgBdcQ73cjHKMCGqciSIOK9Xckh3OpryAb0wxNBUFg&oe=69E78A3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4-WGHxKohYQ7kNvwEiH9U0&_nc_oc=AdoI-TolqbyEfZ_WlWROqgrvKm8RINuezT1e3RtFF5CumClhTfrMa-XOMlud2TblFi0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JYvt8OMMs8b11dzniB0WFP8jTHzuy4mEmuhoBB77X1Q&oe=69E7884F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf5t-9kNZJcQ7kNvwEvmVWF&_nc_oc=Adp1Ggdkn8Ul1RZjUrcCgceaSaNH_h--d1n0ezV_ObXuNwsj9W8YF34xqp1vVt_NrjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qozsaxupnz3KwRA16JHlJSz6awVsSoKJhmYr0SZlaYA&oe=69E7854E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNN5Xg4zM_kQ7kNvwFx6AtF&_nc_oc=AdpgNE1m9t5sBQr5wufb3xK6EWV6KUBr1jzX4jdklpl5-ie0HB0EpIZRcUd0aZLLTDU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BtjuhN1CulPETiPqrk_oI_wLWL5T3p_QgBL8zNkTX0g&oe=69E77F3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
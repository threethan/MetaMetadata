0f&oh=00_Af03mVaCSqJy_vvK_p3erK8FyNC3dgTsRouJaL6kMA3YKg&oe=69D3A679"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IewV_HHyUxgQ7kNvwEzB3rS&_nc_oc=Adp9RyYPXUcEoCMY9gVmuDQx6CbS1NLDKPOn0ubWHgFW3c1CeCsG2Tm-XJlc5fjnxlg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n8DC6om9kJWdryCC61jvuuYoYkk_Jz3AP4Pr4HXgSTw&oe=69D3C744"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6VGYpV-wUgQ7kNvwHqsS6z&_nc_oc=AdrK3JE2h_PRZUSsbOAE-Sd6L_Y-CSqT0D49fBh7TcepOC7b8SGkARn_LLOSpYIXLlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15ru7EEMLDIL3zdxCidEjx2x7Z5CWs7iKt2DFUo7rbYw&oe=69D3C3BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EjbKBEWlBYQ7kNvwEP5lMx&_nc_oc=Adrz9DjJ-Iamjs-juczBAdgEy6OS_Vg-uGkCz7Ueh5ZhJgUaoIUodyQout-TcKBwTrs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a6LI2toT5CdwelfkXdFXCapyD9vYPGfiRFMN3F2Khhw&oe=69D3C1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYu_sgaE500Q7kNvwEG3ZWd&_nc_oc=AdqAYbw1d8J6SMTbB4z1tbYhfHumi6JVNPZxYt0dzz5UYmSkeQY34MWdU-Mm2SAa2m4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R0_2NItdj-ruR9Vr8HbIoRmu60aw0V3beYdleP8Ky-g&oe=69D3BECE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRi2SzOnAX4Q7kNvwHEprms&_nc_oc=AdrosZjmY85GWIFMijJfOFrbUvyJJYxPLfr_CX_wn9mlNvfImkEnHLlP2ucUNPYAs0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_BrAG21qPlsIwGETCMI_pRRCH-Cv1Ml9DV2XZHm-uig&oe=69D3B8BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
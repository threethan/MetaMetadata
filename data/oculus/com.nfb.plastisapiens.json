0f&oh=00_Af4-to7X0zD0ouN3V2pvvV2m87YiIheZ0-cDk1T0Eu5siA&oe=6A104B79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL6ivB6yYuUQ7kNvwHgUr1o&_nc_oc=AdpKqOqKmMr7HCYRvT_ncfb26Ygdlo6y9JEPd7AQkssYlFJ8wyDUjpVUeyN_UvqUJ3M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70U_fGm37_d4bKRU_ICJRGQ_ihefJ5Q3T_Ya5AUts9eA&oe=6A106C44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsvN3fMwnN4Q7kNvwGexNm_&_nc_oc=Ado3XQ7-CdWr50j5XVp9JcECe7pk7ubmMJy9v-qR2LlrBiVFvicrQDi-DbH4Oi9C3Gs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43063NaaAjGtVRskY6vMsjIMPIoF9EGMAhG-RLIZjXoQ&oe=6A1068BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsetnBkI8iEQ7kNvwHDMsxt&_nc_oc=AdoSROa7FqvnDvRtpMjOIFPo_s0r3u3AzoImL6fTQPTf4sHu6483U4HQyEKMoHr8X4c&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54gaJYQD457dG5VlR3dvkldX7sPH1XujeFO_adUQ3cog&oe=6A1066CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niV8ktkt8mwQ7kNvwEveC8B&_nc_oc=AdphBcE3MBrme9Bb0i1xijGA9jy7W07X7hzK-cigajyofTUhcM_p9yAALFmsDrIb-_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Go9FUdxs2Md58GFGvIWY-TtIAkzhrCNx2m118ZHKRFg&oe=6A1063CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmZO4HMwcvYQ7kNvwG9DIlh&_nc_oc=AdrKc8Ggl0RwHVrAUiDImgXnJPRi1LNRHQVdnRpQlAufeIrboGHmzTiSH3qM9f47tcc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af456j8qeUN_a_I3DOiUUtNxhuHCavk8c-BzmXhqbjX3-g&oe=6A105DBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
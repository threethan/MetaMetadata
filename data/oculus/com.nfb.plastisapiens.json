335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D3W0VjRkRQQ7kNvwFfkq6-&_nc_oc=Adr3ywh0y58l2liG1aOLDJ8QoW6IYGSuXqvmH6HR-SsiC0e8Dqvm6d0v4sXSFO_Zqpg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7qZV0YkSpa_YZIy7GZNBLt4urjKTGkd22aip1hzefUA&oe=6AA41444"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfZNY5RUThcQ7kNvwFoltM2&_nc_oc=AdqHoBfx65A5ArwJqeMVT2xUTF9quUuW52XS6pgGHZh0YE7QxPpqk86IJlgpQ-COEeI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5cSu-YLzLfSk9oGDk9pZsXA1guHPljo7C2fwx5zH4sw&oe=6AA410BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHWy_vDCsgwQ7kNvwFP8rRD&_nc_oc=Adr8j9kbB_jFxl2i6_MinjnbuhJBiWyHsdBBe8oIFttQh0TibfLLZC98asm1_8Itkhk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxAkdYMXnBPWKsuS0A2nDt2YcuH8cYvFs7ZZerj5KoSQ&oe=6AA40ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmTlGWddlLEQ7kNvwEgK03y&_nc_oc=AdrxT7g6_3nA95FVUGEXrRqtMN1iQZd55uPQI5xxTPEJ-WI5PsSLSL0b7P7jS0Fwc-E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBT5QgOtUK1Bi5ZIh55-QNG522w92UuZjoYyeNvVT4Vw&oe=6AA40BCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya-9v9txNuMQ7kNvwFdPnIC&_nc_oc=AdrLbcMGKWXw2e03JbzFNhsjkphtL_SoF3UXVlaNXtPy3851GBdYFHi_PNHA5dOIGWY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPfX3khCL1h-svq441Mw5ulXS9zr6Kw3yINknb_pSyjQ&oe=6AA405BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXY9Oc7VaQ0Q7kNvwF1gVYY&_nc_oc=Adp7W8jVEF5Ncswqrq7B1no1QWAORP3jFOsjQa-Et2_gonVoLzrky92Xg
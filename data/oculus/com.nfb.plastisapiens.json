0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekMsQTEiLHoQ7kNvwFk0oBe&_nc_oc=AdopsDmM0zdN3RRUbRPvTHir7zk3TH6_ECLQGv893fqxmln_mRzvlUbXed_2qWSNQ9o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJhEzaV1sXkiSu9X37ah4S-p71aaNXOVr8T7d6a2Op-Q&oe=6AA01FC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4viMVJN3Tz4Q7kNvwF7JDXl&_nc_oc=Adrpzl4SoPedVUPOaQ53niLU0HdHojtiuxX1se3nQwHRfr699K_UZCGAHz5JcmJ4BLg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm66M4oL4SxaV9EpVpm2miOFezlsV-f3pM9JIpULvb9A&oe=6AA01C3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNpoYF38aRwQ7kNvwFQm-Vv&_nc_oc=AdpwVvr38UpTwtX2wXug4i-AeJ4NJQoasgGIeHqnUoBxUTgyuhXIEOzQy7U5YlvsOrQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS8Do53SQJqNJMxpZJ9Bwxgk18K1LYk9u1SjCyNKlLPQ&oe=6AA01A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3rk1192nusQ7kNvwHf0XUy&_nc_oc=AdoOnibER5m-UMnHjtc5Wlv60iB8egLtXjNVWQTew7FwwW9Nxgu8Rgq5j9sYyTv_cxI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL11YIK27UQcxVAZXy1zjA2rzlmpIXfk_oWphD8yRhETQ&oe=6AA0174E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhzmKM08YkgQ7kNvwHnY2NQ&_nc_oc=AdpWRdgjWbUYUS-_h4QDWEIavsi9Dys3Sjcm7aidIM5JAfsxhXPBB9Cl8eIEQHs2IN0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIZ--IuNxzIlEhZxzTViqJ_aEeMWuO5r62Z4Xls0o_Gw&oe=6AA0113A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOkrOM46NrUQ7kNvwGd0wko&_nc_oc=AdrQreyGwQSnAXuv7VYXwNEEdq0N-Da2g_FFTeduV2mJBfn5cil8W7x8gfBlv7dLl
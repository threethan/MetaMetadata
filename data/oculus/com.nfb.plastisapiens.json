0f&oh=00_Af6bC1WS0yf69o71z3dH95AZyPEYVF4Md9G9aRfA-lOzNw&oe=6A16E2F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX0foSdX5gAQ7kNvwGz0qht&_nc_oc=AdqeMObeYLPAt6CTYLgHZsg4_g9INA35OBpEFeOgJSuSIo3vdWRmY2z3793AKb5A2Wc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zeEF96Dm3uh6DGX_sS9LshN6PqOTrfNq7wVSPfXLQlA&oe=6A1703C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D3_uNlPKyQQ7kNvwE1_f69&_nc_oc=AdqG89Y0pV7A3vPXNKIpetKxrap_9TWijMPjkfgckSfBwd-hJouBgeXIVmCA5myLjNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52eudf13iZ22ceisWlmScUJxhTu4k1Sx0b7JOzgwbYmA&oe=6A17003F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-75iDz0to8Q7kNvwHiaTS9&_nc_oc=Adr4K4cLffKn6lMaNkVFIzmmEPn_QbUZ2J8s0YRWqqovhdHVACqKO8ZBQGyjf8i7azM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tZGwSGrYaPHRL2I7UOvTey_lVMGIThSJh35JPFXT3Qg&oe=6A16FE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLO4CjdYK0IQ7kNvwGHfF0-&_nc_oc=AdqaN48WD_gTS-Sc1w1f9HmdvW3guCs1U2eed0-Q6fuch5XFKKMwqa4hAqi0kDx-9ME&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72_leLETKNdcuAGm9hSgpFPm6bP0xhGPNnaehC7OvWgw&oe=6A16FB4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0XmPqf42bgQ7kNvwFIe7eU&_nc_oc=AdpnvRzPWPJ9iosJ-poxi1CMVXinLDBG9zqs0M4puD--McuHXSaGl60fcl4W-2_6Yyk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IjL-4o0JjlrECrIGefRw68QI3DzX6qVet-2rBgMtpqQ&oe=6A16F53A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
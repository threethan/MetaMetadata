0f&oh=00_Af7jSy6pOKoxwy2l0VpYa62I-kkeb_xFFFJrwKic-iFdgw&oe=6A05BF79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzCyotvU3-wQ7kNvwF4F77i&_nc_oc=Adozfi4GlRPxXxLrkSuFh8TKmkLFrzGpiKcOJUs1Uz9BjMulCUGNKKsqiGlC3jv6i8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53cq5MGYpODvw-CKDXuS0LXRRpol7MnZ3VgUCbAUt59Q&oe=6A05E044"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqGNJhHUgrsQ7kNvwG2oeIz&_nc_oc=AdotP5hlzj_EhzvAXZnq9T0zsXD_GQA91eeaA61VavXF1SAIQLdqaWuRceuZpy4SgUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ce7LYIX6PG4zWWpx0iodE4Rd2EGwoAa19-F3LioU7Ww&oe=6A05DCBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeDaPlKuBB4Q7kNvwGhp3nh&_nc_oc=AdpSg64JzgJ_jDq2WyKns3cb6eBDNTUS0DgLWgx4GsRTbIMCbk7y5QJnSJzKggtscaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R9Opw_6sFNNykhlCpJpsw19-WeVdmonroL4AresC8fQ&oe=6A05DACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4-y9gPvBxwQ7kNvwG-RNrI&_nc_oc=AdriGxHuEbGqPOsW0_ZAoRYpYG5jM1Kz79aPWbdSh3WaVZy8-YzBVPwG1uGQMDYIC7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T4-nc28AjSxV-Iv5PvJM-y2BE14pBvJmuLvBoUZkAVg&oe=6A05D7CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_KuvaXOFBQQ7kNvwG1NlkK&_nc_oc=AdrpQT2Q8liAXvMJmn44kFGRRJCw8iYrRdD04LShIluaa7glqESxNzMLB5cmSWuUJ1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NCrKTDQV58N1bV5GMCEKsPAtOGPTB8LF8Yqpa5ExG1A&oe=6A05D1BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
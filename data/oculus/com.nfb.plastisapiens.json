0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDhcAVkqatoQ7kNvwHM8m04&_nc_oc=AdpAv5QB3d5OvcUInuXoEPvHCQl15pLZBs6NmURfmcfn6EpvNeA3murG9DbNIOOD6v0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLN3PYQna-lRXQdsSZ5tHoOTdJIzcR2L4NwUfRxUR04g&oe=6AB3E644"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EHdChHwJDEQ7kNvwHrhqQ4&_nc_oc=AdpZpoRDB_wqIo74rxq0_qSIqK-5kj7RWVN1ksQpueyrLUURJ4UqL_jTnYp8NpH04qY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF-3KAzSpeAmIwU9HAtBN8neVIiG8aHZAdjq1xZ2vUdg&oe=6AB3E2BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exz_-rJ_BXUQ7kNvwErgjpt&_nc_oc=Adp-UaardSRMAjZPFJEQhgo3Aq0XHIQv808txqh7is1bjKU01vB-yYq-4UubC43dJds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiLMZhTwpl7907SdH2b39egcGWOfmcQ3lFe5yiBx7NfQ&oe=6AB3E0CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rthE1COKdhcQ7kNvwGMO9YD&_nc_oc=AdrqHzMSLxGMx9MkE_YcQIXHt7vx59CWOOycb24z2yX0bYEvU0P7p8ej4cBOBrMSRvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYjI5MGevbuoxpgyd-DPPxqKV0pxDVEtcJxpJfCSk4OA&oe=6AB3DDCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4jWi6JaxFQQ7kNvwHP2JaV&_nc_oc=AdqW-uXi-CdfbroZ-H-Kwmp0PWuSZkMTWGhZvqc5qQusED0wC5avIrwsDE6bAmsjT74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4k9S-tOcgWgRBbZU0keA0DilmuYj4qoMYY2lDOMI0w&oe=6AB3D7BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zxtStIAhzYQ7kNvwEfrXPt&_nc_oc=AdphltLX3yma2PWbJSnd45trPsyt60NzQpTyK29XMWNfbCqeQQlydEgIxXYluR_kl
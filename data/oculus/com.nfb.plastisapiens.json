0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D3W0VjRkRQQ7kNvwEnOPFR&_nc_oc=AdokbksJRjPEdFojwFDm7LHAtqvB88WhbKoqrxu3irEJrn4Ur8-4v6rmESsOxGQRssk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaV4YNckA9mIkjwMnZegZNQ6-YPzm6az-bIZao2h6aOA&oe=6AA2C2C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfZNY5RUThcQ7kNvwF397-_&_nc_oc=AdqU4sgr4ixWcArtC01Q3sNp82FZO4lfXA8oXPTy5b_RJStm_oUJsniBRJaW8AqxsJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5alWy7dCHcKvcy6WlJrRsNHTXbYPXN7nJu10puJDTgw&oe=6AA2BF3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNpoYF38aRwQ7kNvwHj-ovm&_nc_oc=AdroXjZ3J32pvhijJBgaVA-bZYjVQGpYvSH3ml-ViF8SAG6o_bXxldZC0LR0E2UUh9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxeFN5SnFJIvREgvEIol2aSsyQo9FTHDdXR3vgXpr5hg&oe=6AA2BD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3rk1192nusQ7kNvwE9RGf-&_nc_oc=AdqoQOdjSV5MnShYVbrqPT6TkxJQzGqex9nd93qLr7f6gkcHjK-jEu940UTiOnHJqT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhswo5-OhfgSCO8xVjXGVgnx3mlV91u09fedu7YxuCXA&oe=6AA2BA4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya-9v9txNuMQ7kNvwEPh6y4&_nc_oc=AdqIvkqU0eU5vY3aRwEEsLN6CaG4lNvsZhs-PiPxyKDWSBvbCyFyhOoKyuuMJ9asW4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYERtvAMzfluFfAXFkwm3lGl6bnkNEjfYq7rHkigAleQ&oe=6AA2B43A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOkrOM46NrUQ7kNvwEGJRe5&_nc_oc=AdqiVoHjg4TIS1tOytnij0Fa0Jgby4qZwMLR8bwd4byJAd5lRnA75YsLV997ZR-tH
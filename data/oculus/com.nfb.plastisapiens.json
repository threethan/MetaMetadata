0f&oh=00_Af1tibLRMaYfaj8cGIj8CmfyC9T6IJppwPVr1IsqWIUPaQ&oe=69DE3279"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrUEayjH3IQQ7kNvwGWGYkG&_nc_oc=AdoGwp8Ixg4NX1wWGrCIHFiz8pxc7HL-KZugY83epyFYu8SeFr2kGgMfc_Phb-oh3Tk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sEsv4zQmNgrhTTwbEJNOXZoaPK5iTFlVVvgVZv5QEsQ&oe=69DE5344"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6kPDmvsh9UQ7kNvwEbHa-g&_nc_oc=AdoRSFzmOWNOw25zJkOe3ahfxnDA4DdEcH1IbN-QAfSMrSzJUm0ap-HrNPWIUqrA4ME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af043SIA9dBt7LnA4ueefm4e9DVwUetHDealq86qhgzYPQ&oe=69DE4FBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K0V4UE3VnYQ7kNvwFFScV5&_nc_oc=Adoc9S9i9fAEr7B1VHmhdzSTb76KeosXcbW6MdksU3g0LGAotwYKJSleyCKjfMkKGDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S2ilZy4ixwZj6euWNk_sUUSw7OwIeeAfsf7ZH8rw7Pw&oe=69DE4DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV6DAWrQ4WYQ7kNvwHHHvJI&_nc_oc=AdqG4EG5aR4W6NXNMbZUUsEFK8xwP3e-ucrd0J-nFX-ptTTGH9uj6l1RXBxRI3NApmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ogOdERDTORWGufCOT9Lv2tpTbpAaODG2jxmGamt314g&oe=69DE4ACE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CFI2mOGNGYQ7kNvwH9Nlg6&_nc_oc=AdqQf5cHfY0JNu3hsYNRwIGeKTQ2SYQjUdZlwp86zO5_Clp_gNOY24iAGqtWTi2eMVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NQLnI7jNHwm6SvsSl2unY7dJUmJvaWkM7r7kg0O1MhQ&oe=69DE44BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
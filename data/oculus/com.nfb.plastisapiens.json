0f&oh=00_Af7zfiIzD4UvBxOeqzJhPBgqI4NzfyCG1bfvha4eOdaApw&oe=6A1ECBF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZNUmvuWDGsQ7kNvwHeL8Af&_nc_oc=Adod16mUb3JQMDlZ1AtJ_fDQOJ8MxpmrD2oYoTwPI21L3rVblD0MPLSx96_kAIvP5Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bd9TQsHOZU7y4cxnQ9OdhaI2HNANFSlm5xEW1uRmoKA&oe=6A1EECC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO9fdz9BJ9oQ7kNvwG9z9bS&_nc_oc=Adqc_65Jnj-jgoKT5-AfJ9OBTMMHvuIN2r9oBoGXKrgqpJ1Af7uxVYu-hLewg-V-pSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RLxqpSsa8zkeWxLOS52HYTJ1r3vnOtn9ONkgOed8r7g&oe=6A1EE93F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRAF4KDy4VgQ7kNvwE0lB-J&_nc_oc=AdoAgutAxfhSE0d8IFzplyIx7-pqGQT8GOtfu1qrAm97PEDZs6QnFqlXmXX-aisOJkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LEzKB70MxQEaBXFlp4NlTrIagHWHDB55rCAWNwCwL_g&oe=6A1EE74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWXLeQEcEr4Q7kNvwFNPVE8&_nc_oc=Adq5n-G_rNQN-liwVU2NmaZuyd4nzFAlAfAZ1BRNBvQ9XWCsXOqEShD-Hxv5Afkz_Q0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58zcLzASEMrHnBDmw61oJ-Q8tUfeTc9KycWelyTH3LpA&oe=6A1EE44E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DODuL0KkyuMQ7kNvwG4zWKL&_nc_oc=AdqnvVBbuE0cPQWmUMPTjPl-7jZ3RvuaD0D5AOYCB4n6lC0r30eJtcKAAQTuVhQnO20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mM-yXmbDUKl0cP7Tqn27gJK3hNOB3pr5216edJDgyPA&oe=6A1EDE3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
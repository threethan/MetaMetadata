0f&oh=00_Af5L3cjppnXdPS90TydicqnKfw-uHvXmBH44JSwPfu5xuA&oe=6A01CAF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFRdh_sfnW0Q7kNvwHIElGr&_nc_oc=Adrp8bw9-Q5RRmz2KJ6aVUYDbtkIWBsRPmD1u2jWFqoLBul7y5EddQy8rXW2ky274Ac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46caXDjvOfgBPhMCTM9zaqmiO_UFj05qOSXz2fCQIj-w&oe=6A01EBC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF0TU6BOtyAQ7kNvwHbj3Ih&_nc_oc=AdrweUhTRvku9zeHQwa2seCubCa2yTWAskVN1Bnr9qmFfGDL9sN1fwQ4aXAAZsL9cuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a56-oHVja68xjjPU2xcmYNTzVaqDTSqqQJO5nvBaSDQ&oe=6A01E83F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8QAeU0cncUQ7kNvwFZKrs8&_nc_oc=AdpsKoBTulPR3kzD8IzPsJdBo86Cy4Zb5cXRUZkZCN9nSrTJahf5tt5GISxAoySg_-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eqX2KgqcTqN3MTRLj9nY_TMqcROOFSq6Lb1s5tAjE-w&oe=6A01E64F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYF9g0ZDQxMQ7kNvwEhB644&_nc_oc=AdpwA1wWee8MPWcNhNl18J2aP4ezC_me8mn6Mk27reAmakHQy2iR3gbeewUGfMXkeUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k6tTUd4lEAnY2d6qyI1TiO9lDbmGkro3L8rcSyOO4wQ&oe=6A01E34E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCCGdX26luoQ7kNvwF0GAvL&_nc_oc=AdqgkK5FdlPgkZVBseWuUrYJ9hr-lyJrJmk7m9APrzdpoKjWWa2mUuVqHY6LXWX9v4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51vK82SO1iJPCis5-LaX6R-KrTTEsOyzGDkwzjvzP-EA&oe=6A01DD3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
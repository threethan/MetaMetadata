0f&oh=00_AQDzLaN5bNXR8o9TfHOUX5hLcqBv-h3EGiZqNQ5sLybtDw&oe=6A5CC279"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzP4JtWTCzkQ7kNvwFISqTa&_nc_oc=Adqc0o3x1vAHrdKFsqLX2KiS-S2rdYJYviVIqVTj0WpPVCVrg-J7is_RLDNox_XVJ4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAld_CdEFGDOzWRqTFdZxEqzXG6B6fZF3uUdL3lo8AK6w&oe=6A5CE344"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6exUxKHDv-wQ7kNvwFuB5hF&_nc_oc=Adpe_kLEsUKbBET8y52w3MIV0959DhqwS3vj53Y_CCxLOndH4cNmw99aIRsMeg9fAP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUSsZYOlvf_T1CqliIS4mB2Lu9iUBm9Vy9ew4-DwxT8w&oe=6A5CDFBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j381lR1SysQ7kNvwFEdQxS&_nc_oc=AdqvgKlPypvoFYwlGpf_0itjb8xjR7M7Rev-1lETmYwGuQXtVHLHL5BBu5pbVP5KUmE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdho1QT6DgvkxczTS8IIAGMDlnjzfOnD38dLN8cCjuGw&oe=6A5CDDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ToQRCW9XX4Q7kNvwExE2ko&_nc_oc=Adpc-0XUiMEAWJM2011mSOD77Lex8Q79MeIcs5AQFBIfLK6h2v0pZzJYSx-woAT4eOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOFSlM6sQuO-Sb5RXnDAo0f0xdWpaxqHAfkx5GC1_5lw&oe=6A5CDACE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaN4pHnr9DsQ7kNvwHf4liJ&_nc_oc=AdqRGYvURhCemIhdlQvOjxU4O9T5bzuVl4sOE5umAEDOFqk-fDsKKOZ55j_8KS1cFNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEUsGSJf9jrfejJedqLNtq8VS7GFh3Flpat1MoGJrvpg&oe=6A5CD4BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af_q_Bs1qKcwD0GXfy2WxsJ5Q2LZW4B5jsNUaPwTwfU3-Q&oe=6A43EE39"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiUPaSEHnGIQ7kNvwFHEmAf&_nc_oc=AdqZv6lTj7-5R5M4fV0pIF21dMZYQ1AgkS6j35kk9kBYW2NoEl-wsFHlumuMKLyBdCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gxjh2l1xYNblxCzAtECGVP1ZCYEjr559Qy9cEPD-Dcw&oe=6A43D6C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy0gj2SUzfYQ7kNvwEVQB-C&_nc_oc=Adr0myskgIS-MVUqJeU_FFKTuizDYZwa6ml3XQF7-IcD-ZCaWkQkTh_yvZ-Jq6r7jOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P2L8TyjJj8cCTx9XGe2pbJccV3jFw9_fBNCrebgVHtg&oe=6A43D33F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACV5-NXA0WwQ7kNvwE74QMj&_nc_oc=AdrCUi6D-X0Q18Q4Z0YgemijsGc5tPLiSswcp-c_ZMkmDRfQufaIxJ8axKErIDzxrZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zcURVVAaXtXZkTx8JVHZoYWMIwUQ5xSAZ-s0nuaX0eA&oe=6A43D14F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=581AIGb6tEUQ7kNvwHPpe20&_nc_oc=Adq_Nw-cLOzXmWWTzjZeii4KQVsYREZrtBsgSzYVQNg-dPOlZQem3uNx3QbHdWo7U2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8__H790OWbz4zdApxmUeUMGgopvPpWVYKZpInPWxni-A&oe=6A43CE4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZbjHSCYvtsQ7kNvwERWkAB&_nc_oc=AdpvqHDho0J-G6NLeeQpqndYSAn_NorgvMyqZ6U0DlF5zogr-L5mvy2TExmaddsI_Sg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XPgiaPdx9FlNb_kc0d3q9ujwnpozItZX6ph37D59bMQ&oe=6A43C83A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
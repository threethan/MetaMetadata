0f&oh=00_Af7puITx1NP9krBrW8ClvAgeBumgiqFADTw_WekaUW_8Bw&oe=6A0C56F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_oed0byJocQ7kNvwG-ADiW&_nc_oc=AdosWSlTcKm2SVxSIrktjJkrkdHrxv83e26AKAhUFaLVS_L4OhYJ2D2SHeyVBnIZQ9U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ERBgJ_sriZfIJWjWqOv8C0-xz-sJ_Vv8sHE_yiiwQzw&oe=6A0C77C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbH9Y25eGZcQ7kNvwE9L4CS&_nc_oc=AdqHomWfOHPHlS9R833fE_2O6dCLRWSxX5PYEtemkKnmYKYGprzzAt80CqLdVSqqt7c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TYLvkyXua6gVsRX1UEtNU2Ioypzd9JL1ZrIUhgosDWQ&oe=6A0C743F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT6ifcaotIUQ7kNvwEfgnVX&_nc_oc=Adqbqdx3L2eef3r22r-4ZzcBireWVJXYoVmnj9wJqCk9aW_vgdSQENByyjbUzg4ncz8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hYp6e6VOhzZcq_E7zsKucL2wxQPS9K1OSkuM01bZuLA&oe=6A0C724F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBNpsB9rVIsQ7kNvwF7QIkk&_nc_oc=Adp29VXdfu0MQwPpy_dYZLLDWRhi4nlc0q7hyTbnRF8Xonpmob_RzBVEXnuYi9_x2QU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48FLpjdx7Jzfuc1Zl_bqp6-YrrSzp1xEX4Vvbu1lxpYQ&oe=6A0C6F4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcTy6w-ibq8Q7kNvwEcVS2S&_nc_oc=AdqBpvFkhfpQ6Nqw5DKjRp_EBs91LY93MOoXY_ECjsVONt0od5rXRl3xEB75H0YPeio&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ob7wM1ZXk_NL_vlLzgxMNTv9m8GUJsE2Xi9zqAukseg&oe=6A0C693A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgw6G9twFl4Q7kNvwEq7Dq7&_nc_oc=AdqROR2di26brZEsC9zLy952IvEnAEXfTEQjzwcuqfJFqRDCtoGlqCow1tJF7o_jUxU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBvXPcDkvWeWZCSHJWUTh6uPolDZN6L1cpLj5a6LUv-w&oe=6AA95A44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhbagirYR90Q7kNvwEsN5pK&_nc_oc=AdolJ2YD_kQ3w6agQx5yeXOPLN05EKj3MtmmczpFPmWRQdS95IJbXqrb6bpRtXCIlK8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxjtkrL2Mkijy5HaS9NBMY2-VW3PcfhuXnb-2uoSaBQQ&oe=6AA956BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGShWtppFa0Q7kNvwEbIu0T&_nc_oc=Ado9jVGzdRT10C3kspwYvUyqiQlhHSNzpHQ_38RUciueOAWMeMqj8vfdCs5XJLPI_qk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdsGaKeSkbGaVNAJF0V3oXmaE9OvE49ilPzZRcIFPgYg&oe=6AA954CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y528XzYhASMQ7kNvwFNH9lc&_nc_oc=AdqL_4Q9rebcFtMCMI116xImswMDv9-0pCVYgVevrjgloCsoz6VyUNzCrZADw0pqi_g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY0_emsc3SyIkMAlw-QfyM1hXkNkcBPrRb0u5ae6fK5A&oe=6AA951CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkF89XPSyvoQ7kNvwETdkq7&_nc_oc=Adopu32Y4DRri1uQrnvNqKmokd7S3tM_jcBKxta0Ih4qI4widnc6lguC6If5rUsUh1E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxoQsMoze_YzrYTei1Q5acDcJK65qMEbwHceoSwWwMGA&oe=6AA94BBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIckMGkdKoQ7kNvwE7ha4Q&_nc_oc=AdrxR-7dhIpYLMrK-66L6e7fIxZ2Df_BO-RwTguBkYyYAIsghT112X5bi
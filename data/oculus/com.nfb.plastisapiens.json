0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IvfazipyJ0Q7kNvwFZH6nT&_nc_oc=Adrnpx4EFxlQYAduiDC6X6iV2ZPoqUAALId83KLAue98aifnShlgKYbl009MIYv2SUc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0HeLrvwmdpkuatubj7vNV1Vm7B5gMshldc5wEbSFuaw&oe=6AD38A44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koIQKxF76Q8Q7kNvwFZkcFs&_nc_oc=AdqgMwYLWFlqQG0O12V14S6RDUvV7uW4CtOBd2YaIpLIyiaaPTilvVCk-UydLDYs__M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVaBQ1gsSJJZpaYgMmmxaggRd7acT-R3T89Mg-7ZW2-g&oe=6AD386BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxKP_AXjQwsQ7kNvwHRoEwg&_nc_oc=AdqgVvOISe5LqFOgZxguGoHxIIet08JlkmCONMQprBkWjSXUAyUcfBhjnUOTQHEtqUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy8cl9bRNgRPOtknoJ3L0SI_-YqAjB7hoN6ylSAc0fWg&oe=6AD384CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXJSbk630LYQ7kNvwEkSqRv&_nc_oc=AdrcjTSLWDR2cRO4e6F0cGjO0WaroaB6MlWLOeMohdXkNsr6Zu2Pw2rqaqCoFKNGjP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg3EaeBw-xF_kSVlUd-VRs5U6t5w7q9CPgGbmkZ6h8sQ&oe=6AD3BA0E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkmPzN_9SjsQ7kNvwHuHDPQ&_nc_oc=AdqsOap5N6zkFoL5ZvFL4wZ9CvDLW-M7CKALF8AuqvZBhWjnmBLQvdRo6dPvVvbVYCM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvZuq6odTC8iTi5UfxDuTFYmbEeynZSYsQ0P97wzoxYQ&oe=6AD3B3FA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOt_8_Hdjm4Q7kNvwFzcrhq&_nc_oc=Adprqjng1FDS0CzOZM_UPLy0KF-wvtORrgKsec9QFenrEhl63T_yzcgCzOCoYdRUV
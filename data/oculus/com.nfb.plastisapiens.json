0f&oh=00_Afxl6dr2TVuHiB2eDJCOFjBHk5ngl4gexglxDszrrYTDLg&oe=69C7C8F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv3STq0g7wIQ7kNvwF6ZdyT&_nc_oc=Ado2W6ij56Ad30bpNqsh-t7gK5P81QncIqbSzELkLDrACYj7lUfI7jLrxiKD7ONbHoY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFyXugMxRetvcgx9rk3x20gYvycD4GLfffWvROShvlpA&oe=69C7B184"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1wGfn3YG3EQ7kNvwEvmQCE&_nc_oc=AdpkYrg7PTo6IUya7j28r8YsUngasX-KZyDYDDPfloHHfeOjBRpou-sARKp6dpG_6VQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9nLqrlOicgqWx2laFRJKGk-LYuFRV5lPlKPThKVzhhg&oe=69C7E63F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVrnQi7TWE8Q7kNvwF2NMu7&_nc_oc=AdoCVXSKkUg_exwz_BsXcGnuULaK1BFCVhsPUpIu4IPk6SnRk83C42Pc9DrjDgswqtk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNLKp4JBinLMho91acTQUwfwUD6iVqluRGBTb5TWB4yA&oe=69C7E44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmjqEsCNF9IQ7kNvwG63QVi&_nc_oc=Adom7UfujFRJP61JSVMWxb8Zotz4AqD39q3qg5dKuDISgf1hF8trF0q596toibl1xZs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVu0Q9PFEaCU43kGCxlQ5Zsn0R4dwOo1uqQY8vWTArnw&oe=69C7E14E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmgJASy-LfQQ7kNvwFOWDOt&_nc_oc=Adr-6cua0oiKuDKu-dQfuUs48SRMxuetskWS4jTSpPe2hXC62h6eo9w6EtAPXLQFuWE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH5b1D02rsLZijpkc4JywHSS7Cr_Jp8qrnyv4Sg4lHmQ&oe=69C7DB3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
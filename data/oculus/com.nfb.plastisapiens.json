0f&oh=00_Af5JzvGEIiTy5mI6mg5tkxA2wqQ8AtmjwMDx1Grda4oRBQ&oe=6A0DA879"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_oed0byJocQ7kNvwHK7_Kv&_nc_oc=AdpOctVK9MsvGIsilDHl3xBp5pFP5a1YMyO4_mr5eH5khNuSrDP6YGbfk1wCytEsX3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p8Lur8AgurlJQcCvXkWHHtg9TGPEwN3UR-19IHYTGPw&oe=6A0DC944"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbH9Y25eGZcQ7kNvwGzadhX&_nc_oc=AdpaIhONNkQte_M7jBQdFnaQfvH7bSgIjhUwouv1Y2la7Lopy39FeYnjQNixBqF3W0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jkzwU_j8HEyj7Sp0kyMHgIs_ZjWrYjawkJkt8Dzw6EQ&oe=6A0DC5BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsetnBkI8iEQ7kNvwEsNY0g&_nc_oc=AdoNPCnSpkSIz4WRYQlfu99JqWrfuiyz592Gu3g69ekPnBKWqUzKLm2aaBAhOdwC6CY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rR3PZqkDtyZr1PKnLr-YgFM3GmdFTfGLM-2xXMCdAwg&oe=6A0DC3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niV8ktkt8mwQ7kNvwEB7WWY&_nc_oc=AdoBGAvw5TKMqi59asZJGGn8Lj6IH8pK8VINnvTMXrrphjf2TOHEJKcPv_c6K5Vqvk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41XMr6eSHOFhnM578SjwocElNrvDGALgZVkdl-YXVBVQ&oe=6A0DC0CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcTy6w-ibq8Q7kNvwFPoxen&_nc_oc=Adq65CQza79DV6SdQBlu_qw2G903tWWe8TKXr8TPh3zrflo1WUAhCcdnqN0Nel07oCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZSH5kELLir9faolEBgPfnSJh8iO7LfCb9ZL4Q7h6Fpg&oe=6A0DBABA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
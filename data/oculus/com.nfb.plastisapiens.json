0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1oAd_Cuz7sQ7kNvwEs-_51&_nc_oc=Adp6NK87NW2QJMtnrUqmlp9FeCJdol8lJoqwxotkBb_Q_t1B_DdwCFUvLEZBG7v8QSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQG1l4h0ewJYf86IqfytHtY1UXgM0yE7Kd9NrZjEqMuA&oe=6A843804"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp6clfiKSscQ7kNvwGYPaar&_nc_oc=AdpOagQZzcnC2rjX7pAJN2XgxModpZig6_NAT4cDdo8ozzYgNMMOal-0XyUya99vMkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPuR2dwf0XDm-uVKG6S9DqmOZS8EQbs0ZYF9GXVNAhkg&oe=6A84347F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuVAl1u1m8oQ7kNvwENGjEn&_nc_oc=AdrTRhojnyl2nIvc1ARjruzKbXPkW5_aKcASM6uMCoAn1F5OuIaDucxfLMd3JZ4e0Dg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRpE2-mljqKkLKMGK5tTjZTj-0ChOiFWiRE57JXM8rNw&oe=6A84328F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0NBwZNp1nYQ7kNvwEfONoP&_nc_oc=AdrgFwVOOjqs7kd26SuRRwBEid5M1j15oPwBxk2B_rFZT-6alrzYdqru0Uj2dNtLPRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRfbCxQDQA9d6f7qvsLL4qRTU7tKERe11F2rqLFgwVUg&oe=6A8467CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyaZ64fyfyIQ7kNvwEBvLmR&_nc_oc=AdpmJlWrG9AaW9tRFpwUCOlWxfJgScB5yI1IFQoPyrtGV8IlIMTGPS7oE7czIkrtC6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9PI3PAx7rltXRhP8-DKPGuxDxYaJOjTneSPfibDh7VQ&oe=6A8461BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08KYXFNl8Z0Q7kNvwETKbpo&_nc_oc=AdqoNH8zooX1Psf-K-w1ALj3KNDgc9An70-4pWvUblW9VNVHSQpWD9ZxL2_q_BLQ_
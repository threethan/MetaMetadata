ar-S9A75MuKDlxA&oe=69BFDFF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO52f9dFVLIQ7kNvwFsCIT4&_nc_oc=AdmUJmT6pAj22xpfPb7Q91zKs4ANHJwt1qeQ7OCefg2L3pcNQXvMHqyNESrNs4D_GPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeEXDw-1qRClSBkh8IfzQ0l2HVauP6xY3jk_Yw63q4Sg&oe=69BFC884"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLT2OLONxgEQ7kNvwGZFG3c&_nc_oc=Admf9wpBHFJXDjmZckEt2dLr4sHr2Ke8vGPbBfjNUFMMbD-IBj7F0OHVy8LbVNbeXWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4DGGeRtGpQfYjCzLeD0m6L2Yvc4FBZW1JqhxiqSLzaQ&oe=69BFFD3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ny0PuNcCOsQ7kNvwGSf-N7&_nc_oc=AdkrNNFMXPRViopiMFnZSDmpzVe1HRr-Vn1aZpaix2f1MgxZaUMiE8hrmcEmNR_ik68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJH-Ho-AjwEDaevCRqzTCQSMB_i-ST4ZlEyZnYZEhiRA&oe=69BFFB4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-k6DGCb3FEQ7kNvwEQ1gQL&_nc_oc=AdmqlAWD6bDksHFprxMVAX6Snq87pbPeuYcnkd_Hmgj3LGqzON9G3FUuVQ6ar5xwwSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGhvN1z-ZUmSKWO2ZaBNldFwS1csy153gmhXTTwzPzrw&oe=69BFF84E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mu4N86UO-FUQ7kNvwF75Wn6&_nc_oc=AdmnWT25IylFM1UlC_wjxuYQhra2s1rz7i8UEu6_EuKOXZ8v-_WUkYSf3gxRoyUvXXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhAcrnnBB0wY52lvQjMcIYZUo9p8W4564L2yMV2aGG9w&oe=69BFF23A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/389
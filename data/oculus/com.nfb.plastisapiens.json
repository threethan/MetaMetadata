0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IvfazipyJ0Q7kNvwGL5EF1&_nc_oc=AdpmJ-rpuBCuR_6Tx7VUWFbAmqE4lQB_q6XNBdrS0bZDSImRg-vVlmXRHXttunyqya8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbWnn-DuagZ3qfrIjPLhz_Ebs9GPH1JQEt7a3hbSHj7w&oe=6AD0E744"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uaCkMgnBYQQ7kNvwGH_Xc3&_nc_oc=AdofuhQAHqltbc9WEFZXGy0512cBlLI6dk6-6SGCJpFZCi5Xj2K2KkmJYudk66JP4m8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMretCIZkLLXqEg9OYIPyE-oagvrHwZYyWqa0QsJ3TDTg&oe=6AD0E3BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KplUDPoeHw4Q7kNvwHs0FAU&_nc_oc=AdqRNKrEk526AHuThO28CPF8OpOt0g_WIMhMgRBsx6pq2pYdKVbBQ1VXPxk23FDqhHI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6miWBqxokHrKip2OIQCguI0hJro6y8O7h4xV3tdnQow&oe=6AD0E1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b0jf-fO3ucQ7kNvwFdbIY7&_nc_oc=Ado-lnDIYr41jFY_4Gka43AIsQwFiajkSkWSmVdCeAVs0O7dT8ad2TxLw1ZbgJUre6s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmcJkrKiF6_kcdUBihq1Kbo-xllRY9bqEyenukVjVRnQ&oe=6AD0DECE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guCnFxCOZewQ7kNvwHyoMs5&_nc_oc=AdpuKRccW00ZVrmvbpsmZxGng8NdM4rWIbXlAId0hMb8N8E5vC0YTdKjWXajs3zpMaA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwJe3A1cfYSCodaTFF1Dtnx8TlVFYFhEVgBKb3JDVgAQ&oe=6AD0D8BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xvasZ0IbwQQ7kNvwG9F9PY&_nc_oc=Adrcuan4bJdkktaWsSqaZomwuKwOjgKTwuxCLKurKjryCbtFtUMFI8CaUqLDpMXDx
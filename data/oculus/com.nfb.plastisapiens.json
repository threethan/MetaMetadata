0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qThcLt2UOAEQ7kNvwEO2cUx&_nc_oc=AdoHIP10JwDGumIPB3FXm5Uk8S3hePebKIZNUc4elbuh4983jBiEtvVeY5GjAN-oc2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyf61tDEM9MIhtARVZNi8-BOKM9hWdJMJxwrACFKzLIQ&oe=6A95CC04"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70FZPWMAvtIQ7kNvwG_sXXQ&_nc_oc=AdowolxeUxNbdf5jq1SL9WqQquZdyB-gttSzdvU86XDdhvCAr2OHrNimQ2tTACHCDtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXNEmb0VQsjsc08z1FhWLYfcduceMy9L7Wqf5XSnPqVA&oe=6A95C87F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCLyBYbQuaAQ7kNvwE6mD33&_nc_oc=AdqelKtHHk0WwZqtWuhZwdy50h60lj91bli5o89tJ2pxX564yYyoS4BK-B4UT29i_AM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVE1Blq3Qoy7N2IuNcIbEfEIkfTWS5hIvEpEQFIJLdNA&oe=6A95C68F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv5FDUgfFh0Q7kNvwHC9880&_nc_oc=Adp-IgvrTYB7c87lV-EV_aixEfgjC7v2xCamWnWahXv33_-vFIm_TY8C6GbeSClp9BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZUBKHAd8P8UEmJzAHEVQOYZETbswUEir1wwGfUM_o1A&oe=6A95C38E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbGOAzTw7Y0Q7kNvwH_fZ2P&_nc_oc=AdrP7wVOMUzdCTC4ODVNh3A5AfJMagZF6khYz8i18j-pXafCHXNUNe1OuwHYmQ7OYTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJfk16CXwhWQrjmrg-S4uM3mazHwOwkUW43xTJLaywHA&oe=6A95BD7A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wS745gSZB3sQ7kNvwHV1Dqa&_nc_oc=Adp_lYW3QbZQZYO5hlv0pXj_blVpFnv2YM3vMnHeBmVJQ3XUAQSrTg2-HrHTMBSE5
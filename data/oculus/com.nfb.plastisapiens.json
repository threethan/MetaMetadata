0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10EsuO-v0zUQ7kNvwFzRPAz&_nc_oc=AdpanVGlHyoiIbKdrxyyJd1Lq_ew6P2dht-c39RpXRcPoBcLiC359TPR24L1OjvOmgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlvj3KxznMHb4leKOdbGzWihQJQiSNYCOEuMJ97TSghw&oe=6ABFC3C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hgcStEeYd4Q7kNvwGM7osH&_nc_oc=AdrJPKyh3wuwUyl2qmyEpdJkbxu87RUv4L-pHjFoNpaowCYueGOzqsj8ZhEMAdyLSoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh3TvPrXP7et_Qf-u5pbRe2L0v1LF27vfetAja__QfIg&oe=6ABFC03F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzkhApOQ6tMQ7kNvwFBJtHX&_nc_oc=AdokiwiiYfCBfqexfoHH7yGKeTTReD_E_WcOKMQoYz8W7Wlb0kHL55Pg_NqnJGhPZqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSivMoU98ufmq8U5djkMz8Ber7Q3yvpTU_MA4OBnh7kw&oe=6ABFBE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5-enX8fyCEQ7kNvwFv8pO6&_nc_oc=AdoJnmUWkarhgT9vaz6KGuP3A9JDa3EOqAzA_rS0hbZGDutfey0kFjYBcEwG8wpjY6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjWdmyXdTaUxMbL8GCGtPWjuqNaIVXwnzX-Ewlev9Tag&oe=6ABFBB4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw8Do_Ju4VMQ7kNvwFke7YT&_nc_oc=Ado3JJl-RPmQ-QSjZ8RkPsg3zzZ88Z0wwU1EJbenb-lZuIYgccoRMCghZOSAmN_csPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtt4IzHaSeMQ7sSJyeWbumxqTwdormWAA0fvV8sLnlIg&oe=6ABFB53A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xY6p3s9-U4Q7kNvwExMICe&_nc_oc=AdoCT5X0lNfDrXhmQvU6P8jklmY8H0lkEWrnDbOT0UM6qIg2lSlpkTEQnFiBBCRoe
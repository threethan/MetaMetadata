0f&oh=00_Af-Klb12pMsC6pdaq5PrvNtJm_4WmoVvcP87RPBtQhyubQ&oe=6A2C3339"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN179XwJYbAQ7kNvwHyhkeD&_nc_oc=AdrmG2EwsPOhZU1q3ofv2s2pGuH0vsHaaE3T60l5M6Pmp8sTsfS8fwVmH7s9WawyBY0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-VYY9hccbtjlCb3ekqwB0tzyhhhTXTIVNtn7J_MEVNA&oe=6A2C1BC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxO9Y5kvM0QQ7kNvwFHOL-X&_nc_oc=AdonyPK0FKLFrhN8Y7FrWJ5Q_tCoU3SopNvSIzqb8TKTZxwZYzZkW1SYcfj0F65OsV4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TZaEZFrOxbJE8lj5f4Uhamb8MxOFF-RKV_DaDh4tg4w&oe=6A2C183F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmA-gGJcfaEQ7kNvwGhecb0&_nc_oc=AdpjxMDxp32mOtWq34wcK5598xb4NvzCMrO6L9gF9d-XTRKz3uPKWz6Y_5FCpzDa95E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NpkK_EnVE9gVBtCNk88T4uRMEC1qQCO_K25UbDq3Lbg&oe=6A2C164F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LDiqGUXlucQ7kNvwErSKWm&_nc_oc=AdqoAgp4gFrNPphvphUGx04_qXUYtCW8d44rsWbXizOwe0fyIsEDBdbm0zLWcfR3BFU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G3l-cdWKU9zZImtKDRzXKnp0KR8lqFXIsOA8iyLsndg&oe=6A2C134E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGyE6NeIi6YQ7kNvwEZti10&_nc_oc=AdqHMxGuEAptk27UazXByyIAw7AWNAEzPRozypyafXP51rAmaLD99dn__oqDxIdoIdY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LDSvU1pmm_L28cdYtcmDryXRU3We1CaETeUAty6LSLQ&oe=6A2C0D3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af63vofGb3qHLN_X0Rk9OaJYG-z0RThXH5gry-EUWsolhQ&oe=6A159179"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfUI0ag0GhUQ7kNvwFVza2-&_nc_oc=AdoU3AD75-A8dd6Js74hB-pvwaqr0Sxo9_Uy5FhhnMIfTxjNRnskVb3PrgPnRxC0_CI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74qWetR6R5sD_4pYai7Y0Ur5DxjDz4yRoN0E92Pl3kRw&oe=6A15B244"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D3_uNlPKyQQ7kNvwFGsS6P&_nc_oc=Adp_3Akd4_zTadcZvbEVyrquYJwpuYXd7wo33KY8IkwLpVQDdstkppVsxM5-0TlnBkg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DCyigmOgX7VMuXBxWJqh_a5Uj67WcQKxYOdMAqABK4A&oe=6A15AEBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-75iDz0to8Q7kNvwH5EVci&_nc_oc=Adpldenjq_8UHIUqiKyNCuWfxnNeT01KiRLi-4OHntaBU6vFrRSH2MNEuVqzj_ouaS4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kgwOR2UitDxjkKrbgqWv1MMWosEj-PrnjQ9ixd0kuBw&oe=6A15ACCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLO4CjdYK0IQ7kNvwGzsaIe&_nc_oc=AdqcYf3a2-OphfEw7YVpFqXF8Go_4v7hA7Ko-pKIDWixsxsWE-7YI4q4htoBUDGVJOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yOrk43zqdt1aSCntfDEyBe_K2UUoOjRx4rgol-VZkRQ&oe=6A15A9CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0XmPqf42bgQ7kNvwFlcMxC&_nc_oc=AdpzmN4dcoga8C5va9DL896lvmHq8xVPvfSOmzu2KwVazRXBeqrUPJFxZF3fTe6fxsU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jRId5dkOWjiH2Zy6X-pFvTVqId3x_nT1zZ7oMOX0jgA&oe=6A15A3BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
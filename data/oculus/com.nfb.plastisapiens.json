0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH1Tt21-SegQ7kNvwEyjRPN&_nc_oc=AdofZIARDpR-xqUZSysBO7uhoAP6bYkBjMyf15W3ZYLisnDRjOKWvzntk2rnWP9fZOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVyeK_jHbE3JAvEHs_x4NCd3Ip1H3YsESQyrWMZ9lMfw&oe=6AB7DAC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6CB0ZrqDuoQ7kNvwE5ZeHM&_nc_oc=AdooeEc0MdOTIinwO4aftbGh36H_NNdg02ubzbHu_sC7hZM-HYH3hGyIiA_C0xnGLi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEsP8XBIYsXQI2_9BpEpn6p2CpM-9iwsrLqk--kx_ACw&oe=6AB7D73F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX3BbIimpHAQ7kNvwHk_the&_nc_oc=AdqX-klMDvLqNG90jYc0WSzocwbqNsGe0uKlWveVHxgCgZUfGfugSE5WpDzpuBtuKiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-7bX3qm58SVrHFUBI2vXnckNlFvqe6Y4xk54wEnjhnw&oe=6AB7D54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igIrWH2-PIgQ7kNvwFi-_Om&_nc_oc=AdoALpdNtBWkEqmDtUaJ27sRI8xRnTwIbdGIgCp-JbvX9S-eJt72NOaByxiIObV4vw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXRJeDdv3Bf7zct0aEVpaZVsQnQ3xfgWJ3u_TqhFq2Ag&oe=6AB7D24E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFrE35HngAYQ7kNvwFV3sZs&_nc_oc=AdoFIBn5lijUsHFL3e8EU1I047AIO9G735DTv29Q0fk6rt22NHpL68NXLO8TUabbUkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTKiyhdoK9C01r7rIRltdUHzlMlmGZ9BaaQOdV0oFduw&oe=6AB7CC3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMxalOaoRTMQ7kNvwGILWiv&_nc_oc=AdqJQsa8Ul7sX3FiyS3KfJZn5eAkoEcydor6nAiQCYrVbE_PNbWlLOewFlWj0vRn4
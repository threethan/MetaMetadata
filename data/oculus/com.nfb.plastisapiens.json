037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyTLdexhNY8Q7kNvwFdO64u&_nc_oc=Adpg0WS_yRL75DmCBaZOtFLIMenjLZeZFnWjntWaDchYd7hpVoRp5Ce5FW0K-QoJdKY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRNdPu7CI3ptF7glBCovejbEfQkgSO-waSRyLSjoFe_g&oe=6A8D7284"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKSovZt-e-QQ7kNvwF8HI0G&_nc_oc=AdqVlh8XgXbVbVCexqRJevZfRG7ZheKXmoFy4FH8i5vbhH3pCNJFtHSuVPJMUJcz_gY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRS9qpchTBLpqFR7veotiGq6Rr9XOFQ7aNPFkLR_0PJQ&oe=6A8D6EFF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7VQO8c60VUQ7kNvwFCpPKP&_nc_oc=AdpLz5okJtM8IFRwtjaiEMsAIF29HIgfw9Kovj2Alzx7QBLOYARimylnxP0Mqu7gqlo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-kTT5y4RcwAnYh79NZhDAojWdd4uPkmYkT6LJtJXQOA&oe=6A8D6D0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEdSas77E78Q7kNvwH3UUou&_nc_oc=AdrOo_kyTYIJ8FAfDzYdDAhBOwP-L1PeKUcSEiPpEQV-eJageB_Ul8rDLD8EyVlDtvg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF9i4BAHXfooZyKkGnBQcCxp0hkU32N0Iak8YyOqMi4g&oe=6A8D6A0E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG30QgAaLv0Q7kNvwHWGrr6&_nc_oc=AdqcXqiZ7VmAZoVepLQ5Vr3XyE6lrjmjawqmvmS0Pgp-rolk47zpGCM-qtsNe2Y62UE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD1-37QObgxtM_n9-vBclGSZGZyWfuCdCpBP62nqZGww&oe=6A8D9C3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWfx9nnACP4Q7kNvwH89HFu&_nc_oc=AdoOTCsc52UZwtB6z8QDU5n74QE790PBVqI5ctNRMc
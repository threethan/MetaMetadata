0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNKDiELLSBQQ7kNvwE19hzm&_nc_oc=AdoLrKQUZMXRZAZFaFYb1OctT37r8QMgUndTfLj2tIrRnEVNiTKa9YtCmtQGPnvUppI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6Rz5lfwOSSZa7JUOOgqOLqxBs0AfYQkJuKb0KGNPHiA&oe=6A92B884"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG263FV40Z8Q7kNvwH0p54m&_nc_oc=AdpkFIudxF3IZ693TuJ2eIKX6-KxkcDG3MI2DnNOa2M6zbIepDwJYjMd8qnbG3kbQgw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkjFTRtACka9c5KPS3nSvTS5Vf7f8gFMiCt7HNW5LUQA&oe=6A92B4FF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVKeNYUvPoEQ7kNvwFgZ2F3&_nc_oc=AdpGN9LzP4rR-h82M3tkRdS0FkZ1-zNx2VqITtTozcL45MZRBEbW1DqM3k7O1jjWY6A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnbnktFxDYjkNtSA40kox--wUJ8PR4RTVeIXd4AnjD0g&oe=6A92B30F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-F-PtYVDU4Q7kNvwGF5Um6&_nc_oc=AdpIDh90soUJAIDd6oZMhniKDSGMIbYtB-HfkeV8ISwVIRYocpI2tBAhtQek_pbFt3w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL9LoqkhjAs_FbjmufFzZjIVDsXagW3FZUvtHUbtQvUg&oe=6A92B00E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbGOAzTw7Y0Q7kNvwG8Jz45&_nc_oc=Adoapwt-OESmzO12bslWDeOAB_xZbp6IYRYTBbhLx0iPAJMaW8gRw-5DxK8whHfVdfo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5cy4Hzvmh6Oq2CpcrH53vBJg1vxEBIjFarbGnSSMgEw&oe=6A92E23A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2ZvNl63XxwQ7kNvwFq81_W&_nc_oc=Adp_TO-_rgwWau4Lboydo7tbkkMjvcNfhBkGlkbCmn8n67pGngEdB-ylaz74C9eRC
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpyNK6oAt0cQ7kNvwHarKpa&_nc_oc=AdpV-YGG8y3HcIe_0sy3bGbkMV1FhP9c9UVMezbrbAyrPYUPTVDVsrhMsqJwuYkp04c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCLVKtieYnZJDvyFPO0RzX2SXFq8iokHpH0YBdOsxkZQ&oe=6AE5FF44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGt1uAIpBb8Q7kNvwELh55Z&_nc_oc=AdrX8qPnDqcP4xHWWr_jdWMyQxTOqgepa7_xAF0wd1b0KbnIJfwZwMQy4K-lACH6ap8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI8tU0sJYo0xOUyVFNtxpFupEyHVNJIpcc6GD_DHyCTA&oe=6AE5FBBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AnvpsES2HEQ7kNvwG3OY9r&_nc_oc=AdqnJdG9NTANo0WYMsgQqpUK-4PDKv93XZLbpdDpLwaYh_UNuBlS3-f_RD3IH9bBYfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpilnJBOuE9_jrhWhrU3rwNkb5MdVyDTXUfxBgZFP8TA&oe=6AE5F9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T7_DtMalHQQ7kNvwHOyxlC&_nc_oc=Adpd52BwTvcQ7YfsThJkew9bL5pc7ecLrGL97rYzFrW_XRetRZqr0cIpiusPA6kX80Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3RcuRtEmvD08_zOhgsyXeCC-rUfJQTqWFvwlJK_hc2w&oe=6AE5F6CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx39DjEy9vcQ7kNvwEOkH5t&_nc_oc=AdooOKqjicaA33uJgYNv1IFTvJKe6uNgqchhr8uVsW5Nr9Kecrktx6b5Ofzz8Y0oK4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJJBPtX45HKBvjSL1YEMpB_vgQ1ZluzCtWNA7jZeW86Q&oe=6AE5F0BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U-wvKA9CboQ7kNvwE5kN9d&_nc_oc=AdosGYUkofj0yKEsAHeOKiuuES1SK52t1p_OqyaYTbmN1jO2VCYO09kLG1Fu6DwKy
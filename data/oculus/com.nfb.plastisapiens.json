0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKcXmX7iTOIQ7kNvwEqxJpJ&_nc_oc=AdrChuO5XlPabj8Ef_n7emS9QWLgv1zbeKqVvThj-3RTb5OZXMtps9YSPlmVnwVx_nU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpOu26yHrTX6SvOpnfrLqaFCeK6SM2EHabzMlNYC5GyQ&oe=6A882C84"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1mvATSLULEQ7kNvwE76jd1&_nc_oc=AdpvLQPk0rxoLpWd8PdXISVhGphy8jry9aE0_8LxS_hlwXhdugmFv2-qqJZxP0tJdBI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpXbDeqFJ8ihEg4sbENscweo2iRi9i8WB3ReZCU8jkJA&oe=6A8828FF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI2tuzgEV8MQ7kNvwFEz2qH&_nc_oc=AdpnPBlCr9I3xdzec1asV65NysCrf2CR07sKSouskjYEAWW1J4mZIHuvLPtII_V_sf0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI5p-1YSjnzDz9RPc7zs3pY0eCLdbs_1Ml6ZqYTZef7g&oe=6A88270F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmMwrD9fVFsQ7kNvwGnuz6v&_nc_oc=AdrcUsfCnoL2xq8JhkwN38t7sWU9KyzrsXX8OfSGmpCV0k3em70dsUgM0iacbOsou80&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnhnuNG61NV6JQbC0jB3Msz8zw4mlqGnnMSE8CfCz1KA&oe=6A88240E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUWfbCt-AysQ7kNvwGwm_7-&_nc_oc=AdqU7XPMWwYI3A4jpMRcTSmjZs3F6AmjFWB0eV6qwNlTEHFEhLDOdj0wmi3ZFkU74N4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFQwGXL-3ueFJMQ93VBRkvOtr41DPagbdNWfrDeUQwKg&oe=6A881DFA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI3DIXrotb4Q7kNvwHlNxM2&_nc_oc=Adrkb-XMgM1KH-04Fgm2z9cw-JHQ3FwQuoWrifVmOFK550wwoguI_Vv44nAV2rRWj
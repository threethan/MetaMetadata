335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viDkQJMee_EQ7kNvwG4mlGS&_nc_oc=AdpU1zwNtv55tZmZfkUWUkYihSShV9WRGQll3JeTlkH6m2gRPxWvaHnSFRRMFKoNAg4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI58UqoGiwQRRRzeugnNYo9zdp1auz6ccRHZSw7Tos9sw&oe=6AAEA044"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jk58YJ3tbEQ7kNvwHyJ2Pd&_nc_oc=Adq-VyMfesAfXXmtvUpv14352Bi8pX6PvSlw2GyB-VUw8akVDc4SO9rBOO2ujvR4_x8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImwwdk_XKqKjNynmTzKkAq5al9ZLIB6v9BACII3JLXCg&oe=6AAE9CBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4QjR0geQlgQ7kNvwHTb69P&_nc_oc=AdqAh3K9k3Rdt9YQ_Y8QYjXsQGF6j-usBc3RInwY_LtTAOcZa0fq2nmI2J2JKTib2ZM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu160FbIIJENXnMuerEuPzEHIfD5hf8NYPNFCeBbFixA&oe=6AAE9ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF3dJIoby8kQ7kNvwHTX4tT&_nc_oc=AdoHYDjlFEIBVYlqcCRqhSck0XK5M2UnPPmiijehBIqXXj220GpStka04QoPlx13kDE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV77zpOcWiavFGkjY4J_A5F8R7ehUiQGnbrAjISKWBwQ&oe=6AAE97CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHw3kOID3YUQ7kNvwEQbWib&_nc_oc=Adp9hjxv37_p1ef5yz-zktibO-ww4-34O7mJnyl7t85cjYEcu9rgHpVS9UNFx02Udx0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdNJSj4Xo18YgbiksrpJ-6Esa2C52FRp5Xw08NaejD6g&oe=6AAE91BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMs_EseQhwgQ7kNvwEK3OM0&_nc_oc=AdrursVbbx7c4kdnAbe8puLhNcFbX07Qq7vpdxdFpBuChNizzMtpP5Fuk
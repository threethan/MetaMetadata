0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgw6G9twFl4Q7kNvwETd6yK&_nc_oc=AdrF64Hp5wDBgg5rIP6jtEGJAoUyIgp0cfE5jeMNXK4vUaveiuiG5G8gsA4hpUYKvy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKFfmcaNDpJ5QshUtT8Ebm3a7oQhGQ-Fft7_3EXQdQrg&oe=6AAAABC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXCzS98d6rgQ7kNvwE2ZvrL&_nc_oc=AdrQGEuBNlXQoguyIwIUTCGd9U4zUPVAQwQvjetvkjj6Xitw-mcPINo3z20ETYzViaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYfZ9mFXZQ-K8GYqqh3-lDPPC9EdbLtXlxxNwtZ7puCA&oe=6AAAA83F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGShWtppFa0Q7kNvwFz6OeG&_nc_oc=Adp_VzeJfJhppKix2GaRITkpK9VQnP9Q0clYP97pyGcheRo9iuImMNx87azfxsFrpRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpAYj1VkofK9CP8aCTj92PL7Qb0RaWIuetl0E7dPlDig&oe=6AAAA64F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y528XzYhASMQ7kNvwH156Bo&_nc_oc=AdoYdWTvV6Oy0uq8rdJSbO_h_6pToen5Fg8m-jqU6poWnHZtjbp_pvt4W5y_Zx7i-x4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6XruiiJ9mpBJPLHwqxmS2btdAWFRAjllmJ5nGMW5A4w&oe=6AAAA34E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0uz8OoPdEcQ7kNvwEKBoLH&_nc_oc=AdqvUrXWzV-zvQlurqdDDI8FJOj5PG1VGaEA3aSRIn1ees1cAMlAJcgiguFDjaJ3IpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyCzhme0QBiIGwREL6wreEosy5s3TLovKmiTTQTqut_A&oe=6AAA9D3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIckMGkdKoQ7kNvwEW-6tG&_nc_oc=Adp99Nh-YWymnQsuFSO0ifcqjmO9_0syYS0skRs959rOxV9rgFg32_km-OKwBhQTU
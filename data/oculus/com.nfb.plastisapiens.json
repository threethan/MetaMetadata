0f&oh=00_AfzxA4uMBMzJDGyBA_AOMx4De7qv-Gh3ao7ZFRq66nCZXg&oe=69CBBD79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZdiZ98VAvYQ7kNvwGIkzY3&_nc_oc=AdpLwg7Fdi2lor5uGkjMYy7l-5qHj8fUGojQ20s8DI63RRG_mCv8TItdCJ7PdJMrF24&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAAaWcnxhKubPPT6YpQnHdZMnvTg4qnbN08ROnW-JS_Q&oe=69CBDE44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKdpCt38MkkQ7kNvwE8_VTQ&_nc_oc=AdqEKg-oHzMw4xmD7kxn8iV_ZKYpl37fqRj6WVPv1VzMxaURIIYqV6n7kSqov1yKpcM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_PADS6oG1WM1Tbf5MCcKyRfHZvSzffSxW2Hbmc_Tg-w&oe=69CBDABF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgSMbxM4kqMQ7kNvwEE5PBB&_nc_oc=AdpDcIzF96yUwzXn3N0DtzVoN4JM16zPbmeuMBOFbn49NeQQRA-5r4Wxm2s7i-fMgBY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx080HKWuOW2oPn7JNMXntA3w_QRuN5w-2OE3M4FSftcw&oe=69CBD8CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP8kB7vk6xAQ7kNvwG4f0bV&_nc_oc=Adp-p5TjXUQwVbgzrZQk7S4I6e64tEaGoQqQr9LYhdAROUNsLQcy3GvNOqyYmOOlMpw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-DyTjgRmF0_Anvenjkg2_AwW0LVJmZYyVRbIwodCQqQ&oe=69CBD5CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTa3xlbXEa4Q7kNvwHiWahv&_nc_oc=Adq_weuXO6KOS_rpsRcDn7BYBsxUv7xANn3SYFWQGJt4-pD_m3EVDfzhUreRINBTBm4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCcM4j5cvHvOZiJwy1aWBXOM9h2J3R5sNOa4LL1L19Hw&oe=69CBCFBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
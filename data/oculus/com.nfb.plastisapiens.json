0f&oh=00_Af0A7lZxoWZXdrFKk2ih6g_uDBTuWgtqkXbAkA1GjQ5tCA&oe=69E8BE79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfXrVLhIDX4Q7kNvwH5EMqg&_nc_oc=AdqOMVR0p-HMZ9VSnDMxZ33zqojiOdnmrpAo9vRKPHrfeO82-a5M-jqvYpdOz7JqLQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qax19drgevwpytXusHu4-RwIz0bbN7kh6rwvuVpIlPg&oe=69E8DF44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by2fjDmq5rcQ7kNvwHCtKYA&_nc_oc=AdoFt7rJGC22JlBgWl9Vpn78eAsR3Bc2MB45XeO44cy6cL1hZv_jAOaEL23JkgAXfxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g0w_z5GkgeT9aZZsj83CCH7Ur80qDPpqNAYINhwbCuw&oe=69E8DBBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4-WGHxKohYQ7kNvwH0oTNj&_nc_oc=AdoAR-ZXEOOyyGVIhk5NBayiWzN-A8ohBCSjVZ-EZnAZi1GHah3xzn_FhSrlkCoVKtM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wvehr3aw48sAe0D7gIB4XU1bW-5rbMyDn0CBOOsLZHA&oe=69E8D9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf5t-9kNZJcQ7kNvwG9-dHy&_nc_oc=AdpuuZ9AVIvawSHpxaMeRpeIRXWh47xms2zCQSabooSUZsosd0R0LCVSeq4Wpj3rMso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V0hPS13HPmbkh-JuxsXUrfG-rqfZVTTHkP_K4mABnKw&oe=69E8D6CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrjOozRAQ18Q7kNvwF3jxmT&_nc_oc=Adp551eTGOJO3RDzo-1uwAXn0q3luGqCG9-56ygqy8rJDH7YieDXIKyqcaRn4O8MkJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19KKhkdvJ88hi2LvZe7nv0WtHTZjkEnTI35t2-Q63M7g&oe=69E8D0BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af4ER6UxcXtctFybXtaMtZJipRqip5i5yBwkaPHqewvvOQ&oe=6A0B0579"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_oed0byJocQ7kNvwFppTG3&_nc_oc=AdrMLzwL--bsMs15vryd4sUipR_IR3yEeUnJvUZn4N7EKjNq7Tw6kD-7dj_sgqsKt8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GqC0qTagI7MRfzujwnjIpy8OTy00kQf8HFLLb-ij25Q&oe=6A0B2644"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_LqJCOtzcEQ7kNvwGCBHHa&_nc_oc=AdpWPGPC0EqR6EsN75MZpr6cj_HSyoPossldT9Ja_705oeE0IUU3SKQwwXZ-oaiecbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75NL3jQNvYMqtYZ2kX9fJK2D-E3bOjzygs79ner6YXHQ&oe=6A0B22BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT6ifcaotIUQ7kNvwEjjPL3&_nc_oc=AdqSGDOMoqK9EECtPitm2Xi5ruTXytRuPF1qxsy8wIfN-UK7VR3yHYnm1_yT8AjC-hs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af790AesjwXkEFmWuBoD52TMeMJSJ_dH6RZIvgYOuzhUMw&oe=6A0B20CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBNpsB9rVIsQ7kNvwHH5zxC&_nc_oc=Ado64VdkJPcSZEYaI8BnocgHPJRQGMSZ2Bx7C1HVLaoVSCLBY20qjeQgj3jM7hk2GhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-Ap5Xhs3pH67hzU_RlqFgPmYUXJtj3J-BECxp8FugeQ&oe=6A0B1DCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jabLbogZk5wQ7kNvwFUufUb&_nc_oc=Adp9TtrxmOX0H63cV6FjqbU-N2U9_JVP2PyJiLoPD10b68dhAdfHy-Rt08Utqh0fzeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d3Pp_Nz_a2qMOtfBl2XlbnYV15PLPj4mscPOXz_XF1Q&oe=6A0B17BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_AQALTghANeKGGqkJX_C81JWENXsF6unxFcdnNGK3HMNPWQ&oe=6A5B70F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzP4JtWTCzkQ7kNvwGpf9aq&_nc_oc=Adoit9m-VWDe26BYlkbVmORNlVnjT0cJLikWIQ8Y9-fhxi7ehxMIWZxcYfVd28h4pwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBrIoU-nup13-cJjOMRN2btIcsGADdCSvF2HRk16_0wQ&oe=6A5B91C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTdGBnj52DcQ7kNvwHfg_Vv&_nc_oc=AdohRyz4kcJ8vRFL5p06oE-0BFwa-zmb1pnp0Omcr7MPnTUluam6sUmvYFF_AJOZSCQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVe-8WHipuJl6cixmUVNkc4n0ieTMXZpRJhn9LDrrRaQ&oe=6A5B8E3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuQybU9NY-gQ7kNvwGHVfQz&_nc_oc=AdrqdLaT-3FMHmu0gVjcMTF4Y6Rlex3CdfCAxbmsES-0Q0tmiGOMvqRbiSmUc1pxfic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNsKKviFDDO07kkvx4Nft6vgBpzVBLx9vcU25BW-0shA&oe=6A5B8C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjvEL2CCprwQ7kNvwF3n57j&_nc_oc=AdqqY7R5I84M6Z3UfY2UTqJCO1wIe744c6dDzeJHMbdvgVkK2803z2YjJlK_IN-GP_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNMLn5iiJeWRCzZOd-AkDf-BGCqmR1a4FR3rYSinQZ1Q&oe=6A5B894E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaN4pHnr9DsQ7kNvwF8c0bU&_nc_oc=AdraczdtqP9coWQEXFYIRLcccykWogDY5_pEJJ3iSGP_nKBGBKITc77hsvJopRaE4A4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC5WU3M4U8J1QcYJayCTu-HW0SQSWLnXRrncj2Soa83w&oe=6A5B833A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
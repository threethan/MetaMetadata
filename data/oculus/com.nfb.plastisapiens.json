0f&oh=00_AQA4qs9-UxFEYugyHaGkjIezdRyUIq48mh3UJQY8l1vLag&oe=6A5387F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP9fe_eV4ZQQ7kNvwHvwFvG&_nc_oc=AdoIKGTmg-wfkGAQvdlv7YtUv6gvu7WHGjbpav97AdJCgzUpLAPh31XSQeBya7fdVEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi1vZc9_CqxsAW_dCY_JI5iAT4ylqn6jVhQ_Se2wFf_A&oe=6A53A8C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nBi5W8tGKoQ7kNvwETkjXJ&_nc_oc=AdoyUKAPVxQBAMsyNoVxlR-77EhROrZUvw92jn9h-l63Vcnln0b_yfcZxsZrc3T_z_g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCivqhJAaDCgM8beo0H_kl64121ogBqPnV9sRjdbgcavw&oe=6A53A53F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJgn4qLrnmsQ7kNvwFkDrlR&_nc_oc=AdqSk3g6ahoqkKaiyWRBpIKKI2slilVlTAMXzhtSUqp6hahkAjLQ2ZlWt0SDO2ObB5w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4TEPEwf8QAM_GhiWc2pOL_IzmyOzjl4JyF1QabdTu1Q&oe=6A53A34F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok6fZThhaNcQ7kNvwHkCtuv&_nc_oc=AdokE1zmdWY-6DjpL0PXVaQlVMH_fitDk37aCjHlVw36RX8U5PySytyi4p8hRa0P6j4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeEEqmrR2lidgVO9UW074r5ZSl3AklnsTOeVEr3kPhKw&oe=6A53A04E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hngPi-ajEPcQ7kNvwEWIDTF&_nc_oc=Adq9uUn5NgwjMENFlkos04w6HPd6dKScyhc36ECWZfPbsVdeuNLRrbkYnCyh2UhR71Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAowvxwStDiAnPlacLtIcKCDNv-qg15_g91cn5mzWC1g&oe=6A539A3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_Af-49ftZqDL1991NoN9NY6mh3bB_KaVG5qfeBuaz8sI8bw&oe=6A244A39"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OpwRHXSI-AQ7kNvwEyIuTp&_nc_oc=AdqBjRHNpGll96PL_fCtWqLw33nqPoG7ULULKt_wLS6lkUWMfupYo1LkmP4Qs-N9grQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c4jL3qQYrufkqp0xWTHnFSS7DLWxcNRXVZoGkvrrVCQ&oe=6A2432C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d12O65yiJgQ7kNvwFzG2UD&_nc_oc=Ado7uHmBStsk1jGPK1h043DNbCYRk2cXT6JSToNuCJl63C_cPoY2qy2x-Jfqj4w5dEo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vil5AQJboth3ZmQgJK0kJM3Qa6L2azGdJSwwA0mQnHw&oe=6A242F3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy6pU74Zo-0Q7kNvwH9AkvA&_nc_oc=AdqWO8lET9Zk8Ra3IF6HdBiTbxl028ZZzFHlKi4WLzamOqYcS-6hfCytrFnwS-m8cAA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8QgxD7l9Duqc5SuewDk0AYSl90Qo7EWsAzaIqq67dPg&oe=6A242D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owlBwtOxzb8Q7kNvwEh5n0w&_nc_oc=Adr1XAZPDoDmWQb70TKWNesJZlQJe25_1VoB2B-HxuFiPx5yd0KeQPlWh4RQb2AS0Dk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9giJB1ETw27gyTHNa73UU65dWMC5lvbKLqe3tq7D1O4A&oe=6A242A4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wtryXqVIf4Q7kNvwEBW2jB&_nc_oc=AdpGGlGDkp1Wzzz0ij73R8S07OMYa9hQBPO-5Z4UkylyLwm6-TRuErDHaXydimdcHoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cGiKeyoEMvCYFUnQRR9Jfburl8PKJnWcnmfKPk6mXuA&oe=6A24243A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
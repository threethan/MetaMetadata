0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFjWwkOZl-sQ7kNvwEePvS3&_nc_oc=AdoRZGucbHCYIHCcAz9LApn2H11892Qe514YKhWur6PoqyHzPeocXeqsEh2DD2twlhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7KNe661LGvyOA5oyEo79SEcWy0sdD8Vz-Xgv_O2GK0Q&oe=6A71FB44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a46ULZMTi0Q7kNvwGGXdbS&_nc_oc=AdovUL5iGwqaJvjRhnYdCcXtrZD2c4eJlRa9X_WWeRT_y9phpzzkpRfr0dgIkCLw4EM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4aHMrbXnZ5eGYQYW1J7kaUo0KnSEKhBKFRGhvraxTqg&oe=6A71F7BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzc0FEJnmp8Q7kNvwFehmwQ&_nc_oc=AdptS6y9TjqkxZrhKvSm-67_pU61Rp6nNTXi3PqMGCUPjBUzn7aIJAhmL8V-qxB5G6c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHohKGPTjq5y465V3Jg1lAgOuxpLDtRPB9wBmSU-6lKng&oe=6A71F5CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa4pixIldv8Q7kNvwFcziou&_nc_oc=AdqeyQ3WeRHi8RWrETem5HLzSgew23B-vdc7ncqXeihbUUd0bXymIWN0w9p2SfdmJvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmvBaHNJ6dPk8q04sGR1fq0VEMJHbx6pOFAsrMaTGFDg&oe=6A71F2CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk__RSXQRrIQ7kNvwFtKfxh&_nc_oc=AdrpgVALy_DO90sxcoxlyplI72X9c7rfz86dlCtT_Yyr0ZTbMkGwtKafQ67sActh1I4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFabyJcDvm_wcMHLeFz1H02EunmQspPUzdxc9JQr_xvcg&oe=6A71ECBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68wgrLGA1gcQ7kNvwHe3hYV&_nc_oc=Adr6ThrqK0DoTx4SRyyfbndUHkRas0dk0WRl3FY1j0I1IAzDAAyJJpTlF6f5ZPAox
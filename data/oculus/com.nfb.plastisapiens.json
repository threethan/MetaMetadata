0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgw6G9twFl4Q7kNvwG4BcYd&_nc_oc=Adqs0tv2CpCr-elOfP4dU92WGE-dwA9ST3vjrJdnFRLfO8zYe05m4zMby23i8rCh6gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJynkewIpZJR4BXG-M7aA5ToCpG_1ZnfUKnrVIKMnZY3Q&oe=6AABFD44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXCzS98d6rgQ7kNvwFYI1jq&_nc_oc=AdpukUaVDW9B6KnwWw9Vifa9vBXKsY2g0U-MfEleAzFKWEvQk810U2Z6AhdtZynfokg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8EQ92Pok9EEBtwNZsq9WUrZozIxJi3VyLFwq8x2Spfw&oe=6AABF9BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4QjR0geQlgQ7kNvwF834Gt&_nc_oc=AdrTnSYbDjVGS9aVqJkkJOfgfPQ4Qbz8NoERlxRGygkiURBKdzfzMuRqI1Na37m_F6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkupzEv3M0ed5vQTgyAJ69R7ieR4LaARCUxGpn-MjYrg&oe=6AABF7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF3dJIoby8kQ7kNvwFjzQb3&_nc_oc=AdqRpFVRUVL7-YXWvEWkTG0BC6CcAs1HLm_a8EMX9tsG_gk4s2Bfy-JiUCXnsrXTq98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2dNLK-aOZMXUVZG7cLSrPgH_UoM6U_kNBsJw3e1Lr1w&oe=6AABF4CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0uz8OoPdEcQ7kNvwEWUKIo&_nc_oc=AdraDDhnIP-YTKhXBkSdoyoCn-aN3ar5oSMgbgo4IoxMSLw5FgMCoieJds0FJ5TncGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8nupRaIKShp3gTObL_HSZEvrYyV76OBEnDB0OFFp_AQ&oe=6AABEEBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMs_EseQhwgQ7kNvwED1wIb&_nc_oc=AdoLH47pFb-eWC_YKwAdMHRKcKa3FBao2755D8c_knz9ovrjMXQNTaiRTFCflmUQj
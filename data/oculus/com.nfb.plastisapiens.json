0f&oh=00_Af4RfJZF8aiBP9F9V7Ru_Lsww1irKYIlCKhrrAxO8Jdsqw&oe=6A12EE79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfUI0ag0GhUQ7kNvwHMvlW1&_nc_oc=Adr9DZrvp5mydYLVeBb-1vZ9C5AcLOXyG9AyTF57efDt2mNFNdz8MdgpsEwvZTDbDR4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41NWNlprecl4NnRXFzWnMSRAMhWV2_7M3F4ZkvXh5gSw&oe=6A130F44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsvN3fMwnN4Q7kNvwEAhnW4&_nc_oc=AdoGelYSSxiPY1hLlETxIAyy7Y3N063D5vstBfDQSY5Ih6gIXyjDc4Ap1ZYnecYmFhQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75VQijZKdDWWNIG_Uxk26x4sr94fsXa1xYb4ewyBq5Aw&oe=6A130BBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5It3gJA3-4Q7kNvwH1_c6j&_nc_oc=AdrFed8hjcO_y12Oxy2jSrd1lOt7hbPQ3LYY6KIy9Zjiq8SaaXMnpmK4C5U8zyvADuw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cOtN-46EW-3GS7pQgnC_Ty40rxpkGz1zFj62oUE7OvA&oe=6A1309CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKibeOBp-58Q7kNvwGDjJNw&_nc_oc=Ado47KfdghbzimRpLPBkVN0jxPn_JJAlLzj42oUnlpGkh2XQHGZIrOX0IHmfR_lVXB4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65tl-Pdhl-vlpqn7KIbb1g5UIxo16QKLrKMzNG4PLqJQ&oe=6A1306CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmZO4HMwcvYQ7kNvwFj5zox&_nc_oc=AdpcjTrYdXWgLpryXSUvT9TDHbNFCFfMUuNb5eQMncg2xtnwbvzRIlDuMvBg1Vbtv4E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oqDhKDRPuHKVVqxWdXpMngV6kKuZu29XtguJAIXF_7A&oe=6A1300BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
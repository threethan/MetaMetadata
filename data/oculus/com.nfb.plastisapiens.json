0f&oh=00_Af3p5CFOm-GFkYx3OjOTBIeqydr9J5Q3EO1pE7acSxSb6g&oe=69ECB2F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFKxeJtH66YQ7kNvwH0Tibb&_nc_oc=AdruVa4RrSQKWT3DFQ3KkLpFurpnZN731QjJdxB2CKRusQOgw8BZRpFYZWRcBVj0rZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z_sCZkgM9iTu3ruZxZvZdC6F8s1otnCSPrwqvP53lPQ&oe=69ECD3C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOpzpTyXNLUQ7kNvwGg1Ydv&_nc_oc=AdrMrLyKGMrG3NssNy1rQygM2neOhQGRA0hcUtRBIw3zNXqacC-K48TN_lEaPbHK5R4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DwXYnfwqJeMQ4Vb-l5VL8RzoCmAZtgkw4YNrH86nA5w&oe=69ECD03F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeAhJG4pzjoQ7kNvwHwSkpW&_nc_oc=AdpRadFdeC6IgWVt79SYJyCQpTF5DVZPGSahZTLAjF0VdI1ofoWpdDqJUgVR-jckzVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t5SX24r6x-2skhuf6WvdyGiiqoMmuQtDKcN3EUwbgtQ&oe=69ECCE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngXUl1Ij3SwQ7kNvwFSOJ3N&_nc_oc=AdqiwM5MwfdPDtWfCphSYqwBOvx1hVXNKW16Pnjo9M19BRR9x80oXzfRVjXmDnN2XfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mltz8XLmckSZ9GT9WEQV5zJ7Kff1ilsgRUjUI3rPkfw&oe=69ECCB4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVryD9V42mEQ7kNvwFcZrCr&_nc_oc=AdqsVdW3fW5oiVOiWs_XptZh-3euUx_kZAhtPrQyS1iUYS7gSDUYoHjjtgVvsNr3Jy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UkkBBCHxr-KPibnattCtTl8s0yy7iHiSphvA0cytr-Q&oe=69ECC53A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
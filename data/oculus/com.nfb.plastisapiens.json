0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igysEnfXkOUQ7kNvwHHWT8J&_nc_oc=Adq1XdwZnGW6AsUsJEQlSKqNAFuB8JfdbOqqG-nFsfvnfdGvm_0-oVa8NdmHkz6pakM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3K4S10lHVovcebCLiV8QjNkZ1HCBMrXZY1JqHlrDWnw&oe=6AF8AC84"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjZz54wQVQMQ7kNvwF-DOMZ&_nc_oc=AdoiWhLWvTUzl2RwlOxbYOTgnonulAdGzuOtdbR248R7E60Nxn4uo-3KqV6MKeCxUQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMSWbP416_A8mB1JSIKdyL_c8QjD8gGTFtGm1Seic7SQ&oe=6AF8A8FF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtKw2fzOsMAQ7kNvwEci7d2&_nc_oc=Adrfsqb-gEAO0JTHlXtynGid_R655lsMqDu4NCoS2o9Sft44Nit2cTWX5RAcG_qJiSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-dqrL2IqLJdUv-pZzf5Cdqz_GGhbgSKgZqwWumAyvg&oe=6AF8A70F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cJ_dJkfNy8Q7kNvwHITihW&_nc_oc=Adov9-gjghvz9x9vHidQW3zUK2qtNliIGEcI9CfIq0nSbeRc0CqdfSoaka9TFpAllA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSHPLu6QK-MGbmQd2RLPt6koqQHhmSqnqPzZUFtD2CKg&oe=6AF8A40E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba5AxciJm80Q7kNvwGOxtug&_nc_oc=AdrWpGZyVq9LgDtJcvmQ9KxkWvTmDPY91YULmEB8Jps90QAy5rvNRATuFMXRiqSiYUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTthSPbbJMVkMqskTfmebcqRth3GmxDzjO3VuaSApUPqg&oe=6AF89DFA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPJkBukvRRQQ7kNvwGGo3T7&_nc_oc=AdoslxgqDXEfVdUat484_v9nbceBZyBQBp4SQzkiokd1O9WyWyRrrj7qqAqG_wBMD
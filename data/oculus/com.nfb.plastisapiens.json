0f&oh=00_AfyRLRtPfuED02TFKyNCbX5nOG4sR7Gscrs6t-D-V17WLg&oe=69C282F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO52f9dFVLIQ7kNvwEb3djg&_nc_oc=Adr8iH6zZuts7YcHR-pifg76XbJWImB1QdVPhxTw96VhhOJgI9yt8kguG22x9QvpyZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzys9owze4HKB97f68PrJvDPvBZOiJRaa5XVcueYVimBg&oe=69C26B84"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V2wF6i6VhQQ7kNvwF1pL2K&_nc_oc=AdqRuOBHZK7fhWm3AQbemO2mHzlwcUKzzJOs7_mhH3tt5wa7kYJDQAyKifB7-hCHV6s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5dF7R0YN4ObqO7oXwoKMKc94nNtDfcTBTtaeQHA0_HA&oe=69C2A03F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMXH4Ix5aTQQ7kNvwEVXow6&_nc_oc=AdrZ4P0Gnuz3sqeuQ8wxIJrZEx9eqHPxEQz0Nyac3p92QkK2V_vvBZN6GGrm360yZqI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwgqtTSvXKtV9-4nawaZURtI2Pcx9E7OgHkJHdRDn69Q&oe=69C29E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJPultAwmnEQ7kNvwGqkxVq&_nc_oc=Adp4lOzl-PH8DkKR3W1e4QroEdADoAWO4lZT6PIPSJnA7rh0piaM28xyDAF-vhXd0f4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzdrf5oJZVVAmUVDSO_fpYoGbu8m9W2vE3-XkQx7I3FUA&oe=69C29B4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKPEho39FuwQ7kNvwFbqAHV&_nc_oc=Ado4U3TLaR3wu_VUUVsG0dp3-jietpTOYJWRdphNXsor-owZvno91hzRFbITc3wrkxE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0felAJbLjIxie7eFCobaLr1E6UCT1dGx3XY87b3uHWA&oe=69C2953A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
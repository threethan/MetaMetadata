0f&oh=00_AfwYOmY19-e3cLoIppvmHU27vOYR8cMmSZ0xydZSzMZI1g&oe=69CFB1F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRO-cdictbQQ7kNvwHIEd7F&_nc_oc=AdrWkFsIMXXetUnvcDuZwoB4cPfAqqNwEdPOCepk65Wk6FOi5kP4_OEO3T9N43Iuios&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwghNzP8j42udz_X_uDZsU3DPNXIbujHSVJaRFGzBSK6A&oe=69CFD2C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1shhuNYaOKsQ7kNvwHXK0PX&_nc_oc=AdomKjJsF07wcLH1nh9233XbY_xqMT0TcJzmph0qHh7BRQN7JbKH1EAyWZjDoIwEJ9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVDHmJJAd-VMpBi7zU0GVqyDTwsUpq_qm9egqzBSDwDg&oe=69CFCF3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41VmYvzFvPUQ7kNvwHPEK_x&_nc_oc=AdoX0GYSNjvr4LYpkQH6O4avJAI06zyXnKa8Kz6NQ0VXvFXzmEEe5GT-HcYrNTlc6PE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTWEl_E-Xl_XB_IR7P4D723yDFnh8flUKMS0BtpzF5pA&oe=69CFCD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAOfBHSYUAwQ7kNvwHp7fie&_nc_oc=Ado2kWG1H4wzHMSQRWokSb9ihTJGkJBOF3KLIQ6l_ZIB3vyC3sIQ9mj7z_P0ME92vJM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMcz2F6b3rN3zHgD98TN5C6u7sMsXQsNkYDOg32UozDg&oe=69CFCA4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emLUgGh3LZ8Q7kNvwFBVl9r&_nc_oc=Adq7TBrIXOj04I3JFkkC-A5mbxCq8xM2M0oi5G0_wwwacOPdY0DfsHiZv0qgBNhgN7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxuy7Fc6MCDqa4Ol_80YIuwqtaTZmJL1A9e_j4n-w31Dg&oe=69CFC43A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
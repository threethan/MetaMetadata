0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jm2IfVH94QQ7kNvwG27c7n&_nc_oc=Adq1O0kUm0TGWvlyS1nA4v0NW398CdHdF0n-4TWBGdFoiQ4kAbipNUSwDnjAbmM9HWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7IM1Wsn9XzV-GG3_PBBqfqmuU2IMLRhOMzzfJwT2R7w&oe=6ACBA144"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwh-7nZymoEQ7kNvwGEFrEj&_nc_oc=Adq-QxnditlmNqaIRjpsN83K_pQOV3XLaBeiUD_y5YIHfZpzeraPYHkbxzSSgvlFfoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI2ISQ9raeZ1oNLhfScznrrrq8jarnzCl1qcBXrYRPQQ&oe=6ACB9DBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkXYlHAkFsUQ7kNvwGLXYUf&_nc_oc=Adq4lBztywN8OHvwWohxXHoOeNdOQU-mnk1yWjlSmms9a_CZeALAdu1-bWt_vaLb-Qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2An0GfXCah5-N7kMQ3rE3wyc_YhJOPFqvQSVcL6ZsAQ&oe=6ACB9BCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDqUbbhki8cQ7kNvwHYLY3d&_nc_oc=AdpBjAU9ZdGICWlQpt3i-hZYYg3G92NAhQSx9t2zh01GhogCxfhNNgwYJKsfB6X99H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQep9nO6D3T5WwoXcrz8hu8VmnOyl6v4_TR_jK5G9NGA&oe=6ACB98CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQuaX2YnfAUQ7kNvwE2I37A&_nc_oc=Adps2-XcfTa8U60l_PA2pOLI4wPB6GNuV3rg2JMH-3oTewrYqQuevjCxNDEXTKAZm-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQkDzCb3k3XN9l2ud_u9X6LIpYLmj39qgw_KCuXjzgUg&oe=6ACB92BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGUMJ9RG9xkQ7kNvwHutRhE&_nc_oc=Adr8sNNtaiHUWg9fNF5zCFlqhmV9lS0Aqj3gK4uXbGCvkE_oimnvGNKZZD78VDcTI
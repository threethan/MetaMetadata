0f&oh=00_Af3lBl0WD2VMNZlNX58BTRZsK2Ar7q1jKzDuzOpSsofT-Q&oe=69F34A79"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92aUWeRlMZsQ7kNvwHyjso2&_nc_oc=Ado4vGH9pPH9ZyqrPqvsgWt7x8eems7_vTttgyXoC8s_pgcv7oFejjuK6l-2rpGN798&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RnvbmR9ukeKjAVQtoKc1DPRMk4Qk6fzj9QDApZkg2XA&oe=69F36B44"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P5A0odD6FgQ7kNvwGMfki6&_nc_oc=AdrwNU1TdzGvUJ8sSNKgYC6fkcWpq9WMZpg_0JLBDvdUu6PbeCjuPc3Lk09Ru8TNxfQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NGu4Sh1zabZorz8dL50MnC4Y_QX8wWLWRtAKghxLLsg&oe=69F367BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kqgw844_gWwQ7kNvwGgFQZ4&_nc_oc=Adq4NnfAsPIR94R1TZYUZbNeaiGchh1r_ksO6cRsBtoQ0ezFOmXbtjBsXN448sDNjx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NiyPfBhMiyn6vDW0_IToW5hnL1OQHo9AoWgD9UVbYhw&oe=69F365CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO6Bq-MP1ToQ7kNvwGIFIL6&_nc_oc=AdqGHkpW7OSI1E52RhrrQSolfiXFZa48s1CdGx7BDRtdwE2WvIiBORnU6Cht5UstZac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RFnrYJchytriMIlyvou91ueD3MlFEk0I6U11L7zueCg&oe=69F362CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjKTPQJdYP8Q7kNvwE6rTTD&_nc_oc=AdqRLzifAvN_xuDmRgGbd1WDx-jdmeiMV_TZjmSzjoJcAnRamX9Qz9isqB336Q6Ophw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PdeC-hKhHOuRO_r_JaJn7c6agxgvHxeO-sNiLgX6NVw&oe=69F35CBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
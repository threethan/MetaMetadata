0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpyNK6oAt0cQ7kNvwFBTxfa&_nc_oc=Adp22MTfvH6QC8yBlyraJz6DDni_AfYjUm2ZKiaZir86wgGTdbGlPf_PxbKrxEy9H0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtV9OL2kB9S7RHt9jOVU1uSh3HA8eO-9kPOQmVDK0_7A&oe=6AE4ADC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWz5jUC_4t0Q7kNvwGyvmi9&_nc_oc=AdpgAoYrjS273BIA05bP5tfeO6_BtmVDb-hSf1dz1odG42Drcs5WnCvVMxNkR1ZgrYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeM__npRl6smaAApT4RLOeUhoAhObUwTouMnFPCmUaPA&oe=6AE4AA3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AnvpsES2HEQ7kNvwGtnWTg&_nc_oc=AdqP0JHgDKTyAUf2kqD2UvOTAl5kGlYBTNQhDVV4SGUBKseyzDubLKAJ-NH8uXXqi_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQSjVRLLSm9D8Tq7yEXcIH2JJCUaIVjtA4Kan30GhzPA&oe=6AE4A84F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T7_DtMalHQQ7kNvwHZJK0i&_nc_oc=Adpkrb_lYn4Yj5OWJKIKmaCtkWo1Mx2Xys7HkBLWWxwLi4lhtljVFn5ncHbgizrX2eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcISsmKH2zCPswsxm0frW-Nq3yKClg1gHJvlDzwsHQQA&oe=6AE4A54E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-VeGdWoVZIQ7kNvwGOI00J&_nc_oc=AdqfOdPIOCD-SeeWR7FAFl4x49cwCRxvbosT2zCCWDLERDwWx36866X9Nh09bb_o-KY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbv0tuF_541cGkYmjrd_z4f1aaUmm3ZzLvRK20dM6k6g&oe=6AE49F3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U-wvKA9CboQ7kNvwHHB8yP&_nc_oc=AdqUTBg2DNmMIKnybZIgfdNBQRbrRCxQiDNodzuystC9x20T_P6ojE7SS7l551o4s
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYL7P3BSUu4Q7kNvwECR-80&_nc_oc=AdrUgD4FqfIXNy7azSwXDcmph_wEehxxiGiYd2qF5FEv0YI-8fK2jAYlS57lE160Iyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc560vKrqzgd8WFZFcsE2E6RrUtl2z_1aY1xgmhD0mVg&oe=6AEDE844"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvyRMc1aGPoQ7kNvwFf1mse&_nc_oc=Adp9lfgyzxCi28nSDFKHItCSPPc6iQogh-FGeKuezkO4MpIU8evmMqSrfrj5B3Lkn5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOgaEqmQPi6dzOBXchruf-9g8ulA4wHeGM_ItYZdq_RA&oe=6AEDE4BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nZjIIaeVSEQ7kNvwHAp6Td&_nc_oc=AdrCYMuI5pNrmHyy77IyZX5RPldsvJpoP2X2x0LuDTiP3yNokKrCXz040VyxekaNBZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3GX3PpTaMTzY6hug1tLrgn8CXCLT5ONqgANJoOWlayA&oe=6AEDE2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PHGfvXXNbQQ7kNvwFg2YLb&_nc_oc=AdpFv9PfmkPO_NWUeJWUlov7Mcnk1-m6KUSnndHh5YOG4-qRw-QXfVzbOE7h4M8GWwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu7d5qt_pH6xRYEFjwDxwyy-DNs1-CeeB1jJj2Aga4KA&oe=6AEDDFCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Xw7dMgoW7kQ7kNvwGKBLBc&_nc_oc=AdrInm7dLj_RQE8sia5FJzXkGT7Pwtdqm1aTnqypHZn6q5rSuSiY6IYRJrf0WIdf2rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLmK9hrm9cdVGosI0gyjSX70r6inl3YcIygiDtjzl_Bg&oe=6AEDD9BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnK1w9EC0ygQ7kNvwFahVNd&_nc_oc=AdrR1a5aGnyWwMdZZCF1uso7wAdo6iGEW-UpfnDAu2mNBBsx1mKvJx8O6q6KHCcHM
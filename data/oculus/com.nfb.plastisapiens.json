0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM_WkHQRwIIQ7kNvwGUu0OU&_nc_oc=AdrDC2rgMeGZCMCWo1-0doFUGuGJxHPLKMMyrIfpkfmXo4Zsxu6adzyp7BpXQrqQvuE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP6aefc4sCz7MiAk8Tn6g4ox1Et0Um9MYzyFqceKOoUQ&oe=6A804384"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVVUp5sv6ysQ7kNvwFOOy9-&_nc_oc=AdqTX8BeU1BfCifO-ELFPU-IS8TdQgDb03hrw3Bgr0Mh3SECmieD-YIMrx9LPaXx-Io&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNtozeUJLjIPw9QM2aQrDeWfMNryhrrhbfaPRDib3n-w&oe=6A803FFF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhcHMk2FlnAQ7kNvwELsid2&_nc_oc=Adp2Oi39K7O46qUaPmZjDxyhbMQKKg8G_jQ6hluV90Ca8so6Tg4fns1HSHbx17uCH1Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5NZZdv3Cb3lKKYgnqFJROvqYXBE4OComO3VEDDfqSMQ&oe=6A803E0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y41W4ApV8FkQ7kNvwFGzhTc&_nc_oc=AdqR_KWBHjRVKUrLsBZqmbQ8O1OCUy63332BYuVis0XQ0Xzar_4jVunwp6vn_I0dQSU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFztvfXVGNqsu2voaUoJt7ehS6cII86pjhQMo9CRDky_A&oe=6A80734E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wc4jXLvkTN8Q7kNvwGUfxe1&_nc_oc=AdqEuOqKvpbXqqU06-JYARML228ndtDC2xc6WBS6ycBA4uQ30Ux69nqAKVYjlWzs8co&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxUth3CBjDGMUIgpFz-3NO6KBh1sOCrL1-m1GuwMUIug&oe=6A806D3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHyUiBCsdPgQ7kNvwHhsuBs&_nc_oc=AdqcxHcip3GGyLkzj442uVBDkWG4C2cUgIf-x03xdg0RS6LbopqSauorr8n3itUcx
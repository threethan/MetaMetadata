0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qThcLt2UOAEQ7kNvwE5oV6z&_nc_oc=AdrSSxyxeZgnq4LX6aH3sAHeXTJ3WCJtqoAYTZ7PBzf_sXYUBj2N3aA6f5qXDgxH4Pw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTsVMtllcqnRKur20sPWab6G-vgfdW8fortVVXfFm7pA&oe=6A9836C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x_zbMnupMgQ7kNvwFrbr1v&_nc_oc=Adrw5ubjgOuOo4V02sFWY59T--0WeHUg6CxCSWoOWdV1nPQh-LEAjarXqGmR3NWcnxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4de12-tsbMIZ0b8FJq_S-QWzR5nCh64pySszcXGzD3Q&oe=6A986B7F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ycEISv8dKsQ7kNvwF3c5ja&_nc_oc=AdoOgjTTXL2dE3J9BdiBerR9ZxR_8MBJ4eFmXncQbBmBBW3J6lHn590QHDwtNAIyWTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrj-tvOimF4Ydsi8YznvHX0A7K90Fa_MAGBU5fXSHRwA&oe=6A98698F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUOc7s47gfoQ7kNvwHSUcPm&_nc_oc=AdrUHJLkyxO5mBlKz_XzWJEgT9iy8Bu8DI2NVo0-b-zBmd2YBhiU-KxLXUq8mj0nOoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGxuf-Xals3ig6Jt0nATmuwuu_spZ8JiOrcFv9hlmwaA&oe=6A98668E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9s1Xn5qN4YQ7kNvwG3y07a&_nc_oc=AdqngA99iI8uoJAY5RiNWXzEH60NCPam17drFVcMczYxFjxr3zCvpkykw1TYfd1NWUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQVbbswu-aVEuPfLfFrggmxzApVdF5_P8f4rqt9Zkpvw&oe=6A98607A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J06IOOAae5sQ7kNvwF5m5zC&_nc_oc=AdqVPKVTzmoQlQzkRK8H39aNsBF68bV5_WMK_kpyowollpFTwOUo6ZETwZrxVAZx3
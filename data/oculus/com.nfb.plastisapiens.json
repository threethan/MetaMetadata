0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyDmIptm8GAQ7kNvwEG8-W2&_nc_oc=Adp7d6ewm5fm5tJcw-d_6_EFXpCvt74ECSEmZpQFVdhVEPGFmmYHflPbSPOFStHk9K4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4lS1p3QbWHfBBBPrUbeoNrFNLuI_cvP_AZtEfT9W1Hw&oe=6A7B35C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL8bO6iopGYQ7kNvwHTls-m&_nc_oc=Adq9he4nYzZJGg668YJVDrB8NjY1K7p4lTb_2-FAakxh5DJzohvkEZQOHQPDcI0x9c0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtaucGgfX-bGQbu5GVWzDhiA6zfs2GlzmnQSwZ-LFIeA&oe=6A7B323F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMu8hW0bQoYQ7kNvwHJYRbQ&_nc_oc=Adp0Me1Kjuu1elE-ngaEWr8WDnffbQWuKu8TokxtUfBuvx4zTnz1PjEPPP1SCvx1U-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO7Dgy3v9ctA7Qkp5GoYh1UUyKm3o2UQjKh6lF9D2IHg&oe=6A7B304F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H21uQlUYIMUQ7kNvwFMKMfp&_nc_oc=AdpZPBbv_mpBeqqL85lx-mRe7zv3BDRqA9gq0q6T75YAGnA1_6HKmielHm55p9DYX5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx7q7x1AbIu75GuOh39Em6wn3MAeksNlgb_dFzk5lR8w&oe=6A7B2D4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTzCbL1c_IgQ7kNvwEf8cse&_nc_oc=AdpaPBPhPLlqAD5QU57yxh-9MFYfxGoMjYexh8Ov8iqSJJ7iopbuZI4BmMFJVcrcJ9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbbjiPxUGf2h_RTM5kc0NFv7NWEnLzPzlplDe7wpcvLQ&oe=6A7B273A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KjN75ED3BMQ7kNvwENmDeD&_nc_oc=AdrYXwM8IdKq_AcRnkmvAe-BblUUbj3pfgYG5bXCv5B_RVKxUyrBkbtvBvACG1Lmt
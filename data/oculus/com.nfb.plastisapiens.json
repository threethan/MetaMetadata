0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR0zFvxnpxsQ7kNvwHV-vTv&_nc_oc=AdpVgNlbOIOmUvDbFMDdMil0ieYxMQHz4XeyfX9s1R29QBL71dOBE2OPX51rpeGZakk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMo8Cx__6DO2BLCdH4L_lYIgBZChfyHxxEAJdHiggsFw&oe=6AE20AC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWz5jUC_4t0Q7kNvwE-zhIe&_nc_oc=AdpZSJekf9YyB0Jkbe2eLACcVKZiWN5R_eOEes9qs7y_7qkJ-U9Y8MNs_kxwsdaTqxk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzZRK_7UxxyWzzkHAupdEbJNLuAbtcG9QKSp5my4Zn_g&oe=6AE2073F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbcIZ5YN1jkQ7kNvwFs9VVg&_nc_oc=AdqP_ksMC891ksqZE9ez5eVL6M3eqd5X_LRinZrCQ8pdjG0mVEhY668x_GzOskgpGjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmRpm_PGitUb_VP7rdU2ylZzba0Y0VXDf3aHBR-Ez87g&oe=6AE2054F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWrx7wAAWqwQ7kNvwFYEWyw&_nc_oc=AdrMbo85kdv7R-kpU_O-lpuL4zul2RG_bJJn_HlbzqAyn9M5uHlv1XLzx-HTCk1DJe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM19wbkWN-GP0rF5_J0l1tTvZjPzuUVrB9UHfWntFwrPg&oe=6AE2024E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-VeGdWoVZIQ7kNvwHYlHxx&_nc_oc=AdrA49p4aNvdZHukN9jOEzmttHFlONDQOrvG47Pxcse5i8jf4a9WBsorTmcIMDKLj6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0KrqCTKWNIHC3uZc2XewcjiYpatiBYsDyWqoIHYrAWQ&oe=6AE1FC3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXCVqNj73dwQ7kNvwEjuulf&_nc_oc=AdoJSi9XgSFaHWCeTaD9rHKdkgc0LiSOXiLNy2JdXKrCrKCJY4T0p4DquKkwk6caq
0f&oh=00_Af4GcZbKe9BJktNznH5ElIuBPrc0H6NBolYSxUJVqTnArQ&oe=6A046DF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzCyotvU3-wQ7kNvwFCgFwt&_nc_oc=AdrbHS2gIhtC1IjFHWQKKWuO_ULEPGUBML-P3eLjnSUl_8TcvjEaeQ95_Gd_YMvc2wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rotOZawO-LfOL9Sxe9r66iBUeZJzqG_2hUhtg6PbaFQ&oe=6A048EC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF0TU6BOtyAQ7kNvwEdfpCN&_nc_oc=AdobXFszcVCPSVL_WHDRb9MQssu2BRWqx-Z-_ZoR92bHoXnxvu5rOotBnHMhVetzCzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BeTr4v_7OWyLIi7bIwhb7XLXXm_f6M7zKBfzfQSQ8kw&oe=6A048B3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8QAeU0cncUQ7kNvwEjsNdW&_nc_oc=AdonygKaNeoUDb24t2_o1H5Bjbo9CERmaJtGPEC3wbhSDDKtBaMagQ0x_OjolW60HhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72jc-o09hndmgLnf0Cbwm_OsD1d89ixZiCVogsCEbbCg&oe=6A04894F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYF9g0ZDQxMQ7kNvwHAxNuF&_nc_oc=Adog6qYJ2Y78ODL-RIe3jMCvLSO4XxsKnzDf_KKNEdngfEocgESk46AjOlpmTcn5RfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ycoz7pFVjaSTHIj1XlmAl8Focfz_FuJRdmo6HP3OFkQ&oe=6A04864E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_KuvaXOFBQQ7kNvwHEf6rc&_nc_oc=AdqaxbHef59oxApegHimM9jygPcel7FPBdy86xO5q4C5zLTw6ENuevGNiDUgjbwd_Qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KiNqlKpxDqodTXkicq7h_uVRDf3bmWvTMvgOG4wlMbw&oe=6A04803A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
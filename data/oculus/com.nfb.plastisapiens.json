0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR0zFvxnpxsQ7kNvwFL4pMt&_nc_oc=Adp8JTOZdosSfz8IpmwV4z4s6XMva3USc8rjnBQ9BMYo-k1FOPX0ouRHAytR334c-fo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVi42aqW5imb9b7amiO9rhkR6xDkl7BlpvvAcnoypg-Q&oe=6AE0B944"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFdFRDTBufcQ7kNvwEjFejX&_nc_oc=AdrvMcj9FWYitLDGcgKdhVHP5x3Ttx3wY9QNjGR0lyXrpkEVMnwxiwRp-Bw2nbUoG6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgXu-cvG3vLjcHV0_VFYuCmkJ8jA6jZhaIpN8C5Ehg5Q&oe=6AE0B5BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbcIZ5YN1jkQ7kNvwG1TsEW&_nc_oc=Ado0cK4PsgKPB3XMLmDtLlQ5qFyHPadMlzfM-WjK3Fi8l_TsjXcVhB-eVqWyLYVt1QY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiepoZyyRnGFdRfeuohTv1mHhZBi-_8X7vToSYpWa83w&oe=6AE0B3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWrx7wAAWqwQ7kNvwH2oVAU&_nc_oc=Adq_nUsbvxVOGeycJDAf28YRpzEPltwQ7JfZ9INpk_u_OMSLegJcIvqwi2HEif0yxw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6xesmekV79pbkiDk733_02MB8_7jkdDoQlziY4Xau_g&oe=6AE0B0CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IjYpQ3_rIIQ7kNvwFSxKZ-&_nc_oc=AdoBGC9UdtWRBjnQ1B8_cbbUewKKUWaT045B1yN6AcZ5Obvvls06xMSWFpF71C2BdkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDNPnPeV9lw1SltU7cun1cVVTxoY3Qu-JOWDSjHGX1og&oe=6AE0AABA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXCVqNj73dwQ7kNvwGx5eJ4&_nc_oc=Adp2c2sUA2YAC-8F5dQhC0mkUCPO-BdneAQ-x3Qy7Y9owSKMilTb6dPV3d-Y19lJV
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10EsuO-v0zUQ7kNvwGH9_M4&_nc_oc=AdoGsDRSzey4oqK0N5IH2oFqdmtg6JZUze8fh666x4dIAx-h6vQr161mOyg_XjvA5Rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpkleedjnaMKhTHxKk8Annh-Uh_s7SYHHtm-lsFH8NsA&oe=6ABD20C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOk8BcWMJWEQ7kNvwFMF93Q&_nc_oc=AdqdCcyDxAZy8w7r5FStmwsqOwc3PUzXviiqJ56DmV1r6YiXpYaATci7u_Bci5YJvsg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-1SPE5EUGJJKq3aK8hzvjDx1FJ_gYFrjY9kXUH_XyeQ&oe=6ABD1D3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPZdyKT25R0Q7kNvwGZngA6&_nc_oc=AdoUvGhmwcTSN_e-a1XpDDnOPFduNl2Xymg203_1FSirGcPeHRc2UNc5kiu9IZdK7e4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHkTR6TRje1Tz19tzpX4pow0x-t2GiOWksSEwjeb4H6g&oe=6ABD1B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GwZXKNxSlIQ7kNvwF3lYGW&_nc_oc=Adp6HoL2UxyYqGX8Dn9JF_uAxRs3_v3xyw4qQvkGd0ZqmYOX9cexnoIZgWe43v9If5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa6u02RuxOxdGc-RKrzbcdvp10F4_RXFe-emvSEl1REA&oe=6ABD184E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUCNCir3BKAQ7kNvwFzn71P&_nc_oc=AdrmPeYNT5nstDwa_PlZGOVMVH36UdtcbJNqICNMs7bmP1xEsiTvq0Rkj4mYAhP-xn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB-3wtNn6EbcoI_e4ZnNxD0ZNuxrmoTQPUPPnDg7J8Sw&oe=6ABD123A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwgoSX5HTrQQ7kNvwG4pKe5&_nc_oc=Adr7ebNGOTSalJFrTDQWlN0BPIri1wx9YR2KuWzQtjzoLlhGwFtehEseexzxjPoMi
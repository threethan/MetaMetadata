0f&oh=00_Af3MG0eEU0sZVFmX8MgAjSPG0-Om8y9Ss_KxO6-_KA3G6g&oe=69DCE0F9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrUEayjH3IQQ7kNvwGWvMt4&_nc_oc=AdpEmbhOAw1c72KBF7YgVWFdUMK6P4ThY7GIwjg0HPLeIPFJi6VKl1kHIBYb98-sgaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mqOzUVJq4bx5DDsz1t2JFzHhpNtmHL1X3s4apS_Z9Xw&oe=69DD01C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbKnWf_ybN8Q7kNvwH-jB-d&_nc_oc=AdpvCOhTZO_NVTy3CoVYLucS0oFSd1iWHHQUI2cqUAP9ySIy6dK4Jep-fgSH5zG2Sq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IiQZeF4NSgve8izOEMnpo5GB6aZr1c81UOCtJ9PC-hQ&oe=69DCFE3F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHmOOUysbQwQ7kNvwGR3SPq&_nc_oc=AdrBGLdg-fmg2G7cNP4F1A288V3twSHozeHJCeQ0pAqYQZyVNS50zOcDW4pMp492OG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uT2FxbGGfwANs8U7KxAXLWDmz7aHOj4n2ykKlMukNtw&oe=69DCFC4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaWSmfwqKg8Q7kNvwEfwTDv&_nc_oc=Adrni6iAmoHjL9qC-RkYgBbo7kbLVRyJu43wW8bt-oln3pgQV7Hf6KUTpRmvae9oSAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Nve38K0zV-WiBldZkB6YQygBN66VJk0dCVUqurH3l5Q&oe=69DCF94E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CFI2mOGNGYQ7kNvwECvVMZ&_nc_oc=AdomsIEZLOwiYgrffK1_PB0uBqKk5Yqd4z9ELnYgU-5GdLXoKHbdp5R_LZ5ZKkvTq14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ij1yClEFR0ZJwLto5RkQuFUkH8l5GktSd_8ckIfPY3g&oe=69DCF33A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0f&oh=00_AQA8i3FgDZ0Gr_OnryaA-OkXVmvvEz8f_oTFLBDmWkYGvw&oe=6A562AF9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tvpDhDQgqsQ7kNvwHE3CQo&_nc_oc=Adpevp1HTNetSH-bB731kdy6Z526XKY5JZ57iiofde1y8BhEEh7So8zHthn2mnEVZJo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv2Yhma-V1HeXcCo7xaWgRZnjNeGxhq_BI86Mt9IKOOg&oe=6A564BC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kW5gG2RUCkQ7kNvwFIPRwu&_nc_oc=AdoLtnxyVSqqGNYoGr63wxGc09JUfPYzq1hLd7ztQWmGDsH5jcxpXMWmykvBtAmg4U0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgpqj5bmsiYncYMeW5vsHQTz_76p2CSHwAASoOfzzvlg&oe=6A56483F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTZmPyeXNCgQ7kNvwHs9VVx&_nc_oc=Adr4rr1oYmk1cCWITYaM9hO9x9ZsOH4WwjEfT5bwEWSGQ-EwjMDXNtqyivzPo0db0zY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Ai6W-GNcF907nlGbOipTXiZnMj8IPwEpAXXHSwR3wA&oe=6A56464F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBYhzaIw9QUQ7kNvwEUv5CF&_nc_oc=Adrt_OkLjHeiFhgeNLPUzZS00hAdRgodSU2Dxck6Rqhjccc7d0Y_QKvpshMWH9OTKY8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjCT7glsfPjX6JetGb7u69vqGF5J_Iuf9RpNYDukLY9A&oe=6A56434E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hngPi-ajEPcQ7kNvwFnFrsk&_nc_oc=Adom-Vi2WjjP_M86HRPcIcB1SUWlbGw01rXGeklkWDJhuX9b7q7OGAr64Pp-W1rhVLA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbhJw1Sf1_uREzXgNGm3ITvPEM-qnqpfgyuw6FfeIU9Q&oe=6A563D3A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
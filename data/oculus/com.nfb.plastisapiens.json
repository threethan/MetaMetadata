0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsWOXRy99uwQ7kNvwH9LfES&_nc_oc=Adq484njxRj5WIa3CFXU0mYaMeEb50mUcrAAo2I5POkzay5Ofi3rmDopPgT8O9zPYls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOljCsdX2W3xjpD0WT7q5TyLx9rm9ImgoPWv6nhfNLYA&oe=6AA565C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfZNY5RUThcQ7kNvwFw9UpM&_nc_oc=Adp_nFnCvsHhs3pBSqZrtikXYgrTyvMIQU7yfaMLvhV67MLhvHuMvWy2hrPKzjNB3yQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVWQajksvTrLcW9eExWL84U8FJCy5xFCiGOIosR28vtA&oe=6AA5623F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHWy_vDCsgwQ7kNvwF4fgJy&_nc_oc=Adpi1UoWUjJWl79Cv7qo_lxrvWVP_nwqoOAummoobLTmx08IrldmSFsvyxeQ9zVpxqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDEiNSERaFZx5oVjhEuZ206kiNFSqpRjmsSUNrklAXqQ&oe=6AA5604F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmTlGWddlLEQ7kNvwHBMsMu&_nc_oc=AdpNi-9VvPRSTBPaPHKYAzUtu0KqxqyxlJV3Oag_lRfkGpp0bE_6J5sMK-Z_efgRQAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWH7z6TcOv4EATMFvdJmaDYZVQUBzvaKCQRJCxt6WJjw&oe=6AA55D4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya-9v9txNuMQ7kNvwGN9xnK&_nc_oc=AdrCbe4K7t-eQYp1VnBU4I67WKRgXKApcgpF_lMq7jK47hDnbvUE5aRMfIf9cFADUy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_XyqO2h-0j_Fv--ASXkaUjBM4HDoS1LiWefGrpbqGNw&oe=6AA5573A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXY9Oc7VaQ0Q7kNvwH_goy1&_nc_oc=AdrKd7MH2glYGbIdo7UonuS4uxAp2N7oVqx0t-gXk6nBPY8t4j30rb7lghiVbmiIO
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlko6hYCynkQ7kNvwH4z_Bl&_nc_oc=AdqsMGldS6U09LfriCatoTY6gNdL26fAmSMkzKH1OsnwNZ4osq8S98OuITOA9a4FTiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID1JNCFMTiRrL1bumIW6LA2Ikptwkd2ZqcWUmVYHBbbg&oe=6A998844"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x_zbMnupMgQ7kNvwFo6JYM&_nc_oc=AdrOP8WsmFouT5WVhpWEGgKkTWzpbVNDbNBRCd-u8tL_vqIgQLi7AGABs8BCDQ4CZTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpHgem8x-eVdayL96sBKxgMq_3RXGZWEWC63rjExrZjw&oe=6A9984BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ycEISv8dKsQ7kNvwGq1iEL&_nc_oc=AdrYaxWT5Wzkny-ufuzofkNwtP-Go1ZpSnfemUs45IKKKaEVwH8M-NShuwX3i8OOMEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbF57QE7NqCODzjNkAVOtq01HCeDSZly9Lg273OK33Gw&oe=6A9982CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUOc7s47gfoQ7kNvwFmO0nc&_nc_oc=AdqcG053hnKsaWKEItrwHWGoF1_vfQCpQCuIe2DGFsEIYSwLxFIqiTewsZpWFEOujhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVt8y4EnKjynyLcMfBLsfXXLDsQUKWb6K-2dWbrb-0eA&oe=6A997FCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9s1Xn5qN4YQ7kNvwHM7Syw&_nc_oc=Adp-prf4Urf2DefvxeEiwVebXMEiJxvTyLw93IwPnc0Lb4HzQk3CqlBVRtgLC0welEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdE1rbigHOZJpiNlpJQ94BzlojU5HgUOAuC5EnHTx2gw&oe=6A9979BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J06IOOAae5sQ7kNvwEKSIhb&_nc_oc=Adp3F8pAeGM696y0R8IPRBOww0nhvn3P2W1H9mu9d7LzBsPgLQyIxNZm1TMXB2QHq
0f&oh=00_Af-NIkxwH3ivdsrOr8F7X8-18BNOOAKVpqGuJmWAtoyO8g&oe=6A259BB9"}, {"file_name": "ScreenshotsPlastisapiens_1-3 copy.png", "id": "736273697694704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_736273701028037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OpwRHXSI-AQ7kNvwE8Ymep&_nc_oc=AdpwxiQeMBzz9BxxUNbe1S6sTEnvMg__7B-OAYmqReWEBavyW3wQgHOEiO3_pDW_-a0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nhTjDeHtgR9sCY3tDNryUVBoynqKVlNUMBiZqq6nm8w&oe=6A258444"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d12O65yiJgQ7kNvwE_Xwwf&_nc_oc=AdrysxtXFNMrbFdvyeGswOrtQn2oq9IrhARAHZrJWJBVuxkddAt37Egmr-XF32sPh2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZF-T_LiU4NUcjPYDs1ZMm8XnQNJL7D4OI_5ZUbb8CyQ&oe=6A2580BF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkfSJOzpwWEQ7kNvwF-w-Eo&_nc_oc=Adq1_APhVVFymZt9BSDNfKbxvx2CWJ8w-vBlv5pN5TvKNyWLlnv_NC8hDNYbtIlQ2tI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xAnk7cXDiP1hV3JB2DfQgJY2I91cXdFfAD5Wx3NqXNQ&oe=6A257ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j36Mh6l7svIQ7kNvwHFIxIv&_nc_oc=Adqb3ts1WHwU7OTQOY5fxrrXUENDAWdOtcA3ILFxRm7OnJKV_95lSa1NvAjVTABy6wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DhzficiSUkI8NEi84OmESqcY-Z-DkNRKoG1_a6EpfcQ&oe=6A257BCE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wtryXqVIf4Q7kNvwHFMuMJ&_nc_oc=Adqssd7dV9Ki6UkP5adRvY49e7kRdQXQQk5AOTq7UwwgKf5_6hPFjIJSDxkZsxeLU7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9syuZKTuK0G0n4XKgrlDg--5JaYpAxLvcWD5wrAyFxQ&oe=6A2575BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "ur
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10EsuO-v0zUQ7kNvwHI49MB&_nc_oc=AdrCUePaloq-KjDwBmsLd2sXzClRrd0WB-40JyXcuWJj809JQaghBCKVY4ZkQf73nds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ5D78T78T9dalQ-_htu0yk9cB6uqo4y6RgvP85WHD4A&oe=6ABE7244"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hgcStEeYd4Q7kNvwH7Uker&_nc_oc=AdoDIcwzAoSV3uKQbopQDpIzIzmOC2p03BQ5GngROU1dZ2Goq3xEXgpEolbnfox7Rmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPjWlIfKJoHPSu8SgJiuSxiL-7IXIWFxsGurkzl4aolg&oe=6ABE6EBF"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPZdyKT25R0Q7kNvwFADPvg&_nc_oc=Adq5CXXFFOBp5RDYXd0eb0V_u3g_Y0PDJvpLtA14008o616rtpvm0_KqJovDHgFmksg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdN7w4OFVnrRbj_8B1s43CTXfA4xoPuPeP6f0UCohuoA&oe=6ABE6CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GwZXKNxSlIQ7kNvwEhhPM4&_nc_oc=AdrILTevUolfOpSEpTv70AbDqLQ_I9F2ce8E4ANgHfes5q7gRxGqxuEg-4qARzrD7lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg_MgkvNPXsB0yuKg_1kpgAF5YnUoXtYnZbHyStkQT6A&oe=6ABE69CE"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw8Do_Ju4VMQ7kNvwGQvzHk&_nc_oc=Adr_eHUz7Xrl0hPSnzw17hxGihecSDxr-wp3ahmeK5jx9Nc6xDRhAcHLuG6AduL-xz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtj7iailpwNg_MQQvuCSM_NCrZtkcqU6f4bmZWfHZQcg&oe=6ABE63BA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwgoSX5HTrQQ7kNvwH5d_kF&_nc_oc=Adp_Kpz_Wn8VdlKofdqTWQ5oF5wBZ6nY84VKjN55sxA1eGJqKXrehPk7Fx6ZlqUkr
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLaZH8gwqikQ7kNvwFbXT9f&_nc_oc=AdrU5VXVJ5gm-DRv1DKMJlmjNKchzmkZgpSR3Gx-mlKenaZwKdfbLdD-Zp7fVcUylGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY98tyT-VWTMLs9VJjueX_2WZ8iMRtB2HJvGSotdJUdQ&oe=6AF1DCC4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNeB_b1TXHkQ7kNvwGNt-Ba&_nc_oc=AdpZZk4E0M94amuoCNgCYcBhMB_-PGyS1ZT-tIyigT1v8Qq4h0bYMmCufG0Q1iPcV8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLw1Idssf6-UZWNOWHD5JNx5hzLjd7rSJnBrFwMrOc8g&oe=6AF1D93F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d25NH2sE0-4Q7kNvwE7ch6e&_nc_oc=AdqpIAy9XpdulhUSweeZAutckw9DBXsXUdmMS_ia3kpgMUnnht4hla1ujQSOlaQHLWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6pTzq-VIc4I5-sAucm9xvpwWfRyO_YBodVvOhUFk5-g&oe=6AF1D74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bplMd64UP0gQ7kNvwGsXggm&_nc_oc=AdqzTGke1dxE3a1z710t9Ud9RXVQicpJH-Qgrs7b1IenKhYN5lPSJSK5azTnEuIMM4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQceaz4g3IcE_jiKVJ3qzUWeOPxcPO5fjhJhcK7Z4vP6g&oe=6AF1D44E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kyooABAjUQQ7kNvwH3M2mo&_nc_oc=Adrm04ULJ04x85-bUpIm8f2ITIGebOtwors0AuqEWuEDniarimXYJuTGJL1DIiScR_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpVDr3pBIAXf3ecm_aw14YYjda_SMAvHW85krqV0kJ3A&oe=6AF2067A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOMLRJtLUqgQ7kNvwEHA43L&_nc_oc=Adr5xguzNz7zyZunpAAmEZV5dqKxl2W5s8eCj-wmxTx5XH7P4D34RPqSiHOCRBrYQ
0159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti5NGGbS2koQ7kNvwE2hD7O&_nc_oc=AdowpwoYkLQjQnvDJIKi6QCvVd0xwkL2qvNRTIp7bReCv1v-_T0lyU156elEHbsPock&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFnf7cARqgS0VfvhhWLsi9QxZ5AleUNZAdyJpCEujuCA&oe=6ADCC4C4"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EUGKtvVcT4Q7kNvwHX9rNg&_nc_oc=Adp-N8JmnBcMnd8zPSro9ieyGu7pEmHXV02iqJeiXgWqnf14y-JrGaWRB9BJnDr89tg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLHY1uCofnd-UKMFjuNCePR7QyvkVU3WxFGsUyZaQ7Fg&oe=6ADCC13F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lixurrAzhwkQ7kNvwFwvBi8&_nc_oc=AdrgSqBDirUlzaRhTK8ZavOQSz7B03Sz6GoYFllNkxjsBx6e2ak0VRmTsa3jOp1RVMs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXPrbINPPwD7IFwUHwOIZ6119NM0qsJjhhqUIVgseeWw&oe=6ADCBF4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4nVDXnfn10Q7kNvwF6ICv_&_nc_oc=AdrpCloq5cSSTl07VEK2OYv92elR8BlB_pCfS6e2jGmaIlh0GPBwjgzghpjFZRvqzdY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5iJ3wTTMkBO-jo51VyBvWDNRrTt4ol7NJfusGu5Jo8w&oe=6ADCBC4E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDRxYeb-vN8Q7kNvwF7zDON&_nc_oc=AdprDcN2phxmZVHDBEJbrr7_jkfWtLSh5suXW6QlA7L2ZU77l7B-Gm95flkNj_r5CyI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2j1fbSpIJuFlj7rtSZ8ACY5NYzEAsmPESghJp4i6ZUA&oe=6ADCB63A"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK5KDRlUVfAQ7kNvwFhdyly&_nc_oc=AdrZ5TQWDm_4FgWgGQ6yNcwXuoJlE-XPD4NTV8Tm9U61eMI9M3qsNCvakcVsJ-_W3
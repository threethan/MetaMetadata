037_5891335045560159768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyTLdexhNY8Q7kNvwGSqibz&_nc_oc=AdqP_IuFwzu_LJb42iJkjgb7XLTyRn2l919WgCH2EBClT48RExoWRFXzoZUXMOrY708&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH97qHlTipQzUHiSHtgCgGh08OxXrW5LqOyrI_SNEtbXw&oe=6A8EC404"}, {"file_name": "ScreenshotsPlastisapiens_2-2.png", "id": "578055333902990", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974711_578055337236323_3077108640787461141_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKSovZt-e-QQ7kNvwF_qtMw&_nc_oc=Adqf8tnsC-7dNx5WxkFV6z6bf2b4tYhW3aNnipvDSQmdsZbxs0iM1XxjBTUhMZFmtCw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYDWkcO_-uomr5KRsn-y2Uwf3QcUu-2O923s463KA5-A&oe=6A8EC07F"}, {"file_name": "ScreenshotsPlastisapiens_2-1.png", "id": "747659256278512", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974672_747659259611845_6543220561444418370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7VQO8c60VUQ7kNvwEnvSDz&_nc_oc=Adrl9qkIvYHFb_TqVHi6QOw6yT3Vg17HYrbpCO7vBQuQH4bN7N2v-cRgJkYWLffGgGU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiUgFtSARehvPB8xnlKArRVNWfTdv__m7HJpEumF_81A&oe=6A8EBE8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Plastisapiens_2560x1440.png", "id": "568599268070265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_568599271403598_542154395231396204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEdSas77E78Q7kNvwEkLYqS&_nc_oc=Adro75TysRb9TJ4euEBryCPiIoO65PC43PaLrtI9M9nADp0JCOL8HcqWof1vLweV8hQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmZomyH_c7a6UZUcemB_GmWtNxlZhPaV8BTtguK4LA7Q&oe=6A8EBB8E"}, "display_name": "Plastisapiens", "keywords": [], "long_description": "Prenez une grande respiration. Expirez. Inspirez. Expirez. D\u00e9tendez-vous et contemplez un monde o\u00f9 le plastique fait corps avec l\u2019environnement. Plastisapiens est une exp\u00e9rience m\u00e9ditative de r\u00e9alit\u00e9 virtuelle, un univers o\u00f9 plonger avec curiosit\u00e9 et o\u00f9 jouer avec l\u2019inattendu. Prenant appui sur la science, le r\u00e9cit bifurque vers une fable \u00e9cofuturiste d\u2019une beaut\u00e9 \u00e9trange et ironique, un voyage \u00e0 travers le temps et l\u2019\u00e9volution, vers un avenir imagin\u00e9 de toutes pi\u00e8ces. Alors que nous interagissons avec les organismes autour de nous, puis que nous assistons \u00e0 la fusion du plastique et de notre \u00eatre virtuel et organique, l\u2019exp\u00e9rience met en place une bulle de bienveillance o\u00f9 nous pouvons nous laisser bercer par cette mati\u00e8re. Doucement guid\u00e9s \u00e0 travers un univers stup\u00e9fiant de corps hybrides, nous sommes amen\u00e9s \u00e0 nous demander comment la relation de r\u00e9ciprocit\u00e9 entre les humains et l\u2019environnement transforme notre identit\u00e9, jusqu\u2019au c\u0153ur de notre ADN.", "short_description": "Plastisapiens est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle surr\u00e9aliste qui nous projette dans un univers o\u00f9 les corps et le plastique ne font plus qu\u2019un."}, {"images": {"nodes": [{"file_name": "Plastisapiens_2560x1440.png", "id": "5442287372504800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974711_5442287375838133_576180580823593093_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcbHQbt7dnAQ7kNvwGvIWNh&_nc_oc=Adrl3ndxsioplicmb1DMbjWxbjDLDc6zZztdhXyoA6imLkc9ZB4M9FaOk6W4DaLoDlQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb00vszSl4bCndtMzDSjyK-RUaV4YlSIEnRpVssvbzMA&oe=6A8EEDBA"}, {"file_name": "Plastisapiens_1080x360.png", "id": "5315689688498546", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974670_5315689691831879_4793735738534308530_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWfx9nnACP4Q7kNvwEo2lV6&_nc_oc=AdoAG51k8SmTTxA1SFCCpmXMB4p2hs4-w0Bw9u-1lx
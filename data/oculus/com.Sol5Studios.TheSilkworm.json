768467254968449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMiA-A8_mRAQ7kNvwHCx6X7&_nc_oc=AdlDokIemVX3NlSOeWOQKiX28zqu2ywPFjJdg66tkn1077pTKb1vHWz9hxA6qsDqONE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aft1afST0UW4sdf3ZI93wF6s-wiWQw3ga2-WRb7WNi671g&oe=69A1A347"}, "display_name": "The Silkworm", "keywords": [], "long_description": "Walking past a Silkworm, do you ever find yourself wondering.. what would life be like if ~I~ were a Silkworm? Wonder no more! Silkworm is an open-world Action-Adventure game set in expansive Silky City. Jump, Swing, Climb, Zipline your way through the city, and fulfill your Silkworm destiny.\n\nLearn to make games like this with us :D - https://discord.gg/YHKCQP6REp (check website field below for clickable version)\n\nOr for a more casual look into the making of these games, follow on TikTok: danger_dom_", "short_description": "Walking past a Silkworm, do you ever find yourself wondering.. what would life be like if ~I~ were a Silkworm? Wonder no more! Silkworm is an open-world Action-Adventure game set in expansive Silky City. Jump, Swing, Climb, Zipline your way through the city, and fulfill your Silkworm destiny.\n\nLearn to make games with us :D - https://discord.gg/YHKCQP6REp (check website field below for clickable version)\n\nOr for a more casual look into the making of these games, follow on TikTok: danger_dom_\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sol5studios-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Sol 5 Studios", "support_website_url": null, "website_url": "https://discord.gg/YHKCQP6REp", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FLYING"], "has_in_app_ads": null, "internet_connection":
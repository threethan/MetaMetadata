440_square_shadow.png", "id": "1028016652035700", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303838_1028016658702366_4005522651680527963_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TripL4usr8Q7kNvwGigWzj&_nc_oc=AdrKxk6L_f0eQ8yoJFgNGFjrOQBhalFjzV5ZFu2WO06LLnOG5RoCgAIYKaOnqltpMkQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq6Q8pJKj3BY0QMwm0yb_zpPy_dnNL7FEkhAkBvlLrjw&oe=6B084AC9"}]}, "id": "311863465285946", "locale": "en_US", "screenshots": [{"file_name": "Screenshot-HeroMoment.png", "id": "1729975287830533", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974888_1729975291163866_2648731533470094025_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxfGKszpE50Q7kNvwFVMLRx&_nc_oc=AdrsFSzmHuPL7JFSXtOjQ3Q7KWkaD9P4PY3Bfmv0XIOnosPZ1rvXuTyPm8MiiRYB1p0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJP4vUUTgt4et3zpZ_jSwh0HwZWOcDRCnHpIJY6-aeaw&oe=6B083DB8"}, {"file_name": "Screenshot-NPC Opponent.png", "id": "1021545086090699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_1021545099424031_6694415027269339898_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLiwIUkZ6AIQ7kNvwHzi_7E&_nc_oc=AdoAr9yA4RXWaTZNQw4ANSZznDd0rNJ3S_QgBetsLd9Nuq4yOmDe7gBs-7cFZWMnX2I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT67YAdYOczL2RheK8OJPGwqZIlf6z3D4T8pTm7rh_REg&oe=6B086C8F"}, {"file_name": "Screenshot-Arena.png", "id": "855040766578683", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982581_855040773245349_6076818306779792022_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3xdtKFBAR4Q7kNvwEcr5Hk&_nc_oc=Adrt471kM0DNT7_6XkqWKq-WU03JZmHEgW4btZO43ANlQPQkZziq4ZOehwPe7AMFYx8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtKkR4mSL078Rohd0lnhcQ3zoQU_JQaxOviLdZOIc1bA&oe=6B085474"}, {"file_name": "Screenshot-LobbyMenu.png", "id": "510941114868041", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984466_510941118201374_9006863217060690995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCL42iVrn68Q7kNvwHK1IkS&_nc_oc=Adrq9DJJJ-r2wbop9Agwc2zbb8WxEfbd9iG3htNT3pqQ_8KEZ-1T9tBjRAhitPJLMqk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Ic70ee8mGXj9KjHzkZwN5mx652f_uF8tN8_49nLH_g&oe=6B0867DF"}, {"file_name": "Screenshot-BigPieces.png", "id": "855861089460800", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001708_855861092794133_914761184506848463_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o1KM3wBQXgQ7kNvwHGzlqq&_nc_oc=Adqs2WtJqo6E1ZXn7zdMEytEh2LpNn33bTrO43kwnXX59VjjioLo8rXkXiyCsOuy01A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuILc1FMUwNzofZnnzey0SXw6PQgmMZDXOGuF2u2QBsg&oe=6B086304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9AGqJOb2gEQ7kNvwHecH_y&_nc_oc=AdqNRuAFiYbYG6aYn_VuZkhmpaLGpeM4VUe1_CX3SZ_jIMyt8wSgMB1Fb4wpWN-56PU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSwipmEQfiErVEKMmMwgKYkdCTFdAg5pqRPTf8V9H0FQ&oe=6B0866F9"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_ca
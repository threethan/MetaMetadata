rWCEt1R-MMB6T5QXI5FJWdz2kdWNSBQP0XBJwcZxc-jFZ8jJj62s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXUGb6dhg5i8bCETo22HcT4z7KEFeEqYRFd7WMtLGq5w&oe=6AD0DEDD"}, {"file_name": "Env-Void-4.png", "id": "669594122492014", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824611_669594125825347_6059067654706702108_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaRSxApE0tsQ7kNvwEVqjH1&_nc_oc=AdqCHs_MCRY3q_LZRBARCon4yRdz0ToKUKDWigRtvuAPhQCn8QHMTCGU7Jf7WbNxgog&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeieR_PbD1qhQX_bIDbmy19oqO6jSGMt6TejAlnrrmyQ&oe=6AD0F349"}, {"file_name": "Env-Void-3.png", "id": "678824154921397", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827813_678824158254730_6389200423412651731_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNmuHRpg4LMQ7kNvwED_CwP&_nc_oc=Adp4nI8RWxlALTRIKD6vYOQsyqSG8OiK8nHEfSof7KuURbzEl_wO3uD1gFr3NdTuzm4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIIn1d2Bt2o2KRBT_D7H6uhkiRE1vlkJN35fDMQzNIBQ&oe=6AD0FF8E"}, {"file_name": "Env-Arena.png", "id": "682293894345142", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820382_682293897678475_1325824166594480615_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3yC_g6prY0Q7kNvwF47nU2&_nc_oc=AdqEWY4k0atqM2p5XmZY0KgitHJghBSCUlyO3lFRc77K_m3E7ib-9F1aXXAAiULw6bM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_FrkHh2rnxsfSm0GTggIem-XKbnjoXKbOlFsiyv9oUQ&oe=6AD0F780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499318402_1910298826431733_5874529790902205316_n.png", "id": "690209857452242", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304938_690209860785575_1478466606950616581_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aprKVf6RNFIQ7kNvwFt6w_1&_nc_oc=Adoi9tZBdS1pl2Oc8Xl1KqHsP8TH0EAtYOSJZbx2j6BgjdirOyD4qaxWBOexNLBpqCE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY6_cLqkhMUb1xef87XhWWR-1ej9EQSfhaAmlF5YT1sw&oe=6AD0EC03"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "board", "magic", "club"], "long_description": "**The world\u2019s most legendary board game reimagined with magic, battles, and VR.**\n\nWhether you're here to relax, learn, or compete, Merlin\u2019s Chess brings strategy and fantasy together in the most immersive way possible.\n\n# Includes:\n\n**\ud83d\udea8 Official CHESS.COM Integration!**\n\nChallenge over 200 million Chess.com users, or play against official Chess.com Bots of the world champions, athletes, and celebrity content creators. Enjoy first-of-kind cross-play.\n{1672858073373438}\n\n**\u265f\ufe0f Animated Chessboards**\n\nMassive or tabletop-sized pieces come to life and clash each other with sound and visual effects.\n{665555099586111}\n\n**\u270b\ud83c\udffb Full Hand Tracking Support**\n{1750083772244542}\n\n**\ud83c\udf99\ufe0f Voice Commands**\n\nCommand the board like a true wizard. Use natural language to move pieces, and perform in-game actions.{2107862396361663}\n\n**\ud83c\udfa8 Environments & Piece Sets**\n\nChoose between various theme options to craft your own gameplay experience.{1009389611384771}\n\n**\ud83c\udf10 Multiple Game Modes**\n\nUse Casual/Ranked modes to play chess with popular Time Controls. Switch to Spectator Mode to join others and make it a Chess Party, or test your skills against AI opponents in AI Mode.{1397490261378212}\n\n**\ud83d\udc6bMake New Friends**\n\nCustomizable Avatars, Voice Chat, and Friendship System. Find your people, or bring your own. Includes safety features like Mute & Block.{9786338901402296}\n\n# Upcoming Features\n- Puzzle Mode\n- Mixed Reality Support\n- Merlin's Chess Academy\n- New Environments, Piece Sets, AI Opponents", "short_description": "The world\u2019s most legendary board game\u2014reimagined in VR with magic, battles, and friends. Play immersive animated chess with voice commands, hand tracking. Comes with first-of-kind Official Chess.com Integration and cross-play support!\n\nBattle AI or players, customize your board, spectate live matches, and explore magical environments. Whether you\u2019re learning, competing, or just vibing\u2014this is chess like never before.\n\n"}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "25901273672870445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499305050_1466995878318638_7571756294986394024_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgD6ceJ_SCcQ7kNvwGcpN5X&_nc_oc=AdoGm4Gno_Pt6V-GTu4lZ6nYYd8foUoy74KJecUyuop0cqDP5djX-ZQLZ-6hH1XYmH0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEBGaky2RPb1d97hIs-vmCPfXLX1A7dNxdTVtTUKvpVg&oe=6AD0EFD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Merlin's Chess", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
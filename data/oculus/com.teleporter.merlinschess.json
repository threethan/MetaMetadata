440_square_shadow.png", "id": "1028016652035700", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75303838_1028016658702366_4005522651680527963_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLc-vNogeO0Q7kNvwGbc2NO&_nc_oc=AdpInzjLKJMpLQeTkRVlDHzUw9rbSg6p3zidtefam4hM5BUZRYPVI5mzNontwhvDBPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZLl3qsXAjUJpunUqkDlfInh-jnxZt323ZzjVjQy79tw&oe=6B0C7789"}]}, "id": "311863465285946", "locale": "en_US", "screenshots": [{"file_name": "Screenshot-HeroMoment.png", "id": "1729975287830533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_1729975291163866_2648731533470094025_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AyPw4d1Sl4Q7kNvwF5Yc6E&_nc_oc=AdokVrcZUd7DhiW0hJ2HcPVlNF-v5bLElSwcZeYSHH94vaKeakLx1_byNCaLUSQKUgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWg3uU-JjMdogsPWCf1WWSoQRq57DDlRvhwTEtltoyeg&oe=6B0C6A78"}, {"file_name": "Screenshot-NPC Opponent.png", "id": "1021545086090699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031447_1021545099424031_6694415027269339898_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pil4v8rC-UQ7kNvwEuSYHR&_nc_oc=Adr3egxOkw63eryCgUCkhIrO6n45s6vKVDXug2Mcj7j1MwI8ey7-g6NA28e-F4H3Bco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQC08ShpgAiWbM-JalE0cxp1h646ySjWKGH-kPoi4fb2A&oe=6B0C610F"}, {"file_name": "Screenshot-Arena.png", "id": "855040766578683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_855040773245349_6076818306779792022_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLxLO980CCIQ7kNvwHqCuwi&_nc_oc=AdpTJMjBQk2l2-aWNXzbwBJH-F91y583XORSUxuw_R9T3fMWmA32hCiMRCs7RJkTslI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzA1q5GgEP98Xm55yQpZVW9pRSChOlZgvZlnEmLIMiaw&oe=6B0C8134"}, {"file_name": "Screenshot-LobbyMenu.png", "id": "510941114868041", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984466_510941118201374_9006863217060690995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8jNA-xud4QQ7kNvwECp5CJ&_nc_oc=AdogJKpapZER_VK9QottcoQIfRwzJnjv7QCKTE9DhY-Y-owcAEkCl1FcvqEv_0PefOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTekrip13mpd0hyee0in-CEC1nOjR20s7tkZax6ltULcg&oe=6B0C5C5F"}, {"file_name": "Screenshot-BigPieces.png", "id": "855861089460800", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001708_855861092794133_914761184506848463_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U8CUZVZkpgQ7kNvwEaKMbc&_nc_oc=Adpvbjnf92chOILVqM6hLCr5YbUudCUflnALsxIoU79RsacYIvmXFGOgO8KL2LC-ukE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqwNY8JHkXUyj6vXeaB0W6RPnbeScoYUDQ45rYdJcUzg&oe=6B0C5784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwOde6nCrLEQ7kNvwEnjXtt&_nc_oc=AdrMEBlwCc8iLW-RvJtN5IKp16yqJrpf4Db2e3xR4MMf0-EXYQdEdDZrzzAGD6AcZ-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFZ9N8gsjXDakxatxedVmZQ2oJYk2NZbtIjaGrZpXrqA&oe=6B0C5B79"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_ca
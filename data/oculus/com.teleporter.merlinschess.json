1-7&_nc_sid=6e7a0a&_nc_ohc=OBEBj5c0KK4Q7kNvwHz5wEv&_nc_oc=Adojway-lr6GbRtJKHnoLJyhLvrz1UQULHzTDpQ8f5dLJZ7JC6xuebVJPcduc9UimoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3viAleoN5-8U1tAnWNttZQnsQhxzNFHfdvNNhQAeBTQw&oe=69DB94C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_VTs0jm4wgQ7kNvwGrLfRk&_nc_oc=Adqha_2MgN49KgA7W5S4Jc7wdFQJPcn1Gt8F5XFXFamw1WPG3sAZOYAkGHyrg4lwmEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lWO822zbqoCRkqKA2-XpgKSeGdSfM0SYguaTsFX_TBQ&oe=69DB98B9"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8016743785083375"}}]}, "scheduled_offers": {"count": 
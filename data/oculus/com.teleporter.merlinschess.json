content-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_669594125825347_6059067654706702108_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQnoWqqKd2kQ7kNvwGnnFKZ&_nc_oc=AdngKb4Dms0-efjDjRxYFB535m0qCU59LPAke7K4AiNQ5jG6UikJOhMF77fUeDcNuPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvypTJXh5N5SA5IgjXu_giH4heiCLIRrVkx_sxz4MDSHQ&oe=69A2D389"}, {"file_name": "Env-Void-3.png", "id": "678824154921397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827813_678824158254730_6389200423412651731_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hC6vbSXKQNEQ7kNvwEWCXGd&_nc_oc=Adm2GoDPFNXD1TOEGgD3e6SO-ViIHTw2a1fkFBuATJdvcanQg-hQWSyVW3rFClt8paE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAo9xaAvKfD8d3hASiqEtK_c8bkb4SKuqLEXmxEGPA_Q&oe=69A2DFCE"}, {"file_name": "Env-Arena.png", "id": "682293894345142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820382_682293897678475_1325824166594480615_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyVI2nUJGBEQ7kNvwHGk0Tx&_nc_oc=Adm4jeM51hPAiJjO5WB5yOqKXt7nwOTYNKzFF_J7aOVAwsaH2JCB-2vrSNelJfth0H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnJLG_UKZYdEYsVeCPF4owPGXoATmEaHCmqSurmRpYGQ&oe=69A2D7C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MC_Cover_RoomsUpdate_8.png", "id": "888841377071155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_888841380404488_2700644950042067927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD6EuGDyfFgQ7kNvwF5UONS&_nc_oc=AdnKixCxWE1FLtced98ofG9R1hW9JJ-7ZEkqo4v1fns5miDVEdzlXdzTFfQKRzeHjf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4qezcXiBhMF6M0hB5xEV1Iw4oNaO16WdhaqWvDhQnjg&oe=69A2F916"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "board", "magic", "club"], "long_description": "**The world\u2019s most legendary board game reimagined with magic, battles, and VR.**\n\nWhether you're here to relax, learn, or compete, Merlin\u2019s Chess brings strategy and fantasy together in the most immersive way possible.\n\n# Includes:\n\n**\ud83d\udea8 Official CHESS.COM Integration!**\n\nChallenge over 200 million Chess.com users, or play against official Chess.com Bots of the world champions, athletes, and celebrity content creators. Enjoy first-of-kind cross-play.\n{1672858073373438}\n\n**\u265f\ufe0f Animated Chessboards**\n\nMassive or tabletop-sized pieces come to life and clash each other with sound and visual effects.\n{665555099586111}\n\n**\u270b\ud83c\udffb Full Hand Tracking Support**\n{1750083772244542}\n\n**\ud83c\udf99\ufe0f Voice Commands**\n\nCommand the board like a true wizard. Use natural language to move pieces, and perform in-game actions.{2107862396361663}\n\n**\ud83c\udfa8 Environments & Piece Sets**\n\nChoose between various theme options to craft your own gameplay experience.{1009389611384771}\n\n**\ud83c\udf10 Multiple Game Modes**\n\nUse Casual/Ranked modes to play chess with popular Time Controls. Switch to Spectator Mode to join others and make it a Chess Party, or test your skills against AI opponents in AI Mode.{1397490261378212}\n\n**\ud83d\udc6bMake New Friends**\n\nCustomizable Avatars, Voice Chat, and Friendship System. Find your people, or bring your own. Includes safety features like Mute & Block.{9786338901402296}\n\n# Upcoming Features\n- Puzzle Mode\n- Mixed Reality Support\n- Merlin's Chess Academy\n- New Environments, Piece Sets, AI Opponents", "short_description": "The world\u2019s most legendary board game\u2014reimagined in VR with magic, battles, and friends. Play immersive animated chess with voice commands, hand tracking. Comes with first-of-kind Official Chess.com Integration and cross-play support!\n\nBattle AI or players, customize your board, spectate live matches, and explore magical environments. Whether you\u2019re learning, competing, or just vibing\u2014this is chess like never before.\n\n"}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "25360109076986910"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_849624804699824_7345245512273961586_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwOxC2P0bBsQ7kNvwGvissK&_nc_oc=AdmLMDVDa30kIJnBgSedi28RufAxhkYAS38KQsaRuIgKfywVlEuUd9A3kGlET_PP3l0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEQtihuqBtAgco6LU7I5Gqd2-a6o6gyOw1WHQzXMjaxQ&oe=69A2EF92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Merlin's Chess", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1747933200, "lastRevision": {"nodes": [{"id": "8016743815083372", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8016743778416709", "i
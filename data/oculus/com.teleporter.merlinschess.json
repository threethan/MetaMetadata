440_square_shadow.png", "id": "1028016652035700", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75303838_1028016658702366_4005522651680527963_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eARwMBd37CMQ7kNvwFl8f-j&_nc_oc=Adpmy6EO6C6-EhtkJeT90vayYHeJTTwVF_4sPuM1x-n5MhMLj90HWsAwP3PDYC9rAx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMdEW_nrIP3KWT2BKon4PDjvDTeH8JrP9Eiahuo37AOg&oe=6B0304C9"}]}, "id": "311863465285946", "locale": "en_US", "screenshots": [{"file_name": "Screenshot-HeroMoment.png", "id": "1729975287830533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974888_1729975291163866_2648731533470094025_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPKj6LhX_SQQ7kNvwHI4Kdk&_nc_oc=Adp2E8VsPnO0itqTzPO9K4Q9BNVjXwcXbXnwYpB8mUJw7fhGiorPQhOd1CMo3-WByPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIxk1vFiHbMkUR3RD8y6tWJtGOqWWBAd2g25-P079ehg&oe=6B032FF8"}, {"file_name": "Screenshot-NPC Opponent.png", "id": "1021545086090699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_1021545099424031_6694415027269339898_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55-Oh0uYzEwQ7kNvwG5OhKr&_nc_oc=AdoTirYxBZ0qoyesFGMKoo2_5u64paRbZ5_LdeDUze-NCq6EOUdtD-t3yFNYLUW1lUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB8UpjBLj6FSaHTPKnodpw3bfmTQSAsXaA1kYRir7nNg&oe=6B03268F"}, {"file_name": "Screenshot-Arena.png", "id": "855040766578683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982581_855040773245349_6076818306779792022_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fKDvf1BX8wQ7kNvwGvKdH0&_nc_oc=AdpJ8a3fdjnWREFAsvMG27tAfHlgmSG1pOfti_9ziJcgktnpv2CdbswCr2ETGjq6hZ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgnGXLmgUXLETKt54R-awBoDumKX13bwZ3tycRT9gO7Q&oe=6B030E74"}, {"file_name": "Screenshot-LobbyMenu.png", "id": "510941114868041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984466_510941118201374_9006863217060690995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frEfij1MxJEQ7kNvwFvISkW&_nc_oc=Adqx_KFgodwuqYooX1uI1Lzngtz_rqx2NaCG2vbywv6QO21vgFrKDH6u1O_b3tpYgBA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0LyFTd2sesuPxCeS6dx7BI6fQ2aS2W6sD1koDy3l6xw&oe=6B0321DF"}, {"file_name": "Screenshot-BigPieces.png", "id": "855861089460800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001708_855861092794133_914761184506848463_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfXKd4mxtpAQ7kNvwG06PMH&_nc_oc=AdqoNd9nu5aaiz1OH2gBcf0W_R986xEwOl99PoUFGY-zCmuHgWUi4eqjl0r7CoW9kBk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvRGXfWVfx9H6aRu_pMI-qxYtwv7UQG81bTKMlfMPpog&oe=6B031D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8cV839zulMQ7kNvwGLzewh&_nc_oc=Adrq95StX-RmYyYGNBy8bQd2N_3-Id1dMTS5nwEq0APkw5XdqfgGcpx-LqqVG_fbavo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbQCQ3wFZWTyVZp5_jXpnTAX7hq9SevL2P6x7vwNQc9A&oe=6B0320F9"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_ca
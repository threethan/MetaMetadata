440_square_shadow.png", "id": "1028016652035700", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75303838_1028016658702366_4005522651680527963_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI17qzL2eC0Q7kNvwGXDdF4&_nc_oc=Ado1JNk_ScQvjD-7DnRKjqO-_2qEGaN-pBFraMxiIVophgdBuXzCHRjBJLhijhraCUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQT0QHA-nu5N_AvobdkmgQV8p-Ngp2Jkjx41sXrm9Fp0A&oe=6B0DC909"}]}, "id": "311863465285946", "locale": "en_US", "screenshots": [{"file_name": "Screenshot-HeroMoment.png", "id": "1729975287830533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974888_1729975291163866_2648731533470094025_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTfNSDwSEUgQ7kNvwHGYVWv&_nc_oc=AdpnifLSm5sdiwOTQ3SLT-zol78jVhb5Sju3bwUl-smhg6T9e9qhI1UuI0i9-UC0HiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSD4TyrZz9Hu2rud-1-XKLVeI0KlLs7yjaXuFjBXLZkNg&oe=6B0DBBF8"}, {"file_name": "Screenshot-NPC Opponent.png", "id": "1021545086090699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_1021545099424031_6694415027269339898_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pil4v8rC-UQ7kNvwHl3R9p&_nc_oc=Adr0yQafpAq8FHJvwigOm5qA3DiLcXykSJm6Jw4vKPH49ZYlETCHyWT-0ThPn4-S8xA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSLC3A3thH04cGi0frnsdUgLcepnrDNfQiiwKyGmMjTw&oe=6B0DB28F"}, {"file_name": "Screenshot-Arena.png", "id": "855040766578683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982581_855040773245349_6076818306779792022_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CDr-LnY5EYQ7kNvwG2FlP6&_nc_oc=AdrIhFRBUb4Xyag8mxLbkh_c-Zd4oq7i7jEMFyObWuAjN3svZrwl9pC-LupXvaFtVe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCYWEST5bdLjIN1QUb_QwlineMPH4975_o55pSgQ82uw&oe=6B0DD2B4"}, {"file_name": "Screenshot-LobbyMenu.png", "id": "510941114868041", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984466_510941118201374_9006863217060690995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8jNA-xud4QQ7kNvwEHmv_4&_nc_oc=AdouCACn-_SjN0fuQog7kcnY8jcd5elMZne_4_MQZsCvRzg5vhESU5f8jtydaQ6Z59g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJxaOHxiN-Yf6OSjP1FFzRHUCiiYuDQDhLZhXhbbUFRQ&oe=6B0DADDF"}, {"file_name": "Screenshot-BigPieces.png", "id": "855861089460800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001708_855861092794133_914761184506848463_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4g_uYR1vV0Q7kNvwHq3kD3&_nc_oc=AdowPghpwzpp-dYfYPIDUh4_EA7ZZwgVoKLqxHyDJOl7Jk5XnfiXiQvf6Fr9kz5qE2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYLX8VaZOVxfqxfjSEh5-LthAfPZA8s4koZDgjslj_Mw&oe=6B0DA904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwOde6nCrLEQ7kNvwE9CiUo&_nc_oc=Ado9aeHwPdFSUYBkq_Srae-Q_oYjV28bDXm4h37316w1ec4p607t-9K036DTYHU_bO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7oUnD13wvSGePQMw9cX5oh_QyetGn5VAnLASTkHy6KQ&oe=6B0DACF9"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_ca
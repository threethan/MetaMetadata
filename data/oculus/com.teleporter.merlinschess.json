creenshot-LobbyMenu.png", "id": "510941114868041", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984466_510941118201374_9006863217060690995_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzl9e-uJwtQQ7kNvwGw6MoG&_nc_oc=AdpxO9SxrJGPm2w3wLrvRqSvUJMVkwqWWebmMvQr7V0CL0ZLpmDh5fo71ic2fqAFVKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW-echwp3fgfYDm8vSfbhlpR7S-Gl1mmDaQP4HRnZIHA&oe=6AFDDBDF"}, {"file_name": "Screenshot-BigPieces.png", "id": "855861089460800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001708_855861092794133_914761184506848463_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ORudZ_1UTwQ7kNvwEblOOW&_nc_oc=AdreCeO2krppttqRwm4Xtvs5kPWHxJx-CFV2Hs1YU9PeImNmjwjlT61JtsFl-En69hI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQPORaAKipRPk5YC9CUNprcZi5ntg6vUV3hfansUqNEQ&oe=6AFDD704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx_SqezArGkQ7kNvwHzPq0u&_nc_oc=AdqSu9HyV97-tHBUkY1aJdQlWTFQgLUKko8igtCExO397BLh9vayU_wRPPHE6s4X53w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyY1WB1ib6_lyUJfQ2F3MUzV7Mkvf0NDGFZrJLNfZBJg&oe=6AFDDAF9"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8016743785083375"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "2226378168758884"}, {"status": "PUBLISHED", "id": "1726522435268433"}, {"status": "PUBLISHED", "id": "1546910950568670"}, {"status": "PUBLISHED", "id": "1812380026876027"}, {"status": "PUBLISHED", "id": "2032114964381968"}, {"status": "PUBLISHED", "id": "2030323324562871"}, {"status": "PUBLISHED", "id": "1328668021999099"}, {"status": "PUBLISHED", "id": "1252680792995902"}, {"status": "PUBLISHED", "id": "1244169263952306"}, {"status": "PUBLISHED", "id": "675095358815520"}, {"status": "PUBLISHED", "id": "2067230110355953"}, {"status": "PUBLISHED", "id": "1848305796022791"}, {"status": "PUBLISHED", "id": "3955923694723192"}, {"status": "PUBLISHED", "id": "1480626726681260"}, {"status": "PUBLISHED", "id": "1710480659879787"}, {"status": "PUBLISHED", "id": "1385519602871862"}, {"status": "PUBLISHED", "id": "1412093403503441"}, {"status": "PUBLISHED", "id": "945596140693717"}, {"status": "PUBLISHED", "id": "1317336856274542"}, {"status": "PUBLISHED", "id": "939710658145541"}, {"status": "PUBLISHED", "id": "1874360156701240"}, {"status": "PUBLISHED", "id": "1265109184694688"}]}, "baseline_offer": {"id": "675095358815520"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2226378168758884"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28783018601362590", "version": "v0.2.2.3c.p"}, "id": "430780765985804", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28783018601362590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.2.3) | Oct 29, 2026\n\n- Fixed: Login issues for child accounts and family sharing caused by recent Meta policy changes.\n- Fixed: Voice commands randomly stopping working.", "created_date": 1793210282, "id": "28783018601362590", "version": "v0.2.2.3c.p", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28783012274696556"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28783018601362590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.2.2) | Feb 02, 2026\n\n\ud83d\udee0\ufe0f Bug Fixes and Improvements", "created_date": 1770036407, "id": "25666689646328850", "version": "v0.2.2.2c.p", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25666686982995783"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28783018601362590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.2.1) | Dec 29, 2025\n\n\ud83d\udee0\ufe0f Fixes\n- Fixed: Some edge cases in Chess.com synchronization.\n- Fixed: Text formatting issues in the Merlin's Chess Box.\n- Fixed: Chess.com opponent search UI getting stuck.", "created_date": 1766933266, "id": "25363752419955909", "version": "v0.2.2.1c.p", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25363748896622928"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28783018601362590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Release Notes (v0.2.2.0) | Dec 28, 2025\n\nHAPPY NEW YEAR, CHESS WIZARDS!\nMerlin \u2764\ufe0f You\n\n\u2728 New Features\n\n- Rooms (Lobbies)\n--- Create private multiplayer lobbies to play with your friends\u2014or anyone you want.\n--- Jump straight into a match or just hang out with your friends before playing.\n--- Collaborate on selecting game properties such as time control, piece set, environment, piece colors, and more.\n\n- Oculus / Horizon Friends Integration\n--- Challenge your Oculus / Horizon friends directly from the Quest\u2019s social invite panel.\n--- When you invite them to play, they\u2019ll receive a notification both in VR and on their mobile app, and they\u2019ll join your private lobby instantly if they accept the invite.\n\n-Oculus / Horizon Destinations Support\n--- Your Oculus / Horizon friends can now see your real-time activity status in Merlin\u2019s Chess and join you as long as this feature is enabled.\n--- Examples: In Chamber, In Chess Match, In Lobby, etc.\n--- (Optional: You can disable this behavior in your Oculus system settings.)\n\n-New \u201cChallenge\u201d Button in the Friends Menu\n--- A new Challenge button has been added to the Friends section of the in-game menu.\n--- It allows you to instantly create a private lobby and invite your Merlin\u2019s Chess friends. \n--- No code sharing required.\n\n\ud83d\udd27 Improvements\n\n- Faster turn switching and move calculations\n- No more waiting after your turn starts\u2014improved fairness for bullet and blitz games\n- Reduced latency for AI moves\n- Chess.com UI Menu Auto-Launch on Chess.com sessions.\n\n- New Physical Menu Design in the Merlin\u2019s Chess Box: \n---Improved visuals and usability. \n---More intuitive, intent-based menu flow\n---Currently available for the Play module and its sub-modules.\n\n\ud83d\udee0\ufe0f Fixes\n\n- Fixed an issue that caused disconnections from Chess.com when creating Chess.com sessions back-to-back\n- Fixed an issue that caused the player menu to become unresponsive\n- Fixed an issue where the Merlin\u2019s Chess AI opponent stopped making moves\n- Fixed an issue where Check announcements were skipped for one of the players\n- Fixed an issue that allowed players to press Ready while the game session was unloading due to auto-abort", "created_date": 1766878622, "id": "25359314693733015", "version": "v0.2.2.0c.p", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25359311243733360"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28783018601362590"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.1.3) | October 12, 2025\n\n- Fixed: Internet connection security check false-negative problems on Wi-Fi networks with custom DNS setup.", "created_date": 1760121781, "id": "24679999518331206", "version": "v0.2.1.3c.p", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "24679996654998159"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
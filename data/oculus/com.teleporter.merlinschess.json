: "en_US", "screenshots": [{"file_name": "Screenshot-HeroMoment.png", "id": "1729975287830533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974888_1729975291163866_2648731533470094025_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALgNu7dCXJwQ7kNvwF3Y6-z&_nc_oc=AdrHl4bInGyZtA6r6BhjXBnG2GGQ2uKxh58_j7EybeK-B8VVDF8ynwRT51zRlCK3spk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6hlWzYol0ROnXyJ1NUd3D7-gq56-Lxygez1i95vqJPA&oe=6AAE97B8"}, {"file_name": "Screenshot-NPC Opponent.png", "id": "1021545086090699", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031447_1021545099424031_6694415027269339898_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeChEYvUAicQ7kNvwEJSjcT&_nc_oc=AdpUldonf0ApdJICZjHPRgphF9u2atBm_pQA7U9mtE0yvEfcx9E8qsIEyTSio45iVPs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIazl_kWjnNebDGM9xCoDzv1Cc2e2IblAqCujN3xlqCA&oe=6AAE8E4F"}, {"file_name": "Screenshot-Arena.png", "id": "855040766578683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982581_855040773245349_6076818306779792022_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vxAX_g0hCwQ7kNvwHymj4m&_nc_oc=AdoL3Ka1GKd1T6vKVgrJCT1abKvkoWW89JeR44-x_zIWSHy9M357CKP_pAdME9Fn4Hs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKllJ23aBoA6Rp7XiVwaySr_Ur5aO6yrLZ_xAQomtYt7Q&oe=6AAEAE74"}, {"file_name": "Screenshot-LobbyMenu.png", "id": "510941114868041", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984466_510941118201374_9006863217060690995_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXL0zJe1Z5gQ7kNvwH-BiQQ&_nc_oc=AdpwXp3YvokT5pWxGjlpekW8uALj3lZWwsc0xDE-KfUoVV8eZ4YiXMb7u8GVh3lc-DA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwILk9OerxPZ6uuev3AT5Ts6e7XnEW4qdTTNh4JV33fA&oe=6AAE899F"}, {"file_name": "Screenshot-BigPieces.png", "id": "855861089460800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001708_855861092794133_914761184506848463_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2UajkBjf24Q7kNvwFKg-e0&_nc_oc=AdrROyeprezhUoEqT7LYvEX433-mnp0iDh2xwVp8XPANKGePqazJ_P3om8ieKRmlKqE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN8dOw-FS0RJEglpIR9JHfbzMzupQRRcomKO5BMpjZVw&oe=6AAE84C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Video_Cover_2.png", "id": "1661466311394678", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001733_1661466314728011_603153942027164803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bYJ2AtqC1kQ7kNvwEnEfTc&_nc_oc=Adron6ZUAOUIQuoJqURkSx1GsVGeeecX-Eq7j0Sey8qdXdR4xNf0x0jxhZARvKR5J3s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN6oQtD1WuvJC-XMG3Awhl4_GrfsmlvxwKknF0PYGcSg&oe=6AAE88B9"}, "display_name": "Merlin's Chess", "keywords": ["chess", "wizard", "strategy", "magic", "boardgame"], "long_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\n\ud83d\udca1 \"For anyone who's ever touched a chessboard, this is an absolute must-play!\"\n\n**Step into the world of Merlin's Chess, where strategy meets magic!**\n\nMerlin's Chess is a fantasy-themed VR chess game brings a completely new gameplay experience to the greatest strategy game ever. Explore an immersive and enchanting way to play chess.\n\n# Rich Set of Features\n\n- **\ud83d\udca5 Animated Chess Pieces:** Experience massive, animated chess pieces coming to life and clashing each other with captivating visual and sound effects.\n- **\ud83c\udf99\ufe0f Voice Commands:** Command your pieces with your voice. Many other in-game voice commands are also supported.\n- **\ud83c\udf0d Matchmaking:** Find worthy opponents from around the world who match your skill level.\n- **\ud83e\udd16 Play vs. AI:** Challenge AI NPCs with a wide range of difficulty levels.\n- **\ud83c\udfae Game Modes:** Multiple game modes to serve every need. **Casual Mode** for a calm experience, **Ranked Mode** if feeling competitive, and upcoming **Puzzle Mode**!\n- **\ud83c\udf7f Spectator Mode:** Join ongoing games as spectator, hangout with other players, and feel the competition.\n- **\ud83c\udfc6 Rating System**: Pro-grade rating system for competitive matches. \n- **\ud83c\udff0 Fancy Content**: Seasonal Themes, New Match Environments, New Piece Sets, New Command Stations. Always fresh and inspiring!\n - **\ud83d\udc69\ud83c\udffd\u200d\ud83e\udd1d\u200d\ud83d\udc68\ud83c\udffb Social by Default:** Customizable Avatars, Voice Chat, and Friendship System.", "short_description": "\ud83d\udca1 \"This is what chess in VR was meant to be!\"\n\nMerlin's Chess offers an immersive and enchanting way to play chess with a rich feature set including a variety of game modes, animated chess pieces, multiplayer gameplay, voice commands, AI opponents, piece sets, match environments, spectator mode, and additional DLC support for exciting new themes."}]}, "developer_name": "Teleporter Realities", "developer_privacy_policy_url": "https://merlinschess.gg/privacy-policy", "developer_terms_of_service_url": "https://merlinschess.gg/terms-of-service", "publisher_name": "MechaTurtle Interactive", "support_website_url": null, "website_url": "https://merlinschess.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8016743785083375"}}]}, "scheduled_offer
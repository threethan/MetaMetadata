4"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29038117879185993", "version": "v0.2.3.0c.p"}, "id": "430780765985804", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038117879185993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Release Notes (v0.2.3.0) | Nov 15, 2026\n\n- Improved: Major engine and system upgrades.\n- Improved: Reconnecting after a connection loss. The game now retries a few times and, if that fails, safely returns you to the lobby instead of getting stuck.\n- Improved: In-game camera now supports additional LCK features.\n- Improved: Additional performance improvements.\n- Fixed: Keyboard not opening reliably in the in-game browser and some text fields.\n- Fixed: Voice chat and voice command errors.\n- Fixed: Occasional image-loading issues with Chess.com profile pictures and other online images.", "created_date": 1794769517, "id": "29038117879185993", "version": "v0.2.3.0c.p", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29038114665852981"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038117879185993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.2.3) | Oct 29, 2026\n\n- Fixed: Login issues for child accounts and family sharing caused by recent Meta policy changes.\n- Fixed: Voice commands randomly stopping working.", "created_date": 1793210282, "id": "28783018601362590", "version": "v0.2.2.3c.p", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28783012274696556"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038117879185993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.2.2) | Feb 02, 2026\n\n\ud83d\udee0\ufe0f Bug Fixes and Improvements", "created_date": 1770036407, "id": "25666689646328850", "version": "v0.2.2.2c.p", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25666686982995783"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038117879185993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Patch Notes (v0.2.2.1) | Dec 29, 2025\n\n\ud83d\udee0\ufe0f Fixes\n- Fixed: Some edge cases in Chess.com synchronization.\n- Fixed: Text formatting issues in the Merlin's Chess Box.\n- Fixed: Chess.com opponent search UI getting stuck.", "created_date": 1766933266, "id": "25363752419955909", "version": "v0.2.2.1c.p", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25363748896622928"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8016743778416709", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29038117879185993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "430780765985804"}]}, "change_log": "Release Notes (v0.2.2.0) | Dec 28, 2025\n\nHAPPY NEW YEAR, CHESS WIZARDS!\nMerlin \u2764\ufe0f You\n\n\u2728 New Features\n\n- Rooms (Lobbies)\n--- Create private multiplayer lobbies to play with your friends\u2014or anyone you want.\n--- Jump straight into a match or just hang out with your friends before playing.\n--- Collaborate on selecting game properties such as time control, piece set, environment, piece colors, and more.\n\n- Oculus / Horizon Friends Integration\n--- Challenge your Oculus / Horizon friends directly from the Quest\u2019s social invite panel.\n--- When you invite them to play, they\u2019ll receive a notification both in VR and on their mobile app, and they\u2019ll join your private lobby instantly if they accept the invite.\n\n-Oculus / Horizon Destinations Support\n--- Your Oculus / Horizon friends can now see your real-time activity status in Merlin\u2019s Chess and join you as long as this feature is enabled.\n--- Examples: In Chamber, In Chess Match, In Lobby, etc.\n--- (Optional: You can disable this behavior in your Oculus system settings.)\n\n-New \u201cChallenge\u201d Button in the Friends Menu\n--- A new Challenge button has been added to the Friends section of the in-game menu.\n--- It allows you to instantly create a private lobby and invite your Merlin\u2019s Chess friends. \n--- No code sharing required.\n\n\ud83d\udd27 Improvements\n\n- Faster turn switching and move calculations\n- No more waiting after your turn starts\u2014improved fairness for bullet and blitz games\n- Reduced latency for AI moves\n- Chess.com UI Menu Auto-Launch on Chess.com sessions.\n\n- New Physical Menu Design in the Merlin\u2019s Chess Box: \n---Improved visuals and usability. \n---More intuitive, intent-based menu flow\n---Currently available for the Play module and its sub-modules.\n\n\ud83d\udee0\ufe0f Fixes\n\n- Fixed an issue that caused disconnections from Chess.com when creating Chess.com sessions back-to-back\n- Fixed an issue that caused the player menu to become unresponsive\n- Fixed an issue where the Merlin\u2019s Chess AI opponent stopped making moves\n- Fixed an issue where Check announcements were skipped for one of the players\n- Fixed an issue that allowed players to press Ready while the game session was unloading due to auto-abort", "created_date": 1766878622, "id": "25359314693733015", "version": "v0.2.2.0c.p", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25359311243733360"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
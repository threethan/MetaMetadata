art.png", "id": "758635336591232", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311539_758635339924565_8712177388953044842_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtSx-swMv54Q7kNvwHh-bNO&_nc_oc=AdoVTn0yaY1qKDWL_pIRKAFS19Z82wLleNfimZkHCfJhM02PQ96txvWFNxuc4NWFiEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2ApxJ_Hw5Y8XCguvzYo5brpJMue36BLSwFO6cSy24ww&oe=6AB91E15"}, {"file_name": "22-227978_football-goal-text-png-clipart.png", "id": "2519976058345372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311539_2519976061678705_3255318815524092943_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNerq-1AweQQ7kNvwGPVykc&_nc_oc=AdrH_khRGcl_ep1yjjcIqkFYi-68pGpQGYDq9OgU4Pw42-NMGZ8ivzSJDqqoYfGtlwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMoeI_Ub68shGEQAWQuvgZ9blFyOSYwM7QyXzjVPGChg&oe=6AB908B9"}, {"file_name": "22-227978_football-goal-text-png-clipart.png", "id": "2782825908772999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295628_2782825915439665_9080021859608477684_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdVu8DZ-rycQ7kNvwHkO0hp&_nc_oc=Ado6GRg1XypS933_Ra_Ariyv57TgIJxN3hkS4Y-r2wwOULRgIzyjuW1V41lDk3Hm1Ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjpJgACXeDezXS-qkK50A5twGS8gaegRHK6ldt5SAjeA&oe=6AB913B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Market Mayhem", "keywords": ["action"], "long_description": "Enter a lively and chaotic merchant bazaar where danger and deliciousness fly through the air! In this fast-paced VR action game, your mission is simple yet thrilling: slice as many fruits as possible with your trusty sand-forged blade while avoiding deadly bombs thrown by mischievous merchants.\n\nAs the game begins, fruits of all shapes and sizes are launched into your path from different directions. Your job is to swiftly react, using precise hand movements to cut through the airborne produce. Each successful slice adds to your score, rewarding speed, accuracy, and awareness. But watch out\u2014hidden among the fruits are explosive bombs. Hitting one will cost you points and shake your grip with a blast of haptic feedback.\n\nThe longer you play, the faster and more chaotic the scene becomes, challenging your reflexes and focus. With a limited time to rack up the highest score possible, every moment counts.\n\nWhether you're aiming for a personal best or just enjoying the satisfying slashes and splashes, this game delivers an immersive and exciting VR fruit-slicing experience. Are you quick enough to become the ultimate fruit master of the sands?", "short_description": "Step into a vibrant market where merchants are hurling fruits and bombs your way! Wield your sand-forged blade to slice as many fruits as you can\u2014but be careful to avoid the bombs! The more fruits you cut, the higher your score climbs. Sharpen your reflexes and get slicing!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/marketmayhem", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10002904793163260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.
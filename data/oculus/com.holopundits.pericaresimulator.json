reenshot_Peri-Care_05.png", "id": "728088559472652", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_728088562805985_8325440462705578520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJY7GKodvS8Q7kNvwEku_j1&_nc_oc=AdoKR9lnPpLWttJS0v5ezEpjAOMYjZa2PSFwomQqVFDO40sqIxDWGw6Bga3HGvCWVjY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkpQn4o3sEp8iJYrOcZpOP8-R70nCI5xiaTJyjEGnzuw&oe=6AA55C7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "925593592919215", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031407_925593596252548_8555483234337504629_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fukuiYUcT4Q7kNvwH_801M&_nc_oc=AdpbRuqlddaqZliGJjPJuoz3TIqEoNZkVzsYu_cz5EpFem7fqy8f9bGNoIfBkTAmoKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPGPhhaAXLsPk1f5vCkd95opY_QCUlJVrsL2PSvEs2aw&oe=6AA540B9"}, "display_name": "Peri-Care Simulator", "keywords": ["CNA", "nursing", "training", "perineal", "healthcare"], "long_description": "The Peri-Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper perineal care. This application guides users through the steps of maintaining hygiene, preventing infections, and providing perineal care correctly. \n\n**Learning Objectives:** \n- Remember the steps and protocols for providing perineal care. \n- Understand the importance of proper hygiene in preventing infections. \n- Apply the correct techniques to provide perineal care safely and respectfully. \n- Analyze the patient's condition and comfort level during the procedure. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. \n- Create a hygienic and respectful care environment for patients through proper perineal care. \n\nThis thorough approach ensures CNAs are well-prepared to perform perineal care competently and confidently in clinical settings. ", "short_description": "Learn the essential skill of providing perineal care for female patients, ensuring hygiene and comfort."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26795986560048915"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3882649118651801"}, {"status": "PUBLISHED", "id": "1300923344647792"}]}, "baseline_offer": {"id": "3882649118651801"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743940, "status": "PUBLISHED", "id": "3882649118651801"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30530058186641715", "version": "1.0"}, "id": "370392879460817", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26795986530048918", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinar
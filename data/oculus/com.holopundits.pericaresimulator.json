reenshot_Peri-Care_05.png", "id": "728088559472652", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974567_728088562805985_8325440462705578520_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9uMwk1oAjgQ7kNvwFBsq23&_nc_oc=AdriuqjPn9KNMEqIV6K0PalqZ9riKW6u4vwsUQgSk01dxALk0jY9P5KL-rfET4nh_Wk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUxUMNIWC6kEpRZ5XBAY7JPD471xBRdvJApgfLK-zgug&oe=69C7E07F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "925593592919215", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031407_925593596252548_8555483234337504629_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clas6vOzZuAQ7kNvwHcXcUN&_nc_oc=AdoJU8AROlr4t69_C_p1gDT4HGIy-3SDpWELc57nAdC_HDDWYzbAcAq4HiqYFtXy_Rc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyBajwqLfiw0gBP-68209mKw3AnkCZIBShwLIGcczgkg&oe=69C7C4B9"}, "display_name": "Peri-Care Simulator", "keywords": ["CNA", "nursing", "training", "perineal", "healthcare"], "long_description": "The Peri-Care Simulator tutorial immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the essential techniques for providing proper perineal care. This application guides users through the steps of maintaining hygiene, preventing infections, and providing perineal care correctly. \n\n**Learning Objectives:** \n- Remember the steps and protocols for providing perineal care. \n- Understand the importance of proper hygiene in preventing infections. \n- Apply the correct techniques to provide perineal care safely and respectfully. \n- Analyze the patient's condition and comfort level during the procedure. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. \n- Create a hygienic and respectful care environment for patients through proper perineal care. \n\nThis thorough approach ensures CNAs are well-prepared to perform perineal care competently and confidently in clinical settings. ", "short_description": "Learn the essential skill of providing perineal care for female patients, ensuring hygiene and comfort."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26795986560048915"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30530058186641715", "version": "1.0"}, "id": "370392879460817", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26795986530048918", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30530058186641715"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "370392879460817"}]}, "change_log": null, "created_date": 1753257
": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjIQsF2JJHYQ7kNvwHFNQOG&_nc_oc=Adq_xi_V8jLm7YecKolWgrD3Pty_soIyqNf48qHUsm0c7ZXpd3__M-QW_AzWV4CWugE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmqlW8EXhKe4NnWiWmHDdPTTmilXXihOs5ZfMPsnLpYg&oe=6AEB3296"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1am38rrWT40Q7kNvwEpCCUX&_nc_oc=Ado6If_2TDhuXpQ3z_VU2KC5Jb9cp3eELLtwe0iZOSZSNg8ms3BM9KuSAmJn5kBVQBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT-Aa443uaNw5KJWLw_ob_G9fziGiTktmBCn_YQnz0ZA&oe=6AEB2E20"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECVyPDf-fhYQ7kNvwHcCnwE&_nc_oc=Adr0dQNmX3QfDyK2NkwlYr4lSSuaIzFxHoNeA-_qBM-iSiOr-st-mOJh1rKYFf928ZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSekVLge278oGWulAyHizbkNT7wn70yqwCRIVmgYMwkvw&oe=6AEB4B82"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VapoClqIAPYQ7kNvwGvAQS7&_nc_oc=AdpfQie0prAh9Vu-davZUSKVCob2oQjQkHduKqA4Fj1LvkwFCzfCYOajiRf2kMgoZgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7a82qBBI9nw579sSe3jeCeqd_hgdx9tssBI4DTGlk-g&oe=6AEB4236"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq9jUm53htsQ7kNvwGpqviy&_nc_oc=AdqZ8wyL4xgTCfILAfOeKDUpm9kNDMlajMpCfns4Rr0IYpEtvf_Te3KP4pIH7ttwEmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAyJ8-1olO_JlIxND6AUDhxQhAhgQGRowxUKVkWrhajQ&oe=6AEB61B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
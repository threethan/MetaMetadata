name": "03-map.png", "id": "3120951428295956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620655_3120951431629289_3272043014730411557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUfvzVDZLFoQ7kNvwHjk9VC&_nc_oc=AdqtmUapxEx8nAbEGdgOt-339LFBXdDlO3LOotZBPArjyC-ey206Lr7hR7jrmzmWFqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZsy_uJF8Ot9ziNRe99l6vNozYNe3H2y28Awoq7AB_rA&oe=6AF896C2"}, {"file_name": "01-beijing-road.png", "id": "1148375551089575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628436_1148375554422908_8732934802185607320_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2vjHbTsCf4Q7kNvwEG2N3b&_nc_oc=AdryTRomxbvS9VxAz3sbWBKZwgcOy1vkwHtfbTKRaDmDuqPEMC0Gm4LFj6hW9hk57Nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS879vQOZXecatc_ZRyxe3AXqgzEz8axhCsxaI7kOb0Xg&oe=6AF89C4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u4e2d\u56fd\u8857\u666f\u6f2b\u6e38", "keywords": [], "long_description": "\u4e2d\u56fd\u8857\u666f\u6f2b\u6e38\u7531 FFSky Studio \u72ec\u7acb\u5f00\u53d1\uff0c\u662f\u975e\u5b98\u65b9\u8857\u666f\u5ba2\u6237\u7aef\u3002\u5b83\u5e76\u975e\u767e\u5ea6\u5730\u56fe\u3001\u817e\u8baf\u5730\u56fe\u6216\u5176\u8857\u666f\u670d\u52a1\u7684\u5b98\u65b9\u5e94\u7528\uff0c\u4e0e\u767e\u5ea6\u3001\u817e\u8baf\u65e0\u96b6\u5c5e\u5173\u7cfb\uff0c\u4e0d\u4ee3\u8868\u5b98\u65b9\u6388\u6743\u3001\u5408\u4f5c\u6216\u80cc\u4e66\u3002\u5730\u56fe\u3001\u8857\u666f\u5f71\u50cf\u53ca\u76f8\u5173\u5546\u6807\u5f52\u5404\u6743\u5229\u4eba\u6240\u6709\u3002\n\n\u6234\u4e0a\u5934\u663e\uff0c\u73af\u987e\u4e2d\u56fd\u8857\u5934\u7684 360\u00b0 \u5168\u666f\u3002\u968f\u610f\u53d1\u73b0\u964c\u751f\u5730\u65b9\uff0c\u91cd\u8bbf\u719f\u6089\u7684\u8857\u9053\uff0c\u6216\u5728\u51fa\u884c\u524d\u4e86\u89e3\u76ee\u7684\u5730\u3002\n\n\u2022 \u968f\u673a\u63a2\u7d22\uff0c\u6216\u5728\u5730\u56fe\u4e0a\u9009\u62e9\u5730\u70b9\u3002\n\u2022 \u641c\u7d22\u76ee\u7684\u5730\uff0c\u6cbf\u53ef\u7528\u7684\u9053\u8def\u8fde\u63a5\u5207\u6362\u8857\u666f\u3002\n\u2022 \u6309\u65e5\u671f\u548c\u6765\u6e90\u6d4f\u89c8\u53ef\u7528\u5386\u53f2\u5f71\u50cf\u3002\n\u2022 \u5728\u672c\u5730\u6587\u4ef6\u5939\u4e2d\u6574\u7406\u6536\u85cf\uff0c\u8fd4\u56de\u6700\u8fd1\u8bbf\u95ee\u7684\u5730\u70b9\u3002\n\u2022 \u9605\u8bfb\u9644\u8fd1\u767e\u79d1\u6761\u76ee\uff0c\u9009\u62e9\u73af\u5883\u5f55\u97f3\u966a\u4f34\u6f2b\u6e38\u3002\n\u2022 \u7b80\u4f53\u4e2d\u6587\u4e0e\u82f1\u6587\u83dc\u5355\uff1b\u53ef\u9009\u4e2d\u6587\u8bed\u97f3\u641c\u7d22\u5728\u8bbe\u5907\u672c\u5730\u8bc6\u522b\u3002\n\n\u65e0\u9700\u6ce8\u518c\u6216\u767b\u5f55\u3002\u5730\u56fe\u3001\u5168\u666f\u548c\u5728\u7ebf\u767e\u79d1\u9700\u8981\u7f51\u7edc\u8fde\u63a5\uff1b\u5f71\u50cf\u8986\u76d6\u3001\u62cd\u6444\u65e5\u671f\u4e0e\u6e05\u6670\u5ea6\u53d6\u51b3\u4e8e\u5185\u5bb9\u6765\u6e90\uff0c\u90e8\u5206\u5730\u70b9\u6ca1\u6709\u8857\u666f\u3002\u5168\u666f\u4e3a\u5355\u76ee\u6444\u5f71\u56fe\u50cf\uff0c\u5934\u90e8\u79fb\u52a8\u4e0d\u4f1a\u4ea7\u751f\u771f\u5b9e\u573a\u666f\u7684\u6df1\u5ea6\u6216\u4f4d\u7f6e\u89c6\u5dee\u3002", "short_description": "\u7531 FFSky Studio \u72ec\u7acb\u5f00\u53d1\u7684\u975e\u5b98\u65b9 VR \u8857\u666f\u63a2\u7d22\u5e94\u7528\u3002\u5728\u4e2d\u56fd\u8857\u5934\u968f\u673a\u6f2b\u6e38\u3001\u641c\u7d22\u76ee\u7684\u5730\u3001\u67e5\u770b\u53ef\u7528\u5386\u53f2\u5f71\u50cf\uff0c\u5e76\u6536\u85cf\u559c\u6b22\u7684\u98ce\u666f\u3002\u652f\u6301\u7b80\u4f53\u4e2d\u6587\u4e0e\u82f1\u6587\uff0c\u4e0e\u767e\u5ea6\u3001\u817e\u8baf\u65e0\u96b6\u5c5e\u5173\u7cfb\u6216\u5b98\u65b9\u80cc\u4e66\u3002"}, {"images": {"nodes": [{"file_name": "cover-landscape-2560x1440.png", "id": "29295599223460462", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628455_29295599233460461_1771253647189358320_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jr_ddOVmz0Q7kNvwEq6SNp&_nc_oc=AdpINjhk1OIdJVi_MVQV4Hhxm
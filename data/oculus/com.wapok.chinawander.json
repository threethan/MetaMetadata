": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjIQsF2JJHYQ7kNvwG2sRgX&_nc_oc=Ado7LMgU-UnQxu4cbByXZIFcV1WO-DWz8fcWr_2iMz3Ohk4ykaj2q4JwlPSP1dIl900&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp5Q7y4X5CENwDb9h0DdAQBsCALsUOGJvOrKtYyNo-UQ&oe=6AE9E116"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1am38rrWT40Q7kNvwFajOEB&_nc_oc=Adp05yQqQvVCP-eNZFmGMc5qNVaGU7S6Lx1S0fwGVjKg2cU02ToTWxDsQVBj5vImlzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUOZ28cw14FEBGdqlAOwLbjj9mAnjFYRQtHe7CvhOYAQ&oe=6AEA14E0"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECVyPDf-fhYQ7kNvwEjavUR&_nc_oc=AdoDD9hAkSK2O4UPiD07kBx8ZyZne1wPd2KqcSEEYNprhQAVMeEV3sj44Fzlz2VCYdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLIDfsozW363MhC5MF4vf6WfAL2qlYyaYOfE52QLqp_Q&oe=6AE9FA02"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VapoClqIAPYQ7kNvwEQ0dXo&_nc_oc=AdoM-KN3UGHGb1J16k3ZsuFFpTKcUq0NrYcK8TSl5Jw65jf9Hclh9XOYndW76RAsIwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLO2DW5He3yTke5L8UsyJVaPwM5FJWRvJxIZciT16DeA&oe=6AE9F0B6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq9jUm53htsQ7kNvwEnBzho&_nc_oc=AdqTwucqrlnbeh3AJlVyyC1cwIEFQq9q-8FsqG2ojVBdrRD7_Tj17OD2kMpY6PsIQgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkXjLvq2tMWNVvpRdfKo9BiRDSMTTEaKdpe0OOwTzjbA&oe=6AEA1030"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjIQsF2JJHYQ7kNvwHLBbz7&_nc_oc=Adr-85ypyOGx83IlwSgbKgdRI6o3UeYHEpYmS1OrUM8Q4PCnAV7clDZSzwW2V1N5vx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYdRPL8bQAncDf_FC0GJoprR8G69KnhoUJ0RPEVYLRcw&oe=6AE73E16"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyM_iIahId8Q7kNvwEZjfmf&_nc_oc=AdrbShRDfDk2RN44nSfXhIqZjq16J39bjteBFz6RVThqiwjlvNCvHAENIXrpLEvcSWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCoJGGTPLsqacIcDCxrDYqRWlCy9OK4xjj_eyNHAiYKQ&oe=6AE739A0"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1aTqrz3LqQQ7kNvwGGdvJ_&_nc_oc=AdrvTOuEbaEq6klhcnaaLg2QVIWHp_cPdJLhepNN95fFtnZ02_-fqAJsrzEDTcVOx6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoar-H1Hr1b6XDHEwXDLOySutGq3T3IA7NMQh9teYOCA&oe=6AE75702"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE-BJd7xmvgQ7kNvwESTuV8&_nc_oc=AdpD7e3XyZGo7taZcsxR0K_QTN8GYot4P1Wys1LbxLXhBL66VOSLVYWfZ8VDeW9XC0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLk9pSXSgffL2TeXCBgPcjxEKeVsQYy-pszHkBDGbGcg&oe=6AE74DB6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAh7a7EJMfUQ7kNvwHvGN4e&_nc_oc=AdocoKi3IGlVyoJLpHrzzqgrMfzL8cjiwuTAPc5I4XCKTOhssGndov6UXF7Ji-e91JE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXv5ZbZfABzWhR0uyNbiyQXn-4v50IxEfdKRizv29SDw&oe=6AE76D30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
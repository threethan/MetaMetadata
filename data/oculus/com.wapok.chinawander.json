08179684_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX3a7_eja_cQ7kNvwGHZxgZ&_nc_oc=Adr1Ps7_TaB9koyIknFP_gg4eOiG9HBMeafJChi598p8_FYtHaa6h9i3kvzG2fmxhNY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvyHAGtyDXV37bRDzA-JlJGWPAwE3uDB4VKEruVOOReg&oe=6AFC6F02"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTmTHnIh1YYQ7kNvwHkE2Jw&_nc_oc=Adojl70cN5r6lGwggw61wM7EQggZszJ26IakOpusmM6biNL5HoeH3eZqqs3vi5QYQ-0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9VYmIA2YGRl7XEvon3ckqFEqRIsCE6n52RDuXSKxDbw&oe=6AFC65B6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXwdjs5Qp_8Q7kNvwEQ2dnu&_nc_oc=Ado54naudh_GHp83R4_yD3CpMgVblL-kNBi0zV4W4DE0beMb4OHF0nL2nLTXim6BMAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiG11r2SiQT0dVl5i4gOt_bZWFA6LV6cqQ-kQgHyykBA&oe=6AFC8530"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2520283395049687"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1135490818957887"}]}, "baseline_offer": {"id": "1135490818957887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792701600, "status": "PUBLISHED", "id": "1135490818957887"}]}, "liveChannel": {"nodes": [{"la
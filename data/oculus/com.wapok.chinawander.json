08179684_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlYX02qB-cgQ7kNvwGmlupi&_nc_oc=AdpjfRJpBXHLyja2nBfEyPmRFtSIAbRyjHUQYG0Yq3sztNv_Mvz-TV21lBtqwM7ou9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWR3iYccfT34U1YL9B6OqzHobbnldXPnng19krKLCH2cA&oe=6B0F1C42"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIjtKQETc2sQ7kNvwEleQ2n&_nc_oc=Adqhzc_tQCwZsj21xX0JF3vAQQH0UKq1lo4LLKaeXaqlz-x59PhhSSrR52KiJKPjI9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWU7YsCnH6-OiazN_eAm0-9bWG0aI0FDs9yGB_KfbOiZg&oe=6B0F12F6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ1qFwRTd3AQ7kNvwFqQ-i3&_nc_oc=AdqKdQRSrcZNEhlWkhGtd2_OxAeMS7ILFR2mnDvZWsP6ZZ71AP2thTHLJS4Pu9HSt3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMYm7fpOoYUS4ReizLGZQvuipeBhei0Xxg59Vo5nnvPw&oe=6B0EFA30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2520283395049687"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1135490818957887"}]}, "baseline_offer": {"id": "1135490818957887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792701600, "status": "PUBLISHED", "id": "1135490818957887"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2562824277462265", "version": "1.1"}, "id": "1861112298398000", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2520283391716354", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2562824277462265"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1861112298398000"}]}, "change_log": "See where you are and which way you\u2019re facing. The main map, wrist map, and floating map now show the current road, along with the city and district when available. When a panorama includes orientation data, the map arrow follows your gaze and shows a compass bearing such as \u201cNE \u00b7 45\u00b0.\u201d\r\nBetter place-name suggestions on the built-in Pinyin keyboard. Type chengdu in a place search and \u6210\u90fd (Chengdu) appears first. When naming a favorite or folder, the same input puts the common word \u7a0b\u5ea6 first. We also corrected Pinyin readings for place names including Chongqing, Xiamen, and Lu\u2019an.\r\nMore relevant nearby articles. Chinese-language lookups now use the region as well as the place name to distinguish places with similar names. Duplicate entries for Beijing\u2019s Forbidden City have been merged. The Forbidden City and Shanghai\u2019s Yu Garden now have short introductions and links to official sources. For other places, you can continue searching within the app.\r\nControl the main panel with either hand. Press A on the right controller or X on the left to open the panel. Press B on the right or Y on the left to close it. When using binoculars, click the right thumbstick to lock or unlock the view.", "created_date": 1795746104, "id": "2562824277462265", "version": "1.1", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2520283391716354", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2562824277462265"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1861112298398000"}]}, "change_log": "Add a selection of locations", "created_date": 1793371864, "id": "2531874643890562", "version": "1.0", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2520283391716354", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2562824277462265"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1861112298398000"}]}, "change_log": "Optimize gesture controls", "created_date": 1793022426, "id": "2527691260975567", "version": "0.10", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2520283391716354", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2562824277462265"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"ch
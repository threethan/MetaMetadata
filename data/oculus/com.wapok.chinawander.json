", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMmEsHVcUhwQ7kNvwF6OIAA&_nc_oc=AdrIHhORqvGcC5iRssaNNOJZhBhS65__n63q18TW_wfJW3NOp6GJyRqeOBMSuSu9kGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6_4Pw3sKuN0qvnXJ1YYOOH9viuYlGPI0y4lFjGpshlQ&oe=6B005A36"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcJZe-hXElQQ7kNvwFTme24&_nc_oc=Ado0vAfBF5b0-B07NWQeQYqlZxtJ0I5mldvIEhGjDhmxQM5csd9wl8xd4qVie1H9cYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpW9jTNC4ygnRl6f03YSXwTCHKKr73YgLitU5BWOTyHQ&oe=6B0079B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2520283395049687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_2165217894081911_1670494314016514778_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30MtCE84CikQ7kNvwFwpR6P&_nc_oc=Adq3aQfcYCj9KlVyw8LglcHzCgewwte9iOzs1wKcrWG-onVWm52w-nt1MA0m6vykEDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShV4mLbvYYQJhWLsUqEgX0_jLp1S9t8BBquLmC64i_tw&oe=6B0057B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ChinaWander", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "36269221
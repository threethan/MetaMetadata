": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALjCdfpQPFoQ7kNvwE8Izti&_nc_oc=AdqZIsMi2fdk8R1y97KJ4kXX0EJlfEdRaYS5XR4rra5HxTnyKwn8PpfXhQoMYccQzBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5_6OiNNrcGE-684pZpggpl1Htx_AUmXLq_Z1J0QYxpQ&oe=6AE0A696"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnN3KGL1G7wQ7kNvwEDwMtt&_nc_oc=AdrbkrgOPhzThnSi35GVg79peYMVAwwzwjb-VwuYap5vhO8ZTi255MNIjJdC1oHVGio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGI4jO2-12rLcgELTC60N3f1xm1E91SnwLKaX2NJoYFw&oe=6AE0A220"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9Mo6WZKZE8Q7kNvwFJHa4J&_nc_oc=AdoxJXyqbnc_Vpyg_5rFgACXJeU1dsow6SeEbR2h8Gb0BhFuX-TVoky6RZmjT0CyGls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqojOjhrsE1VKa7rhepx0OwMGSuGd80FzhCiclxNdmgQ&oe=6AE0BF82"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41p8Etdxxr0Q7kNvwHToxET&_nc_oc=Adqc77SJUgFmf2Qkfpgnzi-fyYixEAl7K3Nk5zfaER5s2dXj3ENNEgBDcgf5Ltr4-_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw59wrdAhVxRhBrKmIFOS2IeBTaPnxhqpzvTHC9GMw4w&oe=6AE0B636"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kyRk8l86T8Q7kNvwENmdcc&_nc_oc=Adon3Rle4SopjNdd_RCXMNxYFQ3dnQOYcHr8_J7WelJpLftmC9Uwuoavaq08OfuajLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8NrXg8sEY42k2OeXAL_wJ3a56QYn-4e777YD8libsgQ&oe=6AE09D70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
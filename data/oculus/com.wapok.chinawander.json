": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALjCdfpQPFoQ7kNvwGxgjnI&_nc_oc=AdpMaLJ8jFyQvA0Atgg26S58-BmjqsfQK81YLPlzq9KsvTpVuWUyvw2nPnjFbM0qiwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPW5QGCU8tWcB2PN26GrNxuVymQLllHkRhKGfH0KMhPA&oe=6AE1F816"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnN3KGL1G7wQ7kNvwETpFvv&_nc_oc=AdoTtgDEHgRS0gyErUDhPWSf0fOeEO_OF5SZf8CBcI8m25JmLkH28pHd2l1k_F0KJj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpyu6GZuVNKjDGTo7v8wyByFGtnbj7oqLmIsPEuaT30Q&oe=6AE1F3A0"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9Mo6WZKZE8Q7kNvwFgs2ux&_nc_oc=Adqj6uyxEExzzo9LQR4oPdQ8yy97SkJ4ol4HR1gwuLZ-Fy2jU71gCX0mNBpH83_1NbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPfkjM7BmrpIB7RltTigXp26xzPFeoEdaG_tRBAIYAwQ&oe=6AE21102"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41p8Etdxxr0Q7kNvwErDPHU&_nc_oc=Adp6PweLOjSyDpsYtmJvpTMUgslHSBE1iid4dWQrnXnLio4VLEkIa0sPOHkXp1Vmvkg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO40btpA8yOKrvy3u7d8f7vaZ9XAdYgbQlcK1mDFDqIRA&oe=6AE207B6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kyRk8l86T8Q7kNvwGQnu0Q&_nc_oc=AdqHLVt0mj6JPSlM7Fg82-aV_gzrBibpUPGtPD5yZ5FsAC_JHT3SkdKcby8vj6-U5rU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZUoi6kE706aENR0Mv8rH8Q_heCt9De8x6bs3M3W3Xjg&oe=6AE1EEF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
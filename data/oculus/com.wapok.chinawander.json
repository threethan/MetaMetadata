": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmYB5oFQ2-wQ7kNvwFg0mNg&_nc_oc=AdqcMVAAph-7GJVfRqlFEtC0TyfrVScnEsEaBYrLBX7c2LUZM-zr-wAFd9kVbcHQBew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtDi4oGCw9qkEdm0nHS0U8Mzpbu0AzgjioWtGAUpwvlQ&oe=6AE49B16"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyM_iIahId8Q7kNvwHRhCtk&_nc_oc=AdonY1CGwzOoq-GqaPNOwe_Ef6grvuKe5z2cwFhgGWNDQej39v5c4NhIwtqStK_xyIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZxEBIawlSfx-zOHKegBHBrCWEsEdAGGXyRE-BiQHjmw&oe=6AE496A0"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1aTqrz3LqQQ7kNvwHsv6LO&_nc_oc=AdoMT-LL3enIQL7lzzUXpwnmzF1l8DveT562TStSGBjMtFkCPmicigk_GAlxpgnv_SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWjcIuylNjBR0yVFHwFqXbNuIzrnGg4e5axfpaQi6sZg&oe=6AE4B402"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE-BJd7xmvgQ7kNvwGVipGK&_nc_oc=AdpND9ABSmnY29_ySOMs7PAcUB7vCaRnaPQFBnUtXYOmVxy2jng02Q5fZlpdOaR34i8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYzldIlY3uXCVPXPv8prm-VCzKS8RKJGGWQnqCNlHNyA&oe=6AE4AAB6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAh7a7EJMfUQ7kNvwFVSGih&_nc_oc=AdplGTuG5bbPpX040QV3GBlyl6M859aIVwRpgEcamCfvX3a8q6mTpbQdXGW6NRtR_Es&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUK1Z72R7EY_8Wk4taXo1MWz9OcFeuvtjflP029JOhag&oe=6AE491F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
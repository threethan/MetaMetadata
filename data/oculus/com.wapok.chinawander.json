": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xVfsBLIKR0Q7kNvwHD7i7_&_nc_oc=AdrNLQr8ef6JhBP2hIP_c3fB63G92gKuBsyfYnxcrlB9L1zBVKU8rHygsLdFtXNuY88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDaTycdwLZpJUp-LJMX3tX86u5rxDdOySNnJtftWy5Bw&oe=6AF0B0D6"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-ZLdwRRLhsQ7kNvwEqVMol&_nc_oc=Adq0Ju15W0rOnHOr7mliGJO36GnCn-cxqjK9dJtmXufVRkp79BiHmEjZgXr9VUKOwiI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5kbE2gUI4zkyQJooNq6BI5GFfDNLLI5TsjjYeejtxAw&oe=6AF0AC60"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beIURMzu9GMQ7kNvwF-1EZ3&_nc_oc=AdqUywJFTwhHty9RtPCkuoVhE10GTTrwqiDAPlEZL5SRgdW5pquZR2YyqfWvjL8MnAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRmjcd3tQwX4ieQBvgyTAyZtbAdv7dyKF-hPKAMFmQQQ&oe=6AF09182"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OooWxdnGVcAQ7kNvwHtWrym&_nc_oc=Adq568Z27bjLZWVHHjN1UgBBtTKRt_gry39CyBFv_M0g1tGUCZcFqkV3mW_pniyC6a0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTUX09oxvI21r7kD4b1Pv5BLHwcygtQy1IV5y9yAg5CA&oe=6AF08836"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc5u3sdWlbQQ7kNvwHReBh8&_nc_oc=AdphltdUp_fcy8CMeRmkrUzCTkcgKsdDCgi5z-uj69-Bu_2b-ZeiX6lJAe3kQoC_3QE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh9jd0YbVbjsBuDDy9u16QDkH3cBnRDA3BnPg-_LbFyw&oe=6AF0A7B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
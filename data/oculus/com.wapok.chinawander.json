": "en_US", "screenshots": [{"file_name": "04-history.png", "id": "1672922974262459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623512_1672922980929125_5241850309398749755_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xVfsBLIKR0Q7kNvwGsIg-3&_nc_oc=Adoa0zl1utXFNkUGxpYqlQ7Nw6Y6EScqYxitKTWlIbdf1rmbA03qnl9TdlA11K2o6F4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoz1xHIKa6imYqc2bzRO82j0DlyZQVwKBY7U9dRiHzxQ&oe=6AEF5F56"}, {"file_name": "03-map.png", "id": "1753433973456736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_1753433976790069_7285999299790393475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LjwlVkr5GMQ7kNvwHHYH5M&_nc_oc=AdrGZX9syfJD-2LkmEDcHj-W6EE5T2qstaBSzSpuBH-Wz5l8VKOeI9JRRedoypK9pAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR92FAUUUqgUiF3NvmVMmR4CFW3A5kWZrzi6rKf3TdhGg&oe=6AEF5AE0"}, {"file_name": "05-favorites.png", "id": "2115443372511841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619374_2115443375845174_9097435577108179684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRdf2YLHqGEQ7kNvwFp5B7k&_nc_oc=Adrqr3UHlWPlRNSHt-TCNu9KQjfv0xO5uU_jOKopepUHnfs0LnsKzwRWZ4L1wvL0hi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVltN2U-QpeOTOPBep3yn8enWKGJsW8bNwE_FTEXEngg&oe=6AEF4002"}, {"file_name": "02-shanghai-road.png", "id": "3321265084747103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622162_3321265088080436_5172227488920306061_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAYSKMTdGCwQ7kNvwHchomy&_nc_oc=AdpkeUV5b9Mw1XeIFxez47SYTBYviUnX-ZeA-q95MxCENvHuccViOdCAKcRlPZO3re8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQok37JxOu2G6yJJu6vjutNtOWoq3ZZoWTBMrMDp-bOvQ&oe=6AEF36B6"}, {"file_name": "01-beijing-road.png", "id": "1636343461273562", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620532_1636343464606895_6536535717995770494_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ja3PYROtGMQ7kNvwErtpBG&_nc_oc=AdrbxdZWJDhpTAasKcoiK_WJoHVYXxauqDmr7r_GUgYsY3-Qsr8OIDV0LOO7_atSfak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMy8zgeI1iCv_68reUzrrQrJ1UKgNhe-GdRFXejcoUbg&oe=6AEF5630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChinaWander", "keywords": ["China", "travel", "exploration", "panorama"], "long_description": "Explore China, one street at a time. View 360\u00b0 panoramas in VR for relaxed discovery, revisiting familiar places and getting to know a destination before a trip.\n\n\u2022 Discover a random location or choose a place on the map.\n\u2022 Search for destinations and follow available road connections.\n\u2022 Browse available historical imagery by date and source.\n\u2022 Save favorite views in local folders and return to recent visits.\n\u2022 Read nearby encyclopedia entries and listen to optional ambient recordings.\n\u2022 Use Simplified Chinese or English menus. Optional Chinese voice search is processed on your device.\n\nNo account is required. Internet access is needed for maps, panoramas and online articles. Coverage, dates and resolution depend on the source; some places have no street view. Panoramas are monoscopic photographs; head movement does not create real-world depth or positional parallax.\n\nChinaWander is an unofficial street-view client independently developed by FFSky Studio. It is not an official Baidu or Tencent app and is not affiliated with or endorsed by either company. Maps, imagery and related trademarks belong to their respective owners.", "short_description": "Discover places across China, browse available historical imagery and save favorite views. Supports Simplified Chinese and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wapok.com/chinawander-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FFSky Studio", "support_website_url": null, "website_url": "https://wapok.com/", "c
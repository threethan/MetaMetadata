2.oculuscdn.com&oh=00_Aftgm9tjmRHgg2XqHNeoK7OiVeml-SE8haxVC-p6j5URPQ&oe=69A1A8FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "663620329211929", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75469629_663620332545262_4503774194542849788_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cti89607B4Q7kNvwG8r0Ju&_nc_oc=AdnkeJwWdvyzSK7Cs1MCZ_6DbApGfzWz9rBB1TaTfO9aGLYBs9BG1A5m079hH4m75R4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aft3grVXkPIfhufE_6MCbcqKGKHDrQDt_rOKcDQeH1wNKg&oe=69A1A785"}, "display_name": "Escape From Antarctica - ContentsDa Science Experiment", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743
": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499619113_1337791237574159_6288870819744868213_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TguF5zlU4zEQ7kNvwHY2Szx&_nc_oc=AdnRrZvrRS0BbJDkFhjJPRpbdGf-UPC2vDcpChR0GP_-zFPGtNIhla0BSedGdw0X3Uk&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfunE7smtSd3Qdwd-pSsf3ejj-Kd6NsgjqHew4lr5gYlPw&oe=69A19308"}, {"file_name": "ApplicationFrameHost_PhPFMvGX7q.png", "id": "1489887695965834", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499301549_1489887699299167_3492007752653712501_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH2BplmMidkQ7kNvwEH768Y&_nc_oc=AdnGHthslloaoV28uE6m5rZHWjKwDafNJhqSd_d0dLFPxNsePbI5ApJMzld9aGvU6sQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsQWM_IOTLi591XfaJ0E4d3uaxymtrCzBfkY2Li4N_orA&oe=69A1A1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Great Antarctic Expedition_Landscape.png", "id": "1790363314761789", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75221326_1790363318095122_220828785061119719_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qa8P_tnSA4Q7kNvwFRXz2A&_nc_oc=AdkkAcP8kHjnYJqR9Pldlj2YIKYFHqw01kHox5Q0e6tBzhjfV4_IUcgsCng0EcOAU7c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvM7iburriT9gPs_dN2YCeqFdFgAllrDNwDE2NFFyLUyw&oe=69A1A988"}, "display_name": "Great Antarctic Expedition - ContentsDa Science Experiment", "keywords": ["story", "antractic", "explore", "science", "contentsda"], "long_description": "1.Open the Antarctic Specimens toy, set the cover aside, and assemble the specimens into the cover in sequence.\n2.Build a boat to cross the ocean by following the green light to make a trash can with buckets and pans to clean up the trash in the ocean, then use the materials to build the boat.\n3.While crossing the ocean using the boat, build an igloo to avoid a snowstorm and travel to the Antarctic base.\n4.At the Antarctic Base, build a solar-powered cooker to cook environmentally friendly food and plant a national flag to protect Antarctica.\n5.At the Antarctic Point, you'll experience different time zones, see what it's like to be sprayed with ice from a light aircraft, and end your Antarctic adventure by seeing the Northern Lights.", "short_description": "Embark on a virtual expedition to Antarctica. Learn about the continent's unique ecosystem, climate, and the importance of its preservation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26364650373228563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75540507_699244312372864_884936410941995922_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih0eCg7zGd0Q7kNvwEbqLqV&_nc_oc=Adnkqam8FvFfymH6HYL29AJjjro9YNLmHMb_VbfO9M91oEVHGooMDg-giGe9wetQ4IE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu0rAdjf7rlDEqRQ_Waxb_nvbXNRu-qJdxrv2phceb0xA&oe=69A1935A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Great Antarctic Expedition - ContentsDa Science Experiment", "pla
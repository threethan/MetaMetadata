-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XInlGooE43YQ7kNvwHzrRNJ&_nc_oc=AdqusPzIJHsu5NlyBxIKENQtzC74fmFGH2YxOTsjgglnORX-tCwGd-V7KGhHvLBmzN0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IHEUGoQI8bo06WoXPDu7v0V_aGsua-MnbCZ1aOKAUMQ&oe=6A1AFE39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPRtEZWReDMQ7kNvwFyguno&_nc_oc=Adra2G0uUaptfSOQuTpQdar7wz2n82yQjxDtSHKHa2fGnIOrI8mEqk3gAH3L6Na0puI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hjszYwZ37YhKf1Uauz8ZB6p-NeT8fzAzIqwyzRnkGcg&oe=6A1AFD55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZPj_OL71gkQ7kNvwEke0Or&_nc_oc=AdrxFKuJV9GGLKtoB_T5wCTNuTPauK7hedA2kFiHIjJTkfAatPZ1wNduZZqX7CWzI3s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4prDqf2BBgxS0qXfRQga7--BoT2mjwzyVyPdZtOZXrug&oe=6A1AFBDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
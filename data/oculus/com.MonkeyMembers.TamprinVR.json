-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUThSzQj24EQ7kNvwEsi4mm&_nc_oc=AdqZ4EGCtQqpuuWXQQVGmDxhiNakw40wFTiLjqU8lAj1af0e0RZMPzPBS20yDz4P_F4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3GrhsGMM6sruJUY_cQTnBj4NeXxE1HXw0vc2AaIudZg&oe=6A4D1739"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJJF3d8HphoQ7kNvwGqqPHc&_nc_oc=AdpXSHOd6A5hcUYfV3rDLnvLzP6fV53zB2XS-oLPq3niCZRdKIjKrdR24alDaORM_c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNKM8Y9qr7UGapKn_qeiFFc7kHRegOxnbYq43ur7mAuw&oe=6A4D1655"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DPNF73A5jYQ7kNvwG5J8dD&_nc_oc=Adqs7_9CEsoDje0FudpE6NlHrpNgAgVNEICNr_cS3WrpbZ3mlrWywmTfS8XRU3HenM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGBgtSQdYvI8nS0BoQ916LC1Dt_NUI0IaM4C4aMoQdUg&oe=6A4D14DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uovVKG9c3u8Q7kNvwHL-PwO&_nc_oc=Adr98TViRp7Fb9fHRlz2ooxb9VqTmR9ppnK86hNThf2MkRWJrtBcS5GDXVm19rpu-dg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZBpFkdVckYV_LEAtjDRAm5nXAQYa_1zKpWPyVtDN6gw&oe=6A5651B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZWuFePwThUQ7kNvwG7qJ0u&_nc_oc=Adq78syg3QSu95SDJF_Kk9a7VX_sS_RSdmhaFstTC1NSM1yA7b1XxP-oFeEx1mGUyr8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_vFYajh4KTs3NBF-NKporFVjOdP9_gV1AdzqZbNOpvQ&oe=6A5650D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMZiE6o2c6QQ7kNvwHEMWzI&_nc_oc=AdoesYUzlZDCLDORwVkWYNE3w-7mo2UbjS9rjDQFwvnkJCnKkRxjqnwimvb6ue6m5Cg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJCssT4iUydPvkAfCn4-DeaXk-6Y3_Cr-sDS4Finu_uA&oe=6A564F5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
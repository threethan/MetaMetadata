-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jzlg48MdNEgQ7kNvwHfSzy8&_nc_oc=AdrzWvzAutfCez0DwJEPsDixNya0TYCNVn5hP717hp-MgFUxD2RHicLN-eDRJRWQ-ic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzUGSOuwtnpI5caC0C6T7fCCyrLvH3XiQNu7_PDT5G9A&oe=6AB14939"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4f4gN7sNzAQ7kNvwErmNx4&_nc_oc=AdovjQdla5-VgUA7COxJ5PbMWFhRVeHovtHryPeJCsqdrZiNA_Wraey_9CXMxpduXts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdkQZ_QxadiOArLUNe_pukQrz26uAtfNlwyrjiBvBbUw&oe=6AB14855"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8KhQt_C9SsQ7kNvwGouU6Y&_nc_oc=AdrLNNgtH6R9Y0xE8xJa770M6jqypp7WRM6uwLSo3EDjob06mwxkb0WfbReO0j4dlv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9l1jPYlvkHtq0p_ieRuNe6fn91O1_cto02_SBMsDj4A&oe=6AB146DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
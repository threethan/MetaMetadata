-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRvf7ZUp8mwQ7kNvwG-BfCe&_nc_oc=AdpB7Xiy1YkIEmC3KrQoSKN3sSgo7BiDuofrv5BZMKZkfV5-zrdSl5xUyluil3C1QwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69kXPwZZRtemDG3tmmc2UL1Cl-U-gOojJW03U8_rDROQ&oe=6A0B2C39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6kn1tlKA-kQ7kNvwGNpUXn&_nc_oc=Adpm0hKkkzjPnLWcgSBUaoQSq4hCFR6f9yUQ6q72_ahd-wTYjtZbykZ8GaLDNDOGNNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y_VimQyxYob6L_D6vyLeeawp7eNO_Pfblt-620399Kg&oe=6A0B2B55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srpSg9CkDUYQ7kNvwGEeCmE&_nc_oc=AdoGKJV1n6sYMsxw_KuQXSdMUousDQcl-7fFLaj-_2TAiWeViWPOARjSfNSdfHC1Kpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EnKsplLhtQNIQ7a58QRePG6xslsiTzzsVAt-iUv5wTg&oe=6A0B29DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
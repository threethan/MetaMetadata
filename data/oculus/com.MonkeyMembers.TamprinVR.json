-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHxyNiDpqVMQ7kNvwEq_JVX&_nc_oc=AdrgiIdLjibWs3e31zkoWyd3E0k1vutSFFBdF3vvBeZlpVffMa4Nw5ipc_ykOqygihc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CNsgZ3j9MChwdUwc4B6LL4e0cP59b6sLPHrPvfWJfZA&oe=69D8DAF9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGWemkf9OjEQ7kNvwHQpLFe&_nc_oc=AdqUFjH8twmEGdStv94KtbKiy_1GQUO8aVxmfQgd1ZYjo4HEtgM9JUAgbV8IE6bMP9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SbwjcqG2WEgXeWfqcYh7Wnng3mfqGZAZKJRHrNNxrUw&oe=69D8DA15"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-LOSvf3ZW0Q7kNvwFUnT76&_nc_oc=AdoAcVoKzwyy7mpxC7J2IyXv9Is6ewFQWqjnJVMcarp_6_zxLeIRMIlWWnULuJVcS14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39CtFdC5uzicK1zVlJNIgbqSoY064L-huVyub6-L7QUw&oe=69D910DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
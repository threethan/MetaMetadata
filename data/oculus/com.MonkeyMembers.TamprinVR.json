-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwWO-H58xx8Q7kNvwEPXVVY&_nc_oc=AdqQ-NHH04xSfB85RcfhipTn2-1WkCxxk8ZUvUEnQsD929PJa6fwRzF7n-ohx5JKwlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h76aOqfsZKB1TWoe8Aj6ynEcIZI5DS_YN1kKh1KwZOg&oe=6A01F1B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBlIfWOgGOMQ7kNvwG1auqj&_nc_oc=Ado48CrRu-Pi9NgH4i38VrD3bn0f6wOoVCQhBfQB88_R9SSTRfBwQf0rQtaIthVII8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7259PckS365AL2ZFGN5DIrOpcgq-ootSVcjR4GfgRunA&oe=6A01F0D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPH43L5eL8oQ7kNvwHwTcW-&_nc_oc=AdrHwp65u0Q8-u7wlQaYg5zG-Ixy7goQzSgtLQi0dCbI99AoeW_tVWaPCJLJBmgTaiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_HSePoODJPQjkSqGzoNICAHsAAcYjVC27hxKy27YmUw&oe=6A01EF5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
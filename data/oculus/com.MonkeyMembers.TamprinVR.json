-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJwg5Wm-HN8Q7kNvwFdIPrU&_nc_oc=Adrovb-UWqrJ7OV_vwVGzI77pCtDu2jOb-QIBZ6fbbgXrRTYsKau-jSAObKLfNewKeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BZewTrxFRjFNRewr04uqNygJIQ93WcJmJPJyoJIGzfA&oe=6A15B839"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kD5U3uB3iMQ7kNvwGHJdRE&_nc_oc=AdoRVw8N6h6TommbNDbrsZUqCFjCN1Kt_w5piImq1JTOK6oxwoQpOkIrig7Hx3156Eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AzFgtqARBXjyEBPJVzKAAnLdFba0yVjLzYwOz06hsiA&oe=6A15B755"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4SpV1q6D28Q7kNvwHVosUw&_nc_oc=AdoHMBilL4_iIu2O8vPOy7rcAPfy85yqPmgMlgWS--HjasuosNH3QQXNhm0msymI6As&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6coKDRysg36beBRTkeHjZT5Y2oUs2UegRnOfzQ8K3Jdg&oe=6A15B5DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
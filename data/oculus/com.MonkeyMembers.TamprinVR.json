-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6mTY6VbPE0Q7kNvwGoNBW0&_nc_oc=AdrpDY_vImmVOBrKZtlAer1pZKSoabVg-AZPM-b72SxXY17XkkaYrVMsQTh8MaQRNPg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoVp0Kkk3jpiUQEqJOWEMTQpNx-srawHKwB4erKiJ2zA&oe=6A5A4639"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcQq6PuDuZYQ7kNvwFjkCzw&_nc_oc=Adp7p4ZsQ7nHIK_3UolSIwUCDw0wQD_01CexMRRIsZ4_eOrvh_1WIPi3TCAXjtTxR9I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV1DYGeljeMMM7N-edjVRceqFCCewGq0zzcr9NlROxFw&oe=6A5A4555"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwbPfMWeAU0Q7kNvwGHGL6X&_nc_oc=Adrqae75dyyRpIeUBXtMNYcgOSYrQ4ohFunln71U3L4zwAmClE3HxS77jQDx_Nn10sQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0umiHiD9F_RyekHZf5cqjPWjGvsuMTTUyYoXFZ4-40g&oe=6A5A43DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
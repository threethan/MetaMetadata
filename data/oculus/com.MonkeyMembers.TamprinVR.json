-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXdceawrGx4Q7kNvwFHJB9a&_nc_oc=AdpdaEbd5FQaqM9c9YnvJSJN_7wN4wCNvN-X_li6WFicXvi0b1pbQoZTXJRYyiECmhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs8giYSvb1UGKBu3G2xMgD5eemM4MrK1__dA99PLsklg&oe=6A6DD479"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j16yaXLjLoMQ7kNvwGTmI_A&_nc_oc=AdqI7VcIUEXsxTRr1Vjp566uYhZZymFpctouXcjr4rt6emvebF7-35erS_joi4Rqz2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWE4YM-PQ-Ju1koNTS6EhK4eCG_m6ZElZPZnzx1CHBmA&oe=6A6DD395"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTyngytSjvAQ7kNvwGKJmAE&_nc_oc=AdpPawyhMJkIJmvOMwJZVcvQmKJsPRtRrESMsJzlJEZunxBWN-f4nZKZ8WkzplwI530&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASvpeC6xeXce4xq_aHwY0FamH5P0mdEPxbYOhguxJedQ&oe=6A6DD21B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
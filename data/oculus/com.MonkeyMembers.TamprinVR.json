-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KywONCTp54Q7kNvwGcDECA&_nc_oc=AdqhOYwQbswOIYPn0gEa52MC7j0D58YVRJrYVgSgMmpaBdc2RsYvpGgdOgeAZ1A_5x0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeoqPhNBQZHiK5rHU6ye9QDN1sU2ACvjbn7wVCdodsww&oe=6A74A439"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfbrpU4JFewQ7kNvwHvck0Q&_nc_oc=AdoMc4msqlkf0vgbEMVA6DfNJ-tFH9qTrfvUB9ogzLl80vEKbY29E3X5tvL3bYe1mvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRnVLHLTQjAK_s4KGv1VL0DrgN0v8E0hdd7YUNvrPwUg&oe=6A74A355"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcOHknZsg7cQ7kNvwHlX0_f&_nc_oc=AdpJICpZuQkrzYwr8BbN4k0P8Vk6fb1S-kM77jJZZgpM_qrwtbosZTF5NVPlkvwPrkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSq_oRia4yVQYYkTUqZngI-sZJIDP-WPV2sgBP0i1i0Q&oe=6A74A1DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL4erRH3WpkQ7kNvwGC2PkS&_nc_oc=AdqZLqLJefQB-TtMLlAweRSuwjO0uF1T-Y2uabOEuHRxiLaS1tOCxRzPsADIhI88kJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yVBaS9d7t6pUqX4XuCPQlVqTX67GbBaawD3D6Zsx4CA&oe=69E8ACF9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8zUfJ2L6s8Q7kNvwFHzHth&_nc_oc=Adqgg4MvtFNNNMX9KsNpo2_oBiMBhnyNDCfOhByN48vwULK56si55F0m1Rk_rGfU-60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zg4UpH4FV_BNExLvKqmhYovQAxqfRK0TLNIXFu8Ugiw&oe=69E8AC15"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLFvfCTEUIsQ7kNvwFW9BXn&_nc_oc=Adr1RzuriQaqPd1NJciARE4bqSGilDonwMZdPdMVE1kjH3Vr8Q-ueuxneWuywnah_TM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af212ng95KHpHGVURKNG08O5Ms4NhntjrFI807aAljBXMg&oe=69E8AA9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQtfG7ob_9QQ7kNvwEA1UOs&_nc_oc=AdoCi1XgZJr-M1d3hvxmC_vK16ntgzhBBdrku6zXs3_RZPkzENV2xubNYZu5GvKIkgE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsQklZzQewYhUQOJDi2W3IRnxrrHEux6Oopmh1nwcvcA&oe=6A916CF9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsiqHkOEYMgQ7kNvwHWpRp7&_nc_oc=AdpjvwlxptJtmaYufCTkH_n3GbPw5NIyQDiLm-eMTq9QOyUuH5BGgs8AbIvYYXdEjlE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRhEKZRg5ekFPYScJHIBLWEQwljGq4e5Wak1KFmC3VSw&oe=6A916C15"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUwRqCToCcIQ7kNvwHHWxbC&_nc_oc=Adp0pxLPEbRHvmL2y-MHo96UwrRBUSHA_ByRbpLluAm-OSsx1MuqqqKM_zQ-Tkcycng&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnzXpw9rbCgrPNQV6iQlGB85sBzaQFCxoNJ-2AfpVjsQ&oe=6A916A9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
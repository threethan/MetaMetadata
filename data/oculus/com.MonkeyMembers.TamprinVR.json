-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqqPCoSjY7oQ7kNvwEyFaOa&_nc_oc=Adr9t9r9E71oSs4sj0wdqNV0owpvy0DmqowDjNrzDWporr4jr41vCvS5rw-gjBKclyA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObR6V6om1_f_1X6ewddhzFNQDLJg2UP3bgl82RcR-Dhg&oe=6AD0ED39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYIDExiJmLQQ7kNvwEyC77u&_nc_oc=Adqs4KJ9LSHnkqgoCofWgMidHCY-ne4Pg9yjaT9Q3P8Fq7ZBBsP_Kpr3KNKRRlEBw28&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUctKyOog-e0fy6uG88f7-4jf-QozJLu1eUml67YRTCw&oe=6AD0EC55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQgcWwiKeGcQ7kNvwH2i5Mu&_nc_oc=Ador36vg6-T9nWYZC3xNFojJBZX7iUDxVH27DvX4shu9VkvpsdwTqrUclNUn8vsyro8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIkg3mJBtzdwx6Isiyx80ylqVco_53hu5WtsbuvhBDMQ&oe=6AD0EADB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XInlGooE43YQ7kNvwHHJqAL&_nc_oc=Adoa6tb3zy9O46j2I2wR22V0PP4LJ2MsYCrkmebwKTUNBAlY2JjHqi9bFAHRHZcKAWs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bxamnNrGEhIPjWCh4yD0dQPU2p3OIWi2PRpBrHkC84w&oe=6A1C4FB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOBeVztPrX0Q7kNvwGWsIHe&_nc_oc=AdokAvo7DGJFQKMFNBBD1PyAib5XDzD-73ZuiVNgUmeEfbLayI5xw-E5YyCERYRcPMk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s49vXxtnkOyiN_i4ligOooeFD-gCcJ2m3UvdB_-fm3w&oe=6A1C4ED5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZPj_OL71gkQ7kNvwF3Qht8&_nc_oc=Adopsgyl8RXUhPPsW8dE82oVQ63j-v_rBHeGwGtbXToME5wRtNCiINevkGC9ucrshr8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dkz8BG_UwJyZx8I9JchyGVICTVKIhnIOIggJgYzlH4g&oe=6A1C4D5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
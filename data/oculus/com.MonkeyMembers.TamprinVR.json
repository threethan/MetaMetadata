-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRvf7ZUp8mwQ7kNvwEJi1IB&_nc_oc=Adrk9aLut8GLpaxL1fg_okrCkLYUA3q7BFNAbGyQg549DM3IQFupX94p9pj3YHgjscc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SF6mQUrqAJNK_-Q-QKHkF00GmXQ5F6l3eLxt9bsDRfA&oe=6A0DCF39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n8wcolQVbIQ7kNvwHS19Zi&_nc_oc=AdotsGFGoJxPAtVfN624cbgW4jC3Hmh2V6xWEmRN3DqfZce97FtQv2ZL-jp26m7QS6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vC7DOFabgsxPdnlf153p2fU9SEO8LG8mELgc5D4YuzA&oe=6A0DCE55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srpSg9CkDUYQ7kNvwG9r4hd&_nc_oc=Ado97ewz4xr3FlkBWI-iq5FycDKyHJJYuD_gVO3N6FuSVOAbXDsU3SLQGmZTeuLTtnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F9pFvqb42CqBkvzoCUefN0BmXF4z3hZjK26gUU60VsQ&oe=6A0DCCDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
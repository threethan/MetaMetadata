-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOsKWMwRnysQ7kNvwEIoKz-&_nc_oc=AdoRYYV03zhPSdbm4T3a6sNXX4I34NVQlK9bLCDxsFQjUbDohJH6PV7OqmjzDmN8ems&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC7oTjc2_AeByyAUPdAyjGEgjwlsjxLlv4FatZPSLWlg&oe=6ABE7839"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cawRtVWWWVEQ7kNvwEKqHci&_nc_oc=Adrn_aQov_QZgyN1AOMvat-lYrIbnDQpfsjLpxvDylN-I6-BPqJrThKhqNtcIZpqy4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW-pffaGxCjeb-sUEv_UHfWQ3rxw3xz-l9U3ByhfgWUQ&oe=6ABE7755"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syT3ZPL5hvwQ7kNvwGq-thg&_nc_oc=AdrIx8nG_lKYABoeVfJqD1iDnv0Ey3QM1jGjmcaL9WrCTmu7ggJii2k55CcXt_xQJiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzQoa71KsmculH8caitwYQYG5tsAw1jOps5XwkAN3HrA&oe=6ABE75DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f4oDVEYp0cQ7kNvwEM8qZ9&_nc_oc=AdqqtUShYbSDIhe80q7CUpyTGCLcHjAKzjiNdMIvZBh5Wb-3Hce_muZFnNI-RjJ7PFw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aeWXsfyOml4Yy5U_nbeWulG7nCshc2KeeCCdYYwem-Q&oe=6A107239"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAFM7lDDFhgQ7kNvwHGYZUj&_nc_oc=AdqhJn_m5BBQ0sJKssxQ5554RirrQ_8DeXG7foLMkOS0eDIF8s-dnIFf-PTE2JxM344&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r_hR_mhCG2L0-h5kdSQ4vUuQdinI0-6dBkLe31BvuQA&oe=6A107155"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdUQnKa_gOYQ7kNvwFqhYef&_nc_oc=AdqzLtvZkqIq9yCIstRocn970La_qHYU4-huDQsiGTY3cEWeqrufCMDGcH9nR6rvDH0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ecPNsru4ayGFCpfJcdohizYyjZISizuwVuCUYCoFShA&oe=6A106FDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
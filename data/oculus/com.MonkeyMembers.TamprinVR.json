72_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWK67MPVIxEQ7kNvwE2HocM&_nc_oc=AdmMAyecFMzuWP4fLZ7oLqok4JgVHsDDA0X--u7org9XPjDf_CVl0j1V4dvO1A57iKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwgpSc5J8Pc3kK5Z2PbBjeCxE3-QMlZjyS963Wjy0qZw&oe=69A6C1F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ekt_qUmNeSEQ7kNvwHpnjQP&_nc_oc=AdmQxA3iJEjSP4T96vAjsZ8sA6nIUMLg5GuNL2h9d-dQ4tdpthRcDWJjzBkNyLlHw14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtNTLnCGCjW4NzdS-kx_QNeONWb7kWDhmBHeBeGVCs2g&oe=69A6C115"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLquUoVdNgcQ7kNvwEiCGjU&_nc_oc=AdnFV7Tz0CDDS08j3t2GKSSLDafgbtL0ApEmNNA297zh20K5fTGwSpkCcR3_VwnANoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftB3-g13KwAov7zqysIWgYABjMeJale0S_aROG_KY3XJA&oe=69A6BF9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description": "Hey you!  Do you like small Gorilla Tag fan games or communities? Well come join Scary Monkey Game VR! Its a small but awesome community! So don't be shy.... BE A MONKEY!"}]}, "developer_name": "MonkeyMembers", "developer_privacy_policy_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MonkeyMembers", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9975161552524873"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001654_1370269376863040_3022169743682869403_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIcwkvanliwQ7kNvwHfHodF&_nc_oc=Admq1x-UpuAQiE3IKYXswSWy3L-U_I8dlONQwxGt8Xo5vvgRGHDjIG_3j50a0ARoXvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssgzJLdij4MaV7BPDnS0YqfaVCzVc7v3cRwLb2p5SztA&oe=69A6C11F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary Monke Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1692035781, "lastRevision": {"nodes": [{"id": "9471022736272093", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9471022676272099", "is_first_party": 
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-cQAzy0KSoQ7kNvwF8ynjT&_nc_oc=AdqfR6ey9GIGKmtAi1cPQ9gRzhFcKGuve6Dvp2cr6f4IPUgfixtB08LOx2Hih2PuqTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuwG8jnmwA0ZHOyzVDRdtOgceaMoG4Xwmc_EsSpKTTHQ&oe=69CE4EF9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygFE0DE6xnsQ7kNvwEo39g0&_nc_oc=AdqDOxal_XgpyVvY7-y0SfuFoPgR5kntgSURBBR8zYeXjVBNn5LHyFj6HljkYO0RRwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoaZsBx_2Z9d2b9ni2CRv8Y7DQF_-hWWxs0epZQcqpiQ&oe=69CE4E15"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJuzMLzBgnEQ7kNvwFwhX1j&_nc_oc=Adr402ZWK9_0uNjCACRoTK8S5xF21HwXv_MOF1pyHRnmbU0NyGDdt_W_xSKy4rvUao0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAsZCYx2xLmclchTplQsnVmkrDaB4-xItH3OEEYvcpcQ&oe=69CE4C9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXdceawrGx4Q7kNvwHWpTBd&_nc_oc=AdrEwGalquT--p7k_zZ-njA8t084TluqB6W-WzfEpgvdcPeHZiODINkdI2xjUCwpwgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLtoZqqRHmZspL1yDQ7_8VwimhJEomnGCMF6czYyQbsg&oe=6A6F25F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCoz4sSjJOMQ7kNvwHuwoyQ&_nc_oc=AdrHWjEIZbSA-rLxd8SFCtVhgyX88CG_WRNNNhmhZOiUELF9oRB-1fa8dO6DtFyT5dg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXId6xqICIhage56LNDTXf8q1Ki-Wc8USUWaxfk8z2Dg&oe=6A6F5D55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTyngytSjvAQ7kNvwG8WjLD&_nc_oc=AdrUVXX0jVLRVWG8nrAjARHqd_C44mcqtmM1uPjAuxw0NYqmG6YJ2ZpnlOaQGfmubEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDczYlYJEGW8Ad5q5eby1zQgOp0gDJh4fXRKtGDaEc2uw&oe=6A6F5BDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I23BH2VD7kQ7kNvwHoTzm8&_nc_oc=Adqi4lG5cWRIJnb6BPCRGrQ4dTsw4zCk_hb0Rx4orDzBSg-mt5vUY0oxXOm2A2HYgao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6VHdnjJWNsSanIZBlL4fyEwH3J4t664Rr1rg4nMr5DA&oe=6AF485B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMFcPHvrFhAQ7kNvwHJ7ev0&_nc_oc=AdrUIUY6a9aZDdfjVffS31M0pGxcH-pnbZdK1Dgk5RidLABLumm2OepzwgQNI_RHz8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNiN6l2cKykE2tpeX4h4wI0hT9AiPmOBX31DtjfUIRMg&oe=6AF484D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRT7J52vRvIQ7kNvwEt_BrY&_nc_oc=AdrrnB4oInvnk9c1vjXkJqY6M-6ncqNrAap4SuHnzxH-cjubxYVxEkWpq0kEvKqhO9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQDGrD1WQbr0MlbCUu7XKuYAxnRT4GIA0HAk4sewq0SQ&oe=6AF4835B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rhNSZp69RUQ7kNvwFeJMmR&_nc_oc=AdomZJo985kLYO1zVWRRYnNV4cKXO0zwVnxIAEUci0lKleqi599TEeq-VFoVKyU6DSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A65yNrbSKbgpJyWm_ar5q3SUcWiYFiIxcdhLcX0Ar5Q&oe=6A3AA239"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts_oyTGV8B0Q7kNvwFrfkiR&_nc_oc=Adqi-6pfDT4BpEk-rnx91hw9IVOiGXJbfVqXr_-KxT6uwAvD0ISkjsRHt-ZUEtwvJPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZCmvVIPZBcF8-Lhe4Q98HBHDp3_cXYS1wvjz-AE1XOQ&oe=6A3AA155"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmJyUR1ZEIcQ7kNvwElbLxl&_nc_oc=AdoTu7iNJO_8l0VlClv74zhvm6c179yjkxgwMhOp2crdrB8MFtzWvn9TcEifrtgfL-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ma4GaIl0UTKbvhhRQ9w22-fOMGcEohsEEk2mONCGtMA&oe=6A3A9FDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
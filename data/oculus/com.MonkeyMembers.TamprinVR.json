-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XnKANNjY7oQ7kNvwFvL87Z&_nc_oc=AdpEgZWITWELm74pYRQZ3h0fBPfFXKtmiUCemOFUIddErVWa9XOW6r4AjvO6f4zhWfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBT3sDe41gIHIEADwSbZnQCSAOuugThPHswGqAZWY9Vg&oe=6A79B1F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1LmMp6XByYQ7kNvwEk9qHy&_nc_oc=Adpan5buGMXwK5skiMTA3WzDsTHq3AODa_J1vW3hFQxwwbYq7sG8O7uY_7m63K7ypXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-sNNvg3Dw8gI_LTDWv9RIqbcChc77tLuV-idGx5BEUg&oe=6A79B115"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udNMqXP8NqYQ7kNvwHQysyv&_nc_oc=AdpsUmpjpntvE8jgKLoX2UdXs7XebIN45ILtBiIBFhp6MAQZKzsl_GSlt7h33ljDRGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh995MFk7i8JrANLzbKsBJDMQENXacBD3i6lLUru1OOQ&oe=6A79E7DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b7Sa7VTsesQ7kNvwEK4VOf&_nc_oc=AdotBNxKkCdNTaVJxnxnoDVlVsMYfR3IzD2m995zxaA0HjpXFZeq6Z4drWgBhF-sf_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N85uS28MfBEFj5er7a9m_0P62BBE0imMgrXMs5pgcAA&oe=6A3167B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKvPcaCCbRkQ7kNvwFi4xAE&_nc_oc=Adp45A0oo6u9hZ7c_sI_uajeVxhDYwT4_U7LMLhlmMAJqrIZ-iUDAGXkzFHxQOg1mzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9elnC5vigCCsrZycUIxo8es71qtAK8x2ExEsUypdwGGQ&oe=6A3166D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vKzGs0OPD8Q7kNvwEHsMIp&_nc_oc=AdqbGFBEh38dvM_2as_LV_N3wTaMqgyUteJNL27i_6Ab5k1X2uiIyc4UVHNY545hA-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9roeq_Hm0Ms3BGS6LxtBVMiON3OZriLZ_-hFc42A3MSw&oe=6A31655B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
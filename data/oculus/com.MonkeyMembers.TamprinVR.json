-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow2yEsAbk3kQ7kNvwFERu-8&_nc_oc=AdrCrf3U6-epkhGkX6E7iYwgi-l206lC3VttZSLl81Sfaikm5A-ssduKmqXc1sE7fks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tj0xWyohKqVacvRet5a2kseZJYEdIPQQw3zYmkSo1ug&oe=69FB5A39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtwCFl_wU2kQ7kNvwEDdT8a&_nc_oc=Adrmll2fT2p9kj0brKpdJEbxpmdeNgzGfBTvJRabWQD2PdhNnyuna2sL_qFaX1mUuL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61cQwkgjOj31OKRkUjVyrEKiwkLRfSV3XN8sKqyyS6rQ&oe=69FB5955"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oevDugcQqTgQ7kNvwH25ubz&_nc_oc=AdorFGoedtOfk0Xeo_22Sy1c8H34nVOYSvfy8hNdWnjI9cgOmMP4a6wx1vsZAVPjKNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VakgFlBjypuybdzd-KRosFwaev4Q-KiAUjVIDxF3tTA&oe=69FB57DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prHimQlPR-UQ7kNvwFAJesE&_nc_oc=AdrSz7H3JPKmOraed4H6_XBoJw7R9qnomva84ZAGr5IeGaGtNDUkOWPs6zAZZmp0LHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPVnx7Dcc5FxH_ZUl_fEnDjC8ENm3lHCx7fM9NOm9MqQ&oe=6A510BB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT7LeMjthNkQ7kNvwFP6Mxd&_nc_oc=AdrjZfndHQU42D64N9ruGa2g08aRDHDfCBiKg_IlpKV-lJbDATFsBkT_JLcTv_so8Vs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6-LOqFB4j4OcBJHV92gwbH1y5oSEbLpWvBsjH_E1tdg&oe=6A510AD5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cki6iZQjzvkQ7kNvwHjShnZ&_nc_oc=AdomYBg4fJrGQXwNrFpHD6en6UtpE4vm6Wzb5yPWQItQ9wSbCBXthRaIs82aC02QcIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS1q-IoNYGIUrsgIgCLuESMiWAuZ3LyRE65bump0E6QA&oe=6A51095B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGuiLpMPqQwQ7kNvwEx6bsE&_nc_oc=AdoC8aj5ggXOf1DHtZf2qpLuGxGGU_Cw88PCNaILujk-xFxfRtiRgskejg9gB8e7uCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ui2X6QXkru1PRrESp28axyqJTbRcZPhPyy4vg7hScpw&oe=69D637F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WavN1beEFsQ7kNvwFfj2tL&_nc_oc=AdroiIwv9J_zCXVuackBrJ0xuxBjYzOglX2emr0UlrfjrUZM2489jMXqZ5Ojn8VJmJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dewCjvP1psTCS7o68vxquNxbAU2SRwXszG8UA2Qda6A&oe=69D63715"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9fRQ5yrr9sQ7kNvwHpmw21&_nc_oc=AdpJtNHv2TygJrUKSc6iKEm2-SN_QoTJf0YX0nd2AMGvkxDipCUPG7xIeNi_sMCrG3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af379KDE-kvuVUzZyOqS02gDcqFZwQpDv8aC5Lqz-iP04w&oe=69D6359B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
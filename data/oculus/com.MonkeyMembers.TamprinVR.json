-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGuiLpMPqQwQ7kNvwF7Cx9c&_nc_oc=Adqs0-WMGOKHotYhxr6kDsJv98wY3q0nV7_TopDKq4FDF2fVO8f9lq3GJtOFK5b4keY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BCSLV5UikFQrq8HiFQf9ibTsIOzVoENBALFluxxqJaw&oe=69D394F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRr9jgJb4OwQ7kNvwECBYts&_nc_oc=Adr8STRApt27H6J-aU-ac7RCwXy3hscREghA_VKEFV1BE-Sf4RcpzHs_YDB5T89mAs4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-MI2o5RJtiSuv8Ddydo4btYS0yHRvRazz8CyxwP5U6w&oe=69D39415"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9fRQ5yrr9sQ7kNvwHkncTI&_nc_oc=Adp84IPDWSriL_GsNAJ88G-QuGUBcZEtbEdGQoXsejCWYr-n5Qs-dKoxcO62ip9oTSg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28Rhe1u8zsOrG7wF1nm7htQ6IjPPArl_S_MoDd8EOxaw&oe=69D3929B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
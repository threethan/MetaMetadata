-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f23yBuWsRsQ7kNvwFdMc5U&_nc_oc=AdqumADYRuTO6W19iXcW8ignNxVW_vfqEH6jyF-R81EuwoLYJvqfKFRQ4SzKuQycH08&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af063AEYGC9BUbTWEoiLsIPgTYKCGTupwI8YUbkUZaYtfg&oe=69F8B739"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtwCFl_wU2kQ7kNvwHS--o7&_nc_oc=AdpbOnXxW1NvuApfqrFJSoOeUcWzE2AnGV8LNYHWfc6KbjEDxbpIqchNVhGLYU5Egsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wEAUiv0LwP9ToN0GddaU941zc5OAFYltNPaEltHEV6g&oe=69F8B655"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ojN5QDChnAQ7kNvwF9nyro&_nc_oc=AdrBCUAa5AHP8On2EkZ0rdKkqw7afl3Sr8rg747TasM_w0C_eAAj85aGWJyJN8C4YdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0V698BWCrSmTWi_EXlRrrpKmAfqCKtPcHDoyUbFxzXbQ&oe=69F8B4DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
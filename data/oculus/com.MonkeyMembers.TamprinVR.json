-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f4oDVEYp0cQ7kNvwFPmY1Z&_nc_oc=Adq6AJTZbkbtqVZ2bvM8yTH63Ekb5GrTJU1xXw8BPr6zV5ACQ2I5iy_S4AdEzsht2d8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BfNPgdObOEfh-ab0GkV85M8dB1o99TCryCd2C1J6b5g&oe=6A0F20B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n8wcolQVbIQ7kNvwGxE1Wf&_nc_oc=Adr2HV6dA1XRwbUK3hnlsLyHmkyTcK2qBebRKZuGZMs8BAl2YzVr64tD8uqSP8yfn98&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fc9mH_tWkWr4AFtcHsiNxfxe5aovTvwC2kiw_Dbhvww&oe=6A0F1FD5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdUQnKa_gOYQ7kNvwHsUHMj&_nc_oc=Ado35ku_ZP_aFzDLvSVfdP5qE0vavd_M9HYQ2JqgFfcTlXmM_mtF6BVw4oIUDjeAcHU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TTeKS6o6c9c2lKqClg8SvMsrFAgV55ep7jw1gzyqabg&oe=6A0F1E5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
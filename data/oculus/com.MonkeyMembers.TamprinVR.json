-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6TDOmFjrUQ7kNvwFTjiyM&_nc_oc=Adq4KmNMq_f9V66A1Qa2wASa7kfkpdiYwvVNkzdYDm2tcP3PY52lvzsCjP0P_lmUzD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2JJ_KTRGRlRj0dyALSdoZYm6qONpyP5Cv62EC4tN5lA&oe=6AEF3FB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXpd918uef4Q7kNvwGmMuWs&_nc_oc=AdpumIEfoGduKUzvsw9EzOhpPUtwdHWQ9eNxLH4BK3CD8SbGJEKH_UJQeTJ3kAgx97A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYIGqqAmHBcZfBIiTPLlZk8sHAyAwUOkm04fHvQWhGQw&oe=6AEF3ED5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vn8R0wUDGZ4Q7kNvwFLfGA3&_nc_oc=Adr_8u48NH_VhSg8QVe6_NcWrXXkdEod1mZZfu82zcGtKchrsQvecwt1kY8QYajH9g4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQexOSKI8MQfJ_7oRd8NXQjAjD2Z0dtGWtL4mkR-7C0ew&oe=6AEF3D5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
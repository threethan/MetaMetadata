-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBR168GOxF4Q7kNvwGTkQx3&_nc_oc=AdrWcbt9AHn0oD2nhCd0olaTJJDayNI3ofoQdWkw5qK2xJ9-up3RhH1lc8lK4iqbAlY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Wi2JFciwKcDlTd8UEbYG28UfvotUpizLshD3f8x7GA&oe=6A9ADFB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ONk-mbdHNAQ7kNvwGEAkfF&_nc_oc=AdraXKNi7AcgYriIuKIGEfYfECFBy0SbKDF_oDiiwWflAaYrpyASq9Z7t_FlVujQGT0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9DImrCyKJU7NbYo8znefUw3mLr89HkzQ-atbuReRI2A&oe=6A9ADED5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2ndFlDhxOcQ7kNvwEZ3g1X&_nc_oc=AdoN_w07oNesOHHJrnoDP1F4Ia1h3GO0qKGrkbzwoSeklj2Syh-i7DTYnD83biHjWME&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy40tc5Mil1x4gIVlrWFdd2sRflhof2zB5pJ-gLTJcpg&oe=6A9ADD5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
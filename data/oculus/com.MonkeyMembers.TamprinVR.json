-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOwT0A_mtXYQ7kNvwEfHWyE&_nc_oc=Adqs4zz3bN1gW70sP6d7W6e1hVw5HfaD1HzzzEuFuO5nHbjku3NVyWaFSviJRjeapug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmstSKkfUE8BKdFMnToH7zus7HiiedV9LtP9hHlAPIGA&oe=6AB68F39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIzMsvHJxO0Q7kNvwGWaQWd&_nc_oc=Adq3hNLdJ0SF1N2wty4PoYGGB3H6NZ2TUan2ju_hUwsORJSdqsnlKr9G_hZGqSxU-Oo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIqjSyftiWSCzJTceGaEc2PnfhrChLM4QXOndmejViKA&oe=6AB68E55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67Nk0i3XDIsQ7kNvwHBIpkQ&_nc_oc=AdqDWdO-2l03FpmL5_JIiB44NCkaCBl0e_6__U6qfhW_cmLiYCAAVjESwaCXVCeK4H4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBSxyMFdFHV-ROndYApWTsvwxSvFp7rsoDWRFzTNtsdQ&oe=6AB68CDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-LZ-_JT4FwQ7kNvwFRHGB3&_nc_oc=AdoMc8Yd5xmQReCIZskel5sfMD0jfy10emZDPSoH-ugyfdcw24hjS3KxQoPZA66HTo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpj9vHHuNOXTOPOHcLvVNbxGCmXXDH-CtG_wcglvBnvg&oe=6B06F9D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj-nSdJ1U-MQ7kNvwEpSLx6&_nc_oc=Adrc4FKzD-0WMlLyGNEXdnFZ6gnZ2zbpws4_TQj9ggjNAnCF4NDeF6xVcbHDKeBM3Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOA3ZfJInMAfe2tvCpPMwfsSaHe2oZgOjAQYeyFJr3oQ&oe=6B06F85B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin's", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....TAMRIN? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description": "Hey you!  Do you like small Gorilla Tag fan games or communities? Well come join Tamarin's VR! Its a small but awesome community! So dont be shy.... BE A TAMARIN!"}]}, "developer_name": "MonkeyMembers", "developer_privacy_policy_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MonkeyMembers", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "c
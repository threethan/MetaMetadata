-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkGL94g9xiwQ7kNvwEs5VOU&_nc_oc=AdoQJQ2QyJetWbgLDRGIJI5kJ16M9WoZ_8ID1gBfrcrxbslSEmC3lE5mYWggtR8dbGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNArtL7rh-JLdkMZXGOKiP8gFMpfC1sgKv0V3GO7wiGZA&oe=6AC11B39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cawRtVWWWVEQ7kNvwFvj1dJ&_nc_oc=AdoNvfdx16Pi7OzwC8zv5IA1LW5rVdd9M-u85qBwCKZly1yhy1Jt00gtCP4cvjLgKrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgM5roF5NzcnAvQbQ3EWF8skjb_dUjphPLJgvHLrGpvw&oe=6AC11A55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVifkvRo0JMQ7kNvwE5_ZTX&_nc_oc=AdqKo4UGNaERFrn1Qiv8JcGgBmFAhRhkvMiDniQyJhHRv5cFHW-8ZjiwrhfDB6E7LZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzcQReUT12ntU3Lnz-Bh80vDv8KH0rUvfMD5PgxWTJ8Q&oe=6AC118DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
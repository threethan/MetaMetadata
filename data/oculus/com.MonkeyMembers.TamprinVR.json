-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zfqjjJ8vHkQ7kNvwHY_xer&_nc_oc=AdpdBJ7PqxFtcw_VvGcp5NGODhMhhUUNW9U6e8H-oWEtQLLmA9WOQ_ceBVe3ZtEVA4U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-PHUYXWvrFG8d49Q1gUxnLRBGC7T9RL7POxFvpSBxGg&oe=6AC50FB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYB8BxEH4awQ7kNvwF1pZ0j&_nc_oc=AdrxMREBjt_WDk86-0cG8SLHhmXmMQgtV3AVbeorKikePY4Ty4iJJ-BNPDDErN8urT4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLuWj8jAPQNnbd_TygAOvZQ2siSnrJILtF8EnNDJ8BRA&oe=6AC50ED5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZECv1z0_-1EQ7kNvwEJDfLo&_nc_oc=AdoPjvkCyEKWr6Iaay3syOIzlD0SmvFbiTz306i3k01XUWdMAFfWop74DyctHwjhs5Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfMigNC50rU4rmZliw654MlQXT4meDC3aAr3GWdUidHg&oe=6AC50D5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnjLoMrKXg8Q7kNvwF8aiwD&_nc_oc=AdrOTOwZw9S3mllEnOR8PtVZ245KJYhFZ_H9BkOPKNfpDES73nLSdZAWDW1BuB0ouyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvKmzyPkDqs7JmgfkMCeXSc6TO5aK5F-4mxn4x_J9glA&oe=6AF09139"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXpd918uef4Q7kNvwFd0bA_&_nc_oc=AdqlU_46IiyaqlXoe1sgc5s7Anh7XhFd23BDUlpry21pyzG31Whu_M6eoKV1qlZLg6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1rIlGCOTkMRSJJIv3rbOLZU9cQu9zTXcMs6fYjZ49DQ&oe=6AF09055"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spV2fxEzH0kQ7kNvwGcThhC&_nc_oc=AdoJoT3289i7eJIjvQJVwaY0s-lqY5t-DAZGS3UcaFFSN0VbroB2pxpTyU_k6Oinbv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR95CL4RdMp83eFEsD6GCgrZSrfeBy7B2-22TeWqFHaUQ&oe=6AF08EDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
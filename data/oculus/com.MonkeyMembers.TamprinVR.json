-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqHzIiPbtN0Q7kNvwEnq_ow&_nc_oc=Adp324QL5Ie9PJnth5msnKOeC7fu5zqE93MdekC2Ru0X5qSebg0ufYxd6wV1FPZiSkU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cI08QbmY43QBZD5SaoD_JuSbppnpCX7RBE5ATUsKj6Q&oe=69F37139"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoSZ20_8Ag8Q7kNvwHyKW1Q&_nc_oc=AdrQ6nap3LzBbXe52ugq9dAY3FttiR1appnIsPUP8LgperpMicZ98UhBJwm35PTyuqQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iXFBXNLFOM6dIKgtngyGK4BB8wK1rwH6BdWcaABdFaQ&oe=69F37055"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f015I_6zHMQ7kNvwGAvIOr&_nc_oc=AdotsPyBxPj8x8-3mvDVp2GnLh6hKETtkjDEceO8DtP9ISRqIkpvWYunrmB8qjn3RWo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1y1Ac-SwFpGg9foP7yLdF6kf8svOiqGs4MRYGW9koTCg&oe=69F36EDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBR168GOxF4Q7kNvwGNmlCf&_nc_oc=AdpHJoJ7FCouO-Ebts__k3ehSfJRgW1O_AYsnRSAKSz6Gbt79kBitGYEojjl_vSeDe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfmAUFXO8n4ZY_qIjI2wvA6Rufhqz-BqexOqLUHUQi3A&oe=6A9C3139"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ONk-mbdHNAQ7kNvwGas7bK&_nc_oc=AdqIf-adisy5NnHm0trln4HNv2o8wi9MyabpaF_9zAmOndmv80TpaBKo1JniXBWrIpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEg4mX9mEPDvt0gtUOpMXOpo2YbNjkcY5N0jnIeI9U0Q&oe=6A9C3055"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2ndFlDhxOcQ7kNvwG32qwM&_nc_oc=Adr8f4144gQuZJzkKsA9VS6saGlJPV-9_o6J9Fu_tIEJNfdekyqeU4n0L9uu5xh6eXE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvYgPblLIhvooHL_21Gdfp-vP0CY8Le16b5BGoSfN4MA&oe=6A9C2EDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
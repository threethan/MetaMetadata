-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lonx57kd8QMQ7kNvwEhh8OG&_nc_oc=AdpOAjJ8BrT0FCLoYKqtbHqmp7amnF6NE1K6B9w871wFi4jwSVCLg2DJL-Y9lx1QKz8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RGm-DABrw4bJOgrpyBBaS6mrP87rG50RBQJL_VcSG9g&oe=6A452E39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWS_Gcob7n4Q7kNvwEbwOme&_nc_oc=AdoGg0pCIGxjkinozC9KDsrimH0Oo_jNqd1qh1Op9O9xTtSci3GJ37xx-DEC8LXfJdc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sq3SCE0YFEZbJWGIBLHO5FJl3ZA-zXJRSoAH1UXFc4Q&oe=6A452D55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tKiawZ0vv8Q7kNvwEkVmDn&_nc_oc=AdprYnT01upufp2L3SVQJFTctqrbm2d6LOOuQ0Rkp9VXenbA80fPLKOB2OV3o0_LtDs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6NJ5UJoJgZ99MX35jzdezFbroXK05G1Oi1_YOqIFdsw&oe=6A452BDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwWO-H58xx8Q7kNvwGa6gCP&_nc_oc=Ado6M891nOUVGB2cX9nveQrc6GXppSlDKWwznSg9vTJu74l9olZSCCL1Exy5RHu0Esk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zW3mQOFwPbaGxaVvJ7Qkq8woe8sIE9Bbwt3Zpk1OJAA&oe=69FF4EB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9XgWph3LUkQ7kNvwFcmux1&_nc_oc=Adrkv_T7_QTRNDRp9RwKURy0wrdbgYDB8-L4BBX9o6i4KmBDs2sClpJk-hpYHXMqc2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65JKQb82hBiBlABw7jKvj8gp780yQ2TLjx6eWzIxfAZQ&oe=69FF4DD5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPH43L5eL8oQ7kNvwFJvaJV&_nc_oc=AdogrHFIWq8NV_VWpmOS493QwPbxO82iv7Mvjx7QroZ1zJrBFLHx8v6h5Q3ucQIvtL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tWNFzBbaMYh0aiV39_Xne5bPRGMI-MBOn-er0v2oZFg&oe=69FF4C5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
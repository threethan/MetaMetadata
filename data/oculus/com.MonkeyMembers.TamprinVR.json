-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFCKLR5CCPQQ7kNvwHlVnZm&_nc_oc=Ado2P_68yeGfZ-rXpJH2yLRGobc6Q8Jo-uBhLxXHq5qZzwIMz3bNEmywq17wniR0GT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-ydsJPPny7yCylArKhT2JkBD-7cyNHc9ZIMrStYeHIg&oe=6A8983F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F89gvxQKblMQ7kNvwH7BU1-&_nc_oc=AdpR_RbSN_8wDt_Os-d_sC_9F3RuDy9NPp0VIpBsKs6bik0jE1gtH9L_xrzuQ21I1XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaXZBsAfrfP07CBUK3XcooJtQx9yfGok9UkUAZMJuUCw&oe=6A898315"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTOVvxtDmKAQ7kNvwFzETEF&_nc_oc=Adrc1rdba3cscHj7dwHanMdCqTCoujaaqGFe8jktXkjTgHQqm2SysUGim6Pf6ayozno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGQuEp7HdXZqdvdjjfgcbKF00BjXr_T9F54Vb8eCeEzg&oe=6A89819B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
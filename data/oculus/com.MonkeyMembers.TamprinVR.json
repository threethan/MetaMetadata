-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HwLkgTkuGMQ7kNvwHHJxNc&_nc_oc=AdpNvhTXJlSSSFHFTZ-nJZoe-OaPKydGtj6QREsrxIQGuIQJowCfpq50j65Hut77qYM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnyq7Fo8y95wuQiXFAV4oAANSxKfC-fiPul1slW50PIw&oe=6A843DF9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIC-U67HgTAQ7kNvwHCV76f&_nc_oc=Adptg8xYc2Y0_1FSZQtV9N_nur8hZ3b6XmcpbTqGqHXIPOrzXfBx0FAvxHJ1npUOYes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx9zaGjBnUGmc4Z-ixOm6sbo_f2XpmbtH2tGpcTSjdRg&oe=6A843D15"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-gPcfDK_QQQ7kNvwEgkDxt&_nc_oc=AdqLpFvaGQ8fDM5nkw8wEHT4FWZjQFF4L8yr0nhbXaqCW6zwKKnuhn890z3kNyoJ8fk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbb5bDKDYH4KwllfA2KaTMld1nxcO4vvQYNi4kcZpwcw&oe=6A843B9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEKkDvZQGmwQ7kNvwFIRYdm&_nc_oc=Ado_8Kj2tfgNH0-XrHWme89rsDdOjbj8_wkbGksdpf3CZNOHU8S9G_CDaNL8XjrUC9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU_F2zX16x1JHEjx-XZy6cWWHXAHttLbehjQT7EJKApg&oe=69CA5A79"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eIa3EtrNdkQ7kNvwFPo-m9&_nc_oc=AdpQaZAnikJcE8ftBAe-MFCg_9JrHINaa-NRaGvNRv2iFNJMluqHg2ic1b1jZzvhCLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHpcD0NxUDhk4bZhMzbod0pmxOgkJ-EldG2Enwnk6PsA&oe=69CA5995"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9GmnFPaDD4Q7kNvwHoQB6B&_nc_oc=AdroVXR_FXwGcNovF6XGPPYBgnia12WG-1KjOnwTeQdvjx-H7D3LXFLoXOgR66WRjq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnZTVikcRHyuVETUsNKL7WcinMhWKR8Bk6g6J5qqqq_w&oe=69CA581B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
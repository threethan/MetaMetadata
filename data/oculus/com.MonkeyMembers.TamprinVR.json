-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HwLkgTkuGMQ7kNvwHqtXA3&_nc_oc=AdpqAWKvJ_YZx8jQQNV_ia0KJok107RHB2SdUOstqH3FxDH3dvpC3Vp7LmE9ESi-kJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpTCjwtnNlPyaY-TUzaktK6SzT2BZ-lj2b0M0UGUgE-Q&oe=6A82EC79"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIC-U67HgTAQ7kNvwEMhH0F&_nc_oc=Adpftwcs2Uu2XJP8-r44wflQUdtYshlX8mAR7J993mS9GA9HkmoSBZPq1mO2H8Jlpsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj2NgDpkeCmx2UOCXAmalcvPSqvSJpmDYo5TGEtQMZfA&oe=6A82EB95"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-gPcfDK_QQQ7kNvwH7m-HP&_nc_oc=Ado74V8h0X9xyiIe-tTFRZ_QqXIvP4G6lkdqiNNR-EzFdKueJTUra21LtRsCmUog-_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuBYbyeKIUR38Z4Uv6rLDyImse4C6PP1O4nwS_iyUppA&oe=6A82EA1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJwg5Wm-HN8Q7kNvwFEs48L&_nc_oc=AdrdQJyuzXAVKcYFHZpmoEnY_kdTXf9H5uoupKmziK9pz53F1jEt-Ij68lBiA6wpLq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af519-nQcp7k3d6nehd30tG1kT6KaAzQNeHjWW7HW3o32w&oe=6A1466B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kD5U3uB3iMQ7kNvwG3T1fK&_nc_oc=Ado2wI86iQbUgCi-0zjM-MuwKPPyIDye_FyI5aH8ylMeQ1fJTM77WkiXcROUMbQnEGY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sS0qSUPJyfo-talEYfjQJ6vuwM__ys68ggVBSxS7RcQ&oe=6A1465D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4SpV1q6D28Q7kNvwG-Wkzv&_nc_oc=Adr6YVH9EIbgT0B8yntGiDKNukIfxzw7gBgbJRebomj3JE_SpNKVqBdr1B2DSr0geWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mMHeCB-yB6QThgCmjKDhqBy8Zushg4u_L2gfR93IQsQ&oe=6A14645B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
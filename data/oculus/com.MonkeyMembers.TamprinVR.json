-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47Lj1ncwXrwQ7kNvwHqP1k2&_nc_oc=AdpzfEG1FC1KO9zUezj6vKpW-1dLxyQlPxljpER-OFw7DJyQFGHz956OD6jUcFau07k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzHTMZW597Y__XJMQ8et6AeMNBk_2AIgZ1XNbdgxa-YA&oe=6A9D82B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ONk-mbdHNAQ7kNvwG4Tt4c&_nc_oc=AdrJQMN8gFQr4O3K88sSNCLi7d-HTn-0eGHKMblCtpYtP96En3V5uaVEekORtIKVFBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdRQ-cZBcoqd7Wicvtkp_FwpgzOYNlQN8O6WOEt_9TPw&oe=6A9D81D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=788N0aX2YZMQ7kNvwGpZXsJ&_nc_oc=Adrnl7wq9dt_D-6Z2vbSgZlZKC0umhF8UfMDRzUv_bSw70RSXrX7uVPwePBK6M2GkLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpTJXCzVBjqyztQD88MQfjZ25oRN97Xw8KJjlxCuqKVA&oe=6A9D805B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
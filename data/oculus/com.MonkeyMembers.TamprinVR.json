-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b7Sa7VTsesQ7kNvwHj22ll&_nc_oc=AdqTN5l09jveNkzJDCH_GrvolX3OEqO_0VkRHEMQS2OOPzVeNAad88PsmRdyIIKP9rs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8amX7zCSGkNC26TsM9Edn7bCtLwbdUAHAGDWZ4Kr9lTw&oe=6A2EC4B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wEiBszGIwQQ7kNvwGJ4dwM&_nc_oc=AdqiQwey2DKicRsz_m-nVOxgsgDJW5bO5zc7yg-0e_5YjqasNO0Qw2SueDGKKsQAwhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BoFGrzAMhKHWPbtgfTdPKFFyPgLGX1IdpO2xxzH7piQ&oe=6A2EC3D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vKzGs0OPD8Q7kNvwEKtwvB&_nc_oc=AdrtH0SZ6Q5kyry6PFd8lNQvu_pjGnHwPCKsLmFyCg1TK_fioAUvFj5LNgyenXhDBFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7ydMS_ksSPNVNCyBQ8gICx8miXYbnhy8tBYJIgC7B9g&oe=6A2EC25B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lonx57kd8QMQ7kNvwFoOY7V&_nc_oc=Adod9VEMlR20n-4dsyndQtxrKuVq6_nbThPUM2H5DGsUZQpaVvzFQ4uO7nyBjGz2xko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jdWWROH4K1-nlPmVwfSE0tgmd_pEDgN42tAIU2XkP1A&oe=6A43DCB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWS_Gcob7n4Q7kNvwG4d0Ew&_nc_oc=AdrKBHsBqZ-S5fRJBG77ea--T7PwC4o6yoD0e5gj_cc4rVFpUt49KpBdvDTOFlgxNKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G4_meDGNMONlIP5qSwZLSBOLomfCew-WmCkIpTX2ggQ&oe=6A43DBD5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tKiawZ0vv8Q7kNvwGQsQz8&_nc_oc=AdoXuijjIBmJ7NtP2YV_viI3QTmSmhfjjwfNveNwC7MCUFQrWkLa48dbNAB-UqXpIwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SIg97Dog-1rboeqJbw54Ko9vHptTLlqBOLauI5xd2ww&oe=6A43DA5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
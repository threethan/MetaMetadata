-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8POcrmtyVcQ7kNvwE4Oedi&_nc_oc=Adq4EjWT2ai9rFlIlS691lBVuhe0et5j0vX3SeL_Og-B70y0kt5f8dKEI6ArWgFHOyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BP2LO-SZL_SKmZPFPfzY47npFqq92kBPPco1wzWAEDA&oe=69DCCF79"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IVDltBrQ7MQ7kNvwGvyWvq&_nc_oc=Ado5KYi8mbabvV6GNCRuuoOfem8cpwhy0QuI61PI0HkWHzL9NyZqA2zLbFDshyZktuM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EF3wAsWAZI59vexoBeX2-psAKA2cuCRx-Uy2shtK_ag&oe=69DCCE95"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmhZ5AH249AQ7kNvwHPuPXa&_nc_oc=AdrhREewxCqaRZvZaSSUo_TzDca1a7wkNYrtL6ZTHtIihxAHfssztsFxI32v0s42aew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bMXrsSl7FysfkPTX0EqUcE1hbWwf5py_hBVHtfyKo7Q&oe=69DCCD1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
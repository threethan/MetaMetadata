-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD0y83qNZqYQ7kNvwEW3ESa&_nc_oc=Adp0Xg_3t7qVMUjQMrSUSb-s-Ee42N7M8iyeP1Wg9oLx_ENzTQQWyl2boB-A_aVB5QQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKetZ4PdKm8gHPcK0KXtYdOK8vu73yE0TwlWZr9zHo_QA&oe=6AA6BD39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVMbB-CHm8UQ7kNvwEt8kn7&_nc_oc=AdresS3KRAOM_Kg1fswCr1-KNOySfBWathvsuJ0usKTstHcZ3N1ATltA1lN_MHwITQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs8gk_S0hoJszHwK1yQ4Ew60dI1hd23XnGx-8W4fJOMQ&oe=6AA6BC55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXvH52BFzEwQ7kNvwFpASoA&_nc_oc=AdoR7u7GnmytcBP-Q2hXcr1ZO7I3I8wG6gYCt_txeD9C_rTjjAZBAfQFP7KizEZFKM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPw4jjk0VMV3tviO6-FnrC4xhZLDSdux7qxmUUyo3yyw&oe=6AA6BADB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
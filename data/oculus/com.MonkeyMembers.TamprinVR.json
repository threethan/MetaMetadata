-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQ88mqHiYBEQ7kNvwH2XoeU&_nc_oc=AdpKRe_qvFlc27_Mi4T6YzB-ouauVsYzhgcszNuuSYpru7zsLbinqytImnPeH1GM7k4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzmBjxDohjBxzUn7Mpr87rE0D9hoEqE_TU_9LjYAWERg&oe=6A622F39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOgVn1uUTWYQ7kNvwGlXbl5&_nc_oc=AdoPA_nOxPKZGZ5etxEWBOCXvVH_EjCfQaWBreZuESq8lQ9cq0QcIBdGEmsJQcKJPnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHF_z7zoPQl-K8QFwkSTT_3QGYg3ODxoa1JmEfgn19Vg&oe=6A622E55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu6YsGuUCgIQ7kNvwFp71ou&_nc_oc=AdqdILr1QceaN1bQ2XDe9prTmrboEpxqO1YzgUwpw6SQlpF2lsde1WVc_e6DR2aQLrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwh0XjJ72fASEatjoPB8Q5HOg9jfWzTsIB0ufqNCgCdA&oe=6A622CDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUSuSm_VQMQQ7kNvwFmQG_s&_nc_oc=AdpW87SVfcH_nz6sWK-8pcrGqT-6JY0VjqDh7vKeCsQjRjBUGDxr0aOUExwh1vF_iyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wYOlLVfF_Se8jzAMXSS-i2okN3PkDpT4kzIt7AxX0Xg&oe=6A297EB9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqcxEBe82ZEQ7kNvwEGPFty&_nc_oc=Adp4Fv6cuiMiGJIk4tSWL2CYUn4SifIvnH6Q25F55koj27QRNJShVcIkomedOBbH9xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CafHe3H8sALwst6axyU4XeIe7jR0Sg2FhudwY1P3-DQ&oe=6A297DD5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8y9SgedieUQ7kNvwG9qeQr&_nc_oc=Adpo9epI7x1DtE1sfQjijfPj2E5diIpbeAEzjQ8WwoDIH65T4aDbVTYAEJuqbIaTv1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5K6s-o72wGT0Y1Ww-t1zIpQSQdfEfxal6o0gA5jp-7A&oe=6A297C5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow2yEsAbk3kQ7kNvwELX0T6&_nc_oc=Adq5tm6sSfncW20gJcb7TKMCSg8NgBMx1fcN1MwCfm1so-b7IXx4Er3Qv23JRd7n6DU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_7092PdqiFmVy-YiwIsT8UjPHuPR3sMFzZhOfQFyo0A&oe=69FDFD39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9XgWph3LUkQ7kNvwEMH4Vg&_nc_oc=AdrIrH_jWkH3rS90qE8q01ATpEvYyM0ItI0-gZMm7Qxcwo8OaHfxUxwkxq0Q9Pkngs4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VrsN78_G-S38ZrN8oCA-N20Az13HV2kQt-RjJT0axBQ&oe=69FDFC55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oevDugcQqTgQ7kNvwG0nLGz&_nc_oc=AdpxCvBkNskrhOvMciA4xEQoZ4N7qPvGIXfGNRYDo_o3TnN7jOZ3aLFzQqbYgsgXdck&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RzKoF5t7a44-l48RwJwn-4wVlPRjikZWj-rMwIapu2A&oe=69FDFADB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
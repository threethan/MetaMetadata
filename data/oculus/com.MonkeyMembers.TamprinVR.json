-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBoOQFWOZbgQ7kNvwEAm2m7&_nc_oc=AdreoV98cLeBDi7IGvciycJUdFhlPMNwW567ROHdt0Xkkd5ZtNJ3DjFOhY7pQYInroc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mH1QZArKiKnWmE2xkQ5T9tb-r-gc4tDXHllAoXerPjg&oe=6A0737B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHfvZ9uBzNUQ7kNvwFJ7ctA&_nc_oc=AdqCXf1wq5GJg5s_ZN2i_PWKJTejJXLIek6VTp2VkB3BrjdUnd9rUtDFKXBk_qV6PU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fYp1W91FE50F4M-BNootQuw__gQTRYcSI89MJwHhqAw&oe=6A0736D5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHaX3HeztvwQ7kNvwGT7-et&_nc_oc=AdqICsWjVLW6yi6dBQNcbl4NuotLmsmRjwyXDkTfIggpEfhQZI19357o_1PCx7J10sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51sWtyGWzmgUrro3nkua7HeESG8Qoc4O0axCvXCCtPgA&oe=6A07355B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
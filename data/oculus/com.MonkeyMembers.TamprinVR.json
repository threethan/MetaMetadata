-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUSuSm_VQMQQ7kNvwFZWz73&_nc_oc=AdpNddgb7F1NAoiadgrCgDPku8teoawIeT3o_v-fGbyhJeQZSGMMtgpVgQ2vMUwEg7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7Lea4CEzXh4lmEdEtHRdPZAnz6PIQ0ExrOLFZV8Ulcg&oe=6A282D39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqcxEBe82ZEQ7kNvwHtBVPL&_nc_oc=Adrny-35GOkThHjPHHKL4zasHkbBTjXKkkXNPRJg5FTZUxFcSEHvjCnY3L8vTLeYJi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I0Y9XGWwoDJOki8vkOsWFyP1JLX2x-VoxLsLhCARWyA&oe=6A282C55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8y9SgedieUQ7kNvwFWyOOq&_nc_oc=AdqMgnxufJ4k1H4WJeSmuob565tq-QNzJdKHX0LqXUB6TIuQ0bR9AQZNy4p_vvGbscs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uvnaon7OsrZLfLS8bWvS6_xQQ8w81aW-tUz7jUrheWA&oe=6A282ADB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
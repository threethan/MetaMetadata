ontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFqMFIiN8SZXuyrZCZ8mOA8NSWMvGB4hNhBRfbH8qh0w&oe=69AAB41B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin's", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....TAMRIN? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description": "Hey you!  Do you like small Gorilla Tag fan games or communities? Well come join Tamarin's VR! Its a small but awesome community! So dont be shy.... BE A TAMARIN!"}]}, "developer_name": "MonkeyMembers", "developer_privacy_policy_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MonkeyMembers", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6366016930180765"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer":
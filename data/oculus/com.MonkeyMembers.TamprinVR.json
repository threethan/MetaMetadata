-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duUEvcOSMcQQ7kNvwHGdcmB&_nc_oc=Adp4GldobC5WXfciLS4BoSIOqJbQfpmg3vi0Szlue4iTMDdM0gHm-WVxzf71nJJ-ZDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjUVhu8tAJUFm2uVynAUP6ea1JKxgr0YzbMCLPr6RDIA&oe=69C665F9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpbDxJfMTT4Q7kNvwHOwp9Z&_nc_oc=AdrHING8jb4QG8WIhTMkXbW0nmJC2mqK1e_gdWO4rkcSH0h7Ee0JlfLhEGM9ueUWsyY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAMwsLPg2Qpzrj0MbNid0OD_xuZ85a7C1AQv4TcrnXJQ&oe=69C66515"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yALVnIodpnUQ7kNvwFb5Y8B&_nc_oc=Adq55HY0P4ZzblbpQJpBD_3gi8ZIwTPXThb5l5EM8WpgwoSULbIUP0Mm5vd40ohMLsU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9NSdrSbJZVOJFNESlQnTSSsq5LF5w-jBlAI3LhVKwkQ&oe=69C6639B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XohKe5ut3nsQ7kNvwGz8d7y&_nc_oc=AdoB65HzS7YB0yO_fYpu1sEM41K8-fTeY9SjiPrCqmF39hQRBxL07a0EEONJHXlsq6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAEW-ixlCMD9_sSfBttjrZflcaFKWVFh1BOGohIBZC4w&oe=69C27179"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ZscPEZXcQQ7kNvwEOkMQ6&_nc_oc=AdoymRSc43CPOMd311-hEIUkTc4qbMJe2l28CXkU6wcQMlJGu-hfzIJOwNplfyfaVCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMHqtSG0jZrLVQm53kj9jS35fBVp5RGavHaxTPWZ5fGw&oe=69C27095"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7GNtJb7fk8Q7kNvwFUYuNr&_nc_oc=Adp89QJCewIjNPjqOEazVkCCtkqTcT17BC2bccD1ox56EZ5arCpf1rJnd7FhoORpc9I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXIT7xv5AUTj7xVwf_exRLnbHTbIv9Fce5kf7hgahxvw&oe=69C26F1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
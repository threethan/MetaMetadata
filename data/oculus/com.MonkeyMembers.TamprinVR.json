-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PdPfEyadd4Q7kNvwG1wFzf&_nc_oc=AdqKhF2usOYsE10c-shD_jMOafMqRny9AC-gYKyo7_ybV4gIzGFM9HusdB828f8o92A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P5O7LpTUZSzNsMXjULEF7KseFmfm-Izfcx0i7ADj6yw&oe=6A185B39"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPRtEZWReDMQ7kNvwFTJXcA&_nc_oc=AdoUSFpy1Y__vD6U6hWju8vB4bN8TkQCgJCosPh0Ifm7KJN755Cv8qFtzR-MtEL8Eqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57TI-KXq-tamXnJ7r3WG3lUI9HZldnrYgdc3VQsDj2Ew&oe=6A185A55"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LD1BL7y0htEQ7kNvwECF8OB&_nc_oc=AdoDOzTl0FITmIH4fyVXm3o__PZHQvmEg71vzZBFzj5mD2XI5XqyAeOEfiX0PaW1Vpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S7p2OwwXFXewbZd4uKI5yNDZwFiZrlU2YYSPnuGOl5Q&oe=6A1858DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
-06-23_13-12-58-289.png", "id": "276787321546051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982572_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhLPjZp1fTQQ7kNvwHEI816&_nc_oc=AdqtFVhFO-7NU3-kHd8VZS1NVkiCnpjIzBmhJdLl_lV3xWUI5H047JnJ-TG8eMoacjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSHWTUa77a8-xEKpvghxYcTN3q9HfP96ovj2iW1zXwYg&oe=6AE210B9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87aTfhc2PowQ7kNvwGChlzP&_nc_oc=AdpGzPDeUrVcXvq32KkXjSJT3BKRI6aWhrc3xN1lNVJVkY5juBgYHlAWQortjmucyRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM8C-frjuupmPlOUInsgT9-t7BJAwqf9FI3RLc49jzEQ&oe=6AE20FD5"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOwy-4Vadf8Q7kNvwEho7z8&_nc_oc=AdpSevUGylH-BNo-DwIfc2BLbeVmqBKZLrO9Pn5CROOZSO8GA9bzNCF2eNxoYKO72Yg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGxvm_0Jps2vY-JnABSBOZVFY7MGRUFJsTdxIYwZsYBQ&oe=6AE20E5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description"
72_276787324879384_7299991300553878102_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWK67MPVIxEQ7kNvwEYbv_X&_nc_oc=Adk5q75kSilcSRW4RCRBkQEsUAA5p7jBn6wP12e_pdKdLixEd6bjQcRblnA2pBMrUJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuiWg5my_WCuO_RXkk09GgcmwFE4GSW-26V4mg1HN2rew&oe=69A41EF9"}, {"file_name": "Picsart_23-06-23_13-15-05-997.png", "id": "807002267462764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974871_807002270796097_342782759577546265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=furrbUE7ix4Q7kNvwG9kG4W&_nc_oc=AdkKsiZfwSbq6CcL1vWxn44Eb5vGMvlfAGzUwNj76cEkBkR3rzOGrH_w1Z1pizsYcUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsFTQXNtN5aKFjzjYzf66b7SVS2kVwoYq__l8oGAJDI_Q&oe=69A41E15"}, {"file_name": "Picsart_23-06-23_13-18-29-502.png", "id": "286773650436348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572949_286773653769681_2381707231673474451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLquUoVdNgcQ7kNvwGH4f4r&_nc_oc=AdngJL9yLijg1heCY1oo6kQumdrnxwQsYtl5ar8-Dq76Gy-aG82aBYjEsw_eZ71oye8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfscMiXelMK09GzhSyjlFcAEIkDqXhuwd0D2ni7CeodcQg&oe=69A41C9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monke Game", "keywords": [], "long_description": "Have you ever wanted to swing around as a monkey that goes by the name.....MONKEY? Well if you have then this new game is the right choice for you. Besides swinging from trees you can swim and fly! Gather up with your friends to explore the deep depths of Jilly Job Jett(The Horror Monster) in her cave. You can also go get some snazzy monkey cosmetics from Billy Bob Jones the shop keeper( The horror monster's cousin) You can lay in the sun on the beach or fly in zero gravity.  Whatever you do have fun!", "short_description": "Hey you!  Do you like small Gorilla Tag fan games or communities? Well come join Scary Monkey Game VR! Its a small but awesome community! So don't be shy.... BE A MONKEY!"}]}, "developer_name": "MonkeyMembers", "developer_privacy_policy_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MonkeyMembers", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeymembersllc/privacy-policy?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9975161552524873"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1370269376863040_3022169743682869403_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3cHU5svjN0Q7kNvwEYOVCu&_nc_oc=AdngxgBBGGbV7Ea4Y7cyRwRPqkfr83hkaYVf6Sq4bMz-wo3-14yOrPAf6M7vMg4bp6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv5vGY0iuErzoZXua-c5yYJGrvRIWW6b1bSiGNIrqLV2w&oe=69A41E1F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary Monke Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1692035781, "lastRevision": {"nodes": [{"id": "9471022736272093", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9471022676272099", "is_first_party": 
nd you. gg"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/shenaniganshorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qtui", "support_website_url": null, "website_url": "https://sites.google.com/view/shenaniganshorror/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1294878787050469"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_2104158283537655_3512443430317359282_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCQnOPpiNx4Q7kNvwGD0yUj&_nc_oc=AdpSKTIdN5GBvRcoBrQ7q_eXnDzayeQUJ2O_aWEHjF_xzKlr4KbKErSIP4-S0rBdPgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRV85b3lrVY5yLPMqFVLvjI4vAbnWCXhZoX3LOoERrYvg&oe=6B0C80F2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shenanigan's Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1793320800, "lastRevision": {"nodes": [{"id": "1237394102798938", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1237394086132273", "is_first_party": false
0a&_nc_ohc=um4AqfAXLCoQ7kNvwFRGHuS&_nc_oc=Adpps_-Ss6DKPmLGJaBx-_ad5bHiKKom69GY0DHKAuRwWCoLS6r7RtaDbrcU8sztgkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0O7_rpmqmTmfQ5hxeZ673ISUW3QmicfVvn6Zq67MqEw&oe=6AF8750B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLg3Rf0eSqgQ7kNvwEXZ7Ep&_nc_oc=Adokc7EfzNWcqy1vZw5KMh9rfEMJAb8iBKYMp6kupu31qQaM7mjRJOg0z1YJ006w5xY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvaqKe0xj1YCQlrOuRZePKWyBLp4aJHqA_4nsYZpRI2Q&oe=6AF894AB"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xylq4n0w0h4Q7kNvwHduENJ&_nc_oc=AdqFphiXc-dGUFtjAl8cLRnXSaa8xqYbOF3C9KdBoYaZujXO87uwU1AZ3_ACwyqHZog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8_Fv7ShtXO8pLcLVRB_DLKIDhvbQvJZ_rhL971ikcAw&oe=6AF89600"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302483_2158684635061574_2099875900286193595_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWjfHoXifd0Q7kNvwGav8Z1&_nc_oc=AdrwsLPEZja3kzsgE1kgX1BEd28VqHdZInFYwv_5NWOi9F1H0nvToIsQHlWrG959d9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNxfD2WLRzjjp_5Thmf_O8MimLaaVvMiCx2E4oEsZ_Ww&oe=6AF8A3C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "lethal tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
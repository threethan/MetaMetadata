yers to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302483_2158684635061574_2099875900286193595_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a-GT6_7MAcQ7kNvwElc0m9&_nc_oc=AdrwXoKO4up8Q-J-aoJbYx9qX0KWitBUerQ1ZZIMyKiO3JwAMkK5YTTlhRQAzhC1pqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi-ITy3m
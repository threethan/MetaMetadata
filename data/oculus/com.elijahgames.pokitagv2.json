2326261632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gDViUAdwUsQ7kNvwFBsO-d&_nc_oc=AdrIbyPSXYr6fukW75Omv74ENzdU3gt6OpYJghtQrwYKp9fhFj7uRovRltG1tE_7IKo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPThK8H8c5Cr8pDeRV5i1JGPfzibIbms5axDR5I2HU0A&oe=6AEC978B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYXI7O-wfYEQ7kNvwEI0Cdy&_nc_oc=Adonw7EHKH7hyEqYvWHGtb_vOF9TRdTaf_fh64_J6PY53AnHjRlj5DdwoSXd9Bj62gs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAFFsWEhz-Qoh8TKZgkU48ReCD_r-_688_KCmQ5FXceg&oe=6AECB72B"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsR_XM758rUQ7kNvwEeItmf&_nc_oc=AdprQOVFGatcDNL5ujmN_g83Qd2aq5kgBO7krDptiUEviKLAPiEqPoWbmBXoLL9fVFg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1_DaxTvBTCSFIgxpy9p65mdVO3hOtsdy4RcoGeh9TSw&oe=6AECB880"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25975295325483572", "version": "pokitagv2"}, "id": "2343518042836591", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25725606143785826", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
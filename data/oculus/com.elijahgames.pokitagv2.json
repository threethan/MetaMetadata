0a&_nc_ohc=c2wyb7-7EHUQ7kNvwGv0_Ed&_nc_oc=AdoJDsoaK_0Qh5TTMZXqk4WOu85-oqjFuMk-cXPoiW30wluNDQDHFJKNCTNIwIzVKFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l_4AxiTTG6XBD43stwzXMcw6gxP0-3eJ8OnN6F5c-fQ&oe=69EB830B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE3Qa4lFIygQ7kNvwF1SsCi&_nc_oc=AdqZnpXO0Nhp20c5yy_mBcQ4T0bEV28bQZoWKm5qRLjcKVeosfSiLcLtzvghynypF-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qXT3Qw4AuERj4zmY-85KR3ZVvoi51fRgAusM2fUkgPw&oe=69EB6A6B"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjaRw4QHSt4Q7kNvwGutxN5&_nc_oc=Ado-AcEDhhigaD3tJ-udu9Yn2hHy5PbqKhkxlwdO-0wdTdMCxas4ctpJXSBZIdp75gI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gol7lO1U61EW2NvfH2vmmRHJ1BawgFMj8jAwa14tvHA&oe=69EB6BC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302483_2158684635061574_2099875900286193595_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENmNgc0vn2IQ7kNvwH7K3iC&_nc_oc=Ado0Zo71aMEAsCoScsrYjDUJk4kNmp86HAekKc2ruqLlu2Qcm_5diAqRyqfIKd5dy_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UlLNgQK49LwkhA-QpmHV3Bjn0XqnEEAtBhcfFOVyiZw&oe=69EB7989"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "lethal tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
599799230_2010282942326261632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfmFyzgEHCkQ7kNvwFek4Zy&_nc_oc=AdoRmGc9r05DH5cmCs8gkGq6OP-fcXUSCuTNUk64tNwbLoEUossKr5o3k_5z57tO7wE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iLhIp_9VTZ6zjWa0Lfa3GV2qPFsTh52l02fV0NjQwNA&oe=6A36A88B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGVBbNR_FYwQ7kNvwE3ADV1&_nc_oc=Ado1OWwETNDrOCsqp2xPsPrtpvpm9RXgsxalss4kFX7_o0wF9N0XDYRPXWESmhngvZk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pwQGQNf5b7F319RuicutQzKVu10ZeaV3A_mQmZpG6Hg&oe=6A368FEB"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO-N9gwGoPwQ7kNvwFxPuf6&_nc_oc=Ado94F1DIKyPRBqNOGvmOkf4gJPuIHfzZnUsY3aHHf1koW463NCYlMvnBhFNLs2JTKw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EDuYINA6UUkM4w034bRbFwuBq0A_VSigTuNvAb5VT3A&oe=6A369140"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25975295325483572", "version": "pokitagv2"}, "id": "2343518042836591", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25725606143785826", "is_concept": false, "latest_released_binary": {"__t
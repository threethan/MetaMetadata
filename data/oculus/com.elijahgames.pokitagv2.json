0a&_nc_ohc=nM5ka7kQf5MQ7kNvwHfHaJg&_nc_oc=Adpp7FO2j9EdL3D3XlO--C0GaLpF7-EOsa--NMYDUhDxFTqefTqRD93s9Utbzo10bMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLiWDJP20rnh968RWBSzxbP1d5UkgCLbwzkjUjxafVtQ&oe=6A5CE40B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRlmO4RRzDMQ7kNvwFhyrIU&_nc_oc=AdpNWvzPebyHPLyizZStt3kvkSUse3aGG39-yB8lp7LdPnp2tAY1I7KBdOPHXitBL08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ8v4Xcm1IKm265bAyZH9_B0_Pr-H4620_ZPY6EKUZzw&oe=6A5CCB6B"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVoOF4RuZ4cQ7kNvwGV1dM9&_nc_oc=AdoZMVSV9-BLCb5-_wrYulL2Bp5eBpv5jVfr2vxk0lSFUn3ngOySjWp9HCVznzbEIpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJWmc5NrPeLSJPXxsA-WAU51Y4en5AInPjKnNidXXOKg&oe=6A5CCCC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\
0a&_nc_ohc=1ql-lwrh9cwQ7kNvwF99CYH&_nc_oc=Adp9mbTcmA1hcrfRBzYn_0ttqZuAVKpuLnAtNYYXHcEs95G5utZvEOY3bJIFh_V_w4k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yyvPpemudMPu9rllmU9JpuAfiPSjQkWCdTLQiWiFDRA&oe=6A1AF90B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzw28Alor5UQ7kNvwEhNHRl&_nc_oc=AdpBJzzy4Z5MAEANXJTroQ3zEoCYbUTnFsw0xAw2Ui0xkqsFuscIwIuMXyp0W3CErXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z_ap3LIlCT4FCGlEZm9aVPOIhHrvv58KhAHqOZ37j3g&oe=6A1AE06B"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF83jBSWnUAQ7kNvwGid2AX&_nc_oc=Adpswa-t7GNCpwb0T-Zfyuko6oI7v7miRzYOwrz-kIQRkeyWFiaEPWpy6tFSVRDhIvw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uHkortuP9jWsl6CwAqgFg_v5AAaznGKIWM1NYPJ0DBw&oe=6A1AE1C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499302483_2158684635061574_2099875900286193595_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe5FMoF7QSIQ7kNvwFAb0fY&_nc_oc=AdqGLC3O13mMe-nUH94QArZMe72dZPTKrsebMlSGrNdt7HYOELKbgdI8RnwpmsaHiM0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54YDSHgd5AIHt7lbyRWTi4JCQ7-xnr1_4z7R9KpZVqqA&oe=6A1AEF89"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "lethal tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
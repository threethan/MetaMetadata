E", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499307931_1352086376726378_6917449662245347226_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtuONwQLV6AQ7kNvwFT0wEi&_nc_oc=AdqxCCEmUKk51Hjyk0SHW0m_HkX4WhT5eKDf1kzxKsPgAkK9bidbiX6pgIVS7uWOuyo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJtAjM7Ww-MyKMWA-jZU2orQZD7uJHdchlExYjIapYQg&oe=6A7DCDBB"}, {"file_name": "lethal tag.png", "id": "926874253315301", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304938_926874256648634_5584493358790818962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UNM2irsd1gQ7kNvwEvvglE&_nc_oc=Adorx2SClD9SlDEE6Wr-R1pSXy3sE8K61Ed_Ptf7o5vpJkdVmfiW3CUUOzA5inVrHLU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5Amf9EInCwyrcMQlJXMRlTF9vYgNgiW6dBR0WBqBl5Q&oe=6A7DBAFA"}]}, "id": "1273910210985316", "locale": "en_US", "screenshots": [{"file_name": "pics (1) (1).png", "id": "1554696069349598", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499303140_1554696072682931_8025850026847662632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5E47gnK51QQ7kNvwHCEfpN&_nc_oc=AdqN_pJ0oF7hR4gvW1g2oVBN5ixmAnUKljcxLkyOPLXT7tTVPsYAOkHjqBnIAfHLHh4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQmPldsDRLjLuUCZTq_GodrrXKSKbd9qFX2DZfSlmY_g&oe=6A7DA016"}, {"file_name": "pics (5) (1).png", "id": "1729889284648381", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499301053_1729889287981714_8444571259042398795_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFAPQz7qSTgQ7kNvwFc-9y0&_nc_oc=AdoxjRMAnWOeGTI4B2p06iRhYp8nEUb2ev51CYyGSicbfNYZ7UziMWqRR10Mrg3nYLQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaprzkZhfAyZriPfObLDqZjM-77SSdZs3We_7UUZUPCg&oe=6A7DB82B"}, {"file_name": "pics (4) (1).png", "id": "1289493596465897", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308131_1289493599799230_2010282942326261632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6dNYY3GRmAQ7kNvwH8oMMY&_nc_oc=AdqhoDTt0hfkJJOge8bM_oUz-M4yCInXPdOLlDXCc-CoZ0tCRPK59TclT5rsFBxiUJo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLL19nfTKkOmfh84Dyo_ZnbLkJNBCSnmb93ii9Q83FZw&oe=6A7DA14B"}, {"file_name": "pics (3) (1).png", "id": "1421166813092554", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499302483_1421166816425887_6080330864639774038_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfx8UoV6jvsQ7kNvwFYRXco&_nc_oc=AdpciBRzysOh0Ukjl50fnqxTF03_fPrcxUiyp_Onw74IDGwEjtKSdRjlWsw5BMLw9Bc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET1phih-SomsWxZNImlvW7LUrIUC3wFRIHXpMTFVPuUQ&oe=6A7DC0EB"}, {"file_name": "pics (2) (1).png", "id": "1958147864782626", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307954_1958147868115959_1519175698540543582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxdle30ac2cQ7kNvwE7g2Q6&_nc_oc=Adrj_OFfc7kf94pdewEiyppzR2m1o9qgvS03f9Hlo3nhcad_DKyG71-mBDEONLlmwwA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExLSpRB8pvuAJSwtpXI43ENaUjhynmdAjO32iDgi_U1A&oe=6A7DC240"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal tag", "keywords": ["gorilla", "tagging", "project", "lethal", "lethaltag"], "long_description": "Jump into a fast-paced and energetic VR world where movement, creativity, and player interaction drive the experience. This game focuses on fun, social gameplay where players can explore, compete, and interact in real time.\n\nWhether you're racing around environments, experimenting with movement mechanics, or just hanging out with others, every session is different. Designed for smooth and responsive VR controls, the game encourages players to move freely and engage with the world in a natural way.\n\nKey features include:\n\u2022 Real-time multiplayer interaction\n\u2022 Physics-based movement and gameplay\n\u2022 Social and competitive experiences\n\u2022 Easy to pick up, hard to master\n\nBuilt for VR, this experience is all about freedom, fun, and connecting with other players in a dynamic virtual space.", "short_description": "A fun and chaotic multiplayer VR experience full of fast movement, social interaction, and unpredictable moments."}]}, "developer_name": "elijah", "developer_privacy_policy_url": "https://docs.google.com/document/d/1R3XZd00z_v6DbPiCEpMDZGPGwQFnX1h27SeKe_1GihM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "elijah", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1D7sHCZYxF3hNSCSSxbu7xrE6OjthWpgbk8u79wJwKbM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25725606183785822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302483_2158684635061574_2099875900286193595_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIe20xWyvtMQ7kNvwHGMuku&_nc_oc=AdoFRSSDXHFgMh6tHwuGTS7V6v263on2hQL6KK9we5_lMmQX9Du046PWJo7coTRV-u4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRZl5a2Bo79BgNb-DdER1wd2NlkuJmFxIVyLqAYsWfbA&oe=6A7DD009"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "lethal tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
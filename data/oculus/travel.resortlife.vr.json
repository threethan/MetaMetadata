nshot-4-dining.png", "id": "1812850897515514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622162_1812850900848847_5262027677950207122_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OtPlQ5sXWoQ7kNvwEsw-zo&_nc_oc=AdrCsNtO-sQ5x42xFlXawjs1WqCKwbXoNY371KDfy-AG2LkUjYj3hswZj1LuG_gb57o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGijVTEEcZWvO4nGHFfvE704X3WlNkC8MLy-L6TF0Z5w&oe=6B09A4C2"}, {"file_name": "screenshot-5-spa.png", "id": "2273476076534329", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620666_2273476079867662_6323047209946159536_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iN9OQ4J6WYQ7kNvwE6SNGY&_nc_oc=AdrGZ3-jkulx1kSdIOSyjzrk2bbNwQwP8ZFPz3g7Tg431iWl0yOhgcWcvyLIkbjKAfk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQINg62vbarQk7M9g_EYSquSb-Qd_AUYN62tjymE_63RQ&oe=6B09A0E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Resortlife", "keywords": [], "long_description": "Resortlife is a destination management company based in Mal\u00e9, working with Maldives resorts since 2006. This app puts our 360\u00b0 resort tours in your headset, so you can see where you would stay before you ask about a trip.\n\nWhat you can do\n\u2022 Choose from more than 40 Maldives resorts on a wall of islands. Look at one and you are standing above it.\n\u2022 Step inside overwater villas, beach villas, restaurants, spas, pools and jetties, photographed in 360\u00b0.\n\u2022 Move the way you like: follow the rings from room to room, open the list of every scene, or press Play the tour and sit back.\n\u2022 Point at a ring to see a picture of the room it leads to before you go.\n\nGood to know\n\u2022 Every tour is real 360\u00b0 photography of the resort. You look around from fixed points. It is not a 3D walk-through.\n\u2022 The tours stream over the internet, so you need a connection.\n\u2022 Use it seated or standing with Touch controllers. No room to move is needed.\n\u2022 Free, with no account, no ads and no purchases.\n\nWhen you find an island you like, our team in Mal\u00e9 can help you plan the stay at resortlife.travel.", "short_description": "Stand on a Maldives island before you book it. Resortlife opens more than 40 resorts in 360\u00b0 photography: step into overwater villas, restaurants, spas and beaches, and look around from where the camera stood. Choose an island from the lobby, move from room to room, or sit back and let the tour play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://resortlife.travel/privacy", "developer_terms_of_service_url": "https://resortlife.travel/terms", "publisher_name": "Resort Life Travel", "support_website_url": "https://resortlife.travel/contact", "website_url": "https://resortlife.travel/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1519444664577267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624656_2150041082571346_5545025970602259970_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeyKlJL5r80Q7kNvwGLe1Vx&_nc_oc=AdpClh-1pDwcOUhXeSJDHG5Dh3CoSM65PF_EXMpBaBYAlstHbfP0LGqm5lpcZ5jhbAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj4HUOvmucqLmXS43WKkff393nbT7SE_j4PNND2FMw-Q&oe=6B0
t-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_5136774086399077_5860152697619475301_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYirWzS0THUQ7kNvwHI743J&_nc_oc=AdnxEgehc7pIWSKHedkhtUAxeFGGnlRqJpbuGZUU0Sr3kvCM_xi_T4VQFCP4vin2G7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGdVw1bFXfJyeOfGxb_yQpdSfonI99zRQVbBiiWJgrxg&oe=69BBF21F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsyG1xuR-jwQ7kNvwEeMCDI&_nc_oc=Adnhyw8VIRdgaG1WIt95OcHJcuVG1vZv0Z2SHAUfjXDINAcEYWZeYyG77NsIetKXk_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpP6ITzB1mb0wMh2X1kqX3Yt7es34TEEZv5652zpFtMg&oe=69BBEFE1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NegrDwVlx98Q7kNvwGNqLt_&_nc_oc=AdlPZiVlDTxZWrY14ZkITZUJhax24X8gG8OAZGHxvVSDfir2OjzKuyg8PFSgzzxjToM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOXdXiUKwbHd22hINOI5RGMpKIzcqIyCm7xhWIjzWOrQ&oe=69BBE523"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoyybmXpY7gQ7kNvwHZTnzZ&_nc_oc=AdnTI4aBgmRA1oZpNwGdxfMEYzqh7hzUNxdpIl1alFeTEDxqflBtFXWgctQxnhx_6To&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzo5kJNZLAgHJWSOhQDWIcbXvqXsdU-wGyWDYmqR-xJuA&oe=69BBF7FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPx8q4EzmsYQ7kNvwEKEh-z&_nc_oc=AdmlNLfmRtyGVgHI2OZY0BvTi3hIxcLMnztGth0yTRIS3Yx5FIq9Dq2bJQFgLmge2yE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx94uXGGDRdfDF3N94MFmI2XXBRzGGDZHTsJwffEZ5x9A&oe=69BBE131"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_a
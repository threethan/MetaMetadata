1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwHBsuuKeNIQ7kNvwF41A_Z&_nc_oc=AdlX-tC6E4KOQef2QayecXrLAm13XmstaALHOEM_S1MmQzqICQUhUy41MGjkJyzUzGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftW7huppgvbXfc6lU96xtfGVIbqDMCtEFRR0aJ_kbztzA&oe=69A5889F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gnFlOSlzg4Q7kNvwEOCGs1&_nc_oc=AdlYu8F5gwRY10iuJRpOVl9jszH1bUagjiUOSQAeoqhENF--md5e7zv6xLE2ChvNTsg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvPpRAx6_4VxQUMFHVdnw_YODe0Atm7PyvBUKFmGS6b6A&oe=69A58661"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osmv1U7fLpoQ7kNvwGfvKC2&_nc_oc=AdlyxU8s3sLt6kXTQBldCXFD9PIvSXixMfPxh439lzdVXzZVtNQJEN5yZHIuC8kU8fE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfujfFotcLdn7nocnxKj4jiTAe1Zqrc4fve0WydGH2K82w&oe=69A57BA3"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzdrpfed5tkQ7kNvwFaJepV&_nc_oc=Adn6ixpN2YvnCxMGYcafxAaaleLvu0txSgjt8b6qEJo8meRb3EB0Nb2PD0-biVm7hhE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfspHh1P1fi1tEpDXjBT3UjCjYgFwKSWAmB8GKpw7iCRxQ&oe=69A58E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQwQK0Puvb8Q7kNvwHaFAqV&_nc_oc=Adnh6ti5Y659DLPhp44gQkJ0vG7CPZD9QOVrKbfYruULJeH9FxzshXzg2pc4Y7c_Bzg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvAovp_DsNQHLq-fyF01ScSyN95s9K2J13tEJhcGWWTBQ&oe=69A577B1"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
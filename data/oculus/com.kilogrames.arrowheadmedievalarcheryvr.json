t-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_5136774086399077_5860152697619475301_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zykHoFj69d0Q7kNvwFn7cvw&_nc_oc=AdmkjcoDuFcznehGhdjclrw4MwcVvV28RE1UdTJFTHdoSWwunvk4Ydj1gm41w_DUEB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPj7ZWHN0MoXH1jOu5KCFKMJvmCfquVaOW1Q5UShVSwg&oe=69A82B9F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwb-N2lyiecQ7kNvwFyABkP&_nc_oc=Admx0WQC_1VurspISFPlE0AXtGUP6YUtqengv2IBcaOPe6jJcR5cCRDTfCHDottTjKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftLQgZzA6w_R8QRICO0lkKzGo6A4Dnt97YK3yfepoEhEA&oe=69A82961"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osmv1U7fLpoQ7kNvwFMJ9P4&_nc_oc=AdmXQvqc3lgAW31t0rg_bzLzY5qLfWFGhVRl2rHiXTQlzMijwRyyW-f9m39u04cqzZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsbmosLqSjK8_04h1t5XJcxt-Kp9_rV-vpb1vRux07FdQ&oe=69A81EA3"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzdrpfed5tkQ7kNvwHDYdz7&_nc_oc=Adm0k1kGkSM2cQWPTlV-GoWOo_qQcqlTZaSkCf2tqDC_TF3YWFfBS78E87kNStsq5NE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftA6kJP3FTCz8lCLPvpc_BR_mr_-INSkzb7JpSPQG91rg&oe=69A8317D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQwQK0Puvb8Q7kNvwEGrV3F&_nc_oc=AdlWxUYqThxl16UUQQSmfqu3hKLBcxhvpMRLFLLZOAkwkZhv6w6J88vq7-PKBitxRhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZzsO9N25ghh114GQts8tl01M1sIw6wtyAF8MLvb1v5A&oe=69A81AB1"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_a
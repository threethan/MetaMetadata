t-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_5136774086399077_5860152697619475301_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHtwHlhWHxoQ7kNvwGo44fQ&_nc_oc=AdkIpMuvGISDX_18EWYhgAKjR15t-L_D29dD7zlxhSWpOtffWhmvigbWzEWK92i_c4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdfII4zVVELuCrNhojaxeGIiK_w0bz64CIPjzTeQ-3SA&oe=69B4091F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2X02FA3C1QQ7kNvwFR0-F8&_nc_oc=AdmVTPOQpeRpAjFRG1u9-J49MBhUCYoEC1a9aQ2evcyC5L-nqgYDWCxS42xlQhe4Mwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9No5_Zu4x2OA4drDbTKO9c14ax8cSaO7NrHsqQJJ0pQ&oe=69B406E1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhcAggvuxE8Q7kNvwHlFmpc&_nc_oc=AdlAW1Vc7sMzw-u1_i2LySKrxvVEvnNKXcSmhscYd7aWN0AHFpwMx0RznT2TlC-v0WE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnsjzNUqKJ5x9BhXpDm30CM_20IyEzUZCRQx3SrtH71g&oe=69B3FC23"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxGDXPoi5uwQ7kNvwGIcilB&_nc_oc=Adlv5vGqmYOJCU9zE4xLO8Cfoeggo8k5qw5kHTXFYxeoU-kTy7s_-nTrkX3HNWSoBEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7rxROpTk4mq77QVmxRCRqE8hg4S6Gz3uMl0ECj2EFMw&oe=69B40EFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkw-g3-UZREQ7kNvwG9TLIG&_nc_oc=AdkX_ENbFB8WPmf7Kf9boQ0nvde2KgVgBPbKWUOiZ32YguIwJAY6dEo_NC6e450JyUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw75bLMtb8xtmrFnhdAtNyb1oYLxrJIBVsEh5ESFpHctw&oe=69B3F831"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_a
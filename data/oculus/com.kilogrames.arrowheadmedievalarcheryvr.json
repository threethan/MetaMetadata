1-7&_nc_sid=6e7a0a&_nc_ohc=jK3EVj-TM9cQ7kNvwFetUyr&_nc_oc=Adqyx-VkcLNwwvU3_eEN9AOtiqFK9WQV0DyO_sxkfzlaAclpyxyIeftkfeCCgjlZjFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYGETJdzVepuO2-3bLwWkrmaafOmTf5GAScc77qwfzkg&oe=6A771631"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", 
1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUNL4ZBZSTQQ7kNvwHqPLwg&_nc_oc=AdkjD9pwqZWApT2T8dBoJh4CgmsoONFKLziK4vLJYYa_DO2-tyjKGeCukURJwW9Favw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuEV2M9SuqO4TObwJtamhzh2-QSFrg1x6fAdnBLPBQy0Q&oe=69A1941F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8078UlaoMmkQ7kNvwHlpNj3&_nc_oc=AdmBK0htbjc2wK9_cBCBT6lH0cbYm2jTY39PUsCxJPVvX-7RopNUBCbDyEO02Rij134&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftMjZJDAWg2U15NA0zlodw2oNyIyYAITeKPva4dwkHlCQ&oe=69A191E1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PvhKF-UwVEQ7kNvwGDI-5l&_nc_oc=AdnBzROnxjq12Q4UZkLVRHQ3CqS9Snctjbfhk21UUvzOPY4nol6fYaDs1-Ek3yH80gE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsitUHx0eOz68EZNQ8EL10d4KZxjqieP719K5tMPgebyA&oe=69A18723"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gh8JakSmOIQ7kNvwHtMVt_&_nc_oc=AdmPVQARQVA9eoAla0Ao6iWgInPges8GhTZMD21YObdOlwrNQFCFLYbxVS-wJnZ5v9M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsLc46JYg5sGoYOP-t-37wL9tfHcKZ9sGj9gu1m9-TjxQ&oe=69A199FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmaIktaSygQQ7kNvwHKKmBH&_nc_oc=AdkYMQ6lcVuhjwfEqWVu3HOAOOIcLo9ZvTvcDmg3UwsEpyY_EaHdr4TpLQ_xkU9qNq4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvsfY0i2raAPmXlnfK7inNxfPzxFMffXMJty3UDb10ngg&oe=69A18331"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzAARaa18w8Q7kNvwFjvBvJ&_nc_oc=AdoTHOc-kPuRqq61gbfxKy9WqDgIlIzbg67aCEcieKafeUFJ6PQodcTQjKvHvSJMp0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0zAav3_TlBczGToDJ_FTUYPAM1_gmqNyMDamw5mREDGQ&oe=69F0AE1F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaNP3piQhKAQ7kNvwFXtyAP&_nc_oc=AdolJBfSSlLoSXzsRapSFAoybl013uw5qTwDfHvmWx5PBmY5FjZ7VBz_rAVibB1UM4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3QNfnWe3oLss-HCXq2qgfigcZ3v5idvAK9I8TwPDYo9A&oe=69F0ABE1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slCKsoDMIy4Q7kNvwGEpb6Y&_nc_oc=AdqPCD7Zh7CSy4e65fKl-EP8Jr4aJpSRlH8Qo8PP--KDCw-Yukha5KyBCDMRZVo1gW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2JAnkZfr3GwDNNMLab9Qq3ZPWwaqlQauBgeBJxvbtgkA&oe=69F0A123"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OISw_U3HjLcQ7kNvwEkd7m9&_nc_oc=AdrFgmTmopef8bm3aL7Fu1YkoStJ-EZwNzIxY8u2BjuXrhwPHgNAL1YTe0cg1HvN_xA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0rb9BudqA6Bye6qQBKdn4QyxV0D9DksdL7wlJu2ho20Q&oe=69F0B3FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHZHLjDJStoQ7kNvwGeb0Cw&_nc_oc=Adr-OelhPnD1ch1uAZakvMf1eQNYoorR0YLUGtu2H3Zs4S4k1yMvxBGGbkL0nlgbc-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af28z9NUnmo6xKEk938k-3tm7TzMvLKA5-qf4D7NglWx9A&oe=69F09D31"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
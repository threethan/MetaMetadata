4083065744", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39001670_5136774086399077_5860152697619475301_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P0x1AQA0fIQ7kNvwEh-i6V&_nc_oc=AdpPTWM3vxOUjdA3Elf7CQOK5JWIFUvjt8mBPyDWVq_JKRbu6bGRAKKbQlw6AFl58zs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l9C0CUekcfO5OcAtYSOrLwZ3syf2dEHtm6XOrkViDiQ&oe=69FDDD1F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBxWMLAmwMcQ7kNvwEzk6fg&_nc_oc=AdodnMOvOWCAawW7Lv55ffEqvWlmOtVa8riyBsQ_ZFFPeay3s7-M0_DPeZ7py-hvNtk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SmcBbiSd9GpvhagkqaE8l4-Z3Km75XtQ2AWtosy-wdA&oe=69FDDAE1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfIErpHMeV4Q7kNvwHPJb0O&_nc_oc=Adqp3zh-ogUVjA65h5eztglNWv_kfVlCuHSR1fbzF6gs67A3iUXdWx4stTUZZsb0QI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dpiVjG6TIw9IY0hhBYeDKgVXbC_0ulsumP0l1r5cMZQ&oe=69FDD023"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nblRb4JSfZUQ7kNvwHwn-wR&_nc_oc=AdraPeyIe9ivHTs_ibpEnfnwKb6lfWAy-NtxDC8YnflnsXUGUqyats8-YPtt1WOuhXM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af512Ul7ZUGdKIxodH0nI_cttA0Uukaqs_YKfG8xnjCaLQ&oe=69FDE2FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtVINLugZqcQ7kNvwFl1Scu&_nc_oc=AdqBFwvxEQTZEJw8XjBws7XtPUNwbxmpGa3p5anSDbZ1zGJa3tG3Z7Afg6jHWJ-rpj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u_b_8osRXrOFcNB6dCObCYQy7abBt0G7Oc9-7gdpl5g&oe=69FE0471"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", 
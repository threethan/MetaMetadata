1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwHBsuuKeNIQ7kNvwHfsDNi&_nc_oc=AdlZ9HxXXgwuB9zMAoobnLTk6vCpDW-0Vkv2ehTlFSVzc4ueDfnAiaottt2wnnDlrww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuamJF5ZU7NbfN9jNbV4cCZiXPvTRa_Ia45vOg2INMmDQ&oe=69A4371F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gnFlOSlzg4Q7kNvwEF992p&_nc_oc=Adn7J1blV1rjAMO5W61UfCpzxxdCJdrFkgaXxet5rjp6lGa6YHckEywHEN7BQJAPghU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuEItbZDawuKikSahKwYZTecE9PjtTYTGOTYffVLUFBaw&oe=69A434E1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PvhKF-UwVEQ7kNvwGqollj&_nc_oc=Adnh24r80EqssmUsfz2shzmuuVcU-QejpzRFAg5jhh5YuQeYYn5fDQv0F2CqoBlvFXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1S6S652TTTujrEaH-7ILt-3GijNXcSTAbRdqcZmOpLA&oe=69A42A23"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gh8JakSmOIQ7kNvwGrtjYY&_nc_oc=Adn9tlIwg2rKa3EjJa9-JhsoRIVQhkx7TeJ9bj5av18FfN2fBJ1KWhrv4nD8is2uYqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsbnhyqswitkkv3CZZroorSXs4qBMGlspbqe6b1gdbWSQ&oe=69A43CFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmaIktaSygQQ7kNvwHXmRY8&_nc_oc=Adm7D3C0yRGrzstopuBcH8ynocIJ6wQaZwpmF6xYujqUExChe5kbwIcEtZZ0w7d3UTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvG07Mp17HISlCjpFw333-9XC3BbxEI3jbFAS9MyWW60A&oe=69A42631"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
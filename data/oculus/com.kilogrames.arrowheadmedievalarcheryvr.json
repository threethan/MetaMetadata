1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUNL4ZBZSTQQ7kNvwFjnSzU&_nc_oc=AdnomYMMXmbmhxrS_Qm-OpbucMJS-FPDsizqo88wdbFsIObnaKsopBYDqsF8JESYHIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfveNw9g_QFtp96-ugmdLceXizEp3ikucBvuslDz62OVvg&oe=699EF11F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8078UlaoMmkQ7kNvwHz1ERq&_nc_oc=Adlqoe9LOB3BzILBjcGbEW9bTw6nOyFuCo105IPrbp5r1RYcKLXHjZxyaOc30lpHY6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsEQtVv-Mw2pSJk-Ix6hJ0v1LnuMKP8hRT5WEoXnYo9iw&oe=699EEEE1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-08rZbSAJoQ7kNvwEr-bJT&_nc_oc=AdnzrkdeWR9tlyU4kzdXwOvuJA-nQmySbwgMo56UUwEzRU_xszuZKI9gztAaf56KNLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftObTkL4k9tQpOfheSJNEePJ2dc-enYuE0K1XJjOxgchA&oe=699EE423"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwSnBzLpv-sQ7kNvwFfYR7f&_nc_oc=AdlDu-qpGkqkRHpetnKmlkb9otFSoGp0_t9f6xVr0pJ3rk3OjvisWVFi_TF2pUJQnMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft7CtK6IspJRZud5LQAGpnKOjKrH3BKbdk9-ZpwYOW0ig&oe=699EF6FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA5mP_MYV_QQ7kNvwFIAtak&_nc_oc=AdlY9v7VgLRjQ9_kYZqHGkARTuyjuLIqvm4u_YTOWkPj9uw3JgjASke8HSe1uA4mIy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsAYgpwq2AJUfIN7H8hdLcI6LndqzHXOcJpRvj5FBbIeA&oe=699EE031"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUNL4ZBZSTQQ7kNvwHCtvEI&_nc_oc=AdnziDg84b4T3pmtD_ETkCoEv8UPqw-nvlFs-I34nGhoJwnGWywla9ig0Y6ZFrsSl6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvx6fzLPwQ0QpJDJn2RXJMCJU_JmKvVR8V_Owog2_OZeg&oe=69A0429F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8078UlaoMmkQ7kNvwED-PpL&_nc_oc=AdmQnRqtuq-82tazqlffiqoMgqUEfgTq765CW5hU1qr96Ul7Y4TPGJ-Xtk7z6x3Q61c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtHvhV2-RS0phtF1MVBeOAuL4P0Sd1rNwRPtrvmU5Q_w&oe=69A04061"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-08rZbSAJoQ7kNvwE98VNv&_nc_oc=Adl4mLEo9yzXYtOKPuC7Bg3CFORE5Pr2pk8TiMwwoXUUr3fnXe67RbMeSTnSlOJvThA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8clpHKvGyQJUNvrRk_J__TvrUHSpV8MH-Q9K6z2z6cA&oe=69A035A3"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwSnBzLpv-sQ7kNvwH5DI9X&_nc_oc=AdkNBNfIKqzU1bkjAHwWOHpjdPsDOyLyLx1NGb73Kvea6et7qCke3wEucwmNu3Sc0Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6chNvmVNjBEhGXyloxoKkqnKMuAF-cjFguWT3BP1l-g&oe=69A0487D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA5mP_MYV_QQ7kNvwFBqcr9&_nc_oc=AdmwSlWWAFJVI0WDnglb5dxMu9lOJ4HDj1OzaaVpF9RCWHdF0cFsolKIf1UIrwEkgDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMWFLmcRNaeGD1GFQb0YHgi2jy3UxnO9_-EFYPxmHnOg&oe=69A031B1"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zykHoFj69d0Q7kNvwHeAIqx&_nc_oc=AdnlLh8YuaSfaGdhbpwfHO9hdImmTizgUf2syAvIF5srINbPbmRGuWU-SdcQz96hnS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPH1e7yVcRq0gopYwX08MtZXNGFj_cPiXJmpEXbj-bBw&oe=69A6DA1F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwb-N2lyiecQ7kNvwEh2zm-&_nc_oc=AdlclmKtsZHyQZ1TQeFiVQnboz4KyU5WZ_c1lYQlH3NxJFCwxQy7yW4ujKocYNj5ITc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWMdPlg3ZRRBfiz0msBoGGD5rCOKSHhDE3XR2hDc1J1g&oe=69A6D7E1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osmv1U7fLpoQ7kNvwHDyxxw&_nc_oc=AdlfYt-CkgbBdUYS5YeWnbXHuaZcXLCgYbrZ3DrVPXcYu6xeelhc8CRF-REGhzykNTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5PmEveNt8W2oXbiCZ_3NgiIgSOaOEwADRFhJud4c0bQ&oe=69A6CD23"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzdrpfed5tkQ7kNvwEgv2-Z&_nc_oc=Adk6KBpigYsvglkgeJUrMXGz4gTRz-Jm2pnj1hbUBJkwWSFH17RMGMWbd9gi9XCopV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGCkpYYXvVAQzL0J8IUxDWjH3V5svMchAcg5-_8LbyGg&oe=69A6DFFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQwQK0Puvb8Q7kNvwHlAvBE&_nc_oc=AdmJiTl3vBskivUkiY7HWQYzzqTQHDGva8lWbixE47k2cRQ4CIRh6d7wUrIwCQmA-84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupEP7Gt5lWzg1GJOKEYv0RRWUoLzOsy9jV566kQAns0Q&oe=69A6C931"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
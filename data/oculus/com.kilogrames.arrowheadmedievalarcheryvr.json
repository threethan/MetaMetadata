1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh1MiRRmSMcQ7kNvwGjuL6y&_nc_oc=AdmbFuGDRguGtIsYHco60JO7GrtCRH0YNYLL1C3vFSlh1Csd5opl6JEOqla1OBSmxC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftk_nPkB51NZwK_DL6b3OAPSU2DxtFO-4yIi6D-vODNCg&oe=699C4E1F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62zLyXdtVu4Q7kNvwELAjnJ&_nc_oc=AdnwvvytqoWIepG8FJRMide5mfman-TGK6VERdaJ2WD2Me4Ne245IbXDBLarKN7WeTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftUtbHhEkKAlDjOYTC3lznBl2ShCYnSoHSeBRIggZwR2Q&oe=699C4BE1"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc6_E4pFZ0gQ7kNvwEZsux0&_nc_oc=AdmEyeScTwYGdzDI6jmFIwlfg_8NRIoqeDAxs2LnUIuQr02pfI8XBPsOTo5P7NgCtyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afumjb-o3HXnJtoYSSx-s4OWb4QA7OwwOh4anWcjubBK8Q&oe=699C4123"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8ZcpLmYr6gQ7kNvwG-acTY&_nc_oc=AdkfZLCxi7nlGy_MYQZBSTX4t6P8SjDXXNmKR-LsRYH-KxKrO5GOvkMnRtejmQSbPxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCYvtwI7NFNQY_vOVm_iWMd2o0IRaBVmcehNB9Oe5P5Q&oe=699C53FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXYKiAHmcRAQ7kNvwE1u_zA&_nc_oc=AdlW6udmp5-tAAxjRd3B6OX8fzU_Dkqcd-hQKMLRkKcBYGlNyEL-DJe4ErvjcAs2oa4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftG2Bp05kQH5JBnP_sNOSUU3IWaunCAM22GzBua3Rud6w&oe=699C3D31"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
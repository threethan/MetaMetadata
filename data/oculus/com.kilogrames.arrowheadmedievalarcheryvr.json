t-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_5136774086399077_5860152697619475301_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLQjLmybQJAQ7kNvwF__rgA&_nc_oc=AdlJyNej_VkJxNL3GMvSisRRrJE4vqCLteOO0xAKf80CuE-uKE9IZ-pBBQqb8K8HVSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiUtamaSaPtHKxUzxufrWichLMgJQcLGIq6WugjRAfRg&oe=69B0149F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBLEd06rQZoQ7kNvwGBhNLn&_nc_oc=Adn1IexOCxR4lzj2pvUfqLVeSfZEeMraaVE4jzCTquZwK_pzGAPYr4IE5UT24NL7lFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb7-UWjN7CkU8lWr_q4MpqhaeKs8-AhY9nDa621DhTAw&oe=69B01261"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ux7Cih6TMEQ7kNvwH0be0i&_nc_oc=AdkYgUNzejAV5lOUbDQOqD_YH_YcMlHqnwzGzMcQBR6HcAqwo6qN0P5V7JhTFFbpnsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAa8kGciP8o-B9WDARx62j2CVE330YXRPX868dIX3M0w&oe=69B007A3"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SBXaTGgdmAQ7kNvwHR5Wba&_nc_oc=AdlyKSfUi0eKUCdAkwv88P9aFzcR5JyptcOIcLaj64DkG2xLOb408z7hfo6aBlJeEnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJuypEq3Z6fUkY0pLURdQpo0GY0Jnve-kaFRI59UhaYQ&oe=69B01A7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1YmxSFuxp4Q7kNvwHGO2bo&_nc_oc=Adkau_dYsegllYlHNh6vrC0dSTiIevgGKxg4oNthRSbQ3OKN4VAbce-0sR1ZPQkhDPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4TiuASDdK9kseKunvImXVM10mftdjejkaBcabKZGYfw&oe=69B003B1"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_a
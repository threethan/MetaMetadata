t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlP1VgPWq-kF_R46TyVtYJWUNOm40b4Rc74PcJkDf0CQ&oe=6B031F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1246076232558533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223481_1246076235891866_7104691615773776988_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSPjEgWdBwsQ7kNvwHn4coB&_nc_oc=AdraYbNkqtLWUvmLh4fEJwKSPb_GclgfFJybqphVBtB3yNImb4TGS_gtEAcLVI7E77w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvJ1zRT5H_68nk2X_lVgEJfOC6biLb_R90CSD1ZevdKQ&oe=6B0315D2"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": [], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category"
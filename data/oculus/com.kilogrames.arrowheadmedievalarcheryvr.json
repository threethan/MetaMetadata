1_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgRBN_64srUQ7kNvwGFup2K&_nc_oc=Adnk0FUQXGuXxUVFd0BOvTndhSuYZWnH4P3DcISRcJTBMdMYBHtoz-v6ArbzPa6rP8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs-AWqDzQUcrKO1upgC_mk1j1VhWJlo5Dsss3f-mwUB8A&oe=6998599F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3SyvzbJEjgQ7kNvwFNgF8d&_nc_oc=AdnuBS5FfxiW4xDAZsXR2kKpaNqJycKVpgBI5C2rGwRNVzjc4tSidpa9X_26KfIFKKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv4sOkKRwmGW_hr7v-MLOkwE6_0Yo1h1a83iRDFo_QZhA&oe=69985761"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYU5t0yGxpYQ7kNvwHooQb8&_nc_oc=AdmulZLepMZ2u6yAYEnrewhceJhqv24FCbotAca4dRDxcNHXc2Nwzlt3weN3ocXbEFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuG5zjPBUqstQclRCP_Hfvzb5etyXqvImF1yHMA3KmKlg&oe=69984CA3"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2t2mUrI9C8Q7kNvwGCZFXj&_nc_oc=AdmabUaJXw0Etwmy3RdhdXwLjEUBF-ZldWlu6Uz70yEtj1YcIRsqQjhxR4i2sn1SwcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs92VzCVcifnfhw1u1unBOKnAHauQL401YAZ1xpmwLbyA&oe=69985F7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdI_ksnA9wQQ7kNvwECWx1w&_nc_oc=AdmzhauNdCHOx3cm_FZQEJKQ8rQokYcr4maQro_venMJEaybX7JZwdpPJsGEGTmcaPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft4tfpT5tmPEy6bO_ay098SQ8ApHmV6o1SxqenGJrk3Tw&oe=699848B1"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_m
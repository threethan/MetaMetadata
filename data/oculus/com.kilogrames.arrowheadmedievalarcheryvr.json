t-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_5136774086399077_5860152697619475301_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS-IewYAF0UQ7kNvwHbgDqP&_nc_oc=AdnhiyrGMvLjhMQG8sOLu0Z858fiFVJ652_8dPdJ56_t6Xq10BIXYusXWhcUHLbAA58&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOfSDCv4qjRbtFLCwDZMos09e4O5tuBoEPFknbWeuRcg&oe=69AD719F"}, {"file_name": "Screenshot3 - 2560x1440.png", "id": "726582605202649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_726582608535982_8475006094115199909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e9TulLpUMcQ7kNvwEHN7Se&_nc_oc=AdkKpxxI2nPwlJVA3pICa9FIKirdFxUWtUsnvNOVcY2avdhbOMGPS9Aq48ftXsgp_k8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU5yFYbfEByQ4HvaH5gpYr_vW1aE0rC1hVTNsvwX0TDg&oe=69AD6F61"}, {"file_name": "Screenshot4 - 2560x1440.png", "id": "714600619570063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974680_714600622903396_1273069376198343469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ux7Cih6TMEQ7kNvwG_8Uun&_nc_oc=AdmmPtXgRH8reNDzvHsUVBm1_4UNkISenhyN5vPpzIQJwcdrPpkjQ9zlH9Bav1BO9hg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbK9zoygCULi0iasCnjp6L49pg8GdntA68JAb2hxeGSg&oe=69AD64A3"}, {"file_name": "Screenshot5 - 2560x1440.png", "id": "5506531752741837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_5506531759408503_2265239503555799204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SBXaTGgdmAQ7kNvwF-16pY&_nc_oc=Adli3cJYHBKVMJb9hSxuAJTaEVpU25fIDA83EXwnfH2b8CqKQl_F--86LfQuih_wXc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYCBfrQSouTqWgrNpA8Z784H8Bom_1xVWZD1-y4epzqA&oe=69AD777D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1017956389769984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974832_1017956393103317_5876993711808068677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1YmxSFuxp4Q7kNvwFATtdV&_nc_oc=AdmqZVleD5aHVnQEEQ8h5LGqXWCxq03n57pnBEfNsQocwRdHsVOu6RplHgI8rcippAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFRKxmA2onYGOSolGfp1wJaqUtRXIa4WVze8M7AoRfAQ&oe=69AD60B1"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": ["archery", "bow", "arrow", "medieval", "sports"], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master\n\u2022    Advanced options to fine-tune your archery experience", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_a
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7E4IXzA4lL_yR6l0WYyaHnwZbLKgVhtmUQbT9x2fnUg&oe=6B07140E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1246076232558533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223481_1246076235891866_7104691615773776988_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcOG6KRIvPkQ7kNvwGP_rUR&_nc_oc=AdqVorBPo-u5aL3s4l0R83dAfMrZ70I8f8LFxJ1UaQ65o5cTKp-qgCS0iYWvj8h2ggQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxXuR0qYJfmOf-lYLoo1spO3HpWFXz_ALbCO3NX6yQJQ&oe=6B070A52"}, "display_name": "Arrowhead - Medieval Archery VR", "keywords": [], "long_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels.\n\nPumpkins, target stands, shields and practice dummies, static or combined in intricate moving mechanisms will require precise timing and accuracy and provide a unique variety, where no two levels play the same.\n\nSimple and intuitive controls, stunning 3D graphics and realistic bow mechanics will immerse you into the atmosphere of Middle Ages and offer you a chance to show your true skill.\n\nFeatures:\n\u2022    Polished and realistic archery mechanics - arrows travel fast, following a realistic curve\n\u2022    Stylish and beautiful environments\n\u2022    Variety of archery equipment\n\u2022    Easy to learn, difficult to master", "short_description": "Become a master of the bow & arrow!\nHit all targets and waste no arrows to accumulate Stars and earn Gold. Buy new equipment and beat even the most challenging levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kilogrames.com/arrowheadVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kilogrames", "support_website_url": null, "website_url": "https://www.kilogrames.com/", "category"
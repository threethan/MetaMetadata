0WBPAtzP82ziZIKbyCiDXU4yNJ9umZlL6gotna4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hUIwwtDJvW-MYsOqiyOuG2hoOHiFQz6ALOTpFpIDsvg&oe=69FF5325"}, {"file_name": "3.png", "id": "825624429097595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_825624432430928_232408131441567731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tpLtEvjyMgQ7kNvwFJ2VTp&_nc_oc=AdoAg9yTUlN_dyFT7egl-E5NgVC8a4Sh2-ioLS0uHcj1koYDqOCMeunc_rHGT0vMXfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40W4Qvj6bJAegPtp81yg83SLlV7pfBr9zAN8D5jf7wNA&oe=69FF22C7"}, {"file_name": "6.png", "id": "962912154800701", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375088_962912158134034_2297803110696232507_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goyrm4oUkQ4Q7kNvwHWgNDi&_nc_oc=AdqVEl-Aq1eaih4E9nKeM3pU_2B1n-HTdM8jv7E-RTl2iHqzKIAqTKL75WLcpCerYGM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xnH3o8_Udc9KD05M4k4cuGCrsKNwC3YUg7z8AJ724fg&oe=69FF2D89"}, {"file_name": "1.png", "id": "634577291814563", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982593_634577295147896_4258915715040137912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGA1OMy_cQgQ7kNvwEcm0Q9&_nc_oc=Adomc3EAq0E3qaAoQdvjix-SWOnuiApVZJ5dSNYYIXfi5ey2RmAxdmUC65NwSK2XSMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61ndRvhriAXSCZND15TP3ayDU3KaSyRNrfpgBh9p1Tvw&oe=69FF3603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bike Attack Race - Bike Racing Game", "keywords": [], "long_description": "Bike Attack Race is an offline stunt bike racing game where you can become the ultimate street bike warrior. Race against rival bikers on dangerous tracks, perform death-defying stunts, and shoot down anyone who gets in your way. Choose from a variety of bikes and tracks to challenge yourself.\n\nIn Bike Attack Race , you will:\n- Shoot your opponents with a variety of weapons, including pistols, shotguns, machine guns, and even rocket launchers, to slow them down or eliminate them from the race.\n- Choose from a variety of bikes, each with its own unique stats and abilities. Some bikes are better for speed, while others are better for handling.\n- Race on different tracks with different challenges, such as narrow paths, obstacles, traps, and even other vehicles.\n- Collect power-ups to help you win the race, such as speed boosts, health boosts, weapon upgrades.\n- Unlock new bikes and tracks as you progress through the game.\nCompete against other AI players from around the world.\n- Bike Attack Race is a fun and challenging game that is sure to appeal to fans of bike attack racing games. The game is free to download and play, but there are in-app purchases available.\n\nHere are some of the features that make Bike Attack Race unique:\n- Stunning graphics\n- Realistic physics\n- Varied gameplay\n- Customization options\n\nIf you are looking for a fun and challenging stunt bike racing game with a lot of features, then Bike Attack Race is the game for you. Download it today and start racing!", "short_description": "Bike Attack Race is an offline stunt bike racing game where you can become the ultimate street bike warrior. Race against rival bikers on dangerous tracks, perform death-defying stunts, and shoot down anyone who gets in your way. Choose from a variety of bikes and tracks to challenge yourself. The game features stunning 3D graphics, realistic physics, and varied gameplay modes. If you are looking for a challenging bike attack racing game, then Bike Attack Race is the game for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
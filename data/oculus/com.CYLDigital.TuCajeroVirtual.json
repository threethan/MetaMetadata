e_name": "Captura_05.png", "id": "876976094751153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819980_876976098084486_8050200854791426043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E13Ma_HKo8Q7kNvwE5COWv&_nc_oc=AdnhbrsB-DTiOWxSCNYmJEDaR8DvLFCAZ7i6UvNMCNps5sUol-DpXrC2Q-we4vtGr5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtuv1QxfL582_5wgeSLIIDqRl0HkWU-CnV4sT3VMeCVQ&oe=69BD4282"}, {"file_name": "Captura_01.png", "id": "1172632434982559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825575_1172632438315892_7991019674834641222_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpXgCtpILDwQ7kNvwGo8r-e&_nc_oc=AdkWv8ZTAtm6JfbQTKyYvQKv7SEevjFjaFIfuQiYIjo57w6J2iX3cHbrqI_mRKQNDKI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww6lRKTjLzRzwrnS-0sWBtR9WxFIuCCLOoywHgf8-YFw&oe=69BD41C7"}, {"file_name": "Captura_04.png", "id": "1055710183307201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820141_1055710186640534_3071770350064012861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyEksjCIEVAQ7kNvwGbu4XM&_nc_oc=AdmdjcKvlAgdD9ba1QZ1P1LVtNiiA24abYU79o8UZClG4l72izmfT1BF-NZlyxez-_E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfybBMyYKRmfk-9YDJV5l1dyao9zvvxy4duvGA69M5cCOQ&oe=69BD2BD7"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF_LJYt2LbwQ7kNvwG9o073&_nc_oc=Adkp5q2wuMupXAbgu867ZPVY-CkJ1JI0UPytVl5ZbhSLegjuBaMqdIppVH03qy4cLO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRU-Fi0JGU-HT-CyrOv55SXaGHmltNm2jisjFDxVpliw&oe=69BD5E3D"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL-Xkviizl4Q7kNvwFH2YRE&_nc_oc=AdnA-kJ56Rd0klPghX_9MnaJCV_dWtjyEEa6J3MmmztGG4sCDkhQCYB6E70ukXS8ABI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXm_O0fAlxDaYQ3ZA-FZYa-uIe4jshuprpiHFtxdUdHw&oe=69BD3670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQiLvK7PaO8Q7kNvwEvevnI&_nc_oc=AdlZTFsn0ND-QDPHr05ia85GohB717X6Tf0sgL8DOhkywhBCyLvWvaL3TCyM1UuxdN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPz-vrDAF9xjpnE1PjnepsbspWF8WuOy3sQ7939YF2_g&oe=69BD3B4B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app.html", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26056664523990234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307479_2163919034138320_5503963672134840084_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPCkD_Cxf8MQ7kNvwEO3fsv&_nc_oc=AdlfUEgOshutRjTeuRw0wwPVO_rjlnF9SEspYFfkpTVqP-h-WJh0meUQWOEn9OlvBfc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8mxE41A8gLaMRGpxLvBe9u6YNP8v29G_H9-IIl4oY5Q&oe=69BD5567"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tu Cajero Virtual", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_da
e7a0a&_nc_ohc=FPIK90uttQMQ7kNvwGdusX1&_nc_oc=AdqykYGLMpSS66qfghTkz7FtpvVVJZ8MhDUa30tLYiDlGKnNKI2lL7H_vBoNKnXP3zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpFsmft9Of91aijjJgeYtxGK3OD725JIAR2YwMdYg6Iw&oe=6ABBD597"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq_GmAftxU8Q7kNvwEHUbF0&_nc_oc=AdqAk-_ZAJhXrqzghz_-mgooWKZO9VywiXU2m4FB45N8-jFGKfP_g5RBR2pkeyvhJrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOhLdoBBiH-KZSktE2JGfEl0Mpitwm0GoOPLlCnpGrWA&oe=6ABBCFBD"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNjBqMuPPRQQ7kNvwHwSn1x&_nc_oc=AdrGAD4pszh0S_t9yxWpN3mtTkzlFnmoJiW8i7nv8D5HTtQwfQZl6F5B3vHL3Gi6rLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiP894g6KPcom1I2LfO_gQuocOCx8t1y6ijqGEzGoWIg&oe=6ABBE030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDZqzz_qNyAQ7kNvwEfd346&_nc_oc=AdoaLiDo_uhZOUmiMZLLrjdve2fZDefLyYk5hxu3Arqw6JuyIihBF13qu7-5-jZp3TU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiLJruezyhKaNU2uRiumHWV_dh3Gdw4PooCtwveH4rmA&oe=6ABBE50B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"
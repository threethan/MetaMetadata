e_name": "Captura_05.png", "id": "876976094751153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819980_876976098084486_8050200854791426043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOT-9-cwAKgQ7kNvwE_qGtz&_nc_oc=AdmG3QkiHu8cstQNHkjkYJeeDi_dsU7kI_RYPaW5Xawg-5PMnLVDp6iPlDV02-mEIrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsagnQwDd-MiBgBmIwLDtVrnSv8_rew5qaDJkoiWsM-g&oe=69B7FC82"}, {"file_name": "Captura_01.png", "id": "1172632434982559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825575_1172632438315892_7991019674834641222_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC6-5CoM-DwQ7kNvwEW546T&_nc_oc=Adm6WKiSdkThaswn4rUmvf9GS-7f4LSStlNH9AG88g9bpl355-R2VOSdN3kXIyo_jVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRDnNep49KLofckI3ry1o1mNpsjhWIpWuETy_hdN-PEw&oe=69B7FBC7"}, {"file_name": "Captura_04.png", "id": "1055710183307201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820141_1055710186640534_3071770350064012861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QucL2BTe18Q7kNvwFEew5F&_nc_oc=AdkOLVetp2vUhMq3cCZruzmjPie-pXIrZiPPyWlcQv1lKpNQMdPrS3hoerv251KpHqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwH16Nrt_gTxop9LAAu9zskvpPHh7admr60F5kaz0FFLw&oe=69B7E5D7"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOH1pooXtXQQ7kNvwHTxP7h&_nc_oc=AdnH-YHJc_dm8XLvXuEa-YDATUEj2rFdySu55cKyw8YojYjlaIjnjDCmdGUBsow8oAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6RslNLAhC-u1ziORQr_SY__PyxsYX2fHBFp9OHZmdDg&oe=69B7DFFD"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0MdJyPF018Q7kNvwH0NHM2&_nc_oc=AdkSIbuni7JknZpnDc17Hz1lcUIQg_mc3kcYIHRoZHK5PmjSLotBygj2_3ovmG91U58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5Byojo7ov_iMxAHausLwgzlX9G0sH_h64YP66Hpy77Q&oe=69B7F070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReJxurT4JwIQ7kNvwGWvBs2&_nc_oc=AdlwslGtE1TygA4Pbje7nW6_-sXEgBZAfZ6ETxITG5cFyVsch7BPvIev-jUHuzVuPjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfygDfJfLN_5U0FBEg-zQW3LOucnOfBZVPrDrzzqkfnJSQ&oe=69B7F54B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app.html", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26056664523990234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2163919034138320_5503963672134840084_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYD8slyBlG8Q7kNvwHgllNS&_nc_oc=Adkbe5rFw76Fqsyr5Gr7TYak05i7nATeuK6n0oimQRE7pFRuvQwGdQtTmkUvzCwnqaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8J_6QS4WDMTty4qNg_8xurlTKXfvu2p70xcp3rCYjiw&oe=69B80F67"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tu Cajero Virtual", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_da
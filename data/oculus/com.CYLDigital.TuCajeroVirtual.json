kNvwE-fpCK&_nc_oc=AdpfpAnuAp03C3vVEak8AKYtc2_lt1nnCVe9XZocdNSbPU2tbdrxI4840yVr-h2JeXo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwERK-Qrsi6aw7siZqHTbCPoCmq_GR9HasWdx4dsyPaCA&oe=69C51F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRh_09pcx9wQ7kNvwGGL0W-&_nc_oc=AdofJbjR-JMok321niTpTCe9i_-4ANuBXXCSa5UgqX2joT9-wxzPOWbc7c5-0p93VvI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrRpBkXSkzbFJ2BFg9aEkwIP6qUb3mI1JdEvMgFQ8jEA&oe=69C5244B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app.html", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26056664523990234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307479_2163919034138320_5503963672134840084_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6_z2v5eNq4Q7kNvwHuYcd5&_nc_oc=AdrXPgD_ZzbsMH220ztn2Q_V_JeoZcfbJsk4G_cH65PsmKHJrr6JQ6vYUQcLJvPwZ5Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwENT3O7u3OuE4f10b5819t2xVFau9ZXqpA0fyacRsutA&oe=69C53E67"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tu Cajero Virtual", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Le
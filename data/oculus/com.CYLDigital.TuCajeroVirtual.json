_5HYi50McRWj8Td_RrSiI1nfIrUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwee9gZR1jZFii6japoCxMye9upyEq1L-1mR5qCVAeRcA&oe=69AEC147"}, {"file_name": "Captura_04.png", "id": "1055710183307201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820141_1055710186640534_3071770350064012861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1MtKyFMeCkQ7kNvwGB26M8&_nc_oc=AdmBuWIrBT1kfwubjIPh_byLR-1cjTgmtyDFnDy0c1VXq3UTyUEsxMoB0XPtNy15O58&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW3F5Vf3Is74PqYAJxwjgLP85hcgL7DrkpMtTUM8TZ4w&oe=69AEAB57"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpXxASgvr4sQ7kNvwFckaM9&_nc_oc=AdnFY3tRYBdbjpG91_9GNGCdIkaBaAjc05jqBBTXnUnElcCu-ugR4d81ALPSaAdbsOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx5fA_FJ91CbbVNJqT94d4sENuJFdmfLjT8OgBX93dWg&oe=69AEA57D"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZRSlqPz7hwQ7kNvwFwz-0d&_nc_oc=Admv1hq9JqOmgcWUvslQrBDKJ_9Na8M5iFm-Y8msXXIEOSBA1eYtTVIwD4x3ST5UsdU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGzxqE2EoLOn4yZ5P4oQO5ARBT-Bk-aMxmUGyI-N7zzQ&oe=69AEB5F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBaHgK_sdZcQ7kNvwGwxI7l&_nc_oc=AdnaYN_Nfy4IgiZeSBahmxDVZsyNCsTG7ImIWrmEnLehG_8p5T0M7bA23IRgA76NVVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD90hMxEUH6fg391nt1sSZyt05fNTjjIwam_BiBqPfCw&oe=69AEBACB"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category":
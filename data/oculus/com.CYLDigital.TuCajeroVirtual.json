aOlz8WmIO4RmyzJFGkj7jk9gISO9w0YrkSnC6QRI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxedtIT-BU906doahjJm4ztmYmU_AwKaOFm1RFI2_jNEg&oe=69AACCC7"}, {"file_name": "Captura_04.png", "id": "1055710183307201", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491820141_1055710186640534_3071770350064012861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x98B64XR7u4Q7kNvwF-wRpB&_nc_oc=Adlq58kjfpOVdFbJ5EKLR5XoARTxe1yj_OhLRLPVgz1biwtalRf3Nv71rO1_i4SGW_o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGKnXrRIH4yngx8jEuI2x2EXhB9vn-ESqeCUsJ2VBS5w&oe=69AAB6D7"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_fJ4Ya-yeEQ7kNvwHFRdrJ&_nc_oc=AdlK4yrwy9rL3Brsl2ZSUcIK0r4LxNIbwVphoto2oE-yzMnwCq0G8fmNhmCQ37GV4kI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfytPjJYUc1ojhUBd-1ROywOsOG6lTAgqW719zF4Gsc6nQ&oe=69AAB0FD"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdW6gqQcKDEQ7kNvwE-16EV&_nc_oc=AdlVI2ME3Wp159RfS5VoN3jPw5yQYfIY-6oreW56myTUhDl_vPil-ms2te0EBTw0Hw4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKAGvD2TQRgfG0fkSX6iPqNVdj6tYEg0u926StaY7_Og&oe=69AAC170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3X8otFAebwQ7kNvwHRhcfg&_nc_oc=Adly26ra87fSO1Wp6syIR2x_PUTeSjGb9-ECUFhPgLJts0o031y7vuUzTmC5PbJSr9Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx90Cj_SzHUOmeYuT4BmJpRoRapBGcYmXwCKCQ3S9RYhw&oe=69AAC64B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "contex
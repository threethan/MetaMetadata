e_name": "Captura_05.png", "id": "876976094751153", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819980_876976098084486_8050200854791426043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOT-9-cwAKgQ7kNvwHQ8SPU&_nc_oc=AdlihzEIi1DNO5Wr7JBnASw_JaPtV9Rh-TZnRh3mHLWJbrHJGjGdHcjiQreMbDYxsP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz34Hu3m3F-g2-23l_qKmh-4R43FcB4G5EnSWQZtE9kBA&oe=69BA9F82"}, {"file_name": "Captura_01.png", "id": "1172632434982559", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825575_1172632438315892_7991019674834641222_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC6-5CoM-DwQ7kNvwEomWiX&_nc_oc=AdmQMplJJKPRuwwNjJwUAuFk52gRD4VqkQBf3DFV5tCANo8eGPjL_m82lf0x74duH1U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVAHfP0UgkfnyJKTzj-e54DPsRiT4CUwiTxnP6kiOttw&oe=69BA9EC7"}, {"file_name": "Captura_04.png", "id": "1055710183307201", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820141_1055710186640534_3071770350064012861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPdiRHuvefEQ7kNvwH_3S4h&_nc_oc=Adlbge0Hcg9owBKw9RgekhOv8eDxlnZfxS8dg-Il7YzfKfz-utSAbJdEkpeNIpGRyxk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxpxDm43nXGN72YalQA9qb_5t2AHR5qlBPf-rqqVsusBA&oe=69BA88D7"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXENdiLRVQwQ7kNvwEliDQh&_nc_oc=Adnpk1VP5MNQ2D_QrLKRSoQHSP-t-GeCtSywhdbFg6WB163IYXPB_pmDgPozn6gkqJE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgiEC4wfCU7T64_u_hxACvMDoBU-MfFrDmAgaUGe7n1A&oe=69BA82FD"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0MdJyPF018Q7kNvwFAab9Y&_nc_oc=Adn9hjDLbovX3_a2jHQ5JQK5efFQgTUJN_BEfCIMyfe1rm6M3Qnk44Ht3RmrKtI0VRQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbbpedkIkp7N0a_YPLUH0JXCU05R5NWFnCr1mQa1eZ8Q&oe=69BA9370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq_OmFwmfq0Q7kNvwGpa6fo&_nc_oc=AdlHSTUa1L3OAqDf4SMQ6lTic6qoQV1xrScRgbSn5gHf3peqd5hV9DxDQX3L6R5LMOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoLPDpp32GPhqKTaVZfb5TG6SQ8PykAScVeCaOipJ47Q&oe=69BA984B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app.html", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26056664523990234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307479_2163919034138320_5503963672134840084_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4TLTxgjPZkQ7kNvwHqnixQ&_nc_oc=AdnSpfNIz-8qfRdrZs0A9aiTgyY1WLN5j_gZ7Qi4-z8dHj914dUh5C2orDSItIaaIZk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc4g867diVHH_6K7QFU_kstpUf0J6u7hXrtZphizOTnw&oe=69BAB267"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tu Cajero Virtual", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_da
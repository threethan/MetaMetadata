e7a0a&_nc_ohc=McFXih9QkwkQ7kNvwEArdZV&_nc_oc=AdrGuA0MyJAquuJKx2B0yFZjW73IcN5zCy2FwWr9N_GH9IIwNOHwDyL0M7rPncpEcC4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fSBtPzOq8eYljSMwkFIn86xDDOnYXKDG6NmfiED6UBg&oe=69E64297"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwn0MldvlQoQ7kNvwGpfMHI&_nc_oc=AdrkHC2zkaVahV5TR0xpAXAwgK8vrxrznUZRt2-hgLH6_8DLkGFJgcvpJip02YcOv0s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f4ClajF5489Bn4Yhj_niKlGOMbEcoPEK8aw7qc7f6gA&oe=69E63CBD"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2LPIiAgWesQ7kNvwFDJWZ6&_nc_oc=Adoi0gEGTqAXPHIXrkTEoUhMjO48LXfVsC3KgM17OxhDH3ErRvjEene_qHk9Yu5aHxs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ksDK8gmUpBrgT_jV3b7BvtoKZu2JhMrc4lMC56V7JtQ&oe=69E614F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EJF5QghByUQ7kNvwHAdIcu&_nc_oc=AdopJP_FSX2erg9qiZlQQMs3Vg85uLbOd_JgxNMdsCACWCg1BiUzWwxBEbKstb_MnmA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36cKprHQF6z5SiyIBqsr0Wwr7WP2EfNTfX6cyvyxcB4w&oe=69E619CB"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"
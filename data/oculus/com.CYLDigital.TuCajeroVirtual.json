ura_04.png", "id": "1055710183307201", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491820141_1055710186640534_3071770350064012861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z62UkucKZYEQ7kNvwHcE1sg&_nc_oc=AdkRxVgo4Mv4VvEL8B5hhV45YBdF82lvPapQLG9SvEf53-AnxpQHQVqMFp7WEpYx91U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftUNEsDCWPeKelhxKOkYhahnIQokL69AF65dlXc1pUECA&oe=69A17C57"}, {"file_name": "Captura_02.png", "id": "1529645664985500", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823286_1529645668318833_9107217559624098403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNiDUZi3YBQQ7kNvwHGqB7k&_nc_oc=AdmCjK6DCtt3-Gcf2l9JZc9-TTuyxl1ojC3l6yVYfw8dzsI1mNCRCstNKIibNDQCdoc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftuhbPUlpv9CsLUbmgqTr31RTi0IOnpeLFdd_X9ogScvQ&oe=69A1767D"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdyNE1MHZeYQ7kNvwGR0ZQN&_nc_oc=AdmDZ_Q3q7tnQf5ExE3lhtnP2xrpK2RPpj5b3SHzyGEr41yY_AiRDfq5EqfyWAy_o1c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsHs6BX6yAQsbaSTUOlo48QV93R3CkswDABsVmpWyGgHg&oe=69A186F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQjnm5z4NfsQ7kNvwFZlM1l&_nc_oc=AdlFV_q-M7pGRHs_VBcy-q5MzwJGZnGEQ0g3qu5y516iaz8vTHneJSkhSAjFE_SuADk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft4IsrEilkjVe3WFbowNj96NpBSihqSp-GpfmA8ZvAjpg&oe=69A18BCB"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT"
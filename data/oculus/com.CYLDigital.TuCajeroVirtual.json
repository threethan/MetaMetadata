zyMS0BK_ZurfrRZ4tWidzEz8BcbA49enw&oe=69A05D3D"}, {"file_name": "Captura_03.png", "id": "1400295501766199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1400295508432865_7820209685786897037_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdyNE1MHZeYQ7kNvwFnZE4d&_nc_oc=AdnSK5cK4S-ZAqWs2J5kOV1AHJlvaimHBcpi_WUFoP4nJDYVjQo27VvWQ9pxjyC5FBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsn_X3FuS4E74i_imIXZsXnKP9hK1z-2uPjtNLGNvGpOg&oe=69A03570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MiniaturaHorizontal.png", "id": "776981608203653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_776981611536986_5277102562661181893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r7o0XTXfeQQ7kNvwEv_uZq&_nc_oc=AdkXusK94d-teXYgViTYixNOdEJO7ASuhs-GE0en1V_QYPG6d49DRDWWi1BTZY_-h3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsU0xQCMlcLhn6lFu0yeAA9kHpSRF_RPutJeKOGK-rxqw&oe=69A03A4B"}, "display_name": "Tu Cajero Virtual", "keywords": [], "long_description": "La Junta de Castilla y Le\u00f3n ha desarrollado esta herramienta para aprender a utilizar un cajero autom\u00e1tico a trav\u00e9s de una experiencia inmersiva, segura y pedag\u00f3gica en Realidad Virtual (VR). La aplicaci\u00f3n pretende fomentar la autonom\u00eda, la inclusi\u00f3n y la confianza en el uso de tecnolog\u00eda bancaria. \n\nEsta aplicaci\u00f3n ha sido desarrollada dentro del proyecto IBERUS - Smart Comunidad Digital Transfronteriza (IBERUS - SmartCDT) aprobado en el marco del Programa de Cooperaci\u00f3n Transfronteriza Interreg Espa\u00f1a-Portugal 2021-2027 (POCTEP) y cofinanciado a trav\u00e9s de fondos FEDER, cuyo objetivo es profundizar en una red de colaboraci\u00f3n entre administraciones locales a ambos lados de la frontera para la transformaci\u00f3n digital de los municipios, aprovechando las ventajas que las tecnolog\u00edas ofrecen tanto a ciudadanos, empresas y administraciones p\u00fablicas.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu", "short_description": "La Junta de Castilla y Le\u00f3n pone a disposici\u00f3n de cualquier persona una aplicaci\u00f3n de realidad virtual para aprender a usar un cajero autom\u00e1tico de forma segura, inmersiva y pedag\u00f3gica, fomentando la autonom\u00eda, inclusi\u00f3n y confianza digital. Forma parte del proyecto IBERUS-SmartCDT, del programa Interreg Espa\u00f1a-Portugal 2021-2027, cofinanciado por FEDER, orientado a la transformaci\u00f3n digital de municipios fronterizos.\n\nM\u00e1s informaci\u00f3n en www.iberus-smartcdt.eu"}]}, "developer_name": null, "developer_privacy_policy_url": "https://t-enclave.com/politica-de-privacidad-app", "developer_terms_of_service_url": null, "publisher_name": "JCYL Movilidad y Transformacion Digital", "support_website_url": null, "website_url": "https://www.cyldigital.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25800865209570168"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307479_2163919034138320_5503963672134840084_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ9JmKDrFX4Q7kNvwEZMAiK&_nc_oc=Adln1-t_HpND9zTcrj_cBSbsXEo2pIXEAHyZ4TcE3ZQ9rxavtI6Z_hORim5RD3w3RAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuLUOcjGz0MLcd6_cVPTxBEoPy1y53Cy8CtUb2IsGrmZQ&oe=69A05467"}, "is_concept": f
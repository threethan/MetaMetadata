 jungle out there\u2014will you rise to the top?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/74c36ae2-e47c-4a1c-a5cc-573745812305", "developer_terms_of_service_url": null, "publisher_name": "Skibidi Studios", "support_website_url": null, "website_url": "https://skibiditoilet8.godaddysites.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7876543249079986"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7876670199067291", "version": "1.1.43"}, "id": "1637777573424247", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7876543229079988", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7876670199067291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1637777573424247"}]}, "change_log": null, "created_date": 1714530649, "id": "7942181159182861", "version": "1.8.53", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary
N7dnOK7hWCRkulIc7sodfuKeLCI8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJzffrSmp1TuPk_L9tquJtShpo2fONJpa8u3K_kiJ5UA&oe=6B05B608"}, "display_name": "Funny Little Monkeys", "keywords": [], "long_description": "Embark on a wild, gravity-defying adventure in Funny Little Monkeys, the ultimate fan game inspired by the heart-pounding action of Gorilla Tag. Swing through towering urban jungles, dodge obstacles, and outmaneuver your opponents as you navigate a vibrant, neon-lit cityscape. With intuitive controls and exhilarating gameplay, team up with friends or go solo in this adrenaline-fueled race to the top of the leaderboard. Are you ready to unleash your inner primate and become the king of the concrete jungle?", "short_description": "Enter the neon-lit frenzy of Funny Little Monkeys, a thrilling fan game spun from the high-flying antics of Gorilla Tag. Scale towering cityscapes, swing past obstacles, and outsmart rivals in this adrenaline-charged race. With slick controls and multiplayer mayhem, it's a jungle out there\u2014will you rise to the top?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/74c36ae2-e47c-4a1c-a5cc-573745812305", "developer_terms_of_service_url": null, "publisher_name": "Skibidi Studios", "support_website_url": null, "website_url": "https://skibiditoilet8.godaddysites.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "us
://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LLRjzargo0Q7kNvwGWP2Ry&_nc_oc=AdqPZr6scH4KA5x2yZKfQy3mTuhdTpbXmI_v7eUtbg1u8jX1v2sc5WFn5i64-s9LujI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDD0zYYbPFDlVmBd4wVvGVuSzsu_EmyCmTF0XHk2Y_SA&oe=6A7C5985"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxyVP8Ni3mEQ7kNvwHepfgs&_nc_oc=AdoEmN74F9rfVDnUR3wMfvqUzeLp2FgFLoqOehKpaFyaA8gLp9ld1e2IOxjooMHcYpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhlRAsjfKK8brnqHJjpxoAM-5uLk8KFYG_b4ClvwoMSQ&oe=6A7C6685"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-W3-pjSj34Q7kNvwE_kdl0&_nc_oc=Adp706e6uABYG9phSL_ja613cImWCDufxp_Dd_NMJLjNvIyC5HGOMPUCeYdon0boqPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhDWamfqrGZxmdfLZdsLROlZhgvmJ_tAwIv0D9P46hbQ&oe=6A7C5A8D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_PuusY_2WMQ7kNvwElPew5&_nc_oc=AdrR28DAtjtP8l2hXLeB9RnmxlqgeM-iMARQh9GyD4bAw1qXKtN3FOqaX9hhEcV0bfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU6rhvtbUmTNTUjtbrW0815Dj0bebPdVg05SRADapaFA&oe=6A7C756C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dX0Ygq6mZIQ7kNvwHtQpN9&_nc_oc=AdrgAwGfSJAOghkSufu4FzOtAVYK4XBD1k7CMj1ThrQtPD0TfuKg25XazYlRi82n1Fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGfT7UZoYOfQuPbP5-5rvjZ8dDDuz7MZcrLv-5wCy_g&oe=6A7C4A6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQVxv3lenwUQ7kNvwG_GjnU&_nc_oc=Adq_r7_vyhpsLZSD_etiHNT0xC1yFCkphtMkUv-Nob9QguuPC2iUWkaMaZjCbar2B6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa__VYm7vi99_xeZBIdIc7qbn4FZ8RQnHgqUOJrapBdg&oe=6A638545"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUIJjJLBO4sQ7kNvwHG7ecO&_nc_oc=AdoDv_3ZGbPl5TuYgV13Se8LZdN9sUu8qgN5jXWbmeXdL4RMUmeRGPITpUQisYmMIDc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6N1r21JBlazmICwKpK6lMwm6pBHBIRKoEGG_OXw4udA&oe=6A635A05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R8YZ7rh5pMQ7kNvwGNyZ6g&_nc_oc=Adr1DoDHqGVCj1L6SIraANGoehZJoij7THgNlDob1a3KPZwi3jFfHS8RWYa0uJSug_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXTlLAffzRpQe6ntZZqJi3zXe4sN2Sq48CCUoZGA8WXg&oe=6A63864D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFk1qxI22Y8Q7kNvwFKaPvw&_nc_oc=Adpu19yTay8Bw2fUYtHwnTu-cHqVS2BdXtUFkNs73sPKEq9f2N10d5JS0kUuaOLEMqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF7mNHgEJ04JSGR-pINR4AWRAY_asn-TMIdmU8WJ_S5w&oe=6A6368EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBUg3XarM9kQ7kNvwFJCsKU&_nc_oc=Adqrg0HWIZ4WbdMknPsT0gwfKQiuqy0-dSaxWorN9V5ZzB3ajY4p7Rys1qckSr-WftI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBScYL2Hd_PYvEr91gaImc3BcIuDN0andhSOFuq35CBeA&oe=6A63762D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
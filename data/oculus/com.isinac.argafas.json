://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mWZgEi1GoMQ7kNvwGkjWpk&_nc_oc=AdoElO3GFDI8RdBVGdL9b_8orW1h5c_R9TzG9xIu68Yql9KMrqfrszk83O_5GQU5xOw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbylL6mAhqrEyjOBazAJvVI7csizMFYIZ1je1tTdF6Yw&oe=6AA02A45"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMoNjSrVADEQ7kNvwHF7taV&_nc_oc=Adp90cGki8fV5rKwLLW3JNNeEHu_2MhjN6bFldIwRa83Kr-5u5Y_LDF84MWfawq_x0U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7lKQS_-ZA1MxinzZWlShlURzohPm5SiSkpVStqchFYg&oe=6A9FFF05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a9GsjrZMpkQ7kNvwGv6-yD&_nc_oc=AdrNibwSJCOUDgFi8T19fox2G2ZS2jTYpYw6JJuMpBuAqKRK7qqW81NnbWJywtHXgKw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVKCDV2x5119jy1N-o-wFSTs7gmDaRjhl_tEmlo2UO2A&oe=6AA02B4D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsjqutZW8l0Q7kNvwEYlz03&_nc_oc=AdrwTp05bAGmDQsMt4qlyl4i2KhF85XmhKwmzSHY7gAsakoK14JijEO4ihnWkT0rYA0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI04fu1OZH3H2D5x3EPoRfYANUDSPSmzG5k1ryWNF0_LQ&oe=6AA00DEC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4zR_k1Vj4Q7kNvwEqmOAm&_nc_oc=AdpJ-w2MsfOispu_t1QdN5p0JvKlM0ZFvzAsSexfQqAp9wmYUVyUxjiDbvTct9ri-gw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMnIf_MxilYsWTWfssCk9yB8Tend5KKbvVwhxPAUqgwA&oe=6AA01B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usGslcOhGTIQ7kNvwENM_vd&_nc_oc=AdrsMs11mVx7Jw4zU5gCZrXUjpHMT8k9UnDQCAbPKvLlDxvo6x9taRuGGUjCRPWodk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyb_x3WcFpeE_7hsnkW2ovRQATw_CJ4C5FeTR48oM1Sg&oe=6A6CBFC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCaehsZO4RsQ7kNvwEpCumK&_nc_oc=AdoUg1IroTVudMzIm-vDYeoLtxLHzaceV1wJ1s1b6bKojbfBBsS_LX2Cc417HAg9x2c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8U30Qbfe7D7H7OO7KqHvacg4m6Arr6KFakDREA62OxQ&oe=6A6C9485"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGdAeDbWH_4Q7kNvwFKQCTa&_nc_oc=AdpjHRuW0gSTZImpedRDX3OLgCdCYWWIj_nasCO_7XVqYpwe1s6bWrINgUtd_BMNJwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_PWVlYNTUR5VMrQMY-SE6ArmC-OBuqZghXWccyPptaA&oe=6A6CC0CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5iUTtQ_LTUQ7kNvwFD2XZQ&_nc_oc=AdogF-nlgZaWGbaNli9KZaKS-F6wbDpI5oidqo-qlNp0SL1nThhCT31HRfWA6Dogaig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4fxCVvgu-H5bQdQDHAp5M0PxCVfXoxOLp0VbhmzQGgw&oe=6A6CA36C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN7PiZntDUgQ7kNvwHxl2MM&_nc_oc=AdrsXNFq25hp7FPshNkOI4VHtXij5yeC6R_G9rwS1tC96hCVEqNST6Wahw9-l8V3WKU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcW2Pi55gdo4H9IQmCQfoZqLeF-VAIPjHJmoTabEeCug&oe=6A6CB0AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
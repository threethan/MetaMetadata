://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRiiQY8pgP8Q7kNvwHHTPgt&_nc_oc=AdrzV6Eka4I4zupd8TdVwT7OXNT1zUyDEIQ-fm4tUH5W79fpSedIUByXw3GPUdW7lc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDgLsiPZ3cmhr4A_OphpkgLJZRaiV5zATMGasmJALsfQ&oe=6ABD2B45"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyGMuQiqXdEQ7kNvwELxRW0&_nc_oc=Ado5AlwfZxOemy3C-YGHI5S560zoAtti_MudqAxftXdZO9oiYKwuejYq_9dLqXh2WXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlMGkKo3yJi5CldYkDqyIiPPM_Fj2d9Sx47x20YuJqJQ&oe=6ABD0005"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFXxXisPJBoQ7kNvwEZiXcO&_nc_oc=Adr-2yVWsa-cPqUcXd3oBgiYnv15om8rScaG_ulAdYSr46gJWKSUYgidAewY08gJztM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKavrrqRecALv_XHXvkN10jZByyOFkj316lPSnv5WlDUg&oe=6ABD2C4D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XceQQnv5HgcQ7kNvwHF76Jc&_nc_oc=AdpGqN9EVhnAsBGIQHOM4p7KB222JCr1cPwNfpLJNP_cnoqJ8dmLRgsT9vuFiuPDNbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQaAF69HsHkOGHS4UrOUpggieKMzm5dNukNX5zWg3lHw&oe=6ABD0EEC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7VF1eyvl24Q7kNvwFNKEH7&_nc_oc=AdoXdGjefVe84w5wKsn2b0NVKFDXbYG4j87m2J4EfzWTDH4lBI_Wmr-8tT8kQE4tj38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbUle_H85wvG2943W9j0eBm6V14MoUgBrPWtoo3dF_rQ&oe=6ABD1C2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
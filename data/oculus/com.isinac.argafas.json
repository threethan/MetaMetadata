6071943635909", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFtkGYkuiDUQ7kNvwHMf4f3&_nc_oc=AdqWdKw2Yn3bZIXLuFroUD_wFaPqrY3AgXDJyAU70pOwGUPDM-kgbqxJr3kYmPN4mJU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl4VIM_qipqqHA7dI0e8b3gy_S8NIEl_O0x0VQRbVhPQ&oe=6A972805"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrERaxWlATcQ7kNvwFoxcNm&_nc_oc=AdquTK-ZpfHBVusBhP-wgwXnnEHqznVygKHwSYH4ZlLBvO_0IO3z_6OD1vP33QToou4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRxyBc2ks_whQ12JH3KCga_x80o6-2-6cmAuMcHI2c0w&oe=6A973505"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX2at5XgvBgQ7kNvwGegj_r&_nc_oc=AdqKD2_ai6bYvMf9tW3tiw8z58YMPNKoAcQb6T8Bv-79wAse25qvcMuCWCHEeQZGsxo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeeRdaFaXvkOPZ_zRTc8L3sbW0K4-xeJ9W1-VCjL-QoQ&oe=6A97290D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLZx3Ofw_hkQ7kNvwGX1evg&_nc_oc=AdrxxiamBZ4H-nFel8dEcS-DiGRW9UaKm69IWrJS2bDzl5k4achdVagRq9P947mCSHs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmsj7WnKcKogvjmmhJHf45UAiGzL1V7h_WK1fOS7i80w&oe=6A9743EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqz4zrOFd48Q7kNvwHiD1gP&_nc_oc=Adoa6rHF_1_JqKeidpl1IsBKOPo51n9xEEazuOcbijr_C3iPhSQl-MGJHliyegKWEAw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs9xNidc379vKcdyr2b2IY0ZahkSTwMlV2RFbzFuHzoA&oe=6A97512D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
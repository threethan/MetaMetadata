6071943635909", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCu-rH0prQYQ7kNvwExnISf&_nc_oc=AdpfmvWssw9ZouchzziBGbnsncGYl7TDNC5D1Yp2dZeVS6or1E5_3wwUQzvKmyV1_TA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9Kly1lvyF8IQVuIPQKTZyxJuIsatuYwKZXc_1vN-Vhw&oe=6A917185"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4p3W4JYSaIQ7kNvwEXeYje&_nc_oc=AdpSfGbaQyZFaazpcrT4mQZ_1BWkxUmv4kMu5Za41uYpBxNYG9bVwO_tCcqw_y6M3d0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMdWmHqqpYW1B7up4D9qBgjy5ecTc7-uz48KbnsxT9wQ&oe=6A917E85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMYW-lL2e3kQ7kNvwHXfI4v&_nc_oc=AdqjDV2BVQ2Ao_2s0kylsBgu8RLVDQ8dm-Q1cxTX9PWzeKsDI7Di7VZwtzRpeeQtGzQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECMs-NBoSKDhYIweLsB2oFI3bPC8scxu_5lzvr_Xq0_w&oe=6A91728D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzAjBXVrGF4Q7kNvwFXXm4k&_nc_oc=AdrjTM89QIXDsc2DiDY9bQ9FXrA_DxgftKbGX1ox1o2ZDPgx_gtusbnD83zh7ZRsQb0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXysy1mrO2hNQRObjMxMKTUjTXz8LmaMx-paKWtqjwiA&oe=6A918D6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5kKY_vfP8wQ7kNvwElwsd9&_nc_oc=Adq_a-8MyOZWpN3PCyDG3cy7JxN4vBZ82CRcpiQZKFbSM9KTgnlfUeaB3fRjsxxwbHI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHUGHAPn9BVJUND6kE7CwOT97lCOUnhZb8TG6WPpmQYg&oe=6A91626D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
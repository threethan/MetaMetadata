://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JCITaL7d14Q7kNvwGsmqos&_nc_oc=Adr7VnSUF_5fZnL9Uxf8iiamOnoAM8DnboyRD9Q7ezQwFOuI1xm_zlQac7dwniXQ0jg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxq-_CJXEAFifLsMF7VqwAsbzMRF1feHzilBSFvNVA8w&oe=6A819F85"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgfjypkTtAsQ7kNvwGcLj8e&_nc_oc=Adom56Q-y2X1ky5cNTCMcziI6puBjvtSRnuv0evgmnODnwUDYSgFmIjPoIdNHZtOuEo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHegZxpFW3nePUcdPTsiV1q5EfAslThZS7QJFDeTUFzfA&oe=6A81AC85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUwAv91zKZEQ7kNvwFc1H-U&_nc_oc=AdqDtRBeO_ain-5bTIBk26_Ju75rbKwOmg7aEsuSRwjbXJxcy_AeU71-Ze3ri0h9wPc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyzJZMmh38EHLHJY9iDYE9bDXu-OpoCc9F6q0pcynB6g&oe=6A81A08D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0SCRfYaZCMQ7kNvwGRrV_q&_nc_oc=Ado2tVZ4PMFpIu0GnPAyP2veCPlvf11p2Sv5EwEhn88JN_DmcaMxSPTGYoLKQmuoptw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlQ9vAmgp38oen9cYv9V4DZ-wxCWy4jeRGNRfrl0moGw&oe=6A81BB6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I__-TFBClvoQ7kNvwEyfpRv&_nc_oc=AdoHmDDWF150EhakRbVJa6ybVxxjmxY5iVc8_TqsYezD0YVFqvx6gTbH5dk-qsupt9U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmXDXIIWewmKw6-dTWbeUukp34L0vqtuPe73u6atJpcg&oe=6A81906D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
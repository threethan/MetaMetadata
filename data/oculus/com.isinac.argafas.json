://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMmigvQU20cQ7kNvwHIVU7L&_nc_oc=AdpbPTrxkeu9mmCr-g8ze_8lRQMZfsZUj5SrPgmGt_yv_t0e--8WLHycyY3VKhjVBQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5CixG2C4jIFbnVfdgLHTpU_lek14KJvPS05ckfLkJTw&oe=6A79B685"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxyVP8Ni3mEQ7kNvwHzOkss&_nc_oc=AdpylRD-lGme4WRWixYJJtTivZ8sSGW6HRPbGBNiTGqQfzxUyiBj9v4oOoU2REb_DEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4K5nMjVs02GfRxGQ0iTIcOvCTX_-VEm9w5qRSHIXlIA&oe=6A79C385"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-W3-pjSj34Q7kNvwH0bDyf&_nc_oc=AdomBVh9wNscYYZl5Hc_tvsHLF-XOPyIzP_Ho5KSXuUAKY4LIwa_k3xtCRPmHDimukE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0uQfB7ZPhoXJDEqUxOIhxnOTBuQljFueIkt486FSJTg&oe=6A79B78D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sPk17mW9NgQ7kNvwGCcpuX&_nc_oc=AdrGREkSA2FxPF1L-HNJl1_Lfkvp4rgdmjF_bnJdDjNGc1PUt3nxuTsmGdqkQqnTKF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYA0nNmj-wl-yEJxqBe3rfS_C8cFVeb0RsJnxlqYKlUA&oe=6A79D26C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngywuiRM300Q7kNvwHXGTD_&_nc_oc=Adq-kp-N1LShDLDDZLoXfSMT8sqvRP5X6-TperqGEwJVKlZsKdKNjrTQrqdBp4d8haw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGGVNvvLFBRnMCe_tW0Mtcl6kYI6oSgF717xY-UkkrOQ&oe=6A79DFAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
6071943635909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_PEWpoDiG0Q7kNvwHreaUZ&_nc_oc=AdpxqgKCV4Bxp1euJatHP3WhYWeCFNrcHG9nC6NEIYo7NuFKNx76jIz6qII4HvI5Wmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMmKny5F2F0_VuAhTQpqJN-lKjSW4IrQblmCOT_SS-OQ&oe=6ACFA045"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OuHdwDQU8UQ7kNvwFiI16x&_nc_oc=AdrFrI5By9ygQc4bO7KNSGUAsrCuyWn1w_CNt7bCHf5wtj2cD3KJN13Dy7spMs-2P4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmbOIigqZ88vAo3IRab6d-_sHsopLa-KbiYbT9XiAs7w&oe=6ACFAD45"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONEoTisCl1cQ7kNvwFJ-9G3&_nc_oc=AdoNH2qB4vY6m9FrpHhJNZXen7VTOEANovd2kflWlqs7mkItdEOjD71eETzpdKTxMqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8P16Y_OmrCp3zgawW4nbrnIqfVzgxVyzJ-smoeLMFEQ&oe=6ACFA14D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dit2ewPsaQEQ7kNvwERkK2N&_nc_oc=AdpUeDgRfqkqQF3YliLaF_HOzNvLh-_KoFNHUIWCApTsOCuR9jqvnHD1zA1Ek9tIdk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObiWfzHl08I8Y-goOL66S1-1taI3gSMc8jkYN7AUbDVA&oe=6ACF83EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvKkcaoSgSAQ7kNvwFHVjQG&_nc_oc=AdrbLlGoPc7EFqk5wcZSkt4cU-ImShkKcyCzI1R-oySW_QyTpkg-5wvX6PiDuY-pDyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSp8iMhpj-5Sronds0Sl_v_QCsucAggI0QC-ljvnHpUA&oe=6ACF912D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
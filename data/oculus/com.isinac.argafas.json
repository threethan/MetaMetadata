6071943635909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJNhiVawbScQ7kNvwGz2EO0&_nc_oc=Adp81kAPpRqHlkZ_sylDxg54Lk9g-tVR6itRIl1bXrzgbHn0A2Vva1zuCGxTEBoJ2LQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ96X0Vor7yyFFNx__KpsHiU2H7FlzY78V2RhE1Pzufg&oe=6ABE7CC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyGMuQiqXdEQ7kNvwHfg8cj&_nc_oc=AdqqRaF1a5gPRv-0HhaoKYs09M5jwmxV8e3zG55Z3yDD4CtVBZIp6eEeRF0ehuWE1fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzkht105vIFR76MPy6H50AKxLRMlWj1Q4sH3kdHur2-w&oe=6ABE89C5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFXxXisPJBoQ7kNvwGUH8R7&_nc_oc=AdrwNSFb_2DMexJBwix1r35bktt1N3lEDflCjIvHUq1vnMThYVl1iUhBuVq-z0MsSgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrq4HDmj0qYMGf1vR8cOhGpeiQnhUYqnDKs5wpJ7ti5A&oe=6ABE7DCD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XceQQnv5HgcQ7kNvwFGYZIr&_nc_oc=AdoubpdYpoQ0ozt6Atv89LYQI2cmSyX5bCFJQ-63ArgMtSUIpgBSCmwLsoN9bojXIUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2eDTmwsY_SnlC7R5WubZdf01ukLNlJdEeub5093MLmg&oe=6ABE606C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7VF1eyvl24Q7kNvwHgFgoB&_nc_oc=Ado3QlhkmFr9eSRv6mcPrN04dQsb2z25iPUGSwdZACWPGG5FQ6-JyK7EFqFBdseegT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhLPZuJ6FzI766LlZpoUe0BKGRn0KKiCVGUq1GiteWVQ&oe=6ABE6DAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
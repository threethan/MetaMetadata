://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MSsS_fxIekQ7kNvwEHJGVH&_nc_oc=AdqfQw9cB5B_LE6TjF96CwbWJsuyKowdDYSmSDC4jnhk3z64LO_NB7FKlOyStDYZmrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDiMLKpa2BE8nYJJ8U1bmy1dLnxZlqcZ2PyNKJlN2N0Q&oe=6AAFFC45"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IGjQWWFPK0Q7kNvwEDhaH-&_nc_oc=AdoP_00PNH_Roxhb-tHnBXP8TR6_oUSM9Ssy7r-T4QqZ3uZ0k_zkVQoZ5G6g-xbDVUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3adm6vWLECsdr7BjQ76kq453K3V8Y0oLdnCA6kbSS_Q&oe=6AAFD105"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_oabn9fqwIQ7kNvwGiOwzO&_nc_oc=Ado6NOTs5xjea66PkMTH7wub9tILO1OdVOlWh1-wD59jeLuWDqE9l9Nj5f2kLpvVrP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1OYoK4gLyEBFPm-OiZ6FB77UofYVAgs0hjDJL3r6wRA&oe=6AAFFD4D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh83ApCsU5wQ7kNvwFAhEiI&_nc_oc=AdoIfNgqMbLEeAfrB_qNQTG2qmEQE8_AdpgQR3uuzOlCrksAR7UBVGj7d3D1tDJbxjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTeoHErdKNJwqzmTxC8Dgd84PBD44Gu1-0Ll91MnWG0A&oe=6AAFDFEC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkDbXVqGmBkQ7kNvwF8tMnK&_nc_oc=AdoMVg7i7Fpeq6PMRVPtrA46rTocQu9mo2CAsnPVQka65bd7XQXKk6Vg_BP3mqH9YR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxRjnyEsm2S02yGCFIN2TH4hraO2AD-obs7cxhf2T0ZQ&oe=6AAFED2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4dCKCdMqWMQ7kNvwEG0lm1&_nc_oc=AdraTBG51J9YE3-6W0a2MxcLFW4fS2FYs-jifnsmqrx1Ew8s7YECwgy3MNcQ1qnuz_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOjcPsSoWZHJjxS9k32Hqr86CKthHI4otVAecEOyQVuQ&oe=6AB7E545"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_yiTc8IqfAQ7kNvwE65CMO&_nc_oc=Adr25TVBC5swVtc4fvAgGMCf4IcA81Bqa7RWmKEWwniNciTDtRKwyKjs_V3SKK_5q1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQYqMEFmElv4QL1Ou727NdzRi-w8G6Z4dTO44koLlObg&oe=6AB7BA05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyPsH7UrpNsQ7kNvwFsEFg3&_nc_oc=Adr4xAVnTdDGzg6mRpWtMOKW_FQRSNqsnD7eaLc4MZQ8ZKjG68Rgd9gVS7XPLLbib9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM20nEde45tBYzl7JzYJSX8sadXL_OeXolA2xsAH5kSA&oe=6AB7E64D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eorXzQwKei0Q7kNvwH4BWVB&_nc_oc=Adord9aEbhficT61SVpx4xPiZY2nxQsH6MGEbHgxVtNo8Jj-PDoTBYp9jmTvkx6P9NU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEi2ummgMafJL4tHPD_OcQ_kF-vl3Od9_Qj25QFUVCQw&oe=6AB7C8EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg6c8xN7N_oQ7kNvwHTxlIb&_nc_oc=AdpZn2F7EVUpK9C9QOLz-_WG3ihnXW4pqPfE6nelfNd-K4ivvLbYz23tTc1j_Tn9Qyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOjibyUUKQBwlkhpZZdUP7CUfpOKRXQflm8osRixgMEw&oe=6AB7D62D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
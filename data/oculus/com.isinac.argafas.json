://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fscb_aM15DIQ7kNvwGzzG7U&_nc_oc=Adq2mBxSads7WAmZLwsH_GQSjI4VOtp7XrBNtzpFhulkq3Hz9MKpacgahZXTO4ux4vk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTuv95ebUZulXMrQXPVpFk2oTuQbS9VV2ZkSTWkt-ytg&oe=6A82F105"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgfjypkTtAsQ7kNvwH3Z-9h&_nc_oc=Adoa6Dkh_wMr-7h6GrYeuQ9kOQOHzQHeOfEEHE2khIbkcRY7-p7Qmt63mibkreBYnGE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpuf1DpHK28C_EGuBrX6tC6NizMYmbNf5OsZ9m99RNug&oe=6A82FE05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUwAv91zKZEQ7kNvwEBb4VC&_nc_oc=AdoAi9UoSaOg7lcHBAY88xvI5hkZVDwd_wZGSueTM7ursH4UzeIqKgtVJqSaXq57n8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZLcU-I7F_C6ONPmvmxdLGT_DRFlsO5Mtpja2Fy7kfRQ&oe=6A82F20D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0SCRfYaZCMQ7kNvwE8Y26L&_nc_oc=Adq3utNYhA8LOTn1lmp1k8EuvHTje6UfekPUZIqZWAOp2O2yj1ojmHPMZYAtey2ybbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF82rKcrNma_ivJ1UTs-vgOxFKodSZT2SVVCSOD1M9bGg&oe=6A830CEC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I__-TFBClvoQ7kNvwF1SgrA&_nc_oc=Adp_H3Mxp4wdjKgLKfLF4FLLVWTxN7sYM-zfWZx4M0igsHS35mN981iCnoFi30efGRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERgRHq12qJt2idr7ASOQAkOfMDbDs1H9FhllUYCumoaw&oe=6A831A2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
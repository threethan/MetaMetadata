://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LLRjzargo0Q7kNvwG_6r6_&_nc_oc=AdrNZOpab505wCOVFqV_RN4y-WJoi8O6h56i3bq9Ztge3zsCkx7IeAYlhPwSV-8xnRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtcWF8wdiF_Vn7BJwfDFOCHVXe4aY3uRAdlfVACpUvxQ&oe=6A7B0805"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxyVP8Ni3mEQ7kNvwGx5xO6&_nc_oc=AdpLSzQTzSgbk3dFZfzFZGOfrKlzqX3qjiUFITwPeG80_ksBxuo8NaFQmKs-30UegL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm_MH6SeIEteLmUGC0jq_ZB-cbZV46rBn34cYWws7-Bw&oe=6A7B1505"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-W3-pjSj34Q7kNvwGC8Qja&_nc_oc=AdrbqeO8RwKvIYBGbCIlSz0lM-cRuduM8vurEarXux6UL7TL_CZEjsVC1wEYGhhT9qI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx_RiQPvXES0Yiv5dnjSBfQg-qlbRIiZf6m4YgX4E_Hw&oe=6A7B090D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sPk17mW9NgQ7kNvwHUQFuy&_nc_oc=AdoquLJR66ahUDLLWmrQu7XxrrU1A1uneA3QUjDuEKcuihhdwhe8g0tNHAE6px7r4xA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1GNjdv2GAtyyVryjf5L6exLyjFGvfudXo7Qona2tvIA&oe=6A7B23EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngywuiRM300Q7kNvwHSXlG3&_nc_oc=AdrCYC6MOa7H8I5wVcd4novgSp2kXfD76gnzgQ0o4DKeZwDUASXYOAWIKVzbTdt5IWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWIeHpQu4MabvXg4JA69BXizhN0lUz8JsDWHmziVJNUQ&oe=6A7B312D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
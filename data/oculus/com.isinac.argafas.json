://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH0qXS_eQFAQ7kNvwEZ3q10&_nc_oc=AdpXgCHn6kdFaMChRiPSJ22bth2v59c55aRwunxIbbu3likx4ULlM767avDM4vrERgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEhykS1FJIfagy7RI6HHvCy8HRaWaAAxzmBZyTHrAI6A&oe=6ACBABC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt3-QjEX5XsQ7kNvwFM2_r5&_nc_oc=Adq6lAzWrlaNKnQ3h8FBVn8_spTmx7gZwZr3k8vwepJ5IHvSpdVFyPHhLGWU2JEelxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxZWJ_ovlqCBSLO3CiQfNuLqpRcMyFe1kKy4yxd07H-Q&oe=6ACBB8C5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf45iyVKZqUQ7kNvwGVuiCU&_nc_oc=AdpmzWxTzSuPYs0bEZxWAJqO1XjWhBDNAUepcKcUlhERnbgb4vZRGWP3XuFWsOgPavc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN16k8XvIzjMWwyTsra2m8w31gcg-U_xrzJ_a1D_F0iQ&oe=6ACBACCD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVaY2cI-OQ4Q7kNvwH2dI8T&_nc_oc=AdpUANzteN8HVU-qT1NfMdQDSFD2tF3bNOnVAiyP4XpQYO2WaQFieUtISj6cg6kauHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2RGzDdePBMumWxwKWuAnzH-2S8qRiu-Fi8TKnN7GHCw&oe=6ACB8F6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdLN6R6EssQ7kNvwFJcL3P&_nc_oc=AdpLBgayHBxK4oy6gKeP7paDa3Wm3EFzxjpuXq3ry-lrbQmfDfT_cK7F1YZ22fVEFoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOe3IaYzX4Zqu5U8AKQ2WxTzTtHIpzREFKQbQXJ9Roww&oe=6ACB9CAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
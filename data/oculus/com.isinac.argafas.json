://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fTHW5S-fr0Q7kNvwFUIIbI&_nc_oc=Ado7hMr_EEGR5-0WtlhSqMY9-I9Ha__u4QADCs5I2Feo3HmhuWhNzgBsTDV2wFWyjNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjekQypSOTEOJyfRZspDx1UwNcgQOlnr6VGG5MZhQc4g&oe=6AF87EC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvxtE8IWvQYQ7kNvwGLA2ae&_nc_oc=AdpbTCA-YHqpgxK-YmQau_JPy7PYopypmI-VzxCRwdkj81F1rjezRfGb3_58PpHEwOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh9gMpTqfEqBWDU4-n4S2RgSICCkY9sQPC_TqTDI3s_g&oe=6AF88BC5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTtUoarARQUQ7kNvwHKM3wH&_nc_oc=AdoYXoVCoxGbBm9XaJTtNG937KNQ06asp1PYG0AuIbnaDjMjaXqwp1QeaT4SQab4kSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ3S9r_LPlJc0GZK4QIfTbEiOaVNBXL9rfgEFuuQXKkA&oe=6AF87FCD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR89C-81D3QQ7kNvwGuHgv3&_nc_oc=AdpUYdc5WGP4ss-_T2oiwu93Cnp_9ViKyEp6q25NDMfdW1mzvyBgK5xwv3g17UvZE40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd7uPpjYPIzlO4Yi63rV66SZEX6inB9lu04fpD_TD9Qw&oe=6AF89AAC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22k5Ci9ZzTgQ7kNvwH4VoPA&_nc_oc=AdpK27dIYxyvHryX7rVz2R_Vep0ONy5mItEefFvGI6acY518HE0jx73WtrzdqAYEjvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPo4FvJ7OqqUcbi3p9SIuMJ-7u3f8isXd0Dc3J4hbcqw&oe=6AF8A7ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
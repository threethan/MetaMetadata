://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQV2IbUrNxUQ7kNvwF49YQi&_nc_oc=AdrrHK1NCSt1nXepBypEqcJpnVlahaBu9kOhgyCrnLTcbXwu2CmkRgXGeXysTIx2kJU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImziAc-X9hLGXBBJKhU1LpeoScfbXq791jF9jXA9Zaig&oe=6AAD5945"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IGjQWWFPK0Q7kNvwFE5QE6&_nc_oc=AdqlhqbpbbYscEXmI6EoDmHxKbFt-8Y89m-gNCfUu1xOKd2RMPSL3dprj0ssbUAhAyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoHXv9unwr-FUquWi5P8av8zRWecKFOBmlZMYbUytF-g&oe=6AAD2E05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_oabn9fqwIQ7kNvwExW-p1&_nc_oc=Ado0UkkNLnLzpHmWImhpSwFkix61GpFknbmnhM8XKlFJ_Udn0few0DEig2Krf8ccuI8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfJWsS0Qu3ncakZtbmlbw_Sb8SgHg8OXrztj4b4VdKsQ&oe=6AAD5A4D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qdbl5ibMV0Q7kNvwGW5PRR&_nc_oc=Adq-PZCkN9NayMc_K6CAFcskKrz1Acqx86RsjTQR3T6Jmo2sOll5znHI_STizuWO0tk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK50dvTAVkFIlKhiuRAS_pz71ejnt2IxF4VbIup29Izng&oe=6AAD3CEC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stGrfu71fYUQ7kNvwGB1Tl0&_nc_oc=Adrp2IEmBYDk1knjgsDJ5CRMHXt9K7Zy76H0BWby7KvhJlMQMA5x77KeTV1FEaKZpYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi8Sb_wMj8MYTiCzZFC-jstEFU59Qv1Bqb1S9nLqMcqA&oe=6AAD4A2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
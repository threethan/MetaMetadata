6071943635909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCrbr6mTNzQQ7kNvwH7ejBN&_nc_oc=AdrhlVbisPd2k9BKXD5S_6Sgm4tux0UJrWmh0kOYMA5YVgKvvb0hVB5HAyEGq1iURwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWRy6hWWzgkGkdWsYatNLaGCdlCD4fGufVnGk8zgtuMA&oe=6A9C35C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HueqgncCwt4Q7kNvwG6T2pd&_nc_oc=AdqtZjUTGRLUWPXFF-QI_N7J8kbdltK0qGrO56t5D4cwnGy-vb4Qkt5SCo0GtFQPVcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlDuaBF0HILs7kdCjUmIWf_ytJbQeC5z1_le9yIqXoyA&oe=6A9C42C5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua0az_ePKOwQ7kNvwELCMvE&_nc_oc=Adpzk7V3sSbM57AN2Gf4pcAUr588DAB2N4WqFsR031KpELILAOVq8myRPVbLwNcD2w0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9xozvwv756T4H8s8t8w5B_JHhgCOZPKVg0-0C7fCINw&oe=6A9C36CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KOizdbTv2IQ7kNvwHOXzRz&_nc_oc=Adpi8f09-jYExBnka9hucx7sAa8XXUyR3Zbt5bA_w_Wvr511P0P9phbl5bZYSmZg49A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3RkRQaAF0hz82tDj3_SFoNYC-4sv56kmPtLbMXLvgVw&oe=6A9C196C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebXrfejq5aMQ7kNvwHF1IzZ&_nc_oc=AdoOdumZ9LgEgacSHLjhLOxC1lmTWJ1LBacZhFBXWdeifK2od6Rvp3T_HJDuTR7d8K0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVOTJRIhcVynJdNd-3SaTeWCb158Bd9Xv2AdotxkncAw&oe=6A9C26AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
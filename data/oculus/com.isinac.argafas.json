://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JCITaL7d14Q7kNvwHfgkuh&_nc_oc=AdrA_gKwwGyFDg9wNN5soBnUocf6nMVEPxjd1OZrtSKWD1Ch9Cmlmmo3ZWxc2i-u-nU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdulZmTldQvT4klEVFQymKIgsKDx5AqxSGB-iOzHTWlw&oe=6A804E05"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzO3Li_kMjwQ7kNvwEcTsny&_nc_oc=Adoqs1emjG6uxwGMFLfFoX0F2I5G5FJiVqRJNtfN-zwRwshFQjgsfdVfut3ajJyjETc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgtb8IRkn851vHjgttYPzu6kEaZ1QIWgkdWw3jSn5f1w&oe=6A805B05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOomv6nhOckQ7kNvwEYTTQx&_nc_oc=AdpHLTKGdkAGJSlozFlUOLLBoYqbFCN08po8v8ZaPbyh179TlPkTYQssP-ASrXD7gV0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0RG4z5dD7lPGku9gckOqNdb-pHhFOXSuj1npkGRh28w&oe=6A804F0D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0SCRfYaZCMQ7kNvwGd0p94&_nc_oc=AdrSQWGP1xfas3pH4cm3lG5GqmTFSV70yySyflZ7VNyk308ZL7e6YjWhcO010gheIcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9DjiBW4T4vit6Xx9pwb5cL5W-RJiO5Tdr4cJ-i5aSiA&oe=6A8069EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I__-TFBClvoQ7kNvwH3sH_s&_nc_oc=AdqQ7rZarXeDUg-ElwxvziIsbRMhxAu-9lkNNllzDERyJ6WbtCv0aP2x_YtGLMLJyGk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFD25mqQctJTr594h832zZ-CH3tJSJy-sA21qD38gOYg&oe=6A803EED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
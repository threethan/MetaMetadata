://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw0SGy1xVdwQ7kNvwEkJLcY&_nc_oc=AdqAMH0f1iQ0hqJzEu1B90ZRkDI4BHw-EiLUP9T_pmeynaUJh7-jSKgBQ5agicNYFgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG09x8lyeDSpFMU-v1-4My9M6-e4KGHuAw-BtmFdYQbrg&oe=6A707C05"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi_Lz8e_11wQ7kNvwE5TIqb&_nc_oc=AdrdEsLSVpX328zEtzU59b8ob325n_5uT2wsWKpPrIkBCV7AdF1JaCv2dynNsf4RBA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaqzo_hXZmOCvmntjLDV7uGfjBEmfeCDO2TFhwdJz-AA&oe=6A708905"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rjuPvE2n_oQ7kNvwGip59M&_nc_oc=AdovTvOXwE7YbFImM0VJ-V5HpkCt9ZMDFpLlkfKaJBaRStYjlyPbZduVAKVobBY1MQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSq7fe0EBzuQYa5-bw2Z46_BfvZwP0wvL5y79kyHFbkQ&oe=6A707D0D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DipHWHCEarMQ7kNvwFcOead&_nc_oc=AdoVdwaAO2u7p3VQvxvKK1APPARYLOfcPPjr2gxBGZbQYChItzhGF-6mVUmjRfBV4v4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmMqVSQBMBwgzxNn6SUn4YWwP5w9mwkHDoJnGOHG7_IQ&oe=6A7097EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjaJrglLLv4Q7kNvwFls8kW&_nc_oc=AdryQuUjim2DJ79ToAhIZWlV4P14kxM7Mxbfn8WrQUzfQLEaoXuovJp-SuMw0cpZwbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDlMHLC5QDZ1VqsqRI28O_XScOMtjKVmfy0_yIvD9rsw&oe=6A70A52D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFtkGYkuiDUQ7kNvwHh5eca&_nc_oc=AdoAhDfvu4g-mubVLfTx6hggoKr0UMjjSEM-Zx_1dgMgax8Es18kcxpczQhs50ubLX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu0k9kaoQm6otmEn8t-2TwatpfKAGtcJWX-cssekKvMA&oe=6A9992C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HueqgncCwt4Q7kNvwHLtPrS&_nc_oc=AdoGaBMTAcVuErLMl0m2Q0jkcKS69kuKbJU7sHXxp8kvb5-0uiLAZ9m_teHAbL9o2Q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPpv_y0uj6M_qWQN7nWEPB-BzQIMoUL7jsN2UxzlP9Ig&oe=6A999FC5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua0az_ePKOwQ7kNvwH6Rv08&_nc_oc=AdrJHSv2pSha-wG0JI6wqDezn0g-EWGXnJrUug7KifJiFjq_4VTNG3wOK3xEIObrAds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKyTKYArn5Tyw0LCFEhwvOaLXSDiAswz060WHyLTiE8A&oe=6A9993CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcLVU0pIVT0Q7kNvwGwBFMu&_nc_oc=AdqPwj-SFoYfzzVnjlRXfXSRjw_FPUhGlBMurk_xj50NUiY00ga6_tU7xsgzITQLWSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3TDQJH0S5YkWLB-qkSS0HSey7clWlxu5zhmKhmzVIhA&oe=6A99766C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8ckFc-WxYgQ7kNvwE6GUW0&_nc_oc=AdqwGi4Y4ydylYcquOHbf0r9GW8EpwRNZgQTmfGf2b7PkpOqqqiTsaQvuzLXzubeVv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxuwvHVZDKTLJF3BSWHr0oZajE1oJT7ofT0VGTPz2a0w&oe=6A9983AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
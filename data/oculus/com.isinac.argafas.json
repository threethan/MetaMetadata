6071943635909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyZRMjGAOswQ7kNvwErYJHI&_nc_oc=AdpKu1pAlkmmG9kO29Iu7e-2BOpRoAx_V-pNIsjq4NzwJ-DzviKZ86LDcS9dVhMayik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0FCdIEJfuvW5KemA2iuPmM2fpt_mry5gta1thqWo0pw&oe=6A6233C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUIJjJLBO4sQ7kNvwFNhMSZ&_nc_oc=AdrkxM4tMjsRLr6I9JHT4Hjdi2_OMy2FFX_bumm_8h3ejU-LMvdpBCbP0-_uIT5THyY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjlljlviCTle2gcET8YHiAURleLiEfwKltV4odk6QT4Q&oe=6A620885"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R8YZ7rh5pMQ7kNvwEFTF9Y&_nc_oc=Adp6pvddh-abG8fj5onL8VbxunJI1_Lgo9REM4YeADuHMDRGCfb-gFSIt1Tpvo8q-EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSjLlZWl3zKTWnRzh5_0qYHmkTuhQVo-zqsjTp0miKrw&oe=6A61FC8D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFk1qxI22Y8Q7kNvwHkTs1v&_nc_oc=AdrkNUAuFnqe0hJEapLdLaaaEqt5-WgBjobsex4aAuE3IgXF7tLQEuk7jn_keY-HpTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0vTZ7cL2D-vBszGlGCSRx1mACMcHyOgaVk7V6hgZEvQ&oe=6A62176C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBUg3XarM9kQ7kNvwHMwD43&_nc_oc=AdqCUNv_mINfQH063jgfvdtu5uThiZ5uieJf5DIe0PSSLzJe2xCeU7GxOtXUJT2Qzwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxTpQgC05dBywYKYizAN-8tlP0irBmXL3vsfp7fHW5eg&oe=6A6224AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
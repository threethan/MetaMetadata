://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyZRMjGAOswQ7kNvwH5zHqF&_nc_oc=Ado-ZIP7tC_aPPZwDVAaeVk9QRFMUzpGoW_SOrIWQk-sJuACRntatCnImi5aWgAX8MY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDutoJDYYQZZR2kVLd2128Cd6lH_llETR3mazBn3y_oEA&oe=6A60AA05"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_ewvN0ygUgQ7kNvwE6qILM&_nc_oc=AdoolKyYU5EWH1g1M_gEmCSbR8elLIZ-G5-0JIz6z8afeWNcxjwwpK_tXYxhFDy-Pn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmFMRN1CbrwOtF52EFQcVsZFbMYw9l4KQygiIPRCIZpg&oe=6A60B705"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJmdRr9RyPcQ7kNvwHCQjSt&_nc_oc=AdoRcpEjXjfDRDYgYr1CVes9ZTY1mpfqdGOBIZSHuQJD_ixRaFT3fHMxM7VvrkaywCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdUb_GE2Wp-csYqSTBKmy9u1PbgD2kd-XM7fWDYdgO5w&oe=6A60AB0D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFk1qxI22Y8Q7kNvwGA_oo8&_nc_oc=Adom5KTF4xNXMAmpcIvam75Drzwg_uQg5iEbB3epzpuzfkSPUuPBQvWU0pclTF1vVV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVJReKCBwE61JeHMhiNSyeSYJHvUSFp5WRm0UT2zItHA&oe=6A60C5EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBUg3XarM9kQ7kNvwELj9hN&_nc_oc=AdpTWB7ioh8NkP_FADL7dbkiHWY6_6n-FHiR0nUiB1feOSOTSTx8fhCISGpz1DSlnbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFRTRY_59a7pfe_Zqooa4ZgZ0luK0GZ7mLPaokvPs0QA&oe=6A60D32D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
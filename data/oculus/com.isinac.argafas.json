://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQV2IbUrNxUQ7kNvwF9GKjg&_nc_oc=AdrC6_zbQMcJlftUAmdZPHvcTfXhfaTJYTWGhAtZjKsESVRuBEa6ew-44EYAEhE65NA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGZ1C4d3gX9j92I2Da-zocP5u1IUYHqWPCc2n1PfZkyg&oe=6AAAB645"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syPn3h0iEzwQ7kNvwEB9Z1M&_nc_oc=AdoYwFG8ajUcFdBvZI_x8JVLYnLOIPV1_SR-GsE4XQDUZaI6ybj51F90hZ6GHlKYoSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtD7B03g4qH6wr_M2OkEQMSrkYe5UpVVYu-Mp6Ja5PUQ&oe=6AAA8B05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFg4LA71KCgQ7kNvwHFwRWc&_nc_oc=AdrxH33X-i0mp0ALFWA6fILHlhLzH1xg_aZuOH6wj7pw1DS1GE9yuieV4H2qfWMFzN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgl0_BKZ0H9YhQpt4ty_QoAwrfctP-qZTydixVZMwtZA&oe=6AAAB74D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1EaWO6UzrYQ7kNvwGTBqrl&_nc_oc=AdqEdqoRZQkj7T8W5IkG9aaDaOnlQ4TCZDArvvv_KrMw-xpz7zHd3z7uDkaMHmE7kts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLkr-wq3tBZGb2K3wCOBXeslZateni-TNo3yfaThrrpA&oe=6AAA99EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dWXFEjO53gQ7kNvwHswefx&_nc_oc=Adqta3tAYWIp78YOueQvHNTCIguq3vr0f7vJLZsMKhifOe_EDXoc5cMYto0foFbyzRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKib7K8E0bvjSZleYgKBa9cy4uxdlrqTr3WJbOXLEyUPQ&oe=6AAAA72D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mWZgEi1GoMQ7kNvwG2UyUP&_nc_oc=AdodjXBcpR7Sy-LENcaf4hPEN-yRCzjW5HD3ufDV4EUCsb4hRSdwANKD7cKEJR7RCYo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqrhHmL8wWPoFJf-9J2Pmh-nuGvblpz-uonqAY1yN7wQ&oe=6AA17BC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHMaP6JjvhoQ7kNvwE-nnfL&_nc_oc=AdrSxzbn9fLBMVwgZRi9hlbvPVq5iZQtuXYEJwiDU0oL4uKRwUbN9guhvyTgxxnj500&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5woDOmUdNlMtQ6QZIv4-vAJrb1A3awAS8gTi9KLs65A&oe=6AA15085"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAtRX96Bfq0Q7kNvwG69HIp&_nc_oc=AdrHP1FuJRXLKjJxdNZCr5Q8E5t_nnQ4_lW3SbrxsUI7fyhMKNSyr8sK7Xi4NbrV-mY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFzFBq7rYDiepd8gNkhMRTGANjHyStA3iV-VgS0MQTdw&oe=6AA17CCD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsjqutZW8l0Q7kNvwHGY0rR&_nc_oc=AdrPTQUV2SCq2w4uz1gOSEhAudwm11y-FgsM6KjYEvI9X1OeQo8fb98YaY1Y_5FrkDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa55aFkq_cz4akojBGs8Yjz5DgdOEqv4gFsB-5Wg3Lww&oe=6AA15F6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4zR_k1Vj4Q7kNvwEEMgh7&_nc_oc=Ado2pXEdemjMuXPmTs22i07Gae-5ZgeoXdwBpplUll9ytnWZH5Hm5vUjz80vls6XDs8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfsOY6EV8FDf9XweEQDWjCR9kzCL4AX84dy4G_sSzp0Q&oe=6AA16CAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
bos.png", "id": "2106071943635909", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MSsS_fxIekQ7kNvwFaD8Pc&_nc_oc=Adog1ehf1gAszhEsm9ZockMquyza8VsGy42plMIQeztzkcqahvtl6Gritz7HbKVmXd4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmZXg0wDLThf-bVxwoYzjaa5hEpoar3ObV_CxbsyEo2A&oe=6AAEAAC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IGjQWWFPK0Q7kNvwHmwnZw&_nc_oc=AdqzPvxmHiK1mWmAJur3Ea5nmbfPX974AivLFf7ZGTv01mMffey2IB-92xn5i0_rh8s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk1_-6fVKSTcG_cn1ckU9d9vQge7jrcTw8VJ-T_Ky70g&oe=6AAE7F85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_oabn9fqwIQ7kNvwGnsWwI&_nc_oc=AdpjF3PfZk7bZfD1UeasIzZCMyXDcIpTCEEALLsNjbI8zPn11d9sBEZqpuNhXzFP5FU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF76xboBDldvalENYoAT11QlwlkCVXSmOOme143Jxikw&oe=6AAEABCD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qdbl5ibMV0Q7kNvwHhwd1z&_nc_oc=AdousfLDVxAWNl-LCXtRVeCOB2P-9nudpkHuszF7eB3SFHY0EvQdzYcKnNZftBlYfzY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpBRUmAnlm3b3ZiMz54psDE_AGVZ3feUlUlPtdihgSdA&oe=6AAE8E6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stGrfu71fYUQ7kNvwEIBOf0&_nc_oc=Adr_UA1WSKURv9JU8LNxA8PQfgf0dbE5fmuBqv3QnkB-aMtJj5JBrV60uYA133NdgfI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPNLcrCCuyAmt1YrKdagvSzo73I8fn67MZodaTBLNN3A&oe=6AAE9BAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort
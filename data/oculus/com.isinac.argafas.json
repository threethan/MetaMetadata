bos.png", "id": "2106071943635909", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju2Dd4lFd-0Q7kNvwFQOyxE&_nc_oc=Adrfb9zvYpV02ilOsMXwbqiG9fwcTQxNaORKOSTex83F8_x2c2MEBHMcVxuo007Dn7c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc5rxaTC_UjyJc0JN8UdSVZpAUc3TVxbA3UG-Ug6dILg&oe=6AA964C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syPn3h0iEzwQ7kNvwFP5c-S&_nc_oc=Adq4ZXKpI-oszK9z4jB4akOoydNKnuEwurl3dcDlXJOcA5Mod6aWGYsDqPuFqhrU9iw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbBxUzW2N0nqaZKa6n2OqrzdWcl-U9KN4KQAINYqBP9A&oe=6AA93985"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFg4LA71KCgQ7kNvwEETFFw&_nc_oc=AdoSabz9WxNXwlq2nfsAjYy1kuTpx3K1vmgl8vriR5EoNoh4KW9vZdEreeFewGdL4qE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqpxWJ7XbZyeAo9VjkJPGb7ni1Q6yxlKPCw7Si6GoZMA&oe=6AA965CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1EaWO6UzrYQ7kNvwG4HCfU&_nc_oc=AdrOlmk85X577zB-GNzYdNOAp1WcJtvMewSwoKs1543MkXhcrp2OX19-e59LhDOGaRM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMTaNN1JEsu3n6NgMa6ywitpmY4rOwo3-onQ7bdy5DDQ&oe=6AA9486C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dWXFEjO53gQ7kNvwE_NHIn&_nc_oc=AdoJErP0X4zIOXvAUeXmKHsGxt9IqBSr6AUwjS0CbmrI0aASocamiwS6utwpdfEczlE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIa30Jyed9zt-ntD3aRB51Ue9RQmzaVNL80NmX4QwI6g&oe=6AA955AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort
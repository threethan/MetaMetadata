6071943635909", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usGslcOhGTIQ7kNvwHFtDFy&_nc_oc=AdrOn-Xmak1Fb5GqMmc_z3bEETd-toWmC9CA92OoBFCY5oY6gQUdcXlgNUdH7viLpqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgme41d7pyR58Q_-IfN0_T5T_lPJk27bKHgnE9fA7c7A&oe=6A6B3605"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCaehsZO4RsQ7kNvwEZ67YV&_nc_oc=Adq5Fa6Cnzv6eqKUdtI6k5dvTvLMjSdbJRgXmGDJkKO2W0CDhpfXOUYM_peeC6cDSFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXn_h1qGcUZogzGEAC3DWdv4B9r5a0nyAVpS4P_Tz2mg&oe=6A6B4305"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGdAeDbWH_4Q7kNvwHTYz-T&_nc_oc=Adq_-57q61O1OoL82cVtDp9RY3BAAJJcluag6oyjH2s-jNq1NrePKrpY4kwIo0u1PKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaHMnMwh0DRDMuSuAsO0jzXc07DPgpj-UOeh28zqD5MQ&oe=6A6B370D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSl8LBl05dQQ7kNvwF8T0gb&_nc_oc=AdpXXzfTkmtGVQUqEjv6sqyi5KGihoB6jDxjQzABOi9rLa2TjK6QqoE-0Xvz83Euubg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVMV91pz18vM5ENOtsQ9I2G0YR9dkfm3Zqv1uyhsNvBw&oe=6A6B51EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqb4kZKjBL4Q7kNvwFETK8R&_nc_oc=AdrkVlLDFOjeNOyNyPpFdASGuJSiywpznXvKaWYqHXBh0Lc6zwENI6dALshuPwf440Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKn_i__Z8FT43CqwByOZWqle-fv1EsciXjTH_ZmafbRw&oe=6A6B5F2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
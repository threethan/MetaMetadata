://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw0SGy1xVdwQ7kNvwFEh3tQ&_nc_oc=AdredCvlYs5cuyo74UrCVAL1PxoYwq4Xx2wruI7NaTem0m2zWowjOOfEidbxbHzn0-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfaE_DbsffZWTLWrSzcMyPLPIa23eWVmBggJbzTUBcjw&oe=6A71CD85"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDQs3z1dFVIQ7kNvwErFL1_&_nc_oc=AdoDyFSU6cp8klj0kmZC3II4mjTu61M30K27A70BjPEpYQ5U8rRFD_s3KM8VXigD9s8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBHQYrpB9k-_P9vImUCuzPqUED2XlxoJyBMnfLQ5L4-g&oe=6A71DA85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1r5amm_4AgQ7kNvwE61gAB&_nc_oc=AdqDzdpaBJQo9GuXb1hA89ruVTRBL1ghpaSCAhpd2sXEpScdTAW9B7Bf9hZc9uCIz1I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdQGxZscx0Ae1WvvpM75fPwstPRZQnO-0KKjHgk-F96w&oe=6A71CE8D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DipHWHCEarMQ7kNvwEMUbdA&_nc_oc=AdpE3D9dg52Ts5_H57lz8av00JhlG1rwKHPHZItUfmKwHUQaBg9kmesoVJODlo6SI40&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKodlEGyH3WwHsaqs0WEg4Z48K5fDvIx-yWfuYJriPkw&oe=6A71E96C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjaJrglLLv4Q7kNvwFVgUav&_nc_oc=Ado-GEDr9TSqcjRoBn6AI96Tl_go4E0UHqKOpX616USSq_437_BDFBALgr8f0b5CQ2A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGavww7_sQT3Y96rdFk-ekN0rJd4rr8ccLtREqdXzfmjg&oe=6A71F6AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
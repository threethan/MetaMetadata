://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4dCKCdMqWMQ7kNvwEpAOLs&_nc_oc=AdqRXTjnk-p6zuowEgYNbL4FfN7trLEraoXcracREJipuE_t00WWlh6HKaM_Jrj7k5Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4j0oFp6s3Bbh52H9BdT1yAsBlGr9fxEu6Qy4blzSijQ&oe=6AB693C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_yiTc8IqfAQ7kNvwFllenh&_nc_oc=AdqqpfaE9L_3tpJztKKQ0Z0rQKpRE0xOy5pKBErEKNUvMKZ9q1LUScRKgrEZKOf8-WA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwpmwBCqL1_NzswxkJjhVouoTczwG2LoBbNdeD8_9YUg&oe=6AB66885"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyPsH7UrpNsQ7kNvwEDV2ix&_nc_oc=Adr1rSDb6sCuwtaFp_JXAXNXXtqVSlPEKyMEN-N0CV5iBS0SWMCvtej3QacZRupzsnk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiss6fR9IFvZADwR556vqwa1Xah_tOhOEHjWCBjBgyZQ&oe=6AB694CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM1Bc1UhQrwQ7kNvwGf-85W&_nc_oc=Adr-c6qXY4fTfkur-oaMXKiWorzfCaos9hCjWYgNSXBHko7Tm21F3JzwVr5Z5krvYYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFOKQQEXP97xB7wPkqz9v2bpWiLY1nMqJq9-TiBMMpPA&oe=6AB6776C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQKrrqVyOvgQ7kNvwHYxeFl&_nc_oc=AdpkBTIjHQYvW3Z-bmIrIerPg1WsokubuyrUwMwrZFxQtRQl-_JozVbxLGePJU6Fyis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRDn6SHeztOxWvn9db1RZDoxTFC_WCy7NnjG65bcYwPA&oe=6AB684AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
6071943635909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W0B4zPxgtIQ7kNvwHSYERV&_nc_oc=AdqaPAvTkoM_5Pn2X3wFAgRMM7Mry0J0lfY27jcwmmUYQTllUx0vUyul2Sn7C2TtYzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1Z78wNIUJ689Beby6FDToqs8l2aBec9BwM0PoA6a5Qg&oe=6A95D685"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrERaxWlATcQ7kNvwGMGIIR&_nc_oc=Adr82iuCRDScl7fZlowR7PS6p3Ii7WFDmv2R1F_5lQKZy1dk2DO6N3VI00BNpW3mFT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqwQuCseDHUO8QHKGxf3b_AfB72qFqDQvRDd9vY9UFpQ&oe=6A95E385"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX2at5XgvBgQ7kNvwE5bPaY&_nc_oc=AdqV17e37yoGc8odUP9zpT1JqXb8C51z9vC-in9NyONwlJ50_-BCvq2L3QjW-9KlI7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJV1KNN8M9GWTEYtcdw4EbvSVfX-FknC9noh5tbVNEyw&oe=6A95D78D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLZx3Ofw_hkQ7kNvwGcYN36&_nc_oc=Adq3O_Z8d8LpEzQXQ6tci8fu5PN-H9tiKx1kx_Lb9SDGYylnKhXmQ5zljynniWC0sZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuIp0y098tG9lxZb-kn1kus8A7RBUGaYY6Jp4atJt7Mg&oe=6A95BA2C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqz4zrOFd48Q7kNvwEqksXO&_nc_oc=Adp8ajgD-ZzO9eMcfyTIqfltgNKRg5zxhsiYIX62xLZBZ-5SHLFaayM42vQIF8GoUAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZBF_Oz_aSq748vjC0GfUe3HJ2qpfTHzqHUrtlY1bb3g&oe=6A95C76D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
6071943635909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju2Dd4lFd-0Q7kNvwGEKJRJ&_nc_oc=Adr7saE_LzGfgxbFer66w_XOQKSNqKwEBpFhY0imRP5Ud9IG9eeFAWUOSox8GoEBqMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGfoQEt6G5__iCbc39u3fwsMtDHl4jeKKuDZydBp2q7A&oe=6AA6C1C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiEMLvso-k8Q7kNvwGkj9jc&_nc_oc=Adquwe4BUCJM6VbcdRWmy-V1g49SQTf0SSYeZHldEyNWLFyNHyNRgYkfFdTf9rqUAPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAIEbLPM2vL5E-pFE5cIYnyEZtyEdYq4XB0h-xhTkFyw&oe=6AA69685"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWQwiFtisUkQ7kNvwEjeFq4&_nc_oc=Adr-LraggAzS6mSDOPwBGIUh09BVHX_lL-yjBfCPGQDx5qvYlGodm50P-xXC3_VjxPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIHNDcPVuiTRNSotluk0FliweBAGjaATwZg1-Nm0Z4cw&oe=6AA6C2CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psp2DrxW1wkQ7kNvwEvaFtu&_nc_oc=AdqjCJiuZBO8RoGBV7qSaZceJDXg3aui_r57ofD8YyOjcYpag76TyLE2QlYBQl8Ujl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-v5hk3IcD8atg0bH38uYC8FqracO1lQF9uZvRJfCqAg&oe=6AA6A56C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dkHDEAd_jcQ7kNvwERARQv&_nc_oc=AdrsPM1MKpzgbFzZsCDalf3-EvQO7EpALq0b3YM8ug8dDaQ4L4i8WhA2JPbd9eB0isw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDiyav8zqfApG7XOmG7CB5orMhAegCrjzm-j_U94hdXA&oe=6AA6B2AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
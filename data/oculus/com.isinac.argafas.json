6071943635909", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W0B4zPxgtIQ7kNvwEQcQaa&_nc_oc=AdrwMbylLtRxGpdc685BNWC0gYL-sAJRXEPJSxpSVwTJQXxutfh56ntK2DStGpP0BqY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAEHZOJtlKXCgn4wtheCyUARD-nlw9Qr7eZliCh4SFNA&oe=6A941485"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4p3W4JYSaIQ7kNvwFSLx3H&_nc_oc=AdpRfECjizYsoyoD4jfs8FAfhADQHgz5lzFIkMsL1RUMXm9wDImxinsuxGobOVx-SPU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz3kzsiyykpCBkoflr-jtGEGKEhB_148nIbJeKHarMGg&oe=6A942185"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMYW-lL2e3kQ7kNvwGbV2Z5&_nc_oc=AdrcNmBDAfAN_AtQDN7ZrlqsSdvC2iEOhqrYKFjcnKjyYSfyIB7vrXF0rP5D0DcgNl8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhFKAdZ2q7S0mZYt66xs0jEqgW16I6h9XnoZrKlrRhug&oe=6A94158D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLZx3Ofw_hkQ7kNvwHh-XHj&_nc_oc=AdoG_xQatGDun3h76N1iDPr-8V2eldD1S6zEf26FbMf0Vp4rrdEtGAbg7nFy3k3ivQo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHcl3nh7j5_K9f0L6kglqRCgAunzRrMZ5QgwZKo09dWw&oe=6A94306C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqz4zrOFd48Q7kNvwERGUM9&_nc_oc=Adp1a_8hWIvqs9WdNBX0ilfybI8lyqo4qNgUDoLu-k_9NzmY9fqE1x9qRjxny9ak3KA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETcym0mG8IkwlQSGCYElH1zyGUlw-BXjXL6GXPwtCO-Q&oe=6A94056D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
6071943635909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRiiQY8pgP8Q7kNvwHnU_Dx&_nc_oc=AdpjdfIkbzLO0NaljhWV_NBriV5mo5JfFr_A4zit64VVzSzJuRFlHOqi9YAAZ40m1Pk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlhc_LGine2dFCOW49dcQ91T_iax0r9XraPSz9jTAXRg&oe=6ABBD9C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R-KYG45kjMQ7kNvwHWEFcM&_nc_oc=Adq9FnLQ0oxav5tGy7l5kW6_IgZVr8yvIToofG_adxfBxB4F0f75VjtH7cVaz67kowQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-kdSBNrOJ2ppzol22PRbyF9HDjpKmTaloh3BQSRj_Cg&oe=6ABBAE85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94ZlXX8ffRcQ7kNvwEf77Gi&_nc_oc=Adr2kecTya-NexTSdJq9fY52uiHIboRPubH1TqlSKnoVt-O8JSQuuQuogqId9STs1KA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKafB05mTHjgqeVuIhqWPUtqH6rwcCw7GwHrbbDZ_Mq6g&oe=6ABBDACD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XceQQnv5HgcQ7kNvwGlh2pX&_nc_oc=AdoiVZEE__SRv3U6W4n8y6NyLp7MsttdEh1v112rr8NsVLBzMMg8EvJ0wgymSNLVZj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUNOQkVVDHODhL5A-2mN0_Qw5KDZRxhXlqpZTkx9cNOw&oe=6ABBBD6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7VF1eyvl24Q7kNvwHlzz42&_nc_oc=AdodqRKgmg3__fBVVGy-oIsFz7gjqZ5vUK6audIVru4ssXXtD-3RTVQhHi5Jg_fyQKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIusNvRnSz7DSILvM6nYuhmM82JFm2_FNGuDsFOE6XOXg&oe=6ABBCAAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
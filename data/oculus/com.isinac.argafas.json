captura_2_cubos.png", "id": "2106071943635909", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JRYeX59pK4Q7kNvwF-QOUi&_nc_oc=AdoUV0UeIZ5bNmU9OGm_ff0DVOJcO8ROA8ACeqDN47DAH9G1NHbWAq8-sW93Z7vHTLE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz7unBZ9dzI4duJd0hPez5s2dZcgQCcHLP2MDRdcEaDw&oe=6A8D7D05"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4du6ZJ9iVrgQ7kNvwGAzSRA&_nc_oc=AdqnFBFOK_LRsawID1tqhvMoVBi6au_98l2mkLgQkqnRdw8r71otf91q00g3GC60u6Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWFEjg0HeGNNkMQKg4LTrn4ITNu-DEMPCXf1PvxMEGKg&oe=6A8D8A05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If0Dw1BxopYQ7kNvwETRGys&_nc_oc=AdoZI8NnWwtfl5OXO0ymS8f_tyvgGHSoGzvDAcXRE6LgJo-kxhQUkAIWZyeci3wDExA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn0wEUjmWJpskuvaK_BDrw8kmvIX8PoFNzZ4qhP7_Tww&oe=6A8D7E0D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4hTSNoLz7oQ7kNvwEuKwBB&_nc_oc=Adr_pY_iEFrXQ-omICgTcfzQMLN09X4ZlpCD6YLM4fnbj33esTo17ot2q7jQtjMSFM4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJHkG6u-BmtcPzXBmMX159ToU01mxr4UgQl7YVfvWmkA&oe=6A8D98EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7l5Ro7hFPMQ7kNvwFXHbTr&_nc_oc=AdogxPSJlCEH_so0KQdeEmH6EhZYPbSZzHuj9AiVKrHaEA9bTBmFpDLwMsCJOfUfdzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3eCLK_oC9eatx-GqtBmYxc4M92VS_k_s3ANI7iksVbg&oe=6A8D6DED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_S
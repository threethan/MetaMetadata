PICnsEA&oe=6AFDE0AC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMbz54qvzMsQ7kNvwGx-LCj&_nc_oc=Ados4aIE3rqrJNPJMEdHy5kMFHdws5ha1kw0TxuVI-d2CcXdFEeJ9dinUFONMZmrcio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjgN6ChimVuvLD9Zuy9ZUX3k0h9BAgiOqB0pd5Y3IPPQ&oe=6AFDB5AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "de", "fr", "it", "pt", "nl", "pl", "ru", "el", "ro", "sv", "da", "fi", "cs", "hu", "bg", "hr", "sk", "sl", "et", "lv", "lt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1190558130812646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1032523742567749_4867702978848316994_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD5_d2E7ZBAQ7kNvwEIfCcp&_nc_oc=AdrOXXPXYAt9usQ4LMT1eQRlik4Bn6pQFbbVN_XOKurMak2-uc0L3ckIdZ8Jkf5xP2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQWa-Xv6FXsEsaXgCdgJEjHJ1-Sio-0EhV4ZCcC28eMg&oe=6AFDCEB0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ISINAC AR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1784304540, "lastRevision": {"nodes": [{"id": "1190558144145978", "release_type": "SCHEDULED", "administration_status
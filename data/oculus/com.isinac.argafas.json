6071943635909", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erXA0oTpSvIQ7kNvwHgBLDC&_nc_oc=AdqxxxRMGUTxDEsBsdgTRsVxo9-_Ymz7y7sX4iIkjcfqfs8MyBNkIDiGwtVgZ4zxS5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSbbIkX6-8tP18ol2QmbuRu2TZWOa9pB4X6UdTUzV9dA&oe=6AC51445"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4Uzb4S-5bAQ7kNvwHhN1qq&_nc_oc=AdpqAn7o7IiZmURAnMKPBae5VLDsyjIvSuw5odEQUulg40sZ1kkF428Vub2Sff3h_k8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5NI9jrZi8vYFDhE-EYYJBQgL-9raGq5VhmeJ3Q-WPKQ&oe=6AC52145"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by1FcLqj-qwQ7kNvwFDvxI-&_nc_oc=AdpVSHE2Ar7p99zpK5ZwsBgK3sji7ztfB_nWyNiXJWvetTTcg-e0VkH6gatwqZKrEEs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYlasIQPUuJ2VrnS9lbcbEL-FMilLBE0PmmDPksK97Eg&oe=6AC5154D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coh4gSJFZggQ7kNvwHHIuXA&_nc_oc=Adoem8ZlpcqJehlspGmFuXLglfA45qUtEAmYu6xGZpDJ3I_4vC9eMNOFoua0Uwh8Bhg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyZArfaUjQKGbH6MoyESSDqOyoZeErcuRzXdK7IqvkAA&oe=6AC4F7EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VKHLUV7sIIQ7kNvwGSEc9W&_nc_oc=AdqxWpVp8s3zW5OZXBxLPT4KJfVkMBjpBOw9vmAC1uMoRLoICN_XPFuq7EpDKyK_zOU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcMwFKy2lZxVjejcDv3eSCT9K6sT-TKGcze-Et0T9fLQ&oe=6AC5052D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJNhiVawbScQ7kNvwHCCFrB&_nc_oc=AdoDKLPBJkr8s79lapojd71U-zAW4iT6Dg6Xwn6tekCsf5JvJVoSJqhhFP2vc7z9kJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsCA-ynDrxG0A-i9GMUna0nRDQfP9hc__VbtQy6dfZiw&oe=6AC11FC5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0FI75cVxc0Q7kNvwH1nimB&_nc_oc=AdoJPpJQzD-mEDF0NfLn9w5QFpgfX2pMFTmc-L7bxJbr6fNJ9Vzybl6AWEdyVDlQ2aI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrrLChF24UxgMrK2zEO27wHL4CUKAmc5da1GmsRTPWbQ&oe=6AC12CC5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUyfZQOMjQEQ7kNvwGfbXnV&_nc_oc=Adpv1do4349vlrtcc_klywS2-1LDz702f5ZKf3zquNiTv2YUpgpoKF2aZAeQpDEzLrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdOYGyLH2oUWBDFyOMdctTwdzlFxUQuflngN34sF4xnA&oe=6AC120CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxppFPJ17qAQ7kNvwFz3hhl&_nc_oc=AdqwXUW0jqmurEsexU6c80F5i3A_q3v9Tas5GdCp1fUJ5EhcwT4zcYClGY1NWSgIjzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqHKe7DnbvP69WYdyoSZSXFweNl0iUga9oQfSVDyjaQQ&oe=6AC1036C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJPg44p9HNMQ7kNvwFiun0x&_nc_oc=AdoNasUGnKnxG5b1idOTvIPvbVAgw94xSHVNa_MFWERgLghujhn5-j7xmryaQ9dUDfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY1hTBF8tyomd0TBIlB04QtTZJ6RSDmDtEe5igrv9E6Q&oe=6AC110AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
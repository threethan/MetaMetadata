6071943635909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntaeATZZg7MQ7kNvwHUJuKk&_nc_oc=Adp32pGZNRxmRAeMms8cIniPQEkBq4ldzz0RU843nxXuA_ytvK6Ie5PJcmxVTkBDX_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJovNLl_UV6PG1etmcm2245kGxLMHrLX9VKnqclQRG1tA&oe=6AA57045"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiEMLvso-k8Q7kNvwEk1d4L&_nc_oc=AdocUj-81J9WPMSQqsLljinijBq41veza1ZVpGTh0A48x4ukwsRH1n7-5sZNJxAMpNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJriPGMkWYCWI0AGvShE_8jmpFf3C8b57NyhPS84-VTpQ&oe=6AA54505"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWQwiFtisUkQ7kNvwG-TJCO&_nc_oc=AdrPmG6L6Mo4j64RCwr_j-Cq8Mo9Lr7eMgKuq66DrZ4LeMlsyp62iggDtwZeYUA1UCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEs-7dr-fXgQk7_IV3nBPAdlFIhkrEfSb1rXD03ohEeA&oe=6AA5714D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psp2DrxW1wkQ7kNvwHmi5Ti&_nc_oc=Adou9M3n-QCNE1eZo8fSz0gN5y4jvAkZYq69pbZZ9ttRdJCSg1FfenAsZmjHXNJdJ1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3Pe030MsQoyDFlHh8SO-YzZQF5CtZcoz5SH_tiZZsYg&oe=6AA553EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dkHDEAd_jcQ7kNvwE5yFqp&_nc_oc=Adolw_xSkeZRfKlftv3OwwxH0ZdIFd7U-nHLVb4KU5b_V5LXPwwqPXBi0LCBreEaxjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWeP1aftIPKffQxDDNHBJ25-EhIeIlARh_Lr43Sct1uQ&oe=6AA5612D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
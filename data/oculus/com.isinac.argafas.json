://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntaeATZZg7MQ7kNvwFS33TW&_nc_oc=AdrSkPDODPzbOOzCDmnKrKcJeiB7h91SjvoY0Pe-0fxDnysPDdhIi5ooR3S6mEbQ9CU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIobQsWALQxlEZBbcU0Zw5Z0YcxaS0g8UGDo5RQMtsRdQ&oe=6AA2CD45"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHMaP6JjvhoQ7kNvwEhcpgp&_nc_oc=AdqMrKprNNRF0mwpFiEjsvNEcp3KNsoR6gQ_h5DWafXL29RZLLrlkgGMiOrumyfgKOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKdtce4_iSEVsDSwr24eucvzrK3yAKhnn5QzK1fSaoZg&oe=6AA2A205"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAtRX96Bfq0Q7kNvwFaDKCn&_nc_oc=AdpJq35xuV9Jwddl4b_RIzERa94kQqIfReBT5L9Mw2Qf3WvKIpnYJFFBqKSBhLXUxZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr6L23sxWJDzcxoShAXFyBZ3BE331rauTkaL-cnSXWYQ&oe=6AA2CE4D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsjqutZW8l0Q7kNvwGTld0e&_nc_oc=AdppBJT0qNB9FZzFrkAzDv174LzHKNxTaXzGGodQv2QZ8Z1PJ1Nmxszy-kqStbG6Qzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOIg_M2YfA2PMthRzdlNbQuAkC_vaETK53HV_Kqb5xMw&oe=6AA2B0EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si4zR_k1Vj4Q7kNvwF3MfKU&_nc_oc=Adry60Z4bOUqBJz8bp1nJMCGCgCZZH43b1LnGuWFYCzfXq3O_lXn3JHRvIuxCbI9IQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjQgsi86nJK-Ti-1E1KGSDP9lhg52f12O0v0F0X0NboQ&oe=6AA2BE2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
6071943635909", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JRYeX59pK4Q7kNvwG6CqW3&_nc_oc=AdrJHwKG04cOWL6hXLo8KDY13iD81hm08KXhJBtGbkZ2vRrxc0lCilak0qpBjUTUFpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy94oJ0hcpof0yeb3cNq5_uNHXy4Dhs1iyr2XxdauTBw&oe=6A8C2B85"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntCI807tPksQ7kNvwGLgo1H&_nc_oc=AdrFqKaRsbjmdUdlRz5edEctuHHpuR6dSi4l1bAkGcajsAePuBz9JFUbbTU1CtC_MF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMBpsIFm-qIHjrvCMtV_wmzLgSPFE3YKaHpgZtJNA65g&oe=6A8C3885"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMWOv5brTx8Q7kNvwE_pl67&_nc_oc=Adq7HcGxrwhUKMJPl7FZjus6VSZdEU4TWPklwyOYw1O-L_C4xb87bJm8Lm515cCZMEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7oqQ7eXc--25k2sA2ZE2GhwtAd83RHVqNuqkIAaNTZg&oe=6A8C2C8D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4hTSNoLz7oQ7kNvwF_QB5D&_nc_oc=AdrmVJ43VU5RIWAUl2lC8y3EXT3NqQw5sRp_8k--lbQRpG690s4aB4nkQ9ICCm_Wo98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm6PzJXE0o8wNiCr29_Lfsx8RYOScGp_8g1ngBS21-pQ&oe=6A8C476C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7l5Ro7hFPMQ7kNvwFvdeZu&_nc_oc=AdrnKFfWO_ZxA6CwrDklxOShcgxkg2pHAWeitsqSSPI_A6tSMI7SmNHl5cJUcaXuvzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKjIC0aNyYGIBvVOAL5cVdVNRU6hvw3xcrTNPw85zA7Q&oe=6A8C1C6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
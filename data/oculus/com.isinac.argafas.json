://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCu-rH0prQYQ7kNvwEavGRQ&_nc_oc=Adq87q-lzcny5s4aKL-A2QuJiiEgzYqwVfBMlPxBif226qmB_ltMiM5H-w4mmZbUVog&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKWvjj0799Va1muYP89IrBdoTLPxFCqmNPAK3xjbCfQg&oe=6A902005"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4du6ZJ9iVrgQ7kNvwGi0tfo&_nc_oc=AdoPqS3j65hK0boL6gEKjlNeijmN_Vn6yEkyihPq7B1OTdVpjXJL-iptnevkez1QuFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4b06cCPq3ZPWXi42b-4498U1Q1E4puWIwHs5Qqf_8_w&oe=6A902D05"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If0Dw1BxopYQ7kNvwHofULs&_nc_oc=AdoJKVUFv_pnLXqQH8xnBau5Th5X2OGFBEXmHeVm89f4i8oIzv6EEZ9ss1XMSxbO0FA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpyDUMt_plbkHjTtjGWCOM381rf7lqsvwLDfqtQRTWVA&oe=6A90210D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzAjBXVrGF4Q7kNvwE78dur&_nc_oc=Adr_LjzWlmaUyrIB8xskucGNGRDH9gSb9lPFOobcDgsqg3DUyIHV5iOIOnjP_wKyzic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3yTRQTYDcypoo1LpGkguv-OJaxNJnvxzt4R9OkoHB0Q&oe=6A903BEC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5kKY_vfP8wQ7kNvwF8Ed9D&_nc_oc=Ado683xCT_-nCEk382LroDf8rM9Atz8azST5dkFlco6Aisj-TGQpWq0NsUS94rNSjJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTIqDvckT6tjwtFF5g3jRRD0l55nN94wGUvaiyHL7mmA&oe=6A9010ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
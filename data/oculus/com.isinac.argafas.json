://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ekt3K1qJUYQ7kNvwGfV9UH&_nc_oc=AdrhAtGL3iAGkru-3sMVyJhHu9gnhuEIzvxOWPtdKNr8D5Tp6DGvbyDHWc0e_kv8riY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM95oHl0nhvArMP3Kq4iNY7-X3O4ttDSwBmz_UIycFJOA&oe=6AC908C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt3-QjEX5XsQ7kNvwExndPf&_nc_oc=AdrwfZAu_LGVoFXtho3H7vED1wYWfzfglQi_ixB_ycyb3FBgXn0UfHthbnNUEo5XgBs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-E7S5fKxGXkkWzAEpXotsCbPXNq4aNhPG8iQFMWZ_YA&oe=6AC915C5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf45iyVKZqUQ7kNvwH8oUD-&_nc_oc=AdoS1mVRPd6-zoFdBV57lE6MSmhyL0vIgS0j4fd-fneHUyhoPWdMEnVkECtSjSdzWq0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgbT0KPG7UApO2OJx0-o2dsUmx5HzWPIgkQci1tT7SfA&oe=6AC909CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L18ivpPqAQAQ7kNvwEP8qcn&_nc_oc=AdoV_Db_9t8hf5OrBlt2CS8GfYCSY8gO30wZ5IpGNpCqcd0qPg8SSTSiKQ7r_z7HcnY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcis-7MrrOR5eZe9gxPvK8Gs0Wqc2KUMlz6aMSdDVuRQ&oe=6AC8EC6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITE4KFf3K04Q7kNvwGV50fN&_nc_oc=Ado3ZnxFcyK3uxe_Jg-c3cxS4vchoGwZFyAZEoJw12R1oXYqm5hS_0TCuakR19bHdZ4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUuyNvdqvCfrY3zBnHUbx-nqOLe6eP3b1paf21NjuJYw&oe=6AC8F9AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
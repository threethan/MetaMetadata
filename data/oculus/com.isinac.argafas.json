://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP1LFqvlrWEQ7kNvwFzRMCc&_nc_oc=AdrfoDyJd6F-ICjVtEctMmP_TILZvhW84YwQXo2cbatLpFkOzvOUKT-axU7mVCfqJ_c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiD98HTF2ZJR39ay_C2Q6xOpWSdS5BAPZhwlO8EYr70Q&oe=6A883705"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFi5_Ya_5WUQ7kNvwGL7Ivx&_nc_oc=Ado4K0rVwXXM_UHBCZZ7un0MBPmgKnjB9ebLPf8K9f2VQIe_TYeqArScjFpzzeHT-08&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3_LWr4tDNbxbsr4p14_2QLz9EjNxu0ZhaeqmLMdebOg&oe=6A884405"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5-3EA7uayMQ7kNvwERvk3M&_nc_oc=AdoluVjdX40Xtgrt6odRGnkRIjBam7Ib8XkwKjxXogX6ChBIvcLrxAALLXfbn-Bcyig&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt37faEI186TdqqlXqfU7zHkA0cd8459Wb69WGp16g8Q&oe=6A88380D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZLGsaqzzloQ7kNvwHmDVX-&_nc_oc=Adoe_td4tg8xB8sGiY2m6IY8JnlOc9ENi9hG2nW9g2kQOrdgIYlzr8Hpul1VwUJr3oA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYlJTT9iI-LOAg_CMlpF9ko_7OVXvAMgJlOIm5DqgAdw&oe=6A8852EC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNrhHJSLTz4Q7kNvwFrdZnJ&_nc_oc=AdrFzMLsAwCPgtQ2IKVIZ-XYcE5VHpxWQus13l9zpkSLvdCeJ6ZVF7nP7TX_tZnMcCc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMhS1ngIzrA9VQsoH2XblXrIxSbDcRfGw6UlhzCzotUg&oe=6A8827ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
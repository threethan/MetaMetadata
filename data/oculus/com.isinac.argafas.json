://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvsLbXghlxcQ7kNvwHT-Ptz&_nc_oc=AdrjD05A10VJQ4YUwRN4YnWZZOpURA9bbeALIoVyTc5EKhSSM4329rv-6VK2NNm4wG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzXZKdkxggFjodorhLEJkpMb5UeR1rYzfB2TrJzpLrMw&oe=6AD394C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n58iXJ4nEmMQ7kNvwFnzWmg&_nc_oc=AdqVbhKw2pr1LDuieWVwq-x3Rjd1kFlSJTk19CBgOOsDjR1ZosmR6C6H10lsxXgIJ8o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB12uZtZoSDxNkA39L1X4C04VZvhIdw-pH1mZPbyxB4A&oe=6AD3A1C5"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj08rl2BqrQQ7kNvwF1DqsJ&_nc_oc=AdrTtZxVSfjkJJP2B2W2Z8qAFurlpaJieJRmmdi0iMW3nP4EoqLnaFMwDTnX7vLoJpQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXjo9BYIQaUVGv_N5JCZJrCPSLkMjI7QTLvJUbIPGFvw&oe=6AD395CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFS8z0rYp3oQ7kNvwHHfWVk&_nc_oc=AdrW70_3UTkd6wwFG-W9lFPfBVRCF28wOFEUu_kGptxt3lSeKu_HaXqYfQFSIY1mbVI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd2ozjeYY8QmOkOVSRjTkGfoNYeVixdRnu6NUTTs-41Q&oe=6AD3B0AC"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkA-P2R_PJcQ7kNvwEt9Slb&_nc_oc=AdrCuf6CewYvOTCyRaVncq48bsIgpYcX58LswyoOylKc0JSZBV_TjHAGlXj-kH_DosQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxy7LF_IRu1oKOfAr5H4GkIzwy56TJjvlr_hCYc-RTig&oe=6AD385AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
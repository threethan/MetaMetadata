://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mWZgEi1GoMQ7kNvwF67qPV&_nc_oc=AdoPzmXlWw95jzrB58J6zd9Ukb9zNWw4H7TvpW6EKDJrvBS1pWusUSVBFrjBIZ7qYcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf2SlCLFVrXFrL40aLaVvRTnuL65n7EmgRUhiYwH0YaQ&oe=6A9ED8C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMoNjSrVADEQ7kNvwHg81OD&_nc_oc=Ado84Ej-FpORVJzQoN50zxGNExWr0ReSRKnmfSZucur3TxtI1pb3CIoSiRHGkIBrrnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhTyrkbBVFZLKiSMgqyiKH5E6udR7U1GPRBDwjQYy1gg&oe=6A9EAD85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a9GsjrZMpkQ7kNvwGcqV8w&_nc_oc=AdoB8X4uuWZqX725rSKb7uR0bl0F6H9YSq_M-4qrd64TO52NWBkbnTrhz6RRk4HS2Nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNSiZWl4Mnb4AYxSPaexYmFPiZfDghd3vuWsT9jRAKrg&oe=6A9ED9CD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KOizdbTv2IQ7kNvwHWN2WN&_nc_oc=AdoXhXjq2fKPFteVmMuwPFdeRcP-nlPaZNs7YEfX88dhSi-I-Nh3ZDVvgJvHcXI_kfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEgEJwAZh0cAI9beEjX6pbDpKEbnskaIMzDtlv5o9Pig&oe=6A9EBC6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebXrfejq5aMQ7kNvwE0aeUN&_nc_oc=AdpgtXfi6QtAKEvtN_4LYWGEBmEipZkAFZVzDEoPBNy0-QUjw_cmupbwK96IFVz-Alc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBTDXfE4XHHjCfCbZ0J8JAeynRk6TZP-jg_ItAOY0qOA&oe=6A9EC9AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
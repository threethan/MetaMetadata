://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQVxv3lenwUQ7kNvwHn76hZ&_nc_oc=AdqFQ6hwTsbzX82myK6ll5n9bbt1SS7VzxPGFd_7yyqutQspJFKCa_7YNT7sfJWwFUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA69qfxl98ObjAaP49fZUpkpWf72SjnSShniyixUnSDHg&oe=6A649E85"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUIJjJLBO4sQ7kNvwH5eSkg&_nc_oc=AdrEmrXuXbVY14si3uRoofsolD7hXm9PHPeCqshMP7Hgz50KT-yp6OHn9BPg3WAp3hI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsFo171vQxm6-36EaSbbCS6RFxc-5ddp2-iJniJfUnRw&oe=6A64AB85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R8YZ7rh5pMQ7kNvwHvU97g&_nc_oc=AdouwX_aboNmtonl8Q3zOzmfw6Htp2k723oLrOWv0T8Lv40UZvkCBK2-u7w6kdcots8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMfYiZJd9I5NElk63MNuUmqhxn_iFX1A0QEl_BnZ4bkg&oe=6A649F8D"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CrUDhXpdOkQ7kNvwEigDP9&_nc_oc=AdpM9pHZE5EpEAtQgH6eSxl2USJYC2k37AJuiS2bM-lMvevKHjALMAxBThWf32P_8W0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1Z2wgxswrC0nIIVLtVn0j-keLFjKfcrLGgCw1e3iCJQ&oe=6A64BA6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA_tVE4Bxm0Q7kNvwH1Zz8N&_nc_oc=AdpNMsdxYmLJqC7PnIRSH7slEiQrIDh0C1fVkDq9yaBqzeAy2jFiSV6NWi2eiHcCfNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR1G494btG-1T9ck6FtOH5aDGYdhNoSoLssuwSkTAtAw&oe=6A64C7AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873
6071943635909", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_2106071946969242_3386174246877914404_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90k5AFgFDSYQ7kNvwFEVzk-&_nc_oc=Adp599cuI6DdpZ6kC5rkndxIffg7qVDZmbFM8Bew0gBC89KCJhqMHS_Lprg4gZl_I9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD62t8wELa8lmxg6Vnt0IDBl5YVuRtYZbinBu4YXQXPoA&oe=6A6779C5"}, {"file_name": "captura_4_sala.png", "id": "790830280724676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_790830284058009_4697970295450266005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQGVVpmwr3YQ7kNvwGYvtDi&_nc_oc=AdqUoKB4ssd46f6VNNBrC497D6GOiTjmf0d8W2OK98Mv8c55w-lxhfzBZJlQD-NsEAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiliPJaYmEnae8cwEI5ar5r80GnRP7R96dvW5sGLyE0Q&oe=6A674E85"}, {"file_name": "captura_1_composicion.png", "id": "2417372965419383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_2417372978752715_3676056798419441867_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tZ-_T3DFOoQ7kNvwHKFJiB&_nc_oc=AdqxL8pRyn4lRWGlusf2I2SE7d7SjvorcMNbZy1yil5twEO7ZTeT8rjwpHjUnEcM-kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcjjpeiRNDgKFXpe7Z0WIs_Wfb3iTGqeVH0Y1toTrvWA&oe=6A677ACD"}, {"file_name": "captura_5_cilindros.png", "id": "1769371750910077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1769371754243410_8681517540240733393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CrUDhXpdOkQ7kNvwF_LqT6&_nc_oc=Adq8eBcAqFCuOA11i25Z77cPU9RwAuxShxL3BPLhPzqpCVQbNWq6xpS3eVhM3t_GE_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADFeShhzWFQaHcL_6RiJIZkdpi0qGUYzFPGBSc9vwBYA&oe=6A675D6C"}, {"file_name": "captura_3_circulos.png", "id": "2370304726791984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2370304730125317_9097412645047081263_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA_tVE4Bxm0Q7kNvwEtUvJ9&_nc_oc=Adql-X6UiU9-sbJj1MFWxprKhKc9z-mPsroYxTAiaeV7uIvzsQOOsUruPVRjtcWuRE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEbog6CkTEkyY9F1y6Nlwf9BXJ7N_e0IzRPpV16lU5vA&oe=6A676AAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISINAC AR", "keywords": [], "long_description": "ISINAC AR is the professional tool for ISINAC distributors. Put on the headset in your client's room and design the acoustic treatment on the spot.\n\nWHAT IT DOES\n\u2022 Scans the real room (walls, floor and ceiling) and measures it.\n\u2022 Places ISINAC acoustic panels at real scale on walls and ceilings, with real finishes and colours (ILUCS and IZZER ranges).\n\u2022 Calculates the TR60 reverberation time of the room, before and after treatment, per frequency band.\n\u2022 Auralization: listen to how the room sounds now and how it will sound with the panels installed.\n\u2022 Assigns real construction materials to each surface for an accurate calculation.\n\u2022 Generates a professional PDF quote with room photos, product table, prices and the TR60 chart, and sends it by email from the headset.\n\nFOR DISTRIBUTORS\nSign in with your ISINAC distributor account. Works offline once signed in \u2014 ideal for client visits. Interface available in 23 languages.\n\nISINAC Acoustic World SLU \u2014 melamine foam acoustic panels. www.isinac.com", "short_description": "Place real-scale ISINAC acoustic panels in your client's room with the Quest's passthrough view. Instant TR60 reverberation before/after, listen to the difference, and send a PDF quote by email \u2014 in 23 languages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.isinac.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "ISINAC ACOUSTIC WORLD S.L.U.", "support_website_url": "https://www.isinac.com/", "website_url": "https://www.isinac.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categ
I9JRTuGMTC6TRA&oe=6A8433F1"}, {"file_name": "ScreenShot_8.png", "id": "989623758274801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974798_989623761608134_6922568895917808241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyisyYObUH0Q7kNvwFyCWJr&_nc_oc=Adpv2W5URXhN3S71OQOWMyDC2fUKBcIPEVCBwIlqdxMv6E0fdx3p0U20Vf7PRJpNi1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgND2PZTzOhvlgM80shILBdzT9YY95bhaucXg_tewozg&oe=6A844385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage1.png", "id": "3035900403295034", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_3035900406628367_6381994466917133426_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu14tc1m298Q7kNvwFnmxmJ&_nc_oc=AdqpOzs8uLf4KJ2dp-AMb7KMstDzcgwkwQZXNTJi4MDCy5iJhe3wxADOl-jD35fX1PY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYhIm6fW8FDu45ArPRIwH3BKXI1v5gydKKludxeJO3eg&oe=6A8467A3"}, "display_name": "SwingToMove", "keywords": [], "long_description": "SwingToMove is a multiplayer VR game which you swing your arm to move the character. \n\nIt gives you feel like swim like turtle. Avoid trash and pass the ring to score!\n\nYou can voice chat with your friends and race under water as turtle!\n\nThe game is a early-access version. We love to hear your comment!\nThank you so much to play our game!", "short_description": "SwingToMove is a multiplayer VR game which you swing your arm to move the character. It gives you feel like swim like turtle. Avoid trash and pass the ring to score!"}, {"images": {"nodes": []}, "id": "894420754494656", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc2a4\uc719\ud22c\ubb34\ube0c (SwingToMove)", "keywords": [], "long_description": "\uc2a4\uc719\ud22c\ubb34\ube0c\ub294 VR \uc7a5\uc560\ubb3c \ud53c\ud558\uae30 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\ud314\uc744 \uc704\uc544\ub798\ub85c \uc6c0\uc9c1\uc5ec \ub9c8\uce58 \uac70\ubd81\uc774\uac00 \uc218\uc601\ud558\ub294\ub4ef \ud55c \uc6c0\uc9c1\uc784\uc73c\ub85c \uc774\ub3d9\ud558\uba70, \uc4f0\ub808\uae30\ub97c \ud53c\ud574 \ub9c1\uc744 \ud1b5\uacfc\ud574 \uc810\uc218\ub97c \uc62c\ub824 \ub204\uac00 \uc8fc\uc5b4\uc9c4 Life \ub0b4\uc5d0 \ub9ce\uc740 \uc810\uc218\ub97c \uc62c\ub9ac\ub294\uc9c0 \uacbd\uc7c1\ud569\ub2c8\ub2e4.\n\n\ubcf4\uc774\uc2a4 \ucc57\uc774 \ud65c\uc131\ud654\ub418\uc5b4 \uce5c\uad6c\ub4e4\uacfc \uac70\ubd81\uc774\uc758 \ubaa8\uc2b5\uc73c\ub85c \ub300\ud654\ud558\uace0 \ubc14\ub2f7\uc18d\uc744 \ud5e4\uc5c4\uccd0\ubcf4\uc138\uc694!\n\uba39\ubb3c\uc744 \uc3d8\ub294 \ubb38\uc5b4\ub97c \ud53c\ud574 \uacbd\uc8fc\ud574\ubcf4\ub294 \uc7ac\ubbf8\ub09c \uacbd\ud5d8\uc744 \ud574\ubcf4\uc138\uc694!\n\n\ud604\uc7ac \uc571\uc740 \uc5bc\ub9ac\uc5d1\uc138\uc2a4 \ubc84\uc804\uc73c\ub85c \uac1c\ubc1c\uc774 \uc9c4\ud589\uc911\uc778 \uc810 \uc591\ud574\ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.\n\ub354 \ubc1c\uc804\ub41c \uc571\uc744 \uc704\ud574 \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4!", "short_description": "\uc2a4\uc719\ud22c\ubb34\ube0c\ub294 VR \uc7a5\uc560\ubb3c \ud53c\ud558\uae30 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\ud314\uc744 \uc704\uc544\ub798\ub85c \uc6c0\uc9c1\uc5ec \ub9c8\uce58 \uac70\ubd81\uc774\uac00 \uc218\uc601\ud558\ub294\ub4ef \ud55c \uc6c0\uc9c1\uc784\uc73c\ub85c \uc774\ub3d9\ud558\uba70, \uc4f0\ub808\uae30\ub97c \ud53c\ud574 \ub9c1\uc744 \ud1b5\uacfc\ud574 \uc810\uc218\ub97c \uc62c\ub824 \ub204\uac00 \uc8fc\uc5b4\uc9c4 Life \ub0b4\uc5d0 \ub9ce\uc740 \uc810\uc218\ub97c \uc62c\ub9ac\ub294\uc9c0 \uacbd\uc7c1\ud569\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/swingtomove/%ED%99%88/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "TeamSM", "support_website_url": null, "website_url": "https://sites.google.com/view/swingtomove/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274332
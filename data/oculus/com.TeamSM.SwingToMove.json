b2e4.\n\n\ubcf4\uc774\uc2a4 \ucc57\uc774 \ud65c\uc131\ud654\ub418\uc5b4 \uce5c\uad6c\ub4e4\uacfc \uac70\ubd81\uc774\uc758 \ubaa8\uc2b5\uc73c\ub85c \ub300\ud654\ud558\uace0 \ubc14\ub2f7\uc18d\uc744 \ud5e4\uc5c4\uccd0\ubcf4\uc138\uc694!\n\uba39\ubb3c\uc744 \uc3d8\ub294 \ubb38\uc5b4\ub97c \ud53c\ud574 \uacbd\uc8fc\ud574\ubcf4\ub294 \uc7ac\ubbf8\ub09c \uacbd\ud5d8\uc744 \ud574\ubcf4\uc138\uc694!\n\n\ud604\uc7ac \uc571\uc740 \uc5bc\ub9ac\uc5d1\uc138\uc2a4 \ubc84\uc804\uc73c\ub85c \uac1c\ubc1c\uc774 \uc9c4\ud589\uc911\uc778 \uc810 \uc591\ud574\ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.\n\ub354 \ubc1c\uc804\ub41c \uc571\uc744 \uc704\ud574 \ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4!", "short_description": "\uc2a4\uc719\ud22c\ubb34\ube0c\ub294 VR \uc7a5\uc560\ubb3c \ud53c\ud558\uae30 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\ud314\uc744 \uc704\uc544\ub798\ub85c \uc6c0\uc9c1\uc5ec \ub9c8\uce58 \uac70\ubd81\uc774\uac00 \uc218\uc601\ud558\ub294\ub4ef \ud55c \uc6c0\uc9c1\uc784\uc73c\ub85c \uc774\ub3d9\ud558\uba70, \uc4f0\ub808\uae30\ub97c \ud53c\ud574 \ub9c1\uc744 \ud1b5\uacfc\ud574 \uc810\uc218\ub97c \uc62c\ub824 \ub204\uac00 \uc8fc\uc5b4\uc9c4 Life \ub0b4\uc5d0 \ub9ce\uc740 \uc810\uc218\ub97c \uc62c\ub9ac\ub294\uc9c0 \uacbd\uc7c1\ud569\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/swingtomove/%ED%99%88/privacypolicy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "TeamSM", "support_website_url": null, "website_url": "https://sites.google.com/view/swingtomove/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
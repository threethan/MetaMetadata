scdn.com/v/t64.5771-25/75395596_902085291385237_4630560439466535239_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEdicvcoyFEQ7kNvwGtpejR&_nc_oc=AdrAn7NvCMLlledCA4EjospY3VunCxpZ6hReAOGicopF1jvH2yM_xRmzwehlppFvjfA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1x8gl91GzIB7e9atkcamUYtVVe0gSQ_vxMtMnde2ifg&oe=6B0B443B"}, {"file_name": "smooth drum - screenshots4.png", "id": "5445434742247091", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65398055_5445434748913757_5115244369874882240_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-mbt93YuHIQ7kNvwFQdf53&_nc_oc=AdqI1VPblmHozhYbQabGunpHrLV4oUcYEfled_dJs6_vsuHmpB4gv_qJRhgfJZ6dGhY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4pg_WliRFnJS-EL3ybkTkX0GAtaQf25rq7oR_7kZpnA&oe=6B0B44B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "smooth drum - trailer cover.png", "id": "897006808837180", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974813_897006812170513_8927323887624792810_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1OulNyKbK8Q7kNvwGiw0Qf&_nc_oc=Adqr6lB00rI4AUablYt0VeSxYI1JdrDCIUdI7fCwhqWxG0D8U2NtAny6N4PsuxC_Eo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2xK2sERu1C0NDzlNEBnCaDmJgmjC3fBkbKZZEwTGr-g&oe=6B0B43B6"}, "display_name": "Smooth Drum Roller Safety and Operation", "keywords": [], "long_description": "The smooth drum roller's purpose is to flatten and smooth out uneven surfaces, making them beneficial across industries. It uses vibration, static pressure, and impact to compact materials like sand, gravel, and other aggregate materials, making it perfect for rolling weaker aggregates and compacting asphalt pavements. Smooth drum rollers consist of a large, smooth steel drum in the front, two wheels on the rear end, and a cab where the operator can adjust settings based on the specific project. As part of this engaging simulation, participants will operate a smooth drum roller and complete various tasks on an active worksite. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. \n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a backhoe in a safe and realistic format. Before starting their simulation tasks, participants must wear personal protective equipment (PPE), conduct a pre-operation inspection of the vehicle, and complete one task to familiarize themselves with the operation of the vehicle.", "short_description": "The smooth drum roller's purpose is to flatten and smooth out uneven surfaces, making them beneficial across industries. It uses vibration, static pressure, and impact to compact materials like sand, gravel, and other aggregate materials, making it perfect for rolling weaker aggregates and compacting asphalt pavements. Smooth drum rollers consist of a large, smooth steel drum in the front, two wheels on the rear end, and a cab where the operator can adjust settings based on the specific project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "intern
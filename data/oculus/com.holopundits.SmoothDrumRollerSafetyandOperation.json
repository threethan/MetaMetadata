775eXBPMo5QrSN2jYWsRsto0Guj5EU2R6C6N9aORw&oe=6A54E4BB"}, {"file_name": "smooth drum - screenshots4.png", "id": "5445434742247091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65398055_5445434748913757_5115244369874882240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNOo2w9GdnAQ7kNvwF8FUp3&_nc_oc=AdopWpe_1qiJAdiVT36jMjCz-q2IqFx5En4ewTmpJVdvEP2vFT0wPPn-srffgmWm_FI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5NnDduOnKRrhYQTuqthG91IF79kq24Js5R6Ng-AbVTg&oe=6A54E530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "smooth drum - trailer cover.png", "id": "897006808837180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974813_897006812170513_8927323887624792810_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtTDpFgY-7EQ7kNvwHBAcbQ&_nc_oc=AdqvWCnBaN5QHEX8bLONZ02KgdiBuNFWdrYDPUjlOfrsCeos3Cu1eiTOYIGJDkeWlUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUAFePMY-k2U1KJHg7aM0ovXzEP7cw9bzkvkkM5ip68A&oe=6A54E436"}, "display_name": "Smooth Drum Roller Safety and Operation", "keywords": [], "long_description": "The smooth drum roller's purpose is to flatten and smooth out uneven surfaces, making them beneficial across industries. It uses vibration, static pressure, and impact to compact materials like sand, gravel, and other aggregate materials, making it perfect for rolling weaker aggregates and compacting asphalt pavements. Smooth drum rollers consist of a large, smooth steel drum in the front, two wheels on the rear end, and a cab where the operator can adjust settings based on the specific project. As part of this engaging simulation, participants will operate a smooth drum roller and complete various tasks on an active worksite. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. \n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a backhoe in a safe and realistic format. Before starting their simulation tasks, participants must wear personal protective equipment (PPE), conduct a pre-operation inspection of the vehicle, and complete one task to familiarize themselves with the operation of the vehicle.", "short_description": "The smooth drum roller's purpose is to flatten and smooth out uneven surfaces, making them beneficial across industries. It uses vibration, static pressure, and impact to compact materials like sand, gravel, and other aggregate materials, making it perfect for rolling weaker aggregates and compacting asphalt pavements. Smooth drum rollers consist of a large, smooth steel drum in the front, two wheels on the rear end, and a cab where the operator can adjust settings based on the specific project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7137583
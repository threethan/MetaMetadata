oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KmPJ5yJrNCFvAt4VSv9nXn9E4s8giuIjxztYyDy91Cw&oe=69F34FAB"}, {"file_name": "FL_s3.png", "id": "824006290222270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822550_824006296888936_6096381536973309022_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DSmohVayLUQ7kNvwFotSnX&_nc_oc=AdokfXkgGduC5dGv-c6U5813h_lBszZpdjLZn3ueedbsV32B7vs76RWMhKr788eLw9I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OpM9bxIs4Qf53o8XU34wgGJyOm1vwBuhSW6FwvN8Qaw&oe=69F3439F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FREAKY LAB VR", "keywords": ["cat", "beat", "animal", "fun", "job"], "long_description": "# \ud83e\uddea Welcome to **Freaky Lab VR!** A freaky laboratory in the VR world! \ud83e\uddea\n\nBecome a scientist and perform hilarious experiments. \n\nCreate strange characters \ud83d\udc7e, potions\ud83e\udd64, and have endless fun\ud83e\udd73.\n\n__\n\n# \ud83d\udd2c Experiment! Change your clients\u2019 bodies however you want.\nHorse head? Cactus arms? Giant legs? \n\nAnything is possible!\n\n__\n\n# \ud83e\uddea Mix and discover!\nCollect samples, use elixirs, and see what happens.\n\nEvery mechanic is a new surprise!\n\n__\n\n# \ud83d\udd0a Crazy physics and unpredictable sounds!\nEvery move, every reaction looks and sounds hilariously silly.\n\n__\n\n\n# \ud83d\ude02 Humor and laughter!\nNothing here is serious!\n\nRidiculous situations, goofy ideas, and loads of joy.\n\n__\n\n# \u2728 Create, experiment, and play like a true mad scientist!\n\n\n**Complete missions. \u27a1\ufe0f Unlock new tools and gadgets. \u27a1\ufe0f Experiment, discover, and laugh as much as you want!**\n\n\nFreaky Lab VR \u2013 anything can happen here!", "short_description": "Step into Freaky Lab VR \ud83c\udf1f and become a crazy scientist! Have fun with experiments, change people\u2019s appearances \ud83c\udfa8, mix potions, and create hilarious effects.\nPlay with character physics \ud83c\udf00, and enjoy the reactions \ud83d\ude31.\nCreate, discover, and have endless fun! \ud83e\udd73\ud83e\udd73\ud83e\udd73"}]}, "developer_name": "VR Factory Games S.A.", "developer_privacy_policy_url": "https://vrfactory.pro/our-games/freaky-lab-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VR Factory Games S.A.", "support_website_url": null, "website_url": "https://vrfactory.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "679605416902314"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "755552780682189"}, {"status": "PUBLISHED", "id": "4248854581998555"}, {"status": "PUBLISHED", "id": "1414235676758522"}, {"status": "PUBLISHED", "id": "1456250078807017"}, {"status": "PUBLISHED", "id": "1542001836952586"}, {"status": "PUBLISHED", "id": "1207401321277245"}, {"status": "PUBLISHED", "id": "1135557188647164"}, {"status": "PUBLISHED", "id": "870366838905623"}]}, "baseline_offer": {"id": "1456250078807017"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "755552780682189"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25796042443425974", "version": "1.1876"}, "id": "1176308433280999", "channel_name": "LIVE"}]}, "is_for_oculus_keys
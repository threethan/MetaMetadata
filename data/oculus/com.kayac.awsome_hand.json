ontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_3115592055280221_86018876380306558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQTS8F66t0EQ7kNvwG0MVis&_nc_oc=AdrGHqcWN9CroFaKC24fGgrg_H8Wb3C3MZWLVX0-3yVNp2HsIEJyTjbmwoer2CfB_3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2x5o8EAtaGtsX6EE2bVAa7x9dlmUeD0QSu6xn1oI6JA&oe=6A9D6459"}, {"file_name": "Lv18_filter.png", "id": "1593708305103796", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618254_1593708308437129_1596989496089793648_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbdvQ8JTQJgQ7kNvwFSHVcT&_nc_oc=AdqHswLdXpRQiDeomTEsNQj-KcQwBUhxH0ZLMhs1nrLygDkySe9zlua-5PeGHNDY4j8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN97YwIiygS97GXiHf-GJFRBMQeZglKUUkHSQBvP5FkQ&oe=6A9D686C"}, {"file_name": "lv53.png", "id": "1140693334684254", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_1140693338017587_9643885209414429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujo6DDwQzxkQ7kNvwH8aUZS&_nc_oc=AdrqU4f9aK1LZq5xW5MBi8uV0Krqo9CAQVhr7P1ubujkPjbuQvR0YEc-SvcRBHksyT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxRnPFx7VQCVYXvgCxSFFkfPLAs1tn3E9p6b7F78BQyw&oe=6A9D7C26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "523755789-f3575e8b-30e1-4898-a957-f76ed037fdbd.png", "id": "1675424156984871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619096_1675424160318204_2070619056344330898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VxlmWJN7sIQ7kNvwGx0l2p&_nc_oc=Adqq5Py4NQOD5M6-QxSwfYvDSKMujdBqr-A9HJ_E2lkZLw8Rt929Ynb-arxwbbQXzaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA3SKUsXaErGM0J3Z4PYIqjArXeEJ6tkbdIiCJo7SwxQ&oe=6A9D57E3"}, "display_name": "Awesome Hand", "keywords": ["Hand", "Tracking", "Puzzle", "Casual", "Game"], "long_description": "**Which is more flexible \u2013 your mind \ud83e\udde0 or your wrist \ud83d\udd90\ufe0f?**\n\nAwesome Hand is a hand-tracking VR puzzle where your hands are the controllers.\nNo controllers needed \u2014 your real hands become the game\u2019s input device.\n\n# \ud83c\udfc6Official Award Recognition\ud83c\udfc6\nThis game received the  **Best Implementation of Hand Interactions** special award in the **2025 Meta Horizon Start Developer Competition**, Meta\u2019s official developer competition.\n{1575642900340013}\n\n# Hand-Tracking Puzzle Gameplay\ud83d\udc4d\nUse your palms and fingers to curve the ball\u2019s path, interact with playful hand-based gimmicks, and guide it all the way to the goal.\n\nThe rules are simple, but mastering how your movements influence the ball creates an addicting blend of physical skill and spatial problem-solving.\n\nWhether you want a light, relaxing experience or a clever challenge, Awesome Hand lets you play at your own pace.\n\n# 135 Handcrafted Stages\ud83d\udc4b\nIt features 135 handcrafted stages to test your creativity and control!!", "short_description": "So which is more flexible, your mind\ud83e\udde0 or your wrist\ud83d\udd90\ufe0f? \nAwesome Hand is a hand-tracking puzzle where your hands are controllers. Curve the ball\u2019s path with palm and finger moves to reach the goal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kayac.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KAYAC GAMES", "support_website_url": null, "website_url": "https://kayac.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_
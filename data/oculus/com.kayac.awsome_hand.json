ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_3115592055280221_86018876380306558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vWb6QZ_ZAMQ7kNvwFAfmJM&_nc_oc=AdqBXibH8QImVc0ySmnNLcoKwLq2UUtXNUiqSLVSrMGwxy31KZ--KBMyqeXxVrs1Crg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP21u_ueDng15wYmO9hTM6jYLCdw8X0VEa1hWz0sZEtWQ&oe=6ABFAB59"}, {"file_name": "Lv18_filter.png", "id": "1593708305103796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_1593708308437129_1596989496089793648_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EdlN1bH6G0Q7kNvwHVt9SC&_nc_oc=Adr4vVd-oQztm1FUb5D4Ev6ngx_sDoQ8Q8CFC2SbY9SR6E1f6Zv57YOOiQZrzbvEi78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjQyqOdzTdWPPTZArmnn-rrqlLMwDqPektf2eFiieKbw&oe=6ABFAF6C"}, {"file_name": "lv53.png", "id": "1140693334684254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619113_1140693338017587_9643885209414429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSaUn3rKaCIQ7kNvwFId2Pd&_nc_oc=Adr8qc_WG8EIws4pjr5l1ZR-Vjv0RskSgFYPwlHZMqCECTK-1b9H6qON3bupHk2dTyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUngGSn-RMBh3sWVFYaoKrle9zkeO98yIBEzw_tjT9tw&oe=6ABFC326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "523755789-f3575e8b-30e1-4898-a957-f76ed037fdbd.png", "id": "1675424156984871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_1675424160318204_2070619056344330898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FR4aKnTHmM0Q7kNvwH_CgZO&_nc_oc=AdoeKsEWYW7j4_kREhw5Apsax5kBiTFdL09-V3rFp9VlbDQopYNG--HaaEdqbfEpSEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLQCsU07xLIfLNE3iGj4xFGFmSKdNFzMxjByoqMHtYTQ&oe=6ABFD723"}, "display_name": "Awesome Hand", "keywords": ["Hand", "Tracking", "Puzzle", "Casual", "Game"], "long_description": "**Which is more flexible \u2013 your mind \ud83e\udde0 or your wrist \ud83d\udd90\ufe0f?**\n\nAwesome Hand is a hand-tracking VR puzzle where your hands are the controllers.\nNo controllers needed \u2014 your real hands become the game\u2019s input device.\n\n# \ud83c\udfc6Official Award Recognition\ud83c\udfc6\nThis game received the  **Best Implementation of Hand Interactions** special award in the **2025 Meta Horizon Start Developer Competition**, Meta\u2019s official developer competition.\n{1575642900340013}\n\n# Hand-Tracking Puzzle Gameplay\ud83d\udc4d\nUse your palms and fingers to curve the ball\u2019s path, interact with playful hand-based gimmicks, and guide it all the way to the goal.\n\nThe rules are simple, but mastering how your movements influence the ball creates an addicting blend of physical skill and spatial problem-solving.\n\nWhether you want a light, relaxing experience or a clever challenge, Awesome Hand lets you play at your own pace.\n\n# 135 Handcrafted Stages\ud83d\udc4b\nIt features 135 handcrafted stages to test your creativity and control!!", "short_description": "So which is more flexible, your mind\ud83e\udde0 or your wrist\ud83d\udd90\ufe0f? \nAwesome Hand is a hand-tracking puzzle where your hands are controllers. Curve the ball\u2019s path with palm and finger moves to reach the goal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kayac.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KAYAC GAMES", "support_website_url": null, "website_url": "https://kayac.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_
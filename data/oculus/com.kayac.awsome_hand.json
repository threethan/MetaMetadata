ontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_3115592055280221_86018876380306558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR8IW-R5pyUQ7kNvwEPyfDg&_nc_oc=AdpEvzE2fyAOltzlFwAL9NQ9Fm4FgVhdRqjciCMUYVOlcNESnZoGqUEWdxAjwNX0Lic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T4UvhD8HU8dZhwcNgUB7_u5J7o3nW6zsYUiTXPuWj4A&oe=69FB3BD9"}, {"file_name": "Lv18_filter.png", "id": "1593708305103796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618254_1593708308437129_1596989496089793648_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HNj3NqMqQAQ7kNvwE6ZkvO&_nc_oc=AdrEFzshaEhhbMMhi5Oz1LYz6ZWz3Wx-ZKswO9DHsZ-8uKhXILIq9rk8lezc2T-1cYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VFlWtG_P2fJIdXT-caV5mS5wUSZMEJDoh2wJxKu0Bew&oe=69FB3FEC"}, {"file_name": "lv53.png", "id": "1140693334684254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_1140693338017587_9643885209414429_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G71mgPVHuQoQ7kNvwEDSVYI&_nc_oc=AdoDauveRDGLOGN5MdD_ZmgeL8yYzBwuQFKuMDi5r7msbxWfu8T9GFHo_akOUNqMWns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tUCP-hiB4ATtGIiv0ULo2lwB-VQSk1EGjdNuY2UADRA&oe=69FB53A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "523755789-f3575e8b-30e1-4898-a957-f76ed037fdbd.png", "id": "1675424156984871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1675424160318204_2070619056344330898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl3WZ2McUw8Q7kNvwFKBdU2&_nc_oc=AdqQCpA_jP3OFguaFqcKSfEAb2rcBJ9JikxYUWgHxuci4xnu6tlVG1CK16cxjKMMKGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TkfmjdSTgcPkRKVgoRhXG2053InBWS5GHQcs9R-Nnzg&oe=69FB2F63"}, "display_name": "Awesome Hand", "keywords": ["Hand", "Tracking", "Puzzle", "Casual", "Game"], "long_description": "**Which is more flexible \u2013 your mind \ud83e\udde0 or your wrist \ud83d\udd90\ufe0f?**\n\nAwesome Hand is a hand-tracking VR puzzle where your hands are the controllers.\nNo controllers needed \u2014 your real hands become the game\u2019s input device.\n\n# \ud83c\udfc6Official Award Recognition\ud83c\udfc6\nThis game received the  **Best Implementation of Hand Interactions** special award in the **2025 Meta Horizon Start Developer Competition**, Meta\u2019s official developer competition.\n{1575642900340013}\n\n# Hand-Tracking Puzzle Gameplay\ud83d\udc4d\nUse your palms and fingers to curve the ball\u2019s path, interact with playful hand-based gimmicks, and guide it all the way to the goal.\n\nThe rules are simple, but mastering how your movements influence the ball creates an addicting blend of physical skill and spatial problem-solving.\n\nWhether you want a light, relaxing experience or a clever challenge, Awesome Hand lets you play at your own pace.\n\n# 135 Handcrafted Stages\ud83d\udc4b\nIt features 135 handcrafted stages to test your creativity and control!!", "short_description": "So which is more flexible, your mind\ud83e\udde0 or your wrist\ud83d\udd90\ufe0f? \nAwesome Hand is a hand-tracking puzzle where your hands are controllers. Curve the ball\u2019s path with palm and finger moves to reach the goal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kayac.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KAYAC GAMES", "support_website_url": null, "website_url": "https://kayac.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_
53758038", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830589_1933155057091371_6268471673274798880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVGW0H-wP7YQ7kNvwFi1eoG&_nc_oc=Adm2YmrQg04qOFDF5o_GqneIYUIzybJOzv7roLLlUglkjFSkjr5yWwU3BkcX7H7F_kE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVw0uxmTQ6qD_XTKPjgI6-Ax6vTCs8pu_864Mx0IUeBw&oe=69BAA1BA"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "3021849741310135", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824621_3021849744643468_5205794030606188015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsA-EF-_g4kQ7kNvwH6_F_o&_nc_oc=AdnS9NxubXdjWMUTrmZ_q9RplBGe80Y4j_dpOiybsyWKdt--7ywNchi43aDxMgUhLOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw09IEI591DUad_R1gN9QT1t4qmAZX55XzpXoFHz-KhYQ&oe=69BAA9B0"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "2517401845318351", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824533_2517401848651684_4803484512760012863_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7OOtCUurU0Q7kNvwFZe2OX&_nc_oc=AdnYGfrWQ7wgMHy8phxgzLObaneSSFWkSiNtiFpkt4s1FKW_hDKJPn0N7p42qfqoSIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE3Xiuvh3bTsACZ46nyn1cewBUgdfcrBBRSvN0L_qndA&oe=69BAB862"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "687058207178666", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825095_687058210511999_2058666401068865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJbvhqcmTakQ7kNvwFuyrRe&_nc_oc=AdkLrL1_dTv9oQrOSBB6uXVYreCt-KUaNouKET83683Kcn7jTuxWx1wPcCiN_4OA4N0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzuwx5qFSD5o8VmXubRe67hcJxTWdDpPqSfZOH7wHKIiA&oe=69BA87B6"}, "display_name": "San Paolo Vecchio - Affreschi nascosti", "keywords": ["San", "Paolo", "Affreschi", "Assorestauro", "BSOD"], "long_description": "**San Paolo Vecchio - Affreschi nascosti - VR**\n\nEntra nella storia come mai prima d'ora. Esplora e scopri capolavori nascosti della Chiesa di San Paolo, un gioiello nel cuore di Ferrara. Questa app ti offre un'esperienza immersiva unica che combina l'arte e la tecnologia della realt\u00e0 virtuale per svelare affreschi preziosi, rimasti nascosti per secoli dietro le mura del tempo.\n\n**Diventa protagonista!**  \n\nGrazie a scansioni 3D ad altissima definizione e ricostruzioni fotogrammetriche, potrai navigare virtualmente all\u2019interno degli antichi spazi della chiesa. Rivela affreschi celati, apprendi dettagli artistici e storici, e rivivi il fascino del lavoro dei restauratori.\n\n**Funzionalit\u00e0 principali:**\n\n- **Immersione Completa:** Usa il tuo visore Meta Quest per un viaggio nel tempo altamente realistico.\n- **Interazione Attiva:** Utilizza strumenti virtuali intuitivi per scoprire dettagli invisibili ad occhio nudo.\n- **Narrazione Guidata:** Approfondisci la conoscenza degli affreschi e della storia di Ferrara con una narrazione ricca di curiosit\u00e0 e informazioni storiche.\n\n**Ideale per:**\n- Appassionati di storia, arte e cultura.\n- Studenti e ricercatori che desiderano approfondire in maniera interattiva.\n- Turisti che vogliono preparare o prolungare una visita fisica ai luoghi storici di Ferrara.\n\nScopri un patrimonio culturale unico, con \"San Paolo Vecchio - Affreschi nascosti\" vivi il passato in prima persona e contribuisci virtualmente alla tutela della memoria storica.\n\n**Installa ora e inizia il tuo viaggio nel tempo!**\n", "short_description": "Esplora affreschi nascosti, antiche cappelle e miracoli svelati. . Con questa esperienza VR immersiva, diventa restauratore per un giorno ed esplora i segreti del patrimonio culturale di Ferrara come mai prima d\u2019ora. Scopri e svela la storia in un viaggio interattivo tra arte, storia e tecnologia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bsod.studio/san-paolo-vecchio-ver-privacy-po
98880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrdxGEbf7xEQ7kNvwFxPf97&_nc_oc=AdlrbAk-LFF4y4Ffh7t2-AuTnKBKByQtmFSpfBQpoan55Ll0-lwKnVQdu2Zp0kpzKwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyGotWZcThc81o3Mstrhkv1cwGcAwD66ipkb2KaYAH_bQ&oe=69B2B8BA"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "3021849741310135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824621_3021849744643468_5205794030606188015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC663rrFpwwQ7kNvwHhX4AJ&_nc_oc=AdlDv0PANN9PuSLYt5TcJZzrUvCY8MXRhYLgEd8SoaUtKkb2KXyNF2T5a01x1plywaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTKMhlQ1uet5xxcaCh6vIrbug2KEUIX4R-A3R5GHl2yw&oe=69B2C0B0"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "2517401845318351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824533_2517401848651684_4803484512760012863_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSTcobylF3oQ7kNvwFAzm3H&_nc_oc=Adnx_Gi8aqlbZfPGTVXgoKd1wwCB05sX9pB2_zu3_HWoRzLQXxeXbZqrDHJiF1CjrM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIs7JGjibiysSN0qphA76h5JPwZTC2kPvjs8UGC8T_jQ&oe=69B2CF62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "687058207178666", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825095_687058210511999_2058666401068865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APnQjYtLPSoQ7kNvwEBVnTu&_nc_oc=AdkdJKoyS6lvVykrahm6yNnl_4p-E_MbCt0aKQQd8TzXagFmrDSqKBRMV5pl_bldSws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxI_B7yWy17nGBrDoero6mE_qq8-o1gyuqmPLZFZWHRng&oe=69B29EB6"}, "display_name": "San Paolo Vecchio - Affreschi nascosti", "keywords": ["San", "Paolo", "Affreschi", "Assorestauro", "BSOD"], "long_description": "**San Paolo Vecchio - Affreschi nascosti - VR**\n\nEntra nella storia come mai prima d'ora. Esplora e scopri capolavori nascosti della Chiesa di San Paolo, un gioiello nel cuore di Ferrara. Questa app ti offre un'esperienza immersiva unica che combina l'arte e la tecnologia della realt\u00e0 virtuale per svelare affreschi preziosi, rimasti nascosti per secoli dietro le mura del tempo.\n\n**Diventa protagonista!**  \n\nGrazie a scansioni 3D ad altissima definizione e ricostruzioni fotogrammetriche, potrai navigare virtualmente all\u2019interno degli antichi spazi della chiesa. Rivela affreschi celati, apprendi dettagli artistici e storici, e rivivi il fascino del lavoro dei restauratori.\n\n**Funzionalit\u00e0 principali:**\n\n- **Immersione Completa:** Usa il tuo visore Meta Quest per un viaggio nel tempo altamente realistico.\n- **Interazione Attiva:** Utilizza strumenti virtuali intuitivi per scoprire dettagli invisibili ad occhio nudo.\n- **Narrazione Guidata:** Approfondisci la conoscenza degli affreschi e della storia di Ferrara con una narrazione ricca di curiosit\u00e0 e informazioni storiche.\n\n**Ideale per:**\n- Appassionati di storia, arte e cultura.\n- Studenti e ricercatori che desiderano approfondire in maniera interattiva.\n- Turisti che vogliono preparare o prolungare una visita fisica ai luoghi storici di Ferrara.\n\nScopri un patrimonio culturale unico, con \"San Paolo Vecchio - Affreschi nascosti\" vivi il passato in prima persona e contribuisci virtualmente alla tutela della memoria storica.\n\n**Installa ora e inizia il tuo viaggio nel tempo!**\n", "short_description": "Esplora affreschi nascosti, antiche cappelle e miracoli svelati. . Con questa esperienza VR immersiva, diventa restauratore per un giorno ed esplora i segreti del patrimonio culturale di Ferrara come mai prima d\u2019ora. Scopri e svela la storia in un viaggio interattivo tra arte, storia e tecnologia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bsod.studio/san-paolo-vecchio-ver-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Dashboard", "support_web
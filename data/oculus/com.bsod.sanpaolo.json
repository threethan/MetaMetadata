: "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830589_1933155057091371_6268471673274798880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbkJT8FYT84Q7kNvwGqAvlZ&_nc_oc=Adrg0aRSsrE-j7lfmmDISICJxIIEMmmbW33t-gBp-S_-IaZwjogrI5rpYnWqgH2E7NQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z9oxtlGuZgTpxU25YWEoy5EWbkxZC7aWSkMGLzDkQqw&oe=6A411ABA"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "3021849741310135", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824621_3021849744643468_5205794030606188015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlzOZcgk1FEQ7kNvwFOGGK0&_nc_oc=Adp7KRSaLYAXnA7VA4M_-QoDvPgwwSx5nRc5zyCtIkiaIItUKPhg6bom86gZLBg8Avc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xI8BBTz4rwVAjKWMDuJJ7Pspoa17R7JtCWPsg1-5-QQ&oe=6A4122B0"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "2517401845318351", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824533_2517401848651684_4803484512760012863_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APa7SaDUaM0Q7kNvwEl_f_V&_nc_oc=AdoZkgY3zlLrMc9lM9CRF6CKj3y4y4UEa9yj5kj1sxrsk5l30N1pFHhAukbPz6sIUoI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2U7QrV1zmuXq5iBJPGYWyEzDyNPKUTMeV_iLGoHUgnA&oe=6A413162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "687058207178666", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825095_687058210511999_2058666401068865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9JCYfYXO24Q7kNvwEG104r&_nc_oc=AdraBtTi8--Sw94tCh2kBVlXqsXwStWKGGNKNLasAobkOQOF0gTs8tiWbO8eq5b6sXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eU216bGg1J-NWWfOCvbjbV_IpHno8j81fzt1l6rVvew&oe=6A4138F6"}, "display_name": "San Paolo Vecchio - Affreschi nascosti", "keywords": ["San", "Paolo", "Affreschi", "Assorestauro", "BSOD"], "long_description": "**San Paolo Vecchio - Affreschi nascosti - VR**\n\nEntra nella storia come mai prima d'ora. Esplora e scopri capolavori nascosti della Chiesa di San Paolo, un gioiello nel cuore di Ferrara. Questa app ti offre un'esperienza immersiva unica che combina l'arte e la tecnologia della realt\u00e0 virtuale per svelare affreschi preziosi, rimasti nascosti per secoli dietro le mura del tempo.\n\n**Diventa protagonista!**  \n\nGrazie a scansioni 3D ad altissima definizione e ricostruzioni fotogrammetriche, potrai navigare virtualmente all\u2019interno degli antichi spazi della chiesa. Rivela affreschi celati, apprendi dettagli artistici e storici, e rivivi il fascino del lavoro dei restauratori.\n\n**Funzionalit\u00e0 principali:**\n\n- **Immersione Completa:** Usa il tuo visore Meta Quest per un viaggio nel tempo altamente realistico.\n- **Interazione Attiva:** Utilizza strumenti virtuali intuitivi per scoprire dettagli invisibili ad occhio nudo.\n- **Narrazione Guidata:** Approfondisci la conoscenza degli affreschi e della storia di Ferrara con una narrazione ricca di curiosit\u00e0 e informazioni storiche.\n\n**Ideale per:**\n- Appassionati di storia, arte e cultura.\n- Studenti e ricercatori che desiderano approfondire in maniera interattiva.\n- Turisti che vogliono preparare o prolungare una visita fisica ai luoghi storici di Ferrara.\n\nScopri un patrimonio culturale unico, con \"San Paolo Vecchio - Affreschi nascosti\" vivi il passato in prima persona e contribuisci virtualmente alla tutela della memoria storica.\n\n**Installa ora e inizia il tuo viaggio nel tempo!**\n", "short_description": "Esplora affreschi nascosti, antiche cappelle e miracoli svelati. . Con questa esperienza VR immersiva, diventa restauratore per un giorno ed esplora i segreti del patrimonio culturale di Ferrara come mai prima d\u2019ora. Scopri e svela la storia in un viaggio interattivo tra arte, storia e tecnologia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bsod.studio/san-paolo-vecchio-ver-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Dashboard", "support_website_url": null, "website_url": "https://www.bsod.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28461447586837191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831068_531090229796236_7893277545334235202_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2uHDKQyeswQ7kNvwFT1fP2&_nc_oc=Adpf0XBl_gGyaq9asd6PApEil8TDiPQ0eBbdcdY4E3WSr8Y1UZs6jg58MlMulU4ADY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af854e00HG9r9gqJUfl-GhYPZ3EQZMYNLfgZAD_Ytma2kw&oe=6A411F5F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "San Paolo Vecchio - Hidden Frescoes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1744815960, "lastRevision": {"nodes": [{"id": "28461447636837186", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28461447550170528", "is_first_party": false, "enables_in_app_ads": fal
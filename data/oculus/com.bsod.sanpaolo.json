c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMPB3iw3oi0uzmsDwEEkViZ7ysqDBWYK0dsl8QYioMjg&oe=6A4E4167"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l48oY0AJbwsQ7kNvwE5_qbo&_nc_oc=AdrH0qSv9jcy2JDlLP1FJBsuzGtHUJ5Q9_6qAa4--Hcstb4KFbc-SmGsQnIAX7i-qfQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq4MucaOr_KDZFOYc8LJwqe8gbjJ03_4-d8vXtJAUJ0Q&oe=6A4E5031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq6YnyWZZ_4Q7kNvwEmbUDo&_nc_oc=AdpBBD4Rwyv1TBMwVXucsqHjEIdEbWVZGK9nSEaEjr8J37yvzC7yQ4bR553jFFQb74k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYTRJ0tz_bkVy45deolmVoCw7bkaF2mDzOP8Hdvdk0Qw&oe=6A4E5419"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA-bqrWrnTEQ7kNvwHetovL&_nc_oc=AdpPVvE6cJOaqgG0vXoRWDgjRiWMzOYcDh7KOtzGfhUs62VZZkoBt1q7HtKtrXIcRdo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG74BFSh9Ov1WeJ-M7Jj7dRVYBUy8LANQVReHVBrHHNg&oe=6A4E6B76"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwLGaB-PpqQQ7kNvwF52hkB&_nc_oc=Adpf9KjUttUwA0MfVjdtTNfF0kCmJOHmgvXE38puULlXLXv4OWKrL5uuvdU_SNT8OVk&_nc_zt=3&_nc_ht=
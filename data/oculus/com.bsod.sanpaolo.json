: "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827867_589180484142828_266929031235457912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy-X69Odzr4Q7kNvwFrBGhs&_nc_oc=AdmG-QZiFESMe3K2tKj85hOnqzINIXgC_nLBiN-JmKXh4WQ_FIQ0zMer71HxFzdKWno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSPeZrUaF-y7HY5UrThgPvAHGibA7IJ_ybdCkP8pWKWg&oe=699AE845"}, {"file_name": "screenshot_0000_Screenshot-2025-04-10-113143.png", "id": "1176925730331466", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_1176925733664799_3790371368702893484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41vHhxvSZ5sQ7kNvwG5BvgQ&_nc_oc=Adkqo4xRSbaGyF1Pm7fR4iKDoQZmTL9IR568G2IapUO9k-i1NNokgCtrBUWWzoG4gOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvZu3CrpcVAJfWg-R-LZ15Nu5vCU8JOzl9-SkMQnbL8iA&oe=699AEBCE"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "1018396219679557", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828895_1018396223012890_5107840577383576045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIMi-tBGg_0Q7kNvwE5I5my&_nc_oc=AdlGWhh_SICzWi3yMLXKaA3scy_hLCi4573T9Dg_-Q1SNHUg4WzHBLPBq38-wg_XAs0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv7wkly-0opHuaBeqi-lhkJEyUKWqI0ugpwKgaFHQ6FVw&oe=699AF038"}, {"file_name": "screenshot_0004_Screenshot-2025-04-10-112719.png", "id": "2091812787933632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830787_2091812791266965_7439820487698740197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBvFojpQJe0Q7kNvwEJkZgR&_nc_oc=AdlWjr-jHVOLJxHXC-ggGRMvx_1OlyrupPiZC1RFWGXo53eA74VNqAMrxGQNnstfDV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv8232QR2YaqKDt6Abt-ahObGENb2bTay_QuKBxsBLDug&oe=699AF567"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isctujO3BKQQ7kNvwHRg0Rs&_nc_oc=AdmlKOqUezI6ziLIOcTgxh5pOJsWLXsjOMnmM8IC01ExSodL6_hGRswzInpE5tMEBEM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvlPnMjZ-OuxrnNsPHdHEZYIr_t4Ll8DOOUKX36a9RB2Q&oe=699B0431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS2p844vjJgQ7kNvwEH5uGh&_nc_oc=AdmmTskFxZQVwRIPBm_FfT2ZQaMKIRvgEOh4t0Bgqmp-PQK7pHfB3ix-oY7QBX8bNBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftciITA3o8XornrwGKzjJlXwdpk5Uc29-YSwbHjr69pQg&oe=699B0819"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iDzPpg2rawQ7kNvwHN_qaf&_nc_oc=Adn1SY8O0oy5PJ0N9dRE8AROJQrnq2K-QPdIqpDCubJW2VEiiTV-xsAEHmG10zKcPn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsgYzWPETa5LESiOaUL7VytsIGxS2Eetnyi7d8XqmKFog&oe=699AE736"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ala9BqjYRegQ7kNvwFCrDcB&_nc_oc=Admu3Y-Dhos0NJ7YgI01CeQFI-EwBiod6Oe2RRZ4deUQAVHJ7UYby9zpWpqJQEBSpHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmrQuW6pU5pjUYU2Y-6j8MCVm4KUXtjrPu95Roj6j_sw&oe=699B0294"}, {"file_name": "CoverImageSafeAreaTemplateLandscape_SANPAOLO.png", "id": "1243210453909475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824513_1243210457242808_4833206868291161260_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znthW0yN6BEQ7kNvwGj9FY_&_nc_oc=AdnxG
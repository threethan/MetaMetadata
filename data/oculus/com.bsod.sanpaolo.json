: "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827867_589180484142828_266929031235457912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy-X69Odzr4Q7kNvwFgZcl7&_nc_oc=Adn7-Q9_ScWtNNKMht2F73XkInkuBZuNbIMW66dWozLPEw-OYBG3nVsr0kxG0VT8SGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftKUmsMKxC76WVauQ_VEKjm6S9L1-7goIGu2OWtwrm-hg&oe=69984545"}, {"file_name": "screenshot_0000_Screenshot-2025-04-10-113143.png", "id": "1176925730331466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1176925733664799_3790371368702893484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rC19rzA0K8Q7kNvwGKqcYT&_nc_oc=AdnalDnPj9hK60BcKcdQcnVMriXeZWHpraHgLGlti0YUoCwacSc_ONlXZI74mtn1Ao8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfshmOqpOMTnhWGq6fp6WEwGChwI4hjp_YP2fOnTGLLKgg&oe=699848CE"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "1018396219679557", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828895_1018396223012890_5107840577383576045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSPNvdJ-NGUQ7kNvwGdxYsi&_nc_oc=AdkS8Il44iRyE_8ocdAPoTckH1VO3roweTobUpyafX0HjGBQDV2xg-pnP3QyOVbwXv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs69NbS--Isie-TdDVeUGk5lobQ3a9HBHkqQ-kNj__fcQ&oe=69984D38"}, {"file_name": "screenshot_0004_Screenshot-2025-04-10-112719.png", "id": "2091812787933632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830787_2091812791266965_7439820487698740197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNhMh9h1bmsQ7kNvwFWcosG&_nc_oc=AdnxGCpssAM1OZhdXlEFDwUWBAG6Ek6ecnNYxcpXuNzTaFVnklxbAoGfTlzhmt3ngxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft6_55OSc-l9Rtj7bVDxYdvCdwcewpwTIB21KxHoN3xjw&oe=69985267"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f-gCsg5XtYQ7kNvwFbfoVL&_nc_oc=AdlM_6wRkHbRdGC0fXD4K66PcM-O10Bi2puQ5k5MeKsbVSD57WdR4soGlM-ebzijl_0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs4reOGDrwfPILeIKdiNe-okLbm9F1b4GwmbcFoxZdTbA&oe=69986131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntS5TGhYI5UQ7kNvwGL0xLK&_nc_oc=AdnGrY_725oAxkLlmtIT8XWwz2ONvjo0QYGiuTJIB5FNTddXqRUyE-CcQQuT2bQ2P20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuenw2VKKhdnRp6PYGhQzJ4NM1BQ7Y9OT55DKEdY71OJw&oe=69986519"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iDzPpg2rawQ7kNvwHx1kOI&_nc_oc=Adkte-vxyNl9rG9XhFvDgNHfRmtfM26NVDtktGNx99zeFoycrfJz6e-zvlO_RqAYiMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu8dsqSQrQ_dXTlYh8gCEnVTsHCfcMipws1dOpwO-hsXw&oe=69984436"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGFgOru3lKsQ7kNvwEcGRU6&_nc_oc=AdncBwkY3sXgO7eCsY_j2PF41hxsLpSSE2jq5eW1SEuM_2mJBYveZBkqoyuhU5YOeio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftKY3zyEPXVjqnsQ92Ovhy-LFA2JmrZmGrTpXR46NznAQ&oe=69985F94"}, {"file_name": "CoverImageSafeAreaTemplateLandscape_SANPAOLO.png", "id": "1243210453909475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824513_1243210457242808_4833206868291161260_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcZHph3jelYQ7kNvwFKpQUg&_nc_oc=AdkKe
eenshots": [{"file_name": "screenshot_0002_Screenshot-2025-04-10-121726.png", "id": "589180480809495", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827867_589180484142828_266929031235457912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkt4uPILTWUQ7kNvwHvRirR&_nc_oc=AdoGh5FzIV3usd1T7r5B7dqpyAf4e2vtpCfhD3i6tIq-i4mQDaEJU9Fg14E7EXVBHDI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f1ZnJaJHaqAoOnArBM_KW31yxN6Q2sHHgYR09jTftvQ&oe=6A11C785"}, {"file_name": "screenshot_0000_Screenshot-2025-04-10-113143.png", "id": "1176925730331466", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491827725_1176925733664799_3790371368702893484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psolQKwwDpsQ7kNvwHJ8Zfi&_nc_oc=Adq2OhDj6g0EAIX6BFXFKa5IFJ6nQmMEl8CnPgvI87_HqCq84i_pTSC9O66u1lxjBag&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mVculq2tt-s_4VoPuzzfNURA3JJ5_UKarh7tNfvG39Q&oe=6A11CB0E"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "1018396219679557", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828895_1018396223012890_5107840577383576045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=incqnGBwfU8Q7kNvwG8jy1F&_nc_oc=AdoFZrzkVymTyN2EUPvV5F3toIsCRTTSaxHxdNUIncsX6rMhcC_JDUXNqYL2YKhkSLs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uiZ7TuzZlPQ2mLeKSgCLu3Xdn3e3Ab3zu_1toFdgxsg&oe=6A11CF78"}, {"file_name": "screenshot_0004_Screenshot-2025-04-10-112719.png", "id": "2091812787933632", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830787_2091812791266965_7439820487698740197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrWrdQIzc4YQ7kNvwFnpX3s&_nc_oc=AdrUF3GPUcWMjAaXsh-fYSesB15gG4YZQAtFOYWP1gFF6s1fDHcMXdRMHuC3XbL968M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PNxQ3s8ReiljMTPoyY8biqgvpWz3b7hn98-7ZbTWk3Q&oe=6A119C67"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRmve-fSp6oQ7kNvwHTGym-&_nc_oc=AdqjXG3zehgzLHRLAy6yYecjKrXhm_FZ_VuKEL06PFkqGdVpu-jMopozzQA6Rw3A1-0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7biku-WdpudebORcBIluoneG9DOOXKAKdhrQ1Vr4693Q&oe=6A11AB31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0Zci6gfvP0Q7kNvwG_e2RO&_nc_oc=AdpmzYXjGZXowLCmxn8EbpsidFm47hLU-VOuZ2YyJYTcsnH1A_1jsaix5N1wVBVFeDw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UhxjtcWOFOAIiNYMYYeSJT8Z2EF5dD_AkvobDKTSmvg&oe=6A11AF19"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMY8Tc3jqNUQ7kNvwHdo0r7&_nc_oc=AdqEhtX8F3zQija-1RvsNSw0NSd2FqlmgUFKl7fVdwI-_6FiOr856-6Gh8BVctZO5bY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WFc4rgvDwTSkriqazxkfergJTTclCPTAH6Gscq6L8pg&oe=6A11C676"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T7w8UK1Gh0Q7kNvwGXFUcR&_nc_oc=AdqLpcDPhlky7eCO1AGel0HMr1pr8P9dZVHg6M516hXsQgWNc7QtbtzV1Qjx26TTv5k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fmVyKWjgZDvhIOL2JDDn4C6ZVwOAoQp-JOi3FvSGeUg&oe=6A11A994"}, {"file_name": "CoverImageSafeAreaTemplateLandscape_SANPAOLO.png", "id": "1243210453909475", "image_type": "
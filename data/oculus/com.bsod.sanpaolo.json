: "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827867_589180484142828_266929031235457912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs6hDcZtk-MQ7kNvwE__RRt&_nc_oc=Admpbll-a8xLrGRqwJCA70cN0661NtBdCqBLWSZBvKE1PLqQ_ZDMaJtmyWcx9UxHCwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSQsxCcnrAh4JlDfpNx_lgAnAkXkX1CfYWlb587K_AzQ&oe=699D8B45"}, {"file_name": "screenshot_0000_Screenshot-2025-04-10-113143.png", "id": "1176925730331466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827725_1176925733664799_3790371368702893484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41vHhxvSZ5sQ7kNvwGAEQfg&_nc_oc=AdnjgMdw36v7ryhc_RBYInkUZX-X36B5W7AkjClcSMsCHIuk2RZxshgk551yZNC-glg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxjwzSLs9pzeoJQ1KYa89LirtebHI8FMUeF1iCnmv87g&oe=699D8ECE"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "1018396219679557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828895_1018396223012890_5107840577383576045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIMi-tBGg_0Q7kNvwEc0Ays&_nc_oc=AdmUwTEf6guc8xBqfdGlstcjT_EqVH68REJ-4zQyp5I0QVK1K15wn920ne0nI-Ettsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsabk7m_lla0RDxOVVplUkrs6OcfjuXgSh1IviuWKv2vQ&oe=699D9338"}, {"file_name": "screenshot_0004_Screenshot-2025-04-10-112719.png", "id": "2091812787933632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830787_2091812791266965_7439820487698740197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb7IMjEtriEQ7kNvwH9VJ7L&_nc_oc=AdnAMQh9AB6JQRIam7_pBecsDU0aZ4rxoguQjTnXtoxMISAOea3HltiHWrZjmL8L4ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv569jXfk4e52hMe_Mm0c0GmckudVNpozBP7MJsYsjWUQ&oe=699D9867"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FEq29rTwOcQ7kNvwFGI3zq&_nc_oc=Adl1aWoXzflxAPyue8j2AGV8gtz8WbVT1_7qv6d1u8iMytyOfcs3AnowsJHrkXRT4ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_-MC-jFfzjPnfAo1o42lodJg-sTcgkyo_7-axTy0cMw&oe=699DA731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wadpkSycZqoQ7kNvwHUxSeb&_nc_oc=Adl9GITnKK71FN-cNGdBHCDgd8RmmBdnE5mbDroOlKPd9ziBp2CTy8MEKUZn9nHeAHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs19EKtwXlaspnm7g2_TZEXMnEHOqhlXBaIhMZgkPQkmA&oe=699DAB19"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHgcqwVrtAMQ7kNvwEizZnl&_nc_oc=AdksLKuRBDco9Mzwhy-dIcHAydU2YbwBCTRrgDIDdcqnqhriDDJxHYhSp0ZmzuVFYE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqMoXsdQq2JoneBKj7mCtPoTjdk8um8bsO5rZCSZTWdA&oe=699D8A36"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ala9BqjYRegQ7kNvwF05qs3&_nc_oc=Admv7uwvoERvD-yMxZbl4on9rbZtfMyZtAYfDLsirscYkW5K7Q8GpmtrkL1sX0SNx3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1-T3dORiNn__tGNEDuDK-GB9aQoLHKqFDKOzX70K1lA&oe=699DA594"}, {"file_name": "CoverImageSafeAreaTemplateLandscape_SANPAOLO.png", "id": "1243210453909475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824513_1243210457242808_4833206868291161260_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znthW0yN6BEQ7kNvwGkkI76&_nc_oc=Adl5o
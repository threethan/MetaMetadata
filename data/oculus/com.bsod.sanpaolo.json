: "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827867_589180484142828_266929031235457912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syf4r_tC1_EQ7kNvwGRD5Yw&_nc_oc=Adm0BiguRTIn0MWLcuOAyLmcxsAThyr0htJ43ssjIkWYscT1KQeFx-a2-kEiVb2H8fo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftnHToBSMrV7kz408zxcnKyeoHnwnsQN1Q1_XTYAoD3AQ&oe=69A422C5"}, {"file_name": "screenshot_0000_Screenshot-2025-04-10-113143.png", "id": "1176925730331466", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_1176925733664799_3790371368702893484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UANKkpV2YAoQ7kNvwGb7F9B&_nc_oc=Adm3QpeCKQ9YXJYNQmf7b97A8hRrgMvMajI_KG0-ZztSMyLiE9nLl2-WXhG9VYyn3RU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsTb5ZxQIFwRrCbVcx0vIXouQ8-kEA8ih1t3Y8kIEgsVw&oe=69A4264E"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "1018396219679557", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828895_1018396223012890_5107840577383576045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFpe1SpLfSsQ7kNvwERD_0B&_nc_oc=AdmQX1GhfLRjDi5ofUDENFgHO83FBEO_ykjUto_qqbIDk24AKJQT6SIA07rqKO5TnRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftP6I22qsD7QGfq2iNkwYprliz9GfZL3a_yLyW6vDIQtg&oe=69A42AB8"}, {"file_name": "screenshot_0004_Screenshot-2025-04-10-112719.png", "id": "2091812787933632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830787_2091812791266965_7439820487698740197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECjpxFO52HsQ7kNvwF0i8KQ&_nc_oc=AdmI36tIa-U8nfQSjRMadkpMnKaCPvvaZRhkG0gNigN_1WbvxP9tKyEfDBH1Xx0qSHM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuff4WkCmjtDjYf61tY2F3nwrIaW8xYyg1eByptUeO6cQ&oe=69A42FE7"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gak7MxxwtiMQ7kNvwHFpVAx&_nc_oc=AdlWA_r6ZFwUqJk9m1qEkEOwc6gsbUEKZCUZsx79f4PR8_ng3kJ8vLI8FVR4cZaLCkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvynDJzLe9cD-GyoI8rbLWdz46GpTS-qeUwPhyD-syDtw&oe=69A43EB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIOhw1-SIH0Q7kNvwEEk-yI&_nc_oc=AdnE19dxMqrG8XRdFq9-TSS4SuoHcOQ6D7YqdATjezHFWdi7GBsuFFsRTE3XtuILnbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuhOp6uTrY9J1sO17ZqzuE0qvunIB5f6oFfoVuf_wGoSw&oe=69A44299"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFfBLkU_0SEQ7kNvwFkWkXK&_nc_oc=AdnqyJx1waxjU_QdM750Puyd9B2yHYgQT76SdzPB9hyKmIOpsHhcWPzDwcDaLFKVpdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvTAGc5JfXGqm41JqyHjbr1bf3rv8cbn-NBqqCH98kNvA&oe=69A421B6"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdUb0hayW4AQ7kNvwEnmFYS&_nc_oc=AdmNueiwEfRzlXCf5n_F5oRv0xY6-WN4y0rKiuP6iJqU385fCjX4zKtauhBBCeCxghY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsBNjHE_6gWHjEtxpZ_zqITlVG71JluRmeTH3rVYy3ldQ&oe=69A43D14"}, {"file_name": "CoverImageSafeAreaTemplateLandscape_SANPAOLO.png", "id": "1243210453909475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824513_1243210457242808_4833206868291161260_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyhM-uC_gPAQ7kNvwGCYBu_&_nc_oc=Adnek
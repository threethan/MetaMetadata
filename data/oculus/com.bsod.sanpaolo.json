: "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827867_589180484142828_266929031235457912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGfcmsmzBAUQ7kNvwE0h_wf&_nc_oc=AdmSDMgQk_NtLEOYiO2-JM6CLxU5xrUkWywaI7RWXdZLJsgYc3lwp9cOvZqTm8ZYh9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4DrFQw8jgjRKbo8BjFkMs0WqaDZdW7oLi4AzLSUCBWA&oe=69A2D145"}, {"file_name": "screenshot_0000_Screenshot-2025-04-10-113143.png", "id": "1176925730331466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827725_1176925733664799_3790371368702893484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UANKkpV2YAoQ7kNvwEp6zIF&_nc_oc=AdnqUHGZQv_VFEJRKEliH8I8aa10ZE2g2YVTdvY6l5KP8CuEy9zM82jbGmKhBuNJqqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvzM1xlZfJCOhrtOmQu57CvXmh7jPU1VqTsTh52wvBrA&oe=69A2D4CE"}, {"file_name": "screenshot_0003_Screenshot-2025-04-10-112403.png", "id": "1018396219679557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828895_1018396223012890_5107840577383576045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFpe1SpLfSsQ7kNvwEL3jVe&_nc_oc=AdmwC1ezI_0xN9g8Ec9fKihcLh6u5pb37t66LwfLbHzeyYn_uzqpm3A_oeKYePuJMqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuzGvn12wPTIm7tbxHHcYq8oKoBMgL5YzE4PoWsJGLUsw&oe=69A2D938"}, {"file_name": "screenshot_0004_Screenshot-2025-04-10-112719.png", "id": "2091812787933632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830787_2091812791266965_7439820487698740197_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECjpxFO52HsQ7kNvwG0AVlS&_nc_oc=AdmKnNj-18KNO1v9XOvYcgKouKJVli3aEFGU26KF5RRgzkVI_6vkn9Df2JWvSvAJHSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv22QMm5vzpsOjV-J23emI3NONh0AxiRH5BkWUwPXIk9w&oe=69A2DE67"}, {"file_name": "screenshot_0001_Screenshot-2025-04-10-113005.png", "id": "1391575151856032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827031_1391575158522698_4796616866213924747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gak7MxxwtiMQ7kNvwGND362&_nc_oc=Adnu-NpXJRO9g8IezyhbxTZ_FbkHHGncxtPOpli8i9Njm_xvezAL1dhJgeWPHf1zTL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv53PoxwIRpx_FbrBIQhsVgfwumYhc-sHJpgjdemILm8Q&oe=69A2ED31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER TRAILER.png", "id": "2021730704977200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824556_2021730708310533_6538207973128942507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIOhw1-SIH0Q7kNvwFaHtbD&_nc_oc=AdmmRdwnhFH2Msu8H39A0QjoRA2AsrU3LbixzFY2zqHGhEkSVOMNUw1Yj6mGpFhk2l8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1FidrTl-b_-eDv4IwtRRDninSNRJ8L-1WWJ9wwHTuSA&oe=69A2F119"}, "display_name": "San Paolo Vecchio - Hidden Frescoes", "keywords": ["Affreschi", "Assorestauro", "BSOD", "San", "Paolo"], "long_description": "**San Paolo Vecchio - Hidden Frescoes - VR**\n\nStep into history like never before. Explore and uncover hidden masterpieces within the Church of San Paolo, a jewel in the heart of Ferrara. This app offers you a unique immersive experience, blending art and virtual reality technology to reveal precious frescoes that have remained hidden for centuries behind the walls of time.\n\n**Become the protagonist!**\n\nThanks to ultra-high-definition 3D scans and photogrammetric reconstructions, you'll virtually navigate the ancient spaces of the church. Reveal hidden frescoes, learn artistic and historical details, and relive the fascinating work of restorers.\n\n**Key Features:**\n\n- **Full Immersion:** Use your Meta Quest headset for an incredibly realistic journey back in time.\n- **Active Interaction:** Use intuitive virtual tools to discover details invisible to the naked eye.\n- **Guided Narration:** Deepen your understanding of the frescoes and the history of Ferrara through engaging storytelling filled with historical insights and interesting facts.\n\n**Ideal for:**\n\n- History, art, and culture enthusiasts.\n- Students and researchers looking for an interactive learning experience.\n- Tourists preparing for or extending their physical visits to Ferrara\u2019s historical sites.\n\nDiscover a unique cultural heritage. With \"San Paolo Vecchio - Hidden Frescoes,\" experience the past firsthand and virtually contribute to preserving historical memory.\n\n**Install now and start your journey through time!**\n", "short_description": "Explore hidden frescoes, ancient chapels, and unveiled miracles. With this immersive VR experience, become a restorer for a day and uncover the secrets of Ferrara\u2019s cultural heritage like never before. Discover and reveal history in an interactive journey blending art, history, and technology.\n"}, {"images": {"nodes": [{"file_name": "pano_test_lowres.png", "id": "1937208813750082", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825045_1937208817083415_2308131944780557392_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMmYvYGSDjkQ7kNvwFGt2-T&_nc_oc=AdmTsxPnfw0_tM9kncWEAtwkhlZP4COLIaFnJHfkP2b7FzV02myUOHZBHY41F7XpqLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRvcQCjBTva6JCkY_YT2r4-uxshwxta-xNWTwvaYiKUw&oe=69A2D036"}, {"file_name": "CoverImageSafeAreaTemplateHero_SANPAOLO_1.png", "id": "1751691975409010", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824504_1751691978742343_6280807670428162182_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdUb0hayW4AQ7kNvwH4szVu&_nc_oc=AdkDD8mD1RrKhxsMBgEr2FDZl7dVoVBWGPT_j7ZhN-WFCQBQDygWP0EpEtGt7n6WnJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwKNRqdtnOR2Yxe2-5lczRc1IUQv-KuddwAUDCB4PO2w&oe=69A2EB94"}, {"file_name": "CoverImageSafeAreaTemplateLandscape_SANPAOLO.png", "id": "1243210453909475", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824513_1243210457242808_4833206868291161260_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyhM-uC_gPAQ7kNvwHGLqt-&_nc_oc=AdlUV
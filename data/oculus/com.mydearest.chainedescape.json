2\u753b004.png", "id": "1655996795288154", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391878_1655996801954820_608114223118122481_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahCJKsBfqngQ7kNvwG1u00v&_nc_oc=AdptHkRZxrqXst0ZJfktmTjr_Vq85MAo4fUEXGUa9tDgq5IW5wf3Vf9AICmXH5ykxts&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XKBM2_TGIoks3aWJGl1xbYYaORgi5LIr6qN8ICZn7KA&oe=6A36C187"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 01.00_00_00_00.\u9759\u6b62\u753b001.png", "id": "1741820593347787", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393759_1741820596681120_2205642507853669191_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggw-IQUS4ykQ7kNvwERqyfw&_nc_oc=AdoeEpwA49PKeVDn7j_M6T7Tjlr9crShEZfibFHA-3Xhe9GHugiitUn7TnGq7rJza44&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-6wLRb1EFVA9cTOqs-arW11mYKCAj5Z3FOD8YN1D_Qw&oe=6A36BD64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1400071464328288", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473397310_1400071467661621_504865707334186785_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HUVBaTcU5oQ7kNvwGhFA-N&_nc_oc=AdrQXFk27IDhp8IQMbx2lXkneVkV9RJWnQMceBEb2wU62Q5Z-xr5JoRTvdnt5S9EONU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w8MGgy8W8sthBX2Xa-n6qqemt1679wmuVt_nGWjXshQ&oe=6A36BA37"}, "display_name": "Chained Escape", "keywords": ["Together", "Penguin", "Multiplayer", "Party", "Coop"], "long_description": "\u26d3\ufe0f Linked by Chains, Bound by Fate \u26d3\ufe0f\n\"Chained Escape\" is an immersive VR game where players control penguins chained together, striving to reach the summit. Supporting multiplayer for up to 4 players, you'll need teamwork and strategy\u2014sometimes helping each other, sometimes causing chaos\u2014as you race to clear the game before your energy runs out!\n\n\ud83d\udcaa Master the Physics-Based Chain Mechanics \ud83d\udcaa\n\nUse realistic physics to manipulate chains and control your movement as well as your teammates'. Rescue friends by catching their chains at the last second or desperately swing through mid-air toward safe ground. Sometimes, you might even discover a solution no one else has imagined!\n\n\ud83d\udc27 Rewrite the Penguins' Harsh Destiny! \ud83d\udc27\nYou play as imprisoned penguins subjected to grueling forced labor. Break free from a suspicious spaceship crafting mysterious objects, and escape to secure your freedom", "short_description": "\u26d3\ufe0f Linked by Chains, Bound by Fate \u26d3\ufe0f\n\"Chained Escape\" is an immersive VR game where players control penguins chained together, striving to reach the summit. Supporting multiplayer for up to 4 players, you'll need teamwork and strategy\u2014sometimes helping each other, sometimes causing chaos\u2014as you race to clear the game before your energy runs out!"}]}, "developer_name": "Buzooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "23907847882136694"}}]}, "scheduled
_ohc=4JtHb9SzrHsQ7kNvwGhJqdl&_nc_oc=AdpPJEn0bRmj7V3PB8ZlBMjBdHTYZ0J6qo_LR4e-04lEUzr8HUoo8XO34g1Ph5iZZmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HoQYQs3YeirgfF81e-uythrj6g9z_Rs7HY4PcVw5GGw&oe=6A37F28C"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 03.00_18_29_19.\u9759\u6b62\u753b008.png", "id": "1411201113386939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499318615_1411201116720272_1631362542869837605_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmMoRYNepzIQ7kNvwFsNI-g&_nc_oc=Adrq-SPpWcaqmlThgnHyfib8fCSPbccBr-YDtq9VvM9I_KfD_YJFp7d47A2CMP3F4fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fI3nrFvznwEZG3u_FivXa0O6sOH0IaN4F_90VNDwz2A&oe=6A37FA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "785043204082470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293825_785043207415803_6291011238981230228_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjw2Pef4pRsQ7kNvwEteFls&_nc_oc=AdpILKVsSabNxJbWD15BjpRGNPbmqGKb-LLgHrh_lDTtpVXHpZUasSndeJdkakQj--U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dc33szIkOoAWDyz5lOSjJNrxZmjZoDjTK50rVV1SaaA&oe=6A37F499"}, "display_name": "Chained Escape", "keywords": ["Together", "Penguin", "Multiplayer", "Party", "Coop"], "long_description": "\ud83d\udd25The Magma Meltdown Update is Here!\ud83d\udd25\nChained Escape just turned up the heat with the all new Magma Meltdown Update.\n\nFace the fiery challenge of the Thermal Blast Sector, where the floor is lava and every step could be your last! Test your survival skills in escape mode, or race against friends in Versus Mode to see who can beat the heat first!\n\nThis is Chained Escape\u2019s hottest breakout yet!\n\n\u26d3\ufe0f Linked by Chains, Bound by Fate \u26d3\ufe0f\n\"Chained Escape\" is an immersive VR game where players control penguins chained together, striving to reach the summit. Supporting multiplayer for up to 4 players, you'll need teamwork and strategy\u2014sometimes helping each other, sometimes causing chaos\u2014as you race to clear the game before your energy runs out!\n\n\ud83d\udcaa Master the Physics-Based Chain Mechanics \ud83d\udcaa\nUse realistic physics to manipulate chains and control your movement as well as your teammates'. Rescue friends by catching their chains at the last second or desperately swing through mid-air toward safe ground. Sometimes, you might even discover a solution no one else has imagined!\n\n\ud83d\udc27 Rewrite the Penguins' Harsh Destiny! \ud83d\udc27\nYou play as imprisoned penguins subjected to grueling forced labor. Break free from a suspicious spaceship crafting mysterious objects, and escape to secure your freedom", "short_description": "\u26d3\ufe0f Linked by Chains, Bound by Fate \u26d3\ufe0f\n\"Chained Escape\" is an immersive VR game where players control penguins chained together, striving to reach the summit. Supporting multiplayer for up to 4 players, you'll need teamwork and strategy\u2014sometimes helping each other, sometimes causing chaos\u2014as you race to clear the game before your energy runs out!\n\nMagma Meltdown Update is here!\nTake on the Thermal Blast Sector, where the floor is lava and danger is everywhere. Enjoy our hottest stage yet!"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connecti
SthlxWY5KXrkMSSC0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mJvdOrMeVjBDHssAqI_zCnrxVm-4j4OHvnHrBmjgNNw&oe=69D3A8C7"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 01.00_00_00_00.\u9759\u6b62\u753b001.png", "id": "1741820593347787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393759_1741820596681120_2205642507853669191_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvYgh0vRgWsQ7kNvwFfONwO&_nc_oc=AdqsS92WiiY7SaQK0820WInPH7kwQZzmsLJ9GIwGbuElSP45X_TPtQROkpWMLZW10NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0abnVZX7cgwZ2TvdS0S4xEtn6u32wHsAAJN1UvHfYp1g&oe=69D3A4A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30cf\u3099\u30fc_2560\u00d71440px.png", "id": "1400071464328288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473397310_1400071467661621_504865707334186785_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QX7ALQs49YQ7kNvwG7W5av&_nc_oc=AdqPZs-kfL5FJJKuEZmgWvNtHFaG6xH5qIWPvMzn8QoSkYjszE8bK5RJCn7eArV4lsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VMEG3gZunbBEe7NJzq7vJo5ha9FD22VBS8BFCnh4xzQ&oe=69D3A177"}, "display_name": "Chained Escape", "keywords": ["Together", "Penguin", "Multiplayer", "Party", "Coop"], "long_description": "\u26d3\ufe0f Linked by Chains, Bound by Fate \u26d3\ufe0f\n\"Chained Escape\" is an immersive VR game where players control penguins chained together, striving to reach the summit. Supporting multiplayer for up to 4 players, you'll need teamwork and strategy\u2014sometimes helping each other, sometimes causing chaos\u2014as you race to clear the game before your energy runs out!\n\n\ud83d\udcaa Master the Physics-Based Chain Mechanics \ud83d\udcaa\n\nUse realistic physics to manipulate chains and control your movement as well as your teammates'. Rescue friends by catching their chains at the last second or desperately swing through mid-air toward safe ground. Sometimes, you might even discover a solution no one else has imagined!\n\n\ud83d\udc27 Rewrite the Penguins' Harsh Destiny! \ud83d\udc27\nYou play as imprisoned penguins subjected to grueling forced labor. Break free from a suspicious spaceship crafting mysterious objects, and escape to secure your freedom", "short_description": "\u26d3\ufe0f Linked by Chains, Bound by Fate \u26d3\ufe0f\n\"Chained Escape\" is an immersive VR game where players control penguins chained together, striving to reach the summit. Supporting multiplayer for up to 4 players, you'll need teamwork and strategy\u2014sometimes helping each other, sometimes causing chaos\u2014as you race to clear the game before your energy runs out!"}]}, "developer_name": "Buzooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "23907847882136694"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2081437039072293"}, {"status": "PUBLISHED", "id": "1602554054498396"}, {"status": "PUBLISHED", "id": "757393547210897"}, {"status": "PUBLISHED", "id": "718232097761747"}, {"status": "PUBLISHED", "id": "617400804418
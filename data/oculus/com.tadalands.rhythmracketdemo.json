-X38Q&oe=6AEDDA92"}, {"file_name": "screenshot_2.png", "id": "959133320626995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304764_959133323960328_5670481365382642168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOgAc4oXZRoQ7kNvwG02hA8&_nc_oc=Adp0QdnytFIdcugXOACZuRfMN9bTbqOiJLElRRU3IwbwbLQEQbfAeHXtDtrx0c2m3Xc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFZ-HlzolvlVzDwqrUDl2LdDpU78lh2nTFMbqZ8xXX5w&oe=6AEDFD30"}, {"file_name": "screenshot_3.png", "id": "2082429382541398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830593_2082429385874731_9003513391198878593_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqqpc4uC7OYQ7kNvwFX0r3W&_nc_oc=AdpTFBst6bStNooQx_0M66Jlx6OQVpnC1YJU3QmVXN9lQGomLbrBd73kyIU4bIxMmnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvjuKDuwaW8X_jdf0r0PNQb7CJmgUtGtSTWLSrpTUMhA&oe=6AEDDBDC"}, {"file_name": "screenshot_5.png", "id": "1242575747855027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313058_1242575751188360_4488134838088940622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgRiYvbTYrUQ7kNvwGtjdeF&_nc_oc=AdrrkXCKY7OegQ-rjVE9i2cy8-OsXpcgtFrZ_7L0XTPBnmERh2NRiTlCKsJ5lWlT3X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROkOpZ4yrep3tI3hzqfCV5wXP8r1EdUwNNVGDSn5dRUw&oe=6AEDD7DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_demo.png", "id": "770227605911247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822924_770227609244580_3311407269777496338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvH0AF_TaLsQ7kNvwHcDwvr&_nc_oc=AdqD8fNF6jpHm94sOPvOX9Kszk6lBch36NFmyLoO2SfI1bQrPLTpsPdtS5pr7IrkNkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSOuWBRhQCQUmrCCDgp3TT5FQ4_4cpLi0MfocaX5CmHw&oe=6AEDDA61"}, "display_name": "Rhythm Racket - Demo", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of the music.\n\nGet the full game here \u2192 https://vr.meta.me/s/1S5C9g6vEST6p3Q\n{1248197004069725}\n{1296455139059008}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1985013245383485}\n{1924103911582438}\n\n# 3 soundtracks to try out!\nWith 10+ in the full version!\n{964566906128340}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{955582563645192}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{27057277030541176}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{2110782169763378}\n\nNote: Progress does not carry over to full game.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2
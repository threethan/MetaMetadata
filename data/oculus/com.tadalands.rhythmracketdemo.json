nnewv_jZ4C1Hx4Khzw0JrwnYK8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC44yz4GVwdiXfRVqo44AI2wwzfWP3a8flISEpdQO5tiw&oe=6A563F5C"}, {"file_name": "screenshot_5.png", "id": "1242575747855027", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499313058_1242575751188360_4488134838088940622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUCYJsk0dtsQ7kNvwHwMRy_&_nc_oc=AdocXnQFoaYAOnn9xznTESAHNUrG6S2Bwfuka9qfawKlDE1-zXIXZB8fV3P_GtYNpPU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4xElYxhnPIzVN8KRtIyvkXXPWHgSaEa82JlWi50o-cQ&oe=6A563B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_demo.png", "id": "770227605911247", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822924_770227609244580_3311407269777496338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv1IxTGXroAQ7kNvwG7J-Ro&_nc_oc=Adp6hrkCmfOyyILiqddwPtFm3BYi8p7D2BMGieph4k-aPlfST4NRs3Aa_H5FUwK7NTY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1P7JO56eiVNbTbgyAL5pwIUO3s26pO0ZJHCLTkdH_OQ&oe=6A563DE1"}, "display_name": "Rhythm Racket - Demo", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of the music.\n\nGet the full game here \u2192 https://vr.meta.me/s/1S5C9g6vEST6p3Q\n{1248197004069725}\n{1296455139059008}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1985013245383485}\n{1924103911582438}\n\n# 3 soundtracks to try out!\nWith 10+ in the full version!\n{964566906128340}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{955582563645192}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{27057277030541176}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{2110782169763378}\n\nNote: Progress does not carry over to full game.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26597522769877455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "897248893305807"}]}, "baseline_offer": {"id": "897248893305807"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774374420, "status": "PUBLISHED", "id": "897248893305807"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26597383123224753", "version": "1.2.2"}, "id": "1650140382809001", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26576685948627804", "is_concept": false, "lates
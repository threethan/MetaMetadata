5bBvA&oe=6A870592"}, {"file_name": "screenshot_2.png", "id": "959133320626995", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304764_959133323960328_5670481365382642168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maoJG4_-3qUQ7kNvwHdSvEk&_nc_oc=AdoqpgGMH7q8F7wb9dcknvIT5KzqMKWEltA3p5I6yT_I_hMJ7Zz14dlBv6HvD403jT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPEyu3Nyg6OZZIGtw8uypYubT4ksyynXdKw6TFnuU0dQ&oe=6A86EFF0"}, {"file_name": "screenshot_3.png", "id": "2082429382541398", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830593_2082429385874731_9003513391198878593_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I1EsbaIZgAQ7kNvwHjeQqS&_nc_oc=AdojqCqwQWhuVBgSch9sAxY0n-NBlKjNH67_bOU1m2HOnZXUC8EoeuhJX1ufB9BonX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqR1vdCr-Ov4_keGAW8SF1e_bltw1JBoxHA2y3Lsba1g&oe=6A86CE9C"}, {"file_name": "screenshot_5.png", "id": "1242575747855027", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313058_1242575751188360_4488134838088940622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynJSKyfqAJ4Q7kNvwED5lKk&_nc_oc=Adq8uxD_060bKvPFLmOyjT8xcdFF9plU1BTs2QOP0sQrct8xCMI4dgbLaMd1GqDxP9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxnMi7r-b4OsFgTKrF8CHTeMrQ4G3OmNhKpPZlys3VSQ&oe=6A8702DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_demo.png", "id": "770227605911247", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822924_770227609244580_3311407269777496338_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji_vO63czawQ7kNvwG11r8s&_nc_oc=AdoERlJE7ie5NFyDXNbHs68KkfFqKR4xv228q9MJPPO5IvwXmHgzKU6e5rl8DWG9eZs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHheMibKLBUXBRXsQI2a-z99CHE58JQOaHvDHIij44nAg&oe=6A870561"}, "display_name": "Rhythm Racket - Demo", "keywords": ["beat", "rhythm", "music", "racket", "swing"], "long_description": "# Swing your racket to the beat!\nI took the badminton mod from Beat Saber and turned it into a full rhythm game! Experience flow as you swing, smash, and return volleys to the beat of the music.\n\nGet the full game here \u2192 https://vr.meta.me/s/1S5C9g6vEST6p3Q\n{1248197004069725}\n{1296455139059008}\n\n# Work up a sweat!\nJust 4 note types and 3 lanes combine to create complex patterns.\n{1985013245383485}\n{1924103911582438}\n\n# 3 soundtracks to try out!\nWith 10+ in the full version!\n{964566906128340}\n\n# Audience reacts to your performance!\nWatch the audience cheer in excitement during perfect swings.\n{955582563645192}\n\n# Aim for a Million!\nAim for a max score of 1,000,000 on each soundtrack to earn M rank.\n{27057277030541176}\n\n# Discover artists with banger tracks!\nFrom rhythm game artists like **t+pazolite** (Arcaea, DEEMO, & Cytus II) and **Nstryder** (osu!, Geometry Dash, & Sound Space).\n{2110782169763378}\n\nNote: Progress does not carry over to full game.", "short_description": "Swing your racket to the beat!"}]}, "developer_name": "Allen Dawodu", "developer_privacy_policy_url": "https://tadalands.com/rhythm-racket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Tadalands LLC", "support_website_url": null, "website_url": "https://tadalands.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2
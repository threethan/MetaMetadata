ent-atl3-3.oculuscdn.com/v/t64.5771-25/75286676_850054586438355_4708420444196828299_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnyivQCHtTYQ7kNvwH-FWCJ&_nc_oc=Adn7ccdaNEv2eHGXGMfNAzg7TgvFdP2vSO8oZ2XBsCCHXWRmGJfA9CLVfIwn6BMNmJ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvMrBaP_RoPLyjVt2bnL8yNL0OKvC18CSawe8m3wZlpA&oe=69BA8042"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPoiWPJ9EAYQ7kNvwGrzmcG&_nc_oc=AdnCmUyLorThHrrnEBcYoRj2ylwtIsv8Um2KeYp9zAa6UJLKVw9RjSD5xURoevmX1kE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpvWut6M1npNUI9TnO-FcAKGlE50N3rZGd2tjiIHTtkA&oe=69BAA0AC"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv1lM5k7aWYQ7kNvwH5QF25&_nc_oc=Adl9treh7oM5pclHioEWz1NU0DWUdJKy2ge0hcP170ib3xvc22DalP4tjl1E8cFs2Ag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtv7rmiVJ0qw400TmHAScc4uekTE9PpsBUDjT6Uw6Amw&oe=69BA89F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8-Bd_facdAQ7kNvwEwT1JV&_nc_oc=AdkHHW5N_rnOIwTUXUkZPMI7q8ASwvRex-dn0IwyV1pz-vrEHAeH4CgCtYk7THmAUCQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXlccnl_CugdwxcbM6ZMkYXkwoyhrfkQQYcnEbOC44jA&oe=69BA9347"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat Technology Co., Ltd.", "developer_privacy_policy_url": "https://mqvwzgqbgw.feishu.cn/docx/TroodKHf0orxRqxcuW4ce6ninMg?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "Shanghai Magibeat Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.magibeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
gXLntofBhwiH4L7rNZxGOf-eNIcz8p8q2JaB8KtrjCWOJV1YnXdDxYZ72Wf8QI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT19ilPUK7mcbz5IXjp9P_elNu6u2TKf9cvaoF78C3nbQ&oe=6B09A5D6"}, {"file_name": "screenshot-5.png", "id": "850054583105022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286676_850054586438355_4708420444196828299_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQB0mv3NeOIQ7kNvwFaaUmS&_nc_oc=AdoriijiUzn-OdCrYnXOjapIptLs26Wmyn9ywez0XHFdr-c8jmewNXEnhXMoiil75ls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdHVNYSX5unl6ON77sXt9fiWNwIwUXu--Xp7zxuRqmLQ&oe=6B09CDC2"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42yoP4uDBcEQ7kNvwFSh-Rt&_nc_oc=Ado1SOGi0Gi7tYNMugny3_Ri2LV_SuF7WF3hRP8HBU39Nn0OxuROJ8XpJbKRJDrmmB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7SzuJhNsQ9Kuj_AWEG1h74PF2WThK0ph_JjfjuvZ1hw&oe=6B09B5EC"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9n6RY7jIE0Q7kNvwGWnQG3&_nc_oc=AdqHYZ-ke8p4xlYyaLA76aQKYnSwBwDHQfbef8p44N-k01UhvCKcrm8XdC7W-3oDAxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQX3-Yek_BEfKraMvMYndFQPI-lAwcQrfuoIxdIfQwPQ&oe=6B099F37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgTDCvQRw70Q7kNvwFWO8gA&_nc_oc=AdrCmIXd4UqVy6tIF0e0BTg1QeVlPSmsuZo75b8eIARl5HM2vlA0TdAP7tjLf6L7k4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuyoABN0dfI4IIXBpWmU-7f5a47pfhqRswaAScJUuAOQ&oe=6B09A887"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat T
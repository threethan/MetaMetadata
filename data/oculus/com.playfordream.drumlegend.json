lzecXATWuF9XZUJKZUUvbug0X2E8uDjN_NhueT7RiCwEhRfdQGF7dO914FQU34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2tm_giKe89cnhcUCMPjbwSPMqmU6ku67rPPBF4z_zdg&oe=6B0702D6"}, {"file_name": "screenshot-5.png", "id": "850054583105022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_850054586438355_4708420444196828299_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQB0mv3NeOIQ7kNvwHaX_eX&_nc_oc=AdoRE3Sp0s0dilH5bvS1EOrY9W8Hjc4qJ3XL67xCfa99F-B5YS3nWFJZTF4lxNML5gE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTabf4P-wVQQdZELLoUbzO5rmiomIYRnwDjVX_tCSEA7g&oe=6B06F282"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42yoP4uDBcEQ7kNvwH4JkLT&_nc_oc=AdqRZp_LY6rk3NlhIhS23wb3joBDYhj_niEuY79YwXOAFcDJZUfczrnvkd0kAADhGTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoIJ9N1-IoNPtgeUrTkEA2SHOg7gEH7QWyy3QVGgl2wA&oe=6B0712EC"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KuDpMdZlvIQ7kNvwF4_cjY&_nc_oc=Adqx_sOa4tuwfMkmWpblYiQzcQmm123vrFRYQydh0j3HoyNSwpUZG1xrO-JB0XO-DsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlF6MYhayNHJZsWszkoFzFnPrBbGFDw1KTJv1QxbuZKg&oe=6B06FC37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgTDCvQRw70Q7kNvwHAgMpL&_nc_oc=AdoX1R4xjDUSLdrECGFoICMLQoQO6F3REeTznrJtG5AGllltb9XMyjRcnRbyKojVOhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgbZOnarIFvV6XobjDS-2hlXoHJuXR8vFzkVk_1c88Fg&oe=6B070587"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat T
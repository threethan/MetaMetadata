tx9CWc-qgILgaE13U7RZqp66BQTtmn_DXzyViKtNIzTQuHPQGGdbnMLsuckVgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRBxNzm6-Fdf3XMLHafjnBAwt5j82DyGHVlgirh1zkdA&oe=6B0DD296"}, {"file_name": "screenshot-5.png", "id": "850054583105022", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_850054586438355_4708420444196828299_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDVF3GGZZdoQ7kNvwE68MeH&_nc_oc=AdpiAv7_SWM5sRTsFZokfJnYyzwKPvtMjhgjFBPgVCkzexF4INq62j0XJKJ4q4LKIP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsqpWk-fIy6Yc-GxyTY8BW14HGlFDMSmU7crn_ToQPFA&oe=6B0DC242"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBClIIRQvnsQ7kNvwGIEkld&_nc_oc=AdrotcR3n8Ica2RVzKUGoJ6Q_b86__YWsHQ-kB9P81wK8G6QJ-JhKdkc0fiSi99Pl9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiOlCptZQfABffSiMvLTZE7d7qLycfW4titDMF16qsCg&oe=6B0DAA6C"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQURfWcT3fUQ7kNvwExdk6Q&_nc_oc=AdoDS4juAkv4Tdq-tg5COlOMjCAakvLdIJBFvPU4LckEeWqYvYdLw7WiS2gkCoY_WQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7F2M6tLl4THj805MBr6F7jBbXiC-TvHBT8BIyOzJe2w&oe=6B0DCBF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAllC6QzyTcQ7kNvwFqyCVv&_nc_oc=AdpXlcY1Pvf1xApbNivX_hEk7z6VZKEiDUhCMwV32_5F8dorPArGhPKiszsWubLFBn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxpFNrvZ2FjXJOVGMeS34_dEB9WXACvZnNiJrzTjKRaQ&oe=6B0D9D07"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat T
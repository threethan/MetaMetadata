ent-atl3-3.oculuscdn.com/v/t64.5771-25/75286676_850054586438355_4708420444196828299_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMxf_Lals0kQ7kNvwEuSn9A&_nc_oc=Ado-fdjy6fdkcyNZpbo12wQgDjvW8zJZONYkzKl3BDEH9Z-FUzk3DR56IPUVI-qS3dw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAfGcFxv7f79PZtkHpKznP3MmttXNL1T8f_4i8ycsMUA&oe=69C15002"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITKRtfCaYfgQ7kNvwEIL5Ve&_nc_oc=Adq2c5OqJj2XrWyqdR9pwbN90cRw6H5O1pXawHNcTvGMFppr1PoNRbuSGZhT5Cpcgm4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwpouv7iDd2aOrGa9HyR1SM4mcIL_O3CuuXfoIadJIUyg&oe=69C1382C"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko8HnuSg8JUQ7kNvwEELULM&_nc_oc=Adr03wLL4uhq19Fz5XbBJx5JI8wbGGa9kIaC9ArSSUy3YFZa3ZcMRlZRSWiGXFceDB0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw83FMtrc8gVmX-CJVvwpu1tACg1BCuTi2kUF3KOhIL1Q&oe=69C12177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9c_WB9S0H4Q7kNvwE9J0RT&_nc_oc=AdqYL0jeGTi-_MRwZFYXTJPFsWPxaOvQrF2Jj7LLT7mrdzzyjlrZ0Yi-b1Ocj3LftnE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOlM9fBb17uDFU86pZt1PEVqoSWN08O8luYfs9fDNsCQ&oe=69C12AC7"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat Technology Co., Ltd.", "developer_privacy_policy_url": "https://mqvwzgqbgw.feishu.cn/docx/TroodKHf0orxRqxcuW4ce6ninMg?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "Shanghai Magibeat Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.magibeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
ent-ord5-1.oculuscdn.com/v/t64.5771-25/75286676_850054586438355_4708420444196828299_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnyivQCHtTYQ7kNvwGwE9-4&_nc_oc=AdnPYPUnXqfgTpUazkFgD4F7Nca95Vzuprbnff7wzZdzNRs355-3UW0LmNmiQo-00Oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEG2XGS6qTJm4YNkF1TM0z9mkLjA4LlDSoyNniTTPwTA&oe=69BC0A02"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPoiWPJ9EAYQ7kNvwGYdzDM&_nc_oc=Adkua0uQObq_uH6uvHGXtKviPjMDEtbwdXJc0-qHtb2Cq6kDSuN4ZEhEGt-f3ImM0tI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwj-0DtUCsSvBqn8jOz9871ZGOi04VsbsQD9w_DDgwkBA&oe=69BBF22C"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b3joNQz0Y0Q7kNvwEkMgOw&_nc_oc=AdmkWM6ukid1T6ifpnH2_q5YN7SyIbDnS9upEJqzjgb0cymofRubC7SAu16d7RsJUuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzG1B-Es8vsdisOCeeISoGEjOLcLKuJLPdCUIcbi0kgZw&oe=69BBDB77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8-Bd_facdAQ7kNvwEEPpM8&_nc_oc=AdnCYhKNXphWNVcCCKiWXRt0r76KmlmsnSXaYVMqynDg9ToCaT1Q3rGIyfThN3v0sBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxylv3A6ETW9MsdCAus9Y2g6N3SrRJNfVdogD-cQFGuJA&oe=69BBE4C7"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat Technology Co., Ltd.", "developer_privacy_policy_url": "https://mqvwzgqbgw.feishu.cn/docx/TroodKHf0orxRqxcuW4ce6ninMg?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "Shanghai Magibeat Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.magibeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "contex
86676_850054586438355_4708420444196828299_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg-O0flRhMYQ7kNvwFYt2Cg&_nc_oc=Adox4kHbk__gCP107M7hu4ZqzGjRik8TxrRceTNg6RmSV4WQWPULdZk8Q48-3dGx3TA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af369ZFhE_I56lK6gQG4ZyFuUO5tYVEr304I3Q1V1ndzcQ&oe=69F21782"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CdW61Ty1oIQ7kNvwFlw-K7&_nc_oc=AdoOOS-sAArqo2g9Pe0x-ohZ2Le6-j41Cjs0INHqqCQ3k5OcStoghf6fn-m2X2bBtqo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af04iQSLlle0mBRfkJs5UXYpxJXifS785EgLcpx9Ncj_Hw&oe=69F1FFAC"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEFa58BTgpcQ7kNvwGUtyqW&_nc_oc=AdpUobIqAuGYzqjEqd8DvpRXcogP3lb7AoIdgotIovznQJkWmSFzz47PEiJVYXr-prE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tjUMLcxdQz7MrXPlRKVyJhcsnBekefpaHCHdD9tklHw&oe=69F1E8F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8Mbk4wOI8QQ7kNvwEBA_-n&_nc_oc=Adok5TzFtAL2SQ2-4m8hsXgOKQoa3pqW16BBxKNH7r8xGmM1Zd1UiqQq6062ad8-47o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1a2ZyPK30DvH9odtdgGgJPXOJj5eKg67iMVAi8aTaerg&oe=69F1F247"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat Technology Co., Ltd.", "developer_privacy_policy_url": "https://mqvwzgqbgw.feishu.cn/docx/TroodKHf0orxRqxcuW4ce6ninMg?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "Shanghai Magibeat Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.magibeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
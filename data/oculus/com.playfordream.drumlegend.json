99_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLiAAOkAQw4Q7kNvwGp3WP8&_nc_oc=AdljAx0CMsi0RsVOxZNJK4w23PUtY7GmddgYQiYvlAQcCYkwhRcX-50fdtWLHViYlM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuAzGDZnZbGJVm1ALdLmroy-2ONaC9wnwXFNdte7CkPLQ&oe=69A44F02"}, {"file_name": "screenshot-3.png", "id": "6018325031602083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031319_6018325034935416_8290995268417184847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-ZVhnjehzgQ7kNvwGABVaW&_nc_oc=AdlzCoKMAkuBANxdtzecgpHeWLXbPmaZug17rrCAZ3XwQrdNZqCErVPfqFohn32J570&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft3XZ2ZD806Ow0tG9RjcRJY4R0YX467_T_1BM89MdubdA&oe=69A4372C"}, {"file_name": "screenshot-1.png", "id": "300409502712698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_300409506046031_7075151105749574940_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSd1--fUfK0Q7kNvwGL6-GE&_nc_oc=AdnuMN1WPIWbWcodQ3Xc6lAVE7GOgbyv3g9qiSqfSPkEi21razDxe9MJY9hLy1bqaa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftCwMKhcQGNM7HP-8GcqPVfCg_-lCrTSEG1XQyAEsSNog&oe=69A42077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762\u98ce\u666f 2560x1440.png", "id": "924741425935792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422370_924741429269125_5581551878028527069_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTeCmgj2-F0Q7kNvwFHzpt_&_nc_oc=Adk20BGOEmqofzhKtcfmvCXr8PY9rQO385qB763dNdBe3eN3B1GCPozE0ClmVnBzceo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7JtBnsUXPz_tgwZvfn7Mw2zeR-QnEWBNuvhnbSfT6cA&oe=69A429C7"}, "display_name": "Drum Legend", "keywords": [], "long_description": "We proudly launch Drum Legend 2.0 !\n\nThe game now support Custom Songs!\nVisit our Discord for Import Guide and get the Song Editor.\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n\nDrum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. \n\n- Drum Maestro:\nSimulate playing the drum kit and get a taste of being in a band!\nThis mode comes with a certain level of difficulty. If you haven't played the drum kit before, you can start practicing with the 'Practice Album' song pack.\nEnjoy a refined drumming experience with professionally designed drum charts, gradually becoming a VR Soulful Drummer.\n\n- Rhythm Rush:\nDon't make any miss, smash all notes accurately!\nThis mode is easy to pick up, but achieving SSS ranks or challenging level 9+ tracks requires continuous practice.\nEvery season, we release new featured song packs with meticulously designed music and charts for an exhilarating rhythmic experience.\n\nWe are a pioneering team dedicated to exploring new music entertainment experiences in the XR world. 'Drum Legend' is our first music rhythm application, and we welcome your feedback to help us improve the product experience.\n\nDiscord\uff1ahttps://discord.gg/CdCkmZ6UJ5\n", "short_description": "Drum Legend is a music rhythm game with multiple drumming gameplay options. In the 'Drum Maestro' mode,you can simulate a band drummer ,learn a variety of drumming skills, and play your favorite music.In the 'Rhythm Rush' mode, challenge yourself with more difficult tracks, aim for higher scores. "}]}, "developer_name": "Shanghai Magibeat Technology Co., Ltd.", "developer_privacy_policy_url": "https://mqvwzgqbgw.feishu.cn/docx/TroodKHf0orxRqxcuW4ce6ninMg?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "Shanghai Magibeat Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.magibeat.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}],
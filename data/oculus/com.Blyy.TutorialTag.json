s://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308330_1237607594691566_7708650453773225911_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AH41YokNFsQ7kNvwHPoz4t&_nc_oc=AdqJvYbO572q4469PaLoh86tUYfi8CMqMiHx3-kj7Cxz9NenzMqkwCvvJwv3y2Mr1Jc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhGzludhKyJDPwhmCUnkpxhMLx6aI3oGR764yOdBjMLg&oe=6ADCB735"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tutorial Tag V1", "keywords": [], "long_description": "Tutorial Tag V1 is the perfect introduction to the classic game of tag, designed especially for new players. This interactive tutorial guides you step-by-step through the essential mechanics of tag gameplay, helping you learn how to chase, dodge, and tag opponents with ease. Each level offers simple, engaging challenges that build your skills progressively while keeping the experience fun and approachable.\n\nWith clear instructions, friendly AI opponents, and a welcoming environment, Tutorial Tag V1 ensures you gain confidence before jumping into more competitive matches. Whether you\u2019re completely new or just brushing up on the basics, this game makes learning tag easy and enjoyable.\n\nGet ready to master the fundamentals and become a tag pro with Tutorial Tag V1!\n\n", "short_description": "Tutorial Tag V1 is a fun and interactive game designed to teach players the basics of tag gameplay with easy-to-follow challenges and friendly competition. Perfect for beginners looking to master the moves and have a blast!"}]}, "developer_name": "playfab.auth.", "developer_privacy_policy_url": "https://sites.google.com/view/tutorial-tag-v1/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/tutorialtagv1reel/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
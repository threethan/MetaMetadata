s://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308330_1237607594691566_7708650453773225911_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3WCZckBA_UQ7kNvwFbHX9U&_nc_oc=AdppFKOifLt75aE5AlD5djEHKLvkLSkPkPozYXVS3lPP_cOFZTA6KPBJ9gXzZcfWsc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB2ZrNR6IsmtTV5f46lepuzz0Bk0maoEoZi3uHb00XGA&oe=6AF47235"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tutorial Tag V1", "keywords": [], "long_description": "Tutorial Tag V1 is the perfect introduction to the classic game of tag, designed especially for new players. This interactive tutorial guides you step-by-step through the essential mechanics of tag gameplay, helping you learn how to chase, dodge, and tag opponents with ease. Each level offers simple, engaging challenges that build your skills progressively while keeping the experience fun and approachable.\n\nWith clear instructions, friendly AI opponents, and a welcoming environment, Tutorial Tag V1 ensures you gain confidence before jumping into more competitive matches. Whether you\u2019re completely new or just brushing up on the basics, this game makes learning tag easy and enjoyable.\n\nGet ready to master the fundamentals and become a tag pro with Tutorial Tag V1!\n\n", "short_description": "Tutorial Tag V1 is a fun and interactive game designed to teach players the basics of tag gameplay with easy-to-follow challenges and friendly competition. Perfect for beginners looking to master the moves and have a blast!"}]}, "developer_name": "playfab.auth.", "developer_privacy_policy_url": "https://sites.google.com/view/tutorial-tag-v1/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/tutorialtagv1reel/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
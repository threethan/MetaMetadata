ent-ord5-2.oculuscdn.com/v/t64.5771-25/499624592_1391039003229345_2796542476780565181_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg26anXLOPUQ7kNvwHOQ9t8&_nc_oc=AdoPj-qKRDXp1YBYzcZZBcR6KhA3rMFAgvBXKfDewTe7p31EzyMx4bcuSLqu7fAa3b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCnFecFxSoCc8Rzhc8rhDMJnr-f85Pkyn_19TPYM2mZg&oe=6AC674E5"}]}, "id": "2860729414288916", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1-2560x1440.png", "id": "1615073666698343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624069_1615073670031676_8918779848857087699_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMtr6EhCr68Q7kNvwHAMuFP&_nc_oc=Adr2rv4ki1jkdJ7EifSaoWQsxgmU5dnqJDh39Slbx9aKoM9u8zFLYoombB8T6RabrO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2mxu0AynKonhhPxsm3sXVXWV8drXOrGG7PYi3UHw9mA&oe=6AC66B23"}, {"file_name": "screenshot-2-2560x1440.png", "id": "1074012615216283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620669_1074012618549616_8702359764037665285_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZndrnKLeNI4Q7kNvwEZgAjj&_nc_oc=AdrI9OTHToOMGk4ccctwCn0DVNgce1NWLTpwh5ZjQ-qlubC8bR8d5m2uCy2Lr7nqg2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGKIg1cV7Z4ZYsI0gZI9r_XE2sAi6UoQhIBl7aqg6I9g&oe=6AC65507"}, {"file_name": "screenshot-3-2560x1440.png", "id": "2292414821298723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499621314_2292414824632056_6609008562636446512_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40_490RWWJkQ7kNvwH4fi0n&_nc_oc=AdpeVpiOi6LQ2oM-xsoZzgJQnvRufax1w4Adiwp-k_nxFcfu2ORKddLbyHVGNRBVfLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3rfKOz4l6XYB2iw5jfg2yruNulAroTL2FW_en5UJF_w&oe=6AC651CA"}, {"file_name": "screenshot-4-2560x1440.png", "id": "1811626919975772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_1811626923309105_1957786506738453538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnCej3kgH-4Q7kNvwFiCGua&_nc_oc=Adrzsv1GzMBm3PzK_rQgCQc2E5bAa-1Xuou3gOpIbUdKqQmRCbDuT0bnP701iLgTWXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY8800cWUCACTf2euoOuEPwn5nxAyOBlOuzlxKyU8I1A&oe=6AC65281"}, {"file_name": "screenshot-5-2560x1440.png", "id": "2184556942937752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619382_2184556946271085_5493924981742300238_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJs7S2KPL9cQ7kNvwEGdkLu&_nc_oc=AdpklOBlqRwrvr03rF0ncIZk3S8biyTdtIO8l9k6hifgBOczZYXF_ZrII2PHPN16E9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPpeCAKNgLHaVHbQ0oZSGiSwFqOEYvDfEMwWD07alETQ&oe=6AC66168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "915071751285953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593714175_915071754619286_5153291191742394089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w3p3Nq8OBAQ7kNvwGl2043&_nc_oc=AdqvwvxOrRB2HVeOWk_WPoDbHPldt1OUP1b3nbOxSxM4X8W6GbB10Af9lsE8i86MTE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9lFzkA0m7j1xogY0mIkkie5YB6hAwblAanYFv6WQ48Q&oe=6AC66ACE"}, "display_name": "Night Shift Security", "keywords": ["zombie", "shooter", "horror", "survival", "undead"], "long_description": "NIGHT SHIFT SECURITY\n\nThirty floors of glass and neon, one elevator, and you.\n\nTHE PENTHOUSE\nYour safe floor, behind the couch with the city in the window. The armoury wall holds two pistols, an automatic and a torch: take one in each hand, or a gun and the light. A basketball hoop and six balls for between shifts. Nothing gets up here.\n\nTHE ELEVATOR\nThirteen stops. Touch a button with whatever is in your hand, and ride.\n\nTHE FLOORS\n29 to 27: corridors with the neon city glowing through the glass at each end.\n26 to 24: longer hallways, no windows, more doors for them to come out of.\n23 to 21: the lights are gone. Emergency lamps only, and your torch beam.\nThe lobby, and two parking garages with service hallways behind the cars.\n\nTHE ZOMBIES\nThree of them walk the building: the girl, the clown and the runner. They groan in the dark, come round corners, lunge when they reach you, and go down hard when you put them down. A board over the armoury counts every one.\n\nTHE MUSIC\nEleven tracks play through the whole building. Change them, or turn them off, from the in-game menu on the left controller.\n\nCOMFORTABLE BY DESIGN\n45-degree snap turning, walking-pace stick locomotion, nothing that moves you except the elevator's fade. A zombie that reaches you gives a red flash and a buzz in the controllers, and that is all: no health, no death, no game over. Open the menu and time stops.\n\nSingle player. Standing or room-scale. No account, no internet, and nothing collected.", "short_description": "You are the night guard of a neon high-rise, and the only one in the building with a gun. Take a pistol and a torch off the armoury wall, ride the elevator down, and clear thirteen floors of zombies: window floors, deep floors, three that have lost their lights, the lobby and two garages. Then come home to the penthouse, shoot some hoops, and pick the music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://night-shift-security.r-deopaul.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://night-shift-security.r-deopaul.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
4DgXvE-ZXFmXBdL0QIXmRC5TonYr2rxawe-gCo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdPmj6MjYemJrTF42Cm42ms8pLsZ-swIlw_JT4-_T_iA&oe=69C68FF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0dDhg-Hv_MQ7kNvwHScBbJ&_nc_oc=Adqacnd3OOEKDikATK9FSy_jd9jZYPGTW3v8-60ay2mCnSdbVj54vbq_JCNX_nS69TI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2J971-d0dBbdqBTVKPVnoKNgUrHvBtvbsTJ3UrqvSXA&oe=69C662E1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUpYJIkLQDwQ7kNvwHbc8nS&_nc_oc=AdpeKmMP5QcxmQlyR913-bY7B2beve4BWp9jYNJL5uL2V-WZcU2rgv2sLcCIf6v7e7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzo7L9EXJDvhdeG2xnvDgbkqhkjK1NwnUbouul5gp5FQ&oe=69C690EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8hKCFzT3nsQ7kNvwHahBxf&_nc_oc=AdrwoelQYEMlAJcJqaOemvS1Zw5imQK3rfratskizOHYqLVRpMsQS5q5uUFcyK6w394&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFrCGvHZ1GbNDfiPrOUYSeh_ZHvpKikiOAEK6y-fIZHQ&oe=69C676AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7zoCxWbK1UQ7kNvwEsIzsm&_nc_oc=Adqas8XYfjzloyKTALRSWwp7ZaZw28Xk6XtidjiRoIMrGJ1dHOV1sXOt0zqG5ckdib8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSMQzPugnfyjQ2t-2D43afwaD8EWe4RcOnjq0naPy4Eg&oe=69C66AD3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
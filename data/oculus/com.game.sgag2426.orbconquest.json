wSAGE3XXfbC3TlORTZPjA2b7ZkH--1gRURQM88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82frHP3X6s4Uif-hDgAqp_VZRZ5CWBrMFl-jCqE_ztpQ&oe=6A3007F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cwmydJbuVAQ7kNvwH5_5X6&_nc_oc=AdoMpX_9xLsLED9LDIPZN3xkZfoa2B4EDCo1AlhHIEvcE64PmqEyhPstGmxPGLuZOXg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kNqcni_4y8Mud7b87wiYRTV7i0wYhbhmO2zZAEKkzwQ&oe=6A301321"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4p0zJgMfiAQ7kNvwESftHw&_nc_oc=AdrBE6XrvpjDuHoNm_LRynLcsBH19u4m87iNklbgFKDvtyeVxug5MtC6tr2-ZrOVqIo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sgAlawYJEkhfDybAxf4lKsQJ_t2WLvonFCdflAq4i5g&oe=6A3008EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNfY7pboXI4Q7kNvwHnqG3_&_nc_oc=Adrics4Qg-KUvv796vFU8NDwm-liiCw962ulla4RmBgHfgM98yrcoUYfdR2XxTePACg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GxIDGyXqONifyxXH6NJwRxeVzM5ujcxSv7LL6NPFK2g&oe=6A3026EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGv1yhYoDVIQ7kNvwEqeBEl&_nc_oc=AdoNNdRJ6891JCCifyrYy09sDf39ShV0M1nnfI8Canp_57hJMABAr-ScShyC7thkYvg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gzbnNIhdjwPfi6gsK6YosF1N-Ccn4lfj9goDUpcMDDg&oe=6A301B13"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
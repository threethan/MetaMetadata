xCuW7ugsb7ZpS2OqhU060WhN4IkCsw0vDkl5KU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8Ipg1V894_6_HCGGk8YasqkNuZFqeZL9_2yUcBB4fQQ&oe=6A8AC732"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpF-cje8BRAQ7kNvwElilkG&_nc_oc=AdqKHCQlwbazFlbFhZRLHpX0iVYeE2snVKQFv9la6uRxIkgs8-FmrXI2WUiv2kzZAzg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsdAdQ3bqUGXPKXDDzj8UDBUYLDa6UwGBARaypG9MXtA&oe=6A8AD261"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCQCFiWFsuYQ7kNvwG2iphl&_nc_oc=AdrAJymWHcZxQt9QsphC_3vZpcxii9rcUMAjHK-a73ugwEWyR96cu2KkO9GgR6GhY8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHatMVdmsK22uyX4BhQQyvZ4uSfuChDfk7CnoxhPKsi8Q&oe=6A8AC82E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4XQfkVzEZMQ7kNvwEc953K&_nc_oc=Adpd9OHJ738f8EB5EJmOQe19szXqlorPgdEw9Wz642Usi5d97oDutU5LMAifvb0wQC8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_RFW_h6BGZ0QAhFqjMvj-n2HyLwOce2PlRwhpgJnZ0Q&oe=6A8AE62C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-35IyrZrYLQQ7kNvwHzQSLu&_nc_oc=AdpcHbd5KW_Yc6UsVDyZGZrUOicrGdhTZuJcSO856L0rjCuRVB2B5JMIMHJ-Ai-c97g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx4ouMqYMR1LjYI507iNPJoYtqqUqhk7xrVhwOysqHiQ&oe=6A8ADA53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
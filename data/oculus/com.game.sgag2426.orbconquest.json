4ssaOcb9AS5fKNu4mW4dke0lvKIkiawuNkQX-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS8I6mZQ8Rvf7i9opamvUDVqrr7fV9WvGnxGEZarDu5g&oe=6ACF8D72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMSWgP2teNEQ7kNvwFiByYc&_nc_oc=Adr1eIy0kxIH1e6hS7kBp6RctyVMuEyZgGnkvtYt432SBqjPeoMpCbaL28rXUyo-mXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLFhxdUPD5Wzpwllop5l6x5FivCSdEWTFn7lfxt5vvUA&oe=6ACF98A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utXGJPJACqoQ7kNvwEGc4jy&_nc_oc=Adr-GWfjWIDjVtCFjYHTZkhN9sT9-MgGvJRmfEr2aruxmS5wGbaEiX0aZryK2l6ov6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrbayXzcUlavezSg6qXQLz_sE45XzxqCbq17fmeVoSkw&oe=6ACF8E6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr3JHZ_VwTwQ7kNvwHnUHW7&_nc_oc=AdoRaXYej_8bbYfaOFpufaEuZklhJe_MXRNQNeKs5NlGCfvrgSUSsGpR1OHFrUqvXkA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTQ0eUQn5KtZyYg16RbtxnzHhbO0Y1c3G2WNde8uTZXg&oe=6ACFAC6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C4IKzwzCCMQ7kNvwGzmGTh&_nc_oc=AdqfKLKYq99oX8_sz5fXLynx8WCx_brvCVLk8JBz5gOrFcZ-dgtFa-xfqi1LeNJK4X4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpvdrMXx4aR2t1l9HwQsC7ovTjMDyIuxAzl_5w7po4JA&oe=6ACFA093"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
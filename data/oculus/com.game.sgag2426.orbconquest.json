1tZD6eOVKITxM77-FR0ksVwK4PypHr7pjSz5e0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiVtXbf9i4bmU7WtwPgQtbeqMnzvC4WWlda-175GEJLg&oe=6AE353F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjXNUUpnux4Q7kNvwFmQ5ZN&_nc_oc=Adq9Idqlu94X360sL7hCmIuuIif1OmQVzUoadnOXP5D5bnwQC-tp_CW2afYzWnNAPoo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr27PSVlRaBt9i3Z0Tb0d3PfW6pLgveUu6mjBrYM_kzA&oe=6AE35F21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KPGKsNQCREQ7kNvwHzM8Be&_nc_oc=Adr18I7sClg-AOFyJvk3LAVKaRA4HqJcKu7186P7q8xM3Z8NZ_9l5bsGNdKlA3vXZnM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlLFpfOjfRjyvIie1Sb4Lr2SMOdVTpqhkRjEIQO408og&oe=6AE354EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_jNwSynknUQ7kNvwFPjBhJ&_nc_oc=AdrCyIbsBRzix6tvzx6B54TcQDbPXgfGZDDbKTqksy1Ji0H8zneTsAKXhExTrD6rtok&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5JSc5V6OAtLioxx4MYO_TmUCGS3KSBKhmTY71frveDw&oe=6AE33AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MjQxg_Peb8Q7kNvwGRgAJb&_nc_oc=Adq8k8VFXJEFNVAWQA3Doh9saurmUji6oRIVSDOKsSYnvjo8ot4Psv5b5BXZA6TFEk0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaeJCpGHGbTEZFO1BS0uzkl9uVdG2WWh8clxvgpFQY_w&oe=6AE36713"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
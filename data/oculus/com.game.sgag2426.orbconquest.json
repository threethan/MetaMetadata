zh_Rt5zYSMqMnbHHkMaSJC7SV4fRNTpWnELLOE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXZevIF42yjhxpmSPqzACi0YQZVZey5LFsdqXhKdgaCg&oe=6A900D32"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAO5-GVa0r0Q7kNvwGHzyRz&_nc_oc=Adqhy2IlLNJiFzfZ5xUW9ILejswi6gw-79j2h1_NuCXDt2WcQpiBzcC6mbidnSnvTpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG4B77yFdi79sB2HL2GAt5JBae4nhSciYz7ihfWkTQ5w&oe=6A901861"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqYJUg5bNdUQ7kNvwGiHzsr&_nc_oc=AdrBcfSHuSiFHrc26OrgDrGP6ZJ-HtwGeZQqdCvvkTlSd4XsCWF7QpOefci8DkyI9gg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO7m3zFo9PI8LZ1PXN8Xl0oZlwNuEBNXcm_UjfPmoIYg&oe=6A900E2E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDmNKJAqF8oQ7kNvwFy2q-p&_nc_oc=AdqsowJvBcQWTgAO8_LG7j-y5ijo4VokaktrQ0rshinhiIlpBtj8F1NS0YUwVNnJ2kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXQSZCsQD9CJ9SmXKg3yrpwE-UOWt8Hvunqu9FPZqQAw&oe=6A902C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khz6wc1HT2wQ7kNvwEQkZ7j&_nc_oc=Adp_wHhLw9M0eZOiXy4JHeupng6iNzk1buKnwyXfvcgxa4b_sdH3nngwNl9KMqkVHbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIvdWM2iVsLNO3kW3p3_aJUWdURJweuql19hHubBkXJg&oe=6A902053"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
o4MIn1K4tui0cV3l9Iv2nfyVyr_1QoMAzHwbOU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rhfc6l5rdNjZbKYpetPedMBNrdP9ZIBN0JcVeaa-IbQ&oe=6A412B72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mmI_YcNZZ0Q7kNvwGkawUc&_nc_oc=AdpidhhNyETWr616MRpwb5uVSUBwpLsdmtOvvH3KjuDQbPW9Uh9yC7h-W7NeZSyLY9E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92s4-TfMQCtZbuw2d0pIpC5xqgXN7Z-c9RfrV2jc8NOw&oe=6A4136A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN4vHpxbwy8Q7kNvwHK1TO1&_nc_oc=Ado8L4tkvhNo6Rfxv_0bGCdXuIZhm5-w1JyXRFT3-L1RZ-bCjDOyDiZf0b0u4feEF8Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dIO6y2kt8Ghn3uQYrPbZRgN05D9k3Zw_NU18_Kg0hDQ&oe=6A412C6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h1j95OpCOoQ7kNvwFMGPuQ&_nc_oc=AdroentaMwPJFD4zQtCLSrAW00L9VxwrehrQn3RFvQASeEY-eOwJr7IVT-np5jyHyOw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sO_qnPR7NqgTQg-po3V7Q3c4ChFLWuOf91wW3PuD48Q&oe=6A41122C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLKpvEVLyUQQ7kNvwE9FgYw&_nc_oc=AdpTqn1RB11e50wFJvuT_YpzELEVAtNGY8vzGTtemhT6_5oidChIRE5j2ALTNbtyBMo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ueJrrLYFsdJFV3ChloH5dKq6OUOmGeTVGrQzqAoQeCg&oe=6A413E93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
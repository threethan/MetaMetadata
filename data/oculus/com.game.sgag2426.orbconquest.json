L0cGF9gCHESe3TqB4F4TxVS7qKHm49htUCbUpU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBby9v_OXlU0_Mz9eTNB2pE7QjIfc_H-3xUIQ17CQCshQ&oe=6A54F1F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOrvdcDbsmgQ7kNvwEc-VZv&_nc_oc=AdoOBVyG5iRds2BdBl40gGA9qQcYLRKW10X_rJxTDXytSN2Dk-0yIL25qtsq5BwEUfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRPAJTGrtGAR5K2mjgwVCMUZbP9FsLm_UtwBX91DA9CQ&oe=6A54FD21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OywE1L26IIQ7kNvwG8AHIu&_nc_oc=Adp71p6EhfAPdMY0Y_eDyrXDAK9CGiqtCPDKw2FSUK79h8jKQxae1vJ1YeMKy1zrTL8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2b6vhokS26K-3DBfrKGJ7-JgPrWWsZmTohd6geGeTLQ&oe=6A54F2EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jjhw459DTQQ7kNvwEdlB1S&_nc_oc=AdoM31w1tWsVnsz1cf6DqIP5clIG-ZRdRpCxyoikHqxHqIYpQ0vR6PUXFGk8fFhUoZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMI36b2u7N3VsxU4lhA8-OeWLZZf8T-ajdcvX2Rd31Qw&oe=6A54D8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQPl391QbdsQ7kNvwEU6AzU&_nc_oc=AdooMyx0Fuy0uMsA1zsHFhWIatPC0CTlNkc9afU8vOESwTt-CE8bZRDGTzAJlbRPajY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrXxFzl3j09zgrJ6t_YvBagci2ro3AMf1EPB8cp1Fk8w&oe=6A550513"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
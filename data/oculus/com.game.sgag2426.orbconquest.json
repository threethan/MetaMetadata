Q2lYrwzXXyZXia4ttK1t3KSNkRQGtUwkjtc2Sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OhNq95TgPvMc-PdCsoQ7ZLOtw3g_gBSGZ3qDNhg4JwQ&oe=69E4E272"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0oDl10SzZgQ7kNvwEWBAyD&_nc_oc=AdrixMXL0GRtyDJ8atWmK1_zzd_n3qI8RT7QMmrVvCW1MONjnhy17Y2fjT7dNMZBhMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05tbQwaqVGvRov9C0HYlrPqmcCwOHlu4UOQZRYC5oUwA&oe=69E4EDA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_F0Gd4eMxoQ7kNvwGzv_Zl&_nc_oc=AdrI_yPBWR5OKmV1cOEcr1vf8s3OmXUqBOk1Tbul-SA3evoCeP-Hgz3SSeetjRt7ZBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KnRSEzT1QLVbfkBzRJh8LS2Kb5fMMQ8NAgTsL51Ynww&oe=69E4E36E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpbM0ZNRXMoQ7kNvwH9-qfL&_nc_oc=AdpVDwEn0e3sF-V64ZMFdFsYrByHNIBLDkPxtMRIvChhmyhVVF3QbSA9c6LQ9RZGV0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aJHWxQqxMl4m5HmiU2Qhf2RvrukVASW9MO8UELit5Yg&oe=69E4C92C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF0wtkeWU98Q7kNvwENWNeW&_nc_oc=Adqp3LVCFlXGPQYfrLlcSHh7Qde5PFY8WDuSkGCcPDDB1lTBj0gv2z_YJQHrnyryfdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tyFnr1ZYHRrd1WJonaOJ0l9VbicbTN4W3YchSDrcGCw&oe=69E4BD53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
q3ZsdVYUzMkEITY85aAUpZXhG-3wxl-DzNPLqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd0g9c8ENjw6YCkCLO-c0WV9OcdYQSTQeYyV36mtlpDA&oe=6A53A072"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOrvdcDbsmgQ7kNvwF0JmTl&_nc_oc=AdrZ_q6OQZhV_idkiTmWTbYvYcsdYSW-LwkYoDjpPNas2-rmtPNlH_0ko8sbR_KDOJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZK1rT3HQEst3pMXD_xaLA60uPoOFXSrGlIplYJcDz6A&oe=6A53ABA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OywE1L26IIQ7kNvwH_1jYZ&_nc_oc=AdoJ9K38_Ljjf2pHIOLhoowB3oIaBUpg9FDAdPx_1TrREslvMpS2paU9uWjreEugLPw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV7w1Ne9hJ4JiKob6rYAvXULli0_ZjcE8n1Ctv0nzuRQ&oe=6A53A16E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRapO-SLS-EQ7kNvwFFE9dW&_nc_oc=Ado0BTojLNBHKH4tJ26T7hJpxIEUEMtIb-d4BX5L52ausy5ku5cn1QhLCQJt8WH85A0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWFU7RmVEp_qns85eSpUJ8YA60BP-DGsMDsVvZPVRTfw&oe=6A53872C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQPl391QbdsQ7kNvwHpRdkT&_nc_oc=AdoYZP7dKB9czpfwQ5D2y6Pf-IcgFcnWVFdgJJvG5-xdkhVs8XqVUVINbzHV9wTJKCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKVIxb56yuz1yDqrU2RXgwdlxnvdoGD8BMdd3BnrWE5w&oe=6A537B53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
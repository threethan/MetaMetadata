l8i8K9OJz6Y-QaAHVSk1vSLEuiESgKq8-bQ-80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6PINSD7hI-fQDS_3EyWYV4f0Y-B_0Smsyr5FlOiKS0g&oe=6ACA4772"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZtAPNTH0eIQ7kNvwEH01k0&_nc_oc=Adp3WOz0OM1FCkghIWBxoFg8evhID7v9kw9Xd16SbbxeBTt1fzkf0DUF8DZTwi5DVJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeuj-JmIGWg2hlwc3u4K4IpU5tB0kgekRkdHdfNGt3FQ&oe=6ACA52A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uX9mkwY9I4MQ7kNvwEiMn8a&_nc_oc=Adp3cs0oLDNjGhutzrDwDq6_lnn9IBPIL3RXBg-EbGenPMEWPVFkEOVm9qBA1ifFYwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3O1EVumAH9mamyHUQkpWmgpI1yXnBG7EYA4bSaXQKcw&oe=6ACA486E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=092v2RwMytoQ7kNvwFi-5GV&_nc_oc=Adr2XEkVGy_nnHGapXmwnX2zDyP6LIAqut_NC_9CcUHHwCh-27yi82h5fXq5iF3CLyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVrf13XdjdXtmLhYS8kzC2jwd9nkqAPbBIziRaA5voew&oe=6ACA666C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z78qvKDdULoQ7kNvwF2shfq&_nc_oc=Adr37nRZdnwv5hpOtM4eo26IlwrlPvOjXaGDeiU9BHmxSZ47HiTBvTxLxoUjpQdG7oI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5PNeCNcDtwAlORTTPk8qzMPR3IeDuqOPL5LIFjGX-1w&oe=6ACA5A93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
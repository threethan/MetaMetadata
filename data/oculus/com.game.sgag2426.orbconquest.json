jRuZbALTix358E51Fsykhg7LED0SPfH0X1lDT0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOfWOEh9J9mbxWtyVx86A501au4AHrvy_dQNyM0-bcOA&oe=6A974D72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_ujubKWsbgQ7kNvwFKwvcr&_nc_oc=Adq-DS1fhqOiGjZPE7sQygR7eKx1wWG8-UCNU3KlcKP4Sfueo1P591x5SgoEf44HzhU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfml6p8sj_zQz7iz1Z_O9WofS_-aA4daZkXOhHtbdmRA&oe=6A972061"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16emm8iaDUAQ7kNvwEIObHq&_nc_oc=Adp2Z7J9-tqAeVmeHxaT2d9xT1Zg5lIl819iGPjvaTDhAikUs13RoawWxO5uEZs5LTA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQCgQf2DO0hJoR0hr6QYm3NRcrPjfGXqFwZ_lI2CKtgw&oe=6A974E6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRvLBuNMydcQ7kNvwHNRFxa&_nc_oc=Adomz0m8ZAZHv3WvYVYi9mBcwWTOwfTR3RvTlpM_D1MvQTOMNiHacepehZ4DsoTsGmc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAm-3Ep1kGnwqEPkv4JuBgy4NoySU4IvZAT1ytg5y1tQ&oe=6A97342C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efFDQkytGGwQ7kNvwG20BGw&_nc_oc=AdqeXVSaJ06ot8dtfkOf5WaWSTnbeRrcPkwKb8oIF6xsR9rbcx8uMmpL_VPoMNap0i8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYbySmPcSswMFI4UNmtk19HuKvr8XozQg_8MKPU4FDaA&oe=6A972853"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
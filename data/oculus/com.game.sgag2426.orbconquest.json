q2l82b8QUiX0r9UsnUzzUsmJr171kyuGmpE2GM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3raYeUXtPc2tA768aUXB3Z7Y_HHb-i0XWos1LrlYkX3Q&oe=69D51072"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgqTTxwATO4Q7kNvwH-fhj6&_nc_oc=AdoxHKsvgj3Ih-48qMBBYlMEkDgRoRIsjW-BOaq_LIDCQRtNXV5REvbmxOy0sr0c108&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o7Kdx1Kk42gi6MLu-NjSA8yV60CGN9ralrP9bLt4emw&oe=69D4E361"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1VbE5LmFHAQ7kNvwHv5_QQ&_nc_oc=Adpke8E-HNE83FGF853bgq55aTBzfYsn5aAfvwzxLkkeA5va-zTcaX8T2WdeHTBH6oc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KsoRhHKHmRByWIVcYVUVxpXjK6SqajI37GU66JbeJ0Q&oe=69D5116E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvTIBILVjo8Q7kNvwHHMoM_&_nc_oc=Adp342UUGahdDItzTZMSLoUJSLCUhRxi2VdHiGbCl_L01_B1ckl816bmrELt4J0EK3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kjQOyrvUaMJEVWasCSwazoQj5kpTdQ_XAQCyyMxkdOA&oe=69D4F72C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0bICPgEFv8Q7kNvwEo02Yn&_nc_oc=Ado-39Ne-FLA10-JlY5e3BjzhYFiyP3fvZ0HETwdXFg66gLOtdveBM3miJBA0t3hivU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nDP4vv-2mGP3D_pPWAvf3GkYLNOSMoDbKrO9-ZFvzNQ&oe=69D4EB53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
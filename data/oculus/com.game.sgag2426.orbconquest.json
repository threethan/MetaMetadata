bg9T0u7RJGL8-zIW7FLVzWGGUxMuCbC6Z64hP6iXBVnfc-w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfP6rhwGQgwpt4nod0Y5didO6OdCkMHFw-RlLjsgqWHg&oe=6A858132"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXon9Q0byyoQ7kNvwFD44mV&_nc_oc=Adoh0IXgjWeyfQ13fIJs0_gwpibwr6OYHpj7VmxwABADoE_H774cid_yw0tTr5Tqiag&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6TA3CQ6oYWCGy6vXwhuvDNdV4_APYwL-4SqRD-7eOpw&oe=6A858C61"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhin8uQZSDQQ7kNvwG7Fkvs&_nc_oc=Adq5EeqUSssEJ7u90f5bbHi1UK7IejJmQO3QzA1wmlfCNpfBa6zXMRPNuR7AogwNJ20&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0x1mBHDEmfcmSUBxEKFjObpDGLCVgJoeFiAPB6N2jLg&oe=6A85822E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E_uoZGpixYQ7kNvwFlgSt5&_nc_oc=AdrIjrJT5awTyQ7O7c78Kg3wEFf_EevrDipfpzxrKReXWqz9mnb9iG-V5f4gosUUBHY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxO3zIbAa3gZPMcosGXmUzWMNhNBFaq-B4FetCYw5I0w&oe=6A85A02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDx4LszdPo0Q7kNvwEcbp5P&_nc_oc=AdoJsgKHgMj9NABA54mhP-mph4lyO2My7u3lc36V58BWbTk_7IhO9rCtiGrDRISGDDg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH088Su3MZFUNzukovF4_3nEoxpjSjxbFbcBpGUmTeU-A&oe=6A859453"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534"
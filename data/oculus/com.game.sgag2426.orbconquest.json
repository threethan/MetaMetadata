mdXpDV0sAA_FMp7FmKQvs6yI-QaG_RZg8UIWEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e1M41P_As7KQktlZu9NQ9wKRGnRLHn7ONG8STZourdw&oe=69FB4BF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZVpylPtRPEQ7kNvwFfdoFz&_nc_oc=Adq_Wj64Oz3WnqFxdJPTxQlP1rfh0GSkMvYjjzovN1V7tMKj_kLD8YsbVrDhSfMZppU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MO_kU_VD-CLa4AnN64GuQkqnZZG0pU1Rm5UpqdhtJ4Q&oe=69FB5721"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEPzBfNcXEQ7kNvwEQQtHc&_nc_oc=AdqXyYoLnXmACpTxc-iodShzGnkjw71Kk-6KGLGDzHwaUbZ0ODtSK1U4euIRM0dSMCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zMVDLJ_uJwAVxcbyDzAMt6P2pnnq9gFULSKzi7lqqpA&oe=69FB4CEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VIzGEd1FJoQ7kNvwHg-z6i&_nc_oc=Adp8OKaXNTaNdEBz6NlfklFoul44lOUg1pblmGs7YLnCS8uLRAb03tTEniYuKngTcus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75G0SM0yIqUR6vTMDNTK7jpVJfxRz_tp1WU6HDvdUxYA&oe=69FB32AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Owe5wdfyxvMQ7kNvwF5xkxt&_nc_oc=AdrHMC-YADoKQ1XOM_MJyy0QAba71GZLpL__p1-wDj8QyPIjGinkaixxJnTrTFuEnYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h2XaDfXfeeAE8zmfe0D38JKsWtkDMnyeK2TTtgcB4jw&oe=69FB5F13"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
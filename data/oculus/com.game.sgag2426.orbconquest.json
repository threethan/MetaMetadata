_-qxhrxE-0W3XsNITlE3_CUW8gh6uw&oe=6AA168F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KXsOcirIloQ7kNvwHjpiPH&_nc_oc=AdpIfDiMor2rWfGjDruHpcDSeVgf1fP9LnGQ4sstoeQ4OKNwF5zjR6AfbLcO95bGSpQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA62z-Ae2d22z6O9WdAhUS6PofbO_IdqjevbXBoY-syA&oe=6AA17421"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TADCMOGrxMQQ7kNvwGuqSE6&_nc_oc=AdpmP_K29BzcTaH28RuseauScRj6zWrjv6GTZlDsy97uD2SA8MJAuvxE2rEUxUoxiB8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyfdmUibCpAb_SzCn39L_g8lyhtp7ML2qAjWerkTTITw&oe=6AA169EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fzi7_K6EoMQ7kNvwHRWzN9&_nc_oc=AdoBghJSzvEa7WOxJ4DhYUkfp9TAJnCSPhSQJ9sp95Q9NFwtf70sgTHudgvaVhMPVlU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2GDeMl9WAxHZcj83BPY5xoCLlV9Fdp3Kqw1IdLEzKCA&oe=6AA14FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4Mz1ivFthAQ7kNvwEgO7AT&_nc_oc=Adqp2S2RwPMOUAw2aUz4fTyBhjybCsYrQF06N4aYwLBKouz3lExHal1NrWQTPJ6sdNU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrhe7cxy1UQFQa1AQZiWkS4ixsxA0K1W_YuD0MIDcrnQ&oe=6AA17C13"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type":
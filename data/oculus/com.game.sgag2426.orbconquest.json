jWNz3a6A6aL95kuO77nDiUnbICTf0RqoSrdMMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_dxQ97eJLUWaq9ja1FeFaBu9yVOF_sKplEGPL-0CtKw&oe=6A95C3B2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_ujubKWsbgQ7kNvwGQ-Q8D&_nc_oc=AdpF-dRfJ8C_Pr1RfTs_aYiy-8dntauNFHNQNoAlbH7PyEh_8KwoIMW7K0I4iAS9mQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbmMVZfWPF-fQTporRYFLjs9M0QMJTTEm2gRa-AHjELA&oe=6A95CEE1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16emm8iaDUAQ7kNvwEFlBEA&_nc_oc=AdqvGbECzLqIXlkmNfJKDMAqvIC1Jfl4WD130UC7MgF4d1Y7SVoTullbLksCI-mvvCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsuB7KFS7FGHIIH9DQnmLfqPUyr3Cv9LB6V9FOBtXegw&oe=6A95C4AE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRvLBuNMydcQ7kNvwFmEIwb&_nc_oc=AdqWku0LbACg2-VLRr_MpcwrW95vf97yozzQslUK8gmFZ09VOXloVznPezZkTgabJSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo3TWwAgwUtEMlnBenGkkcRpc4W-95f43nuUqkk3TO8w&oe=6A95E2AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efFDQkytGGwQ7kNvwGiZWdo&_nc_oc=AdoJ6siPaWlR4e0dGI21tMpwmFYNHywzRzXaSH-EXBRLB7NrXjDTYZT57O3dVdAubW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSAFR16uBj_2xA2JrNb69j09bZQNFxeMbUCTMdybyk9w&oe=6A95D6D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
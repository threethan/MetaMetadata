PHaQPQG9HS3ZrpNPABtCpFooMqW7lWChw&oe=699B0E72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79jE1Fikj9AQ7kNvwHko2fp&_nc_oc=AdnDJo9adIjEAUVLSgwd8fD9yOjaqJ5hQ0at6I7cI2wkgaD83p5PpKCdK_ZKZ0y6kLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftUMrS76bXJpThv5TYWNkX_PHYWNIpDTqTnhRbO3dN1yg&oe=699AE161"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuTAxk1WPSIQ7kNvwGSjN1c&_nc_oc=AdkCANW7O4vMdHGxm8nGchVstpTg9Kljy5wH2ef5ZA7V-0YgcweuvtE977CD7DrYNXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuOGulhrcNnqv9StIjlwpmfzRM0faUECIZRB_wcrqoeAw&oe=699B0F6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqeZ7Fc6Kd4Q7kNvwFlc0mC&_nc_oc=Adme7k8cfJnTt7M27tcvXSqHTTXcv9KQXRathDzV01NH9G84z72UCU-hLSyvJkoOcBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv8TULR0XKVEYrDQQYb9UjOphzLhgUQ6GT4wXQXt4N_JA&oe=699AF52C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixFVec0XxloQ7kNvwHU0wYT&_nc_oc=Admp_tpeWg0n33iVfQRUwm3ZJBtMa_EkNpb9fBJfvDZKkHdxHJCscGIPEHzboSDhJ_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs30R7BigHZ6Kw2D9jwbh3w-lwI2RlsbO0rg0kTfCBQlQ&oe=699AE953"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_
sGNNz2jBfzdg9sthubew43AOuhMHbxkWtcyyuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00sdi7aDJGeik51QkzO2HHBR2K-bxPNWrFBDQYrPz6pA&oe=69DE4AF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlIdLc7YW7EQ7kNvwFKLt4f&_nc_oc=AdpF-tHu5zcseOyBirBH7K7tYWWstEnu31OrBM3GP20ha4KU0dhR0BBebRMQs9Rb5iM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W6lZkZzZFNF20x5wDlIINzSa7JNbm4ED0eDaoeKjXmg&oe=69DE5621"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgtG91Vu9FkQ7kNvwF-6P2b&_nc_oc=Adq6C069MtK8Yquy9WkizfpL_87ubIq4AE-Gp42LyCvdRpubDeslu-EG8iEK_OWf-q8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hVPPpnSz8s8p2oTFuFOqsrcgTPi5POubEzm5vpeynnA&oe=69DE4BEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cIqntX3TAYQ7kNvwFoJj1x&_nc_oc=Adpw4q8DGo9rozdn0sHKWSURcTApSiiNaAFwbo-I2FbAMQoworfKgBCENHjHFcewJP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hG2nBqetGlcSkhp45ZfNIbr5p2DEH7nv1UdwJCDsmog&oe=69DE31AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQKwyu0F0CQQ7kNvwH9HgZ5&_nc_oc=AdrI7rJnzmCDCbPlDsNelVQrZG_bc3TBdxu6kjzUhelMn7mkeqXe08T9AX_mRQi0fzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24weUtQUT4jq1ayVk4wvCCsmU0YASw0vnh7VhwHH2OYg&oe=69DE25D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
Yze5fWLnUc0Hd-w7fuTV_ESPPT49vDJEnwvY-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBabJXU8xwA2curwyccn6vj3ScJ_NGVrwB6AwGNv7rAg&oe=6ACE3BF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMSWgP2teNEQ7kNvwF9l90I&_nc_oc=AdqGu_IgMwx-Wd5pc3714HnTirpBWF3CzWmDophHd6KRNmgr4Q7ebMlibQo5MMem0qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3O6XAptTuM8reCqBoYJQcVPg6i4bNRW1KUQyA-q0VXw&oe=6ACE4721"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utXGJPJACqoQ7kNvwF0CYKX&_nc_oc=AdqS8KGHmTwsPAOFK8coYhYbPeTcHI5tQPyC-EhOvkkKaDlKj1nlhA6uu_qoN-faJZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSi8TKMzGjJpc92BpOE5PnQabaVz9g8xo1xv9Fti1Jyw&oe=6ACE3CEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSDandubzdcQ7kNvwEpqhM_&_nc_oc=AdpVJd3IzK8GlvPJWMd-mPSqjcHzkYWA0rYIWyszvNn6LZj4CTOk4dR3iK4dYrJR7Vw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrkbgj41gTYTIipNautrOVjVsXTl7wWtxc3kVyRnRuKA&oe=6ACE5AEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdnoqkIOqXQQ7kNvwEU8yg2&_nc_oc=AdoTupXA0yBcy8XrN5y46Tw7ezddoj5j9C8rGVt4sVGxZtHV6WTr1BYiGUvoz7dnxmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbCikltXcK_UVGi7P0NtOW4JTzU4f0jYz5X6bwKn8_ug&oe=6ACE4F13"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
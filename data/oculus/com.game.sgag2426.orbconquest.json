BqgifDGfZHE0e_UmdN6hkoxVCzqalXG_gkfRqc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bb4uoRL7NLTM6qbTRFw3pESK4GcWWma01Rhs8Zs0x3g&oe=6A32AAF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT6D8ug3Fk4Q7kNvwHjFWUC&_nc_oc=AdqI1IS5t7WtYFb3TyYaPPi93vLGD9HmqGTBZoB0pA-EMiOdzmmHKFyIZS79GbDlDo4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f-u7IY1k_vcWYvHJDBiX-U-RWjYLgsfj2k99SIhC3Fg&oe=6A32B621"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiBo4TaV3toQ7kNvwEBZ55C&_nc_oc=AdprMSrfHs9CCf-NfnfOZSiPhukKYOie7ta6Vno5j11mhEjlJohItZPpjJ-nxxb3DWA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__uOvqRXomi4S0I056BCR8EX6n7b5-kQsfiLuaweHHTQ&oe=6A32ABEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA_Z6RlXSXoQ7kNvwGG-klA&_nc_oc=AdqdhUatgrnyZmVPxvEXXAR17TyLqINIZVCBZm4sV5sT62jykJpWSUHd6JFUsLNt0AQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84zIaot7WarS-3q70dpzzIdhS2F0pxU-FcggiqYCezbA&oe=6A3291AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvzWG5E1-sIQ7kNvwFwYoXP&_nc_oc=AdqznVuy4hFyQsbZOGRCqm4i_Nc8ypem36k4I9VgGgg6OmcZsa7URIrp7mZ28Cjrtho&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6X_ZikG5BmsuKPX5JFdo1RktUj1fK3I7RYNQWK-9qWw&oe=6A32BE13"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
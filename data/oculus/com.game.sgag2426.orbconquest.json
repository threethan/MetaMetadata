y24XyNvHhs_mWlB-mHCdCA_85VmfNZj9Hv8X5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGLZlCvSVmoa_p66uaZ3-TXubmRALjnn67-gPxjSLFMQ&oe=6A5A37F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIcaUAbHEMIQ7kNvwH6L_MU&_nc_oc=AdqlMpWkjY7HeDaCea0yg1XCgCqYotuQpRvqm9Hx_7gjr8Db9QYsiU960jNdXzwXSAE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjkgNE7FHBOn1ybLn6zcIYvbSxmV84to2SngWLw03CiQ&oe=6A5A4321"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKa-_R-eAaEQ7kNvwGItez2&_nc_oc=AdpyLSwPQ3-fGnrLrarS04AJ38qcpALi3-6FrGjNxDIylssPX7KXxwSGg6b4KwnBsng&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpDF81oK0x1NHHdu-StSOBAmsaFyJ90t0xPOqVwqjdrA&oe=6A5A38EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS_Eqh-GlrkQ7kNvwE-cu34&_nc_oc=Adpk_AUe5BFPBrByxQYwVzzT8vt8XPuwHYCiDxcH4w8sIBr97fkku7elL4XfAFkFMhw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLaz8Fw1vVWydGMsRBzsTBWFoBCPJ5-3BlAB84w_uxeA&oe=6A5A1EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eplk90b_KkgQ7kNvwG_-24s&_nc_oc=AdrybPCD3N6GrL3oqxJyDIxLDgCF4TSrY52Ers7mMEUhlf61rhgJ0oUvAIZPS3T0ktk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtWVL1cNlIiiQE9BolmyaGsMCFJobpVsfxc83e2705sA&oe=6A5A12D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
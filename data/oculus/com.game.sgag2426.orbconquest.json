1tvNcUKwcsf8LqPHyWW8jofS0RN9o3DSS13Wo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAOiWnfKRyChXc1mKLSg6EMdb1ORuTZaaaz__3iUDmJQ&oe=6AAD4672"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYT40UD76k0Q7kNvwE6587u&_nc_oc=Adp2lw9N702M6WUp3nV-aD9UjK4KZzPoBSBvFhKcLrPNOXFYAKT6CjQqJuhpjlqLQT8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiUFPmlhua-FKBKDDssEDFynuDAJYClxuux30jXc75Cg&oe=6AAD51A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XMBxbG5V1QQ7kNvwEHUap9&_nc_oc=AdpjNp_BHYFROEDQqlu4f7EZpV27AirM1BkxFMZ1ZafgBhhMzeS5ps8uCpvwsM0nrMg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKejBIQ97OCUKSDHa2ErhcovGkQsa-pwg_7Ylv-xntK3A&oe=6AAD476E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPiKl2MvJJgQ7kNvwFx0aPn&_nc_oc=AdqzJFylcJyjf_-ocFrrswwtbaZeqbt5HPOjKSnlT90BO9zE9j99hT3kd1cYvjT9uuM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU7w5JNUuYOYhW7bIxqaEbXFx4T3NU8WqUMQoZguyAfA&oe=6AAD2D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbYTU442BfYQ7kNvwGOZMPx&_nc_oc=AdrNRly65W20R2DheOkuk-f3QbaHgvq0Eckh4CcSFaGVyqN14ifXA1OGeyhVOFfExJQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBstg4PldNHHvDwuQHkmkGZmjyU-f7SU-eZbLhtW7euA&oe=6AAD5993"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
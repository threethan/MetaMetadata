8BB_bY4ChM7gq3WnSJ63ZRRrGydt1lwLukLNZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLaPPmqKo4Tc9CqsTOr6y8y732GC_3NH8wlL8rRZTCEA&oe=6A9EC5F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ecVuJkq7wsQ7kNvwHinJyK&_nc_oc=AdriJ8GBL61Ta4seSFXZ0fVKXmSx7ekd1-CNI-C34bJrqVwGatBkkgg_5If2-q9fkM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOXSYOmbEQgLohP0peYEofgOa7p1pohxqm2rSVfwx_Iw&oe=6A9ED121"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTyWG0KHG6EQ7kNvwEeVFA7&_nc_oc=Adp6ShLkkuV_627RxT9IH5rw6B1pOYehp6gSABTFMPm1Y6STjtPBMEKgY7_I9C3d6PU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2stX0_r_6D96mBFU7Zjs1q4EanMDewZzskPwiRVrGLw&oe=6A9EC6EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2LZ-U6puiAQ7kNvwGmz95J&_nc_oc=AdoqqMKiRiUngZQ96kZ___MT_oygRSGhqa_zY1KZtA4S5e-81lpEwCBweL91JiIYQe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPt7RSISTLvp_Kh5NQDHjragZmhvd25fAcezQ3GBrBTQ&oe=6A9EACAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tf9RDKAGvQQ7kNvwFEz_U9&_nc_oc=AdqLRX8WkPee2J2soR7u6zXIF6c7nn2ihkSgrEbpf2emzCDPclNpjXN3i2g2DOepOjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx_Bby8WreQ3iXh0P79noYo5_NCZzfkw9IAEIiTp6qdA&oe=6A9ED913"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
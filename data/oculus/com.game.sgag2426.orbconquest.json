pCsuJ_LHYpUG4kR1PcuLSbCLRhB2uxJ_KUvA3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zRHxdlFNtSHgW6whCb4C0fbcnuF8OSDqIoT294VScww&oe=6A072972"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HinpPxbviREQ7kNvwHcC3tu&_nc_oc=Ado8DZ7dLCsfcbEsM1IF2AVpDWDao7KpuxsmaBgHGCYMiEDbFQ0w8W5ply1p8zMko8E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nPx7sRS5Q5-7AfsaOTM2i6Jn4c1OYDOX9R7eYay_czg&oe=6A0734A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eSNIZu73Q8Q7kNvwE7_SNg&_nc_oc=Adoecjd2k8YMnbk0MQHjESqe718cZAJToTaS1qTV8-TVFmiUQRrauNyt-_DuxWBk6aU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aWW8xmYWmXbsauOgn82bYsabNZnSk5qllUlyX41CFGA&oe=6A072A6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p99UjGJWBIcQ7kNvwEzyTmG&_nc_oc=AdohD2N2hWGLqKu3owOcEaMoF0nzECGAcZqkpSJIlrVRRQtQ3y_-yDOQvakjsASc-YQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kHLRU5gAOA5HYR4_7HjXfIv4nv1EuJTnkkK32PNC0yw&oe=6A07102C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byb6LM2ou9AQ7kNvwG8I04Q&_nc_oc=AdrRMSYdnW80KLckp7bm7-Lhd9pOLlr0aTSdNN5EsO-OBoshsyUIXdfdgCSGTKUFmo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JDVWQK5HILVIhjH2D9X479-GcNbZG1Qoz6rKPwUETDg&oe=6A073C93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
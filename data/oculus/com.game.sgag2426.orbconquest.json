1E8gTWyQyqPcZELkgM77ZdGf40zbP5lIj0eHDI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76buDAVfTlwhUR3BkCt74b08iweCxH8R1cCHBnPMiBkg&oe=69FDEEF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZVpylPtRPEQ7kNvwGGYMuV&_nc_oc=Adpo_BS7NhcCjg7AoODj4Ux6Py68a8BwjUkEUSrfdynDwI0s7zfWwV0VlOq5Lfs5bxw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ETCtya7yujECgaTTDHVcfdNCUC_adFpKQItyXZm6c-Q&oe=69FDFA21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoEPzBfNcXEQ7kNvwG9JTO4&_nc_oc=AdpshM8RAFQUGMJ5z2n78ISinbdf77ZeKj6KQmWZBV3JwwV_v3NPmWUVLQw0DG1HvrQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LZ8RE11CJHm-rdBIRs0I7lsFC95kgzjuPPdxJ1bbA7A&oe=69FDEFEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsQJBTTngpwQ7kNvwGTxKE7&_nc_oc=Ado_0muZb7pIDHFIpQZu-3SZFUVOLG9D-_2NkHSCInxMaBGInSOk7DnBwtqYaKDgiE8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rpg_pOKMc2VvocNfoiOicVWGP6tg4JIXvo2MtQKtL5g&oe=69FDD5AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Owe5wdfyxvMQ7kNvwE8Xpsz&_nc_oc=Adqo3_X7ct1TvDyzbCr7IlqE1fWNnZYmnAe6vGf3syYCRNaLxdwotV9eufP1SXa9jbA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jgz1zaToAXEy6OU9Hi7mHoQ64e7LJu_6KL0wai93gYw&oe=69FE0213"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
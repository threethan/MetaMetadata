VZ1z64wdoMhbLA8UZK8gSGdHzvrrQ9RH1KLjiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrp4MGPBIsj3QM-eEiKG1KiMfo1wsqywi0cFH-OtW3aA&oe=6ADF5F72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMJ4kmH3Lw8Q7kNvwFrzLnQ&_nc_oc=Ado0-Pkt8cccELUrOTMaSA4W7dgUfPVU4PwpkN5G3hTGLWOhqbJD4b3YMXIEBh9J-5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz_Yg8IX1-7RJxKHh7hAkqakjfr7s2cuJHHxb7TDtkyQ&oe=6ADF6AA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WvQab6elUoQ7kNvwEX_QmV&_nc_oc=AdrUCUYSrvj-yBBNolblwaLjIM535S6M7x1Sn7Tz6jiggXhHw_nutVOyW3rBnef5Ln0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh4uK0xQVLH4jgRZPz7fqkafNAX2K9wPmak-h76DyKnw&oe=6ADF606E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yaoh0Bp4m8Q7kNvwGvm25h&_nc_oc=AdopytRDUu6PPprRYObg8dIsSVrg0g8tH5ucK7i4p_Pl32MpRD3ynb9boRaqB3amLfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODSwDQTcneN_1m0UC3HGaKH5SKXYTjW6yKjJiJS5D6rA&oe=6ADF462C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuVvqrf7zacQ7kNvwHdntlh&_nc_oc=Adojm-xYoWbExWZiwAgOzSArP8IKhhNElErNKbkleglZOKuT3YQ_16PRBhk_p8vst1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGdZblMTmHb1svwvMdSWcCpRn6mnebhfJXDLLBI5Orpg&oe=6ADF7293"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
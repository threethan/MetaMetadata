eDixGkDzc7-OYDO_gSug5iv6oqYAflTmYttHNY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vkoJFuIQgU7w5uXzNP3D01TUUnz4xT4R_m_fWozyjqw&oe=69E633F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0oDl10SzZgQ7kNvwERGPYr&_nc_oc=AdocwTAQISAA-JRgEzUTEabZ4njHOvMAaAzP2y7mMWr0nGdiJf0P7FKTpt2zhlly1iI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2szJ2OkYeQb5HXiq3FmREpODPvr7dJVwRgpnS75jTQ6Q&oe=69E63F21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_F0Gd4eMxoQ7kNvwHttCYB&_nc_oc=Adq_eu0vv-0YLxpIXJk2eHgmBM4SKl5r-xRAaZPxrt31sqZRsPKdfEzPiqVPg7bRLZk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G6kEHDb4fmcRKFbw1GOB6W2P78NRsB_NDEsvBoEkdCQ&oe=69E634EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GkBk94UKjIQ7kNvwGmX1bb&_nc_oc=AdpYecH6h-Psl4tag9vYbu2rul262dNrz4f0h3XzJ7_L2kAXQlxb1K-RGrCHT05hUhc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i9b74Kpxi7HN7jVG_K3CbsX9uQ9AbohMeKFDt1Pyt1Q&oe=69E61AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF0wtkeWU98Q7kNvwHqYCzP&_nc_oc=AdphbhJJyo-uUvsnhSfxgF0sFhCNgRVzAhKLWNfhVdVQ54t-0Ji9yFd8IDT-3sIFbqg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WeoLybWn-1NULKCJKxE7FITJo7RF490mZNXMhKpwJqA&oe=69E60ED3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
e_ELPxX4Jp9RqxtOampwe3bSL5g9ZXS1vIW7u0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2ruqW2BKBbMjdQa4fP0L3W5neND-grT-G4IPALqlnBA&oe=6A637272"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsh6y0G9-zsQ7kNvwEoHDgY&_nc_oc=AdoBkzRy0xyWlCYDE4q7TWqt2LQztvFYDP5cW2TDNFQCRe-giyLkCOaZISPwPMuF1ZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdTG8q7vYmRbC8JSttxNxwtwnRdSTyDuc3tKlazgbCgQ&oe=6A637DA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqd-PGuSV0UQ7kNvwG0UDpS&_nc_oc=Ado4U5sG_ulpDZJGiIWUb0cOw8hlmLTb6Gb5vcHvC-AkYct2XLpTKZQEgM8ZyZQv_Ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBebA2pVyTJxenWhurx0IVVUA6OIr-9o3qhcBDuZBfo3Q&oe=6A63736E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q55fqzzTq8Q7kNvwE7hJLT&_nc_oc=AdqWclL8MhO3Xe2PwrcimBbHElO4d36st0Fp_6nlhZ1oCVIxNrqpb1mH5N54X6NI0ec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIOzEE8inWoTcNXYnIAglLK8HSAhVmvFtljNRDrgjYkw&oe=6A63592C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8QP5WMog-4Q7kNvwHmdD-F&_nc_oc=AdrYn0JC67ZQBX5fcplQNdqzM1mteCeBQI5ibJov45fKwIZfRRKaRbiNEL7SZK95guM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsVs02ICY37tIh7Uv4zzaG2Hzs4xxFCX92yzamDoBzZA&oe=6A638593"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
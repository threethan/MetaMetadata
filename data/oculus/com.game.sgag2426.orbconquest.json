dDjjEsxI_-KWp2juW84Pq3x_XJ1W9cHqHmLhPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY7pMZy_R_EMbEeFj6j_WmbhpbPSUXuDg1J7YBeDkHZQ&oe=6AF325F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nCJF6Tmc08Q7kNvwFTjqG5&_nc_oc=AdrHu1GyJSjJjtCwx05QvYanSxft7B5kPM90uBKIBPEzlgV2wxPnKKAkggu2p9e5yv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc2gyuoi6Ytwga_E-8sthgb8Fwq4cKr7Xbg4JxKHVIkA&oe=6AF33121"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoHWJC727aUQ7kNvwElKWlq&_nc_oc=AdrkylSd3dktECQA2eGb_g7mfZL5IO-yjnwuCEpqEacE50Cjx-k4_bMIDkxiXolk-j4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPY4mABHSOvHMy1rGp7ERTnGVdmikWAG_hnMkkBx219w&oe=6AF326EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S5JE3_MWQwQ7kNvwEb5AMW&_nc_oc=AdqTQQRfi8PG92XC49y-T0EPVD9wgdjlXNawROBTj5nyfEIte41yElEX3_JwylribYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1wIIkBh3t_3sK6RIb_Y9hSbXFv6qTKAFv_7_CwnXVyQ&oe=6AF344EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pFjY5udpGQQ7kNvwEHSDe7&_nc_oc=AdqIZBm4k4h5jTa2D0oI5KMslCrQiBkqgpu2v13PPSZ-6iIEeIHNJtIdYDeBQY9o9FE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4jCCLqJVaVh65Kk3qfBVmJ2jKt3aSXhgkLJ6C-0VM7g&oe=6AF33913"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
rqjbpbi14Iz7q-Bhmaurt42vDY12Ly65zWOFVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBElEsTM3n4u9VsBwtuLinjKbTwOF-hftUVA4DmbIvCEg&oe=6A6220F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsh6y0G9-zsQ7kNvwFpIcSZ&_nc_oc=AdqOBe4uFceI28Di5CqrV_hMpjFEXAoYj5ffu7kEJYUqsk0O7vMBZTOkO0GfCg2kPf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuLZPdTJoPoXtOwCLDXbDIzAwnjFAEHSqxy8WDm7XBdw&oe=6A622C21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqd-PGuSV0UQ7kNvwGAx58B&_nc_oc=Adq49d6upH3-AmWFRb2euLflTqIBi1Vs2vcy4dVCnmTreizYnk0N6url3_0xFDlLVfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_61iWN3uMCCU2out25z5j0m9kEI0Y1e0_CAdv8xKsbg&oe=6A6221EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q55fqzzTq8Q7kNvwHh9xDI&_nc_oc=Adr8Vva-wN9t8syrUfao-m8KFzESDMmzYyibf5t69hwejK6hfRo8JidoaPncrYw8gQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiyLLigTypYDP1SbrJ3CQajdot5Rue_Oc2ObffQDUp5A&oe=6A6207AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8QP5WMog-4Q7kNvwFawGNa&_nc_oc=AdoTtpbEEhaxC8Rwukt90OG_fTvkywQLrSV6aJb7dM62PlOPJgWTDzxE1chZHGPxO7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpmBSqsaHYSNfYOImEMx0b67TDAdog7I7ni6qVTleXmg&oe=6A61FBD3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
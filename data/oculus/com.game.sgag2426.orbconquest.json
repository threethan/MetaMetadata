wZMz_KAOeT_thhFsVN--UId2QcR8qp_thTNAIc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sElRIesxG7AFtCRN1A0Zw9ks_NtHVa3ssuuvShbERLg&oe=69F4B472"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px101BP7v3oQ7kNvwHUTgrI&_nc_oc=AdpULN9Hmd937yOd25k45mLCLnjz0bq_VyTjIAqMlMdqDxg82H6Kwcg4ni1SWkceAeo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32xU62vAHxfFBhp54P01MRCuWst5fgm1Wi8fxn7MgZVw&oe=69F4BFA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJoHtuvbYkoQ7kNvwF0PKX5&_nc_oc=Adp0d_LHDCHwCrsgiNlqcjIPu75vIpGnOdtxSzOFuGcRbE8sLVp4JucKgo1h18ZoRws&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bHbIxBLicg0G8QFOND7UvKnAPVPj804HOgfOVeo97Qw&oe=69F4B56E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx899OYHtHEQ7kNvwHESEF1&_nc_oc=AdpuYikCDeWK-NJZY5DNq9FnxvANrTVWX7pQ0tHBoRTxy0azZtYlttaw5xB-TPFvVxU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-QIFhYR3mQjTDp5j3JOVAF7fxp2frurtze9SRqKaxEw&oe=69F49B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLEKuPM0C3YQ7kNvwG0vsoc&_nc_oc=AdqzOSvzWVJrSFM8li6E_LElorn9MR-fpoXLZgBKq74KLQPtD0Stlgs3CA-PT7e6Xfg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YsgY56G4392_TqeECOXpchk9u60oWcLEZxVA3eDcVKw&oe=69F4C793"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
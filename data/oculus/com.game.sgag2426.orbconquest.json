pePGZ-5bSM25gqjxS6K17U7YqgoMNIVP9LkQFbn1Sq-P6yPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfurrIWKcR-_MQBlJ98Gv52JNned3Ox60CTG5n8xjRiGpg&oe=69A41BE1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NOwXi9fXNMQ7kNvwF3l7Du&_nc_oc=Admp6vH6wj1ZsG7_DgkJvq6SPQIEH2bc07qBp8Lk57N7v1YchEeUrVU8AX4MQxgPeYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvYKXPekPg6kZN7NvdelxSk00DiKHD9KOy_57nmC5s4cw&oe=69A449EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZogEOBXizgQ7kNvwE3Wbze&_nc_oc=AdlwByOdrN0DXwZ5W9ZvDBr-ydc2Leny9oB5OpqzS86vlXaQSqhRNJQPNhOclTnUNyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-UdY9XSnvyZIZkmunUQ-KwEaZrhrpe7nU543d36sfkg&oe=69A42FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLAXD8WrUYYQ7kNvwEH7pUA&_nc_oc=Adm5htvHjeEJw9B2vGs1rxxIPn2-Pcdm4pgKSRvLG2UoGHKAE2EurE6aaVYq_mIg9Rs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvj3OINKY4InC4jvauKWdFIx8M67XFjt9kwdyoZN5nVlQ&oe=69A423D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "
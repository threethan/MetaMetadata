yv-kk3d07YrpiYB6jySKsA6n7ZY8m5IWP__3gs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8ObH1NmnVFIV435G2pfh7rBPCknRKQsT1sg2M9zq9ew&oe=6A81C4F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HcPdB8phS4Q7kNvwFtMlVa&_nc_oc=Adrayyx7cOY8twx8RcPlJfyxVkN89sw1l9LrWyeq4k8maN89dBg3FpgYbIiTIAZLvIU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN7HQz_muDUS61LOlrHScWUG-NIaqJswMdRYcLhKC1Lw&oe=6A8197E1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzD5sPOsjesQ7kNvwFivyUD&_nc_oc=AdqMOgoxubHVf-RhJD-VElHpeAHMd3G4xAvAlLHwTJj_76XJdBkF3HPM4fiCAaAiZIM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGZU1fWnUcjByZLOacGg7SdVMfL8cDmDSdXTaddNIwEA&oe=6A81C5EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWSe2x67Jz0Q7kNvwEhy1kZ&_nc_oc=AdoQAfi5bfK-qokqux5o4526cLNj44WveCUzMtwdkbrfic8LgRyGyGlK-FV-xL8pEpI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdrk6kmPveiMvcpLqNWi_6pmi-udGUZgRlYpHwYKrh-Q&oe=6A81ABAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7jSxSuJpHoQ7kNvwGPQPiu&_nc_oc=Adp272FHzeeKfFaQN6J1Tw180WU7owuU3tm0MBmLxDBo6N98w9P3UBVmrOSU5j0GNbE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtivMg6Ua9OiXkaGY2SXwdW_qCgUqwAksqp0tscmbYvQ&oe=6A819FD3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
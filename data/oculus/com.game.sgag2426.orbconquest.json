eIGSrDTI57qXB5nWCp4mTuSiebk7RuSmYRcsek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoVgPMgvR_Y55Yo81ehGOcEyXFu9IUIeC1Gmt60h9lQg&oe=6A4BB772"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9XiQRbbKZsQ7kNvwFTMy0D&_nc_oc=AdptXFVzQtP5hnr7Ix0u5BDW7pMe26eIZZbHkL9U2BeQ6W6r1uL7W_hGby3bJ6RnoXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlcgsmNb8zfBqHkT74dykWucUp_uvOI0EqbmIkL48uZw&oe=6A4BC2A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeTpBO4ElWgQ7kNvwGFYU-M&_nc_oc=Adr3BpLQVsmQY1sgkZlhHxcnKJGl292BP-L39rizFE-xceR7OqYbtoRV6wZI3uQ98EY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWY2JydnFnHmi3FR26RPuIZ23Oe78GZ6toVVmjPLtkYw&oe=6A4BB86E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDPQ95oVcA0Q7kNvwGHi0a9&_nc_oc=AdpYfNTV5Qoc6zNAdUfDfiC6wYuNd6XCb35KjgalBqdoujDuUgI3nnLow7AfUDkx2X0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgIx4aH5LUmdzzXcadmO2d7FzlHQAp-7pJwby9waw0-w&oe=6A4B9E2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1Ro_pNFtqMQ7kNvwGnku2O&_nc_oc=Ado-Dc7gU9IGxI2IwYgf4PkB36T-oNOc4iyw_UBMVeVSJZYZhrvjcXP0NvHJmRB_18M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_XdxbGht1H5GYzDq3sI-R5OiFjBgZ7xOk1BooUyKNQw&oe=6A4BCA93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
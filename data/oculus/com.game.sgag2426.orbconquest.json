XNCKpz6No6tJWmHGc19ar-0_3dLP6s6CAjK0mk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-FWg15-hoxTzW9oOhIPaMpqX3w8js4msNkKDPT5Nz-Q&oe=6A9D7472"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ecVuJkq7wsQ7kNvwGQHTp_&_nc_oc=Adp4rdUk-VCKA16sWeSX4v4ck5e5G4fjM4c2WIcVLr_vh-3JLF3ajAJuOtUmAQWWkJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdKkbVS_8A6Ctozpr6rAZV6BYRoslA3jTOLn0PdV8JGA&oe=6A9D7FA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTyWG0KHG6EQ7kNvwGcYHuC&_nc_oc=AdqaIiRoE7NIDXETVj2DS8SYFoO0wAWwQMe5363u4KhAq6MbXYRyyjvnGPPrxp9Ts9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdzBtexdUgrEiVkiGD1E-ziAyA5pF9qwLg7BpFiXrI3g&oe=6A9D756E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2LZ-U6puiAQ7kNvwEer6nW&_nc_oc=Adqx4RgJE5cPg66wPNrTiDLAIY0zteChRHzWejwDMBEkqA14gBpHnxPw7VYWn8rjC6s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOPPWzUS59WrlbEV5w8h7-v4jdpp8HVh8yRkdao27gtQ&oe=6A9D5B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tf9RDKAGvQQ7kNvwHcxJWA&_nc_oc=AdqXkabjBctEy9YSWjIKu8MR3cz89ANxXMtOUd8sJGpLJR7d0bKkCOvg6ydEdPnwCMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6WFz8aDmvIcQa3fIsCnUWDr8OfGnlnQ9k9Mm94_r03A&oe=6A9D8793"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
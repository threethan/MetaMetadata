-aMHKNQZUhz6kg80ssPLrgEi8wZo7dW7kwCfb0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QtildnJJ2SQmc4CGTEoysiBcvRdjBgZaUljFasBbGLg&oe=6A0C6F72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GJJPF8gKEUQ7kNvwERtibJ&_nc_oc=AdrcOwTijBmNnXJOdlGZx8CgHTR5bflAqBepCO5OtQdXRFJrPRx7K4jcmjNbPKiYHhw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W_XgkE7DRp_sdf3TP23dHkkbNSPImmri25T3MS9ykdA&oe=6A0C7AA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq6MzLrvscwQ7kNvwHql3lg&_nc_oc=AdqR1hgElltkHym2b02-RVGl3MROg24EJ3LXRUwJGqkmr3jWiAcpD4dgvpAyRibhSB4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TCTZSfnI8cDLb25b6A3tCeZhWCjRI0Q4eQuyVAjehtw&oe=6A0C706E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQVwp32KVxUQ7kNvwFAvVH3&_nc_oc=AdqgKyBC3ANul3Ea54Oo1HullXGAIYqea93c9GQD-GetxeT9-vAoeZ7tk46PK3j9-eU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fQ_17Q4kzYkmjVi3pWbvzeuf1undJfYQ0LAFZGH2Pww&oe=6A0C562C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn1W58TIx4IQ7kNvwGjveuF&_nc_oc=Adq8l5wx7nEMRUzeRRS3GDhjOKzBLt7_oR4PkLovmREOnlWs_G4PJ9qkiMFmDsuILfc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dn_lyjCtGHFXBEe7cVyC0r4JhErOjVr53ICxUUPsXhQ&oe=6A0C8293"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
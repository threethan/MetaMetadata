rPR1ozF_xEtImSiRGYeTs2vCs5B_iYhOIMd1OQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjxRuWV1MLFnHLyufHcisud--Wyxo0kAFmt2e4r-w-Iw&oe=6AF082F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nCJF6Tmc08Q7kNvwGSn-7b&_nc_oc=AdoXh6qwLSALgEEpj3VNkCGbEMKLZHrblOnLZmfc0yyF68HnjC-L7TptXWlprcOeoOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlfSAooHtBulEQcyuFbhQkH1YxqyWED8VcRRQH5MUbYw&oe=6AF08E21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoHWJC727aUQ7kNvwGhVbNq&_nc_oc=AdqtNoTy7Q3Xa4-zXfs475PPKw3zisWE7nhMwqW2gSwunC4W6Bu0d4lw66x_XIjUCKE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7xQPkA-gzzQkXi_Flv3d5OobSvgOqlwZz2ncN2ez8OA&oe=6AF083EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHAFSuXnfFEQ7kNvwGYY6yT&_nc_oc=AdpZ4MNR8lTq4ZgRwh3Iw4OotBhLSDk0UuScNfn6fZBeNA42GMHRMmwT5Eo1lrL5Tew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSkPk6-zH7WnmBEHCKPbrTRGU5KOMv5IEHljCLusUSXA&oe=6AF0A1EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0ZdKZ_yZRoQ7kNvwHvCIpd&_nc_oc=AdrhiyIvw238rlToogLxBErY6lpQs3_KavrmxW1xGz5Z31UfFeYXHmWr8MMDOqfUEc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnBeUwlMIAmwfhhDYkrE4jU5Mq_95msoEKLlrGAOW2SQ&oe=6AF09613"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
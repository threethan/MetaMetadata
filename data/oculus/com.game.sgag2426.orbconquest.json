3w4CWqyCgwb1KKvoAgdjQI-2lJ9lizp41b868U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCh_l1SITnr-E_-dJ6qmqExZovCO6_Jn7x78Q6VYKabQ&oe=6AC7A472"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntKX0YFndeAQ7kNvwGEPSPq&_nc_oc=Ado6XZZtwJFVYRHszzgbaTme-hviTpNWh4yirjsrcLvv1CrWA5CS6YaIehZ-JC7-kJA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJtO5BP5vRIBVbT1Bp1Mhgg7k7fch2C2CwjNCupjFWTw&oe=6AC7AFA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90E2c7BwpsEQ7kNvwHBURvm&_nc_oc=Adpi2l1orNtlrNVuBi8n3a1Di8qxVxEkBfPTq57CUMHU-UI6d_rSSNnPvCf5ldKOmtY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy3bb2DJMdk6veJ_10PgAMkTVJ_mYVoPbrTsfj8QoQ_w&oe=6AC7A56E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=092v2RwMytoQ7kNvwGwghzD&_nc_oc=AdpcSj7JC_ChOo0n1CdtpYExrmKHnyErdU5GQ_vsmU482w4y4VS7hDF3k6G6WKc3VQg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyVDmedkJXgvC-iv04RJVCMyX6s1o0tPUSy6_7zB1lvg&oe=6AC7C36C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z78qvKDdULoQ7kNvwHc1CGr&_nc_oc=AdqviiezxwhtO78p_39zFGiU8Xq8ehlxOXmIXbji-9AgccjAPbNNHBy9BzNJEwk4LSs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF-GYJlGSWNwDl7t04z-MwDgCeKStQEj8cySB1bA7YSw&oe=6AC7B793"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
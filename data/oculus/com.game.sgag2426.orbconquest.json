A6_3uHehvB20thLKxfZaFYVzQMYGD2HCxv-oDw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80aJIohraD-aeT7MfhoMDQhXzTnO9ahAt2dqkPfzsoDA&oe=6A26CD72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESj3o8c6nlEQ7kNvwHmd2NA&_nc_oc=Adq3E99-MLhwane89f2D75InPErl6P5YMagnzXR0Jxn2acSTmX2a3DHJONAq7LJnRFQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MZvwKQsBJVGhPbmPMfajvol9fYeNiTWPJwqLU-PoWOA&oe=6A26D8A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaTDQrLQE9MQ7kNvwHhHlOy&_nc_oc=AdqQzNE7CV0_PiP1oBCWFAHKhaiBP_mA2IcV2ABwBUJLu6kivUQvCg3mEDVXkvw4QL4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81rklMo7c69Y9kjVVwDwUasnHGSJmKfd6BJ1rO3UaW9A&oe=6A26CE6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJdCcJFH9RYQ7kNvwFk-dJR&_nc_oc=AdpjRlewSrE8oMQdQWJJLaR2LoTO7I_98-xvem5X6-N3qGSiAoamBzlFFxuP_-ob6b4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D7cvzWAHYUWd8Bvk5INjWNZobcOlsJ2-4r1xj9_SA3Q&oe=6A26EC6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOSd1yLyWmoQ7kNvwEDOXb4&_nc_oc=AdpDitvPVEVjaRbNfhxcwBrh14Zz9VPxWmzStPz8nVwDZ_uRlGbGvFysHhZiMabq1wA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NMYKjre6nFr3kIb-veuCLxYh-8DwxGijNXd9HRj4sAQ&oe=6A26E093"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
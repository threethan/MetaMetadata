G8OPkMRLZKLS9DhmZ1_iGfgBG1Rkjv4ADjjaVo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jW9bNXVN0xYnqllVZmiJG0ALDtXniglypgTrtxM0irw&oe=69F605F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px101BP7v3oQ7kNvwGK-P_y&_nc_oc=AdrWX7zPWA-O_RPL5PoD396tOxsLBzFdCS9RPFv9xLCnG-IDxk9ROBwhfRE5uh6wArA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qNqHy05OzX_5mDw2YNDrhq2IFZoXz-7POmcbE1bDYUg&oe=69F61121"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJoHtuvbYkoQ7kNvwHjHzE7&_nc_oc=Adp1MIckkJyv23lVYQG6ZjXsgQ4KIKe-_MievZXdmUu0fVwZrO9KMWi_69TJ29gEVxA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_iIrLY2lpti9aBr9iX4H40x1a0mXrh1tDM7lvn-044A&oe=69F606EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zr3HUUN8R6QQ7kNvwGt_c1z&_nc_oc=Adr8Rl6CdpcFq_jHXQ4sd1iM2D3_6CobcsEUclmoIGi4uQErvxgv6C186jjXPekuFrM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18n22qdHbLG4bJ8jWhsfYtEs_J3khWgUbSs2nVXLnOtw&oe=69F5ECAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLEKuPM0C3YQ7kNvwGYol1Q&_nc_oc=Adq6qt4Dc609YMBewbppttBBmXZAUbRMCc6PB4jpF-btstcPseCTaqbs7WOuGvP3oqo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XQo_trgmjPId96NPU63VH51K0b75fddGTQ9DS9hXdhg&oe=69F61913"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
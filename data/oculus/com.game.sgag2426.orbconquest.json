lSQqcY6NNu5V9nyWFbPXkoDG0jbRogehSayTpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z7dYvO6XCLHzTjAxHBgXn_6Wcjfycco8w07ijdAYzpg&oe=69EE1CF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOR6G1oAc8UQ7kNvwHnVLyf&_nc_oc=AdqotuO2W9spSTyvqtmsOw_HFyfZopv6yYZJBoVhABe5Ao7fGGCORCoxT7T-4sz_9ls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lvGJR--N9HC_UEGE54reM1NRRlGMfHNj_TqARJW0cag&oe=69EE2821"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_Pyz0oxKw4Q7kNvwFDweHh&_nc_oc=Adpxn6_iSV_gLG4JMMWeADY3dK-QJScCd60ZTldAFH2UJvFI-ardC9c0JwaPerXuVmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qgbOyT2oUNhcMsrbyMto3fvlBPOp3TLRQRi9bItVeeg&oe=69EE1DEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFAT9bpHbVIQ7kNvwGPkq6D&_nc_oc=AdpCHzGrLCouEsA5AqFBTZWdNGjqyy8c8sFRlxdp0mmvl3E7HJxd0kAlnvPaqmiASww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34CnUKMy50xy4rqVlzowb9e1M-kXXxH6xBTWACSc9zMA&oe=69EE03AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knxAxsySPzUQ7kNvwHUpTJT&_nc_oc=AdpT1aWl8oTZ63knYacVThi5_w-EXB59L4CkH9skKKuxdMbOFne3blHf7ewIUanmZ3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qng-Z0PQ-ASW2anglJ3JsafBZq7jqM5J2MEH_xqnqYg&oe=69EDF7D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
TfHOIJw4b2wgA1wn_jH3Dj4waX6LOX25xVJGEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZYWZSqETd9WJm6mfbuIIYgLu4fCvpAV-8mQ2Kgf9UkA&oe=6AE0B0F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjXNUUpnux4Q7kNvwFOe4w0&_nc_oc=AdosMfvbvJejNGQpyRqEmQZQRJKlykI8P5ZA1UWWMg9vBO-J7qD2i-Go3Enlc_WItBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP93J_goPHxpCZRBYFxTd-b3ty0xja-bQ866jUcshOAjQ&oe=6AE0BC21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KPGKsNQCREQ7kNvwElTjmC&_nc_oc=Adrso_UcRnJWHFeOWblkP94bxhbA-YVrKpw6dKU7Z7116RWcYaWcOMMnsg-ZqmM6VgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI0b7BW8siZQNRp3-ePNCST3zC7BolSiMboGD7-CzjtA&oe=6AE0B1EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yaoh0Bp4m8Q7kNvwEkNmrj&_nc_oc=AdoAwVt0RXtuYmCySOsspAWAB3mkvpfPNtAynWLSn9fZK3FAASEQ-NQChAGXHCWQ8_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4Hf8eI3bAv4D04E26nRo-VXcb12svvStQfPct8dW9hw&oe=6AE097AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuVvqrf7zacQ7kNvwFxTNeY&_nc_oc=Ado8AkBiMyCWoBFC8aOsO7hRngPGokPhlM-hCA1oQqCBQzar0SsbvOBg_f7K4BOfD3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYZ5qXEagfR9ek5VAI4kVDdV5RY66rOoYIWLtGzGPdng&oe=6AE0C413"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
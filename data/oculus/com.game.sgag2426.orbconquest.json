bIYOX4JiHkJ69KfbvPQFH4V4aeic-NFxgHyGCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tdwdl8XXOWiKjK7v2bdHb4YbL6bOqQ0B3d-Fmg-4OQw&oe=6A427CF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UeDI6qOCD8Q7kNvwGZafF-&_nc_oc=AdrrswnKKWUJYpAbZVZPPh1o4OdEeHShlZ1KlfbkAdrjmWG4FkXPyIhLQrrdsoUxaI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95WX6OtM4WNVdmWGuN7pP3rs9qfomScULedsv8w5p2Hg&oe=6A428821"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbvZ37G_dLQQ7kNvwHAZ6Lg&_nc_oc=AdqsKvqhLXRr4EPD2IpIoprK5VxTc7YHiZUax1sUhGt0NprXdeUyhRDB0EVJEQeCTMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hikYFkdJlBohS5GcA0rnt0FJG8bFCtJeKVyj4FkW0bQ&oe=6A427DEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h1j95OpCOoQ7kNvwEPqQ44&_nc_oc=AdoTZwVfj1T0_bL8yeS4JplEC9HozZei521llYLcWH2JiKUnT5dSQ0-L6wTJDhW59v8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tcXRPLZIFkdeOsnvZVy8vEM99ImDDemkTBaWJxZxlxg&oe=6A4263AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLKpvEVLyUQQ7kNvwHKlrrc&_nc_oc=AdrJmMK3Z_eMtRS5hAhT8dwh8o2AMphWqfkEk3DiZmD5QI_c0zfWhY5MBA5Hm2WCTTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f2SgdIyjiCvGk-tZjJ9t1dg3FA3as7BFxQTciizZqnA&oe=6A429013"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
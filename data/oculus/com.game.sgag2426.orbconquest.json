RNNB3qCRAlA1mJ4_IB4xwlZ_aBJbrtmWLVSbHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I3b2DO1qFYUpelNkGu-rlveU3VYANUJdFRqP34N0ywQ&oe=69D904F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUFBAfSM-wwQ7kNvwFxT3jE&_nc_oc=AdrLccd6Kvr6GB-h755ECOLCjQZaHL-uHm0tzZXQdrZElFC6B139W4lEYAJK6GmsrFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cYAQHNzgNwz16hnywjSPIFuIcs62xzbpRj7ZhMdMspQ&oe=69D91021"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa8KbNShgCIQ7kNvwEIEiwe&_nc_oc=AdrB1tJaEMlH31op5ZxqHrkhXRn11sHvKugAdJW2VQZ_GxuMIb4vGvwK9Yf4OGgx3uw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Js8IA0D3rOPHrcZqksk7CTw3ntsz-jm_5ZZOnTOsQQw&oe=69D905EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5pPKFkwLHgQ7kNvwGTGgzo&_nc_oc=AdogPw2ueJacwy80aFCiJOKQXLC7k6UwoIP_8xzCe4_9TK83iwDfbckvToO2MdvrG38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dFd9qkwjSb-ngCBUnhC_XPpNE6OYitlmglP4z7DTmAg&oe=69D8EBAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oofAxiGzhIQ7kNvwHw4UFL&_nc_oc=AdqLn5bHMON3IAf11rTfIv3oXmv0QAFSIjUtsAhST9QR_515FtgxsFKpg4PZHKqNRqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UHkH87JEPhkXWmUJMBWEfyLDH9qXInUOo1Gj6AsltZA&oe=69D8DFD3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
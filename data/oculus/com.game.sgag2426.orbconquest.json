20f&oh=00_AQF8HSIFs6L5wxV8gdwmiB1b4ou1v31PNYKTpsXlunUkPg&oe=6A8D6A32"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAO5-GVa0r0Q7kNvwEiEEX0&_nc_oc=Adp8x3ErsekVaO7A3sTD-1Cwo_Qd9Cz-soBfy-YmEkX89Pjz3M_yJJpIHjE9fJYO0N0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwUUqkWgUgrhJQj3KdPhukO4_wcNqyNxe5U16mws2STQ&oe=6A8D7561"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqYJUg5bNdUQ7kNvwGhUYof&_nc_oc=Adrj_o3DVgceGQfDVKzUIovlqQKL5i5ql5PNccbucB5r-t4ybUmUsMBGBv0YgrpkGg8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdfeQxQN0B-rvwpM9_KCx8VUaw5yaV9iAo4-a5GS22HQ&oe=6A8D6B2E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqMbXZ2Gjb4Q7kNvwGolTNR&_nc_oc=Adp_cqbrhz0T47eoCEvqf-BvckIwloee9pBYoRf9HDgBmRtO8dS2pGKBnhoVRsxBRaw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGspDUFvNFig5PT5Y5qfFv7hPl1wQ4bntOOapy5faUF9w&oe=6A8D892C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khz6wc1HT2wQ7kNvwEK-uIq&_nc_oc=AdoN7CeDR5-v54z9qFkAZT2yYAvID-hu2705_E1z8U_fyknQye8YBflU4147ajNTs3c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZo8nODJcKVvMjiSmCRmP2ejLjW-Jwu9JGH5r9YNNLTw&oe=6A8D7D53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}
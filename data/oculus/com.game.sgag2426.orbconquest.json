OPeck9kU8wGkZ7Qk287HtoodoPQgu4v5s0kdUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONVmOLFLYApok9f539WiLbDWeQS4Fn1l7e-SX73IS80g&oe=6ABFBB72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayl4bIXI1yIQ7kNvwHWiRM_&_nc_oc=Adod1caY5BN3wGoO5aPEVRGCzqxBJhVhjBNtsWdOAsq30HgyWTT6zjVr8WyG1KjrrhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa63M6bHRcj5jKq2VO-z3_wRMF1wVwwpFIxB6rKFQdhQ&oe=6ABFC6A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMsnrFfbBu0Q7kNvwHAG0Ku&_nc_oc=Adpc42BFI0lsrbOR3ag3wfCSo2agKRN59Sbhwn42KWFks5jrsxEL7TyH5ihOY_7S35g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPtDpeJlLKmTx9jz5ybKp20XVVuderuOteDvdyqJlaMg&oe=6ABFBC6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CvQOj3i3BEQ7kNvwF5vmoR&_nc_oc=AdrZJNdtbYaGK2cg1_7tCcqk-H9pu_EkHq_iCzmxz_JeAY6pTTdHhWyr7Q-itUBfoKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDSoiBePZUx5iZqZCrKaiRIoU50tv79jcn8KhxKWpOMg&oe=6ABFDA6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RCfyfR-CqoQ7kNvwEFwnc6&_nc_oc=AdpMAQ72s053N5_WnZ-XQFF7jC2yrg7j4ldHmPT75YuzfQk-L3MhzzmYFD5fDmPWUFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF5x6xO2iJfsKos11wkgXdjOytbQGkw-WDoIEVrtcDSA&oe=6ABFCE93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
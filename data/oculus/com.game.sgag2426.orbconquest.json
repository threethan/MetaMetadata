cC3CXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEzZS0NbSvWcWciAPWDuVpSM8ST_raqceqMAUrb-XPQA&oe=69AD8372"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6IAORygtwQQ7kNvwEkvMWb&_nc_oc=AdmUu1u4VKBdXMqY6TCY8vQfZJIh1xqrt40AMMgligeOkg6gS_pwr3pkIi0fidMghEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1-Amv0GwbutMmeLLKNn-C_LdNoQFl1x9KmhL9yqs2Vg&oe=69AD5661"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSvD1a8rC3UQ7kNvwHZ8PNS&_nc_oc=AdmrZf4qFg5iyuW53wcq8VEMi57TTEuNeiRi2RCdrWBtvb938aS62yZKO66u1ph-R1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtvOSjs4vUYSAVde1LOQDn6qJDuA8De1QYsLxyArOd4Q&oe=69AD846E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88pOpjIYMWwQ7kNvwH-MM64&_nc_oc=AdnxdPWGRppCPgTv9Bdb3B5E0_Turo3H_sN4tb36Up5VvosdUm9R0BIzfws4WKcNzYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHq4MY68b68v1FawUJml1LelysFjs2DNcaGLsM2b_Wyw&oe=69AD6A2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr3mDfPvszIQ7kNvwHOPL_m&_nc_oc=AdnDXNQxp596WSM2whB86zRxNM47IZfCajCWmzuHa9_TfF6uLaEvw05AA0_geTumk24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjQHSXumESXm9GDDGsH72WeaGykHA2T65Sm0dIzo4keg&oe=69AD5E53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504
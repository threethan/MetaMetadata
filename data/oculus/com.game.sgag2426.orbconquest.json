GBMVrt_qIuIb_NnOJcmWO2k3KPzhnHy1IZ_fN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlLF4BMDn65gxMyt3Iekoc167iFVlny4VXslNyoIvD2g&oe=6A60CF72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3gtaCkZl8UQ7kNvwEE_hZB&_nc_oc=Adot8JOmoJX_ykbmJIr0UbQ_c41qynXpVL8FkK7hGtAes39Sl0e4bPR1pSe--661DnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuofnvYeQW4g3BqimXB6qTJPmRwKIDGYYhcld-5qjxog&oe=6A60A261"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKdhMEwjtJIQ7kNvwHM0qXN&_nc_oc=AdryDxxoUFOGEDbqf9kCeBDVPvNqGyG1fPMlB_oCl28qWjRvLKbHg_meLxZN2jIVetk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh0xkQ0bmUp4__ennQHhZ2jvvoZKwwx7KSPLaYElXr6A&oe=6A60D06E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q55fqzzTq8Q7kNvwFq1_D7&_nc_oc=Adp_aDAAxZHc2_je2Jwb4GawJU_X8YtZXoi9qjCA956gi_mKqIeFX3umcCAl_rd9v68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2QVWAnGZDnmezy1H9Vsw0xTsjDlD-rvXSLMz_VqOEMg&oe=6A60B62C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNDsVL8c_gMQ7kNvwGVlH8l&_nc_oc=AdqAofN6DGLD2QGXcNiZCnVw4eA20G0jKiOj1UY8tGt6_hUYQtfljwfjmuwFk4Mc65w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs4VWOjfzfx_9O6YI7o843hdkS0JvG769Tk6PQbVzKCg&oe=6A60AA53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
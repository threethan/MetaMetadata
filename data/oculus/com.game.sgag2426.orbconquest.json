xbXIzP_IHQeNnTon3hmpHP-DY089xTYugQB2G4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IhHRuFnj5BHkgBJljP0ciHQhKRSqpez8hFHK_KjPTNQ&oe=69DCF972"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlIdLc7YW7EQ7kNvwF-rpeh&_nc_oc=AdrgajJMVFzAy5Va04Zg821ejn9WVik0jgq_q27QQ-aEf50_XapRMUzBddzPrRpwz0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JK_hyNHbWp3P_sEO_pMGkT7Ilh2c7ZmRYtNIbHue60w&oe=69DCCC61"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgtG91Vu9FkQ7kNvwHBRjL5&_nc_oc=Adq2tKYMMlVZRgqbaTxY6hV1oUw7eua53cJbRSdGdDiHIThH_f3xfDwzfi6vnXZ1l0Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02FPahlUZhh5WnsmSRFlSRq3lFluSNqui1IOtUrXmC1A&oe=69DCFA6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7ZcJx-QWUMQ7kNvwHTOU6T&_nc_oc=AdrN_t8qNrf6nQf1q8A_pc6D3EAZjrdZ-WD4bGKgxXQx9dxeMnnAiZR-zly7ZnOoT70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bhrFT1oV3Rw41m12ceRoXSGiI_sa9w3ZK__4aKr7bpQ&oe=69DCE02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQKwyu0F0CQQ7kNvwG_n3x_&_nc_oc=AdqPTOY5vcCrwLKGQrziTYofA9Wn1Oqrrp2fQW-OXBRD-Z1Z3qxpg4XBOuQnVnK8cts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a-NKCdt4QAwCLD2yyxleh0iOR0-CT7ITzqcDF2FGsTg&oe=69DCD453"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
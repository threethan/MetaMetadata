m5LXCkqch89Q1R3dMhLUKriZrPy_-l-J6CGdSM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11V8Kc8F4OVUZKQNn_25-IFTGV_y0V_GRyC8NraCqVAQ&oe=69D7B372"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUFBAfSM-wwQ7kNvwEEhMs5&_nc_oc=AdoTZGtRDQZjooXJKKzLVjpUkMrmCgeS3-RoRjhyulgJwbINVNJr2jGe0DrSQMJ39cU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WsZgwqSPyyo2xZgI8TsCtLQLHBKtRgfXByhht7VMTew&oe=69D7BEA1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa8KbNShgCIQ7kNvwGDxccX&_nc_oc=AdoSH64zBzC1OFGSySRv8y9BS7dWYUjEv4fDZzBpZ0hm_2NPQJ6ijIE7jR3gB_vKyOc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qX_AUmROTzNIPkBs8cx9Uqp94i4mgpWlsFYcDG3i80A&oe=69D7B46E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5pPKFkwLHgQ7kNvwHS362S&_nc_oc=Adr7SV6QMS9R5jsym_s7G0V5PomQbZ2Xvye7ZJs8XJ9uvMJJMnXFt5GToqgcRH89rWM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cx-Tg0iuWMsrCoZmM_bC9CJgW4R3jHigs1frY73MRPQ&oe=69D79A2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oofAxiGzhIQ7kNvwEtHsLQ&_nc_oc=AdprR3GD2dAmZTCbXiPg1vhaZc7oBaP-bjstDpCSyUaFW5Th7tTBLZaCr4XjuRVL7Cs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-6GbB6oXnt96yTG-9vY_f3Q1lGGrry8uihb3_T4pYBQ&oe=69D78E53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
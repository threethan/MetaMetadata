1piBKNSfhuwriF3O43ReD_DlLlFLXLUB-1tGog&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA0K-5yELVm06hH4_mh2h7D6s8RMNcA8OquRL-ZGMtPw&oe=6A807372"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhSQo8vPUIIQ7kNvwHbtoci&_nc_oc=Ado88wLfJp2jggtfQruZkMmddJXHetKJA3qunMk1aIF-f5FYhQBxmxBY7o7Vzj-yIPc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUhhb9CFTWWgXXjPd4AK-4ttAf6ABn0zijYqy9f2x-wQ&oe=6A804661"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc5Foo7GwpYQ7kNvwFA3wrH&_nc_oc=AdqcULvMssgDPpioS_JNZOpa8vmhG5Hqe4LLxKTr6AzviWlcymRGirkU9P_uAblnOPc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRK9BzWKsyXazB4EX0Dm_Lh-BiXqYW5dr6Quq4MYbDXw&oe=6A80746E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWSe2x67Jz0Q7kNvwHOHhF6&_nc_oc=Adp4IYgEu8vuol9QMb5qm0dzp7PvMnd3l7T1FdbJYwStyGT_C30a9q0-Ks6Jczt03f8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjJOM-Gm2MnrPXy8MUnrmNWCOlh3cmEOVYFuknXnSVvw&oe=6A805A2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMOfiDSyMh0Q7kNvwFdW1bJ&_nc_oc=Adq0PqazjxKJ3qxKPxFp66HFeqo2EON-Ctv9SW43qBx8jbU85RY_VoMRMQavpR3MhgM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSAGrpp_x7cIJ9Le2opQ6uoOEor7CQuIOvqYFHw5E_pg&oe=6A804E53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
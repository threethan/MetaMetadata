rrO5YG1F4Jdvv9DtV4GF6j6Gw-jCmBZRf1mvuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n_wsqee0IAjxCPJZ6tObN-AEKS7SRwqMVTNBuCnktxQ&oe=69DBA7F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlIdLc7YW7EQ7kNvwEmmSOl&_nc_oc=Adrz9R9BN5eZAPgpzeG84Y9hczyAa2ijmhBUbOGBugwFyWg5axhSFxzAwsmRRnbeGhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rbtTlNj06EMj3qWit3BY2JGwsOTHHC8nfK2wam1GHvw&oe=69DBB321"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgtG91Vu9FkQ7kNvwEHDlR2&_nc_oc=Adrxy4JnbRdKLYFEvfOAsMJrExpXONtrcg5itBMLlizbKl0JQ7MRB8_DcCIq5LOyk28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jy5BjFvsC56JMJ-65dBkfT4HD2huSWaP5BgRLWa0dgA&oe=69DBA8EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7ZcJx-QWUMQ7kNvwGX5rqN&_nc_oc=AdrSx2fkgJwHFxuiFegg1TBEwNe6cfxRwAV3-U5onCcbj05V76mdd7CrsYK1uaakTOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lsDkEFduIEGVU7Ovf2-qt8_TkmUMdDnPnTznp-cqypw&oe=69DB8EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQKwyu0F0CQQ7kNvwEDS5A4&_nc_oc=Adq412L2MVdO31liGZVDRoBAKXF0jidAZmKm6pKNviW2NEiChvE8Ks5UYXc_alz9QZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f3C10P4dtz5QiY-MRNQj_98QbHA0O7C5o23jyxRxFDA&oe=69DB82D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
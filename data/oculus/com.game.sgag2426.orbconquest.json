oJpRJ9J9Ao4MmqgmP1ZUBrJBHHYIGwZN2WD_AQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD6puULhnQZSXlKPG7pVQ2hGN6IyyrPTue5BSXZ6kg1A&oe=6AA01772"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ecVuJkq7wsQ7kNvwG8Qss5&_nc_oc=AdrCypLOjO2HDD_rPVcIoCPlnrCn2NgIjT2s3q6Vi08SRxsJJRnJbwoA9J5IMDv3078&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCyTLbOQuDvh6hI8csTqpzbZStKTSCfGaXbUeXbvmlHw&oe=6AA022A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTyWG0KHG6EQ7kNvwF1CElV&_nc_oc=AdrAIQnBKxWLkJ4bTHADOAGXZVFaz2ocvLbkdNUqm5cDWO_xNAnnK7vWqXUOF10Oelk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdAZdCr0emzG2L7tgiBzV5YyPvvS3c3x2SwXGozdAk_A&oe=6AA0186E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Fzi7_K6EoMQ7kNvwF-UgNs&_nc_oc=AdroX7qkos0u80uXJSIRFt-hw-KjhSwemDpO4jGRLRbnvBKrWRS5eDKnB8lIzIqiZv8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkmrhTrrhuHIwwChj7RU-q0ExquIMpyrcx9DjmZ4echw&oe=6A9FFE2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tf9RDKAGvQQ7kNvwGeGUTq&_nc_oc=Ados-90LocPFGdowFYFOp0_W39DR1ClVZwXMFxzAepxnFsJqzHztstQbFZ11GZd_8qI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzznTj2UHrkPUGK_hS0wluESCYaUJ4ZKZGjtOc2BxWmQ&oe=6AA02A93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
dn.com&_nc_ss=7f20f&oh=00_Af0OYs8bNoRwD5UiWvhg8n-TBOvN8nFrIdABnJKoiNeWcg&oe=69F21172"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXXWhCzUCU4Q7kNvwHzp_TO&_nc_oc=AdqFm-iKxTlFziAeupmoASS5Nqv8hOv-kqb9R0E124M6MfFdtIfoXSbWgjuRy2lCNx8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af18Kzz0L6VwxVKilIZLYjzgxCruz5VBAWTEizBGwR-xIA&oe=69F1E461"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV2s436qbawQ7kNvwEy78Em&_nc_oc=AdphWrHs4mXqd3CXByofApWRKCwyIQABEuQ2wTgk2e0R2HRqY4QDZhdAeuCajTdY5YE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2anl7HuL09WM12Uv4suoGNToKHO5kb-mKomlLUAybakg&oe=69F2126E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx899OYHtHEQ7kNvwGofizC&_nc_oc=Adrw4nbt6cQ-HE7c1830yr24TRmAY3J6CA3rE0ZqxCFvFCGIh33A0o_noG8fHYySwQM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dwxVnoS8MPMsSbbeBHgVcJumeeKa8WOMs2w9cgQQ0WQ&oe=69F1F82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcXyt7OlQ54Q7kNvwHD_-Py&_nc_oc=Adqv_AKk4ZfymSjgZPJTrzt5PKydL5zH7jThkwfOWEkWFylS_y5l3dCj5yj0o80aMEU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af36ku4ZBOp4jNFH_3DbKEukrQ7R7RnvNa-ra3f1bHE5ig&oe=69F1EC53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_typ
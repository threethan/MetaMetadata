3haC6fdlxFCeLaYoNIvuYf2PWANFK5HCbbRh_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHszNAylxJbD9-b9CidO_4eKVxzOKsvnwf11Jjmu6UVhQ&oe=6A86D2B2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXon9Q0byyoQ7kNvwGCS3GB&_nc_oc=AdpgXYeixD-136xyWhuJGRj3vNk3aC7wO0l7Fj1XXoyuc8jFfmwqSDTVXq6CxtcEAC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0RPGRczcTeShbAzTMYdVh085JD6Dg_0iIX3Dfvk60Gw&oe=6A86DDE1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhin8uQZSDQQ7kNvwFLjUPk&_nc_oc=AdpxeEGf7ayzE5hiZGut9iBnCBnG9Dx_yO432PLmBjiU3md7hsZTZyZFg_QgHJfw6jY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjxZGUd60qE2xGhSWdra1PmOk8sgiiWvVdffChBW0evA&oe=6A86D3AE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E_uoZGpixYQ7kNvwFkjCvX&_nc_oc=AdoHqUBAVR-MYlm22ibuI_O0pLxqRyolHq0OYiPilzrlD01eC_RBoJCkH2gT5Ac7Dkk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQZsUhpYjfxr3PuyA0Ej3qesGs1Z5WxmupfS4SiPjt-A&oe=6A86F1AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDx4LszdPo0Q7kNvwGTe2t0&_nc_oc=AdqATC9pOkORp7_YByaRg9dbpB3xrYC0gTC4sTp1zvcSo2E6bPE8AH7dbZFBBpfxup8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2BNnL0p47Q_GHKHxkQo_8YgzisIqArpceqXEH9tkp5w&oe=6A86E5D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
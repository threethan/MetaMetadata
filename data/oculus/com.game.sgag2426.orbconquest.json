yye7M1WgveVz4EBxcxpon--TCJzVy-7FOhwjY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII-o31a3qNmpX4Gge3HkGZtPYcBKG0eKuwx2pTcpCHBQ&oe=6AA6AEF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuvmspYdrTkQ7kNvwFeX7hp&_nc_oc=AdqUwaymyeuUOAXJusyy6Ee6mv3OymJz13_ZvL7DJZlYe7KI_wEoiYhEt400fI5UIZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlu9kngc1rbYvGI9mAk0hHHfw2ReWOA7_NdEiLIYKHnQ&oe=6AA6BA21"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOOvAtcEcjEQ7kNvwHviI3h&_nc_oc=Adp64RPBFjtcyJ4NTUwEdJvV95Ri2g0aUy8plWHo5xPrwHy1adPj1XUAQP9DX3ByDNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRU7WMWw_VU9CzgPeg1vMN5oONT1gFW5AmIs8-Qvzi3w&oe=6AA6AFEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXP7IamzgG0Q7kNvwHRG9OL&_nc_oc=AdoSCONvd1pzrMju84vkbUV_PbR_QN7PEOIyIW6Tpy9Zjv3-Eii8wREz4beoBM3p5Bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJNWamtyrreZ5pho-5GT0FSMU4F2KA-17OLDtV8NYJRg&oe=6AA695AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heo2IZZaxxMQ7kNvwHfvXuR&_nc_oc=Adr7WhMq7l-s_2MJQTouFdecLXOxsmcWXAFGgSAnZDnRDp1ACWbnH_QMKGymG5J0lJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUYcFxI8fp8LUjm2OcY7wZVEESbB8hb1NXrEz0reIexg&oe=6AA6C213"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
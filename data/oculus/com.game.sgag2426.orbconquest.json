BYbAK4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZCUGKKRLw-tJLbStIaEwRZPH57ZUdRFvDnZOfQpI6iA&oe=69BD5572"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6aKbtFFTC8Q7kNvwHTNJ3V&_nc_oc=AdkWnQ_8fnbdaC7dlgPlhbpcZxWim3oavbxcRz9MjRbppM5sjYe9dmvdpsvBxq_VXAA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi6MTHRIua8WzYn7jjZDP5_n8OCk-Km1j06KvIyULAYw&oe=69BD60A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKEmi4W5TjIQ7kNvwF2wKXJ&_nc_oc=AdkC2gCjBZFyRJ6ln82agvtlFpXE_k7wrgvUAVRjq98FzaTl_U941FR5kHoU6cb-_Fk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzx6zG0pGZ1-dPbMRMhz4DRRsrpxc-xUuEnoSCjGJAfWg&oe=69BD566E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsNUUgxMIfoQ7kNvwFzKb6z&_nc_oc=Adn8LoyNrksctuq_6V0p42iFXRXRx32u-FSsLKeC0F_432lIfLEfamZgpQy5hKgTQZ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxf5sRi4MVn3w451UAVPBFbm7ABrXSEauWIG1STEbFs1g&oe=69BD3C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOYrSAcVVVIQ7kNvwEEyrkp&_nc_oc=Admz8ZjsdCkeMgpfg3UN_IO-7nTdT1c3fBLV01tq-VNDN-yUnDiQWbeoL97SlX2wrA0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIjmN7AEI_1-bjKfMdyA7_qGcYXJ1tbLzx-sqJckRooQ&oe=69BD3053"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504
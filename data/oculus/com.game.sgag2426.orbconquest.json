nrhYw_0G3jwi_OhMQsRXujB_iAXc9ZRhIPJ0SI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3he6Q0FCyVe9nWWs0Ro9KZuT5hrpVkittQtVFqElIOyQ&oe=69EF6E72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXXWhCzUCU4Q7kNvwF_wOpH&_nc_oc=Adp6BmeN94q4Y6PumxFDtmL0su8nf9h0xOZpI3H43AJN0TetqWm7pU3mAbzbPK9YZk4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eXlEkItSwEYQ7sGfg632R5tvqe_nhSVqP1w5kx8UI8A&oe=69EF79A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV2s436qbawQ7kNvwGs9aOB&_nc_oc=AdrcI9gV6XMZaeupDGj6obSY0tw1_2gYs88epLPcRHXzPm4ZBgPgYjkb0yc249qZm88&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Sc31eFdpfNRG3kw-QojH-pTFVQ4BNhNRTb9Slno2JUQ&oe=69EF6F6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFAT9bpHbVIQ7kNvwHMnlh_&_nc_oc=AdqqUBUWzn7m1dxBy_EcoMg7sKRdWXG6Otx5rgJr2_sAk2YPbcrGZavEelnK2u9lCSs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27zUlFRwhaVnGrliIX3-VwtrcR1K3cuQBFkfR5jiXS-g&oe=69EF552C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcXyt7OlQ54Q7kNvwGe8wsK&_nc_oc=AdpIDR-SmApdZ5wcvcmou_r2sAkOzCvcRqoZOxcW9MxhmXmqdC7alWOY8GLZh6tajEw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aaf2UHEtDqZmhMVm2sMHkwNz2Yfb2730_RMsopcvE6A&oe=69EF8193"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
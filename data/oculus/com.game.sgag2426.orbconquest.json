=00_Af4WY1NRTRqPlfO-pue6K_wxfi3ybL5eX4ZxTwdbKkfnaA&oe=6A11B572"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gee3lYcTkRMQ7kNvwESQcgv&_nc_oc=Adr3j4teq2Y8PvcMADAyk5hLTRQNrP9pQChHpZWGtI18snMy8yN-zcE5JOJrn5KkFss&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69MbAvetw428CsiT74IeDjUvGRrv211pPLtRapgPv2Ng&oe=6A11C0A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rthoFlKP4I0Q7kNvwG6jXCH&_nc_oc=Adqet-OwTLa9BQKPdZ-xfzfjL4U7gXq9BTrTsGjfKd6yz972d99shcSUUln-pjWp6-g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78H50OjdJLcV9GMO73ygs6d0iJDGFk2_r_P9i-4IHfJg&oe=6A11B66E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTLqZYcTyzAQ7kNvwGPNUy5&_nc_oc=AdoUrFwoDO5vBV8nmWIl_nstWNsqgfTstYxj8YQFyQ9GKH61Ch00mFOpVtsWmZRkYNY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n-FBKUesO-1dD3QCTGQAxcK7M7jIov-8E02opkflgqw&oe=6A119C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPVDIshJ2VEQ7kNvwHj-5xH&_nc_oc=AdpajZqwg_ofLXhy2g5R7giiL6sjQ4zz7ehV0vWEK0CiqE8m32aal2QJlMMirQJ1_g4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RVAc7jyeQOXJhU18g3BAA5IMWAL6B7TXhPdajjwT22w&oe=6A11C893"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "extern
NrlUsOBSPCVXbf4VG3zyoDAkwvm0jGWxqlZdvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB98_NpNkDVIRQ8cXKjn1jf69B_-Fb2U8ioIlQwbflUOw&oe=6A661572"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geu4jI7I7oMQ7kNvwGI-al-&_nc_oc=Adrs6mhHZnI1_3oEujEtNkuXuHzXnjxvajkrQnf0BdEIth-YOpwUP6NVxAWK2h79HV8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA02AGzGzRaMvBV5mICbhgv1Jxon1Ed0kjmBlscLEW2lQ&oe=6A6620A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YodZ6w_xcmIQ7kNvwGdVuRL&_nc_oc=AdrDFyEVMbATjI2bK2zknuI-JsmgCGUmBQ0JhF44qBspXzFTXeT-AaGwSySeZYfDstE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfJtJGtNE_43HiqS3hxbM7oqukABgJ5QVaksUqVgxC1Q&oe=6A66166E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiUyNA3w_0kQ7kNvwH2UoX9&_nc_oc=Adpa2dhAoaBnkaCnefo7HI05jsYmWnwQfkXhb8jbqpK7yNGlMWEj471Fw3QK5_3A1X0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFLHe25qJPXtBNfUIKQdnaHnLLoWnVvMNBuU0_nFC6WA&oe=6A65FC2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1vWWxU4t7oQ7kNvwESBlRy&_nc_oc=AdrtQfoh7fzD4SQR3OpZSfRJ1AXknvjVquH-fvAhMHkrC4__rZAHhCWpT_-24qYtkyI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6bV4_XMcrni5b_Yzki6UU7MVfH3r4cmawwIXAKGq1_w&oe=6A662893"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
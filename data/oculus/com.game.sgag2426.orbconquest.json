RsEZ4vy9joFAaUEVcrQZvtiBvKKQ5BexshUNTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk1hEHlKAbp6fNZ8MNvC7jl_-I9jQk9GSEeinD12s3Jw&oe=6A50FD72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqzNOu8GCoAQ7kNvwEEH7ji&_nc_oc=AdrAYCCQZguOx8qiWsmY6TgjFAGQ_345FA4bnG5ITihQpNGC7_jAObyhLYCO4_xTVYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHD_xNPDUyS1bbA1wyXa4EOvp7Q8uDE-GUYrkfKARzHg&oe=6A5108A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOyJMMemcKwQ7kNvwHtX-AI&_nc_oc=AdqO2JWB-Wn3XvegJYy7gIe9YdZ3x7WZ-pntZc0jU7uZ5ojGQEctlZ1S8Qhba_nAOMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9F-S9lNoRkt4Dz9mhxUT86xrsomDE2tpmFKZ4ktCtcw&oe=6A50FE6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRapO-SLS-EQ7kNvwF4ssCL&_nc_oc=Adp-QwJP9t2FgC7h0aodBsArY7w8mJIAHJ1S68OIYX1ktZeB8zJKMX6gyc9XFRBS_KE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdQBg4KWBexN_3JNeVyLfnm857v1RNRwRwyrr_O2PoJA&oe=6A50E42C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQPl391QbdsQ7kNvwFKAtZb&_nc_oc=AdoyLkjYTuxxTRduf6DJl0sUrmc9vRNPh4xLZHsR6AwUQgXCfA3PrdS-uXNh9h_pvJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzxj_JQMoS5O9i1jCnkAOKbumxsLjFYCh3HAr88TMk2w&oe=6A511093"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
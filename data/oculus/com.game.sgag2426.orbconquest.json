kvuMfVCUcOIG3wYzR-u9b386HoU_JjXThKKMNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbdRmPkNcXUACmn14-wUFiWl2ns1CarLPLgm4T5E9mxA&oe=6AAFE972"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYT40UD76k0Q7kNvwHOq8fI&_nc_oc=AdobIFrTNa4ffVBOKRYAZBAbwT16SUoMljau2WYd1AcbNoJiTObR4yKJGVoxsaExC4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoEBqJMTVk4LDsarlQEODrux0DgI7sPTC47ip_PElQoQ&oe=6AAFF4A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XMBxbG5V1QQ7kNvwEmM5xb&_nc_oc=AdqSOS_BSD3ORdgeulvVolfnkVdqTNzmu3gUcuouB4lto_VERpo1NBUo4PqFHHCI9d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNWKyjVv6nlPFzapj8q5XjqCJj32WUJAa2JMex3Uo0wQ&oe=6AAFEA6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuYFz3xQWV8Q7kNvwFRhvf4&_nc_oc=AdrBaqtWiz3XYUQxwuhBlhMG348S32lMC-2VB5bZZfZa3PctMPLlDuG2s8M5dSQBsm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfBjMv0QPb2papiRuWvqzoQHnsuQvPy-uvLGjLGo2Fwg&oe=6AAFD02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2S6gMd0-skQ7kNvwEpAlSu&_nc_oc=Adq8rl1k-rVqJZOIAoiJOtvedO7vW1sNz4C8RsvCo1bVLF4nSaRjHp-pyIIx0e9CSwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNmISEIbFXRZR3gMiAd9MJL5o9uBweW5hXCIZ5eeWzwQ&oe=6AAFFC93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
tbnuIw5GEigWMcfwkVZi-Tq1awwWccoNvSjXik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7mNSU5XKwF6p69QXEdv1XxX6AL3gSu8_m0k0alGQweA&oe=69CE78F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obD0rjf8QU4Q7kNvwHhgDNZ&_nc_oc=AdpiFaLyNE41RudMfM3VgeChzZ5DjTuD7UYxaUNKTQsJG11AVGEKD6xu_AxSyHL84wk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRuMLG2p3lboct1rcpUvDZvyWCo0PjX0AEckgZ8XmyLg&oe=69CE8421"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JioD3uZMA5sQ7kNvwGKqBTz&_nc_oc=Adqi8H65nBKcm2YTpvUy1Psd3d3_VzDy4rs0FQ3l4kP9cUYqTzp2sIyMhYdtEFXkOjI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzjV355yZwTMIijTxwPZMHBgoyiIrNQCh0SZpabN9mfw&oe=69CE79EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OugRh-UEEiMQ7kNvwHLaDWp&_nc_oc=AdqyjS9ukm_gWH72kB06I29oR1zmCzVKBWM-LuXlY15-welSrbeEMOobNUlUh4mKVM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKKSrgtnG1xFEI_1PeNjEQUu_Q0zXjP5Q4xp30OvBmRA&oe=69CE5FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLZJPEAF5FoQ7kNvwEAMzCH&_nc_oc=Adqt1iDxBe0t3aRQgNMAX9iIj8Ypplur0-sQUl6683t5PkV8sFbb3FZ66702-TeluoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5y1O3JSRDiyicNlxCADFONKEnY0MkASvLUI7p6jQhZg&oe=69CE53D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
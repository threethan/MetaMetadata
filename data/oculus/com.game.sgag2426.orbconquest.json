HG7B_nVcmKvhmGe-isjvo3qVZi97z5NUgDXI70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4GeaPUcvNjikcdSTsHMUollJyT6CHirStrkU1qzBk0g&oe=6A43CE72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UeDI6qOCD8Q7kNvwFEz_Zk&_nc_oc=Adq3inV_BoWBYKg-vXMPM9mdy0cOacClT4K9pHcexDiDW1lirqH8Dknb_UN26dzJRTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8duOkYfhKf0TuSHTdjd_p8WhsFn3Fnnoh_8_2xFCDIHQ&oe=6A43D9A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbvZ37G_dLQQ7kNvwELw-rE&_nc_oc=Ado2Vfd29h0JV1akn3ELVibRaYCtWddz41Q3Csa2GvV368yb681WS_iez8ua9mknvt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--OZGH0ItsS2EYfp-45cxvwi31Sea-Dh81CMvagAnPPQ&oe=6A43CF6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h1j95OpCOoQ7kNvwE5xuhV&_nc_oc=Adp14y63qkHISgv2o-X_SSribM4YNX7E4nxqZbXgV8X5YwlOhgvFH0uzNCYwEtSwj10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZIFIKJrknR9wqO6xBOM5i6C_nxNtPkN51KOtixNHsIA&oe=6A43B52C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLKpvEVLyUQQ7kNvwFd38Ac&_nc_oc=AdrB9Z2kkvRrD-SpsC15KZj5ieS9Yo2xk3HOH7KBpUg_bTtKLj1DCvTA0yTmWnPncbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vPOIN4v-ysTf3CCayAwnGDGycNkw0w9D0S46Aqe0DHA&oe=6A43E193"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
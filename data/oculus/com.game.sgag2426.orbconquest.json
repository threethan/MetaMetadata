DT7kgIIn1mGVUJkDrseoMTv1QA6AbtJBHyZdpg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi76OwIeAuVKqmVgYwqQu5p_uxnw1jpsv9veNU9ahnYw&oe=6AF9BD72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJUmAfjbJtUQ7kNvwGzZWnd&_nc_oc=Adqy3x3NiP5eMnZO9v8nE23gK8e760csnxK_QjMpE3OWAUR0Fw4b78RSA1a8EfF_ccg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBGtBw4wvIg6qxp079YLCtUhSxRIpg-w5gKAOtgj2D3w&oe=6AF9C8A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od_WTlARO30Q7kNvwGsb52M&_nc_oc=Adp87XP-7sc2TspJvx2_XsvqnXlcW4jOUJp5vh_c6gaYc3RoQoJUZD472HeMGGdB6A8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcA7igBRR2dISyKAlgu5FPEU_6nbZbuIkDoeGGFkd4NA&oe=6AF9BE6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--44FLLB_ecQ7kNvwH5rguC&_nc_oc=AdqQNsDc4FdV5nqfbHW4L0DIjDAuZKD9f06V_Mhfw9v9xZPIRUbdmWo18FgvEElExs0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWoYN_NNzQFZtdyivDPmIXO57lTmup-Kxqr3-09Zpx0Q&oe=6AF9DC6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXgxt-feQXcQ7kNvwEJ100z&_nc_oc=Ado16B-8Fo0oNMS0RG_0HwckJNjyIL4NG7bi_CIvoAx4nIpZ0zlRyGVAk4GZyp4dzeo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ-Fyo94Dvqe_Wb5yhKYIWfU8b8XdqeE3oSr-Z1yNIig&oe=6AF9D093"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
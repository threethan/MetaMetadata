2CuGfK_cfRVQUC8yUZ4drV0VGQ8w9TwRw&oe=699F02F2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MHq8wef3_sQ7kNvwEfLWXj&_nc_oc=AdnzDoKyiUd2jP1-csu-WK5FPa1ECK0l-qvUwma7Wic3pdKBzJYd-shUqcPBIitGN1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsOhcMjthB1oZqbVgVRorSxzVKDxqzboCC_YNM9-Dxp7g&oe=699ED5E1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VSlWC79ankQ7kNvwEMsEbW&_nc_oc=AdlyFBnSy31QzElBfsbtlFGfSt2JBufuW8KrUup9txv5Dg6cVGHNMBqX3ZTsvf2lPrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvyVLQ_0LeFRcgFRn8cwhNoVNXBUWE5mp18Xob4kkKHUQ&oe=699F03EE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WJelHWkkN4Q7kNvwEUznQb&_nc_oc=Admx15Y5Ef-PmxHnaVgljtL_HGrNnBrx5I26aP0D8UnxKbwdg7DQ5kxyNYabqRW1Jqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afts349d4bUOwnMU4BA6LwM-gtfriyw-TJPzA_A_TzdpiA&oe=699EE9AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wz72YWjfp8Q7kNvwFuj3Ej&_nc_oc=Admtw899_17-2b5NbjJUtI01hQE3OPTj0H0Xgr064v2j6ZcHtqAPluYh7g6gzgbhzi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu9-sFQOMpyR-yGD-WF-10H6GeW30NPf3dzANn2m4pCHA&oe=699EDDD3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_
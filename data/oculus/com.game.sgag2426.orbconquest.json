wMu23vWAquRziCPzM3VEc1QB3bCjQIqTHEGIis&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyHKWuzPGx32yWYvgZC5UD4ywYgETNc552prw7jt6rWw&oe=69C7E172"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBadjKifcV4Q7kNvwE6UniD&_nc_oc=AdpK94Kzgf9FbfL1eSb9Rva7CpO3HllvupNBAkTuMt0_g_yPRZh2rM0Jw-OBC6joGgE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi9-LjKRb6FrDP02_DKg9JHkO1gwJZtiD_7iY_ILe6vQ&oe=69C7B461"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKPeTlkDcGoQ7kNvwFH0CZk&_nc_oc=AdoNIv2-KVqH18Ijm6RUnXymlcf1jouDm7nykm5NMQGJviEf0UagvjXb_qxpVWKGQXk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKRkhFFMpVgvIxxGjLRZBVnXboHzLXGhk9L8GrjB_7bw&oe=69C7E26E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8hKCFzT3nsQ7kNvwE72f7k&_nc_oc=AdpjYh9OTJtFN0395S3eg2GGXFtHfzfpzfOtB2pWxNHPOpArsf0C5WUMwW3llm-yvDM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzW5qxVUnS0B8SHsSljHCxGOcxd-16gpZnDJ0XJjYsYtQ&oe=69C7C82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8HdyoCDKxgQ7kNvwGALbGC&_nc_oc=AdpRg4hnXHICfcWFG_foPRo97YMNVD8_KjNT88Adg0qevmMvqCgSaFeoGSR2LrGY0sw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSIoOmgktlEievPA2rzcyqLZOYVor1nE09vG5Ztgj83A&oe=69C7BC53"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
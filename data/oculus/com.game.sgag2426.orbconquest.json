6IBxdWTQc79NHcYeaNIY4oKzXaJfjxWwuMoldw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tkf2YimJxjB1ZnmXGzuTYoBD4ddjnmzdkGjlykgR5bQ&oe=6A16FB72"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYnH5YFaoroQ7kNvwGOhhwe&_nc_oc=Adpqm1s_CU-TH-yYKboKwq2a4FUQ8fMUPN4MvhHUzwdU1aGUktSODzr1QdIs8vEM668&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vr7GA_B5lIGlZa9qp7CH2ThY0AfQ97mbPdHV2Exr2yQ&oe=6A1706A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kXL0aGT3z8Q7kNvwE1yyQd&_nc_oc=Adqw-1zRSYXgzKQDQP6FjU-yMz_m6WLlgRqACkGerbFstkc0_1B4HvR4q_C7NouG45k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79rTirYxl5io2fsFK2_R_xoaSWWF8BPQZ0bvHAJtM60w&oe=6A16FC6E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIVxvPjmjtgQ7kNvwF2o1yM&_nc_oc=AdoBpb-uMP6Dsk0ycOnUvNapCuOCyzU-KMR--J30_GNqq7lEZHc7ZRVcjjgieJO2DlE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LDW9xIeb41D_VAHY2-zkcg67d7LDG6c4nJWOoUCYddQ&oe=6A16E22C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47AXDdjOXd0Q7kNvwGPM2bN&_nc_oc=AdqMrJgwzgyc9rV6aB9_NGnmm0f9Xdykv34IPjt3viDqviGe4aGd1JEupKH947CCbBE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oec_FIMAyjaNf5cEM3h5tn9euPXxwtdNfqBruKrMqPw&oe=6A170E93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
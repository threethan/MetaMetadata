ZmGn5EHXGBSaRB_C0FE4BYWWDBUCzfu3iK6Ezg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF89xr2ckjiBPL5o5KcRXZURh_2DY7LLdaOjI1HkOrGA&oe=6AF47772"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d8i-AjcPEUQ7kNvwGhZf-F&_nc_oc=AdrXALg6D8ue0GSLKnZm2q6aHc2UpgW6AQRFDIdEBzttQjKYdWQGo5xvfw8bzo5t8WE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Rw-N8JR2jNs8GbFVhZv_kLsGACAQNJDtkEolDj1mxQ&oe=6AF482A1"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd8eLRLwYLsQ7kNvwHS4rdm&_nc_oc=AdrU5OZ7HWIiL2FxEjhTy-EBMtrSv4QKoUkKrAY3RaV96iCNDzRjlYRRBqpc9UdZ89c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhkLQX6wDEyuBUABnKe0b3ghW74Z7OVETsFMe82EExKg&oe=6AF4786E"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S5JE3_MWQwQ7kNvwGaXaef&_nc_oc=AdowqqhmDFbSoQTRdrnNLxoIxxDV1gXwNRi99q9i44v9wbCGr3fz3RfFldjJcEa7eBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB16kWNAwaEU9W3PSKin_gFe0PjsXeyp46Tv58wbvR2A&oe=6AF4966C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pFjY5udpGQQ7kNvwFSTvPS&_nc_oc=AdrdF59a2hLM8V0Oz0pKZ0V7ihHxblDQ3qez6-EYxNwdRqbOo1Bjsb0eVRKSOiQa8nY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlkhQsTkakr4aGkhxO4A9VG7S_GDSrlUTvwWM3ZiG7TQ&oe=6AF48A93"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
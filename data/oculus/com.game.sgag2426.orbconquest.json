7MwVVpAVGqHd7Tg8ctcwWtYwPoZj7mFBQXFp3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReJB5BTlLhyks6slYzK_93kY1OJSUSs3cTWOqMqgp9MQ&oe=6AEB3CF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xafJ0mXHhQQ7kNvwH7wGhU&_nc_oc=AdoECav_4ZjfWC9HGnib2SF9eO5q-qyd-90OcKHqDCnCLvXFz8r6XBaEqEvCnfUFkms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyvF5pzXfkCRsYxkgTjzoxjFvxcZER5DT9AOjgpRuv6w&oe=6AEB4821"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ex5yrbGyPoQ7kNvwGKW1MJ&_nc_oc=Adpui-DMsFTwBy3_gqbZGIaeaTp8_lijTyRtPXoieqgnnuZEcA1Tz0Qtp3TDML_s0vM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRORb6jRHg2MCjuX7Sm_PCe2VvJpn8xE-esKbvJQhqQtA&oe=6AEB3DEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ8fBWbe-FsQ7kNvwH5ZfEa&_nc_oc=AdoUmB41EocEis9SVJWmULKkDZQpTZ42B8CI-nSKGOaR-eHaNpKn76LeFeeDszP1wx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYv9xwpwVuhUPA1wmyb2mRUVZEVzz3qrtNRLzC-Pod_Q&oe=6AEB5BEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QBGMYZohTcQ7kNvwGRamfN&_nc_oc=AdpTa09mJCL6bobNqTX7ewLdj-xnH-9JD65iv2PQhBOi4OKT2MU-zkF9nAnaqmYdBcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb0c0UplMVky4cLmuDOy5rnvJSxucC-HwEGfAz_hKxBQ&oe=6AEB5013"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
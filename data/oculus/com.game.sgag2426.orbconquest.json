PwbjN4Bu7hgx-Tjn6GTMUIAgHubazvwjQQPw80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM8ohbeqbUqyxiHN1SRdsE2mkeD3QcHi4D8bfPhHyeuA&oe=6A5F7DF2"}, {"file_name": "ss2.png", "id": "296114026862324", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_296114030195657_275861733805151497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3gtaCkZl8UQ7kNvwGvOLVI&_nc_oc=AdpoIwXvSAW_3-UDcrL740zml1zVlGqQ1KfhQoV6Swk6-ZVMwsci6mcrEflLoc8F21s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaUEJPeevXf_JIN2DMufLUM-UOM2Cq79_tO6dDmj2eFA&oe=6A5F8921"}, {"file_name": "ss4.png", "id": "802537541948419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_802537548615085_7583608226087987807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKdhMEwjtJIQ7kNvwF54NQe&_nc_oc=AdotueuvDtMF6M1NNDfoHMC6H6-hrhIKwZTnpkiw9x5-tnpsFKVMEsODzmdIKtTTkj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANbGtqeqhx77B-ZqTZqi0-fBK-WjCo0AlcCiHbZWl2rg&oe=6A5F7EEE"}, {"file_name": "ss3.png", "id": "1952004381931095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75298472_1952004385264428_8213665801664121384_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ0yaEiKLrMQ7kNvwHFhRbR&_nc_oc=AdovSVkwR2gTpksSoVgVU3EY3jIlcUSiyOXoU-PWiDBSyR1Z0MGOYelMmeq2qIe7Lj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3cQK6L6KPRzge3iTodb68qM1gvXmLtfjBA4xAQ74Q3w&oe=6A5F64AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7841830009239208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035410_7841830012572541_6800934679758716826_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNDsVL8c_gMQ7kNvwE72BN5&_nc_oc=AdqrodHsL8kMYwNbajTxd99NbB6UzTGUcyB6euhqomjdjJJPrEe701gB6m9mKT3YEIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjkgWcvhCYIqS2BmRA3wbEBfulEe1sNJCIIT9dMgXp9g&oe=6A5F58D3"}, "display_name": "Orb Conquest", "keywords": [], "long_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges.\nGameplay Overview\n\nIn \"Orb Conquest,\" players are transported to a visually stunning, high-tech environment filled with neon-lit paths and mesmerizing graphics. The game mechanics are designed to test and enhance your coordination and problem-solving skills. Each level presents a unique maze-like track, teeming with hurdles that require quick thinking and precise movements to overcome.\nKey Features\n\n    Dynamic Spheres: Master the control of highly responsive spheres, each with unique attributes and abilities that you can unlock and upgrade as you progress.\n\n    Intricate Tracks: Navigate through a variety of complex and beautifully designed tracks. Each track offers different challenges, from narrow passages to moving barriers and beyond.", "short_description": "Orb Conquest: The Ultimate VR Experience\n\nDive into the exhilarating world of \"Orb Conquest,\" a cutting-edge VR game that challenges your precision, reflexes, and strategic thinking. Set in a futuristic realm where you control dynamic spheres, your mission is to navigate these spheres through intricate tracks and lines, overcoming a series of increasingly complex obstacles and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbconquest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SGag2426 Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/orbconquest", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
me": "capture 1.png", "id": "783698660711990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_783698664045323_5210865340295355557_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx7F9bgndecQ7kNvwELCwwo&_nc_oc=AdqRPmJAE0xO-2d7adoBXUmlmp86zhlz_rdDKrHMbnYBbqqP0F1fQWgCPgveSdeCFtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2T2rrfsSxwQ8VDW0CB0BySrLMjb40W7PSyVLAgUmm1g&oe=6AFDCA73"}, {"file_name": "capture 5.png", "id": "4158663734376507", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819464_4158663737709840_5173086170138774773_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aN9CDES18EQ7kNvwHBKDoT&_nc_oc=Adp0FJoe-sijb3SHwSPjlyhsBXCcGZfsSmIUUbhHgp9WOxKpWJDCF6ahP04Z8nLIJjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtmUryy_v5uwQaFFmmxEW_BbyuWFVKYTLdpoMBjmym6g&oe=6AFDC392"}, {"file_name": "capture combat_1.10.1.png", "id": "780930228047748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827096_780930231381081_2881658998307427268_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1Gloq8x9nIQ7kNvwHi9elV&_nc_oc=Adp2uMNPDGAgYURU9W8t1XK3cW4KKfnlPZ5gGeTDt4jmG0ZeCGIxWtcNaJQMdadejHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMF5nKzcQkO9KnbEzdBq2R4sVa4EbrME0Xrfy1ZXp2Qw&oe=6AFDADF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CM StoRE - couverture paysage.png", "id": "810281675275931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827038_810281678609264_4909290266648874459_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEoMAkKO4oYQ7kNvwGppu_-&_nc_oc=AdqL0JGPVdu2NnlkKQaIHtou-q5WRpK2NKvbkQotcElDI9YUevdReYl4PHgxIE4pk4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpaEX9YYYrlccD3jtPKCaQen5Vil9JFviWElUUfEAdng&oe=6AFDE2A5"}, "display_name": "Cr\u00eape Master! Alpha", "keywords": ["combat", "magic", "crepe", "spell", "action"], "long_description": "# Cr\u00eape Master! Alpha is a fun solo adventure in magical girl style! Become a Cr\u00eape Goddess and protect earth against an alien army!\n\n# Features: \n\n1. BONK WITH YOUR MAGICAL PAN: Mix heavy and light hits, aim for weak spots, and take back the stolen ingredients! \n{1331214528437222}\n\n2. CRAFT SPELLS WITH INGREDIENTS: To cast spells you have to craft them prior. Enter a Crepo-Trance, grab the right ingredients, and mix up cr\u00eapes at a lightning speed. Unleash them later in battle with a pose!\n{793123986817059}\n\n3. MAGICAL GIRL POSE: Pose like a true Magical Girl to summon your freshly cooked cr\u00eapes and cast powerful spells. Just move your arms and fire them off!\n{1132416108744724}\n\n# YOUR STORY: YOU ARE A CR\u00caPE GODDESS HANA\u2026.\n\nIn the far reaches of space, a tyrant has sworn to destroy the Cr\u00eape, the universal symbol of joy and community. \n\nOn Earth, an ordinary student finds a ruby-studded pan and, by cooking the best cr\u00eape in the universe, awakens the powers of the Cr\u00eape Goddess!\n\nShe then learns a shocking secret: our planet is actually a cr\u00eape\u2026 and therefore flat. If the Cr\u00eape is destroyed, the world will fall with it....\n\n-> If you like the concept and want to support development (or just share cr\u00eape memes), join our Discord community and give us your feedback! \nhttps://discord.gg/t4JbDdpGQU\n", "short_description": "Cr\u00eape Master! is a fast and crazy combat game where you fight like a magical girl. Become the Cr\u00eape Goddess, smash aliens with your magical pan and cast cr\u00eape-powered spells by striking real magical girl poses with your arms.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hallucinations-studio.com/cm_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Hallucinations Studio", "support_website_url": null, "website_url": "https://www.hallucinations-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24495419053462914"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1481664136363980"}]}, "baseline_offer": {"id": "1481664136363980"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761558480, "status": "PUBLISHED", "id": "1481664136363980"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25362324266772384", "version": "0.9.25.3735"}, "id": "2023729341474970", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8522131494551592", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25362324266772384"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772804377, "id": "25882754384729367", "version": "0.10.79.4463", "version_code": 799, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25882751411396331"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBi
ueRqkd8A-f9gHy1w&oe=6A7DAEB6"}, {"file_name": "capture final.png", "id": "913405551109535", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824307_913405554442868_4620760491231566657_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17KPCI9woaYQ7kNvwG4g1sV&_nc_oc=AdqAC-Syqf0KVCvQbrZiLfyzBa7Ot0ikE4uvOIstUiUEgr_QGdCUyhD0_MPJQIf4F1U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsLPZLB8vdkSrHfuLcL-hClvfpNO0-3ND3EyCDnMbdLA&oe=6A7DADEC"}, {"file_name": "capture 1.png", "id": "783698660711990", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499310651_783698664045323_5210865340295355557_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQnufgC64CgQ7kNvwHmjhXX&_nc_oc=Adop3kmpSmFFhdH-7e4jALPrKt_n9uuQhhMf1A-5PgH_orrAa9npQ8N_q2Gcsfys_GQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA6MjVHl_rciOc7TAai1ZcrQg6fVbQshMXpQZpEwUWww&oe=6A7DB0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CM StoRE - couverture paysage.png", "id": "1415640733376481", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822863_1415640736709814_2754899795012134397_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBH_XYCx_sgQ7kNvwEFtoDc&_nc_oc=AdpVUwYUxPL3Eu5iUdVZ00YqONFufEW4O7-sH8UNKs4nsvp0w9VIFkB9lqRQutXjqV8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkFOsZOL615eQHBVsj-CQUECbrE2L1LLBvbQSmcl2WJQ&oe=6A7DAEFC"}, "display_name": "Cr\u00eape Master! Alpha", "keywords": ["combat", "magic", "crepe", "spell", "action"], "long_description": "# Cr\u00eape Master! Alpha is a fun solo adventure in magical girl style! Become a Cr\u00eape Goddess and protect earth against an alien army!\n\n# Features: \n\n1. BONK WITH YOUR MAGICAL PAN: Mix heavy and light hits,break guards, and take back the stolen ingredients! \n{1401849871406732}\n\n2. CRAFT SPELLS WITH INGREDIENTS: To cast spells you have to craft them prior. Enter a Crepo-Trance, grab the right ingredients, and mix up cr\u00eapes at a lightning speed. Unleash them later in battle with a pose!\n{793123986817059}\n\n3. MAGICAL GIRL POSE: Pose like a true Magical Girl to summon your freshly cooked cr\u00eapes and cast powerful spells. Just move your arms and fire them off!\n{894263426315476}\n\n# YOUR STORY: YOU ARE A CR\u00caPE GODDESS HANA\u2026.\n\nIn the far reaches of space, a tyrant has sworn to destroy the Cr\u00eape, the universal symbol of joy and community. \n\nOn Earth, an ordinary student finds a ruby-studded pan and, by cooking the best cr\u00eape in the universe, awakens the powers of the Cr\u00eape Goddess!\n\nShe then learns a shocking secret: our planet is actually a cr\u00eape\u2026 and therefore flat. If the Cr\u00eape is destroyed, the world will fall with it....\n\n-> If you like the concept and want to support development (or just share cr\u00eape memes), join our Discord community and give us your feedback! \nhttps://discord.com/invite/8qcQHspEAr\n\n\n", "short_description": "Cr\u00eape Master! is a fast and crazy combat game where you fight like a magical girl. Become the Cr\u00eape Goddess, smash aliens with your magical pan and cast cr\u00eape-powered spells by striking real magical girl poses with your arms.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hallucinations-studio.com/cm_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Hallucinations Studio", "support_website_url": null, "website_url": "https://www.hallucinations-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
64.5771-25/491819464_4158663737709840_5173086170138774773_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f08Xigx9iIQQ7kNvwE4mt_v&_nc_oc=Adr_AZWJuqRuBEjINwG_5UH6ul6NTVDsjuNGcftuD8ooB3N8iaSV6dgfjQUPsHSj-qA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3FZ1zy9AzwVK6M92riqWnfyNWotde195Py8LjKFEXHQ&oe=6A7DA9D2"}, {"file_name": "capture combat_1.10.1.png", "id": "780930228047748", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827096_780930231381081_2881658998307427268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZLgMlQloxEQ7kNvwGdd5Ry&_nc_oc=Adpd50MoNdQsB0t3O5PPudhGgmHzGeU3D58N7nV5m2H4DWy0LR0WNK0x2lk27Yx3tmw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGilfMJXVXbfTw4kbAFJXG6-woryOmxhXj4VurkETefEA&oe=6A7DCC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CM StoRE - couverture paysage.png", "id": "810281675275931", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827038_810281678609264_4909290266648874459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rNEQy5YBqsQ7kNvwFPOHfS&_nc_oc=Adq6BxyeRYjnB2x1Kjq9jTV60Hp_WLLWBf3oM3nAoLUc51GYD8ghfJUfc-K8pD1FPhA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzU3bEM7Q7M2RaTbq56pjxnd0BtT5I8gDDsJ_7xCcg9g&oe=6A7DC8E5"}, "display_name": "Cr\u00eape Master! Alpha", "keywords": ["combat", "magic", "crepe", "spell", "action"], "long_description": "# Cr\u00eape Master! Alpha is a fun solo adventure in magical girl style! Become a Cr\u00eape Goddess and protect earth against an alien army!\n\n# Features: \n\n1. BONK WITH YOUR MAGICAL PAN: Mix heavy and light hits, aim for weak spots, and take back the stolen ingredients! \n{1331214528437222}\n\n2. CRAFT SPELLS WITH INGREDIENTS: To cast spells you have to craft them prior. Enter a Crepo-Trance, grab the right ingredients, and mix up cr\u00eapes at a lightning speed. Unleash them later in battle with a pose!\n{793123986817059}\n\n3. MAGICAL GIRL POSE: Pose like a true Magical Girl to summon your freshly cooked cr\u00eapes and cast powerful spells. Just move your arms and fire them off!\n{1132416108744724}\n\n# YOUR STORY: YOU ARE A CR\u00caPE GODDESS HANA\u2026.\n\nIn the far reaches of space, a tyrant has sworn to destroy the Cr\u00eape, the universal symbol of joy and community. \n\nOn Earth, an ordinary student finds a ruby-studded pan and, by cooking the best cr\u00eape in the universe, awakens the powers of the Cr\u00eape Goddess!\n\nShe then learns a shocking secret: our planet is actually a cr\u00eape\u2026 and therefore flat. If the Cr\u00eape is destroyed, the world will fall with it....\n\n-> If you like the concept and want to support development (or just share cr\u00eape memes), join our Discord community and give us your feedback! \nhttps://discord.gg/t4JbDdpGQU\n", "short_description": "Cr\u00eape Master! is a fast and crazy combat game where you fight like a magical girl. Become the Cr\u00eape Goddess, smash aliens with your magical pan and cast cr\u00eape-powered spells by striking real magical girl poses with your arms.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hallucinations-studio.com/cm_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Hallucinations Studio", "support_website_url": null, "website_url": "https://www.hallucinations-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", 
oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrxd0nF31pU3hOL7e3mFxAXn1bNYPJtUSJXsku9A8j7w&oe=6A7DC30C"}, {"file_name": "IMG_9072.png", "id": "1390345992543962", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499298502_1390345995877295_5591771451457387739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANos_C1VaNcQ7kNvwEh5bzz&_nc_oc=Adr5W4Hi830idB4U2B5Im8ja3QKZP_ubSlY7_V-hGSta_UZbPTvD_XHCNGW8l4c03No&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAIf35IWO4CiUTym2lzx5R8FPiTr-tKmFgm3VxWIZL1g&oe=6A7DCB64"}, {"file_name": "IMG_9074.png", "id": "880929834654733", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499311537_880929837988066_3272023324369853377_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVNbOyMl5nYQ7kNvwF22dKv&_nc_oc=AdoQcp3-bvnbR9_K_RCmSdAerXMRg5ej_UgTZ9JkS1sY3zLeK4AImDwmoLPBpLfomqI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvRVSNfnsaHA4P-UYW0jQklS4od4jpolyzdZOA1hqu_A&oe=6A7DB380"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonder. VR \u00a9", "keywords": ["backrooms", "scary", "vr", "horror", "Liminal"], "long_description": "\ud835\udc0d\ud835\udc0e\ud835\udc13\ud835\udc04: \ud835\udc16\ud835\udc04 \ud835\udc00\ud835\udc11\ud835\udc04 \ud835\udc08\ud835\udc0d \ud835\udc02\ud835\udc14\ud835\udc11\ud835\udc11\ud835\udc04\ud835\udc0d\ud835\udc13\ud835\udc0b\ud835\udc18 \ud835\udc08\ud835\udc0d \ud835\udc04\ud835\udc00\ud835\udc11\ud835\udc0b\ud835\udc18 \ud835\udc00\ud835\udc02\ud835\udc02\ud835\udc04\ud835\udc12\ud835\udc12 \ud835\udc13\ud835\udc0e \ud835\udc04\ud835\udc17\ud835\udc0f\ud835\udc04\ud835\udc02\ud835\udc13 \ud835\udc01\ud835\udc14\ud835\udc06\ud835\udc12!\n\nWonder. VR \u00a9 \n\nA Liminal Horror Exploration Game\n\nYou\u2019ve slipped through reality.\nIn Wonder, you awaken in a place that shouldn\u2019t exist\u2014endless fluorescent corridors, damp carpet beneath your feet, and the distant hum of flickering lights. There are no windows, no clear exits\u2014only shifting rooms, forgotten spaces, and the gnawing feeling that something is watching.\n\nExplore the ever-changing levels of Wonder, a surreal world of liminal spaces inspired by backrooms legends and uncanny dreams. Each room feels familiar, yet disturbingly wrong. Uncover cryptic clues, piece together the origins of this place, and survive whatever lurks beyond the walls.\n\nFeatures:\n\nProcedurally Shifting Worlds: No two playthroughs are the same. Rooms evolve, hallways rotate, and new levels appear without warning.\n\nAtmospheric Horror: Jumpscares\u2014just pure unease. The terror comes from the silence, the spaces, and what your mind fills in.\n\nEscape\u2026 If You Can: Solve puzzles, decode hidden messages, and try to find a way out. But the deeper you go, the stranger it gets.\n\nEntities & Echoes: Some things wander these halls. Some remember you.\n\n\ud835\udc02\ud835\udc21\ud835\udc2b\ud835\udc28\ud835\udc27\ud835\udc22\ud835\udc1c\ud835\udc25\ud835\udc1e \ud835\udc12\ud835\udc2d\ud835\udc2e\ud835\udc1d\ud835\udc22\ud835\udc28\ud835\udc2c \ud835\udc0b\ud835\udc0b\ud835\udc02 \ud835\udfd0\ud835\udfce\ud835\udfd0\ud835\udfd4 \ud835\udc00\ud835\udc25\ud835\udc25 \ud835\udc11\ud835\udc22\ud835\udc20\ud835\udc21\ud835\udc2d\ud835\udc2c \ud835\udc11\ud835\udc1e\ud835\udc2c\ud835\udc1e\ud835\udc2b\ud835\udc2f\ud835\udc1e\ud835\udc1d\n", "short_description": "\ud835\udc0d\ud835\udc0e\ud835\udc13\ud835\udc04: \ud835\udc16\ud835\udc04 \ud835\udc00\ud835\udc11\ud835\udc04 \ud835\udc08\ud835\udc0d \ud835\udc02\ud835\udc14\ud835\udc11\ud835\udc11\ud835\udc04\ud835\udc0d\ud835\udc13\ud835\udc0b\ud835\udc18 \ud835\udc08\ud835\udc0d \ud835\udc04\ud835\udc00\ud835\udc11\ud835\udc0b\ud835\udc18 \ud835\udc00\ud835\udc02\ud835\udc02\ud835\udc04\ud835\udc12\ud835\udc12 \ud835\udc13\ud835\udc0e \ud835\udc04\ud835\udc17\ud835\udc0f\ud835\udc04\ud835\udc02\ud835\udc13 \ud835\udc01\ud835\udc14\ud835\udc06\ud835\udc12!\nYou\u2019ve slipped through reality.\nIn Wonder, you awaken in a place that shouldn\u2019t exist\u2014endless fluorescent corridors, damp carpet beneath your feet, and the distant hum of flickering lights. There are no windows, no clear exits\u2014only shifting rooms, forgotten spaces, and the gnawing feeling that something is watching."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wondervr.org/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mortis & Tapor", "support_website_url": null, "website_url": "https://wondervr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26407943212235592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293803_1506895777448804_9025593847555310060_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UID8dOlOApIQ7kNvwGKrUy6&_nc_oc=Adrv-M0Ptc7D4jFXVoOzXfdn7tj6miI0AhECD7JKCu9KcZ7sZ_13YdubFxnXmBddHe4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYVVyPD_EcpzlRpuEX3Hs8FoUlVe9EeF3JIJY17XM7bA&oe=6A7DB653"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wonder. VR \u00a9", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "
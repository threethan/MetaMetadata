cdn.com&_nc_ss=7f20f&oh=00_AQFTS2-fW26qoNM5tS2oaP-qeyDrLguF2la9d0Iwu4TzGA&oe=6A89A08C"}, {"file_name": "IMG_9072.png", "id": "1390345992543962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1390345995877295_5591771451457387739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5ueiwL_6xAQ7kNvwEwkiXb&_nc_oc=AdqcWq1rGKCKdnngP590ZBG8XLASKGw78VXH3SHCLnqyshs_7be_wQApjBAYnuWW1QY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1Y8keT02lfehDfWapDEcAXE05ycNRukuYSerBOgX17g&oe=6A8970A4"}, {"file_name": "IMG_9074.png", "id": "880929834654733", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311537_880929837988066_3272023324369853377_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpJOYI3DkkMQ7kNvwHoDkOH&_nc_oc=AdopsKeMA_F_idJzCbcKeGkyKCjS45cLTU6mqP3jJrBdp7Ih3qUK5QMyfqE_okX4yVg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC2WPfSAXynHXK5fhqUXoJ9A4lyNsQyd3LAhZNplXWxg&oe=6A899100"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonder. VR \u00a9", "keywords": ["backrooms", "scary", "vr", "horror", "Liminal"], "long_description": "\ud835\udc0d\ud835\udc0e\ud835\udc13\ud835\udc04: \ud835\udc16\ud835\udc04 \ud835\udc00\ud835\udc11\ud835\udc04 \ud835\udc08\ud835\udc0d \ud835\udc02\ud835\udc14\ud835\udc11\ud835\udc11\ud835\udc04\ud835\udc0d\ud835\udc13\ud835\udc0b\ud835\udc18 \ud835\udc08\ud835\udc0d \ud835\udc04\ud835\udc00\ud835\udc11\ud835\udc0b\ud835\udc18 \ud835\udc00\ud835\udc02\ud835\udc02\ud835\udc04\ud835\udc12\ud835\udc12 \ud835\udc13\ud835\udc0e \ud835\udc04\ud835\udc17\ud835\udc0f\ud835\udc04\ud835\udc02\ud835\udc13 \ud835\udc01\ud835\udc14\ud835\udc06\ud835\udc12!\n\nWonder. VR \u00a9 \n\nA Liminal Horror Exploration Game\n\nYou\u2019ve slipped through reality.\nIn Wonder, you awaken in a place that shouldn\u2019t exist\u2014endless fluorescent corridors, damp carpet beneath your feet, and the distant hum of flickering lights. There are no windows, no clear exits\u2014only shifting rooms, forgotten spaces, and the gnawing feeling that something is watching.\n\nExplore the ever-changing levels of Wonder, a surreal world of liminal spaces inspired by backrooms legends and uncanny dreams. Each room feels familiar, yet disturbingly wrong. Uncover cryptic clues, piece together the origins of this place, and survive whatever lurks beyond the walls.\n\nFeatures:\n\nProcedurally Shifting Worlds: No two playthroughs are the same. Rooms evolve, hallways rotate, and new levels appear without warning.\n\nAtmospheric Horror: Jumpscares\u2014just pure unease. The terror comes from the silence, the spaces, and what your mind fills in.\n\nEscape\u2026 If You Can: Solve puzzles, decode hidden messages, and try to find a way out. But the deeper you go, the stranger it gets.\n\nEntities & Echoes: Some things wander these halls. Some remember you.\n\n\ud835\udc02\ud835\udc21\ud835\udc2b\ud835\udc28\ud835\udc27\ud835\udc22\ud835\udc1c\ud835\udc25\ud835\udc1e \ud835\udc12\ud835\udc2d\ud835\udc2e\ud835\udc1d\ud835\udc22\ud835\udc28\ud835\udc2c \ud835\udc0b\ud835\udc0b\ud835\udc02 \ud835\udfd0\ud835\udfce\ud835\udfd0\ud835\udfd4 \ud835\udc00\ud835\udc25\ud835\udc25 \ud835\udc11\ud835\udc22\ud835\udc20\ud835\udc21\ud835\udc2d\ud835\udc2c \ud835\udc11\ud835\udc1e\ud835\udc2c\ud835\udc1e\ud835\udc2b\ud835\udc2f\ud835\udc1e\ud835\udc1d\n", "short_description": "\ud835\udc0d\ud835\udc0e\ud835\udc13\ud835\udc04: \ud835\udc16\ud835\udc04 \ud835\udc00\ud835\udc11\ud835\udc04 \ud835\udc08\ud835\udc0d \ud835\udc02\ud835\udc14\ud835\udc11\ud835\udc11\ud835\udc04\ud835\udc0d\ud835\udc13\ud835\udc0b\ud835\udc18 \ud835\udc08\ud835\udc0d \ud835\udc04\ud835\udc00\ud835\udc11\ud835\udc0b\ud835\udc18 \ud835\udc00\ud835\udc02\ud835\udc02\ud835\udc04\ud835\udc12\ud835\udc12 \ud835\udc13\ud835\udc0e \ud835\udc04\ud835\udc17\ud835\udc0f\ud835\udc04\ud835\udc02\ud835\udc13 \ud835\udc01\ud835\udc14\ud835\udc06\ud835\udc12!\nYou\u2019ve slipped through reality.\nIn Wonder, 
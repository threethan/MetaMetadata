cdn.com&_nc_ss=7f20f&oh=00_AQHhT22Xc36s8X5s-RLdsX86cdlMJfQYTKw8AuIy6zbCQw&oe=6A95B64C"}, {"file_name": "IMG_9072.png", "id": "1390345992543962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1390345995877295_5591771451457387739_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvUPFscRQAYQ7kNvwGqEUe6&_nc_oc=Adrgrlyo3uQMB7x6bEI9xi9rUnUpI6z2sYZ6f345M0OXqJznWuukNM4tQeICVf3xR60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVFcvaTXi_p6icLQulnaam2MB2deB6XZHH_C8QqoJvxg&oe=6A95BEA4"}, {"file_name": "IMG_9074.png", "id": "880929834654733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311537_880929837988066_3272023324369853377_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BnzLGeZbyIQ7kNvwEWGV8x&_nc_oc=Adqw4iVXsKqjZ4-83iMz-YdYKFo_OB-F2UbKCkB7xC1IfarGhZwmFkuTfXYUukQPLEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhUbzNCL2Rbz1Q5tifJbJxqlfslfnBKO9lqhgz53f9RA&oe=6A95DF00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonder. VR \u00a9", "keywords": ["backrooms", "scary", "vr", "horror", "Liminal"], "long_description": "\ud835\udc0d\ud835\udc0e\ud835\udc13\ud835\udc04: \ud835\udc16\ud835\udc04 \ud835\udc00\ud835\udc11\ud835\udc04 \ud835\udc08\ud835\udc0d \ud835\udc02\ud835\udc14\ud835\udc11\ud835\udc11\ud835\udc04\ud835\udc0d\ud835\udc13\ud835\udc0b\ud835\udc18 \ud835\udc08\ud835\udc0d \ud835\udc04\ud835\udc00\ud835\udc11\ud835\udc0b\ud835\udc18 \ud835\udc00\ud835\udc02\ud835\udc02\ud835\udc04\ud835\udc12\ud835\udc12 \ud835\udc13\ud835\udc0e \ud835\udc04\ud835\udc17\ud835\udc0f\ud835\udc04\ud835\udc02\ud835\udc13 \ud835\udc01\ud835\udc14\ud835\udc06\ud835\udc12!\n\nWonder. VR \u00a9 \n\nA Liminal Horror Exploration Game\n\nYou\u2019ve slipped through reality.\nIn Wonder, you awaken in a place that shouldn\u2019t exist\u2014endless fluorescent corridors, damp carpet beneath your feet, and the distant hum of flickering lights. There are no windows, no clear exits\u2014only shifting rooms, forgotten spaces, and the gnawing feeling that something is watching.\n\nExplore the ever-changing levels of Wonder, a surreal world of liminal spaces inspired by backrooms legends and uncanny dreams. Each room feels familiar, yet disturbingly wrong. Uncover cryptic clues, piece together the origins of this place, and survive whatever lurks beyond the walls.\n\nFeatures:\n\nProcedurally Shifting Worlds: No two playthroughs are the same. Rooms evolve, hallways rotate, and new levels appear without warning.\n\nAtmospheric Horror: Jumpscares\u2014just pure unease. The terror comes from the silence, the spaces, and what your mind fills in.\n\nEscape\u2026 If You Can: Solve puzzles, decode hidden messages, and try to find a way out. But the deeper you go, the stranger it gets.\n\nEntities & Echoes: Some things wander these halls. Some remember you.\n\n\ud835\udc02\ud835\udc21\ud835\udc2b\ud835\udc28\ud835\udc27\ud835\udc22\ud835\udc1c\ud835\udc25\ud835\udc1e \ud835\udc12\ud835\udc2d\ud835\udc2e\ud835\udc1d\ud835\udc22\ud835\udc28\ud835\udc2c \ud835\udc0b\ud835\udc0b\ud835\udc02 \ud835\udfd0\ud835\udfce\ud835\udfd0\ud835\udfd4 \ud835\udc00\ud835\udc25\ud835\udc25 \ud835\udc11\ud835\udc22\ud835\udc20\ud835\udc21\ud835\udc2d\ud835\udc2c \ud835\udc11\ud835\udc1e\ud835\udc2c\ud835\udc1e\ud835\udc2b\ud835\udc2f\ud835\udc1e\ud835\udc1d\n", "short_description": "\ud835\udc0d\ud835\udc0e\ud835\udc13\ud835\udc04: \ud835\udc16\ud835\udc04 \ud835\udc00\ud835\udc11\ud835\udc04 \ud835\udc08\ud835\udc0d \ud835\udc02\ud835\udc14\ud835\udc11\ud835\udc11\ud835\udc04\ud835\udc0d\ud835\udc13\ud835\udc0b\ud835\udc18 \ud835\udc08\ud835\udc0d \ud835\udc04\ud835\udc00\ud835\udc11\ud835\udc0b\ud835\udc18 \ud835\udc00\ud835\udc02\ud835\udc02\ud835\udc04\ud835\udc12\ud835\udc12 \ud835\udc13\ud835\udc0e \ud835\udc04\ud835\udc17\ud835\udc0f\ud835\udc04\ud835\udc02\ud835\udc13 \ud835\udc01\ud835\udc14\ud835\udc06\ud835\udc12!\nYou\u2019ve slipped through reality.\nIn Wonder, 
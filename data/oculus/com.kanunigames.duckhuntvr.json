com&_nc_ss=7f20f&oh=00_Af8RYPO88lDc3PeE-jG-rl1y7SfiTlXjLoQltJTSdS0Fyw&oe=6A43DBDC"}, {"file_name": "4.png", "id": "1080288493558377", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618819_1080288496891710_97685708059101185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8zQck-HEygQ7kNvwHeI9ri&_nc_oc=AdrVAity60KI4StGFvSO1E1twWb09jOaa8l6TfQO5azm_HGudthvvKoy3xqa5dy8_HM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92T46ZZeR2kohic98MKs7-jZs6Fd55Kf-s3ehZycmsjw&oe=6A43BA91"}, {"file_name": "5.png", "id": "1506489020714159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619432_1506489024047492_3027816332349143938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xa4E1LBo_8Q7kNvwFjzbNZ&_nc_oc=Ado77OPvv2igSjIfournguPuUiFt3ysTqPqWwJCOeK4_5ecLJBpOukYk5A5bwfggATw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91XlJGZ60q1UnpWCE3qvDwXu4WSfrnI7dV372IcYaTRQ&oe=6A43E06F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1670759237069396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618819_1670759240402729_6990449813557072519_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGbcwk2prGUQ7kNvwFtTGsl&_nc_oc=AdpOh6o-K6zebGo9EJ-mzdPnCTdPFKDMsforaXdQjskfSdAkN8H8jALp4mLm8j9eHD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0_fXufwgOAvG06K5TImKp6YRt4zUCCIEpoKPiiGw0Cg&oe=6A43E6E7"}, "display_name": "Duck Hunt VR", "keywords": ["duck", "hunt", "vr", "arcade", "shooter"], "long_description": "Relive the timeless joy of duck hunting in this fully immersive VR reimagining of the retro classic! Duck Hunt VR brings back everything you loved about the original\u2014flying ducks, fast reflexes, and that iconic dog\u2014now rebuilt from the ground up for Meta Quest.\n\nGameplay Features\nGrab your shotgun and shoot ducks as they fly across the sky\n\nReact fast before the ducks escape\n\nWatch your loyal hunting dog retrieve and present your trophies\n\nEnjoy intuitive VR controls and realistic reloading\n\nWhy You'll Love It\nFaithful tribute to the original Duck Hunt experience\n\nClean retro-style graphics and sound\n\nNo menus, no complexity\u2014just pick up and play!\n\nPerfect for quick arcade sessions or long nostalgia runs\n\n", "short_description": "Relive the nostalgia of the classic duck shooting game in immersive VR! Grab your shotgun, aim with precision, and shoot flying ducks before they escape. Featuring iconic 8-bit style, faithful retro gameplay, and everyone's favorite dog that brings back memories. Duck Hunt VR is a fun, fast-paced arcade shooter made for modern VR hunters. Simple, satisfying, and perfect for all ages who love the classics!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://kanunigames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "KANUNI GAMES OYUN YAZILIM VE PAZARLAMA", "support_website_url": null, "website_url": "http://www.kanunigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25125406140382712"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1804479093443962"}]}, "baseline_offer": {"id": "1804479093443962"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753201680, "status": "PUBLISHED", "id": "1804479093443962"}]}, "liveChannel": {"nodes": [{"late
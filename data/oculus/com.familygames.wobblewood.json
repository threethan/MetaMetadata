"}, {"file_name": "02_swing_ride.png", "id": "1077415951847878", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620666_1077415955181211_4417746685525100597_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k2CJPyf7tUQ7kNvwEZ_CRt&_nc_oc=Adqg3Q_Q03zhOUb8chOj1DSB4RepWbfdcZhf0-TTvAFqxSvCoi5Yz11InYIiLI8gZq0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvakbS1f0ToUprcpP1wkN0UxxaSlSkJL10-NVf0d_j2w&oe=6AFC8936"}, {"file_name": "04_seesaw_bear.png", "id": "2578965559220685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624583_2578965562554018_1132942340582010767_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuEWCY4c1loQ7kNvwE4xusn&_nc_oc=AdqYChBd0wrLRZCIgr58x5PnNLFE1yw7_mk9jT8ouSTGxuDomWfYu9UCvoEWs_SwqHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRassJzTDA11kD8dRsM01BqE6xKqICAFqOYJXJhZYKFxQ&oe=6AFC8C3C"}, {"file_name": "03_carousel.png", "id": "2123945588549115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624619_2123945591882448_4354286134283385570_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iL6jGzxkDoQ7kNvwEIJ1qU&_nc_oc=Adrhz43txjpc-Mg-8ybuIC8pbdbsbqSX1UbstM4WcSN-oBcCpO8zZXxinSmhF2pLFao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4RTEaYYtFESvx4hX8G64clcLh0jDwh3eFo3zcBGBv6w&oe=6AFC69EE"}, {"file_name": "05_climbing.png", "id": "3975993102704694", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624069_3975993106038027_5629079923399424392_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulX39hBpo8sQ7kNvwH8dIr4&_nc_oc=AdqdJlK9R867CCZCoTUzL-upxp6wHjkl7X6_2x0gyxPkevlu5OGtHKSHfo65nUpnG24&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOTyAfLZ0VcOxTqexCW_cQBeARmslZhS5ThSO5J9s3HA&oe=6AFC87F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Fun for the whole family\nA dad built this game for the whole family to enjoy.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, fun for the whole family"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
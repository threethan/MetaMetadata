{"data": {"node": {"__typename": "Application", "id": "1234707743056508", "organization": {"id": "1231462673381015", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1336082636252351"}]}, "id": "1408104511456793"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1234707743056508"}]}, "id": "1558165172514515"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1234707743056508", "release_date": 1787316360, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1313750445152237"}, "id": "1064444736115041"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1313750445152237"}, "release_status": "RELEASED"}, "id": "1313750445152237", "version": "0.40", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1789284381, "id": "1313741298486485", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1322078214319460"}, "release_status": "RELEASED", "id": "1234707743056508"}, "id": "1322078214319460", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1234707743056508", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1027149656834548"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1783509732681911", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["\ub180\uc774\ud130", "\uc5b4\ub9b0\uc774", "\uac00\uc871", "\uadf8\ub124", "\ub180\uc774\uacf5\uc6d0"], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\uc5d0 \uc628 \uac78 \ud658\uc601\ud574\uc694!\n\uc5ec\uae30\ub294 \uc870\uae08 \ud2b9\ubcc4\ud55c \ub180\uc774\ud130\uc608\uc694. \uae30\uad6c\ub9c8\ub2e4 \ub2ec\ub9b0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \u2014\n\uadf8\ub124 \uc904\uc774 48m\uae4c\uc9c0 \uae38\uc5b4\uc9c0\uace0, \uc2dc\uc18c\uac00 40m\uae4c\uc9c0 \uc790\ub77c\uace0,\n\ubbf8\ub044\ub7fc\ud2c0\uc740 160m\uc9dc\ub9ac \ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub3fc\uc694.\n\ud83c\udfa0 \ub180\uc774\uae30\uad6c 6\uc885\n\uadf8\ub124 \u00b7 \uc2dc\uc18c(\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7\n\ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7 \ubaa8\uc591\uc774 \ub9e4\ubc88 \ubc14\ub00c\ub294 \ub79c\ub364 \ubbf8\ub044\ub7fc\ud2c0\n\ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c\n\uadf8\ub9bc\ud310\uc5d0 \uadf8\ub9b0 \uadf8\ub9bc\uc774 \uc0b4\uc544\ub098\uc11c \ub180\uc774\ud130\ub97c \ub6f0\uc5b4\ub2e4\ub140\uc694.\n\ud83c\udfc5 \ud48d\uc120 \ubaa8\uc73c\uae30\n\uae30\uad6c\ub97c \ud0c0\uba74 \ud48d\uc120\uc744 \ubaa8\uc744 \uc218 \uc788\uc5b4\uc694. \uba87 \uac1c\ub098 \ubaa8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\ud83d\udc68\u200d\ud83d\udc67 \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e4\uc5c8\uc5b4\uc694\n\uc77c\uacf1 \uc0b4 \ub538\uc744 \uc704\ud574 \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\ub808\ubc84\ub97c \ub2f9\uae30\uba74 \ub180\uc774\ud130\uac00 \uc790\ub77c\ub098\uc694 \u2014 \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ud68c\uc804\ubaa9\ub9c8\u00b7160m \ubbf8\ub044\ub7fc\ud2c0\uae4c\uc9c0, \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e0 \ub9c8\ubc95 \ub180\uc774\ud130"}, {"images": {"nodes": [{"file_name": "icon_512.png", "id": "3910250235936661", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654944867_3910250242603327_3778951319027458932_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQzawVBcbZ4Q7kNvwH7uohQ&_nc_oc=AdrGZ-wIugp7rDQvexr0EyRzDoB4l5gCGfZttY1I7NfufjRpZv4-5kArugWTT4fJjqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLO0_sQvy373CtdOe7NisfwwBJAunYTbuLFiREEGbR_w&oe=6AD24271"}, {"file_name": "logo.png", "id": "2154209538479229", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673638530_2154209541812562_4196844845391635056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6DyonWvNc8Q7kNvwGMqQA_&_nc_oc=AdqhYZixVBLppRYQxH0ZJRa8-qHc2W0bRPxNyO08c2VEl4dae7VsHUcsLDMklvcb5aE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-ccrB4SLu6FbeK1-dKloPFs8Jt3X6rpd80Ck6kg4zPw&oe=6AD243AA"}, {"file_name": "cover_square.png", "id": "1763722761629511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619078_1763722764962844_2969881034918788423_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnOeC1b4ACsQ7kNvwGOLaJD&_nc_oc=AdqHoVXy1_ZV_krsHQkgjH9OEA5sbI54FMqnAw5WVt92jK424J7hEouIhDpqVUmsWRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzBHL9_EBPnKAT4ECZY6AtZ9-5OaWbLagB0dhfLV5DPQ&oe=6AD25C2F"}, {"file_name": "cover_portrait.png", "id": "1418390050199265", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "
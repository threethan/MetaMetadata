SxVSBMQZv6VBWyqsiSZoO6ac4nk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1u4GGYw4jPgTmtLJ19r1rK4ef2cs9usHjMEhgDX2DRA&oe=6B0B14BA"}, {"file_name": "04_climbing.png", "id": "27907360338896489", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622214_27907360342229822_4259148398654863545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnclJfrzuwoQ7kNvwE2Gs4V&_nc_oc=Adpq2_GXeegC16qDf3YTKx5c3XLOtZKIbSgkgxvWOU5Lot18i0XKK4GLGH4CiMiEH8k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgAuXwVA4yA9dLB_nzsflrsna9EGz_NRzpHIS5ObYNtA&oe=6B0B18C9"}, {"file_name": "01_swing_ride.png", "id": "1605889514298796", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/595117516_1605889517632129_7884906357958656516_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-UwLAO_q9UQ7kNvwEuX6M4&_nc_oc=AdpEhNk2MMy-W9iW29UrPE33iUow_NMt2LZ2bZOXonXacOjlkFDemeWZTBvXXrIyzws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyDUEnJ76KiUnSEv13ZYZWnV5ZG-_tGiqtdoPijz8sqQ&oe=6B0B29C3"}, {"file_name": "05_slide.png", "id": "1018204294312782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619805_1018204297646115_2674205060236311921_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VOkFhDNzIsQ7kNvwGNgy20&_nc_oc=AdrduBzgJf3kHO3oJgy_qvRZ7MJKp5uIejdS3jN2XdDx_u99CslHe6uEbG8K_AMKMrc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKIvJIEhBc9kmL8RGpI_OxqGzFKfHZ28ZBG-sy6kOHaQ&oe=6B0B1FC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "kids", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Built for kids\nA dad built this game for his seven-year-old daughter.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, built for kids"}, {"images": {"nodes": []}, "id": "1031319562826880", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["\ub180\uc774\ud130", "\uc5b4\ub9b0\uc774", "\uac00\uc871", "\uadf8\ub124", "\ub180\uc774\uacf5\uc6d0"], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\uc5d0 \uc628 \uac78 \ud658\uc601\ud574\uc694!\n\uc5ec\uae30\ub294 \uc870\uae08 \ud2b9\ubcc4\ud55c \ub180\uc774\ud130\uc608\uc694. \uae30\uad6c\ub9c8\ub2e4 \ub2ec\ub9b0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \u2014\n\uadf8\ub124 \uc904\uc774 48m\uae4c\uc9c0 \uae38\uc5b4\uc9c0\uace0, \uc2dc\uc18c\uac00 40m\uae4c\uc9c0 \uc790\ub77c\uace0,\n\ubbf8\ub044\ub7fc\ud2c0\uc740 160m\uc9dc\ub9ac \ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub3fc\uc694.\n\ud83c\udfa0 \ub180\uc774\uae30\uad6c 6\uc885\n\uadf8\ub124 \u00b7 \uc2dc\uc18c(\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7\n\ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7 \ubaa8\uc591\uc774 \ub9e4\ubc88 \ubc14\ub00c\ub294 \ub79c\ub364 \ubbf8\ub044\ub7fc\ud2c0\n\ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c\n\uadf8\ub9bc\ud310\uc5d0 \uadf8\ub9b0 \uadf8\ub9bc\uc774 \uc0b4\uc544\ub098\uc11c \ub180\uc774\ud130\ub97c \ub6f0\uc5b4\ub2e4\ub140\uc694.\n\ud83c\udfc5 \ud48d\uc120 \ubaa8\uc73c\uae30\n\uae30\uad6c\ub97c \ud0c0\uba74 \ud48d\uc120\uc744 \ubaa8\uc744 \uc218 \uc788\uc5b4\uc694. \uba87 \uac1c\ub098 \ubaa8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\ud83d\udc68\u200d\ud83d\udc67 \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e4\uc5c8\uc5b4\uc694\n\uc77c\uacf1 \uc0b4 \ub538\uc744 \uc704\ud574 \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\ub808\ubc84\ub97c \ub2f9\uae30\uba74 \ub180\uc774\ud130\uac00 \uc790\ub77c\ub098\uc694 \u2014 \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ud68c\uc804\ubaa9\ub9c8\u00b7160m \ubbf8\ub044\ub7fc\ud2c0\uae4c\uc9c0, \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e0 \ub9c8\ubc95 \ub180\uc774\ud130"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": 
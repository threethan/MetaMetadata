104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5eRpncCLyoQ7kNvwHDE_WF&_nc_oc=AdpuGzu9dFb15ZeqAjjn5bmM9F7TfvBfFwuEtiESTowQi7DrYWPcV0Gn7PYqwe0dCHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlgnWs-8AEduPJA9XaF5cZYllsTEzHx8YGWmsZhDNSkQ&oe=6B030883"}, {"file_name": "05_slide.png", "id": "1018204294312782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_1018204297646115_2674205060236311921_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sngy2U_-hsUQ7kNvwHVTKMZ&_nc_oc=AdqHRrjSWeABEzmZtlg5UaoMBZfTu5v3wKdGbEzkSGwWIbmzrP6wT5ktRH23EmTOZoE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6jALfevQR6wEURjLJXchfHnb3WCo1tLR1lVj06piKIw&oe=6B0336C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "kids", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Built for kids\nA dad built this game for his seven-year-old daughter.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, built for kids"}, {"images": {"nodes": []}, "id": "1031319562826880", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["\ub180\uc774\ud130", "\uc5b4\ub9b0\uc774", "\uac00\uc871", "\uadf8\ub124", "\ub180\uc774\uacf5\uc6d0"], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\uc5d0 \uc628 \uac78 \ud658\uc601\ud574\uc694!\n\uc5ec\uae30\ub294 \uc870\uae08 \ud2b9\ubcc4\ud55c \ub180\uc774\ud130\uc608\uc694. \uae30\uad6c\ub9c8\ub2e4 \ub2ec\ub9b0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \u2014\n\uadf8\ub124 \uc904\uc774 48m\uae4c\uc9c0 \uae38\uc5b4\uc9c0\uace0, \uc2dc\uc18c\uac00 40m\uae4c\uc9c0 \uc790\ub77c\uace0,\n\ubbf8\ub044\ub7fc\ud2c0\uc740 160m\uc9dc\ub9ac \ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub3fc\uc694.\n\ud83c\udfa0 \ub180\uc774\uae30\uad6c 6\uc885\n\uadf8\ub124 \u00b7 \uc2dc\uc18c(\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7\n\ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7 \ubaa8\uc591\uc774 \ub9e4\ubc88 \ubc14\ub00c\ub294 \ub79c\ub364 \ubbf8\ub044\ub7fc\ud2c0\n\ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c\n\uadf8\ub9bc\ud310\uc5d0 \uadf8\ub9b0 \uadf8\ub9bc\uc774 \uc0b4\uc544\ub098\uc11c \ub180\uc774\ud130\ub97c \ub6f0\uc5b4\ub2e4\ub140\uc694.\n\ud83c\udfc5 \ud48d\uc120 \ubaa8\uc73c\uae30\n\uae30\uad6c\ub97c \ud0c0\uba74 \ud48d\uc120\uc744 \ubaa8\uc744 \uc218 \uc788\uc5b4\uc694. \uba87 \uac1c\ub098 \ubaa8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\ud83d\udc68\u200d\ud83d\udc67 \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e4\uc5c8\uc5b4\uc694\n\uc77c\uacf1 \uc0b4 \ub538\uc744 \uc704\ud574 \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\ub808\ubc84\ub97c \ub2f9\uae30\uba74 \ub180\uc774\ud130\uac00 \uc790\ub77c\ub098\uc694 \u2014 \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ud68c\uc804\ubaa9\ub9c8\u00b7160m \ubbf8\ub044\ub7fc\ud2c0\uae4c\uc9c0, \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e0 \ub9c8\ubc95 \ub180\uc774\ud130"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1234707759723173"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1361499433703017"}, {"status": "PUBLISHED", "id": "1982855132368059"}]}, "baseline_offer": {"id": "1982855132368059"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788548400, "status": "PUBLISHED", "id": "1361499433703017"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1313750445152237", "version": "0.40"}, "id": "1064444736115041", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1313750445152237"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1064444736115041"}]}, "change_log": "v0.45 - \ub180\uc774\uacf5\uc6d0\uc774 \uc5f4\ub838\uc5b4\uc694! \uc0c8 \ub180\uc774\uae30\uad6c \uc77c\uacf1 \uac00\uc9c0\uc640 \uc0c8 \uc74c\uc545\r\n- \ub180\uc774\ud130\uc5d0 \u300c\ub180\uc774\uacf5\uc6d0 \uc9c0\ub3c4\u300d\uac00 \uc0dd\uacbc\uc5b4\uc694. \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \ub180\uc774\uae30\uad6c\uac00 \uc788\ub294 \uacf3\uc73c\ub85c \ubc14\ub85c \uac00\uc694.\r\n- \uc0c8 \ub180\uc774\uae30\uad6c: \ubc88\uac1c \uc5f4\ucc28 \u00b7 \uad00\ub78c\ucc28 \u00b7 \ubc94\ud37c\uce74 \u00b7 \ud68c\uc804\uadf8\ub124 \u00b7 \uc9da\ub77c\uc778 \u00b7 \uc5f4\uae30\uad6c \u00b7 \uc790\uc774\ub85c\ub4dc\ub86d. \ud06c\uae30\uc640 \ube60\ub974\uae30\ub97c \ub808\ubc84\ub85c \ubc14\uafc0 \uc218 \uc788\uc5b4\uc694.\r\n- \ubc88\uac1c \uc5f4\ucc28: \uc2e4\uc81c \ub864\ub7ec\ucf54\uc2a4\ud130\ucc98\ub7fc \uc124\uacc4\ud55c \ucf54\uc2a4 \ub137\uacfc, \ubf51\uc744 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c \ub9cc\ub4e4\uc5b4\uc9c0\ub294 \ucf54\uc2a4. \uc7ac\ubbf8\uc788\ub358 \ucf54\uc2a4\ub294 8\uac1c\uae4c\uc9c0 \uc800\uc7a5\ud574\uc694.\r\n- \ubc94\ud37c\uce74\ub294 \ud578\ub4e4\uc744 \uc9c1\uc811 \ub3cc\ub9ac\uac70\ub098 \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \ubab0\uc544\uc694. \uc5f4\uae30\uad6c\ub294 \ubc29\uc544\uc1e0\ub85c \ubd88\uc744 \ucf1c\uc11c \uc62c\ub77c\uac00\uba70 \ubcc4\uc744 \ubaa8\uc544\uc694.\r\n- \uc74c\uc545\uacfc \ud6a8\uacfc\uc74c\uc744 \ubaa8\ub450 \uc0c8\ub85c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \ub180\uc774\uae30\uad6c\ub9c8\ub2e4 \ubc14\ud034\u00b7\uc0ac\uc2ac\u00b7\ubc14\ub78c \uc18c\ub9ac\uac00 \ub098\uc694.\r\n- \ub180\uc774\uae30\uad6c\ub97c \uc804\ubd80 \uc0c8\ub85c \uadf8\ub838\uace0, \ub180\uc774\ud130\uac00 \ub354 \ub113\uc5b4\uc9c0\uace0 \ud759\uae38\u00b7\uaf43\ubc2d\u00b7\uc5f0\ubabb\u00b7\ub208 \ub36e\uc778 \uc0b0\uc774 \uc0dd\uacbc\uc5b4\uc694.\r\n- \ud0c0\ub294 \uc911\uc5d0\ub3c4 A \ubc84\ud2bc\uc744 \uae38\uac8c \ub204\ub974\uba74 \uc5b8\uc81c\ub4e0 \ub0b4\ub9b4 \uc218 \uc788\uc5b4\uc694.\r\n- \ud55c \ubc88\uc5d0 \uadf8\ub9ac\ub294 \uc591\uc744 \uc904\uc5ec\uc11c \uc6c0\uc9c1\uc784\uc774 \ub354 \ubd80\ub4dc\ub7ec\uc6cc\uc694.\r\n\r\nv0.45 - The amusement park is open: seven new rides and all-new music\r\n- A Park Map board now stands in the playground. Press a button to travel straight to a ride.\r\n- New rides: Lightning Train, Ferris Wheel, Bumper Cars, Wave Swinger, Zipline, Hot Air Balloon and Drop Tower. Change their size and speed with levers.\r\n- Lightning Train: four hand-designed courses built like real roller coasters, plus random courses generated fresh every time. Save up to 8 favourites.\r\n- Drive the bumper cars by turning the steering wheel or with the thumbstick. Fire the burner with the trigger to lift the balloon and collect stars.\r\n- All music and sound effects are new. Each ride has its own wheel, chain and wind sounds.\r\n- Every ride has been redrawn, and the park is bigger with dirt paths, flower beds, a pond and snow-capped mountains.\r\n- Hold A to get off at any time.\r\n- Less to draw each frame, for smoother motion.", "created_date": 1794723379, "id": "1441693649024582", "version": "0.45", "version_code": 46, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1313750445152237"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1064444736115041"}]}, "change_log": "v0.44 - \ubc88\uac1c \uc5f4\ucc28 \ub4f1\uc7a5! \ub180\uc774\ud130\ub3c4 \uc0c8 \ub2e8\uc7a5\r\n- \uc0c8 \ub180\uc774\uae30\uad6c \u300c\ubc88\uac1c \uc5f4\ucc28\u300d: \ubb38\uc744 \uc9c0\ub098\uba74 \uc5f4\ucc28 \uc804\uc6a9 \uad6c\uc5ed\uc73c\ub85c \uac00\uc694.\r\n- \uc2e4\uc81c \ub864\ub7ec\ucf54\uc2a4\ud130\ucc98\ub7fc \uc124\uacc4\ud55c \ucf54\uc2a4 \ub137: \uc6b0\ub4e0 \ud2b8\uc704\uc2a4\ud130 \u00b7 \uc2a4\uce74\uc774 \uc790\uc774\uc5b8\ud2b8 \u00b7 \ub8e8\ud504 \ub9c8\uc2a4\ud130 \u00b7 \ub85c\ucf13 \ud0c0\uc6cc. \uc5ed\uc758 \u300c\ucf54\uc2a4 \uc885\ub958\u300d \ubc84\ud2bc\uc73c\ub85c \uace8\ub77c\uc694.\r\n- \ubf51\uc744 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c \ub9cc\ub4e4\uc5b4\uc9c0\ub294 \ubb34\uc791\uc704 \ucf54\uc2a4\ub3c4 \uc788\uc5b4\uc694. \ud0c0\ub294 \uc2dc\uac04(2~3\ubd84)\uacfc \ucd5c\uace0 \uc18d\ub3c4(\uc2dc\uc18d 100~200km)\ub97c \ub808\ubc84\ub85c \uace0\ub974\uace0, \uc7ac\ubbf8\uc788\ub358 \ucf54\uc2a4\ub294 8\uac1c\uae4c\uc9c0 \uc800\uc7a5\ud574\uc694.\r\n- \ud0c0\ub294 \uc911\uc5d0\ub3c4 A \ubc84\ud2bc\uc744 \uae38\uac8c \ub204\ub974\uba74 \uc5b8\uc81c\ub4e0 \ub0b4\ub9b4 \uc218 \uc788\uc5b4\uc694.\r\n- \ub180\uc774\uae30\uad6c\ub97c \uc804\ubd80 \uc0c8\ub85c \uadf8\ub838\uc5b4\uc694: \ud68c\uc804\ubaa9\ub9c8\u00b7\uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ubbf8\ub044\ub7fc\ud2c0\u00b7\uc554\ubcbd\u00b7\uc810\ud504 \ud0c0\uc6cc\u00b7\uadf8\ub9bc\ud310\u00b7\uc548\ub0b4\ud310\uae4c\uc9c0 \ud6e8\uc52c \uc54c\ub85d\ub2ec\ub85d\ud574\uc84c\uc5b4\uc694.\r\n- \ub180\uc774\ud130\uac00 \ub354 \ub113\uc5b4\uc9c0\uace0 \ud759\uae38\u00b7\uaf43\ubc2d\u00b7\uc5f0\ubabb, \ubb49\uac8c\uad6c\ub984\uacfc \ub208 \ub36e\uc778 \uc0b0\uc774 \uc0dd\uacbc\uc5b4\uc694.\r\n- \ubbf8\ub044\ub7fc\ud2c0 \uae30\uc6b8\uae30\ub97c 5~25\ub3c4\ub85c \uace0\ub97c \uc218 \uc788\uc5b4\uc694.\r\n- \ud55c \ubc88\uc5d0 \uadf8\ub9ac\ub294 \uc591\uc744 \ud06c\uac8c \uc904\uc5ec\uc11c, \uadf8\ub9bc\uc740 \uc88b\uc544\uc84c\ub294\ub370 \uc6c0\uc9c1\uc784\uc740 \ub354 \ubd80\ub4dc\ub7ec\uc6cc\uc694.\r\n\r\nv0.44 - The Lightning Train arrives, and the whole park got a makeover\r\n- New ride: the Lightning Train. Step through the gate to its own zone.\r\n- Four hand-designed courses, built like real roller coasters: Wooden Twister, Sky Giant, Loop Master and Rocket Tower. Pick one with the Course type button at the station.\r\n- Or ride a random course, generated fresh every time. Pick the ride time (2-3 minutes) and top speed (100-200 km/h) with levers, and save up to 8 favourites.\r\n- Hold A to get off at any time.\r\n- Every ride has been redrawn: carousel, swing, seesaw, slide, climbing wall, jump tower, easel and signs are far more colourful.\r\n- A bigger park with dirt paths, flower beds, a pond, puffy clouds and snow-capped mountains.\r\n- The slide angle is now adjustable from 5 to 25 degrees.\r\n- Much less to draw each frame: better graphics, even smoother motion.", "created_date": 1794652971, "id": "1440078895852724", "version": "0.44", "version_code": 45, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1313750445152237"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1064444736115041"}]}, "change_log": "v0.43 - \ubc88\uac1c \uc5f4\ucc28 \ub4f1\uc7a5! \ub180\uc774\ud130\ub3c4 \uc0c8 \ub2e8\uc7a5\r\n- \uc0c8 \ub180\uc774\uae30\uad6c \u300c\ubc88\uac1c \uc5f4\ucc28\u300d: \ubb38\uc744 \uc9c0\ub098\uba74 \uc5f4\ucc28 \uc804\uc6a9 \uad6c\uc5ed\uc73c\ub85c \uac00\uc694. \ucf54\uc2a4\ub294 \ubf51\uc744 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c \ub9cc\ub4e4\uc5b4\uc838\uc694(\ud55c \ubc14\ud034 \ub3c4\ub294 \ub8e8\ud504 2~5\uac1c).\r\n- \ud0c0\ub294 \uc2dc\uac04(2~3\ubd84)\uacfc \ucd5c\uace0 \uc18d\ub3c4(\uc2dc\uc18d 100~200km)\ub97c \ub808\ubc84\ub85c \uace0\ub97c \uc218 \uc788\uc5b4\uc694. \ud0c0\ub294 \uc911\uc5d0\ub3c4 A \ubc84\ud2bc\uc744 \uae38\uac8c \ub204\ub974\uba74 \uc5b8\uc81c\ub4e0 \ub0b4\ub9b4 \uc218 \uc788\uc5b4\uc694.\r\n- \uc7ac\ubbf8\uc788\ub358 \ucf54\uc2a4\ub294 \uc800\uc7a5\ud574 \ub450\uace0 \ub2e4\uc2dc \ud0c8 \uc218 \uc788\uc5b4\uc694(8\uac1c\uae4c\uc9c0).\r\n- \ub180\uc774\uae30\uad6c\ub97c \uc804\ubd80 \uc0c8\ub85c \uadf8\ub838\uc5b4\uc694: \ud68c\uc804\ubaa9\ub9c8\u00b7\uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ubbf8\ub044\ub7fc\ud2c0\u00b7\uc554\ubcbd\u00b7\uc810\ud504 \ud0c0\uc6cc\u00b7\uadf8\ub9bc\ud310\u00b7\uc548\ub0b4\ud310\uae4c\uc9c0 \ud6e8\uc52c \uc54c\ub85d\ub2ec\ub85d\ud574\uc84c\uc5b4\uc694.\r\n- \ub180\uc774\ud130\uac00 \ub354 \ub113\uc5b4\uc9c0\uace0 \ud759\uae38\u00b7\uaf43\ubc2d\u00b7\uc5f0\ubabb, \ubb49\uac8c\uad6c\ub984\uacfc \ub208 \ub36e\uc778 \uc0b0\uc774 \uc0dd\uacbc\uc5b4\uc694.\r\n- \ubbf8\ub044\ub7fc\ud2c0 \uae30\uc6b8\uae30\ub97c 5~25\ub3c4\ub85c \uace0\ub97c \uc218 \uc788\uc5b4\uc694.\r\n- \ud55c \ubc88\uc5d0 \uadf8\ub9ac\ub294 \uc591\uc744 \ud06c\uac8c \uc904\uc5ec\uc11c, \uadf8\ub9bc\uc740 \uc88b\uc544\uc84c\ub294\ub370 \uc6c0\uc9c1\uc784\uc740 \ub354 \ubd80\ub4dc\ub7ec\uc6cc\uc694.\r\n\r\nv0.43 - The Lightning Train arrives, and the whole park got a makeover\r\n- New ride: the Lightning Train. Step through the gate to its own zone. Every new course is generated from scratch, with 2 to 5 loops.\r\n- Pick the ride time (2-3 minutes) and top speed (100-200 km/h) with levers. Hold A to get off at any time.\r\n- Loved a course? Save it and ride it again (up to 8).\r\n- Every ride has been redrawn: carousel, swing, seesaw, slide, climbing wall, jump tower, easel and signs are far more colourful.\r\n- A bigger park with dirt pat
=1-7&_nc_sid=6e7a0a&_nc_ohc=X-khKGpq4woQ7kNvwFcwNPE&_nc_oc=Adq5JoxoCKAvkLXWwMhqqPdW6wN0Q0xFfMvfdGRvh0_H4SerI167EpS2ILEfBK71pa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkkiFCxOYyruax4hqiVcPTpV-X49wtcL7tvfN48pg-kw&oe=6AB2A8D6"}, {"file_name": "02_carousel.png", "id": "1102615662097724", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_1102615668764390_5486211654797626500_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkNX6LwNhL0Q7kNvwFkoQdV&_nc_oc=AdqwTDcFXaXP-2M3ZXfS9gIGTAFdHh69-0OVAucjMRYFCXR0ORzxKgutFrOwpKtOq4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAnxQDgAi5Pnk1DU15lSw-P91477qZ7I0WW1n_tRmCvg&oe=6AB287FA"}, {"file_name": "04_climbing.png", "id": "27907360338896489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622214_27907360342229822_4259148398654863545_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCiIQ_O8Tn8Q7kNvwEY_pWF&_nc_oc=AdoAeSkmzL2qI2ZgJ8IhwzLe_87FeJd7NrQK_BImHMSOh0nyktSO2h7tzWM_1BjHzr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqD8jI5Hg1Lc6g2gdSOg4jhW1xJOPvO9B9D8VtIHTOnQ&oe=6AB28C09"}, {"file_name": "01_swing_ride.png", "id": "1605889514298796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595117516_1605889517632129_7884906357958656516_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP1_3qf39toQ7kNvwG9Ub-l&_nc_oc=AdrvYOcaTAUbbpza29bn9EV4bEFW0aGltSXpWtRGEPJULQnbsH7TkV58lbvEk3I_A6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB6O65mU3kduElvJ81IHPQPu-mCd7EdTiyzkTEkcm1xg&oe=6AB29D03"}, {"file_name": "05_slide.png", "id": "1018204294312782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_1018204297646115_2674205060236311921_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rWKmPeiodMQ7kNvwGRRvM7&_nc_oc=AdqXh03VhIdEuJ7Rka1Q3vqLVv_R4jDMQ3ZccTrKkaOkSum-hmZOFqTriJUA9xY1SCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR5lksstgtZkwKzkeWlVshZ_nsl8f961j6vac5OTv3Ag&oe=6AB29302"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "kids", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Built for kids\nA dad built this game for his seven-year-old daughter.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, built for kids"}, {"images": {"nodes": []}, "id": "1031319562826880", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["\ub180\uc774\ud130", "\uc5b4\ub9b0\uc774", "\uac00\uc871", "\uadf8\ub124", "\ub180\uc774\uacf5\uc6d0"], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\uc5d0 \uc628 \uac78 \ud658\uc601\ud574\uc694!\n\uc5ec\uae30\ub294 \uc870\uae08 \ud2b9\ubcc4\ud55c \ub180\uc774\ud130\uc608\uc694. \uae30\uad6c\ub9c8\ub2e4 \ub2ec\ub9b0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \u2014\n\uadf8\ub124 \uc904\uc774 48m\uae4c\uc9c0 \uae38\uc5b4\uc9c0\uace0, \uc2dc\uc18c\uac00 40m\uae4c\uc9c0 \uc790\ub77c\uace0,\n\ubbf8\ub044\ub7fc\ud2c0\uc740 160m\uc9dc\ub9ac \ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub3fc\uc694.\n\ud83c\udfa0 \ub180\uc774\uae30\uad6c 6\uc885\n\uadf8\ub124 \u00b7 \uc2dc\uc18c(\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7\n\ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7 \ubaa8\uc591\uc774 \ub9e4\ubc88 \ubc14\ub00c\ub294 \ub79c\ub364 \ubbf8\ub044\ub7fc\ud2c0\n\ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c\n\uadf8\ub9bc\ud310\uc5d0 \uadf8\ub9b0 \uadf8\ub9bc\uc774 \uc0b4\uc544\ub098\uc11c \ub180\uc774\ud130\ub97c \ub6f0\uc5b4\ub2e4\ub140\uc694.\n\ud83c\udfc5 \ud48d\uc120 \ubaa8\uc73c\uae30\n\uae30\uad6c\ub97c \ud0c0\uba74 \ud48d\uc120\uc744 \ubaa8\uc744 \uc218 \uc788\uc5b4\uc694. \uba87 \uac1c\ub098 \ubaa8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\ud83d\udc68\u200d\ud83d\udc67 \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e4\uc5c8\uc5b4\uc694\n\uc77c\uacf1 \uc0b4 \ub538\uc744 \uc704\ud574 \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\ub808\ubc84\ub97c \ub2f9\uae30\uba74 \ub180\uc774\ud130\uac00 \uc790\ub77c\ub098\uc694 \u2014 \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ud68c\uc804\ubaa9\ub9c8\u00b7160m \ubbf8\ub044\ub7fc\ud2c0\uae4c\uc9c0, \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e0 \ub9c8\ubc95 \ub180\uc774\ud130"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": 
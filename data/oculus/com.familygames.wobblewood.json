cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C_vhGQsQxYQ7kNvwGUHcky&_nc_oc=Adp2ultERGzynS2UUqoBHoX0MHSknP_VbW7aAVYl2xx_E3BwcsC2PmzROe10YIG2sOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVuvSU6rffRFx1tBobE2K5o5uJlChRc6sVW7vGn8HvdA&oe=6AD25936"}, {"file_name": "04_seesaw_bear.png", "id": "2578965559220685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624583_2578965562554018_1132942340582010767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMgd1EH0wzAQ7kNvwEvzOGC&_nc_oc=AdrFewZUSMGtmFcPfsSnC2PYtDckBPcD7vem7230fLk7H45fO5383H9REOoyVFrtoZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkyQ-JNiG-8tmLWzOiLKbhLBYhcoCpzvoklPyj01st7w&oe=6AD25C3C"}, {"file_name": "03_carousel.png", "id": "2123945588549115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624619_2123945591882448_4354286134283385570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f90MWrUvLQQ7kNvwHCYWWm&_nc_oc=AdrImxjnAl5yXgCNJdqVkCqFTp7xSDAz6ClbWpuwTpXCE8JlP93q07noxxxBIuJ6GqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnvmLhGgLyYCp7CF6GEHZGTyj4YWf3yGaGQabqPSahow&oe=6AD239EE"}, {"file_name": "05_climbing.png", "id": "3975993102704694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_3975993106038027_5629079923399424392_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r7Vb69K1x0Q7kNvwGBLFIi&_nc_oc=AdrEO0fhvHDed-XADmeTmLrtHUqLg0zvnLEWiLgzqLhRZDt9yMOkAswRAcLBjVkFCUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-LbxuHMjPvMD4AMKdyc6f5bTyocSyUtnypJYKyDzaVg&oe=6AD257F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Fun for the whole family\nA dad built this game for the whole family to enjoy.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, fun for the whole family"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322078214319460"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619078_1763722764962844_2969881034918788423_n.png?stp=dst-pn
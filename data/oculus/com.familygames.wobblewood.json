104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJQCKEFfot4Q7kNvwHCBCfs&_nc_oc=Adr-H7qO2F2E3q8rJVgPV8bA7dyCeYVO_S8ZxeWZwHp8cRwBDjgZw8WjQK0yBzilYP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfI1GUiqNhY3k-VaiWAiHkQDHwLD-1S4mSgbzHN9cKcA&oe=6AFDC283"}, {"file_name": "05_slide.png", "id": "1018204294312782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1018204297646115_2674205060236311921_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lbkk0d5JcLgQ7kNvwGzT0KF&_nc_oc=AdoPOWNFh80SZ3vr0JYuQg_m74xqdeepWSSEeidJunQdhb4cjjiNHDK6xNNdgFnnnUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMwlnSj30utrDrwXtDj4GPQfe0iU6QyC1MGULOLWYJFg&oe=6AFDB882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "kids", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Built for kids\nA dad built this game for his seven-year-old daughter.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, built for kids"}, {"images": {"nodes": []}, "id": "1031319562826880", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["\ub180\uc774\ud130", "\uc5b4\ub9b0\uc774", "\uac00\uc871", "\uadf8\ub124", "\ub180\uc774\uacf5\uc6d0"], "long_description": "\uc6cc\ube14\uc6b0\ub4dc \ub180\uc774\ud130\uc5d0 \uc628 \uac78 \ud658\uc601\ud574\uc694!\n\uc5ec\uae30\ub294 \uc870\uae08 \ud2b9\ubcc4\ud55c \ub180\uc774\ud130\uc608\uc694. \uae30\uad6c\ub9c8\ub2e4 \ub2ec\ub9b0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \u2014\n\uadf8\ub124 \uc904\uc774 48m\uae4c\uc9c0 \uae38\uc5b4\uc9c0\uace0, \uc2dc\uc18c\uac00 40m\uae4c\uc9c0 \uc790\ub77c\uace0,\n\ubbf8\ub044\ub7fc\ud2c0\uc740 160m\uc9dc\ub9ac \ub864\ub7ec\ucf54\uc2a4\ud130\uac00 \ub3fc\uc694.\n\ud83c\udfa0 \ub180\uc774\uae30\uad6c 6\uc885\n\uadf8\ub124 \u00b7 \uc2dc\uc18c(\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7\n\ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7 \ubaa8\uc591\uc774 \ub9e4\ubc88 \ubc14\ub00c\ub294 \ub79c\ub364 \ubbf8\ub044\ub7fc\ud2c0\n\ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c\n\uadf8\ub9bc\ud310\uc5d0 \uadf8\ub9b0 \uadf8\ub9bc\uc774 \uc0b4\uc544\ub098\uc11c \ub180\uc774\ud130\ub97c \ub6f0\uc5b4\ub2e4\ub140\uc694.\n\ud83c\udfc5 \ud48d\uc120 \ubaa8\uc73c\uae30\n\uae30\uad6c\ub97c \ud0c0\uba74 \ud48d\uc120\uc744 \ubaa8\uc744 \uc218 \uc788\uc5b4\uc694. \uba87 \uac1c\ub098 \ubaa8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\ud83d\udc68\u200d\ud83d\udc67 \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e4\uc5c8\uc5b4\uc694\n\uc77c\uacf1 \uc0b4 \ub538\uc744 \uc704\ud574 \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\ub808\ubc84\ub97c \ub2f9\uae30\uba74 \ub180\uc774\ud130\uac00 \uc790\ub77c\ub098\uc694 \u2014 \uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ud68c\uc804\ubaa9\ub9c8\u00b7160m \ubbf8\ub044\ub7fc\ud2c0\uae4c\uc9c0, \uc544\uc774\ub97c \uc704\ud574 \ub9cc\ub4e0 \ub9c8\ubc95 \ub180\uc774\ud130"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1234707759723173"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1361499433703017"}, {"status": "PUBLISHED", "id": "1982855132368059"}]}, "baseline_offer": {"id": "1982855132368059"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788548400, "status": "PUBLISHED", "id": "1361499433703017"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1313750445152237", "version": "0.40"}, "id": "1064444736115041", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1313750445152237"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1064444736115041"}]}, "change_log": "v0.43 - \ubc88\uac1c \uc5f4\ucc28 \ub4f1\uc7a5! \ub180\uc774\ud130\ub3c4 \uc0c8 \ub2e8\uc7a5\r\n- \uc0c8 \ub180\uc774\uae30\uad6c \u300c\ubc88\uac1c \uc5f4\ucc28\u300d: \ubb38\uc744 \uc9c0\ub098\uba74 \uc5f4\ucc28 \uc804\uc6a9 \uad6c\uc5ed\uc73c\ub85c \uac00\uc694. \ucf54\uc2a4\ub294 \ubf51\uc744 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c \ub9cc\ub4e4\uc5b4\uc838\uc694(\ud55c \ubc14\ud034 \ub3c4\ub294 \ub8e8\ud504 2~5\uac1c).\r\n- \ud0c0\ub294 \uc2dc\uac04(2~3\ubd84)\uacfc \ucd5c\uace0 \uc18d\ub3c4(\uc2dc\uc18d 100~200km)\ub97c \ub808\ubc84\ub85c \uace0\ub97c \uc218 \uc788\uc5b4\uc694. \ud0c0\ub294 \uc911\uc5d0\ub3c4 A \ubc84\ud2bc\uc744 \uae38\uac8c \ub204\ub974\uba74 \uc5b8\uc81c\ub4e0 \ub0b4\ub9b4 \uc218 \uc788\uc5b4\uc694.\r\n- \uc7ac\ubbf8\uc788\ub358 \ucf54\uc2a4\ub294 \uc800\uc7a5\ud574 \ub450\uace0 \ub2e4\uc2dc \ud0c8 \uc218 \uc788\uc5b4\uc694(8\uac1c\uae4c\uc9c0).\r\n- \ub180\uc774\uae30\uad6c\ub97c \uc804\ubd80 \uc0c8\ub85c \uadf8\ub838\uc5b4\uc694: \ud68c\uc804\ubaa9\ub9c8\u00b7\uadf8\ub124\u00b7\uc2dc\uc18c\u00b7\ubbf8\ub044\ub7fc\ud2c0\u00b7\uc554\ubcbd\u00b7\uc810\ud504 \ud0c0\uc6cc\u00b7\uadf8\ub9bc\ud310\u00b7\uc548\ub0b4\ud310\uae4c\uc9c0 \ud6e8\uc52c \uc54c\ub85d\ub2ec\ub85d\ud574\uc84c\uc5b4\uc694.\r\n- \ub180\uc774\ud130\uac00 \ub354 \ub113\uc5b4\uc9c0\uace0 \ud759\uae38\u00b7\uaf43\ubc2d\u00b7\uc5f0\ubabb, \ubb49\uac8c\uad6c\ub984\uacfc \ub208 \ub36e\uc778 \uc0b0\uc774 \uc0dd\uacbc\uc5b4\uc694.\r\n- \ubbf8\ub044\ub7fc\ud2c0 \uae30\uc6b8\uae30\ub97c 5~25\ub3c4\ub85c \uace0\ub97c \uc218 \uc788\uc5b4\uc694.\r\n- \ud55c \ubc88\uc5d0 \uadf8\ub9ac\ub294 \uc591\uc744 \ud06c\uac8c \uc904\uc5ec\uc11c, \uadf8\ub9bc\uc740 \uc88b\uc544\uc84c\ub294\ub370 \uc6c0\uc9c1\uc784\uc740 \ub354 \ubd80\ub4dc\ub7ec\uc6cc\uc694.\r\n\r\nv0.43 - The Lightning Train arrives, and the whole park got a makeover\r\n- New ride: the Lightning Train. Step through the gate to its own zone. Every new course is generated from scratch, with 2 to 5 loops.\r\n- Pick the ride time (2-3 minutes) and top speed (100-200 km/h) with levers. Hold A to get off at any time.\r\n- Loved a course? Save it and ride it again (up to 8).\r\n- Every ride has been redrawn: carousel, swing, seesaw, slide, climbing wall, jump tower, easel and signs are far more colourful.\r\n- A bigger park with dirt paths, flower beds, a pond, puffy clouds and snow-capped mountains.\r\n- The slide angle is now adjustable from 5 to 25 degrees.\r\n- Much less to draw each frame: better graphics, even smoother motion.", "created_date": 1794623708, "id": "1439366622590618", "version": "0.43", "version_code": 44, "release_status": "PENDING", "status": "SUBMITTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1313750445152237"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1064444736115041"}]}, "change_log": "v0.40 - \ub354 \uc608\ubed0\uc9c4 \ub180\uc774\ud130!\n- \ub098\ubb34\u00b7\ub180\uc774\uae30\uad6c\u00b7\uc548\ub0b4\ud310\uc5d0 \uc9c4\uc9dc \uadf8\ub9bc\uc790\uac00 \uc0dd\uae30\uace0, \uad6c\ub984 \uadf8\ub9bc\uc790\uac00 \uc794\ub514 \uc704\ub85c \ucc9c\ucc9c\ud788 \ud758\ub7ec\uac00\uc694.\n- \uc794\ub514\u00b7\ub098\ubb34\u00b7\ub180\uc774\uae30\uad6c\uc5d0 \uc9c8\uac10\uc774 \uc0dd\uaca8 \ud6e8\uc52c \ub610\ub837\ud558\uace0 \uc608\ubed0\uc84c\uc5b4\uc694.\n- \ub098\ubb34 6\uc885(\ubc9a\uaf43\ub098\ubb34\u00b7\uc790\uc791\ub098\ubb34\u00b7\ud3ec\ud50c\ub7ec\u00b7\ub2e8\ud48d\ub098\ubb34\u2026)\uacfc \uaf43 5\uc885(\ud2a4\ub9bd\u00b7\ub370\uc774\uc9c0\u00b7\ub77c\ubca4\ub354\u2026)\uc774 \ub298\uc5c8\uace0, \uaf43\uc78e\uc774 \ubc14\ub78c\uc5d0 \ud769\ub0a0\ub824\uc694.\n- \ud480\u00b7\uaf43\u00b7\ub098\ubb34\uac00 \ubc14\ub78c\uc5d0 \uc0b4\ub791\uc0b4\ub791 \ud754\ub4e4\ub824\uc694.\n- \uc810\ud504 \ud0c0\uc6cc\uc5d0 \ub09c\uc774\ub3c4 \ubc84\ud2bc(\uc26c\uc6c0/\ubcf4\ud1b5/\uc5b4\ub824\uc6c0)\uc774 \uc0dd\uacbc\uc5b4\uc694. \uc26c\uc6c0\uc740 \ubc1b\uce68\ub300\uac00 \ud06c\uace0 \uc810\ud504\uac00 \ub192\uc544\uc11c \uc5b4\ub9b0 \uce5c\uad6c\ub3c4 \uaf2d\ub300\uae30\uae4c\uc9c0!\n- \uadf8\ub798\ud53d\uc740 \uc88b\uc544\uc84c\uc9c0\ub9cc \ud504\ub808\uc784\uc740 \uadf8\ub300\ub85c \ubd80\ub4dc\ub7ec\uc6cc\uc694.\n\nv0.40 - A prettier park!\n- Real shadows: trees, rides and signs now cast shadows on the lawn, and cloud shadows drift slowly across the park.\n- Grass, trees and rides have texture now - everything looks crisper.\n- Six kinds of trees (blossom, birch, poplar, autumn\u2026) and five kinds of flowers (tulips, daisies, lavender\u2026), with petals floating on the breeze.\n- Grass, flowers and trees sway in the wind.\n- Jump Tower difficulty button: Easy / Normal / Hard. Easy has big platforms and higher jumps so little ones can reach the top.\n- Better graphics, same smooth frame rate.", "created_date": 1789284995, "id": "1313750445152237", "version": "0.40", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_releas
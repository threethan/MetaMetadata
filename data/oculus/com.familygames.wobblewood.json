{"data": {"node": {"__typename": "Application", "id": "1234707743056508", "organization": {"id": "1231462673381015", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1336082636252351"}]}, "id": "1408104511456793"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1234707743056508"}]}, "id": "1558165172514515"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1234707743056508", "release_date": 1787316360, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1451214788072468"}, "id": "1064444736115041"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1234707743056508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1451214788072468"}, "release_status": "RELEASED"}, "id": "1451214788072468", "version": "0.46", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1795081233, "id": "1449258571601423", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 4, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1449275258266421"}, "release_status": "RELEASED", "id": "1234707743056508"}, "id": "1449275258266421", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1234707743056508", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1027149656834548"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1955713082051189", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["\ub180\uc774\ud130", "\uc5b4\ub9b0\uc774", "\uac00\uc871", "\uadf8\ub124", "\ub180\uc774\uacf5\uc6d0"], "long_description": "\ud83c\udfc1 \uce74\ud2b8 \ub808\uc774\uc2f1\uc774 \uc5f4\ub838\uc5b4\uc694!\n\ub3d9\ubb3c \uc6b4\uc804\uc790\ub4e4\uacfc \uc5ec\ub35f \ucf54\uc2a4(\uc26c\uc6b4 \ucf54\uc2a4 \uc14b \ud3ec\ud568)\ub97c \ub2ec\ub824\uc694. \ucf54\uc2a4\ub294 \uc9c0\ub3c4\ub97c \ubcf4\uba74\uc11c \uace8\ub77c\uc694.\n- \uc624\ub978\ucabd \ubc29\uc544\uc1e0\ub85c \ub2ec\ub9ac\uace0 \uc67c\ucabd \ubc29\uc544\uc1e0\ub85c \uba48\ucdb0\uc694. \ud578\ub4e4\uc744 \uaebe\uc73c\uba74\uc11c \uc67c\ucabd \ubc29\uc544\uc1e0\ub97c \uc0b4\uc9dd \ub2f9\uae30\uba74 \ub4dc\ub9ac\ud504\ud2b8!\n- \ubbf8\ub044\ub7ec\uc9c0\ub294 \ub3d9\uc548 \ub9c9\ub300\uac00 \ucc28\uace0, \ub2e4 \ucc28\uba74 \ubd80\uc2a4\ud130\ub97c \uc5bb\uc5b4\uc694. \uc55e \uce74\ud2b8 \ub4a4\uc5d0 \ubc14\uc9dd \ubd99\uc73c\uba74 \ub354 \ube68\ub77c\uc838\uc694.\n- \uc2a4\ud53c\ub4dc\uc804\uacfc \uc544\uc774\ud15c\uc804. \uc120\ubb3c \uc0c1\uc790\uc5d0\uc11c \ubb3c\ud48d\uc120\u00b7\ud3ed\uc8fd\u00b7\ube44\ub217\ubc29\uc6b8\u00b7\uc6b0\uc0b0\u00b7\uc790\uc11d\uc774 \ub098\uc640\uc694.\n- \ud578\ub4e4\uc744 \uc9c1\uc811 \ub3cc\ub9ac\uac70\ub098 \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \ubab0\uc544\uc694. \ucd5c\uace0 \uc18d\ub3c4 20~80km/h, \uc0c1\ub300 2~6\ub300, \uc2e4\ub825 \ub124 \ub2e8\uacc4.\n\ud83c\udfa1 \ub180\uc774\uacf5\uc6d0\n\ubc88\uac1c \uc5f4\ucc28 \u00b7 \uad00\ub78c\ucc28 \u00b7 \ubc94\ud37c\uce74 \u00b7 \ud68c\uc804\uadf8\ub124 \u00b7 \uc9da\ub77c\uc778 \u00b7 \uc5f4\uae30\uad6c \u00b7 \uc790\uc774\ub85c\ub4dc\ub86d. \ub180\uc774\ud130\uc758 \uc9c0\ub3c4\ud310\uc5d0\uc11c \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \ubc14\ub85c \uac00\uc694.\n\uad00\ub78c\ucc28\ub294 \uc9c0\ub984 100m\uae4c\uc9c0 \ucee4\uc9c0\uace0, \uc790\uc774\ub85c\ub4dc\ub86d\uc740 100m \ud0d1\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\uace0, \ubc88\uac1c \uc5f4\ucc28\ub294 \ucd5c\uace0 \uc2dc\uc18d 200km\ub85c \ub2ec\ub824\uc694.\n\ud83c\udfa0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \uc790\ub77c\ub098\ub294 \ub180\uc774\ud130\n\uae30\uad6c\ub9c8\ub2e4 \ub2ec\ub9b0 \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \uadf8\ub124 \uc904\uc774 48m\uae4c\uc9c0 \uae38\uc5b4\uc9c0\uace0, \uc2dc\uc18c\uac00 40m\uae4c\uc9c0 \uc790\ub77c\uace0, \ubbf8\ub044\ub7fc\ud2c0\uc740 160m\uac00 \ub3fc\uc694.\n\uadf8\ub124 \u00b7 \uc2dc\uc18c(\uacf0\ub3cc\uc774 \uce5c\uad6c\uac00 \uac19\uc774 \ud0c0\uc694) \u00b7 \ud68c\uc804\ubaa9\ub9c8 \u00b7 \ud074\ub77c\uc774\ubc0d \ubcbd \u00b7 \ud68c\uc624\ub9ac \uc810\ud504 \ud0c0\uc6cc \u00b7 \ubaa8\uc591\uc774 \ub9e4\ubc88 \ubc14\ub00c\ub294 \ub79c\ub364 \ubbf8\ub044\ub7fc\ud2c0\n\ud83c\udfa8 \uadf8\ub9bc \uce5c\uad6c\n\uadf8\ub9bc\ud310\uc5d0 \uadf8\ub9b0 \uadf8\ub9bc\uc774 \uc0b4\uc544\ub098\uc11c \ub180\uc774\ud130\ub97c \ub6f0\uc5b4\ub2e4\ub140\uc694.\n\ud83c\udfc5 \ud48d\uc120 \ubaa8\uc73c\uae30\n\uae30\uad6c\ub97c \ud0c0\uba74 \ud48d\uc120\uc744 \ubaa8\uc744 \uc218 \uc788\uc5b4\uc694. \uba87 \uac1c\ub098 \ubaa8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\ud83d\udc68\u200d\ud83d\udc67 \uc628 \uac00\uc871\uc774 \ud568\uaed8\n\uc628 \uac00\uc871\uc774 \ud568\uaed8 \uc990\uae30\ub3c4\ub85d \uc544\ube60\uac00 \uc9c1\uc811 \ub9cc\ub4e0 \uac8c\uc784\uc774\uc5d0\uc694.\n- \uad11\uace0 \uc5c6\uc74c, \uacb0\uc81c \uc5c6\uc74c, \uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4 \uc5c6\uc74c (\uc644\uc804 \uc624\ud504\ub77c\uc778)\n- \uba40\ubbf8 \ubc29\uc9c0 \uc635\uc158\uacfc \ubcf4\ud638\uc790 \uc124\uc815 \ud328\ub110\n- \ud55c\uad6d\uc5b4 \ud3ec\ud568 13\uac1c \uc5b8\uc5b4 \uc9c0\uc6d0", "short_description": "\uce74\ud2b8 \ub808\uc774\uc2f1\uc774 \uc5f4\ub838\uc5b4\uc694 \u2014 \ub4dc\ub9ac\ud504\ud2b8\uc640 \ubd80\uc2a4\ud130\ub85c \ub3d9\ubb3c \uc6b4\uc804\uc790\ub4e4\uacfc \uc5ec\ub35f \ucf54\uc2a4\ub97c \ub2ec\ub824\uc694. \uad00\ub78c\ucc28\u00b7\ubc94\ud37c\uce74\u00b7\uc9da\ub77c\uc778\u00b7\uc5f4\uae30\uad6c\u00b7\uc790\uc774\ub85c\ub4dc\ub86d\u00b7\ub864\ub7ec\ucf54\uc2a4\ud130\uae4c\uc9c0, \ub808\ubc84\ub97c \ub2f9\uae30\uba74 \ucee4\uc9c0\ub294 \uc628 \uac00\uc871\uc758 \ub9c8\ubc95 \ub180\uc774\ud130"}, {"images": {"nodes": [{"file_name": "icon_512.png", "id": "2034571480561473", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839665_2034571483894806_163205019895756954_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxoQbxxsO7MQ7kNvwGMBmM2&_nc_oc=Adrs3BP9tlyp6s0lNuQ4V2PrFfovXxByBNap-CNKPNfOaRZgIyZ0I8TLA6MJAfzWCNE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqf6A-Lrh3F8KnBH8v-gv8lSY8RlRiqCnQoaDXWRvf3g&oe=6B0B2ECA"}, {"file_name": "cover_square_1440x1440.png", "id": "1793439122783042", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839681_1793439126116375_8817831632517317410_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WBFj3Pqpd4Q7kNvwGVf_N6&_nc_oc=AdoTA2uzjAFl3i-6ox4_I51hibv611EaTCmJiV2gFJpT4V15EjcEkxpv9E46ssIzIMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPFbzbN_tnXeZ6wbJa_9BeGKih9ugkLL1D5pwAGmRGvg&oe=6B0B3E51"}, {"file_name": "hero_3000x900.png", "id": "1665820731993146", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839697_1665820735326479_1696300498820747451_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO0iT37tWXEQ7kNvwG78mB8&_nc_oc=Adp1jRiX1KBj80kEprt8pD4m_NdV8ksaaiSWqpQwod7nL2-3bW0I12p0oVYYe0fiTNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTO54vysLUNCOzlnUag_2OuA_O2Ky-sgXLEApTeIZCf0w&oe=6B0B3070"}, {"file_name": "cover_portrait_1008x1440.png", "id": "1649890343595148", "image_type": "APP_IMG_COVER_PORTRAIT", "uri":
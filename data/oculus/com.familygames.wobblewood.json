BxIVnInzfD6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiO--_7PDLesMweIzzoypBTuwnFtVPjj6dPxjOSLmp2g&oe=6ABA65F6"}, {"file_name": "04_seesaw_bear.png", "id": "2578965559220685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624583_2578965562554018_1132942340582010767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Qpnw0p3WsQ7kNvwHkRUUS&_nc_oc=AdoU8vtWvwWIkCWTSfojVuX1K2h9htORzdJ3adUd0ztsWsEw4K_LtKIT7bmReGhdhaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-5PQQU_k1954UWx8WVtrNzkUK5EUno4b-ih1v7BjW1A&oe=6ABA68FC"}, {"file_name": "03_carousel.png", "id": "2123945588549115", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499624619_2123945591882448_4354286134283385570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irFKt-Ye1vgQ7kNvwGDiUOq&_nc_oc=AdoKYjPH3-bWbap61EbSY74kIOf7lxEqOg7raXOgfvRnA3H4xaM7sCuMQtxYevIe9Ko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqOxVhQ9a5BZds_K8sflIHlR0Rgb2l0WeR2Fu0DY0-DQ&oe=6ABA7EEE"}, {"file_name": "05_climbing.png", "id": "3975993102704694", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624069_3975993106038027_5629079923399424392_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcIaIWvqJVYQ7kNvwHXP1Qw&_nc_oc=AdrJ1xw6qW0bk4C7qgrS9IobKFl4bGAR5pBe09hmbARbOGoIZIcUWdx224LtLAXjj-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInCc3xf8PDQX2vkOM8E6vRE0k7B6s72CfQk29T8O1Gvg&oe=6ABA64B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "family", "swing", "themepark"], "long_description": "Welcome to Wobblewood Park!\nThis playground is a little bit magical. Every ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\n\ud83c\udfa0 Six rides\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 A random slide that changes shape every time\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Fun for the whole family\nA dad built this game for the whole family to enjoy.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Pull a lever and the playground grows \u2014 swings, seesaws, a carousel and a 160-metre slide, fun for the whole family"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1322078214319460"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_1763722764962844_2969881034918788423_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VKlplXJlo8Q7kNvwEsTNHq&_nc_oc=AdqsKHmbSPaRo880WrE_HTlkIShGSXA-mGvTqtOv
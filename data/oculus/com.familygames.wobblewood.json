side_04.png", "id": "1491387609536365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839685_1491387612869698_4378286288827470628_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN0uud6BXGsQ7kNvwHGccN2&_nc_oc=Ado4dHZVRotM5PpeyRNG0GrpYGfwBBuqBTPuLw8mDvsxd2YvrHJNyDFwvAs44o1hv-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgLzdLKkjEr6FdzF-Svi-6o9x78OTzXAci3kboVTiL2A&oe=6B0B2B41"}, {"file_name": "01_ferris.png", "id": "1657662562509660", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839664_1657662565842993_2021011126299541882_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J261ucwyjoIQ7kNvwGlll3F&_nc_oc=AdpeaayI4wETokpiZMxu3y7B4wFeIjj8ZYuKRFdoLJNxkBfJdb9xqv7AeEMfjv4SKJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAQ3Z6yOk5vAFt0UdGqdo8I0h2MFyczLW5AXkQftSe6g&oe=6B0B2816"}, {"file_name": "02_bumper.png", "id": "2708595679595360", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839672_2708595682928693_6084976033943738416_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_WL6tV8kngQ7kNvwHvRd7I&_nc_oc=AdpQVqvA8L43A9HSDlLw1_3RCkG1xg4LopdOyOQfmZrGsT1_kYeHzi9tDbT-Q9FkUMA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQk6MUv09HL22qX8dMi6rAS77EXFZ0jlCArufGkLyrIqg&oe=6B0B2A6E"}, {"file_name": "03_balloon.png", "id": "1634562848406207", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839742_1634562851739540_1385269871028770894_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQguNHaSWFcQ7kNvwFlhErs&_nc_oc=AdoQBlOgvQ_0epK_-GifiybOKRrRYzbQsZ-fGv7S9R2fMmgvelibZ18tXdYfsw4nPi0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGuTXSgRTc_lgHaQ0A1jrc4nX7jdMKlMOnEzvTC_HvCQ&oe=6B0B2E4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wobblewood Park", "keywords": ["playground", "family", "swing", "themepark"], "long_description": "\ud83c\udfc1 Kart Racing is open!\nRace animal drivers on eight courses (three of them easy), picked from a map board.\n- Right trigger to go, left trigger to brake. Turn and squeeze the brake lightly to drift.\n- Drifting fills a bar and earns boosters. Tuck in behind another kart for a slipstream.\n- Speed races, and item races with water balloons, fireworks, bubbles, umbrellas and magnets.\n- Steer with a real wheel or the thumbstick. Top speed 20-80 km/h, 2 to 6 rivals, four skill levels.\n\ud83c\udfa1 The amusement park\nLightning Train \u00b7 Ferris Wheel \u00b7 Bumper Cars \u00b7 Wave Swinger \u00b7 Zipline \u00b7 Hot Air Balloon \u00b7 Drop Tower. The Park Map board takes you straight to each one. Grow the Ferris wheel to 100 metres, fall from a 100-metre tower, or ride coaster courses at up to 200 km/h.\n\ud83c\udfa0 A playground that grows\nEvery ride has a lever \u2014 pull it, and things GROW. The swing rope stretches to 48 metres, the seesaw to 40, and the slide becomes a 160-metre coaster.\nSwing \u00b7 Seesaw (a teddy bear rides along) \u00b7 Carousel \u00b7 Climbing wall \u00b7 Spiral jump tower \u00b7 Random slide\n\ud83c\udfa8 Drawing friends\nDraw a friend on the easel and watch it come alive and roam the park.\n\ud83c\udfc5 Balloon collecting\nRiding earns balloons. How many can you collect?\n\ud83d\udc68\u200d\ud83d\udc67 Fun for the whole family\nA dad built this game for the whole family to enjoy.\n- No ads, no purchases, no data collection (fully offline)\n- Comfort options and a parent settings panel\n- 13 languages supported", "short_description": "Kart Racing is open \u2014 drift, boost and race animal drivers on eight courses. Plus a Ferris wheel, bumper cars, zipline, hot air balloon, drop tower and a roller coaster, in a playground that grows when you pull a lever"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "developer_terms_of_service_url": null, "publisher_name": "FamilyGamesHDE", "support_website_url": null, "website_url": "https://wobblewood-privacy.ryu03066.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "zh_CN", "fr", "es", "de", "pt", "it", "ru", "tr", "pl", "zh_HK", "zh_TW", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1449275258266421"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839681_1793439126116375_8817831632517317410_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WBFj3Pqpd4Q7kNvwGVf_N6&_nc_oc=AdoTA2uzjAFl3i-6ox4_I51hibv611EaTCmJiV2gFJpT4V15EjcEkxpv9E46ssIzIMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeJ1reZH8X0biOGoFyPvXAGyaA5CF37ss-PCK-dXwqGQ&oe=6B0B3E51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wobblewood Park", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1787316360, "lastRevision": {"nodes": [{"id": "1234707766389839", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1234707743056508", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform"
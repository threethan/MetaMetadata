3bB94Q7kNvwHk3W5v&_nc_oc=AdoMGT4haSEFXiJvfrS-kTkvHf21NBCRjZGXWl7QKsCdKLmmHNoOIvddQjSQWAvpjBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn1fzlUe6yzwLIohbE-LeSVeToGg6mIPr83daiPZ0rBA&oe=6B01D960"}, {"file_name": "e272d69e1aee44378250e24ecd92edb4.png", "id": "1225465352511154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821784_1225465355844487_7014951378799129905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5SF2SHly9MQ7kNvwFVR-5n&_nc_oc=AdqgDryTkqV3flCgpBghOiZG_mbdmDiI7M3nDAzgTGSUZkxhm3ShoSEDe6ouR8Vf34w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrb6ojtgJj7vTmOen3GR7fAqipishhw1JR14qpMAi8UQ&oe=6B01DF42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ColorWifiStrength", "keywords": [], "long_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. Have fun exploring your WiFi coverage!", "short_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10
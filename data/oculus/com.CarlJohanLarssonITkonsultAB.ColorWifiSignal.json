s://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821784_1225465355844487_7014951378799129905_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxPp4M5ar_8Q7kNvwHE1NWu&_nc_oc=AdpxvG0VXG3MpEXR6kO1dpfEG4DJeQr4r3oQ3wHgZ-sG30YLCx2PaYaNWyli_QxiHu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJb7WP8mQN43YnHAwsPzZUClvToDqiWNpXcQd9Ej8DCg&oe=6ACCEB02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ColorWifiStrength", "keywords": [], "long_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. Have fun exploring your WiFi coverage!", "short_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10HhmotM7wb7jvex3vnndd82eDDidVkuTV-jkhOdpHJc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Carllarsson Studios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/10HhmotM7wb7jvex3vnndd82eDDidVkuTV-jkhOdpHJc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FO
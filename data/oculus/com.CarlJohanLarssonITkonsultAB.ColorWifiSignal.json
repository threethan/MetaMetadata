zvXewQ7kNvwEWDq7-&_nc_oc=AdpeF6bWtdA7UfqU4K4Ln4gDoqbOXKkZHSZW2-ayNMnrKWwOKsiNYnt1bOg2BoghPjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ27WFuQgtMVDeqkPG8N88ulTD_u2nTqUODCZVVJFn6wA&oe=6B0DB6E0"}, {"file_name": "e272d69e1aee44378250e24ecd92edb4.png", "id": "1225465352511154", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821784_1225465355844487_7014951378799129905_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhqoKmvTgm4Q7kNvwH7FW-4&_nc_oc=AdqCZTMh9Kn3OXqqIwxGFxRUStivZSODHIeM4aCKJC_DrDCCu-4bCvt62N3zQml8Rko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgAL-_XcJkBMbEUcyZtVsVhZ6TW2zphbuU0wF9U2N33Q&oe=6B0DBCC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ColorWifiStrength", "keywords": [], "long_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. Have fun exploring your WiFi coverage!", "short_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10
d": "711779484588401", "locale": "en_US", "screenshots": [{"file_name": "3be1f19276764117a4b445171f740195.png", "id": "1267650598127049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825271_1267650601460382_4846832402812060543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJVLQRSlbUQQ7kNvwGvN2CW&_nc_oc=Adk6CVovip93LJfGAk9U_6lUjo3NL5H1n94NgzTWtaPSgh9o5b_Tlel79heb0OG9TQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxY-8FFuRWdK_gVc3LdsjoNjfWrEJ4S4gXN4uY7ZYqbJg&oe=69B3F177"}, {"file_name": "rum.png", "id": "4130835800535676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830459_4130835807202342_4268855370608166276_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJplMR0DDPAQ7kNvwFti5Qr&_nc_oc=Adl0vflwJZIY_qUTFDMvWEQMnn2jRcc_DvAbV5oLymhaAXoVsEwiwCG3ZDWn0Ii0U2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4yja1uMNRr04NoD_gLurIVDlMQPmilcYoXn_IiC2M9Q&oe=69B3FA92"}, {"file_name": "552a16ca29b34d80a7f87961ee431bf2.png", "id": "1839105573595956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824518_1839105576929289_782135184761219912_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WgjX0SlhOIQ7kNvwGh_9sh&_nc_oc=AdluKcbUe92msptH-E4VsK6gllxKgnbQdy9aPj3X7Jm2JYOK96GPOEUdyloX7vU9QUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVbJQ89_TlMgo_DFTAhR6LuZlJ5rKlp5LNUD3OuiPU5A&oe=69B40434"}, {"file_name": "c4398909e8e845e191fedf4834549a33.png", "id": "9642490269202665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_9642490275869331_2474914053381986775_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ksavuBkpt0Q7kNvwGmbuPx&_nc_oc=AdmSHfB36RaGl9-axoCNum4Rmuj9LOcO_kwhIcejP1n9gnE3slggkaKtI6peBDSgis8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-JDDJ8scqgqdx5DeplJXXvzy8fD7PA0wpWERxVium0A&oe=69B415A0"}, {"file_name": "e272d69e1aee44378250e24ecd92edb4.png", "id": "1225465352511154", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821784_1225465355844487_7014951378799129905_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMLFSmx8K00Q7kNvwH7dpvj&_nc_oc=AdkkQf-8R7ZhYJs02e9UMpGbRnFfvd21RVFKjT8lC1gz7EcqyW2Rud-2gm4TxgKP2I8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgPa0WCQIWPK2nOUNrDOMIkUJPAFXlXTqZYgHN7OjLzQ&oe=69B41B82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ColorWifiStrength", "keywords": [], "long_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. Have fun exploring your WiFi coverage!", "short_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10HhmotM7wb7jvex3vnndd82eDDidVkuTV-jkhOdpHJc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Carllarsson Studios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/10HhmotM7wb7jvex3vnndd82eDDidVkuTV-jkhOdpHJc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"i
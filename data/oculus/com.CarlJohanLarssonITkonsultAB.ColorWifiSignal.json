", "locale": "en_US", "screenshots": [{"file_name": "3be1f19276764117a4b445171f740195.png", "id": "1267650598127049", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825271_1267650601460382_4846832402812060543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oXIpn8W960Q7kNvwHB1N43&_nc_oc=AdrUCvtgPddF5wCWJMmzC0dkNWrmFnz_R3D2zb-3ID_0QXpTVUvOpcErJXo4KeZQdLo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32-AivXx24zspZ4a3QUQ6R1Vzl5AlXQJhebPjGk1n-yg&oe=69F1E7F7"}, {"file_name": "rum.png", "id": "4130835800535676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830459_4130835807202342_4268855370608166276_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIK0E_Of8cwQ7kNvwHLiXkc&_nc_oc=AdoHmmwljCYyeSGtH2urOAhhNrFsmh8Gw96ncRkNYJi6qKC3S35RUQFbu8-2QEt6r0M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Ts2Zik9CCY4imFBOPU2qF-NoE84SaoFU1fYVn2HTEXA&oe=69F1F112"}, {"file_name": "552a16ca29b34d80a7f87961ee431bf2.png", "id": "1839105573595956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824518_1839105576929289_782135184761219912_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs-VxUG4_u8Q7kNvwEKHKgQ&_nc_oc=AdoUolwLBNdTV_QhNuOOXwAUgUaFf8iGNHqZGEo-MW7-5zzrKOa6-fs7Dt3UWYb6wTU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2NALRzHnTiC2HlcpoJlKHP80gLrKQwTu9wJ4p-AhMVvg&oe=69F1FAB4"}, {"file_name": "c4398909e8e845e191fedf4834549a33.png", "id": "9642490269202665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819980_9642490275869331_2474914053381986775_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hjyp5UwuOW8Q7kNvwG9r8_S&_nc_oc=AdpuZQzf3EiqlMgzGlb-gBTweTy5ySRtFEiN5JnpnoL2A0O2CvihFxpOu4xcLEBFSqw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1uVAERbCbkVMLgtmv0rX2Slewc9bjG0UoEBGVJoVgALA&oe=69F20C20"}, {"file_name": "e272d69e1aee44378250e24ecd92edb4.png", "id": "1225465352511154", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821784_1225465355844487_7014951378799129905_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsB_xpgBq3QQ7kNvwEuL3qD&_nc_oc=AdruYxEvVGyVsKJG8NaBZ5QKDcwX7amQ2vFGKEs0B4Fq0v1aOeoRcy6jGkAO6h8e6Ws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3j6FESHUZsuTcDluNNAbK8bhWXH-BolBdfPVToSZ4EmQ&oe=69F21202"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ColorWifiStrength", "keywords": [], "long_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. Have fun exploring your WiFi coverage!", "short_description": "With this app, you can visualize your WiFi signal with colors. The headset automatically detects the signal strength, and when you press the right trigger button, a ball is placed where you hold the controller. The signal is measured in your headset, so for the best precision, you should place the balls near your head.\nThe colors are displayed in five levels: green, yellow, orange, red, and black. Green represents the strongest signal, red is the weakest, and black means no connection at all. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10HhmotM7wb7jvex3vnndd82eDDidVkuTV-jkhOdpHJc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Carllarsson Studios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/10HhmotM7wb7jvex3vnndd82eDDidVkuTV-jkhOdpHJc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, 
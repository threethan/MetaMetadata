 Cycle\n- Customize Avatar (In Multiplayer Mode)\n- Multiplayer Safety Features (Space Bubbles, Blocking, Reporting...)", "short_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode."}]}, "developer_name": "Orca Virtual", "developer_privacy_policy_url": "https://orcavirtual.com/QQPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25721711634156123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75500285_2875737965910563_4511770789056666144_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2ANX55qrmUQ7kNvwHVxZOn&_nc_oc=Adq4K1VnQXvgRN0dwKMZueX2dthZX0aYV6xA2vxXD1PFwpxq_q6yzbXJAI_g6x494FA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmKIcoaNY2DKQRZb182zmM8N2p8dfEr7r4ZgX1fj8e0Q&oe=6A6E07BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
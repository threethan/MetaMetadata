D6"}, {"file_name": "qq_s4.png", "id": "868452945153895", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75588061_868452948487228_4657752642407295147_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcNPiuiTp3wQ7kNvwH9lhr5&_nc_oc=AdpQdip6YaTSg6-qYHSeuIILHvZQMBoXNHxWVQqctTPiA_Y44crSMRMKjBHXxfP6E5o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIkFcQoTch63BY57So0shxC9sWlZY_HFS-AVoWyhiNoQ&oe=6A85AAEB"}, {"file_name": "qq_s5.png", "id": "500250689214368", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569440_500250692547701_4209380133973393444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp8TaUnCJ38Q7kNvwEvLInx&_nc_oc=AdoMXtuSQzVnz1B88VZ2WUyEd5V-5xKJXwApwNcHrp33rkX_8oNIByG8o51wBFXiTIE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqt4Cbfru87BV329bBqwlBmrKIcIhk1XKDf-tKznnSlQ&oe=6A85AD8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1496788984310987", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036648_1496788987644320_8980773239125526344_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_ImKpgSgvEQ7kNvwFwQH9v&_nc_oc=AdrRP6U8svgNB48_u5EL69Pp6sw8wGk8N8usgX36TrMc6a5cZflrNVW3_PEuVGegOoU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuiiXLh0xiVLhDCY_j0Wmqr4lJxx4Syh_jj-WJLfNNyg&oe=6A8580B0"}, "display_name": "Quiver Quest", "keywords": ["Archery", "Quiver", "Quest", "Fantasy", "Exploration"], "long_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode. \n\nFEATURES LIST \n\n- Target Shooting\n- Fishing\n- Hunting\n- Food Collection\n- Eating\n- Cooking\n- Fire\n- Interact With An NPC\n- Lawn Bowling (In Multiplayer Mode)\n- Swimming\n- Map\n- Inventory\n- Stamina\n- Temperature\n- Weather (Clear, Rain, Snow)\n- Day / Night Cycle\n- Customize Avatar (In Multiplayer Mode)\n- Multiplayer Safety Features (Space Bubbles, Blocking, Reporting...)", "short_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode."}]}, "developer_name": "Orca Virtual", "developer_privacy_policy_url": "https://orcavirtual.com/QQPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25721711634156123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75500285_2875737965910563_4511770789056666144_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7vbVQDMxAgQ7kNvwFuTCJg&_nc_oc=AdoSijG9KDjRfEv1FdjmOsZlftw7kfcUumgcHiQpBRCjWfrl1hdjE_um3YOdy5HCwFw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkAWTJ0_S5EdQKlkmykDOg5WwMdi_sI8So3DJh7gmQ5g&oe=6A858A7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
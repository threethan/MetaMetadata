D6"}, {"file_name": "qq_s4.png", "id": "868452945153895", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75588061_868452948487228_4657752642407295147_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DswkSTI2RAcQ7kNvwGIVBpz&_nc_oc=Adrc7QOYtJ3FKpItu6ilMjdUpkW8ekF5ta2yP_zrolDREvPutS9z1JhYzKT-sD5FNUI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zNS5KUgbpyEsDjjQtiXYleATy51NWVAkX5TkpQl45Ag&oe=6A4662EB"}, {"file_name": "qq_s5.png", "id": "500250689214368", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569440_500250692547701_4209380133973393444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25GurAFvpRUQ7kNvwF8FhbB&_nc_oc=AdrAVCuSghEROZQ8I-NkBHi_tEBFOZdSTZmVNCb0KtDytSLt0gK6TmPSEvjG_5Nz2pA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7oslPmbgA5-dkajsy04E560OfihUIyLSM-2iHsey6qg&oe=6A46658D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1496788984310987", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036648_1496788987644320_8980773239125526344_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZnkCmPSBGkQ7kNvwH6Scm7&_nc_oc=AdqeuwMA0Gltl3GYNSBymB8N0h7LL9gCJCjsNJpHkX-q4bA5yTcMtNb64FfwPwgzTZE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_hT_4Z0O8pQtDC3ZZLqKlG5pLX7mhRAgNBXA25xRDHQ&oe=6A4670F0"}, "display_name": "Quiver Quest", "keywords": ["Archery", "Quiver", "Quest", "Fantasy", "Exploration"], "long_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode. \n\nFEATURES LIST \n\n- Target Shooting\n- Fishing\n- Hunting\n- Food Collection\n- Eating\n- Cooking\n- Fire\n- Interact With An NPC\n- Lawn Bowling (In Multiplayer Mode)\n- Swimming\n- Map\n- Inventory\n- Stamina\n- Temperature\n- Weather (Clear, Rain, Snow)\n- Day / Night Cycle\n- Customize Avatar (In Multiplayer Mode)\n- Multiplayer Safety Features (Space Bubbles, Blocking, Reporting...)", "short_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode."}]}, "developer_name": "Orca Virtual", "developer_privacy_policy_url": "https://orcavirtual.com/QQPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25721711634156123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75500285_2875737965910563_4511770789056666144_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiowdlioEqwQ7kNvwFDJujD&_nc_oc=Adr7OnKEVKk8xsjx_SNE5XGwS6jozzbsPKuKoFUjnlLd5nZxFG0ooG1pkuIWUV_2Njc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YzCDpWf6idVuZvuof27tDedilt42aFNJkXN8Xtnm-sQ&oe=6A467ABA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
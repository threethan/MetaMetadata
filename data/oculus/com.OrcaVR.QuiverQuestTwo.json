56"}, {"file_name": "qq_s4.png", "id": "868452945153895", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75588061_868452948487228_4657752642407295147_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1TqU7FIq8MQ7kNvwFuoHw7&_nc_oc=AdreA3IEXLzShNAPMdYuKpq_ejyY-FjbNi41xpN4fQw2S1-cSwTSpRJiGMVuJihPBvw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzPrLePnfgCvFfyrZALCtyfQRVsGdJo9MTYJhCA5YCzQ&oe=6AA3FD6B"}, {"file_name": "qq_s5.png", "id": "500250689214368", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569440_500250692547701_4209380133973393444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJHfwFV3visQ7kNvwGsnZ9X&_nc_oc=AdqHeKyMKF6BUe49aspZkMMD2jxGyxn2yXRadGwMdOzjBAH8w2aqC8cmW9KR7XBWYx0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf5MHzkpSJvIB_fGuNsTSWUhLjZho50ndF1g8EiK5NAg&oe=6AA4000D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1496788984310987", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036648_1496788987644320_8980773239125526344_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWAAY_qa-uYQ7kNvwF2ea59&_nc_oc=Adrb_v_BjJN0Z2-p-GYIVlA3QIqqi9irDB71GjcSSKbD61EUwQfyArcJ9W5HA4GRzUc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK8neWMaZKVyGVGWvANmtdcBW9payd6hC-7Y7nNxDhWg&oe=6AA40B70"}, "display_name": "Quiver Quest", "keywords": ["Archery", "Quiver", "Quest", "Fantasy", "Exploration"], "long_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode. \n\nFEATURES LIST \n\n- Target Shooting\n- Fishing\n- Hunting\n- Food Collection\n- Eating\n- Cooking\n- Fire\n- Interact With An NPC\n- Lawn Bowling (In Multiplayer Mode)\n- Swimming\n- Map\n- Inventory\n- Stamina\n- Temperature\n- Weather (Clear, Rain, Snow)\n- Day / Night Cycle\n- Customize Avatar (In Multiplayer Mode)\n- Multiplayer Safety Features (Space Bubbles, Blocking, Reporting...)", "short_description": "Become an archer in a land called Arlan. Go fishing, hunt elk, eat food, collect water and more to unlock new locations to explore in this open world adventure. Play with others in an open multiplayer room or play by yourself in single player mode."}]}, "developer_name": "Orca Virtual", "developer_privacy_policy_url": "https://orcavirtual.com/QQPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Orca Virtual", "support_website_url": "https://orcavirtual.com/", "website_url": "https://orcavirtual.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25721711634156123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75500285_2875737965910563_4511770789056666144_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC-w58VeIJUQ7kNvwGqgzYJ&_nc_oc=AdpQu2l5B5GfuXwG3vPwNT5A4ypeYx7KjqePY7exFmiuvyB3oxGKQUMJbnJwibQIXLA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9LsmJpMD8Ne6Hl10A8yKFNY7PwVg7oVKlqT6mim0jHw&oe=6AA4153A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
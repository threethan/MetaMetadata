=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOU-LM3aAjkQ7kNvwGAb0L_&_nc_oc=AdqEhPbQqvbweaymmZURKjl5Z0XcIb0tgzTj0_x72DZ-pMeGfP8wRWHQjHGaPCYMqFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl_rsQ7usORy5sAOR6Uaoc1VkcnXYik7WiIiLikXbJIg&oe=6AC7A9AF"}, {"file_name": "Demo industry.png", "id": "1585044346298384", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1585044349631717_1794620354297323252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JLIP2v3sAgQ7kNvwFvIZBp&_nc_oc=AdpF8lzsRRs7uXpNJ2c9M9N7H92yLnKYiDPeg5YwygL-1CYii70zdVl3QP47_NEtHnk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRzrwkY4ejVj6Yc7auw6jneGpv3Hw2wR-DrGYjNnkxyA&oe=6AC7CA8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fynd CORE", "keywords": ["Training"], "long_description": "**\u26a0\ufe0fDisclaimer: This application requires an active subscription or a valid PIN code to use. Please refer to www.fyndreality.com. \u26a0\ufe0f**\n\nProper training can be expensive, dangerous and labour intensive. With Fynd CORE, you can design realistic, **scenario-based training** without writing a single line of code. Virtual training removes risk, enables endless repetition, and enables you to learn at your own pace.\n\nOur **cross-platform** application enables you to create custom training scenarios on your computer and play through them in immersive VR. Through our partners, we enable **training on complex scenarios** across defence, defence industry and civil preparedness.\n\nWith Fynd CORE\u2019s **multiplayer capabilities**, a team can train together on cross-personnel scenarios, or an instructor can join their student to watch along on their **mobile phone** and provide support.\n\nFynd CORE has **proven experience** training military cadets in Ukraine, providing tactical operations capabilities to NATO officers, and unlocking new training opportunities for fire and rescue teams in Norway. \n\nStep into the new generation of training by using VR where it matters with Fynd CORE!\n", "short_description": "Fynd CORE is a XR collaboration platform empowering teams to create and perform immersive training experiences across industries."}]}, "developer_name": "Fynd Reality", "developer_privacy_policy_url": "https://www.fyndreality.com/fynd-core-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fynd Reality", "support_website_url": "https://www.fyndreality.com/support/using-fynd-core", "website_url": "https://www.fyndreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb", "uk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "37411965825113345"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_1027317865482833_5542515998344867595_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iC-Dg7M3ge4Q7kNvwG1Os0m&_nc_oc=AdqeYjP2Qm8zckvE1e7J09nuApoWzLmLu213pdLaJMSDIFH0iG919lYjyKlmnoX6wF0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTkFz__aSP2-xrr2ja06zRcP-326sDUQI1zWP3tHs0Jg&oe=6AC79ED6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fynd CORE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training
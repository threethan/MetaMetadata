20f&oh=00_Af8f3sOWISNrU_CTotnEnqafiz9D0VAzhxk1dDIS94tplw&oe=6A392BB3"}, {"file_name": "5.png", "id": "1279002717667093", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823270_1279002721000426_7034212431025536085_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=OnW32B51Bb0Q7kNvwG6SpiK&_nc_oc=Adr5nGkxUC-64fVXBWqZFyRF2OrMfRl9ctngYMXbQrGnvSLF5k4ekceuGREYqEXxDLU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8c7f5OHx9y-PH7UBexMFtvaztd_qrQodRrsUNs08WHQ&oe=6A39576F"}, {"file_name": "2.png", "id": "864995886566352", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819859_864995889899685_1079126013610936578_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OCMJ9-NLcwQ7kNvwHKec-9&_nc_oc=Adq2NMc-hLCLA3pUHSbhmFh63qE_NAG4-sTL-U3D6gngGISu3BNfIs7hG_OGfMnR4os&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_viKo5ByCu5pdq-lmIbvHCSLdfJ7bqkk0H9GdPR9ChLw&oe=6A39485E"}, {"file_name": "image.png", "id": "1224661149832493", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824741_1224661153165826_7702343814807121163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxTbYhH_SbMQ7kNvwEdM7aH&_nc_oc=AdqB3qAF0fdJgxn2zFXk98keOwTMQDYmH5ct-wj18-8lGbN3g1iNBmA6Vd0aB9qM004&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YGmy03ivBZH39Oa0QrtA4t7FZNDqhlUtcTu2n9JJqOA&oe=6A3939F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-A'raf", "keywords": ["quran", "quran3d"], "long_description": "Step into a space of reflection and tranquility. This VR experience invites you to connect with Surah Al-A'raf, one of the most profound chapters of the Quran, in a way that minimizes distractions and maximizes presence.\n\nThe Experience\nAs you open the app, you are transported into a serene environment designed to focus the heart and mind. Listen to the powerful stories of the prophets\u2014from the dawn of humanity to the lessons of faith, obedience, and the ultimate consequences of our choices.\n\nKey Features\nHigh-Quality Audio: Crystal clear recitation that allows you to absorb every word and melody of the Surah.\n\nMinimalist VR Environment: A beautifully crafted, distraction-free space designed to foster Khushu (devotion) and contemplation.\n\nEase of Use: Simply put on your headset and the experience begins no complex menus, just immediate spiritual connection.\n\nReflective Learning: Perfect for those looking to memorize, understand, or simply find a moment of peace in a busy world.", "short_description": "Step into a space of reflection and tranquility. This VR experience invites you to connect with Surah Al-A'raf, one of the most profound chapters of the Quran, in a way that minimizes distractions and maximizes presence."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25780536321645244"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1353432866549200"}]}, "baseline_offer": {"id": "1353432866549200"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773919740, "status": "PUBL
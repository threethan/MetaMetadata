x0fqCr02tud1zn8j_Cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQD8HOzbQqMjyePMFyFQ_1I3xoVOxOG-NfbS3vFlzkDZA&oe=6B0DB4EF"}, {"file_name": "Game_1440p_08.10.2026_15-51-25.png", "id": "1595192769018355", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624592_1595192772351688_6474625189477384578_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTESnHt8I7wQ7kNvwEepKJk&_nc_oc=AdrEQrUuf6j_0TU--Xe5PKFvCECTvmwqUbE0p1MStYare2Nlm4jYEiCVdy-74qrnBc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXhaT9DMivRXtBnb4qaamLYpUbrGX15IJnUP7iLBE2LQ&oe=6B0DCD41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scared Chimp 2", "keywords": ["ScaryBaboon", "Lethal", "Ape", "Scared", "Chimp"], "long_description": "In the confines of the research facility, amidst the cold metal and artificial light, a scared chimp resides, its once vibrant spirit subdued by the weight of captivity. Each day unfolds in a monotony of routines, its fur dulled and its movements marked by hesitancy as it navigates the sterile enclosure. Through the bars of its cage, it gazes longingly towards a world it can no longer touch, yearning for the freedom of its natural habitat. Yet, despite the fear that grips its trembling frame, there remains a flicker of resilience, a silent plea for understanding in the depths of its wide, expressive eyes. In this delicate balance between captivity and longing, the scared chimp serves as a poignant reminder of the ethical complexities inherent in the pursuit of knowledge and the profound bond that unites all living beings in a shared journey of empathy and compassion. And I hope you guys like the game :)", "short_description": "In the confines of the research facility, amidst the cold metal and artificial light, a scared chimp 2 resides, its once vibrant spirit subdued by the weight of captivity. Each day unfolds in a monotony of routines, its fur dulled and its movements 
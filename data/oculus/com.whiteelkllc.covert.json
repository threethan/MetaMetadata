833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3HRQiZ1syMQ7kNvwHWBCQF&_nc_oc=AdoHGNgVSi2pXcFuLr6TXEkqvcDE9C4ez2sb0o620aKV2f3dtz8xBIZb3TB6Csej7is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAvv8xveOA7Vjk--qltfovvOtOTheDZWWovxEPJKdOlg&oe=6AF72DE5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaIcEYe4KMkQ7kNvwENQzPY&_nc_oc=AdpnBF9t9eAZ8w7KpCJJt5PJ9PAK-ToFWNDFg6Meyl-PqLwbV9rQr9uljGNHoA8CJss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6aU59TN3JbTeSLTlnx_OkUM9OM72Xh8kG8g2_-JLciw&oe=6AF72835"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71FLQEklzUcQ7kNvwGZH7j8&_nc_oc=Adr2GsZaovBCcexINfdWO50JVzbdhmhXDRKBtW5nOukl8euZI831mqvAdGkemxy4lds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3E93trzBjfnS_035YofkHCXxZExJJlpJ-WDvwjvnOBQ&oe=6AF7341F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvtSeqpaAg0Q7kNvwH5DU-w&_nc_oc=AdqXgQN9QRTGLKgCcITRAcI7LdMFcjeRFsPZ5Igw9Om_792rkH0RpKhS8-M7GMxHiZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKwK9ocYsSCxMCnWnuJImYM9qWFAX_QlOABEF15EQREg&oe=6AF71223"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-5FDnHgbicQ7kNvwE_zNr_&_nc_oc=Adpn3SymEjo-kIKMa1HFuelHCRet0Z6VSeeCJVB8ZoiA6Qw_sB6kCLCfAmhl8tt_wxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkNv0teLYbFOytonxFNuOUfipAJ5L9ZBPyCLlaG3PuAA&oe=6AF73761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bkZZ2O4tfEQ7kNvwEb5q_2&_nc_oc=AdoCWj0U3QZL9zG4rblEFrG7WUInroSSX9_f4I404HoGm80qCb3tUYSYIsPDFnywuvM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTf_q0FAtS4eo5SFRSVgs3-c6QKSnR-5czkHLvM2VzCg&oe=6AE8AD65"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLB5nJ8JEOUQ7kNvwFPTwRp&_nc_oc=AdpuoQXnnaa3Lr3FlCunriK5sEFgHcB6GrdF12EQJg72oySKsh4333kLKb_nJAHicSU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-SwM5OOo-i3sakQ3qo-TlHJe3dc49wn6je6GD0Cm5MA&oe=6AE8A7B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVuxCYQbQPYQ7kNvwGD7FBL&_nc_oc=AdrwDtGGJd1S8eHzwWLCgRT2ysb-29mlqepU8xrcqFDKOZGyILyXAbhDiVylKVJlh1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEeKn-yklsia8NAAHMtqJsNGo7zBgxyqt4kI8kMCA9Mg&oe=6AE8B39F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyW8tCYRtGgQ7kNvwFiU7iK&_nc_oc=AdqbAHj8iyz4HuPYSLGhJ6kpGSygMuGIdlbzgjoXygHHGRY2SVOcEGAd9d6CveewFLw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgezg7wQZ3rZvcN4Lg1QaNE8PQG7iCbmuDle0IkJwHOw&oe=6AE891A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi_nUxfLo6oQ7kNvwHC-Z4H&_nc_oc=AdoyKMAJWvfCrINnH9Rh_RWwSEEzb0q-NSgqXxt1P6ZffFTYTq5FEqZLVuqCzzRj5QU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbTZdBZTEq0uLkt-T6OS9_Z5OBnCB8V-Ap_DS_WoDiBg&oe=6AE8B6E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
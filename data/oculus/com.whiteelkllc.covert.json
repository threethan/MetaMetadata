833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9fXE9dhX8UQ7kNvwHUj5DQ&_nc_oc=AdqSMGZP4zNaZOHfFdLhYYifqQMdNJDm5ksO5C9ABA4Uu3GHylFx95G0_sXv0qxasOk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3l5Fyc5c5PNsDZz9cqz-dO13B2JxtZ0D3mXDKM5Heg0Q&oe=69F61965"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tXkrMsvjt8Q7kNvwFnZMvU&_nc_oc=Adp15G1tOKMjaPF4lt-aO8kjYyxkpxA8cE870BQk9tS7a4bi3EH8YRqoDZ0LHiHeqoQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01VGiu3Sr8uUmUkuMFeFR2ZY4gCBrOuHoCYRw_P0IzAg&oe=69F613B5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQo9qf2jVAQ7kNvwEJybVE&_nc_oc=AdptBM9aA95utqQm7MXrZmrYHGFePZIQNgmcmsaA4oaCvc6kuR1O6USdwM65Opfp1AQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HUVa4kXDxgt-EaYiJGfPYrQq1jGALGQ2hBWGHF9APLg&oe=69F5E75F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3YEg894_AAQ7kNvwHK1mB8&_nc_oc=Adp9IDc1U1DSBTB4Yzptl59SPpqmTtZvfnMsaAfskf70dgWsx4LaWzLmSRp4kPdLLCs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dJgsdR-Ej4DOqb9X1daFDAzSkFTVxA9StKmmStSQRaw&oe=69F5FDA3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCVA_aXmWS8Q7kNvwGvJOvq&_nc_oc=Adom3rpVTtWHdVXgxM4juyAdkiPaRt3okvnD4vPmHNOMAj509CXGfVT5GtMI039MSYI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vU2C0RWPrpvbYf64Xn9APAg5DK6Hr88QPI8GiYMCcHA&oe=69F5EAA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
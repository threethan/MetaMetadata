833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OB6zxhx2lkQ7kNvwGwvzQJ&_nc_oc=AdqXcsdzyERAmU7HrYN1PF2v4o_ve1aQQElaY6XI2DGQuNXVFRh-UD2gF18CoW1ovxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l9cOpfaZEvCjfTLU-zBfb-xFdxQAPMqpiJteWHlCCVg&oe=6A01F6E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeRoiVpSHPQQ7kNvwFqQdNa&_nc_oc=Adq_DHJ9tTWjoRXJMcqFeKpsDjFjwS7rvYYcB5eMUXYSs5boQLdILCcfgGDHPRZf0QE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56s88I5-qGDb4dzuvQGZjsY4IDwyZgr0mlJ4wpJtlQRQ&oe=6A01F135"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPwwlzyHTDgQ7kNvwGcLr3U&_nc_oc=AdpmD83zpROXp2J3hfEDEERhfcwTC9mi9oWXnL0pO2IR9sSlQvhu_ax79aKs8BQD58k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IWr0XAg8YnKr2Z4HFhf7bJCfjoiG4ybTy3Ito4BcLAA&oe=6A01C4DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJnZZE1uCJsQ7kNvwFSq8Pw&_nc_oc=AdomXmWzi9IqiuE2IO3jm5eXoio3BqvVysAbJ0uXXNeaigoFCLSOo0X5C32IQe4srGQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G8bXYy5IvmJYPc0f1PUuvv8yz65Nt1Mmde1v-ZDPqqA&oe=6A01DB23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiC3N8vyPQsQ7kNvwHx6Ve5&_nc_oc=AdqyfKwUMs_9RDafWqjbo0oA5Tl5mzVOtAvjDpl2nRP2x6V9EIvDrmi8KOya35taf6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oMl7pvYvrBFpP_8yWYm7NcfWREc2mp1mAnZa0KdF7bg&oe=6A01C821"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
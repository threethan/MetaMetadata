833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0152912zqwQ7kNvwGtnI3_&_nc_oc=AdpAQavS3UkJQvFx54iH0yqLMWwhmduL6tW9a2dG0c0gCuUjInsH0UGzsM50M6PJsYQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DF82JgJsp04zEL_oZ8zH3KRqnINE5BkIobAtp6bH3NQ&oe=69E21AA5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F76zNKrALjEQ7kNvwEp5uHB&_nc_oc=AdpgRajV5BvIl-b3ihuXdnqnB0xcyeKguySVqrzCCSBwO30gfNVkNVGTQpmhILSTacM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xxKOuiX6WrvV3uLaAUTimyumGCAhgs_sgl5UZLA6i8Q&oe=69E24D35"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RpnjemvF9AQ7kNvwFFF4_1&_nc_oc=AdrlsSS2OMwWZy1Gs4bMdfPtfDBtW6AWW1-TtmTIG4Xj5NSY_sRl3ei1pfr_5smknmU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S8N8wyRuvpFBd7p5HLZ57NZUCK8_lTMsWaqnoVQ01cA&oe=69E220DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Krx7LGb8y4Q7kNvwGSVzo5&_nc_oc=AdptEkGex2daMIIbZZnkZY5msYQ2YO_NSNt90XUv7gPcwHe0pTSZB8-tF1FySnHkhZI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Yn7LndL8Q6Pp6E1nRLkv2H-ccql0TQkkwKIIPuIjz2A&oe=69E23723"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkStqXZYAvkQ7kNvwFBYLU-&_nc_oc=AdpFJMLRyr_tIPw_Ir41xSerI0JIAKpcrVD0V9i5uqRQj5_tUJZw82pMHiGnCRA4kBM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rSbAiyJ2Mu1ZFJTUO3haqZWlqFJHYhRjXtxIu7GprNQ&oe=69E22421"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
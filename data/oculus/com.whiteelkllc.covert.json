833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyarDDip_dEQ7kNvwGSneut&_nc_oc=AdrFDnJM4KbeIcY1MiEfBGAfg6W67ZxXRX_fuoO_K7jbgb_mpiKCv84CjTkekk7ZTUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bf3P9JS6MNRTmQDXZTL8FZZeXVCZiqaLyiZSUSMJ_8w&oe=6A1EF7E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05io0Zw6nKMQ7kNvwFXd48v&_nc_oc=AdoXwt_RpNKyBFAxdDUNpfj3nKzb1YeD32a4EBYJ5SJ81xi7j_qWiAPYg0efPr0Yvxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xuMstYllmDyVCgbkIjhGpcZ0i-LkskVOSJbe1WNLiCg&oe=6A1EF235"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckeHYAaOM0QQ7kNvwF52tEi&_nc_oc=AdpEZF_TL4VgczGy1jHwFmBoMKUm03QuXO2obl8Che8GxBE2_bHfyOcCoO-PxOZpan8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QyJciDT_shvd6EXp9Tzug1SRATYu5ADRQEYJ1dgvEFw&oe=6A1EFE1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0IB-8odpg8Q7kNvwFgaqE3&_nc_oc=AdoiKlj-YaOsuHXbAho8F6lR-VwAxDwb94lT-J8wj2hwJ2VPzVVFOuCey3EUpKMfVwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pKokNLtRgEaCdFix3iAIL05bGg1dxY5MWS1JhGEiQ6w&oe=6A1EDC23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO2xk2tNZZkQ7kNvwFaJ7t2&_nc_oc=AdrMMMwIaOPyucraPtZReYNk6Iq5JXe26nH_miw_SO3YWaXntQ5gp_0XRoomKUMAq6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XA182fU7MYGoklHhddkM9mS9S9Dxm03nFK088LvIkyg&oe=6A1EC921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
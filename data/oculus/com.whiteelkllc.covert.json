833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqm0pk5mXZYQ7kNvwGzfTh5&_nc_oc=AdqjEBp01wC3XhSbaDMrB3JwmF5n5kCWhooyfmACBeinoKzrDjMncljZbTDRNEG_yHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT92Q9xsFtNmq0gn3n2qRlYNr0a7hb-f6l-A2EI5-1tNg&oe=6AF1E7E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6MVSwsEgTAQ7kNvwGcVbbm&_nc_oc=Adoi49vzEiEXDc6EAiCCmagoGAx2nl9Nz-jXbvW8BN_HtM7CMW6T63WGsRcudHpiGCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfeKWL3KRBLqpNg6TxABxDvbZPSqI-0SrGYuhj3PMB_Q&oe=6AF1E235"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YifY_KYgwsQ7kNvwGJhTSA&_nc_oc=AdpZpVEFFVCfbPY-c3_AfThLfLONh9O2r6-TSNuH6oWz_r8t0I2NYMCSYdhNyGObsYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8LAflZHdXM6FfXfT-EIdqrIXMWStY28hasO_0J8tTyw&oe=6AF1EE1F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoAcw7NOQm8Q7kNvwHrsjbF&_nc_oc=Adq6g6PpsaJSH400_IJHiPC97vtfUlbgA3BTMgfqjcTkbHIaoqrvij90dcq9X6lkl7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8F9ynccTR1Ui1OGLEYJD1xpUwmYa6VUj5XPgKoSvzRA&oe=6AF20463"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYOU9dGRwFIQ7kNvwESh1h1&_nc_oc=Adp31YEydUUEuUvRKp088RXKyqT1fzElkdddvWVHBoArix9vpXZ96D3UnhA8tWjHhLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTIBuGXixi2_chJ-lnyaM5fnWQ9Z9DUiUXe40ZNTWKuw&oe=6AF1F161"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
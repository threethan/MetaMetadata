833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx8V9lyWKkEQ7kNvwHUntO0&_nc_oc=AdonfvL_Z-_PF6EJUpyFqUaKXfrjbj6a3yBmO50hmVMPF1Z4TatoZrwHpZUdK7jVSec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKP2gwNrE1C4vodfvSL7vuXe1vwXDywkcfQ0GknfD0mA&oe=6A6385E5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCz5etam2T8Q7kNvwGCckP1&_nc_oc=Adpod87pbL1rzMVRT9W1BiFBi7CbjXaNgI8TqWt5_7T3ggG4cHAcJFeRwyu7OCRSYdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIcGjRxPnJW61ttjycixcvYJrMI5VVwc6QEniY6LFLYQ&oe=6A638035"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGLmndgeYKEQ7kNvwG5Cwix&_nc_oc=AdoYpd0ADw-INWvSBCJmnts4UaPhhrk4uq6DgH9UW3QZyz9rpogQinwKROreXFaL-yc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7BeUenHvNbSZsPxDo5ho2ZCWjzLCmhZFvh2oxhPd8pg&oe=6A6353DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KmsUoMNHpsQ7kNvwEZt7fl&_nc_oc=Ado-LyY6Rzmg2VNKJfp5gKzhTv8cvs5TBkBCKULduNG0VJD8zLSjT6AlXZXN5yxHXgE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV1EEMImsYlLLb1QTqWgNLtRpNAC7RUz0tRDagvFEaMg&oe=6A636A23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmKCTAU-Qb0Q7kNvwH2_YpO&_nc_oc=Adpp9gQI2UrcO1-AuYI6IoYHRH4nMuYgn2WOlOuvfuLBAolJzrfnBHf0zO7noTYm5Fs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo-8cCTCDTy9jpM8VGNeCH6I3qYZ0gMGfXC5lbYy0ZWg&oe=6A635721"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jaq4L-O8Q2QQ7kNvwFxcf1z&_nc_oc=AdqK_QZwVtx8GMqCwxKkRKcqOznPyK4_JHHqPlX0X2XWOeRP-YzgmnYCotIbXjXdw2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xCb2YPMPKjE6E8JZtY5vfJXt5ByutosYF3e49UjTdPw&oe=6A429065"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8UPGDhSN0IQ7kNvwGouZii&_nc_oc=Adp8loPXcNrT5K396VxX8RbtQx9f47xZVetDOMBGutsE79kHOvtv0BMJNTP7F_gSj8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WBCJR9qCcc7w5zi7iDcTvhrSggE6lgd9IRfHjdX7Uaw&oe=6A428AB5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knUeDAUuBTwQ7kNvwG4F1nZ&_nc_oc=AdpOtxmwZn1DKMK5M_ERo6wtLdM0d6UUk32MahgCw5o0TfOHeZW2W0E-1sgjWAvI9pw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-awGvUO2wG0YXSrVmxYVW0JWvo-iy-XBrlEG_rWTLTVw&oe=6A42969F"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JU3_hjEsA1sQ7kNvwEFr3gL&_nc_oc=AdpOoUuOuXBhf-K2O0YlFule0DgC165UMXvOzMqR3YxjdMlvfJR_hmaAvt9ezk-nByc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KrhM49Fkn6uo7m5-IrkFDW6DtaMhyFsBJbIDFuhyo7w&oe=6A4274A3"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3eBMoPoPjgQ7kNvwGaJ2ra&_nc_oc=Adp5hqyQVDQO4hk0VAnoP9dS10bqBkwDl7t0EfAw0DCLevYWp4ki9fQF_oZuuNTSR10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rJYpvBdKI0vTDR3Dh3sSjE_bAyrCfpQzpXb3OJm4HkA&oe=6A4299E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3pJ-6CJE4gQ7kNvwHmvA_r&_nc_oc=AdpVTaJnuA2NvmpTARhOHSDMEo9JWNvB143gWBzpNkazIriW3n9-AIHVoOHf1_VTItM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPSeJwW1xEboSxnjPTt03F89hBFi52S71ehK_brb1Zjg&oe=6A6893A5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdt_azYkZPcQ7kNvwFsd3rY&_nc_oc=Adq9h62xAvJF6FJa943cJ5hWEzZAB0GJEOv_6GSKBkOKi2K8ZU2loHCtHkJ5bF9XPa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMRfPEQdoDkOT2S_ldoIdzZnZJofIwohyadYJ4agVrTQ&oe=6A68C635"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDxVO2M8AacQ7kNvwG2T2uT&_nc_oc=Adpqd5TwdgcmozQ--besgy__JnT3XJzUX48QiKGIO6vuCCD4Kh9v7is8QdfMfcNbfPs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVuZ117KaRxO8mJ3ue64HUz83OEOkOzQwm3-JBI5gfwg&oe=6A6899DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4UwP9qGhdoQ7kNvwE8Nse9&_nc_oc=AdqvtxA8I_8aqGHUxhTPbW5tU7EHGv0n3Ku-eADNPNEa-eSU2EYjZUEq-b6vepsvIH8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALMZeaZ6rrAMI0tYDzsjR-yC5mUT1VP71aIzUjue8soQ&oe=6A68B023"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_yOGgYn_h8Q7kNvwEJEC6Q&_nc_oc=AdpBp2U6aPOFZU8wfLC_LjUBdFtZ4zCD3-05QqACJWoVb0pPy6TWq5H93CoNsoTFw6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwc2so9urQYi0e8_sG2bxxez9nDj-psILuBF2214HpCw&oe=6A689D21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
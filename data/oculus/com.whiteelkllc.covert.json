833152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMkkHNQjawoQ7kNvwF7HJwE&_nc_oc=AdpuLMWnzoYNddk9CbEYdteKCkWf2XL890Thb82wff3pgR43jbEER4xy4g-JTP_VH7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8HHBtwATsguG2JnSLtbI9I1IYGLuHluvOaistqxe2QQ&oe=69CA5FA5"}, {"file_name": "migrated_image.png", "id": "2608432922808465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001686_252446765420067_3138884708348198912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GSs5sQy3SMQ7kNvwG2AiPV&_nc_oc=Adot4ZDhXPslvfCxi23OxvojTuMu_1joSATwEAdA9MCkejdWQ9uTMtVAggaAj-qiFQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5TCxyw8nfN3HRrNPQKPn-bufwGUYNwcHTlGPuqBiZyQ&oe=69CA59F5"}, {"file_name": "migrated_image.png", "id": "500397003983704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974439_1923795197925879_6673457130109927424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OthwE_A5oQQ7kNvwErZhBN&_nc_oc=AdqzZqoFFZzZ6hNlarj2wiHfsWgz8JhAg5E-ZXRlcXQcv908AHYo4_zMk4p60MwzU2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS54T3lU2nlhtFwnaZsEStEdDlu1_BEmOs8UOJ0gIzjw&oe=69CA65DF"}, {"file_name": "migrated_image.png", "id": "247460932948909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_336366803585011_7366122813926670336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w3N8bp5Hs4Q7kNvwEeI12P&_nc_oc=AdpWyD88C3ckuI44v9v3fgf3PSL6QweOvCG6isdgAUhrJVnJULrFIwCpmYtE0KBPIxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWU3gGsK9OSku28v6JZM2DSmoL57pLSW2k__pno3DgBw&oe=69CA7C23"}, {"file_name": "migrated_image.png", "id": "207202277197797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_2101040860225378_8310325426392137728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnWIIXzisS0Q7kNvwFRkgDE&_nc_oc=Adps3rPxTvx9m-AYBRcHAGtpd4TmU2apxX0EnB-3W-6aRraS8SGIQ0JOo2yytN-mjjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRHszgSD5tdJ4XaMMp2qNclLtj1Qs2_BJZM1nbuNs_GA&oe=69CA6921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Covert", "keywords": ["covert", "heist", "coop", "hacker", "stealth"], "long_description": "\u2022\u2022\u2022NOTE\u2022\u2022\u2022 Please make sure you have a device that is fully compatible with the companion app - Supports Android 7.0 - iOS 6 & above.\n\nRecruited by a mysterious client, you & a partner take on a series of high-profile heists. Utilize gadgets to infiltrate heavily guarded facilities as the crafty Thief in VR. Breach through security systems as the clever Hacker on a mobile device.  Cooperation & trust will be needed to sneak past guards, hack through laser grids, crack safes, & much more\u2026\n\nTeam up & pull off the heist of the century!\n\nFeatures:\n6+ hours of gameplay\nCooperative: A successful heist cannot be achieved alone!\nAsymmetric gameplay: Experience the heist as The Thief in VR, or as The Hacker on a mobile device\nCompanion app: Free! Only the VR app requires purchase\nOnline: Play with your friends & family from anywhere\nPass-and-play: Introduce your friends & family to the unique & immersive experience of VR, while putting your stealth, communication, & trust to the test!", "short_description": "Covert is a cooperative heist game where you and a friend work together to pull off the heist of a century."}]}, "developer_name": "White Elk LLC", "developer_privacy_policy_url": "http://whiteelkstudios.com/index.php/privacy/", "developer_terms_of_service_url": "http://whiteelkstudios.com/index.php/terms-of-service/", "publisher_name": "Oculus Studios", "support_website_url": null, "website_url": "http://thecovertgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":